%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_es
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 9ca4ee10b5b962b4993a5133922046c2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: Claro, amigo... cof... Todo lo que tenía se quemó, ya no tengo nada que esconder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Echa un vistazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: No... cof... no seas muy duro juzgando. El humo no es precisamente un buen dentista.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Aquí, mira... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: Como dos troncos carbonizados y algunas ramitas ennegrecidas. Uñas limpias, eso sí. Irónico, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: Desde luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: ¿Lo ves? Cof... Rojos como un par de brasas. Es por el humo, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: ¿Estás seguro? No es una imagen agradable.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: Estoy hecho un cromo... Mi piel está agrietada como un árbol viejo. No alzo los brazos si no es necesario. Es doloroso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: Claro, como sea. Solo tendrás un cadáver carbonizado. Así es siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: ¿Cómo resultó? Cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: No hallarás mucho. Están carbonizados hasta el cartílago.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: Pronto dejaré de escuchar. Quizás sea mejor así.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Anda, hombre. Dispáreme de una buena vez. Solo no apunte a los dientes. No hace mucho que ya se pudrieron'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Como sea, no tengo qué temer. Dispárame si eso te facilita las cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: Buena idea. Tal vez sea la opción más piadosa llegados a este punto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: ¿Acaso sabes por lo que han pasado estas manos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: Si esta foto es una condena... Cof... acabemos con esto. Ya no hay nada que me retenga aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Todo arde eventualmente... Supongo que me ha llegado la hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: ¿Sabes? cof... Nunca logré que mis hijos se lavaran los dientes todos los días. Y... ahora no hay quien se lo recuerde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: Con estas manos... cof... solía salvar gente. Ahora ni siquiera puedo sujetar una taza como es debido.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: Así que, así son las cosas...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: Bueno, me toca morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: Cuando un bosque se incendia... cof... se deshace. Y sabes que no hay nada que puedas hacer al respecto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: A veces, despierto por la noche sintiendo que se me desgarra la piel. Nada me alivia. El fuego me lo quitó todo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Solo la memoria puede salvarse del fuego. Pero el cuepo cae en las brasas tarde o temprano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: Cuando el fuego consuma todo a tu alrededor, recordarás el silecio de verdad. No con tus oídos, sino con tu alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: Vale. Pues ven, pónme a prueba. Lo pasaré todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Anda, míralos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: ¿Has visto dientes como estos antes? Son como un tesoro escondido en mi boca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: ¡No son dientes, son oro puro! No todos, por supuesto, pero habrá más en el futuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: Si supieras lo fácil que es abrir latas de cerveza con los dientes delanteros.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: ¡Que les den a los abrebotellas!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: Al menos todavía conservo las manos, así que puedo estar agradecido por eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: Si no las tuviera, no podría hacer carreras en absoluto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Aguarda un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: ¡Mis dedos han desaparecido!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: Ayer me faltaba uno solo. ¿Dónde se habrán metido los demás?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: Bah, ya volverán a salir. Dentro de poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: He perdido mis dedos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: Es una nimiedad, pero sigue siendo desagradable.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: ¡PERO ME HAN VUELTO A CRECER UN POCO LAS UÑAS, ¿LO VES?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: Lo que quiere decir que mis piernas también volverán a crecer. Dentro de poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: ¿A dónde quieres que mire? ¿Directo hacia ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: Ignora mi tic. Es una manía.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Desde aquellos días en que podía acelerar un motor de verdad, no alcanzaba a ver... bueno, nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: Supongo que no estoy preparado para bajar la velocidad. Siempre estoy atento, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: Venga, prosigue. JAJAJAJA, vale, ¡joder, qué divertido!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: Lo has hecho, tío, has alcanzado la cima de la comedia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: Ahora nos vemos las áxilas entre nosotros. Una locura.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: El mundo afuera es un infierno. Como si el universo estuviera dándolo todo para borrar a nuestro planeta del mapa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: Y para embellecerlo todo, los Visitantes quieren acabar con nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: ¿Y tú vienes y me dices "enséñame las axilas"?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: ¡JAJAJAJA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: ¿Quieres tomarme una foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: No es mucho lo mío, pero bueno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: ¡Joder, he parpadeado!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: ¡JAJAJAJA! ¡Valeee!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: También has oído esa transmisión, ¿a que sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Sí, es bueno, ¿cierto? ¿Eh? ¿Qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: ¿No lo has hecho?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: Qué... curioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: Vale, no te voy a coger más cerveza. No te lo tomes a pecho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: ¿Sabes lo que le pasa a la gente que se retuerce de ira como tú?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: Se tuercen ranto, que se rompen. Y terminan en una silla de ruedas como yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: Si te va a enfadar así, mejor llévame a dar una vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: ¿Por qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: Eso no hará que pueda andar otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: A ti tampoco creo que te sirva de algo. ¿Así que qué sentido tiene?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: Probablemente no podré seguir la trayectoria de la bala. Pero puedo intentar esquivarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: Jamás entendí por qué la gente se afeita. El pelo es la defensa natural del cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: ¿Ves cómo se enrojece esto? Me están creciendo dedos ahí. Los de repuesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: Ah, la verdadera comedia aún no ha empezado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: ¿En qué nos equivocamos en esta vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: ¿Quien se pone a mirar fotos viejas? ¡La vida es muy corta para perder el tiempo así, amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: Lo que quiero decir...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Mira, solo deja que me marche, ¿vale?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: Bueno, tarde o temprano o todos nos llega la hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Tarde o temprano, Dios te hará un ajuste de cuentas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: ¡Pero no me voy a ir en silencio! ¡ESO JAMÁS! ¡AAAAAAAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: Es todo parte de nuestra biología como sacos de carne, ¿lo pillas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: Un momento nos reímos juntos y al siguiente nos volamos las cabezas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: Necesito prepararme para mi último viaje.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: Mis manos son mi único motor ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: Y no tengo embrague.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: Para ser sincero, la idea de que algún día pueda perderlas también me asusta. ¿Qué pasará entonces?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: Odiaría quedarme sin ningún medio para desplazarme. Atascado para siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Ni la muerte me asusta tanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: Un día, sin importar qué, ya no puedes ponerte al corriente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: ¿Has notado que el tiempo se acelera con la edad?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: De críos no teníamos prisa por avanzar en la vida. Antes todo era simple. Sin responsabilidades ni decisiones chungas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: Pero ahora, por mucho que nos demos prisa, parece que nunca nos alcanzará el tiempo para nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: Sabes, de repente no me apetece reír.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: Tus ridículos exámenes, joder...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Todos quieren salvar el mundo, solo que no se ponen de acuerdo en cómo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: ¿Y para qué? Tal vez solo hay que relajarse y pasar del tema.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Mira...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: ¿No crees que nuestro viaje en este mundo ha terminado?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: Es el final de la línea. No tenemos a dónde ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: ¡Ding! ¡ding! La última parada ya está cerca, podemos verla.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: ¿Estás listo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: Me estaba figurando... ¿Prometes no enojarte?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: Si... Si no puedes fiarte de esta señal, ¿cómo voy a fiarme yo en nada?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: ¿Quién sabe? ¡Quizá todas todas las señales tengan que ver con los Visitantes! ¡O quizás ninguna lo haga!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: La gente es propensa a cometer errores.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: Pero estos errores pueden traer consecuencias chunguísimas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: Si... Si tú te fías de esta señal, ¿cómo voy a fiarme de las anteriores?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Quizás las otras sean pura mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: Somos humanos, claro. Podemos cometer errores y ya está.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: Pero estos errores pueden traer consecuencias chunguísimas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Como tú... Un movimiento basta para liarla con esa escopeta que llevas encima y entonces alguien pasa a mejor vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: Si confías en tu elección, pues... qué envidia tu confianza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: Andelante, examíneme. No tengo nada que esconder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: ¿Sabe? Nunca me importaron demasiado. No tenía tiempo. Pero ahora... Ahora me arrepiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Mira, aquí están.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: Son palas, no palmas. Todo por los críos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: Venga, mira.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: ¿Ve estas ojeras? Las llevo por el insomnio...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: Venga, mire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: Se me acabó el desodorante hace siglos. No me lo vaya a echar en cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: ¿Me puedo sentar? ¿No?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: Desgreñada y malhumorada, como de costumbre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: Hace mucho que no los limpio. Seguro que los tengo tapados.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: Ya estoy medio sorda por los chillidos de los críos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: Ya va como una semana desde que me sangran las encías cuando me cepillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: Y sigo con los dientes amarillos. ¿Pero cómo no voy fumar con estos críos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: Tengo como un sarpullido por los productos de limpieza. Nunca tuve tiempo de ir al médico.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: ¡Con estas manos hasta le habría cocinado una sopa si usted quisiera! Pero no, usted viene y saca esa arma...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Podría volarme en pedazos con una granada y ni hecha pedazos dormiría bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: ¿Qué, va a dispararme por el olor? Menuda gracia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: Venga, ¿pero tan mal me veo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: Está fatal de la cabeza si quiere pegarme un tiro por mis orejas. ¿Qué le molesta? ¡Me las puedo tapar con un sombrero!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: Por fin, paz. Ya nadie me va a dar la lata...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: Qué triste...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: Uno de mis críos tiene unos dientes perfectos. Y no ha sonreído en su vida. Igual no es cosa de los dientes, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Estas manos... con ellas abracé a mis críos, cuidé del hogar y de mi marido. ¿Y sabe qué? Nadie lo apreció jamás.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: Cuando tu hijo se pone malo, te tiras días sin dormir. Luego te acostumbras y empiezas a vivir en un limbo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: Una vez, estaba tan hecha polvo que no me duché en una semana. Los críos ni se enteraron.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: Sabe, una vez encontré una foto donde todos los niños sonreían. A veces me quedo mirándola toda la noche hasta dormirme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: A veces desearía ser sorda. Pero cuando los críos por fin se duermen, hay un silencio glorioso... Para eso se vive.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: ¿En serio? Joder... Bueno, vale, ¡pero dese prisa!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: A tomar por culo. Venga, mire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: ¿Están amarillos? Me la suda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: ¿Blancos? Menuda sorpresa. Es solo higiene, gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: Solía pensar que si iba a tener dientes así, quizás debería ponerme uno de oro. Como los tipos duros de las películas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: Sí, da igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Pero mira nada más cómo las tengo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: ¡Já! Mi abuela siempre decía que con estas manazas debería cortar leña, no... hacer lo que estuviera haciendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: Pero aquí no hay nada que cortar, y tengo que desahogarme de alguna manera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: Como sea, examínelos, da lo mismo'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: ¿Qué, le gusta que sean azules? Nunca necesité nada más para interesar a las tías. ¡Ja!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: Me importa tres cojones.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Sí, me afeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: No soporto tener algo de pelo bajo de mis brazos. Es como si un puto arbusto decidiera crecer ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: ¿Ah sí, comemierda?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: ¿Qué? ¿A qué coño me mira usted así? ¿Qué ha visto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Joder...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: ¿A qué coño me mira usted así? ¿Se le perdió algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: ¿Está usted gilipollas? Le acabo de enseñar los dientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: ¿Se cree que no soy capaz de estrangularle con estas manos más rápido de lo que pueda dispararme?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: ¿Qué cojones le sucede? ¿Está celoso o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: Me pican como el infierno, como si intentara tocarme los cojones.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: Cuando me rasco hasta que sale sangre, sí, pero el picor mejora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: No le creo. ¡Está jodidamente loco!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: ¿Quiere dispararme por una puta foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: Tenga cuidado agitando esa escopeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Podría dispararme sin querer y todo por mis putos oídos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: Está completamente ido de la olla. ¡Venga, zorra!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: Es un cabrón jodidamente desalmado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Váyase a la mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: Mi abuela tenía un diente de oro. He querido uno así desde que tengo memoria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: Brillaba como si el sol estuviera atascado en su boca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: Mi abuela decía que se lo pusieron cuando el viejo se le pudrió.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: Y Pensé: "¡Pues genial! Me harán lo mismo a mí cuando los pierda toditos".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: Y entonces... Bueno, llegó el momento. Excepto que nadie me dio nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: No me brilla la boca. Mis dientes solo son amarillos y apestosos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: ¿Ve estas manos? Tierra, sangre y toda esa mierda. Pero son mías.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: A veces me escuecen tanto que quiero me las quiero despellejar. O dar un puñetazo a una pared. O ambas cosas a la vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: No quiero hacer daño a nadie. Pero no puedo contenerme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: ¿Ve usted estas uñas? Tierra, sangre, lo que quiera. Pero no son de otra persona. Todo esto es mío.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: A veces me escuecen tanto que quiero me las quiero despellejar. O dar un puñetazo a una pared. O ambas cosas a la vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: Apuesto a que si fuera otra persona, me rayaría por lo que me hago a mí mismo. Pero me importa una mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: Mi abuela siempre me llamaba "bebé ángel" por el color de mis ojos. Pues vaya jodido "ángel".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: Ahora estoy aquí, mirando a través de estas sucias ventanas y pienso: "¿Qué jodida parte de mí es un ángel?"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: Me puedo figurar la cara que pondría al verme, decepcionada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: Sabe, las cuchillas de afeitar serían lo bastante afiladas para... ya sabes. Si tan solo fuese tan sencillo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: En aquel entonces terminé con el brazo rajado. Ahora, cuando me afeito, es como si la cuchilla no cortase el pelo, sino... una parte de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: Pero me afeito de todas formas, porque odio esa jodida mata.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: Ni siquiera tengo una foto de mi abuela. Ella no soportaba esa mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: Decía que cuando te hacen una foto, tu alma se queda encerrada en la imagen por toda la eternidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: Yo me partí de risa y le dije: "Venga ya, abuela, qué tontería".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: Y ella dijo: "Cuando me muera, mirarás mi foto y te preguntarás si estoy en el cielo".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: Bueno, ¡que le den a todo! No tengo ni fotos, ni abuela.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: A veces, me sorprendo tirándome del lóbulo de la oreja, pero solo cuando ya me está ardiendo como la hostia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: Antes pensaba que era una cosa nerviosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: Luego entendí que simplemente quiero arrancármela, como si me estorbase.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: Pero no estoy tan chiflado como para automutilarme, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: ¿¿Verdad??'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Oh, querido, ya sabía yo que tu energía se resistiría. Adelante, examina. De todas formas, sigo viéndote de cabo a rabo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Venga, echa un vistazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: Los ojos son un reflejo de nuestro cosmos interior, no los dientes. ¿Quieres ver tu destino en ellos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: Los ojos son un reflejo de nuestro cosmos interior, no los dientes. ¿Qué esperas encontrar ahí?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: Vale, pues ven y echa un vistazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: Pero ten cuidado, sigo teniendo las astillas que me clavé armando atrapasueños.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: ¿Mis ojos? Pues claro, son cafés.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Bueno, si no cuentas las manchas rojas. La culpa es de la luna.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Ay... Las cosas que el universo me pone delante... Venga, echa un vistazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: Es difícil cuidarse con estas condiciones, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: ¡Ten cuidado! ¡Mi aura puede deslumbrarte!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: ¿Y bien? ¿Qué te parece?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Anda, mira lo que quieras, pero ten cuidado porque estas orejas lo oyen todo... hasta tus pensamientos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: ¿Y bien? ¿Encontraste lo que buscabas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: ¿Quieres dispararme por mis dientes? Entiendes que no soy yo, ¿verdad? Es que Marte está de morros con Venus.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: ¿En serio? ¿Me vas a disparar por tener astillas en las manos? ¡¿Es tan alto el precio de trabajar con atrapasueños?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: ¡¿Estás loco?! Sabes que solo es la luna gastando bromas, ¿verdad? ¡No es tan fácil seguirle la pista!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: ¡¿Estás loco?! Sabes que solo es la luna gastando bromas, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: ¡Esto no es astrología, es barbarie! ¿Por qué no dejas el arma y te cuento más secretos míos? ¡Lo haré gratis!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: ¡Eh! ¡No es mi rollo que no estuvieras listo para ello, cariño!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: ¿Puedes dejar esa cosa? ¿Qué sacas revisando en mis oídos? ¡¿Por qué no usas los tuyos para oír a la gente sabia?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: Si me matas, estarás condenado a...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: ¡Diarrea eterna!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: ¿Sabes? Una vez vino a mí un hombre con dientes perfectos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: Le dije: "¡Todo está bien, pero tu alma está podrida!". Piensa en lo que es más importante. ¿Lo pillas, verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: Una vez me desvelé sacándome astillas después de un ritual. Me dolió un montón, pero para mí fue como una lección del universo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: Los ojos son portales. Una vez vi a un hombre... sus ojos brillaban como ascuas. Dijo que era por amor, pero cosa de Marte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: ¿Sabes? Una vez estuve tres semanas dándome una vida austera y pensando solo en mis sueños.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: Verás, los pensamientos son manifestaciones y así es como hago que mis sueños se hagan realidad. Solo tengo que saber pedir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: Que curioso acordarme de eso ahora, justo en este momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: Una vez me hicieron una foto y como salí brillante, pensé: "¡Esta es una señal de los astros!". Y luego vi que solo era el flash.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: Una vez oí un sonido, como si el universo intentara hablarme. Pero creo que fue algo mucho más fuerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: Una vez oí un sonido como si el universo intentara hablarme. Al final, era solo una ventolera. Pero me moló igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: ¿Qué quieres revisar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: ¿Quieres ver mis dientes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: ¡MIS DIENTES SE ALZARON POR LA VERDAD!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: Y se cayeron por ella... Mártires.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: Mira, puedes verlo tú mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: Mantengo mis dientes limpios con una buena solución de cerveza. Protege el calcio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: Sin ella, habría perdido los dientes hace ya mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: Comprensible, desde luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: Están pasando tantas cosas ahora mismo, pero estamos vivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: Seguimos vivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: ¿Qué pasa? ¿Has estado sentado entre las sombras demasiado tiempo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: Ha llegado la hora de dormir, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: ¡Lo que tú digas, colega!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: Contempla mis sagradas uñas tanto como plazcas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: He entrenado para absorber la beneficiosa luz solar con ellas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: Y para abrir tapas de cerveza, ¡Claro que sí!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: ¿Solo quieres revisar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: ¡CONTEMPLA MIS OJOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: Están furiosos y coléricos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: ¡CONTEMPLA MIS OSCUROS OJOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: Los uso para absorber todos los beneficios lumínicos, transformándolos en energía.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: ¡Obtengo toda mi energía a través de MIS OJOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: ¿HAS VISTO EL GLORIOSO PODER DEL SOL EN MIS OJOS?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: De no ser así, estás ciego. Prueba mirar al Sol más tiempo, COMO YO.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: ¿Una foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: Hum... Hum-hum-hum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: ¿Alguien te ha dicho que he saludado al LÍDER SOLAR en persona?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: Sí, le enseñé a mirar al Sol, pero te contaré eso más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: ¡Venga! ¡FOTOGRAFÍA MI SAGRADA IMAGEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (Haces una foto al hombre desaliñado).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (Como se ve en la vida real, en la foto se ve lo descuidado y sucio que está).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (No percibes ninguna distorsión).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: ¡TODO HA SALIDO MARAVILLOSAMENTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: Pasa a verme luego y te contaré todo sobre mi vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: Pagándome alguna cosilla, desde luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: ¡Y LO GASTARÉ EN PRESERVAR LA ENERGÍA DEL SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: ¡Intenta disparar! ¡La verdad me protegerá!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: ¿Vas a guardar el arma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: Bueno, es muuuuuuy difícil sin una birra en mis manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: Muuuuuuy difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: Humano, ¿por qué estás haciendo esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: ¡TE HAS VUELTO UN LOCO DE LAS SOMBRAS, UN OSCURECIDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: Ojo por ojo, como dicen, pero luego te disparan por un par de ellos...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: ¡Bueno, bueno! ¡Pero esto ya es excesivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: Ten cuidado a donde apuntas esa cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: Espera, ¿no te gustan mis sagradas manos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: ¡¿POR QUÉ NO?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: Sois un idiota, un ignorante... y quiero una cerveza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: No eches miradas a donde no te incumbe, como dicen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: ¿Entonces qué se supone que haga? ¿Apartar la vista para siempre?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: Ah, espera un momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: ¿O era "no te metas..."?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: Un segundo, espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: Bah, me trae sin cuidado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: Así es.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: ¡No dispararías al Sol!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: Pero no te preocupes por mí. No me ofende que alguien actúe como un necio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: Siempre y cuando tengas una generosa reserva de frío líquido vital. Ya sabes, la palabra que empieza por "ce" y termina por "veza".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: Ah, ¿un amante de las bromas, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: Pues dales una olfateada, si eso es lo que deseas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: Este es el fruto del cuidado personal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: Ah, ¿un amante de las bromas, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: Pues dales una olfateada, si eso es lo que deseas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: Este es el fruto de los rayos vitales del Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: ¡Liberamos una humedad vigorizante para seguir viviendo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: ¿Qué quieres examinar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: E-Espera¿Qué? ¿Vas a tomar una decisión basándote en mis dientes? Ok...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: Me acaban de arreglar los dientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Aunque, para ser honesta...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: Realmente no recuerdo haber estado en el dentista. ¿Estuve siquiera allí?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: Madre mía, estoy tan nerviosa que ni siquiera recuerdo si comí ayer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: Así que... ¿Encajo en la descripción?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: ¿Soy una Visitante? ¿Cómo? ¡¿CÓMO?! ¡No puede ser!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: Ay, dios mío, me corrieron de mi hogar, me despidieron del empleo y ahora me van a echar de mi propia mente...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: ¿Quieres mirarme las uñas? Eso es un poco raro...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: Pero está bien, míralas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: ¿Qué tienen? No puede ser tierra, de ninguna manera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: Ni... Ni siquiera recuerdo haber estado escarbando en el suelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: ¿Cómo demonios se coló toda esta mugre dentro de mis uñas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: No podría andar sucia por ahí durante días. ¿Verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: Qué... extraño.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: ¡Imagínate! No me acuerdo de dónde salió toda esta tierra. Estaba sentada aquí, en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: ¿Alguien... Alguien me puso tierra debajo de las uñas a propósito? ¿Quién haría algo así?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: ¿Quieres mirarme los ojos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: Puedo adivinar cuál será el resultado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: ¿Qué pasa si tengo una de las señales?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: Sí, bueno. No es ninguna sorpresa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: ¿De verdad soy una Visitante? ¿Qué opinas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: ¿Y por qué no lo sabría? ¿Es así como la gente se convierte en ellos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: Tal vez el simple hecho de pensar que no eres como los demás te convierte en la peor persona posible para la sociedad.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: Tengo miedo de morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: Espera, ¿Puedo cubrir mis ojos? ¿Me puedes dar alguna venda?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: O al menos déjame quedarme un poco más.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: Si resulta que soy una Visitante, ¿empezaré a matar gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: ¿Me volveré peligrosa? ¿O siempre lo he sido?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: ¿Y si ya he matado gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (Le sacas una foto.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (Cuando la foto se revela, ves un cuerpo borroso y un fondo nítido.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (Es como si la persona se hubiera asustado al hacer la foto.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: Jajaja, ¿te imaginas? Solo me he asustado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: ¿Y ahora qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: ¿Puedes dejar que viva? ¿O sería mejor matarme? ¿Qué es lo que harás?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: ¿Por qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: ¿No sería más fácil dispararme y ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: Quiero marcharme, pero tengo demasiado miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: Quizá...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: No lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: Si me disparas, ¿me convertiré en algo aún más terrible?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: Quizá debería huir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: Pero ya ni sé si todavía soy humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: ¿Qué se supone que debo hacer?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: Justo como esos Visitantes en casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: Lo siento, fue terrible... Te lo mostraré.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: ¿Soy humana? ¿Sí? ¡Dime que soy humana, por favor!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: ¿Para qué me has pedido mirar si ibas a sacar la escopeta de todas formas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: ¿Disfrutas humillando a la gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: Menuda pesadilla. No puedes sentirte segura en ningún sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: un día, Los Visitantes podrían entrar en tu casa, y al siguiente, un chalado podría matarte porque sospecha de tus axilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: ¡¿ALGUIEN PODRÍA AL MENOS DECIR QUE TODO ESTARÁ BIEN?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: ¿Eso es todo? ¿Terminé siendo una Visitante solo por esa señal?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: De maravilla, el cuerpo me falla una vez más...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: Lo sé, está hecho un asco. Entiendo por qué me tenían miedo en el trabajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: Fui al hospital la semana pasada a causa de mi espalda... Creo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: ¿Fui... Fui también al dentista entonces?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: ¿Cuanto he gastado?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: ¿Qué quieres comprobar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: ¿Quieres que te enseñe los dientes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: Vale, echa un vistazo. Aún queda el olor a tristeza y a humo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Bien amarillos, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: Déjate de gilipolleces con tus pruebas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: No soy ningún Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: ¿De dónde coño han salido siquiera?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: ¿Las uñas llenas de tierra son una señal?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: ¡Bastaría con que se lavasen las manos!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: ¿Está insinuando que un jardinero se convertiría automáticamente en un Visitante, entonces?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: Menuda gilipollez'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Revisa mis uñas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: ¿Y bien? ¿Soy un Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: No lo creo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: Cada día es más ridículo que el anterior.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: ¿Y si no hubiera dormido? ¿O estuviera llorando?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: Ya no entiendo cómo funciona esto en absoluto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: ¿Y qué harás si una señal lo confirma? ¿O varias?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: Esta noche me convertiré en un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: Me pondré a llorar a propósito pensando en los buenos tiempos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: Todos estos puñeteros exámenes buscando señales, tíos en trajes amarillos...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: Todo está bien jodido...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: Una mierda, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: ¿No tienes la sensación de que nos estamos yendo directo al infierno de forma acojonante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Se supone que todo está bajo control, pero lo que hay nuestro alrededor es un caos absoluto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: Venga, has la puta foto de una vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (Le haces la foto.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (Está sentado tranquilamente, no completamente en el encuadre, pero no percibes nada inusual.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: Solo me da pavor lo que vendrá después.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: ¿¡Joder, en serio!? ¿Eres gilipollas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: ¿Te ha comido el cerebro la AFAE?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: ¿O te has pasado ya de copas? Creía que ya no quedaba de lo fuerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: ¡Pues, ya que insistes, aquí está!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: ¿Has visto todo lo que querías ver?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: ¿Has olisqueado hasta la saciedad?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: ¡Gracias por no hurgarme en el jodido culo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: Sé rápido.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: ¿Qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Mmm... Vale..'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: ¿Ya está?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: ¿Puedo tener algo de paz y silencio?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: ¿Las manos? Un segundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: Están cansadas de cargar al que se negaron a salvar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: ¿Puedes dejar de pedirme que haga estas gilipolleces?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: Si tanto quieres dispararme, simplemente dispárame.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: Ya no me queda fuerza...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: ¿Qué buscas? ¿Quieres ver si están irritados?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: Si es tan importante...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: Si muestro alguna emoción, ¿eso significa que soy una Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: ¿Podemos ser francos ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: No se está permitido ser feliz, ni llorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: Ni siquiera lo está hablar siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: ¿Qué queda? Estar sentado con la cara entre las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: ¿De verdad esto va a acabar tan fácilmente?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: ¿No más sufrimiento?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: Pero no te salvé, mi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: ¿De verdad? ¿No te parece humillante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: Nadie me ayudó a rescatar a mi marido y ahora...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: ¿QUIERES CONMEMORAR SU MUERTE?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: Es que no tengo palabras.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: Haz lo que te plazca y déjame en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (Le haces una foto.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (No notas nada inusual.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (El difunto acaba en el encuadre, lo que te obliga a reflexionar sobre la vida.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: ¿Ya estás feliz?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: A él le gustaban mis dientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: Yo quería ponerme ortodoncia, fíjate.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Claro, ¿por qué no dispararme, verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: ¿Acaso la gente puede siquiera llorar en este nuevo mundo? Reírse seguro que no.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: ¿Es que se te fue la olla?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: Por favor, dime, ¿¡ESTÁS LOCO!?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: Si esos demonios te dijeran que saltaras de un precipicio, ¿serías el primero en hacerlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: ¡Tú...! Pero... ¡joder! Es que no tengo palabras.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: ¿Y bien? Da igual que saques tu escopeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Joder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Dispárame de una buena vez. La AFAE ya me destrozó el alma. Bien podrías acabar con lo que queda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: Ya ni pienso en la ortodoncia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: Hasta que me ha pedido ver mis dientes, ni siquiera me acordaba que esa idea existía.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: Madre mía... Estoy hecha polvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: Lo pago con cualquiera que esté cerca, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: La culpa no es de nadie. Excepto de algunos canallas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: No lo entiendo. Y no quiero entenderlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: Humillar a alguien que acaba de perder a su...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: Un momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: Uf. Con que has sacado la artillería.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: Y, al final, ni te has dignado a matarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: ¿Qué ha sido eso? ¿Tus inseguridades? Está de más ventilarlas de esa manera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: ¿Qué es lo que quieres chequear?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: ¿Dientes? Vale, sí, no tengo rollo con los dientes. ¿Cómo los quieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: Mi colega era dentista.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: ¡A que no adivinas! ¡Le volamos todos los dientes! ¡JAJAJA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: Ah, quieres ver los míos. Vale, vale.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: Bien, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: ¿Qué cojones, tío? Era una historia perfectamente normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: Pero pegarme un tiro en la cara por mis dientes... No lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: ¿Por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: ¿Estás loco?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: ¡Tío, cómeme la po...!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: ¿Qué narices? Soy un tipo normal y corriente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: No hago guarradas con mis uñas, tío, ¿ves?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: No te confundas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: Me las lavo. Acabo de ver una moneda en el suelo y la cogí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: Están limpias. Hoy me lavaré las manos, tío. Venga ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: Me las lavo, tío. Que hoy no he tenido tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: Están limpias. Más o menos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: ¿Vas a cargarte a un tío solo por tener las uñas sucias?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: Vale. No pensaba morir de una manera tan gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: Parece una forma rara de identificar a esos monstruos, si te soy sincero.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: Se distingue a los sopla pollas y a los pringados por sus manos. ¿Qué tienen que ver los Visitantes con eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: Tendrías que levantarte a las nueve de la mañana y currar al menos cuatro horas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: Últimamente, me pican los ojos como cojones recién afeitados.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: ¿Crees que sea por el sol? ¿O qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: Joder, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: Esto es alguna clase de enfermedad.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: Mira, he pensado una cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: Vamos a sacarle la pasta a otros para no tener que reventarles la cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: ¿Qué? Venga, tío. ¿Tienes que pensártelo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: Bueno, si no te mola el rollo, lo entiendo. Pero te digo que de verdad tengo algo en los ojos, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: Si tan solo tuvieras unas gotas para los ojos...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: Aun así no las compraría. Tengo mis razones.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: ¿Quieres hacerme una foto? Venga.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: Te lo advierto, colega, soy muy sensible a la luz. Puede que me mueva.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (Le haces una foto.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (La foto parece normal, pero su cara...)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (Ha salido muy borrosa.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: Te lo dije, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: ¿Quieres hacer otra?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: Tío, ni pienses en timarme, ¿eh? Tienes que controlar a esos gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: Tenlos a raya.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: Que si no, se relajan, se olvidan de quién manda y no pagan.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: ¡Espera!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: Que te den a ti y a tu casa. Me largo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: Voy a pararme justo debajo del sol. Te lo dejo en su conciencia, comepollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: Hostia, joder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: Has elegido un chanchullo muy jodido, subnormal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: Aquí el jefe eres tú.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: Bueno, ¿cuál es el veredicto? ¿Todo bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: Dejarlo en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: ¡Espera, un momento! A ver, hostia, una vez probé a afeitarme y decidí seguir haciéndolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: Pero no se lo digas a nadie. No eres un bocazas, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: ¡Aguarda un momento! Es como si me pidieras que te enseñe mis calzoncillos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: Sí sabes que un tipo civilizado como yo no puede ir con las axilas quemadas, ¿cierto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: Sabía que eras de fiar. No ibas en serio a atacar a un tío normal, ¿cierto? Je.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: ¿Por qué no le metemos presión a esos capullos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: ¿No? Pues nada. Luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: Sé que te estás empezando a estresar por todos los Visitantes y esa mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: Y estás haciendo todo esto por nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: En fin, sin rencores. De verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: ¿Qué quieres revisar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: ¿Mis dientes? ¿Quieres que te enseñe mis dientes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: ¿Por qué? Todavía tengo dientes de leche. Papá solía decir que... snif... que...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: No, ya no voy a llorar más.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: Pues, aquí están.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: ¿Qué significa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: ¿Todo está bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: Ya sé cortarme las uñas yo solita.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: Todavía no se me da muy bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Mira'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: Muy chulas, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: Me las corté yo misma. Lo hice yo. Solita.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: Me voy a ir. Quiero estar sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: ¿Puedes mirar dentro de mis ojos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: ¿Verás en qué estoy pensando?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: Entonces pensaré con mucho cuidado, tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: ¿Por qué pones esa cara?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: ¿Acaso v-v-viste...?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: Tú... snif...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: Tengo s-s-sed.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: ¿Qué tengo que hacer?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (La miras y te das cuenta de que esto es excesivo).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: ¿Solo quieres saber cómo estoy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: Estoy muy cansada. ¿Puedo irme a jugar por mi cuenta?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: ¿Una foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: No me han hecho muchas fotos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: ¿Me la enseñarás después?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (Le haces una foto).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (La foto sale algo borrosa).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (Salió corriendo hacia ti sin esperar a que terminaras de hacerla).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Mmmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: Gracias'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: No me gusta. No me pidas más fotos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: Je. Pues venga, tesoro. Revisa si quieres. No vas a ver nada que no hayas visto antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: ¿Mis dientes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: Aaaaaah'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: Sabes, estos dientes... Uf, qué rabia les tenía. Pensé en quitármelos todos de una vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Mira estos dedos, no valen para contar, apilar ni medir como Dios manda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: Me dan lo justo. Lo justo para no quedarme sin nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Ay, alma... ¿Estás seguro de querer hacer eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: Los ojos son como ventanas, ¿sabes? Dan luz a las casas y muestran la verdad en las personas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: Pero mis ventanas están llenas de polvo... El vidrio está rajado... Las polillas se comieron las cortinas hace mucho...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: No, hijo, no mires. No hay nada ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: ¡Uy! Poner a una pobre vieja a levantar los brazos... ¿No te da vergüenza? ¡Apenas puedo mantenerme en pie!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Bueno, qué le vamos a hacer. El que manda, manda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: ¿Y bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: ¿Qué? ¿Para qué gastar rollo en mí? Se nota que no hay mucho... ¿Insistes? ¡Pues qué bueno, supongo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: ¿Y qué le parece, hijo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: ¡Jo! Ay, alma, qué ocurrencia la tuya.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: Son de lo más corrientes. Oigo como siempre. Pero, ¿sabes...? A veces, siento como si ya no estuviera aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: Es como si solo pudieran verme por un tragaluz y ni eso siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: Ay, ¿pero por qué me estás apuntando con ese trasto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: No hay cosa peor que una anciana desdentada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: ¿Crees que tengo miedo? ¿Crees que me aferro a estas viejas manos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Tantas veces he intentado agarrarme al aire que mis dedos ya saben que no hay nada que puedan sujetar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: Así que así es como está la cosa...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: ¿No me crees? ¿Quieres comprobarlo? Pues mira, echa un vistazo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: Yo también acostumbraba a mirar a los ojos de la gente. Y ahora a duras penas recuerdo esos días...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: Mira, esta es una señal de que los años pesan, ¿ve? A todos nos llega algo así con la edad. ¿No lo sabías?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: El hongo no siente dolor. No pide de comer. Simplemente existe. Vive por vivir. Como yo, je, je.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: ¿Qué, también vas a enfadarte por esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: Ay, ¿puedes acaso sacar algo por mis orejas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: Bueno. A mí me da lo mismo. Estoy a favor. ¿Qué más me da ya, hijo? Ya quiero verle, a Dios, después de tanto esperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: Es solo que...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: Le pagué a un médico para que me los quitara todos, pero no pudo hacerlo todo de una vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: Yo iba y me sacaba uno o dos por vez... No pudo quitármelos todos. Los médicos no tienen tiempo para esas cosas ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: Y bueno, alma, así es como vivo con este asunto inacabado en la boca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: Las manos son para quienes se aferran. Yo dejé de hacer eso hace ya mucho tiempo, alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: ¿Extender las manos? ¿Para qué? Puedes alcanzarlas tú mismo, al fin y al cabo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: Venga, entra y pasea por esta estrecha jaula...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: ¿Crees que puedes escapar de este destino? Pues, solo si llegaras a morirte de joven. ¡Pero no te hagas ideas!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: ¡Una cara tan guapa como lo tuya! Sería un pecado destruir tanta belleza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: En mis tiempos, solo los señoritos tenían estos cacharros. ¡Ahora, cualquier gañán puede usarlos!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: No tengo nada que decirte. Estás siendo un tonto. Molestando a buena gente sin razón...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: Vale, solo no atormentes a mi hermana.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: Siempre hemos tenido dientes fuertes en nuestra familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: Cuando era adolescente, intenté abrir una cerveza con los dientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: No acabó muy bien. Pero me enseñó a cuidar de mis dientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: Ahora mismo mi hermana no puede valerse por sí misma. Así que soy la única que hace cosas con las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: ¿Y qué aspecto deberían tener unas manos humanas cuando tienen que responder por dos vidas a la vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: Sí, mi hermana llora mucho, pero nuestros ojos siguen siendo muy parecidos. Aunque su mirada es un poquito más apagada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: Eso me preocupa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: Sí, mi hermana llora mucho, pero nuestros ojos son igualitos. No son rojos, al menos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: Puede que ya haya agotado todas sus lágrimas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: Se las muestro. Pero por favor no moleste a mi hermana, ¿sí? Está demasiado cansada para esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: Suelo afeitarme. Intento hacerme cargo de esas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: Incluso en estos tiempos de locura.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: Suelo encargarme de eso, pero no traje una cuchilla conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: De todas formas, apenas hay tiempo para eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: Mi hermana y yo hemos pasado por bastante en nuestras vidas. Por favor, guarda esa arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: Empecé a fumar hace poco. Por culpa de gente como usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: ¿Cree que solo usted lo está pasando fatal?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: ¿Se cree con derecho a apuntar con un arma a quien quiera?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: ¿Qué sentido tiene? ¿Mi mirada le pareció demasiado inquieta o vacía?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: ¿Qué sentido tiene? ¿Mi mirada le pareció demasiado vacía?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: ¿Cree que usted tiene mejor aspecto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: Debería tranquilizarse y no tomar decisiones impulsivas. Se lo digo a mi hermana todo el tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: Qué lástima tener que decírselo a usted también.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: Aguarda. ¿De verdad dijeron en las noticias que SEMEJANTE axila es una señal de ser un Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: Piense un poco más. No sea estúpido.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: Así que así termina la balada de mi vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: Agridulce, solo que sin lo dulce...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: La vida siempre puso a prueba nuestra fortaleza. Todo siempre fue tan duro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: Mi hermana no pudo soportarlo. Se dio por vencida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: Entiendo que está en una situación complicada con estas revisiones...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: Pero si se deja llevar por el pánico, ¿es realmente diferente de los Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: ¿Qué pasará si permanece aislado de los demás?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: ¿Sabe? Estoy hasta las narices de esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: En serio solo quisiera tomarme un respiro aquí y no vivir con miedo constante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: Pero cada día es lo mismo, y no parece que haya un final a la vista.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: Para ser sincera, estoy aterrada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: ¿Y después qué? ¿Van a desaparecer los Visitantes, o tendremos que compartir la vida con ellos para siempre?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: Hágalo y ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: Dientes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: Manos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: Ojos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: Oídos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: Eche un vistazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: ¿Me los va a arrancar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: Mi hermana me ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: Pero es inútil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: Ella debió...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: Debió haberme dejado morir en aquel entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: Mi hermana y yo tenemos ojos parecidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: Pero los suyos no están tan vacíos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: Mi hermana me depila las axilas. Siempre me atiende.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: Supongo que no ha sido en vano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: Sacar tu arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: Mejor así.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: Coge mi alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: No hace falta eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: La muerte ya está cerca, de todas formas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: Déjelo en mis manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: Deme la escopeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: Lo haré yo misma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: El vacío no se irá cuando cierre los ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: Solo se transferirá a usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: ¿Le gustaría eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: ¿Y bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: ¿Va a acabar con mi miseria?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: ¿No tiene el valor?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: Va a morir, de todas formas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: Lástima'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: Quizás para la próxima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: Lástima'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: No tengo ninguna de las señales.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: Quizás para la próxima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: ¿Y si solo nos estamos preparando para que un agujero negro nos consuma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: Seremos succionados por el horizonte de sucesos durante mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: Y nunca veremos nuestro propio final.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: Una agonía eterna anticipando a la muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: Da igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: Vale, entonces esperaré a que me llegue la hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: Mi canción...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: ¡Era para usted!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: ¡Tenía un final feliz!'
    m_Metadata:
      m_Items: []
