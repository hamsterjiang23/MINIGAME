    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507571
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507572
    m_Localized: Escucharle
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507573
    m_Localized: 'Cultist1: ¿Por qué te molestas con estos exámenes?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507574
    m_Localized: 'Cultist1: Solo debes estar listo para partir cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507575
    m_Localized: 'Cultist1: No sé qué es lo que esperas.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507576
    m_Localized: 'Cultist1: No tengo nada que decir.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507577
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507578
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507579
    m_Localized: 'Cultist1: Hace mucho que no me hacen una foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507580
    m_Localized: 'Cultist1:'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507581
    m_Localized: 'Cultist1: Tendrás que rendir cuentas por tus acciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507582
    m_Localized: 'Cultist1: Te has equivocado.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507583
    m_Localized: 'Cultist2: No hay por qué tener miedo. Todos partiremos hacia una vida mejor. Seremos salvados.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507584
