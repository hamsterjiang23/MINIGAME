    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507567
    m_Localized: 'Cultist1: No hay nada especial en esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507568
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507569
    m_Localized: Escucharle
    m_Metadata:
