  - m_Id: 41582931045507535
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507536
    m_Localized: 'Cultist1: Sono stanco di prepararmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507537
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507538
    m_Localized: Estrai il fucile
    m_Metadata:
