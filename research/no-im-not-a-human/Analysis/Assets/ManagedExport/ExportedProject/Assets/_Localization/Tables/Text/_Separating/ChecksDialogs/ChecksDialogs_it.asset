%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_it
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 9ca4ee10b5b962b4993a5133922046c2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: Certo, amico. *coff* Non ho nulla da nascondere. Tutto quello che avevo è bruciato.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Dai un''occhiata.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: Non *coff* essere troppo severo. Inalare del fumo non giova esattamente ai denti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Ecco, guarda... *coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: Sembrano due tronchi carbonizzati con i rami anneriti. Eppure, le unghie sono pulite. Buffo, non trovi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: Nessun problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: Visto? *coff* Sono rossi come due carboni ardenti. Tutta colpa del fumo, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: Sicuro? Non è un bello spettacolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: La pelle è screpolata come la corteccia di un albero. Non sollevo mai le braccia se non è necessario. Fa male.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: D''accordo, come vuoi. Ma non vedrai altro che un cadavere carbonizzato. Va sempre così...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: Allora, com''è venuta? *coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: Non c''è granché da controllare. Sono carbonizzate fino alla cartilagine.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: Finirò per perdere l''udito, prima o poi. Ma forse è meglio così...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Avanti, sparami se credi. Fammi solo un favore: non mirare ai denti. Tanto stanno già marcendo da soli.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Pazienza. Non ho più paura di nulla, ormai. Sparami, se per te è meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: Buona idea. A questo punto, potrebbe essere persino un gesto di misericordia...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: Hai idea di cosa hanno passato queste mani?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: Se questa foto deve segnare la mia condanna a morte *coff*, così sia. Tanto non ho più una vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Tutto torna alla cenere, prima o poi... Immagino che ora tocchi a me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: Sai *coff*, non sono mai riuscito a convincere i miei figli a lavarsi i denti. E ora non ci sarà più nessuno a insistere...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: Una volta *coff*, queste mani salvavano vite. Ora non riescono nemmeno a sollevare una tazza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: E così, questo è ciò che ho fatto della mia vita...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: È giunta la mia ora, immagino...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: Quando una foresta brucia *coff*, va tutto in cenere. E mentre la guardi, sai che non c''è nulla da fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: Ormai, mi sveglio la notte con la pelle che si lacera. Nulla lenisce il dolore. *coff* Le fiamme mi hanno portato via tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Giusto i ricordi sono rimasti intatti. Ma è solo questione di tempo prima che i nostri corpi vadano a fuoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: Quando le fiamme ti circonderanno, ricorderai la serenità e il silenzio di questi momenti. Ma non con le orecchie... Nell''anima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: Certo, fai i test che vuoi. Non avrò problemi a passarli tutti!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Prego, guarda pure.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: Hai mai visto denti del genere? È come avere un tesoro nascosto in bocca!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: Non sono nemmeno denti veri. Sono d''oro massiccio! Non tutti, certo. Ma prima o poi sostituirò anche gli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: Aprire una birra con gli incisivi è un gioco da ragazzi. Hai mai provato?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: Fanculo gli apribottiglie!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: Beh, per fortuna le ho ancora, le mani.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: Altrimenti non potrei più nemmeno andare in giro!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Aspetta un attimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: Le mie dita! Sono sparite!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: Ieri me ne mancava solo uno. Dove sono finite le altre?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: Bah, mi ricresceranno, prima o poi. Devo solo avere pazienza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: Il mio dito è sparito...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: Non è un dramma, ma non è che mi faccia piacere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: IN COMPENSO, L''UNGHIA MI STA RICRESCENDO, GUARDA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: Vuol dire che anche le gambe ricresceranno! Devo solo avere pazienza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: Dove vuoi che guardi? Devo fissarti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: Non fare caso agli spasmi. Ormai sono abituato...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Non sono mai riuscito a fissare nulla a lungo, nemmeno quando riuscivo ancora a premere l''acceleratore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: Immagino di non essere ancora pronto a ridurre la velocità, ti pare?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: Beh, certo. Perché no? Ah ah ah ah! Accidenti, mi fai morire!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: Ce l''hai fatta, amico. Sei ufficialmente il miglior comico al mondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: Ora ce ne stiamo qui a guardarci le ascelle a vicenda. Pazzesco...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: Il mondo sta andando a fuoco. È come se l''universo si stesse impegnando a farci fuori tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: Come se non bastasse, all''esterno ci sono i Visitatori in agguato, pronti a ucciderci tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: E tutto ciò che riesci a dire è "Mostrami le ascelle"?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: Ah ah ah ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: Vuoi scattarmi una foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: Non mi entusiasma l''idea di essere fotografato, ma accomodati.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: Diamine, ho chiuso gli occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: Ah ah ah ah! Ma certo, sei tu il capo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: Hai sentito anche tu quella trasmissione, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Già, niente male... Eh? Come?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: Aspetta un attimo, non l''hai sentita?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: Tu... non stai bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: D''accordo, non berrò più la tua birra. Non prenderla sul personale!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: Sai cosa succede a quelli come te, che si piegano troppo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: Che finiscono per spezzarsi. E si ritrovano su una sedia a rotelle come la mia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: Se proprio devi perdere le staffe, salta su e facciamo un giro. Vedrai cosa si prova.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: Perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: Non sarà di alcuna utilità.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: Nemmeno a te, beninteso. Quindi, perché perdere tempo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: Probabilmente non riuscirò a seguire il proiettile a occhio nudo, ma posso provare a schivarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: Non ho mai capito perché le persone perdano tempo a depilarsi. I peli sono una difesa naturale del corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: Vedi quello sfogo cutaneo tutto arrossato? Mi stanno crescendo delle altre dita.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: Oh, non abbiamo nemmeno iniziato a divertirci sul serio. Vedrai che risate!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: Quand''è che è andato tutto a rotoli?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: Cosa vuoi che mi importi di qualche foto del cazzo? La vita è troppo breve per queste sciocchezze, amico!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: Intendevo dire che...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Senti, lasciami in pace, ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: Beh, alla fine ciascuno miete ciò che ha seminato.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Presto o tardi, Dio fulminerà anche te.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: Beh, mi rifiuto di andarmene in silenzio! MAI! AAAAAARGH!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: È tutto scritto nel nostro codice genetico, dico bene?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: Un istante fa ridevamo insieme, e ora ci spariamo a vicenda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: Devo prepararmi per il mio ultimo viaggio...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: Le mani sono il mio unico motore, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: E non ho nemmeno le marce!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: A essere onesti, l''idea di poterle perdere mi terrorizza. Cosa farei se dovesse accadere?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: Sarebbe terribile non potersi spostare in alcun modo. Rimanere immobilizzati per sempre...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Nemmeno la morte mi spaventa tanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: Prima o poi, arriva per tutti il giorno in cui non reggiamo più, nonostante gli sforzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: Hai mai notato che più invecchiamo, più il tempo sembra scorrere in fretta?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: Quando eravamo ragazzini, la vita sembrava eterna. Era tutto così semplice. Nessuna responsabilità o decisione da prendere...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: Ora, invece, per quanto corriamo, non riusciamo mai a restare al passo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: Tutto d''un tratto, non ho più voglia di ridere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: I tuoi maledetti test, gli incendi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Vogliamo tutti salvare il mondo, eppure non riusciamo a metterci d''accordo su come fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: E a che pro, poi? Forse dovremmo semplicemente rilassarci e lasciare che tutto vada come deve.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Senti...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: Non credi anche tu che il nostro tempo su questo pianeta sia finito?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: Siamo prossimi al capolinea. Presto ci toccherà scendere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: Din don! Ultima fermata, i passeggeri sono pregati di lanciarsi dal finestrino.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: Tu pensi di essere pronto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: Sai, ci ho riflettuto a lungo... Prometti di non arrabbiarti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: Se... Se non riesci a fidarti di questo segno, come posso riuscirci io?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: Chi lo sa? Magari tutte le prove indicano che sono un Visitatore, o forse nessuna!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: La gente commette errori di continuo, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: Ma a volte gli errori hanno conseguenze terribili...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: Se... Se ora ti fidi di questo segno, come farò a fidarmi dei precedenti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Magari anche gli altri erano un mucchio di balle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: Siamo umani, in fin dei conti. Commettere errori è nella nostra natura.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: Ma a volte questi errori hanno conseguenze terribili.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Come nel tuo caso... Una mossa falsa, un dito che prude, e BANG!, qualcuno ne paga le conseguenze.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: Se hai fiducia nelle tue scelte, beh... Ammiro la tua sicurezza, non c''è che dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: D''accordo, fai tutti i test che vuoi. Non ho nulla da nascondere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Prego.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: In tutta onestà, non li ho mai curati granché. Non ne avevo il tempo. Ma ora... rimpiango di non averlo fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Ecco, guarda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: Sono badili, non mani. Tutto per i bambini.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: D''accordo, guarda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: Vedi le occhiaie? È perché dormo pochissimo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: D''accordo, guarda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: Ho finito il deodorante da parecchio, ormai. Non volermene.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: Posso sedermi? No?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: Uhm... Trasandata e irritabile, come sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: Non le pulisco da parecchio. Potrei persino avere qualche grumo di cerume.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: Sono già mezza sorda per via delle urla dei bambini.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: La settimana scorsa, le gengive hanno cominciato a sanguinarmi ogni volta che lavavo i denti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: E guarda, ho tutti i denti ingialliti. Come si fa a non fumare quando devi badare a bambini del genere?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: A furia di usare detersivi, mi è venuto uno sfogo. Non ho mai avuto tempo di andare da un dottore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: Potrei prepararti una zuppa con le mie mani, se vuoi. Eppure, il tuo primo istinto è impugnare il fucile...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Ah! Se anche mi lanciassi contro una granata, i miei brandelli non riuscirebbero comunque a riposare tranquilli.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: E ora cosa farai? Mi sparerai perché puzzo? Che razza di buffonata...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: Oh, andiamo. Ho sul serio un aspetto così terribile nella foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: Sei fuori di senno? Vuoi spararmi per via delle mie orecchie? Se non ti piacciono, indosserò un cappello!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: Finalmente, pace e tranquillità... Nessuno mi assillerà più...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: Che tristezza...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: Sai, uno dei miei bambini ha dei denti impeccabili, eppure non sorride mai. Magari i denti non c''entrano, che ne pensi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Le mani... Le ho sempre usate per abbracciare i bambini, sbrigare le faccende di casa e stringere mio marito. Ma nessuno l''ha mai apprezzato.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: Quando hai un figlio malato finisci per non dormire per giorni. Poi ti abitui, e ti ritrovi in una sorta di limbo insonne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: Una volta ero talmente stanca che non ho fatto la doccia per una settimana. I bambini non si sono accorti di nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: Una volta ho trovato una foto in cui tutti i bambini sorridevano. La notte, la guardavo fino ad addormentarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: A volte vorrei essere sorda. Ma quando i bambini dormono, c''è un silenzio impagabile... È quella la mia ragione di vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: Parli sul serio? Ma che cazzo...?! D''accordo, ma vedi di muoverti!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: Chi diavolo se ne importa. Toh...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: Sono gialli? Beh, si fottano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: Sono bianchi? Ovvio che sono bianchi! Sono una persona pulita, razza di stronzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: Ho pensato "Se proprio devo perdere i denti, tanto vale farmene mettere uno d''oro". Come i cattivi dei film, hai presente?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: D''accordo, come ti pare.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Guarda che roba!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: Ah! Mia nonna diceva sempre che con badili del genere avrei dovuto spaccare la legna, non... boh, fare altre cose.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: Ma qui attorno non vedo legna, quindi devo trovare un altro modo per sfogarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: Come ti pare... Guarda pure, se ti va.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: Niente male i miei occhioni blu, eh? Mai avuto bisogno d''altro per stregare una pupa. Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: Sai quanto me ne frega...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Sì, mi rado le ascelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: Mai sopportata la sensazione dei peli sotto le braccia. È come avere addosso dei maledetti cespugli.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: Sul serio? Razza di stronzo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: Che cazzo hai da fissarmi a quel modo? Che c''è che non va?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Merda...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: Che accidenti hai da fissarmi a quel modo? Non ti tornano i conti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: Ma ti sei bevuto il cervello, coglione? Ti ho solo mostrato i denti!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: Credi sul serio che non possa sgozzarti con le mie mani prima che tu riesca a premere il grilletto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: E ora che cazzo ti prende? Sei geloso, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: Prudono di continuo, mi mandano fuori di testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: A volte mi gratto fino a sanguinare. Solo a quel punto mi sento meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: Non rifilarmi queste stronzate! Sei solo un pazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: Vuoi spararmi solo per una stupida foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: Vedi di fare attenzione con quel fucile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Chi lo sa... Potresti spararmi per sbaglio solo per via delle mie orecchie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: Sei completamente fuori di testa, lo sai? E va bene... Fai quello che devi, stronzetto!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: Bastardo... Sei solo un lurido bastardo senza coscienza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Vai a farti fottere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: Mia nonna aveva un dente d''oro. L''aveva desiderato per tutta la vita, da quando ero piccolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: E come brillava! Sembrava avesse un piccolo sole in bocca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: Diceva che glielo avevano impiantato quando le era marcito un dente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: E io pensavo: "Cazzo, sicuramente ne daranno uno anche a me, quando sarà il momento".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: Ma ora quel momento è arrivato... e nessuno mi ha dato nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: E la mia bocca non brilla per niente. Ho solo questi vecchi denti gialli e puzzolenti...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: Vedi queste mani? Sono sporche di terra, sangue e chissà che altro... Ma sono mie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: A volte, le mani mi prudono al punto che vorrei strapparmi la pelle o prendere a pugni un muro. Insieme, magari.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: Non voglio fare del male a nessuno, ma non riesco a trattenermi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: Vedi queste unghie? Sono sporche di terra, sangue e chissà che altro... Ma sono mie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: A volte, le mani mi prudono al punto che vorrei strapparmi la pelle o prendere a pugni un muro. Insieme, magari.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: Se fossi diverso da come sono, il modo in cui mi lascio andare dovrebbe preoccuparmi. Ma a me non importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: Mia nonna mi chiamava sempre "angioletto", per via dei miei occhi. "Angioletto"... Incredibile, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: Ora me ne sto qui a fissare quelle finestre marce e fredde e penso: "Dove cazzo l''avrà visto, quell''angioletto?".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: Posso immaginare lo sguardo con cui mi fisserebbe oggi. Pieno di disappunto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: Sai, con un rasoio abbastanza affilato puoi fare... molte cose. Se solo fosse tutto così semplice...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: Ho finito per farmi dei tagli sul braccio. Ora, ogni volta che mi rado è come se tagliassi via una parte di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: Ma lo faccio ugualmente. Cazzo, detesto quei cespuglietti...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: Non ho nemmeno una foto della nonna. Non le sono mai piaciute.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: Diceva che quando ti scattano una foto, la tua anima resta intrappolata lì dentro per l''eternità.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: Scoppiavo a ridere ogni volta che lo ripeteva. E le rispondevo: "Dai, nonna, sono sciocchezze".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: Ma lei diceva: "Quando sarò morta, guarderai la mia foto e ti chiederai se sono in paradiso o meno".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: E ora non ho una foto e nemmeno mia nonna. Fanculo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: A volte, mi accorgo che sto tirando il lobo dell''orecchio, ma solo quando fa già male da morire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: Un tempo credevo si trattasse di un tic nervoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: Poi ho capito che voglio semplicemente strapparlo via. È come se mi desse fastidio...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: Ma non sono così fuori di testa da mutilarmi da solo, dico bene?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: DICO BENE?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Oh, tesorino... Sapevo che la tua energia avrebbe resistito. Ma avanti, prova i tuoi test. Riuscirò comunque a leggerti nell''anima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Prego, guarda pure.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: Il nostro mondo interiore si riflette negli occhi, non nei denti. Vuoi forse conoscere il tuo destino?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: Il nostro mondo interiore si riflette negli occhi, non nei denti. Cosa speri di vedere lì?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: D''accordo, guarda pure.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: Ma fa'' attenzione: mentre lavoravo ai miei acchiappasogni devo essermi ferita con qualche scheggia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: Ah, i miei occhi? Sono castani, come puoi vedere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Beh, fatta eccezione per le macchioline rosse. Sono causate dalla luna, sai.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Oh, l''universo mi mette alla prova in modi sempre nuovi... Molto bene, puoi guardare.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: Prendersi cura di sé in condizioni simili non è affatto semplice, come immaginerai...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: Fa'' attenzione, la mia aura potrebbe accecarti!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: Ebbene? Cosa ne pensi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Prego, guarda pure. Ma fa'' attenzione: alle mie orecchie non sfugge nulla, nemmeno i tuoi pensieri.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: Ebbene? Hai trovato le risposte che cercavi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: E vorresti spararmi a causa dei miei denti? Sai che sono innocente, vero? Sono Marte e Venere a essere in opposizione!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: Non parlerai sul serio, mi auguro. Vuoi spararmi per via di qualche scheggia dei miei acchiappasogni?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: Sei fuori di senno? Non capisci che è tutta colpa della luna? Non è semplice seguirne i movimenti!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: Sei fuori di senno? Non capisci che è tutta colpa della luna?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: Questa non è astrologia, piantala di fare il villano e abbassa quel fucile! Se lo fai, ti svelerò altri segreti senza pagare nulla!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: Suvvia, caro, non è certo colpa mia se non eri preparato!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: Ti dispiacerebbe posare quell''arnese? Cosa hanno le mie orecchie? Senza di esse, non potrei accogliere parole di saggezza!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: Se mi uccidi, sarai condannato...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: ... alla diarrea eterna!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: Ora che ci penso, un giorno ho incontrato un uomo con dei denti perfetti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: Gli ho detto che era tutto a posto, ma che la sua anima era marcia, e che doveva rivalutare le sue priorità. Capisci, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: Una volta, dopo un rituale ho passato una notte a estrarre schegge. È stato doloroso, ma ognuna recava una lezione sull''universo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: Gli occhi sono una finestra su altri mondi. Ho conosciuto un uomo i cui occhi ardevano come braci. Diceva fosse amore. Per me era Marte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: Sai, una volta ho passato tre settimane in ritiro spirituale, meditando esclusivamente sui miei sogni.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: I pensieri sono manifestazioni che consentono ai sogni di realizzarsi. Dovevo solo esprimere il desiderio giusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: È strano che tutto questo mi sia tornato in mente proprio adesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: Una volta mi hanno scattato una foto, e ho pensato di aver ricevuto un messaggio dalle stelle. Ma era solo il flash...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: Una volta ho sentito un rumore strano, come se l''universo cercasse di parlarmi. Ma credo che fosse qualcosa di persino più importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: Una volta ho sentito un rumore strano, come se l''universo volesse parlarmi. Poi era solo uno spiffero, ma è stata una bella esperienza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: Cosa vuoi controllare?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: Vuoi sul serio che ti mostri i denti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: I MIEI DENTI HANNO LOTTATO PER LA VERITÀ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: E sono anche caduti per difenderla... Dei veri martiri.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: Come puoi vedere da solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: Mi lavo i denti con un collutorio alla birra. Protegge lo smalto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: Se non lo usassi, avrei perso tutti i denti da un pezzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: Comprensibile, direi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: Il mondo è travolto dagli eventi, eppure riusciamo ancora ad andare avanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: Lottiamo per sopravvivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: Cosa? Sei rimasto all''ombra tutto questo tempo, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: È ora di riposare, amico mio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: Come vuoi, amico!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: Ammira le mie unghie benedette.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: Ho imparato a usarle per assorbire la salvifica luce del Sole.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: E per aprire le bottiglie di birra, ovviamente!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: Volevi solo dare un''occhiata?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: GUARDAMI NEGLI OCCHI!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: Sono colmi di rabbia e sdegno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: GUARDA IN QUESTI OCCHI SCURI!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: Li uso per assorbire i benefici raggi purificatori e trasformarli in energia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: Ottengo tutta la mia energia attraverso questi occhi!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: HAI AMMIRATO IL POTERE PURIFICATORE DEL SOLE NEI MIEI OCCHI?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: Se non l''hai visto, devi essere cieco. Prova a fissare il Sole più a lungo, come faccio io.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: Vuoi scattarmi una foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: Uhm...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: Ti ha mai detto nessuno che ho incontrato il LEADER SOLARE in persona?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: Già! E gli ho insegnato a fissare il nostro sacro Sole. Ma di questo parleremo in seguito.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: Avanti, allora... IMMORTALA LA MIA SACRA IMMAGINE!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (Scatti una foto dell''uomo sciatto)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (La foto lo ritrae fedelmente in tutto il suo sudicio e trasandato aspetto)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (Non noti alcuna distorsione)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: LODE, LODE! CHE RISULTATO MERAVIGLIOSO!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: Torna a trovarmi più tardi e ti racconterò della mia vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: Per un costo ragionevole, s''intende.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: CHE SPENDERÒ PER RACCOGLIERE L''ENERGIA DEL SOLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: Coraggio, spara! La verità sarà il mio scudo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: Potresti mettere via quel fucile?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: Beh, è molto difficile, senza una birra tra le mani.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: Mooolto difficile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: Suvvia, umano, perché mai dovresti farmi questo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: SEI IMPAZZITO A FURIA DI STARE ALL''OMBRA! SEI UN OSCURANTISTA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: "Occhio per occhio", dicono. Eppure, c''è chi è disposto a spararti, dopo averti guardato negli occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: Ehi, calma! Vediamo di non perdere la testa, ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: Occhio a dove punti quell''arnese.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: Che c''è, non ti piacciono le mie mani benedette?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: E PERCHÉ MAI?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: Sei uno sciocco, un ignorante. E voglio subito una birra.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: "Guarda a te stesso, prima di guardare gli altri", dicono.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: E io che dovrei fare, secondo loro? Distogliere lo sguardo in eterno?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: Oh, aspetta...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: Forse dicevano "Non ficcare il naso nelle faccende altrui"...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: Aspetta un secondo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: Chi se ne frega, cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: Proprio così.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: Non oseresti mai sparare al Sole!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: Ma non preoccuparti per me. Non mi offendo per sciocchezze del genere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: Non finché hai in fresco una generosa riserva del salvifico nettare!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: Ah, ti piace scherzare, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: Beh, annusale pure, se ti va.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: Sono i frutti di una buona igiene personale.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: Ah, ti piace scherzare, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: Beh, annusale pure, se ti va.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: Sono i frutti dei vivificanti raggi del Sole!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: Grazie ai suoi raggi benedetti emaniamo una corroborante umidità!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: Cosa vuoi controllare?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: C‑Cosa? Vuoi prendere una decisione in base ai miei denti? D‑D''accordo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: Ho appena fatto la pulizia dei denti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Anche se, a essere onesta...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: Non ho il minimo ricordo di essere andata dal dentista. Sarà accaduto sul serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: Dio mio, sono così nervosa che non riesco nemmeno a ricordare cosa ho mangiato ieri.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: Allora... Uhm... Rientro nel profilo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: Sono un Visitatore, dici? Ma com''è possibile? COME? Non può essere!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: Oddio... Sono stata costretta a fuggire da casa mia, ho perso il lavoro, e ora sento che sto per impazzire...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: V‑Vuoi sul serio vedere le mie unghie? È una richiesta piuttosto insolita...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: Ma d''accordo... Guarda pure...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: Sono sporche di terra? Ma non è possibile...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: I‑Io... non ricordo di aver scavato nel terreno...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: Come è possibile che questa robaccia mi sia finita sotto le unghie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: Non voglio credere di essere andata in giro in questo stato per tanto tempo. O no?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: È... assurdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: Non riesco nemmeno a immaginare da dove provenga questa terra. Sono rimasta qui in casa tutto il tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: E se... Se qualcuno me l''avesse messa apposta sotto le unghie? Ma chi farebbe mai una cosa simile?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: Vuoi controllarmi gli occhi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: Posso già immaginare ciò che noterai...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: Cosa accadrebbe se manifestassi uno dei segni?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: Beh, ovviamente. Non credo che qualcuno ne sarà sorpreso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: Sono sul serio un Visitatore? Tu cosa ne pensi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: Allora perché non ne ho alcuna coscienza? È così che la gente si trasforma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: Magari basta pensare di non essere come gli altri... Di essere degli emarginati.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: Ho paura della morte...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: A‑Aspetta... Non avresti qualcosa per coprirmi gli occhi? Una benda, magari?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: O... O magari, dammi ancora un po'' di tempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: Se dovesse venir fuori che sono un Visitatore, comincerei a uccidere le persone?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: Diventerò pericolosa? O magari lo sono sempre stata?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: Pensi che potrei già aver ucciso qualcuno in passato?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (Le scatti una foto)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (Non appena si sviluppa, noti un soggetto sfocato su uno sfondo perfettamente nitido)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (Sembra che il soggetto abbia avuto un sussulto al momento dello scatto)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: Ah ah ah, ma guarda, mi sono mossa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: Uhm... E ora cosa accadrà?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: Non potresti lasciarmi vivere? O credi sul serio che sarebbe meglio uccidermi? Cosa vuoi fare?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: Perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: Non sarebbe più semplice spararmi e basta?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: Vorrei andar via, ma ho troppa paura.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: Forse...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: I‑Io... Non lo so.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: Se mi spari, mi trasformerò in qualcosa di ancora più orribile?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: Forse dovrei semplicemente fuggire...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: I‑Io... non sono più sicura di essere umana.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: Cosa pensi che dovrei fare?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: Proprio come quei Visitatori a casa mia...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: Devi scusarmi, è stata un''esperienza terribile. Ora te le mostro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: Sono umana? Allora? Dimmi che sono umana, ti prego! Dillo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: Ah ah ah! Ma perché mi hai chiesto di vederle se volevi comunque puntarmi contro il fucile?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: Ti diverti a umiliare le persone?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: Che incubo... Nessuno è più al sicuro, ovunque si trovi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: Un giorno i Visitatori ti invadono la casa, il successivo un pazzo ti uccide per via delle tue ascelle...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: PERCHÉ NESSUNO DICE MAI CHE ANDRÀ TUTTO BENE?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: Tutto qui? Basta questo per essere bollata come Visitatore?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: Fantastico. Ancora una volta, è stato il mio corpo a tradirmi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: Sì, lo so, è tutto contorto... I colleghi al lavoro avevano tutti paura di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: La settimana scorsa sono andata in ospedale per via della schiena... O almeno credo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: Forse... sono andata anche dal dentista in quell''occasione?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: Quanto avrò speso...?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: Cosa vuoi controllare?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: Vuoi che ti mostri i denti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: D''accordo, guarda pure. Goditi l''aroma del fumo e della malinconia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Sono piuttosto ingialliti, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: Bene, piantala con questi stupidi test.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: Non sono un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: Chissà da dove provengono, poi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: Le unghie sporche di terra sarebbero un segno?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: Potrebbero semplicemente lavarsi le mani, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: O vuoi farmi credere che qualsiasi giardiniere sarebbe automaticamente un Visitatore?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: Che cumulo di stronzate.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Controllami le unghie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: Quindi? Sono un Visitatore?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: Non credo proprio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: Ormai la situazione si fa più surreale di giorno in giorno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: E se non avessi dormito? O avessi pianto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: Non riesco più a capire che senso abbia questa storia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: E se uno o più segni confermassero i tuoi sospetti? Cosa faresti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: Penso che stanotte finirò per trasformarmi in un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: Cercherò di piangere rievocando tempi più sereni.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: Tutti questi test per individuare i segni, quei tizi vestiti di giallo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: Questa storia...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: ... è un gran casino.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: Non hai mai la sensazione che stiamo per sprofondare all''inferno?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Dicono che sia tutto sotto controllo, ma intorno a noi non vedo altro che caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: E va bene, scatta questa dannata foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (Gli scatti una foto)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (È seduto tranquillamente, e per quanto non rientri completamente nella foto, non noti nulla di insolito)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: Il pensiero di ciò che potrebbe accadere mi terrorizza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: Parli sul serio? Ma sei un completo idiota?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: La FEMA ti ha bruciato del tutto il cervello?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: O sei semplicemente fatto? Credevo che la roba più pesante fosse finita, ormai...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: Beh, visto che ci tieni, te le mostrerò!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: Allora, hai ottenuto ciò che volevi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: Hai annusato per bene? Sei soddisfatto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: Grazie per non avermi perquisito il buco del culo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: Vedi di fare alla svelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: Cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Uhm... D''accordo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: Abbiamo finito?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: Potrei avere un attimo di pace, ora?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: Le mani? Dammi un secondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: Sono ridotte male, da quando devono portare una persona che si sono rifiutati di salvare.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: Ti spiacerebbe piantarla di chiedermi stronzate del genere?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: Se proprio vuoi spararmi, fallo e basta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: Ormai non ho più un briciolo di forza...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: Cosa cerchi, di preciso? Infiammazioni?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: Se proprio devi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: Se dovessi mostrare emozioni di qualche genere, significherebbe che sono un Visitatore?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: Posso essere sincera?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: Non si può essere felici, non si può piangere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: Non si può parlare liberamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: Cosa ci resta? Dobbiamo starcene in un angolo con la testa tra le mani?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: Basta sul serio così poco a far finire tutto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: Non soffrirò più?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: Ma non sono riuscita a salvarti...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: Dici sul serio? Secondo te non sarebbe umiliante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: Nessuno mi ha aiutata a salvare mio marito, e ora...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: VUOI UN RICORDO DELLA SUA MORTE?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: Non ho parole.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: Fa'' come ti pare e lasciami in pace.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (Le scatti una foto)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (Non noti nulla di insolito)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (La presenza del cadavere dell''uomo nella foto ti induce a riflettere sulla vita)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: Soddisfatto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: Gli sono sempre piaciuti i miei denti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: Io invece avrei voluto mettere l''apparecchio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Ma certo, perché non le spariamo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: Pensi che almeno ci sia concesso piangere in questo nuovo mondo? Perché di certo non possiamo ridere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: Sei impazzito, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: Rispondimi! SEI IMPAZZITO, PER CASO?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: Se quei dannati ti dicessero di saltare giù da un ponte, correresti a lanciarti per primo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: Tu... Cazzo, tu... Non ho parole.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: Allora? Tanto vale che metta mano al fucile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Dannazione...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Premi il grilletto, coraggio. Sono già morta dentro per via della FEMA, devi solo finire il lavoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: Era parecchio tempo che non pensavo più all''apparecchio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: Se non mi avessi chiesto di vedere i denti, futilità simili sarebbero rimaste nel dimenticatoio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: Dio mio... Sono esausta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: Mi sfogo sempre con tutti coloro che mi capitano attorno, ma in fin dei conti...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: Non è colpa di nessuno. A eccezione di qualche bastardo, s''intende.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: Non riesco a capire. E non voglio nemmeno provarci.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: Umiliare qualcuno che ha appena perso...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: Aspetta un momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: Oh! Quindi avevi messo mano al fucile, in effetti...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: E non hai avuto nemmeno la decenza di uccidermi, alla fine.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: Che problemi hai? Sei afflitto dalle tue insicurezze? Non è necessario sfoggiarle in quel modo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: Cosa vuoi controllare?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: I denti? Si può fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: Avevo un amico dentista.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: E indovina? Gli hanno fatto saltare i denti! AH AH AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: Ah, volevi vederli, giusto...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: Regolare, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: Ma che cazzo, fra? Pensavo fosse tutto regolare.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: Invece rischio di trovarmi con la faccia in poltiglia per colpa dei miei denti. Ma che storia è?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: Per favore?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: Ma sei fuori di testa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: Ehi, succhiamelo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: Cazzo dici, fra? Sono un tipo normalissimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: Non c''è proprio niente sotto le unghie, vedi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: Non farti strane idee.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: Le lavo, certo. Solo, ho visto una moneta per terra e l''ho raccolta. Normale, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: Sono pulite. Più tardi mi laverò le mani, amico, contaci. Andiamo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: Le laverò, fra. Non ho avuto proprio tempo di farlo, oggi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: Sono pulite... Più o meno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: Sul serio vuoi stendere qualcuno solo perché ha le unghie sporche?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: Caaazzo! Non credevo che sarei morto in un modo così idiota.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: Sembra un metodo piuttosto strano per localizzare quei mostri, fra. Sincero.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: Certo, puoi distinguere una carogna o un pollo dalle mani. Ma i Visitatori? Nossignore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: Dovresti alzarti alle nove e lavorare per quattro ore, come minimo. Non fa per me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: Ultimamente gli occhi mi prudono più delle palle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: Credi sia colpa del sole? Losco, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: Merda, fra.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: Ma che è? Un''epidemia? Roba di bacilli del cazzo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: Sentimi bene, ho un piano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: Puntiamo un''arma in faccia alle persone, poi le risparmiamo se scuciono la grana!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: Che c''è? Dai, bello, non è mica fisica nucleare.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: E va bene, la vita al limite non fa per te. Ci sta. Ma ho gli occhi tutti incasinati, fra.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: Se avessi del collirio o robe del genere...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: Non che voglia comprarlo, eh. Ho le mie ragioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: Vuoi scattarmi una foto? Come ti pare.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: Solo, tieni presente che la luce mi dà parecchio fastidio. Potrei muovermi quando scatti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (Gli scatti una foto)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (La foto sembra normale, eccetto un dettaglio...)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (Il volto è del tutto sfocato)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: Te l''avevo detto, fra.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: Vuoi scattarne un''altra?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: Non provare a fregarmi, fra. Tienimi in caldo quei babbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: Falli stare in riga.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: Altrimenti finiranno per rilassarsi, si scorderanno che sono a casa tua, e addio soldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: Aspetta!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: Fanculo tu e la tua casa del cazzo, io me ne vado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: Vado a piazzarmi proprio sotto il sole. Mi avrai sulla coscienza, stronzetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: Macheccaaazzo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: È una richiesta da maniaco, cazzone.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: Ma sei tu il capo, quindi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: Allora, qual è il verdetto? Sono a posto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: Aspetta un attimo, fermo! Ok, merda... Una volta ho provato a radermi e ho deciso di continuare a farlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: Non dire una cazzo di parola, capito? Non sei uno spione, vero? Allora?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: Dai, bello, non sono richieste da fare! È come chiedere a una tipa di vedere le mutande!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: Un gentiluomo come me non può mica avere le ascelle cespugliose, dico bene?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: Sapevo che eri un ometto a posto. Non faresti mai fuori un tipo normale come me, no? Eh eh!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: Ehi, perché non diamo una bella spennata a quei polli?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: No? Ci sta. Magari più tardi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: Lo so che sei stressato a mille per la storia dei Visitatori e tutta quella merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: E che stai facendo tutto questo per noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: Beh, senza rancore. Sincero, bello.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: Cosa vuoi controllare?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: I denti? Vuoi che ti mostri i miei denti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: Perché? Ho ancora i denti da latte. Papà diceva sempre...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: Non piangerò più.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: Va bene, ecco.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: Che significa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: Va tutto bene?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: So già tagliarmi le unghie da sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: Ma non sono ancora molto brava...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Ecco, guarda!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: Sono brava, non credi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: Le ho tagliate da sola. Senza nessun aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: Ora vado. Voglio starmene un po'' per conto mio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: Vuoi guardarmi negli occhi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: Vedrai anche quello che sto pensando?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: In tal caso, farò in modo di pensare molto attentamente, non preoccuparti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: Perché fai quella faccia?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: Hai v‑v‑visto...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: Tu... *singhiozza*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: V‑V‑Voglio una bibita.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: Uhm... Cosa devo fare?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (Osservandola, ti rendi conto che non è il caso)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: Vuoi sapere come mi sento?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: Sono molto stanca. Posso giocare un pochino da sola?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: Una foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: Non capita spesso che mi scattino foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: Me la mostrerai, dopo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (Le scatti una foto)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (La foto è leggermente sfocata)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (Ti è corsa incontro mentre stavi scattando)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Uhmmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: Grazie...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: Non mi piace molto. Non chiedermi altre foto, per favore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: Va bene, giovanotto, controlla quello che vuoi. Non troverai nulla che tu non abbia già visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: I miei denti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: Aaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: Sai, questi vecchi denti... Bah, un tempo li odiavo. Volevo strapparmeli via tutti, fino all''ultimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Guarda queste dita... Ormai non posso più intrecciarle, né usarle per contare o misurare.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: Fanno il minimo indispensabile. Quanto basta per continuare a vivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Oh, giovanotto... Sei proprio sicuro di volerlo fare?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: Gli occhi sono come finestre. Lasciano passare la verità, come le finestre fanno passare la luce.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: Ma i miei sono impolverati... Hanno i vetri rotti... E le tarme hanno mangiato le tende già da tempo, ormai...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: Non guardare, giovanotto. Non c''è nulla da vedere qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: Bah! Chiedere a una vecchia signora di alzare le braccia... Non ti vergogni?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Beh, che altro posso fare? Sei tu il proprietario di questa bella casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: Ebbene, giovanotto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: Perché mai dovresti sprecare della pellicola su una vecchia come me? Sarà rara, ormai. Ma se insisti...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: Allora, giovanotto. Cosa ne pensi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: Bah! Che razza di idee, tesoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: Sono del tutto normali. Ci sento ancora benone, ma a volte mi sembra quasi di svanire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: È come se fossi visibile solo da un lucernario, e nemmeno sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: Suvvia... Perché punti quel vecchio arnese su di me, tesoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: Cado già a pezzi da sola, e ora vorresti anche farmi saltare i denti? Bah!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: Credi di spaventarmi, tesoro? Che abbia paura di perdere queste mani rinsecchite?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Oh, sono rimasta così spesso con un pugno di mosche che le mie dita non riescono più a stringere nulla, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: E così, questo è ciò che ho fatto della mia vita...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: Non mi credi? Vuoi vedere con i tuoi occhi? Bene, guarda pure...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: Un tempo, anch''io scrutavo negli occhi della gente. E ora quei giorni mi tornano alla mente...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: Sono i segni della vecchiaia, caro. Chiunque viva fino a tarda età finisce per ricevere doni del genere, non lo sapevi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: I funghi non provano dolore. Non chiedono cibo. Si limitano a esistere, a vivere. Proprio come me, eh eh eh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: Oh, che seccatura... Ora perdi le staffe anche per questo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: Che c''è, giovanotto? Sei riuscito a capire qualcosa semplicemente guardandomi le orecchie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: Bah... Non importa. Pensi che abbia qualcosa da temere, giovanotto? È da tempo che attendo la fine, oramai.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: Solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: Ho pagato un dottore per estrarli tutti e togliermi il pensiero, ma mi ha detto che non poteva finire in una seduta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: Dovevo andare da lui e farne estrarre uno o due alla volta, non tutti insieme. I dottori non hanno tempo per queste faccende, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: E così, eccomi qui. Mi porto in bocca una seccatura ancora in sospeso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: Le mani servono a coloro che vogliono stringerle. E a me, purtroppo, non capita da molti anni.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: Stendere le mani? Bah! Se ci tieni, fatti avanti tu!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: Nel capanno della menzogna dalle sei dita... Entra pure, accomodati in questa misera gabbia...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: Credi di poter sfuggire a questo destino? Solo una morte prematura te lo consentirebbe. Ma non farti venire strane idee!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: Che faccino grazioso! Non possiamo certo sciupare un simile tesoro!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: Ai miei tempi, solo i più ricchi possedevano simili balocchi. Oggi, invece, ogni bifolco ne ha una!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: Non dirò più una parola! Non fai che insolentire la brava gente e rifilarle baggianate senza motivo... Bah!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: D''accordo, ma non tormentare mia sorella.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: In famiglia abbiamo tutte denti forti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: Quando ero una ragazzina, ho persino provato a usarli per aprire una birra.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: Non è finita bene, ma se non altro ho imparato a prendermi cura di ciò che è insostituibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: Al momento, mia sorella non è in condizione di prendersi cura si sé, quindi ho sempre le mani impegnate.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: Che aspetto dovrebbero avere le mani di una persona responsabile di due vite?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: Mia sorella piange di continuo, ma i nostri occhi sono molto simili. I suoi sono più placidi, forse.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: Questo mi preoccupa molto...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: Mia sorella piange di continuo, ma i nostri occhi sono molto simili. Sai, neanche i suoi sono arrossati.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: Forse ha già pianto tutte le lacrime che aveva.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: D''accordo, te le mostro. Solo, non infastidire mia sorella, intesi? È troppo stanca per queste sciocchezze.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: Di solito le depilo. Cerco di prendermi cura del mio aspetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: Persino in tempi del genere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: Di solito cerco di prendermi cura del mio aspetto, ma non ho un rasoio con me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: E comunque, non avrei tempo di usarlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: Io e mia sorella abbiamo già sofferto abbastanza. Ti prego, metti via quel fucile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: Ho cominciato a fumare solo di recente, per via di gente come te...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: Credi di essere l''unico ad aver passato dei brutti momenti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: Credi di poter puntare il fucile contro chiunque desideri?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: Che c''è? Il mio sguardo è troppo erratico o spento per i tuoi gusti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: Che c''è? Il mio sguardo è troppo spento per i tuoi gusti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: Credi forse che il tuo sia diverso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: Cerca di calmarti, non fare gesti avventati. Lo dico sempre a mia sorella.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: Purtroppo, sembra che debba dirlo anche a te.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: Aspetta... Al notiziario hanno detto sul serio che i Visitatori hanno ascelle come le mie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: Cerca di ragionare. Non fare gesti stupidi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: È così che finirà la mia ballata?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: Una melodia agrodolce cui manca la dolcezza...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: La vita mette sempre alla prova la nostra forza. È tutto così arduo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: Mia sorella non ce l''ha fatta. Si è arresa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: Capisco... Anche tu ti sei ritrovato in una situazione spinosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: Ma se cedessi al panico, non credi che mostreresti di essere della stessa risma dei Visitatori?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: Cosa credi che accadrebbe se ti isolassi dagli altri?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: Agh, non ne posso più.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: Vorrei solo prendere una boccata d''aria e smetterla di vivere nella paura.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: Ma ogni giorno è uguale al precedente, e non vedo alcuna luce in fondo al tunnel.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: A essere onesti, sono terrorizzata.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: Cosa accadrà adesso? I Visitatori scompariranno, o dovremo condividere le nostre vite con loro in eterno?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: Fallo e basta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: Mani
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: Occhi
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: Ascelle
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: Orecchie
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: Da'' pure un''occhiata.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: Hai intenzione di spaccarmeli?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: Mia sorella si prende cura di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: Ma è inutile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: Avrebbe dovuto...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: Avrebbe dovuto lasciarmi morire già da tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: Io e mia sorella abbiamo degli occhi molto simili.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: Ma i suoi non sono spenti come i miei.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: Mia sorella mi depila le ascelle. Ci tiene molto a me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: Immagino non sia stato uno sforzo vano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: Tanto meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: Prenditi la mia anima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: Non è necessario.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: La morte è sempre a un passo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: Lascia fare a me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: Dammi il fucile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: Ci penserò io.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: Quando chiudo gli occhi, il vuoto non svanisce mai...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: E ora diverrà tuo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: È questo che desideri?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: Allora, tesoro...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: Hai intenzione di premere il grilletto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: Non hai il coraggio di farlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: Morirai lo stesso, sai?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: Che peccato.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: Un''altra volta, magari.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: Che peccato.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: Non ho i segni che cercavi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: Un''altra volta, magari.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: Chissà, magari stiamo solo assistendo alle prove generali prima che un buco nero ci consumi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: Verremo risucchiati al suo interno, sospesi lungo l''orizzonte degli eventi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: Senza mai poter assistere alla nostra stessa fine.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: Un''eterna agonia che si consuma nell''attesa della morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: Non importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: Attenderò il mio turno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: Il mio canto...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: Era per te!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: Aveva un finale allegro!'
    m_Metadata:
      m_Items: []
