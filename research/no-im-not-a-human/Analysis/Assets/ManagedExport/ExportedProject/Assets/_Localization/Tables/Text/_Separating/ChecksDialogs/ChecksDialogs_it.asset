    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112392
    m_Localized: 'Alkonost: È la fine, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112393
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112394
    m_Localized: Lascia in pace
