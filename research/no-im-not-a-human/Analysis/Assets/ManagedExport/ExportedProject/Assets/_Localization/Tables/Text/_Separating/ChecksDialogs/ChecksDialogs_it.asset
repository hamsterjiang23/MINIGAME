  - m_Id: 41582931045507539
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507541
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507542
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507543
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507544
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507545
    m_Localized: 'Cultist1: Se è questo il tuo volere.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507546
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507547
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507548
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507549
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507550
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507551
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507552
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507553
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507554
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507555
    m_Localized: 'Cultist1: Ancora non è il momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507556
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507557
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507558
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507559
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507560
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507561
    m_Localized: 'Cultist1: Attento a ciò che desideri.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507562
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507563
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507564
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507565
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507566
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507567
    m_Localized: 'Cultist1: Non ne vale la pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507568
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507569
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507570
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507571
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507572
    m_Localized: Ascolta
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507573
    m_Localized: 'Cultist1: Dimmi... Perché perdi tempo con questi test?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507574
    m_Localized: 'Cultist1: È sufficiente farsi trovare pronti al momento della dipartita.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507575
    m_Localized: 'Cultist1: Non so cosa tu stia aspettando.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507576
    m_Localized: 'Cultist1: Non ho altro da aggiungere.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507577
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507578
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507579
    m_Localized: 'Cultist1: La mia immagine non viene immortalata da tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507580
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507581
    m_Localized: 'Cultist1: Risponderai delle tue azioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507582
    m_Localized: 'Cultist1: Hai commesso un grave errore.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507583
    m_Localized: 'Cultist2: Non hai nulla da temere. Saremo tutti accolti in un mondo migliore. Troveremo la salvezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507584
    m_Localized: Denti
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507585
