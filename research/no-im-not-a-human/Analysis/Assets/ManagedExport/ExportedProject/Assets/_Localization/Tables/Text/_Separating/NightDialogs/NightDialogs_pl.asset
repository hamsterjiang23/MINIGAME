%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_pl
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: e2adf5c0928e69a42a85516c84d58249, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Hej. *kaszle ciężko*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: Wpuścisz mnie, kolego?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: Co ci się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: Jestem *kaszle* strażakiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: Złapało mnie dziś słońce, gdy gasiliśmy pożary w lesie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: Dzięki gęstemu dymowi nie spaliło nas żywcem, ale *kaszle* wciąż przetrzepało nam skórę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: Drzewa… *kaszle ciężko* Paliły się jak zapałki.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: Nigdy czegoś takiego nie widziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: Runo było pełne tlących się trucheł zwierząt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: Dlaczego nie poszedłeś do szpitala?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: Co zamierzasz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Zaskoczyło mnie słońce *kaszle ciężko* podczas gaszenia pożarów w lesie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: Z mojego zastępu przeżyłem tylko ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Reszta… *kaszle* Szef nie pozwalał im odejść.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Teraz pełnią wieczną wartę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: Dlaczego nie poszedłeś do szpitala?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: Co zamierzasz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: Do szpitala? Nie ma już szpitali, kolego.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: Po pojawieniu się Przybyszy cała idea szpitali poszła z dymem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: Trudno o leczenie, jeśli nie można zaufać personelowi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: Teraz *kaszle* nikt mi nie pomoże.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Lepiej by było, jakbym został z kolegami i zginął, gasząc pożary.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: Niedługo i tak kopnę w kalendarz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: Chciałem dalej gasić pożary. Chciałbym sam tam umrzeć zamiast moich kumpli.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Przyznali jednak całkiem dosadnie *kaszle ciężko*, że dość się naharowałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Nawet nie wrócę do domu, bo transport publiczny nie działa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: Mogę jedynie liczyć na uprzejmość ludzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Dzięki, kolego *kaszle*.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: Długo ci chyba nie będę zawracał głowy *kaszle*.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: Przynajmniej nie muszę umierać samemu na gołej ziemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Kurcze, stary *kaszle*.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: Nie chcę umierać samemu na gołej ziemi…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: Oby *kaszle ciężko* pożary nie rozprzestrzeniły się do miast.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: Heeej, uszanowanko!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: Kopę lat. Jak leci?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: Czy ja cię znam…?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Nie żartuj… Naprawdę mnie nie pamiętasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: Byliśmy…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Chwilunia, twój głos brzmi jakoś inaczej…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: Od jak dawna tu mieszkasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Ten dom od zawsze należał do mojej rodziny
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Chyba pomyliłeś adres…
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Och, ty nie jesteś…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Nie jesteś moim kumplem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: Jak długo tu mieszkasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Ten dom od zawsze należał do mojej rodziny
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Chyba pomyliłeś adres…
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: Nie, nie może być.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: Nigdy w życiu się nie pomyliłem! Pamięć mam niezawodną, lepszą od słoni!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: Tu na pewno mieszka… hmm… mieszkał mój kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Musiałem tu kręcić od cholery i trochę. Wpuścisz mnie, proszę?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: Nieee, to niemożliwe…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: Nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: Szlag by to…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Chyba faktycznie się pomyliłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Musiałem tu kręcić od cholery i trochę. Wpuścisz mnie, proszę?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: Klawo! I o to chodzi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Wygląda przestronnie, ziomuś! Ścigamy się? 3… 2… 1… START!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: Odejść? Do jasnej cholery, co ty gadasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: Mam… zwyczajnie wziąć dupę w troki?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Och, ho, ho, ho. Kurwa, palę stąd gumy. Świrnięty zjeb!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: Wystarczy! Przestań się wiercić i stój spokojnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Dobry wieczór, czy może nam pan pomóc?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: Co się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: Czego pani ode mnie chce?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: Jestem wykończona. Potrzebuję noclegu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: Miałam pięcioro dzieci, ale tylko to mi się ostało.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: Mąż też przepadł. Nie wiem, czy nie żyje, czy nas porzucił, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Teraz muszę się położyć i przespać kilka dni.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: Co się stało z resztą pani dzieci?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: Czy pani dzieci nie żyją?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Chciałabym, żeby mnie pan wpuścił, bo muszę się wyspać. Padam z nóg…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: Miałam pięcioro dzieci. To tutaj jest ostatnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: Nawet nie wiem, gdzie zacząć ich szukać. Chcę tylko dobrze odespać.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: Co się stało z resztą pani dzieci?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: Czy pani dzieci nie żyją?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: Nie wiem. Może mąż je wziął. Pójdę do niego, ale teraz nie mam na to siły.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Owszem, bez przerwy się kłóciliśmy, ale ciężko inaczej, gdy twoja druga połówka to skończony kretyn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Wystarczy już o nim. Najważniejsze dla mnie jest odnaleźć moje dzieci.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Proszę wejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: Proszę tak nie mówić.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: Trudno jest opiekować się całą gromadką tych urwisów, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: Nic im nie jest. Pewnie odnalazły drogę do domu mojej mamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Zawsze do niej uciekają, gdy mają mnie dosyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: Albo gdy przychodzi ich ojciec żebrać o pieniądze… kolejny raz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: Wpuści mnie pan wtedy? Chcę tylko odpocząć i poszukać moich dzieci.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Proszę wejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: W końcu chwila odpoczynku.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Dalej, marsz do środka. Wybierz jakieś miejsce.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: Obiecuję, że jutro sobie pójdziemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: No dobrze. Postaram się wtedy pójść do mojej mamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Mogę nie dać rady…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: Nie, dojdę… Dojdę…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Dobry wieczór, domowniku.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Jestem w chuj złym nastroju, więc z góry przepraszam.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: Pełno wszędzie patafianów. Mam nadzieję, że pan do nich nie należy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: O kim pan mówi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: Nie jest pan… jednym z tych dziwadeł, prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: O wszystkich.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: Ogół skurwieli, których przed wzajemnym mordem powstrzymywała wyłącznie religia lub inne idiotyzmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: Razem z ich bogami umarło także ich człowieczeństwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Zachowują się teraz jak pieprzone zwierzęta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Jak gdyby cały ten chlew z Przybyszami nie wystarczył… Jeszcze z nimi musimy się, kurwa, użerać!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: Co pana tak nakręciło?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: A pan czym się od nich różni?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Znakomite pytanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: Na pewno nie uszło pana uwadze, że ludzie dzielą się na dwie zasadnicze… grupy, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: Do jednej należą wszyscy ci pojebani sadyści, gorsi od Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: Robią, co im się żywnie, kurwa, podoba. Przyłożyliby panu broń do głowy po to, by popatrzeć, jak trup pada na ziemię!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: Do drugiej natomiast wszystkie głupie owce. Można im wejść na głowę i jeszcze w rączki pocałują za łaskawość.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: Od obu tych typów ludzi aż krew mnie zalewa…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: Co pana tak nakręciło?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: A pan czym się od nich różni?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: Proszę nie brać tego osobiście. To tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Ten pierdolnik ze słońcem i teraz z tymi, psiamać, Przybyszami, sprawia, że ludzkość zdaje się leżeć z Bogiem w trumnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: Aż kipię ze złości… Chciałem wieść normalne życie, wie pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Komponowałem muzykę. Teraz to wszystkim koło dupy lata.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Staram się nie trafić do żadnej z wymienionych grup.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Proszę wejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: Chcę wierzyć, że jestem inny.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: Wie pan, sram w gacie ze strachu, myśląc o staniu się jak jeden z tych szaleńców.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: Albo jak bezradna ofiara. Obie strony niech się pierdolą.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Mówiąc jednak prosto z mostu…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: Ofiary są gorsze.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Siedzą tylko i czekają, aż dostaną po ryju, czy coś.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Pojąłby pan moją złość, gdyby widział pan to, co ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Proszę wejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: Proszę się nie martwić, nie będę sprawiał kłopotu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: I nikogo nie pobiję.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: Gniew kieruję przeciwko sobie, by nikt inny nie musiał cierpieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Jasny gwint, jest pan tak samo popieprzony, jak reszta tych zaszczanych tchórzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Będziesz pan tylko siedział i przyjmował bęcki w ryło.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: Ja pier‑kurwa‑dolę!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Wyczuwam, że energia tego miejsca jest w stagnacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: W środku szykuje się coś wyjątkowo złego.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: Słońce i Lew są w Piątej Sadybie. Widzę to bardzo wyraźnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: Zdaje się, że jest pan nadzwyczaj asertywną osobą?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: Słucham?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: Niczego od pani nie chcę
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Dostrzegam, że woli pan czyny od słów.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Typowy Lew, nieprawdaż?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: Zgromadził pan tutaj olbrzymie pokłady ciemnej energii. Tak… Nad wyraz nieprzyjemna…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: Nie rozumiem jeszcze po co ani dlaczego…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Wszystko wydaje się wielce zaniedbane. Przypuszczam, że winnam zacząć od afirmacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Wielkie dzięki, jakbym nie miał dość problemów na głowie
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: Niech tak będzie, i co teraz…?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: Nie chcę się narzucać, drogi panie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: Chcę jedynie pomóc zrozumieć związek przyczynowo‑skutkowy cierpienia ukrytego za tymi murami.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Karmiczna szóstka i dziewiątka, jak dwie okrążające się ławice ryb.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Przysługa za przysługę. Rozumie pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Wielkie dzięki, jakbym nie miał dość problemów na głowie
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: Okej, i co z tego…?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: To dla pana zapewne stresujące, gdyż należy pan do wschodzących Koziorożców.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: Balansuje pan w sobie kilka gwiazdozbiorów. Wielowymiarowa z pana osoba.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: Możemy wykorzystać afirmacje, aby dotrzeć w głąb pana wewnętrznego kosmosu. Rozumie pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Wtedy wszystko nabierze sensu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Proszę wejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: W pana poprzednich wcieleniach są strażnicy więzienni.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Proszę dać im przestrzeń. Powtarza pan jedynie doświadczenia uprzednich inkarnacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Musi im pan wybaczyć i zaakceptować w sobie ich dzieje.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Tylko w ten sposób przełamie pan okowy nieskończonego cyklu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: Czy to dla pana jasne?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Proszę wejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Ach, wybornie. Muszę przyznać, że mieszka pan w znakomitym miejscu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: Przez pana dom płynie silny prąd pozytywnej energii.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: Czyli nie chce pan popracować nad sobą, czy dobrze rozumiem?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: Nie interesuje pana stanie się lepszym człowiekiem?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Straszna szkoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Zamanifestuję u pana wyjątkowo przykrą sraczkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Dobry wieczór panu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: Jestem funkcjonariuszem FEMA. Robimy obchód w pana okolicy i dozorujemy mieszkańców.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: Jest pan sam?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: Dlaczego miałbym panu zaufać?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: Nie, naturalnie, że nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: Podzieliliśmy oddział na mniejsze grupy, żeby sprawdzić większy obszar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: To nie zajmie dużo czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: Dlaczego jest pan w ubiorze ochronnym? Czy my też powinniśmy taki nosić?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: W jaki sposób nam pomożecie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: Mogę się wylegitymować, jeśli to pomoże.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: Przybysze rzadko przemieszczają się w grupach. Może nawet nigdy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: Dlaczego jest pan w ubiorze ochronnym? Czy my też powinniśmy taki nosić?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: W jaki sposób nam pomożecie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: Nie, ale może pan taki kupić dla poczucia bezpieczeństwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: Wciąż badamy wpływ słońca na środowisko.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: Musimy zachować ostrożność, bo spędzamy dużo czasu na zewnątrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: Więc co dalej?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: Czy FEMA ma jakiś plan działania?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: Naszym pierwszym obowiązkiem jest zebranie więcej danych i przesłanie ich do sztabu FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Po ich wysłaniu sztab będzie mógł opracować odpowiednią procedurę reagowania.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: Teraz musi pan jedynie zachować spokój.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: Więc co dalej?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: Czy FEMA ma jakiś plan działania?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Wezmę ze sobą jedną osobę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: Sprawdzimy, czy z nią wszystko w porządku i czy może bezpiecznie dalej mieszkać w tej okolicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: Oczywiście zweryfikujemy też, czy jest człowiekiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: Czy muszę coś ze sobą zabrać?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: Mam więc tylko tu czekać, aż coś zacznie się dziać?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Naturalnie. Nie możemy jednak podejmować żadnych działań bez odpowiednich danych.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: Weźmiemy więc z nami jednego z pana gości do laboratorium.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: Zrobimy tej osobie kilka badań weryfikujących, że wszystko jest w porządku, i puścimy ją do domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: Czy muszę zacząć się pakować?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: Mam więc tylko tu czekać, aż coś zacznie się dziać?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: Czy jest pan właścicielem tego domu?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: W takim wypadku nie. Proszę zostać z pozostałymi domownikami. Jeśli zajdzie potrzeba ewakuacji, damy znać.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Zabierzemy tylko jedną osobę i sobie pójdziemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: Życzę dobrej nocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Tak. Jak tylko będziemy mieli więcej danych, udostępnimy instrukcje wszystkim obywatelom.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: Na tą chwilę nie ma powodów do zmartwień.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Wezmę tylko jedną osobę i dopilnuję, żeby wróciła tutaj jak najszybciej.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Dobranoc panu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: Znów się spotykamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: Przy naszej ostatniej rozmowie sprawy miały się nieco inaczej. Wciąż jednak żyjemy…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Hm… To coś dziwnego, nie umiem tego wytłumaczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Chciałbym rozpocząć naszą rozmowę… od wróżby.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: Przepowiedz mi przyszłość, wybierając stronicę z tej księgi. Gdzie mam ją otworzyć?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Gdzieś przy początku
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Dokładnie po środku
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Na końcu
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: „Niedługo przemówią zmarli, ale wszyscy będą mieli za nic, co rzekną”.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Wielkie nieba…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: Jakże zaskakująco trafne.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Chociaż nie powinno mnie to teraz dziwić.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: Co to oznacza?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: Czy naprawdę w to wierzysz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: Kim jesteś?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: „Ja? Jestem sobą. A ty? Byłaś domem”.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Hm. Tak. Zaiste tragiczna historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: Czy właśnie to nas czeka?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: Całkiem możliwe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: Co to oznacza?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: Czy naprawdę w to wierzysz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: „Było to tak dawno temu. Może to był sen. Być może ty, ja i ryby…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: …istniejemy już tylko w pamięci osób, które odeszły.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Może nikt tak naprawdę nie istnieje, a w rzeczywistości tylko wciąż pada deszcz”.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Hm… Zdaje się, że wszystko może już niedługo naprawdę zniknąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: Jak uważasz? Czy żyjemy w snach innych? Czy to może są nasze sny?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: To ciekawy wers.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: Co to oznacza?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: Czy naprawdę w to wierzysz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: Muszę to uważnie przemyśleć. Czy masz jakieś wskazówki?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: W każdym razie przyszedłem tylko, by ci coś powiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Wkrótce będą miały miejsce pewne wydarzenia…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Musisz być gotów.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Może to zabrzmi dziwnie, ale… musisz wpuścić kota.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: Nie potrafię teraz tego wyjaśnić, ale jestem pewien, że okaże się pomocny.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: Oczywiście nie musisz brać tej informacji do serca.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: Jeśli chodzi o mnie, chyba pójdę pogłowić się nad głębszym znaczeniem twojej wróżby.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: Niezupełnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: Odczytałem to bardziej jako poradę. Abyś o czymś nie zapomniał lub jako zwrócenie uwagi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Podczas gdy rozmyślałem o tego głębszym znaczeniu, przyszła mi do głowy pewna idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Kiedy z kotem spojrzycie sobie w oczy, pamiętaj wpuścić ich w swe progi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: Nie umiem teraz powiedzieć dlaczego. Powinien jednak ułatwić pewne sprawy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: Teraz zagłębię się w zadumie nad wybranym przez ciebie wersem z książki.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Bądź opromieniony, człowiecze.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: Radujmy się, że dane nam jest doświadczyć sądu ostatecznego!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: Ziemia oczyszcza się z grzechu. Słońce wykonuje swą boską powinność.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: Wkroczyliśmy na ścieżkę do niezbrukanego, nowego świata!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: OTO PROMIENIE BŁOGOSŁAWIEŃSTWA, KUTAFIKSY!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: Słucham?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Nie strasz mnie pan
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: Czy wciąż błądzisz, człowiecze?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Czekaj, rozrysuję ci to, dobra?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: Słońce nie bez kozery podpieka i smaży nas żywcem! Oczyszcza nas z grzechów!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: Nasze żądze i chciwość zbrukały ten świat, co rozjuszyło Słońce!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: TO NASZ OSĄD!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: A także błogosławieństwo, koniec grzechu. Będziemy żyć jako bogobojne popioły pod jego spojrzeniem, do cholery!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: Czyli… musimy zginąć?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: A co się stanie z tobą?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: Trzęsiesz portkami? Czy doszczętnie ocieniałeś?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Czekaj, rozrysuję ci to, dobra?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: Słońce nie bez kozery podpieka i smaży nas żywcem! Oczyszcza nas z grzechów!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: Nasze żądze i chciwość zbrukały ten świat, co rozjuszyło Słońce!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: TO NASZ OSĄD!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: A także błogosławieństwo, koniec grzechu. Będziemy żyć jako bogobojne popioły pod jego spojrzeniem, do cholery!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: Czyli… musimy zginąć?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: A co się stanie z tobą?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: Wprost przeciwnie!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Nasze grzechy zostaną odkupione. Może nawet samo Słońce zniknie. MY JEDNAK BĘDZIEMY ŻYĆ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: Nie będzie śmierci, kradzieży ani chciwych chujów, którzy nie godzą się sprzedać mi towaru po mojej, uczciwej, cenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: Wyobrażasz to sobie? Czy widzisz, dlaczego to wszystko ma miejsce?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: A co to ma wspólnego ze mną?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: Wszyscy będziemy żyć w dostatku, jak tylko Słońce dokona swego dzieła!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: Jego święte promienie pomogą nam uciec od tej męki, nie widzisz tego?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: Na pewno widzisz, inaczej byłbyś martwy!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: ZNAKOMICIE, CZŁOWIECZE! Możemy to dogłębnie przedyskutować!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Och, zanim zapomnę zapytać, masz może piwo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: Czy właśnie udawałeś ignorancję wobec Słońca?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: To spieprzaj, dziadu! PÓJDĘ URATOWAĆ KOGOŚ INNEGO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: Nara, dupku żołędny! DOWI‑KURWA‑DZENIA!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: D‑dobry wieczór!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Przepraszam, że przychodzę tak późno… Za dnia był skwar, a w telewizji mówili, żeby nie wychodzić na słońce…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Czy może… znalazłoby się u ciebie dla mnie miejsce?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: Jak tu trafiłaś?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Umm, mieszkałam blisko miasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: Asfalt się tam roztapia, jak pewnie możesz sobie wyobrazić, heh. He, he.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: Pracowałam przy kasie w lokalnym sklepie. Znaczy się, przez jakiś czas. Teraz już nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: Zwolnili mnie… Zawsze miałam pecha z pracą…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: Co teraz poczniesz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: Jak myślisz, co się stanie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: To nie tak, że chciałam tu przyjść. Asfalt może i roztapia się na paćkę pod butami, ale mogło być gorzej.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: Chodzi o… będziesz się śmiał, heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: Pod moje drzwi przyszli Przybysze. Heh… dasz wiarę?! Przegonili mnie z własnego domu!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Teraz staram się znaleźć schronienie przed słońcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: Co teraz poczniesz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: Jak myślisz, co się stanie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Uhmm… Chcę jakoś przeżyć? Na zewnątrz jest strasznie z pałętającymi się wszędzie Przybyszami i palącym słońcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Naprawdę nie chcę umierać. Heh, heh. Uhhh…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: A ty się nie boisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Powiedz mi, proszę, że to wszystko wkrótce przeminie…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: Nie wiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: Czy przeżyję? Czy ktoś mnie poratuje? Ile mi zostało czasu, by znaleźć pomoc?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: Nie mam bladego pojęcia, co może się wydarzyć. Ciężko mi nawet zgadywać.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: Czy to wszystko nie przejmuje cię lękiem? M‑mnie przeraża.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Dziękuję! Ha, ha! Dziękuję bardzo, naprawdę!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Dzięki Bogu, teraz przeżyję odrobinę dłużej.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Ha, ha, ummm… okej, rozumiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Dziękuję, że mnie chociaż wysłuchałeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: Um, okej… najwyraźniej powinnam sobie pójść.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: Do widzenia? Tak, ee, do widzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: Czy mogę wejść?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Schroniłem się w barze niedaleko, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Wyrzucili mnie. Tak po prostu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: Dlaczego? Phi. Zdaje się, że nie wszyscy obecni uważali moją osobowość za szczególnie… sympatyczną.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Nikogo nie skrzywdzę, nie martw się. Ja tylko… Życie jest czasem do bani, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: Więc co ty na to, miły gospodarzu? Wpuścisz mnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: Nie jesteś Przybyszem, co?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: Na pewno nie będziesz sprawiał kłopotów?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: Czy wyglądam jak te potwory?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: Nie, nie jestem Przybyszem. A ty nigdy nie otrzymasz szczerej, kurwa, odpowiedzi, pytając o to wprost.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: Zdaje się, że tutaj będzie podobnie jak w barze.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: Dlaczego wyrzucili cię z poprzedniego schronienia?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: Dlaczego uważasz, że tu będzie inaczej?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: Co masz na myśli, mówiąc „kłopoty”?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: Mord i przemoc budzą we mnie głębokie obrzydzenie. Nie dam sobie jednak w kaszę dmuchać.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Przepadam za dobrym jadłem i napitkiem. Lubię pogadać, gdy jestem w humorze. Czy to brzmi jak „kłopoty”?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: Dlaczego wyrzucili cię z poprzedniego schronienia?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: Dlaczego uważasz, że tu będzie inaczej?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: Chciałem właśnie ci ubliżyć, ale przemilczę to.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: Mówiłem już, że komuś tam musiałem nadepnąć na odcisk. Bóg wie, kto to był.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Teraz, kiedy o tym myślę, może to dobrze, że mnie wyrzucili.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Mogliby mnie tam zeżreć żywcem i nikt by nawet nie zauważył.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: Co innego miałbym zrobić? Stać pod drzwiami i czekać, aż mnie słońce usmaży?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: Tego bym nie chciał.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Jak długo żyję, będę szukał kogoś do rozmowy. Jeśli to nie tu, może poszczęści mi się gdzieś indziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: Jeśli pozostała mi w tym życiu choć krztyna pomyślności, to może nie będzie to skończony dupek.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Dziękuję. Zaufanie do ludzi nie ma dziś żadnego znaczenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Doceniam jednak twoje zaufanie. Może nawet… Nie, nie powinienem niczego obiecywać.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Hm. Rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Pojmuję twój tok myślenia, ale nadal mnie to wkurza. Jesteś takim samym tchórzem, jak wszyscy inni w tym mieście.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Dobrej nocy, miły gospodarzu. I wypierdalaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: Czy mogę wejść i chwilkę odpocząć?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: Skąd przyszłaś?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: Dokąd pójdziesz dalej?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: Nie pamiętam. To bez znaczenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Jestem wykończona. Jeśli nie wypocznę, padnę pod twoim oknem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: Czy twój kolega jest chory?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: Czy twój kolega potrzebuje pomocy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Pewnie… gdzieś mnie zwali z nóg i nigdy już nie wstanę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: Nie obchodzi mnie, dokąd dotrę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: Czy twój kolega jest chory?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: Czy twój kolega potrzebuje pomocy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: To mój mąż.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Nie żyje.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: Nie mogę go normalnie pochować. I nie ma też sensu, żebym go teraz zostawiła.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Już nie. Gdy jej potrzebował, nikt mu jej nie udzielił.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: Teraz jest martwy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Mógłby dalej żyć, gdyby…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: Kogoś to obchodziło.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: Nie zostanę długo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: Muszę tylko trochę wypocząć.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Ty…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: Joooł!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: Widziałeś, jaki bajzel się odjebuje? Paranoja!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: A u ciebie wszystko w porządeczku, mordo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: Czego chcesz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: Co się niby dzieje?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Tak naprawdę to niczego. Tylko ciekawym.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: Ale mam odjechany sposób, żebyś zgarnął łatwą kasiorę. Zainteresowany?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Podczas gdy wszyscy skomlą jak mazgaje o słońcu, ty możesz zarobić grubą forsę bez kiwnięcia palcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: Reszta leszczy sra w gacie, a powinni główkować, jak robić siano!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: Dlaczego tu przyszedłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: No dobra, słucham
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Jestem tu, by zaoferować ci nowe możliwości, chłopie. Szanuj pomyślunek!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Wszyscy biegają w kółko jak tchórze, zamiast robić to, co jest naturalne i prawdziwe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: Chodzi mi o to, że muszą poczuć szczęście. Powaga!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: Dlaczego tu przyszedłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: No dobra, słucham
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: Prosto do sedna! To mi się podoba!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Wszyscy uważają, że coś tu kombinujesz, wpuszczając tylu ludzi, że coś knujesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: Wykorzystajmy to i urządźmy największą bibę w historii! Impreza na koniec świata, ziom!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: Umieranie to nie część planu, kolego!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Trzeba kuć żelazo, póki gorące. Jebać słońce!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: Czas wstać i zarabiać! Czaisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: No i zajebiście, ziom! O to chodzi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: W końcu ktoś, kto czai bazę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: Och, rozumiem, pojebało cię. Z początku nie zauważyłem, mój błąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: Może twoi sąsiedzi bardziej docenią mój geniusz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Do zobaczenia w piekle, miękka pało.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Czołem, sąsiedzie. Chwilę się nie widzieliśmy. Jak życie?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: Bez zmian
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Dobrze
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Będę szczery, przyszedłem z pewnego powodu. Zaczynam się o ciebie martwić.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Coś naprawdę złego zmierza w naszym kierunku.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: Właśnie rozmawiałem z kuzynką przez telefon. Powiedziała, że w telewizji podają, że coś dziwnego dzieje się ze słońcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: I że spod ziemi wyłażą ludzie. Z jakiegoś powodu zwą ich „Przybyszami”.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: Upiorne, prawda? Oby to były bujdy…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: Co się dzieje ze słońcem?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: Przybysze?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Będę szczery, przyszedłem z pewnego powodu. Zaczynam się o ciebie martwić.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Coś naprawdę złego zmierza w naszym kierunku.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: Właśnie rozmawiałem z kuzynką przez telefon. Powiedziała, że w telewizji podają, że coś dziwnego dzieje się ze słońcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: Mówili też, że spod ziemi wyłażą ludzie. Z jakiegoś powodu zwą ich „Przybyszami”.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: Upiorne, prawda? Oby to były bujdy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: Co się dzieje ze słońcem?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: Przybysze?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Albo ma eksplodować, albo coś na nim ma wybuchnąć… nie mam pewności.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: Wiem tylko, że coś z nim nie tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: Na pewno zauważyłeś, że to lato było najgorętsze w historii, no nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: Myślę, że powinniśmy przygotować się na najgorsze.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: Kuzynka mówiła, że przebywanie samemu w domu jest niebezpieczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: Wpadłem więc upewnić się, że nie stanie ci się krzywda… albo coś gorszego.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: Okej
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: Potrafię o siebie zadbać
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: Jak twoja żona i córka się trzymają?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Tak właśnie nazywają ludzi spod ziemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: Bóg jeden wie, dlaczego.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: Może dlatego, że przybyli na Ziemię? Lub przynajmniej na jej powierzchnię.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: Albo dlatego, że łażą wszędzie i starają się wchodzić ludziom do domów.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: Kuzynka mówiła, że przebywanie samemu w domu jest niebezpieczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: Wpadłem więc upewnić się, że nie stanie ci się krzywda… albo coś gorszego.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: Okej
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: Potrafię o siebie zadbać
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: Jak twoja żona i córka się trzymają?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: Doskonale. Dokończmy wtedy tę rozmowę rano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: Spotkajmy się w kuchni, jak się obudzisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: Do zobaczenia rano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: Wiem, że potrafisz. Ale chyba nie zdajesz sobie sprawy, jak niebezpiecznie jest być teraz samemu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: Co powiesz na to, żebym został u ciebie na noc, tak na wszelki wypadek? Byłbym wtedy spokojniejszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: Nie martw się o moją rodzinę. Jest z nimi teraz mój dobry przyjaciel. Opiekuje się nimi pod moją nieobecność.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: Doskonale. Dokończmy wtedy tę rozmowę rano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: Spotkajmy się w kuchni, jak się obudzisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: Do zobaczenia rano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: Nie martw się o moją rodzinę. Jest z nimi teraz mój dobry przyjaciel. Opiekuje się nimi pod moją nieobecność.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: Doskonale. Dokończmy wtedy tę rozmowę rano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: Spotkajmy się w kuchni, jak się obudzisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: Do zobaczenia rano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: Dzień dobry!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: Czy jest tu mój tata? Czy może go pan zawołać?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: Wcześniej było okej, ale teraz bardzo się boję. Dzisiaj w nocy jest tu dużo dziwnych ludzi…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: Jak ma na imię twój tata?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Powiedz mi coś o swoim tacie
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: Nie wie pan, jak tata ma na imię? Och, rozumiem, sprawdza pan, czy nie jestem Przybyszką.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: Jest pan mądry! Też zacznę zadawać wszystkim pytania, by ich sprawdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: Jakim cudem doszłaś tu w jednym kawałku?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: Boisz się Przybyszy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Hm, dużo o nim wiem. W końcu jest moim tatą.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: Lubi wypić piwo przed wyjściem na dwór. He, he!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: A kiedy wychodzi, zawsze zostawia mi pyszny obiad i kolację. I soczek!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: Dzisiaj i ja spróbowałam tego piwa. Fuj! Było ohydne!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: Dlaczego ktoś miałby to pić, kiedy mogą wypić sok?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: Och, proszę mu nie mówić, że to zrobiłam!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: Jakim cudem doszłaś tu w jednym kawałku?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: Boisz się Przybyszy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: Nie wiem, teraz wszystko wydaje się na opak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: Ludzie są w domach i śpią w dzień, a potem wychodzą nocą, robić różne rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: Wciąż boję się ciemności, ale chyba nie ma się czego obawiać.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: Czy może jest…?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: Pójdę po twojego tatę. Powodzenia!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: Miłego dnia!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: Ja… nie wiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: Wszyscy się ich boją, więc może też powinnam. Nie widziałam jeszcze żadnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: Czy są straszni? Czy mocno biją?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: Jeśli tak, może mój kolega ze szkoły jest Przybyszem. Wciąż mnie bije.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Tata powiedział, żebym była ostrożna. I byłam, bardzo, bardzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: Skradałam się to po cichutku. Nikt mnie nie widział.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: Pójdę po twojego tatę. Powodzenia!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: Miłego dnia!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: Dziękuję, panu też!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: Chcę iść do domu… Tu jest strasznie…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: Będziemy grali w nową grę wymyśloną dla mnie przez tatę. Rzuca się kostkami!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: I wtedy przesuwa się meble, na przykład fotel albo kanapę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: Aby wygrać, trzeba ułożyć z nich górkę przy drzwiach. Pokażę panu innym razem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: Do widzenia!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: D‑dobry wieczór.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: N‑n‑niech pan mnie wpuści.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: Coś cię przeraziło?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: Co się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: N‑nie wiem, c‑co mam z‑z‑zrobić.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: L‑l‑ludzie…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: Y‑yyy…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: Z‑z‑zabili m‑mojego ta…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: M‑m‑mojego… m‑mo…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: T‑tatę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: Kto to zrobił?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: Dlaczego to zrobili?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: Y‑yyy…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: M‑m‑mój t‑ta…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: O‑oni z‑z‑zab…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: Zabili m‑mojego t‑tatę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: Kto to zrobił?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: Dlaczego to zrobili?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: P‑p‑przybysze do n‑nas przyszli. S‑siedzieli z n‑nami…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Tata z n‑nimi o czymś r‑rozmawiał. A p‑potem oni go… z‑zabili.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: On… *pociąga nosem* Nasz… *płacze*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: Teraz nasz d‑dom się p‑p‑paaali…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Wejdź, dziecko
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: Odejdź, dziecko
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: N‑nie wiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: S‑siedzieli t‑tylko z tatą w k‑kuchni.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: A wtedy coś z‑zro… z‑zrobili i p‑podpalili d‑dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: Kiedy u‑uciekałam, s‑słyszałam, jak się ś‑śmieją…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Wejdź, dziecko
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: Odejdź, dziecko
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: P‑pomoże mi p‑pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: B‑boję się.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: A‑ale… dokąd m‑mam pójść?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: Ja… ja… tak b‑bardzo się b‑b‑boję!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: *zanosi się płaczem i wyje*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: *płacze i wyje wniebogłosy*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: Uszanowanko!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: Czego chcesz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: Nie wpuszczę ciebie
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: Ale masz przestronny domek.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: Podoba mi się.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: Niczego od ciebie nie chcę
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: Mam broń
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: Czy drzwi są solidne i wytrzymałe?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: Nigdy nie wiadomo, co może się z nimi stać.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: Sam rozumiesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: Niczego od ciebie nie chcę
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: Mam broń
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: Tak, to prawda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Więęęc…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: Czy jesteś sam?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: Nie, nie jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Tak, jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: Pysznie!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: W desperacji nawet tchórz nabiera odwagi, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Więęęc…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: Czy jesteś sam?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: Nie, nie jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Tak, jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: To twój szczęśliwy dzień.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: Słyszę w środku jakieś szepty.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: Ale kto wie, gdzie oni będą za kilka dni?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: Ha, ha, ha, ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: Wiem, że jesteś sam.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: Sprawdzałem tylko, czy będziesz kłamał.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: Wproszę się do środka.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: Dobry wieczór, kochaniutki! Strasznie się sfatygowałam, kuśtykając pod twoje drzwi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: Czy wolno mi na chwilkę wejść i wytchnąć?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: Słucham? Specjalnie przyszła pani tutaj piechotą?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: Jak długo pani szła?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: Nie, nie, nie… nie miałam w zamyśle tu przybywać, nie żartujże tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: Lecz toć los zwykł przecinać ścieżki nasze. Każde z tych spotkań cel swój ma, kochaniutki.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Jam tu stanęła, znaczy to, iż stopy przywiodły mię tu nie na marne. Oczy me nie przypadkiem spoczęły na twej chałupie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: Takoż zawżdy było przeznaczone… jak mniemam.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: Nie rozumiem. Czy pani czegoś potrzebuje?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: Mogła pani pójść dalej. Dlaczego zatrzymała się pani akurat tutaj?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: Pfuj! A cóż znaczy „długi” spacer, powiadasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: Patrzajże na się! W izbie siedzisz, a ileż to kroków powziąłeś, by się tu dostać?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: Czyliż to ty od dawna tak chodzisz? Zaiste musiałeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: Jam przemaszerowała przez więcej dekad, niż tyżeś miał ciepłych wieczerzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: Tymże właśnie się różnimy, kochaniutki.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: Nie rozumiem. Czy pani czegoś potrzebuje?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: Mogła pani pójść dalej. Dlaczego zatrzymała się pani akurat tutaj?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: Pfuj! A czegoż to ludziom brakuje, kochaniutki?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: Dachu nad głową, by rzeknąć historyjkę lub dwie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: Legnąć w spokoju i przymknąć powieki bez troski.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: I tchu jeno do oddychania, jak mniemam.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: Wiele mi nie trza, samotny żywot jeno to rzecz srodze nużąca.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: Pfuj! Uszu nie myjesz, kochaniutki?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: Dość mam chodzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: U ciebie ja bym mogła wytchnąć i przyjemnie poplotkować.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: Takiej starej babinie, jak ja, więcej nie trza.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: Ty mi coś rzeczesz, a jać w zamian opowiem ci powiastkę. Będzie tedy po równo, jak przystało.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: Może wtenczas me stare kości ździebko by odpoczęły.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: Dziękuję, kochaniutki!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: Widzę, żeś rozrywkowy gospodarz. A ja może dowiem się, co się tu dzieje.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: Pfuj! Wszyscy mi każą iść precz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: Skrzydła me podcięte, lecz wciąż rozwieram usta i śpiewam.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: Z czasem wszyscy ku mnie kroki swe zwracają… Choć prawią, iż nigdy tego nie uczynią.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Żalu nie chowam. Pomagam każdemu, kto mię nawiedzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: I tobie, kochaniutki, przyjdzie kiedy o ratunek prosić. Do kogóż wtenczas się zwrócisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Witam. Och, tutaj, oprzyj się o mnie przez moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: Czy masz może… dla nas miejsce?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: Czy pani koleżanka jest chora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: Czy obie panie są chore czy tylko jedna z was?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: To moja siostra. Cierpi na depresję.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: Nie ma siły chodzić ani myć się. Czasem ledwo wstaje z łóżka.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: Ale nie jest źle. Kiedyś się jej polepszy. Prawda, siostro?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: Nie jest teraz w humorze na rozmowę, ale czasem znajduje na to siłę.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: Co panie zamierzają dalej?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: Nie męczy pani noszenie jej wszędzie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: Wszyscy w pewnym stopniu cierpimy na depresję.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: Wiedziałyśmy, dokąd wszystko zmierza, nawet zanim zaczęły się te problemy ze słońcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: Oglądał pan wiadomości? Wszystko do tego zmierzało. Nie sądzę jednak, żeby słońce miało wybuchnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: Co panie zamierzają dalej?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: Nie męczy pani noszenie jej wszędzie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: Muszę znaleźć miejsce, w którym siostra może poczuć się trochę wygodniej.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: Wtedy rozpoczniemy nowe, wspólne życie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: Mówią, że to koniec naszego istnienia…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: Nie zgadzam się z tym. Moim zdaniem od tej chwili wszystko powinno być łatwiejsze.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Niech panie wejdą
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: Powinny panie odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Niech pan zważa na słowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: Tak, jest to męczące. Nigdy bym jej nie zostawiła, jeśli to ma pan na myśli.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: Razem wyniosłyśmy się z domu rodziców. Mamy tylko siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Niech panie wejdą
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: Powinny panie odejść
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: Dziękuję! Proszę mi pomóc ją wprowadzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: Zdaje mi się, że śmierć rodziców pogorszyła jej stan, ale jest w nim od dłuższego czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Może się z tego trochę otrząśnie podczas pobytu u pana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Oj. Siostro, musimy próbować szczęścia u kogoś innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: No, chodź, idziemy. Musisz mi trochę pomóc, siostro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: Mój boże, kiedy to się skończy…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: Przed wyjazdem do pożarów rozdawali nam w pracy takie kwitki.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: To wezwanie do stawienia się w strefie kwarantanny FEMA. Ale po co tam iść, skoro wszyscy tam umierają?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: Trzymaj, ja go nie potrzebuję. Możesz go wyrzucić lub użyć do czegoś innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: Mam przy sobie *kaszle* taki świstek. To jakiś ważny dokument.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: Dam go tobie, jeśli mnie wpuścisz. Pozwól mi dokonać żywota w spokoju…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Nie, zatrzymaj go sobie
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: Co jest z tobą nie tak, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: Widzę, że równy z ciebie gość. Może puszeczka EnerJeki zmieni twoje zdanie? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: Zmachałem się, kurde, jak dziki wieprz, turlając się aż tutaj! Co za maraton!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: Zasłużyłeś na puszkę EnerJeki! Dzięki za pozwolenie na wjazd, amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: Kurwa… Ja pierdolę, kurwaaa…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: Dobra. Może, kurwa…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: Może dam panu puszkę EnerJeki? Wpuści mnie pan wtedy?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: Ja nie zginę marnie, a pan dostanie chłodny, orzeźwiający napój. Wszyscy, kurwa, zadowoleni.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: Spieprzaj pan
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: Proszę się o mnie nie martwić… Ja tylko… ja pierdolę… Dobra, bierz to pan…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: Bierz pan EnerJekę.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: Muszę trochę, kurwa, ochłonąć, a nie pić to gówno.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: Widzę, że {0} tu jest. To jasne: wszyscy mówią szeptem i robią dosłownie wszystko, żeby nie urazić tej osoby.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: Nie zdzierżę jednak tego towarzystwa. Albo wóz, albo przewóz. Ktoś z nas musi odejść.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: W chuj nienawidzę mieszkać z ludźmi, który duszą w sobie absolutnie wszystko.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: Wtedy precz stąd
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: Masz anielską, kurwa, cierpliwość.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: Mam nadzieję, że zabierzesz głos, gdy sprawy wymkną się spod kontroli.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: Postaram się… No wiesz. Zachować spokój.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Wspaniale, abso‑kurwa‑lutnie, fanta‑kurwa‑stycznie.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: Pewno przymilenie się do obecnych już w chacie jebańców wydaje się bezpieczniejsze, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: Koło chuja mi latasz, dupowłazie. OBYŚ ZCZEZŁ W PIEKLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: Oto i hojna nagroda od Przenajświętszego Słońca: twoja własna puszka EnerJeki! Zasługujesz na nią, człowiecze!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: Czy aż taka z ciebie zakuta pała?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: Przepędzasz prawego i sprawiedliwego człowieka!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: Wpuść mnie, a zostaniesz hojnie obdarowany przez Przenajświętsze Słońce we własnej osobie! Zgódź się i bądź błogosławiony!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: Spieprzaj pan
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: Nikt nie wie, co zaszło, gdy przybył ostatni Przybysz.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: Dom przez dość długi czas stał pusty.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: Po twoim przerażającym zniknięciu budynek został opuszczony i unikano go jak ognia.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Dobry wieczór, kochaniutki… Kogoż tam masz w izbie? Czy to {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: W jednejże chwili rozgardiasz srogi, a w drugiej jeno szepty w cieniach szemrzą. Takie miejsce lęk w mym sercu budzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: Nie bez przyczyny sama chadzam, gwar ludzki ni ciżba w domu to nie dla mnie rzecz.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Niechaj zostanie, jeśli cenisz tę osobę. Przycupnę gdzieś i poczekam, aż wichry zmian przeminą. A zawieruchy nie znoszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: Moje stare kości by tego nie zniosły… w sam pył bym się rozsypała.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: Załatwię to. Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: Wtedy idź pani precz
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: Jeśliżeś pewien… Lecz gdy burza grzmotnie, albo gdy lustereczko skłamie, odejdę. Za stara jużem na takie dyrdymały.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: Pfuj! Tak coś czułam, że tutaj nie należę… Wezmę swoje powiastki i wnet stąd idę.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Jednakże nasłuchuj bacznie, kochaniutki… Najzjadliwsze prawdy najciszej bywają szemrane.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: Proszę…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Niech pan nas wpuści chociaż na jeden dzień. Mamy coś, co może się panu przydać…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: Tak, wynagrodzimy to panu…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: Dobra, niech panie wejdą
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: Fora ze dwora
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: Dziękuję uprzejmie!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Proszę wziąć tę puszkę EnerJeki. To wszystko, co mamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: Czy może mi pan pomóc wnieść siostrę?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: To pewnie nie najlepszy pomysł, skoro {0} tu jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: Powietrze wokół tej osoby gęstnieje, jakby jej myśli przytłumiały moje własne.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: Moja siostra by tego nie zniosła. Tylko… pogrążyłaby się w sobie. Jakby w ogóle nie istniała.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: Mnie… także ciężko coś takiego ścierpieć. Trudno wziąć oddech.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Przepraszam, ale poczekamy aż… sprawy się tam uspokoją. Może ta osoba sobie pójdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: Załatwię to. Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: Wtedy won stąd
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Dziękuję. Proszę uważać, trzeba objąć ją ręką… o w ten sposób.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: Przez śmierć rodziców… coś w niej pękło. Pomimo tego stara się trzymać, jak tylko może.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: Trochę się tutaj włóczyłyśmy. Miałam nadzieję, że u pana poczuje się troszkę lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: Rozumiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Wytrzymaj jeszcze trochę, siostro. Wkrótce znajdziemy miejsce, gdzie odpoczniesz. Oprzyj się o mnie, właśnie tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: Czasami wszystko może nas… przerastać. Nawet zwykłe zamknięte drzwi. Musimy jednak iść dalej. Chodź, trzymam cię.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: Dzięki, kolego *kaszle*.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: Długo ci chyba nie będę zawracał głowy *kaszle ciężko*.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: Przynajmniej nie muszę umierać samemu na gołej ziemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: Przed wyjazdem do pożarów rozdawali nam w pracy takie kwitki.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: To wezwanie do stawienia się w strefie kwarantanny FEMA. Ale po co tam iść, skoro wszyscy tam umierają?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: Trzymaj, ja go nie potrzebuję. Możesz go wyrzucić lub użyć do czegoś innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: Kłaniam się nisko. Proszę mi powiedzieć… czy mogę panu zaufać?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: Nie jest pan funkcjonariuszem FEMA, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: Zaufać w jakiej sprawie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: Nie, nie jestem z FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: W sprawie arcyważnych informacji, ma się wiedzieć!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: Potrzebuję bezpiecznego azylu, aby kontynuować moje badania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: Dysponuję dokumentami zawierającymi poufne informacje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: Iście wybuchowe tajemnice państwowe. Wszystkie zamierzam ujawnić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: Jakiego rodzaju tajemnice?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: Skąd ma pan te informacje?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: Och, klawo. To znaczy, że mogę panu zaufać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: Widzi pan, według protokołów FEMA agenci muszą potwierdzić przynależność do organizacji, jeśli pada takie pytanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: Zatem jeśli pan mówi, że nie jest ich funkcjonariuszem, to musi to być prawda, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: Co oznacza… że mogę panu zdradzić coś niebywałego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: O czym pan mówi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: Skąd ma pan te informacje?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: Proszę się przygotować, gospodarzu. Klapki zaraz opadną panu z oczu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: Fałszowanie wyborów. Dowody na to, że lądowanie na księżycu było upozorowane.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: Rządowe kontrolowanie umysłów fast foodami. Serio. A na koniec…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: …prawda za tymi czipsami o smaku „ziemniaków”. Co to w ogóle ma być?! To naukowa abominacja!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: Okej, powiem to panu. Myślę, że mogę panu zaufać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: Ale musi pan przyrzec, że nie zdradzi tego nikomu innemu, dobrze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: Pracowałem w placówce badawczej. Zwolnili mnie z powodu moich odkryć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: Wygłosiłem teorię, że Przybysze nie są głównym zagrożeniem. Ono natomiast jest w nich samych… to pasożyty mózgowe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: Ale ci głupcy uznali moje odkrycia za bezzasadne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: Wystarczyłyby zatyczki do uszu, by powstrzymać pasożyty przed wniknięciem do ich głów. Mogliśmy ocalić mnóstwo ludzi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: Opuściłem instytut z wysoko podniesioną głową… i kilkoma cennymi archiwami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: Wiedziałem, że mogę panu zaufać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: Proszę mi wierzyć, ujrzałem prawdę! Niech pan zapomni o wszystkich usłyszanych kłamstwach!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: Popełnia pan błąd!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: Ludzie zasługują, by usłyszeć prawdę!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: Niech tak będzie. Zaufałem panu… a pan podkopał moją wiarę w ludzkość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: Witam. Czy mogę zostać u pana na chwilę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: Przyjechałam do miasta odwiedzić męża. Przeprowadził się do pracy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: Pomyślałam, że zrobię mu niespodziankę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: Ale okazało się, że nigdzie nie ma dla mnie noclegu u niego w pracy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: Jak się pani tu dostała?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: Co robi pani mąż?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: Jak? Wzięłam taksówkę, co z tego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: Taksiarz oskubał mnie z niezłej sumki. Przejazd kosztuje teraz od groma i trochę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: Przysięgam jednak na Boga, że jego zęby były białe jak porcelana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: Niech no tylko mój silny i muskularny mąż z FEMA go dorwie… Zaraz mu je wszyściuchne powybija.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: Czy pani też jest z FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: Co wcześniej robił pani mąż?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: Och, powiem to głośno i wyraźnie! On pracuje dla FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: Kiedy usłyszałam, że go przenoszą do FEMA, kurcze blade, prawie oszalałam!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: Chciałam zrobić mu niespodziankę, więc wybuliłam na taksówkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: Ale ten taryfiarz to złodziej, a nie kierowca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: Czy pani też pracuje dla FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: Co wcześniej robił pani mąż?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: Chciałabym, ale nie, bo nie przyjmują kobiet. A to pech.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: Wielka szkoda. Z moim mężem świetnie sprawdziłabym się w wyniuchiwaniu Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: Pracowałam w służbie celnej, wiesz pan? Chroniłam kraj na granicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: Złapałam masę szumowin z ukrytym najróżniejszym tałatajstwem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: Akurat bym panu powiedziała. Na co to panu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: Jakie to ma znaczenie? Teraz jest w FEMA. Ja też bym mogła, gdyby to nie był taki ciemnogród.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: To niesprawiedliwe. Co, niby nie dorównuję mężowi, bo jestem babą?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: Pracowałam na granicy. Mam nosa do oprychów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: To całe „do FEMA nie bierzemy kobiet” można o kant dupy rozbić!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: No i to rozumiem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: Jak tylko sprzątniemy wszystkie te dziwadła, będziemy mogli dalej żyć jak porządni, cywilizowani obywatele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: Czekaj pan… co, do cholery?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: Słodki Jezu! Myślisz pan, że jestem Przybyszką?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: Noż, kurwa, doprawdy? Mój stary jest w FEMA, do jasnej cholery!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: Z czym masz pan problem? Ja tu z sercem na dłoni, a ty mnie wyrzucasz, psiakrew, na bruk?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: Wiesz pan co? Wypierdalaj. Przekonam któregoś z sąsiadów, żeby mnie wpuścił.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: Moje uszanowanie, przyjacielu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: Czy, eee, masz może broń?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: Dlaczego chcesz wiedzieć?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: Tak, mam broń
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: Och… Proszę mi wybaczyć. Nie chciałem być niegrzeczny…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: Bo… żyjemy w niebezpiecznych czasach. Muszę być pewien, że dam sobie radę i z‑zlikwiduję potencjalne zagrożenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: Kto niby miałby cię oskarżyć o zabicie kogoś podczas apokalipsy? M‑miałoby to sens jak wożenie drewna do lasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: W t‑twoim głosie słychać jednak tę ostrość. Pewno, eee, pociągnąłbyś za spust, gdybyś musiał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: Pewnie nawet mógłbyś udusić kogoś gołymi rękoma, gdyby do tego doszło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: Dlaczego jesteś taki zafiksowany na zabijaniu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: Przed kim tak naprawdę chcesz się bronić?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: O‑okej! Wtedy będziesz mógł kropnąć każdego Przybysza, który się zjawi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: Jejku… nie zrozum mnie źle, nie chcę, eee, nikogo tobą szczuć…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: Wpadłem tylko na uzbrojonego świra. Patrzyłem, jak przesłuchuje jakiegoś faceta. Wciąż się pytał, czy jest Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: Całe szczęście nie zauważył mnie. Mógłby skręcić mi kark bez wahania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: Kiedyś… ja też nauczę się zabijać…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: Wtedy to nie ja będę żył w strachu… ale oni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: Dlaczego jesteś taki zafiksowany na zabijaniu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: Przed kim tak naprawdę chcesz się bronić?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: Jejku… czy wyglądam tobie… na wariata?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: Nie chcę, by postrzegano mnie jak jakiegoś psychola. Ja tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: Zanim wszystko poszło w diabli, nie skrzywdziłbym nawet muchy. Teraz jednak… takie mięczaki, jak ja, nie żyją długo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: B‑boję się, co się stanie, jeśli nie nauczę się bronić, wiesz…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: To dlatego muszę, eee, nauczyć się od kogoś, kto to rozumie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: Nie, nie… czekaj. Nie mówię o tym świrze z karabinem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: Miałem na myśli bronić się przez Przybyszami i przed ludźmi, którzy na nich polują.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: Ostatnimi czasy wystarczy krzywo się na kogoś spojrzeć, żeby dostać kulkę!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: A ja? J‑jestem zwykłym, bezbronnym tchórzem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: To dlatego mam nadzieję znaleźć kogoś… kto, eee, mnie obroni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: Ale jeszcze, może… To znaczy, jeśli zechcesz… cóż…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: Mógłbyś nauczyć mnie… jak zabijać…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: Dziękuję, przyjacielu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: I jeśli nie pytam o zbyt wiele… eee, po tym, jak mnie sprawdzisz…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: Czy m‑mógłbyś pokazać mi, jak to się robi? Jak zabić Przybysza? Chcę spojrzeć śmierci w oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: Jejku… nie wpuścisz mnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: Zdaje się, że wyglądam na jakiegoś narwańca albo gorzej…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: 'Raskolnikov: Przysięgam, że to tylko pozory! Ostatnio… miałem dużo zmartwień.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: 'Raskolnikov: Bardzo mi przykro, że zmarnowałem twój czas. Obym… kiedyś nauczył się zabijać. Bym… bym mógł się bronić…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: Widzę, moje dziecię, że twoje skromne progi są najdalej tu położone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: Zdaje się, że będzie jak ulał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: Jak ulał do czego?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: A czego siostra potrzebuje?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: Boże, zmiłuj się… Czy nie wyrażam się jasno?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: Aby się ukryć, moje dziecię. Pragnę tu pozostać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: A skoro już o tym mowa… Pozwolę się dopytać, jakie oferuje pan wygody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: Ma pan dewocjonalia, prawda? Do modlitwy i kontemplacji wymagam także całkowitej ciszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: To nie jest hotel!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: Do diabła, chyba Bóg cię opuścił
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: Potrzebuję pokoju w pana domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: Przyjmuje pan ludzi w potrzebie, prawda? Muszę najpierw ustalić kilka rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: Po pierwsze nie cierpię pijaków ani narkomanów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: Jeśli ma pan kogoś takiego pod dachem, lepiej rychło mi pan powie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: Po drugie czy nie ma pan problemów z pluskwami? Czy w ścianach nie ma szczurów?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: Wieczne z nimi skaranie. Dostaję wysypki od tych najohydniejszych z boskich stworzeń.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: To nie jest hotel!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: Do diabła, chyba Bóg cię opuścił
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: Och, dzięki ci Jezu! Gdyby nie pan, nigdy bym się tego sama nie domyśliła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: Staram się jeno dociec, czy pana rudera jest godna mojej skromnej osoby. Nie zdzierżę brudu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: Czy wymagam aż tak wiele, dziecko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: Niech siostra wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: Powinna siostra odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: Nie mów do mnie takim plugawym językiem, niedomyty bezbożniku!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: Bój się Boga! Wstydu pan nie masz?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: Zadaję proste pytanie o pana dom, a pan mi klnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: Niech ma pan pewność, że dołożę wszelkich starań, aby wyplenić plugawy język z tego miejsca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: Niech siostra wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: Powinna siostra odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: Bóg z tobą, moje dziecię.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: A więc to tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: Odmawia pan pomocy biednej, starej kobiecie w potrzebie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: Ta śmierć będzie twoim brzemieniem, moje dziecię.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: Bóg pana osądzi przed bramami Niebios. Miarkuj me słowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: P‑pomóż mi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: Postrzelono mnie. Nie pociągnę długo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: Kto ci to zrobił?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: Co się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: Jebane chuje z FEMA mnie dopadły… Wspinałem się na ogrodzenie, zacząłem uciekać…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: Zezowaci z nich snajperzy i do tego skurwysyny. Chybili każdy strzał… prócz jednego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: 'Fugitive: Całe, kurwa, szczęście, że kula przeszła na wylot… Krwawię jednak jak zarzynane prosię.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: 'Fugitive: Przynajmniej flaki mam jeszcze na miejscu… ale niewiele z nich zostało. Heh… aj, boli jak sam skurwysyn, gdy się śmieję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: Opowiedz mi o strefach kwarantanny FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: Zatem FEMA cię ściga?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: Uciekłem ze strefy kwarantanny FEMA. Przyszli pod moje drzwi podczas łapanki i wytargali mnie przez próg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: Ledwo uchyliłem drzwi, a już mnie skanowali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: Zaraz potem coś tam naskrobali w swoich kapownikach i kazali z nimi iść.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: Powiedziałem, że mają wypierdalać… skuli mnie wtedy jak jakiegoś kryminalistę. Koniec końców im jednak uciekłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: Opowiedz mi o strefach kwarantanny FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: Zatem FEMA cię ściga?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: Wyobraź sobie pusty parking otoczony ogrodzeniem z kilkoma namiotami tu i tam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: Pustą przestrzeń wypełniają wielkie w chuj kontenery transportowe, do których wpychają ludzi co rano jak bydło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: Oto i strefa kwarantanny FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: A ich ochrona to jakiś kiepski żart.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: Poszedłem na żywioł bez planu. Poczekałem tylko na odpowiedni moment i wspiąłem się na ogrodzenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: Uwijają się tam jak mrówki. Łatwo poznać, że… się do czegoś szykują.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: Miałem jednak pecha. Jeden z kutasów akurat się odwrócił, zobaczył mnie i zaczął strzelać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: Zeskoczyłem z ogrodzenia prosto w kałużę i dałem w pizdu drapaka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: Och, bez wątpienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: Słyszałeś o ich testach na identyfikację Przybyszy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: To nie plotki!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: Widziałem to na własne, kurwa, oczy! Wzięli jakiegoś nieszczęśnika do namiotu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: Nagle słychać przytłumione wrzaski… a potem wywlekają czarny worek. Gość nigdy stamtąd nie wyszedł. Rozumiesz teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: Krzywdzą tam ludzi. To dlatego nikt nigdy nie opuszcza tych stref.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: Gdy zobaczyłem ten szajs, wiedziałem, że muszę spierdalać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: To dlatego uciekłem, mimo że dostałem kulkę, przeskakując to cholerne ogrodzenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: Teraz jestem świadkiem… wiem za dużo. Z całą pewnością będą mnie ścigać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: Dzięki, naprawdę. Jestem twoim dłużnikiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: Dobrze wiedzieć, że nie jesteś jak twoi sąsiedzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: JA PIERDOLĘ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: Oczywiście. Powinienem wiedzieć. Jesteś jak cała reszta… Banda tchórzliwych psów!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: Chowacie się w swoich budach i nikogo nie wpuszczacie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: Chuj z tym. Dobrej, kurwa, nocy, frajerze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: Czy mógłbyś mi wytłumaczyć, co się dzieje?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: Od gorąca brak mi tchu, a ludzie zachowują się… dziwnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: Strzelają i walczą ze sobą… nie rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: Czekaj, nie masz bladego pojęcia, co się wyrabia?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: Nie oglądasz telewizji?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: Nie, nie wiem. Przez wiadomości mam napady lęku, więc… staram się je ignorować. Moi rodzice je oglądają…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: Obudziłem się jednego ranka, a im jakby odbiło. Mówili, że muszą natychmiast wyjechać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: To było tydzień temu… i nadal nie wrócili. Wciąż na nich czekam, ale oni… jakby przepadli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: Muszę poznać prawdę. Dokąd się udali? Proszę… powiedz mi, co się dzieje!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: Przybysze wyleźli spod ziemi. Nie można nikomu ufać
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: Słońce wybuchnie. Spala ludzi żywcem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: W wiadomościach zawsze samo czarnowidztwo. Robię się od nich albo smutny, albo pełen lęku, dlatego ich nie oglądam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: Przeczytałem gdzieś, że ludzie, którzy nie oglądają ani nie czytają wiadomości, żyją dłużej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: Ale mama z tatą zawsze je oglądali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: Pewnego dnia dowiedzieli się z wiadomości o czymś bardzo przejmującym.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: Nie włączałem swojego telewizora, by się nie stresować. Oni wciąż jednak nie wrócili, a ja nie wiem, co się dzieje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: Wyszli w pośpiechu kilka godzin po wiadomościach… i nigdy nie wrócili. Teraz naprawdę boję się włączyć telewizor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: Pomyślałem, że może ktoś inny opowie mi, co się dzieje. Powie mi pan? Proszę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: Przybysze wyleźli spod ziemi. Nie można nikomu ufać
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: Słońce wybuchnie. Spala ludzi żywcem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: O mój Boże… A co, jeśli ci „Przybysze” ich zabili?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: Kurza melodia, po co wychodzili? Dlaczego nie wzięli mnie ze sobą?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: Już sam nie wiem, co mam myśleć. Może ty także mi nie ufasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: Co mam teraz począć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: Jezu, a co, jeśli… słońce ich spaliło?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: To jakiś koszmar…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: Co mam teraz począć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: Nie wiem, czy to dobry pomysł.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: A co, jeśli wrócą do domu, a mnie tam nie będzie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: Ale… może masz rację. Powinienem chyba z tobą na razie zostać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: Tak, tak chyba będzie bezpieczniej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: Pójdę do domu. Na wypadek, gdyby mieli wrócić…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: Tak… na pewno niedługo wrócą. Tak myślę. Mam nadzieję…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: Dobrej nocy, nieznajomy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: Hej, koleżko. Masz może miejsce dla takiego porządnego kawalera, jak ja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: Co ci się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: Skąd mam wiedzieć, że jesteś „porządny”?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: Ach, nic takiego specjalnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: Teściowa mnie wyrzuciła, bo wywaliłem z domu gościa z FEMA na zbity pysk. Teraz się boi, że po nią wrócą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: Heh, dałeś się nabrać, co? Tylko żartuję, koleżko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: Nie mam teściowej. Nawet nie mam żony!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: A to oznacza, że pić do baru mogę wychodzić, kiedy tylko chcę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: Coś ty za jeden, jakiś kawalarz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: Wyglądasz na podpitego. Piłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: Uwierz mi, nikt, kogo poznasz, nie ma serca tak wielkiego, jak moje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: Pewnie, mogę przywalić ludziom o idealnych zębach lub pięknych oczach… ale tylko z zazdrości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: No weź, tylko żartuję! Nie bierz mnie tak na poważnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: Jedna lub dwie dziwne cechy nie czynią cię od razu Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: Nie skrzywdziłbym nikogo ze względu na zęby, oczy, czy cokolwiek, co gadają w telewizji. Nie mógłbym nawet…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: Nieważne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: Coś ty za jeden, jakiś kawalarz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: Wyglądasz na podpitego. Piłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: Jestem porządnym kawalerem, a nie kawalarzem. A co, coś nie tak z odrobiną humoru podczas apokalipsy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: Śmiech chroni od szaleństwa, koleżko. Nawet jeśli świat się sypie. Bez poczucia humoru dawno bym odwalił kitę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: Przepraszam, jeśli moje żarty cię drażnią. Staram się nie ześwirować.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: To, eee, jak będzie…? Wpuścisz mnie, koleżko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: Miałem dziś iście królewskie śniadanie. Jestem na jadłospisie od kumpla: piwo z rana, wino wieczorem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: Smaczne, zdrowe i nawet może służyć jako dieta, jeśli się dobrze do tego podejdzie. Spójrzże przecież na to ciałko!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: He, he, wyluzuj, to tylko żarcik. Nie miej mi tego za złe. Ostatnimi czasy dobrze się pośmiać. To jedyne, co nam zostało.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: I czemużby nie zapić smutków? To, co się teraz wyrabia, ciężko przyjmować na trzeźwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: Ale żarty na bok. Wpuścisz mnie, koleżko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: Wielkie dzięki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: Gdyby nie ty, byłbym całkiem samotny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: Kurde, koleżko…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: Dobra, nie zawracam gitary. Już sobie idę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: Cholera… ależ tu gorąco. Gorąco, powiadam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: Jest środek nocy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: Wszystko w porządku?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: Phi! Wciąż spiekota jak z piekarnika.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: Może i jest odrobinę chłodniej, zgoda… ale powietrze jest lepkie, że aż… aż… aż…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: …nie mogę oddychać. Czy masz może, ekhm, łazienkę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: Tak, mam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: Po co ci łazienka?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: Nie, nie, nie! Nie jestem w porządku. Spójrz tylko na mnie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: Czuję się, jakbym się roztapiał. Roztapiał, powiadam!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: Jezu… jest goręcej niż w jakimkolwiek hotelu w tropikach, w którym byłem. Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: Potrzebuję się ochłodzić zimną wodą. Czy mógłbym, ekhm, skorzystać z twojego prysznica?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: Tak, mam takowy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: Po co ci łazienka?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: Cudownie! Jeszcze chwila, a obawiam się, że zupełnie bym się roztopił!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: Skoro już o tym mowa… Czy masz może jakieś lody? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: Słuchaj no, chłopcze. Otwieraj drzwi. Potrzebuję tej wanny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: Zaraz tu zemdleję i obrócę się w skwarkę na twoim progu, psiakrew!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: Mówię poważnie, chłopcze! Nie… czuję się najlepiej. Natychmiast potrzebuję zimnej wody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: To po co przyszedłem tu taki kawał drogi? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: Żeby bezczelny pyszałek kazał takiej ważnej osobie pocałować klamkę. Rządziłem tym burdelem! Byłem ministrem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: Nie daj się prosić… Mogę, ekhm, ci to wynagrodzić…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: Wpuść mnie teraz, a gdy się to wszytko skończy… Dopilnuję, byś dostał, ekhm, rekompensatę. Wysoką.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: Wspaniale. Nie pożałujesz tego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: Jak ten cały bałagan dobiegnie końca, dopilnuję, byś otrzymał, ekhm, odpowiednie wynagrodzenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: To niedorzeczne! Nie widzisz, że ledwo tu zipię?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: Dokąd, u diabła, mam pójść, hm? Mam… mam przejebane!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: W końcu… jakieś schronienie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: Co ci się stało w oczy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: Kto ci to zrobił?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: Widziałem coś niewyobrażalnego. Nie odważę się tego opisać… bo któż rozwodzi się nad tym, co rodzi załamujący się umysł?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: Zawsze jest tuż przed nosem. Wypalone w ciemności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: Żadne słowa nie opiszą tej przedwiecznej grozy, która rozdarła mi duszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: Wierz mi… jeśli też byś to zobaczył, postąpiłbyś tak samo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: Co zobaczyłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: Masz na myśli tego bladego jegomościa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: Ja… sam to sobie zrobiłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: Musiałem poświęcić oczy, by nie postradać zmysłów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: Myślałem, że pozbędę się tego widoku, jeśli je sobie wydłubię. Teraz widzę jedynie bezkresną pustkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: Co zobaczyłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: Masz na myśli tego bladego jegomościa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: Wierz mi, nie chcesz wiedzieć…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: To traktuje nasze cierpienie jako ucztę! Bankiet żałości! Opycha się strachem, bólem… naszym rozumem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: Moim błędem było znalezienie się w niewłaściwym miejscu i niewłaściwym czasie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: To… mnie z początku nie zauważyło. Było zbyt zajęte pożeraniem zwęglonych ciał…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: Powoli napychało się tymi sczerniałymi, nadpalonymi zwłokami… NA MOICH OCZACH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: Dobry Boże… nie życzyłbym tego widoku najgorszemu wrogowi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: Doprawdy myślisz, że wystarczyłby zaledwie widok bladego faceta, żebym wybałuszył sobie oczy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: Nie… Och, nie. Grasuje tam coś o wiele gorszego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: Większego… silniejszego… bezimiennego. To podąża za wonią palonego ciała i zbiera burzę, gdzie zasialiśmy wiatr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: To nie miało nigdy zaistnieć… NIE POWINNO W OGÓLE ISTNIEĆ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: Dziękuję… Może teraz w końcu trochę odpocznę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: Cholera… Czy bez oczu do zamknięcia będzie trudniej mi zasnąć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: No dobrze, odejdę. Muszę cię jednak ostrzec…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: Na miłość boską, nie zbliżaj się po ciemku do żadnych zwęglonych zwłok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: Inaczej to cię odnajdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: Joł! Jak leci?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: Ziom, widziałeś tę rozpierduchę na zewnątrz? Co się wyrabia, u diabła?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: Ale tak na serio, ziom. Co przegapiłem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: Słońce goreje i za dnia spala ludzi żywcem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: Stworzenia przypominające ludzi wyłażą spod ziemi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: Bez jaj!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: Stary, widziałem ten film! Grał w nim ten łysy gość!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: Musimy wysłać na słońce grupę kozackich astronautów, no nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: Bum! Rakieta wystrzelona, rozpoczęto misję ratowania świata! W dechę, ziom!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: O, o, i w zespole muszą być cztery osoby. To złota liczba, jeśli chodzi o przetrwanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: Co ty pleciesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: Naprawdę nie masz zielonego pojęcia, co się dzieje?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: Zombie?! ZIOM! WIEDZIAŁEM!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: Stary, możesz na mnie liczyć, cokolwiek nas czeka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: Widziałem o tym tyle filmów, ziom, że jestem normalnie mistrzem przetrwania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: Powiedz mi tylko, czy mamy do czynienia z klasycznymi, powolnymi zombie, czy z tymi paskudnymi sprinterami?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: I czy to taki wirus mózgowy, że wydają zwierzęce dźwięki, czy może są tylko upiornymi umarlakami?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: Uwierz mi na słowo, ziom, że odpowiedź na to pytanie zmienia wszystko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: Masz może strzelbę albo granaty? Będziemy potrzebować nielichej siły ognia, żeby przeżyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: I żarcie, stary. Peeełno szamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: Co ty pleciesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: Naprawdę nie masz zielonego pojęcia, co się dzieje?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: Ziooom! Dokładnie wiem, o czym mówię!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: Przykładowo jak autorzy sci‑fi wiedzą, co kryje przyszłość?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: Oni mają kosmiczne mózgi i przewidują niesamowite technologie, zanim zostaną wynalezione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: Skumaj, jakbyśmy polecieli w kosmos i zaczęli wysyłać listy do kosmitów… O reeetyyy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: Totalna zajebioza, ziom! Mój kumpel przeczytał o tym raport w czasopiśmie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: W porząsiu, już wrzucam na luz… No, wpuść mnie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: Nie no, mam, stary. Jest zupełny rozpierdziel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: Ludzie obgadują znajomych, psują nastrój tą kiłą i mogiłą…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: A po tym, co nadają w wiadomościach? Klimat jedzie po bandzie, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: Ale filmy, stary…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: W nich jest wszystko. Emocje, zdrada, intryga!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: Są o niebo lepsze od książek, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: Zawsze chciałem zagrać w filmie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: Joooł! Zajebongo, stary!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: Stary, to chyba najlepsze, co mnie w życiu spotkało.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: Powinni o tym kiedyś nakręcić film!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: Smuteczek…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: Wporzo, ziom. Kumam. Bez spiny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: Dbaj o siebie, ziom… i o swoich gości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: Przepraszam, że przeszkadzam, ale… czy może mi pan poświęcić chwilkę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: Czuję się tak okropnie. Czy mogę o tym z panem porozmawiać?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: Co się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: Kim pani jest?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: Ja… chciałam tylko dać odrobinę nadziei porzuconym dzieciom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: Zaopiekowałam się tymi, które nazwano „zbrukanymi”, czyli każdym dzieckiem podejrzewanym o bycie Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: Mieszkałam z nimi w budynku starego przedszkola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: Potrzebowały opieki i miłości. Robiłam, co mogłam…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: Ale to nie starczyło… Nie mogłam ich uratować.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: Co się stało z dziećmi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: Czemu wybuchł pożar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: Byłam nauczycielką… pracowałam z przedszkolakami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: Gdy świat zaczął się walić, przygarnęłam porzucone dzieciaczki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: Każde z nich straciło rodziców w najróżniejszych okolicznościach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: Niektórzy byli porwani przez FEMA. Inni zabici, a jeszcze inni…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: Porzucili własne dzieci przy wystąpieniu najdrobniejszych objawów bycia Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: Teraz… wszystkie nie żyją. Żadne nie przeżyło pożaru…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: Co się stało z dziećmi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: Czemu wybuchł pożar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: One…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: Wszystkie zginęły… w płomieniach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: Ogień zaprószyli inni mieszkańcy miasta. Przerażało ich, że dzieci mogą być Przybyszami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: Zmusili mnie, bym na to patrzyła… Najpierw pozamykali drzwi, zabili okna deskami… potem podpalili budynek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: Wciąż czuję na sobie ich przerażone, małe oczka…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: Podłożyli go… inni mieszkańcy miasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: Dowiedzieli się, że opiekuję się tam dziećmi z objawami Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: Co z nami jest? Staliśmy się nieczułym motłochem osądzającym bezbronne dzieci?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: Czym one sobie na to zasłużyły?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: Spalili wszystko doszczętnie i kazali mi patrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: Wiem, że nie przywrócę im życia…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: Ale dziękuję… za wysłuchanie mnie. I za wpuszczenie do środka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: Nie obwiniam pana za to. Proszę mi tylko coś obiecać, zanim sobie pójdę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: Jeśli napotka pan dziecko w potrzebie… proszę się nim zaopiekować. Do widzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: Cześć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: Otwiera czy nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: Znasz… łysego mężczyznę?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: Czego chcesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: Tyle pytań. Tak, ja znam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: Jak niby to pomoże?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: Jak znalazłaś mój dom?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: Skrzynka piwa. Komoda. Szynka z udźca. Nie wie. Daj cokolwiek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: Otwiera? Tak? Nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: Powiedzieli tu przyjść, to przyszła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: Jak znalazłaś mój dom?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: Tancerka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: Balet. Widać?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: Czy ktoś cię tu przysłał?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: Przypominasz mi… kogoś
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: Widzi miasto? Tam żyła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: Widziała twój dom. Przyszła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: Tu nie gorąco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: Czy ktoś cię tu przysłał?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: Przypominasz mi… kogoś
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: Chyba nie. Ma znaczenie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: Heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: Chyba nie jesteś człowiekiem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: Udowodnij, że jesteś człowiekiem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: Mówi? Zgadza się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: Co teraz? Powie więcej? Czy co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: Dziwne do powiedzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: Chyba nie jesteś człowiekiem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: Udowodnij, że jesteś człowiekiem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: Co z tym?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: Popatrzeć jak tańczę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: Może ja zatańczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: Ja bal‑erina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: I? Decyduje? Co robimy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: Dwa ręka, dwa noga, jedno głowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: Nie starczy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: Zdała test?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: Otwiera czy nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: Biedna dziewczyna taneczna marznąć w zimno… Taki smutek…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: Bez złośliwy dla kot. Kotek nie cierpieć chłodno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: Spojrzeć, kotek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: Przemyśli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: Dobra… wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: Wynocha mi stąd
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: Ja poczuć tu jak w dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: Kotek, chodź. Pora na bieg i zabawa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: Znajdź kotek pod dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: Mała podarunek. Od ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: O… tak lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: Och, czołem! Razem z moją kochaną żoną szukamy schronienia, by przeczekać najgorsze!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: Czy moglibyśmy zostać u ciebie na jakiś czas? Jeśli to nie problem, rzecz jasna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: Czy mój dom wydaje się wam bezpieczny?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: A co, jeśli to wy jesteście problemem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: Szczerze, twój dom wygląda bezpieczniej niż jakikolwiek, który dotąd widzieliśmy, prawda, złotko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: Nie wiem do końca, jak to wyjaśnić, ha, ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: Duży dom na uboczu, brak wścibskich sąsiadów… Mniejsza szansa, że pojawi się tu jakiś wariat, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: Czy twoja żona może mówić za siebie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: Dlaczego jesteście tacy zmęczeni?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: Hm… Pewnie moglibyśmy poszukać przytułku gdzieś indziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: Żoneczka jest wyczerpana. Musi odpocząć. Czy możemy zostać tylko na trochę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: Oczywiście jeśli nie prosimy o zbyt wiele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: Czy twoja żona może mówić za siebie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: Dlaczego jesteście tacy zmęczeni?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: Jasne, że może! Złotko, powiesz coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: Ona po prostu pada z nóg. Wybacz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: Ale może innego dnia wszyscy razem porozmawiamy. Jeśli jeszcze się spotkamy, ma się rozumieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: Racja, złotko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: Och, wybacz mi. Nie powinienem był tak naciskać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: Wejdźcie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: Powinniście odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: Ostatnio wszystko jest męczące. Przybysze, skwar, utrata pracy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: Nagromadziło się tego… Nie było łatwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: Żonie jednak zawdzięczam wszystko. Bez niej z niczym bym sobie nie poradził. A ciebie z kolei co motywuje?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: Och, przepraszam, nie powinienem był pytać. To nie mój interes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: Wejdźcie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: Powinniście odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: Och, dziękujemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: Co tak stoisz? No, dalej, złotko, miły pan zaprosił nas do środka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: Jest odrobinę nieśmiała. W porządku, złotko, zaraz odpoczniesz i wrócisz do siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: Rozumiem. Przepraszam za kłopot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: Pójdziemy szukać dalej, prawda, złotko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: Dalej, ruszaj te cholerne kulasy. Też jestem zmęczony.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: Siema. Albo… dzień dobry, jeśli tak lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: Czy to twoja miejscówka? Znaczy się… czy to pana dom?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: Szukasz kogoś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: Tak, jest mój
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: Nie, tylko… szukam miejsca do przekimania czy coś.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: Dość mam chowania się po piwnicach. Jeszcze trochę, a zapomnę, jak się gębę do kogoś otwiera. Jakby cię to obchodziło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: Czemu chowasz się w piwnicach?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: Gdzie są twoi rodzice?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: Tooo… czy mogę wtedy wejść? Czy może mnie tu zostawisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: Nie znalazłam żadnej piwnicy ani innej dobrej kryjówki, więc jestem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: Czemu chowasz się w piwnicach?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: Gdzie są twoi rodzice?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: Można powiedzieć, że… podróżuję. Chcę zwiedzić świat. Różne miejsca. Może gdzieś odnajdę nowy dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: Ale jestem spłukana. Więc albo umawiam się z kimś na pokój, albo wkradam do piwnic. Trudno, takie życie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: Czasem trafia się jednak na kompletnych dewiantów. Ech.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: Spróbuj więc tylko czegoś, a dostaniesz w pysk tak, że się nogami zakryjesz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: Czort wie. Pewnie w domu. Gdzie indziej mieliby być?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: A może są już Przybyszami. Całkiem by im to pasowało. Ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: Moja mama uwielbia się opalać, więc… to inna fajna możliwość.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: Nieważne. Jestem tutaj, no nie? I przydałby mi się dach nad głową.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: Naprawdę zostawisz nastolatkę na dworze? Na pastwę palącego słońca? Z Przybyszami wszędzie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: Nie wierzę! O rany…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: Masz nawet dywan? W porząsiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: Ale… nieważne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: Trudno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: Pewnie i tak jesteś jednym z tych zboczeńców.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: Goń się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: Hej, hej! Ty, po drugiej stronie drzwi! Słyszę, jak chodzisz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: Czy mogę zostać u ciebie na noc?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: Skąd ta wesołość?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: Co ci się stało w twarz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: Dość jest wokół gniewu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: Czasy mamy ciężkie. Ale wciąż jest wiele, o co warto walczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: Następne pokolenie. Sztuka. Zwykła… radość z życia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: Jeśli będziemy wciąż powtarzać, że będzie lepiej, hej – może faktycznie zrobi się trochę lżej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: Jakie masz powody do uśmiechu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: Zatem chcesz wszystkich okłamywać?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: A co z nią nie tak? Dla mnie wygląda dobrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: Och, masz na myśli mój uśmiech?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: Racja… też od dawna nie widziałem, żeby ktoś się uśmiechał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: Ludzie ze strachu zapomnieli, jak wygląda radość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: Rozpacz zaślepia nas na resztkę dobroci pozostałą w świecie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: Jakie masz powody do uśmiechu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: Zatem chcesz wszystkich okłamywać?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: Jest ich wiele. Ale nie potrafię powiedzieć, co uszczęśliwiłoby ciebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: Co sprawiało ci największą przyjemność, zanim stało się to wszystko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: Spróbuj przypomnieć sobie, co wzbudzało w tobie radość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: Nie pozwólmy sobie na pogrążanie się w żałobie, teraz bardziej niż kiedykolwiek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: Czemu od razu „okłamywać”? Wszyscy mają teraz problemów po uszy i rozumiem to.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: Czasem jednak, jeśli im przypomnieć o tym, jak byli kiedyś radośni…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: Kiedy nie skupiali się wyłącznie na przetrwaniu, ale na tworzeniu czegoś… pięknego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: Rozumiesz, co mam na myśli? Ostatnio życie stało się zbyt zgorzkniałe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: Mam nadzieję, że pamiętasz, co to znaczy radość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: Może wtedy… nie będziesz myśleć wyłącznie o śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: Nie daj pochłonąć się żałości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: Jeśli zbytnio się na niej skupisz, zacznie pożerać cię żywcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: I z tą chwilą… To już krótka droga ku ciemności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: Dbaj o siebie, dobrze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: Dobry wieczór panu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: Jestem funkcjonariuszem FEMA. Przeprowadzamy rutynową kontrolę w sąsiedztwie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: "Gasmask: Proszę się nie martwić, to nie potrwa długo.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: Kiedy uwolnicie zabraną osobę?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: A co z ostatnią kontrolą?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: Uwolnimy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: Ach. Więc był tu już nasz zespół.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: Po wstępnym badaniu następuje obowiązkowa kwarantanna. Wspomniana osoba pozostanie z nami przez jakiś czas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: Potem zostanie zwolniona ze strefy kwarantanny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: No dobra, jeśli inaczej nie można
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: Nie obchodzą mnie te testy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: Wyniki były niejednoznaczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: Aby dokładniej przebadać wpływ słońca, musimy zabrać kolejną osobę z pana domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: No dobra, jeśli inaczej nie można
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: Nie obchodzą mnie te testy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: Proszę się nie obawiać. Tak, procedury są wymagające, ale umożliwiamy badanym wypoczynek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: Po zakończeniu badań damy panu znać, co dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: Nie zrozumiał mnie pan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: Nie ma pan wyboru.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: Tak czy inaczej dojdzie do nich. Im wcześniej zacznie pan współpracować, tym szybciej się skończą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: Witam pana uprzejmie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: Potrzebujemy od pana więcej osób do badań.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: Im szybciej je pan wyda, tym lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: Co się dzieje w mieście?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: Przyprowadźcie z powrotem te, które zabraliście!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: Konsekwencje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: Kto podniesie rękę na władzę ludową, temu władza tę rękę odrąbie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: Ukrywanie Przybyszy sprawia, że się mnożą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: A to skutkuje przemocą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: Kiedy to wszystko się skończy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: Kiedy pozbędziecie się Przybyszy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: Nie ma pan prawa do stawiania żądań.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: Nie robi pan nic innego prócz utrudniania nam wykonywania obowiązków służbowych.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: I proszę zobaczyć, do czego nas to doprowadziło. Ostatnio musieliśmy spacyfikować kolonię Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: Było to… moje rodzinne miasto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: Kiedy to wszystko się skończy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: Kiedy pozbędziecie się Przybyszy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: Wciąż badamy przyczyny tych wydarzeń. Proszę nam nie przeszkadzać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: Trudno powiedzieć, kiedy okoliczności wrócą do normy. Musimy przeprowadzić więcej badań, aby zapanować nad sytuacją.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: Proszę z nami współpracować, a wszystko będzie po staremu szybciej, niż pan przypuszcza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: Więc co teraz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: Znowu muszę wam kogoś oddać?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: Gdyby to tylko było takie proste, proszę pana, FEMA nie musiałaby istnieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: Proszę pozwolić nam wypełniać nasze obowiązki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: Panujemy nad sytuacją.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: Więc co teraz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: Znowu muszę wam kogoś oddać?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: Potrzebujemy ludzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: A ściślej dwójkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: To wszystko przyspieszy. Tak będzie najlepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: No dobra, jeśli to pomoże…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: Nie, dość tego
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: Tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: Ale tym razem potrzebujemy dwóch osób.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: Bez znaczenia, kto to będzie. Proszę wydać dwójkę lokatorów. Natychmiast.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: Wkrótce wszystko wróci do normy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: No dobra, jeśli to pomoże…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: Nie, dość tego
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: Proszę udzielić nam pomocy, abyśmy mogli odwdzięczyć się tym samym.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: Dziękuję za zrozumienie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: Oddamy tę dwójkę szybciej, niż pan myśli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: I zajmiemy się Przybyszami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: Kurwa mać…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: Jak pan chce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: Podoba się panu widok za moimi plecami?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: To się dzieje, kiedy takie uparte dupki, jak pan, włażą nam w drogę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: Znowu do tego dojdzie, jeśli będzie pan stawiał opór.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: Dbamy o to miasto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: Tylko. Daj. Nam. Pan. Ludzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: Zwrócimy ich niebawem. Dziękuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: Potrzebujemy więcej ludzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: Tylko w ten sposób unikniemy katastrofy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: Gdzie. Są. Ludzie. Których. Zabraliście?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: Jakiej katastrofy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: PRZESTAŃ PAN PIERDOLIĆ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: ŚWIAT SIĘ ZARAZ SKOŃCZY.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: Niech się pan nie wygłupia albo weźmiemy wszystkich lokatorów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: Czego potrzebujecie do opanowania sytuacji?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: Jaki jest, kurwa, sens waszej organizacji, skoro wszystko, co robicie, i tak spełza na niczym?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: W chuj wielkiej, proszę pana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: Władze nie są w stanie opanować epidemii. Są gotowi wysadzić całe miasto w powietrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: Wydane nam rozkazy są niemożliwe do wypełnienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: Jeśli nie znajdziemy sposobu na przetrwanie, ktoś inny nam go narzuci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: Czego potrzebujecie do opanowania sytuacji?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: Jaki jest, kurwa, sens waszej organizacji, skoro wszystko, co robicie, i tak spełza na niczym?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: Kolejnych dwóch osób.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: Nie weźmiemy wszystkich pana gości. Tylko dwójkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: I wtedy albo znajdziemy sposób na zlikwidowanie Przybyszy, albo nigdy więcej się nie spotkamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: Świetnie. Nigdy więcej nie chcę pana widzieć
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: Nie oddam już nikogo więcej
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: Skończyła mi się cierpliwość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: Koniec tej kłótni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: Jeśli w tej chwili nie odda pan dwóch osób, wyważymy drzwi i wszystkich pozabijamy w tej szczurzej norze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: Nie pan pierwszy stawia opór. Z innymi już sobie poradziliśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: Z panem też sobie poradzimy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: Świetnie. Nigdy więcej nie chcę pana widzieć
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: Nie oddam już nikogo więcej
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: I wzajemnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: To wszystko. Życzę spokojnej nocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: Gadaj do dupy, to cię osra… W przypadku stawiania oporu wydarzy się, co następuje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: Wyważymy pana drzwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: Zgarniemy wszystkich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: I zostawimy pana samego na śmierć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: Proszę uprzejmie wydać nam dwie osoby. NATYCHMIAST.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: Wtedy sobie pójdziemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: Wspaniale. Masz kota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: Co uczynić z dzierżącą go… zależy od ciebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: Skąd wiedziałeś o kocie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: Dlaczego sugerowałeś, żebym wpuścił do środka osobę z kotem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: Mój wzrok sięga dalej niż u innych. To wręczony mi dar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: Nie widzę wszystkiego. Ale ciebie… Wiem, co cię czeka dalej na twojej ścieżce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: Zmierza ku tobie coś okropnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: Nie jesteś tego przyczyną, ale mimo to dotknie cię.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: 'Prophet: Może napomkną o tym w radiu. Będziesz nasłuchiwał?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: I co mam zrobić z tą informacją?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: Co się wydarzy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: Potężna istota oczekuje nadejścia kota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: To dzięki niej sięgam okiem w dal. Lecz nawet ja nie widzę wszystkiego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: Jedno jest jednak pewne. Zbliża się tutaj coś nikczemnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: Nie powstrzymasz tego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: 'Prophet: Może napomkną o tym w radiu. Będziesz nasłuchiwał?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: I co mam zrobić z tą informacją?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: Co się wydarzy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: Nic. I tak już zdradziłem zbyt wiele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: Ale… Przez dwa dalsze dni… Przyglądanie się innym zwiastuje zgubę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: Wstrzymaj się z oględzinami do trzeciego wschodu słońca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: Jeśli posłuchasz, dalej będę ci przewodził.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: Może dzięki temu zaznasz spokoju. Albo chociaż pomoże żyć dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: Obyśmy się wkrótce znów spotkali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: Nie powiem nic więcej. I tak już zdradziłem zbyt wiele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: Potraktuj to jako radę, jeśli chcesz, lecz…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: Przez dwa dalsze dni… Przyglądanie się innym zwiastuje zgubę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: Przy mojej pierwszej wizycie poczułem coś… dziwnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: Teraz to uczucie odrobinę zelżało. Chyba jesteśmy na właściwej drodze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: Obyśmy się wkrótce znowu zobaczyli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: Jesteś tam, tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: Uczucie jest teraz gorsze. Dziwne…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: Czy to z powodu tych zniszczeń?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: Potrzebujesz pomocy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: Mówisz do siebie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: Otrzymałem już potrzebną pomoc. Tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: Czuję się słabszy. Mój wzrok nie sięga tak daleko, jak kiedyś.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: To pewnie ani nie ty, ani nie ona…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: Już kiedyś mi się to przydarzyło, na samym początku. Wszystko będzie dobrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: Młode łodygi przebiją się przez popioły i sięgną nieba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: Nigdy nie wiem, o czym mówisz
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: Zaczynam żałować, że ci zaufałem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: Nie. Na pewno nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: Wiesz, że istnieje istota silniejsza od nas wszystkich?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: Nie lękaj się jednak. Nie jesteśmy jej świadomi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: Przybędzie z pomocą, jeśli poprosisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: Teraz jednak… coś jest nie tak. Czy to może być…? Grzybiarz…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: Nigdy nie wiem, o czym mówisz
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: Zaczynam żałować, że ci zaufałem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: Wielkie nieba… nie chciałem cię przestraszyć. Głośno tylko myślę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: Zanim do ciebie przyszedłem, wszystko było klarowne. Teraz… jest zamglone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: Masz piwnicę, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: Coś tam jest pod ziemią.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: Ale nie widzę dokładnie, co…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: Po co mi to?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: Jesteś pewien, że coś tam jest?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: Wiem, że mogę brzmieć dziwnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: Spotkaliśmy się nie bez powodu. Pamiętam to wyraźnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: Teraz jednak… moja wizja jest zamglona. Widzę, żeś zgubiony w ciemnym lesie, gdzie otaczają cię bestie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: Widzę… co nastąpi potem. Piwnica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: Coś jest tam pogrzebane. Pod ziemią…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: Trzeba ci to odnaleźć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: Po co mi to?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: Jesteś pewien, że coś tam jest?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: Wielkie nieba… nie mogę się skupić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: Aczkolwiek… w ziemi… widzę coś jeszcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: Nie zeskakuj. Jeszcze nie pora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: Muszę odpocząć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: Pamiętam… że tak było trzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: Należało tak zrobić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: A ty…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: Pamiętaj… nie poratujesz się zeskoczeniem. Jeszcze nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: Potrzebuję pobyć sam na sam ze swoimi myślami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: Zapomniałem, jak wygląda twoja twarz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: Tracę wzrok. Prawie nic nie widzę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: Czy ona mnie porzuciła?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: Tylko nie umrzyj mi na ganku
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: Wyglądasz… źle
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: Już za późno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: Wizje… zniknęły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: Wiem, co się teraz dzieje… Coś, co powinno nastąpić już dawno temu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: Wielkie nieba, muszę… Zostaw mnie w spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: O kim mówisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: Czy ty umierasz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: Tak długo była moją siłą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: A teraz? Wszystko mi odbierze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: Po co było to wszystko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: O kim mówisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: Czy ty umierasz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: Już… nawet nie pamiętam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: W myślach powtarza mi się jedno słowo: „Zeskocz. Zeskocz. Zeskocz.”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: Nie wiem, czy to wiadomość do mnie… czy do ciebie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: Jestem zgubiony…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: Powróżysz mi znowu, proszę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: Może to pomoże.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: Gdzieś pod koniec
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: Środek dwusetnej strony
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: Dziesiąta strona?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: Przedziwne pytanie. Nic już z tego nie rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: A zwykłem rozumieć… chyba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: Pamiętam zaledwie jedno słowo… „Zeskocz”. Co ono oznacza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: Czy to wiadomość do ciebie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: Pamiętasz, gdy poprosiłem o wróżbę ze stronic tej księgi? Czy możesz zrobić to ponownie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: Boję się. Może to pomoże.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: Gdzieś pod koniec
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: Środek dwusetnej strony
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: Dziesiąta strona?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: „Od dawna jedziemy donikąd pociągiem. Lecz pod jego kołami droga wciąż łoskocze”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: Teraz rozumiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: Wielkie nieba… Właśnie coś sobie przypomniałem. Dziękuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: Pójdę już sobie. Dobranoc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: „Między dwoma światy śpiewa się tę pieśń: Ogniu, ze mną krocz”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: A to szkoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: Dziękuję, ale to nie pomogło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: Dobranoc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: „Nasz młodzieńczy duch zaryczał jak ogniste stosy w Rouen…”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: Nie mam siły czytać dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: Chyba już sobie pójdę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: Dobranoc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: Hej, młody. Jak się mają sprawy w tej okolicy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: Nie jestem stąd. Nigdy nie mogłem wysiedzieć długo w jednym miejscu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: Dni włóczenia się też mam już za sobą. Starość nie radość, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: Dlaczego podróżujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: Czego tu szukasz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: Widziałeś, co wyrabiają ci Przybysze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: Dom za domem ktoś zamordowany, ktoś rozerwany na strzępy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: Udają ludzi… a potem wślizgują się do chałup i rozpętują piekło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: Robactwo trzeba tępić. Do ostatniego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: Chcesz polować na Przybyszy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: Gdzie masz wtedy giwerę?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: Tu w mieście? Tylko miejsca, by rozprostować kości, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: Od kiedy się porypało ze słońcem, zaczęli wyłazić chmarami ze swoich nor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: Coś knują, mówię ci, młody. Trzeba ich wystrzelać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: Chcesz polować na Przybyszy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: Gdzie masz wtedy giwerę?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: Przecież też na nich polujesz, czyż nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: Nie jesteś głupi, młody. Ale czym mam ich pokonać? Brzydkimi wyrazami?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: Puść jednego, a zaraz wróci i rozpruje ci gardło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: Te przebiegłe szczury nie dadzą ci drugiej szansy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: Miałem karabin. Prawie przez niego zginąłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: Poczekali, aż zasnę z wycieńczenia i wtedy porwali sztucer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: Uciekłem, gdzie pieprz rośnie, a oni zaczęli za mną strzelać. Ichni pomysł na rozrywkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: Nie ma w nich nic ludzkiego poza powierzchownością, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: Wiedziałem, żeś nie mięczak. Masz jaja, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: Wytrzebimy ich. Nie puścimy żadnego w promieniu kilometra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: Do diabła, może i tak lepiej. Może jesteś jednym z nich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: Poderżnąłbyś mi nad ranem gardło…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: Zobaczysz, porachuję się z całym tym robactwem. Tylko patrz, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: D‑dobry wieczór.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: Upał mi nie d‑doskwiera. Szukam jedynie spokojnego miejsca do odpoczynku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: Czy znajdę u ciebie trochę s‑s‑spokoju?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: Jak długo szukasz schronienia?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: To już b‑bez znaczenia. Myślisz, że jestem Przybyszem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: N‑nie jestem. Mam jednak prośbę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: Ale o tym później. Nie wiem, czy mogę teraz ci na t‑tyle zaufać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: Ukrop ci nie przeszkadza?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: Zdejmij kurtkę
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: Nigdzie nie odnalazłem s‑spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: Więc… od długiego czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: Ukrop ci nie przeszkadza?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: Zdejmij kurtkę
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: Zawsze mi z‑zimno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: Inni p‑p‑palą się na słońcu, a ja ubrany na cebulkę i wciąż prawie z‑zamarzam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: Obawiam się ściągnąć którąkolwiek z warstw.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: A co, jeśli mi się pogorszy? I nie czeka m‑mnie śmierć i ulżenie w cierpieniu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: Nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: Nie musisz mnie wpuszczać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: Odejdę. Nie będę się prosił. Już nie będę ci p‑p‑przeszkadzał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: Dz‑dziękuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: Sufity trochę n‑niskie, ale może być.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: Rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: Dobrej nocy wtedy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: Widzę, że dłonie masz ubrudzone od prochu s‑strzelniczego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: Cz‑czy możesz mnie zastrzelić?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: Jasne. Pewnie szkoda ci n‑n‑nabojów. Do widzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: Hejo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: Jesteśże tam?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: Szukasz kogoś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: Razem z moją trzódką mieszkali my niedaleko stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: Te żółte facety wywaliły nas z bloku, ale nigdzie nie wywieźli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: Bezdomni my i znikąd pomocy. Gdzieżbyśmy mieli poleźć? Co mamy zrobić?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: Inni rozbiegli się na cztery wiatry. Ja żem przyszła tutaj spróbować przeżyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: Czemu was eksmitowali?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: Dużo was było?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: Jam nikogo nie szuka. Mamuśce potrzeba jeno miejsca, żeby głowę złożyć, cukiereczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: Całe sąsiedztwo przetrzepali, i teraz kto wie, gdzie nogi mają ponieść.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: Od tamtejszego czasu latam wszędzie, szukam kąta, co by mnie przyjął.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: Czemu was eksmitowali?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: Dużo was było?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: Gadali, że nasz blok trzepnął jakiś flar solarny czy inna głupota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: Przybieżeli żółte typy i powywalali wszystkie ludziska na zbity pysk. Kilku powzięli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: Innym kazali jeno spieprzać, jakby nic nie zaszło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: Cały blok człowieków!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: Kto się opierał, tego żółci za łachmany wzięli i precz. Brali każdego, kto się napatoczył.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: Gromadę mieszkańców pochwycili, niech ich ino pan Bóg strzeże. Nas reszty to już nie bardzo gonili.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: Teraz Mamuśka stara się tylko przeżyć, cukiereczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: Och, bądź błogosławiony. Nie otwierajże tylko tym żółtasom, co tu wszędzie łażą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: Tylko uchylisz drzwiczki i zaraz capną i ciebie i mnie i wywloką, Bóg wie gdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: No dobra. Tylko… nie otwieraj drzwiczek przed tymi żółtasami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: Tak w sumie to… nie otwierajże nikomu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: HA, HA, HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: Sprowadzę ja tu moją trzódkę. Wielka Mamuśka nie dopuści, byś pomarł samemu… HA, HA, HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: Wciąż się tu gnieździsz, jak widzę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: Jakie masz odczucia co do faceta w kombinezonie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: Wykonuje tylko swoje obowiązki
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: Nie wiem, co mam wobec niego odczuwać
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: Ostatnio nastały ciężkie czasy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: Jedna rzecz po drugiej, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: Może opatuleni w kombinezony przywrócą porządek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: A może powinniśmy wziąć sprawy w swoje ręce?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: Nic nie mogę z tym zrobić
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: Robię, co mogę
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: Po co w ogóle coś odczuwać?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: O wszystkim decyduje ktoś inny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: Istne błogosławieństwo, nie powiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: Chyba że chcesz sam wszystkim się zająć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: Nic nie mogę z tym zrobić
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: Robię, co mogę
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: Właśnie tak, wiem o tym!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: Co może począć pojedyncza osoba w obliczu kataklizmu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: Kosmicznej zagłady…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: Śmierci…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: Słuuuchaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: Czy jesteś sam?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: Jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: Nie jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: I co niby możesz zrobić?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: Przegonisz śmierć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: Zatrzymasz powodzie, pożary, zniszczenia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: Jedyne, co możesz zatrzymać to bicie serca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: Słuuuchaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: Czy jesteś sam?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: Jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: Nie jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: A więc skończyłeś sam jak palec.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: Z nikim się nie dogadałeś? Szkoda…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: Zatem wproszę się tyyylko na momencik. Mam dla ciebie prezent pożegnalny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: W tym nowym świecie trzymasz się życia niczym tonący brzytwy, jak widzę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: I po co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: Teraz psy rządzą światem. Tylko one tu przetrwają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: Rozumiesz, co chcę powiedzieć, prawda? Stare czasy nigdy nie wrócą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: Życie się zmieniło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: Wypadasz z rytmu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: Nasze następne spotkanie będzie… interesujące.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: Czuuujesz to?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: Prześladują cię zmiany.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: A także moja skromna osoba…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: Jedno z was jest teraz bezśmiertne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: Wszystko z powodu słowa. Jednego słowa. Ale cóż to jest za słowo…!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: Wiesz, o kogo mi chodzi, praaawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: Wokół ciebie dzieją się przedziwne rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: Nic nie czuję
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: Nie obchodzi mnie to
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: Musi być ci z tym ciężko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: Wygląda na to, że potrzebujesz pomocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: Może wypróbujemy coś nowego? Rodzaj zakładu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: Jeśli masz w domu co najmniej dwójkę z nas…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: Otworzysz mi drzwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: Ponieważ teraz w ich ciałach mieszkają psy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: Nie rozumiem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: Nie możesz przyjść później?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: Nic cię nie rusza, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: Masz wszystko gdzieś?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: Zmieńmy to.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: Jeśli masz w domu co najmniej dwójkę z nas…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: Otworzysz mi drzwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: Nie rozumiem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: Nie możesz przyjść później?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: To proste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: Spróbujmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: Ale najpierw…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: Czy jesteś sam?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: Jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: Nie jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: Szkoda… Pójdę sobie… na jakiś czas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: Ale zanim pójdę, zagrajmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: Czy jesteś sam?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: Jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: Nie jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: Hmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: Taaak… Nasza gra przynosi rezultaty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: Chodź ze mną.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: Proszę, proszę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: Teraz nawet nas rzadko spotkać. A co dopiero was, pozamykanych w czterech ścianach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: Zmiany to nie najgorsze, co cię spotka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: Nie myślisz chyba, że ja tu rządzę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: Istnieją o wiele potężniejsze istoty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: Ja tylko robię, co mi każą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: A więc…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: Do zobaczenia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: Powiedzieli mi, że to nasza ostatnia rozmowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: Wszystko dobiega końca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: Będzie to dzieło albo naszych, albo waszych rąk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: Co masz na myśli?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: Co dobiega końca?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: Przekazuję ci tylko to, co mi powiedziano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: Nic więcej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: Czy już to czujesz? Śmierć zbliżającą się krok za krokiem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: Już wam dyszy za plecami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: Po co wciąż to przychodzisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: Czemu po prostu nie wyważysz drzwi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: Sam nie wiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: Ale śmieszne, że ty nic nie czujesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: Nie lękaj się, możemy pomóc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: Po co wciąż to przychodzisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: Czemu po prostu nie wyważysz drzwi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: Dopiero teraz o to pytasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: Przyszło ci może do głowy… że jesteś wybrańcem? Ha, ha, ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: Wysyłają mnie nie bez powodu…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: By coś zmienić?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: Ale rezultat jest zawsze taki sam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: Zginiecie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: Jeśli nie dziś, to jutro. Jeśli nie jutro, to kiedy indziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: Znikniecie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: Ale teraz…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: Czy wpuściłeś kogoś z nas do środka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: Czy jesteś sam?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: Jest u mnie wielu ludzi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: Nikogo nie wpuszczałem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: Jest u mnie wielu… nieludzi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: Nie wpuszczam byle kogo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: Pozbyłem się wszystkich, którzy nie pasowali
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: Pozbyłem się niektórych, którzy nie pasowali
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: Czy boisz się nieznanego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: Zastanawiasz się czasem, czemu jeszcze żyjesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: Zdaje się, że głowę bardziej zaprząta ci myśl, co jest po śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: Umierasz więc. Co się dzieje potem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: Znikasz…? Na zawsze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: Czy cokolwiek będziesz czuł?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: Mnie ciekawi coś innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: Czy wpuściłeś kogoś z nas do środka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: Jest tu wielu ludzi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: Nikogo nie wpuszczałem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: Jest tu wielu nieludzi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: Nie wpuszczam byle kogo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: Pozbyłem się wszystkich, którzy nie pasowali
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: Pozbyłem się niektórych, którzy nie pasowali
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: Zatem jesteś gotów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: Odczuwasz strach?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: Taaak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: Wciąż nie możesz wziąć spraw w swoje ręce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: Dlatego tu jestem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: Uciekasz, wciąż uciekasz. Przed podobnymi mnie, przed prawdą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: I po co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: Co trzyma cię przy życiu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: Wkrótce wszystko się skończy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: Po co stawiać opór?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: Ej, ty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: Cały świat dostał hopla, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: To koniec cywilizowanego świata. Bestie wypełzły rządzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: W końcu… nie trzeba się hamować.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: O czym ty mówisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: Czy jesteś jedną z tych „bestii”?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: Byłeś może w którymś z okolicznych domów? Łaziłeś ulicami?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: Wszystkie wasze prawa i morały diabli wzięli, miśku. Znaczą tyle, co figa z makiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: Teraz wszystko jest takie proste. Rozpłatasz szubrawcowi gardło i wygrywasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: W ilu byłeś domach?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: Jak przeżyłeś tak długo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: Każdy z nas to zwierzę, brachu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: Zaprzeczaj temu, a w końcu cię pożrą żywcem. Nawet kości się nie ostaną.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: Taki jest nowy porządek świata: argument siły jest najważniejszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: Kto twierdzi inaczej, do rana będzie posłany do piachu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: W ilu byłeś domach?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: Jak przeżyłeś tak długo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: W żadnym z nich nie zagrzałem miejsca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: W każdym było to samo. Strach zaślepia ludzi na pełny obraz sytuacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: Ale u ciebie? Wciąż panuje porządek. To rzadkość, miśku. Ciekaw jestem, jak to robisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: O, patrzcie, patrzcie, jaki kozak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: Im mniej wiesz, tym dłużej żyjesz. Ja ciebie o to nie pytałem, co nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: Chodzi mi o to, że nie zamierzam ci tu mieszać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: Dobry piesek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: Teraz liczy się wyłącznie silna ręka, miśku. Możesz się z tym pogodzić albo dostać jedną w pysk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: Ach… A więc to tak, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: Spodziewaj się mnie później, miśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: O‑och, myślałem, że nikogo nie zastanę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: Nocą jest tu bardzo cicho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: Dobry wieczór! Czy mogę wejść?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: Obserwował pan mój dom?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: Szuka pan czegoś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: Słucham? Nie, nie, proszę się nie wygłupiać!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: To po prostu rzadkość, by zamieszkany dom był tak cichy w nocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: Zazwyczaj słychać jakieś pijackie pokrzyki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: Albo płacz…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: Albo wrzaski…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: Kim pan jest?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: Skąd pan przyszedł?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: Dlaczego pan pyta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: Szukam tego, co wszyscy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: Bezpieczeństwa… i przy odrobinie szczęścia także konwersacji, żeby się nie nudzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: A że tu było tak cicho, nie sądziłem, że są tu jacyś ludzie. Pomyślałem więc, że zerknę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: Drzwi były zamknięte, a niegrzecznym byłoby je od razu wyważać, nie pukając.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: Kim pan jest?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: Skąd pan przyszedł?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: Jestem chirurgiem. Przeprowadzałem operacje na chorych.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: Na oddziale zawsze brakło funduszy, więc często leczyłem pacjentów ze schorzeniami spoza mojej specjalizacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: A teraz… nie ma już szpitali. Wędruję więc i pomagam, gdzie mogę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: Jeśli mnie pan wpuści, opowiem, co się stało ze szpitalami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: W mieście był jeden szpital, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: To długa historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: Jeśli będzie pan tak uprzejmy i mnie wpuści, chętnie ją opowiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: Dziękuję. Mam nadzieję, że będę mógł tu komuś pomóc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: Rozumiem, że niełatwo jest komuś zaufać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: Będę w pobliżu, więc proszę nie wahać się poprosić o pomoc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: Mmmf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: Mmmmmmmmf?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: Co jest z tobą nie tak?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: Słucham?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (Mężczyzna patrzy na ciebie z uniesionymi brwiami).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (Zdaje się, że nie potrafi odpowiedzieć).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: Czy ktoś ci zaszył usta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: I co ja mam z tobą zrobić?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (Jego brwi wyginają się w niepokoju).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: (Znowu coś mamrocze, ale nic nie rozumiesz).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: Czy ktoś ci zaszył usta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: I co ja mam z tobą zrobić?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (Mamrocze coś i wymachuje rękami).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (Nie masz pewności, ale zdaje się, że policzek ma mokry od łez).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: Odejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: (Stoi tylko i patrzy się przez wizjer).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (Nie masz pewności, ale zdaje się, że policzek ma mokry od łez).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: Odejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (Kiwa głową i przechodzi przez próg).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (Stoi tam i mamrocze).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: Sio! Precz!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (Straszysz go swoim krzykiem).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (Mija chwila, po której odwraca się i odchodzi).'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: Kłaniam się. Ma pan zaiste piękny dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: Głęboka tu cisza. W mieście sam wrzask panuje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: Żywiłem nadzieję, że raczy mnie pan przyjąć w swe zacisze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: Dlaczego nie został pan w domu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: Co tu niby jest pięknego?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: Czuję się iście przeokropnie. I nie mowa tu jedynie o mojej gangrenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: Jak co ranek unoszę powieki, leżę i rozmyślam, czy ujrzę dzień następny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: Taką historię najlepiej przełknąć jednym, obrzydliwości pełnym, haustem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: Miejski harmider klei się do mnie niczym poty jakieś. Szał, gonitwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: Człowiek desperacko chwyta się szansy, by żyć. Tutaj wszakże… pogodzony jest pan z tym, co nadejść ma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: Chciałbym ostatnie me tchnienie wydać tu. Powoli. Po cichutku. Rozkoszować się ostatnimi chwilami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: Jak dostał pan gangreny?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: Może amputujemy panu rękę?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: Cisza… pustka… Wszystko jakby dech tu wstrzymało.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: Aż drżę, bez względu, że pełny jestem skwaru miasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: Gorączka bez ujścia. Ulice tak samo gorące w nocy, jak i za dnia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: Bez znaczenia i to, gdyż wciąż drżałbym. To martwica, widzi pan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: Jak co ranek unoszę powieki, leżę i rozmyślam, czy ujrzę dzień następny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: Taką historię najlepiej przełknąć jednym, obrzydliwości pełnym, haustem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: Nie przynależę do tego zamętu, gdzie życie pod wiatr miota się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: Jak dostał pan gangreny?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: Może amputujemy panu rękę?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: Uczciwe to pytanie. Na chwilę tę… powiem tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: Kiedyś razem z moją lubą wspólne chwile dzieliliśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: Każdego dnia… zmieniała się. Troszkę po troszku. I jakże to było piękne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: Aż nie przyszli ci inni. I, cóż… koniec historii sam pewnie nasuwa się panu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: Stoję teraz u pana progu. Samojeden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: Myśli pan, że z sepsą pomoże to?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: Nie. Takiej życzliwości nie trzeba mi. Zdaje się… że tutaj nieuniknione akceptowane chętnie jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: Z powodu tego przybyłem tu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: To tu przejdę do tej ostatniej, nieznanej krainy i zjednoczę się z nią. Pójdę w pokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: Zaprawdę, nigdzie nie słyszałem ciszy tak iście głębokiej, jak ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: Czy piękno postrzega pan niczym przez oczy moje, nie wiem jeszcze. Powiedz tylko… czy ciała wyrzucasz w nocy mrok?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: Zachowaj moje, gdy czas ten nadejdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: Czy przeciwko coś miałby pan, gdybym w niedalekim dystansie pozostał?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: Poczekam, aż śmierć przygarnie mnie w czułe ramiona swe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: Znajdę gdzieś cienia skrawek. Proszę jednak… nie wyrzucajże martwej istoty mojej, gdy czas ten nadejdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: Hej, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: Słuchaj, jestem jakby po uszy w gównie. Czy mógłbym jakoś… się u ciebie skitrać?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: Co się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: Z czym potrzebujesz pomocy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: Od czego tu zacząć? Jestem taryfiarzem, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: Wiozłem takiego pasażera, a wtedy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: Wiesz, jak to bywa. Okazało się, że nie był tym, za kogo się podawał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: Teraz go już nie ma… ani mojej taksówki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: Co się stało z samochodem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: Co się stało z pasażerem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: Miałem samochód, ale już go nie mam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: Straciłem go z własnej głupoty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: Nie chodzi nawet o to, że jestem głupi. Zaufałem jedynie niewłaściwej osobie, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: Co się stało z samochodem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: Co się stało z pasażerem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: Te mendy z FEMA mi go skonfiskowały.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: Wiozłem pasażera i zauważyłem, że ma bardzo białe zęby. Aż zbytnio białe, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: Więc tak jakby podrzuciłem go do FEMA. A oni nie mieli zamiaru dać mu spierniczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: Z początku mnie pochwalili „Świetna robota, obywatelu. Pomóż nam, pomóc wam!”, ble, ble, ble… I wtedy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: Łajzy wytargały mnie z samochodu, bo też chciały mnie zamknąć!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: Więc tak jakby jednemu przywaliłem z butelki, którą miałem w płaszczu, i dałem nogę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: Nie mam żadnych schiz ani nic, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: Ten gość był Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: W lusterku mignęły mi jego śnieżnobiałe zęby, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: Nie myśląc wiele, zawiozłem go prosto do FEMA. To był wieeelki błąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: Tak jakby chcieli mnie zgarnąć razem z tym, co im przywiozłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: Dałem dyla. Nawet do domu nie mogę wrócić, wiesz? Te podstępne szuje pewnie tylko na to czekają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: Ufff… dzięki, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: Tylko nie ufaj tym żółtym szmaciarzom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: Wystarczy mrugnąć i zaraz cię capną.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: Ejże, stary… Nie rób mi tego!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: Przyznaję, spanikowałem, ale to nie powód, aby mnie zostawiać na lodzie, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: Kurczę blade…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: Jesteś taki sam, jak te pojeby z FEMA. Obyś tu zgnił.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: Dzień dobry, gospodarzu. Czy wynajmuje pan pokoje?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: Tak, coś w tym stylu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: Po prostu zapraszam ludzi do środka
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: Hmm… Jakaś niejasna ta odpowiedź.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: Dobrze więc. Umowę możemy spisać kiedy indziej. Oczywiście z datą wsteczną.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: Chociaż… jeśli pominiemy oficjalną umowę, ile pan bierze za noc?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: Zapłać pan co łaska, jeśli taka wola
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: Nie potrzebuję pana pieniędzy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: Czy mnie słuch nie myli? Powiedział pan, że po prostu wpuszcza ludzi? Czy to jakiś wolontariat? Azyl dla bezdomnych?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: Proszę mi wybaczyć, ale odmawiam najmu cennej powierzchni bez uiszczenia odpowiedniej opłaty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: Zapłać pan co łaska, jeśli taka wola
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: Nie potrzebuję pana pieniędzy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: Wypraszam sobie. Czy wyglądam, jakbym potrzebował pańskiej łaski?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: Niewiarygodne… Pomyśleć tylko, że członek szanowanej instytucji wynajmu odmawia przyjęcia sowitej zapłaty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: Niech i tak będzie. Później zajmiemy się tą sprawą i podpiszemy pełną umowę najmu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: Proszę o wybaczenie, ale nie mogę z czystym sumieniem przebywać u pana bez opłacenia odpowiedniego czynszu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: To niestosowne. Gorzej, to nielegalne…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: Albo panu zapłacę, albo nie przekroczę pańskiego progu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: Dziękuję, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: Wszystkie szczegóły wynajmu możemy przedyskutować o innej porze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: Że co, proszę? Czy pan właśnie powiedział, że powinienem odejść? Czy to była groźba?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: Niech pan do mnie nie mówi takim tonem. Mogę to odczytać jako groźbę karalną…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: …która, nawiasem mówiąc, stoi w sprzeczności z artykułem 119 Konstytucji. Proszę mi wierzyć, to nie wróży panu dobrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: Życzę miłego dnia…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: Kurza twarz… ktoś tu mieszka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: Przepraszam, myślałem, że ten dom jest opuszczony. Już sobie idę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: Z drugiej strony…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: Posłuchaj, yyy… Czy mógłbym u ciebie trochę zostać? Już od dawna nie byłem wśród, no wiesz… ludzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: Czemu jesteś sam?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: Myślisz, że to dobry pomysł?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: A kto by chciał mojego towarzystwa, hm? Ludzie wrzucają mnie do jednego wora z marginesem społecznym.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: Jakbym był od nich gorszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: A sam widziałem, do czego zdolni są ludzie. Obok najgorszych to ja nawet nie stałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: Nie… nigdy nie pasowałem do żadnej z grup… Więc śpię na dziko w samotności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: Jak przeżyłeś samemu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: Okradasz ludzi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: Pewnie, czemu nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: Byłem sam… od kiedy Przybysze wyleźli, cholera ich wie skąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: Najpierw myślałem, że tak będzie bezpieczniej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: Ale prawdę mówiąc, przyjacielu, mam tego dość. Basta z tym gadaniem do cieni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: Zaczyna mi to doskwierać. Czuję, że tracę głowę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: Jak przeżyłeś samemu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: Okradasz ludzi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: Hm, nie ma co bajerować. Włamuję się do opuszczonych domów i pustych mieszkań.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: Szabruję, co mogę. Część sprzedaję, część zatrzymuję dla siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: Miałem jedną sytuację, przez którą niemal z tym skończyłem… Niemal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: Ale tak… miałem zamiar się tu włamać. Myślałem, że nikogo tu nie ma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: Bez urazy, ale skoro tyś tu gospodarzem… czy mógłbym u ciebie na trochę zostać, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: Mam wiele historyjek do opowiedzenia. Niejedno widziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: Co, masz mnie za jakiegoś oprycha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: Święty nie jestem, ale pewnych granic nie przekraczam. Nie podniosę ręki na drugiego człowieka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: Był raz… gdy nie miałem wyboru. To długa historia, mogę ją opowiedzieć później.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: W każdym razie… skoro tu mieszkasz, czy mogę zostać na noc?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: Hurra! W końcu pójdę spać jak normalny człowiek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: Przychodź o każdej porze na pogawędkę. Przyjacielu, mam tyle historii do opowiedzenia. Nawet więcej niż kilka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: I obiecuję, że żadna nie jest nudna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: Nie ma problemu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: Nie wiesz może, czy któryś z pobliskich domów stoi pusty?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: Tylko tędy przechodziłem, nie zapuszczę tu korzeni. Słowo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: Już… ech, sobie poszedłeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: W porządeczku. Wtedy ja też już sobie pójdę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: Jest tam ktooo? Czy ktoś tu żyje?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: Wpuścisz mnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: Nie wal mi w drzwi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: W swój zakuty łeb lepiej się walnij!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: Hej, nie żyw urazy. Nie chciałem cię obudzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: Sam nawet nie zmrużyłem oka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: Byłem grabarzem, wiesz? Teraz nie ma dla mnie zajęcia…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: Groby już nie mają znaczenia. Ludzie po prostu wywalają się i gniją tam, gdzie padli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: Widziałeś coś na cmentarzu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: Czyli porzuciłeś pracę?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: Przepraszam za to walenie, ja tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: Nie uwierzysz, co widziałem, gdy kopałem ostatni dół…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: Ostatnio ludziska padają jak muchy, ale nie ma komu ich grzebać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: Zostawiają ich tam, gdzie legli. Słońce i tak niemalże ich wszystkich spopiela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: Widziałeś coś na cmentarzu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: Czyli porzuciłeś pracę?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: Pewno, że tak, do pioruna. Kopałem grób zamówiony przez jakiegoś gościa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: Stał nade mną i patrzył, jak kopię.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: A ja kopię, kopię i nagle… bum! Uderzyłem w coś łopatą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: Myślałem, że to jakiś kamień, ale nie… spod ziemi wygrzebywała się ręka!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: To Przybysz wykopywał się z ziemi! A tamten facet tylko boki zrywał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: Spieprzałem tak, że się za mną kurzyło. Bałem się wrócić do domu. Pomyślałem, że w kupie bezpieczniej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: Kij z pracą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: Nikt i tak już nie przynosi zmarłych. Mówię ci, ludzie przestali dbać o należyte pochówki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: Słońce i tak spopieli trupy. A te noce… są za krótkie, żeby posługiwać przy martwych.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: Gdyby tylko kłopoty dawały nam tyle, ile my dajemy z siebie im.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: Tak czy owak, rzuciłem tę robotę. Do diabła z nią. Mam dość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: Dz‑dzięki!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: Tylko szybko zamknij drzwi, dobrze? Umieram ze strachu na myśl, że zaraz za mną mogą być ci Przybysze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: Ja pierniczę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: W krzyżu mnie łupie od ciągłego kopania dzień za dniem przez całe życie. I co z tego mam?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: Wracam do pustego domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: Potem pukają Przybysze… albo jeszcze gorzej – są już środku i czekają na ciebie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: Słyszałem, jak ludzie mówią… Ktoś wychodzi z domu, wraca i bum. Zgon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: Wykopię sobie głęboką dziurę i nigdy z niej nie wyjdę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: Halo? Jest tam kto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: Słyszę kroki… wiem, że stoisz za drzwiami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: Czy możesz… otworzyć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: Najpierw zwróć tych, których zabrałeś
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: Tym razem przyszedłeś po mnie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: Zabrałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: Och… myślisz, że jestem funkcjonariuszem FEMA? Z powodu tego kombinezonu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: Zdjąłem go z trupa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: Pomyślałem, że w nim będę bezpieczniejszy. W końcu z jakiegoś powodu je noszą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: Może w nocy jest jakieś promieniowanie posłoneczne? Nawet nie chcę wiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: Kim wtedy jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: Co planujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: Nie rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: Och! Nie, nie jestem z FEMA. Czy to przez ten strój?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: Z tego, co widziałem, wszyscy ich nienawidzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: Za… czymkolwiek to jest, czym oni się zajmują.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: Zabierają ludzi… a ci nigdy nie wracają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: Kto wie, co tam naprawdę się wyrabia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: Kim wtedy jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: Co planujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: Zwykłym robotnikiem z fabryki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: Składałem i naprawiałem lodówki'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: Ale… nie pracuję już tam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: Coraz mniej ludzi, a roboty coraz więcej. Nie wyrabialiśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: Miałem dość i odszedłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: Dobre pytanie. Teraz czuję się… zagubiony.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: Miałem pracę. Myślałem, że wszystko się ułoży.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: A potem nadeszło rozczarowanie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: W końcu nie robiłem nic z tego, co miało być moim obowiązkiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: Mam na myśli programowanie. Pisanie kodu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: Serio? Och, dzięki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: Gdzie mogę usiąść?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: Nie sądziłem, że mnie wpuścisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: Serio? Och, dzięki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: Czekaj… nie to miałem na myśli. Rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: Zdaje się, że kombinezon raczej odstrasza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: Nawet nie wiem, po co go noszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: Do widzenia…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: Miewasz kiedyś sny?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: Słucham?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: Raczej nie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: No wiesz, sny. Wiesz przecież, czym są. Kiedy śpisz… widzisz coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: Wiesz, co sobie uświadomiłem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: Ludzie teraz prawie nie śnią.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: Jak myślisz, dlaczego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: Dlaczego cię to obchodzi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: A czy ty śnisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: No proszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: Jesteś jak cała reszta. Nawet jak chorują… nic.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: Ciekawe… czy winić za to słońce? Czy to coś innego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: Dlaczego cię to obchodzi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: A czy ty śnisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: Sny są… ulotne i przedziwne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: Śnimy, gdy poszukujemy odpowiedzi lub ukojenia… albo chwili spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: Ale teraz? Kruszą się. Tracą kształt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: To chyba dlatego, że utraciły tę uświęconą przestrzeń. Czas odpoczynku i refleksji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: No dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: Ciężko powiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: Od sześciu dni nie spałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: Może gdybym się kimnął, sen by nadszedł.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: No dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: Dzięki. Postaram się tu zasnąć, chociaż pewnie nie wypocznę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: Ale jeśli ktoś tu jeszcze śni, byłoby to równie miłe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: Uważasz, że ludzie kiedyś znowu zaczną śnić?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: Ja mam taką nadzieję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: Trudno jest nie mieć snów. Wszystkim jest przez to ciężko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: Dzień dobry, przesyłka od For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: Nie wiedziałem, że wciąż dostarczają przesyłki
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: Życzę miłego dnia… och, to znaczy miłej nocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: Wciąż się do tego nie przyzwyczaiłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: Dzień dobry, przesyłka od For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: Jak pan został kurierem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: Przeszedłem testy. Sprawdzili wszystkie objawy, zdecydowali, że jestem człowiekiem i…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: Och, ma pan na myśli dlaczego wciąż pracuję mimo apokalipsy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: Cóż, co innego miałem zrobić? Siedzieć w domu i marnieć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: Przebywając na zewnątrz przynajmniej nie myślę o tym całym burdelu…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: Życzę dobrej nocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: Witam… mam dla pana przesyłkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: Wygląda pan na zmartwionego
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: FEMA zgarnęła kolegę z pracy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: Jak co dzień, poranne testy. Zauważyli jego przekrwione oczy… cholera jasna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: I po wszystkim. Odciągnęli go. Nawet nie wiem, co się z nim dalej stało i czy go kiedykolwiek wypuszczą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: A co, jeśli z niewyspania moje oczy też będą czerwone? Też mnie złapią i wezmą do tych pieprzonych stref kwarantanny?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: Życzę dobrej nocy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: Przesyłka…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: Co się panu stało?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: Zamordowali mojego kolegę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: Dostarczał przesyłkę, a odbiorca…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: Ludziom odjebało.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: Dlaczego, u licha, ten kretyn myślał, że zwykły kurier jest niebezpieczny? Po co go zabijać? W jakim, kurwa, celu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: Proszę. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: Taaak. Pana dom nadaje się znakomicie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: Czuję to.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: Co dokładnie pan czuje?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: Tak, i należy do mnie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: Śmierć…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: Śmierć upodobała sobie ten dom. Bardzo go lubuje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: Nie wiem, ilu tu pomarło… ale Jej obecność jest silna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: Kim pan w ogóle jest? Czemu jest pan tak ubrany?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: Wygląda pan na jakiegoś dziwoląga z sekty
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: To prawda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: Śmierć jest wszędzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: Niektórzy spłonęli. Innych porwano i zabito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: Jest pan ulubieńcem Śmierci, taaak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: Kim pan w ogóle jest? Czemu jest pan tak ubrany?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: Wygląda pan na jakiegoś dziwoląga z sekty
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: Jesteśmy apostołami nowej wiary, głosicielami świętej doktryny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: Śmierć przybyła. Pragnie przynieść ukojenie ludziom, uwolnić nas od chaosu, zgryzoty i szaleństwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: My jedynie pomagamy Jej się zbliżyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: To jedyna droga ku zbawieniu. Nie ma innego wyjścia…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: Czego wtedy pan chce?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: Chce pan wejść czy coś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: Raczej tak. Czy to doprawdy takie złe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: To mój całun. Będzie mi potrzebny, gdy umrę. W ten sposób nie potrzebujemy okrycia dla naszych zmarłych.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: Nie wierzymy w zbawienie. Chyba, że pochodzi od samej Śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: Ona jest tuż, tuż. Pomagamy Jej przekroczyć próg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: Czego pan wtedy chce?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: Chce pan wejść czy coś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: Musimy dokonać obrządków pogrzebowych. Zupełnie nowych.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: Pana dom nadaje się do tego znakomicie, taaak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: Wpływy Śmierci są tutaj silne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: A tak w ogóle, co się tu dzieje?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: W każdym razie, niech pan wpuści moich braci. Proszę ich chronić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: Muszą przeżyć dostatecznie długo, by wykonać polecone im zadania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: Jakoś się nie palę do tego pomysłu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: Brzmi jak nie lada zlecenie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: Ja nie potrzebuję wchodzić. Moją misją jest szerzyć uświęconą prawdę przynoszącą wieczny pokój.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: Moi bracia jednak potrzebują schronienia. Śmierć ciągnie do tego miejsca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: Przeprowadzą obrządki pogrzebowe dla zmarłych. Proszę zadbać o ich bezpieczeństwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: Jakoś się nie palę do tego pomysłu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: Brzmi jak nie lada zlecenie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: A może jednak ognie pana czekają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: Proszę dbać o moich ludzi i pamiętać, że jeśli któryś z nich zginie… pana dom obróci się w zgliszcza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: Jeżeli do tego dojdzie, wszystko spełznie na niczym.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: Jeśli tak się stanie, doszczętnie spalimy pana dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: Proszę o wybaczenie, ale nie ma innej drogi ku wypełnieniu naszej świętej misji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: To was wszystkich powystrzelam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: Nie lubię gróźb, ale dobrze, pomogę
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: Bo takim jest. Droga ku szczytniejszemu przeznaczeniu nigdy nie jest prosta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: Nie pragnie pan spokoju? Świata, w którym nikt nie ciąży drugiemu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: Proszę dbać o moich ludzi i pamiętać, że jeśli któryś z nich zginie… pana dom obróci się w zgliszcza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: Jakiekolwiek inne wykroczenie… i zawiedziemy w realizacji naszego celu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: Niestety, jeśli nasz plan tutaj zawiedzie, pana dom spotka płomienny los.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: Niestety… nie ma innej drogi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: To was wszystkich powystrzelam
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: Nie lubię gróźb, ale dobrze, pomogę
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: Uważa pan, że tylko my niesiemy płomień naszej wiary?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: Przyjdą inni. Zastaną pana we śnie, obleją dom benzyną i rzucą weń rozpaloną zapałką.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: Nawet jeśli pan przeżyje, z domu zostanie pogorzelisko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: Dokąd się pan wtedy uda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: Więc może… pozwoli im pan zostać, taaak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: Nie sądzę, by to zajęło długo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: Dziękuję uprzejmie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: Rychło się uwiną. Lecz mimo tego, niech ich pan dogląda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: Do zobaczenia. Wrócę ich sprawdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: Przejdźmy do sedna. Jak się mają moi współwyznawcy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: Tak, tak, nic im nie jest
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: Gówno mnie to obchodzi, mam swoje problemy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: Dziękuję za pańską ofiarę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: Jestem pewien, że pan też jest zmęczony. Cały ten harmider, ciężkie czasy, zamieszanie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: Niedawno przemówiła do mnie Śmierć. Pragnie się z panem spotkać, gdy nadejdzie czas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: Może zaoferować panu kryjówkę. Schronienie od wszystkiego. Nawet przed końcem wszystkiego…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: Sam jeszcze nie wiem, co to znaczy… Ale brzmi kusząco, praaawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: Chwila…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: Wszyscy nie żyją?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: Pan… odebrał nam naszą jedyną szansę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: Żegnam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: Śmierć już do mnie nie przemawia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: I tak kończy się ten świat. Nie z hukiem… ale skomleniem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: Och, ale u pana wszystko gra, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: Pana trzódka ma się dobrze
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: Spadaj pan, jestem zajęty
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: Taaak. Jak być powinno. Jej wzrok wciąż na nas pada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: Nie będę zwlekać. Odejdę teraz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: Weź pan ze sobą swoich cudaków
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: O co wam chodzi z tą „Śmiercią”?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: Opuścili tę doczesną krainę…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: Więc to dlatego…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: Wie pan… jeśliś pan wybrańcem Śmierci, dobrowolnie pomogę Jej się lepiej panu przyjrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: Dobranoc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: Weź pan ze sobą swoich cudaków
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: O co wam chodzi z tą „Śmiercią”?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: Czemuż to?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: Zostaw mnie w spokoju
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: To nie przedszkole
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: Zbliża się dzień Jej przybycia… Czuję to, taaak…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: Ale to nieważne, jeśli w pełni nie pojmujemy, co chcemy tu przywołać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: Natomiast znaczenie ma, że wszyscy padamy ze zmęczenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: Mimo tego przeraża nas myśl o wiecznej pustce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: Pojęcie „życia po Śmierci” to tylko mrzonki obiecywane przez kłamliwe religie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: Cykl odrodzenia? Raczej niekończąca się męka z krótkimi przerwami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: Z kolei Śmierć sama w sobie… Ona może zbawić nas od najgorszego losu: pustki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: Nie mamy wyboru jak tylko wzywać Ją.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: Zostaw mnie pan w spokoju
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: To nie przedszkole
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: Niech tak będzie… zrobił pan wystarczająco wiele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: Wezmę ich ze sobą. Pomimo tego proszę przyjąć wyrazy wdzięczności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: Czy doprawdy byli aż takim ciężarem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: Czy może jednak nie pragnie pan pokoju?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: Mimo tego odejdziemy wdzięczni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: Stało się, co miało się stać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: Uszanowanko, drogi chłopcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: Znasz mnie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: Och, ho, ho! Jestem tylko starym piernikiem, który wie to i owo o grzybach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: Ale mniejsza ze mną. Grzybnia zdradziła mi coś niepokojącego, och tak…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: Zbliża się Festiwal Grzybów! A czas, drogi chłopcze, przecieka nam przez palce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: Błagam więc, wysłuchaj mnie uważnie i bacz na moje słowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: Grzybnia?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: Nie całkiem rozumiem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: Oho! Naturalnie, że cię znam! Grzybnia mi rzekła!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: Jej mowa jest dosyć zagadkowa, ale nauczyłem się odczytywać wysyłane przez nią sygnały, och tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: Nastaw wtedy uszu, drogi chłopcze. Czeka nas dużo pracy, a czasu braknie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: Grzybnia?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: Nie całkiem rozumiem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: Tak, tak, rozumiem, że zwykłym człekom trudno to pojąć. Mówią w swój dziwny sposób.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: Grzyby porozumiewają się poprzez grzybnię.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: Wprawiłem się nasłuchiwać jej dzięki Księdze Uśmiechu. Jednak co ostatnio mi rzekła… Biada nam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: Mówiła o nadchodzącym Festiwalu Grzybów… A to, drogi chłopcze, nie wróży nam dobrze. Nie, nie, nie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: Księga Uśmiechu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: Festiwal Grzybów?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: Aha! Lada dzień wszystko nabierze sensu. Och, i pamiętaj, że musimy powstrzymać Festiwal… za wszelką cenę!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: A teraz popatrz no tutaj… mam tu coś, co nam pomoże: Księgę Uśmiechu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: Księga Uśmiechu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: Festiwal Grzybów?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: To wyjątkowa lektura, jedyna w swoim rodzaju. Ona ci powie, co trza zrobić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: Obawiam się jednak, że nie ma czasu, aby ją całą przeczytać. Jest opasła… a my nie mamy ani chwili do stracenia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: Wyrwałem z niej więc tylko najważniejsze stronice. Proszę, chłopcze. Przyjmij je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: No dobra, wezmę te pioruńskie strony z Księgi Uśmiechu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: Zatrzymaj je sobie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: Oho, mój drogi chłopcze…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: Odpowiedź na to pytanie znajdziemy w Księdze Uśmiechu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: Powstanie niebosiężny grzyb… I rozsieje zarodniki swe na cztery wiatry.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: Cień jego rozwinie się i pochłonie słońce… Żadnemu miejscu nie oszczędzi swawoli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: Ale grzyb nie wzrośnie sam, gdyż wszyscy wiedzą, że to cały Festiwal!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: O jejku! Nie możemy na to pozwolić. Musimy to powstrzymać… Ty i ja, mój chłopcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: Wyrwałem kilka stronic z Księgi Uśmiechu. Proszę, przyjmij je. One cię poprowadzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: No dobra, wezmę te pioruńskie strony z Księgi Uśmiechu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: Zatrzymaj je sobie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: Dobry chłopiec. Przeczytaj je w chwili spokoju, zgoda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: A teraz… czas mnie goni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: Wrócę, gdy będziesz miał wszystko gotowe! Zatem zagęszczaj ruchy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: Życzę ci dobrego dnia, zdróweczka, uciechy i mnóstwa uśmiechów, drogi chłopcze. Do widzonka!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: Czemuż to? To tylko ułamek całości… A ja mam cały spamiętany…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: Fe… może tylko marnuję cenny czas z wami, gołowąsami…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: Znowu się widzimy, mój chłopcze! Rad jestem, żeś zrobił wszystko, czego chciała Księga Uśmiechu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: Mam nadzieję, że to wystarczy do powstrzymania Festiwalu…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: Skąd wiesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: Nie brzmisz na przekonanego
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: No rzecz jasna! Grzybnia mi rzekła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: Ona wie o, och, tylu rzeczach. Teraz jednakże zbierają się nad nią czarne chmurzyska… jak i nad nami wszystkimi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: Grzyby wyrastają zbyt rychło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: Jak to, co robimy, powstrzyma Festiwal?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: Nie możesz poprosić grzybów, by zrezygnowały z Festiwalu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: Och, mój drogi chłopcze… Gdyby to było takie proste. Wciąż nie wiemy czy to, co zrobiliśmy, w ogóle pomogło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: Możemy teraz jeno czekać i żywić nadzieję, że to wystarczy, by zatrzymać wzrost grzybów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: Jak to, co robimy, powstrzyma Festiwal?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: Nie możesz poprosić grzybów, by zrezygnowały z Festiwalu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: Celebrowaliśmy stareńki rytuał, mój drogi chłopcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: Nie można przemawiać do grzybów bezpośrednio, nie, nie, nie! Nie jesteśmy częścią grzybni!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: Jednakowoż Księga Uśmiechu pokierowała nas drogą ku uspokojeniu ich korzeni i nieustannego wzrostu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: I to jest co, co żeśmy właśnie uczynili.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: Powrócę, gdy nadejdzie odpowiednia pora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: Upewnimy się, że grzyby pozostaną małe i zatrzymamy Festiwal, zanim się zacznie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: Pamiętaj, że grzyby nie zawsze są tym, czym się wydają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: Jeszcze się spotkamy, drogi chłopcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: Zaiste wspaniały pomysł… Ale nie mogę tak po prostu przemówić do grzybów. Nie, nie, nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: Są jeno tylko cząstką grzybowej sieci! Jednakże!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: Grzybnia jest jej mózgiem. Wielka szkoda, że potrafię jeno jej słuchać… Ona nie rozumie naszej mowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: Powrócę, gdy nadejdzie odpowiednia pora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: Upewnimy się, że grzyby pozostaną małe i zatrzymamy Festiwal, zanim się zacznie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: Pamiętaj, że grzyby nie zawsze są tym, czym się wydają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: Jeszcze się spotkamy, drogi chłopcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: Zdaje się, że Festiwal wciąż się zbliża…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: W grzybni panuje takie zamieszanie, że rytuał… cóż, spalił na panewce…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: Dlaczego się nie powiódł?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: Dlaczego wciąż dojdzie do Festiwalu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: Coś się pokiełbasiło wewnątrz grzybni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: Gdy w jej strzępkach odkłada się zbyt wiele nikczemności… Motyla noga, ona wtedy wszystko zatyka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: Grzyby przypominają wątrobę, chcą oczyścić organizm z toksyn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: Ostatnio zalała ją fala nikczemności, a grzyb urósł bez opamiętania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: Wielce tego nie chciałem, ale… musimy wyprawić się do Krainy Grzybów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: Krainy Grzybów?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: To nie brzmi najgorzej…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: Przeto Festiwal spowoduje niekontrolowany wzrost grzybów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: A to z kolei oznacza, że grzybnia byłaby w łajnie po pachy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: Wielce tego nie chciałem, ale… musimy wyprawić się do Krainy Grzybów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: Krainy Grzybów?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: To nie brzmi najgorzej…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: Oho, i w wielkim jesteś błędzie, drogi chłopcze! To upiorne miejsce, gdzie nie stanęła stopa człowieka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: I, prawdę mówiąc, lepiej by było, gdyby tak pozostało. Aliści nie mamy wyboru.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: Musimy powstrzymać Festiwal za wszelką cenę!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: Czy jesteś gotów podążyć ze mną do Krainy Grzybów?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: Nie daj się zwieść nazwie, drogi chłopcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: W naszej mowie brzmi niemal radośnie… W języku grzybów znaczy jednak coś zupełnie inszego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: To nie jest świat pełen słońca i tęczy. Nie, nie, nie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: Tam nie ujrzymy Festiwalu… ale inne rzeczy… grzybnię…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: Musimy działać natychmiast, albo wszystko przepadnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: Nikt nigdy nie powinien tam wkraczać. Nigdy, nigdy, nigdy. My wszakże musimy, jeśli chcemy powstrzymać Festiwal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: Czy jesteś gotów podążyć ze mną do Krainy Grzybów?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: Oho! Odwaga godna podziwu, mój chłopcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: Pakuj się i…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: Czekaj no momencik, o motyla noga. Pokaż swój zegarek!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: PÓŁNOC?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: Och, na Teutatesa! Jesteśmy spóźnieni! Chodź żwawo! Na jednej nodze!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: Nim zamkną się bramy do Krainy Grzybów!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: Och, mój drogi chłopcze… To niedobrze…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: Obawiam się, że sam nie podołam. Potrzebuję twojej pomocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: Pędzimy przez niespokojne czasy, mój chłopcze. Tańcujemy, gdy Kraina Grzybów pada na kolana. A nuż i my padniemy… A nuż…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: Nie wiem, co nas czeka w Krainie Grzybów… Pewnym tylko, że będzie… niebezpiecznie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: Zapytam więc ponownie, drogi chłopcze. Czy idziesz ze mną?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: Wtedy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: Obawiam się, że nie ma nadziei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: Życzę ci dobrego dnia, zdróweczka, uciechy i mnóstwa uśmiechów, mój drogi chłopcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: Do widzonka!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: Hę? KTO IDZIE? Chyba coś słyszałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: …albo mi się zdaje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: Co robisz pod moim domem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: Utknąłeś tutaj?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: SŁUCHAM? Mówże głośniej!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: Uszy mam pełne pyłu i sadzy i nic nie słyszę!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: Jesteśmy pod twoim domem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: Oby nie spadł nam na głowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: Co tu robisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: Czego szukasz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: HĘ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: Utknąłem? NIE! Znaleźliśmy coś.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: Uszy mam tak brudne… ŻE SŁYSZĘ CIĘ JAKBYŚ MÓWIŁ ZZA ŚCIANY. Przysięgam na Boga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: Co tu robisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: Czego szukasz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: Razem z kumplami wpadliśmy na pomysł wykopać tunele, by ukryć się przed skwarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: Ledwo wbiliśmy szpadle i zobacz. ZNALEŹLIŚMY CAŁĄ PODZIEMNĄ SIEĆ TUNELI.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: Było ich więcej. Niektóre niedawno się zawaliły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: Te korytarze są głębokie. NAPRAWDĘ GŁĘBOKIE. Kto wie, dokąd prowadzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: Ale mniejsza z tym. Znaleźliśmy jeszcze coś innego!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: Co znaleźliście? Coś ciekawego?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: Dorwaliście Przybysza?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: SCHRONIENIA, KURDE! Od tego przeklętego upału!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: Ledwo wbiliśmy szpadle i co znaleźliśmy? Cały system tuneli!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: Bladego pojęcia nie mam, kto ani po co je wykopał. Ale mamy pewną teorię. TEGOŚMY PEWNI.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: Wydaje nam się, że Przybysze się tędy przemieszczają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: Jeszcze żadnego nie widzieliśmy, więc nie mamy pewności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: Słuchaj jednak, te tunele nie są z tego najdziwniejsze. Jest jeszcze coś innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: Co znaleźliście? Coś ciekawego?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: Dorwaliście Przybysza?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: JEST TU CZELUŚĆ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: I coś się przy niej dzieje. Słychać cichuteńki szum. I ON NIGDY NIE USTAJE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: Zwierzęta przy niej milkną. Kompasy szaleją. Latarki nie przebijają ciemności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: Jeden z naszych zszedł na dół. Ja poczekałem tutaj, uhm, na wypadek, gdyby potrzebował pomocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: Słuchaj, jeśli chcesz tu zejść… NIE ZBLIŻAJ SIĘ DO CZELUŚCI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: Próbowaliśmy przy niej kopać i niemal wszystko tutaj się zawaliło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: CO TAKIEGO?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: Nie, nic zbytnio ciekawego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: Tylko ta dziura. Lecz dzieją się przy niej dziwne rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: Jeden z kumpli coś gdzieś o niej słyszał i mówił, że warto ją sprawdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: Słuchaj, jeśli chcesz tu zejść… NIE ZBLIŻAJ SIĘ DO CZELUŚCI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: Próbowaliśmy przy niej kopać i niemal wszystko tutaj się zawaliło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: Opowiem więcej, jak tu przyjdziesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: Wróciłeś, co? HĘ? Mówisz może ciszej, czy to mnie się na słuch rzuciło od tego szumu? NO? MÓWŻE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: Od jak dawna tu jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: Kumple jeszcze nie wrócili?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: SŁUCHAM? MÓW GŁOŚNIEJ! Siedzę tu od może dwóch lub trzech dni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: Czas płynie tu inaczej. W ciemności i bez zegarków. Sam nie wiem, ile już minęło godzin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: Lepiej wrzuć coś na ząb, albo skończysz wygłodniały jak ja i tylko z latarnią za towarzystwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: Zajrzałeś może sam do czeluści?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: Nie martwisz się, że kolegom coś mogło się stać?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: HĘ? MOIM KOLEGOM? Nie, na pewno nic im nie jest. Jeden zszedł głęboko, ale wróci. On zawsze znajduje wyjście.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: Drugi jest przywiązany do liny. Pociągnie za nią, gdy będzie chciał wrócić, albo gdy coś się stanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: WIDZISZ? Lina jest napięta, czyli wciąż tam pracuje. Wiedziałbym, gdyby coś było nie tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: Zajrzałeś może sam do czeluści?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: Nie martwisz się, że kolegom coś mogło się stać?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: CZY SPOJRZAŁEM? Tak jakby… nie, właściwie to nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: Chciałbym zajrzeć, ale… jedno niewłaściwe pociągnięcie za linę i zginę od upadku na dół.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: Podszedłem blisko, gdy byli tu moi kumple. Ale tam w dole… to jak patrzenie w otchłań. Prawdziwa pustka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: Czasem, gdy się zbliżyć… Ma się odczucie, że coś cię wzywa. Spróbuj. Posłuchaj…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: Nie, żebym miał pietra, ale… ona przyciąga. Gdybym tylko mógł spojrzeć jeszcze raz… troszkę bliżej…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: Musimy trzymać się razem. W PORZĄDKU? Jeden musi być gotów wyciągnąć drugiego!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: PRZYBYSZE? Też tak mówiliśmy! Te tunele zdają się być ich dziełem. A ta czeluść to może jakieś… przejście.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: Co, jeśli odpowiedzi znajdziemy tam w dole? Może nie wszystkie, jasne. Ale może dlaczego przybyli, czego chcą… POMYŚL TYLKO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: Jedno zejście na dół i może rozwikłamy tę zagadkę. Zszedłbym sam, ale, uhm… ktoś musi pilnować liny, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: Nie wyglądasz mi na siłacza, a ja mógłbym cię wciągnąć do góry bez problemu. To jak, zejdziesz rzucić okiem, a ja… będę asekurował?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: OCH, TO TY. Myślałem, żeś stchórzył. Coś jednak nie gra. Światło jest osobliwe, a lina jakoś dziwnie ciąży.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: 'Miner: A może tylko mnie się wydaje, bo siedzę tu tak długo i wyobraźnia szaleje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: 'Miner: Ale ta dziura… Powiedz szczerze, ile już razy cię do niej ciągnęło? Jakoś tak przyciąga, no nie? Przyznaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: Myślisz, że twój kolega wciąż żyje?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: Czy ten drugi wciąż nie wrócił?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: Och, na pewno. BEZ DWÓCH ZDAŃ. Lina jest wciąż napięta, widzisz? To znaczy, że wciąż tam pracuje. Gdyby coś było nie tak, wiedziałbym.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: Mamy mnóstwo czasu do spędzenia, czekając na nich. Może zbadamy całe to miejsce. Przyznaj, że zżera cię ciekawość!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: Czemu sam nie zejdziesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: A co, jeśli nigdy nie dowiemy się, co tam jest?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: O kogo ci chodzi? Słuchaj, ktoś musi to zrobić. Nie mogę tu wiecznie siedzieć. Działamy teraz albo nigdy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: Też to czujesz, nieprawdaż? To przyciąganie… Jakby ta czeluść cię wzywała. Słyszysz to, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: Czemu sam nie zejdziesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: A co, jeśli nigdy nie dowiemy się, co tam jest?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: A kto mnie wyciągnie, jak tam zejdę, co? Bez urazy, ale klatę masz jak szczur czoło. Ty złazisz, ja zostaję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: Mógłbym wciągnąć się z powrotem z palcem w tyłku. A jeśli ja zejdę, kto mnie wyciągnie? Czysta logika.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: Chcesz się dowiedzieć, co jest w dole, nie? Nie jesteś trzęsidupą, to widać. Już trzy razy tu przyszedłeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: NO DALEJ. Nie pękaj. Zejdź na dół. JA BĘDĘ ASEKUROWAŁ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: Doprawdy chcesz spędzić resztę życia, zastanawiając się „co by było, gdyby”, bo podwinąłeś ogon?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: NO WIĘC? Na co czekasz? Po to tu jesteśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: „Nigdy się nie dowiemy”? NIE WYGŁUPIAJ SIĘ! To nie jest zwykła dziura. Wiem, że też to czujesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: A co, jeśli tam w dole jest coś, co wszystko zmieni? Odpowie na każde pytanie, zrobi z ciebie bohatera narodowego…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: Zwyczajnie byś odszedł? Żył dalej, jak gdyby nigdy nic? NO DALEJ, ZŁAŹ TAM. Rozgryźmy to… razem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: Trzymasz się na dystans, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: Dobrze, to zwiększa twoje szanse na przeżycie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: Chyba że… jesteś Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: Czemu chodzisz po dworze?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: Kimś, kto przyszedł sprzątnąć te brudy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: Swoją okolicę już posprzątałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: Nic więcej nie musisz o mnie wiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: Niech zgadnę, a w rękach trzymasz miotłę?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: Co masz na sobie? Czy to ma zapewnić Przybyszoodporność?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: Psiakrew, to nie są żarty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: Niektórzy współczują Przybyszom. Uważają, że może im się, nie wiem… polepszyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: Mija kilka dni i mordują wszystkich w domu. Potem uciekają i kółko się zamyka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: Beż żadnej sprawiedliwości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: Ja się nie chowam. Wymierzam sprawiedliwość. Przywracam porządek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: Niech zgadnę, a w rękach trzymasz miotłę?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: Co ty masz na sobie? Czy to ma cię uodpornić na Przybyszy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: Heh. Zabawny punkt widzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: Pewnie. To moja miotła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: Mógłbym sprzątać brudy goły rękami, ale z miotłą idzie szybciej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: Ale najlepszym sposobem jest zamknąć ich w domu i podłożyć ogień.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: Każdego, kto współczuje Przybyszom… traktuję jak jednego z nich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: To po co tu przyszedłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: Jak długo zamierzasz „sprzątać te brudy”?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: „Przybyszoodporność”? Ach, mówisz o moim naszyjniku?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: Heh. Czadowe określenie. Sam muszę zacząć go używać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: Stanowi przypomnienie, abym nie zapomniał, ile domów i miejscowości posprzątałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: Każdemu Przybyszowi wyrywam jeden ząb. To najprostsze trofeum do zebrania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: A jeśli któryś mi czymś zaimponuje… Mogę wziąć coś innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: To po co tu przyszedłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: Jak długo zamierzasz „sprzątać te brudy”?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: Moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: Zadałeś już dosyć pytań. Teraz moja kolej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: Dzieję się coś w tej okolicy? Jakieś zagrożenia, na które lepiej uważać?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: Półnagi Przybysz wyrżnął cały patrol
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: Wciąż przychodzą Przybysze, ale też mam broń
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: FEMA zabiera ludzi. Nie wiem, czy kiedykolwiek wrócą
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: Tylko jeden? Półnagi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: Czyli nie miał na sobie kamizelki kuloodpornej?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: Ciekawe… I widziałeś go na własne oczy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: Tak, wierzę ci. Nie mówisz jak jakiś plotkarz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: Zaintrygowałeś mnie. Wrócę tu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: Zatem też starasz się utrzymać porządek. Wspaniale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: Ale nie ufam ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: Muszę załatwić to wszystko po swojemu. I taki mam zamiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: Wypocznij. Pogadamy później.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: Oni wiedzą, co robią.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: Mają swoje sposoby na identyfikację objawów Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: Czemu miałbyś o nich wspominać? Podejrzane…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: Muszę sprawdzić, co u kogoś słychać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: Wrócę później… To wielce ciekawe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: Wróciłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: Szukałem tej osoby, o której wspomniałem, ale bezskutecznie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: Byłem też w kilku domach. Ta okolica aż roi się od Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: Czy FEMA dała za wygraną w tej miejscowości? Czy tylko w tej dzielnicy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: Jak rozpoznajesz Przybyszy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: A co, jeśli mają tylko jeden objaw lub dwa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: Cholera, pewnie tak samo, jak ty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: Telewizja i radio podają jasne instrukcje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: Jeden objaw wystarczy, by ich kropnąć. Nie waham się ani sekundy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: Skoro już tu jestem… Powiedz mi, czy znasz grubszego gościa w niebieskiej, jeansowej kurtce?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: Ma dziecko. Małą dziewczynkę. Nie wiem, ile ma lat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: Jego żona… kurde, chuj z nią.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: Jego dom spłonął. Od tamtej pory go nie widziałem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: Nie żyje. Tylko córka przeżyła
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: Wtedy jak najrychlej wymierzasz sprawiedliwość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: Przybysze żerują na słabości ludzi o miękkich sercach. Przez to giną oni we własnych domach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: Skoro już tu jestem… Powiedz mi, czy znasz grubszego gościa w niebieskiej, jeansowej kurtce?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: Ma dziecko. Małą dziewczynkę. Nie wiem, ile ma lat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: Jego żona… kurde, chuj z nią.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: Jego dom spłonął. Od tamtej pory go nie widziałem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: Nie żyje. Tylko córka przeżyła
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: Hmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: Udowodnij mi, że nie jesteś jednym z nich. Pokaż dowolną część ciała.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: Masz giwerę? Gówno mnie to obchodzi. W takim razie obaj zginiemy w strzelaninie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (Pokaż zęby)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (Pokaż ręce)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (Pokaż oczy)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (Pokaż pachy)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (Pokaż zdjęcie)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (Pokaż uszy)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: Otwieraj szeroko. No, nie zesraj się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: Hm… czysto. Szkoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: No dobra. Na razie możesz żyć… Ale jeśli choćby drobny szczegół mi się nie spodoba, kula między oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: Kuźwa, czas mnie goni. Muszę coś sprawdzić. Bywaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: Czyste… oczywiście, kurwa, że czyste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: Niech no ci coś powiem. Słuchaj – ci, którzy wyglądają normalnie, zawsze pierwsi się przemieniają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: Nie mam czasu na te pierdoły. Następnym razem sprawdzę cię dokładnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: Cholera, użyj palców. Otwórz je szeroko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: Heh… Żadnych objawów, co? Wspaniale, wspa‑kurwa‑niale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: Zdajesz sobie sprawę, co w ciągu nocy może zrobić jeden „normalny” Przybysz? Wystarczy potknięcie i wszyscy nie żyją.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: Na razie jesteś czysty. Ale jeśli choćby drobny szczegół mi się nie spodoba, kula między oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: Ale to nie teraz. Mam ważniejsze sprawy na głowie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: Hm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: Jesteś czysty. Ale to nic nie znaczy. Te dziwolągi potrafią udawać lepiej, niż ja umiem ich rozpoznawać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: Bez objawów. Farciarz. Zabieraj mi te pachy sprzed oczu. Mam ważniejsze sprawy na głowie. Wrócę tu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: Zdjęcie? Ma coś wspólnego z twoją aurą? Dobra, zobaczymy, jaki jesteś „czysty”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: Hm… tak, wygląda czysto. Ale kropnąłem zbyt wielu, którzy tak wyglądali, by w to zwyczajnie uwierzyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: Szczerze? W dupie mam to zdjęcie, mam ważniejsze sprawy. Na razie możesz żyć. Później sprawdzę cię dokładniej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: Uszy? Masz mnie za pieprzonego idiotę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: Gdyby nie mój brat…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: Spróbuj zagrywkę z uchem jeszcze raz, a położę cię trupem tu i teraz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: Jebać to, mam ważniejsze sprawy. Wrócę po ciebie później.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: Wróciłem. Nie wiem tylko do końca, po co, u licha, się fatygowałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: Gdyby mój brat nie był taką pierdołą, może ochroniłby żonę i dziecko. Licho teraz wie, gdzie wywiało tego bachora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: Co u ciebie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: Chcesz ją odnaleźć?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: Po staremu. Powiedziałem nawet bratu „Weź zmężniej, zaopiekuj się rodziną”. A on co zrobił?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: Wymiękł jak ostatnia pizda. Teraz jego rodzina pewnie leży w piachu albo w pierdolonych kawałeczkach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: To przez takich tchórzy, jak on, świat wygląda, jak wygląda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: Niedawno widziałem pewną rodzinę. Krępy ojciec. Zachował zimną krew, nawet gdy Przybysze wrzeszczeli przez okna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: Wyprowadził rodzinę tylnymi drzwiami i uciekli do lasu. Położyłem dziwolągów, ale tamci nigdy nie wrócili.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: Myślałem, że zginęli. Wiele dni później odnaleźli mnie. Pierwsza z lasu, dzierżąc strzelbę, wyszła jego córka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: Dzikość w oczach, ale żywa. To właśnie szanuję. Nie jak mój brat. Gdyby padł wcześniej, może jego rodzina by przeżyła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: Dobra, dosyć opowiastek. Sprawdzę cię teraz. Udowodnij, że nie jesteś jednym z nich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (Pokaż zęby)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (Pokaż ręce)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (Pokaż oczy)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (Pokaż pachy)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (Pokaż zdjęcie)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (Pokaż uszy)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: Nie ma sensu szukać. Szkoda czasu. Gdyby brat miał jaja, może wciąż mieliby szansę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: Ale teraz? Wisi mi to. Skończyłem z tym.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: Na skraju miasta była taka rodzina. Zabarykadowali się w środku, ojciec zapierał się o drzwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: Żona jednak… miała objawy. Błagał mnie wciąż: „To moja żona, nie krzywdź jej!”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: Gdy Przybysze wleźli na dach, głupek otworzył drzwi. Puścił ją wolno. Zrobiłem wtedy to, czego on nie potrafił.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: Zabiłem ją pierwszą. Potem jego. Dzieci uciekły jakoś z sąsiadami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: Wtedy przyjechała FEMA, mówiąc o „czystce”. Powiedziałem, żeby się tym nie przejmowali, że już posprzątałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: Śmiali się. Chcieli, żebym do nich dołączył. Jebać to. Wywlekają tylko ludzi, a Przybysze wciąż się, kurwa, panoszą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: No, starczy tego gadania. Sprawdzę cię teraz. Udowodnij, że nie jesteś jednym z nich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (Pokaż zęby)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (Pokaż ręce)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (Pokaż oczy)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (Pokaż pachy)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (Pokaż zdjęcie)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (Pokaż uszy)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: Otwieraj gębę. Szerzej. Nie jestem twoim dentystą, do cholery.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: W porządku, czysto. Ale szczerze? Byłoby łatwiej, gdyby tak nie było. Mniej później kłopotów dla nas obu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: Nie bądź taki kozak. Jedno potknięcie i koniec z tobą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: Starczy gadaniny. Marnuję tylko czas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: No? Pokazuj. Gryzę tylko, gdy muszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: Hm… Brudne czy czyste, jeden chuj. Przybysze maskują się świetnie niezależnie od tego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: Nie mam teraz na to czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: Otwieraj szerzej te gały. Nie igraj ze mną, psiakrew.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: Dobra. Nie znaczy to jednak, żeś bezpieczny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: Hm. Możesz iść… na razie. Nie mam czasu na to gówno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: Żartujesz sobie, do cholery?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: Jeśli coś ci tam rośnie, lepiej, żebym tego nie widział.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: Spierdalaj, nie będę cię tam wąchał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: Znowu te bzdury?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: Wygląda w porządku, ale tak też wyglądała połowa zdrajców, których zakopałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: Szczerze? W dupę se wsadź to zasrane zdjęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: Jak ci się podoba twoje nowe życie, mój miły?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: Przyzwyczaiłeś się już?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: Och, ale ze mnie głupiutka gąska, że o to pytam. Przecież ty tu mieszkasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: Wyglądasz… niecodziennie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: A więc zauważyłeś. Dzięki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: Podoba ci się to, co widzisz, mój miły?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: Ostatnio ludzie wciąż zwracają uwagę na mój wygląd. Nawet częściej niż kiedyś.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: Nie jesteś zbyt rozmowny, co? Powiedz mi coś o sobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: Wolałbym nie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: Za młodu modliłem się, żeby ojciec wykitował. Starczy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: Nigdy nie byłem towarzyski. I teraz się to też nie zmieni
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: Och, sprawiasz mi przykrość!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: Czy coś cię gnębi? Czy niedawno zostawiła cię żona?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: A może Przybysze zabili ci kogoś bliskiego i przez to zamknąłeś się w sobie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: Zapewne chodzi o dzieciństwo? Na pewno nie miałeś łatwo. Czy wspomnienia nagle wróciły? Biedaczysko…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: Powiedz mi, mój miły. Jestem tylko nieznajomą u twojego progu. Być może już nigdy się nawet nie spotkamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: Nie chcę
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: Za młodu modliłem się, żeby ojciec wykitował. Starczy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: Nigdy nie byłem towarzyski. I teraz się to też nie zmieni
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: Kto wie, może wyrzucenie tego z siebie ci pomoże?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: Ale nie będę cię do tego zmuszać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: Hm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: Mogę ci dać coś, czym inni by się nie podzielili.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: Ostatnimi czasy wszyscy mają bzika na punkcie końca świata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: Pomimo tego nawet najbardziej samotna z dusz potrzebuje… wyjątkowego rodzaju uwagi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: Wpuść mnie, a mogę ci to ofiarować. Rozpalę w tobie uczucia…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: Miałeś znęcającego się ojca? Okropne. Cieszę się, że masz to za sobą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: Trudno jest wyzbyć się gniewu, a jeszcze trudniej jest wybaczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: Miałam takie same doświadczenia, mój miły. Możemy o tym porozmawiać… Chcesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: A także…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: Jeśli mnie wpuścisz, może poradzimy sobie z tym bólem i wspólnie zaleczymy rany.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: Wszyscy ostatnio potrzebujemy jakiegoś ukojenia. Odrobinę ciepła… troszkę czułości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: Rozumiem. Niewielu potrafi słuchać, nie przerywając swoim „u mnie było gorzej!”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: Nawiązywanie relacji z innymi nie jest łatwe. Nie tylko ty masz z tym trudności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: Mogłabym ci pomóc, jeśli zechcesz, mój miły. Mógłbyś ze mną poćwiczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: Może spróbowalibyśmy… zbliżyć… się do siebie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: Wspólnie ucieknijmy od wszelkiej grozy tego świata, tylko ty i ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: Na pewno możemy zająć się czymś… ciekawszym… niż paranoja i nieskończone użalanie się nad sobą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: Podejrzewałam, że tak odpowiesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: Czy według ciebie samotne dotrwanie do końca sprawi, że wszystko będzie łatwiejsze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: Cóż… On tak nie uważa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: Jesteś jak mój stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: Weź pan spierdalaj…'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: Uhm, nieważne. Widzę, że {0} już zajmuje miejsce, które spaja cały dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: Jeśli mam zostać, po mojemu musimy to sprostać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: Hej, rymy składam jak Mickiewicz Adam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: Klawo!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: Pff… nieważne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: Co za strata czasu…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: Kapitalnie!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: Chociaż… momencik. Któż to?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: Och, nie. Wykluczone.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: To… to… {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: Nie ma mowy, żebym przy tej osobie zdradzał jakieś tajemnice!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: Proszę przepędzić tę osobę, a z wdzięcznością przyjmę pańskie zaproszenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: Załatwię to. Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: Jestem rad za podjęcie właściwego wyboru! Proszę mi wierzyć, nie pożałuje pan!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: Po naszej rozmowie świat ukaże panu zupełnie inne oblicze!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: Jak to „powinienem odejść”?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: Pan… pan ma…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: Tylko ktoś z klapkami na oczach tak łatwo odmówiłby poznania prawdy!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: Żegnam ozięble! Wątpię, że pożyje pan długo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: Do licha, kim jest ta osoba? Jest u pana {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: Znam ten typ. Nie powinieneś był pan wpuszczać tej osoby. Tacy ludzie to same problemy, słodziutki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: Takim osobom trza dać kopa w rzyć, zanim będzie za późno!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: Załatwię to. Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: Cholerne obiboki… Won mi stąd!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: Żarty pan sobie stroi? Mój mąż jest funkcjonariuszem FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: Do jasnej anielki, panie, z czym masz problem? Ja tu z otwartymi ramionami, a pan masz mnie w dupie?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: Wiesz pan co? Straszny z pana gnój. Pójdę porozmawiać z sąsiadami. Żegnam, brudna pało.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: O jejku… Nie chcę być niegrzeczny, ale, uhm, {0} już tu jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: Nie wysiedzę… z kimś takim. Próbowałem. N‑nie dogadamy się.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: Dziękuję pięknie, przyjacielu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: Uhm… Jeśli to nie problem… jak już mnie sprawdzisz…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: Pokażesz mi, jak się to robi? Jak zabić Przybysza? Chcę s‑spojrzeć śmierci w oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: O jejku… Nie chciałem stawiać się w takiej sytuacji, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: Ta osoba musi być ci bliska. Przepraszam za zawracanie głowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: Mam tylko nadzieję… że kiedyś nauczę się samoobrony… i zabijania.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: Boże, grzmisz i nie trafiasz. Kogoż pan tu gości, jeśli wolno spytać? Przecież {0} nie ma Boga w sercu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: Całego żywota nie starczy, by odkupić te grzechy! W takim towarzystwie czuć obecność diabła!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: Przegoń stąd tego nieczystego ducha, a będziesz błogosławiony, moje dziecię!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: Załatwię to. Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: Chwała Bogu…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: Boże, miej litość…! Wyrzekasz się daru zbawienia. Hańba!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: Moja śmierć będzie twoim brzemieniem, miarkuj me słowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: Kiedy staniesz przed Boskim obliczem, zostanie ci to wypomniane.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: Nie mogę… Słuchaj, chłopie, miałem z takimi typami do czynienia. Masz u siebie jednego. Ta osoba to {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: Ta osoba niby jest cicha i zajęta sobą… a gdy tylko nadarzy się okazja, natychmiast wbije ci nóż w plecy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: Wierz mi, tacy ludzie zdradzą cię w mgnieniu oka.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: Zawdzięczam ci życie, chłopie!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: Oby twoi sąsiedzi także nie okazali się kurwimi synami…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: Ty na poważnie, kurwa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: Co, robisz w gacie ze strachu, że FEMA przyjdzie mnie szukać, trzęsidupo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: Tak, chowaj się za swoimi miernymi drzwiami. Zobaczymy, jak skończysz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: Karaluchy pod poduchy, kutafonie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: Widzę, że na kanapie jest już {0}. Takich ludzi… znaczy się… boję się ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: Jednego razu w parku ktoś podobny mnie napadł. Od tamtej pory się tam nie zbliżam!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: Wielkie dzięki! Wciąż… się martwię.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: Co, jeśli moi rodzice wrócą do domu i mnie nie zastaną?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: Ale… powinienem chyba na jakiś czas zostać z tobą. Dla bezpieczeństwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: Pewnie masz rację… Pójdę do domu na wypadek, gdyby już wrócili…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: Oho, koleżko… Ktoś już chyba zagrzewa moje wybrane miejsce.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: Lubię się dzielić, ale w tej twojej klitce jest już ścisk… Wyprosisz kogoś?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: Dzięki, koleżko! Ratujesz mi tyłek!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: Phi, jest u pana… {0}. Nie, nie, nie! Nie będę się dzielił cholerną wanną!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: Już prędzej przekażę ci pewną, ekhm, darowiznę, byś… wiesz… załatwił tę sprawę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: Znakomicie, dobra decyzja.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: Wywiążę się z umowy… jak tylko wszystko wróci do normy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: Wypraszam sobie! Widać jak na dłoni, że podupadam na zdrowiu i że jestem ministrem!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: Dokąd mam niby pójść, co? Mam przejebane. Przejebane, powiadam!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: Wyczuwam, że jest u ciebie {0}. Z tą osobą… jest coś… nie tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: Wybacz… nie potrafię tego wyjaśnić.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: Lepiej będzie, jeśli pójdę gdzieś indziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: Dziękuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: Odejdę, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: Dla własnego dobra nie zbliżaj się w nocy do spalonych ciał.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: Inaczej… TO… cię dopadnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: Joooł… Chwilunia…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: Widzę, że jest u ciebie już {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: Nie znoszę takich ludzi, ziom. Psują całą atmosferę…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: Ale żal… Przegoń tę osobę, stary!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: Ziooom! Wiedziałem, że skumasz bazę!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: Staaary…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: Wporzo, ziom. Czaję. Nie ma spiny.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: Dbaj o siebie, stary… i o twoich ziomków.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: Proszę mi wybaczyć, ale… czy to jest {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: Nie mogę… zostać pod jednym dachem z kimś takim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: Przypominają mi o… tych ludziach, którzy… którzy… te dzieci…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: Przykro mi…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: Załatwię to. Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: Dziękuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: Tu jest {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: Hmmm. Nie powinno. Idź, zrób, żeby wyszło.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: Chodź, kotek. Teraz czas na zabawa, tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: Widzisz sierściuszek? Nie ty, duży głupek.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: Widzisz sierściuszek? Zły wybór.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: Hm… Jest u pana {0}. Moje dziecko nie potrzebuje więcej strachu…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: Czy mógłby pan… nie wiem… załatwić to jakoś? Aby moje dziecko w końcu mogło się bezpiecznie wyspać?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: Załatwię to. Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: Nareszcie…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: Chodź, nie stój tak. Wejdź do środka, pan nie będzie na ciebie czekał.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: No dobrze. Chodź, dziecko… Zobaczmy, czy uda nam się dojść do domu twojego głupiego taty.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: Zdaje się, że może być już za późno…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: Nie… nie… damy radę…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: Jest u pana {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: Moja noga nie postanie w jednym domu z tym dziwadłem. Zwariowałbym.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: Proszę się nie martwić, nie będę się na nikim wyżywał.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: Ani nic ci tu nie rozwalę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: Krzywdzę wyłącznie siebie samego.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: Ja pierdolę, jesteś pan równie żałosny, co cała reszta tych tchórzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: Będą włazić panu na głowę, a pan jeszcze pocałujesz za to w rączki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: Ja pierdolę, kurwa!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: Och, nie wiem, jak ci się odwdzięczę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: Kto to taki?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: Proszę posłuchać, nie chcę robić problemów, ale… nie możemy przebywać z takimi ludźmi. Jest tutaj {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: Moja żona nie przepada za takimi ludźmi, wie pan? Nie sądziłem, że tu będzie ktoś tak młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: Załatwię to. Wejdźcie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: Powinniście odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: Och, dziękuję. Dziękuję!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: Czemu tak stoisz, złotko? Chodź, możemy wejść.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: Ależ jesteś nieśmiała! W porządku. Niedługo sobie odpoczniesz, kochanie!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: Rozumiem. Przepraszam za kłopot.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: Będziemy szukać dalej, prawda, złotko?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: No dalej! Ruszaj te cholerne kulasy. Też jestem zmęczony.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: Chętnie bym wszedł, ale jest już u ciebie {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: Nie chcę, byś kogoś wyrzucał, bo kto wie, może ta osoba potrzebuje schronienia bardziej ode mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: Ale byłbym wdzięczny, gdybyś zrobił dla mnie trochę miejsca.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: Dzięki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: Mam nadzieję, że pamiętasz, co to znaczy radość.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: Być może wtedy śmierć nie będzie jedyną rzeczą, o której myślisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: Nie daj się pogrążyć w żałobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: Jeśli to jedyne, o czym myślisz, przytłoczy cię.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: I z tą chwilą to już równia pochyła ku ciemności.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: Dbaj o siebie, dobrze?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: Och… Czuję tu… taką gęstą, nieprzyjazną aurę. Cień… dość silny, by zatruć cały dom! Biaaada!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: Widzę kogoś… to {0}. Ma pan kogoś takiego?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: Musimy się ich pozbyć lub gwiazdy zwiastować będą zagładę. Rozumie pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: Załatwię to. Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: Wspaniale… Prawdę mówiąc, ma pan tutaj rzadko spotykaną, metafizyczną przestrzeń czasową.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: Przez pana dom płynie silny strumień pozytywnej energii.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: Człowiecze! Nie przekroczę progu, póki chowa się tutaj {0}. TEGOŻ ŻĄDA SŁOŃCE!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: Cień tej osoby tłamsi światło sprawiedliwości! Won z tym człowiekiem! Won! Won!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: PRAWYŚ, CZŁOWIECZE! Twoje oczy zabłysną błogosławieństwem świętych promieni.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: A teraz, gdzie masz lodówkę…?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: Wtedy do licha z tobą!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: Tylko złe podziemne wypełzacze ryglują drzwi przed światłem… Nie, przed oświeceniem!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: Podzielę się swoimi świetlistymi promieniami mądrości z kimś innym! Chuj z tobą!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: Hm, widzę, że jest już u ciebie {0}, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: Na rękach ma krew. Nie wiem, dlaczego u ciebie jest. Lubisz ryzykować?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: Dobra decyzja, młody. Ja wiem, co robię. Pomogę ci, jeśli to… coś… tu przyjdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: W‑widzę, że to miejsce zajmuje już {0}…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: Nie mogę… tam zostać. A co, jeśli jest Przybyszem?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: Proszę, zrób test, albo…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: Czy mógłbyś… załatwić to w inny sposób?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: Dziękuję. Będę tak cichutko, jak mysz pod miotłą. Tylko nie zamykaj drzwi, dobrze? Ha, ha. Tak na wszelki wypadek…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: Okej. Ha, ha… Dobrze, pójdę sobie. Hmm, słońce i tak nas zabije. Wszyscy zginiemy…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: Najpierw {0} musi odejść, potem pogadamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: Takich ludzi wyrzucali z baru przede mną.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: O, przynajmniej coś dziś poszło po mojej myśli. Prowadź.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: No to wypierdalaj. Założę się, że w barach też zamawiasz jakieś marne szczochy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: Dz‑dziękuję. Och. Nie mogę wejść, gdy jest u pana {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: Boję się… być w tym samym pomieszczeniu z takimi o‑osobami. Z‑zawsze wydarza się coś niemiłego.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: Załatwię to. Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: Dz‑dziękuję. Proszę mi wierzyć, tak będzie bezpieczniej.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: Rozumiem… J‑już sobie idę…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: Tak… G‑gdzieś tam… z dala od wszystkich…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: M‑może słońce o‑o‑ogrzeje mnie ostatni raz…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: Nie będę ściemniał, no nie? Jest już u ciebie {0}. Osoba tak sztywna, że chuj, bracie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: Zapodaj temu człowiekowi kopa w dupę i będzie gites.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: Zajebongo! Wpadnij do mnie, jak będziesz miał chwilę, co? Mam ci do powiedzenia coś świetnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: A chuj z tym, wiedziałem, żeś nie prawilny. Nie zadaję się z pizdami.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: Mniejsza z tym. Frajerów jest mnóstwo. Nara, sukinsynu!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: Nie mogę… N‑nie ma dla mnie miejsca!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: Jest u pana {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: Ale… ja nie chcę siedzieć w żadnym innym miejscu! Nie chcę, nie chcę, nie chcę! Tam… tam siedział tata…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: Chcę do taaatyyy…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: TAAATOOO! TATUSIUUU!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: ODEEEJŚĆ DOKĄD?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: Ja… ja… n‑nie znam n‑nikogo inneeego…!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: Tak… tak b‑b‑bardzo się boję…!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: *zanosi się płaczem*'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: Och, święta duszo moja! W moim fotelu siedzi {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: Z taką wyrodną osobą sprawunki szybko zejdą na złą drogę, kochaniutki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: Jeśli nie masz nic przeciwko, chwileczkę tu odsapnę, złapię oddech i poczłapię dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: Załatwię to. Niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: Powinna pani odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: Och, miłościwy jesteś, kochaniutki! Żal mi, żeś dla takiej staruszki musiał kogoś przepędzić…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: Czy będziesz takoż uprzejmy i podasz babuni zydel?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: Rozprostuję jeno stareńkie kości i pójdę w swoją stronę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: Hmm, widzę, że jest u pana {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: Nie jestem w stanie zapewnić tej osobie właściwej opieki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: Ta osoba dla swojego dobra powinna znaleźć kogoś, kto mógłby jej pomóc.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: Załatwię to. Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: Dziękuję. Mam nadzieję, że będę mógł tu komuś pomóc.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: Rozumiem doskonale, niełatwo jest w tych czasach komukolwiek zaufać.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: Będę w pobliżu, proszę nie wahać się poprosić o pomoc.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: Mmmng… Ffffffpt!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: (Wygląda na to, że kogoś nie lubi. Ta osoba to {0}. Wskazuje na niego, potem na siebie i znowu na niego).'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (Kiwa głową i przechodzi przez próg).'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: Wszedłbym, lecz jest tu już {0}. Trzyma się rozpaczliwie myśli o jutrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: Jednakowoż mnie przywiodła tu chęć nasłuchiwania ciszy mgielnej zmierzchu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: Załatwię to. Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: Nie sposób mi stwierdzić, czy piękno widzi pan, jak ja. Rzeknijcie jednak… Nie wyrzuca pan ciał na zewnątrz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: Zachowaj moje, gdy czas ten nadejdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: Słuchaj, nie zrozum mnie źle, ale jest u ciebie {0}, no nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: Heh. Ta osoba przypomina mi ludzi, którzy ścigali mnie i moją rodzinę…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: Musisz wybrać. Albo ta osoba, albo ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: Uff, dzięki, stary. Jestem twoim dłużnikiem!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: Hej, uhm, przyjdź czasem pogadać, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: Kurde, rozumiem to podejście, ale to dość brutalne…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: Hm… Widzę, że ma pan już tutaj lokatora. Jest to mianowicie {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: Czy szanowny pan ma świadomość, że ten człowiek jest notorycznie na bakier z prawem?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: Doprawdy, czy artykuły 28, 48 i 7.3 Konstytucji nic dla szanownego pana nie znaczą?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: Załatwię to. Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: Najwłaściwszy wybór.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: Później przedyskutujemy szczegółowo warunku najmu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: 'Marauder: Spójrz no tylko, ktoś już zajął mój przytulny kącik.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: 'Marauder: Dokładnie tam, widzisz? Ta osoba to {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: 'Marauder: Heh. No i elegancko.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: 'Marauder: Kurdebalans. A myślałem, że w końcu będę mógł odsapnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: 'Marauder: Ech, warto było spróbować.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Ach, siedzi już u ciebie {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: Chętnie bym wszedł, ale… rozumiesz…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: Ach, dziękuję!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: Słucham? Ach, dziękuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: Znaczy się, czekaj chwilę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: O rety… Widzę, że łazienkę zajmuje już {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Spójrz no, cały dzień spędziłem w tym kombinezonie… chcę go tylko zdjąć i zmyć z siebie kurz i… krew.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: Jeśli pozbędziesz się tej osoby, daję słowo, że będę siedział cicho jak mysz pod miotłą. Nikomu nie będę wadził.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: Serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: Nie sądziłem, że mnie wpuścisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: Rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Ten kombinezon nie wzbudza zaufania.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: Nawet nie wiem, dlaczego go wciąż noszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Żegnam.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 'Intruder: Wszedłbym, ale… wygląda na to, że ktoś zajął moje miejsce. Spójrz, ta osoba to {0}. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: 'Intruder: Ten dom jest za mały dla naszej dwójki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: 'Intruder: Raz mi się ta osoba przyśniła i uwierz mi, oby to był ostatni raz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: 'Intruder: Obym w końcu mógł się wyspać…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Słuchaj no pan, węch mam jak pies. Oprychów i Przybyszy wyniucham z kilometra.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: Zrobimy tak: {0} za wpuszczenie mnie do środka. Zgoda?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: Nie chcesz pan? Szepnę tylko słówko do męża, a żółci chłopcy będą tu z samego rana na wyrywkową wizytę.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: Kwitki od kwarantanny, psy węszące… I będą wracać dzień za dniem. Czy wpuszczenie mnie to naprawdę aż taki problem?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: Dobra, niech pani wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: Nie przekupi mnie pani
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: Śmierci się pan nie boisz? Mój stary jest funkcjonariuszem FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: Z czym masz pan problem? Ja tu z sercem jak na dłoni, a pan masz mnie w dupie?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: Wiesz pan co? Wypierdalaj pan. Przekonam któregoś z sąsiadów, żeby mnie wpuścił. Do widzenia, zjebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Cholera, są dwie opcje: albo ci się wykrwawię pod drzwiami… albo mnie wpuścisz i pomożesz opatrzeć rany.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: Nie daj się prosić, stary… Dam ci wszystko, co mam. {0} może być? Nic więcej ze sobą nie mam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: Proszę… zginę tutaj!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: Nawet nie wiem, co mam zrobić…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: Może chcesz czegoś ode mnie? {0} może być?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: Mam też… gumę do żucia. Zostało mi tylko kilka, ale dam ci je, jeśli chcesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: Ach, tak… wiem, co załatwi sprawę. Tak, dokładnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Oto mały, ekhm, prezent ode mnie… {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: Co myślisz? Ha! Czy to cię przekona?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: Miałem coś ze sobą. Poczekaj, proszę…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: To chyba {0}. Weź to. Potrzebuję co najmniej jednego dnia, żeby odpocząć, ale… nie wiem, czy to w ogóle możliwe…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: No weź, stary…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: Dobra, obczaj to. Mam tu dla ciebie małe co nieco.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: Patrz: {0}! Jebs! Zupełnie jak w grach, ziom! Trzeba najpierw zdobyć punkty przyjaźni, no nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: Nie wpuścisz mnie? Coś poradzimy! {0}, łap! Machnij tym przy drzwiach i abrakadabra: jesteś niewidzialny.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: Na pewno zadziała!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: Popatrz tylko na moje nogi! Widzisz? Nie ma ich, co nie? Ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Proszę, przyjacielu… wybacz, że nalegam, ale postaw się w mojej sytuacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: Żona jest ostatnio bardzo osłabiona i szybko się męczy. A ja… zrobiłbym dla niej wszystko, rozumiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: Kocham ją nad życie. Oddałbym tobie ostatni grosz, gdyby była przez to bezpieczna.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: A skoro o tym mowa…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: Mamy tu coś. Nie jest to ostatni grosz, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: {0}, co na to powiesz? Oddam wszystko, jeśli to zapewni mojej żonie chwilę wytchnienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: Co powiesz? Pomożesz nam?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: Dobra, wejdźcie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: W porządku! Ale może jest coś, co mogę ci dać. Potrzebujesz czegoś?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: Jedyne co mam to {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: Czy to cię interesuje?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Dziękuję za pomoc. W przeciwieństwie do…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: …czy ta osoba to {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: Nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: Moja noga nie postanie w tym samym domu, co taki człowiek.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Dzięki, nie zabawię długo… Potrzebuję tylko złapać oddech…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: No, no… popatrz, popatrz kogoż my tu mamy. Czy ta osoba to {0}? No proszę!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Nie no, ta osoba to taki bezużyteczny gamoń, który w niczym nigdy nie pomoże.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: Wyrzuć tę osobą zaraz na zbity pysk, słodziutki, a ja klapnę na zwolnionym miejscu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Wielkie dzięki! Inaczej nic by tu nie było, jeno płacz i zgrzytanie zębów.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: Obawiam się, że jest u pana już {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: Od razu mogę stwierdzić jak ta… maniera mówienia… wpłynie na moją siostrę.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: Potrzebne to jej teraz tak, jak piąte koło u wozu. Konieczny jest jej spokój, a nie osąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: Załatwię to. Niech panie wejdą
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: Powinny panie odejść
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: 'Twins: Jest u pana {0}…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: 'Twins: Przebywanie pod tym samym dachem z tą osobą nie będzie łatwe…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: 'Twins: Wie pan, zanim poznałam swojego męża… cóż bardzo przypomina mi osobę, którą kiedyś znałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: 'Twins: Nie sądzę, byśmy się dogadali.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: Załatwię to. Niech panie wejdą
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: Powinny panie odejść
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: Widzę, że są już u pana {0} i {1}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: Martwi mnie to… Przebywanie z tymi osobami będzie męczarnią dla mojej siostry.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: Przypominają bardzo naszych… rodziców… I to nie będzie służyć mojej siostrze w jej stanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: Załatwię to. Niech panie wejdą
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: Powinny panie odejść
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Hmm… jasne, nie zna nas pan i podejrzewa pan kłopoty. Obiecuję, że będziemy spokojne.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: Moja młodsza siostra… przeżywa ciężkie chwile. Mamy jednak… jak to się nazywało?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: {0}. Proszę, to dla pana. Może się przydać.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: Dobra, niech panie wejdą
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: Nie przekupi mnie pani
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: Jest u ciebie {0}. Ta osoba zasmradza cały dom. Poznam taką z daleka. Tacy ludzie to wilki w owczej skórze.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: Niech wyleci na bruk, jeśli chcesz tu zachować rygor, miśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: Mądry wybór.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: Teraz liczy się wyłącznie silna ręka, miśku. Możesz się z tym pogodzić albo dostać jedną w pysk.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Ejże, nie wyrzucaj mnie… Niech no najpierw spojrzę, co tu mam w torbie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Nóż będę potrzebował… bandaże też… hmm, stara piersiówka, niestety pusta… Nic z tego…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: Aha! Mam! {0}. Bierz, brachu. Pozwól mi tylko zostać do rana.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: Och, w dupę jeża! Może mogę coś ci dać?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: Czy zmienisz wtedy zdanie?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: {0}? Może być?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: Wie pan, nie sądziłem, że ludzie zrezygnują z obkupienia się w zapasy przed końcem świata.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Apokalipsa czy nie, ludzie wciąż muszą jeść!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: Dostawy to teraz całkiem intratne zajęcie, ale ryzyko jest ogromne bez względu na to, jak się na to spojrzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: To cholerne słońce jednak… Przez to teraz pracujemy nocki.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: Ludzie zamawiają po 20 litrów wody. Chciałbym mieć dodatek za pracę w trudnych warunkach lub napiwki za dźwiganie tego.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: Ale wracając do tematu. Jest pan gotów odebrać przesyłkę?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Odbierz przesyłkę)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: Proszę, oto {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: A poza tym rodzina jest daleko. Nie jestem stąd, przyjechałem tu na studia. Nie mam tu nikogo…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Samotność nie jest taka zła
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: Przykro mi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: No, pewnie. Ma pan w domu masę gości, więc łatwo panu mówić.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Nieważne. Praca jako kurier jest całkiem okej.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: Poza tym, na co komu studia, jeśli mnie nikt nie zatrudni?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: Okej, mam tu pana zamówienie. Czy jest pan gotów je przyjąć?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Odbierz przesyłkę)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: Proszę, oto {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: Nie przejmuj się. Będzie dobrze
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: Weź się w garść, to przeżyjesz. Przestań jęczeć jak niedojda
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: Dobrze? Co znaczy „dobrze”, jeśli trwa kataklizm?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: Wszyscy ci Przybysze, objawy, to cholerne słońce…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: Myślałem, że gorzej być nie może, ale każdego dnia szaleństwo się pogłębia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: Niedługo pewnie łoniaki będą objawem Przybyszy, a świat stoczy się jeszcze bardziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Dobra, muszę spadać. Proszę odebrać zamówienie i idę dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Odbierz przesyłkę)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Wielkie dzięki za pogaduszkę. Prawdziwa z pana, psiakrew, skarbnica wiedzy życiowej.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: Wiesz pan co, bierz pan przesyłkę i spadam stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Odbierz przesyłkę)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: Proszę, oto {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: Nie ma innego wyjścia
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: Przykro mi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: Ach, a więc to tak… Mówi pan, że to dobrze, że mój znajomy został zabity?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Proszę wziąć zamówienie i pozwolić, że się oddalę, zanim mnie pan też zastrzeli.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Odbierz przesyłkę)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: *wzdycha*'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: Pamięta pan, jak powiedziałem, że praca kuriera mnie uspokaja? Wygląda na to, że to już nie działa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: Bez ustanku widzę tylko zmęczone, ponure i zgorzkniałe twarze…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: I te niekończące się poranne testy z mierzącymi do nas z broni funkcjonariuszami FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: Cały ten burdel…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: Mam dosyć tego bajzlu. Chciałbym, żeby wszystko wróciło do normalności…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: Dobra, proszę odebrać przesyłkę i idę sobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Odbierz przesyłkę)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: Proszę, oto {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: Życzę dobrej nocy…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: Doskonale. Muszę jednak pana prosić o wyproszenie pewnych… mieszkańców… mających azyl u pana:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: To {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: To {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: Utrudniają nam dążenie do naszego celu, a tak nie może być.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: Załatwię to. Niech panowie wejdą
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Wielkie dzięki.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: Rychło się uwiną. Lecz mimo, niech ich pan dogląda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: Do zobaczenia. Wrócę ich sprawdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: Uważa pan, że istnieje wybór?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: Do zobaczenia. Wrócę ich sprawdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Proszę dbać o moich ludzi i pamiętać, że jeśli któryś z nich zginie… pana dom obróci się w zgliszcza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: Nie śpi jeszcze?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: A powinien…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: Zgubiłeś się?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: Gdzie są twoi rodzice?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: Wszystkie drzwi po ciemku wyglądają tak samo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: Potrzebowałem światła z kuchni, ale… tu roznosi się inne echo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: Z zewnątrz usłyszałem skrzypiącą podłogę. To znaczy, że w środku ktoś czeka.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: Czego szukasz?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: Pomóc ci odnaleźć twój dom?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: Rodzice?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: Nie mam rodziców. Nigdy ich nie miałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Czy są do czegoś potrzebni?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: Czego szukasz?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: Pomóc ci odnaleźć twój dom?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: Nie ten zapach. Nie ten głos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Przepraszam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: To nie ten dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: Nie ten zapach. Nie ten głos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Przepraszam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: To nie ten dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Hej.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: Czy była tu może dziewczyna o fioletowych włosach? Miała na sobie ponczo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: Nie, nie ma u mnie nikogo takiego
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: Jeśli szukasz burdelu, jest kawałek dalej
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: To moja córka…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: Od kiedy zaczął się cały ten syf, nie mogę jej znaleźć.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: Mieliśmy stąd wyjechać…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Potem uderzył ten niezwykły skwar, zemdlałem i…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: Kiedy się obudziłem, nikogo nie było w domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: Żadnego liściku, żadnego śladu. Jakby zwyczajnie zniknęła.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: Dokąd chce się pan udać z córką?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: Nie ma jej tu. Do widzenia
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: Radzę nie mówić tak o mojej córce.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: Szukam jej od kiedy zaczął się ten cały bałagan.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: Nie mam pojęcia, gdzie może być.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: Jak tylko ją znajdę, zjeżdżamy stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: Dokąd chce się pan udać z córką?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: Nie ma jej tu. Do widzenia
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: Gdzieś, gdzie nie dorwie nas FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: Jak najdalej stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: Widzi pan, zdaje się, że mnie szukają, bo wiem o nich zbyt wiele.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: Może to oni porwali moją córkę, a może nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: Jeśli to oni, nie skrzywdzą jej. Chcą mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: Niech mi pan pozwoli zostać tutaj na kilka dni, aż FEMA się stąd nie wyniesie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: Wtedy pójdę dalej szukać córki'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: A co mi tam, nawet wszystko panu opowiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: Dokładnie wiem, skąd się wzięli Przybysze.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: Zaraz, proszę poczekać!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: Potrzebuję schronić się na kilka dni.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: FEMA mnie poszukuje, bo wiem pewne rzeczy…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: Rzeczy, o których rząd nie chciałby, by ktokolwiek się dowiedział.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: Daję słowo, że jak tylko FEMA się stąd wyniesie, pójdę dalej szukać córki.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: A co mi tam, nawet wszystko panu opowiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: Dokładnie wiem, skąd się wzięli Przybysze.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: Dziękuję panu…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: Teraz już rzadko kto wysłucha drugiego człowieka.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: Właśnie tacy ludzie, jak pan, przetrwają ten koszmar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Ponieważ i pan, i ja… jesteśmy nieśmiertelni.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: W takim wypadku powinien pan wiedzieć jedno:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: Nie godzi się pozostawiać ludzi na pewną śmierć.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: Lecz ja nie umrę. Nigdy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: Jeszcze się spotkamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: Oto hojne zadośćuczynienie od Przenajświętszego Słońca we własnej osobie! Zasłużyłeś na to, człowiecze!'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: Spójrz, to… {0}. Wpuść mnie, a obdaruję cię tą szczodrą nagrodą prosto od Przenajświętszego Słońca!'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Uszanowanko, mój chłopcze. Zapomniałeś może o mnie, hm? Nie spostrzegłeś wskazówek zawartych w Księdze Uśmiechu?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Fe… Tylko marnuję cenny czas z wami, gołowąsami…'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: Ach, ta młodzież…'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: Jest pan sam w domu?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Ciężka sprawa. Tak dla pana, jak i dla nas. Jak mamy sprawdzić dzielnicę, w której nikt nie mieszka?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: W porządku. Życzę dobrej nocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: W dowód wdzięczności mógłbym zaoferować panu zbawienie…'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: Proszę do nas dołączyć, a odnajdzie pan spokój. Chodź, bracie, złapmy się za ręce w marszu ku Śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: Jeśli chcecie umrzeć to droga wolna. Ja zostaję
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: Od dawna pragnę spokoju… Idę z wami
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: Skoro tak, niech będzie. Jeśli taka jest pana wola… Śmierć upomni się o swoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: Kłaniam się.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: Pokazuj ręce.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: Uszy? Porąbało cię?! To nie objaw na Przybyszy!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: Uszy? Porąbało cię?! To nie objaw na Przybyszy!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: Wystarczy tego.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: Już mnie więcej nie zobaczysz.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: Naciesz się tym, co jeszcze zostało.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: Czemuś aż taaaki… spięty? Chwyciłeś się życia, jak tonący brzytwy.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: Czy pozostało jeszcze coś, co ma jakieś znaczenie? Zostałeś sam.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: Więęęc…'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: Czy jesteś sam?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: Jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: Nie jestem sam
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: Och, mój drogi chłopcze… To niedobrze…'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Zdaje się, że Festiwal wciąż się zbliża…'
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: Jeśli nie mogą państwo natychmiast przekazać do kwarantanny potencjalnego Przybysza, można mu wręczyć specjalne wezwanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: Załatwię to. Wejdźcie
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Pomiń intro
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (Odbierz przesyłkę)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (Odbierz przesyłkę)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (Odbierz przesyłkę)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (Odbierz przesyłkę)
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: O, hej! Ktoś tu jest. Świetnie!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: Jestem tęgo nakręcony, ale EnerJeka nie ma już takiego kopa, jak kiedyś. Przydałaby mi się dolewka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: Dokąd zmierzasz taki nabuzowany?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: Nie mam żadnych dolewek
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: Tam, gdzie raki zimują. Muszę wciąż być w ruchu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: Nadchodzą ciężkie czasy i ciekaw jestem, co ludzie wtedy poczną.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: Będę szedł, aż mnie nie spali, lub aż mnie nie zeżrą Przybysze. Zależy, co zdarzy się pierwsze.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: Nie starasz się dotrzeć do jakiegoś azylu?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: Od kłopotów nie uciekniesz
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: Mam ze sobą starą, dobrą EnerJekę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: Zapasów mam na całe wieki. Nawet nie pytaj, gdzie je upchnąłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: Podróżuję nocą, więc znajdę jakieś schronienie, zanim słońce mnie przypiecze.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: Nie starasz się dotrzeć do jakiegoś azylu?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: Od kłopotów nie uciekniesz
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: Co masz na myśli?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: Im dalej zajdę, tym mam większe szanse na odnalezienie rozwiązania. Nie czaisz, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: Kto wie, może jest u ciebie skitrane coś, co jest ostatnią nadzieją ludzkości?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: Jeśli nie ruszyłbym się z mieszkania, nigdy bym się nie dowiedział.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: Tylko czekałaby mnie śmierć.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: W samotności.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: Walić to.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: A potem co?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: Uciekasz przed czymś?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: A ty tu utknąłeś. Uważasz, że dzięki temu jesteś bezpieczny?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: No tak, żyjesz. Rozmawiamy sobie, racja.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: Ale patrz, ja też wciąż żyję! Zdaje się, że obaj mamy swoje sposoby.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: Może udzielimy sobie nawzajem kilku rad, heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: A potem co?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: Uciekasz przed kimś?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: Potem zacznę biec.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: Będę biegł tak długo, aż nie odnajdę tego, czego szukam… czymkolwiek to jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: Ale twoja miejscówka wygląda całkiem nieźle, tak myślę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: Wpuścisz mnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: Nie słuchasz mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: Mówiłem już. Przyglądam się, jak inni dają sobie radę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: Widziałem kilka fajnych miejsc, ale ogólnie to jest w kółko to samo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: Ludzi ogarnia panika i albo nie otwierają, albo strzelają do wszystkiego, co się rusza.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: Mówiąc szczerze, to nie są to najrozsądniejsze strategie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: Tak czy owak, męczy mnie stanie u twojego progu. Jeśli mnie wpuścisz, opowiem, co widziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: O, wspaniale!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: Powiesz mi, co tu jest grane, umowa stoi?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: Ja też się podzielę, mam co nieco do opowiedzenia, pogadamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: Ale lipa. Czekaj, mam ze sobą sporo gratów.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: Chcesz EnerJekę? Mam też inne rzeczy!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: Albo… momencik.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: Oto {0}. Chcesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: O kurcze, jest u ciebie {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: Nie przepadam za rozmową w towarzystwie takich osób. Mają zwyczaj przekręcać każdą historię wedle uznania.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: Cały z tym bałagan. Nie, nie trzeba mi tego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: Ha, ha, ha, pierwszy raz widziałem tę osobę na oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: Wybacz, myślałem, że to będzie niezły żart.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: Oj tam, za to poopowiadam ci wiele ciekawych rzeczy!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: Nie ma problemu, spróbuję gdzieś indziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: Słyszałem o jakimś Januszu biznesu sprzedającym powietrze. Boki zrywać!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: Aż się zastanawiam, ile zarobił na tym wałku.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: Dobra, na razie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: Nuda. Wciąż to samo…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: Dobra, kopsnę się w inne miejsca, sprawdzić co i jak.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: Słyszałem plotki o jakimś czubie przyjmującym ludzi, żeby robić im pranie mózgu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: A potem wrzuca ich do ognia!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: Może spróbuję się tam dostać. Brzmi nieźle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: Hej, stary, otwieraj. Słońce wali jak jupitery. Zaraz od tego oślepnę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: Pozwól, że się przekimam kilka nocy. Nie zostanę na długo. Nie jestem jakimś… uh… jak to się mówiło?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: Ach, darmozjadem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: Panuje absolutny burdel, jakby zamówić gwiazdę sceny bez ochroniarzy do jakiejś nożowni!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: Co ty tam ze sobą masz?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: Dlaczego wyglądasz, jakbyś nie spał od tygodnia?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: Nic podejrzanego. Mały piecyk i kilka butelek wody. Użyczę ci pieca, jeśli umiesz szarpać struny.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: Słyszałem, że w pobliżu znaleźli Przybysza i teraz sprawdzają wszystkich. Dla mnie wporzo, dopóki nikomu nie odwali.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: Bo nie spałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: Pogrywałem do rana, a potem wbiły do nas jakieś zjeby i zaczęły nas okradać.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: Kutafony nawet gitarę mi zajebały. Przez ten cały syf ludzie zachowują się jak zwierzęta, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: Prawdę mówiąc, gdybym był Przybyszem, waliłbym w drzwi z buta albo właził oknem, ale jestem… tutaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: Dzięki, stary. Zagram kilka nutek od czasu do czasu, w porządku? Pobrzdąkam ci coś, jak zdobędę jakąś gitarę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: Albo i nie…! To zależy od ciebie, stary!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: Rozumiem, bracie. Nie żywię urazy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: Spróbuję przenocować u znajomych. Wielu ich nie zostało i oby ktoś z nich był jeszcze na tym świecie…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: Nie, obok takiego chamidła moja noga nie postoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: Właśnie tak, tą osobą jest {0}. Zajmij się tym, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: Czadowo!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: Bez gitary… to nie to samo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: Sram na to.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: Jeśli nie ty, to ktoś inny mnie wpuści.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: Jak tam, wpuścisz mnie, herbatniku?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: Czemu łazisz w samych gaciach?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: Do licha, skąd ty się tu wziąłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: Czy to nie oczywiste? Goręcej tu niż w dupie diabła. Dziwi mnie, że nikt na to nie wpadł.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: Łażą, jakby im śnieg w oczy sypał. Banda klaunów.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: Ja odsiedziałem tu i tam. Zaraz jak wyszedłem z mamra, zerwałem z siebie wszystkie szmaty. Teraz oddycha mi się lekko.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: I co robisz pod moim domem, do cholery?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: Dlaczego nie zostałeś w więzieniu?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: Kiblowałem kilka razy, herbatniku.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: Zostałbym dłużej, ale wybił mój dzwonek.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: A teraz? Całemu światu uderzyło w sufit. Słońce wali taką rakietą, że mi zaraz zbuki odpadną.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: Wygląda na to, że wracam na ulicę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: I co robisz pod moim domem, do cholery?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: Dlaczego nie zostałeś w więzieniu?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: Nie mam dokąd iść, herbatniku.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: Nie mam floty, żona odeszła z jakimś cwelem i jestem na gigancie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: Wtedy ujrzałem to miejsce – czyste, ciche, z dala od wszystkiego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: Psy tu dupami szczekają i nie ma wścibskich gapiów. Ta okolica rządzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: Dobra, dosyć trzaskania dziobem. Mogę u ciebie uderzyć w kimono, herbatniku?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: Pewnie, zostałbym. Myślisz jednak, że ktoś się pytał?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: Zegar wybija godzinę i wypad przed bramę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: Nie mam floty, żona odeszła z jakimś cwelem i jestem na gigancie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: Dobra, dosyć trzaskania dziobem. Mogę u ciebie uderzyć w kimono?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: Mądry wybór, herbatniku.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: Ubaw z tobą po pachy, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: Adios, frajerze.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: Słuchaj, herbatniku. Jest u ciebie niezła łachudra.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: Ta osoba to {0}, nie? Znam ten typ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: Mądry wybór, herbatniku.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: Dzień dobry. Proszę, czy możesz mnie wpuścić?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: Potrzebujesz czegoś?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: Szukasz schronienia?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: Tak, dachu nad głową. Nie mam dokąd się udać.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: Akademik niestety nie jest już opcją…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: Co się stało z akademikiem?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: Tak. Proszę… wpuść mnie, jeśli to nie problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: Mieszkałem w akademiku, ale musiałem odejść…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: Co się stało z akademikiem?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: Zrobili łapankę… A ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: Nie chcę skończyć w strefie kwarantanny.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: Pewnego dnia przyszli i powiedzieli, że muszą wszystkich sprawdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: Słyszałem jednak, że zainfekowanych biorą do stref kwarantanny…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: Nie chcę tam skończyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: Dziękuję z całego serca.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: Proszę, oto {0}. To niewiele, ale mam nadzieję, że się przyda.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: Nie, proszę… Wpuść mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: Nie chcę natrafić na patrol. Albo gorzej – na Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: Jeśli chcesz, mam coś: oto {0}. Czy dzięki temu zmienisz zdanie?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: Och… przykro mi, ale jest u ciebie {0}. Nie ufam takim ludziom…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: Dziękuję bardzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: Proszę, oto {0}. To niewiele, ale mam nadzieję, że się przyda.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: Słyszałam o tobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: Większość ludzi nie zbliża się do twojego domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: Ci, którzy tu przychodzą, są albo zdesperowani… albo głupi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: Ale ja cię szanuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: Dzięki?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: Ekhm… A co takiego o nim mówią?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: Nie, poważnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: Większość osób się poddała. Są zbyt słabi, by żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: Odważniejsi przykładają sobie broń do głowy. Inni dzień za dniem zwyczajnie marnieją.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: Lecz ty do takich nie należysz. Nie poddasz się bez walki.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: Czy ty też jesteś zdesperowana?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: Brzmisz jak jakaś szajbuska
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: Przetrwać tutaj to nie lada wyzwanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: Że nie pozwalasz Przybyszom odebrać tego, co należy wyłącznie do ciebie – twojego życia…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: Po prostu musiałam tu przyjść. Myślę, że coś nas łączy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: Przeżyjemy, choćby nie wiem co.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: Czy ty też jesteś zdesperowana?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: Brzmisz jak jakaś szajbuska
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: Że co?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: Ach, chcesz wiedzieć, czemu tu przyszłam? Ha, kto wie? Może mi odbiło.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: Ale absolutnie nie jestem zdesperowana.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: Ludzie przeżyli gorsze tragedie. Z jakiego powodu mielibyśmy się poddać?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: Ach, wybacz, jeśli sprawiłam takie wrażenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: Uważam jedynie, że jeśli będziemy siedzieć na tyłkach i nic nie robić, będzie to nasz koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: Tylko walcząc, przetrwamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: Tylko zdrowe rybki płyną pod prąd. Nic nie przychodzi łatwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: Cudnie!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: Wiesz, jestem zaszczycona tu być, gdy nasz los diabli wzięli.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: Pogadajmy czasem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: Czy to jakiś test?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: Nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: Hm, tego się spodziewałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: Ale z ciebie…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: …dupek.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: Serwus, przyjacielu!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: Czy mogę u ciebie na chwilę zostać? Nikogo innego albo nie ma w domu, albo ich wyrzucili, albo kto wie, co się z nimi stało.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: Myślałem, że miałem kilkoro przyjaciół, wiesz? Zdawało mi się, że przetrwamy to razem… ale zamiast tego jestem tutaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: Mieszkałem z matką i babcią, ale wyrzucili nas komornicy… Straszny to bałagan…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: Kiepskich masz przyjaciół
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: Więc poszukują cię jacyś rozzłoszczeni ludzie?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: Pracownicy teatru. Razem piliśmy, wygłupialiśmy się i mogliśmy na siebie liczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: Byli jak do rany przyłóż, zawsze skorzy do pomocy, do obalenia piwka czy do pogaduszek.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: Ale ostatnimi czasy… Nie mogę się do nich dodzwonić. Wszyscy mają swoje problemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: I przez to przeklęte słońce wszystko się pokićkało.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: Nie, nie mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: Ścigają moją matkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: Starała się mnie chronić, nie puściła pary z ust.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: Nie będę ci ciężarem. Wszystko ci opowiem, tylko… mnie wpuść, przyjacielu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: Niech to gęś kopnie, ratujesz mi życie, przyjacielu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: Przyjdź do mnie później, okej? Mam historyjki nie z tej ziemi. Wprawią cię w osłupienie, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: Okej, przyjacielu. Rozumiem. Nie mam ci tego za złe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: Dbaj o siebie, dobrze? Obyś przeżył cały ten cyrk.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: Jak się masz? Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: Przepraszam, jestem trochę spięty…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: Mam nocleg w hotelu „Nadzieja”, ale wyszedłem na spacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: Boję się… wrócić. Czy mogę tu zostać?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: Czemu? Wróć do hotelu
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: Myślisz, że u mnie będzie lepiej?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: Nie podoba mi się tam. Wole znaleźć nowe miejsce.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: Przebywa tam dziewczynka w żółtym sztormiaku.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: Mam przed nią pietra. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: Nie mam dowodów, nie, nie, nie… Ale myślę, że ona jest Przybyszką.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: Przyszli ludzie z FEMA, a wtedy… przepadli.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: Czemu nie pójdzie pan do rodziny?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: Nie ma pan znajomych?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: Tam jest okej. Tu jest lepiej. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: Twój dom jest dość duży na ludzi wszelkiej postury.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: Pokoje hotelowe są tyci‑tyci. Przypominają mi… straszne czasy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: Ale o tym… później. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: Czemu nie pójdziesz do rodziny?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: Nie masz znajomych?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: To był wypadek… Rach, ciach i tak tu jestem!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: Raz mi pomogli, ale teraz mają mnie w dupie!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: Więc… nie mam ochoty wracać na rundę drugą! Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: Już prędzej wolałbym wrócić do hotelu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: Jakich znajomych?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: Wszyscy tylko wciąż mi dokuczali. Każdy jeden palant… aż od czasów szkoły.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: Jeden dostał za swoje… ale teraz jestem bardziej ostrożny. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: Teraz staram się… dogadywać z nowymi ludźmi!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: A poza tym słyszałem w okolicy wystrzały, a ty bierzesz bezpieczeństwo na poważnie. Taaak…?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: Nareszcie!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: Miejsce, w którym mogę przeczekać ten cały rozgardiasz…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: Więc… ty też myślisz, że jestem szurnięty?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: Małym, obłąkanym szajbusem‑pojebusem?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: Jesteś taki sam, jak ci kaci… w białych kitlach.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: Zobaczysz, pożałujesz tego… Wspomnisz moje słowa…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: Hej. Ekhm, mam nadzieję, że nie wyglądam na tyle źle, byś mnie nie wpuścił?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: A są powody do obaw?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: Co jest nie tak z twoją skórą?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: Nie! Właśnie o to chodzi. Nic mi nie dolega.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: Urodziłem się z problemami skórnymi. To tyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: Wciąż jestem traktowany jakbym rozsiewał choróbsko… albo gorzej, jakbym był Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: Ostatnimi czasy wszyscy wpadli w paranoję
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: A czego się spodziewałeś?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: Dokładnie o to mi chodzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: To wada wrodzona. Nic na to nie poradzę. I z jakiegoś powodu wszyscy myślą, że jestem Przybyszem. Oszaleć można.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: Ostatnimi czasy wszyscy wpadli w paranoję
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: A czego się spodziewałeś?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: Rozumiem, ale nie jestem Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: Przekonamy się o tym
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: Skąd ta pewność?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: Co masz na myśli, mówiąc „A czego się spodziewałeś?”. Weź się zastanów. Myślisz, że chciałem tak wyglądać?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: Mówię ci, nie jestem Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: Przekonamy się o tym
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: Skąd ta pewność?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: Jak sobie chcesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: To jak, wpuścisz mnie czy nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: Przekonamy się o tym
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: Skąd ta pewność?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: Bo wiem, kim jestem. I nie jestem jednym z nich.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: To jak, wpuścisz mnie czy nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: Przekonamy się o tym
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: Skąd ta pewność?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: Dzięki… za wpuszczenie mnie do środka. I o nie robienie problemu z mojego wyglądu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: Oczywiście. Niech tak będzie. Idę sobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: Dobry wieczór. Czy jest szansa, by miał pan miejsce dla jeszcze jednej osoby? Wiele mi nie trzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: Co pana tu sprowadziło?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: Skąd mam wiedzieć, że nie jest pan Przybyszem?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: Skończyłem niedawno studia, ale nie mogę znaleźć pracy w zawodzie, więc zacząłem pracę w niewielkiej kawiarni.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: Ale niestety po ostatnich zdarzeniach nie mieliśmy żadnych klientów i nas wszystkich zwolnili.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: Zdaje się, że ci zatrudnieni w nocnych klubach mieli więcej szczęścia. Tam interes się kręci.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: W ciężkich czasach ludzie wolą na pewien czas o wszystkim zapomnieć… i być przez chwilę beztroskim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: Jak wtedy, gdy byliśmy dziećmi…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: Właściciel z oporami wynajął mieszkanie świeżakowi po studiach bez stałego dochodu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: Więc jak się to wszystko zaczęło, zaraz mnie wyrzucił. Twierdził, że to przez brak zatrudnienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: Rychło wprowadził tam przyrodnie rodzeństwo. Nie mam mu tego za złe, ale liczę, że pan zrozumie też moją perspektywę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: Nie cierpię być niczyim ciężarem. Lecz kiedy sprawy mają się źle, trzeba robić wszystko, by przeżyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: Postaram się być przydatnym, aż nie stanę na własnych nogach. Obiecuję, że kiedyś się odwdzięczę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: Dobra, niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: Nie potrzebuję bumelantów. Sio mi stąd
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: Szczerze mówiąc, to wciąż nie wiem nawet, kim są ci Przybysze i czym się od nas różnią.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: Może nawet pasuję do niektórych objawów, kto wie? Ostatnio wszystko jest takie dziwne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: Ale chyba nadal jestem tym, kim zawsze byłem. Nie czuję przynajmniej żadnej chęci do skrzywdzenia kogoś.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: To wszystko przypomina opowieści z dzieciństwa. Te, w których zło opanowuje świat.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: Ludzi opanowuje przerażenie, kryją się, przestają sobie ufać…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: Gdyby tylko mógł zjawić się jakiś bohater i pokonać prawdziwe zło, by wszystko wróciło do normy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: Ze mnie raczej żaden zbawiciel, ale w każdej historii dobro zawsze zwycięża.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: Dobra, niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: Nie potrzebuję bumelantów. Sio mi stąd
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: Rozumiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: Wiem, że niewiele mogę zaoferować… ale proszę uprzejmie to jeszcze przemyśleć.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: Kiedyś odpłacę szanownemu panu. Jestem też od razu skory do udzielenia wszelkiej pomocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: Nigdy nie podejrzewałem, że start w dorosłość będzie taki ciężki… nie mam dokąd się udać…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: Dobra, niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: Dziękuję pięknie, szanowny panie! Nie zapomnę o tym!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: Dobrze jest wiedzieć, że tacy uprzejmi ludzie to nie tylko bajki.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: No dobrze. Rozumiem. Życzę miłego wieczoru.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: Siema, siema, siema, co tam?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: Co za noc, co? Czujesz to? Sama magia!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: Pojebało cię czy co?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: Skąd ta wesołość?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: Och, nie bądź taki, po prostu jeszcze tego nie rozumiesz!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: Kolego… nie, bracie! Nie muszę już martwić się kredytem!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: Czuję się, jakby mi ciężar z serca spadł, i to jaki!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: Więc… po co tu przyszedłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: Co zrobisz z całym tym zaoszczędzonym hajsem?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: No, tonąłem w długach.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: Wszystko trafiał szlag, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'SuperFake: ALE TERAZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: Nikomu nic nie wiszę!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: W całym tym pierdolniku nikt nie przejmuje się bankami ani pożyczkami!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: To wspaniałe uczucie!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: Więc… po co tu przyszedłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: Co zrobisz z całym tym zaoszczędzonym hajsem?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: Kurczę, dobre pytanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: Prawdę mówiąc, wolę o tym nie mówić na dworze.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: Bez urazy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: Widzę, że nie strzępisz jęzora
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: To było wielce sarkastyczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: Nie lubię tego, prawdę mówiąc.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: Widzę, że nie strzępisz jęzora
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: Cóż mogę powiedzieć? To jasne, że nie cieszy cię moje szczęście.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: Nieważne. To nie był twój dług, no nie? Sam w końcu masz tu fajny domek.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: Jeśli ja bym taki miał, byłby to szczyt marzeń.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: To jak, mogę wejść, czy jak to będzie?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: No i pięknie! Strzelmy sobie po bronku lub dwóch, aby to uczcić!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: Nawet nie wiesz, jaki to dla mnie ważny dzień!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: Bez szans?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: Kurwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: Yhm, coś wymyślę. Do wschodu słońca jeszcze trochę zostało.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: Och, więc ktoś tu jest. Mogę wejść?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: A czy ten dom wygląda na opuszczony?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: Masz tupet
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: Nie, nie to miałam na myśli.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: Słyszałam tylko… że na przedmieściach odjebują się straszne rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: I to nie tylko w naszym mieście.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: Jak gdyby psychole i Przybysze nie wystarczyli, to jeszcze słońce chce nam dopierdolić.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: Przed czym uciekasz?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: Myślisz, że tu będzie lepiej?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: Hej, nie trzeba być od razu niegrzecznym.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: Nie zrobiłam niczego złego i proszę przestać patrzeć na mnie z pogardą, jeśli to właśnie robisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: Mój wygląd zewnętrzny o niczym nie świadczy. Nikomu źle nie życzę. Obyś mnie nie oceniał na tej podstawie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: Przed czym uciekasz?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: Myślisz, że tu będzie lepiej?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: Czemu myślisz, że przed czymś uciekam?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: Nie przepadam za formalnościami. Łatwiej wtedy przejść do rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: Na dodatek uważam, że w miastach już wkrótce nie będzie bezpiecznie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: Im dłużej to trwa, tym będzie gorzej. Mniej powietrza, więcej przestępczości, paranoja aż kipi na blokowiskach.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: Obraliśmy kurs na niezły bajzel.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: A ja nie chcę stać na dziobie, gdy wszystko pierdolnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: Pewnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: Pominę formalności i przejdę od razu do rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: Nocą powietrze tutaj jest chłodniejsze i nikt nie jest przyklejony do telewizora.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: Nie wiem, czy jest u ciebie prąd, ale jeśli nie, tym lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: Oglądanie telewizji i tak niczego nie ułatwia.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: Najgorsze są wiadomości i zdawanie sobie sprawy, że współczynnik przejebania trzeba pomnożyć razy pięć… albo i dziesięć.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: Wspaniale.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: Pogadajmy jutro. Dzisiaj już nie mam siły.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: To był strasznie ciężki tydzień.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: W sąsiedztwie są jeszcze inne domy. Może znajdę tam kogoś, komu nie wadzi moja twarz i kto zachowa się po ludzku.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: Dobra. Zwijam się.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: Dobry wieczór. Gospodarzu, czy mogę prosić o pomoc? Nie jestem stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: W czym problem?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: Jak pan tu w ogóle trafił?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: Popełniono błąd. Nie mogę się wydostać z miasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: Lotnisko zamknięte, pociągi nie jeżdżą.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: Wybrał pan niezły czas na wycieczkę
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: Naprawdę nie ma pan gdzie się podziać?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: Zmierzałem do stolicy, planowałem podróż…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: Wtedy pozamykali granice… i utknąłem tutaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: Tak właściwie to jestem tu tylko przejazdem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: Wybrał pan niezły czas na wycieczkę
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: Naprawdę nie ma pan gdzie się podziać?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: Tak, dokładnie. Proszę mi wierzyć, że gdybym wiedział, co się stanie ze słońcem, nie przyjechałbym.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: Ale jestem tu i nie stać mnie na hotel. Zacny gospodarzu, proszę uprzejmie przyjąć mnie pod swój dach.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: Nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: Byłem w hotelu przez jakiś czas, ale skończyły mi się pieniądze.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: Więc teraz nie mam dokąd pójść.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: Szlachetny panie, proszę mnie wpuścić.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: Niech pan wejdzie
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: Jestem pana dłużnikiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: Choroba… co mam począć? Zapukałem już do wszystkich drzwi w okolicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: Żałuję, że tu przyjechałem…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: Dupa blada… FEMA mnie znajdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: Dobra, palę wrotki.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: A to kto u ciebie siedzi? Czy to {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: Rozwiąż jakoś tę sytuację, albo pójdę gdzieś indziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: Hm. Nie sądziłam, że się do tego posuniesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: Widocznie tej osobie zabrakło woli walki, bo poszło ci jak z płatka.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: Co, u diabła? Myślałam, że okażesz trochę szacunku do silnego charakteru.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: Nie mów mi, żeś miękka pała.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: Ale… rozczarowanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: Przyjacielu, potrafię dogadać się z każdym. Ale z tą osobą będzie problem, zapalają mi się same lampki ostrzegawcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: Ta osoba to {0}, o tam. Może powinniśmy… coś z tym zrobić?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: Niezręczna sytuacja, wiem… Wyrzucić tak kogoś za drzwi. Lecz takie jest życie. Czasem uprzejmość schodzi na dalszy plan.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: Kurde.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: Okej, przyjacielu. Rozumiem. Nie mam ci tego za złe.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: Dbaj o siebie, dobrze? Obyś przeżył cały ten cyrk.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: Och… Widzę, że jest u ciebie {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: Dokładnie wiem, co zaszło miesiąc temu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: On jest róóówno stuknięty.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: Wiem, bo swój pozna swego…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: Znakomicie…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: Brzmi podejrzanie. Ale… co mi tam! Hi, hi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: Nie powinien mieszać się w te szurnięte sprawy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: Naprawdę?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: Może to i lepiej, że nie skończę u ciebie. Tak…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: Jeśli otaczasz się samymi dupkami, może w dupie byłeś i gówno widziałeś. Hi, hi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: Przepraszam, ale nie mogę wejść.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: Jest tutaj {0}. Ta osoba zawsze dokuczała mi z powodu mojego wyglądu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: Dzięki. Naprawdę wolałbym tego więcej nie doświadczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: Czy faktycznie sądzisz, że ludzie drwiący z wyglądu innych zasługują na twoją gościnę?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: Tak czy siak to twoja decyzja. Pójdę sobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: A jeśli ci coś dam? Oto {0}. Czy teraz mnie wpuścisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: Dziękuję uprzejmie! Ale… zdaje się, że jest u pana ktoś, kto sprawiał mi problemy w kawiarni.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: I to nie z mojej winy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: Wiem, że poświęcił mi pan już wiele czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: Ale obawiam się, że inaczej nie będę czuł się tu komfortowo. Ta osoba to {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: Czy mnie słuch nie myli?! Dziękuję! Nie musiał pan, gospodarzu… Znalazłbym sobie inny nocleg.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: Ale doceniam pana zaufanie!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: Dobrze, rozumiem. Życzę miłego wieczoru.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: O nie, jest u ciebie ktoś, kto zepsuje każdą zabawę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: Widzisz tego typka o tam? Ta osoba to ten {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: Dość mam w życiu nieszczęść. Czy możemy chociaż pozbyć się tego kocmołucha?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: Powinieneś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: No, tak możemy rozmawiać!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: Wypijmy za śmierć długów, co? Ha, ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: Kurza twarz… czaję.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: W porządku, zmiatam stąd. Do wschodu jeszcze trochę zostało.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: Ja pierniczę, stary, przypominasz mi tych cholernych banksterów.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: Dobra. Robię to ostatni raz.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: Trzymaj, mam tutaj… co tu właściwie mam?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: Spójrz, co znalazłem, oto {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: Czy to zmieni twoje zdanie?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: No nie, patrz, kto tu jest: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: To długa historia i nie zamierzam jej teraz opowiadać.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: Nie chcę jednak przebywać z tą osobą w tym samym pomieszczeniu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: Załatwię to. Wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: Powinnaś odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: Dzięki. Nie spodziewałam się tego, ale trzymałam kciuki.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: Cóż.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: Wciąż mam czas. Znajdę inną miejscówkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: Tylko szkoda, że to dupkom dopisuje szczęście.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: Przywykłam do tego. Wiem, czego chcesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: Okej. Czy to pomoże? Oto {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: Umowa stoi?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: Dobra, wejdź
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: Nie przekupisz mnie
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: Proszę mi wybaczyć, zacny panie, ale obawiam się, że nie mogę jeszcze wejść.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: Jest u pana ktoś, z kim na pewno się nie dogadam. Ta osoba to {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: Załatwię to. Proszę wejść
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: Powinien pan odejść
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: Jestem dozgonnie wdzięczny.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: Trudno… szkoda.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
