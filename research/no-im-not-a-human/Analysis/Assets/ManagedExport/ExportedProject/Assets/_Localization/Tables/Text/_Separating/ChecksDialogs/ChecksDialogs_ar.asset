%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_ar
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ar
  m_SharedData: {fileID: 11400000, guid: 9ca4ee10b5b962b4993a5133922046c2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: بالتأكيد يا صديقي. *يسعل* ليس لديّ ما أخفيه. احترق كل ما أملكه في النيران.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: ألقِ نظرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: لا تحكم عليّ بقسوة. الرئة المعبئة بالدخان ليست سهلة العلاج.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: تفضل، ألقِ نظرة... *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: مثل جذعين متفحمين وبعض الأغصان السوداء. لكن أظافري نظيفة. أمر مثير للسخرية، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: لا مشكلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: أترى؟ *يسعل* حمراوتين كجمرتين متوهجتين. هذا بسبب الدخان يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: أأنت متأكد؟ لن تجد منظرًا لطيفًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: بشرتي متشققة كلحاء الشجر. لا أرفع ذراعي إلا إذا اضطررت لذلك. الألم شديد للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: بالتأكيد، لا يهم. لكنك لن تحصل إلا على جثة متفحمة. هكذا هي حالتي دائمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: كيف سارت الأمور؟ *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: لن تجد الكثير لتفحصه. لقد احترقت حتى الغضروف.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: أنا متأكد من أن سمعي سيضعف قريبًا. ربما هذا للأفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: تفضل وأطلق النار إذا أردت يا صديقي. لكن لا تصوب نحو أسناني، فلن تمر فترة طويلة قبل أن تتعفن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: لا يهم. لم أعد أخاف أي شيء. أطلق النار عليّ إذا كان ذلك سيسهل الأمور عليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: فكرة سديدة. قد تكون رحمة لي الآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: هل لديك أي فكرة عما مرت به هذه الأيدي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: إذا كانت هذه الصورة حكم بإعدامي، فلننتهِ من الأمر. لم يعد لديّ ما أعيش من أجله على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: كل شيء يتحول إلى رماد في النهاية... وأعتقد أن دوري قد حان.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: أتعلم، *يسعل* لم أستطع أن أجعل أطفالي يواظبون على غسل أسنانهم. والآن... لا يوجد من يذكّرهم بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: كنت *يسعل* أنقذ الأرواح بهذه اليدين. الآن لا أستطيع حتى حمل كوب لعين.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: إذن، هذا ما آلت إليه الأمور في حياتي...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: أعتقد أنه قد حان وقت موتي...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: عندما تشاهد غابة تحترق... *يسعل* فإنها تتداعى كليًا. وتعلم أنه لا يوجد ما يمكنك فعله.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: أستيقظ أحيانًا في الليل، وأشعر بجلدي يتساقط كالقشور. ولا شيء يخفف الألم. *يسعل* لقد التهمت النيران كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: لا يبقى إلا الذكريات. إنها مسألة وقت فقط قبل أن تحترق أجسادنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: عندما تشتعل النيران من حولك، ستتذكر لحظات كهذه تُريح قلبك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: بالتأكيد، أعطني أصعب الاختبارات التي لديك. سأجتازها جميعًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: تفضل، ألقِ نظرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: هل سبق لك أن رأيت أسنانًا مثل هذه؟ إنها ككنز دفين في فمي!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: إنها ليست أسنانًا عادية، بل من الذهب الخالص! ليس كلها بالطبع، لكنني متأكد من أنني سأضيف المزيد في النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: هل أدركت يومًا مدى سهولة فتح زجاجة الجعة بأسنانك الأمامية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: أفضل من فتاحات الزجاجات!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: أنا ممتن لأنني ما زلت أمتلك يديّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: لولاها، لما تمكنت من المشاركة في السباقات!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: انتظر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: أصابعي اختفت!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: بالأمس كان ينقصني واحد فقط. أين ذهبت بقية الأصابع؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: لا بأس، ستنمو من جديد. سيستغرق الأمر بعض الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: إصبعي اختفى!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: ليست كارثة أو أي شيء، لكنني لست سعيدًا بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: لكن أظافري تنمو قليلًا، أترى!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: ما يعني أن ساقيّ ستنموان من جديد أيضًا! سيستغرق الأمر بعض الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: أين تريدني أن أنظر؟ إليك مباشرة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: لا تهتم بارتعاش العين. إنها عادة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: في الأيام التي كنت أستطيع فيها التسابق بأقصى سرعة، لم أكن أستطيع التركيز بعيني على... أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: أعتقد أنني لست مستعدًا لتخفيف سرعتي بعد، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: هاه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: كما تشاء... هاهاهاها، اللعنة، هذا مسلٍ جدًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: لقد نجحت يا صديقي: لقد حققت الكوميديا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: صرنا جميعًا ننظر إلى إبطي بعضنا بعضًا الآن. هذا جنون.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: العالم الخارجي قطعة من الجحيم، وكأن الكون استجمع كل قواه لإبادتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: كما أن هناك زوارًا يحاولون قتلنا جميعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: وأنت تخبرني "أرني إبطيك!"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: هاهاهاها!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: هل تريد أن تلتقط صورة لي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: لست من مغرمي التصوير الفوتوغرافي، لكن لا بأس.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: تبًا، لقد رمشت في الصورة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: هاهاهاها! عُلم يا زعيم!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: هل سمعت تلك الإذاعة أيضًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: نعم، كانت جيدة، أليس كذلك؟ ...هممم؟ ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: ...مهلًا، الم تسمعها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: هذا ليس صائبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: حسنًا، لا بأس، لن أشرب المزيد من جعتك. لا تأخذ الأمر على محمل شخصي!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: أتعرف ماذا يحدث للأشخاص الذين يسايرون الآخرين مثلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: يقودهم غضبهم إلى حد الجنون والمرض. وقد تصبح قعيدًا مثلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: إذا كنت ستغضب إلى هذا الحد، فحضّر نفسك واجلب كرسيًا إلى جانبي لتجرب ذلك الشعور.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: هذا لن يساعدني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: ولن يساعدك كذلك على الأرجح. فما الفائدة إذن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: ربما لن أتمكن من تتبع الرصاصة بالعين المجردة. لكن يمكنني محاولة تفاديها.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: لم أفهم قط اهتمام الناس بالحلاقة. إن الشعر حاجز دفاع الجسم الطبيعي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: أترى هذا الطفح الجلدي الأحمر اللامع؟ أصابعي تنمو. فلديّ أصابع إضافية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: آه، الضحكات الحقيقية لم تأتِ بعد. لا نزال في البداية!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: كيف أخطأنا جميعًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: مَن يهتم بمشاهدة بعض الصور السخيفة؟ الحياة أقصر من أن نضيعها في مثل هذه الأشياء يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: ما أعنيه هو...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: اسمع، دعني أرحل، اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: حسنًا، أعتقد أننا جميعًا ننال في النهاية ما نستحقه.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: عاجلًا أم آجلًا، ستلقى عقابك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: لن أموت بهذه السهولة! أبدًا! آآآآههه!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: كل هذا مبرمج في بيولوجية أجسادنا، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: في لحظة نضحك معًا، وفي اللحظة التالية نطلق النار على بعضنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: عليّ الاستعداد لرحلتي الأخيرة...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: يداي بمثابة المحرك المتبقي لي الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: ولكن ينقصني القابض!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: بصراحة، فكرة أنني قد أفقدهما يومًا ما تخيفني. ماذا سأفعل حينها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: سأكره أن أكون بلا أي وسيلة للتنقل. سأظل عالقًا إلى الأبد...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: حتى الموت لا يخيفني أكثر من ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: يومًا ما، مهما حاولت، لن تتمكن من اللحاق بالركب.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: هل لاحظت كيف أن الوقت يمر بسرعة أكبر مع تقدم العمر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: في طفولتنا، بدت الحياة أبدية. كان كل شيء بسيطًا آنذاك، بلا مسؤوليات أو قرارات.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: ولكن الآن، مهما أسرعنا، يبدو أننا لن نلحق بالركب أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: أتعلم، لسبب ما، لم أعد أشعر بالرغبة في الضحك فجأة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: فحوصاتك المجنونة، وإطفاء الحرائق...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: "الجميع يريد إنقاذ العالم، لكن الخلاف حول الطريقة يمنعهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: وهل هناك أي فائدة من ذلك؟ ربما نحتاج جميعًا إلى التوقف وعدم القلق بشأن ذلك كثيرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: انظر...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: ألا تعتقد أن رحلتنا الممتعة على هذا الكوكب قد انتهت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: وصلنا إلى نهاية الطريق. وسنغادر جميعًا قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: تووت تووت! وصلنا المحطة الأخيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: ولكن هل أنت مستعد لذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: لقد كنت أفكر في شيء... أتعدني ألا تنزعج؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: إذا... إذا كنت لا تستطيع الاعتماد على هذه العلامة، فكيف يمكنني أن أعتمد عليها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: مَن يدري؟ ربما تشير جميعها إلى الزوار، أو ربما لا تشير أي منها إلى ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: البشر كثيرو الأخطاء، كما تعلم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: لكن الأخطاء قد تكون لها عواقب وخيمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: إذا... إذا كنت تعتمد على هذه العلامة الآن، فكيف يمكنني أن أستمر في الوثوق بالعلامات السابقة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: قد تكون العلامات الأخرى مجرد هراء أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: نحن بشر في النهاية. وجميعنا نرتكب أخطاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: لكن هذه الأخطاء قد تؤدي إلى عواقب وخيمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: مثلك تمامًا... خطوة واحدة خاطئة كافية لسحب الزناد، ثم بووم، يدفع أحدهم الثمن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: إذا كنت واثقًا من اختيارك، فأنا أحسدك على هذه الثقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: حسنًا. هيا، اختبرني. ليس لديّ ما أخفيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: من فضلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: أتعلم، لم أكن أهتم بها كثيرًا في السابق. لم يكن لديّ الوقت الكافي. لكن الآن... الآن أنا نادمة على ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: تفضل، ألقِ نظرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: كأنها مجارف، وليست كفوفًا. كل ذلك من أجل الأطفال.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: ألقِ نظرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: هل ترى هذه التكيسات الضخمة؟ نعم، هذا ما يحدث لك عندما تحرم نفسك من النوم...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: ألقِ نظرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: نفد مزيل العرق منذ فترة. لا تحمّلني مسؤولية ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: أيمكنني الجلوس؟ لا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: هممم. شعر أشعث ومزاج عكر، كالعادة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: لم أنظفهما منذ فترة طويلة. ربما تكونا مسدودتين الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: لقد أوشكت على فقدان سمعي من صراخ الصغار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: لثتي تنزف عندما أنظف أسناني. بدأ ذلك منذ الأسبوع الماضي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: وانظر، ما زالت صفراء. كيف أمنع نفسي عن التدخين في وجود أطفال مثل هؤلاء حولي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: أصاب بطفح جلدي بسبب منتجات التنظيف. لم يتوفر لديّ الوقت لزيارة الطبيب بشأن ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: هذه الأيدي ستعد لك حساءًا لذيذًا إذا سمحت لها بذلك! ومع ذلك، فإن يديك تتجهان مباشرة إلى سلاحك...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: ها. يمكنك أن تفجرني بقنبلة، لكن حتى أجزاء جسدي المتناثرة لن تنعم بنوم هانئ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: ماذا، هل ستطلق النار عليّ لأن رائحتي كريهة؟ يا لها من مزحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: أوه، هل أبدو قبيحة حقًا في الصورة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: لا شك أنك مريض إذا كنت تريد أن تطلق النار عليّ بسبب أذنيّ. ما الذي لا يعجبك؟ سأرتدي قبعة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: أخيرًا، سلام وهدوء... لن يضايقني أحد بعد الآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: ...يا له من أمر مؤسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: أتعلم، أحد أطفالي لديه أسنان مثالية. لكنه لم يبتسم قط. ربما لا يتعلق بامتلاك أسنان جميلة على الإطلاق؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: يداي... استخدمتهما لاحتضان الأطفال، وإنجاز الأعمال المنزلية، وعناق زوجي. ومع ذلك لم يقدّرهما أحد قط.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: عندما يمرض طفلك، لا تنام لأيام. ثم تعتاد على ذلك وتعيش في حالة من اليقظة المستمرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: ذات مرة، كنت متعبة جدًا لدرجة أنني لم أستحم لمدة أسبوع. ولم يلاحظ الأطفال ذلك حتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: أتعلم، وجدت صورة ذات مرة كان فيها جميع أطفالي يبتسمون. كنت أنظر إليها طوال الليل حتى أغفو.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: أحيانًا، أتمنى لو كنت صماء. لكن عندما ينام الأطفال، يسود صمت جميل... وهذا ما تتمناه كل أم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: حقًا؟ هراء... حسنًا، لا بأس، لكن أسرع!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: لا يهمني. ألقِ نظرتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: صفراء؟ لا تهمني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: بيضاء؟ لا عجب أنها بيضاء. فهذه أساسيات النظافة الشخصية، أيها الأحمق!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: قلت لنفسي: طالما ستتلف أسناني، فليكن لي على الأقل سن ذهبي، مثل نجوم السينما.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: بالطبع، لا يهمني على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: ألقِ نظرة على هذه الأسلحة الطبيعية!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: ها. كانت جدتي تقول لي دائمًا إنه مع قبضات كهذه، يجب أن أعمل في قطع الخشب، وليس شيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: لكنني لا أرى أي جذوع أشجار هنا، ويجب أن أفرغ غضبي بطريقة ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: لا يهم. انظر إليهما، إذا كان هذا ما تريده.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: تحب لون عيني الزرقاء، أليس كذلك؟ لم أحتج قط إلى أي شيء آخر لجذب الفتيات. هاه!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: لا أهتم بكل هذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: نعم أزيل شعر الإبطين.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: لا أستطيع تحمل وجود شعر تحت ذراعي. وكأن شجيرة صغيرة قذرة تنمو.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: حقًا أيها الأحمق؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: لماذا تحدّق بي هكذا؟ ماذا رأيت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: تبًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: لماذا تحدّق بي هكذا؟ ماذا رأيت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: هل جننت يا أحمق؟ لقد أظهرت لك أسناني للتو!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: أتعتقد أنني أعجز عن لكمك بهذه اليدين أسرع من سحبك للزناد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: ما خطبك؟ هل أنت غيور أم ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: تحكني هذه المنطقة طوال الوقت، وكأنها تحاول إغضابي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: عندما أحكها حتى تنزف، أشعر بتحسن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: لن أستمع إلى هذا الهراء! لقد جننت تمامًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: أتريد إطلاق النار عليّ بسبب صورة غبية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: كن حذرًا عند التلويح بهذا السلاح الفتاك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: مَن يدري... قد تصيبني عن طريق الخطأ، وكل ذلك بسبب أذني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: أنت مجنون، أتعلم ذلك؟ حسنًا. أرني ما لديك أيها الوغد!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: أيها الوغد. يا لك من حقير عديم القلب.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: سحقًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: كان لجدتي سن ذهبية، وأنا أتمنى مثلها منذ أن كنت طفلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: كانت تلمع وكأن الشمس تشرق في فمها.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: قالت إن طبيب الأسنان وضعه لها بعد تعفن السن القديم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: وقلت لنفسي: "رائع! سيفعلون الشيء نفسه لي عندما يحين الوقت."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: وها قد حان الوقت. ولكن لم يعطني أحدًا شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: والآن، لم يعد فمي يلمع. بل ملوث بصفار الأسنان النتنة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: أترى هاتين اليدين؟ متسختين بالطين والدم وأشياء أخرى. وأنا فخور بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: أحيانًا أشعر بحكة شديدة في يديّ، لدرجة أنني أرغب في تمزيق جلد يديّ. أو لكم الحائط. أو الاثنين معًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: لا أريد أن أؤذي أحدًا. لكنني أعجز عن كبح مشاعري.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: أترى هذه الأصابع؟ متسخة بالطين والدم وأشياء أخرى. وأنا فخور بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: أحيانًا أشعر بحكة شديدة في يديّ، لدرجة أنني أرغب في تمزيق جلد يديّ. أو لكم الحائط. أو الاثنين معًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: لو كنت مكان شخص آخر، لانتابني القلق بشأن ما أفعله بنفسي. لكنني لا أكترث بذلك على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: كانت جدتي تسميني "الملاك البريء" بسبب عينيّ. أنا! "ملاك"! هل تصدق؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: الآن أقف أمامك، أحدق في هذه النوافذ القذرة التي لا روح فيها، وأفكر، "كيف كانت تراني ملاكًا؟"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: أستطيع أن أتخيل بالفعل الطريقة التي ستنظر بها إلى حالي الآن. ستشعر بخيبة أمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: شفرات الحلاقة حادة بما يكفي للقيام... بشيء ما. أتمنى لو كان الأمر بهذه السهولة...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: انتهى بي الأمر بجرح ذراعي. الآن عندما أحلق، أشعر وكأن الشفرة لا تقطع شعري، بل جزءًا مني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: لكنني أحلق على أي حال. لأنني أكره الشعر الذي يشبه الشجيرات القذرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: ليس لديّ حتى صورة لجدتي. لم تكن تحب التصوير.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: قالت لي عندما تلتقط صورة لك، فإن روحك تعلق داخل الصورة إلى الأبد.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: وضحكت كثيرًا على ذلك. وقلت لها: "جديًا يا جدتي، هذا غير منطقي".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: فقالت: "عندما أموت، ستنظر إلى صورتي وتتساءل عما إذا كنت في النعيم".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: والآن... لم يعد لديّ صور ولا جدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: أحيانًا، أجد نفسي أشد شحمة أذني، ولكن فقط عندما تحرقني بشدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: كنت أعتقد أنه تصرف متعلق بالتوتر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: ثم أدركت أنني أريد أن أمزقها، وكأنها تعيقني بطريقة ما...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: لكنني لست مجنونًا لدرجة أن أشوه نفسي، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: أليس كذلك!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: كنت أعلم أن طاقتك ستقاوم يا عزيزي. لكن دعنا نجري فحوصاتك تلك. سأرى ما بداخلك على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: تفضل، ألقِ نظرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: ينعكس عالمنا الداخلي في العينين، وليس في الأسنان. هل ترغب في رؤية مصيرك فيهما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: ينعكس عالمنا الداخلي في العينين، وليس في الأسنان. ما الذي تريد رؤيته فيهما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: تفضل وألقِ نظرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: لكن كن حذرًا، فقد أصبت ببعض الجروح البسيطة أثناء صنع قلادات صائد الأحلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: العينان؟ عيوني بنية بالطبع.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: هذا إذا لم تضع البقع الحمراء في الاعتبار. القمر هو المسؤول عن تلك البقع.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: يضع الكون أشياءً غريبة في طريقي... حسنًا، ألقِ نظرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: من الصعب الاعتناء بنفسك في ظل هذه الظروف...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: كن حذرًا الآن. قد تسبب هالتي الجذابة العمى!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: وما رأيك فيها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: تفضل وانظر، لكن كن حذرًا. فأذناي تسمعان كل شيء، حتى أفكارك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: هل وجدت الإجابات التي تبحث عنها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: هل تريد أن تطلق النار عليّ بسبب أسناني؟ ولكنني لست السبب في ذلك؟ المريخ والزهرة على خلاف!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: لا يمكن أن تكون جادًا. هل ستطلق النار عليّ لأنني أصبت بجروح؟ من قلادات صائد الأحلام التي أصنعها!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: هل جننت!؟ أنت تعلم أن القمر هو الذي يخدعنا، أليس كذلك؟ ليس من السهل تتبع حركته!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: هل جننت!؟ أنت تعلم أن القمر هو الذي يخدعنا، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: هذا ليس علم التنجيم، إنها وحشية! ما رأيك في أن تضع السلاح جانبًا، وسأخبرك بالمزيد من أسراري! مجانًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: لا، من فضلك! ليس ذنبي أنك لم تكن مستعدًا لذلك، يا عزيزي!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: هل يمكنك أن تضع هذا الشيء جانبًا؟ ماذا يمكنك أن تعرف من خلال النظر إلى الأذنين؟ تحتاج إليهما لسماع الكلام الموزون!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: إذا قتلتني، فستصاب بـ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: ...إسهال أبدي!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: أتعلم، جاءني ذات مرة رجل ذو أسنان مثالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: قلت له: "كل شيء على ما يرام، لكن روحك فاسدة!" فكر فيما هو أكثر أهمية. أنت تفهم قصدي، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: ذات مرة قضيت الليل كله في إزالة الشظايا بعد إجراء طقوس. كان ذلك مؤلمًا، لكن كل شظية كانت بمثابة درس من الكون.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: العيون بوابات إلى عالم آخر. رأيت ذات مرة رجلًا عيناه تتوهجان كالجمر. قال إنها بسبب الحب، لكنه كان متوافقًا مع المريخ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: أتعلم، ذات مرة عشت حياة زاهدة لمدة ثلاثة أسابيع. لم أفكر إلا في أحلامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: الأفكار تتحول إلى واقع ملموس، وهكذا تتحقق الأحلام. كل ما كان عليّ فعله هو أن أختار أمنيتي بحكمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: الغريب أنني أجد نفسي أتذكر ذلك الآن، في هذه اللحظة بالذات.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: التقطت صورة لي ذات مرة وقلت: "هذه إشارة من النجوم!" ثم أدركت أنه مجرد وميض الفلاش.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: سمعت ذات مرة صوتًا... كأن الكون كان يحاول التحدث إليّ. لكنني أعتقد أنه كان شيئًا أعظم من ذلك بكثير.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: سمعت ذات مرة صوتًا... كأن الكون كان يحاول التحدث إليّ. لكن اتضح أنه مجرد تيار هواء، ولكنه كان لطيفًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: ما الذي تريد أن تتحقق منه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: هل تريدني أن أريك أسناني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: أسناني دافعت عن الحقيقة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: ...وقد سقطت دفاعًا عنها.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: يمكنك أن ترى ذلك بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: أنظف أسناني بمحلول جعة لطيف. إنه يحمي المينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: لولا ذلك، لفقدت أسناني منذ زمن طويل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: هذا مفهوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: هناك الكثير من الجنون الآن، ومع ذلك نحن صامدون.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: وتستمر حياتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: ماذا!؟ هل جلست في الظل لفترة طويلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: حان وقت الراحة يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: كما تشاء يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: انظر إلى عظمة هذه الأظافر المقدسة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: لقد دربت نفسي على امتصاص أشعة الشمس المفيدة بها.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: وبالطبع فتح زجاجات الجعة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: هل أردت فقط أن تفحصها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: انظر في عينيّ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: إنهما مملؤتان بالغضب والغيظ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: انظر في عينيّ المظلمتين!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: أستخدمهما لامتصاص فوائد الأشعة الصالحة، وتحويلها إلى طاقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: أحصل على كل طاقتي من خلال عينيّ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: هل رأيت قوة الشمس الصالحة في عينيّ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: إذا لم ترها، فأنت أعمى. حاول أن تحدق في الشمس لفترة أطول، مثلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: أتريد التقاط صورة لي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: هممم... هممم...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: هل أخبرك أحد أنني قابلت الزعيم الشمسي بنفسه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: نعم، لقد علمته كيف ينظر إلى الشمس المقدسة، لكنني سأخبرك عن ذلك لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: تفضل. التقط صورتي المقدسة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (تلتقط صورة للرجل الفوضوي.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (كما في حياته، تظهر الصورة أنه مهمل وقذر.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (لا تلاحظ أي تشوهات.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: هذا عظيم! يسرني ما آلت إليه الأمور!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: تعال لرؤيتي لاحقًا، وسأخبرك بكل شيء عن حياتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: ...مقابل رسوم رمزية، بالطبع.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: والتي سأنفقها في جمع طاقة الشمس!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: هيا، أطلق النار! الحقيقة ستحميني!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: هل ستضع سلاحك جانبًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: الأمر صعب جدًا من دون كأس جعة في يدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: صعب جدًا جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: لماذا علينا فعل هذا أيها البشري؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: لقد جننت أيها الجاهل!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: يقولون إن العين بالعين، لكنهم سيطلقون النار عليك مقابل عينين...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: مهلًا، مهلًا، أنت تتسرع قليلًا في هذا القرار!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: انتبه إلى أين توجه هذا الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: انتظر، ألا تعجبك يداي المقدستان؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: لمَ لا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: أنت أحمق، وجاهل، وأنا أريد بعض الجعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: "لا تركز في شؤون الآخرين".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: ماذا عليّ أن أفعل؟ هل أدير نظري إلى الأبد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: آه، مهلًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: هل كانت "الأنف السبب...؟"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: لحظة واحدة...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: لا يهمني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: هذا صحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: لن تجرؤ على إطلاق النار على الشمس!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: لكن لا تقلق عليّ. لا أشعر بالإهانة من مثل هذه الأفعال الحمقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: طالما لديك احتياطي وفير من السائل البارد الضروري للحياة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: آه، أنت محب للمقالب، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: حسنًا، شمها إذا كان هذا ما تريده.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: هذه نتيجة العناية الشخصية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: آه، أنت محب للمقالب، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: حسنًا، شمهما إذا كان هذا ما تريده.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: هذه نتيجة أشعة الشمس المانحة للحياة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: من خلال أشعتها المقدسة ينطلق سائل الحياة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: ما الذي تريد فحصه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: مهلًا، ماذا... ستتخذ قرارك بناءً على أسناني؟ حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: لقد عالجت أسناني للتو.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: لكن، بصراحة...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: لا أستطيع أن أتذكر حقًا أنني ذهبت لطبيب الأسنان. هل ذهبت فعلًا من قبل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: يا إلهي، أنا متوترة للغاية، لا أستطيع حتى أن أتذكر ما إذا كنت قد أكلت أمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: إذن... هل أنا متوافقة مع الأوصاف السليمة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: أنا زائرة؟ كيف؟ كيف!؟ هذا مستحيل!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: يا إلهي، لقد طردوني من منزلي، وفصلوني من وظيفتي، والآن سأفقد عقلي...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: هل تريد أن تفحص أظافري؟ هذا أغرب شيء قد تفحصه...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: لكن لا بأس... ألقِ نظرة...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: ماذا يوجد عليها؟ أوساخ؟ مستحيل...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: أنا... لا أتذكر أنني حفرت في التراب على الإطلاق...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: كيف وصلت كل هذه القذارة تحت أظافري؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: لا يمكن أن أكون قد تجولت وأنا بهذه القذارة كل هذه المدة. أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: يا له من أمر غريب.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: هل يمكنك أن تتخيل؟ ليس لديّ أدنى فكرة عن مصدر هذه الأوساخ. لقد كنت جالسة في مكاني، في بيتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: هل... هل وضع أحدهم هذه الأوساخ تحت أظافري عمدًا؟ مَن قد يفعل ذلك!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: هل تريد أن تفحص عينيّ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: يمكنني تخيل ما ستراه...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: ماذا يحدث إذا ظهرت عليّ إحدى هذه الأعراض؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: نعم، حسنًا. لا أحد مندهش من ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: هل أنا حقًا زائرة؟ ما رأيك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: ولماذا لا أعرف شيئًا عن ذلك؟ هل هكذا يتحول الناس إلى زوار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: ربما يكفي أن تعتقد أنك لست مثل الآخرين... وأن المجتمع يكرهك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: أنا خائفة من الموت...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: مهلًا، هل يمكنك تغطية عينيّ؟ هل لديك ضمادات أو شيء من هذا القبيل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: أو... أو... دعني أعيش وقتًا أطول قليلًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: إذا تبين أنني زائرة، فهل سأبدأ في قتل الناس؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: هل سأصبح خطيرة على المجتمع؟ ... أم أنني كنت كذلك دائمًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: ربما قتلت أشخاصًا بالفعل!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (تلتقط صورة لها.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (عندما تتضح الصورة، ترى جسمًا ضبابيًا وخلفية واضحة.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (وكأن الشخص ارتجف عندما التقطت الصورة.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: هاهاها، هل تتخيل ذلك؟ لقد ارتجفت للتو.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: أممم... ماذا سيحدث الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: هل يمكنك أن تدعني أعيش؟ أم أنه من الأفضل أن تقتلني؟ ماذا ستفعل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: ألن يكون من الأسهل أن تطلق عليّ النار فحسب؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: أريد أن أرحل، لكنني خائفة جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: ربما...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: لا... لا أعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: إذا أطلقت عليّ النار، هل سأتحول إلى شيء أكثر فظاعة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: ربما يجب أن أهرب...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: أنا... لا أعرف إن كنت ما زلت بشرية أم لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: ماذا يُفترض أن أفعل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: مثل أولئك الزوار في بيتي...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: ...آسفة، لقد كانت تجربة مروعة. سأريك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: هل أنا بشر؟ هل أنا كذلك؟ أخبرني أنني من البشر، أرجوك! أرجوك!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: هاهاها! لماذا طلبت أن ترى إذا كنت ستسحب سلاحك على أي حال؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: هل تستمتع بإذلال الناس؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: يا له من كابوس... لا يمكنك أن تشعر بالأمان في أي مكان...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: في يوم من الأيام، قد يقتحم الزوار منزلك. وفي اليوم التالي، قد يقتلك مجنون بسبب إبطيك...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: لماذا لا يستطيع أحد أن يقول إن كل شيء سيكون على ما يرام!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: هذا كل شيء؟ هذا كل ما يتطلبه الأمر ليصبح المرء زائرًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: رائع. جسدي يخونني مرة أخرى...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: أعلم ذلك... الأمر برمته معقد. لهذا السبب كانوا يخافون مني في العمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: ذهبت إلى المستشفى الأسبوع الماضي بسبب ظهري... على ما أعتقد.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: هل... هل ذهبت إلى طبيب الأسنان أيضًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: وكم أنفقت...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: ما الذي تريد فحصه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: هل تريدني أن أريك أسناني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: حسنًا، انظر. استنشق رائحة الحزن والدخان.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: صفراء بوضوح، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: ابتعد عني بهذه الفحوصات التافهة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: لستُ زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: من أين أتوا أصلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: الأظافر المتسخة علامة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: يمكنهم غسل أيديهم بكل بساطة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: هل تعني أن البستاني سيصبح زائرًا تلقائيًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: هذا غير منطقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: تفقّد أظافري.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: ما النتيجة؟ هل أنا زائر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: لا أعتقد ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: كل يوم أكثر سخافة من سابقه.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: ماذا لو لم أنم؟ أو كنت أبكي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: لم أعد أفهم كيف تسير هذه الفحوصات على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: وماذا ستفعل إذا تأكد ذلك من خلال علامة واحدة؟ أو عدة علامات؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: سأصبح زائرًا الليلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: سأبكي بتذكر الأيام الخوالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: كل هذه الفحوصات للكشف عن العلامات، والرجال الذين يرتدون بدلات صفراء...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: كلها...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: ...أمور غير منطقية بالمرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: هل شعرت يومًا أن كل شيء يحدث يقودنا إلى نوع من الجحيم المرعب؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: كل شيء يبدو تحت السيطرة، لكن الفوضى تعم كل مكان حولنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: حسنًا، التقط صورتك التافهة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (تلتقط صورة له.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (إنه جالس بهدوء، ولا يظهر بالكامل في الإطار، لكنك لا تلاحظ أي شيء غير عادي.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: أنا خائف جدًا مما سيحدث بعد ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: هل أنت جاد؟ هل أنت أحمق؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: هل أفسدت الوكالة الفيدرالية عقولكم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: أم أنك ثمل؟ اعتقدت أن كل المشروبات القوية قد نفدت بالفعل...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: حسنًا، بما أنك سألت، سأريك!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: هل حصلت على ما تريد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: هل شممت ما تشاء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: شكرًا لأنك لم تفحص مكانًا آخر!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: أنجز ذلك بسرعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: اممم... حسنًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: هل انتهيت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: هل يمكنني أن أحظى ببعض الهدوء والسكينة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: الأيدي...؟ لحظة واحدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: تبدو مرهقة من حمل الشخص الذي رفضوا إنقاذه.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: هل يمكنك التوقف عن مطالبتي بفعل هذا الهراء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: إذا كنت تريد أن تطلق عليّ النار لهذه الدرجة، فافعل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: لم أعد أقوى على ذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: ما الذي تبحث عنه؟ احمرار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: إذا كان ذلك ضروريًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: إذا أظهرت أي عاطفة، فهل هذا يعني أنني زائرة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: هل يمكننا أن نكون صريحين بشأن ما يحدث؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: لا يمكنك أن تكون سعيدًا، ولا يمكنك أن تبكي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: لا يمكنك التحدث باستمرار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: ماذا تبقى؟ الجلوس والنظر بين يديك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: هل سينتهي الأمر بهذه السهولة حقًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: هل ستنتهي المعاناة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: لكنني لم أنقذك...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: حقًا؟ ألا يبدو ذلك مهينًا في رأيك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: لم يساعدني أحد في إنقاذ زوجي، والآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: تريد أن تخلد ذكرى وفاته؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: لساني يعجز عن الكلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: افعل ما تريد واتركني وشأني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (تلتقط صورة لها.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (لا تلاحظ أي شيء غير عادي.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (يظهر الرجل الميت في الإطار، ما يجعلك تفكر في الحياة.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: هل أنت سعيد الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: لطالما أحب أسناني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: لكنني كنت أرغب في تركيب تقويم أسنان.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: بالتأكيد. لماذا لا تطلق النار عليّ، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: هل يستطيع الناس البكاء في هذا العالم الجديد؟ لأنهم بالتأكيد لا يستطيعون الضحك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: هل أنت مجنون؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: أخبرني من فضلك، هل أنت مجنون!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: إذا طلب منك هؤلاء الأشرار القفز من فوق جرف، هل ستكون أول من يقفز؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: أيها الـ... اللعنة... لا أجد الكلمات.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: ماذا الآن؟ من الأفضل أن تخرج سلاحك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: اللعنة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: اسحب الزناد وحسب. الوكالة الفيدرالية قتلت روحي بالفعل. ويمكنك أن تقضي على ما تبقى مني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: لم أعد أفكر في تقويم الأسنان بعد الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: كنت قد نسيت كل تلك الرغبة حتى طلبت رؤية أسناني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: يا إلهي... أنا مرهقة للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: أفرغ غضبي على كل من حولي. لكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: هذا ليس خطأ أحد. لا أحد باستثناء عدد قليل من الأوغاد.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: لا أستطيع أن أفهم ذلك. ولا أريد أن أفهمه.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: إذلال شخص فقد للتو...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: لحظة واحدة...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: أوه. إذن أخرجت سلاحك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: ولم تكن لديك حتى الشهامة لتقتلني في النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: ما كان كل ذلك؟ تعبير عن عدم ثقتك بنفسك؟ لا داعي لإظهار ذلك بهذه الطريقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: ما الذي تريد فحصه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: يمكنني أن أريك أسناني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: كان صديقي طبيب أسنان.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: خمّن ماذا حدث؟ لقد كسروا أسنانه من فرط الضرب! هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: أوه، تريد رؤيتها. حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: كل شيء سليم، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: ماذا تفعل يا صاح؟ كانت قصة عادية تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: لكن أن تفجر وجهي بسبب أسناني... لا أفهمك على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: أرجوك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: هل أنت مجنون؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: سحقًا لك أيها الـ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: ماذا تفعل؟ أنا شخص طبيعي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: لا أفعل أي شيء بأظافري، أترى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: لا تسيئ فهمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: أغسلها عادة. لكن اسمع، لقد رأيت مؤخرًا عملة معدنية على الأرض فالتقطتها. حسنًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: إنها نظيفة. سأغسل يدي اليوم يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: أغسلها عادة يا صاح. لكن لم يكن لديّ الوقت لفعل ذلك اليوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: إنها نظيفة... في الغالب.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: هل ستقتل رجلًا بسبب أظافره المتسخة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: يا رجل. لم أكن أعتقد أنني سأموت بهذه الطريقة الغبية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: تبدو طريقة غريبة للتعرف على هؤلاء المجانين. هذا غريب جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: يمكنك التعرف على الحمقى والأغبياء من خلال أيديهم. لكن الزوار؟ لا، يا رجل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: يجب أن تستيقظ في الساعة 9 صباحًا وتعمل لمدة 4 ساعات تقريبًا. لكن لا يمكن أن أكون هذا الشخص.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: أشعر بحكة قوية في عيني في الآونة الأخيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: هل تعتقد أن السبب هو الشمس؟ هذا مريب بعض الشيء، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: هذا مخيف يا صاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: إنه نوع من الأمراض المعدية أو شيء من هذا القبيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: اسمع، لديّ خطة مُحكمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: لنقل إننا سنطلق النار على الناس... ثم يدفعون لنا لكي لا نفعل ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: ماذا؟ بحقك يا رجل، الأمر ليس بهذه الجدية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: لا بأس، إذا كنت لا تحب المخاطرة، فأنا أتفهمك. لكنني أعاني من مشكلة في عيني يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: لو كان لديك قطرات للعين...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: لم أكن لأشتريها. لديّ أسبابي الخاصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: هل تريد التقاط صورة؟ حسنًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: دعني أخبرك يا صديقي، لديّ حساسية شديدة للضوء. قد أنتفض.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (تلتقط صورة له.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (الصورة تبدو طبيعية، لكن وجهه...)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (يبدو ضبابيًا جدًا.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: أخبرتك يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: أتريد إعادة التقاطها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: لا تحاول أن تخدعني يا أخي، عليك أن تتصرف حيال هؤلاء الحمقى.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: عليك ضبط سلوكهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: وإلا فإنهم سيسترخون وينسون في أي بيت يقيمون، ولن يدفعوا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: مهلًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: تبًا لك ولبيتك. سأرحل عن هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: سأقف تحت أشعة الشمس الحارقة. عُد إلى ضميرك الآن أيها الأحمق.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: ماذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: لقد اخترت أمرًا غريبًا هذه المرة أيها الأحمق.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: ولكن أنت صاحب البيت...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: ما النتيجة إذن؟ كل شيء سليم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: دعه وشأنه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: انتظر، مهلًا! اللعنة، ذات مرة جربت الحلاقة وقررت الاستمرار في ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: لكن هذا بيني وبينك. أنت لست واشيًا، أليس كذلك؟ أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: أوه...! هذا ليس لطيفًا يا أخي! هذا مثل طلب صور محرجة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: بالطبع رجل أنيق مثلي لن يكون لديه إبطان متسخان، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: أطلق النار عليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: استمع إليه
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: كنت أعرف أنك شخص صالح. لن تقتل شخصًا عاديًا بهذه البساطة، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: لماذا لا نضغط على هؤلاء الحمقى المقيمين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: لا؟ حسنًا. في وقت آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: أعلم أنك تشعر بالتوتر بسبب الزوار وما إلى ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: وأنك تفعل كل هذا من أجلنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: على أي حال، لا أحمل لك ضغينة. صدقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: ما الذي تريد فحصه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: أسناني؟ هل تريدني أن أريك أسناني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: لماذا؟ لا أزال أملك بعض أسناني اللبنية. أبي قال...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: لن أبكي بعد الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: ها نحن ذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: ماذا يعني ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: هل أنا سليمة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: أستطيع قص أظافري بنفسي الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: لستُ خبيرة في ذلك بعد...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: انظر. أترى!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: جميلة، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: لقد قصصتها بنفسي. أنا من فعل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: سأذهب. أريد أن أكون وحدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: هل ستنظر في عيني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: هل سترى ما أفكر فيه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: في هذه الحالة، سأحرص على التفكير بحرص، لا تقلق.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: لماذا تنظر هكذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: هل رأيت شيئًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: أنت... *تبكي*.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: أريد أن أشرب.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: اممم... ماذا عليّ أن أفعل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (تنظر إليها وتدرك أن هذا مبالغ فيه.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: هل تريد فقط أن تعرف كيف حالي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: أنا متعبة جدًا. هل يمكنني أن ألعب وحدي الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: صورة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: لم يُلتقط لي كثير من الصور.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: هل ستريني إياها بعد التقاطها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (تلتقط صورة لها.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (الصورة تظهر ضبابية قليلًا.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (ركضت نحوك دون أن تنتظر حتى تنتهي من التقاط الصورة.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: هممم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: ...شكرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: لا تعجبني. لا تطلب مني المزيد من الصور.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: حسنًا، تفضل وافحص يا عزيزي. لن ترى شيئًا لم تره من قبل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: أسناني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: آآآهه.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: أتعلم، هذه الأسنان العجوزة... كنت أكرهها. كنت أفكر في خلعها كلها.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: انظر إلى أصابعي — لا يمكنها العد أو التكديس أو القياس بشكل صحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: إنها تعطيك ما يكفيك فقط.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: يا عزيزي... هل أنت متأكد أنك تريد ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: العيون مثل النوافذ. للضوء في المنازل، وللحقيقة في البشر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: لكن نوافذي غائمة... والزجاج مكسور... وقد أكل العث الستائر منذ زمن طويل...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: لا تنظر يا عزيزي. لا يوجد شيء هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: ستجعل امرأة عجوز ترفع ذراعيها... ألا تشعر بالخجل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: ماذا يمكنني أن أفعل؟ أنت مالك البيت في النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: هل انتهيت يا عزيزي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: لماذا تضيع فيلمًا ثمينًا على عجوز مثلي؟ الأفلام نادرة هذه الأيام... هل أنت متأكد؟ حسنًا، كما تحب.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: ما رأيك يا عزيزي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: يا لها من فكرة رائعة يا حبيبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: إنهما عاديتان للغاية. وسمعي موجود. لكن أتعلم... أحيانًا، أشعر بدوار ودوخة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: وكأنني لا أستطيع أن أرى إلا من خلال نافذة سقفية، وحتى ذلك ليس دائمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: لماذا توجه هذا الشيء القديم نحوي يا عزيزي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: أنا على وشك الانهيار بالفعل، وتريد أن تجعلني عاجزة عن الكلام بلا أسنان أيضًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: هل تعتقد أنني خائفة يا عزيزي؟ خائفة من فقدان هاتين اليدين العجوزتين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: لقد أمسكت بالهواء مرات عديدة لدرجة أن أصابعي نفسها تعلم أنني لم أعد قادرة على الإمساك بأي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: إذن، هذا ما آلت إليه حياتي...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: لا تصدقني؟ تريد أن تتأكد؟ حسنًا، انظر...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: كنت أنظر في عيون الناس مثلك. هذا يذكرني بالماضي...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: حسنًا يا عزيزي، إنها علامة الشيخوخة. كل من يحالفه الحظ في أن يعيش طويلًا يحصل على هدية كهذه. ألم تعلم ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: الفطر لا يشعر بالألم. لا يطلب الطعام. إنه موجود وحسب. يعيش من أجل العيش. مثلي، فيهيهي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: يا له من أمر مزعج، هل ستنفجر غضبًا بسبب هذا أيضًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: ما هذا يا عزيزي؟ هل يمكنك استنتاج شيء من خلال النظر إلى أذنيّ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: لا أمانع. ماذا يهمني في ذلك يا عزيزي؟ كنت أرغب في رؤية نهايتي منذ وقت طويل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: كل ما في الأمر هو...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: أنني دفعت لطبيب لينتهي من الأمر ويزيلها كلها، لكنه لم يستطع إزالتها كلها دفعة واحدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: كنت أزوره لخلع سن أو اثنين في كل مرة... لم يكن ممكنًا خلعها جميعًا. الأطباء مشغولون جدًا لهذا الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: لذلك يا عزيزي، ها أنا ذا، مع كل هذه الأمور المزعجة في فمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: الأيدي مخصصة لمن يمسكها. ولم أحظَ بهذا الشرف منذ سنوات عديدة يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: أمد يدي؟ هه! يمكنك أن تمد يدك بنفسك، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: إلى كوخ الكاذب ذي الستة أصابع... تعال، وادخل القفص الضيق...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: هل تعتقد أنك تستطيع الهروب من هذا المصير؟ هذا سيحدث فقط إذا مت شابًا. لكن لا تفكر في أي أفكار الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: يا له من وجه شاب جميل! لا يمكننا أن ندع شيئًا كهذا يضيع هباءً!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: في شبابي، كان الأغنياء فقط يمتلكون مثل هذه الأدوات. ولكن الآن، أي أحمق عجوز يمتلك واحدة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: لن أتكلم أكثر من ذلك! بعد كل هذه التصرفات السخيفة وإزعاج الناس الطيبين دون سبب وجيه!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: لا تعذب أختي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: جينات الأسنان القوية تسري في عائلتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: عندما كنت مراهقة، حاولت حتى فتح زجاجة جعة بها.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: لم ينتهِ الأمر على خير. لكنه علمني أن أعتني أكثر بما لا يمكن تعويضه.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: أختي ليست في حالة تسمح لها بالاعتناء بنفسها في الوقت الحالي. لذا، فأنا دائمًا مشغولة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: وكيف يجب أن تبدو أيدي البشر عندما تكون مسؤولة عن حياة شخصين في آنٍ واحد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: نعم، أختي تبكي كثيرًا، لكن عيوننا لا تزال متشابهة جدًا. ربما تكون عيناها أكثر هدوءًا قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: ...هذا يقلقني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: نعم، أختي تبكي كثيرًا، لكن عيوننا لا تزال متشابهة جدًا. أعني أنها ليست حمراء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: ربما تكون قد بكت كل دموعها بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: سأريك. لكن أرجوك لا تزعج أختي، اتفقنا؟ إنها متعبة جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: عادة ما أحلق شعر الإبطين. فأنا دائمًا أحاول الاعتناء بنفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: حتى في هذه الأوقات العصيبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: عادةً ما أعتني بنفسي، لكنني لم أحضر معي ماكينة حلاقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: ليس هناك وقت لذلك على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: لقد عانينا أنا وأختي بما فيه الكفاية. أرجوك، ضع هذا السلاح جانبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: بدأت أدخن مؤخرًا... بسبب أشخاص مثلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: هل تعتقد أنك الوحيد الذي يمر بظروف صعبة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: هل تعتقد أنه يمكنك سحب سلاحك على من تشاء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: ما الأمر؟ هل بدت نظراتي سريعة أو غير واضحة لك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: ما الأمر؟ هل بدت نظراتي غير واضحة لك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: هل تعتقد أنك مختلف؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: يجب أن تهدأ، لا تكن مندفعًا هكذا. هذا ما أقوله دائمًا لأختي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: من المؤسف أنني يجب أن أخبرك بذلك أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: انتظر. هل قالوا في الأخبار حقًا إن الزوار لديهم هذا النوع من الإبطين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: فكر بتمعن. لا تفعل شيئًا غبيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: هكذا إذن تنتهي قصة حياتي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: نهاية كان يُفترض أن تكون حلوة مرّة... لكن لم يبق سوى المرارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: لطالما كانت الحياة تختبر قوتنا. كان كل شيء صعبًا للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: أختي لم تستطع تحملها. فاستسلمت.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: أتفهم موقفك. لقد وُضعت في موقف صعب.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: ولكن إذا استسلمت للذعر، فهل ستكون مختلفًا حقًا عن الزوار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: ماذا كنت تتوقع أن يحدث حين تعزل نفسك عن الآخرين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: لقد سئمت هذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: أريد أن آخذ قسطًا من الراحة وأتوقف عن العيش في خوف دائم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: لكن كل يوم لا يختلف عن سابقه، ولا يبدو أن هناك نهاية في الأفق.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: بكل صراحة، أنا مرعوبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: ماذا سيحدث بعد ذلك؟ هل سيختفي الزوار، أم أننا سنضطر إلى مشاركة حياتنا معهم إلى الأبد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: افعل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: الأسنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: اليدان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: العينان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: الإبطان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: صورة
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: الأذنان
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: ألقِ نظرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: هل ستضربني وتكسرها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: أختي تساعدني.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: ولكن هذا لا يهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: كان عليها أن...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: كان عليها أن تتركني أموت في ذلك الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: أنا وأختي لدينا عيون متشابهة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: ...لكن عينيها ليستا فارغتين من المشاعر تمامًا كعينيّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: أختي تحلق لي شعر إبطي. إنها تعتني بي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: أعتقد أن جهدها لم يذهب سُدى.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: اسحب السلاح
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: هذا أفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: اقتلع روحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: لا داعي لهذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: الموت قريب مني على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: يمكنك أن تترك الأمر لي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: أعطني السلاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: سأقتل نفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: عندما أغمض عيني، لا يزول الشعور بالفراغ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: ...سينتقل لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: أهذا ما تريده حقًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: ما الأمر يا عزيزي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: هل ستسحب الزناد أم ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: استمع إليها
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: ألا تملك الشجاعة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: ستموت على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: يا خسارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: ربما في المرة المقبلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: يا خسارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: ليست لديّ أي علامات.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: ربما في المرة المقبلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: ماذا لو كنا نستعد لكي يبتلعنا ثقب أسود؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: سننجذب ونتمدد على طول أفق الفضاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: ولن نشهد زوالنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: بل نشهد العذاب الأبدي وتوقع الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: لا يهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: سأنتظر حتى يحين وقتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: أغنيتي...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: كانت لك!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: وكانت نهايتها سعيدة!'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733824
    m_Localized: 'Firefighter: ...'
