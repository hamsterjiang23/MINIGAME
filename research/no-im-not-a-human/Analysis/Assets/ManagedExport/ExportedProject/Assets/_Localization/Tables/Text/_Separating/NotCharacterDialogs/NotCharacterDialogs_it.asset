      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: La tariffa del consulto verrà addebitata sul conto associato al suo account.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: Una tariffa?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: Credevo che la chiamata fosse gratuita.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: Esatto. Dopotutto, i nostri specialisti della rimozione Visitatori non possono lavorare gratis.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: Come giudica il servizio ricevuto oggi?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: Cinque stelle!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: Un uno su dieci.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: Vaffanculo, ecco come!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: Se avesse guardato con attenzione l''annuncio, saprebbe che la chiamata iniziale prevede un piccolo costo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: Come giudica il servizio ricevuto oggi?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: Cinque stelle!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: Un uno su dieci.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: Vaffanculo, ecco come!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: Grazie. La sua opinione è molto importante per noi. Arrivederci.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: Per ora è tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: Disponibile con la consegna a domicilio ForRest. Chiama ora il numero {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: Buon pomeriggio, e benvenuti al notiziario.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: 'TV: Mentre divampano gli incendi, i Visitatori continuano a terrorizzare la nazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: La FEMA ha annunciato un nuovo segno per aiutare i cittadini a identificare i Visitatori...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: A seguire, uno speciale su chi siano realmente i Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: Eh? Sì? Chi è?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: Tua moglie mi ha dato questo numero.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: Tua moglie ha bisogno di aiuto.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: Ah‑ah... E quindi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: Non trova più i bambini.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: I bambini sono con te?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: La solita solfa. Tocca sempre a me sistemare i suoi casini.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: Non fa altro che piagnucolare e ripetermi quanto è stanca.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: Niente di nuovo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: Non trova più i bambini.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: I bambini sono con te?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: Già, come al solito. Dei suoi figli non le frega niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: E indovina chi deve metterci una toppa? Sempre io. Figuriamoci...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: Hai controllato a casa di sua madre?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: Potresti venire a prenderla?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: No. Perché, non sono con lei?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: Non mi sorprende.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: Hai controllato a casa di sua madre?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: Potresti venire a prenderla?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: Ah‑ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: Beh, forse sono lì.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: Io non ci vado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: Se la sbrighi lei. Chiedile che razza di madre perde i propri figli...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: Risolvete la faccenda tra di voi.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: Comunque, le dirò che stai bene.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: Cos''è, la principessa non può muoversi? Può andarci da sola a casa della madre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: Le gambe le funzionano, no? Quindi che problema c''è?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: Risolvete la faccenda tra di voi.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: Comunque, le dirò che stai bene.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: Allora perché hai chiamato? Vuoi fare l''eroe con la damigella in difficoltà?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: Fai come vuoi. Tanto quella è una stronza indifferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: Lasciatemi in pace, cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: 'Phone: Comunque, le dirò che stai bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: Non sprecare il fiato. A che servirebbe?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: Ce ne freghiamo altamente l''uno dell''altra.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: Perché ti interessa tanto? Chi te lo fa fare?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: Come vuoi. Tanti auguri, a tutti e due.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: Dimmi, credi nella Morte?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: È stato tuo marito a dirmi di chiamare.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: Non ho chiamato per una predica. Si tratta di tuo marito.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: Cosa? Mio marito?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: Dopo tutto quello che ha fatto... non voglio neanche sentirlo nominare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: Mi ha chiesto di dirti che è pentito per ciò che è accaduto.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: Mi ha chiesto di dirti di andare all'inferno.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: Mio marito?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: Dopo tutto quello che ha fatto... non voglio neanche sentirlo nominare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: Mi ha chiesto di dirti che è pentito per ciò che è accaduto.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: Mi ha chiesto di dirti di andare all'inferno.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: Eh? Che cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: Di nuovo? Sul serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: Non sei il primo che manda a chiedere scusa, lo fa sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: Vuoi sapere come mai non è lui a chiamarmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: Perché è un codardo. Non ha il coraggio di affrontare le sue responsabilità.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: Spera ancora di poter rimediare, ma la vita non funziona così. Non è possibile tornare indietro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: Ora sto bene. Ho trovato delle persone che mi capiscono.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: Credi sul serio che quei pazzi ti comprendano?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: Perché ti sei unita a una setta?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: Se lo dici tu.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: Chiamali come vuoi. Adesso sono loro la mia famiglia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: Condividiamo la stessa fede. Sappiamo che la Morte è vicina.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: E che non porterà dolore, ma pace.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: Buona fortuna.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: Condividiamo la stessa visione sul futuro. L''arrivo della Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: Ti sembrerà assurdo, lo capisco. Ma la Morte porta gioia, non sofferenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: La felicità è pace, assenza di dolore. Di sicuro, anche tu avrai sofferto molto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: Forse un giorno capirai, e inizierai a vedere il mondo attraverso i nostri occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: Buona fortuna.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: Grazie per aver capito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: Buona fortuna.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: Pronto? Chi è?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: Salve. Tuo fratello mi ha dato il tuo numero.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: Chiamo per conto di tuo fratello.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: Fratello? Ma io non ho...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: Ah, intendi il figlio di mio padre, giusto?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: Un momento... Ma tu chi sei? E cosa ci fa lui con te?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: I suoi genitori sono scomparsi.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: È venuto da me in cerca di un riparo.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: Scomparsi? Com''è potuto succedere?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: Non vorrai dire che loro...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: Dannazione... Non è possibile... Sono morti?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: Non lo so.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: È probabile.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: Un riparo? Ma lui vive con i suoi genitori, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: No, ti prego. Non dirmi che loro...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: Dannazione... Non è possibile... Sono morti?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: Non lo so.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: È probabile.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: Dio mio... Com''è potuto succedere?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: Digli che se vuole può stare da me. Sa dove vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: E... grazie per averlo aiutato.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: A presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: Sì? Chi è?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: Tua moglie e sua sorella sono qui con me.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: Tua moglie mi ha dato questo numero.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: Dal tono, sembra quasi che tu voglia chiedere un riscatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: Ma temo di non avere più nulla da dare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: E comunque, presto non ci sarò più.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: In che senso? Che ti succede?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: Tua moglie è al sicuro.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: Ti prego, dimmi che lei sta bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: È una donna forte, sa come cavarsela ed è sempre pronta ad aiutare il prossimo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: Ma per me... è troppo tardi. Ormai nessuno può aiutarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: Non mi resta più molto tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: In che senso? Che ti succede?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: Tua moglie è al sicuro.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: Io... non ce la faccio più. Il sole, i Visitatori... è un incubo. Sono paralizzato dal terrore.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: Voglio solo che questo strazio finisca, ed esiste una sola via d''uscita... Mi capisci?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: Per favore, dille che la amo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: Anzi... no, non dirle niente. Assicurati solo che non venga a cercarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: Non deve sapere che ho lasciato questo mondo senza di lei...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: Grazie per aver chiamato... E per avermi ascoltato.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: Addio...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: Starà ancora proteggendo sua sorella. Non è mai stata capace di abbandonare le persone...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: Poverina, sempre circondata da deboli e falliti. È per questo che ho deciso di lasciarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: Salve, qui l''ufficio ammissioni FEMA. In cosa posso esserle utile?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: Ho qui la moglie di un vostro agente.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: C'è un'altruista che vorrebbe lavorare per voi.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: Ok... Qual è la richiesta? Non ho ancora capito cosa posso fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: Ammesso che non si tratti di una minaccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: È una minaccia.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: Vuole unirsi a voi, ha già prestato servizio alla frontiera.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: (Senti la persona al telefono sospirare profondamente)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: Tu sei uno di quegli attivisti, giusto? Sempre a lamentarvi di qualcosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: Non sprecare il nostro tempo. Lascia la linea libera per chi ha davvero bisogno di aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: Mentre parli, un Visitatore potrebbe assalire qualcuno, o peggio. Morirà gente per colpa tua.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: Uhm... È consapevole che questo è un lavoro difficile? Ne è sicura?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: Se lo è, riferiscile di compilare il modulo 31‑G in triplice copia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: Poi dovrà superare la visita medica, quindi firmare...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: (Riattacchi. Perché ti stai dando da fare per questa donna?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: Per quale posizione si candida? E per favore, non dire "direttore".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: Saresti il terzo, oggi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: Direttore.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: Addetta al rilevamento. Insomma, per le ricognizioni.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: Ne ho abbastanza di questi scherzi idioti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: Mentre ti diverti, i Visitatori stanno ammazzando qualcuno. E sarà solo colpa tua.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: Vedi di crescere e falla finita con queste stronzate.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: (Ha riattaccato. Sul serio?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: Non cerchiamo ricognitori. Ci servono esperti di epidemie e scienziati qualificati.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: La tua amica non ha il curriculum adatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: Ma al diavolo, sai che c''è? Le cose cambiano in fretta. Riprova tra una settimana.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: Vedrai che troveremo un posto per... come l''hai chiamata? Una "altruista".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: La mela è composta da sopramela, terra dei funghi e carta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: State attenti a... dei fun...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: Anche se vi attir... il campo sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: Colui che... vi trover...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: Solo pianto e commiato.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: Controlla se respira.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: Perché non rispondi? Voglio morire.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: (Ha riattaccato... Non è andata come ti aspettavi)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: La informiamo che al momento non è possibile raggiungere il nostro paese in aereo o in treno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: Come posso aiutarla?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: Devo rimandare a casa un turista.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: Perché non si può con il treno?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: Le conviene attendere che riprendano i collegamenti aerei.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: I traghetti sono attivi, ma è pericoloso. C''è un elevato rischio di tifoni notturni.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: Inoltre, l''acqua riflette la luce solare sulle navi e rende il viaggio insostenibile per l''equipaggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: E come faccio a rimandare a casa questo poveraccio?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: Ora vive con me. Forse potreste accoglierlo voi?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: Il calore ha deformato i binari. Di giorno, i treni non possono circolare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: Si può viaggiare solo di notte, per tratte brevi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: Troppi cambi. Meglio aspettare che i voli vengano ripristinati.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: E come faccio a rimandare a casa questo poveraccio?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: Ora vive con me. Forse potreste accoglierlo voi?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: Non resta che aspettare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: Ci dispiace, ma per ora non c''è altro che possiamo fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: Non parla neanche la nostra lingua.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: State scherzando? Siete inutili!
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: Non ci sono alberghi disponibili.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: Non possiamo farci nulla. Stiamo lavorando al problema, ma molti altri sono nella sua stessa situazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: Non parla neanche la nostra lingua.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: State scherzando? Siete inutili!
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: Senta, il nostro personale è sommerso di lavoro. Dopo i recenti tagli al budget, le ambasciate non hanno risorse.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: Stiamo facendo tutto il possibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: Oh, wow, siete dei veri eroi.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: Detesto gli scansafatiche.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: Non c''è bisogno di usare questo tono.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: Non possiamo assumercene la responsabilità. Se ci tiene tanto ad aiutarlo, se ne occupi personalmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: Il nostro budget è estremamente limitato. Andiamo avanti solo con la forza di volontà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: Oh, wow, siete dei veri eroi.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: Detesto gli scansafatiche.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: Beh, se non le piace come lavoriamo, si arrangi da solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: Buona fortuna a superare il confine, tra i controlli per i Visitatori e l''afa di mezzogiorno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: Ok, grazie.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: Vaffanculo.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: Allora perché lei è ancora a casa e non al lavoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: Perché non viene qui a mostrarci come si fa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: Saremmo lieti di imparare, visto che sembra saperne più di chiunque altro!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: Ok, grazie.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: Vaffanculo.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: Mi scusi... Non avrei dovuto alzare la voce.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: Non è il primo che chiama a essere così... furioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: Stia bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: Buona fortuna.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: Spero che un giorno si torni a viaggiare senza restrizioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: Allora sarò più che felice di aiutarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: Una finestra interna. In passato, serviva a risparmiare elettricità, facendo filtrare la luce tra due ambienti.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: Poi l'hanno sigillata... Ma solo da un lato.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: No, non voglio guardare da quella parte. Mai più.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: Odio dormire vicino al comodino. Troppi brutti ricordi...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: Non capisco perché non stia nell'angolo. Pensavo fosse la norma.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: D'altronde... papà non ha mai badato a queste formalità.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: Toto. In pratica, l'unico giocattolo della mia infanzia.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: Beh, tranne i bastoncini che usavamo per battere l'erba.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: Eh... La nonna stipava ogni armadio di stoviglie.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: Per le feste, tirava fuori il suo servizio più raffinato. A chi diavolo serve, ormai?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: Sinceramente, preferisco stare da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: Posso parlare a me stesso, se ne ho voglia.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: Una di quelle riviste dove devi trovare qualcuno in mezzo alla folla...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: Perché mai dovrei? Ma lasciatemi in pace, una buona volta...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: 'All''epoca mi disse: "Quando non ci sarò più, dovrai decidere se aprire o meno quelle scatole".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: Sono passati quindici anni, eppure non so ancora cosa fare.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: Soffri la solitudine?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: L'ansia ti divora? Non hai nessuno con cui parlare?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: La roulette telefonica fa al caso tuo!
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: Chiama subito il numero 891‑533 e ti troveremo la persona ideale per una conversazione.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: Tua figlia sta bene?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: Chi li ha uccisi?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: Fai attenzione (riattacca).
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: Tua figlia sta bene?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: Chi li ha uccisi?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: Fai attenzione (riattacca).
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: Dove hanno portato la persona che viveva con te?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: Meno male che non hanno preso tua figlia.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: Cos'è la FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: A presto (riattacca).
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: Dove hanno portato la persona che viveva con te?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: Meno male che non hanno preso tua figlia.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: Cos'è la FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: A presto (riattacca).
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: Dove hanno portato la persona che viveva con te?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: Meno male che non hanno preso tua figlia.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: Cos'è la FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: A presto (riattacca).
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: Salve, parla con il numero d''emergenza FEMA. Come posso aiutarla?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: FEMA? Che sarebbe?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: Di cosa stai parlando?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: (Prima che lei possa finire, viene interrotta da una forte voce maschile)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: TI HA DATO DI VOLTA IL CERVELLO? METTI GIÙ QUEL TELEFONO!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: Che dovrei fare con le ascelle?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: Che dovrei fare con le orecchie?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: Per garantire la validità dei test, eviti qualsiasi contatto con l''acqua.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: Non faccia la doccia e non si lavi le mani.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: Le orecchie? Un momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: Mi lasci parlare con la direzione, la ricontatteremo a breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: Molto bene. Dimmi, consumi prodotti a base di funghi?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: D''accordo, un''ultima domanda. È stato versato del sangue in casa tua?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: Salve, questa è la roulette telefonica. A breve la collegheremo con l''interlocutore più adatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: Ehi, ciao.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: Ciao.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: Pronto?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: Ciao.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: C''è qualcuno?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: Io... ho bisogno di parlare. Stanno succedendo troppe cose...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: Ho provato a mettermi in contatto con amici e conoscenti, ma nessuno mi risponde...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: Poi ho scoperto la roulette telefonica.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: Magari non è il posto migliore per le confidenze, ma è comunque meglio di niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: So anche che non dovrei scaricare le mie paranoie su uno sconosciuto, però...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: Non puoi capire quanto mi aiuterebbe. Mi farebbe sentire... decisamente meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: Ti va di ascoltarmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: D'accordo.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: Non me la sento di fare conversazione.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: Ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: Sì, capisco. Scusa il disturbo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: Oh, grazie! Grazie mille!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: Che ne dici se inizio parlandoti di me?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: C''è qualcosa in particolare che ti piacerebbe sapere?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: Dove vivi?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: Perché i tuoi amici non rispondono?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: Lontano da casa, purtroppo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: Cercavo di sfuggire al caldo, così ho cercato il posto più freddo che potessi trovare.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: Mi trovo nel nulla più totale, fa un freddo che gela le ossa. Non c''è vita qui, neanche un filo d''erba.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: Ma è un luogo piuttosto sicuro, a chilometri da tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: Non è così male. In fondo, persino nel nono cerchio dell''inferno c''è un angolo di gelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: Sai la cosa buffa? Una volta odiavo il freddo... ma ora mi sembra una benedizione.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: Continuo a ripetermi che prima o poi le temperature torneranno normali e questo incubo finirà.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: Ma sto perdendo le speranze. Cosa ne sarà di noi quando il sole smetterà di bruciare?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: E se i Visitatori non se ne andassero? Potrebbero sostituire i nostri cari, e noi non ce ne accorgeremmo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: Perché ti sei messa in viaggio da sola?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: Ti manca la tua città?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: Vorrei tanto sentirli, ma... non so proprio come fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: Quando è iniziato il Cataclisma, ho lasciato la mia città. Volevo fuggire da quel caldo torrido.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: Promisi a tutti che mi sarei fatta sentire spesso, per sapere come se la passassero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: Ma da quando sono qui, non sono più riuscita a contattarli.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: In seguito, ho scoperto il motivo. Hanno interrotto le linee telefoniche.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: L''intera città è tagliata fuori dal mondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: Ora io sono al sicuro, mentre i miei amici...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: Il pensiero di non rivederli mai più mi sconvolge.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: Quanto mi mancano i vecchi tempi, quando la vita era semplice e il futuro non faceva paura...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: Perché ti sei messa in viaggio da sola?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: Ti manca la tua città?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: Non doveva andare così. Il fatto è che...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: Il mio migliore amico voleva venire con me, ma non ha potuto...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: Non aveva i documenti necessari per poter viaggiare.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: E quando il Cataclisma è arrivato, ottenerli è diventato impossibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: Era così abbattuto... Rimpiangeva di non averli presi prima. Volevo aiutarlo, ma non sapevo come fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: Sì. Non il luogo in sé, ma le persone che ci abitano ancora.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: Soprattutto, il mio migliore amico...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: Voleva seguirmi, ma non ha potuto. Gli avevo promesso che ci saremmo sentiti, e invece...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: Sai, credo fosse innamorato di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: Era così premuroso... Sempre presente per ascoltarmi e tirarmi su di morale.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: Alla fine ho capito che ci piacevamo a vicenda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: Volevo che fosse lui a dichiararsi, ma immagino che non sia mai riuscito a trovare il momento giusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: E poi... con l''arrivo del Cataclisma, non abbiamo più avuto tempo per noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: Avrei dovuto fare il primo passo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: Beh, ora conosci qualcosa della mia vita. Tocca a te.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: Non sono abituato a parlare di me...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: Non so nemmeno da dove cominciare...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: Non essere timido. Ti ascolto volentieri.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: Beh, io... non ho alcun legame.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: Sono... un solitario.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: Non sentirti in imbarazzo. Raccontami della tua vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: Beh, io... non ho alcun legame.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: Sono... un solitario.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: Io... avevo un rapporto difficile con mio padre.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: Odiavo mio padre.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: Ho chiuso da tempo con la mia famiglia.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: E un giorno, ho smesso di essere suo figlio.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: Mi è rimasta solo questa dannata casa.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: Mi hanno lasciato solo questa casa.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: Mi dispiace... Da come ne parli, non sembri molto contento di aver ereditato quella casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: Proprio così.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: Sarebbe stato meglio se fosse bruciata.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: Faccio fatica... a immaginare quello che hai vissuto...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: Devi odiare molto tuo padre... per voler vedere la casa ridotta in cenere.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: 'Phone: Ehi, grazie ancora per aver parlato con me.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: 'Phone: Spero di risentirti. Cerca di farti forza, ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: Pronto?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: Salve, posso parlare con sua figlia?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: Salve. Sua figlia potrebbe venire a giocare con la sua amica?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: Cosa? Perché vuoi parlare con lei?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: La sua amica ha chiesto se può venire da noi.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: C'è una bambina qui... Suo padre è morto.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: Era... un Visitatore anche lui?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: Come sarebbe "anche lui"?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: No, dei pazzi lo hanno dato alle fiamme senza alcun motivo.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: Nessuno brucia le persone senza una ragione...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: Quindi era un Visitatore... proprio come la mia piccola.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: Hanno bruciato anche lei.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: Al suo asilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: Ho pianto tanto, all''inizio. Volevo farla finita, non riuscivo a rassegnarmi alla sua perdita.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: Ma mio marito mi ha aiutata a farmene una ragione.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: E anche voi ce la farete... Tu e quella bambina.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: Il fatto è che...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: Tutto accade per un motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: Se hanno bruciato suo padre... evidentemente era destino.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: E disperarsi non cambierà nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: Per favore, diglielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: La nostra bambina... Lei...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: È morta...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: 'Phone: Noi abbiamo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: Abbiamo dovuto ucciderla.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: Cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: (Riattacca)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: 'Phone: L''abbiamo uccisa. Credimi, non c''era altra scelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: Aveva tutti i segni... Mio marito è stato irremovibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: Avete... ucciso vostra figlia?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: 'Phone: Non provare a giudicarmi!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: Era un Visitatore! I suoi segni corrispondevano, non c''erano dubbi!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: Cazzo...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: Capisco.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: Era un Visitatore, ti dico!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: Tutti i segni lo confermavano.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: Sono sua madre, la conoscevo bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: Per questo ho notato subito quelle strane anomalie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: E coincidevano. Una per una.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: Quando l''ho detto a mio marito, lui...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: Si è occupato subito del Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: All''inizio, l''ho odiato e volevo ucciderlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: Ma col tempo ho compreso... che quella non era più nostra figlia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: Mio marito me lo ha fatto capire.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: Il mio unico rimpianto è di non aver chiesto a quell''intruso cosa ne avesse fatto della mia piccina...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: Mi dispiace.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: Non chiamarci più...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: Per favore...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: Non devo giustificarmi con te!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972625
    m_Localized: 'Phone: Vai all''inferno!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972626
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972627
    m_Localized: 'Phone: Mi manca così tanto...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972628
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096192
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096193
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096194
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096195
    m_Localized: 'TV: A seguire, uno speciale sulla sospensione temporanea dello smaltimento dei cadaveri.'
    m_Metadata:
      m_Items: []
  - m_Id: 58231803335401472
    m_Localized: Due scatolette di cibo per gatti.
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790080
    m_Localized: Un pacchetto di sigarette.
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790081
    m_Localized: Un barattolo di kombucha.
    m_Metadata:
      m_Items: []
  - m_Id: 58690054376120320
    m_Localized: 'TV: Disponibile con la consegna a domicilio ForRest. Chiama ora il numero {0}.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
