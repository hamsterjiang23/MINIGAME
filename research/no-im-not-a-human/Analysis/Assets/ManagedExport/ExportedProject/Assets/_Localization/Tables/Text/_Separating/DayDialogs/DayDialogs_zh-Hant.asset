%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_zh-Hant
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-Hant
  m_SharedData: {fileID: 11400000, guid: 48f2181e494cb864ca5ca7074da486ff, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: 該死，實在是太熱了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: 感覺如何？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: 我要對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: 看來似乎比我想的要更糟。*咳嗽*該死。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: 我覺得自己可能撐不過一週。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: 不過——當你決定接納我的時候，我的確感到好受了一些。謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: 只是……我坐在這裡的同時，兄弟們卻命懸一線。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: 我本應跟他們共同進退。我本就沒有東西可失去。無論如何，我也都活不下來……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: 該死，實在是太熱了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: 為何不回自己的家？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: 我要對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: 我家裡有小孩。我……*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: 我不想讓他們害怕我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: 而且，我也*咳嗽*不想讓他們記住我現在的這個樣子。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: 還是讓他們認為我在撲滅森林火災的時候……*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: 英勇犧牲了會比較好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: *咳嗽*就讓他們記住我的鍥而不捨和孜孜不倦吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: 該死，實在是太熱了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: 你的制服呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: 我要對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: 被高層拿走了。*咳嗽*我們現在裝備不足。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: 好些人*咳嗽*於執行任務的過程中喪命。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: 我們根本就來不及把他們全部給運送出來。最終，大火*咳嗽*將一切都吞噬殆盡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: 而高層……卻更他媽的關心*咳嗽*一件制服……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: 如同連珠砲彈一般不斷出台各種命令，卻沒有哪怕一條是為了大家而制定的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: 該死，實在是太熱了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: 為何會引發森林火災？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: 我要對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: 最近，森林非常乾燥。因此，*咳嗽*很容易就會燒起來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: 大火*咳嗽*只是降臨在我們頭上的災難之一，正如於地下爬出來的那些偽人一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: 然而，命運給我們準備的還不止這點「驚喜」……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: 或許，我們早就已經深陷絕境。能平靜迎來死亡已是最好的結果。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: 其實……*咳嗽*我本打算把一件禮物帶回家裡。不過，還是交給你吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: 一條項鏈……沒錯，的確不太好看——這點我也清楚。不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: 它以死亡的蜜蜂串製而成，曾將灑下的陽光化作蜂蜜。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: 該死，實在是太熱了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: 你看起來很糟糕
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: 我要對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: 我想……我的大限已至……*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: 我為什麼沒有留下呢？我本可救下幾個兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: 我本應堅持到底……工作至最後一刻，直至倒下。這樣一來，就不必派年輕人去送死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: 媽的，這些該死的高層！*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: 這一切都……太過悲傷。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: 能讓我在最後抽上一口嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: 拿出一根菸（給他香菸）
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: 你該不會剛好有帶了菸吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: 抱歉，沒有（不給他香菸）
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: 還真是「壓死駱駝的最後一根稻草」。*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: （對方從口袋中拿出了打火機、將菸點著，然後抽了起來。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: （深深地吸上一口之後，他往後一靠、抵在了牆上。沉默片刻後，又繼續開口。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: 要是能跟小隊的兄弟們再次團聚就好了。一起抽菸、一起聊天——'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: 怎麼，你不抽菸的嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: 我知道、我知道——消防員抽菸確實不太好。*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: 不過，現在也沒差啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: 我只不過是想*咳嗽*在死之前稍微放鬆一下罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: （對方靠在牆邊，一邊說話、一邊凝視著天花板。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: 我怎麼就打定了主意要當消防員呢……？我媽早就說過要我去進廠上班來著。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: 消防員不應該——'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: 真希望能自由自在地四處閒逛……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: 你是在找誰？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: 我的好友。我們自小就相識了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: 這個傢伙曾經出過事故。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: 他被人僱去山裡採什麼東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: 我不是很懂，也並不在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: 結果，他好死不死地把自己的背給扭傷了、好幾天都無法動彈！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: 他在山裡拚了老命地去工作……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: 以致於海鷗誤把他的……背……給當成了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: 好吧，是他的屁股——海鷗把他的屁股給當成了自己的巢！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: 哈哈哈哈。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: 不好意思，我的腦海中響起了好幾把聲音。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: 他們把這個笑話說得非常有意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: 真希望能自由自在地四處閒逛……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: 呃……一切可好？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: 好得很、好得很。我在等自己的雙腳重新長出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: 看——右邊的這隻已經開始了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: 因此，我還會在這裡待上一段時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: 我是指你腦海中的聲音
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: 好吧……
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: 哎呀，你沒聽懂嗎？我只是在開玩笑罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: 我還以為你立即就聽出來了呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: 看來沒有奏效。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: 哎呀，你是在顧惜我嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: 謝謝，真是貼心！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: 要知道，一直以來都沒人在意過我的感受或是關心我過得如何。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: 難道，是因為我沒有雙腿、取而代之的是幾個輪子？莫非……他們是在嫉妒？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: 沒人會正面回答這個問題——這，就是問題所在。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: 大家都會開始找藉口，說自己只是匆匆看了一眼、沒有留意，不是故意的……諸如此類。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: 不過，要是他們直勾勾地盯著看、一個字都不說的話也會令我不自在就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: 只是，無視我的殘疾也並非什麼明智之舉。畢竟，一眼就能看出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: 一般而言，能找到一個微妙的平衡是最好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: 只是如今，城裡根本就沒有已經沒有這種東西了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: 不知，你有否想過要是自己坐在輪椅上的話該怎樣行走？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: 嗯……這種說法好像有點語病。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: 要是你失去了雙腿的話。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: 沒錯，就是這樣——你甚至無法離開自己的房子！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: 不然的話，要怎樣上下樓梯、穿過馬路呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: 沒錯，特別是那些東倒西歪的路緣——歪得比手風琴上的鋸齒紋還要誇張！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: 這棟房子既沒有樓梯、也沒有門檻。因此，我可以輕鬆地在其中進行移動。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: 非要說的話……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: 要是能有個斜坡的話，就更好了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: 想想看嘛——要是可以坐著輪椅滑下去的話，一定會特別有意思！當然，會撞到牆壁上。哎呀……問題不大。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: 真是希望你可以把這棟房子改造一下，打造一條賽道——讓我體驗一下驚險、刺激的競速！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: 哎呀，不對——你是在問我過得如何。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: 還挺不賴，謝謝關心。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: 真希望能自由自在地四處閒逛……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: 難道，你被太陽曬暈了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: 怎麼會冷不防地冒出這樣一句八竿子打不著的話？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: 我的頭髮既沒燒焦、也沒脫落。因此，一點問題也沒有。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: 我失去了雙腿，因此無法競速。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: 不然的話，要怎樣在全速疾馳的情況下減速、轉彎呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: 而你尚有雙腿，又怎能理解呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: 難道你真的相信這些？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: 為何你會覺得自己的雙腿能重新長出來？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: 沒錯！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: 大家都說——'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: 我們的右腳所邁出的步子要更大一點，因此總是在轉圈。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: 喏，我就是最好的證明。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: 一模一樣，永遠都在轉圈。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: 上一天結束之後，下一天就會開始。不過，此二者之間真的存在任何差別嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: 媽的，從來就未曾變過——我們生活在無盡的循環之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: 好了，現在仔細想想——你我之間真的有什麼不同嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: 畢竟，你不也在轉圈嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: 要知道，我們所生活的這個世界充滿了奇蹟。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: 雖然到目前為止全是一些不好的就是了，不過——'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: 總有一天，這些不好的奇蹟終會到頭。自此之後，幸福的奇蹟便會來臨。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: 上帝早已寬恕了無數信徒。或許，美好的事情將要降臨於你我之上。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: 真希望能自由自在地四處閒逛……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: 請問，你為何會失去自己的雙腿？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: 還記得我提到的那位在山裡工作的好友嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: 嗯……他決定在自家院子挖一條溝。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: 不知出於何種原因，他認為自家地下延伸著一條滿滿都是肉的隧道。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: 為此，他還特地訂了一台……手動鑽機還是什麼東西來著。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: 然後，就開始挖呀挖、挖呀挖……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: 該死……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: 我想，那應該是我最後一次見到他了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: 真希望能自由自在地四處閒逛……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: 呃……我們不是在談論你的雙腿嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: 去他媽的腿吧，我只想知道他究竟挖沒挖到他心心念念的那條隧道。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: 好吧，就當我沒問
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: 嗯嗯……對了！我當時忘了他的事情，自己出門買啤酒去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: 結果——不小心摔倒，然後被電車給碾斷了雙腿！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: 不對，等等……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: 並非如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: 怎麼一言不發？難道不感興趣？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: 好吧，既然你不想聽、我也沒必要說。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: 這裡讓人喘不過氣來……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: 我記得你不是帶著一個孩子嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: 嗯？噢，他還在的。大概是跑到其他什麼地方去了吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: 我需要知道其他的孩子都去哪裡了、是否還安好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: 請問，這裡有電話嗎？我可以打給他們的父親。這樣一來，我就不必再次見到他那張醜惡的臉孔了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: 這裡讓人喘不過氣來……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: 怎樣，給丈夫打過電話了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: 我為何要這樣做？畢竟他也就只會嘟囔個不停，好像什麼都不關自己的事一樣，完全無動於衷。一切的一切都落在了我的肩上——照顧孩子、打掃房子，還有賺錢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: 我經常會覺得他是在忍受我、而我也在包容他。不過……不知怎地，他卻沒有離開我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: 也許，他是覺得我能堪一用吧。不然，就是害怕我可能會報復。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: 天啊，我好累……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: 這裡讓人喘不過氣來……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: 如何，你有去見自己的丈夫嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: 蛤？我幾乎無法起床。全身疼痛、筋疲力竭——而且，我總覺得自己之所以還活著只是為了賭一口氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: 一切的一切都落在了我的肩上——相夫、教子，打理好整個家。不過，他有時也會做一些反而讓此等重擔變得勉強能接受的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: 之後再聊吧。我需要休息一下，感覺快要昏過去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: 這裡讓人喘不過氣來……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: 具體來說，他都做了些什麼事情？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: 譬如說……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: 之前，他經常會帶一個女人出去兜風。我都看在眼裡。起初，我還可以默默地忍下來。不過，之後就不由自主地每天都在跟他鬥嘴。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: 我一直嘮叨個不停……結果，他換了工作。這樣一來，他就不會再見到對方了。也許，他還是愛我的……沒錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: 雖然，這一切說不定只是我的一廂情願罷了。總之，我要休息了——之後再聊吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: 這裡讓人喘不過氣來……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: 難道，你不擔心自己的孩子嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: 我當然擔心，只是……作為一個母親來說，程度可能還不夠吧。撫養第一個孩子時……我也不知道自己在做什麼，簡而言之就是把一切都搞砸了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: 我本以為自己可以在撫養第二個孩子時糾正這些錯誤。結果，還是重蹈覆轍了。不僅如此，撫養接下來的第三個孩子、第四個孩子時也是一樣……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: 醫生跟我說過，我生不了孩子。因此，當我誕下第二個孩子的時候……我激動地管他叫「世界第八奇蹟」！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: 然而，結果卻……糟糕透頂……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: 我……我需要休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: 這裡讓人喘不過氣來……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: 為何會說「糟糕透頂」？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: 這實在是難以啟齒……我很愛他們，只是……我經常無法控制自己的脾氣。不光大吼大叫，甚至還試過動手打他們。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: 我知道這很糟糕，我也對此很後悔……不過，這是我第一次感到事情原來可以如此輕鬆。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: 誰都不在之後，我反而不再覺得呼吸困難了……雖然不想這樣說，不過我終於感覺好些了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: 媽的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: 如何，冷靜下來了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: 嗯嗯，我冷靜得很快。不過……每當我想起什麼爛事，就又會發起火來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: 我以前要更為隨和。想要讓我大發雷霆、或者觸及我的痛處，都絕非易事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: 然而現在，只需要激起一點點的火星，就能把我整個人給點燃。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: 說到底，我又為何要保持冷靜呢？或許，正是憤怒讓我得以保持理智。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: 起碼我不會像某群蠢貨一樣去敬拜太陽。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: 這些傢伙為何會覺得太陽是在救我們的命？媽的，一派胡言——擺明是在要我們的命！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: 照我看來，我們離灰飛煙滅、就只有咫尺之遙而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: 而他們根本就不懂——一丁點都不懂！好了、好了……我沒事了。我已經冷靜下來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: 謝謝你願意聽我訴說。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: 媽的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: 這永無止境的憤怒，究竟從何而來？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: 我自己也不清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: 目前發生的一切無時無刻都挑動著我的神經。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: 還有那些滿嘴謊話、死不足惜的邪教爪牙——他們還想去誆騙更多的人們。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: 更絕的是，大家竟然像一頭頭把腦袋伸進餿水槽裡的豬一樣——真他媽的會去相信他們。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: 只要能向這個邪教進貢，甚至不惜把自己的孩子給扒個一乾二淨。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: 以此來討好他們的那個不知道從哪裡冒出來的狗屁救星。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: 真是一群瘋子。不光如此，他們甚至還會把自己的這些妄想灌輸到正常人的思想中、將其洗腦……就像我的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: 總之，我現在已經冷靜下來、感覺好些了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: 媽的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: 邪教是否奪走了你重要的人？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: 正好相反。她是自願成為其中一員的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: 我的妻子……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: 雖然在這一切破事發生之前，她就已經是一名虔誠的信徒。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: 不過，我深愛著她。於是，也接受這點。我們之間的關係從未因此出現過任何的裂痕。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: 災變開始之後，她將自己的信仰轉而投向了邪教爪牙口中的救世主。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: 照她看來，這些傢伙的滿嘴狗屁聽起來竟有幾分道理。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: 日子一天接著一天地過去，她也逐漸變得越來越瘋狂——篤信著一些我無法理解的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: 而當我意識到自己都做了些什麼的時候，她早已倉皇逃離。一切均已無法挽回……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: 媽的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: 你和你的妻子之間究竟發生了什麼事？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: 某天，我的妻子說自己要成為邪教的一員。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: 我……實在無法相信。我曾經深愛過的這個女人……竟成了一個完全不同的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: 我們之間的一切對她來說已經如同糞土。我怒不可遏——我這輩子都沒有試過像當時一樣氣得七竅生煙。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: 我開始胡思亂想、覺得她從始至終都沒愛過我，甚至——有可能一直都在找機會，想要逃之夭夭。我感到無比噁心。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: 我不由自主地握緊了雙拳，然後……做了一件永遠都無法原諒自己的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: 我打了她……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: 現在，一切均已無法挽回。她成為了邪教的一員，而我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: 永遠也無法對此釋懷……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: 媽的，我好討厭自己！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: 我寧可傷害自己，也不會將痛苦施加於他人之上——我活該如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: 讓我一個人靜一靜吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: 怎麼——想要占卜一下嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: 為何你會知道這些與我相關的事？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: 哎呀，你真幽默……並非是我知曉，而是星辰在借我之口進行講述。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: 雖然靜寂無聲，不過……月亮和金星落在了你的第六宮。如何？全都寫在你的臉上了，根本不用你說一句話。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: 我之前也認識一個跟你別無二致的人。總是傾聽，永不訴說。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: 經典有雲，「木星若在第八宮，最好要保持沉默」。此為閉門之兆。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: 怎麼——想要占卜一下嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: 先前說的那人，之後怎麼樣了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: 我跟他說——「重點並非在於你做了什麼，而是在於你的氣場是否同時發揮出了作用。」而他，則一直對此心懷疑慮。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: 因此，生命離他而去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: 某天，當我閉上雙眼時，卻做了一場成功實現自己心願的幻夢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: 我將自己全部的能量都灌注到了這幅景象之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: 若無法對其敞開心扉，又何苦眷戀這副軀殼？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: 而你，也能做到。閉上自己的雙眼……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: 想像自己早已實現了目標……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: 細細地端詳……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: 好了，現在理解自己為何會感到痛苦了嗎？因為，你一直都不明白苦難就是最為純粹的快樂。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: 告訴我……你準備好邁出這一步了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: 怎麼——想要占卜一下嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: 「這一步」是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: 意思就是說，要忠於自我。聞到了嗎？自己未竟渴望所流露出來的氣息。就將它們通通都釋放出來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: 我也曾經陷入過低谷，覺得人生已不剩半點光芒、失去了一切的意義。當時，我的導師只說了一句話——「去傾聽自己內心的海洋吧」。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: 起初，我也嗤之以鼻。然而，當我閉上雙眼……卻聽見了陣陣浪聲。就好像從始至終都在我的思緒之中一樣。這點，你也可以做到！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: 不過，最重要的是——還請捫心自問：你準備好接納真正的自己了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: 怎麼——想要占卜一下嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: 誰是你的導師？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: 一位偉大的女性。她就宛如暴風雨之中的燈塔，教會我如何看清萬物的本質。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: 我永遠都不會忘記她的教誨：「人們之所以會丟掉性命，正是因為未曾學會如何汲取內心的光芒。」'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: 她令我明白——我可以幫助大家找到屬於自己的那條獨一無二的道路。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: 不過，唉……她卻害怕更進一步。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: 她沒有將自己放在核心——要知道，此事非同小可。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: 如果沒有處於自我宇宙的中心位置，人們就會喪失本真——這，你應該可以理解吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: 怎麼——想要占卜一下嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: 那麼，你是如何幫助自己的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: 人們所犯下的一切錯誤，都只不過是自我宇宙中尚未破解的密碼罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: 而我，則是走過了漫漫長路。時而環顧四周、時而回望過去。看看——這棟房子已經對我的存在做出了回應。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: 不僅明亮、而且寬敞，還能與我體內的能量和諧共存、沒有必要與之對抗。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: 其早已吸收了你的恐懼。予以接納吧——否則，它將會流出你的淚水。理解了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: 怎麼——想要占卜一下嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: 請問，你想從我這裡得到些什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: 哎呀，親愛的——我可沒有什麼需求。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: 重點在於，如果你看到了自己的影子起舞，就能明白腳下的道路藏於何處。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: 只要念誦幸福的咒語即可。已經能感受到一切都在改變了，沒錯吧？就連呼吸起來都更為輕鬆了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: 此為我的能量與這個空間相互交融的結果。無需追尋意義——捨棄掉幻想，擁抱混沌吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: 我希望你可以和我一樣，一同融入這個空間，並進行宣言：「我不是此處的住客，而是這一聖所的締造之人。」'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: 怎麼——想要占卜一下嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: 如果我不想當什麼締造之人，又將如何？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: 這棟房子一直都非常想要將你擁入懷中，而你卻以名為掌控的鎖鏈將其禁錮。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: 內心的沉默，正是你以恐懼所扼殺的世界呼聲。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: 如同冬蜜一般，你的能量凝固、停滯。需要以呼吸的溫度將其融化。而鏡子從不說謊。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: 如果眼裡只有自己，就什麼都不會看見。於你而言，只要將體內的能量向右轉三度即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: 如此一來，你終會獲得幸福。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: 我在聽，人類。說吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: 難道，你是某個宗教團體的一員？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: 沒錯，人類！不過，我所信仰的對象與你所知的任何低等宗教都有所不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: 我敬拜聖潔的太陽——因其予以我們保護、憐愛！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: 然而，愚蠢之人卻只從中看到了壞處。這些傢伙竟然覺得它會把我們燒為灰燼……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: 一派胡言！太陽只會對邪惡之種和異端之徒傾斜自己的憤怒！因為他們皆為罪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: 願這些心懷異議之人永世都無法得到其正義之臂的熾熱庇護！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: 自討苦吃、自作自受，而因此受到灼燒之時卻竟還感到驚訝。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: 邪惡之種？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: 異端之徒？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: 怎麼，這也要問？難道，你對那些異星來客一無所知？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: 好吧，沒有陽光庇護的人類。就讓我來告訴你真相吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: 偽人，即為邪惡之種！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: 異星來客抵達地球之時，太陽還很年輕、地上的青草也要更有生機——偽人，就是這些傢伙的後代！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: 這群該死的雜種在地球上安家、繁衍，長達好幾個世紀！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: 現在，它們於地下爬出、妄圖奪取本就不屬於自己的土地！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: 好在，太陽決定予以我們庇護——因為，這是我們的土地。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: 而且，太陽對這群褻瀆神明的偽人從不留情——不然，為何它們一直以來都潛伏在地下？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: 該死……為何那天晚上會這麼醉……？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: 根本沒有必要喝到不省人事。因為，聖潔的太陽會以其正義的怒火……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: 聖潔的太陽，請讓他的靈魂得以安息、請原諒他因無知犯下的罪孽！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: 將他擁入你的懷中。此外，也請接納他所種下的無花果樹之靈魂——他再也無法對其進行澆注了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: 阿門。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: 沒錯，人類！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: FEMA就是一群罪該萬死的異端之徒！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: 這些傢伙竟敢干預我們——也就是普通人無法控制的領域！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: 手伸太長的混帳。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: 願太陽對這群將我媽丟進水坑的混蛋予以詛咒。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: 我在聽，人類。說吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: 無論如何，太陽也的確燒死了好些人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: 沒錯。都是邪惡之種，人類！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: 太陽決意對它們於數千年來所犯下的罪孽施以懲罰！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: 甚至，這些生長於黑暗、陰影之中的偽人竟還癡心妄想地想要對太陽出手！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: 不過，太陽並不屬於這些骯髒不堪地底居民，而是屬於人類！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: 而是屬於我們！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: 媽的，這可是予以人類的賜福！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: 到底要燒死幾個人，太陽的怒火才能得以平息？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: 難道你是在說，現在這個世界末日是太陽所降下的審判？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: 幾個？遠遠不足。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: 相信我，我的好友——這一切遠未結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: 這一切只是開端！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: 罪惡天秤上所積累的籌碼——也就是我們的骨灰，尚未足以與宇宙之力相抗衡！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: 太陽所投下的正義之炎，還需要燒灼更多對象！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: 不過，我的好友，請你知曉——這些犧牲皆不會白費！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: 總有一天，我們都能領會太陽的真正意圖……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: 唉。每當在夜深人靜的時候想起離我而去的妻子，都會令我感到無比悲傷……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: 她是個聖潔的女人……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: 然而，也是個無可救藥的婊子。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: 末日？對誰來說？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: 我們？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: 哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: 不要引人發笑了——太陽是站在我們這邊的！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: 這是在向我們施以援手，難道你看不出來嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: 它是要把偽人給趕回地下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: 它是要懲罰犯下無數罪孽的瀆神之人……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: 它令那些身披尿跡斑斑的破布、羞愧地躲在面具之下的異端之徒無所遁形。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: 我們應當對太陽懷抱感恩，而不是宣揚什麼末日降至。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: 非要說的話，也是太陽之敵的末日！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: 死吧，地下居民！死吧，異端之徒！死吧，邪惡之種！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: 天啊，我已經很久沒吃過炸馬鈴薯了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: 我在聽，人類。說吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: 難道，你認為目前發生的一切具有某種神聖的意義？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: 我之所以會像這樣不厭其煩地給你解釋這一切……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: 並不是為了讓你反反復復地提出相同的問題！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: 我似乎看錯你了，人類——你的確沒有陽光的庇護，你根本就不明白這一切之所以會發生的真正原因……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: 媽的，要是能來幾瓶冰鎮啤酒就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: 人類——你有準備這些發酵的貢品嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: 沒問題，拿去吧（給他啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: 沒有啤酒？放屁，我看你八成是瘋了吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: 我親眼見到了你的冰箱裡都裝著些什麼！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: 好你個人類，只管自己獨享、從不與人分享！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: 沒有（不給他啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: 感謝太陽……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: 嗯，沁人心脾、口感濃郁——是我的最愛。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: 令我想起了跟三五好友一起去酒吧玩樂的時候。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: 大聲暢談、牛飲冰啤，更別提美味的小食、獨特的醬汁……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: 此外，還有那個總是盯著我們的滿臉陰沉、面有慍色的傢伙……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: 好吧，現在並不是傷感的時候。雖然你有點蠢，人類——不過，起碼你很善良。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: 來，收下這份小小的謝禮吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: 願聖潔的太陽拯救你的靈魂！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: 卑鄙之人！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: 給我下地獄吧，混帳東西！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: 忘恩負義的傢伙！我費盡口舌地講解了這一切背後的神意及其重要之處，而你竟然……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: 心懷惡念、愚昧之人！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: 去你媽的。繼續踡縮在你這破屋裡吧！我會去找個更好的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: 給我等著瞧——他們一定會讓我回到酒吧裡去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: 祝你餘生能落得個不錯的下場，蠢貨。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: 嘿、嘿嘿。希望這一切能早點結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: 請問，你為何會失去自己的房子？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: 唉……我永遠都忘不了那天發生的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: 我被解僱了——萬念俱焚之下，只想回家、趴在床上痛哭一場。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: 到了之後，我發現走廊上放著幾雙靴子。我還以為是有人來拜訪我的室友了，譬如好友、親戚。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: 我走向她的房間，想看看她究竟是在搞什麼名堂。剛走到門口，就聽到了一陣奇怪的聲響。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: 我被嚇到了。於是，呃……就決定悄悄地查看一下裡面的情況。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: 我瞥到她躺在床上、一動不動。還沒等我反應過來的時候，突然……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: 一個蓬頭垢面的傢伙從背後一把抓住了我、對我說：「不要進去裡面。她……狀況不太好。」'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: 「我們還是去廚房裡待著吧。」然後就拽著我的手臂，把我拉到了餐桌邊上、讓我坐了下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: 我想要逃走，然而恐懼如同枷鎖一般將我牢牢禁錮在原地……接著……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: 我……他……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: 我需要休息一下——我的焦慮症發作了，現在胃裡翻江倒海。唉……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: 嘿、嘿嘿。希望這一切能早點結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: 然後，都發生了什麼事？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: 唉……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: 對方讓我坐在餐桌邊上後，之前躲在轉角的大塊頭走了出來、把出口給擋住了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: 兩人開始大聲交談。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: 好像……當我不存在一樣。然後，他們……就開始摸我！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: 先是手臂，然後輪到肩膀……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: 我還聽見背景響起了陣陣歡呼與大笑，似乎是從我的房間裡傳來的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: 就好像裡面有一大群人一樣。哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: 我開始覺得呼吸窘迫、慄慄危懼——心臟快要從胸膛裡跳出來……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: 我想要大聲呼救，然而就連一個字都喊不出來……恐懼掐住了我的咽喉。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: 我只能呆呆地坐著，如同一隻被車燈照到的野鹿一般——六神無主、手足無措。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: 一會之後，大塊頭去開冰箱找東西了。我意識到自己的機會來了……嘿、嘿嘿！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: 恐懼彷彿賜予了我力量，驅使著我死命奔向出口、就此逃離——永不回頭。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: 直至精疲力竭、癱倒在地為止……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: 為何你沒有受到太陽的灼燒？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: 之後，發生了什麼事？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: 我想不起來了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: 我肯定是躺在地上待了整整一夜，然後……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: 真是奇怪……我還以為自己記得當天所發生的一切……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: 不對，難道……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: 我該不會是個偽人？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: 不、不，這怎麼可能！我……清晰地記得迄今為止的人生，不管是我的童年、還是我的父母！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: 我絕不會是個偽人，沒錯吧？快告訴我——我絕不會是個偽人！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: 我不知道
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: 沒錯，你並不是個偽人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: 我想，你的確是個偽人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: 我躺在地上，然後……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: 然後……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: 我還以為自己記得所發生的一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: 不對，難道……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: 我該不會是個偽人？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: 不、不，這怎麼可能！我清晰地記得迄今為止的人生，不管是我的童年、還是我的父母！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: 我絕不會是個偽人，沒錯吧？快告訴我——我絕不會是個偽人！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: 我不知道
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: 沒錯，你並不是個偽人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: 我想，你的確是個偽人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: 為何要這樣說？哈哈！天啊、天啊、天啊——天啊！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: 我需要休息一下——胃裡又開始翻騰了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: 謝謝，我感覺好些了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: 唉，我需要休息一下——胃裡又開始翻騰了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: 為何要這樣說？哈哈——我現在更加害怕了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: 我不想死、我不想死、我不想死——我不想死！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: 我們已經沒救了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: 嘿、嘿嘿。希望這一切能早點結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: 你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: 不要再靠近我了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: 抱歉，我……我還以為你要殺了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: 為何會有這種想法？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: 如果我真想下手，你早就已經死了
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: 我不知道誰是偽人、誰又不是……萬一……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: 萬一你就是個偽人的話，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: 你會殺了我嗎？而且，還得抽筋、剝皮？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: 拜託，不要——還請給我個痛快！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: 我不想在痛苦中死去。求求你！哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: 放心，我並不是個偽人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: 我沒有要殺了你的意思
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: 抱歉，我實在是焦慮得不行。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: 不知道究竟可以信任誰。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: 而且，萬一……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: 萬一你就是個偽人的話，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: 你會殺了我嗎？而且，還得抽筋、剝皮？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: 拜託，不要——還請給我個痛快！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: 我不想在痛苦中死去。求求你！哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: 放心，我並不是個偽人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: 我沒有要殺了你的意思
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: 我怎麼可能會知道？我、我又沒檢查過你的牙齒或是眼睛……哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: 我們已經沒救了。要嘛就是遭受偽人的毒手，要嘛就是遭到太陽的灼燒……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: 希望已經破滅，死亡終將降臨——做什麼都沒用。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: 不要管我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: 我怎麼可能會知道？我又沒檢查過你的牙齒或是眼睛……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: 我們已經沒救了。要嘛就是遭受偽人的毒手，要嘛就是遭到太陽的灼燒……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: 希望已經破滅，死亡終將降臨——做什麼都沒用。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: 不要管我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: 嘿、嘿嘿。希望這一切能早點結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: 你怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: 偽人——它們要來了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: 難道你聽不見嗎？死亡在召喚我們。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: 不管是偽人、抑或是人類……二者又有何不同？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: 死亡面前，眾生平等。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: 既然如此，又何必懷抱虛妄的期盼、無謂地自尋煩惱？就讓它們來吧！哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: 對於我們來說，這樣才是最好的——就讓偽人來吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: 你看起來不太好
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: 難道，你瘋了不成？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: 我好得很——只是頓悟了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: 我，就是個偽人！哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: 我們與人類同根、同源，相差無幾！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: 就如同一枚硬幣的正反兩面一般！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: 來一同迎接死亡吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: 你知道自己說的話有多癲狂嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: 好吧，你讓我別無選擇
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: 我並沒有瘋——只是頓悟了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: 我，就是個偽人！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: 我們與人類同根、同源，相差無幾！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: 就如同一枚硬幣的正反兩面一般！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: 來一同迎接死亡吧——誰都逃不過這命運！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: 你知道自己說的話有多癲狂嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: 好吧，你讓我別無選擇
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: 不、不，你什麼都不懂！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: 死亡即將降臨——太陽即為先兆！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: 我們很快就會再見面的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: 還在等什麼呢？來，開槍吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: 不知，你殺人之後是否會感到哪怕一絲的悔意？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: 罷了，我又何必在乎。哈哈哈！想要怎樣都隨便你，人類！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: 怎麼，有什麼事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: 話說，你為何會被趕出酒吧？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: 因為這一連串的災變把每個人都逼瘋了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: 太陽不斷爆發、偽人暗中進犯、經濟遭遇危機——各式各樣的問題接憧而至。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: 把大家全搞垮了——其中的一些不堪重負，還有的一些借酒澆愁。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: 而我……則因憤怒而失去了理智。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: 我跳上了酒吧的桌子、高聲喊道——「媽的！別再把一切都怪罪於周遭了，要在自己的身上找問題！」'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: 唉……就該讓他們繼續哭哭啼啼。即便淚水滴落進了啤酒的泡沫裡，也不會造成絲毫的影響……佐以鹽分之後，麥芽和酒花反而能更顯風味。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: 誰又會需要此等苦澀呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: 怎麼，有什麼事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: 對比酒吧，這裡有什麼不同嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: 我現在已經不會再去理會任何人了，沒這個必要、也並不值得。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: 不過，每當電視的聲音傳入耳中、或是無意中聽見他人交談時，內心的火焰就又會燃起。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: 然後，我還是停下了。畢竟……一切都費力不討好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: 我早就已經受夠了——我的意志早已支離破碎。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: 生活本就非常苦澀，現在更是……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: 總有一天，我會自縊於吊燈之上、告別這受到陰影籠罩的世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: 怎麼，有什麼事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: 一切可好？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: 嗯？問這個幹嘛？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: 我從你身上聞到了一股味道
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: 難道，你發燒了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: 哎呀……我喝了一些你的啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: 我感覺不太舒服，因此小酌了一口——沒什麼大不了的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: 媽的，真是一團糟。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: 每個人都嚷嚷著說自己正在解決問題，而實際上全在鬼扯——到頭來，根本就什麼都沒有改變。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: 說不定，我們都沒幾天可活了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: 即使太陽沒有燒死我們，偽人也會殺死我們。即使驅除了這些不速客，我們也會自掘墳墓。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: 即使沒有問題，我們也會自己去製造問題……媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: 就好像是一種永無止盡、極其病態的癡迷，沉醉於一種驚慌失措、自亂陣腳的狀態。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: 媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: 滾吧，我感覺不太舒服。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: 發燒的不是我，而是這一整顆行星。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: 不管何處，人們都在接二連三地死去。冰川正消融，森林正燃燒——這個世界得了熱病。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: 地球想要擺脫我們這些早已飽餐一頓的吸血害蟲。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: 總有一天，它會成功……而且，絕對不會讓我們死得毫無痛苦。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: 呸……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: 給我滾吧。拜託，我感覺不太舒服。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: 怎麼，有什麼事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: 感覺好些了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: 老兄……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: 人生在世，終有一死。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: 不知，你是否想過我們死後會有什麼歸宿？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: 只要我們心懷信仰，就能前往美好來世
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: 一無所有
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: 我不知道——也許，會飄浮在太空中？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: 不無道理。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: 不過，這他媽的並沒有令我感到好些——知道為什麼嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: 彌留之際，我的大腦就會感知到死亡將至……然後開始呈現一些值得回溯的美好片段。譬如，天國的景象——一個比這裡更好的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: 而耗盡最後一絲維繫住這片如夢似幻之時光的力氣之後，又會剩下什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: 不——我並沒有感覺好些。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: 真希望你能給出其他的答案。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: 雖說真的有可能會是這樣，只是……實在令人毛骨悚然。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: 一無所有……只剩黑暗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: 我不想再繼續聊下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: 其實，仔細一想……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: 太空之中除了我們之外，應該就再無他物。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: 沒有其他生命，只有冰冷、虛無。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: 畢竟要是真有的話，我們早就應該發現諸如某種信號之類的東西了——對吧？雖然，我也無法一口咬定就是了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: 無盡的黑暗……如果這就是我們死後的去處，跟煙消雲散又有什麼不同呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: 我……我想要一個人靜一靜。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: 怎麼，有什麼事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: 你……你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: 起碼，酒吧的天花板很高。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: 隨時都可以上吊自盡。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: 於我而言，這裡太過擁擠——甚至，就連這一整顆行星都令我感到喘不過氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: 老兄，我只求這一切能趕緊結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: 真是一團糟。每樣東西、每件事情都把我給嚇得夠嗆。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: 我已經無法再忍受下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: 我為何要到這裡來？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: 真想好好休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: 不知，你有什麼需要嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: 我只需要他活著。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: 除此之外……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: 別無所求。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: 不如，我給你拿點水來吧？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: 不知，你是否想吃點什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: 就坐在水龍頭旁邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: 渴了的話，會自己喝。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: 好吧，我就不打擾你了
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: 我能和你坐在一起嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: 我並不餓。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: 只想坐著。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: 好吧，我就不打擾你了
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: 我能和你坐在一起嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: 為何，你要離我而去？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: 不是曾經答應過我，一切都會好起來嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: 不是信誓旦旦地說，不會有什麼事的嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: 然而，卻撒手人寰了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: 現在，只剩下我一人——孤家寡人、無依無靠。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: 為何，要這樣對待我？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: 我想要和他在一起。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: 而你，無法令任何人起死回生。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: 我甚至沒有辦法……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: 好好安葬……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: 我甚至沒有辦法好好安葬他。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: 我該如何是好？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: 真想好好休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: 請問，他是怎麼死的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: 我無法開口。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: 這一切實在是難以承受。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: 我已經流乾了眼淚。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: 我已經沒有眼淚可流了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: 只是，這樣真的對嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: 我不能就此停止哭泣……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: 我想，你需要好好安葬他
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: 接受現實吧——他早就已經不在了
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: 不……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: 不、不、不！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: 我還沒做好心理準備。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: 我才剛從那些傢伙的手裡將他奪回。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: 然而，現在卻又要分開？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: 我做不到。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: 我不會把他埋在冰冷的土壤之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: 不。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: 不是這樣的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: 我知道他還能聽見我說話。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: 真的想要如此相信。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: 真想好好休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: 關於他，你都記得些什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: 某天，我們一起去好友的家裡做客。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: 當時，彼此都還很年輕。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: 大家一起嬉戲打鬧、盡情痛飲。平時他就挺怏怏不樂的，於類似的聚會上也基本上不太說話。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: 沒記錯的話，當天可以說是喝了個天昏地暗。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: 而他，也一如既往地非常安靜。不過，卻突然之間開口了：'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: 「快把吉他拿來，我要高歌一曲。」'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: 我被他的彈唱給深深地吸引住了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: 大家開始七嘴八舌地點起歌來，而他則是愣了一下——然後……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: 就站了起來，說自己有事需要先走了。結果不小心碰翻了杯子，想要去抓住它的時候還把吉他給掉地上了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: 之後我才發現，他只會這一曲——千辛萬苦地學會，只是為了打動我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: 我還有一張當時的照片呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: 雖然已經稍微有點破舊了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: 現在，你已經唱罷最後一曲、再也無法為我彈奏了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: 真想好好休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: 請問，他出什麼事了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: 還用問嗎？他死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: 清楚、明白——抱歉，打擾了
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: 又不是我殺死了他
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: 不好意思，我實在是沒辦法……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: 每晚，我都以淚洗面、無法抑制。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: 不過，最重要的是——我希望……造成這一切的罪魁禍首能受到太陽的灼燒、痛不欲生地死去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: 所以……他到底出什麼事了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: 我就不再向你打聽此事了吧
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: 沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: 我知道這樣非常的失禮，只是……我真的很難開口談論他。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: 希望那些雜種會遭受報應。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: 希望有人可以殺之而後快。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: 所以……他到底出什麼事了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: 我就不再向你打聽此事了吧
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: 我的丈夫感到不太舒服，因此前往醫院進行診斷。結果，卻被醫護人員給打發走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: 說讓我們去FEMA所開設的一處中心。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: 抵達之後，他們便不由分說地把我的丈夫給隔離了起來——就連電話都被收走了，聲稱三週之後就會放他離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: 我實在按捺不住、提前到那裡去了，想要看看他怎樣了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: 然而，他們卻冷酷地……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: 抱歉，讓我緩一緩。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: 對我說——「他已經死了。」'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: 之後，再無下文。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: 既不讓我去查看他的遺體。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: 也不允許我將他給帶回家。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: 不過，這群傢伙蠢得要命、甚至連自己繫鞋帶都做不到。因此，我只需要找一件實驗服給自己套上、然後徑直前往太平間即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: 而他……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: 真的躺在裡面……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: 那些雜種殺了他——他們的手上沾滿了他的鮮血。而我，卻只能無力嚎叫、不再關心任何人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: 我想一個人靜一靜。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: 好的，謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: 沒有他的生活，實在太過煎熬……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: 真想好好休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: 出什麼事了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: 我今晚就會離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: 之前就已經說過，我並不會待太久。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: 只是需要休息一下，僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: 接著打算怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: 要回到家裡去嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: 我……並不願意去想。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: 我會回家。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: 把吉他給拿出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: 然後……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: 如果願意，也可留下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: 祝你好運
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: 已經一人不剩。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: 我們要回家了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: 我已再無他求。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: 如果願意，也可留下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: 祝你好運
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: 為什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: 這樣也並不會讓我覺得好些。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: 而且——無意冒犯，不過我對你一丁點的興趣也沒有。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: 我只是想要回家。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: 回到自己的歸宿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: 謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: 雖然你並不怎麼說話，不過……卻是一個不錯的傾聽對象。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: 希望你能找到自己正在追尋的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: 嘿嘿，怎麼啦？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: 災變開始之前，你是做什麼工作的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: 哎呀，問得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: 不知，你是否有聽說過……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: ……體育賭博？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: 難道，你是個騙子？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: 的確聽說過
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: 哎喲，這也說得太難聽了一點！我他媽的可是個分析師。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: 要是你知道究竟有多少錢流進了我手中的話，一定會饞得流口水。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: 我可是個專業人士，而且熱愛自己的事業。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: 只要把錢交給我，就能拿回五倍……不對，十倍、甚至遠超於此的數額。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: 那麼，你究竟賺了多少？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: 不是，你管這叫工作？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: 我就是以此為生的！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: 透過正規的途徑下注？拜託，會這樣做的不是蠢到家就是窩囊廢。真的，兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: 總有辦法可以騙過莊家。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: 只要把錢壓在關鍵的地方，然後歇著——財源自然會滾滾來！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: 如果沒錢，也不打緊——找人去借就是。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: 那麼，你究竟賺了多少？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: 不是，你管這叫工作？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: 我該怎麼說呢……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: 我一共積累了三千萬……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: ……的債務。不過，這並沒有對我造成任何的負擔！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: 而且，現在也根本不需要再去理會了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: 我可不會因為一點小小的危機就退縮。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: 怎麼，有什麼問題嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: 沒錯，這就是份工作！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: 我甚至還有一處用於辦公的地方呢。哎呀，那裡可謂奢華至極！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: 不光有一張閃閃發亮的沙發，還有一台記著莊家名字、欠款金額和淨利的筆電。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: 嘿嘿，怎麼啦？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: 討債人還沒來找你的麻煩嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: 討債人？去他媽的討債人吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: 要知道，我已經擺脫了所有債務——太陽都幫忙處理好囉。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: 銀行早就已經無能為力了，甚至有可能就此一蹶不振！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: 換句話說，老子他媽的已經自由了——不過，還得繼續奮鬥下去就對啦！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: 投注已經過時了，我得想點新花樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: 於你而言，太陽的爆發反而是件好事
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: 也就是說，你又要繼續開展自己的……「事業」了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: 哎呀，拜託——話也不能這麼說。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: 總之，我都已經想通了！要嘛翻倍贏，要嘛輸精光！每次都是這樣——輕輕鬆鬆、小事一樁！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: 不過，現在……我可以重新開始了。真是不錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: 順帶一提，我剛剛想到了一個新的法子。想知道嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: 洗耳恭聽
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: 不感興趣
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: 就在不久之前，我想到了一個超棒的賺錢法子——要是感興趣的話，我可以與你分享。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: 洗耳恭聽
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: 不感興趣
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: 現在，這一帶基本上是處於FEMA的掌管之下。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: 我們得，怎麼說……稍微跟他們拉一下關係，知道吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: 要是可以定期將其他人給送過去的話，說不定甚至會把我們帶進地堡避難呢！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: 懂我的意思吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: 不是，你想要把其他人「進貢」給FEMA？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: 難道，你覺得FEMA能拯救自己？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: 沒錯。媽的，為什麼不呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: 不要畏手畏腳。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: 非常時期，非常法子。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: 隔離區是給那些沒有半點主見、只會盲從的傢伙準備的。想也知道，裡面根本不會有什麼好事發生。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: 因此，我們一定要跟FEMA搞好關係。拍拍馬屁，巴結他們。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: 也沒有必要太過諂媚，只要把其他人給送過去……滿足他們的需求就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: 對了……對了——甚至還能給他們打電話說明一下我們已經檢查過對方的確具備相應的特徵——這樣一來，他們就會知道我肯定不是個……叫什麼來著？對了，偽人！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: 他們都是好人，我們大可放心。真的，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: 或許，你是對的
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: 簡直一派胡言
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: 既然你這麼想要與他們為伍，就他媽的趕緊給我滾過去吧
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: 該死，你怎麼就感受不到這股變革之風呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: 我們要看清是誰在背後掌控大局，然後向對方獻上自己的絕對忠誠。此為致勝之策，絕無半點虛假——知道嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: 因此，我們一定要跟FEMA搞好關係。拍拍馬屁，巴結他們。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: 也沒有必要太過諂媚，只要把其他人給送過去……滿足他們的需求就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: 對了……對了——甚至還能給他們打電話說明一下我們已經檢查過對方的確具備相應的特徵——這樣一來，他們就會知道我肯定不是個……叫什麼來著？對了，偽人！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: 他們都是好人，我們大可放心。真的，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: 或許，你是對的
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: 簡直一派胡言
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: 既然你這麼想要與他們為伍，就他媽的趕緊給我滾過去吧
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: 我，當然是對的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: 對於能賺大錢的法子，我的第六感非常的準。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: 相信我，就絕對不會吃虧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: 哎呀，拜託——這才不是什麼一派胡言。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: 大家以前還得花錢來購買這些投資建議。我現在毫無保留地傾囊相贈，而你卻……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: 給我去死吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: 怎麼，難道你是想要把我給踢出去還是怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: 我還以為你是個好人來著。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: 我甚至就連賺錢法子都傾囊相授了，而你卻……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: 給我去死吧，我要離開了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: 哎喲，我想出來的這個法子真的挺不錯的。既然如此，好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: 如果改變主意了，隨時跟我說一聲。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: 嘿嘿，怎麼啦？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: 你想怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: 我想到了一個新的法子，而且——不騙你，一定能成功。快來聽聽。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: 好了，基本上……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: 現在，到處都熱得像個蒸籠。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: 我想，大概是由於臭氧層遭到了破壞。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: 然而，我記得氧氣是因陽光照過臭氧層而產生的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: 如何，猜到我要說什麼了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: 沒錯，就是——售賣空氣！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: 相信我，這絕對能賺大錢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: 真是個了不起的計劃，真他媽令人嘆為觀止
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: 我這輩子都沒聽說過這麼蠢的事情
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: 真的嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: 沒錯，你應該去當一名科學家
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: 假的
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: 哎呀……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: 謝謝！終於有人看出我這頭腦裡蘊藏的智慧了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: 媽的——說不定，我很快就能贏得達爾文獎啦！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: 你……應該知道什麼是達爾文獎，對吧？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: 我敢說，實至名歸
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: 就是……頒發給對科學或者其他的什麼領域有所貢獻之人的獎項。總之，就是宅到爆啦——沒錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: 不過，問這個幹嘛？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: 沒事，隨便問問而已
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: 達爾文獎是頒發給死法極其愚蠢之人的獎項
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: 哈哈，我現在就已經能想像受到認可是怎樣的一種滋味了。通通給我跪下，科學之王駕到！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: 數之不盡的財富、受人敬仰的地位、投懷送抱的美女……哈哈，真是棒極了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: 好啦——當這一切都結束之後，我一定要為「售賣空氣」這項事業申請專利。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: 我就知道你一定能懂，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: 哎呀……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: 不對，你這是在取笑我嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: 去你媽的吧。我正絞盡腦汁地想要提出一項正經八百的賺錢計劃，而你卻在嘲笑我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: 去你媽的吧。我正絞盡腦汁地想要提出一項正經八百的賺錢法子，而你卻在嘲笑我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: 我會贏得達爾文獎，然後成為一個闊佬！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: 而你，則會拜倒在我的腳下、乞求我的原諒……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: 'Scammer: 因為自己曾經出言不遜，說——「帶著你的垃圾法子給我滾吧。」'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: 該死……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: 好好地聽我講話就這麼難嗎，嗯？我不小心把你給惹到了還是怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: 去你媽的吧——沒有你，我反而能賺得更多。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: 該死……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: 去你媽的吧。我正絞盡腦汁地想要提出一項正經八百的賺錢法子，而你卻在嘲笑我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: 我會贏得達爾文獎，然後成為一個闊佬！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: 而你，則會拜倒在我的腳下、乞求我的原諒……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: 該死……看來，這一切都是真的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: 好吧，我還真是一語成讖。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: 千萬不能在白天外出，記得要讓其他人進屋。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: 為何要讓陌生人踏進我的房子？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: 讓其他人進屋？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: 我知道你更傾向於與其他人保持距離，不過——你必須得這樣做。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: 我的表親並不是很確定為何不能獨自一人待在家裡……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: 不過，她有特地提到——如果有人上門詢問你是否獨自一人，一定要回答說家裡還有其他的住客。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: 我並不喜歡與他人打交道
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: 人變多了，又會如何？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: 沒錯……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: 我知道你更傾向於獨來獨往，不過——你必須得讓其他人進來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: 我的表親並不是很確定為何不能獨自一人待在家裡……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: 不過，她有特地提到——如果有人上門詢問你是否獨自一人，一定要回答說家裡還有其他的住客。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: 我並不喜歡與他人打交道
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: 人變多了，又會如何？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: 我記得很清楚。我知道這對你來說並不簡單，然而除此之外、恐怕別無他法。否則，我們都活不下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: 對方可能會帶來某些東西，或者是跟你分享一些趣聞。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: 此外，千萬不要忘記對他們進行檢查、看看是否具有偽人的一些特徵。現在熱成這樣，白天的時候你應該不會有太多的能量。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: 因此，需要謹慎挑選對象。進行檢查得耗費大量的精力，一定要仔細觀察。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: 不過，交談並不需要消耗能量。因此，不必擔心——想聊的話，就儘管聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: 還有就是，也要三不五時地去看看窗外的情況。雖說能從電視上獲取一些相當有用的資訊，然而它並不會告訴你自己的周遭都發生了什麼事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: 然後呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: 我們需要做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: 對方可能會帶來某些東西，或者是跟你分享一些趣聞。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: 此外，千萬不要忘記對他們進行檢查、看看是否具有偽人的一些特徵。現在熱成這樣，白天的時候你應該不會有太多的能量。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: 因此，需要謹慎挑選對象。進行檢查得耗費大量的精力，一定要仔細觀察。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: 不過，交談並不需要消耗能量。因此，不必擔心——想聊的話，就儘管聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: 還有就是，也要三不五時地去看看窗外的情況。雖說能從電視上獲取一些相當有用的資訊，然而它並不會告訴你自己的周遭都發生了什麼事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: 然後呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: 我們需要做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: 恐怕，我們唯一能做的拚命地活下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: 然後，祈禱這場夢魘能趕緊結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: 我想，政府應該會透過某種途徑來幫助我們的。也許，會帶所有人去避難——諸如此類的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: 若是果真如此，就跟我的家人待在一起吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: 哎呀，差點忘了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: 我明晚就會回家。來，記下我的號碼吧——這樣一來，彼此之間就能隨時互通有無了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: 我們家最近剛安裝好線路。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: 之後，就透過電話聯絡吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: 好啦，應該已經沒有什麼其他漏掉的事情了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: 對了，我還給你帶了一箱啤酒——我的連襟在釀酒廠工作。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: 喝了之後，就去睡覺。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: 因為只要來上一口，就會讓人非常想睡。要是不想跟其他人聊天的話，就去喝上個一瓶、然後好好放鬆吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: 我……我要媽、媽媽。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: 跟我說說，發生了什麼事情吧
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: 我不——知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: 突然之間，它們就闖了進來、大聲講話。爸爸說這樣不對，結果它們卻說……它們卻說……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: 爸爸！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: 爸——爸——！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: 好吧……現在，還是先好好休息一下吧
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: 我們明天再繼續聊吧，好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: （女孩不停地喊著自己的爸爸，失控的情緒應該一時半會都無法平靜下來。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: （女孩獨自一人沉浸在悲傷之中，根本就沒有聽到你在說什麼。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: 我……我要媽、媽媽。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: 如何，喜歡這個地方嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: 挺不錯的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: 不過，還是待在自己家裡更好……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: 我什麼時候可以回去？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: 還需要再等一段時間……現在正重新粉刷呢
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: 恐怕近期都回不去了，你的家已經被燒毀了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: 好吧。也就是說，他們很快就會來接我了——沒錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: 不知，他們是要帶我去新家……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: 抑或，會回去之前住的家呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: 還有，他們會給我佈置一個新的房間嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: 總而言之，爸爸還是會來找我的——沒錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: 其實，你也清楚發生了什麼事
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: 現在，就暫且先待在我這裡吧
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: 不過，爸爸應該沒事吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: 還有就是，我的房間怎麼了——也一樣被燒毀了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: 媽媽不會來找我們了？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: 已經一個人都不剩了？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: 其實，你也清楚發生了什麼事
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: 現在，就暫且先待在我這裡吧
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: 我不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: 我不確定。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: 雖然它們打了爸爸，不過我看到他又站了起來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: 也就是說……也就是說，他有可能撲滅了火焰。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: 又或者，已經在來找我的路上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: 我想，他應該馬上就會到了——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: 沒有爸爸的話，我哪裡都不去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: 我想，他已經在來接我的路上了——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: 我親眼看到他站了起來、然後離開了的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: 雖然我當時正在拚命逃跑，不過還是看得非常的清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: 我……我要媽、媽媽。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: 還是接受這一切吧
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: 這是什麼意思？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: 我看到了你的房間有台電視——我能到那裡去看一下卡通嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: 我不知道你究竟看到了什麼，不過你的爸爸應該已經死了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: 我想，你的爸爸可能不會來找你了。我……不知道他發生了什麼事
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: 既然不知道，就不要亂講！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: 我當時就在現場——我拚命逃跑的時候、他也正在有所動作。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: 也就是說，他很快就會來的！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: 既然如此，為何他還沒來找你？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: 最後一次見到你爸爸的時候，他看起來如何？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: 為何要這麼說——他不會來了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: 既然如此，為何他還沒來找你？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: 最後一次見到你爸爸的時候，他看起來如何？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: 或許，他得先處理其他事情？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: 譬如，把那些壞蛋給狠揍一頓……之類的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: 他……他應該很快就會來到這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: 對於你爸爸的遭遇，我深表遺憾——他是個好人，卻太過善良
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: 好吧、好吧，你的爸爸應該快要來了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: 沒錯，他是個好人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: 然而，它們卻打了爸爸……接著……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: 我不記得了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: 對於你爸爸的遭遇，我深表遺憾——他是個好人，卻太過善良
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: 好吧、好吧，你的爸爸應該快要來了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: （女孩的雙眼似乎能將你看透、把你嚇得不敢動彈，只能靜靜地等待現狀有所發展。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: （一會之後，她號啕大哭了起來。對此，你無能為力。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: （繼續讓她活在謊言之中的話，情況只會變得更為糟糕——她必須盡快接受現實。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: 嗯嗯，我也是這麼想的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: （女孩變得心不在焉，顯然是陷入了思考。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: （不過，難道把她的童年給毀掉就會比較好嗎？她真的能承受住這一切帶來的衝擊嗎？）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: （現在，她要面對的問題早已堆積如山。沒有必要讓她更為傷神——你如此認定。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: 哎呀，寶貝——我的年紀已經很大了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: 你是從哪裡來的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: 沒錯——這樣做……有什麼問題嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: 大家總是要求我講一些故事，聽完了之後卻因此而討厭我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: 真是難以理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: 我自己也有一棟房子——準確來說，是一間小屋。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: 雖然我非常喜歡那裡……不過，要是沒人陪伴的話、我整個人都會蔫掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: 再說，又有誰願意去借宿於一間小屋中呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: 因此，我不斷徘徊。畢竟，也已經沒有什麼東西可以失去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: 哎呀，寶貝——我的年紀已經很大了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: 你為什麼會無依無靠、孑然一身？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: 都是一些稀鬆平常的故事——一邊四處生活、一邊慢慢收集。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: 然後，轉而向他人敘說。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: 我已經是一個老太太了，沒辦法很好地記住它們——因此，我會以自己的方式來進行講述。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: 說不定，與我分享這些故事的人會因此而怨恨我呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: 大家都說——「最難承受的並非悲傷本身，而是擔憂悲傷將至的心情。」'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: 不過，喜歡給故事添油加醋的人可不止我一人——這，你應該懂吧？嘿嘿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: 最終，大家都會聚到我這裡來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: 畢竟，大家都需要故事的滋潤。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: 哎呀，寶貝——我的年紀已經很大了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: 你為什麼沒有跟自己的丈夫在一起？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: 不知，你想聽什麼樣的故事呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: 人類是一種總是在瞻前顧後、憂心忡忡的生物。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: 我曾經認識一個把自己封閉起來、與世隔絕的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: 一個人住在高層建築——不光把自己鎖在了居處，而且從來都不到外面去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: 不是害怕偽人、就是畏懼死亡。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: 其實，根本就沒有人到過他那裡去。而且，他也絕對不會放其他人進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: 結果，某天……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: 我聽到了一聲不太悅耳的巨響——就像是在用不鏽鋼湯匙在刮裝了草莓果醬的罐子一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: 不知道出了什麼事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: 然後，我看出窗外——發現，他躺在了地上。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: 他跳了下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: 如何，喜歡這個故事嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: 並不喜歡
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: 說完了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: 大概，這就是沒人喜歡我的原因吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: 記好……總有一天，我也會以自己的方式來講述你的故事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: 沒錯，他摔得血肉模糊。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: 不管是害怕因太陽的爆發而痛苦地死去、還是其他的什麼事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: 總而言之，我想——他應該是難以獨自一人繼續再承受這一切了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: 不過，又能怎麼辦呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: 哎呀，寶貝——我的年紀已經很大了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: 之前好像是講到……你走到路邊，坐在長凳上？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: 好的、好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: 我老家的村莊裡，有著這樣的一個人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: 雖然並不是很清楚原因，不過他喜歡漫步於林間。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: 總而言之，就是這樣。某天，他再度漫步於林間之時，發現自己好像分不清方向、找不到回去的路了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: 他停了下來，整理起思緒。心想——事已至此，只要不停地往前走、總會到達什麼地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: 於是，他不停地走著、卻仍找不到出路。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: 最終，他意識到自己正在原地打轉！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: 然後呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: 真是愚蠢
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: 大家在裡面找到了他的屍體。換句話說，他根本沒能成功地走出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: 我們跟隨他的足跡、發現他其實一直都在同一個地方轉圈。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: 正如常言道——我們其中的一條腿所邁出的步子要更大一點。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: 現在，他應該已經爛囉。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: 為什麼？難道，你不喜歡這個故事嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: 雖說，我的確……稍微添油加醋了一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: 然而——大差不差，確有其事。甚至，這樣的事情其實有可能發生在任何人身上！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: 大家一直在不斷向前，結果卻總是迷失道路。他們又是怎麼找到出路的呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: 我只想好好地養精蓄銳……要是有人能借我一些力量，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: 不知，你的姊妹狀況如何？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: 我需要幫她處理各式各樣的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: 昨天，我終於給她洗了個澡。之前還待在家裡的時候，她甚至連浴缸也進不去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: 雖然一如往常，不過——還是謝謝關心。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: 患有抑鬱的人……非常複雜。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: 現在這個世道，即使下一刻就要立即逃走也不足為奇。然而……我擔心這樣的狀況來臨之時，她的內心無法接受、沒有辦法做到這一點。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: 又或者是，僅僅是因為太過虛弱而不去進食。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: 我也已經非常累了，需要稍微休息一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: 我只想好好地養精蓄銳……要是有人能借我一些力量，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: 接下來，你有什麼打算？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: 問得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: 我的丈夫應該很快就會到這裡來。希望他可以找到一個安全的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: 一個能讓我們熬過偽人襲擊、烈日熱浪的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: 據他所說，像這樣的地方的確存在。還有就是，他並不覺得太陽會爆炸。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: 畢竟，要是真的話……我們都會灰飛煙滅，整個過程甚至只要幾分鐘而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: 我認為他說得很對。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: 我只想好好地養精蓄銳……要是有人能借我一些力量，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: 如何，收到你丈夫的聯絡了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: 不知為何，他並沒有聯絡我——既沒打電話、也沒到這來。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: 不知道是不是出了什麼事？不知道是不是遇到了麻煩？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: 我敢斷言——他並沒有拋棄我們。唯獨此事，絕無可能。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: 即使他已經徹底對我的姊妹感到了厭煩，卻還是一如既往地幫我一起去照顧著她。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: 他……他大概已經在路上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: 而且，我的姊妹也比之前要好些了……沒錯，他應該快到了。然後，一切都會好起來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: 我只想好好地養精蓄銳……要是有人能借我一些力量，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: 你看起來很憂傷
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: 嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: 大概吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: 我想了一些事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: 要是太陽並不會爆炸的話，這股熱浪又為何尚未消散？而且，大家又為何總是把「世界末日」這四個字掛在嘴邊？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: 我看了新聞。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: 雖然沒有明說，不過白天的氣溫似乎變得越來越高了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: 氣候正在改變。也就是說，動物將會因無法適應這全新的……天氣而一一死去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: 我們到底會變成什麼樣啊？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: 我只想好好地養精蓄銳……要是有人能借我一些力量，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: 嘿，還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: 我……昨晚出去尋找自己的丈夫了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: 我到他可能會在的幾個地方去看了看。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: 結果，於其中一處找到了——然而，他卻已經服下了毒藥。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: 我們……我們之前為了以防萬一而購買的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: 他吃了一顆。他太害怕了。他拋下了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: 他服了毒藥。關於太陽，卻是隻字未提。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: 末日已至。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: 嘿，還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: 我感覺……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: 好像有一條非常、非常沉重的毯子。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: 死死地壓在了我的身上。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: 我……不喜歡這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: 末日已至。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: 看來，你今天似乎變得稍微有點精神了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: 是的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: 太陽快要爆炸了——這件事你知道嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: 我昨晚才知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: 也就是說，世界末日已經來臨了？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: 我們的存在將會被徹底抹除？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: 真是引人深思。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: 末日已至。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: 不知，你的姊妹狀況如何？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: 她非常害怕會失去一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: 照我看來，其實我們早已一無所有。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: 於這個不斷膨脹著的宇宙之中，我們只是無足輕重的塵埃罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: 我們將不會被需要，因為早已再無他人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: 如果整顆行星都灰飛煙滅，就不會再有人為我們哀悼——這件事也會一同失去意義。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: 而我的姊妹非常害怕這一點。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: 末日已至。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: 請問，你的姊妹是生病了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: 沒錯。她決定去尋找自己的丈夫，好不再去想一些壞的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: 我有預感——這並不是什麼好主意。不過，她實在是坐不住。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: 如果她依然想要去找他，我也會跟著她一起前往。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: 死亡帶走我們之前，我並不想要失去她。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: 末日已至。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: 如何，你們外出了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: 沒錯。她……找到了自己丈夫的屍體。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: 告訴她一切都會好起來的之後，他自己卻因畏懼真相而自殺了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: 我想，她應該已經身心俱疲了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: 現在，我會照料好她。直至，死亡帶走我們。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: 而且，終於——再也沒有什麼東西需要擔心了，再也沒有什麼東西需要害怕了，再也沒有什麼東西需要畏懼了，再也沒有什麼東西需要羞愧了。'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: .……'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: 該死……*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: 兄弟……要是不太麻煩的話……能否幫忙聯絡他們？{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: 我不是想讓他們接我……也不是想跟他們道別……只是想告訴他們一聲……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: 爸爸並沒有逃跑。而是……留在了需要他的人身邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: *咳嗽*這才是最重要的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: 怎麼，有什麼事情想要與我分享嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: 不知，這都是一些什麼文件？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: 你一定不會相信這些檔案都包含著些什麼。其中的一些可以說是……令人讀起來饒有興味。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: 譬如，這裡闡述了一個相當離奇的理論。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: 聲稱偽人根本就不存在，整件事情只不過是政府想出來解決人口過剩問題的計劃之一罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: 不僅非常令人信服，而且……弔詭的是，仔細思考過後——也很合乎常理。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: 不管我們怎麼看待也好，人口過剩的確是個問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: 說不定，他們真的就是打算透過這種手段來將其「解決」。你覺得呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: 怎麼，有什麼事情想要與我分享嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: 還在研究這些文件嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: 沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: 我又找到了一些令人耳目一新的觀點——不知，你有興趣聽聽嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: 譬如，這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: 聽好，其實FEMA*就是*偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: 他們身穿的制服屬於全覆蓋式。也就是說，根本無法對其進行檢查。好像也說得通，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: 我特別喜歡這裡——作者竟然把FEMA的全稱理解為「徹底消滅人類的機構」。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: 真是耐人尋味。會不會……真的別有所指呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: 怎麼，有什麼事情想要與我分享嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: 好了，這次你又發現了什麼呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: 偽人——皮行者。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: 聽起來就像是從科幻小說裡跑出來的概念，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: 不過，背後確實有一定的道理。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: 其中一份報告提及目擊到了某個通體蒼白的傢伙在街上遊蕩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: 然而，我必須指出……作者犯了一個相當明顯的錯誤。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: 聲稱出現了兩個像這樣令人不安的人物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: 透過窗戶看見一個，大門前還站著一個。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: 拜託——根本就是同一個，不是嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: 'Theorist: 我大膽猜測，應該是窗戶使光線發生了折射——換言之，只不過是錯覺罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: 不過，還是非常的有趣就是了。你不這樣認為嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: 怎麼，有什麼事情想要與我分享嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: 如果是真的，該怎麼辦呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: 歸根到底，究竟什麼才是真的呢？這是一個流動的概念，會隨著視角的不同而發生改變。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: 對於某些人來說或許是真相，對於其他人來說反而是妄想。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: 正所謂汝之砒霜，彼之蜜糖。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: 自古以來，人類對此的爭論從未停歇。而現如今？道德準則早已徹底亂成一團。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: 如果你和我一樣有著足夠強大的意志，你信仰的一切對你來說就是真相。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: 嗯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: 真是一篇有趣的文章。好了，我們說到哪裡了？對了，真相。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: 記好——真相只有一個：其實偽人就是大腦寄生蟲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: 一定要戴上耳塞，而且不管什麼時候都不要取下來。如此一來，就能萬事大吉了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: 不管怎樣，我想繼續進行研讀——還請不要來打擾我。我需要集中精神。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: 又怎麼了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: 你說自己之前在海關工作？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: 千真萬確。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: 話說，你有在檢查大家是否具備偽人的特徵——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: 我也不是在沒話找話啦，只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: 到底是哪個混蛋把這群傢伙命名為偽人的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: 直接管它們叫「怪胎」不就好了，既簡單、又明瞭……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: 又怎麼了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: 為何如此憎恨偽人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: 這是什麼白癡問題？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: 就是因為這群傢伙，世界成了人間煉獄！你都不看新聞的嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: 太陽不斷爆炸、大家橫死街頭，全是它們害的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: 我對天發誓：要是可以的話，我會把它們通通殺光、消滅殆盡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: 只要花上一點時間，我就能把它們都給揪出來——就像之前在邊境時做的一樣。你就擦亮眼睛等著瞧吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: 竟敢不錄用我，FEMA錯得離譜……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: 又怎麼了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: 為何如此渴望替FEMA工作？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: 非常簡單，因為我特別看重這件事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: 我們應該阻止這些不速之客——我們也的確有能力阻止它們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: 我就連鄰居都檢舉了，做了自己分內的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: 結果，你猜怎麼樣？他們竟然僱了我的丈夫，而不是我！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: 不過，不要誤會——對於自己的丈夫能被他們選上一事，我感到非常自豪。只是，唉……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: 說實話？就像是被狠狠地甩了一個耳光一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: 又怎麼了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: 為何把鄰居檢舉了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: 你的耳朵裡是不是堵滿了耳垢，沒聽清我說了什麼？拜託，我早就告訴過你了——他是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: 而且，他讓我感到很噁心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: 將他給檢舉的時候，我實在開心得不行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: 令我想起了以前在海關工作、保家衛國的美好日子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: 就在那時，我意識到自己非得成為FEMA的一員不可！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: 又怎麼了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: 你之所以會來這裡，不是為了自己的丈夫、而是為了FEMA——沒錯吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: 沒錯——這又怎麼了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: 我來這裡就是想大鬧一場，直至上面的傢伙注意為止。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: 對於他們拒絕給我一個工作機會一事，我要進行上訴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: 難以理喻——是我給抓住的偽人、是我盡的公民義務，而他們竟然把工作機會給了他？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: 天啊，我真的完全搞不明白。整件事情都蠢到家了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: 我恨死他了，從頭到尾、從裡到外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: 能不能幫我一個小忙？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: 給他們打電話——直接撥內線就好，用這特殊的號碼：{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: 跟他們說，自己遇到了一個既有經驗、又有毅力的女性，一位不可忽視的人才。如果你覺得有必要，也可以提一下我的丈夫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: 盡量說得誇張一點。只要主動提出請求，說不定他們就會給我指派什麼任務。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: 又怎麼了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: 還是海關要更好一點吧？起碼，你還能夠手握一點權力
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: 不要想給我灌什麼迷湯！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: 我並沒有在詢問你的意見。況且，你也沒有比我好到哪裡去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: 你想要掌控一切，是吧？這棟房子是你的地盤，大家都是衝著你來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: 因此……誰會是偽人、誰不是偽人，全都由你一個人說了算。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: 然而，這根本就不是你的工作、而是FEMA的職責——你完全是在自作主張。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: 說說看，你憑什麼覺得自己比FEMA優秀？他們起碼手握正當的權力，你呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: 如我所料。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: 我……我只是希望自己能學會該如何去殺人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: 還是想要親眼看看我殺死一、兩個偽人嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: 其實……我改變主意了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: 我臨陣退縮了。我知道——非、非常抱歉。我突然意識到自己還沒有做好準備。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: 每當看見屍體，我就會犯噁心。需要好一段時間才能緩過來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: 只是……我聽說偽人就算死了以後，屍體也還是會動個不停。就好像……巷子裡的那個傢伙……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: 光是回想起來，就讓我的胃裡……翻江倒海*乾嘔*。我怕是這輩子都沒有辦法做好準備——抱歉……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: 我……我只是希望自己能學會該如何去殺人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: 巷子裡發生了什麼事情？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: 實在……非常難以啟齒。不過，我盡量試試看。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: 我本以為巷子裡會比較安全一點。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: 結果，剛一轉彎就感覺自己好像踏進了墳場。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: 數以十計的屍體橫七豎八地倒在地上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: 其中的一些甚至還在動！就好像……還沒死透一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: 而在巷子盡頭，站著一個傢伙、手裡還拿著槍。然後，他……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: 不了……就先說到這裡吧。我不想回憶起當時的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: 我……我只是希望自己能學會該如何去殺人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: 跟我說說站在巷子盡頭的傢伙吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: 他……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: 披著一件大衣，上面掛滿了一串又一串的手指和牙齒……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: 他的旁邊站著一個年輕的小夥子——孤立無援、一籌莫展。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: 他一邊大聲地吼叫起來、一邊拿槍指著這個孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: 他要求對方露出自己的牙齒，換來的只有此起彼伏的求饒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: 我躲在一個大型垃圾箱的後面。然後……我情不自禁地把自己代入到了這個孩子的視角。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: 他泣不成聲、苦苦哀求，希望眼前的這個傢伙可以饒自己一命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: 最終……槍聲響起。這個年輕的小夥子重重地倒在了地上——就像巷子裡的其他屍體一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: 就在那時，我意識到……現在，世上只剩下兩種人——獵人，以及獵物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: 我……我只是希望自己能學會該如何去殺人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: 即使不成為一名嗜血的殺手，也一樣可以好好地存活下去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: 你為什麼要說這種話？根本就是在胡說八道！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: 你之所以還活著，是因為露出了自己的獠牙——你是一名獵人！所以，根本就沒有人敢動你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: 要是人們都畏懼你的話——就不會遭遇什麼危險了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: 我不想變成他人的獵物。我不想一邊哭得像個懦夫、一邊迎接自己的死期。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: 正因如此，我想要學會該如何去殺人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: 我們在天上的父……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: 不知，你覺得這棟房子如何？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: 糟糕透頂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: 東倒西歪的牆壁，毫無道理的佈局。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: 而且，你告訴我——你是不是故意把我安置在自己所能找到的、最差勁的小房間裡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: 家具陳舊、破爛，搖搖欲墜。不光遭蟲蛀導致非常鬆垮，而且裡面很有可能已經住滿了飛蛾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: 甚至連一個適合掛上十字架的房間都沒有。如何，我有講錯嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: 全能之主……你為什麼要對我降下此等考驗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: 我們在天上的父……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: 如果你這麼討厭這裡，為何不離開呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: 難道你以為我願意踏進這塊遭人唾棄之地？要是修道院還在的話，我根本不會離開其聖牆的庇護。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: 難道你以為我會喜歡待在這堆殘垣斷壁之中？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: 如果我還有其他選擇，根本就不可能會到這個地方來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: 這裡散發著濃厚的殺人與死亡的惡臭——而我甚至敢打賭，你一定樂於沉浸其中！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: 只要認為對方是惡魔，你就會二話不說、痛下殺手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: 或許，你就是惡魔！不管是尖角、抑或是尾巴，很快就都會長出來！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: 不過，我並不懼怕你——天上的父會庇佑祂的子民。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: 我們在天上的父……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: 為何不待在自己的修道院裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: 首先，並不是我的修道院、而是全能之主的居所。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: 其次，都怪那群惡毒的褻瀆者。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: 這些傢伙竟敢玷汙聖所——願他們受到天上神焰的灼燒！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: 不僅強行闖入，還把我的羊群以及我本人都給趕了出去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: 將一切都據為己有，就好像自己才是修道院的主人一樣。真是一幫野蠻之徒！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: 我們活得堂堂正正——禱告、禁食，並行主的事工。而那些禽獸呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: 根本不用想，一定是把聖水當作賤酒一般痛飲。大為不敬！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: 願他們因此而嗆斃，阿門。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: 我們在天上的父……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: 這群「褻瀆者」究竟想要做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: 他們成群結隊地前來，骯髒不堪、喧囂不止——就像惡魔一樣尖叫著。對神不敬的粗野之人，一向如此！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: 之所以會這樣的理由？因為我不讓他們進去！我直截了當地告訴他們：未受洗禮之人，不得跨過這道門檻！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: 然後，他們變得怒不可遏……開始猛捶大門，試圖將其拆毀。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: 最終，他們破門而入、把我給趕了出去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: 你竟然對需要幫助的人見死不救？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: 我也可能會將你趕出去。
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: 聖所只會為沐浴聖光的民眾敞開大門。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: 即使他們想在烈日下尋求蔭蔽、或者是要躲避這些所謂的偽人，又怎麼了？並不重要。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: 哪怕天降火雨，神的殿堂也絕非這群怪胎的容身之所。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: 主只會對信仰祂的人予以庇護。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: 如果他們橫死街頭，也沒什麼大不了的——只不過是上天對他們降下了審判罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: 真是卑鄙……不過，這也輪不到我來評斷
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: 趕緊離開吧，否則——就不要怪我向你開槍了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: 你這無禮的傢伙！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: 難道，你瘋了不成？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: 我是上帝的僕人！被一群內心毫無信仰的害蟲給趕出了祂的居所……而你……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: 竟然敢嘲笑我、說我活該？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: 你並非人，而是毒蛇！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: 你也是一個褻瀆者！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: 我本希望你能理解。然而，你跟其他人根本就沒什麼兩樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: 我們都是上帝的僕人！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: 我們只能遵循祂旨意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: 祂的想法遠超眾人的想像——我等凡夫俗子自然是無法理解祂偉大的計劃。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: 真是卑鄙……不過，這也輪不到我來評斷
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: 趕緊離開吧，否則——就不要怪我向你開槍了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: 怎麼，突然裝起英雄來了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: 我並不稀罕你這個破爛地方，我一刻都不想繼續待在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: 再見。神怒終將降臨於你！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: 先說清楚，我本就沒有打算要留在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: 踏進這間房子的那一刻，我的內心立即意識到了——此地根本不受神的眷顧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: 或許，即使是現在、祂也正不斷地在跟我對話，告訴我趕緊離開這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: 再見。神怒終將降臨於你！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: 該死的傷口……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: 為何FEMA會找上你？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: 我也不太清楚具體緣由，不過……我能猜出個八九不離十。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: 我本以為只不過是一次慣例檢查罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: 不過，我敢打賭——一定是住在隔壁的婊子把我給出賣了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: 我們互相看不對眼。她找到了陷害我的機會、然後果斷將其付諸行動，聲稱我是個「偽人」。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: 她大概對此感到非常自豪吧……該死的毒婦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: 該死的傷口……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: 請問，傷口的狀況如何？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: 已經有所好轉了，真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: 之前就已經跟你說過，子彈直接穿體而出了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: 人類不該互相傷害。而這個傢伙？他竟開槍了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: 要是像這樣繼續下去的話，我們遲早會滅亡——如果在地上睡不著，只好在地下長眠了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: 然而，偏偏就是有人反其道而行之……不僅自己活在地獄裡面，還要將他人一起拖入其中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: 你真的該去親眼看看那個拿槍的瘋子，一個令人毛骨悚然的混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: 一個瘋子？不是FEMA把你給射傷的嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: 瘋子？什麼瘋子？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: 沒錯，我——的確是FEMA下的手，他……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: 跟我說實話
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: 就此打住吧，你根本就不會撒謊
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: 我是說……那個FEMA的瘋子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: 就在我們四目相對的時候……我意識到了對方非常危險。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: 我是說……當他從背後……向我開槍的時候。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: 跟我說實話
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: 就此打住吧，你根本就不會撒謊
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: 好吧、好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: 其實……我的確是從隔離區逃出來的，不過……並不是在當時遭受的槍擊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: 一位醫生幫了我一把，偽造相關文件、將我送了出去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: 我不能回家——因為那個該死的婊子還在，就是把我給檢舉了的鄰居。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: 於是，我四處尋找可以待的地方、想要保持低調。然後，就遇到了那個傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: 我開口詢問附近是否有什麼可以歇腳的住處。話音剛落……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: 就瞥到了他背著的霰彈槍、以及一串以牙齒和指甲製成的項鏈，而且身後的巷子裡屍體堆積如山。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: 就在那時，我意識到他是個徹頭徹尾的瘋子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: 糟糕，傷口又開始疼個不停。我想躺下來休息一會，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: 該死……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: 好吧，我會把來龍去脈給你一五一十地講清楚的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: 其實……我的確是從隔離區逃出來的，不過……並不是在當時遭受的槍擊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: 一位醫生幫了我一把，偽造相關文件、將我送了出去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: 我不能回家——因為那個該死的婊子還在，就是把我給檢舉了的鄰居。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: 於是，我四處尋找可以待的地方、想要保持低調。然後，就遇到了那個傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: 我開口詢問附近是否有什麼可以歇腳的住處。話音剛落……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: 就瞥到了他背著的來福槍、以及一串以牙齒和指甲製成的項鏈，而且身後的巷子裡屍體堆積如山。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: 就在那時，我意識到——他是個徹頭徹尾的瘋子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: 糟糕，傷口又開始疼個不停。我想躺下來休息一會，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: 該死的傷口……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: 拿著來福槍的瘋子之後怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: 好吧——繼續說說這個渾身上下掛滿牙齒和手指的怪胎。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: 一看到我的臉上表現出了疑慮，就立即拔出槍來、對準了我。我設法握住了它，雙方扭打在一起。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: 我們都在爭奪這把唯一的武器。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: 突然之間，他扣下了扳機——接著，我給他來了一發頭槌、把他給敲暈在了地上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: 然後，我便死命地逃跑……直至感到腹部湧現出了一陣劇烈的疼痛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: 向下一看，全都是血。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: 我之所以沒有跟你說自己是被他射傷的，是因為怕你知道了有可能不會讓我進來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: 如今這個世道，人不為己、天誅地滅。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: 說實話……要是你知道有個持械的瘋子在追著我的話，還會允許我留下嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: 我需要一個能為自己提供庇護的地方。我不想像巷子裡的其他傢伙一樣死去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: 沒錯……我承認自己是說謊了。希望你可以原諒我，不要因此而趕走我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: 好吧——你可以留下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: 我實在無法信任你——就此離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: 謝謝。非常感激你能理解，對我來說意義重大。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: 希望那個怪胎不會追到這裡來。還好，你也帶著個不好惹的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: 或許，他早就已經被其他的傢伙給幹掉了——甚至有可能是那個通體蒼白、瘦骨嶙峋的偽人下的手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: 好吧……看來，我沒猜錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: 之所以會選擇說謊，就是出於這個原因。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: 再見，蠢貨！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: 天啊……他們到底去了哪裡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: 你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: 我不知道……我真的很想父母能回到我的身邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: 我這輩子都在接受他們無微不至的照顧，然而現在……我甚至不知道他們究竟怎麼了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: 希望他們平安無事。我實在無法想像，要是他們已經不在了的話……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: 天啊……他們到底去了哪裡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: 你有其他親戚嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: 幾乎沒有。不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: 我最近發現自己還有一個同父異母的姊姊……爸爸第一次結婚的時候所誕下的孩子，只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: 該死，我的奶奶！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: 天啊，我突然意識到父母可能去了哪裡……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: 萬一奶奶變成偽人、把他們殺了，該怎麼辦？萬一他們被FEMA給帶走了，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: 為什麼——為什麼他們不留下來、為什麼他們沒帶我離開？為什麼……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: 我自己一個人根本就活不下去。為什麼他們要把我給丟下不顧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: 天啊……他們到底去了哪裡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: 冷靜下來了嗎？你的這個姊姊——情況又如何呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: 就在他們離開不久前，我們收到了一封信件。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: 爸爸親手帶過來給我的……因為我從不會檢查信箱，他讓我讀一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: 就是「姊姊」寄來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: 她說想要跟我見上一面。然而……我並不知道該對此作出何種感想。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: 說實話，我本以為是某種惡作劇呢。不過，一想到是爸爸給我的、就打消了這樣的念頭。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: 他解釋道，我並不是他的第一個孩子——其實一直以來，我都有一個姊姊……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: 一個同父異母的姊姊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: 聽到這番告白的時候……我的內心五味雜陳，完全不知道該如何去應對。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: 我是說，沒錯——她理論上的確是我的「姊姊」，然而我們卻從來都沒見過面、完全不了解彼此……這種感覺非常奇怪……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: 我……我想自己應該是想要跟她聊聊的。只是，我對此也非常的害怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: 或許，你可以幫我打個電話過去？來，這是她的號碼——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: 就說……她的的確確有一個弟弟，而他並不知道該怎麼辦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: 天啊……他們到底去了哪裡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: 為何不去投靠自己的姊姊？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: 我根本就不認識她。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: 我的父母坦白這件事情的時候，我感覺——就好像自己被他們騙了一輩子一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: 我怒不可遏、衝出了房間，想自己一個人待著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: 然後，第二天……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: 就發生了我跟你說的事情。電視裡的報導、地區陷入恐慌，然後……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: 他們就拋下了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: 天啊，我願意付出任何代價、只為能再次見到爸爸和媽媽一面。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: 天啊，為什麼……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: 去找你的姊姊吧，她不會拒絕你的
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: 你確定自己的父母真的都已經死去了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: 真的嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: 不過，我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: 我從來都沒有在離開父母的情況下走這麼長的一段距離。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: 她住在離這裡很遠的地方。我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: 我很害怕。我不知道自己能不能順利抵達。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: 坐計程車就好了——現在還正常運營
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: 你必須做點什麼
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: 既然……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: 他們沒有回來找我，因此……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: 我不知道……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: 試著去找一下你的奶奶吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: 試著去隔離區裡看看如何
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: 的確……是個不錯的主意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: 不過，我聽說現在計程車的要價非常昂貴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: 還好，我把父母的存款給取了出來。或許，足夠支付前往姊姊家的路費。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: 謝謝你開導我。要是有緣的話，希望還能再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: 或許，你是對的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: 或許，我長期以來真的過於依賴父母了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: 謝謝你開導我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: 我會試著叫一輛計程車。還好，我把父母的存款給帶在了身上——希望足夠支付路費。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: 不成功，便成仁……要是有緣的話，希望還能再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: 或許，你是對的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: 萬一，只是……他們的車子拋錨了而已呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: 沒錯，爸爸之前抱怨過該再好好地給它修理一下了的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: 還有，奶奶非常固執地不願意去購置一台電話。或許，就是因為這樣、導致他們無法聯絡我？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: 或許……我真的能在那裡找到他們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: 謝謝你的開導——我需要動身了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: 也有道理……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: 或許他們真的在那裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: 我想，的確值得一試。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: 謝謝你的開導——我需要動身了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: 好啊，兄弟。你在想什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: 感覺如何？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: 非常不錯，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: 順帶一提——我偷偷開你的冰箱看了一眼，沒想到裡面放著滿滿的啤酒……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: 到底是從哪裡搞來的——你有叔叔在釀酒廠工作還是怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: 哎呀，無所謂了！每個人都有自己的秘密！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: 該死。要不是因為這些爛事，我們早就能悠哉地一邊喝著冰鎮啤酒、一邊觀看橄欖球比賽了。我甚至還會給你介紹——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: 你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: 你當機了還是怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: 嗯——怎麼了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: 沒什麼，忘了吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: 不、不，我只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: 嗯……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: 我只是在想一些事情，僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: 好啊，兄弟。你在想什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: 你今天看起來有點沮喪
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: 我並不想談論此事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: 談論什麼事？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: 你在說什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: 沒什麼。你不會理解的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: 我感覺應該要問清楚
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: 好吧，我不會逼你
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: 聽好——我真的不想談及此事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: 我感覺應該要問清楚
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: 好吧，我不會逼你
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: 不要再咄咄逼人了！我現在光是維持住自己的理智、避免精神徹底崩潰，就已經竭盡全力了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: 就……不要再管我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: 謝謝。我只是感覺不太好，僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: 好啊，兄弟。你在想什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: 你到底怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: 關你屁事，滾遠一點！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: 只管告訴我發生了什麼事情就好
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: 說出來比較好，不然情況只會越來越糟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: 我做不到……你會用不一樣的眼光看我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: 不過……繼續悶在心裡的確也對我沒什麼好處。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: 我養了一隻小狗，它……前幾天去世了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: 這又怎麼了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: 然後呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: 怎麼，突然之間這麼來勢洶洶——總不能是想幹掉我吧，兄弟？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: 好吧。你想要聽我說實話，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: 我養了一隻小狗，它……前幾天去世了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: 這又怎麼了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: 然後呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: 繼續聽我說下去就知道了。雖然它已經很老了、而且疾病纏身……不過——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: 其實，它並不是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: 我親手結束了它的性命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: 你都做了些什麼？！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: 你個變態！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: 我親手結束了它的性命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: 你都做了些什麼？！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: 你個變態！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: 我知道聽起來非常令人不齒。不過，希望你可以聽聽我的理由。它……它被折磨得不成人形，我實在是不忍心看著它如此下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: 每日、每夜，它的目光都流露出無邊的苦痛。每晚，我都聽見它在為自己受傷的腿低聲啜泣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: 該死的司機！要是這個傢伙開起計程車來不這麼橫衝直撞的話，它現在說不定還活得好好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: 媽的，只要能扭斷他的脖子、讓我付出什麼代價都行。然而，他立即逃離了現場、我也沒能看清車牌……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: 你根本不了解失去自己的寵物到底是一種什麼樣的感受。雖說它們的生命非常短暫，然而——教會我們的東西，卻遠比任何人能給予的還要更多。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: 大家都說——它們只是我們生命的一部分，而我們則是它們的全世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: 好吧，你可以留下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: 趕緊離開這裡
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: 我也非常清楚……自己是個雜種。直至現在，我也沒有辦法原諒自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: 它……它被折磨得不成人形，我實在是不忍心看著它如此下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: 每天，情況都在不斷惡化。晚上是最為難熬的……它會哭泣、啜泣……流下淚水……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: 你看過小狗流淚嗎？它的眼神分明就是在請求我幫忙終結自己的痛苦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: 我根本就不想這樣做——我可以對天發誓，我根本就不想這樣做！我永遠都不可能會想用自己的雙手去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: 該死的計程車司機！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: 竟然敢碾過我的小狗，還裝作彷彿什麼事情都沒有發生一般徑直駛離！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: 就好像把它當成了街邊的一塊石頭一樣，而不是一條鮮活的生命！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: 媽的，只要能扭斷他的脖子、讓我付出什麼代價都行。然而，他立即逃離了現場、我也沒能看清車牌……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: 你根本不了解失去自己的寵物到底是一種什麼樣的感受。雖說它們的生命非常短暫，然而——教會我們的東西，卻遠比任何人能給予的還要更多。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: 大家都說——它們只是我們生命的一部分，而我們則是它們的全世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: 好吧，你可以留下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: 趕緊離開這裡
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: 謝謝，兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: 非常感謝你的理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: 你是對的，兄弟。或許，這樣最好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: 我每天都在思考……就此結束它的痛苦到底正確與否。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: 大概，我這輩子都不可能會知道答案了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: 一片漆黑……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: 好了，告訴我吧——你究竟看到了什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: 你不會想要知道的。相信我——這樣反而是一種仁慈。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: 我本以為只要失去了視力，就能擺脫不斷縈繞在我思緒之中的那個……東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: 然而，一切早已烙在了我的腦海之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: 我還是能清晰地夢見自己所目睹到的一切，一如既往、無處可逃。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: 一片漆黑……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: 對你來說，失去雙眼真的有比較好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: 難以說清。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: 我很清楚自己再也不會看到那個東西了。即使遭到殺害，我也不會知道下手的到底會是什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: 只是……感覺有點奇怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: 我不知道這裡是什麼樣的佈局，難以自由走動。如果失去了藥物的幫助，我的眼窩就會疼痛難忍……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: 不過，我會逐漸適應的。起碼，我再也不會看到那令人毛骨悚然的恐怖景象了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: 然而，即便如此……我所目睹的一切，早就已經深深地銘刻在了靈魂之中——直至時間的盡頭，我都將與之共生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: 一片漆黑……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: 你看起來狀態不是很好
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: 大概是因為沒有梳過頭髮的關係吧？嗯嗯，應該是這樣……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: 我昨晚做了一個夢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: 我沿著電車軌道往家的方向走。四周環繞著房子、樹木林立。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: 我聽見了電車駛來的聲音，於是趕緊閃到了一旁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: 我轉過頭去——看到了某個東西抓住了一個人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: 它的速度很快、我根本看不清。不過，我的心裡其實非常地清楚——我知道這到底是什麼東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: 我不斷追趕著電車，卻始終無法縮短距離——我永遠都無法觸及隱藏於終點線後的真相。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: 然後，我醒了過來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: 一片漆黑……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: 你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: 我又做了一個夢，它又出現在其中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: 我走在一條路上，夜黑風高、街燈閃爍。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: 我轉過頭去，看到它正不緊不慢地向我走來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: 這次，我清晰地目睹到它究竟是如何移動的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: 我試圖逃跑，卻無濟於事——它依舊在逐漸逼近。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: 終於抵達了家裡之後，卻發現無法打開大門。沒有任何辦法，只好爬過柵欄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: 然而，匆忙摸索口袋的過程中、卻不小心把鑰匙弄掉了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: 於是，我繞過了房子、再次爬上柵欄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: 突然之間，四周變得鴉雀無聲。我停下了動作。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: 抬頭一看。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: 猛地發現它就在上方——越過柵欄，向我躍來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: 你覺得……這會是因為服下了止痛藥而產生的幻覺嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: 一片漆黑……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: 昨晚也做夢了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: 沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: 只是……這次，我並不想去開口談論。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: 我現在已經理解了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: 我們全都難逃一死。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: 我們會被它撕成碎片——無論清醒、抑或睡眠。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: 我們會被太陽燒焦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: 一切都已失去意義，萬事休矣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: 我……不要再管我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: 喲，老兄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: 災變開始之前，你都做些什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: 放鬆——看看電影、跟兄弟們混在一起，諸如此類。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: 現在？沒有電影，不能外出……無聊透頂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: 我也完全聯繫不上兄弟們。至於電視，只會循環播放一些危言聳聽的破事以及一堆沒完沒了的廣告。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: 聽著上頭的大人物說——「現在並不是玩樂的時候，我們正面臨巨大的危機。」'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: 去他的吧。我自己會決定什麼時候應該盡情玩樂、什麼時候應該做其他的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: 喲，老兄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: 你是做什麼工作的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: 工作？呸。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: 只有笨蛋才會去工作，老兄——我一直都在享受生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: 曾經看過一齣電影。主角？就跟本人一模一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: 說說看，在工廠裡做事的工人會感到幸福嗎？想也知道，絕對不會。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: 我舉辦千奇百怪的派對、結交各式各樣的人物……而這，便是真正的活著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: 不過……我之前好像在一個配送站當過倉庫經理來著，都是託了家裡老人的福——你懂我的意思吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: 也就是說，你在啃老？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: 也就是說，是個懶鬼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: 為什麼要拚命，老兄？我早就想通了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: 不去利用手中本就握有的資源？簡直蠢到家了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: 就比如說……你有一把槍，對吧？你會選擇將其掛在牆上充當裝飾、還是拿在手裡好好使用？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: 對吧？我並不笨，跟你一樣——懂得善用自己的優勢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: 哎呦，冷靜一點。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: 要是嫉妒了的話，老兄——直說就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: 我能理解，並不是每個人都有能中大獎的運氣。生活如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: 喲，老兄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: 出什麼事了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: 老兄……你的電影都放到哪裡去了？就連一盤錄影帶都找不到。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: 你究竟有在看什麼東西嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: 我遲早會無聊到死。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: 現在並不是看電影的時候
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: 我沒有任何電影
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: 拜託，我還以為這裡會很嗨。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: 結果這邊的人？超遜。甚至就連個能看的東西都沒有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: 沒有雜誌，沒有電影……全是些書……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: 沒有人會去讀書的，好嗎？現在又不是石器時代！沒完沒了的全是一些長篇大論的文字以及描述，超級無聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: 這裡並不是什麼電影院
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: 你到底是來這裡開派對的還是活下去的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: 等等——蛤？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: 不是吧，老兄。你認真的嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: 自己的房間裡明明就有一台電視，卻沒有任何電影？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: 真是一場爛到家了的派對。我還以為你是有趣的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: 這裡並不是什麼電影院
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: 你到底是來這裡開派對的還是活下去的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: 拜託，老兄……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: 你是我遇到過最令人掃興的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: 如果想要活下去，就給我安靜下來
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: 如果不喜歡這裡，隨時都可以離開
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: 拜託，老兄……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: 我家裡的電視壞掉了。我本指望你能拯救我脫離這種境地，結果……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: 你是我遇到過最令人掃興的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: 如果想要活下去，就給我安靜下來
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: 如果不喜歡這裡，隨時都可以離開
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: 好吧。隨你的便，老兄。雖然這裡爛到不行，不過總比大街要好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: 只是……讓我看看電視吧——只要一小會就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: 我就知道！真是敗興！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: 我這就走人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: 淒慘的孩子們……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: 你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: 大概吧……我也不是很清楚……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: 我……我不理解為什麼心智成熟、頭腦清醒的成年人為什麼會任由情緒驅使自己做出如此傷天害理的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: 難道他們真的害怕到這種程度，甚至不惜去殺害無辜的孩子嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: 如今這個世道，人們會去做更加糟糕的事情
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: 混亂之中，理智往往是首當其衝被拋諸腦後
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: 難道還有比去殺害無辜的孩子更加糟糕的事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: 並且，不僅僅是一個人……而是一幫人、一群人，孜孜不倦地進行著屬於他們自己的獵巫行動……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: 或許正是在這種艱難時期，隱藏於我們表面之下的真實樣貌才能得以顯現。或許真正的怪物其實是我們，而非來自地底下的那群傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: 不過，難道人們就沒有意識到去殺害無辜的孩子是一件非常……我甚至不知道該怎麼樣描述……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: 或許正是在這種艱難時期，隱藏於我們表面之下的真實樣貌才能得以顯現。或許真正的怪物其實是我們，而非來自地底下的那群傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: 淒慘的孩子們……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: 你當教師多久了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: 大約是從災變開始之前的……三個月當起的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: 只是……我不是什麼模範教師。之前，我並不熱愛這份工作——只是覺得孩子特別喜歡大吵大鬧、讓人感到疲憊不堪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: 不過，災變改變了一切、令我看清了一些事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: 昔日，任何一個孩子都有可能會在將來成為一名搖滾巨星、一名政客，或是成為他人的父母。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: 然而，如今……他們已經再也無法手握吉他、再也無法前往學校——再也無法正常長大。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: 永遠都是……做夢之人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: 我記得有一天，某個孩子突然跑來找我、哭著向我傾訴——說自己的父母非常懼怕他。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: 因為，對方認定他是個偽人……所以，便將他給趕出了家門。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: 由於不知道自己究竟還能去哪裡，只好來到我這裡……來到幼稚園。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: （女人的眼淚止不住地流了下來）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: 不好意思……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: 淒慘的孩子們……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: 昨天實在是非常不好意思，我並非有意讓你感到不快
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: 沒關係。我……我已經沒事了，現在感覺好多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: 關於之前提及的那個孩子……經歷過他的事情之後，我意識到了他們的脆弱、他們的無助，尤其是當一切都崩壞殆盡之時。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: 於是，我開始盡可能地收留每個遭到「驅逐」、遭到拋棄的孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: 我聽他們說了自己的經歷……知曉了某些父母竟然能不帶絲毫猶豫地遺棄自己的親生骨肉，簡直令人難以忍受。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: 就好像——對於他們來說，這次災變只不過是放棄孩子的藉口罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: 或許……他們打從最開始就根本不想要孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: 淒慘的孩子們……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: 你有自己的孩子嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: 我沒有自己的孩子……我的母親倒是經常跟我說要早點成家、生個孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: 只是，我並沒有準備好——我希望能在時機成熟的時候自己做出這個決定，而非盲從他人、隨波逐流。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: 聽過遭到拋棄的孩子們述說的種種經歷之後……我不禁開始好奇起來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: 如果我當初聽從了母親的勸告，自己是否也會成為這樣的父母。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: 正因如此，我選擇向每個受到這種遭遇的孩子們義無反顧地伸出援手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: 最糟糕的是什麼，你知道嗎？其中一個縱火的傢伙就是我收留的某個孩子的父母……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: （女人的眼淚再次止不住地流了下來）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: 不好意思……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: 我……真心想要給予他們一場美好的生活。我關心他們、愛護他們。無論如何，都不應該落得這樣的結局……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: 我很抱歉……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: 他們的死，非你之錯
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: 對此，我深表遺憾
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: 或許，你是對的。只是……我的內心依舊感到無比的空虛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: 我的腦海之中一直有個揮之不去的想法——你知道是什麼嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: 萬一他們的父母從來都未曾愛過他們、未曾對他們付出過任何感情，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: 我……希望自己有讓他們感受到愛——即使只是一點。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: 謝謝……不過，我的內心依舊支離破碎、無從縫補。恐怕，我這輩子都跨不過這道難關。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: 我的腦海之中一直有個揮之不去的想法——你知道是什麼嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: 萬一他們的父母從來都未曾愛過他們、未曾對他們付出過任何感情，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: 我……希望自己有讓他們感受到愛——即使只是一點。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: 貓咪不是已經在這裡了嗎？你還有其他的什麼事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: 為何要來這裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: 好白癡的問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: 開門的是你，因此——問你自己。問我幹嘛？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: 對於我來說，哪裡都一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: 某人要我來這裡，於是我就來這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: 我並不打算從你身上索取任何東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: 只要把這個地方打理得乾乾淨淨、將我伺候得舒舒服服就好，至於其他事情——我並不很在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: 貓咪不是已經在這裡了嗎？你還有其他的什麼事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: 你真的是人類嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: 你呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: 你的內心還殘留有哪怕一絲人性嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: 你又比我好到哪裡去呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: 貓咪不是已經在這裡了嗎？你還有其他的什麼事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: 要你來這裡的到底是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: 你已經做了自己該做的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: 關心這些有的沒的有何意義？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: 某個我們都認識的……熟人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: 不過，對方並沒有告知我之後該怎麼辦就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: 貓咪不是已經在這裡了嗎？你還有其他的什麼事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: 你打算在這裡待多久？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: 直至對方來找我為止。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: 於此期間，我該去做什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: 我不知道——對方只說了這些。現在，我在等其他指示。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: 給出指示的到底是誰？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: 你在等的到底是誰？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: 貓咪不是已經在這裡了嗎？你還有其他的什麼事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: 為何還沒殺了我？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: 你知道嗎？你還挺笨。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: 每天都在重複同樣的問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: 不是早就已經跟你講過無數遍了嗎？對方並沒有這樣要求。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: 我在等其他指示——你又在等什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: 這裡讓人喘不過氣來……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: 你還好嗎？孩子的情況如何？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: 還好、還好……他……非常疲憊，和我一樣。而且比較怕生，所以會像這樣一直黏著我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: 孩子們都不太擅長應付這樣的事情。即使嘴上從來都不會去抱怨一句，臉上的表情也已將一切表露無遺。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: 我三不五時會覺得一切都是自己的錯——不該把他們給拖下水。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: 不過，現在說什麼都為時已晚了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: 拜託，寶貝——不要板著一張臉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: 為何會在街上遊蕩？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: 哎呀，我們正要去拜訪我妻子的母親、也就是我的岳母來著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: 然後意識到了自己大概無法及時抵達，於是——就找到了你這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: 再次感謝你允許我們待在這裡！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: 拜託，寶貝——不要板著一張臉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: 路程非常遠嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: 我的愛人不太認得這裡的路。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: 要是沒人向我們伸出援手的話，大概要走上個整整兩天這樣吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: 找到正確的方向之前，估計會迷好幾次的路。哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: 不過，如果有人能順路載我們一程——這樣就太完美了，只需要幾個小時而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: 為何偏偏選在現在心血來潮地去拜訪她的母親？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: 對於時間的掌控實在是一塌糊塗
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: 因為擔心她可能會遭遇什麼不測。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: 手機始終處於關機的狀態——已經好幾天沒能聯絡上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: 我們需要確定她平安無事，說不定她正需要我們幫忙呢！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: 雖然現在夜晚變得更短了，趕路的時候稍微有點嚇人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: 不過，沒有關係。我們很快就能見到你的母親了，對吧——親愛的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: 我已經不太記得路具體該怎麼走了，我的妻子則總是會挑到錯誤的方向。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: 不過，都是小事。只要能確實向前就好，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: 或許，我們會為此花上一週的時間就是了。哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: 拜託，寶貝——不要板著一張臉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: 你們不是今晚離開嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: 事情是這樣的——我這傻乎乎的妻子光是收拾行李就已經花了整整三個小時，完全錯過了出發的最佳時機。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: 因此，我們決定把離開的時間往後推遲一些。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: 不好意思，我們下次手腳一定會再俐落一點！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: 我會確保這位慢吞吞的女士不會再耽誤行程。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: 還是說……我們這樣有點太過打擾你了？要是的話，你應該會直說的——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: 拜託，寶貝——不要板著一張臉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: 女士，你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: 一切正常——為什麼要特地去問她？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: 我已經說過的事情，她沒什麼要補充的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: 而且，她稍微有點心煩意亂。不過，也僅此而已……沒有什麼好擔心的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: 我問的是她
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: 你呢，感覺如何？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: 她已經非常疲憊了，還請不要強人所難。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: 這隻慢吞吞的蝸牛遲早會動起來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: 說實話，我想她已經不再關心自己的母親了……不過，沒錯——最好還是讓她們重聚！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: 只是……不知道等到那個時候，她是否還活著就對了。哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: 拜託，親愛的——趕緊做好準備。你到底要我等到什麼時候？該死！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: 哎呀，呃……整體來說，一切都好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: 只是感覺我的愛人好像已經不再關心自己的母親了而已，哈哈。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: 或許，我該提醒她一下、她的母親現在有可能正處於危險之中——嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: 抱歉讓你聽到這些。她實在太過拖泥帶水，都快要把我給逼瘋了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: 快點坐下、做好準備，我他媽的已經不想再繼續等下去了！該死！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: 拜託，寶貝——不要板著一張臉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: 你的妻子並不想要離開——出什麼事了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: 她把我給惹惱了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: 一天到晚都在抱怨，無時無刻都在怪我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: 總是不懂閉上自己的嘴巴，永遠都不會照我說的去做——一如既往地把情況變得無比複雜。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: 對於一直賴在這裡一事，我真的感到非常的抱歉。今天就是最後一天，我們馬上就會離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: 聽到了嗎？趕緊把行李給他媽的收拾好。如果到了晚上還是得留在這裡，我就直接把你給扔出窗戶——我說到做到。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: 女士，你確定自己還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: 出什麼事了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: 我早就已經說過，希望你不要插手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: 與你沒有任何關係。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: 我們自己會處理好——不要再來刺激我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: 我不想再聽你說廢話，我要知道發生了什麼事
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: 我不在乎——你們到底還打不打算離開？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: 聽著——我之前就已經說過，一切都好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: 我的妻子只是……太過無聊了、在鬧脾氣，把我給惹惱了，僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: 你到底要我怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: 我不想再聽你說廢話，我要知道發生了什麼事
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: 我不在乎——你們到底還打不打算離開？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: 冷靜一點。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: 你猜怎麼樣？我也有一把槍——敢輕舉妄動的話，我就殺了這個婊子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: 我橫豎已經沒有什麼東西可以失去的了。你又如何呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: 不管怎樣，你都得死
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: 現在收手也不遲，你還能安全離開
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: 會的、會的，我們並不打算再繼續待下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: 我們這就離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: 聽到了嗎？今天就是最後一天。媽的——趕緊做好準備，不要浪費時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: 我早已了無牽掛。你殺了我，又能怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: 起碼再也不用忍受這種痛苦，而且這個婊子也會與我陪葬——完全就是雙贏的局面。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: 我會開槍的
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: 冷靜一點——只要你把槍放下，我也會把槍放下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: 我為什麼要這樣做呢？我一定要跟她一起走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: 要是沒了她，我也不會走。因此——放下你的武器。我們今晚就會離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: 只要你不繼續插手，就沒人會受到傷害。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: 我會開槍的
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: 冷靜一點——只要你把槍放下，我也會把槍放下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: 你真的要向一名柔弱的女子開槍嗎？你真的對此沒有任何的心理負擔嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: 要是向我開槍的話，一定也會波及到她。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: 一切都與我無關！下手的人——將會是你！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: 開槍
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: 發出警告
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: 我要走了。不然，就連我也要交代在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: 已經別無他法了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: 要是這個婊子沒有被嚇得渾身顫抖、而是跟我一起離開的話，事情根本就不會發展成現在的樣子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: 全都是她的錯。聽到了嗎？你毀掉了一切！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: 開槍
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: 發出警告
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: 你……你把槍放下了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: 等等，你還是打算向我開槍嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: 等等——不要！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: 好吧！好吧。我們會離開的。冷靜一點。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: 對吧？今晚一定要離開這裡——聽到了嗎？婊子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: （女人突然掙脫開來，男人因此扣下扳機）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: （你條件反射地對準男人的頭部開了一槍）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: （看來他們都已經死了，起碼……這場鬧劇結束了）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: （真是一對瘋狂的夫妻）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: 好吧，我們這就離開。立即——先讓我們拿些東西遮著身體，然後馬上就會出發。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: 你再也不會見到我們了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: 等等……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: 你、你這是要做什麼？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: （你對準男人扣下扳機，也擊中了一旁的女人）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: （兩人同時倒下、血流如注）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: （女人發出了片刻呻吟，不過你對此無能為力）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: （兩人均已死去）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: 你還是不明白嗎？這是唯一的方法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: 我們走了，就這樣吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: 嘿——拿上毯子！我們要離開了，就是現在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: （你看著兩人利用毯子把自己裹得密不透風、踏上大街。）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: （不過——只走了一小會，就突然倒下了。）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: （黑煙從毯子上緩緩升起。你轉過頭去、不再關注）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: 一切都會好起來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: 還是感到非常精神嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: 也不能說是非常精神……不過，起碼也不至於會崩潰。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: 我們還是人類，我們還在堅持。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: 我們並沒有使這場浩劫朝著更加糟糕的走向發展。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: 一切都結束之後……我想，我們應該可以原諒彼此曾經所做過的種種事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: 只要尚未失去憐憫之心，人性就永遠都不會消滅。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: 你說對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: 一切都會好起來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: 你一直都是像現在這樣的嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: 其實……不然。我以前非常容易動怒——對人類、對世界，以及對自己感到憤憤不平。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: 經常會因為一些小事就暴怒，甚至就連門框都試過被摔裂。不過，某天我突然意識到體內這滿腔的怒火最終只會令自己分崩離析。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: 首當其衝的將是自己的內在，然後就輪到周遭的一切事物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: 某次……我對著只是想要向我伸出援手的人大發雷霆。然而，如今……他……不對——她已經不在了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: 就在那一刻，我感到心中的某種東西破碎了。我知道自己必須徹底作出改變，否則所觸及的一切都會被親手摧毀。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: 因此，我學會了放下。試著去令自己平靜下來、試著去令自己接受分歧。於是，便成就了現在的我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: 一切都會好起來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: 你失去了什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: 我的家人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: 就在我外出取水的時候，只不過是短短的幾分鐘——我們的房子就被燒毀了。回來之後，目之所及除了濃煙便是灰燼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: 我花了很久的時間來接受這個事實。我不停地質問自己：我為什麼要在那時離開？我為什麼無法拯救他們？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: 不過，或許重點並不在此——不該因無法改變過去而懊惱，而是要背負這一切繼續前行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: 某種程度上，他們依舊與我同在、活在我心中。與他們共度的回憶給予了我不斷邁進的動力。正因如此，我會主動向他人伸出援手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: 我非常清楚失去的滋味。我非常清楚當一切都土崩瓦解後、再次尋得目標的意義所在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: 一切都會好起來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: 你設法克服了失去他們的痛苦？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: 沒錯。我熬過來了，雖並不輕鬆。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: 我在很長的一段時間之內都在責怪自己，覺得——如果能早幾分鐘回去的話、或許就不必落得如此結局。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: 然而，愧疚會滋長悲傷。人生……需要學會寬恕。如果不懂得怎麼去放下，就連自己也會隨之而逝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: 正是這種精神拯救了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: 我原諒了無法改變過去的自己。我甚至包容了如此殘酷、無情的命運。因為，我很清楚憤怒只會令自己陷入深不見底的泥潭之中、不斷地沉淪下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: 一切都會好起來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: 現在，是什麼在激勵著你向前邁進呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: 我相信人類可以變得更好。即便面對這種混亂至極的局面，也依然可以找到機會再次崛起。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: 我不相信什麼奇蹟、什麼天意。我相信人性——我相信彼此之間的互相扶持。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: 一些人會對跌倒的同胞伸出援手。一些人會在艱難的日子裡也展露微笑。一些人會毫不猶豫分出最後一塊麵包。生活，均源於此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: 每個人作出的貢獻，縱使極其微小、也絕非毫無價值——世界將會因此而變得更加燦爛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: 一切都會好起來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: 要是可以的話，你會想要讓一切都恢復原狀嗎——你的房子，你的家人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: 如果能再次與他們相見……再次與他們交談，再次與他們擁抱……我當然會。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: 只是——讓一切都恢復原狀？我不好說。失去是生命的一部分——雖然很糟、雖然會痛，不過……正是這些遭遇造就了現在的我們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: 的確。如果能與他們再共度一天，要我付出什麼代價都可以。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: 然而，要是這意味著我將失去因此學到的一切——該如何去寬恕、該如何去前進……我便不會。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: 人生苦短。要去把握現在所擁有的一切，不能被早已失去的東西吞噬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: 一定要保持警惕，偽人可能就混在我們之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: 你是個獵人，對嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: 更像是個護林員吧，孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: 一直生活在樹林之中。沒有電視，只有收音機——因此，我還是可以得知具體出什麼事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: 本來已經下定了決心絕對不會收留任何人。我的小屋就是我的堡壘。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: 萬一被偽人混進來了，該怎麼辦？對吧。先是利用花言巧語來令我放鬆警惕，然後趁我睡著的時候割斷我的喉嚨。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: 既然如此，你為什麼會來到這裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: 一個人待著並不安全
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: 因為——我可不想被那個高高瘦瘦、通體蒼白的雜種給抓住。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: 於是，只好離開了自己的小屋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: 我能從你的眼神之中得知，你也曾經見到過這個傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: 你一個人是怎麼在那裡活下來的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: 你也曾經見到過這個高高瘦瘦、通體蒼白的偽人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: 要是我連這個道理都不明白的話——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: 現在早就已經變成一具長滿蛆蟲的屍體了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: 我之前覺得讓陌生人踏進自己的小屋是一件非常愚蠢的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: 認為自己一個人待著要更加安全。結果，就碰上了那個怪胎。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: 我從來都沒有見過像那樣的野獸。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: 你一個人是怎麼在那裡活下來的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: 你也曾經見到過這個高高瘦瘦、通體蒼白的偽人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: 哎呀，孩子……說來話長。今天已經沒有什麼心情跟你展開細講了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: 明天，給我帶一瓶啤酒來吧——然後，我會一五一十地把事情通通告訴你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: 看來，曾經見到過這個傢伙的並不止我一個。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: 沒錯……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: 哎呀，孩子……要是你知道我都經歷了些什麼就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: 之後再跟你說吧，今天還是先算了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: 明天，給我帶一瓶啤酒來吧——然後，我會把整件事情完完整整地告訴你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: 一定要保持警惕，偽人可能就混在我們之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: 好啦，該說說下文了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: 帶啤酒來了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: 帶了（給他啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: 怎麼，沒帶啤酒？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: 沒有（不給他啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: 好的——這樣就可以了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: 正如之前所說，我把自己關在小屋裡、不與他人來往。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: 某天，突然來了一個人——氣喘吁吁、無比急迫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: 不斷地敲打著大門，求我放他進去。不過，我也沒有傻到那種程度。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: 這個傢伙通體蒼白、抖個不停，就好像親眼見到了死亡降臨一樣。完全想不通他究竟是怎麼跑到這樣的深山老林來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: 看起來也不像是登山客。因此，我要求他趕緊離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: 然後，他試圖打破窗戶、強行進入。不過，我大吼道自己握著一把來福槍——順利把他給嚇跑了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: 我本以為自己再也不會見到他了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: 或許，你該向他伸出援手
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: 你該放他進去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: 'Hunter: 然後呢，孩子？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: 把追逐著他的東西給引過來？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: 不了，我可敬謝不敏——手邊的問題早就已經堆積如山了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: 你似乎不太愛說話
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: 你並沒有透露太多的事情
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: 我猜猜看好了——要是他能給你一瓶啤酒的話、你就會開門放他進去，對嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: 不要以為自己就是什麼英雄，孩子。我敢打賭——你也曾經將人拒之門外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: 否則，你現在根本就不可能還活著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: 不過，其餘的事情就留到明天再說吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: 你似乎不太愛說話
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: 你並沒有透露太多的事情
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: 我猜猜看好了——要是他能給你一瓶啤酒的話、你就會開門放他進去，對嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: 我很確信自己不會再見到他了。然而，之後……他找到了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: 不過，之後的事情就改天再說吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: 你似乎不太愛說話
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: 你並沒有透露太多的事情
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: 我猜猜看好了——要是他能給你一瓶啤酒的話、你就會開門放他進去，對嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: 明天，給我帶一瓶啤酒來吧——然後，我就會把剩下的事情講完。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: 我不喜歡與他人閒聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: 因此，你應該對我願意開口感到慶幸。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: 明天，給我帶一瓶啤酒來吧——然後，我就會把剩下的事情講完。好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: 要有耐心，孩子。我所目睹到的東西實在過於不祥……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: 不麻痺一下自己的神經，實在是沒有辦法講出口。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: 只要帶啤酒來，我就會說下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: 你非常的敏銳，這點我得承認。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: 我不會在枝微末節上浪費時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: 好了。明天，給我帶一瓶啤酒來吧——然後，我就會把結局講給你聽。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: 不好意思，只是——沒有啤酒壯膽的話，我實在是沒有辦法講出口。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: 先帶啤酒來，然後再說吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: 一定要保持警惕，偽人可能就混在我們之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: 好啦，該說說結局了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: 我會說的，不過——帶啤酒來了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: 帶了（給他啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: 怎麼，沒帶啤酒？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: 沒有（不給他啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: 謝謝，孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: 上次講到對方被嚇跑、而我繼續待在小屋裡，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: 之後，我耗盡了木柴。於是，只好外出尋找。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: 收集到了足夠的數量，然後回去……結果發現，我的來福槍竟然不見了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: 把我給嚇了個半死。即使將整間小屋給翻了個底朝天，也完全找不著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: 然後……我看到他站在窗外——就是那個被我嚇跑的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: 手裡拿著我的來福槍……不過，整個人看起來都有所不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: 不僅比之前變得更高了，而且皮膚還鬆鬆垮垮的。此外，全身上下就只穿了一條褲子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: 他雙手握住槍……輕而易舉地就把它給掰成了兩段。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: 接著，他便一動不動地站在原地、死死地盯著我。就好像在等我眨眼一樣……好趁機把我的脖子給扭斷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: 不過，他還是沒有任何動靜、只是靜靜地看著我。就彷彿是在進行什麼扭曲至極的不眨眼挑戰一般。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: 不知道過了多久……太陽終於升了起來，這個高高瘦瘦的怪胎突然之間就消失無蹤了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: 我回過神來、立即意識到——獨自一人待在野外，而且手上還沒有武器？跟自殺根本就沒什麼兩樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: 於是，我搶在太陽完全升起之前一路狂奔。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: 然後，就來到了這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: 希望你有機會扣下扳機，孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: 說不定，子彈可以殺死他呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: 他為什麼沒有殺死你？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: 你覺得他能被殺死嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: 他殺死了一整隊士兵
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: 我也不清楚。要知道，他可是徒手就把一支堅固的來福槍給掰成了兩段。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: 如果他有這個意思，完全可以在一瞬之間把我的脖子給扭斷……然而，卻紋絲不動。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: 或許，他在享受玩弄我們的感覺——就好像貓咪會戲弄老鼠一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: 你知道嗎？幾乎沒有什麼東西可以嚇倒我。然而，那個高高瘦瘦、通體蒼白的傢伙——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: 實在是把我給嚇壞了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: 我想要去這樣相信。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: 人們常說一句話……「只要會流血，就能被殺死。」'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: 該死。如果就連一整隊士兵都沒有辦法拿下他……我們更是沒有任何的機會。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: 只要他想，甚至可以不費吹灰之力地將這個地方給撕成碎片。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: 你知道嗎？幾乎沒有什麼東西可以嚇倒我。然而，那個高高瘦瘦、通體蒼白的傢伙——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: 實在是把我給嚇壞了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: 沒有啤酒，不講故事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: 不先壯一下膽的話，我實在是說不出口。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: 如果想聽接下來都發生了什麼事……就帶啤酒來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: 只能感到一絲微不足道的溫、溫暖……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: 你不打算把夾克給脫下嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: 是、是的。我的腦海裡一直有個揮之不去的顧慮。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: 我不知道這、這樣做會有什麼後果。甚至在炎、炎熱的氣溫之中，我也無法感到一點暖意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: 如果把這件夾克給脫下了，我會因為過、過於寒冷而死嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: 又或者是……雖然不會因此而死，卻會感到更為寒、寒冷——這樣甚至更加糟糕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: 你不會流汗嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: 也就是說，你甚至不會去洗澡囉？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: 不、不會。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: 之所以會流汗，是因為身體需、需要降溫了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: 而我的這副身體……恐怕沒有辦法再、再繼續降溫了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: 我、我不打算回答這個問題——不、不好意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: 只能感到一絲微不足道的溫、溫暖……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: 對於如何治好這一體溫失調的症狀，你有什麼頭緒嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: 我……覺得自己對此應、應該是無計可施了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: 我甚至試過利用沸、沸水來提升體溫。結果只是被燙傷了，完全沒有任何幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: 你知道嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: 我想到了一個比、比喻。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: 想像一下，於廣袤且冰、冰冷的深遠太空之中……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: 星系顯現。天體坍、坍塌。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: 而我，卻只能在一旁靜靜觀察……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: 我從來都感受不到哪怕一絲太、太陽帶來的溫暖。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: 更別提人與人之間互相擁、擁抱而產生的溫度了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: 大概——不管是太、太空，抑或是社會，都不需要我這個異類。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: 只能感到一絲微不足道的溫、溫暖……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: 我們第一次見面時，你曾說過有話要講——到底是什麼事情呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: 我……不是很確定到底該不該現在說、說出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: 我的心、心頭上壓著一件事——已經持續很久了。我之所以會感到如此……寒、寒冷，說不定就是因其而起。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: 其實，我根本就連提也不是很想提起。不過，渴望訴說的心情不斷蠶、蠶食著我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: 我、我會在明天跟你坦白。我想——到時，我應該就會做好準備了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: 只能感到一絲微不足道的溫、溫暖……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: 好了，你到底隱瞞了什麼事情呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: 我想與你分、分享一個秘密。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: 我已經做好準備了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: 通常來說，結局都不會太、太好。只是這次，或許能有、有所不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: 我相信——衣服下面所、所遮掩的，便是寒、寒冷以及孤獨的成因。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: 看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: 唉……又、又是這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: 你都做了些什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: 你已經沒救了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: 我並非有、有意如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: 我還以為這次能、能有所不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: 然而，根本就不、不可能會有其他的結局。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: 我並不想要這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: 我可以對、對天發誓。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: 開槍
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: 將其趕出去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: 之、之前也是同樣的結果。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: 為什麼我會覺得這、這次能有所不同？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: 不、不要衝動行事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: 我這麼做，絕、絕非出於惡意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: 這並、並不是我想要的結果。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: 開槍
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: 將其趕出去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: 或許，這樣對我來說反、反而是最好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: 再也不會感受到寒、寒冷。再也不會感受到孤單。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: 只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: 千萬不要認為這一切都是我事、事先計劃好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: 現在？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: 直接賞我一、一顆子彈興許還比較仁慈。非常遺、遺憾，我還是能感受到疼痛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: 由太、太陽下手的話，過程將會更加煎熬……更加漫長。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: 我能在這裡待到夜、夜幕降臨嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: 立即給我滾出去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: 好吧，不過——千萬不要輕舉妄動
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: 我知道了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: 非、非常抱歉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: 也許，最後一次……太陽能、能賜予我些許溫暖。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: 謝、謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: 我知道你現在對我恨之入骨。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: 不、不過。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: 還是想跟你說聲抱、抱歉——我真的並不想要這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: 還有就是……能把我的好友也叫到這裡來嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: 由大人邀請的話，她的爸爸還有媽媽一般都會允許的……由我邀請的話，一般都會挨他們的罵。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: 我沒記錯的話，她的電話號碼應該是這個——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: 寶貝……千萬不要放其他人進來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: 為何FEMA會驅逐你？他們沒有跟你說明嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: 我也不是很清楚，寶貝。我完全看不出這些穿著制服的傢伙……葫蘆裡到底賣的是什麼藥。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: 總是在四處亂跑、頤指氣使……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: 他們以為自己是誰？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: 我敢打賭——他們其實根本什麼都不懂，只是在這裡作威作福而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: 他們也有來打擾過你嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: 沒錯
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: 其中一個經常會在這一帶四處遊蕩
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: 真是一群該死的混蛋！就該把他們身上的制服扯下來，然後通通都給扔進隔離區裡面。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: 好讓他們體驗一下與我們這些平民百姓相處是怎樣的一種滋味。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: 他們現在甚至就連建築也要強行接管了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: 真是一群野蠻之徒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: 一次、兩次，也就算了。來來回回、沒完沒了，就真的是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: 毫無羞恥之心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: 寶貝……千萬不要放其他人進來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: 他們是把你的家人給抓走了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: 哎呀。已經很久沒人問起過我的家人了，寶貝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: 大家都管我叫「大媽」——我生了整整一大群孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: 兒孫滿堂、人丁興旺……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: 甚至就連這棟房子可能都擠不下！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: 畢竟，這裡每一扇鎖上了的門後面都藏著一個瑟瑟發抖、楚楚可憐的孩子——躲著那些該死的怪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: 你並沒有回答我的問題
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: 那麼，他們是把你的家人給抓走了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: 哎呀……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: 抱歉，寶貝——話匣子一打開就停不下了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: 沒錯。這群雜種把我的每一個孩子都給抓走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: 不過……他們一定會為此付出相應的代價。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: 那麼，你呢——他們有把你的家人給抓走嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: 我沒有任何家人
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: 哎呀……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: 抱歉，寶貝——話匣子一打開就停不下了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: 沒錯。這群雜種把我的每一個孩子都給抓走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: 那麼，你呢——他們有把你的家人給抓走嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: 我沒有任何家人
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: 你孤身一人？既然如此，為什麼會有一棟這麼寬敞的房子？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: 獨自住在這裡……好像不太對吧，寶貝？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: 畢竟，如果家族不大、又何必去購置一棟此等規模的房子？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: 好吧，我無意強迫你透露自己的隱私。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: 只是在想——要是被關在隔離區的孩子能再次回到我身邊的話，就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: 他們沒有向你伸出魔爪，嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: 那麼，你的親戚現在在哪裡呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: 如此寬敞的房子，想必不會只有一個人居住。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: 好吧，我無意窺探你的隱私。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: 只是在想——要是被關在隔離區的孩子能重獲自由就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: 寶貝……千萬不要放其他人進來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: 你打算怎麼把自己的家人給救出來？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: 我沒有必要去做什麼，寶貝——他們自己會逃出來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: 自己會逃出來？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: 他們會刨開泥土、爬出地面，於隔離區外重新現身。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: 柵欄和鐵絲根本就無法阻擋我的孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: 要是無法從地下突破的話，他們便會把整個隔離區連同其中的所有人通通都給撕成碎片。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: 我能聽到聲響——他們快要來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: 你他媽的到底在說什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: 你瘋了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: 時機成熟之時，圍牆終將倒下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: 死亡將遍佈地表……而他，終將降臨、滿懷渴望。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: 到時，這些穿著制服的傢伙就再也無暇顧及我的家人了——他們需要面對更大的麻煩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: 我能聽到聲響——他們快要來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: 你他媽的到底在說什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: 你瘋了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: 我們會踏平你們搭建的一切設施……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: 圍牆將會轟然坍塌……大街將被鮮血染紅——目之所及，屍橫遍野……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: 我能聽到他們在地下爬行的聲響——已經近在咫尺了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: 你是偽人嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: 燒焦的肉塊，散發著無比甘甜的香氣……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: 這些傢伙的手藝還挺不錯——就是烤得有點過於酥脆了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: 你這裡有的是人，寶貝。足夠我們大快朵頤。我的孩子一定可以在這裡吃飽、喝足。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: 我能聽到他們在地下爬行的聲響——已經近在咫尺了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: 你是偽人嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: 這棟房子真是一個不錯的地方，極其特殊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: 非常寬敞、幾乎沒什麼人住，有著足夠的空間。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: 我能聽到他們在地下爬行的聲響——已經近在咫尺了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: 你是偽人嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: 一無是處的卑鄙小人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: 他們會來找你的！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: 媽媽找到一處新的巢穴了，孩子們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: 快點爬到這裡來吧，他……已經不再需要這棟房子了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: 媽媽想念你們，寶貝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: 快點來吧，這棟房子非常適合我們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: 快點爬到這裡來吧，孩子們——媽媽找到了一處新家。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: 非常寬敞、極其舒適，而且……空無一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: （殺了她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: 把這棟房子給我們吧——你明明就這麼地恨它！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: 你明明就想將它燒成平地！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: 快點交出來！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: 為何要如此劇烈地抗拒？我非常清楚，你很想要——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: 擁抱死亡……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: 怎麼，有什麼問題嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: 為何會把人類看作動物？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: 我這麼問你好了——我們……到底是什麼東西呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: 我們獵殺動物、將其吞食，並且完全不會對此感到絲毫的良心不安——這，便是自然規律。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: 然而，社會卻給我們套上了枷鎖。幸好，這些日子已經一去不復返。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: 你樂於看見現在的這種狀況？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: 非常簡單——社會強加於我們的愚蠢規則已然消失無蹤。現在，一切都變得清晰、明瞭。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: 組建族群、選出首領，膽敢威脅其存續的人只有死路一條——這，便是我所敬重的法則。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: 最糟糕的是什麼，你知道嗎？披著狼皮的羊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: 你認為族群要比社會更加優秀？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: 不是披著羊皮的狼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: 也不能這麼說……只是，人們不再以面具隱藏自己的本性——對此，我感到非常欣慰。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: 然而，這些詭譎的羊卻毀掉了一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: 披上狼皮，惺惺作態。將自己偽裝成真正的人類。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: 實則只是一群懦夫，只會挖洞、躲在地下。我寧可直接向他人發起正面挑戰，也不願去玩你追我趕的貓鼠遊戲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: 如果想要打造自己的族群，就得學會如何去辨別這些魚目混珠的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: 你認為族群要比社會更加優秀？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: 不是披著羊皮的狼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: 你對此抱持懷疑？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: 昔日的社會，是無論如何也找不出一隻像這樣的羊的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: 太多廢話，太多規矩。一天到晚都陷在永無休止的爭辯之中，無法著手去做真正需要去做的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: 因此，首領的存在至關重要——沒有任何疑問、無需進行投票，他的話語即是法律。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: 其必須展現出無比強大、毋庸置疑的實力。只有這樣，族群方能得以存續。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: 沒錯——我指的是被你們稱為「偽人」的懦夫、敗類。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: 過去就像老鼠一樣藏於地下，耐心等待我們變得虛弱不堪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: 如今則是在玩弄人類的道德觀念，利用我們的憐憫之心來苟且偷生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: 因此，我們得露出自己的獠牙——告訴它們人類也是動物。否則，遲早會被它們取而代之。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: 怎麼，有什麼問題嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: 為何一直盯著我的槍？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: 我看得出來——你有成為首領的潛力。你把這裡的人管理得井井有條，展現出了非常優秀的統率能力。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: 這棟房子非常不錯，軒敞明亮、門庭若市。只是，裡面的住客……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: 他們怎麼了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: 你認為有偽人混於其中？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: 你收留的都是一些無能之輩、軟弱之徒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: 說說看——老弱婦孺到底有什麼用處？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: 族群必須要由強大的個體組成。否則，便無法存續。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: 你想要我幹什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: 你想要我將他們通通都趕出去？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: 我擔心的並非披著狼皮的羊，而是弱不禁風的狼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: 你的族群缺乏主幹、過客芸芸。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: 找出最強的個體，將其留下吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: 你想要我幹什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: 你想要我將他們通通都趕出去？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: 你得捨棄弱者。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: 拿來殺雞儆猴——舉行公開處刑。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: 如此一來，就能鞏固你對族群的掌控、展現自己的權威。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: 目睹弱者消亡卻毫不畏懼的……即為真正的狼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: 他們便能留下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: 我並不是什麼冷血的殺人兇手
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: 我只會向偽人扣下扳機
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: 要是對他們不管不顧的話，你的威信將因此一落千丈——他們會覺得你是無膽匪類。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: 心慈，不過就是手軟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: 你得冷酷、無情。偽人？直接一槍嘣了。老弱婦孺？也是同樣下場。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: 如此一來，他們便會去畏懼你。如此一來，他們便會去遵循你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: 我並不是什麼冷血的殺人兇手
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: 我只會向偽人扣下扳機
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: 想騙誰呢？你的眼神已經將一切都表露無遺。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: 你殺過人——不要裝作自己是什麼正人君子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: 災變開始之前，我稱霸街頭、肆意馳騁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: 大家都畏懼我、敬重我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: 你有沒有想過——如果一直持續過著這樣的生活，自己的靈魂到底何時會被玷汙？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: 我，則對此毫不在乎、任由內心逐漸腐爛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: 某天，一個不知死活的計程車司機拒絕載我一程。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: 如果置之不理，我的聲譽將蕩然無存。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: 於是，我打斷了他體內的每一根骨頭。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: 而他的孩子也因此記得這次教訓，人們也和往常一樣畏懼我、敬重我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: 只要不再照顧弱者，便可以更上一層樓。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: 災變開始之前，我稱霸街頭、肆意馳騁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: 大家都畏懼我、敬重我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: 你有沒有想過——如果一直持續過著這樣的生活，自己的靈魂到底何時會被玷汙？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: 我，則對此毫不在乎、任由內心逐漸腐爛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: 某天，一個不知死活的計程車司機拒絕載我一程。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: 如果置之不理，我的聲譽將蕩然無存。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: 於是，我打斷了他體內的每一根骨頭。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: 而他的孩子也因此記得這次教訓，人們也和往常一樣畏懼我、敬重我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: 怎麼，有什麼問題嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: 既然你開口閉口都是族群，為何不自己去打造一個呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: 你為什麼會收留這些人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: 只要這樣，那個高高瘦瘦、通體蒼白的偽人就無法對我下手了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: 我想要向大家伸出援手
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: 我只是想要有人陪伴，僅此而已
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: 因為這些人需要一個領袖
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: 先回答我的問題
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: 也就是說，之所以會收留他們、就是為了保住自己的小命？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: 根本不是首領該有的想法，而像一隻被嚇壞了的狗囝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: 這個族群並不需要軟弱之人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: 看來，你並沒有統率他人的資質——只好由我勉為其難、取而代之了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: 真是一項崇高的目標——非要說的話，就是有點傻。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: 你不可能拯救所有人。遲早，你會將某人拒之門外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: 不過，倒是挺符合首領應該具備的資質。對此，我沒有任何異議。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: 就這？你只是害怕一個人待著而已？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: 根本不是首領該說的話，而像一個畏畏縮縮的懦夫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: 沒錯，就是這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: 既然如此，我便不再質疑你的統治。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: 我拒絕——對你來說，不知道反而會比較好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: 我早就已經透露得太多了。現在，輪到你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: 如果你不適合引領這族群，我就會親自將你取而代之。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: 去你媽的！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: 你憑什麼覺得自己比我優秀？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: （拔出槍來）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: 趕緊離開吧，否則——就不要怪我向你開槍了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: 閉嘴，狗囝。於我眼裡，現在的你一文不值。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: 如果你不知道自己出於什麼理由領導眾人，當初又為什麼要主動站出來承擔這份責任？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: 就此離開吧。否則，我只好放倒你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: 我知道族群如何運作，我遵循自然法則生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: 既然你如此軟弱，便不配充當首領。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: 就此離開吧。否則，我只好放倒你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: 好吧，事已至此……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: 你很清楚——我也有一把槍，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: 把手中的武器給放下吧，不要讓場面變得更難看。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: （向他開槍）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: （把槍放下）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: 去死，你個狗娘養的——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: 雜種……你竟然開槍了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: 真乖。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: 不過，你不該就此收手的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: （他看準機會拔出了武器）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: （他把槍口對準了你）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: （幸運的是，你及時抽出了自己的霰彈槍、扣下了扳機）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: 你把嘴上的繩子給剪斷了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: 枕室衣長遏矇！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: 窩倍塔悶風尚了罪罷！久音餵——塔悶停卜東窩宰爍神麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: 我不明白你在說什麼
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: 你聽得懂我說的話嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: 窩卜冥擺膩宰犟神麼。艾……蓋譖麼班訥？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: 匹汝，鞭早眸種宮瞳域岩？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: 我們到底該怎麼溝通？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: 窩克伊蟲副膩爍得花，染猴膩隊詞坐處翻硬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: 葉序，折羊得花……器馬，窩久能冥擺字機道滴宰爍蟄攜神麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: 怎麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: 「怎麼」是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: 你是想要問我什麼事情嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: 窩嗨室卜冥擺膩宰犟神麼……不裹，膩毫嚮室剃了格紋梯？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: 勘賴，折硬改室格醫吻刺。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: 窩嗨室卜冥擺膩宰犟神麼……不裹，膩毫嚮室剃了格紋梯？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: 勘賴，折硬改室格醫吻刺。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: 嘿，你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: （你拍了一下他的肩膀，並指著他嘴邊的傷口）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: 你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: 還會痛嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: 卜毫伊斯，膩能……宰爍衣鞭碼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: 還——好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: 還……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: 還好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: 毫腩罰因……不裹，硬改遊爸醫斯給船底倒爸。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: 不止，窩得族鍋室否頁宰罰升瞳癢得室清。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: 枕室衣長遏矇。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: 你打算怎麼回家？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: （你將雙手置於頭頂，做出了屋頂的樣子）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: 假？膩室——宰紋館魚假得神麼室清碼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: 窩室籟折李襬方毫油得，節過……確罰升了蟄癢得室清。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: 嫌宰得撞框，久艮……久艮衣脫矢衣癢——窩室宰時照卜倒器獺得瓷克翼型溶了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: 我該怎麼把你送回家？難道，要坐飛機？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: 你有查過船票嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: （你將手向下一揮，劃出了一道弧線）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: 肥雞？膩絕德……顯宰害遊夯板隕英？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: 我得區納立達婷衣霞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: 爍卜釘害遊扮罰克翼李凱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: （你擺動起一隻手，模仿在海浪中行駛的船隻）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: 膩得醫斯室……佐穿？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: 嫌宰海遊讀倫星石？窩惠區茶衣蝦得，斜斜！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: 你為什麼笑得這麼開心？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: （你露出了笑容，並用手指示意——指了指自己的嘴巴、又指了指他的嘴巴）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: 艾雅，膩爍蟄格雅。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: 膩衣釘卜輝翔心——窩達婷倒，活扯害宰隕星！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: （他舉起一隻手，開始沿著另一隻手的手臂移動）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: 不知，是否有人能開車送你回家？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: 窩卜冥擺膩宰犟神麼，碰油。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: 冥舔，窩久能惠嘉！器馬，克醫道扯戰立區。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: 金萬，窩久惠李凱。栽箭！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: 再——見！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: 你是在說火車嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: 你要離開了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: 窩婷卜董，包千。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: 不裹——冥舔，窩惠區扯戰衣嘆酒井！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: 葉需，窩種魚克醫輝假了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: 祝、你——好、運！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: 一首以沉默編織而成的十四行詩……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: 不知，你的手狀況如何？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: 已經失去知覺一段時間了。不過，倒還是能感受到疼痛與寒意就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: 也可以說是在意料之中吧。我只希望最為美好的瞬間能晚一點再到來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: 我曾經深愛過一個女孩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: 我非常珍惜與她一起度過的時光。即使相坐無言，也依舊能跟她心意相通——突然，我恍然大悟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: 我一直以來都在自欺欺人，根本就從來都沒有真正地去了解過她。或許，所謂的「盡在不言中」只不過是我的一廂情願罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: 然而，我還是希望——有朝一日，我們能以一份超脫愛情本身的愛意去愛著彼此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: 一首以沉默編織而成的十四行詩……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: 跟我說說這個女孩吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: 我總能在她的雙眸之中看到如同銀月一般凜冽的光芒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: 她與災變截然相反、互相對立。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: 要知道，世上從未有過如此精緻的美麗——沒有任何一絲、一毫的詭譎。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: 我渴望揭開她的秘密。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: 如今，她已成為我的豐碑。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: 指引我繼續前行的燈塔。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: 一首以沉默編織而成的十四行詩……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: 你們是怎麼相遇的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: 某刻，我得知了自己的命運——敗血症很快冷酷、無情便會取走這條性命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: 我驚慌失措。我意識到自己馬上就會消失於世上……不是在遙不可及的將來，而是在僅僅數個月之後。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: 之後，偽人開始從地下爬出……我在一棟廢棄了的房子裡面發現了她。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: 一個包裹著白色亞麻繃帶的女孩，面容淒美、動人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: 於現今這個殘酷的世界之中，誰都只顧著自己、已經沒人會在乎這般美好——除了我之外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: 「怪異得難以存活，珍稀得不該消逝」——你也應該聽說過這句話吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: 的確在理，然而……我還是輕輕地抱起了她脆弱的身軀，將她帶了回家。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: 當一切都結束後，我會挺起胸膛說——我之所為，皆出於愛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: 一首以沉默編織而成的十四行詩……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: 這個女孩現在在哪裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: 我花費了相當長的一段時間去領略她無比飽滿的美麗、去感受她令人心驚的沉默。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: 直至……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: 一群穿著黃色制服、看不清臉龐的不速之客闖了進來，打破了這份寧靜。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: 抓住了她，帶走了她。至於理由——我想，已經不言而喻。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: 真是遺憾……我根本完全不了解她。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: 如今，已經再也不可能抵達她的身邊……如同飲啜回憶一般，只能說是天方夜譚……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: 人人都七嘴八舌地說著要拯救世界，然而卻無法就具體的方法達成一致。答案其實非常簡單。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: 正是在於沉默、在於美麗之中——要是大家能……感知到這點，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: 她嘗試教會我，而我卻只學到了何為「安寧」。於可怖的事物之中窺見一絲優雅。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: 起碼，現在……我已經做好了追尋她的準備。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: 真是一個糟糕透頂的世界……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: 接下來，有什麼打算？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: 再明顯不過了——我們尚未敲定租賃協議的相關細節。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: 具體來說，該怎麼做？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: 你現在關心的竟然是這個？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: 別告訴我，你連文件都沒準備好？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: 好吧，既然如此……建議你去尋找一所公證機構、領取一份。真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: 開什麼玩笑？現在哪裡還有什麼公證機構？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: 為何你自己不去？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: 與此同時，如果你能以恰當的方式稱呼我，帶上一點應有的尊重——本人將不勝感激。譬如……「先生」。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: 唉……現在這個世道，人人都把教養拋到了九霄雲外……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: 隨你便吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: 媽的，給我滾一邊去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: 總不能連地圖都不會看吧？又不是什麼非常困難的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: 而且，再次重申——還請帶著敬意稱呼我為「先生」。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: 隨你便吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: 媽的，給我滾一邊去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: 我為什麼要幫你去跑腿？而且，再次強調——還請稱呼我為「先生」！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: 我是一名受人尊敬的公民，不是對你馬首是瞻的跟班。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: 隨你便吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: 媽的，給我滾一邊去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: 你是故意的，對吧？起碼假裝配合一下也好啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: 注意你的語氣——我的人格尊嚴受到憲法第21條的保護，神聖不可侵犯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: 因此，強烈建議你立即擺正自己的態度、對我表現出應有的尊重，否則情況可能會變得……非常難堪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: 真是一個糟糕透頂的世界……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: 你就不能別再糾結這個了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: 當然不能——我還在等你敲定租賃協議的相關細節。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: 我沒有什麼需要跟你敲定的東西
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: 你這是在開什麼玩笑？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: 真是遺憾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: 恐怕這違反了憲法第131條的規定。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: 你真的把我給惹惱了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: 一直沒完沒了地引用法律條文，你都不會累的嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: 提醒你一下——根據憲法第131條的規定，我們之間必須簽訂租賃契約。而且，這又有什麼奇怪的了？我只不過是在履行一名公民應盡的義務罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: 你真的把我給惹惱了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: 一直沒完沒了地引用法律條文，你都不會累的嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: 哎呀，我就料到你會出口成髒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: 順帶一提，此舉違反了管理規章第5.61條。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: 來吧，儘管繼續好了——你遲早會自食其果。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: 沒錯。對於自法律、法規以及憲法之中引經據典一事，我樂此不疲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: 我非常清楚自己享有的各種權利！不能因為你自己的無知而認為其他人無權享受它們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: 與此同時，再次提醒你——還請以恰當的方式稱呼我！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: 真是不長記性。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: 真是一個糟糕透頂的世界……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: 接下來，有什麼打算？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: 我留意到你持有一把槍械——我能看一下相關的執照嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: 與你無關
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: 我到底哪裡惹你了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: 好吧，由此看來……你並沒有相關的執照。畢竟，根據你的反應——這是最為合理的推測。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: 難道，你以為手握槍枝就能恣意妄為、藐視法紀？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: 就可以去隨意審問他人，而自己則不會受到質疑？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: 大錯特錯！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: 「一山還有一山高」——就算是你，也應該聽說過這句話吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: 夠了，我手邊需要處理的事情早就已經堆積如山了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: 你能不能別廢話了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: 我只是想要搞清楚你到底是個什麼樣的人而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: 變得戒備起來了……看來，被我戳中了痛處——你並沒有相關的執照。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: 你覺得自己並不受到各種規章、制度的約束。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: 你覺得自己能嗅出威脅。與此同時，還不允許他人提出質詢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: 你錯了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: 「一山還有一山高」——就算是你，也應該聽說過這句話吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: 夠了，我手邊需要處理的事情早就已經堆積如山了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: 你能不能別廢話了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: 哎呀……真是一個可憐的人。沒人敢質疑你、沒人敢檢查你是否具備偽人的特徵——對你來說一定相當難熬，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: 到底是誰賦予了你決定他人生死的權力？到底是誰賦予了你這樣的一種權威、權限？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: 其餘的人就只能乖乖地坐在一邊、祈禱自己不會成為下一個被你消滅的對象。然而，你現在卻想要他人的同情？並且，偏偏是從我這裡？你這是在開什麼玩笑？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: 恕我直言，你自己不也在四處對他人進行檢查、給對方灌輸一些無稽之談嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: 四處窺探，把每個人都看作潛在的殺人兇手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: 不過——當然，我們還是不要指出真正的殺人兇手到底是誰為好。畢竟也許……只是也許……根本就沒有什麼偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: 如此一來，你會變成什麼呢？一個濫用自己地位、利用這片混亂來滿足自己嗜血慾望的……徹頭徹尾的瘋子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: 至於其他民眾？聽到廣播之後驚恐萬分、慌不擇路，如同蒼蠅撲向糞便一般紛紛用到你門前……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: 說說看——最初被你收留的那些人，真正活著現在的到底有幾個？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: 如我所料。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: 真是一個糟糕透頂的世界……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: 先生？你在聽嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: 令人吃驚……你竟然帶著敬意稱呼我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: 然而非常遺憾，已經有點晚了——我很快就會進行檢舉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: 檢舉什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: 向誰檢舉？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: 你已經再也騙不到我了，我已看破你的真實身份。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: 這棟房子並不屬於你——你把原先的主人殺了，取而代之。我將就此事聯絡FEMA。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: 沒錯，他們會來找你的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: 一派胡言
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: 看來，該讓你永遠閉上嘴巴了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: FEMA，也就是聯邦緊急事件管理局。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: 起初……對於你就連一份簡單的契約也無法完成一事，我是願意去理解、妥協的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: 不過，和你聊的時間越長、事情就變得越清晰。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: 現在，終於水落石出了。這棟房子並不屬於你，你是冒名頂替的假貨。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: 你是個偽人！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: 趕緊收拾好自己的東西吧，他們很快就會來把你抓走——就在今晚！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: 一派胡言
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: 看來，該讓你永遠閉上嘴巴了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: 無論如何，我都會進行通報——把脖子洗乾淨等著吧，他們會來將你抓走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: 隨你說去，趕緊給我離開這裡
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: 你死定了（抽出槍來）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: 好啊，儘管試試看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: 等等——什麼？！你瘋了嗎？！這是非常嚴重的犯罪行為！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: 我拒絕——不要以為自己能就此脫身。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: 我會繼續待在這裡，直至FEMA抵達為止。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: 我會當面向他們訴說你的惡行、證明你是一個危險的犯罪分子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: 等等——什麼？！你瘋了嗎？！這是非常嚴重的犯罪行為！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: 你敢！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: 趕緊離開，否則——就不要怪我向你開槍了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: 要是不肯離開的話，就等著吃子彈去吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: 好吧，你讓我別無選擇
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: （向他開槍）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: 我絕對不會讓你逃脫FEMA的追捕——除非跨過我的屍體，否則休想！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: 他們一定會抓到你！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: 你也一樣！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: 殺人兇手——你是個偽人，你並非人類！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: 不要！！！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: 啊——！！！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: 要是能大撈一筆的話就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: 你的拾荒事業開展得還順利嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: 好吧，是這樣的——我本以為這棟房子已經荒廢了，於是才會想要偷偷地給溜進來……沒想到裡面還住著人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: 我只會拿取死人的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: 我是說……想想看——人都已經不在了，還留著大衣幹嘛？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: 對方已經掛了，物品散落一地。而我依然活著，何不物盡其用？說不定可以救我、或是我在乎的人一命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: 難道，你就不會為了拯救自己的心愛之人而拿走屍體上的東西嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: 或許也是時候該藉此機會停止再將每個逝者當作神仙一樣供奉了——只是隨便說說而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: 要是能大撈一筆的話就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: 為何會選擇成為一名拾荒者？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: 不然的話，要去做什麼呢？我並不想傷害他人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: 於是，只好選擇了這一條路。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: 首先，死人不會反抗。其次，他們遺留的東西……屬於無主物品。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: 我無意害人，只求活下去——或許，還能在路上向其他需要幫助的人伸出援手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: 要是能大撈一筆的話就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: 你在拾荒過程中都發現過什麼東西？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: 可多了，兄弟——幾乎都數不過來……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: 讓我想想……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: 我曾經找到過一個廢棄的圖書館。架子上依舊擺滿了各式各樣的書籍，只是都蒙上了一層非常厚重的灰塵——就好像在等待某人回來將其取走一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: 我曾經誤打誤撞闖進了一個藝術新秀的展覽場地。牆上依舊掛著展出的圖畫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: 我曾經……還看過一次與眾不同的日落，美輪美奐——就如同一幅掛在天際的繪畫一般。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: 現在，再也沒有人會冒著風險駐足、仰望天空。然而，過去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: 我非常懷念昔日的光景。當時，我總是會起一個大早——大街尚未喧囂、晨霧低垂瀰漫、草上露珠未乾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: 而且，太陽……天啊，如此明亮、無比燦爛，彷彿在向你許諾一個美好的一天。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: 如今，太陽卻變成了我們的敵人。到底為什麼會變成這樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: 真希望誰能站出來解決這一連串的破事。如此一來，或許就能讓大家喘口氣了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: 要是能大撈一筆的話就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: 你還會繼續拾荒嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: 我還在繼續拾荒的。不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: 某次……沒錯，某次的遭遇一直令我耿耿於懷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: 我找到了一棟房子——空空如也、沒有威脅，一切如常。只是地上躺著一具屍體。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: 背後被人開了好幾個洞，倒在了什麼東西的上面。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: 我猜，大概是想要把什麼東西給藏起來吧。於是，我走近他、將屍體翻了過來……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: 不好意思，之後的事情下次再說吧——好嗎？我還沒有做好心理準備去回想起當時的一幕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: 要是能大撈一筆的話就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: 那具屍體的下面有著什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: 好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: 我將他翻了過來，然後發現了——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: 一個已經死去了的女孩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: 如果是大人……既能預料得到，也在情理之中。然而，小孩？受到的衝擊完全不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: 看著眼前死去了的女孩，我感到骨鯁在喉、芒刺在背。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: 她甚至還緊緊抱著一隻絨毛貓咪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: 全都被鮮血染紅了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: 女孩的表情因恐懼而扭曲、早已凝固……就如同她知道死亡降至一般。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: 甚至有這麼一個瞬間，她看起來非常害怕我會搶走自己的玩具。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: 就好像，即便已經死亡、人類殘忍的本性卻還是令她無法就此安息一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: 這幅景象給我內心帶來的衝擊要比想像中更大。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: 當天，我萌生了就此收手的想法、不再打擾死者的休眠……不過，我已經陷得太深了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: 只能一條路走到黑、繼續拾荒。否則，我便無法活下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: 大家都說——無論我們如何掙扎，都逃不出命運的掌心。或許，的確如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: 希望那些偽人可以就此乖乖地回到地下去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: 為何會成為一名掘墓人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: 嗯？哎呀，這個……其實我也不是很清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: 墓地其實就跟……就跟圖書館沒什麼兩樣。你知道嗎？只是，裡面的「書籍」並不是拿來閱讀的……而是靜靜地躺在地下，僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: 我對每座墓穴都瞭如指掌，誰長眠於其中、雙手如何擺放、穿著何種衣物……就連名字也記得一清二楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: 然後，某天我正挖掘一個新的坑洞。風平浪靜，一切如常。正當我感覺自己已經挖得足夠深了的時候，定睛一看——竟然是空的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: 你敢相信嗎？竟然是空的！然而根據文件上的紀錄，裡面不可能是空的、而是有一具遺骸在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: 某個早就已經死去的傢伙，印象中生前曾留著八字鬍。結果——嗖的一下，便如同清晨的露珠一般消失得無影無蹤了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: 如果……一名逝者突然人間蒸發了，是不是意味著……他們又再經歷了一次死亡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: 希望那些偽人可以就此乖乖地回到地下去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: 發現墓穴裡面空無一物後，你做了些什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: 我在邊緣坐了下來，向裡面仔細看了看——沒錯，什麼都沒有。然而，當我抬起頭來……我看到遠處突然之間站了一個人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: 對方一動不動、只是注視著我，就好像是在出席某人的葬禮一樣。雖然沒有眼睛，不過……牙齒卻白得嚇人——閃爍著光芒，露出了微笑。靜靜地站著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: 媽的，我差點就被嚇得屁滾尿流。真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: 我立即頭也不回地逃離了現場——關於開溜，我還是非常有自信的。不過，他並沒有追上來。只是……如同煙霧一般消散得杳無蹤跡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: 簡直……亂七八糟。與此同時，偽人開始在各地出現、搞出無數爛攤子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: 希望那些偽人可以就此乖乖地回到地下去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: 既然都已經沒有人會去埋葬死者了，繼續挖掘新的坑洞又有什麼意義呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: 我早就已經不再挖掘新的坑洞了。只是在……留意有沒有什麼不尋常的事情而已。不過——當時經歷過那驚魂一刻、偽人冒頭後，我開始去……翻找新近落成的墓穴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: 並非抱著玩玩的態度，而是非常、非常地小心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: 心想說不定會有一、兩個這些怪胎被誤埋在裡面。把手中緊握的鏟子當作利刃，做好了隨時發動攻擊的準備——一旦出現了什麼動靜，就會猛地直接砸下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: 不過，並沒有任何的發現……只有本應埋在該處的遺骸，僅此而已。死者依舊在沉眠，沒有東西爬出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: 我不禁尋思……或許，並不是早就已經被埋葬的死者突然復生。或許，偽人是本應入土為安……卻未能如願的遊魂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: 希望那些偽人可以就此乖乖地回到地下去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: 最近都已經沒有在挖掘新近落成的墓穴了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: 沒有了、沒有了！我並不傻。我這輩子……都在與死者為伴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: 之前，死亡對我來說並不是什麼值得擔心的事情。一旦死去，就會被他人埋葬——簡單、明瞭，對吧？然而，如今誰會來幫你入土為安？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: 即使真的有人這麼做了，你又如何確定自己會就此長眠地下？我曾經親眼目睹一座自己填上的墓穴變得……空無一物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: 我明明親手埋葬了他！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: 我不禁覺得……或許，我的墓穴到頭來也會變得空無一物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: 也許……也許，我早就已經變成了一個偽人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: 唉，還是……忘了吧，兄弟。只不過是一些胡言亂語罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: 希望那些偽人可以就此乖乖地回到地下去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: 照你看來，偽人來自何處？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: 你有注意到嗎？這些傢伙……看起來特別的似曾相識。不僅僅是面孔，還有……整個氛圍。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: 我確實是有個想法。不過，你真的想要聽？好吧，是這樣的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: 或許，偽人……並非死者。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: 或許，他們是思緒——我們未曾埋葬的思緒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: 恐懼、悔恨……不願意忘記的人、不想放下的感情……不斷堆積。當地下的寂靜過於深沉時，便破土而出。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: 並不貪圖血肉，而求獲得關注。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: 你越是害怕……他們就越是靠近。因為你記得他們——而任何被記住的東西……都會想要繼續活下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: 偽人……到底會不會做夢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: 你有睡覺嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: 嗯？沒有。我其實並不想要睡覺。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: 只是希望這裡還有人會做夢，僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: 不過……直到現在，還是沒有人願意與我分享自己的夢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: 或許，我看起來並不是很可信。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: 或許，他們之後就會敞開心扉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: 偽人……到底會不會做夢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: 為何如此癡迷於夢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: 怎麼能說是癡迷呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: 真是個奇怪的結論。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: 難道，你就從來都沒有好奇過自己的潛意識究竟想要傳達一些什麼訊息嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: 你就從來都沒有好奇過自己的腦袋到底藏了什麼事情？沒錯，我們甚至會對自身有所隱瞞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: 就比如說你——你是受到了什麼傷害，才會變得像現在一樣極力地去避免與他人接觸？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: 因此，我對其非常感興趣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: 不如，這樣好了——就來跟你說說我之前做的夢吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: 我被一輛巨大的黑色火車不斷地追趕著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: 突然之間，我的雙腿與地面融為一體、扎根於其中。我不禁大聲尖叫，接著便醒了過來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: 然而……與此同時，我也正駕駛著火車朝著自己直衝而去、無法停下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: 偽人……到底會不會做夢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: 你呢？你的夢中隱藏了什麼事情？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: 我嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: 我已經連續好幾天沒睡過覺了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: 不過，好吧——就來告訴你一些事情好了，反正也沒有人會去相信的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: 我能看見其他人的夢。這種感覺……妙不可言。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: 我也不是很清楚為什麼自己能做到這點。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: 然而……自從一切發生後，夢就……沉寂下來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: 就好像每個人都屏住了自己的呼吸一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: 我也變得無法入睡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: 好了——試著搞清楚我說的究竟是實話、還是在耍你吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: 只不過是迷失的靈魂罷了——與其他在這片已然破碎的大地上行走之人別無二致。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: 我們渴望永恆的和平與安寧。而且，我們清楚該如何透過它來實現……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: 死亡……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: 大家為何會對其望而生畏？難道，是出於對未知的恐懼嗎？還是，因為烙印在靈魂深處、源自教條的懲戒？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: 數千年來，我們孜孜不倦地探尋著生命的意義。其實，答案非常、非常地簡單……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: 死亡，正是人們之所以會誕生於世的理由所在。我們，正是其無比忠實的信眾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: 為何會去敬拜死亡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: 死亡是仁慈的化身。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: 無人不忌憚死亡，然而——這一感情是否合理？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: 想想吧，這個世界只不過是一個巨大的煉獄罷了、將我們折磨得不成人型。然而，憑什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: 數不清、道不盡的恐懼與苦難……難道，我們不配享有安寧嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: 死亡是我們無法理解的樂園。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: 宗教試圖簡化天堂的形象，因為這樣更易於人們接受。只是，生命何曾簡單過？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: 死亡亦是如此——如不親自接觸，便將無法理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: 為何會選擇待在我的房子？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: 這棟房子與死亡的連結無可比擬、世間罕有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: 最初，我們也不明白為何導師會選擇這個地方。現在，一切都變得清晰、明瞭。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: 這裡充斥著死亡的痕跡。雖無法目視，卻能感知到。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: 裸露的混凝土散發著鮮血的氣息。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: 不要誤會，我們並非要求你刻意進行殺戮。畢竟，即使沒有他人在一旁催促、你也已經奪取過好些性命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: 照我看來，你於死亡之間的聯繫遠比我們還要更加緊密。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: 你們在外面搭建的那些篝火是怎麼回事？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: 時機已至。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: 來自地下的天使會接受我們作為祭品獻上的骨灰、准許我們踏進死亡的領域。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: 如此一來，便能贏得它的青睞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: 你看起來惶恐不安。難道，是在害怕嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: 你很敏銳，房主先生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: 與其他充滿信仰的兄弟不同……我扔被揮之不去的恐懼纏繞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: 疑惑正一點、一滴地蠶食著我的心神。生命的盡頭究竟有著何物、又會是一種什麼樣的感覺？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: 導師曾經教導我們——該處並非天堂、也不會是地獄，而是某種無法言說之地。不過，我始終無法在腦海中想像出一幅與之對應的光景……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: 如果連他也無法完全領悟死亡的本質，我們又怎麼可能理解得了它的真諦呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: 萬一僅僅接觸並不足以達成這一夙願呢？萬一它完全超越出了人類的理解範圍呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: 然而，我並不敢對導師的旨意有所質疑。我能從他的眼神之中看到無比的篤定與浩瀚的知識。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: 他要求我們擁抱信仰、展示決心。做好準備。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: 唯有如此，方能渡過死者之河、翻越白骨之山。最終，抵達我們夢寐以求的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: 死亡，被它擁進懷抱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: 為何會去敬拜死亡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: 親切的房主先生——提及死亡之時，還請包含敬意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: 如果帶著不恭的態度肆意談論它，便會被視作褻瀆者、予以最為嚴厲的懲罰。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: 雖然我非常害怕，不過導師曾說過——死亡是諸神之中最為仁慈的一位。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: 不會帶來饑荒、瘟疫，抑或戰爭。只會……平等地賜予眾人安息。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: 因此，我們需要抵達它的所在之處。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: 為何會如此迫切地追尋死亡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: 這趟旅程無關我們的意志，而是出自死亡降下的神諭。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: 它持續不斷地呼喚著、想要將我們引導至自己的領域。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: 導師認為正是因為如此，太陽現今才會燃燒得如此猛烈、試圖將我們自地表驅離。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: 死亡將會賜予我們寂靜、安寧，以及合一。眾人將於它的臂彎之中重聚一堂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: 哀悼死者，只是徒勞——因為……總有一天，我們將再度相逢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: 你打算怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: 時機已至……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: 我很害怕……根本無法停止顫抖……不過，我必須擁抱信仰、展示決心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: 導師相信我——我絕不能令任何人失望。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: 然而，恐懼……恐懼卻依舊侵蝕著我的思緒……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: 放過我們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: 放過我們——放過我們！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: 你們會在這裡待多久？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: 不必擔心，房主先生。我們不會給你添任何麻煩的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: 我們非常感激你的熱情款待，自然——也並不想激怒你。你為我們做的事情早已非常足夠。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: 我們會待在這個房間、靜靜祈禱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: 我們需要好好休息——這趟旅程將會非常艱苦、非常漫長。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: 你們要前往何方？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: 外族之地。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: 人類的性命並非永恆，我們只是地球的過客。既然有來到這裡的一天，也定有離開這裡的一天。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: 外族將接過這片土地，於此生根、發芽。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: 它們的到來並非偶然。將其喚來此處的聲音、引領我們離去的聲音，實則同出一源……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: 死亡……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: 為何會覺得是死亡將偽人喚來？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: 死亡一視同仁——人類、野獸、外族……無一例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: 死亡面前，眾生平等。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: 它一直在等待恰當的時機，現在——已經快了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: 我們必須籌備儀式……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: 你們要籌備什麼儀式？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: 時機已至，該跨越現有界域、遷至新的家園了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: 我們將前往死亡的領域——永恆和平與安寧之王國。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: 該出發了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: 怎麼了，親愛的？想要跟我聊聊嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: 你認為這裡怎麼樣？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: 非常舒適。考慮到現在的各種狀況……遠比我想像中的要更好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: 謝謝你允許我待在這裡。還以為自己要在天亮之前流落街頭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: 你呢？感覺如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: 非常焦慮
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: 還可以吧——我們都得拚命活下去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: 我能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: 鑒於現在的狀況……制定長期計劃根本就沒有任何的意義。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: 因為永遠也不知道什麼東西會先找上門——太陽、四處遊蕩的瘋子，還是偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: 不過，人類曾經遭受過、戰勝過不止一次的災變。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: 我想……即便死去，我們也總會留下一點什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: 之後，他人將會找到這些我們曾經活在這個世上的蹤跡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: 如此看來，也沒什麼不好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: 心態不錯，我很喜歡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: 不過，千萬不要將情緒憋在自己心裡——它們總會以最糟糕的方式爆發出來……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: 特別是在你最不想要失控的時候……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: 與他人傾訴一下吧，沒必要覺得尷尬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: 不想跟我透露的話，就去找其他住客吧——誰都可以。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: 如何，這個要求不過分吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: 怎麼了，親愛的？想要跟我聊聊嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: 我昨晚目睹到了一件奇怪的事情
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: 哎呀——是什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: 你的肚子——鼓了起來
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: 沒什麼……或許，只是我看錯了而已
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: 你的意思是……我看起來就像是懷孕了一樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: 沒關係——不如說，我很高興你能直截了當地將自己的疑問給說出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: 我想……之所以會有這樣的一種錯覺，大概是因為你現在有點害怕需要對他人負責吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: 我懂。如今這個世道，誰都不知道自己還能否看到明天的日出……光是照顧好自己就已經費盡九牛二虎之力了，更不要說去擔心他人了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: 根本就不知道閉上眼睛之後還能否再次睜開。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: 沒錯……我的確對此感到擔憂
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: 不對——我不認為是什麼錯覺
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: 然而，你的確在因某些事情而感到困擾——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: 沒關係。畢竟，恐懼令我們所有人都疲憊不堪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: 我留意到你晚上會起來四處巡視。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: 而這意義重大。就你這樣戒備之心如此強的人來說，對於自己收留的住客卻表現出了非比尋常的重視。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: 真是……非常有趣。你這個人充滿了矛盾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: 不過，也有可能單純只是因為你失眠而已——恐懼的確是最為糟糕的床伴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: 沒錯……我的確對此感到擔憂
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: 不對——我並不認為是什麼錯覺
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: 承認這點需要很大的勇氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: 不過……面對恐懼，我們也無能為力——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: 萬物都將終結，誰都難逃一死……誰又能心平氣和地接受這種想法呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: 重要的是，你會在何處找到自己的救贖——又或者是，你究竟能否找到自己的救贖。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: 好吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: 無論如何……我都非常擔心你的狀況。記得偶爾留意一下自己的狀況，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: 我希望你能安心。畢竟，你我住在同一個屋簷之下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: 要是你瘋了的話……我們便難逃天罰。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: ……不小心押韻了。*輕笑*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: 還挺巧妙的，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: 怎麼了，親愛的？想要跟我聊聊嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: 我很確定自己昨晚看到你是懷孕的狀態——給我解釋清楚
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: 你有點嚇到我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: 你真的確定自己昨晚有看到過什麼東西嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: 你為什麼不立即叫醒我呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: 又是被恐懼迷惑了心智嗎？害怕自己會死掉……又或者是，被保護他人的責任壓得喘不過氣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: 難道，是因為我嗎？抑或，是被其他人佔據了你的腦海？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: 媽的——不要再擾亂我的思緒了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: 我……很確定自己看到了某些東西
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: 你不久前曾經提起過自己的父親。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: 之後就再也沒有聊過關於他的事情了。說實話，我對他並不了解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: 不過，現在……我感覺你跟他一模一樣——正所謂，有其父必有其子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: 你害怕自己這輩子都會困於他的陰影之下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: 對嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: 他早就已經過世了。為何要執著於一個並不存在的幽靈呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: 即便是在來世，你也絕對不會與他重逢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: 不必擔心——我相信你們並不會進入同一個死後的世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: 不要試圖一次抓住所有答案。道路都是一點一滴、一磚一瓦地砌起來的——懂嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: 還有就是……千萬不要再像這樣跟我說話了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: 目睹你現變成這樣，我感到非常的痛心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: 不過，沒有必要畏懼死亡、責任，以及親密關係、或是其他什麼東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: 因為，這些事物全都是生活的一部分。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: 不要試圖一次抓住所有答案。道路都是一點一滴、一磚一瓦地砌起來的——懂嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: 也許，這樣想會對你有所幫助……一切都塵埃落定之後，我們或許不會就此消亡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: 昔日，我相信無論是天堂、抑或是地獄，都是存在的。如今？我已經不太確定了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: 或許，我們會去到某個完全不同於此二者的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: 不知，你覺得如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: 怎麼了，親愛的？想要跟我聊聊嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: 你懷孕了，我很確定——而且……不久之後就會生下來
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: 哎呀。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: 看來，絕望佔據了你的心智。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: 你所相信的一切都在分崩離析……卻對此鞭長莫及、無能為力。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: 難道，是因為你不想看到事態如同現在一般發展？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: 抑或，是因為……你覺得自己並不屬於這個世界——甚至，其他任何世界？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: 不要顧左右而言他——你懷孕了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: 難道，你自己就不害怕嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: 親愛的……我根本不可能生得這麼快。我的肚子甚至都沒有隆起來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: 我能問你一件事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: 如果我真的懷了一個孩子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: 要是——就跟你說的一樣，快要誕生了的話……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: 你會怎麼做呢？你會找到他嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: 他根本就不應該存在於世上
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: 我還沒有做出決定
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: 嗯……問得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: 死亡的確非常可怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: 主要因為——我不知道等待著自己的將會是什麼東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: 天堂？輪迴？又或者是……某些完全不同的事情？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: 根本就沒有人能回來與我們講述。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: 不過，關於你認為自己目睹到的事情……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: 如果我真的懷了一個孩子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: 要是——就跟你說的一樣，快要誕生了的話……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: 你會怎麼做呢？你會找到他嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: 他根本就不應該存在於世上
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: 我還沒有做出決定
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: 人類總會本能地想要保護自己熟悉的事物……即便已經不再有益也一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: 也許……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: 也許，該去睜開雙眼、迎接新的事物了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: 抑或，對未知的恐懼真的把你嚇得不輕？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: 我會把這個孩子給找出來
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: 不久後就會出生——我對此非常確定
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: 不要害怕放手——特別是當這些事物已經不再有益於你的時候。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: 我們之所以會緊緊地抓著某樣東西不肯放手，經常是因為它令我們感到熟悉——僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: 沒錯，打破現有的習慣的確會使人感到非常痛苦……只是，塞翁失馬、焉知非福。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: 我會把這個孩子給找出來
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: 不久後就會出生——我對此非常確定
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: 隨你便吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: 等到時機成熟之後……就告訴我你找到了什麼吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: 我生於城市、長於城市，甚至還有過一套高樓大廈裡的公寓呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: 不是位於鄉間的村舍，既無家屬、也無孫輩。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: 因此，我總是喜歡坐在門口的長凳上——不光能感受到些許的生機，還能聽到各式各樣的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: 然而，災變發生之後……就連這點樂趣也蕩然無存了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: 眾人紛紛倒下……死亡的氣息無處不在，生命的美好無處可尋！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: 每當走進樓梯間，地上總會躺著好些蓋著白布、無人認領的屍體。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: 天啊……這足以令人崩潰、希望自己也能一同死去，而不是一而再、再而三地目睹這種無比悲傷的光景。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: 於是，我踏上了旅程！想要尋找一個依舊有故事可講、依舊有生活氣息的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: 瞧瞧——現在，命運把我帶到了這裡！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: 雖然我並不是什麼虔誠的信徒，不過……像現在的這種時候，總會覺得自己冥冥之中受到了上帝的指引。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: 不過，寶貝——大家早就已經忘記了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: 要是還有人活著的話，也不會特地過來找我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: 現在的年輕人，幾乎個個都有這樣的毛病。被生活搞得暈頭轉向，就連自己的親人也能忘記。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: 全都只顧自己，忙這忙那……就連一通詢問近況的電話也懶得打來！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: 某次，我和鄰居在長凳上聊了起來——她得意洋洋地談論起了自己的孫子。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: 「我的孫兒特別孝順，總是把我放在心上！」'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: 的確，她沒說錯！他是一個非常好的孩子。總會跟我打招呼、問我近況如何。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: 我甚至因此而感到過一絲嫉妒……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: 之後，死亡降臨到了她的身上……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: 接著，這個孩子變得特別尖酸、刻薄。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: 結果發現，之前和藹可親的樣子全都是裝出來的、目的是為了想把鄰居公寓的鑰匙搞到手……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: 你說說看——為何人能臉不紅、心不跳地當著對方的面扯謊？而且，甚至還是自己的親人。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: 結婚、生子，然後……你猜怎麼樣？他們根本就不愛你！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: 還好，我早就已經沒有丈夫囉……一個又老、又笨，還滿肚子壞水的傢伙！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: 哎呀——他已經死了好一陣子囉，寶貝。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: 糟老頭子……毀了我大半輩子！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: 之所以會與他成親，是因為父母的逼迫。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: 「嫁給他吧，女兒——他是個好人」他們這麼說到，我也只好這樣做了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: 起初，他的確對我關愛有加。不過……隨著婚禮的喧囂散去，骨子裡面的劣根性便暴露無遺。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: 你猜怎麼樣？我在熱得要命的爐子前忙活了半天，得到的感謝只有一句——「不要再煩我啦，你看不見我吃得正香嗎？」'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: 三不五時，他甚至會跟好友一起外出悶頭喝酒、一去就是好幾個小時，搞得自己不省人事！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: 醉醺醺地回來之後，還會編一些就連鬼也不會信的事情——說是在車庫裡玩了多米諾骨牌之類的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: 如果我直接問他是不是去喝酒了，就會挨一頓劈頭蓋臉、毫不留情的罵，甚至能把整棟房子給震塌。好一個惡毒的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: 之後，死亡降臨到了他的身上。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: 最初，我感到如釋重負。只是……很快，空虛便悄然襲來。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: 剛一開始的時候，看看電視還能有所紓解。結果，現在……裡面播的全是一些胡言亂語、無稽之談。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: 於是，我走到路邊、坐在長凳上，靜看世事流轉。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: 天啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: 看著自己周圍的一切，我的確感到好了一些。孩子們放聲大笑、一對又一對年輕的情侶牽手走過，就連狗狗也邁著輕快的步子……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: 然後，災變就發生了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: 於是，大家都把自己鎖在了家裡、熙熙攘攘的生活景象隨之消逝。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: 透過窗戶往外看……也不是什麼好事。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: 孩子們曾經嬉戲的地方如今堆滿了運屍袋。野狗在街頭遊蕩……鄰居開始以對待陌生人的冰冷眼光打量彼此。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: 生活彷彿一下子便停滯不前。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: 現在，甚至根本就已經分辨不出誰說的是真話、誰說的是假話……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: 要是大家能不再爾詐我虞，就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: 抱歉，我今天已經沒有力氣再聊下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: 然後，我決定離開這一機構。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: 問這個幹嘛？難道，你是想知道我為什麼不相信FEMA嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: 先從這個問題開始好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: 偽人其實是某種病毒——你相信這樣的說法嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: 我認為根本就沒有偽人這種東西
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: 不太相信。不過，我也不知道它們究竟是什麼東西
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: 相信
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: 要真是這樣的話，你又為什麼會這麼執著於對住在這裡的大家進行各式各樣的檢查呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: 不要騙我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: 好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: 我能理解——我也不知道偽人究竟是什麼東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: 不過，我可以非常、非常確定地告訴你——它們並非病毒。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: 好吧，要令你失望了——事實恐怕並非如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: 前一刻還好端端的傢伙，後一刻卻突然性情大變……一轉身的工夫，就變成了偽人——你有沒有見到過這種情況？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: 沒有——對吧？這樣的案例根本就不存在。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: 你得明白……FEMA並沒能掌控現在的局面——他們只不過是在裝模作樣罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: 他們將醫院關停、把人送至隔離區……到底是為了什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: 幫助大家？你有沒有見到過有誰得到治癒，解除隔離、重返生活的？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: FEMA只不過是將市民集中到一處、把他們給關起來，然後隨心所欲地做自己想做的事情罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: 既然如此，你又為何要替FEMA工作？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: 不要再胡說八道了——給我滾出去吧
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: 我實在是不忍心袖手旁觀、眼看人們接連死去。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: 因此，我加入了FEMA、盡己所能地幫助這些可憐的市民逃出隔離區。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: 我對他們進行檢查、做出診斷，然後偽造文件、放其離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: 你這樣做，很有可能會把偽人給放虎歸山的
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: 某件事情？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: 非常遺憾，我也得放你「離開」
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: 真是遺憾——你甚至不願意聽我把話說完……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: 好吧。既然如此，我便不再打擾你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: 那你認為該怎麼做？任由他們接連死去？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: 我宣讀過希波克拉底誓詞——我會盡己所能、竭力守護生命與健康。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: 然而，後來……由於發生了某件事情，我不得已逃出了隔離區。真是令人遺憾。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: 一切，都發生在我所駐紮的隔離區裡面。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: 蛤？！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: 難道，你認為我不該向他們伸出援手？而且——現在，還要因此把我給趕走？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: 沒想到我會說出這種話——也許，你比FEMA要更加惡劣。起碼，他們還會裝出想要幫助大家的樣子。而你……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: 看來，這裡已經沒有我的容身之處了。至於受到你「看顧」的其他住客……我實在不敢想像他們會遭受怎樣的命運。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: 萬一他是人類，該怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: 你別無選擇
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: 哎喲，兄弟……不要說這種話，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: 出了這種事情，我的心裡早就已經七上八下、坐立不安了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: 好吧……你說的對。的確，根本就沒有其他的辦法。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: 我好懷念只要坐在駕駛席上、什麼都不用去思考的時光。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: 現在？整個世界都被偽人搞得一團糟……或許，下一個上車的乘客會冷不防地請我吃子彈也說不定。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: 唉……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: 我不想淪落為路邊的爛泥，沒人管、沒人顧……就像老爸一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: 希望我的好運還沒花光……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: 你開的是什麼車？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: 你的這輛車到底有什麼與眾不同的地方？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: 一台精美絕倫的經典之作……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: 亮黃的車體、鍍鉻的輪圈、流暢的曲線……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: 不過，現在已經……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: 該死的FEMA……這輛車對我來說十分重要！一群混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: 它是我老爸的座駕。沒錯，他也是計程車司機。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: 我還記得……小時候，我特別喜歡在夜裡搭他的車。我總是會在後座睡著，因此、他也只好帶著我。然而，後來……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: 這麼說吧——他的運氣到頭了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: 我一般不會跟別人說這事，不過……我感覺應該可以信任你。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: 某天，老媽要去出差——於是，老爸帶上了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: 就在那次，我們接到了一個令人永生難忘的乘客。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: 筆挺的西裝、光禿的腦袋，笑起來如同兇猛的野獸一般……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: 只要是生活在這座小鎮上的人，都知道他是誰——就連我這個小鬼也不例外。大家都很清楚，絕對不能違抗他的要求。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: 然而，老爸是個正直的人、堅持拒載。結果……我們都因此招致了反噬。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: 我們都因此付出了代價。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: 我們失去了自己的家。自此以後，再也沒有辦法在同一個地方停留太長時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: 我們當時基本上可以說是身無分文。於是，老爸把一直在開的計程車給留了下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: 然而，當他老了、債台高築時……就開始後悔這個決定，心想當初就該把它賣掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: 說這輛車受到了詛咒——我們所遭遇的不幸全都拜它所賜。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: 他根本就不懂。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: 問題並不出在車上，而是他的自尊。正是他的自尊，令我們失去了一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: 不過……雖說因為他所作出的這個抉擇，令我不得不提前開始工作、養活家庭……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: 我還是非常愛他。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: 我好想念他……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: 我並沒有要得寸進尺的意思，只是……要是不太麻煩的話，能不能——就是，幫我打給電話給他？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: 這是老爸號碼——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: 告訴他說……我很好，一切都在掌控之中。不過……現在，暫時還沒有辦法透露自己的所在位置。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: 你為什麼要隱瞞自己在FEMA工作過的事實？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: 你為什麼要假惺惺地跟我們演戲？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: 你真的不明白嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: 你到底是怎麼問得出口的？！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: 要是被人發現我曾經替FEMA賣過命的話……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: 聽好——我已經不再是FEMA的工作人員了。就當做是……我主動退出的好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: 聽好——我已經不再是FEMA的工作人員了。就當做是……我主動退出的好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: 沒錯，我的確是做過一些為大家所不齒的事情——'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: 把人給帶走、送到隔離區……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: 然而，聽好——我只是在執行自己的工作而已，好嗎？照命令行事罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: 問我被帶走的人之後怎樣了也沒有任何意義……這是上級處理事情，與我無關。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: 把我叫成殺人兇手、或者其他什麼東西，更是……荒謬至極。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: 要是……我是為了拯救大家，而把殺人兇手都送到了裡面——到時，又該怎麼稱呼我？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: 某次，我帶走了一個具備偽人特徵的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: 長話短說……之後，他的情況出現了惡化、死在了隔離區裡面——三不五時就會有這樣的事情發生。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: 接著，他的妻子找上了門來、想要知道什麼時候可以把人給放出去。我們只好告訴她，她的丈夫已經不在了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: 她非常震驚，開始大聲叫嚷、說我們是殺人兇手，要我們把屍體歸還給她。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: 我們如實告知——按照規定，我們不能這樣做。然而，這並沒有讓她消停下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: 她直接在大門處扎了營。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: 我們實在沒有辦法，只好把屍體交給她。結果，違反規定的人全都被炒了魷魚——我也不例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: 她就是非得把那具屍體給帶走不可——該死的瘋婆娘，害我丟了自己的工作。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: 現在，我已經沒有地方可去了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: 而她，不僅沒有把屍體給安葬、反倒是背著他四處遊蕩。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: 就因為這樣，害的我們全都丟了飯碗——真是值了，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: 你們這些FEMA的傢伙就是一群混蛋
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: 運氣有夠不好
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: 蛤？！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: 我只不過是在執行自己的工作、履行自己的職責……到頭來，不僅因為某個蠢貨被開除了——'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: 而且還要被你汙衊成混蛋？！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: 去你媽的。我可不想再繼續待在這裡了，我這就走。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: 天啊，難道——大家全都瘋了不成？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: 事實如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: 自從太陽出現問題、感染開始肆虐之後，大家全都瘋了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: 難道，那具屍體能抵得上我們的工作？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: 她能與丈夫重逢，是件好事
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: 就不應該把屍體交給她
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: 你的意思是——我們被炒「是件好事」？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: 你們這些平民根本就什麼都不懂。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: 早知道就一槍把這個婆娘給射死了，就跟她的丈夫一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: 你說什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: （拔出槍來）
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: 表情這麼凝重幹嘛？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: 按照規定，如果受到感染的平民狀況不佳……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: 我們可以就地「處置」這一問題。如此一來，就不會導致說有偽人出現在隔離區裡面。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: 你應該放他離開的
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: （拔出槍來）
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: 謝謝你的理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: 我並非什麼殺人兇手，只是在聽命行事而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: 你、你這是在做什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: 冷靜一點——拜託，他是個偽人！而且，就快要轉化了……我們無論如何都沒有辦法放他離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: 不要開槍——我只是在聽命行事而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: 我也是這樣想的——就該按照規定來處理。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: 好了，我就不再囉嗦啦、省得招你厭煩。總之，謝謝你在知道我曾經替FEMA賣過命的前提下依舊願意收留我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: 要是哪天能復職的話，我一定會在上級面前替你美言幾句。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: 好了，需要說的就是這些啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: 對了，差點忘啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: 我明天晚上就會回家。記下我的號碼吧——我們最近剛安裝好線路。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour:  {0}。之後，就透過電話聯絡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: 好了，應該沒有漏的事情啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: 喝瓶啤酒，好好地休息一下吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: 喵！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: 撫摸貓咪
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: 抱起貓咪
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: 給貓咪餵一些罐頭（x{0}）
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: （你伸出手去，摸起了貓咪）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: （不是很清楚它到底喜不喜歡這樣）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: 喵！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: 撫摸貓咪
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: 抱起貓咪
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: 給貓咪餵一些罐頭（x{0}）
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: （你決定摸一摸貓咪）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: （看來，它非常喜歡這樣）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: （現在，已經不像剛一開始的時候這麼暴躁了）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: （似乎，它開始習慣你了）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: 喵！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: 撫摸貓咪
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: 抱起貓咪
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: 給貓咪餵一些罐頭（x{0}）
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: （貓咪非常喜歡被人撫摸）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: （你能感到——你一邊摸，它一邊不停地往你所在的方向靠過去）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: （如此可愛的舉動，叫人如何去抗拒？）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: 喵、喵、喵！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: （雖然難以看懂它的表情，不過……你很確定，它很高興）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: （你的心裡泛起了一股奇怪的感覺，今晚想必能安安穩穩地睡個好覺）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: （就好像這位毛茸茸的夥伴把自己的九條命分出來了一條給你、以此表達謝意一樣）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: （誰知道呢……或許，死亡會在今晚避開你的房子也說不定）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: 淒慘的孩子們……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: 怎麼了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: 蛤？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: 我……我只是在想……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: 如果這次災變沒有把人類盡數滅絕——如果大家存活了下來……會有什麼東西等著我們？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: 會有什麼未來等著我們？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: 難道，你是在擔心自己在新的世界裡會沒有立足之處？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: 如今，只憑一顆善良的心撐不久的——你最好找個人一起互相扶持
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: 一顆善良的心……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: 我無法倚靠暴力維生。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: 我也不知道自己能不能適應……你是怎麼說的來著——對了，「新的世界」。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: 好吧，看來你的計劃就是……不做任何抵抗，平靜迎接死亡？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: 既然如此，你打算怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: 誰都經歷過艱難的時期……現在的這一切並不是什麼令人感到陌生的事情
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: 我並不想要這樣。即使有人給予庇護……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: 殺戮也不會停止，暴力也不會消失。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: 好吧，看來你的計劃就是……不做任何抵抗，平靜迎接死亡？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: 既然如此，你打算怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: 誰都經歷過艱難的時期……現在的這一切並不是什麼令人感到陌生的事情
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: 我感到非常迷惘。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: 難道，我們要在一個滿是殘暴之徒的世界裡繼續生活下去？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: 難道，孩子們將來要向……殺人兇手學習？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: 現在可不是自怨自艾的時候
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: 振作一點！
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: 我不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: 我沒有任何想法。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: 只是希望……這一切能趕緊結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: 我……已經無法再忍受下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: 沒錯，只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: 我們該怎麼活下去呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: 大家都失去了理智，一心想要把與自己……有所不同的人給趕盡殺絕。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: 不管擋在自己面前的人是誰，都無所謂。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: 現在可不是自怨自艾的時候
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: 振作一點！
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: 為什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: 也許你可以令自己對一切都感到麻木不仁，然而……我做不到。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: 要是你能見到我所目睹的事情的話，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: 那幅光景……已經永遠地烙印在了我的眼睛裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: 熊熊燃燒的烈焰、慘絕人寰的尖叫……憤怒的臉龐、驚恐的神情……以及，被夷為平地的房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: 我實在無法做到跟你一樣。我沒有那麼堅強。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: 對我來說……只能這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: （她抖了一下，驚恐萬分地看著你）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: （內心的困惑令她一時之間忘了這場噩夢）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: （她捂住了自己的臉，低聲地哭了起來）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: （你不知所措——根本就沒人教過你面對這種情況到底該怎麼辦）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: （你小心翼翼地將手放在了她的肩上，就這樣維持了一會）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: （看來，最好還是讓她自己一個人靜一靜）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: 不如，這樣好了——也許，你可以幫我打個電話給他？我記得號碼是……{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: 好好教訓他一頓。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: 畢竟，他們也是他的孩子。他也應該幫忙一起尋找。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: 要是線路還能接通的話……就幫我打個電話過去，好嗎？號碼在這——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: 就說——我也對自己的所作所為後悔不已……甚至，想把自己的喉嚨給扯出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: 又或者是，直接罵她一頓。唉，我也不知道……也許，這樣會稍微輕鬆一點吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: 至於有些人……這麼說吧，則需要來自另一層面的幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: 其實，世上存在一些懂得如何驅散黑暗的……能人、專家。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: 要是有這樣的需求的話，我可以把聯絡方式給你。也許能派上一些用場呢……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: 我把號碼寫下來好了——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: 記得跟他們說，是我推薦的……千萬別忘了！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: 要是不麻煩的話，能幫忙打給他嗎？來，這是號碼——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: （他遞給了你一張紙條，上面寫著一串電話號碼——{0}）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: （也許，是大使館的聯絡方式）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: 我真的好想喝上一杯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: 你說我們是……「不朽之人」？到底是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: 我要對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: 關於這個……你可以試著往自己的腦袋開一槍，看看有什麼後果……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: 不過——換作我的話，不會這樣做。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: 因為，這種不朽並非尋常意義上的不朽。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: 死後，我們會進入輪迴、進行轉世，獲得新的生命、繼續過著生活——周而復始，循環往復。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: 我也知道這一切聽起來十分離奇，但是……如果你能看到我所目睹的事情，你一定可以理解我到底在說什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: 也許，偽人曾經也是人類——只是，死後轉生成了現在的模樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: 我也說不出個所以然來。我也不知道這一切究竟是什麼原理……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: 不過，我相信——大自然一定向我們隱藏了數不清的秘密。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: 而且，我一定會找到自己的女兒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: 雖說不清楚會在哪次生命之中，然而……我一定可以。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: 因為，我們都無法喪命。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: 我真的好想喝上一杯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: 為何FEMA會追捕你？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: 我要對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: 因為，我當時正處於這一切事件、這一片混亂的中心。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: 就在它們爬出來的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: 不知，你是否記得那些關於城郊會有惡魔出沒的荒誕故事？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: 當我沒問——現在，應該已經不會有人曉得了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: 你猜怎麼樣？其實，傳說都是真的。從一開始，FEMA就全都知道了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: 雖說，他們堅稱並沒有什麼怪力亂神。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: 然而，現在——太陽卻正無情地炙烤著每一個人……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: 而且，還有一群虎視眈眈的吃人怪物！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: FEMA知道自己搞砸了……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: 現在，他們正在忙著掩蓋自己的無能。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: 我只不過是在錯誤的時間、出現在錯誤的地點罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: 我真的好想喝上一杯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: 你是怎麼活下來的？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: 我要對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: 我是不朽之人。怎麼，這麼快就忘了？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: 好吧，我也不清楚……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: 其實，我也有著同樣的疑問。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: 也許，是運氣使然。也有可能是某股……更為崇高的力量在保護著我。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: 上帝——或是你們信仰的其他什麼神明。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: 又或者說，其實……我早就已經死了。現在這條，已經是新的生命了。我也不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: 只能說，問得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: 太可惜了，手上沒槍……不然，我也會問你同樣的問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: 而且，你這裡竟然只有啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: 要是能找來個酒桶的話，我能釀出一批令你讚不絕口的美酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: 我真的好想喝上一杯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: 你還知道些什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: 我要對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: 我對整個FEMA的架構瞭如指掌。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: 誰對誰負責、誰做了什麼，以及誰和誰搞在了一起。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: 而且，他們對偽人知根、知底——非常清楚它們有多麼的危險……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: 卻還是任由它們滲透進了城裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: 因為根本就沒有人把我們的安全當一回事。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: 這些傢伙只不過是政府洗錢的工具罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: 不管是誰，只要目睹到了他們犯下的罪行、都會遭到抹除。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: 這個組織根本就不想任何人知道關於他們的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: 而且，早在設立隔離區之前、他們就是這樣做的了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: 我也是費了九牛二虎之力才逃出了生天。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: 想知道機密資訊嗎？好，聽仔細了……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: 全都是FEMA的錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: 至於他們在電視上說的事情？淨是一些鬼扯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: 如果說有什麼要比偽人更加惡劣……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: 就是FEMA。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: 我真的好想喝上一杯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: 偽人是從哪裡來的？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: 我要對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: 城郊。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: 沒錯，我知道——隔離區的確離那裡有一段距離……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: 不過，我很確定。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: 我並不是什麼迷信的人。只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: 它們跟大家兩年前談論的惡魔，是同一群。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: 雖然，我也不知道它們究竟是怎麼滲透進這座城市的……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: 不過，我很清楚它們是在誰的默許下行動的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: 正是FEMA……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: 出乎絕大多數人的意料，偽人並非什麼異星來客。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: 而是與你、與我一樣——'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: 出生在這顆星球的生物！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: 我不能再待在這裡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: 我得去找自己的女兒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: 謝謝……不朽之人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: 哎呀……終於，能洗到冷水澡了——就得這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: 你感覺好些了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: 好多了、好多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: 不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: 我有點餓了。你……咳咳，有帶著什麼能充飢的東西嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: 有的（給對方一瓶啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: 怎麼，就連一瓶啤酒也沒有嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: 不要誆我……我都親眼看到了，你的冰箱裡面全是這些黃湯、塞得滿滿當當的。難道，你想說已經都喝完了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: 哈哈——這就對了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: 哎呀……真是不錯的滋味，我最喜歡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: 來，收下這些現金吧——給自己買點好東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: （你獲得了幾張皺巴巴的鈔票……然而，如今早已派不上用場）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: 好吧……謝了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: 我並不在乎你的這些錢
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: 沒錯，就是這個樣子！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: 你負責滿足我的需求，我負責給你支付酬勞。就是，咳咳——各取所需……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: 對於願意向我伸出援手的人，我從來都不會有所吝嗇、總是慷慨解囊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: 對了。來，收下這個吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: （你收到了一罐紅茶菌）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: 我實在是搞不明白，到底有誰會喝這……難以名狀東西？不過，你還是拿去吧——說不定能派上什麼用場呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: 「並不在乎」？怎麼，你覺得自己很特殊、鶴立雞群，還是怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: 拜託，人人都需要錢——這一整個世界就是靠著錢來運轉的！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: 好吧，要是現金不合你胃口的話……來，收下這個吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: （你收到了一罐紅茶菌）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: 我實在是搞不明白，到底有誰會喝這……難以名狀東西？不過，你還是拿去吧——說不定能派上什麼用場呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: 「沒有」？怎麼，覺得自己不可一世、無法買通？拜託，一切事物、均有價碼！愛、物品，以及人……無一例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: 這一整個世界就是靠著錢來運轉的，孩子！而我？則是其中的大人物——一名議員！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: 好吧，隨你的便——你一定會後悔的！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: 哎呀……終於，能洗到冷水澡了——就得這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: 你這次需要什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: 哎呀，竟然主動問起——真是令我歡喜！我的菸癮犯了……給我一根香菸吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: 好吧……（給對方一根香菸）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: 怎麼，就連一根香菸也沒有嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: 好吧！我就忍著好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: 哈哈——這就對了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: 順帶一提……想也知道，我以前抽的可是雪茄。不過，現在的這個情況……能找到一根香菸已經非常不錯了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: 沒錯……從前，一切都大相徑庭。現在？到處都是殺戮、混亂。完全就是一場噩夢！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: 該死……FEMA到底跑到哪裡去了，怎麼還不出來收拾這堆爛攤子？之所以會設立這一特殊單位，可不是讓他們天天渾水摸魚的！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: 要知道——我在國會任職的時候，可從來都沒有發生過像這樣的爛事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: 不過……話說回來，也許他們只是需要一點時間而已。好吧，只能繼續等了——俗語有雲，船到橋頭自然直。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: 你曾經在國會任職？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: 你……有參與到FEMA的設立之中嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: 對啊——我剛剛不是說了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: 哎呀，對了。來，收下你的獎勵吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: （你收到了幾張皺巴巴、毫無價值的鈔票，以及一張蓋有FEMA印章、略顯奇怪的明信片）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: 你怎麼會這麼想？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: 哎呀，對了。來，收下你的獎勵吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: （你收到了幾張皺巴巴、毫無價值的鈔票，以及一張蓋有FEMA印章、略顯奇怪的明信片）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: 「沒有」？！你到底知不知道我是誰？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: 我，可是一名議員！政府是一台相當複雜的機器——正是因為有著像我這樣的人，它才得以維持正常、無咎運轉！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: 我，即民眾的喉舌！沒有了我，像你這種傢伙的聲音根本就不會有人聽見。我，令你們的生活變得更好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: 換作平時，你根本就連頂撞我的膽子都沒有！而且，甚至都見不著我——立即就會被攆出去！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: 嘖……再也沒人在乎議員這個身份、這個地位了。大家都覺得我們在辦公室裡遊手好閒、無所事事……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: 哼。行啊——就來看看真正的惡況爆發時，到底誰會笑到最後好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: 哎呀……終於，能洗到冷水澡了——就得這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: 你還需要什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: 你還真是敏銳，孩子！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: 我想……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: 我想喝能量飲料！好讓自己可以……咳咳，鼓一下勁！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: 好吧——拿去（給對方一罐能量飲料）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: 怎麼，就連一罐EnerJeka也沒有嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: 好吧，當我沒說。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: 我並沒有……真不走運
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: 哎呀——就是這樣、就是這樣！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: 跟我說說關於FEMA的事情吧——他們到底是個什麼樣的單位？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: FEMA到底在規劃著些什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: 怎麼，是無糖的？哎喲，我呸……什麼垃圾！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: 你不如直接拿電池酸液給我喝得了，說不定都要比這種……等等——你剛剛說了什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: 你瘋了吧？這是機密！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: 我簽了保密協議——而你，沒有相應資格去接觸這些資訊！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: 來，拿著這罐咖啡、聊以慰藉吧。不要再問這樣的問題了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: （你收到了一罐咖啡）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: 難以想像，這竟然也是EnerJeka……天知道他們究竟往裡面加了什麼鬼東西。等等……你剛剛問了什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: 你瘋了吧？我什麼都不會告訴你——這是機密！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: 我簽了保密協議。真的不是我看不起你，而是你的確沒有相應資格去接觸這些資訊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: 來，拿著這罐咖啡、聊以慰藉吧。不要再問這樣的問題了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: （你收到了一罐咖啡）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: 媽的，你這是什麼意思？你倒是說說，餓著肚子要怎麼做事？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: 我可是在盡己所能地令你們的生活有所改善！我可是在為了你們義無反顧、挺身而出！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: 然而，你們一天到晚只會批評這些、批評那些……每個人都覺得自己聰明絕頂。既然如此，你們為何不進政府工作？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: 沒錯——因為你們只會抱怨，從不行動。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: 哎呀……終於，能洗到冷水澡了——就得這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: 怎樣？你又需要什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: 你挺機靈的嘛，孩子。我想要你手上的這把霰彈槍。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: 蛤？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: 你他媽的瘋了吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: 你沒聽錯，快點給我——我要它來保護自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: 不必擔心，我打過獵、知道該怎麼使用這個東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: 想都別想
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: 見鬼去吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: 嘴巴放乾淨一點，孩子。你沒忘了……自己是在跟誰說話吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: 只要我有那個意思，隨時都可以把你給關進監獄裡！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: 想都別想
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: 見鬼去吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: 我沒有聽錯吧——你、你說什麼來著？我可是一名議員！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: 好啊、好啊，你大難臨頭了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: 趕緊收拾自己的行李吧，我要把你給關進監獄裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: 對我來說，你跟偽人沒什麼區別
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: 我不在乎你是不是議員——對我來說，你根本就什麼都不是
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: 你瘋了吧，孩子？竟然這樣對民眾的喉舌大放厥詞！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: 你完蛋了，孩子——你完蛋了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: 把我惹火，是個天大的錯誤！我大發慈悲地提醒你一下——議員手握非常巨大的權力！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: 你很快就會屈服的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: 對我來說，你跟偽人沒什麼區別
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: 我不在乎你是不是議員——對我來說，你根本就什麼都不是
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: 你……你這混蛋！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: 我可沒有在跟你開玩笑！等著瞧吧——我一定會把你給關進監獄裡！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: 你……你這混蛋！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: 我可沒有在跟你開玩笑！等著瞧吧——我一定會把你給關進監獄裡！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: 哎呀……終於，能洗到冷水澡了——就得這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: 怎麼還沒把我給關進監獄裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: 嘲笑起我來了，是吧？好啊、好啊——用不了多久，你就笑不出來了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: 放在以前，頭銜、地位……的確有所威懾——如今，你什麼都不是
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: 現在，錢根本就沒有任何的用處——你怎麼還不明白？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: 不對……不對！我現在依舊在國會任職！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: 現在，只不過……是在休假罷了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: 哈哈哈……我這是在騙誰呢？生活已經再也不可能回到過去的樣子了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: 當初，還坐在辦公室裡的時候——全國上下都在為我們這些議員效力。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: 大家都畏懼我、尊敬我。車子會為我讓路，人們會爭相取悅我、討好我。然而，現在……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: 好極……因為壓力太大，我的胃都繃緊了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: 你現在滿意了吧？快一邊去，我已經受夠了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: 不對——不對！我還有很多錢！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: 雖然你並不在乎，但是……其他人都在乎……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: 哈哈哈……我這是在騙誰呢？生活已經再也不可能回到過去的樣子了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: 再也沒有香檳、再也沒有豪車、再也沒有女人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: 以前，憑藉金錢、一切的問題都不是問題。只要家產夠大，地位也會上升！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: 要不是因為這一系列的爛事……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: 好極……因為壓力太大，我的胃都繃緊了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: 你現在滿意了吧？快一邊去，我已經受夠了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: 我已經累啦，不要來煩我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: 明天再繼續吧——一邊去、一邊去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: 天啊，我實在是受夠這一切了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: 你為什麼會一個人到外面來？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: 怎麼說呢……家裡擠得不行、吵得要命，一點都不舒適。久而久之，就產生了離開的念頭、想要看看這個世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: 於是，我往包包裡塞了幾瓶汽水、一些零食棒——還戴上了上學的時候製作的這根老舊的友誼手鏈。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: 然後，就出走了。我想，爸爸和媽媽應該都沒留意到吧……管他們呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: 自此之後，我就四處漂泊——能在哪裡湊合住，就在哪裡湊合住。你猜怎麼樣？到目前為止，都感覺挺好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: 起碼，沒有人會在我背後說三道四、也不必再看別人的臉色做事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: 天啊，我實在是受夠這一切了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: 你是怎麼活下來的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: 就是……盡可能地撐過來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: 我會偷偷地溜進樓梯間、棚子裡，不然就是直接睡在樹下的空地上。只要找到有屋簷的地方，我都會跑進去躲避太陽。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: 手邊能拿到什麼就吃什麼。譬如——野菜、還有從商店裡順來的糖果棒，諸如此類。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: 怎麼露出這副表情？沒錯，我手腳不乾淨——這又怎麼了嗎？不然你倒是說說，我該怎麼活下去？我這個年紀，沒人會僱傭。於是，就只好湊合著過囉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: 唉，又怎麼了？難道，你以為我真的會偷你的東西？嘖……拜託。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: 怎麼，你這是要把我當作犯人來審問嗎？想都別想。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: 天啊，我實在是受夠這一切了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: 你打算過多久這樣的生活？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: 關心這個幹什麼？我自有方寸。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: 又或者說……讓我住在這裡，令你感到為難？我沒偷過你的東西吧？我沒堵過你的馬桶吧？既然如此，你為什麼還要總是過來又問這個、又問那個的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: 我知道了……也許，你也是一個變態。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: 我曾經遇到過一個傢伙，也像這樣收留了我、給我過夜的地方。說起話來，態度很好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: 我們看了一堆動漫、電影，諸如此類的東西。我還以為自己終於遇到一個像樣的人了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: 結果……他的手卻摸到了我的身上來。媽的，該死的變態。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: 要是敢動什麼歪心思的話，我一定會跟你拚命。我絕對不會讓任何人傷害自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: 雖然，我的爸爸也許是個混蛋……不過，他起碼也是教過我該怎樣把敢來找碴的人給打趴下的。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: 沒錯，滾一邊去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: 天啊，我實在是受夠這一切了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: 先前提到的那個傢伙，之後怎麼樣了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: 知道了又能怎麼樣？難不成，你是想知道……在我反抗時，該如何治我？是不是——是不是？唉……無所謂了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: 不要以為我看不出來——你之所以想要知道，根本並非出於好心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: 你只是不想收留會給自己惹禍上身的傢伙而已，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: 聽好，我並不是什麼麻煩人物——既沒偷你的東西，也沒砸破你的窗戶。所以……別老是把我當成什麼燙手山芋！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: 再說……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: 你需要我。不然，就會被那個半裸的偽人給拖出去、虐殺致死——對吧？沒錯，我聽說了。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: 要是非得如此的話，你……愛怎麼樣就怎麼樣吧！想怎麼檢查都可以，別來跟我搭話就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: 天啊，我實在是受夠這一切了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: 你的爸爸為什麼會教你怎麼去打架？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: 因為這樣，我就能把對自己圖謀不軌的變態給通通打趴下。又或者是，他就能拿我出氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: 揮出拳頭、承受打擊，諸如此類。日復一日，年復一年。你知道嗎？唯一的問題就是——他揍的不是沙袋，而是我的臉。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: 雖說，絕大部分的時間都是一些正經的操練——順帶一提，我對此深惡痛絕。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: 然而，也有情緒失控、把我給打得遍體鱗傷的時候。至於我的媽媽……她根本就不在乎，連看都懶得看一眼。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: 我可不想變成像他們這樣的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: 既然這麼嫌棄我、來回糟蹋我，當初又為什麼要懷上我、生下我？真是想破頭了都搞不清楚。生活真的理應如此嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: 而且，現在還有能把人給曬死的太陽、會把人給殺掉的偽人得應付。真是太棒了——一切都在變得更加糟糕。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: 難道，這個世界就連一點好事都沒有嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: 看來，的確如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: 我聽著呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: 醫院都發生了些什麼事情？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: 哎呀……說是一場噩夢也不為過。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: 災變開始之後，市民都一窩蜂地湧進了醫院、想知道自己到底是不是偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: 雖說已經解釋過了，我們並不知道該如何去進行相關的檢查、以及該如何去甄別……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: 然而他們根本不聽。一直在不斷地推搡，搞得我們根本就沒有辦法去救治那些真的生了病、需要幫助的患者。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: 最後，FEMA的工作人員出現了——他們認為這群市民會對目前的情況構成威脅……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: 於是，就把大家都給關進了隔離區。至於醫院……也因此被關閉了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: 也就是說，FEMA害得你失去了工作？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: 聽起來……FEMA也沒有做錯什麼吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: 其實……醫院關閉之後，我就去FEMA的其中一個隔離區裡工作了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: 你為什麼要這樣做？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: 所以——你也是FEMA的走狗
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: 那麼……你覺得像這樣把人都聚集到一處，是對的囉？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: 難道，你不認為這些所謂的「特徵」荒唐得很嗎？畢竟——全都是尋常人類會有的特質，不是嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: 沒錯，根本就是一派胡言！擁有一口完美無瑕的潔白牙齒，就說明對方是偽人？根本就沒有任何證據支撐！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: 我可以非常、非常確定地告訴你——他們一定在隱瞞著一些什麼事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: 其實……醫院關閉之後，我就去FEMA的其中一個隔離區裡工作了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: 我想要了解偽人、以及它們的特徵。不過……最後，卻毫無收穫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: 你為什麼要這樣做？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: 所以——你也是FEMA的走狗
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: 我……想要繼續幫助他人。這——是我的使命。我實在是沒有辦法對這一切視而不見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: 也許……不，算了吧。我還沒有準備好談論這件事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: 你這樣說，就有點不太厚道了。畢竟，你並不清楚事情的全貌。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: 也許……不，算了吧。我還沒有準備好談論這件事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: 我聽著呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: 好了……你之前是打算說些什麼來著？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: 不知，你對FEMA有何看法？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: 我認為FEMA在做好事
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: 我並不信任他們
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: 真是遺憾……我的看法和你完全相反。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: 雖然，我曾經與FEMA共事過一段時間。不過，我根本就沒有理由信任他們——特別，是親眼目睹了在那裡發生的事情之後。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: 根據我自己的經驗，裡面的醫生全都被蒙在了鼓裡、一無所知。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: 一個就連這些特徵因何而來、代表什麼都無法解釋清楚的機構，怎會令人信服？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: 經歷過這一切後……又怎能不去質疑他們？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: 我很失望。我本以為你不會被他們輕易欺騙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: 不錯——我也並不信任他們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: 說實話……雖然共事過一段時間，我也不是很清楚FEMA究竟在盤算著些什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: 不過——不管是什麼在驅使著他們，我都會貫徹自己救死、扶傷的使命。即使，要打破規定也在所不惜。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: 問題出在透明度之上。具體來說，其實……根本就沒有任何的透明度可言。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: 從來都沒人說明過這些「特徵」因何而來、代表什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: 只是塞給了我們一份指導方針，上面規定了誰要被歸類為偽人、誰又可以放行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: 自此之後，我覺得自己根本就不像一名醫生……更像是個在通行文件上蓋章的邊境警衛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: 於是，我開始偽造相關文件、幫助大家逃出隔離區。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: 我相信你應該還對此抱持著一些疑問，不過……要是不介意的話，其餘的事情還是留到明天再說吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: 我聽著呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: 你怎麼沒在隔離區裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: 因為……發生了這樣的一件事情……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: 當時，太陽剛剛升起。我正在回家的路上，這時——一名FEMA的工作人員叫住了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: 當下，我的心臟狂跳不已、膝蓋發軟，幾乎無法站穩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: 他喝令我轉過身來。我……甚至都做好了必死的準備。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: 他拿著來福槍、指著我的雙腿，警告我不准逃走。然後，他直勾勾地盯著我。接著……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: 他要求我伸出自己的舌頭，說得檢查一下我是否偽人。我沒有辦法，只好照做。不然，他有可能會直接扣下扳機。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: 突然之間……他哈哈大笑了起來，說——根本就沒有與舌頭相關的特徵，要是連這點都不知道的話、我這個醫生肯定當得很爛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: 我這輩子從來都沒有這麼害怕過。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: 就在那一刻，我心裡想的不是拯救他人、而是想要活命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: 我逃跑了——就像個懦夫一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: 這份羞愧，實在是……快要把我給壓垮了。我辜負了被留在隔離區裡的人們——我既對不起自己、也沒臉面對大家……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: 我不會因此而對你評頭論足
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: 即便如此，你還是可以拯救他人
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: 你是個可悲的懦夫——快點滾出我的房子
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: 謝謝你的理解。這……的確讓我感覺好過一點、沒那麼壓抑了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: 我總是忍不住去想——要是能留在那裡、堅持到最後的話，也許……我還能拯救更多的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: 恐怕……我已辦不到了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: 我的工具、儀器，全都落在隔離區裡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: 換句話說……我現在根本就一無是處。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: 我知道你一直都希望自己能得到一些治療。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: 只是，像我這樣的老人……沒了設備、僅憑雙手，又能做得了什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: 要是讓你失望了的話，我很抱歉。然而，面對偽人的威脅——我也只能說是有心、無力了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: 不必擔心——即使這樣，我也會讓你繼續留下來
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: 好吧……離開的時候可千萬不要撞到門上去了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: 我想，你是對的。我……是該離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: 謝謝你的理解。這……的確讓我感覺好過一點、沒那麼壓抑了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: 我想，FEMA遲早會發現相關文件是偽造的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: 然而，我卻還是無法擺脫這樣的一個念頭——要是我能捨命堅守、留到最後，也許就能拯救更多的人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: 我很害怕這股罪惡感會一直縈繞在自己的內心、至死方休。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: 我想，你是對的。像我這樣的一個老頭，實在是沒臉待在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: 沒什麼好顧忌的，兄弟——想問什麼，都儘管問。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: 你還在擔心……FEMA會找上門來、把自己給帶走嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: 真心希望他們已經忘掉我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: 沒錯，我搞砸了——不假思索就把人帶到了FEMA的地盤。我早該考慮一下，他們是不是也會對我出手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: 我本以為他們只會把乘客給抓走、不會管我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: 結果……他們不僅扣下了我的車子，還他媽的差點把我給一槍打死。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: 不過，拜託——我又能怎麼辦呢，對吧？要知道，那個傢伙是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: 沒什麼好顧忌的，兄弟——想問什麼，都儘管問。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: 你當計程車司機多久了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: 已經有一段時間了。我並沒有為任何的公司做事，而是選擇自己當老闆。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: FEMA根本就不會讓平民百姓隨心所欲地四處亂跑。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: 不過，這一系列的爛事總有結束的一天——對吧？因此，錢嘛……再怎麼樣都不會嫌多。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: 如今，路上危機四伏……大家為了自己的安全，出手都十分大方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: 而且，晚上開車總會讓我想起小時候的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: 你知道嗎？我之所以會成為一名計程車司機，都是因為受到了老爸的影響——想要跟隨他的腳步、成為像他那樣的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: 沒什麼好顧忌的，兄弟——想問什麼，都儘管問。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: 你今天看起來特別沮喪
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: 唉，我實在是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: 沒有辦法接受自己的車子已經離我而去了的這個事實……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: 沒什麼好顧忌的，兄弟——想問什麼，都儘管問。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: 你的爸爸怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: 希望我沒有過長時間暴露在陽光之下……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: 你……確定自己真的不是FEMA的工作人員？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: 我真的、真的不是FEMA的工作人員。我不是告訴過你了嗎？我是個工廠工人，專門製造、維修冰箱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: 我是在某台車子裡找到的這件制服。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: 你之前不是說……這是從一具屍體上扒下來的嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: 你沒在騙我吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: 呃……對、對的，沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: 我是在某台車子裡的，呃——一具屍體上扒下來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: 我想的是……這件制服應該可以保護我免受偽人的侵害，諸如此類。畢竟，FEMA的傢伙整天都穿著它、肯定是有著某種理由的，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: 我沒在騙你。我只是因為壓力比較大的緣故，記混了而已。沒什麼好奇怪的，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: 相信我，如果你知道我都目睹到了些什麼樣的事情……你就一定能理解我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: 來這裡的路上，甚至都快要把我給嚇死了——躺在地上、早已死透的屍體……竟然還在不斷地抽搐。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: 希望我沒有過長時間暴露在陽光之下……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: 難道，你不覺得穿著FEMA的制服到處亂晃是個壞主意嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: 蛤？這個……我不覺得。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: 我是說——的確，我知道很多人都不喜歡FEMA。然而……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: 哦，我懂了。你是想說……我有可能會因為冒充他們而惹禍上身，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: 聽好，我……認為只要我能好好解釋，對方就一定會相信、理解我的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: 沒有必要把他們當成什麼牛鬼蛇神，這又不是什麼十惡不赦的秘密會社。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: 希望我沒有過長時間暴露在陽光之下……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: 來看看你的口袋裡都裝了些什麼吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: 蛤？你……想搜我的身？為什麼啊？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: 我想看看你到底有沒有FEMA的識別卡
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: 怎麼，難道……你隱瞞了什麼事情？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: 蛤？什麼識別卡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: 我可以對天發誓，我根本就沒有什……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: 看看不就一目了然了——把口袋裡的東西給通通掏出來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: （拔出槍來）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: 誰啊？我嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: 絕對沒有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: 看看不就一目了然了——把口袋裡的東西給通通掏出來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: （拔出槍來）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: 好吧、好吧，沒有必要這麼粗暴……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: 來，看吧……如何，滿意了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: 好啦，被你看穿了——我的確是FEMA的工作人員……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: 只是……拜託，不要告訴其他人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: 見了鬼了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: 好吧、好吧，不要開槍。來，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: 沒錯……我的確是FEMA的工作人員……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: 只是，最好別讓其他人知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: 希望我沒有過長時間暴露在陽光之下……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: 你為什麼要隱瞞自己在FEMA工作過的事實？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: 我得對你進行檢查
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: （看起來，這個話題已經結束了）'
    m_Metadata:
      m_Items: []
