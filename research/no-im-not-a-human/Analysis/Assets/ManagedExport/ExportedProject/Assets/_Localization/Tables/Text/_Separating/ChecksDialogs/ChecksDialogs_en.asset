    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507611
    m_Localized: 'Cultist2: A picture...? This is new.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507612
    m_Localized: 'Cultist2: I find myself feeling...uneasy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507613
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507614
    m_Localized: 'Cultist2: How...interesting.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507615
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
