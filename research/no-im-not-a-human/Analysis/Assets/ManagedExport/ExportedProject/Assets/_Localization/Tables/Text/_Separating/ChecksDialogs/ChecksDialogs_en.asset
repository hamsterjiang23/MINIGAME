    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701378
    m_Localized: 'Cultist3: I shall attempt to shift my robe. Please be patient.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701379
    m_Localized: 'Cultist3: ...'
