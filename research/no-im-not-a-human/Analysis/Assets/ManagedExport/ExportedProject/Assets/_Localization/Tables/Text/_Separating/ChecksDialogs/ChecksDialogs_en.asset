  - m_Id: 41582931045507597
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507598
    m_Localized: 'Cultist2: ...We all suffer our share of hardships.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507599
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507600
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507601
    m_Localized: 'Cultist2: Sleep lays beyond our reach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507603
    m_Localized: 'Cultist2: They say it hastens Her inevitable arrival.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507604
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507605
    m_Localized: Pull out the gun
