      m_Items: []
  - m_Id: 23515512964112392
    m_Localized: 'Alkonost: This is the end.'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112393
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112394
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112395
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112396
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112397
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112398
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112399
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112400
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112401
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112402
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112403
    m_Localized: 'Sirin: This is the end.'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112404
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 23515512968306688
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341248
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341249
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341250
    m_Localized: 'Theorist: By all means. Just be aware... Testing me could lead you learn things you wished you hadn''t.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341251
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341252
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341253
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341254
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341255
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341256
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341257
    m_Localized: 'Theorist: Here.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341258
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341259
    m_Localized: 'Theorist: I have an awful habit of chewing on pencils, you see?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341260
    m_Localized: 'Theorist: Cracks, blood... Yes, yes, I know. But it''s just a bad habit...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341261
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341262
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341263
    m_Localized: 'Theorist: Sure.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341264
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341265
    m_Localized: 'Theorist: See the ink? It''s under my nails, on my skin, worked deep into the pores. Tis but the price you pay for knowledge.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341266
    m_Localized: 'Theorist: See the ink? It''s under my nails, on my skin, worked deep into the pores. Traces of knowledge...and I''ve paid dearly for them.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341267
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341268
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341269
    m_Localized: 'Theorist: Ah, the eyes. Yes, of course.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341270
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341271
    m_Localized: 'Theorist: They are blue. Good, it means they haven''t changed me yet.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341272
    m_Localized: 'Theorist: When searching for information, you have to keep your eyes wide open. Take it all in, before they change reality.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341273
    m_Localized: 'Theorist: I see the world as it is. No filters, no fog. Do you?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341274
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341275
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341276
    m_Localized: 'Theorist: Armpits, you say? ...Now that''s unusual.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341277
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341278
    m_Localized: 'Theorist: See the hair? Natural barrier. It slows evaporation, keeps the electrolytes in.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341279
    m_Localized: 'Theorist: Those who get rid of it are letting themselves be controlled by perspiration, making themselves vulnerable.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341280
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341281
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341282
    m_Localized: 'Theorist: A photo?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341283
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341284
    m_Localized: 'Theorist: Photos can''t be trusted. They can be altered, manipulated, erased. But this... This moment cannot be tampered with.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341285
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341286
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341287
    m_Localized: 'Theorist: Ears? Ah, I see.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341288
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341289
    m_Localized: 'Theorist: You must''ve heard the only truthful news broadcast out there, yes?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341290
    m_Localized: 'Theorist: Looking for signs? Worry not, I''m protected.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341291
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341292
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341293
    m_Localized: 'Theorist: Go ahead, shoot. But watch out for those "supplements", the food is how they control you...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341294
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341295
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341296
    m_Localized: 'Theorist: You fear those who seek the truth? Then you don''t fear me...you fear yourself.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341297
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341298
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341299
    m_Localized: 'Theorist: Surely you realize that weapons are just another tool for control?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341300
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341301
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341302
    m_Localized: 'Theorist: Raise my hands? Ever wonder why, across all cultures, raising your hands is a sign of surrender? Who decided that, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341303
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341304
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341305
    m_Localized: 'Theorist: You want to erase this photograph? Or the person in it, hm? Think about who''s pushing you to do that.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341306
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341307
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341308
    m_Localized: 'Theorist: Shooting me and listening to the resonance of the gunshot may be a good identifier, that''s true, but...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341309
    m_Localized: 'Theorist: ...Trying aiming a Visitor. They''ll give off a different vibration!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341310
    m_Localized: 'Theorist: You want me silent? You think it''ll make things easier? Silence is just another tool they use to control us.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341311
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341312
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341313
    m_Localized: 'Theorist: You know, in some countries they hide microscopic antennas inside dental fillings. It''s true, look it up.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341314
    m_Localized: 'Theorist: Under a microscope, the cracks show traces...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341315
    m_Localized: 'Theorist: ...Traces of Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341316
    m_Localized: 'Theorist: Someone once told me, "If you hold the truth, be ready for them to take it." But I won''t let go! Not until the very end.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341317
    m_Localized: 'Theorist: Stare long enough, and the truth starts staring back. See it in my eyes?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341318
    m_Localized: 'Theorist: People fear smelling bad, but it''s actually natural. Artificial scents are just another way that they control us.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341319
    m_Localized: 'Theorist: They distract. They mask the truth. Everything should smell like reality.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341320
    m_Localized: 'Theorist: Photographs are anchors. They hold us in reality, prove we were here, that we existed. That''s why they''re so dangerous.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341321
    m_Localized: 'Theorist: They program us through sound, you know. Frequencies, infrawaves—they alter the mind. We must cut through the noise.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341322
    m_Localized: 'Theorist: Even if I''m gone...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341323
    m_Localized: 'Theorist: ...The truth will remain.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341324
    m_Localized: 'Wifefema: Huh? Test me? Hell, but make it quick. I don''t have time for this.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341325
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341326
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341327
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341328
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341329
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341330
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341331
    m_Localized: 'Wifefema: Here.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341332
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341333
    m_Localized: 'Wifefema: See? White as snow, straight as a picket fence. Just like a doll''s!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341334
    m_Localized: 'Wifefema: Gums bleed a bit... Happens. I smoke a lot. Nerves, honey.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341335
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341336
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341337
    m_Localized: 'Wifefema: Sure.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341338
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341339
    m_Localized: 'Wifefema: So, what d''you think? I ain''t got time for a manicure, not when our country is in danger.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341340
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341341
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341342
    m_Localized: 'Wifefema: It''s so damn dry here... That''s why I''m blinking a lot.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341343
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341344
    m_Localized: 'Wifefema: Green, I know...they''re mine. These are tears of joy. Why? Oh honey...my husband''s with FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341345
    m_Localized: 'Wifefema: Now that sounds good, don''t it?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341346
    m_Localized: 'Wifefema: Green, I know...they''re mine. But murky, you say? I doubt it, mister!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341347
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341348
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341349
    m_Localized: 'Wifefema: You can put that look back in your pocket, mister. You asked for it!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341350
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341351
    m_Localized: 'Wifefema: Gave my hubby a hug before he left, and the next day I start itchin'' all over.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341352
    m_Localized: 'Wifefema: That no-good pretender give me fleas or somethin''?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341353
    m_Localized: 'Wifefema: Well, I ain''t here to strut a runway! No sir!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341354
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341355
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341356
    m_Localized: 'Wifefema: If you insist... Just don''t go showin'' my hubby, now.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341357
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341358
    m_Localized: 'Wifefema: Lord above... What did you expect? A centerfold?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341359
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341360
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341361
    m_Localized: Here, take a look.
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341362
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341363
    m_Localized: What, my earrings? God forbid a lady likes to feel special sometimes! That a crime?
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341364
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341365
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341366
    m_Localized: 'Wifefema: What on god''s green earth?! I show you my pearly whites and you go stickin'' a gun in my face?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341367
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341368
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341369
    m_Localized: 'Wifefema: Oh, come on! What''s so wrong with my nails?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341370
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341371
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341372
    m_Localized: 'Wifefema: My eyes ain''t white enough for ya? Ha! You''re somethin'' else.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341373
    m_Localized: 'Wifefema: Not your type? Ha! You''re really somethin'' else.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341374
    m_Localized: 'Wifefema: Now put that toy away and let''s get back to doin'' our duty.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341375
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341376
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341377
    m_Localized: 'Wifefema: For god sake! If this is about my rash, go find my hubby and ask him!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341378
    m_Localized: 'Wifefema: Don''t go acting stupid...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341379
    m_Localized: 'Wifefema: Just you wait till my hubby gets hold of you! Just you wait!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341380
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341381
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341382
    m_Localized: 'Wifefema: This a kink, you freak! ...Or you just scared of what my hubby will do when he finds your creepy collection?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341383
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341384
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341385
    m_Localized: 'Wifefema: What, you got somethin'' against a lady feeling pretty?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341386
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341387
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341388
    m_Localized: 'Wifefema: A woman''s pride is her smile. The bleeding? Well, could happen to anyone!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341389
    m_Localized: 'Wifefema: A problem with my teeth, huh? You''ll stop actin'' like that if you wanna keep yours, mister!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341390
    m_Localized: 'Wifefema: My hands are made for work, not for show.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341391
    m_Localized: 'Wifefema: Maybe you should get a job yourself... Like mopping the floor with your face.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341392
    m_Localized: 'Wifefema: If only FEMA would take me in! I could spot a Visitor from a mile off! ...And folks like you? I''d eat you for breakfast.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341393
    m_Localized: 'Wifefema: Men love to say women oughta keep pretty. Well, I don''t give a rat''s ass. Hazmat suits ain''t made for the runway.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341394
    m_Localized: 'Wifefema: Boo hoo, I''m scared! The photo! Help! Oh no! ...Ha! Little baby gonna pull the trigger? Who made you the judge, mister!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341395
    m_Localized: 'Wifefema: It''s the little things that matter. Like this damn earring, it reminds me of who I am.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341396
    m_Localized: 'Wifefema: A woman. A human. And you...standin'' there all high an'' mighty, makin'' me out to be some kinda animal. What are you, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341397
    m_Localized: 'Wifefema: You''re a real piece of work, you know that? If only...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341398
    m_Localized: 'Wifefema: ...my hubby was here.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341399
    m_Localized: 'Raskolnikov: Oh, um, totally. You need to test me, I get it. I-I think it''s kinda cool that you''re being so thorough, actually.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341400
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341401
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341402
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341403
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341404
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341405
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341406
    m_Localized: 'Raskolnikov: Oh... Teeth? Yeah, sure sure.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341407
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341408
    m_Localized: 'Raskolnikov: Aw jeez... Don''t get the wrong idea, I''m not one of "them". I just...don''t care that much about how I look, y''know?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341409
    m_Localized: 'Raskolnikov: Aw jeez... Don''t get me wrong, I-I''m not some kind of narcissist, y''know. I just…care about my appearance.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341410
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341411
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341412
    m_Localized: 'Raskolnikov: Oh... I mean, yeah. Do what you gotta do, man. Go ahead, take a look.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341413
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341414
    m_Localized: 'Raskolnikov: Yeah... They''re kinda gnarly. I-I used to try and hide them, but... No point anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341415
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341416
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341417
    m_Localized: 'Raskolnikov: It''s just... I-I didn''t even have time to mess them up. I''m always on the run, hiding or whatever.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341418
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341419
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341420
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341421
    m_Localized: 'Raskolnikov: Just...don''t be scared.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341422
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341423
    m_Localized: 'Raskolnikov: I-I wasn''t crying, okay? I just don''t sleep well, y''know?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341424
    m_Localized: 'Raskolnikov: My eyes used to be all rapid, like a cornered rat trying find a way out. ...Now they''re just tired.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341425
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341426
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341427
    m_Localized: 'Raskolnikov: Aw jeez... A-Are you sure this is necessary?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341428
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341429
    m_Localized: 'Raskolnikov: See? Normal, right? I don''t even sweat that much... Guess I''m too scared to give them my scent, or something.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341430
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341431
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341432
    m_Localized: 'Raskolnikov: Why do you need my picture?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341433
    m_Localized: 'Raskolnikov: Can I, like, refuse?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341434
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341435
    m_Localized: 'Raskolnikov: H-Hey, no need to point that gun at me, man! Okay, okay, take my photo! Jeez...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341436
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341437
    m_Localized: 'Raskolnikov: J-Just make sure I look decent, okay? ...Or at least not too pathetic.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341438
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341439
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341440
    m_Localized: 'Raskolnikov: O-Oh, yeah, sure. But why ears? I hope you''re not expecting anything...awful.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341441
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341442
    m_Localized: 'Raskolnikov: I-I hear everything... Even when I shouldn''t.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341443
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341444
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341445
    m_Localized: 'Raskolnikov: Hooboy, okay... I-I didn''t know you rolled like that.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341446
    m_Localized: 'Raskolnikov: But, yeah, m-maybe you''re right... Sometimes it''s better to shoot than to smile.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341447
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341448
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341449
    m_Localized: 'Raskolnikov: Y-You think these hands are dangerous? ...I think they''re pathetic.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341450
    m_Localized: 'Raskolnikov: Just do it, man. Shoot me. Nothing left for them to hold on to, anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341451
    m_Localized: 'Raskolnikov: W-Wait! I didn''t—'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341452
    m_Localized: 'Raskolnikov: ...Sorry. These hands haven''t done anything to help... M-Maybe I deserve it...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341453
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341454
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341455
    m_Localized: 'Raskolnikov: ...I barely sleep anymore. You can tell, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341456
    m_Localized: 'Raskolnikov: M-Maybe... You could, um, help with that?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341457
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341458
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341459
    m_Localized: 'Raskolnikov: I may not be dangerous...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341460
    m_Localized: 'Raskolnikov: B-But not everyone is gonna stay this calm when a gun''s, like, in their face, y''know.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341461
    m_Localized: 'Raskolnikov: One day, you''re gonna run into someone...big and mean. And then...well, that''ll be the end, I guess.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341462
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341463
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341464
    m_Localized: 'Raskolnikov: Aw jeez... If... If you figured something out from the photo...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341465
    m_Localized: 'Raskolnikov: ...M-Maybe you should just pull the trigger.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341466
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341467
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341468
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341469
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341470
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341471
    m_Localized: 'Raskolnikov: When I was in school, I was terrified of dentists. Shaking, sweating, the whole deal.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341472
    m_Localized: 'Raskolnikov: Then one day, some douchebag kid knocked my tooth out... A-And you know what I did?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341473
    m_Localized: 'Raskolnikov: Nothing'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341474
    m_Localized: 'Raskolnikov: Absolutely nothing.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341475
    m_Localized: 'Raskolnikov: I... I couldn''t stand up for myself. Didn''t even try. I was too scared...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341476
    m_Localized: 'Raskolnikov: Figured, if I can''t be strong, I''d at least be flawless. ...Y''know?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341477
    m_Localized: 'Raskolnikov: Clean teeth became, like, my shield. Like my worth depended on them.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341478
    m_Localized: 'Raskolnikov: It''s dumb, I know. Maybe I shoulda learned something else... I dunno...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341479
    m_Localized: 'Raskolnikov: Every time I froze... Or missed my chance... I punched a wall. Hard. ''Til my knuckles bled.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341480
    m_Localized: 'Raskolnikov: Like, the pain would scrub out the weakness, or something... L-Like I''d earn my strength if I punished myself enough.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341481
    m_Localized: 'Raskolnikov: ...But all I got was dirt under my nails and a nasty infection.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341482
    m_Localized: 'Raskolnikov: And that''s fair, y''know? ''Cause I''m no better than them.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341483
    m_Localized: 'Raskolnikov: I... I used to clench my fists ''til my knuckles went white. Like if I could control my nerves, I could drive fear away.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341484
    m_Localized: 'Raskolnikov: Now I just hide ''em. Y''know... In case someone notices the shaking.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341485
    m_Localized: 'Raskolnikov: Wh-When I saw that man in the alley...he looked at me the way you''re looking now. Like, right into my soul.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341486
    m_Localized: 'Raskolnikov: And I thought...if my eyes were like that, m-maybe they wouldn''t have pushed me around at school.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341487
    m_Localized: 'Raskolnikov: Maybe I could''ve stood up for myself...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341488
    m_Localized: 'Raskolnikov: Aw jeez... S-Sorry, I...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341489
    m_Localized: 'Raskolnikov: ...That''s probably not what you wanted to hear.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341490
    m_Localized: 'Raskolnikov: I-I used to dream about being ordinary. Someone no one noticed. No strong odors, no bold moves.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341491
    m_Localized: 'Raskolnikov: But, I get it now... If you''re invisible, you''re the first to be eaten. That''s why I... I wanna become someone else.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341492
    m_Localized: 'Raskolnikov: Hooboy... Kinda weird, knowing your face is captured somewhere... Huh? Aura? So...you can see who I am...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341493
    m_Localized: 'Raskolnikov: Just tell me, d-do I still have a chance to be better? Am I already a Visitor? Or will I be a weakling forever...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341494
    m_Localized: 'Raskolnikov: One time I heard a guy say that we''re all "non-humans." Since then, I... I''ve been thinking. Maybe he, um, had a point?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341495
    m_Localized: 'Raskolnikov: Maybe I''m not human or Visitor. Just something...unfinished. G-Give me the chance to fix that, or...just end it all.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341496
    m_Localized: 'Raskolnikov: Looks like I''ll always be...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341497
    m_Localized: 'Raskolnikov: ...the victim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341498
    m_Localized: 'Nun: Seems God is not the only one who tests me so...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341499
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341500
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341501
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341502
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341503
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341504
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341505
    m_Localized: 'Nun: Hmph, if you must.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341506
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341507
    m_Localized: 'Nun: Be not afraid.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341508
    m_Localized: 'Nun: Sins are not something to be chewed nor savored, child. ...I swallow them whole.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341509
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341510
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341511
    m_Localized: 'Nun: Be quick about it.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341512
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341513
    m_Localized: 'Nun: Old age and roach poison. Brings forth a rash as persistent as the non-believers...yet only half as vexatious.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341514
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341515
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341516
    m_Localized: 'Nun: Well, go on then. Go on.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341517
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341518
    m_Localized: 'Nun: Something amiss? It''s all but a mark of these bitter years.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341519
    m_Localized: 'Nun: Something amiss? It''s all but a mark of weariness.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341520
    m_Localized: 'Nun: If you only knew the sins these eyes have witnessed, child!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341521
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341522
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341523
    m_Localized: 'Nun: Goodness! Have you lost your wits entirely?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341524
    m_Localized: 'Nun: The very thought! Forcing an old, ailing woman to lift her arms and bare herself before the likes of...you!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341525
    m_Localized: 'Nun: It shall not come to pass!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341526
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341527
    m_Localized: 'Nun: Such indecency!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341528
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341529
    m_Localized: 'Nun: ...I see you shall grant me no peace.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341530
    m_Localized: 'Nun: Well then... If it is His will, let it be done.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341531
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341532
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341533
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341534
    m_Localized: 'Nun: Photography? Pah! I have no time to waste on such nonsense!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341535
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341536
    m_Localized: 'Nun: You believe photographs show us the truth? Lord be with me... The pigeons at my monastery have more sense than you!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341537
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341538
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341539
    m_Localized: 'Nun: You want to check my ears?! How very dare you!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341540
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341541
    m_Localized: 'Nun: I''m no prize cow at some village market!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341542
    m_Localized: 'Nun: Seems you''ve lost all sense of decency.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341543
    m_Localized: 'Nun: Frightening a poor old woman like this. Have you no shame?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341544
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341545
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341546
    m_Localized: 'Nun: Do you truly think a gun will grant you my confession? Bullets shall not wash away your life of sin, child.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341547
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341548
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341549
    m_Localized: 'Nun: I do not see God in your eyes, child. Such a thing frightens me more than any weapon of man ever could.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341550
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341551
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341552
    m_Localized: 'Nun: The Lord sees all. Watches how you torment a poor old woman... You should be ashamed of yourself!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341553
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341554
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341555
    m_Localized: 'Nun: Poppycock! You truly believe that spilling my blood will redeem you? My, were you always so dim?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341557
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341558
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341559
    m_Localized: 'Nun: Child. I have witnessed horrors that would turn your soul to ash. You brandish but a trinket in the eyes of the Lord!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341560
    m_Localized: 'Nun: Lost sheep guided by the latest news... Only to turn on your fellow man with blades crueler than any calamity.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341561
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341562
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341563
    m_Localized: 'Nun: You try and live to my age without losing a single tooth!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341564
    m_Localized: 'Nun: With the rubbish you eat, you''ll be toothless long before me, child! ...If we''re still here, God willing.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341565
    m_Localized: 'Nun: They say a person''s life is reflected in their hands.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341566
    m_Localized: 'Nun: Mine? Nothing but suffering...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341567
    m_Localized: 'Nun: Eyes are our windows to the soul. But oh child... In yours, I see nothing but darkness.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341568
    m_Localized: 'Nun: You''ve lost the true light of faith. Just like those blasphemers who drove me from my holy refuge.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341569
    m_Localized: 'Nun: May your eternal darkness be your punishment, for neither faith nor grace dwell in your gaze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341570
    m_Localized: 'Nun: You run all of these "tests" of yours, but the real truth isn''t what''s on the outside. It''s what''s within.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341571
    m_Localized: 'Nun: Our Father who art in Heaven, guide Thy servant back to the light. He has wandered far, tempted by power...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341572
    m_Localized: 'Nun: All of these pictures of yours are utter poppycock! Poppycock, I say!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341573
    m_Localized: 'Nun: People die, their earthly belongings remain, never to be looked upon again after their funeral!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341574
    m_Localized: 'Nun: That is the legacy we all leave. You shall be forgotten. Yet here you stand, lips flapping like a fool.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341575
    m_Localized: 'Nun: The Lord, in His mercy, blessed me with keen hearing... Only for me to end up here with a fool who delights in...in...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341576
    m_Localized: 'Nun: ...Heaven knows what! Waving that darn gun around, as if it''s your will that must be done!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341577
    m_Localized: 'Nun: Forgive me Father... I pray to never again witness as cruel a thing as man.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341578
    m_Localized: 'Nun: O merciful Lord... Receive my...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341579
    m_Localized: 'Fugitive: Go right ahead. I ain''t got nothing to hide...except maybe my fucked-up luck. Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535552
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535553
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535554
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535555
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535556
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535557
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535558
    m_Localized: 'Fugitive: Sure, take a look.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535559
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535560
    m_Localized: 'Fugitive: Shitty smile, eh? Those pigs clean out people, not teeth, if you know what I mean...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535561
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535562
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535563
    m_Localized: 'Fugitive: Go ahead. They''ve taken a beating, that''s for sure.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535564
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535565
    m_Localized: 'Fugitive: Dirty, yeah? Fell in a goddamn puddle running from those pigs. Before that, cut ''em climbing over some barbed wire.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535566
    m_Localized: 'Fugitive: Fine, take a look.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535567
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535568
    m_Localized: 'Fugitive: Dirty, yeah? Fell in a goddamn puddle running from those pigs. But you''re not talking about dirt, are you?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535569
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535570
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535571
    m_Localized: 'Fugitive: Alright.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535572
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535573
    m_Localized: 'Fugitive: Yeah well, when you can get yourself shot just by catching the wrong fucker''s eye, you learn to watch where you look.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535574
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535575
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535576
    m_Localized: 'Fugitive: Well, shit... You''re not screwing with me, are ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535577
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535578
    m_Localized: 'Fugitive: Look, if I don''t take care of this, it''ll spread. Then where the hell am I gonna get help?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535579
    m_Localized: 'Fugitive: I''ve been tired, on the run, and fuckin'' shot. Shaving wasn''t exactly high on my fuckin'' to-do list, yeah?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535580
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535581
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535582
    m_Localized: 'Fugitive: Yeah? Didn''t think anyone still did that.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535583
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535584
    m_Localized: 'Fugitive: Never been big on having my picture taken.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535585
    m_Localized: 'Fugitive: So...how''d it turn out? Wait, shit... You''re not plannin'' on ratting me out to FEMA, are ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535586
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535587
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535588
    m_Localized: 'Fugitive: Seriously? Don''t ya think these "signs" are meant to spread more panic?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535589
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535590
    m_Localized: 'Fugitive: Dirty? Yeah they''re dirty. Like anyone''s would be, living and working without taking any showers.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535591
    m_Localized: 'Fugitive: Seriously? You think you can spot a Visitor by their ears? Alright, be my fuckin'' guest.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535592
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535593
    m_Localized: 'Fugitive: Dirty, yeah? Believe it or fucking not, those FEMA pens don''t have hot showers or Q-tips. Hell of a service, huh?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535594
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535595
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535596
    m_Localized: 'Fugitive: Don''t do anything stupid, yeah? I already caught one bullet, I ain''t looking for another.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535597
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535598
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535599
    m_Localized: 'Fugitive: If you''re gonna kill me over my hands, you might as well wipe out the whole damn city.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535600
    m_Localized: 'Fugitive: If you''re gonna kill me over some dirty hands, you might as well wipe out the whole damn city.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535601
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535602
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535603
    m_Localized: 'Fugitive: I''ve seen plenty of maniacs, psychos, and just plain freaks. And, y''know, you ain''t ranking much fuckin'' better!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535604
    m_Localized: 'Fugitive: At least you''re not experimenting on ''em... Thank you very fucking much, dickhead!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535605
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535606
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535607
    m_Localized: 'Fugitive: Look. I did every last stupid fucking thing you asked. What the hell do you want from me?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535608
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535609
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535610
    m_Localized: 'Fugitive: What? You want this picture to be the last thing left of me? Real nice of ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535611
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535612
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535613
    m_Localized: 'Fugitive: Give me a break, I''ll clean my fucking ears! No need to shove a gun in my face!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535614
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535615
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535616
    m_Localized: 'Fugitive: They didn''t have mirrors in those FEMA pens. No one needs to watch themselves turning into livestock.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535617
    m_Localized: 'Fugitive: Shit, you''re starting to remind me of those pigs in yellow. Soon as something''s off, they grab a gun and start shooting.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535618
    m_Localized: 'Fugitive: Look, I might let this slide, but others...nah. They could take offense, and then you''ll get a bullet for your troubles.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535619
    m_Localized: 'Fugitive: FEMA pigs never look anyone in the eyes. Not the ones they take, not even each others. You ever wonder why? Huh?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535620
    m_Localized: 'Fugitive: There was this poor fucker in the pens who kept scratching until...well, until he stopped. Think it''s some kinda fungus.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535621
    m_Localized: 'Fugitive: There was this poor fucker in the pens who kept scratching until...well, until he stopped. Probably just nerves.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535622
    m_Localized: 'Fugitive: FEMA pigs take pictures too. First thing, soon as you arrive. For "record-keeping" and all that crap.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535623
    m_Localized: 'Fugitive: ...If they show up here waving my picture, don''t rat me out. Yeah? I don''t wanna go back!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535624
    m_Localized: 'Fugitive: They say if you live in silence long enough, you start hearing things. We found that out back in the pens.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535625
    m_Localized: 'Fugitive: Damn... Ran from one bunch of pigs...just to get shot by another...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535626
    m_Localized: 'Fugitive: ...Fuck you.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535627
    m_Localized: 'Bestson: Uh... Okay... Just tell me everything''s going to be fine.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535628
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535629
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535630
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535631
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535632
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535633
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535634
    m_Localized: 'Bestson: Oh... Is it really that bad? Well...okay...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535635
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535636
    m_Localized: 'Bestson: My parents always said I had, uh...good genes.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535637
    m_Localized: 'Bestson: It''s just... My gums bleed sometimes. Either from the diabetes, or because I...kinda get stressed.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535638
    m_Localized: 'Bestson: I never really cared about them... Ever since I was little, Mom used to remind me to brush my teeth before bed.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535639
    m_Localized: 'Bestson: But now...I keep forgetting. Sometimes I just crawl into bed and close my eyes, hoping they''ll come back...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535640
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535641
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535642
    m_Localized: 'Bestson: Oh... Well, okay...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535643
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535644
    m_Localized: 'Bestson: Normal hands. Or, I guess they''re normal?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535645
    m_Localized: 'Bestson: I never really thought about what hands are supposed to look like.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535646
    m_Localized: 'Bestson: They''re just...there, you know?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535647
    m_Localized: 'Bestson: Oh, shoot... I totally forgot about my nails. Dad used to tell me to trim them, but I never got into the habit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535648
    m_Localized: 'Bestson: And my knuckles... Yeah, it''s nothing important...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535649
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535650
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535651
    m_Localized: 'Bestson: Huh? What about them?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535652
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535653
    m_Localized: 'Bestson: They''re green. That''s normal...right?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535654
    m_Localized: 'Bestson: I mean, they seem fine... Though, lately they sting a little, but that''s probably just...dust. Or allergies...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535655
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535656
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535657
    m_Localized: 'Bestson: Uh... Well, okay...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535658
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535659
    m_Localized: 'Bestson: I''ve never shaved them or anything.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535660
    m_Localized: 'Bestson: My parents never told me to, so... I just never really thought about it...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535661
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535662
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535663
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535664
    m_Localized: 'Bestson: You wanna take a picture? Well...okay. Just...tell me that everything''s fine afterwards, okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535665
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535666
    m_Localized: 'Bestson: That''s a weird-looking photo. Is that some kind of special camera or something?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535667
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535668
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535669
    m_Localized: 'Bestson: Huh? Well...okay...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535670
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535671
    m_Localized: 'Bestson: I don''t even know what you''re hoping to see there...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535672
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535673
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535674
    m_Localized: 'Bestson: Hey... Come on!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535675
    m_Localized: 'Bestson: Some people pull their hair out or bite their nails...and I guess I pick at my teeth. But...that''s not so bad, is it?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535676
    m_Localized: 'Bestson: Hey... I know my teeth aren''t in the best shape, but...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535677
    m_Localized: 'Bestson: That''s not a sign of something...is it?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535678
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535679
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535680
    m_Localized: 'Bestson: Hey, come on... They''re normal, aren''t they?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535681
    m_Localized: 'Bestson: No, wait... I''m human! I''m just...nervous.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535682
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535683
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535684
    m_Localized: 'Bestson: Wait! It''s just...nerves! That''s all!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535685
    m_Localized: 'Bestson: Wait! I''m just not sleeping well, that''s all!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535686
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535687
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535688
    m_Localized: 'Bestson: Come on... You''re not serious about this, are you?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535689
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535690
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535691
    m_Localized: 'Bestson: Please... Come on, mister...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535692
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535693
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535694
    m_Localized: 'Bestson: Wait... Was this really that important?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535695
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535696
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535697
    m_Localized: 'Bestson: Mom even joked that I sucked out all her calcium. Y''know while she was breastfeeding me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535698
    m_Localized: 'Bestson: So her teeth got worse because of me, and mine... Well, they turned out pretty! Except for my gums...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535699
    m_Localized: 'Bestson: Maybe if my parents were here, things would''ve been different?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535700
    m_Localized: 'Bestson: They''d remind me, make me take care of myself... I wouldn''t have let myself go like this...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535701
    m_Localized: 'Bestson: ...But they''re gone.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535702
    m_Localized: 'Bestson: And I''m left...as I am.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535703
    m_Localized: 'Bestson: Sometimes I look at my hands and think... Mom said I had her fingers. Long, neat.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535704
    m_Localized: 'Bestson: And Dad laughed, said I got his fists. Strong, like his were when he was young.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535705
    m_Localized: 'Bestson: But I look at them now...and I don''t understand. I can''t remember what their hands really looked like.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535706
    m_Localized: 'Bestson: My knuckles hurt when I touch them. See, I know it''s wrong, but...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535707
    m_Localized: 'Bestson: When I''m alone...waiting for them to come back...and no one comes... I just don''t know what to do.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535708
    m_Localized: 'Bestson: So, sometimes I clench my fists, and punch a wall. Anything''s better than sitting still.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535709
    m_Localized: 'Bestson: You can''t judge me for that, can you?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535710
    m_Localized: 'Bestson: When Mom talked to me, she''d look first into one eye, then into the other. Very quickly! Back and forth!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535711
    m_Localized: 'Bestson: And Dad... He''d pick one, just one. Looked straight, never looking away. I wonder... Which one would he pick now?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535712
    m_Localized: 'Bestson: No... You''re right. I''ve cried a lot.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535713
    m_Localized: 'Bestson: How do you not, when you''re alone? When no one answers your calls? When your parents just...disappear?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535714
    m_Localized: 'Bestson: I don''t want to cry, really...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535715
    m_Localized: 'Bestson: I just...don''t know how to be alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535716
    m_Localized: 'Bestson: I always believed that if I did everything the way I was taught, things would be okay.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535717
    m_Localized: 'Bestson: If they say wash your face, then wash it. If they say you can''t interrupt, then don''t. Nothing wrong with that, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535718
    m_Localized: 'Bestson: But here... Now... No one tells me what to do.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535719
    m_Localized: 'Bestson: So, if no one tells me... Do I have to decide? What if I make the wrong decision...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535720
    m_Localized: 'Bestson: I know it seems strange to some, but... I''ve never really cared about how I look.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535721
    m_Localized: 'Bestson: My parents said I was a handsome boy, and that was enough.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535722
    m_Localized: 'Bestson: Without them... I just...don''t care.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535723
    m_Localized: 'Bestson: I don''t like this photo. I don''t know what''s wrong, but looking at it...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535724
    m_Localized: 'Bestson: It feels like something is pressing down on me. Is that normal?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535725
    m_Localized: 'Bestson: Does an aura really mean something?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535726
    m_Localized: 'Bestson: I don''t know, honestly... I''ve never seen something like that before.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535727
    m_Localized: 'Bestson: But if my aura is different from my parents''... Maybe I''m not the same as I was?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535728
    m_Localized: 'Bestson: Maybe I''ve changed, and they wouldn''t even recognize me...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535729
    m_Localized: 'Bestson: I waited a long time for them to knock on the door.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535730
    m_Localized: 'Bestson: To hear their voices, their familiar steps...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535731
    m_Localized: 'Bestson: ...But nothing.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535732
    m_Localized: 'Bestson: Time keeps passing, and I feel like...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535733
    m_Localized: 'Bestson: I feel like I don''t even exist.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535734
    m_Localized: 'Bestson: I think I''ve ruined everything. Again.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535735
    m_Localized: 'Bestson: I''m sorry, Mom...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535736
    m_Localized: 'Buddy: Me? Sure thing, buddy. Got nothin'' to hide, and no reason to, neither.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535737
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535738
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535739
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535740
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535741
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535742
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535743
    m_Localized: 'Buddy: Yep, take a look...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535744
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535745
    m_Localized: 'Buddy: See? Half of ''em are picture-perfect, all clean and white. The rest...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535746
    m_Localized: 'Buddy: Well, let''s just say some of that half didn''t keep up so nice.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535747
    m_Localized: 'Buddy: That''s life, buddy... It ain''t always kind.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535748
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535749
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535750
    m_Localized: 'Buddy: Here, take a look...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535751
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535752
    m_Localized: 'Buddy: Big ''uns, eh? Hands made for kneadin'' dough or buildin'' a house...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535753
    m_Localized: 'Buddy: And here I am, just poppin'' bottles and smashin'' stuff. That''s life for ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535754
    m_Localized: 'Buddy: And here I am, just poppin'' bottles. That''s life for ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535755
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535756
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535757
    m_Localized: 'Buddy: Sure, take a look.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535758
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535759
    m_Localized: 'Buddy: Plain, brown. Just like half the world''s population. No mystery there, bud.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535760
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535761
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535762
    m_Localized: 'Buddy: Uh, buddy... You sure about this? I mean, go ahead.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535763
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535764
    m_Localized: 'Buddy: Nothin'' to see here. Thick, hairy, and got some kinda fungus goin'' on. Probably picked it up sleepin'' down with the dog.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535765
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535766
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535767
    m_Localized: 'Buddy: Ah. Alright, snap a pic if you gotta.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535768
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535769
    m_Localized: 'Buddy: Haven''t had a lotta photos taken, truth be told. Just never really got around to it.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535770
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535771
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535772
    m_Localized: 'Buddy: Here they are... Just plain ol'' ears, nothin'' fancy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535773
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535774
    m_Localized: 'Buddy: Pretty normal, eh? Go ahead, give ''em a feel if you want.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535775
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535776
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535777
    m_Localized: 'Buddy: This is ''cause of my teeth...? Don''t take this the wrong way, bud, but that''s a pretty coocoo reason to kill someone.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535778
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535779
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535780
    m_Localized: 'Buddy: Y''know, bud... I wanna believe there''s somethin'' after death. That, somewhere out there, I''ll see my best girl again.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535781
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535782
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535783
    m_Localized: 'Buddy: Whoa, buddy... It''s tough when someone you love gets taken away, you know? Can''t help it if I shed a tear or two.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535784
    m_Localized: 'Buddy: So what? You wanna shoot me for it? For a man havin'' a heart?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535785
    m_Localized: 'Buddy: Just...don''t aim for the eyes, eh? Can you do that, bud?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535786
    m_Localized: 'Buddy: Wouldn''t mind seeing somethin'' beautiful in my last moments.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535787
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535788
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535789
    m_Localized: 'Buddy: I''d go see a doctor about this fungus, sure... But, what''s the point? Especially now...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535790
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535791
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535792
    m_Localized: 'Buddy: Come on, at least lemme see what you got. Can''t be that bad, can it?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535793
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535794
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535795
    m_Localized: 'Buddy: You kiddin'' me, bud?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535796
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535797
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535798
    m_Localized: 'Buddy: One time, a dentist once told me that with teeth like these, I could be in a commercial.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535799
    m_Localized: 'Buddy: And then...hah! ...Then they got knocked out that same night. Just ''cause I was smiling. Funny, huh?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535800
    m_Localized: 'Buddy: I didn''t even get into a fight. I just...laughed at the wrong time.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535801
    m_Localized: 'Buddy: These hands... I used to hold my dog with ''em, back when she was still alive. Pet her soft fur... Man, was she soft.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535802
    m_Localized: 'Buddy: I miss her so damn much, bud. You don''t even know.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535803
    m_Localized: 'Buddy: My grandma once told me: "When you look at me like that, it''s like you''re already saying goodbye."'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535804
    m_Localized: 'Buddy: I didn''t get it back then.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535805
    m_Localized: 'Buddy: Now... Now I see she was right. Only I can''t tell her that anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535806
    m_Localized: 'Buddy: That last night... I stayed by her side.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535807
    m_Localized: 'Buddy: Figured maybe I could keep her warm, make it a little easier for her... I guess she left me a little souvenir.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535808
    m_Localized: 'Buddy: Isn''t that funny? She''s gone...but I''m still carrying her with me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535809
    m_Localized: 'Buddy: I used to take so many pics of my dog. Couldn''t get enough of her. Wanted to show her off, share her with others.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535810
    m_Localized: 'Buddy: But pics of me? Nah. Especially those yearbooks, where folks dress up all fancy outta nowhere... Not my thing.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535811
    m_Localized: 'Buddy: One time, some fireworks went off nearby. My little puppy was tremblin'' somethin'' fierce... Tryin'' to get close to me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535812
    m_Localized: 'Buddy: I held her, tried to calm her down. ...Poor thing.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535813
    m_Localized: 'Buddy: And I thought... "Man, I wish someone would do that for me. If I got scared, I''d want to know I wasn''t alone."'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535814
    m_Localized: 'Buddy: So... That''s how it is...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535815
    m_Localized: 'Buddy: Eh, bud...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535816
    m_Localized: 'Fatman: You serious? Me? A minister? Pfft... Go on then, take a good look...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535817
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535818
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535819
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535820
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535821
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535822
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535823
    m_Localized: 'Fatman: What''s next, you want me to bend over for you? What a joke, wasting a minister''s time with this crap.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535824
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535825
    m_Localized: 'Fatman: You just won''t let it go, will you?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535826
    m_Localized: 'Fatman: Tch. Alright, here. Look.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535827
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535828
    m_Localized: 'Fatman: So? Enjoying the view? Pfft... Lemme tell you something. Smoking doesn''t just calm your nerves, it tests your character.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535829
    m_Localized: 'Fatman: Some fold after the first drag. Me? I''ve been pulling on it my whole damn life, yes I have.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535830
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535831
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535832
    m_Localized: 'Fatman: Take a good look...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535833
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535834
    m_Localized: 'Fatman: Behold. Relics of a better time. These hands once held a glass, a cigar, and, ahem, an entire nation. And now?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535835
    m_Localized: 'Fatman: Now they struggle just to hold themselves together. And even that''s a gamble, I tell you!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535836
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535837
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535838
    m_Localized: 'Fatman: Yeah, yeah, hold on...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535839
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535840
    m_Localized: 'Fatman: Well? What do you see? Thought I was a drunk? Hell no.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535841
    m_Localized: 'Fatman: Well? What do you see? Thought I was a drunk? Hell no. It''s just that a life without dri—'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535842
    m_Localized: 'Fatman: ...Ah, screw it. Satisfied are you, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535843
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535844
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535845
    m_Localized: 'Fatman: Hmph. Some funny old tests you''ve got here.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535846
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535847
    m_Localized: 'Fatman: Don''t piss yourself, I''ll survive.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535848
    m_Localized: 'Fatman: Ha. You know, someone once told me that armpit hair''s a sign of, ahem, strength.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535849
    m_Localized: 'Fatman: I must''ve had enough strength for three men. And where the hell was it when I needed it? Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535850
    m_Localized: 'Fatman: Oh how things fucking change...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535851
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535852
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535853
    m_Localized: 'Fatman: Go on. Just lemme get up... Like the good old days...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535854
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535855
    m_Localized: 'Fatman: Well then! How do I look? Still the same old me? Haha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535856
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535857
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535858
    m_Localized: 'Fatman: Nothing to see there...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535859
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535860
    m_Localized: 'Fatman: Here they are, the minister''s ears. They''ve heard it all. The whispers...the, ahem, screams...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535861
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535862
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535863
    m_Localized: 'Fatman: Well, well, well. Shoot already. Let''s see how you live with yourself.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535864
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535865
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535866
    m_Localized: 'Fatman: All this damn stress... Ended up shredding my smokes. Got sick of scraping dirt out from under my nails after that.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535867
    m_Localized: 'Fatman: What, is that a crime in your house now? Hm? Well?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535868
    m_Localized: 'Fatman: Judging by these hands, I''ve been long-dead already. So go on...deal the final blow.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535869
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535870
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535871
    m_Localized: 'Fatman: Well, go on then. Pfft...! I don''t give a flying fuck how this nightmare ends anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535872
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535873
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535874
    m_Localized: 'Fatman: Pfft... Big deal, armpits! Everyone''s screwed up with something these days, I tell you!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535875
    m_Localized: 'Fatman: Go on, pull the trigger. Won''t make a damn bit of difference.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535876
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535877
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535878
    m_Localized: 'Fatman: If this photo is what incriminates me, fine. I used to decide people''s fates, too. Better to make it quick.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535879
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535880
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535881
    m_Localized: 'Fatman: You''re joking, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535882
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535883
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535884
    m_Localized: 'Fatman: Dentist told me once, "Quit smoking, or your teeth''ll fall out." So I shot back, "Do you even know who I am?!"'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535885
    m_Localized: 'Fatman: Now I look in the mirror and think…maybe all that stress wasn''t worth it. Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535886
    m_Localized: 'Fatman: Once upon a time I could change someone''s fate with a single signature! ...Wish someone had done the same for me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535887
    m_Localized: 'Fatman: What is this, some kind of sick joke? Stare you down, then point a gun. What a supremely stupid idea! Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535888
    m_Localized: 'Fatman: My eyes used to be clear...bright. Now...they''re murky. Life threw dust on them, and never bothered to wipe it away.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535889
    m_Localized: 'Fatman: You have no idea how much I had to sweat! And there was never any time to see a doctor. Never, I tell you!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535890
    m_Localized: 'Fatman: You don''t understand that shit I''ve had to deal with.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535891
    m_Localized: 'Fatman: Back in my youth, I knew a guy with the same...ahem, "gift" under his arms. He compared it to Samson''s hair.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535892
    m_Localized: 'Fatman: Then, a mob had him cornered. And did his hair save him? No. No it did not.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535893
    m_Localized: 'Fatman: You know... A couple of times, people''ve tried to, ahem, "erase" me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535894
    m_Localized: 'Fatman: Burned photos, shredded documents, even tried to kill me once. And what good did it do? Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535895
    m_Localized: 'Fatman: You still make a mark... People remember the ones who decide their fate, yes they do.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535896
    m_Localized: 'Fatman: Sometimes...all you want is silence. But it never comes. Even when nobody''s talking...there''s still noise in your head.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535897
    m_Localized: 'Fatman: Hell isn''t any worse...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535898
    m_Localized: 'Fatman: Than this...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535900
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535901
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535902
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535903
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535904
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535905
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535906
    m_Localized: 'Blind: By the way...they are the last witnesses.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535908
    m_Localized: 'Blind: I chewed on the truth, choking on it, until it clogged my throat.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535909
    m_Localized: 'Blind: I clenched my fists. My knuckles white as my gaze brushed over IT.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535910
    m_Localized: 'Blind: Now my hands grasp at emptiness, waiting for the sweet embrace of death to wipe it all from my mind.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535911
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535912
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535913
    m_Localized: 'Blind: Are they moving?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535914
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535915
    m_Localized: 'Blind: Good... IT hasn''t drained everything from me yet.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535916
    m_Localized: 'Blind: But I... I...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535917
    m_Localized: 'Blind: I devoured, screamed, vomited, tore myself apart.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535918
    m_Localized: 'Blind: Skull split wide. Brains oozing through walls.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535919
    m_Localized: 'Blind: Walls, doors, windows...and IT was there.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535920
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535921
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535922
    m_Localized: 'Blind: Hahahaha... Nothing unusual here!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535923
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535924
    m_Localized: 'Blind: IT loves to be watched. I cannot describe IT, for its horror is beyond what any mortal mind can endure.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535925
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535926
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535927
    m_Localized: 'Blind: Funny.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535928
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535929
    m_Localized: 'Blind: Do you know what the sickly shadow covers first?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535930
    m_Localized: 'Blind: No?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535931
    m_Localized: 'Blind: I do now.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535932
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535933
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535934
    m_Localized: 'Blind: Go ahead, use the flash. I don''t care.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535935
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535936
    m_Localized: 'Blind: And you won''t even show me how it turns out.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535937
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535938
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535939
    m_Localized: 'Blind: Did you hear that?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535941
    m_Localized: 'Blind: Quiet...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535942
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535943
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535944
    m_Localized: 'Blind: Weapons won''t save you...not from IT. I''m not even sure anything exists that could.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535945
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535946
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535947
    m_Localized: 'Blind: In my dreams, I can almost touch IT... Feel its form, its weight... And then...it''s gone. Leaving only dread behind.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535948
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535949
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535950
    m_Localized: 'Blind: Your eyes are drawn to IT. You cannot look away...not until you''ve gouged them out completely.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535951
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535952
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535953
    m_Localized: 'Blind: A tingling runs through every inch of me. My skin demands to be flayed...it''s unbearable.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535954
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535955
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535956
    m_Localized: 'Blind: I used to love photographs. Loved to study every little detail...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535957
    m_Localized: 'Blind: And now...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535958
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535959
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535960
    m_Localized: 'Blind: If you only heard the way IT shifts...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535961
    m_Localized: 'Blind: How IT''s footsteps tangle with yours...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535962
    m_Localized: 'Blind: How the air quivers as IT tastes your scent...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535963
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535964
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535965
    m_Localized: 'Blind: Have you ever heard something chewing...but not eating?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535966
    m_Localized: 'Blind: Savoring your scent, your voice, your trembling?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535967
    m_Localized: 'Blind: IT does that.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535968
    m_Localized: 'Blind: Waiting...for me to start chewing too.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535969
    m_Localized: 'Blind: Then...pain. I awake drenched. My hands clasp at my mouth. As if to stifle my screams.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535970
    m_Localized: 'Blind: IT does not fear the gaze. IT craves it.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535971
    m_Localized: 'Blind: IT spreads over the pupils.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535972
    m_Localized: 'Blind: IT quivers beneath the eyelids.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535973
    m_Localized: 'Blind: IT...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535974
    m_Localized: 'Blind: Forgive me... I suddenly don''t feel very well...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535975
    m_Localized: 'Blind: When IT crawls...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535976
    m_Localized: 'Blind: When IT slides over the body, sinks into the bones...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535977
    m_Localized: 'Blind: The moment IT touches you, you feel IT beneath your skin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535978
    m_Localized: 'Blind: Then...your skin is no longer yours.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535979
    m_Localized: 'Blind: And you...no longer belong to yourself...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535980
    m_Localized: 'Blind: True agony...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535981
    m_Localized: 'Blind: If... If that thing ever reaches you...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535982
    m_Localized: 'Blind: Do not, under any circumstances, try to capture IT''s image.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535983
    m_Localized: 'Blind: That will only feed IT... Amplify IT''s power over us mortals!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535984
    m_Localized: 'Blind: I heard IT.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535985
    m_Localized: 'Blind: Not when I saw IT.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535986
    m_Localized: 'Blind: Earlier.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535987
    m_Localized: 'Blind: Before IT came.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535988
    m_Localized: 'Blind: A low rustle...as if someone were following you from ten paces away...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535989
    m_Localized: 'Blind: Then five...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535990
    m_Localized: 'Blind: Then you turn...and...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535991
    m_Localized: 'Blind: Forgive me. I''d best keep this to myself. You don''t need this on your mind. Trust me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535992
    m_Localized: 'Blind: ITCOMESITCOMESITCOMESITCOMESITCOMESITCOMESITCOMES!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535993
    m_Localized: 'Blind: IT...comes...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535994
    m_Localized: 'Dude: Like, no worries at all. I gotchu, homie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535995
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535996
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535997
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535998
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535999
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536000
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536001
    m_Localized: 'Dude: Hahaha, check it!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536002
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536003
    m_Localized: 'Dude: Teeth like totally look like I grew up chewing corn, not cereal, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536004
    m_Localized: 'Dude: But bro, these chompers''re tough as nails.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536005
    m_Localized: 'Dude: Popped a bottle with ''em once, man. Wild... Totally almost bit off my tongue, but the beers kept flowing, bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536006
    m_Localized: 'Dude: C''mon man... Just like to blaze it, y''know.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536007
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536008
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536009
    m_Localized: 'Dude: Dude, I was, like, diggin'' up a geocache recently. Dirt? Don''t sweat it.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536010
    m_Localized: 'Dude: Whoa-whoa!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536011
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536012
    m_Localized: 'Dude: Like, one time I was super baked, staring at my fingers... And dude, I realized those are MY fingers.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536013
    m_Localized: 'Dude: Just wiggled ''em, watched ''em move... Trippy stuff, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536014
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536015
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536016
    m_Localized: 'Dude: Can''t keep my lids open too long. Looking at stuff stresses me out, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536017
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536018
    m_Localized: 'Dude: My pupils? Don''t sweat it. Man, you wouldn''t believe how often they busted my ass for that at the store. Bummer, dude.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536019
    m_Localized: 'Dude: Red? Don''t sweat it. Man, you wouldn''t believe how often they busted my ass for that. Real bummer, dude.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536020
    m_Localized: 'Dude: Yo, I gotta tell you a story about that sometime, you''ll lose your freakin'' mind.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536021
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536022
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536023
    m_Localized: 'Dude: Hold up, bro...gotta watch the strip show first.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536024
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536025
    m_Localized: 'Dude: They itch like crazy, dude. I heard it''s ''cause I don''t wash my clothes... But, I''m just living au natural, baby!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536026
    m_Localized: 'Dude: Smooth as a baby''s butt...well, almost.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536027
    m_Localized: 'Dude: Bro, like think about it... What''s all this grody pit hair for anyway?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536028
    m_Localized: 'Dude: Stone age was like over a year ago, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536029
    m_Localized: 'Dude: Bugs aren''t feastin'' on us and we totally don''t need it for warmth. So, yeah, I don''t vibe with it.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536030
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536031
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536032
    m_Localized: 'Dude: Sure, dude!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536033
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536034
    m_Localized: 'Dude: So, how''s my aura looking? Bright? ...Rad!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536035
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536036
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536037
    m_Localized: 'Dude: Uh-huh.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536038
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536039
    m_Localized: 'Dude: Why they so long? Maaaan... I had rad plugs back in the day...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536040
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536041
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536042
    m_Localized: 'Dude: Wooooah! Chillax, dude! Let roll a fat one and chat it out!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536043
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536044
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536045
    m_Localized: 'Dude: Daaaaamn, you''re hardcore. Wait, do you, like, feel like the gun is a part of you now? That''s wild, bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536046
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536047
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536048
    m_Localized: 'Dude: C''mon, man, it ain''t that bad. It''s a killer story!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536049
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536050
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536051
    m_Localized: 'Dude: Relax, homie! Maybe that''s just how gotta be! Nature takin'' back the body!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536052
    m_Localized: 'Dude: Relax! It''s cool if you don''t shave. Live your life! We can talk it out, homie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536053
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536054
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536055
    m_Localized: 'Dude: Dude, I''m hella trippin'' right now. And, like, gotta say, you''re harshing my mellow, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536056
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536057
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536058
    m_Localized: 'Dude: Wanna hear what went down?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536059
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536060
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536061
    m_Localized: 'Dude: Man, I used to think teeth were whatever. Like sure, yeah, I got me some of those.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536062
    m_Localized: 'Dude: Then my homie tells me, dude, they''re actually BONES!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536063
    m_Localized: 'Dude: Like whaaat! You got BONES stickin'' outta your mouth. Freaky as hell, right? I ain''t touching that shit!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536064
    m_Localized: 'Dude: Man, fingers are wild...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536065
    m_Localized: 'Dude: Like, we use ''em all the time...but you ever think about what they ARE, man? I got baked once and man...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536066
    m_Localized: 'Dude: Since then...they totally freak me out, dude!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536067
    m_Localized: 'Dude: I''m sat there, just lookin'' at my hands and start thinking...what if THEY AREN''T MINE? Bad trip, bro. Baaaad trip.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536068
    m_Localized: 'Dude: Big pupils are hella cute, bro. Kinda like that movie... Y''know with the boots cat and green swamp guy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536069
    m_Localized: 'Dude: Bet the chicks dig it too, hah!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536070
    m_Localized: 'Dude: So, picture it... I''m walkin'' down the street, high as balls.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536071
    m_Localized: 'Dude: I''m thinkin'', "If the cops stop me, they''ll ask if I''m stoned." So I figure I''ll just say, "Nah, I''m always like this."'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536072
    m_Localized: 'Dude: And guess what? They DO stop me: "Why are your eyes red? Are you always like this?" And I say, "Nah, I''m just stoned."'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536073
    m_Localized: 'Dude: Dude, you try walkin'' around like that. You''ll start itchin'' too.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536074
    m_Localized: 'Dude: Like, for real, is anybody ever like "man, I dig havin'' a hairy ass."'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536075
    m_Localized: 'Dude: Armpits, butt crack... It all just gets in the way.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536076
    m_Localized: 'Dude: Never got why we even need it, man... Like we''re all wearin'' clothes anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536077
    m_Localized: 'Dude: Dude... Sometimes I can FEEL my aura.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536078
    m_Localized: 'Dude: Like there''s somethin'' around me you can''t see.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536079
    m_Localized: 'Dude: When I''m suuuper baked...  uh, I mean tired, it can get hella freaky.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536080
    m_Localized: 'Dude: But most of the time it''s chill. I can vibe with it.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536081
    m_Localized: 'Dude: Man, I had this sick plug once. It looked like a big-ass eye with a craaaazy iris.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536082
    m_Localized: 'Dude: When I lost it, it felt like a piece of me was gone.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536083
    m_Localized: 'Dude: Everyone can see the hole in my ear, but I just see the void...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536084
    m_Localized: 'Dude: Aww maaan... I thought we were vibin''...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536085
    m_Localized: 'Dude: Dude...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536086
    m_Localized: 'Teacher: Do what you must, I have nothing to hide. ...I''ve already lost everything.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536087
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536088
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536089
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536090
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536091
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536092
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536093
    m_Localized: 'Teacher: See?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536094
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536095
    m_Localized: 'Teacher: White...almost perfect. Except...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536096
    m_Localized: 'Teacher: Where they beat me... They tied me to a post, wanted me to watch...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536097
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536098
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536099
    m_Localized: 'Teacher: Here...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536100
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536101
    m_Localized: 'Teacher: I tried... I tried to open the doors, to break the windows. But the fire...it spread so fast...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536102
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536103
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536104
    m_Localized: 'Teacher: Look...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536105
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536106
    m_Localized: 'Teacher: I... I saw it happen. The little ones clinging to each other as the flames crept closer...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536107
    m_Localized: 'Teacher: Searching for me, hoping I would save them... It was unbearable.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536108
    m_Localized: 'Teacher: Even now I''m afraid to close my eyes. I know I''ll see their faces again...helpless, burned, twisted with pain...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536109
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536110
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536111
    m_Localized: 'Teacher: Are... Are you sure this is really necessary? These confounded signs...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536112
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536113
    m_Localized: 'Teacher: It''s a force of habit, I guess. When you care for children, you get used to being careful about hygiene.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536114
    m_Localized: 'Teacher: Teaching them to wash their face, brush their teeth... Now there''s no one left to teach...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536115
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536116
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536117
    m_Localized: 'Teacher: Fine, if you must...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536118
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536119
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536120
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536121
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536122
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536123
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536124
    m_Localized: 'Teacher: I used to wear earrings... Small ones, with tiny jewels. The children said they twinkled like stars.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536125
    m_Localized: 'Teacher: But they always made my ears hurt, so I stopped wearing them.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536126
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536127
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536128
    m_Localized: 'Teacher: Want to finish off what''s left? With the way things are now, I wouldn''t be surprised.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536129
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536130
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536131
    m_Localized: 'Teacher: Go on... These hands can''t help anyone anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536132
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536133
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536134
    m_Localized: 'Teacher: If you could see the things I saw...you''d pull the trigger without thinking. If you had even a drop of mercy left.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536135
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536136
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536137
    m_Localized: 'Teacher: Shoot...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536138
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536139
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536140
    m_Localized: 'Teacher: Just do it...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536141
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536142
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536143
    m_Localized: 'Teacher: You think a bullet will end the pain? God, I hope so...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536144
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536145
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536146
    m_Localized: 'Teacher: When I taught the kids to brush their teeth, I told them a bright smile is all it takes to make the world beautiful.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536147
    m_Localized: 'Teacher: They laughed, showed me their little toothy grins.... And now...it all feels so...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536148
    m_Localized: 'Teacher: Forgive me...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536149
    m_Localized: 'Teacher: These hands once braided pigtails, patched up scraped knees, guided tiny fingers to knot shoelaces...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536150
    m_Localized: 'Teacher: And now...it all feels so pointless.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536151
    m_Localized: 'Teacher: Why even try when someone stronger—someone crueler—always decides what happens to us...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536152
    m_Localized: 'Teacher: What if I''d broken down the door...found another way in? Lately, when I close my eyes all I see are the flames.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536153
    m_Localized: 'Teacher: I told the kids to stay clean so they wouldn''t get sick. But germs weren''t the real danger...it was other people.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536154
    m_Localized: 'Teacher: I tried to hold on to the images of their faces, the sounds of their voices, their laughter...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536155
    m_Localized: 'Teacher: But the more time passes, the weaker those memories become.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536156
    m_Localized: 'Teacher: More and more, those happy moments are consumed by twisted faces and cries of pain, fear, and confusion...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536157
    m_Localized: 'Teacher: Sometimes I touch my ears and remember how one little girl adored my earrings...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536158
    m_Localized: 'Teacher: She even said she wanted the same ones when she grew up. But now...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536159
    m_Localized: 'Teacher: She''ll never...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536160
    m_Localized: 'Teacher: At last... It will be over...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536161
    m_Localized: 'Teacher: Please...forgive me...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536162
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729856
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729857
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729858
    m_Localized: 'Wheelchair: Well, yeah. What? Yeah?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729859
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729860
    m_Localized: 'Wheelchair: If... If you can''t rely on this sign, then how am I supposed to?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729861
    m_Localized: 'Wheelchair: Who knows? Maybe they all point to Visitors, or maybe none of ‘em do!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729862
    m_Localized: 'Wheelchair: People are prone to mistakes, y''know.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729863
    m_Localized: 'Wheelchair: But mistakes can have pretty terrible consequences.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729864
    m_Localized: 'Ballerina: You test me? Ha, yes. Be sure of...something.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729865
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729866
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729867
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729868
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729869
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729870
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729871
    m_Localized: 'Ballerina: Teeth?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729872
    m_Localized: 'Ballerina: You chew up what conscience leaves behind?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729873
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729874
    m_Localized: 'Ballerina: Eat it all up. Bite a tasty hole in tasty conscience.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729875
    m_Localized: 'Ballerina: ...What is conscience?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729876
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729877
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729878
    m_Localized: 'Ballerina: So what?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729879
    m_Localized: 'Ballerina: I dance. Why interrupt to look at dancey hands?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729880
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729881
    m_Localized: 'Ballerina: Kitty...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729882
    m_Localized: 'Ballerina: He insist kitty is alive. ...Lucky kitty.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729883
    m_Localized: 'Ballerina: It makes large pain in hand...and ass.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729884
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729885
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729886
    m_Localized: 'Ballerina: Aaaaah, now to most interesting part.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729887
    m_Localized: 'Ballerina: I have things written in pupils. See...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729888
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729889
    m_Localized: 'Ballerina: Tragedy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729890
    m_Localized: 'Ballerina: You live alone, yes?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729891
    m_Localized: 'Ballerina: So? How it feel?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729892
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729893
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729894
    m_Localized: 'Ballerina: HAHAHAHA! Stare. Sniff. What else?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729895
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729896
    m_Localized: 'Ballerina: Enjoy it?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729897
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729898
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729899
    m_Localized: 'Ballerina: What is? I do not know.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729900
    m_Localized: 'Ballerina: Time to try.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729901
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729902
    m_Localized: 'Ballerina: MMMMMMM...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729903
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729904
    m_Localized: 'Ballerina: Nobody tell me this.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729905
    m_Localized: 'Ballerina: Caused by wonderful dance?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729906
    m_Localized: 'Ballerina: Would scare me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729907
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729908
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729909
    m_Localized: 'Ballerina: Ahhh, good sign.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729910
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729911
    m_Localized: 'Ballerina: So? You tell me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729912
    m_Localized: 'Ballerina: Who''s good, who''s bad?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729913
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729914
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729915
    m_Localized: 'Ballerina: HAHAHA! Shoot the gun!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729916
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729917
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729918
    m_Localized: 'Ballerina: You want the red blood?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729919
    m_Localized: 'Ballerina: Me too.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729920
    m_Localized: 'Ballerina: None for poor me. ...Yet.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729921
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729922
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729923
    m_Localized: 'Ballerina: Don''t like the red blood?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729924
    m_Localized: 'Ballerina: You spill much, every hour every day. Yet, love it you do not?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729925
    m_Localized: 'Ballerina: Yes or no?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729926
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729927
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729928
    m_Localized: 'Ballerina: What? You already miss chance. No second sniff.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729929
    m_Localized: 'Ballerina: Not my fault.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729930
    m_Localized: 'Ballerina: Only large idiot do that.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729931
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729932
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729933
    m_Localized: 'Ballerina: Time to dance?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729934
    m_Localized: 'Ballerina: Have it your way.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729935
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729936
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729937
    m_Localized: 'Ballerina: How do you decide?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729938
    m_Localized: 'Ballerina: With ears?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729939
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729940
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729941
    m_Localized: 'Ballerina: You change mind? Want another sign?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729942
    m_Localized: 'Ballerina: You wish for more?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729943
    m_Localized: 'Ballerina: Up, down, up, down... Why you do this?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729944
    m_Localized: 'Ballerina: Can''t decide?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729945
    m_Localized: 'Ballerina: Looks stupid from here, HAHAHAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729946
    m_Localized: 'Ballerina: We thirst for the red blood.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729947
    m_Localized: 'Ballerina: Sure YOU aren''t Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729948
    m_Localized: 'Ballerina: You want clear path to death. Like us.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729949
    m_Localized: 'Ballerina: ....You are HUGE stupid!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729950
    m_Localized: 'Ballerina: Dancey make you cranky? Cranky dancey.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729951
    m_Localized: 'Ballerina: ...Perhaps you hear different tune. One we sing for the longest time.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729952
    m_Localized: 'Ballerina: And you?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729953
    m_Localized: 'Ballerina: Do you know where this all go?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729954
    m_Localized: 'Ballerina: Funhouse clown, smile all day in fragile house.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729955
    m_Localized: 'Ballerina: Convenient.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729956
    m_Localized: 'Ballerina: Ears. Teehee.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729957
    m_Localized: 'Ballerina: Earies. Ear, ear, earie, ears. Earies.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729958
    m_Localized: 'Ballerina: That what she wants.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729959
    m_Localized: 'Ballerina: Never thought she''d favor big idiot.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729960
    m_Localized: 'Ballerina: Never thought...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729961
    m_Localized: 'Mother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729962
    m_Localized: 'Mother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729963
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729964
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729965
    m_Localized: 'Anger: Careful swinging that damn boomstick around!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729966
    m_Localized: 'Anger: I''m not tryin'' to get one between the eyes over my fuckin'' EARS of all things. Fuck!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729967
    m_Localized: 'Couple: O-Oh, yes, of course. Just please don''t trouble my darling wife. She''s exhausted.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729968
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729969
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729970
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729971
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729972
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729973
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729974
    m_Localized: 'Couple: To protect the ones you love, sometimes you gotta sink your teeth into life, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729975
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729976
    m_Localized: 'Couple: You understand how tough things are out there.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729977
    m_Localized: 'Couple: My teeth aren''t perfect, but it is what it is. They teased me about them in school, too.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729978
    m_Localized: 'Couple: And where are those bullies now?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729979
    m_Localized: 'Couple: Probably rotting in some alley, beaten to death by the same kind of monsters they once were.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729980
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729981
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729982
    m_Localized: 'Couple: Yepadoodle! My wife and I keep clean, don''t we, honey?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729983
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729984
    m_Localized: 'Couple: Honestly, even in times like these, it''s mighty weird not to take care of yourself.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729985
    m_Localized: 'Couple: If I get sick, who''ll keep my honeybun safe? Nobody.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729986
    m_Localized: 'Couple: Maybe that''s why the Visitors are stronger? They don''t get sick like us.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729987
    m_Localized: 'Couple: Maybe that''s why the Visitors are...what they are? They don''t get sick like us.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729988
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729989
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729990
    m_Localized: 'Couple: Sure, show me yours and I''ll show you mine!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729991
    m_Localized: 'Couple: Sorry... I''m a little nervous... But who wouldn''t be? Being tested is terrifying, even when you''ve got nothing to hide.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729992
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729993
    m_Localized: 'Couple: Alright, fine, I''m very nervous.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729994
    m_Localized: 'Couple: But what do you expect when you''re putting not just me, but my precious pumpkin in danger.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729995
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729996
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729997
    m_Localized: 'Couple: Oh, no, no, no. I''ll be the only one showing you those, buster!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729998
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729999
    m_Localized: 'Couple: Women are expected to shave. Why shouldn''t us fellas?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730000
    m_Localized: 'Couple: At least it helps a little with staying cool in this heat, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730001
    m_Localized: 'Couple: One fella to another... I''m sure you know where I''m coming from!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730002
    m_Localized: 'Couple: Women are supposed to shave. Why would I?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730003
    m_Localized: 'Couple: My job is to keep her safe in a world full of monsters.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730004
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730005
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730006
    m_Localized: 'Couple: Wait, is this really one of those tests?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730007
    m_Localized: 'Couple: No photos. Not of me, not of her.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730008
    m_Localized: 'Couple: But... I guess that might give you reason to suspect us.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730009
    m_Localized: 'Couple: Hold on, let me think...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730010
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730011
    m_Localized: 'Couple: Fine. Take the damn picture. But I get to keep it after.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730012
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730013
    m_Localized: 'Couple: Give it to me!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730014
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730015
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730016
    m_Localized: 'Couple: I don''t see how that has anything to do with the Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730017
    m_Localized: 'Couple: But sure, I''ve got nothing to hide. Here.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730018
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730019
    m_Localized: 'Couple: And? What do you see?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730020
    m_Localized: 'Couple: Honey, you ever hear anything about ears being a sign of a Visitor? Quiet as a mouse, you are!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730021
    m_Localized: 'Couple: Oh, really? Hm. I see... Okay.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730022
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730023
    m_Localized: 'Couple: Interesting. So, how are the results?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730024
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730025
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730026
    m_Localized: 'Couple: Please, my darling wife won''t make it without me. Just put the gun down.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730027
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730028
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730029
    m_Localized: 'Couple: And what?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730030
    m_Localized: 'Couple: That''s not gonna help me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730031
    m_Localized: 'Couple: Won''t help you either. So what''s with the gun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730032
    m_Localized: 'Couple: Won''t help you either, my good fine fella. So what''s with the gun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730033
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730034
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730035
    m_Localized: 'Couple: This is a mistake. If you can''t test her, why jump straight to pulling out a weapon?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730036
    m_Localized: 'Couple: I swear to you, she''s human. Right, honey?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730037
    m_Localized: 'Couple: We''re ready to leave, bags packed. The fact she''s holding us the fuck up doesn''t make us Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730038
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730039
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730040
    m_Localized: 'Couple: I can''t believe you''d ever side with those monsters.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730041
    m_Localized: 'Couple: Are you really going to shoot us over our hair?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730042
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730043
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730044
    m_Localized: 'Couple: Look, I agreed to take the photo in the first place. Doesn''t that mean anything to you?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730045
    m_Localized: 'Couple: ...Apparently not.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730046
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730047
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730048
    m_Localized: 'Couple: I get the nails being an issue, sure. Visitors crawl up from underground, after all.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730049
    m_Localized: 'Couple: Eyes, yeah. Armpits, maybe. But ears?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730050
    m_Localized: 'Couple: Eyes, yeah. Armpits, maybe. But ears? What, because they''re close to the brain?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730051
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730052
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730053
    m_Localized: 'Couple: I hope I haven''t worn you out.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730054
    m_Localized: 'Couple: I know how hard it is, keeping order these days.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730055
    m_Localized: 'Couple: Heck, I''m barely managing my own ball an'' chain, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730056
    m_Localized: 'Couple: Maybe that''s tough for you to understand. I''ll keep that nugget in my pocket.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730057
    m_Localized: 'Couple: These are tough times. People are cracking under the pressure.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730058
    m_Localized: 'Couple: If you don''t get stuck in, get your hands dirty...you won''t last.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730059
    m_Localized: 'Couple: Every time I imagine something happening to my sugarplum, I shiver.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730060
    m_Localized: 'Couple: What scares me most is wondering when my strength will give out—when I won''t be able to protect her.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730061
    m_Localized: 'Couple: All I can do now is try to stay in shape. Make sure I can sock ''em right in the kisser!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730062
    m_Localized: 'Couple: Honey, did you flinch? Don''t be afraid. We''re still together.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730063
    m_Localized: 'Couple: We each have our roles. I provide her safety and a chance to get back to her parents.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730064
    m_Localized: 'Couple: She gives me...what I ask for.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730065
    m_Localized: 'Couple: Fair trade, right? Expecting someone to not be lazy with their looks isn''t too much to ask.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730066
    m_Localized: 'Couple: Life''s taught me not to share who we are, or where we''re going.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730067
    m_Localized: 'Couple: The less you know, the better. Words to live by.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730068
    m_Localized: 'Couple: All we''re trying to do is get back home safely. No sudden moves, no surprises.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730069
    m_Localized: 'Couple: Right, darling?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730070
    m_Localized: 'Couple: You know what, I''ve got nothing more to add. We''ll get back to packing.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730071
    m_Localized: 'Couple: Easy there, big fella...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730072
    m_Localized: 'Couple: You wouldn''t really shoot a poor, defenseless woman...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730073
    m_Localized: 'Couple: Would you...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730074
    m_Localized: 'BigLebowski: Fine. Just hurry up and get it over with, old man.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730075
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730076
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730077
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730078
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730079
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730080
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730081
    m_Localized: 'BigLebowski: Weird thing to ask. And hey, you try anything and I''ll bust your face in. For real.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730082
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730083
    m_Localized: 'BigLebowski: My parents cared more about my teeth than they ever cared about me...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730084
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730085
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730086
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730087
    m_Localized: 'BigLebowski: Hm...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730088
    m_Localized: 'BigLebowski: Whatever. Just don''t freak out, alright?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730089
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730090
    m_Localized: 'BigLebowski: It''s an allergic reaction. I break out in itchy rashes. Nasty stuff. Had it since I was a lil kid.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730091
    m_Localized: 'BigLebowski: Here.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730092
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730093
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730094
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730095
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730096
    m_Localized: 'BigLebowski: Watch those hands. One wrong move and you''re losing an eye.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730097
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730098
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730099
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730100
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730101
    m_Localized: 'BigLebowski: Nope. That''s some weird shit. Not doing it.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730102
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730103
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730104
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730105
    m_Localized: 'BigLebowski: If you''re planning on sending this photo somewhere to help my parents track me down, you can fuck right off.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730106
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730107
    m_Localized: 'BigLebowski: Well? Show me!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730108
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730109
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730110
    m_Localized: 'BigLebowski: Urgh. Whatever. I don''t care.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730111
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730112
    m_Localized: 'BigLebowski: So? Clean enough for you? Do I pass your stupid test or whatever?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730113
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730114
    m_Localized: Leave alone
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730115
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730116
    m_Localized: 'BigLebowski: You know what? Screw it! Shoot me! I''m so done with all this crap!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730117
    m_Localized: 'BigLebowski: COME ON! DO IT!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730118
    m_Localized: 'BigLebowski: PULL THE TRIGGER!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730119
    m_Localized: 'BigLebowski: WHAT''S WRONG? YOU A CHICKEN?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730120
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730121
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730122
    m_Localized: 'BigLebowski: You know what, old man? I don''t even care anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730123
    m_Localized: 'BigLebowski: Make up your mind already. Either shoot me or cut the bullshit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730124
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730125
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730126
    m_Localized: 'BigLebowski: So? My eyes look fine. What''s your deal?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730127
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730128
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730129
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730130
    m_Localized: 'BigLebowski: This is insane! Ughhhh! Do you even hear yourself?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730131
    m_Localized: 'BigLebowski: You know what? Screw it! Shoot me! I''m so done with all this crap!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730132
    m_Localized: 'BigLebowski: COME ON! DO IT!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730133
    m_Localized: 'BigLebowski: PULL THE TRIGGER!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730134
    m_Localized: 'BigLebowski: WHAT''S WRONG? YOU A CHICKEN?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730135
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730136
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730137
    m_Localized: 'BigLebowski: Well?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730138
    m_Localized: 'BigLebowski: Oooh, big man! Big gun! Look at me!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730139
    m_Localized: 'BigLebowski: Honestly, whatever. I don''t care anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730140
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730141
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730142
    m_Localized: 'BigLebowski: Okay. So what?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730143
    m_Localized: Shoot them
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730144
    m_Localized: Hear them out
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730145
    m_Localized: 'BigLebowski: Next time, just pull the trigger. I''m not gonna beg for my life. I don''t give a crap.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730146
    m_Localized: Ugh... I'm soooooo done...
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730147
    m_Localized: 'BigLebowski: Mom always nagged me about my hands. Bla bla bla... "That''s not ladylike."'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730148
    m_Localized: 'BigLebowski: Yeah? And what am I supposed to do about these rashes? It''s an allergy, Mom! Jeez.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730149
    m_Localized: 'BigLebowski: Whatever. I don''t care...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730150
    m_Localized: 'BigLebowski: Cause you know what the most important thing in life is?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730151
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730152
    m_Localized: 'BigLebowski: To find a husband and pop out a kid!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730153
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730154
    m_Localized: 'BigLebowski: Real cool stuff, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730155
    m_Localized: 'BigLebowski: ...Yeah, I''ll fuckin'' pass.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730156
    m_Localized: 'BigLebowski: There were girls in my class who swore their eye color changed with their mood.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730157
    m_Localized: 'BigLebowski: Like, please. Who gives a single shit...!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730158
    m_Localized: 'BigLebowski: As long as you can see, they can be fuckin'' rainbows for all I care. Jeez.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730159
    m_Localized: 'BigLebowski: You''re fuckin'' nuts.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730160
    m_Localized: 'BigLebowski: Pull any creepy crap like that again, and I''m out.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730161
    m_Localized: 'BigLebowski: My family''s got a photo album, filled with pics from preschool. I used to smile so much back then...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730162
    m_Localized: 'BigLebowski: Wonder what changed...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730163
    m_Localized: 'BigLebowski: Oh yeah! They went and slapped those dumbass braces on me! Real good stuff! Loved that!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730164
    m_Localized: 'BigLebowski: I never got why some parents pierce their toddler''s ears.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730165
    m_Localized: 'BigLebowski: Like, what if the kid doesn''t even want that?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730166
    m_Localized: 'BigLebowski: Why do they get to make that decision?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730167
    m_Localized: 'BigLebowski: Ugh, whatever...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730168
    m_Localized: 'BigLebowski: Heh... I always thought I''d be the one to end it myself...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730169
    m_Localized: 'BigLebowski: Thank you...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730170
    m_Localized: 'Luka: Go on, if it helps you.'
    m_Metadata:
      m_Items: []
