%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_en
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 9ca4ee10b5b962b4993a5133922046c2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: Sure, pal. *cough* I''ve nothing to hide. Everything I had went up in flames.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Take a look.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: Don''t *cough* judge too harshly. Lungfuls of smoke ain''t exactly a trip to the dentist.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Here, look... *cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: Like two charred logs and some blackened twigs. Clean fingernails, though. Ironic, isn''t it?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: No problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: See? *cough* Red as a couple o'' smolderin'' coals. It''s from all the smoke, pal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: You sure? It ain''t pretty sight...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: My skin''s cracked like tree bark. I don''t raise my arms if I don''t have to. Hurts like hell.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: Sure, whatever. You''ll only get a charred corpse, though. That''s how it always is.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: How''d it turn out? *cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: You won''t find much to check. They''re charred down to the cartilage.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: I''m sure my hearing''ll go soon. Probably for the best.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Go ahead and shoot if you want, pal. Just don''t aim for the teeth—not long before they rot away anyhow.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Whatever. I''m not afraid of nothin'' no more. Shoot me if it''ll make things easier for you.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: Good idea. Might even be a mercy at this point...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: Do you have any idea what these hands have been through?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: If this photo is my death sentence, let''s *cough* get it over with. I''ve got no life left to live anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Everything turns to ash eventually. ...And I guess I''m next.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: You know, *cough* I could never get my kids to brush their teeth. And now...there''s no one to remind ''em.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: I used to *cough* save lives with these hands. Now I can''t even hold a fucking mug.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: So, that''s what my life''s amounted to...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: Guess it''s time to die...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: When you watch a forest burn... *cough* It just crumbles. And you know there''s nothing you can do.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: Now I wake up at night sometimes, my skin tearing apart. Nothing helps the pain. *cough* The flames took everything.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Only memories are spared. It''s just a matter of time before our bodies burn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: When the fire''s raging around you, you''ll remember the quiet bliss of moments like this. Not in your ears—but your soul.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: Sure, give me the hardest tests you got. I''ll pass them all!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Here, take a look.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: You ever seen chompers like these? It''s like a trove of treasure in my mouth!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: They''re not even teeth—they''re solid gold! Not all of them, of course. But I''m sure I''ll be adding more eventually.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: You ever realize how easy it is to open a beer with your front teeth?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: Fuck bottle openers!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: Hey, I''m just grateful I still even HAVE hands.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: If I didn''t, I wouldn''t be able to race!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Hang on.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: My fingers are gone!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: I was only missing one yesterday. Where''d the rest of ''em go?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: Well, they''ll grow back. It''ll just take a little while.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: My finger is gone...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: Not the biggest deal in the world, but I''m not exactly thrilled about it.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: BUT MY FINGERNAIL''S GROWIN'' BACK A LITTLE, SEE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: Which means my legs are bound to grow back, too! It''ll just take a little while.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: Where do you want me to look? Right at you?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: Don''t mind the twitching. It''s a habit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Ever back in the days when I could rev a real engine, I couldn''t keep my eyes trained on...well, anything.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: Guess I''m not ready to ease up on the speed just yet, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: Huh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: Sure thing, I guess... HAHAHAHA, okay, damn, that''s good!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: You''ve done it, my man: you''ve attained the peak comedy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: We''re all just lookin'' at each other''s armpits now. Insane.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: The world outside is engulfed in hellfire, like the universe is concentrating all its efforts into wiping us out.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: On top of that, we''ve got Visitors out here trying to kill each and every one of us.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: And all you''ve got to say is, "Show me your armpits!"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: HAHAHAHA!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: You wanna take a photo of me?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: Not really the biggest fan of being photographed, but whatever.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: Damn it, I blinked.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: HAHAHAHA! Sure thing, boss!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: So you picked up that broadcast, too?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Yeah, good stuff, right? ...Hm? What?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: ...Wait, you didn''t?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: That''s...fucked up.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: All right, fine, I won''t drink any more of your beer. Don''t take it so personally!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: Y''know what happens to folk who get all bent out of shape like you?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: They get so bent, they break. Then they end up in a chair like me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: If you''re gonna get that mad, hop on and take me for a ride. See what it''s like.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: Why?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: That won''t help me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: And it won''t help you either, most likely. So what''s the deal?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: I probably won''t be able to track the bullet with my naked eye. But I can try to dodge it.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: I''ve never understood why people bother shaving. Hair is the body''s natural defense.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: See that bright, red rash? I''m growing fingers there. Spare ones.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: Ah, the real laughs are yet to come. We''re just getting started!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: Where did we all go wrong?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: Who cares about looking at some dumb photos? Life''s too short for that kinda stuff, amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: What I mean to say is...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Listen, just let me leave, okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: Well, I guess we all get what''s coming to us eventually.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Sooner or later, God''ll cut you down.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: Well I refuse to go quietly! NEVER! AAAAAAAAAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: It''s all programmed into our meat sack biology, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: One moment we''re laughing together—the next, we''re blowing each other''s heads off.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: I need to prepare myself for my final journey...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: My hands are my only engine now.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: And I ain''t got no clutch!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: To be honest, the idea that I might lose them one day too scares me. What''ll I do then?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: I''d hate to be without any means of getting around. Stuck forever...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Even death don''t scare me that much.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: One day, no matter how you look at it, you just can''t catch up anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: You ever noticed how time speeds up with age? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: It seemed like life would last forever when we were kids. Everything was simple then. No responsibilities or decisions.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: But now, no matter how much we rush, it seems like we''ll never catch up.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: You know, somehow, I don''t feel like laughin'' all of a sudden.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: Your crazy tests, putting out fires...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Everyone wants to save the world, except they can''t agree on how.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: And is there even a point? Maybe we all just need to relax and not sweat about it so much.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Look...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: Don''t ya think our joyride on the planet is over?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: It''s the end of the line. We''ll all be getting off soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: Ding ding! The last stop is right there, out through the window.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: But are you ready for it?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: I''ve been thinking, y''know... And promise you won''t get upset?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: If... If you can''t rely on this sign, then how am I supposed to?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: Who knows? Maybe they all point to Visitors, or maybe none of ‘em do!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: People are prone to mistakes, y''know.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: But mistakes can have terrible consequences.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: If... If you''re relying on this sign now, how can I keep trusting the previous ones?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Maybe the others are all a loada baloney, too.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: We''re humans, after all. We can all make mistakes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: But these mistakes can lead to terrible consequences.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Like you... One wrong move is enough for that itchy trigger finger, and then BANG, somebody pays the price.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: If you''re confident in your choice, then... Well, I envy that confidence.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: Fine. Go ahead, test me. I have nothing to hide.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Please.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: You know, I never used to care about them much. I just didn''t have the time. But now... Now I regret that.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Here, take a look.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: They''re shovels, not palms. All for the kids.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: Look, then.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: See these huge bags? Yeah, that what sleep deprivation will do to you...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: Look, then.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: Ran out of deodorant ages ago. Don''t hold it against me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: Can I sit? No?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: Hm. Disheveled and cranky, as always.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: I haven''t cleaned them in a long time. Might well be blocked up by now.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: I''m half deaf already from the kids'' screaming.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: My gums have been bleeding when I brush my teeth. Started last week.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: And look, they''re still yellow. How could I not smoke with kids like these?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: I have some kind of rash from all the cleaning products. I never had time to see a doctor about it.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: These hands will make you soup if you let them! And yet, yours go straight for your gun...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Ha. You could pull out a grenade and the pieces of me still wouldn''t get a good night''s sleep.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: What, you''re going to shoot me because I smell? What a joke.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: Oh, please. Do I really look that bad in the photo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: You''re definitely sick if you want to shoot me because of my ears. What don''t you like? I''ll wear a hat!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: Finally, peace and quiet... No one''s going to badger me anymore...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: ...How sad.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: You know, one of my kids has perfect teeth. And he''s never smiled once. Maybe it''s not about the teeth at all?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Hands... I''ve used them to hug kids, do housework, and hold my husband. And you know what? No one ever appreciated it.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: When your kid is sick, you don''t sleep for days. Then you get used to it and just live in the waking limbo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: One time, I was so tired that I didn''t shower for a week. Kids didn''t even notice.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: You know, I found a photo once where all the kids were smiling. I''d look at it all night until I fell asleep.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: At times, I''d wish I were deaf. But when the kids are asleep, there''s this blissful silence... That''s what you live for.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: Seriously? Fuck... Well, fine, but be quick about it!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: I don''t give a fuck. Here.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: Yellow? Well, fuck ''em.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: White? No wonder they''re white. That''s simple hygiene, fuckwit!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: I figured if my teeth were gonna be fucked anyway, I should at least get a gold one. Like those tough guys in movies.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: Sure, whatever.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Get a loada these bad boys!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: Ha. My grammy always told me that with paws like these, I should be choppin'' wood, not...whatever I was doing.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: But I don''t see no logs around here, and I gotta vent my anger somehow.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: Whatever. Gaze into ‘em, if that''s what you want.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: Like my baby blues, eh? Never needed anything else to pull the chicks. Hah!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: I don''t give a flying fuck.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Yes, I shave.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: I can''t stand it when there''s hairs under my arms. It''s like a shitty little shrub decided to grow there.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: Oh yeah, shitlord?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: Fuck are you staring at me like that for? What''d you see?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Fuck...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: What''re you staring at me like that for? Somethin'' missing?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: Are you outta your fuckin'' mind, dickweed? I just showed you my teeth!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: Think I couldn''t punch your fuckin'' throat out with these hands faster''n you can pull that trigger?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: What the fuck is wrong with you? You jealous or somethin''?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: It itches all the damn time, like it''s tryna piss me off.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: When I scratch it till it bleeds, yeah, then it feels better.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: I ain''t listenin'' to this shit! You''re just fuckin'' crazy!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: You wanna shoot me because of some dumb fuckin'' photo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: Be careful waving that boom stick around.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Who knows... You might shoot me accidentally, all because of my ears.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: You''re completely fucked in the head, y''know that?. Fine. Bring it, bitch!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: You bastard. You completely fucking heartless bastard.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Go fuck yourself.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: My grammy had a gold tooth. Wanted one like that for as long as I can remember.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: It glittered like the sun shone in her mouth.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: She said they put it in when the old one rotted away.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: I thought, "Hell yes! They''ll do the same for me when the time comes."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: Well, the time came. Except no one gave me nothing.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: And now, my mouth doesn''t glitter. It just lingers, piss-yellow and stinkin''.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: You see these hands? Dirt, blood, whatever the fuck else. But they''re mine.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: Sometimes my hands itch so much, I wanna tear off my skin. Or punch a wall. Or both at once.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: I don''t want to hurt anyone. But I can''t hold it back.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: You see these fingernails? Dirt, blood, whatever the fuck else. But they''re mine.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: Sometimes my hands itch so much, I wanna tear off my skin. Or punch a wall. Or both at once.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: I bet if I were someone else, I''d be worried about what I do to myself. But I just don''t give a shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: My grammy always called me Angel Baby ‘cause of my eyes. "Angel." Can you believe that?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: Now I''m standin'' here, staring into these dirty, soulless windows, thinking, "What fucking part of me is an angel?"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: I can already see the way she''d look at me. Disappointed.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: You know, razors are sharp enough to do...something. If only it were that easy...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: I just ended up slicin'' up my arm. Now when I shave, it''s like the blade isn''t cutting my hair, but a part of me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: But I shave, anyway. Because, man, I fucking hate that shrub.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: I don''t even have a photo of my grammy. She didn''t like that shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: She said when you get your picture taken, your soul gets stuck inside the picture for all eternity.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: I laughed my ass off at that. Told her, "c''mon, Grammy, that''s nonsense."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: And she said, "When I die, you''ll look at my picture and wonder if I made it to heaven."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: Well, fuck it all. Got no photos and no grammy neither.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: Sometimes, I catch myself tugging on my earlobe, but only when it''s already burning like hell.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: I used to think it was a nervous thing.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: Then I realized I just wanna to tear it off, like it''s in my way somehow...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: But I''m not crazy enough to fuckin'' mutilate myself, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: RIGHT?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Oh, darling, I knew your energy would resist. But let us do your tests. I shall see right through you, anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Well, take a look.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: Our inner cosmos is reflected in the eyes, not the teeth. Do you wish to see your destiny in them?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: Our inner cosmos is reflected in the eyes, not the teeth. What do you hope to find there?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: Well, go ahead and look.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: But do be careful—I earned myself a few splinters crafting dreamcatchers.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: Oh, my eyes? They''re brown, of course.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Well, if you don''t count the red spots. The moon is to blame for those.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Ohhh, the things the universe puts in my path... Very well, take a look.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: It''s hard to take care of yourself under these conditions, you know...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: Be careful now. My aura can be blinding!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: Well? What do you think?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Go ahead and look, but be careful. My ears hear everything—even your thoughts.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: Well? Did you find any answers?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: You wish to shoot me because of my teeth? Surely you can sense it''s not me? No, Mars and Venus are simply aquarrel!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: You can''t be serious. You''re going to shoot me for having splinters? From my precious dreamcatchers no less!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: Are you crazy?! You know it''s just the moon playing tricks, don''t you? It''s not that easy to track her movement!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: Are you crazy?! You know it''s just the moon playing tricks, don''t you?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: This isn''t astrology, it''s savagery! Why don''t you put the gun down, and I''ll tell you more of my secrets! For free!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: Now now! It''s not my fault you weren''t ready for it, my dear!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: Can you put that thing down? What can you possibly tell by looking at ears? You need them to hear wise words!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: If you kill me, you''ll be doomed to...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: ...Eternal diarrhea!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: You know, a man with perfect teeth came to me once.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: I told him, "Everything''s fine, but your soul is rotten!" Think about what''s more important. You understand, don''t you?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: I once spent all night pulling out splinters after a ritual. It hurt, but each one was like a lesson from the universe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: The eyes are gates to another world. I once saw a man—his eyes glowed like embers. He said it was love, but he was Mars.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: You know, I once went three weeks living ascetically. I thought only of my dreams'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: Thoughts are manifestations, see, and that''s how dreams come true. All I needed to do is make the right wish.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: Strangely I find myself reminded of that now, right at this very moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: I had my picture taken once and thought, "This is a sign from the stars!" And then I realized it was just the flash.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: I once heard a sound...like the universe was trying to speak to me. But I think it was something much, much more.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: I once heard a sound...like the universe was trying to speak to me. Turned out it was just a draft. Still, it was nice.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: You want me to show you my teeth?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: MY TEETH STOOD UP FOR THE TRUTH!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: ...and they fell for it. Martyrs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: You can see that for yourself.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: I clean my teeth with a nice beer solution. It protects the enamel.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: Without it, I would''ve lost my teeth a long time ago.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: Understandable, of course.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: There''s so much going on right now, and yet we survive.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: We live on.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: What?! Have you been sitting in the shadows too long?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: Time to rest, my friend.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: As you wish, my friend!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: Behold these holy nails as much as you like.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: I''ve trained myself to absorb the beneficial sunlight with them.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: And open beer bottles, of course!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: Did you just want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: LOOK INTO MY EYES!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: They are filled with rage and anger.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: LOOK INTO MY DARK EYES!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: I use them to absorb all the benefits of the righteous beams, transforming them into energy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: I get all of my energy through my EYES!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: HAVE YOU SEEN THE RIGHTEOUS POWER OF THE SUN IN MY EYES?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: If not, you''re blind. Try gazing into the Sun for longer, LIKE ME.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: You wanna take a photo of me?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: Hm... Hm-hm-hm...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: Has anyone told you that I''ve greeted the SOLAR LEADER himself?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: Yes, I taught him how to gaze upon the Holy Sun, but I''ll tell you about that later.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: Go ahead. CAPTURE MY HOLY IMAGE!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (You take a photo of the sloppy man.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (As in life, the photo shows him unkempt and filthy.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (You don''t notice any distortions.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: PRAISE BE! HOW WONDERFULLY IT''S ALL TURNED OUT!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: Come see me later, and I''ll tell you all about my life.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: ...For a little fee, that is.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: WHICH I''ll SPEND ON COLLECTING THE ENERGY OF THE SUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: Go ahead, shoot! The truth will protect me!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: Will you put your gun away?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: Well, it''s preeeeeetty hard without a beer in my hands.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: Preeeeeeetty hard.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: Come human, why must we do this?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: YOU''VE GONE SHADOW MAD, UNENLIGHTENED ONE!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: An eye for an eye they say, but then they''ll shoot your ass for a couple of them...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: Woah, woah, woah. Getting a little ahead of yourself there!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: Watch where you''re pointing that thing.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: Wait, you don''t like my holy hands?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: WHY NOT?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: You''re a fool, an ignoramus, and I want some beer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: "Don''t stick your eyes in someone else''s business," they say.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: So what am I supposed to do? Look away forever?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: Ah, wait...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: Was it "nose...?"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: One sec, hold on...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: I don''t give a shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: That''s right.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: You wouldn''t shoot the Sun!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: But don''t worry about me. I''m not offended by such foolish actions.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: So long as you have a generous reserve of cold, life-giving liquid!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: Ah, a prank-lover, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: Well, give them a sniff if that''s what you''re into.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: This is the result of self-care.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: Ah, a prank-lover, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: Well, give them a sniff if that''s what you''re into.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: This is the result of the Sun''s lifegiving rays!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: Though his holy beams we release life''s invigorating moisture!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: W-Wait what—you''re gonna make a decision based on my teeth? O-Okay...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: I just had my teeth fixed.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Though, if I''m honest...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: I can''t really remember being at the dentist. Was I ever even there?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: God, I''m so nervous, I can''t even remember if I ate yesterday.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: So... Um, do I fit the description?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: I''m a Visitor? How? HOW?! It can''t be!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: Ohhh my god, I was chased out of my home, fired from my job, and now I''m gonna get run outta my own head...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: Y-You wanna look at my fingernails? That''s a weird thing to check...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: But okay... Take a look...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: What''s on them? Dirt? No way...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: I... I don''t remember digging in the dirt at all...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: How did all this crap get under my fingernails?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: I couldn''t have been walking around filthy for this long. Could I?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: How...odd.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: I mean, can you imagine? I have no idea where this dirt came from. I''ve just been sitting here, in your house.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: Did... Did someone put the dirt under my nails deliberately? Who would even do that?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: You want to check my eyes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: I can already guess what you''ll see...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: What happens if I have one of the signs?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: Yeah, well. No one''s surprised about that.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: Am I really a Visitor? What do you think?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: And why don''t I know about it? I-Is that how people turn into them?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: Maybe it''s enough just to think you''re not like everyone else... That society hates you.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: I''m scared of dying...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: W-Wait, can you cover my eyes? Do you have some kind of bandage?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: Or... Or... Let me have just a little longer...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: If it turns out that I''m a Visitor, will I start killing people?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: Will I become dangerous? ...Or have I always been?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: Maybe I''ve already killed people?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (You take a photo of her.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (When the picture develops, you see a blurry body and a crisp background.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (It''s like the person flinched when the picture was taken.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: Hahaha, can you imagine? I just flinched.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: Um... What happens now?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: Can you let me live? Or would it be better to kill me? What''re you going to do?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: Why?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: Wouldn''t it be easier to just shoot me already?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: I want to leave, but I''m too scared.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: Maybe...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: I... I don''t know.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: If you shoot me, will I turn into something even more terrible?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: Maybe I should run away...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: I... I don''t know if I''m even human anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: What am I supposed to do?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: Just like those Visitors back home...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: ...Sorry, it was a horrible experience. I''ll show you.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: Am I human? Am I? Tell me I''m a human, please! Please!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: Hahaha! Why''d you ask to see if you were just going to pull out a gun anyway?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: Do you enjoy humiliating people?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: What a nightmare... You can''t feel safe anywhere...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: One day, Visitors might break into your house. The next, a madman might kill you because of your armpits...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: WHY CAN''T SOMEONE SAY THAT EVERYTHING WILL BE OKAY?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: So that''s it? That''s all it takes to be branded a Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: Great. My body fails me yet again...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: I know... It''s all gnarly. It''s why they were all scared of me at work.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: I went to the hospital last week because of my back... I think.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: Did... Did I also go to the dentist then?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: How much did I spend...?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: You want me to show you my teeth?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: Okay, take a look. Take in that odor of sadness and smoke.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Pretty yellow, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: So piss off with your tests.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: I''m not a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: Where''d they even come from?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: Fingernails caked with dirt are a sign?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: They could just wash their hands!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: You''re saying a gardener would automatically become a Visitor, then?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: Fucking nonsense.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Check my nails.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: Well? Am I a Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: Don''t think so.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: Every day is more ridiculous than the last.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: What if I hadn''t slept? Or was crying?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: I don''t understand how this works at all anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: And what are you going to do if one sign confirms it? Or several?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: I''m going to go become a Visitor tonight.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: I''ll make myself cry by remembering peaceful times.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: All these tests for signs, guys in yellow suits...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: It''s all...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: ...A fucked-up mess.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: Ever get the sense that it''s all leading to some kind of terrifying hell?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Everything''s supposedly under control, but there''s complete chaos all around us.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: Well, take your damn photo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (You take a photo of him.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (He''s sitting calmly, not fully in frame, but you don''t notice anything unusual.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: I''m just terrified of what will happen next.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: Fucking seriously? Are you a moron?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: Has FEMA blended your brains?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: Or are you just blasted? I thought all the strong stuff was gone already...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: Well, since you''re asking, I''ll show you!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: Did you get what you wanted?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: Have you sniffed to your heart''s content?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: Thanks for not digging around in my ass!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: Just be quick about it.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: What?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Um... Okay.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: Done?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: Can I have some peace and quiet?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: Hands...? One second.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: They''re worn out from carrying the one they refused to save.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: Look, can you stop asking me to do this shit?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: If you want to shoot me so badly, just shoot me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: I don''t have any strength left...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: What are you looking for? Redness?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: If you must...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: So if I show any emotion, does that mean I''m a Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: Can we be frank now?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: You can''t be happy, you can''t cry.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: You can''t always talk.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: What''s left? Sitting around with your face in your hands?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: Is it really going to end so easily?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: No more suffering?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: But I didn''t save you...my...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: Really? That doesn''t seem humiliating to you?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: No one helped me save my husband, and now...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: YOU WANT TO MEMORIALIZE HIS DEATH?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: I''m speechless.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: Just do what you want and leave me alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (You take a photo of her.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (You don''t notice anything unusual.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (The dead man ends up in the frame, which forces you to reflect on life.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: Happy now?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: He always liked my teeth.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: I wanted to get braces, though.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Sure. Why not shoot me, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: Can people even cry in this new world? Because they surely can''t laugh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: Are you insane?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: Please tell me, ARE YOU INSANE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: If those devils told you to jump off a cliff, would you be the first over the edge?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: You... For fuck''s— I have no words.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: Well? May as well take out your gun.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Damn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Just pull the trigger. FEMA killed my soul. You may as well finish off the rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: I don''t even think about braces anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: Until you asked to see my teeth, I had forgotten all about those past idle whims.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: Oh, god... I''m just exhausted.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: I take it out on everyone around me. But...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: It''s no one''s fault. No one except a few bastards.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: I can''t understand it. And I don''t want to.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: To humiliate someone who just lost...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: Just a minute...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: Oh. So you took out your big gun.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: And you didn''t even have the grace to kill me in the end.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: What was all that about? Your insecurities? No need to let it show like that.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: Teeth I can do.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: My homie was a dentist.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: Guess what? They knocked his fucking teeth out! HAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: Oh, you wanna see them. Aight...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: All G, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: What the hell, bro? That was like a totally normal story.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: But blowing up my face ‘cause of my teeth... Maaaan, I don''t get it.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: Please?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: Are you nuts?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: Man, suck my d...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: Da fuck, bro? I''m just a regular guy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: I don''t do no crap with my nails, man, see?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: Don''t get me wrong.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: I wash ''em. I do. Look, I just saw a coin on the ground and picked it up. Aight?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: They''re clean. I''ll wash my hands today, man. C''mon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: I wash ''em, bro. I just didn''t have time to do it today.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: They''re clean. ...Mostly.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: You''re gonna waste a dude just for dirty fingernails?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: Maaaan. I didn''t think I''d die in such a dumbass way.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: Seems like a weird way to identify those freaks, bro. Not gonna lie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: You can tell douchebags and suckers by their hands. But Visitors? Na, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: You''d have to get up at 9am and work for like 4 hours. Couldn''t be me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: My eyes have been itchy as balls lately.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: You think it''s from the sun? Kinda sus right?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: Shit, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: It''s some kinda cooties-ass disease or somethin''.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: Listen, I came up with a plan.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: Let''s say we are gonna shoot people in the face...and then they pay us not to!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: What? C''mon, man, it ain''t that deep.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: Fine, if you don''t live for the hustle, I feel you. But I really do have fucky eyes, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: If only you had some eye drops...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: I still wouldn''t buy them, though. I got my reasons.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: You wanna take a pic? Aight.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: Gotta tell ya, man, I got a high sensitivity to light. I might flinch.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (You take a photo of him.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (The picture seems normal, but his face...)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (It came out really blurry.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: Told ya, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: Wanna retake it?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: Don''t try and rip me off, bro, you gotta warm those suckers up.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: Keep ''em in line.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: Otherwise, they''ll relax, forget whose crib they''re in, and won''t pay up.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: Wait!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: Fuck you and your crib. I''m out.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: Gonna go stand right under the sun. Enjoy that on your conscience, fucknugget.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: Da fuuuck...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: You picked a freaky hustle this time, douchebag.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: But you''re the boss here...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: Well, what''s the verdict? All good?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: Leave him alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: Wait, hold up! Okay, shit, one time I tried shaving and decided to keep doing it.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: Just keep your mouth shut, bitch. You ain''t no snitch, right? Right?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: Yoooo...! Not cool, bro! That''s like asking for panty pics!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: You know a civilized gentlesir like me can''t have fucky pits, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: Shoot him
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: Hear him out
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: I knew you were solid. You wouldn''t blast a totally normal guy, right? Heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: Why don''t we put the squeeze on these chumps?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: No? Aight. Later.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: I know you''re startin'' to get stressed out ''cause of all the Visitors and shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: And you''re doin'' all this for us.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: Anyway, no hard feelings. F''real. F''real.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: My teeth? You want me to show you my teeth?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: Why? I still have some baby teeth. Dad said...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: I''m not gonna cry anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: Well, here they are.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: What does it mean?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: Everything okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: I can cut my own nails already.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: I''m not very good at it yet...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Look. See!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: Pretty nice, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: I trimmed them all by myself. I did it. Myself.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: I''m gonna go. I want to be alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: You''re gonna look inside my eyes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: Will you see what I''m thinking about?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: In that case, I''ll make sure to think really carefully, don''t worry.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: Why do you look like that?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: Did you s-s-see...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: You... *sobs*.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: I w-w-want a d-drink.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: Um... So what do I have to do?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (You look at her and realize this is overkill.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: You just want to know how I am?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: I''m really tired. Can I play by myself now?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: A picture?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: I haven''t had my picture taken much.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: Will you show me after?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (You take a photo of her.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (The picture comes out a little blurry.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (She ran over to you without waiting for you to finish taking the picture.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Hmmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: ...Thanks.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: I don''t like it. Don''t ask me for more pictures.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: Well now, go right ahead and check, deary. You won''t see anything you haven''t seen before.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: My teeth?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: Aaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: You know, these old teeth... Feh, I used to hate them. Thought I should just rip them all out.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Look at my fingers—they can''t count, stack, or measure right.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: They give you just enough. Just enough to keep you from running out.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Oh, deary... Are you sure you want that?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: The eyes are like windows. For light in houses, and for truth in people.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: But mine are dusty... The glass is cracked... Moths ate the curtains long ago...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: Don''t look, deary. There''s nothing there.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: Feh! Making an old woman lift her arms... Have you no shame?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Well, what can I do? You are the owner of the fine house.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: Well, deary?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: Now, why waste film on an old lady? It''s clearly in short supply... You insist? Well, I suppose!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: So, what do you think, deary?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: Feh! What an idea, sweetheart.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: They''re as ordinary as can be. Hearings all there. But you know... Sometimes, I feel like I''m fading.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: It''s like I can only be seen through a skylight, and not always even then.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: Now now... Why are you pointing that old thing at me, deary?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: I''m already falling apart at the seams and you want to make me toothless to boot! Feh!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: Do you think I''m scared, deary? Afraid to lose these old hands?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Oh, I''ve clutched at the air so many times that even my fingers themselves know I can''t hold onto anything anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: So, that''s what my life''s amounted to...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: You don''t believe me? You want to check? Well, here, take a looksee...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: I used to gaze into people''s eyes too. This reminds me of those days...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: Well, dear, it''s mark of old age. Everyone lucky enough to live out their days gets a gift like this. Didn''t you know?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: The fungus feels no pain. It doesn''t ask to eat. It just is. It lives to live. Like me, fehehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: Oh what a bother, you''re going to snap because of this too?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: What''s that, deary? You can tell something from looking at my ears?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: Feh... I don''t mind. What does it matter to me, deary? I''ve wanted to see the end for a long time now.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: It''s just...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: I paid a doctor to have done with it and take them all out, but he couldn''t do them all at once.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: I''d go see him, pull out one or two at a time... Couldn''t get them all. Doctors don''t have time for all that now.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: And so, deary, here I am, with all this bothersome unfinished business in my mouth.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: Hands are for those who hold them. And I''ve not had the pleasure for many a year, deary.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: Put out my hands? Feh! You can reach out yourself, can''t you?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: To the hut of the six-fingered untruth... Come on in, stalk down this narrow cage...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: Do you think you can escape this fate? Well, only if you die young. But don''t you be getting any ideas now!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: Such a handsome little face! We can''t let such a thing go to waste now!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: Back in my day only the rich had doohickeys like that. But now, well, any old fool has one!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: I shan''t talk any more! All these silly antics and bothering good people for no darn reason... Feh!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: Just don''t torment my sister.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: We''ve always had strong teeth in our family.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: Back when I was a teenager, I even tried to open a beer with them.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: It didn''t end well. But it taught me to take better care of what can''t be replaced.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: My sister isn''t in any shape to take care of herself right now. So my hands are always full.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: And how should human hands look when they''re responsible for two lives at once?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: Yeah, my sister cries a lot, but our eyes are still really similar. Her''s are a bit calmer, maybe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: ...That worries me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: Yeah, my sister cries a lot, but our eyes are still really similar. They''re not red, is what I mean.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: Maybe she''s already cried every tear she can.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: I''ll show you. But please don''t bother my sister, okay? She''s too tired for this.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: I typically shave. I try to take care of myself.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: Even in these crazy times.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: I typically take care of myself, but I didn''t bring a razor with me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: There''s not really time for that, anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: My sister and I have gone through enough already. Please, put that gun away.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: I started smoking recently. ...Because of people like you.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: You think you''re the only one who''s got it rough?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: You think you can point a gun at whoever you want?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: What''s the matter? Did my gaze seem too fast or empty to you?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: What''s the matter? Did my gaze seem too empty to you?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: You think you look any different?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: You should calm down, don''t be so impulsive. That''s what I always tell my sister.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: Shame I have to tell you, too.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: Wait. Did the news seriously say that Visitors have THESE kinds of armpits?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: Think a little harder. Don''t do something stupid.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: So this is how the ballad of my life ends?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: Bittersweet, without the sweet...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: Life always tested our strength. Everything was always so hard.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: My sister couldn''t take it. She gave up.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: I understand. You have been put in a difficult situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: But if you give in to panic, are you really any different from the Visitors?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: What did you think would happen if you isolated yourself from others?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: Ugh. I''m so sick of this.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: I just want to take a breather and not live in constant fear.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: But every day''s the same, and it doesn''t seem like there''s an end in sight.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: To be honest, I''m terrified.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: What''s next? Will the Visitors disappear, or do we just have to share our lives with them forever?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: Do it already.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: Armpits
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: Ears
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: Take a look.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: You gonna knock them out?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: My sister helps me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: But it''s pointless.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: She should''ve...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: She should''ve just let me die back then.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: My sister and I have similar eyes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: ...But hers aren''t so empty.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: My sister shaves my armpits. She takes care of me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: I guess it hasn''t been in vain.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: Pull out the gun
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: All the better.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: Take my soul.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: No need for that.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: Death''s already close, anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: You can just leave it to me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: Give me the gun.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: I''ll do it myself.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: When I close my eyes, the emptiness won''t go away...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: ...It''ll just become yours.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: Is that what you want?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: Well, deary?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: Are you gonna press the button?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: Hear her out
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: Don''t have the courage?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: You''ll die, anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: Pity.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: Maybe next time.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: Pity.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: I don''t have the signs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: Maybe next time.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: What if we''re just getting ready for a black hole to consume us?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: We''ll be sucked in and stretched along the event horizon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: Never to witness our own demise.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: Only eternal agony and the anticipation of death.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: Doesn''t matter.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: I''ll wait for my time.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: My song...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: It was meant for you!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: It had a happy ending!'
    m_Metadata:
      m_Items: []
