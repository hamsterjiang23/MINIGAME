%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Endings_pl
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 5b2e2a6d2de35064e96737a28b7715de, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 206681661440
    m_Localized: Właściwie to dopiero co wróciliśmy z wyjazdu.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632960
    m_Localized: Nie męczy cię siedzenie w domu?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632961
    m_Localized: Tak, tak, pamiętam.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632962
    m_Localized: Poszliśmy na plażę.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632963
    m_Localized: Ale wczoraj było za gorąco i wróciliśmy wcześniej.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632964
    m_Localized: Tak, przygotowujemy ją do rozpoczęcia szkoły.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632965
    m_Localized: Nie chce iść, ale nic na to nie poradzisz, prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632966
    m_Localized: Dobra, wpadnę później wieczorem.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632967
    m_Localized: Okej, potem pogadamy. Czołem.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632968
    m_Localized: Schodzisz do piwnicy razem z innymi ocalałymi.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632969
    m_Localized: Jest tu chłodniej, ale atmosfera wciąż jest napięta.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632970
    m_Localized: Przy ostrożnym wydzielaniu żywności zapasy wystarczą na miesiąc lub dwa.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632971
    m_Localized: Barykadujesz drzwi. Nikt się tu teraz nie dostanie.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632972
    m_Localized: Śledzisz upływające dni, zaznaczając je na ścianie piwnicy.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632973
    m_Localized: Oczekiwanie na koniec wlecze się prawie dwa miesiące.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632974
    m_Localized: Niektórzy mają nadzieję, że słońce w końcu spopieli ziemię lub zniknie w mroku. Inni kończą ze sobą na własnych warunkach.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632975
    m_Localized: Przedłużanie nieuniknionego sprawia więcej bólu niż szybki koniec. Nikt nie zazdrości żyjącym.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632976
    m_Localized: Jednego dnia słyszysz komunikat w radiu.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632977
    m_Localized: …będzie można bezpiecznie wyjść na zewnątrz za dnia”.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632978
    m_Localized: Czujesz…
    m_Metadata:
      m_Items: []
  - m_Id: 206702632979
    m_Localized: Rozczarowanie?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632980
    m_Localized: Dochodzi do ciebie, że mimo wszystko przeżyjesz ten rok.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632981
    m_Localized: Ale co potem? Czy następne lato będzie ostatnim?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632982
    m_Localized: Myśl o oczekiwaniu końca to ciężki kamień na sercu.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632983
    m_Localized: Ale przynajmniej jedna inna osoba zdaje się szczęśliwa.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632984
    m_Localized: Kto wie… może pociągniesz jeszcze z dekadę?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632985
    m_Localized: Razem z ocalałymi schodzisz do piwnicy.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632986
    m_Localized: Jest tu chłodniej, ale atmosfera wciąż jest napięta.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632987
    m_Localized: Przy ostrożnym wydzielaniu żywności zapasy wystarczą na miesiąc lub dwa.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632988
    m_Localized: Barykadujesz drzwi. Nikt się tu teraz nie dostanie.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632989
    m_Localized: Śledzisz upływające dni, zaznaczając je na ścianie piwnicy.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632990
    m_Localized: Oczekiwanie na koniec wlecze się prawie dwa miesiące.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827264
    m_Localized: Słońce nie jest jedynym zagrożeniem czekającym na powierzchni.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827265
    m_Localized: Paranoja pogłębia się dzień za dniem.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827266
    m_Localized: Chłodne. Wyrachowane. Obce.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827267
    m_Localized: Zaraz nastąpi koniec.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827268
    m_Localized: Nie masz jak się stąd wydostać.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827269
    m_Localized: W twoim domu byli nie tylko ludzie.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827270
    m_Localized: Twoje ciało przeszywa ból.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827271
    m_Localized: Żywisz nadzieję, że to się wkrótce skończy.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827272
    m_Localized: Ból zanika, gdy ulatuje z ciebie życie…
    m_Metadata:
      m_Items: []
  - m_Id: 206706827273
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206706827274
    m_Localized: Przyjmijcie mnie do siebie…
    m_Metadata:
      m_Items: []
  - m_Id: 206706827275
    m_Localized: Liczę, że niczego nie żałujesz.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827276
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206706827277
    m_Localized: Zastanawiało cię kiedyś, co jest potem?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827278
    m_Localized: Znaczy się, co jest po śmierci. Co wtedy?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827279
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206706827280
    m_Localized: Widzę, że pogodziłeś się z losem.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827281
    m_Localized: Po co martwić się tym, co nastąpi po tobie, racja?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827282
    m_Localized: Czas na nas…
    m_Metadata:
      m_Items: []
  - m_Id: 206706827283
    m_Localized: Nawet wiele dni później dom wciąż stoi pusty.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827284
    m_Localized: Wszyscy omijają go z dala jak zarazę.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827285
    m_Localized: Plotek krąży więcej niż wszystkich ludzi, którzy kiedyś tam żyli.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827286
    m_Localized: Dom i ostatnie ślady po jego właścicielu przepadły w bezmiarze czasu.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827287
    m_Localized: Nie pojawili się żadni krewni, by zebrać resztki.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827288
    m_Localized: Gospodarz zniknął bez wieści, jakby nigdy go tam nie było.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827289
    m_Localized: Wszystko, co do niego należało, przepadło, rozpadło się, lub zostało zapomniane.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827290
    m_Localized: Dlaczego ludzie tak kompletnie znikają?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827291
    m_Localized: Gdy wpadniesz w objęcia śmierci, ślady twojego istnienia niemal natychmiast zaczynają się zacierać.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827292
    m_Localized: Wszystko obraca się w nicość…
    m_Metadata:
      m_Items: []
  - m_Id: 206706827293
    m_Localized: Jak gdyby twoja osoba nigdy nie była częścią świata.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827294
    m_Localized: Niechże chociaż do dłoni ściętych przez mróz się przytulę.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827295
    m_Localized: Czy byłbyś się w stanie na to zdobyć?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827296
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206706827297
    m_Localized: Gratulacje!
    m_Metadata:
      m_Items: []
  - m_Id: 206706827298
    m_Localized: Udało ci się opuścić miejsce, które było jak poczekalnia.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827299
    m_Localized: Ty… co?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827300
    m_Localized: Gdzie… jestem?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827301
    m_Localized: Miliony, które drżą przede mną, mogłyby wybudować wspaniałe miasto.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827302
    m_Localized: Ale nie lękaj się. Tutaj strach nie istnieje.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827303
    m_Localized: Od jak dawna pragnąłeś mnie ujrzeć?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827304
    m_Localized: Wyczuwam to. Wszystko w porządku.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827305
    m_Localized: Co teraz?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827306
    m_Localized: Umarłem? Czy to koniec?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827307
    m_Localized: Na tych żałobnych ziemiach wszystko przygotowane jest na zimę – grube ściany, ciepłe płaszcze, przyjemne sny.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827308
    m_Localized: Jak pięknie, że ta długa noc dobiega końca. Zbliża się świt. Czy mam zachować twój cień?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827309
    m_Localized: Widzę, że chcesz.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827310
    m_Localized: Nie ma powodów do obaw.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827311
    m_Localized: Nie pozostało nic, czego można by się bać.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827312
    m_Localized: Droga poskręcała się w śliski węzeł, a potem rozpadła.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827313
    m_Localized: Co teraz?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827314
    m_Localized: Umarłem? Czy to koniec?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827315
    m_Localized: Bezmierna wieczność czeka.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827316
    m_Localized: Jakże wspaniałym jest, że wszelkie cierpienie ma swój koniec.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827317
    m_Localized: Poznasz to, czego chciałeś się dowiedzieć.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827318
    m_Localized: Ale szukanej odpowiedzi nie odnajdziesz.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827319
    m_Localized: 'A: A towarzyszyć ci będzie przy tym mantra:'
    m_Metadata:
      m_Items: []
  - m_Id: 206706827320
    m_Localized: Boję się.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827321
    m_Localized: Co mam począć? Czy… nic już więcej nie ma?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021568
    m_Localized: Boję się…
    m_Metadata:
      m_Items: []
  - m_Id: 206711021569
    m_Localized: Czy ja… umarłem?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021570
    m_Localized: Co tak naprawdę oznacza umrzeć?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021571
    m_Localized: Może zasnąłeś i odnaleźliśmy się we śnie.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021572
    m_Localized: W tym sensie jesteśmy podobni do siebie.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021573
    m_Localized: Jestem niechcianym rodzeństwem, czarną owcą w rodzinie ludzkości.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021574
    m_Localized: Co mam począć? Czy… nic już więcej nie ma?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021575
    m_Localized: Boję się kontynuować…
    m_Metadata:
      m_Items: []
  - m_Id: 206711021576
    m_Localized: Oczywiście.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021577
    m_Localized: Ta niewielka kraina pochłonęła tak wiele snu.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021578
    m_Localized: Dokąd chcesz się udać?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021579
    m_Localized: Do tych, których spojrzenia wyryły ślady w twoim sercu?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021580
    m_Localized: Nie, nie chcesz ich widzieć.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021581
    m_Localized: Jesteś zmęczony.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021582
    m_Localized: Wiem, dokąd musisz iść.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021583
    m_Localized: Tam, gdzie mnogość zwierciadeł wywołuje efekt obfitości.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021584
    m_Localized: Nie lękaj się. Upływ czasu to moje dzieło. Nic ci tutaj nie grozi.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021585
    m_Localized: Znajdź ukojenie w mroku. Nie ma tu zamaskowanego faceta ani nikogo innego. Są jedynie cieniami na moich ścianach.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021586
    m_Localized: Widzę, żeś gotów.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021587
    m_Localized: Poprowadzę cię w noc, gdzie sosny sięgają gwiazd.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021588
    m_Localized: Tego pragnąłeś, czyż nie?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021589
    m_Localized: Oto miejsce dla ciebie.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021590
    m_Localized: Lecz… te krótkie ścieżki niebawem przedziwnie się poszerzą.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021591
    m_Localized: Długie, zakurzone, wyściełane kompromisami.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021592
    m_Localized: Baw się dobrze…
    m_Metadata:
      m_Items: []
  - m_Id: 206711021593
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206711021594
    m_Localized: Czy ja nie żyję?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021595
    m_Localized: Czy utknąłem tu na zawsze?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021596
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206711021597
    m_Localized: Czy ktoś przybędzie?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021598
    m_Localized: Mogę włączyć sobie film albo coś?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021599
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206711021600
    m_Localized: Czy ktoś przybędzie?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021601
    m_Localized: Mogę włączyć sobie film albo coś?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021602
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206711021603
    m_Localized: Czy ktoś tu jest?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021604
    m_Localized: Boję się…
    m_Metadata:
      m_Items: []
  - m_Id: 206711021605
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206711021606
    m_Localized: Czy ktoś tu jest?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021607
    m_Localized: Boję się…
    m_Metadata:
      m_Items: []
  - m_Id: 206711021608
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206711021609
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206711021610
    m_Localized: Dnie i noce nie mają tu znaczenia.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021611
    m_Localized: Nie wiem, od jak dawna tu jestem.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021612
    m_Localized: Ale teraz… jestem spokojny. Tak bardzo spokojny.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215872
    m_Localized: Nie słyszę żadnych kroków ani głosów. Nie odczuwam niczego.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215873
    m_Localized: Nie pamiętam, jak się tu znalazłem.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215874
    m_Localized: Nie wiem, jak mam stąd odejść.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215875
    m_Localized: Ale tak naprawdę nie chcę porzucać tego miejsca.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215876
    m_Localized: Mam nadzieję, że nie skończy się to szybko…
    m_Metadata:
      m_Items: []
  - m_Id: 206715215877
    m_Localized: Ciekawi mnie, co to wszystko znaczyło.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215878
    m_Localized: Dlaczego zostałem tu wpuszczony?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215879
    m_Localized: Czy ktoś po mnie przyjdzie?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215880
    m_Localized: Chciałbym ich znowu zobaczyć.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215881
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206715215882
    m_Localized: Jestem… zmęczony.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215883
    m_Localized: Odpocznę tylko chwilkę.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215884
    m_Localized: Grzyby są nie z tej ziemi, wiesz? Oho!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215885
    m_Localized: Pną się w górę wyżej i wyżej… szybko jak fasola i wprost na twoich oczach.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215886
    m_Localized: Ciekawe, co z się z nimi stanie, gdy wybije północ, hmmm…
    m_Metadata:
      m_Items: []
  - m_Id: 206715215887
    m_Localized: …tym w grzybni gromadzi się więcej kępek nikczemności.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215888
    m_Localized: Aż nic by nie zostało…
    m_Metadata:
      m_Items: []
  - m_Id: 206715215889
    m_Localized: A teraz, mój drogi chłopcze, grzybnia musi znaleźć ujście swojej wściekłości…
    m_Metadata:
      m_Items: []
  - m_Id: 206715215890
    m_Localized: Motyla noga, nasz rytuał miał ją uspokoić.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215891
    m_Localized: Celem jabłecznych pestek było przypomnienie jej o grzybno-ludzkiej więzi.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215892
    m_Localized: Jednakże grzybnia chyba dostała hyzia i zaślepia ją gniew uwięziony w strzępkach.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215893
    m_Localized: Gdzieś tam leży Kraina Grzybów!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215894
    m_Localized: Pędem, mój drogi chłopcze! Musimy powstrzymać grzybnię, nim grzyb się zbyt rozrośnie!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215895
    m_Localized: Idziemy pod ziemię!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215896
    m_Localized: Kurza twarz… spóźniliśmy się, drogi chłopcze.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215897
    m_Localized: A to dopiero.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215898
    m_Localized: Słuchaj… masz może jeszcze trochę kombuchy?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215903
    m_Localized: Patrzajże! Piekielne światło słabnie!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215904
    m_Localized: Czas przemocy mija, a my zapowiadamy nową epokę beztroski.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215905
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206715215906
    m_Localized: Nie trzeba dłużej się zamartwiać. Moje owieczki zagłodzą cierpienie.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215907
    m_Localized: Tego dnia, bracia… odnaleźliśmy nasze wybawienie.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215908
    m_Localized: Lecz najpierw trzeba nam czuwać nad przygotowaniami, a potem czekać…
    m_Metadata:
      m_Items: []
  - m_Id: 206715215909
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206715215911
    m_Localized: Nadajemy imiona zmarłym, by nadać ich śmierci znaczenie. Odejdą tak samo, jak i my.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215912
    m_Localized: W ten sposób okryliśmy Oluna. To teraz jego imię.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215913
    m_Localized: My także otrzymamy imiona.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215914
    m_Localized: Oto i nadszedł czas.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215915
    m_Localized: Bracia, wezwijmy Ją. Jesteśmy gotowi.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215916
    m_Localized: Nie przepaść w nicości, ale powrócić w Śmierć.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215917
    m_Localized: Pozostawiamy nasze ciała w objęciach Śmierci, by odnaleźć spokój w miejscu poza światem.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215918
    m_Localized: Ta wiedza niegdyś była powszechna, ale wielkie wymieranie zgładziło nie tylko życie.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215919
    m_Localized: 'Ending: Teraz przypomnieliśmy sobie raz jeszcze, jak oddać się w Jej objęcia.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215920
    m_Localized: Echem odbija się głos o nieznanym źródle.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215921
    m_Localized: 'Ending: Pozostało jeszcze wiele miejsc, w których nie doszukałem się jeszcze Jej słów.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215922
    m_Localized: 'Ending: Ale… ty, tak jak i ja, wiesz, dokąd prowadzi ta droga.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215923
    m_Localized: 'Ending: Od samego początku było jasne, gdzie się spotkamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215924
    m_Localized: 'Ending: Właśnie tu. Dokładnie w tej chwili.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215925
    m_Localized: 'Ending: Czy mam odłożyć cię jak zakładkę chowaną do książki?'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215926
    m_Localized: 'Ending: Chronić cię przed powodziami, pożarami i upływem czasu?'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215927
    m_Localized: 'Ending: Czyż to nie tego właśnie pragniesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215928
    m_Localized: 'Ending: Słyszę twoje wycie i lamenty. Matka Westchnięć by się odnalazła, gdyby sama się wzniosła.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215929
    m_Localized: 'Ending: Po co opuszczasz to miejsce, gdy i tak powracasz w noc?'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215930
    m_Localized: Ukryję cię. Skryję i odprowadzę tam, gdzie twoje miejsce.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215931
    m_Localized: 'Ending: Przed nami rozegrał się absurdalny ciąg wydarzeń.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215932
    m_Localized: 'Ending: Lepiej jest jednak czcić co znane i ichnie głębokie mogiły.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215933
    m_Localized: Przybywasz znikąd, przyciągając wzrok.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215934
    m_Localized: Niektórych drzwi lepiej nie otwierać.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215935
    m_Localized: 'Ending: Twoim przeznaczeniem nigdy nie było przetrwanie w szaleństwie kosmosu.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215936
    m_Localized: 'Ending: Zachowam pamięć o tobie…'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215937
    m_Localized: Nie miałem zamiaru przychodzić, ale miałem wizję… Dzieje się tu coś dziwnego.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215938
    m_Localized: Gdy spoglądam na twój dom, przypomina mi się pewien wers.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215939
    m_Localized: Zupełnie jak wtedy, gdy stoisz przed czymś tak mrocznym, że opuszczają cię wszelkie chęci i obserwuje cię chłodna ziemia.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215940
    m_Localized: Czy… coś zrobiłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215941
    m_Localized: Nie wiem, co masz na myśli
    m_Metadata:
      m_Items: []
  - m_Id: 206715215942
    m_Localized: Zabijałem Przybyszy. Jak inaczej miałbym przeżyć?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215943
    m_Localized: Chyba jednak wiesz.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215944
    m_Localized: Coś za tobą podąża, ciągnie się za tobą ślad mroku. Nie tak… miało być.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215945
    m_Localized: Obawiać się śmierci? Starać się przeżyć? To zupełnie normalne.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215946
    m_Localized: Ale zboczyłeś ze ścieżki, a twój strach przywołał bliżej śmierć.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215947
    m_Localized: Nie sądzę, bym mógł coś na to poradzić… Wybacz.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215948
    m_Localized: Nie, coś na pewno jest nie tak.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215949
    m_Localized: Czekaj… teraz widzę.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410176
    m_Localized: Zbyt bardzo byłeś przerażony. O matko…
    m_Metadata:
      m_Items: []
  - m_Id: 206719410177
    m_Localized: Zaślepił cię strach.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410178
    m_Localized: Nie sądzę, bym mógł zapobiec temu, co nadchodzi… Wybacz.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410179
    m_Localized: Dobrze o tym wiem.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410180
    m_Localized: Kieruje cię ku makabrycznym wyborom.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410181
    m_Localized: Ale ta wiedza tylko pogarsza sprawę.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410182
    m_Localized: Co sprawiło, że obleciał cię strach?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410183
    m_Localized: Ból?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410184
    m_Localized: Przemijanie?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410185
    m_Localized: Prędzej czy później.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410186
    m_Localized: Ale… twój wybór padł na „prędzej”.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410187
    m_Localized: Tak mi przykro.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410188
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 206719410189
    m_Localized: Bez broni. We krwi.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410190
    m_Localized: Braknie ci sił, by odczołgać się od światła.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410191
    m_Localized: Nie masz sposobu, by skończyć ze sobą.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410192
    m_Localized: Spłoniesz powoli…
    m_Metadata:
      m_Items: []
  - m_Id: 206719410193
    m_Localized: Chyba że…
    m_Metadata:
      m_Items: []
  - m_Id: 206719410194
    m_Localized: 'Window: Znowu widzisz to dziecko. Ale co ono tam robi?'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410195
    m_Localized: 'Window: Czy ono pożera psa? Nie… Przytula się mocno do piersi zwierzęcia.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410196
    m_Localized: 'Window: Stoisz jak wryty, nie mogąc się poruszyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410197
    m_Localized: 'Window: Dlaczego ono nie pójdzie do matki?'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410198
    m_Localized: 'Window: Czy ona tak naprawdę była w ciąży?'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410199
    m_Localized: 'Window: Gdy się nad tym zastanawiasz, świat na zewnątrz zanika, pogrążony w gęstej mgle.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410200
    m_Localized: W pobliżu odczuwasz pewną obecność.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410201
    m_Localized: Tak, widziałeś dziecko, ale to dotyczy czegoś innego.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410202
    m_Localized: Dusząca mgła dławi świat.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410203
    m_Localized: Pochłania każdy dźwięk.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410204
    m_Localized: Jej cisza spowija wszystko niczym płaszcz.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410205
    m_Localized: Zdaje się, że szepczą ludzie.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410206
    m_Localized: Wołasz, ale powietrze ani drgnie.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410207
    m_Localized: Czy może są orędownikami nieszczęścia?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410208
    m_Localized: Dziecko wierci się w ich ramionach.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410209
    m_Localized: Nie może już wnieść światła do tego świata. Takie masz przynajmniej wrażenie…
    m_Metadata:
      m_Items: []
  - m_Id: 206719410210
    m_Localized: Czy to nasze zbawienie, czy potępienie?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410211
    m_Localized: Ogarnia cię panika.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410212
    m_Localized: Ich trójka ciągnie dziecko w różnych kierunkach.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410213
    m_Localized: Podnosisz broń i strzelasz na oślep – gdzieś, gdziekolwiek.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410214
    m_Localized: O co chodzi? Dlaczego wszyscy są tak ubrani?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410215
    m_Localized: Z mgły wyłania się więcej postaci.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410216
    m_Localized: „Jesteś prorokiem, czy tego nie widzisz?” – mówi kobieta.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410217
    m_Localized: Jesteś zbawicielem.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410218
    m_Localized: Nikt nie jest gotów.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410219
    m_Localized: I zwiastujesz nadejście raju.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410220
    m_Localized: Twoje poświęcenie zbawi nas wszystkich!
    m_Metadata:
      m_Items: []
  - m_Id: 206719410221
    m_Localized: To jakieś szaleństwo.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410222
    m_Localized: Kto wie, co poczną z tobą?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410223
    m_Localized: Kątem oka pośród tłumu widzisz błysk gwoździ w czyjejś garści.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410224
    m_Localized: W tym mieście wydarzy się niedługo coś okropnego.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410225
    m_Localized: 'Gasmask: Witam pana uprzejmie.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410226
    m_Localized: 'Gasmask: Dostrzeżono pański wkład w wysiłki akcji medyczno-awaryjnych.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410227
    m_Localized: 'Gasmask: Potrzebujemy takich ludzi jak pan. Proszę do nas dołączyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410228
    m_Localized: Nie spodziewałem się tego
    m_Metadata:
      m_Items: []
  - m_Id: 206719410229
    m_Localized: Dlaczego ja?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410230
    m_Localized: 'Gasmask: Proszę się nie martwić, nie ma powodów do obaw. Oczywiście otrzyma pan sowite wynagrodzenie i pełny pakiet świadczeń.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410231
    m_Localized: 'Gasmask: Proszę się spakować. Idzie pan z nami.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410232
    m_Localized: Nie jestem zainteresowany
    m_Metadata:
      m_Items: []
  - m_Id: 206719410233
    m_Localized: Jestem gotów
    m_Metadata:
      m_Items: []
  - m_Id: 206719410234
    m_Localized: 'Gasmask: Ma pan głowę na karku i wychodzi z inicjatywą. Dokładnie tego potrzebujemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410235
    m_Localized: 'Gasmask: Rekruci często dostrzegają to, co sami możemy przeoczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410236
    m_Localized: 'Gasmask: A teraz potrzebujemy nowych ludzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410237
    m_Localized: Nie jestem zainteresowany
    m_Metadata:
      m_Items: []
  - m_Id: 206719410238
    m_Localized: Jestem gotów
    m_Metadata:
      m_Items: []
  - m_Id: 206719410239
    m_Localized: 'Gasmask: To nie była sugestia…'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410240
    m_Localized: 'Gasmask: Niech pan pakuje manatki i wsiada albo sami pana załadujemy do samochodu.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410241
    m_Localized: 'Gasmask: Wybór należy do pana.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410242
    m_Localized: 'Gasmask: Dobrze. Proszę wziąć tylko niezbędne rzeczy. Nocleg będzie zapewniony.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410243
    m_Localized: 'Gasmask: Nie będzie potrzeby tu wracać. Przynajmniej nie prędko.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410244
    m_Localized: 'Gasmask: Czekamy na pana.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410245
    m_Localized: Ogarnia cię skołowanie. Czy FEMA właśnie tak robi nabór do swoich szeregów?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410246
    m_Localized: To duża organizacja. Z pewnością będzie trzeba zadawać się z licznymi ludźmi.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410247
    m_Localized: Wygląda na to, że zmiany w pracy będą długie.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410248
    m_Localized: Tak właściwie, jak ryzykowna jest ta praca?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410249
    m_Localized: Łapanki i nabór w jednym? To takie dziwne.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410250
    m_Localized: Czy rotacja jest aż tak poważna? Po co inaczej rekrutować tak… agresywnie?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410251
    m_Localized: Eskortować ludzi do stref kwarantanny?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410252
    m_Localized: A potem co?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410253
    m_Localized: Ani co się stało z lokatorami.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410254
    m_Localized: Masz przeczucie, że nigdy już nie wrócisz do tamtego życia.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410255
    m_Localized: Po odprawach staje się jasne, że w tej pracy przeżywalność pracowników nie jest priorytetem.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410256
    m_Localized: Żałujesz tylko, że nie wziąłeś ze sobą swojego plakatu.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410257
    m_Localized: Za drzwiami słyszysz szaleńca wrzeszczącego w szewskiej pasji i kipiącego agresją.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410258
    m_Localized: Pozostaje ci tylko czekać z nadzieją, że nic się nie wydarzy.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410259
    m_Localized: Zaślepione furią spojrzenie uzbrojonego człowieka mrozi krew w żyłach bardziej niż jakikolwiek Przybysz.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410260
    m_Localized: Twoich uszu dochodzi jego płytkie dyszenie.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410261
    m_Localized: Skurwysyn. Trafił mnie…
    m_Metadata:
      m_Items: []
  - m_Id: 206719410262
    m_Localized: Myślałem, że… załatwi to wolniej, bo bez walki… się nie poddałem. Ale… co z… innymi?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410263
    m_Localized: Zamilkł… Musisz sprawdzić, czy on naprawdę…
    m_Metadata:
      m_Items: []
  - m_Id: 206719410264
    m_Localized: Przez takich bydlaków zginęło wiele osób.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410265
    m_Localized: Tobie podobni zabili mojego przyjaciela.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410266
    m_Localized: Tacy ludzie nigdy nie dają innym żyć w spokoju.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410267
    m_Localized: Co, myśleliście, że nikt wam się nie postawi?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410268
    m_Localized: Ci ludzie zatraceni w szaleństwie…
    m_Metadata:
      m_Items: []
  - m_Id: 206719410269
    m_Localized: Rozpierdolę was!
    m_Metadata:
      m_Items: []
  - m_Id: 206719410270
    m_Localized: Przepędzę was głęboko pod ziemię.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410271
    m_Localized: Wszystko zaleję waszą krwią.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410272
    m_Localized: Każdego uzbrojonego parszywca czeka dziś śmierć.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410273
    m_Localized: KAŻDEGO. JEDNEGO.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836555284480
    m_Localized: „Aktywność słońca maleje…
    m_Metadata:
      m_Items: []
  - m_Id: 11636836555284481
    m_Localized: …eksperci przewidują, że za kilka dni…
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478784
    m_Localized: Zaufanie gaśnie.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478785
    m_Localized: Czujesz na sobie spojrzenia innych.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478786
    m_Localized: Paraliżuje cię lęk przed śmiercią.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478787
    m_Localized: Nawet nie myślisz o ucieczce.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478788
    m_Localized: Zaślepia cię groza.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478789
    m_Localized: Rozrywają cię na strzępy.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478790
    m_Localized: Ciemność. Widzisz ciemność.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478791
    m_Localized: W myślach ukazuje ci się obraz niewielkiego, samotnego domu.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478792
    m_Localized: Opuszczają cię resztki sił…
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478793
    m_Localized: Raduję się, że dołączasz do nas, bracie. Zaiste, Śmierć nie wybrała cię na marne.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478794
    m_Localized: Strach przed Jej słowem i jego przeinaczenie powstrzymywało nas od Jej uścisku.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478795
    m_Localized: Lecz teraz kroczymy ścieżką dawnych wierzeń.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478796
    m_Localized: Ona ukoi nas wszystkich.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478797
    m_Localized: Nie zapomni o nikim.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478798
    m_Localized: Nawet sama Śmierć wzniesie się…
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478799
    m_Localized: Czujesz? Ona nadeszła…
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478800
    m_Localized: Musimy działać natychmiast.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478801
    m_Localized: Podążaj za mną, ukryję cię.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478802
    m_Localized: Zaprowadzę cię do miejsca, do którego należysz.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478803
    m_Localized: Ofiaruję ci spokój.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478804
    m_Localized: Który od zawsze był marzeniem ludzkości.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478805
    m_Localized: Twoim przeznaczeniem nigdy nie było przetrwanie w szaleństwie kosmosu.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478806
    m_Localized: Zachowam pamięć o tobie…
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478807
    m_Localized: 'Vigilante: Ty sukinsynu! Pierdolony Przybyszu, myślałeś, że zrobisz mnie w konia?!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478808
    m_Localized: 'Vigilante: Zdychaj, chuju!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478809
    m_Localized: 'Vigilante: Ja pierdolę, kurwa! Jesteś jebanym Przybyszem!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478810
    m_Localized: 'Vigilante: Żegnaj się z życiem, gnoju…'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478811
    m_Localized: 'Vigilante: Masz mnie za jakiegoś idiotę? Naprawdę myślałeś, że dam się zrobić w konia?'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478812
    m_Localized: 'Vigilante: Już nie żyjesz, mądraliński!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478813
    m_Localized: Ilu innych zamordował? Ilu spalił żywcem?
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062336
    m_Localized: Panuje tu całkowity bezruch.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062337
    m_Localized: Już nic ci tu nie wadzi.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062338
    m_Localized: Ale na to jest jeszcze czas…
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062339
    m_Localized: Mogą rosnąć bardzo szybko, gdy dzieje się źle.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062340
    m_Localized: I im okazalsze są grzyby…
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062341
    m_Localized: Kapeluszem mogłyby przykryć całą planetę.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256640
    m_Localized: Za mną! Żwawo!
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256641
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256642
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256643
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256644
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256645
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256646
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256647
    m_Localized: Umieranie jest przerażające.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256648
    m_Localized: Z samej trwogi można oszaleć.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256649
    m_Localized: Widzę, co wobec ciebie planują.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256650
    m_Localized: Nie powstrzymasz tego.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256651
    m_Localized: Wyrzucili cię na zewnątrz.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256652
    m_Localized: Nie pozostał nikt, kogo można by obwinić.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256653
    m_Localized: Coś zdaje się ciebie obserwować.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256654
    m_Localized: Czy napotkanie ich to dobry znak?
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256655
    m_Localized: Co się tu wyrabia?
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256656
    m_Localized: Nazywasz grzechy tego świata.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256657
    m_Localized: Dziecko doprowadziłoby nas do królestwa grozy.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256658
    m_Localized: Ale ty… przegonisz mrok.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256659
    m_Localized: Jej słowa szokują cię.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256660
    m_Localized: Cokolwiek mają na myśli, jedno jest pewne – dziecko nie żyje.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256661
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256662
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256663
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256664
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256665
    m_Localized: Ciężko powiedzieć, kiedy pozwolą ci wrócić do domu.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256666
    m_Localized: Nie jest jasne, czego będą wymagać.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256667
    m_Localized: Nie wiesz, co z twoim domem.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256668
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256669
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256670
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256671
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256672
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256673
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256674
    m_Localized: Teraz wszystko straciłem. Ale wy… wciąż macie coś, na czym wam zależy.
    m_Metadata:
      m_Items: []
  - m_Id: 1361586487812096
    m_Localized: Majątek, twórczość, myśli, wspomnienia, emocje.
    m_Metadata:
      m_Items: []
  - m_Id: 1361586487812097
    m_Localized: Przestajesz istnieć. Pozostaje tylko pustka.
    m_Metadata:
      m_Items: []
  - m_Id: 3948884693868544
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 3948884744200192
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 3948884744200193
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 3948884744200194
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195392
    m_Localized: Udało się.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195393
    m_Localized: Przeżyłem. Sam.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195394
    m_Localized: To było jedyne wyjście.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195395
    m_Localized: Zrobiłem wszystko tak, jak należy.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195397
    m_Localized: Ile dni minęło? Ile godzin?
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195399
    m_Localized: Gdyby ktoś został… czy coś by się zmieniło?
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195400
    m_Localized: Czy gdybym powiedział ojcu, jak bardzo go nienawidzę, czy zdobyłbym się na to, by odejść?
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195401
    m_Localized: Czy… ona byłaby dumna z moich poczynań?
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195402
    m_Localized: Mury zawaliły się. Jesteś w pułapce.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195403
    m_Localized: Ale może nie ma potrzeby nigdzie wychodzić. Może nie pozostało nic innego.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195404
    m_Localized: Szkoda jest żegnać się z tym światem, gotując się ze złości.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195405
    m_Localized: Na ojca. Na siebie samego. Na wszystkich.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195406
    m_Localized: Nikt nie podał matce pomocnej dłoni, gdy najbardziej tego potrzebowała.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195407
    m_Localized: Ręce wciąż mi drżą na myśl o wyjrzeniu przez to okno.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195408
    m_Localized: Moje mury runęły i leżę w gruzach.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195409
    m_Localized: Tak bardzo nie cierpiałem tego domu… może to dobrze, że go utraciłem.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195410
    m_Localized: Wszystko obróciło się w pył. Jednak czuję się przez to swobodniejszy.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195411
    m_Localized: Nie pozostało nic, co miałoby mi przypominać o moim dawnym życiu.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195412
    m_Localized: Chciałbym, aby ona mogła to zobaczyć…
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195413
    m_Localized: Dlaczego czuję się teraz tak lekko?
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195414
    m_Localized: Ja nie… ja… przygniatający mnie ciężar prysnął, skruszył się niczym mury.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195415
    m_Localized: Przepadł.
    m_Metadata:
      m_Items: []
  - m_Id: 38371868175048704
    m_Localized: Zrobiłem wszystko tak, jak należy…
    m_Metadata:
      m_Items: []
  - m_Id: 38371868175048705
    m_Localized: Przez niego targnęła się na siebie.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
