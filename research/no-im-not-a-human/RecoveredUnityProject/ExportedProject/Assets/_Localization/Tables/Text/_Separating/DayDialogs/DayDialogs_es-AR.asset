%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_es-AR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: es-AR
  m_SharedData: {fileID: 11400000, guid: 1bdb57fba89c5124a83ad717d0443512, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: Qué calor tan infernal...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: ¿Cómo te sientes?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: Parece que es mucho peor de lo que pensaba. Cof... Maldita sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: No creo que aguante más de una semana.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: Aunque me sentí un poco mejor cuando me dejaste entrar. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: Pero... estoy aquí sentado mientras el resto de los chicos están muriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: Podría haber estado con ellos. De todas formas, no tengo nada que perder. Igual me voy a morir...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: Qué calor tan infernal...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: ¿Por qué no has vuelto a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: Tengo a mis hijos en casa. Y no... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: No quiero que me tengan miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: Y no... cof... no quiero que me recuerden así.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Que piensen que morí en el bosque, mientras... cof... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: Mientras apagaba incendios.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: Cof... que me recuerden por lo mucho que aguanté y por lo mucho que trabajé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: Qué calor tan infernal...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: ¿Dónde está tu uniforme?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: Los jefes se lo llevaron. Cof... Ni siquiera tenemos suficiente equipo ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: Mucha gente... cof... está muriendo en el trabajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: No nos da tiempo ni para sacar a nuestros compañeros. El fuego... cof... al final acaba con todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: Y a los jefes... les preocupa más... cof... un puto uniforme...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: Se inventan un decreto tras otro como eslabones en una cadena y ninguno termina beneficiando a la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: Qué calor tan infernal...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: ¿De dónde vinieron los incendios forestales?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: El bosque ha estado especialmente seco últimamente. Por eso... cof... se incendia fácilmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: Los incendios son solo... cof... una de las desgracias que estamos viviendo, como esos Visitantes de las profundidades.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: Pero el destino aún tiene más guardado para nosotros...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: Quizás una muerte pacífica ahora sea el mejor resultado para esta causa perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: Sabes... cof... pensaba llevar esto como regalo a casa. Pero mejor te lo daré a ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: Este collar, no es mucho, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: Está hecho de abejas muertas que alguna vez convirtieron la miel en Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: Qué calor tan infernal...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: Te ves horrible
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: Creo... creo que me llegó la hora... cof... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: ¿Por qué no me quedé allí? Pude haber salvado a algunos de los chicos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: Pude haberme quedado... y trabajar hasta desmayarme. Así no habrían tenido que mandar a esos jóvenes al matadero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: ¡MALDITOS JEFES! ¡COF... COF...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: Todo es tan... triste.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: ¿Me das un último cigarro?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: Toma un cigarrillo (Darle un cigarrillo)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: ¿No tendrás un cigarrillo por ahí, de casualidad?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: Nop, lo siento (No darle un cigarrillo)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: La cereza sobre el pastel, como quien dice. Cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (El hombre saca un encendedor del bolsillo, prende el cigarrillo y comienza a fumar)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (Da una bocanada larga y se recuesta contra la pared. Después de una breve pausa, continúa)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: Ojalá pudiera estar con los muchachos una vez más. Fumando, hablando de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: COF... COF... COF... COF...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: ¿No fumas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: Ya sé, ya sé. "¿Un bombero fumando?" Cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: A estas alturas, qué importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: Solo quería... cof... relajarme un poco antes de morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (El hombre se apoya contra la pared, mirando hacia el techo mientras habla)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: ¿Cómo fue que terminé siendo bombero...? Mi mamá me dijo que fuera a trabajar a una fábrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: No está bien que un bombero esté fuman—'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: ¡COF... COF...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: Vagando libre, ojalá pudiera estar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: ¿A quién buscas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: Pues, mira, tengo a este amigo. Nos conocemos desde que éramos niños.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: Tuvo un accidente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: Lo contrataron para extraer algo en las montañas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: No sé en qué estaría metido. Y me da lo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: Pero ENTONCES se lastimó la espalda, ¡y estuvo días sin poder moverse!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: Trabajó tanto en las montañas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: Que las gaviotas confundieron su... jaja... sus nalgas... eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: Ah, fue su trasero. ¡Confundieron su trasero CON UN NIDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: ¡JAJAJAJAJA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: Perdón, son solo las voces en mi cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: Me contaron un chiste muy gracioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: Vagando libre, ojalá pudiera estar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Uh... ¿todo bien?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: Sí. Solo estoy esperando a que me vuelvan a crecer las piernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: Mire, la derecha ya empezó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: Así que me quedaré aquí un rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: Me refería a las voces en tu cabeza
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: Está bien...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: ¿No entendiste? ¡Era un chiste!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: Pensé que lo habías entendido en el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: Supongo que no fue gracioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: ¿Me acabas de preguntar cómo estoy?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: ¡Gracias, qué amable!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: Nadie nunca me pregunta cómo me siento o cómo estuvo mi día.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: ¿Será porque en lugar de piernas tengo estas increíbles ruedas de carreras? ¿Acaso están CELOSOS?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: Nadie contesta a eso con honestidad. Ese es el problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: Solo empiezan a poner excusas de que simplemente estaban echando una miradita rápida a mis piernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: Aunque es igual de malo cuando solo se quedan mirando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: Pero ignorar mi discapacidad es estúpido. O sea, está ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: Lo que digo es que tiene que haber un equilibrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: Pero claro que no hay equilibrio en la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: ¿Alguna vez te has puesto a pensar en cómo caminarías si tuvieras unas ruedas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: Mierda, eso no es lo que quería decir...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: Si no tuvieses... piernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: ¡EXACTO! ¡Ni siquiera podrías salir de casa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: ¿Cómo usaría las escaleras? ¿O cruzaría la calle?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: Estas malditas aceras están todas disparejas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: Tu casa no tiene escaleras ni escalones, me puedo mover sin problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: ¿Sabes? Solo hay una cosa que desearía...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: ¡Que tu casa estuviera inclinada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: Sería divertidísimo rodar en ella con la silla de ruedas. Y chocarme contra todas las paredes y todo eso... ¡JAJA! Como sea...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: ¡Hombre, me encantan las carreras! Pero no tienes forma de practicarlas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: Ah, espera, me habías preguntado cómo estoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: Nada mal. Gracias por preguntar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: Vagando libre, ojalá pudiera estar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: ¿Tienes insolación?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: ¿Y eso qué tiene que ver?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: No se me ha quemado ni se me ha caído el pelo. Así que todo bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: No puedo correr en una silla de ruedas sin piernas. ¿Ve?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: Si no tengo piernas, ¿cómo iba a frenar a gran velocidad? ¿O tomar una curva?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: No tienes silla de ruedas, así que, ¿cómo podrías entenderlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: ¿En serio crees eso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: ¿Por qué crees que te van a volver a crecer las piernas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: ¡Por supuesto!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: Ya sabes cómo es el dicho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: La pierna derecha da pasos más largos. Por eso siempre andamos dando vueltas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: Mire, mi pierna es la prueba.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: Es todo lo mismo y no hay forma de salir del ciclo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: Este día se acaba hoy, mañana empezará otro. ¿Pero habrá un nuevo día?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: Al diablo. Da lo mismo. Yo solo vivo en el ciclo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: Así que, si lo piensas bien, ¿de verdad eres tan distinto a mí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: ¿Acaso no estás dando vueltas también?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: Mire, vivimos en un mundo de sorpresas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: Sorpresas terribles, por ahora. ¡PERO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: Las terribles sorpresas van a terminar en algún momento. Y luego van a empezar las buenas, las felices.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: Dios ya perdonó un montón de pecadores. Quizás a nosotros nos toque algo mejor también, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: Vagando libre, ojalá pudiera estar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: ¿Cómo fue que perdiste las piernas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: ¿Recuerdas a mi amigo en las montañas del que te hablé?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: Pues... se le ocurrió hacer una excavación en su patio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: Se le metió la idea de que un túnel lleno de carne pasaba por debajo de su casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: Encargó un taladro manual o algo así.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: Y se puso a excavar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: Diablos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: Seguramente esa fue la última vez que lo vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: Vagando libre, ojalá pudiera estar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: ¿Y qué hay de tus piernas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: Al diablo lo de las piernas. Quisiera saber si excavó hasta donde quería llegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: Está bien, olvídalo
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: Sí, eso es. Justo después, me fui a tomar una cerveza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: Me caí y un bus me cortó las piernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: O espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: No, eso no fue lo que pasó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: ¿Por qué no dices nada? ¿No te parece interesante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: Bueno, no me molestaré en contártelo. ¿Para qué las molestias?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: Que calor hace aquí...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: ¿No tenías una niña contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: ¿Qué? Sigue aquí conmigo. Seguro está explorando por ahí o algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: Necesito saber dónde se metieron los demás y si están bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: ¿Tienes un celular o algo? A ver si llamo a su papá, así no tengo que verle la cara otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: Que calor hace aquí...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: ¿Y bien? ¿Llamaste a tu esposo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: ¿Para qué? Solo me diría cualquiera excusa. Nunca movió un dedo. Todo fui yo: los hijos, la casa, la plata.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: A veces pienso que él solo me toleraba y yo lo toleraba a él. Pero no me dejó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: Quizás porque le resultaba conveniente tenerme cerca. O solo tenía miedo de que le hiciera algo malo si siquiera llegaba a intentarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: Dios, qué cansancio tengo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: Que calor hace aquí...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: ¿Fuiste a ver a tu esposo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: ¿Qué? Apenas y me puedo levantar. Me duele todo y estoy reventada. A veces, creo que solo sigo viva por puro rencor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Todo era yo: los niños, mi esposo y toda la bendita casa. Pero a veces, él ponía de su parte y era tolerable.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: ¿Podemos hablar después? Estoy que me muero y si no descanso, me voy a desmayar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: Que calor hace aquí...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: ¿Qué tipo de cosas hacía?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: Bueno, hubo una vez que...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: Resulta que solía meter a una mujerzuela en el auto. Yo lo sabía todo. Al principio lo toleré, pero luego le di lata todos los días.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: Le acusé de engañarme. Terminó cambiando de trabajo para no verla más... Capaz sí me amaba de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: Capaz solo me estaba imaginando cosas... Como sea, necesito descansar. Hablamos luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: Que calor hace aquí...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: ¿No te preocupan tus hijos?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Sí... Pero probablemente no tanto como debería. Con el primer niño... No tenía idea de lo que hacía. Lo arruiné todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: Creí que había corregido mis errores con el segundo. Pero resultó igual. Luego el tercero, y el cuarto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: Los médicos decían que no iba a poder tener hijos, ¡pero cuando nació el segundo fue la octava maravilla del mundo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: Pero luego... se volvió difícil... Fue horrible...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: Yo... Necesito descansar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: Que calor hace aquí...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: ¿En qué fue horrible?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: Me cuesta hablar de eso... Los quiero, pero... A veces perdía la paciencia. Gritaba, hasta llegué a levantarles la mano...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: Sé que eso es horrible. Me arrepiento muchísimo... Pero, ¿sabes? Por primera vez... me siento tranquila.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: No están aquí y... al fin puedo respirar... Odio admitirlo, pero por primera vez me siento... feliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Maldita sea...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: ¿Y bien? ¿Ya te tranquilizaste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Sí, me tranquilizo rápido. Pero apenas recuerdo algo que me molesta, vuelvo a perder la paciencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: Antes era más relajado. Era difícil ofenderme o sacarme de mis casillas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Ahora solo se necesita una pequeña chispa y se desata el mismísimo infierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: ¿Y por qué demonios debería estar tranquilo? Quizás mi rabia me ayuda a mantener la cordura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: Por lo menos yo no adoro al dichoso sol como algunos imbéciles de mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: ¿Cómo carajo pueden pensar que el sol nos está salvando? ¡Sí, cómo no! ¡QUE NOS ESTÁ MATANDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: Todo apunta a que no falta nada para vernos en el más allá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: ¿Y estos imbéciles no se dan cuenta? Nooo, ni de verga... Bueno, ya. Estoy bien, no pasa nada... Ya me calmé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Gracias por escucharme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Maldita sea...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: ¿De dónde viene toda esta ira?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Ni yo mismo lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Todo lo que está pasando me molesta muchísimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: Y los sectarios, esos malditos farsantes. Seguro les gustaría engañar a más gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: Y la gente les va a creer, carajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: La gente está dispuesta a quitarles las últimas migajas a sus propios hijos con tal de pagar un tributo al culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: Para contentar a su asqueroso salvador del inframundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Unos malditos lunáticos. Incluso les lavan el cerebro a gente normal con sus delirios... como hicieron con mi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: Bueno, ahora estoy bastante tranquilo. Me siento mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Maldita sea...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: ¿Los del culto te quitaron a alguien?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: No, ese es el punto. Ella se fue con ellos por su propia cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: Mi mujer...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Antes de toda esta mierda, era muy religiosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: Pero yo la amaba e hice las paces con eso. Nunca se interpuso en nuestra relación.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: Cuando todo se fue al carajo, encontró una nueva fe en un nuevo salvador.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: La jodida palabrería de los sectarios le pareció lógica.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: Se volvía más loca cada día, creyendo cosas que yo no podía entender.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: Cuando me di cuenta de mi error, ella... ya se había ido, con miedo. Era demasiado tarde para arreglarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Maldita sea...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: ¿Qué pasó entre tu esposa y tú?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: Un día, mi mujer me dijo que se uniría al culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: Yo... solo no podía creerlo. La mujer que amaba... Se había convertido en una persona totalmente distinta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: Nuestro amor ya no significaba algo para ella. Estaba furioso, más furioso de lo que jamás había estado en mi vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: Empecé a pensar que nunca me había amado y que solo había estado buscando una manera de irse a la mierda. Me dio asco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: Sin darme cuenta, cerré las manos en puños e hice algo que nunca me voy a perdonar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: Le pegué...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: Ya no hay vuelta atrás. Ella está en el culto y yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: Nunca podré hacer las paces con lo que pasó...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: ¡MALDICIÓN, ME ODIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: Prefiero lastimarme a mí mismo en vez de a los demás. Me lo merezco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Vete. Necesito estar solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: ¿Quieres una lectura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: ¿Por qué sabes tanto sobre mí?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: ¡Já! Qué gracioso eres... No soy yo quien lo sabe. Los astros hablan a través de mí, así de simple.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: Tu luna está en Venus en tu Sexta Casa. Se te nota en la cara, ¿ves? Por muy calladito que seas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: Una vez conocí a alguien como tú. Siempre escuchaba sin decir ni una palabra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: Ya sabes el dicho: Si Júpiter te cae en la Octava Casa, mejor estar calladito. Significa que las puertas están cerradas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: ¿Quieres una lectura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: ¿Qué le pasó a esa persona?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: Le dije: "Da igual lo que hagas. Lo que cuenta es lo que irradia tu aura mientras lo haces". Nunca confió en mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: Y así, la vida lo pasó por alto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: Un día, cerré los ojos y soñé despierta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: Puse toda mi fuerza en esa imagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: Si no abres tu ser a la energía, ¿qué sentido tiene vivir en este cuerpo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: Tú podrías hacer lo mismo. Cierra los ojos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: Imagina que ya alcanzaste tu meta...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Visualízalo bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: ¿Sabes por qué sufres? Porque aún no entiendes que el sufrimiento es la forma más alta de felicidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: Así que... ¿Estás listo para dar ese salto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: ¿Quieres una lectura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: ¿Qué quieres decir con "listo"?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: Significa elegirte a ti mismo. ¿Hueles eso? Es el aroma de tus anhelos sin cumplir. Ya va siendo hora de soltarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: Cuando estuve en mi punto más bajo, sin luz ni sentido, mi mentora me dijo una cosa: "No estás escuchando a tu océano".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: Primero me reí. ¡¿El océano?! Pero luego cerré los ojos y lo oí. Como si siempre hubiera estado ahí. ¡Tú también puedes escucharlo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: Pero lo más importante es preguntarte, ¿estás listo para convertirte en uno contigo mismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: ¿Quieres una lectura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: ¿Quién fue tu mentora?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: Una gran mujer. Era como un faro durante una tormenta. Me enseñó a percibir la esencia de las cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: Nunca olvidaré sus palabras: "La gente muere solo porque no aprende a dejar respirar su luz interior".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: Ella me hizo entender yo podía ayudar a la gente a encontrar su camino único.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: Pero, bueno, ella tenía miedo de ir más allá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: Ella no se veía en el centro. Y es importante estar en el centro, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: Si tú no eres el centro de tu universo, ¿quién eres? ¿Sí me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: ¿Quieres una lectura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: ¿Cómo eso te ayudó?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: Todos tus errores son solo códigos en tu universo que aún no has descifrado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: Recorrí un largo camino. Mira alrededor y mira hacia atrás. ¿Ves cómo es esta casa ahora, sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Luminosa, amplia y en sintonía con mi energía. No es necesario intentar pelear contra tu propia casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: Ya absorbió tu miedo. Acéptalo, o las paredes comenzarán a llorar tus propias lágrimas. ¿Me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: ¿Quieres una lectura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: ¿Qué quieres de mí?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Ay, querido, ¿en serio crees que quiero algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: Entenderías dónde se esconde tu camino si tan solo pudieses ver el baile de tu sombra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: Solo necesitas recitar afirmaciones para ser feliz. Sientes que todo está cambiando, ¿verdad? Que es más fácil respirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: Esa es mi energía uniéndose a tu espacio vital. No le busques sentido. Es un espejismo para los temen aceptar el caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: Te pido que formes parte de ese espacio. Di: "No soy un mero invitado aquí, soy el autor de este santuario."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: ¿Quieres una lectura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: ¿Y si no quiero ser un "autor"?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: Tus paredes hace tiempo que quieren abrazarte, pero tú las confinas a las cadenas de tu control.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: El silencio en tu interior es la voz del mundo que estás ahogando con tu miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: Tu energía se atasca como la miel en invierno. Tienes que descongelarla con tu aliento. Y los espejos no mienten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: Si todo lo que ves es a ti mismo, no ves nada en absoluto. Solo tienes que mover tu energía tres grados a la derecha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: Y por fin serás feliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: Estoy escuchando, humano. ¡Habla de una vez!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: ¿Eres miembro de algún tipo de credo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: ¡SÍ, HUMANO! Pero mi fe no es como las religiones que tú conoces.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: ¡Yo rindo culto al SANTO SOL EN PERSONA! ¡PORQUE ÉL NOS PROTEGE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: Pero la gente estúpida solo ve cosas malas en él. Creen que nos incinerará a todos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: ¡TONTERÍAS! ¡Su ira está dirigida a las semillas del mal y a los herejes! Porque ellos son pecadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: ¡Y ojalá que aquellos que estén en desacuerdo nunca se vean bajo su brazo ardiente de la justicia!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: Buscan problemas y se sorprenden al ser quemados.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: ¿Semillas del mal?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: ¿Herejes?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: ¿Todavía preguntas? ¿¡Nunca tuviste un encuentro cara a cara con ALIENÍGENAS?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Muy bien, humano. Le diré la VERDAD.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: ¡¡¡LOS VISITANTES SON SEMILLAS DEL MAL!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: ¡¡¡SON DESCENDIENTES DE ALIENÍGENAS que aterrizaron en la Tierra cuando el Sol era más joven y la hierba más verde!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: ¡¡¡MALDITOS VASALLOS que hicieron sus hogares en la Tierra y se cruzaron entre sí por SIGLOS!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: ¡Y ahora, han salido y quieren tomar NUESTRAS TIERRAS COMO SI FUERAN SUYAS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: Pero el SOL decidió protegernos, porque ES NUESTRA TIERRA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: ¡El Sol NO TIENE PIEDAD con los Visitantes! ¿Si no, por qué se habrían escondido bajo tierra tanto tiempo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Maldita sea... ¿Por qué se emborrachó tanto esa noche...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: No hacía falta beber hasta el olvido. La ira justa del Santo Sol, él...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: SANTO SOL, perdónalo por nuestros pecados, ¡ya que solo es un ignorante!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Recíbelo en tu abrazo amoroso. Y quizá el alma del ficus, al que ya no podrá regar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Amén.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: ¡Escuchaste bien, humano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: ¡Los de la AFAE son unos MALDITOS HEREJES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: ¡Interfieren en procesos que van más allá de NUESTRO control! ¡El control de la GENTE NORMAL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: Meten sus narices donde no deben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: ¡Que el Sol maldiga a esos idiotas que tiraron a mi madre a un charco!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: Estoy escuchando, humano. ¡Habla de una vez!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: Bueno, por alguna razón, el sol ha quemado a mucha gente últimamente
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: ¡Así es, humano! ¡A todas las semillas de maldad!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: ¡El Sol decidió castigarlos A TODOS por los pecados que la gente ha cometido durante MIL AÑOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: ¡Y LOS VISITANTES, esos malditos estúpidos, han empezado a alzarse por el SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: ¡Pero el SOL no es para ellos, los subterráneos, sino para nosotros, para los HUMANOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: ¡ES NUESTRO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: ¡ES UNA BENDICIÓN PARA LA HUMANIDAD, MALDITA SEA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: ¿Y cuántos tienen que arder para que el sol se calme?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: ¿Estás diciendo que el fin del mundo es la justicia del sol?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Muchos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: Y créame, amigo mío, ESTÁ LEJOS DE TERMINAR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: ¡ESTO APENAS ESTÁ COMENZANDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: ¡La BALANZA aún no está lo suficientemente llena para contrarrestar las FUERZAS DEL UNIVERSO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: ¡MÁS DEBEN ARDER en las llamas justas del SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: Pero tenga presente esto, amigo mío: ¡estas víctimas no morirán en vano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Algún día, todos entenderemos el verdadero plan del Sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Hombre, a veces de noche, me pongo muy triste de que mi esposa me dejara...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: Era una mujer santa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: Pero también una perra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: ¿El fin para quién?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: ¿Para nosotros?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: ¡Já!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: No me hagas reír. ¡EL SOL ESTÁ DE NUESTRO LADO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: ¿No ves que es nuestro salvador?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: Está tratando de regresar a los Visitantes a las profundidades de la tierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: Está castigando a las peores personas por los pecados de la humanidad...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: ¡Revela a los herejes que se esconden vergonzosamente tras sus máscaras, en sus trapos orinados!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: Debemos dar gracias al Sol, no empezar a quejarnos del fin del mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: ¡ES EL FIN PARA TODOS LOS ENEMIGOS DEL SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: ¡QUE MUERAN LOS SUBTERRÁNEOS! ¡QUE SE EXTINGAN LOS HEREJES DE MIERDA! ¡Y QUE ARDA LA SEMILLA DEL MAL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: ¡Dios mío, cuánto tiempo sin probar unas papas fritas...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: Estoy escuchando, humano. ¡Habla de una vez!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: ¿Crees que lo que está pasando tiene algún significado sagrado?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Humano, dime... ¿Para qué te expliqué esto con lujo de detalles, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: ¡¿Para que vengas a hacerme EXACTAMENTE LA MISMA PREGUNTA?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: Parece que me equivoqué contigo, humano. No entiendes las verdaderas razones de lo que está pasando en absoluto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Carajo, ojalá tuviera una cerveza fría...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: ¿Te importaría invitarme una, humano?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: Claro, ten (Darle una cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: ¿No tienes cerveza, humano? ¡Estás bien mal de la cabeza!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: ¡¡¡Vi dentro de la nevera CON MIS PROPIOS OJOS!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: ¡Vamos, humano! ¡Se bebe toda esa cerveza y ni siquiera puede COMPARTIR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: No (No darle una cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ahh, gracias al Sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Mmm, qué rica. Está oscura como me gusta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Me recuerda a cuando salía a los bares con mis amigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: Conversaciones geniales, pintas frías, palitos de pan y salsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: Y la cara seria de un flacucho que siempre nos miraba con desaprobación...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Bueno, no hay por qué molestarse. Puede que seas un humano estúpido, pero al menos es amable.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Déjame darte un pequeño regalo de agradecimiento. Toma esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: ¡Que el Santo Sol salve tu alma!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: ¡DESGRACIADO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: ¡QUE TE PUDRAS EN EL INFIERNO, HIJO DE PERRA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: ¡La ingratitud! Te expliqué los significados sagrados, la trascendencia, y...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: ¡Eres un HUMANO MALVADO Y ESTÚPIDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Vete al carajo. ¡Quédate encerrado en tu maldito cuchitril de mierda! Encontraré un lugar mejor que este.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: Ya verás, me dejarán volver al bar. Estoy seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Que tengas una buena estadía, idiota.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: Je... je... Ojalá todo esto termine pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: ¿Cómo fue que perdiste tu hogar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Ahh... Recuerdo bien ese día.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: Me despidieron y solo quise regresar a mi casa, meterme en la cama y ponerme a llorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: Llegué allí y vi un montón de botas en el pasillo. Pensé que mi compañera de piso tendría amigos o familiares de visita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: Fui a su cuarto para saber qué hacía. Al acercarme a la puerta, escuché un sonido raro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: Me puso algo nerviosa, así que decidí mirar en silencio para ver qué pasaba ahí adentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: Solo alcancé a ver a mi compañera tendida e inmóvil en la cama cuando de repente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Un tipo desaliñado me agarró por la espalda y me dijo: "No puedes pasar. Ella... no se siente bien."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: "Mejor vamos a sentarnos en la cocina". Luego me jaló del brazo y me sentó a la mesa de la cocina.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: Quería irme, pero el miedo me tenía paralizada... Y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: Yo... Él...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: Necesito descansar. Yo... uh... el estómago me da vueltas de la ansiedad. Ugh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: Je... je... Ojalá todo esto termine pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: ¿Y qué pasó después en tu casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Ugh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: Después de que el hombre me sentara en la mesa, un tipo enorme que estaba escondido en una esquina bloqueó la salida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: Se puso a hablar en voz alta con el tipo que me había agarrado del brazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: Todo... Todo como si yo no estuviera ahí. Y entonces, me... ¡comenzaron a tocarme!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: Primero mis brazos, luego mis hombros...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: Y de fondo, oí vítores y una fuerte risa que parecía venir de mi cuarto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: Sonaba como si hubiera una multitud de hombres ahí dentro. ¡Jajaja...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: Um... co-comencé a tener problemas para respirar. Sentía como si el corazón se me fuera a salir del pecho...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: Quería gritar y pedir ayuda, pero mi voz... No podía hacer ningún tipo de ruido por el miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: Me quedé sentada allí, inútil como un osito de peluche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: Pero cuando el grandote fue a la nevera a buscar algo, me di cuenta de que esa era mi oportunidad...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: Salí corriendo hacia la salida. Fue como si el miedo me diera fuerzas. Y corrí, sin mirar atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: Hasta que me quedé sin fuerzas y me desmayé en el suelo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: ¿Cómo es que no te quemaste con el sol?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: ¿Y entonces qué pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: No me acuerdo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: Debí pasar toda la noche allí, tirada y después...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: Qué raro... Pensé que me acordaba de todo lo que me pasó...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Espera, no creerás que yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: Que yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: Podría ser una Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: No, eso no puede ser cierto. Recuerdo mi vida. Mi infancia, a mi mamá y a mi papá. ¡No!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: No soy una Visitante, ¿verdad? ¡Dime que no soy una Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: No sé
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: No eres una Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: Pareces una Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: Estaba tirada en el suelo, y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: Estaba segura de recordar lo que pasó...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Espera, no creerás que yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: Que yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: Podría ser una Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: No, eso no puede ser cierto. Recuerdo mi vida. Mi infancia, a mi mamá y a mi papá. ¡No!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: No soy una Visitante, ¿verdad? ¡Dime que no soy una Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: No sé
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: No eres una Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: Pareces una Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: ¡¿POR QUÉ DIRÍAS ESO?! Ay, Dios, ay, Dios, ay, Dios, ¡AY DIOS MÍO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: Necesito... necesito acostarme. Siento que se me está revolviendo el estómago otra vez. Ugh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Gracias, eso me tranquiliza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Ugh, necesito acostarme. Siento que se me está revolviendo el estómago otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: ¡¿POR QUÉ DIRÍAS ESO?! ¡Ahora estoy mucho más asustada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: ¡NO QUIERO MORIR! ¡NO QUIERO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: Todos vamos a morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: Je... je... Ojalá todo esto termine pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: ¿Te encuentras bien?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: ¡NO TE ACERQUES MÁS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Perdón, es que... pensé que ibas a asesinarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: ¿Por qué piensas eso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: Si quisiera matarte, ya estarías muerta hace mucho tiempo
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: Yo ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: No tengo idea de quién es un Visitante y quién no... ¿Y si...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: ¿Y si tú eres un Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: ¿Me vas a matar? ¿A despellejar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: ¡POR FAVOR, NO! SOLO MÁTAME RÁPIDO Y SIN DOLOR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: NO QUIERO MORIR AGONIZANDO. ¡POR FAVOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Tranquila, no soy un Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: No voy a matarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: Disculpa, es que estoy muy nerviosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: No tengo ni idea de en quién puedo confiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: ¿Y si...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: ¿Y si tú eres un Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: ¿Me vas a matar? ¿A despellejar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: ¡POR FAVOR, NO! SOLO MÁTAME RÁPIDO Y SIN DOLOR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: NO QUIERO MORIR AGONIZANDO. ¡POR FAVOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Tranquila, no soy un Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: No voy a matarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: ¡¿CÓMO VOY A SABER ESO?! No te he revisado los dientes ni los ojos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: Todos vamos a morir. Ya sea por los Visitantes o por el Sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: No queda ninguna esperanza. La muerte está llegando, no importa qué hagamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: Déjame sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: ¡¿CÓMO VOY A SABER ESO?! No te he revisado los dientes ni los ojos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: Todos vamos a morir. Ya sea por los Visitantes o por el Sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: No queda ninguna esperanza. La muerte está llegando, no importa qué hagamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: Déjame sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: Je... je... Ojalá todo esto termine pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: ¿Qué te pasa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: ¡LOS VISITANTES! ¡VIENEN POR NOSOTROS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: ¿No lo escuchas? LA MUERTE NOS ESTÁ LLAMANDO.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: ¡¿VISITANTE, HUMANO...? ¡¿CUÁL ES LA DIFERENCIA?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: ANTE LA MUERTE SOMOS LO MISMO.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: ¿Entonces por qué torturarnos esperando? ¡QUE VENGAN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: ¡QUIEREN LO MEJOR PARA NOSOTROS! ¡QUE VENGAN LOS VISITANTES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: No te ves bien...
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: ¿Te has vuelto loca?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: ¡NO, SIMPLEMENTE VI LA LUZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: ¡SOY UNA VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: NOSOTROS Y LOS HUMANOS SOMOS UNO. ¡SOMOS TAN SIMILARES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: ¡SOMOS COMO REFLEJOS EN UN ESPEJO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: ¡ACEPTA LA MUERTE JUNTO CON NOSOTROS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: ¿Sabes que te escuchas como una loca?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: No me dejas otra opción
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: ¡NO ESTOY LOCA, VI LA LUZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: ¡SOY UNA VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: NOSOTROS Y LOS HUMANOS SOMOS UNO. ¡SOMOS TAN SIMILARES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: ¡SOMOS COMO REFLEJOS EN UN ESPEJO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: ¡ACEPTA LA MUERTE CON NOSOTROS! ¡LLEGARÁ PRONTO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: ¿Sabes que te escuchas como una loca?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: No me dejas otra opción
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: ¡No, no entiendes nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: ¡La muerte viene! EL SOL ANUNCIA LA LLEGADA DE LA MUERTE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: La encontraremos pronto. Muy pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: Dejarla tranquila
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: ¡Pues dispara entonces! ¡¿Qué esperas?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: ¿VAS A MATAR SIN EL MÁS MÍNIMO REMORDIMIENTO?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: Me da igual. HAZ LO QUE TENGAS QUE HACER, HUMANO.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: Dejarla tranquila
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: ¿Ah? ¿Querías algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Así que, ¿por qué te echaron del bar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: Porque la serie de catástrofes hizo que todo el mundo se volviera loco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: Que si la explosión del sol, que si los Visitantes, que si la crisis económica y así siempre es una cosa tras otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: A todos nos jodió. O sea, a algunos les dio estrés, a otros les dio por el alcohol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: Bueno... a mí casi que me explotan las venas de la rabia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: Me monté en una mesa del bar y grité: "Dejen de culpar a toda la mierda que los rodea. ¡Un poco de humanidad, carajo!".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: Y que lloren, no me importa. Las lágrimas en la cerveza no arruinan el trago. Es más, la sal le sienta bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: ¿Igual a quién le importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: ¿Ah? ¿Querías algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: ¿Crees que aquí es diferente?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: Ya no molesto a nadie. No vale la pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: Es que, si uno oye la televisión o se pone a escuchar conversaciones y te vuelves a irritar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: Y entonces te preguntas: "¿De verdad necesito esto?"'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: No, mi buen hombre, ya estoy que me da un infarto de los nervios.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: La vida ya era bastante jodida sin todo esto y ahora...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: Podría solo gritarle al mundo entero desde lo alto de un edificio y ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: ¿Ah? ¿Querías algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: ¿Todo bien?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: ¿Ah? ¿Por qué preguntas eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: ¿A qué hueles?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: ¿Tienes fiebre?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: Bueno... agarré una que otra de tus cervezas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: Me sentía mal y me automediqué. Por eso decidí beber un poco. No es un delito ni nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: Todo es una puta mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Todos dicen que están arreglando cosas, pero están diciendo pendejadas; nunca pasa nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: ¿Sabes? Creo que igual todos nos vamos a morir pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: Si el sol no nos mata, lo harán los Visitantes. Y si acabamos con los Visitantes, seguro vamos a terminar enterrándonos entre nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: Porque si no tenemos suficientes malditos problemas, nosotros mismos agarramos y nos los inventamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Como si no pudiéramos vivir sin cagarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Mierda'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Vete, que me siento mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: No soy yo quien tiene fiebre. Es todo el puto planeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Por donde mires, alguien se está muriendo. O los glaciares se derriten. O los bosques se queman. El mundo tiene fiebre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: La Tierra intenta sacudirnos como si fuéramos pulgas llenas de sangre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: Algún día, lo conseguirá. Y no creas que será indoloro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: ¡Urghh...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Vete, carajo. Por favor. No me siento bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: ¿Ah? ¿Querías algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: ¿Te sientes algo mejor?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: Mi buen amigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: Todos vamos a morir algún día. Es inevitable.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: ¿Alguna vez te has preguntado qué va a pasarnos cuando nos muramos?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: Pues, creo que será lo que tenga que ser
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: Nada
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: No sé... tal vez terminemos flotando en el espacio
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: Hay algo de cierto en eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: Pero no me hace sentir ni una maldita pizca mejor. ¿Sabes por qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: Cuando me esté muriendo, mi cerebro lo va a entender y me va a empezar a mostrar algo a lo que sería lindo volver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: Y cuando mi energía para ese sueño se desvanezca, ¿entonces qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: No. La verdad es que nada de esto me hace sentir mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: De verdad estaba esperando que dijeras otra cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: Podría tener razón, por supuesto. Pero eso es espantoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: ¿Que no exista absolutamente nada...? Solo... ¿oscuridad?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: Ahora mismo no tengo muchas ganas de hablar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: Si lo piensas bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: En el espacio no existe nada más que nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: No hay otras formas de vida. Solo está el espacio frío y vacío.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: Si la existiera, probablemente ya habríamos encontrado alguna señal o algo así. Quién sabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: El espacio es un vacío de oscuridad sin fin. Si terminamos ahí después de la muerte, será como desaparecer...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: Quiero... quiero estar solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: ¿Ah? ¿Querías algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: ¿Estás... Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: Al menos el bar tenía techos altos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: Uno podría ahorcarse ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: Aquí dentro me siento claustrofóbico. Todo este bendito planeta es muy pequeño para mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: Mi buen amigo, solo quiero que todo esto termine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: Todo es un maldito caos. Todo me aterra horriblemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: Simplemente ya no puedo soportarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: ¿Para qué vine aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: Me gustaría descansar un poco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: ¿Necesitas algo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: Que él estuviera vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: Eso es todo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: Es todo lo que necesito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: ¿Puedo ofrecerte algo de agua?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: ¿Te gustaría algo de comer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: Solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: Me sentaré aquí junto al grifo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: Beberé si lo necesito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: Entonces te dejo tranquila
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: ¿Me puedo sentar contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: No tengo hambre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: Solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: Solo quiero sentarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: Entonces te dejo tranquila
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: ¿Me puedo sentar contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: ¿Por qué tuviste que irte y morir?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: Me prometiste que todo iba a mejorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: Dijiste que todo mejoraría.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: Y luego moriste.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: Ahora soy la única que queda con vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: ¿Por qué hiciste eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: Quiero estar con él.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: Y no me lo puedes devolver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: Ni siquiera puedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: Enterrar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: No puedo enterrarlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: ¿Y ahora qué se supone que haga?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: Me gustaría descansar un poco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: ¿Cómo murió?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: No puedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: Es demasiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: Ya no tengo lágrimas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: Ya no me quedan más lágrimas que llorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: ¿Pero eso está bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: Solo dejar de llorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: Necesita ser enterrado
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: Lo único que queda de él es un cuerpo. Necesitas aceptar eso.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: No...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: ¡No, no, no!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: No estoy lista.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: Me lo acaban de devolver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: ¿Y ahora tenemos que separarnos otra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: No puedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: No se lo voy a dar a la tierra fría y sin corazón.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: No.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: No, eso no es cierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: Todavía puede oírme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: De verdad quiero creer eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: Me gustaría descansar un poco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: ¿Qué recuerdas de él?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: Un día fuimos a visitar a nuestros amigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: Éramos mucho más jóvenes por aquel entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: Estábamos pasando el rato, tomando algo. Él usualmente era bastante callado y no hablaba mucho en reuniones así.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: Bueno, habíamos estado tomando bastante ese día.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: Estaba como siempre, en silencio y, de repente, dijo:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: "Denme una guitarra. Voy a cantar."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: Y tocó tan bien. Me encantó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Nuestros amigos empezaron a pedir varias canciones y él se quedó sentado un momento, y luego...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: Luego se levantó, dijo que tenía que irse, tiró un vaso, intentó atraparlo, se le cayó la guitarra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: Luego supe que aprendió una sola canción solo para impresionarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: Todavía tengo una foto de esa noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: Está un poco dañada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: Ahora ya no puedes tocar para mí. Me has cantado tu última canción.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: Me gustaría descansar un poco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: Entonces, ¿qué le pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: Se murió, maldición.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: Entiendo, perdón por molestar
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: Yo no lo maté
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: Lo siento, es que... no puedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: Las lágrimas vienen cada noche. No puedo detenerlas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: Solo quiero que los responsables de todo lo que pasó... quisiera que ardieran bajo el sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: Así que... ¿Qué pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: Ya no te volveré a preguntar
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: Sí. Lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: Eso fue grosero. Pero me cuesta tanto hablar de él.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: Espero que esos malditos reciban lo que merecen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: Y que alguien los mate.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: Así que... ¿Qué pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: Ya no te volveré a preguntar
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: Mi esposo no se sentía bien. Fue al hospital, pero lo enviaron con esos malditos miserables.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: Fuimos al centro que la AFAE había abierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: Solo lo pusieron en cuarentena. Le confiscaron el celular. Dijeron que lo dejarían salir en tres semanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: Regresé antes, solo para chequear.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: Me dijeron fríamente que...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Perdón, necesito un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: Todo lo que dijeron fue: "Está muerto."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: Eso fue todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: No me dejaron ver el cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: No me dejaron llevarlo a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: Pero todo siempre es un maldito caos con esos imbéciles, así que me bastó con ponerme una bata blanca e ir a la morgue.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: Y él...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: De verdad estaba allí...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: Lo mataron... su alma está en sus manos. Lo único que puedo hacer ahora es gritar que no me importa nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: Me gustaría estar sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Sí. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: La vida sin él es tan dura...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: Me gustaría descansar un poco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: ¿Pasa algo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: Me voy esta noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: Ya te había dicho que no planeaba quedarme por mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: Solo necesitaba descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: ¿Ahora qué?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: ¿Vas a ir con tu familia?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: No quiero pensar en eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: Creo... creo que solo regresaré a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: Sacaré la guitarra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: Y luego...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: Puedes quedarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Buena suerte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: Ya no queda nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: Nos vamos a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: Ya no quiero nada más.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: Puedes quedarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Buena suerte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Sí, ¿pero para qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: Eso no hará que sea más fácil para mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: No quiero ser grosera, pero realmente no me importas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: De verdad quiero irme a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: No quiero hacer nada hasta que vuelva.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: Gracias...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: No hablas mucho, pero... eres bueno escuchando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: Espero que encuentres lo que estás buscando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: Jeje. ¿Qué tal?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: ¿A qué te dedicabas antes del Cataclismo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: Uuuy, me alegro de que preguntes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: ¿Alguna vez oíste hablar de...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: ¿...las apuestas deportivas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: ¿Qué eres, un estafador?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: ¡No, hombre! Soy un maldito analista deportivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: Si supieras la plata que cayó en mis manos, estarías babeando, hermano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: Soy un profesional en mi negocio, cabrón.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: La gente me traía su plata y yo se los multiplicaba cinco... no, DIEZ veces más.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: Entonces, ¿cuánto ganaste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: ¿A eso le llamas trabajo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: Era mi forma de ganarme la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Andar apostando era solo algo para pasar el rato, hermano. En serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: Hay maneras de engañar a las casas de apuestas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: Apostabas a un equipo fijo y esperabas a que la plata volviera solita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: Y si no tenías plata, no hay problema. Se la pedías prestada a cualquiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: Entonces, ¿cuánto ganaste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: ¿A eso le llamas trabajo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: ¿Cómo te lo digo...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: Hice treinta. Malditos. Millo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: ...de deudas, sí, pero las deudas no me preocupan nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: Y ahora me importan un carajo, definitivamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: Miro al peligro a los ojos, hermano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: ¿Me estás jodiendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: ¡Claro que es trabajo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: Hasta tenía un local para hacerlo. ¡Hermano, era puro lujo...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Un sofá brillante y un cuaderno con nombres de banqueros de apuestas, lo que me debían y la ganancia neta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: Jeje. ¿Qué tal?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: ¿Los cobradores todavía no te han buscado?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: ¿Cobradores? ¿Qué carajo dices de cobradores?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: Pfff. Olvídate de ellos. Mira, ya no tengo deudas. El sol se encargó de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: Los bancos ya no están precisamente para ese trabajo. Tal vez nunca lo estén.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: Lo que significa que estoy jodidamente libre. Y puedo buscar un nuevo negocio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Apostar es tan del siglo pasado ya. Tengo que pensar en otra cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: Entonces todo esto del sol ha sido conveniente para ti
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: ¿Y bien? ¿Quieres "hacer negocios" de nuevo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: ¡Noooo, hermano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: Solo recuperaría las pérdidas luego y pagaría mis deudas. No es gran cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: Pero ahora, empezaría de cero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: Por cierto, tengo un nuevo negocio. ¿Quieres saber cuál es?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: ¿Cuál es el plan?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: No realmente
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: Se me ocurrió una manera de ganar dinero. Puedo contarte si quieres, llevo pensándolo un tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: ¿Cuál es el plan?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: No realmente
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: Básicamente, la AFAE claramente está a cargo aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: Necesitamos, como... Estar bien con ellos, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: Y creo que si entregamos gente de forma regular, incluso podrían meternos en un búnker.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: ¿Me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: ¿Quieres entregarle gente a la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: ¿Crees que la AFAE te salvará?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Pues sí. ¿Por qué carajos no?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: Creo que así vamos a sobrevivir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: A tiempos diferentes, negocios diferentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: Estar con el montón en las zonas de cuarentena generalmente es una pésima idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: Así que debemos estar en buenos términos con la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: No hablarles feo, entregar personas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Hasta hacer la prueba de señales por una llamada para demostrar que no soy uno de esos... ¿cómo les llaman? Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: Son buena gente. Seguramente saben lo que hacen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: Puede que tengas razón
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: Suena a pura mierda
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: Si tanto quieres ir con ellos, vete de mi casa de una maldita vez
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Mierda, amigo. No estás alineado con cómo las cosas están cambiando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Hay que ver quién está al mando de la situación y quedarse con ellos. Es una estrategia ganadora. En serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: Así que debemos estar en buenos términos con la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: No hablarles feo, entregar personas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Hasta hacer la prueba de señals por una llamada para demostrar que no soy uno de esos... ¿cómo les llaman? Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: Son buena gente. Seguramente saben lo que hacen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: Puede que tengas razón
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: Suena a pura mierda
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: Si tanto quieres ir con ellos, vete de mi casa de una maldita vez
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: Obvio que tengo razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: Tengo un sexto sentido para las movidas rentables, hermano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Confía en mí, conmigo no puedes perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: ¡Hermanooo, por favor! Eres jodidamente increíble.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: La gente me pagaba por consejos de inversión. Te lo estoy dando gratis, te lo digo como un regalo, y tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Mierda. Vete al diablo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: ¿Qué, me vas a echar o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: Hermano, pensaba que eras buena gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: Hasta te ofrecí un negocio. Pero tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: Te puedes ir al infierno, yo me voy a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: ¡Mierda, qué buen negocio se me había ocurrido! Bueno, está bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Si cambias de parecer, me avisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: Jeje. ¿Qué tal?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: ¿Qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Mire, se me ocurrió una nueva movida. Va a pegar. En serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: A ver, básicamente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: El sol está asando como un sauna del infierno, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: Creo que las capas de ozono deben estar en mal estado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: Pero me acuerdo que el oxígeno sale de la luz del sol pasando por el ozono.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: ¿Así que sabes lo que pensé?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: ¡VENDER AIRE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: ¡Eso SÍ que es tremendo NEGOCIO, créame!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Gran genial, demasiado increíble
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: Nunca había escuchado algo más estúpido en mi vida
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: ¿De veras? ¿Tú crees?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Sí, obvio. Deberías ser científico
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Diablos, bueno...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Gracias. Al menos alguien reconoce que soy inteligente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: Me voy a ganar un premio Darwin antes de que se dé cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: ¿Sí... sabes lo que es un premio Darwin, no?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Oh, definitivamente te vas a ganar uno
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Bueno... Es por, como, contribuciones a la ciencia o algo así.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: ¿Por qué me preguntas eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: Por nada
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: Los premios Darwin son para gente que se muere de maneras estúpidas
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: ¡Jajaja! Ya puedo saborear el reconocimiento científico.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Un montón de plata, estatus, chicas... Qué sueño...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: Bien, cuando todo esto termine, voy a patentar tecnología para vender aire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: Bueno, está bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Espere, ¿se está burlando de mí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: ¡Vete a la mierda! Estoy aquí pensando en cómo hacer ORO y tú te burlas de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: ¡Vete a la mierda! Estoy aquí pensando en un trabajo serio de verdad y tú te burlas de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: ¡Me voy a ganar el premio Darwin y me haré millonario!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: Entonces te vas a arrodillar a mis pies y me pedirás que te perdone...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: ¿Por qué no te vas a la mierda con tus ideas de mierda?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: Mierda, hermano...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: ¿Te cuesta mucho escucharme o algo así?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: Da igual, vete al carajo. Voy a sacar más ganancias sin ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: Mierda, hermano...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: ¡Vete a la mierda! Estoy aquí pensando en un trabajo serio de verdad y tú te burlas de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: ¡Me voy a ganar el premio Darwin y me haré millonario!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: Entonces te vas a arrodillar a mis pies y me vas a pedir perdón...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: Diablos... Así que al final es cierto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: Pues entonces, todo lo que dije tiene sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: No salgas durante el día. Y acuérdate de que tienes que dejar pasar a otras personas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: ¿Por qué debería dejar entrar extraños a mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: ¿Dejar entrar gente?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: Sé que mantienes tu distancia de la gente, pero tienes que hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: Mi prima no sabe bien por qué no podemos estar solos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: Pero me dijo que cuando alguien te pregunte si estás solo, siempre hay que decir que no, que tienes a alguien contigo en la casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: Odio lidiar con la gente
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: ¿Qué sentido tiene tener gente en la casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: Te entiendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: Sé que no eres fan de la compañía. Pero tienes que dejarlos pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: Mi prima no sabe bien por qué no podemos estar solos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: Pero me dijo que cuando alguien te pregunte si estás solo, siempre hay que decir que no, que tienes a alguien contigo en la casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: Odio lidiar con la gente
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: ¿Qué sentido tiene tener gente en casa ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: Sí, yo sé; sé que no será fácil para ti, pero tienes que hacerlo. Es la única manera de sobrevivir ahorita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: Podrían traerte algo o contarte cosas interesantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: Y no olvides examinarlos por si tienen señales de Visitante. Con este calor vas a tener poca energía durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: Así que tienes que escoger cuidadosamente a quién quieres examinar. Las pruebas son agotadoras. Tienes que observar muy bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: Pero no tienes que preocuparte por hablar con ellos. Eso NO consumirá energía. Así que, habla todo lo que quieras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: Y asegúrate de mirar por las ventanas. La TV es un buen recurso, pero no te dirá qué está pasando a tu alrededor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: ¿Y luego qué?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: ¿Qué tenemos que hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: Podrían traerte algo o contarte cosas interesantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: Y no olvides examinarlos por si tienen señales de Visitante. Con este calor vas a tener poca energía durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: Así que tienes que escoger cuidadosamente a quién quieres examinar. Las pruebas son agotadoras. Tienes que observar muy bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: Pero no tienes que preocuparte por hablar con ellos. Eso NO consumirá energía. Así que, habla todo lo que quieras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: Y asegúrate de mirar por las ventanas. La TV es un buen recurso, pero no te dirá qué está pasando a tu alrededor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: ¿Y luego qué?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: ¿Qué tenemos que hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: Me temo que lo único que podemos hacer es tratar de sobrevivir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: Y esperar que esta pesadilla termine pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: Creo que el gobierno nos ayudará de alguna manera. Quizá nos lleven a todos a algún refugio o algo así.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: Si lo hacen, quédate con mi familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: Ah, casi se me olvida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: Voy a regresar a casa mañana en la noche. Toma mi número para que me llames cuando quieras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: Recién nos instalaron la línea hace poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: Nos mantendremos en contacto por teléfono.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: Bueno, ahora sí, eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: Por cierto, te traje una caja de cervezas. Mi cuñado trabaja en una cervecería.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: Tómate una cerveza y descansa un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: Da mucho sueño. Así que si no quieres hablar con más nadie, tómate una y relájate.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: Mami... qui-quiero a mi m-mami...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: Cuéntame, ¿qué pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: No séeeeeeee.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: Entraron y empezaron a hablar y mi papi dijo que había algo mal con ellos y le dijeron que... que...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: ¡PAPI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: ¡PAAAAPIIIIII!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: Bueno... trata de descansar por ahora
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: Mañana seguimos hablando, ¿te parece?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (La niña llama a su padre sin cesar y su histeria no parece tener fin)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (La niña ni siquiera te escucha. Está sola en su pena)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: Mami... qui-quiero a mi m-mami...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: ¿Cómo estás? ¿Te gusta estar aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: Aquí estoy bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: Ojalá estuviera en mi casita...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: ¿Cuándo puedo irme a casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: Más tarde. La... están arreglando
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: No será pronto. Tu casa se incendió
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: Está bien. ¿Entonces, van a venir a buscarme pronto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: ¿Y me van a llevar a una casita nueva?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: ¿O a la misma?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: ¿Me están haciendo un cuarto nuevo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: Así que, mi papi todavía vendrá a por mí, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: Ya viste lo que pasó, ¿no...?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: Deberías quedarte aquí por ahora
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: ¿Pero mi papi está bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: ¿Y mi cuarto? ¿También se quemó?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: ¿M-mi mami no va a venir?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: ¿Queda alguien más?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: Ya viste lo que pasó, ¿no...?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: Deberías quedarte aquí por ahora
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: No... no lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: Quiero decir, no estoy segura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: A papá le pegaron, pero luego se levantó. Sí, eso lo vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: Lo que significa... significa que podría apagar el fuego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: O solo venir a buscarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: ¿Va a venir pronto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: No me voy a ir ningún lado sin mi papi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: Va a venir a buscarme, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: Lo vi levantarse e irse.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: Estaba corriendo, pero lo vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: Mami... qui-quiero a mi m-mami...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: Tienes que aceptar lo que pasó
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: ¿Qué quieres decir?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: Vi una tele en tu cuarto. ¿Puedo ver caricaturas ahí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: No sé qué fue lo que viste. Pero creo que tu papá falleció
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: Puede que tu papá no te venga a buscar. No sé qué le pasó...
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: ¡Tú no viste nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: ¡Yo estuve ahí! Se estaba moviendo cuando me fui corriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: ¡Lo que significa que va a vendrá por mí pronto!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: ¿Por qué todavía no te ha venido a buscar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: ¿Cómo se veía la última vez que lo viste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: ¿No va a venir? ¿Por qué dices eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: ¿Por qué entonces no te ha venido a buscar todavía?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: ¿Cómo se veía la última vez que lo viste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: ¿Quizás tenía algo que hacer primero?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: Fue a golpear a esa gente mala.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: Él... debería estar aquí pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: Lamento mucho lo de tu papá. Era un muy buen hombre. Quizá demasiado bueno...
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: Sí, seguro que sí, tu papá seguro llegará pronto
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: Mi papi era bueno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: Le pegaron... así que...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: No me acuerdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: Lamento mucho lo de tu papá. Era un muy buen hombre. Quizá demasiado bueno...
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: Sí, seguro que sí, tu papá seguro llegará pronto
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (La niña te mira, como si entendiera más de lo que deja ver. Tienes miedo de moverte, así que solo esperas a que pase algo)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (Al cabo de un rato, comienza a sollozar. No parece haber nada que puedas hacer)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (Sería peor dejarla creerse una mentira. Debe asumir la situación lo más pronto posible)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: Eso me imaginaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (Notas a la niña distraída. Claramente está pensando en algo)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (¿Pero vale la pena arruinar su niñez? ¿Podrá soportar ese golpe?)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (Decides que ya tiene suficientes problemas ahora. No hay razón para preocupar a la pequeña)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: Ay, Dios mío, ya estoy muy vieja...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: ¿De dónde viene?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: Necesito examinarla
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: Pues sí, mijo. ¿Qué tiene de malo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: La gente se aprovecha de mis cuentos y luego me odia por ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: ¿Se imagina?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: Tengo una casa. Una choza para mí sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: Sí me gusta estar allí, pero me voy a marchitar sin compañía.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: ¿Y quién va a vendría a una pequeña y vieja choza?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: Así que vago y doy vueltas, mijo. No tengo nada que perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: Ay, Dios mío, ya estoy muy vieja...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: ¿Por qué no tiene más parientes?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: Necesito examinarla
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: Oh, Yo cuento cosas de lo más comunes; historias sobre la gente que he conocido con los años.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: Se las cuento a todo aquel que quiera oírlas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: Pero ya soy una abuela. No me acuerdo bien de todo. A veces... me invento algunos detalles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: Quizás por eso es que les caigo mal a los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: Como dicen por ahí: "La tristeza misma no es tan difícil de llevar como lo es la idea de que la tristeza vendrá".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: Pero tampoco soy la única que maquilla los cuentos, ¿sabes? Jejeje.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: Todo el mundo viene a mí. Tarde o temprano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: Todo el mundo necesita cuentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: Ay, Dios mío, ya estoy muy vieja...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: ¿Por qué no está con su esposo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: Necesito examinarla
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: ¿Qué te gustaría que te cuente, cariño?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: El ser humano es una criatura temerosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: Supe de un hombre que se aisló de todo el mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: Vivía en uno de esos edificios altos. Bueno, pues... era de esos que casi no iba a ningún lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: Puede que le tuviera miedo a los Visitantes. O a lo mejor solo le temía a la muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: La verdad es que nadie se acercaba por ahí. Igual él no los habría dejado pasar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: Y entonces, un día...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: Oí una especie de ruido desagradable, un estruendo como cuando se te cae una jarra de mermelada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: Al principio no supe de qué se trataba.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: Así que miré por la ventana y vi al hombre en el fondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: Había saltado...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: ¿Qué te pareció el cuento, cariño?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: No me gustó
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: ¿Eso es todo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: ¡Uy! Probablemente por eso no le caigo bien a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: Bueno, no importa. Algún día, voy a contar su historia como la recuerdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: Sí, mijo. El hombre se desparramó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: O tenía miedo de morir con una agonía terrible por la explosión del Sol... o quién sabe qué.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: Creo que su corazón no pudo soportar la soledad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: ¿Pero qué se le va a hacer, cariño?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: Ay, Dios mío, ya estoy muy vieja...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: ¿Qué tal le fue sentándose en la banca?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: Necesito examinarla
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: Bueno, mijo, escucha este cuento.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: Cuando vivía en el pueblo, había un señor allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: Le encantaba caminar por el bosque. No sé por qué sería.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: Pero lo hacía. En uno de esos paseos suyos, caminó hasta notar que se había perdido. No encontraba el sendero de vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: Se paró a pensar. Decidió que si caminaba derecho, iba a llegar a algún lugar tarde o temprano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: Caminó y caminó, pero no pudo encontrar el camino de regreso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: Fue entonces cuando se dio cuenta de que estaba yendo en círculos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: ¿Y luego qué?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: Esto es una estupidez
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: Lo encontraron muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: Seguimos sus pisadas y nos dimos cuenta de que solo estaba dando vueltas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: Ya sabes lo que dicen: una pierna siempre da pasos más largos que la otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: Eso fue lo que pasó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: ¿Por qué? ¿No te gustan mis cuentos?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: Bueno, le agregué una que otra cosita, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: Pero sí pasó de verdad. Y es algo que sigue pasando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: La gente camina y se pierde, ¿y cómo hacen para salir?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: Necesito reunir fuerzas. Si tan solo alguien me las diera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: ¿Cómo está tu hermana?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: Tengo que ayudarla. Con muchas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: Ayer pude bañarla. En casa ni siquiera podía meterse en la bañera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: Todavía sin cambios. Pero gracias por preguntar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: La gente con depresión es bastante... complicada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: Temo que podríamos tener que huir en cualquier momento y ella no se sienta con fuerzas para hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: O que no coma porque no se siente con energía para masticar ni tragar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: Yo también estoy cansada. Creo que voy a descansar un poquito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: Necesito reunir fuerzas. Si tan solo alguien me las diera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: ¿Qué vas a hacer entonces?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: Buena pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: Mi esposo debería venir a buscarnos pronto. Espero que pueda encontrar un lugar seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: Algún lugar donde podamos esperar a que pase el ataque de los Visitantes y a que ya no haga tanto calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: Dijo que existen lugares así. También dijo que el sol no puede estallar y ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: Si eso pasara, seríamos aniquilados en 10 minutos o menos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: Creo que tiene razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: Necesito reunir fuerzas. Si tan solo alguien me las diera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: ¿Alguna noticia de tu esposo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: Por alguna razón, no se ha comunicado conmigo para nada. No ha llamado ni ha venido a buscarnos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: ¿Será que le pasó algo? ¿Se habrá metido en problemas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: De lo que estoy segura es de que no nos ha abandonado. Eso es imposible.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: Incluso cuando estaba completamente harto de mi hermana, igual me ayudaba con ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: Seguro que... Seguramente ya está en camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: Y mi hermana parece estar un poco mejor... Así que... Sí, él vendrá y todo irá mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: Necesito reunir fuerzas. Si tan solo alguien me las diera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: Te ves triste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: ¿Mmm?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: Oh, capaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: Tengo muchas cosas en la cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: Si el sol no va a explotar, ¿entonces por qué no sigue haciendo tanto calor? ¿Por qué todo el mundo solo piensa en el fin del mundo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: Vi las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: No lo dijeron directamente, pero parece que el día se está poniendo cada vez más caluroso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: El clima está cambiando. Los animales están muriendo porque no pueden adaptarse a las nuevas... condiciones climáticas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: ¿Qué nos va a pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: Necesito reunir fuerzas. Si tan solo alguien me las diera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: Oye, ¿qué tal estás?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: Anoche salí. Quería encontrar a mi esposo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: Caminé por algunos lugares donde podría estar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: Lo encontré en uno de ellos. Se había tomado una pastilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: Nosotros... Las compramos. Por si las cosas se ponían mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: Se tomó una. Tenía miedo. No me llevó con él..'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: Se tomó la pastilla él solo. Incluso antes de que el sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: Este es el final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: Oye, ¿cómo te sientes?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: Me siento...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: Como si hubiera una cobija pesada, muy pesada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: Apretando mi cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: Y... no quiero...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: Este es el final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: Hoy te ves un poco más animada
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: Sí'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: ¿Sabía usted lo del sol? ¿Que va a explotar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: Me enteré esta noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: Entonces, ¿este es el final?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: ¿No va a quedar ni rastro de nosotros?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: Qué interesante pensar en eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: Este es el final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: ¿Cómo está tu hermana?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: A ella le da miedo perderlo todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: Yo no creo que tengamos nada que perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: En este universo en constante expansión, solo somos partículas de polvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: Nadie nos necesita porque no hay nadie más.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: Si el planeta desaparece, nadie nos va a llorar. Y no haría falta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: Pero a mi hermana le aterra eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: Este es el final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: ¿Tu hermana está enferma?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: Sí, es que quiere ir a buscar a su esposo para distraerse de pensar en cosas malas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: Se me hace que esta es una mala idea, pero ella tampoco puede quedarse sin hacer nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: Si aún quiere ir a buscarlo, yo también tengo que ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: No quiero perderla antes de que todos muramos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: Este es el final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: Así que, ¿sí salieron?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: Sí. Mi hermana encontró el cuerpo de su esposo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: Él le había dicho que todo iría a mejor y luego se suicidó. Tuvo miedo de enfrentar nuestro verdadero final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: No creo que le quede fuerza alguna.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: Ahora tendré que cuidarla hasta que todos muramos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: Y entonces, por fin, no habrá más de qué preocuparse, nada que temer, que aborrecer, o de lo que avergonzarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: Dejarla tranquila
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: Dejarla tranquila
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: Maldición... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: Oye, amigo... Si no es mucha molestia... ¿Podrías llamarlos? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: No es para pedirles que vengan a buscarme... no quiero despedidas... Solo diles...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: Diles que papá no huyó. Él solo... se quedó donde la gente lo necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: Cof... cof... Eso es todo lo que importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: Dime, ¿tienes algo que contarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: ¿Qué son esos papeles?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: Lo que contienen estos archivos es increíble. Algunas partes son, de hecho... algo fascinantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: Mira aquí, por ejemplo. Es una teoría particularmente curiosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: Afirma que los Visitantes no existen en realidad. Todo es parte de un plan gubernamental para tratar la sobrepoblación.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: Es una lectura bastante convincente... y curiosamente, tiene cierto sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: La sobrepoblación sigue siendo un problema, nos guste o no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: Tal vez así es como decidieron "manejarlo".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: Dime, ¿tienes algo que contarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: ¿Sigues revisando tus papeles?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: Exacto'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: Tengo mucho más, si te interesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: Mira, échale un vistazo a este.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: Fíjate. La AFAE *son* los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: Los trajes que usan son de cobertura total. No hay forma de examinarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: Fascinante. Me gusta especialmente lo que creen que significa AFAE: Agencia para el Fin Absoluto de la Especie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: ¿O era algo distinto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: Dime, ¿tienes algo que contarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: Entonces, ¿qué has descubierto esta vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: Visitantes... Cambiaformas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: Suena a algo sacado de una novela de ciencia ficción, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: Pero hay algo de cierto en ello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: Un informe menciona a un hombre pálido visto caminando por las calles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: Aunque, debo señalar... el autor cometió un error bastante obvio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: Dice que se vieron DOS seres pálidos y perturbadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: Uno visto a través de ventanas, el otro de pie en la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: Venga, ya. ¿No es obvio que son la misma criatura?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: 'Theorist: Me atrevo a suponer que la ventana distorsionó la vista. Hizo que el rostro pareciera diferente. Un error de percepción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: De todos modos, es entretenido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: Dime, ¿tienes algo que contarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: ¿Y si fuera cierto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: ¿Y qué es la verdad, de todos modos? Es un concepto fluido, moldeado por la perspectiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: La verdad de una persona es la ilusión de otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: Lo que para uno es bueno, para otro es malo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: La humanidad ha discutido sobre eso desde siempre. ¿Y últimamente? La brújula moral está por todos lados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: Si tu creencia es fuerte, como la mía, se convierte en tu verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: Un artículo intrigante. Ahora, ¿de qué hablábamos? Ah, sí. La verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: Recuerda esto. Solo hay una verdad: los Visitantes son parásitos cerebrales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: Usa tapones para los oídos. En todo momento. ¡Y todo estará bien!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: En fin, tengo más que leer. Por favor, no me distraigas. Necesito concentrarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: ¿Qué ocurre ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: ¿Has dicho que trabajabas en aduanas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: Puedes apostar a que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: Hablando de eso, ¿SÍ ESTÁS revisando a la gente en busca de señales de Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: No es por ser obvia ni nada, pero... ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: ¿A quién carajos se le ocurrió llamar a esos bichos raros Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: Tendrían que haberles puesto un nombre más adecuado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: ¿Qué ocurre ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: ¿Por qué odias a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: ¿Pero qué pregunta más tonta es esa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: ¡Son la razón de que todo se haya ido al carajo! ¿No ves las noticias?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: El sol va a explotar, la gente muriendo en las calles. Todo es culpa de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: Juro por Dios, acabaría con todos ellos si pudiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: Solo dame tiempo. Los rastrearé como en la frontera, ya lo verás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: La AFAE comete un grave error al no aceptarme...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: ¿Qué ocurre ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: ¿Por qué tienes tantas ganas de trabajar para la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: Carajo, porque me importa, por eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: Sé que hay que hacer para detener a esos Visitontos; y HAY que detenerlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: Hasta denuncié a nuestro vecino. Hice lo que debía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: ¿Pero qué hicieron? ¡Contrataron a mi esposo! ¡No a mí!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: Ahora, no me malinterpretes, estoy muy orgullosa de que mi esposo entrara, pero por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: ¿Sinceramente? Se siente como una bofetada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: ¿Qué ocurre ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: ¿Por qué delataste a tu vecino?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: Te lo dije claro: era un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: Y me daba escalofríos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: A decir verdad, me sentí muy bien delatándolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: Me recordó los viejos tiempos en aduanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: Fue ahí cuando me di cuenta que tenía entrar en la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: ¿Qué ocurre ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: No estás aquí por tu esposo. Es por la AFAE, ¿cierto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: ¿Ah, sí? ¿Y eso qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: Sí, vine a montar un lío hasta que me escuchen los de arriba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: Quiero apelar ese rechazo laboral.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: ¡Es una porquería! Yo atrapo al Visitante, hago mi maldito deber cívico, ¿y a ÉL le dan el trabajo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: Dios mío, simplemente no lo entiendo. Es una estupidez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: Odio a ese hombre. Lo odio con toda mi alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: Oye, tengo un pequeño favor que pedirte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: Llámalos, ¿sí? Usa su línea interna, tienen un número especial: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: Diles que conociste a alguien que vale la pena. Una mujer con experiencia y agallas. Diles que hasta les llevé un empleado nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: Exagera. Intercede por mí y tal vez por fin me dejen hacer algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: ¿Qué ocurre ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: Aduanas era mejor, ¿eh? Al menos tenías algo de poder allí
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: Oh, bájate de tu pedestal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: No pregunté lo que piensas. No eres mejor que yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: ¿Te gusta estar al mando? Que la gente venga, que se quede en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: Tú tomas las decisiones aquí, decides quién es Visitante y quién no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: Pero ese no es tu maldito trabajo. Eso es asunto de la AFAE. Estás jugando a ser juez sin credenciales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: Así que dime, ¿en qué eres mejor que la AFAE? Al menos ellos tienen la autoridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: Eso pensé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: Yo... solo espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: ¿Todavía quieres que mate a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: La verdad es que...  he cambiado de parecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: Sí, me asusté. Lo sé. Lo... lo siento. Pero me di cuenta de que aún no estoy listo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: Todavía me da náuseas ver cadáveres. Me tomará tiempo superarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: Es que... los Visitantes... escuché que sus cuerpos aún se mueven. Después de morir. Como ese hombre... ese hombre en el callejón...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: Maldita sea, no puedo pensar en eso ahora mismo. No estoy listo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: Yo... solo espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: Cuéntame qué pasó en el callejón
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: Resulta... duro de contar. Pero lo intentaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: Pensé que los callejones serían más seguros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: Pero en cuanto doblé la esquina, sentí como si hubiera entrado a un cementerio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: Docenas de cuerpos tirados ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: Algunos de ellos aún se movían. Como si no estuvieran del todo muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: Y al fondo del callejón, había un hombre con una escopeta, y él...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: No... Ya basta. No quiero recordarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: Yo... solo espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: ¿Quién era el hombre que viste en el callejón?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: Él...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: Un hombre encapuchado, lleno de hileras de dedos y dientes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: Había un joven a su lado. Indefenso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: El hombre del abrigo le gritó, apuntándole con un arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: Le ordenó que enseñara los dientes. Y el chico le estaba suplicando piedad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: Me estaba escondiendo detrás de un bote de basura... Y entonces... no sé por qué, pero me vi en el lugar de ese chico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: Estaba llorando, rogando, suplicando por su vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: Entonces... ¡BANG! Y su cuerpo simplemente cayó, como los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: Fue entonces cuando me di cuenta... ahora solo hay dos tipos de personas. Depredadores y presas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: Yo... solo espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: Para sobrevivir no hace falta volverse un homicida sanguinario
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: ¿Por qué dices eso? ¡No es verdad!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: Estás vivo porque mostraste tus colmillos. ¡Eres un depredador! Por eso nadie se atreve a tocarte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: Si la gente te teme, estás a salvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: No quiero ser una presa. No quiero morir llorando como un cobarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: Por eso tengo que aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: Padre nuestro, que estás en los cielos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: Así que, ¿qué tal la casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: Uf. Lamentable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: Paredes torcidas. Y la distribución no tiene lógica alguna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: Y dígame, ¿a propósito me metió en la habitación más penosa que pudo encontrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: Los muebles son viejos y están en mal estado. Están carcomidos, desgastados y probablemente ya estén llenos de polillas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: Ni siquiera pudo colgar un crucifijo en una habitación decente, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: ¿Por qué me pones estas pruebas, Padre...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: Padre nuestro, que estás en los cielos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: Si tanto odia este lugar, ¿por qué no se va?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: ¿Cree que elegí venir a este lugar desolado? Si el monasterio siguiera en pie, nunca habría abandonado sus muros sagrados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: ¿Cree que me importa esta pila de podredumbre y escombros?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: Si hubiera tenido opción, no habría venido aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: Este lugar apesta a sangre y muerte, Dios mío, ten piedad. ¡Y apuesto a que disfruta de todo esto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: Asesinas a cualquiera que consideras un demonio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: ¡Quizás usted sea uno! ¡Con cuernos y todo, solo que no le han crecido!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: Pero puedo soportar estas transgresiones. El Padre Celestial vela por su rebaño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: Padre nuestro, que estás en los cielos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: ¿Por qué no se quedó en su monasterio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: En primer lugar, el monasterio no es mío. Es la casa del Señor Todopoderoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: En segundo lugar, fueron esos viles blasfemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: Profanaron Su lugar sagrado. ¡Que el fuego del Cielo los encuentre!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: Irrumpieron, me expulsaron a mí y a mi rebaño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: Se instalaron como si fueran los dueños. ¡Bárbaros, todos ellos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: Vivíamos correctamente y con decoro. Oramos, ayunamos, hicimos la labor del Señor. ¿Y esos animales?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: Bebiendo agua bendita como vino barato, sin duda. Que se ahoguen con ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: ¡Que se pudran en el Infierno!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: Padre nuestro, que estás en los cielos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: ¿Qué querían esos "blasfemos"?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: Vinieron en turba, sucios y ruidosos, chillando como demonios, maldiciendo como los brutos impíos que son.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: ¿Y por qué? ¡Porque no los dejé entrar! Se los dije claro: ¡si no están bautizados no cruzarán el umbral!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: Dios Santo, se enfurecieron, oh sí... Golpearon las puertas, intentaron destrozarlas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: Después entraron a la fuerza y me expulsaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: ¿Le negaste ayuda a quienes lo necesitaban?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: Quizá yo también te habría echado
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: Un lugar sagrado no es refugio para los impíos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: ¿Y qué si buscaban sombra del sol o refugio de esos llamados Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: Aunque llueva fuego del cielo, la casa de Dios no es lugar para fenómenos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: El Señor muestra misericordia solo a quienes creen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: Y si ardieron en las calles, que así sea. Ese fue su juicio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: Eres despreciable, pero no me corresponde juzgarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: Será mejor que te vayas ahora, antes de que te dispare
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: ¡Miserable insolente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: ¡¿Te has vuelto loco?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: ¡Soy una sierva de Dios! Expulsada de Su casa por alimañas impías... Y tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: ¿Te atreves a burlarte de mí? ¿Dices que lo merecía?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: No eres un hombre. ¡Eres una víbora!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: ¡BLASFEMO! ¡ERES SOLO OTRO BLASFEMO MÁS!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: Esperaba que pudieras entender. Pero no eres mejor que los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: ¡Solo somos siervos! ¡SIERVOS DEL SEÑOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: No podemos hacer nada más que aceptar Su voluntad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: Él es el Señor. Su sabiduría es superior a la nuestra. Jamás comprenderemos Su gran plan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: Eres despreciable, pero no me corresponde juzgarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: Será mejor que te vayas ahora, antes de que te dispare
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: ¿Oh, ahora eres tú el salvador?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: No quiero tu vil excusa de hogar. No pasaré otro instante aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: Adiós. ¡La ira de Dios caerá sobre ti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: Nunca tuve intención de quedarme, que lo sepas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: Lo sentí en los huesos en cuanto entré: no hay Dios en esta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: Tal vez Él me habla incluso ahora, diciéndome que me marche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: Adiós. ¡La ira de Dios caerá sobre ti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: Esta maldita herida...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: ¿Por qué vino la AFAE por ti, de todos modos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: No estoy seguro, pero lo intuyo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: Pensé que solo era un registro de rutina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: Pero apostaría lo que sea a que fue esa perra de al lado quien me delató.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: No nos soportábamos. Vio su oportunidad de incriminarme y la aprovechó, afirmando que yo era un "Visitante".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: Seguramente está muy orgullosa de sí misma, la muy puta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: Esta maldita herida...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: ¿Cómo va esa herida?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: Estoy bien, de verdad. Está mejorando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: Te lo dije, la bala me atravesó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: La gente no debería hacerse esto. Y este tipo agarra y me dispara...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: Si seguimos así, pronto estaremos todos bajo tierra. Si no se puede dormir en la superficie, bien podríamos descansar enterrados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: Pero no... viven como perros y arrastran a los demás consigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: Debiste ver a ese lunático con la escopeta. Qué bastardo tan espeluznante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: ¿Un lunático? ¿No dijiste que te dispararon los de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: ¿De qué lunático hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: Sí, sí, fue la AFAE, él...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: Dime la verdad
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: Basta. Eres un muy mal mentiroso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: Digo... hablo de un tipo de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: Se veía muy amenazante cuando lo vi... cara a cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: Digo... cuando me disparó... por la espalda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: Dime la verdad
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: Basta. Eres un muy mal mentiroso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: Está bien, está bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: La verdad es que... sí salí de la zona de cuarentena, sí... pero no hubo disparos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: Un doctor me ayudó. Falsificó los papeles, me sacó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: No puedo volver a casa. Ella sigue ahí. La vecina que me entregó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: Así que buscaba un lugar donde esconderme. Entonces me encontré a ese tipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: Solo iba a preguntar dónde podía pasar la noche. Y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: Vi un destello de una escopeta en su espalda, un collar de dientes y uñas. El callejón lleno de cuerpos detrás de él.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: Fue ahí cuando me di cuenta que era un maldito maníaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: Mira, el dolor está regresando. ¿Te importa si me acuesto un rato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: Maldición...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: Escucha, te lo explicaré todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: La verdad es que... sí salí de la zona de cuarentena, sí... pero no hubo disparos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: Un médico me ayudó. Falsificó los papeles, me sacó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: No puedo volver a casa. Ella sigue ahí. La vecina que me delató.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: Así que buscaba un lugar donde esconderme. Entonces me encontré a ese tipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: Solo quería preguntar dónde podría pasar la noche. Y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: Vi el destello del rifle de asalto en su espalda, un collar de dientes y uñas. El callejón estaba lleno de cuerpos detrás de él.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: En ese instante supe que era un maldito maníaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: Mira, el dolor está volviendo. ¿Te importa si me acuesto un rato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: Esta maldita herida...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: Cuéntame, ¿qué pasa con ese loco del rifle de asalto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: Sí, ese monstruo, lleno de dientes y dedos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: Vio la duda en mi cara, me apuntó con el arma. Logré tomarla y forcejeamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: Ambos luchamos por el arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: Disparó y lo próximo que supe fue que le golpeé el cráneo y lo noqueé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: Corrí. Tan lejos como pude. Luego sentí el dolor en mi vientre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: Bajé la vista, sangre por todos lados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: No dije que me disparó porque supuse que no me dejarías entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: En tiempos así, cada quien busca cuidarse a sí mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: Sé honesto... Si supieras que un psicópata armado podría venir tras de mí, ¿me dejarías quedarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: Necesitaba refugio. No quiero morir como esos pobres diablos en ese callejón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: Así que sí... mentí. Espero que puedas perdonarme. No me lo tengas en cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: Está bien. Puedes quedarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: Ya no puedo confiar en ti. Márchate
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: Gracias. Significa mucho que seas comprensivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: Esperemos que ese desquiciado no aparezca. Menos mal que tú también vas armado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: Quizás alguien más ya se encargó de él. Diablos, quizás hasta ese Visitante pálido y escuálido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: Bueno... supongo que tenía razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: ¿Ves? Mentí por una razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: ¡Hasta nunca, idiota!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: Ay, no... ¿A dónde habrán ido...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: ¿Cómo estás?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: No sé... Solo quiero volver a ver a mis papás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: Ellos me cuidaron toda mi vida y ahora... ni siquiera sé qué les pasó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: Espero que estén bien. No puedo imaginarme estar sin ellos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: Ay, no... ¿A dónde habrán ido...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: ¿Tienes algún otro pariente?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: Casi nadie. Aunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: Hace poco me enteré de que tengo una hermana mayor... del primer matrimonio de mi papá. Pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: ¡Rayos, mi abuela!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: Ay Dios, creo que ya sé a dónde pudieron haberse ido mis papás...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: ¿Y si la abuela resultó ser una Visitante y los mató? ¡¿Y si AFAE se los llevó?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: ¿Por qué? ¿Por qué no se quedaron? ¿Por qué no me llevaron con ellos? ¿POR QUÉ...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: NO SOBREVIVIRÉ SOLO. ¿POR QUÉ ME ABANDONARON?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: Ay, no... ¿A dónde habrán ido...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: ¿Ya te calmaste? ¿Qué hay de esa hermana tuya?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: Bueno, yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: No mucho antes de que se fueran, nos llegó una carta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: Mi papá me la trajo porque yo nunca reviso el correo. Me dijo que la leyera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: Era de mi "hermana".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: Decía que quería conocerme. Pero... no supe qué pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: Sinceramente, al principio pensé que era alguna broma. Pero mi papá me la dio, así que no podía serlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: Me confesó que no fui su primer hijo. Que tuve una hermana todo este tiempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: No una hermana completa. Solo con el mismo papá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: Cuando oí eso... me sentí raro. No supe cómo manejarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: O sea, supuestamente es mi "hermana", pero no la conozco de nada... se siente raro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: Mmm... creo que me gustaría hablar con ella. Pero tengo demasiado miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: ¿Podrías llamarla tú por mí? Aquí está su número {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: Solo... dile que existo. Que no sé qué hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: Ay, no... ¿A dónde habrán ido...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: ¿Por qué no quieres ir a casa de tu hermana?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: Apenas la conozco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: Cuando mis padres me dijeron la verdad, sentí que me habían estado mintiendo desde siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: Me enfadé muchísimo y fui a mi habitación. Solo quería que me dejaran en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: Y entonces, al día siguiente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: Pasó aquello de lo que te hablé. La tele, el pánico y, luego...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: De verdad me dejaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: Dios, te juro que daría cualquier cosa solo por ver a mis padres una vez más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: Dios, ¿por qué...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: Ve a casa de tu hermana. No te negará la entrada.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: ¿Estás seguro de que tus padres están muertos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: ¿De verdad? ¿Tú crees?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: Pero es que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: Jamás he ido tan lejos sin estar con mis padres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: Ella vive muy lejos de aquí. Y yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: Tengo miedo. No creo que pueda hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: Coge un taxi. Todavía están funcionando.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: Tienes que hacer algo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: Bueno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: No regresaron por mí, así que yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: No sé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: Prueba a buscar a tu abuela.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: Prueba a revisar las zonas de cuarentena.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: Oye, eso... en realidad no es mala idea. Es algo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: Aunque he oído que los taxis son muy caros ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: Pero cogí de la reserva de mis padres. Quizás sea suficiente para pagar un viaje a casa de mi hermana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: Gracias por hacerme entrar en razón. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: Puede que tengas razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: Puede que en serio haya estado dependiendo de mis padres por mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: Gracias por hacerme entrar en razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: Intentaré ger un taxi. Por suerte, me traje la reserva de dinero de mis padres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: Espero poder hacer esto. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: Puede que... puede que tengas razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: ¿Quizás su coche se averió?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: Sí, padre decía que necesitaba reparaciones de nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: Pero la abuela se niega a tener un teléfono. ¿Quizás por eso no pudieron llamarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: Puede que... puede que en serio los encuentre allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: Gracias por hacerme entrar en razón. Es hora de que me vaya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: Bueno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: Puede que de verdad estén allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: Supongo que tengo que intentarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: Gracias por hacerme entrar en razón. Es hora de que me vaya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: Pregunta lo que quieras, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: ¿Cómo estás?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: ¡Me siento genial, bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: Me asomé a ver en tu nevera ¡y nah! Hombre, si hubiera sabido que tenías TANTA cerveza...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: ¿De dónde la sacaste? ¿Tienes un tío en una fábrica de cerveza o algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: ¡Bah, qué más da! ¡Quédate tus secretos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: Maldición, si no fuera por todo este desastre, bro, estaríamos relajados, bebiendo cervezas frías, viendo fútbol. Hasta te presentaría a...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: ¿Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: ¿Te congelaste o algo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: ¿Ah? ¿Qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: No importa. Olvídalo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: Nah, es solo que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: Solo estoy pensando, eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: Pregunta lo que quieras, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: Te ves deprimido hoy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: No quiero hablar de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: ¿Hablar de qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: ¿De qué hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: No importa. No lo entenderías.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: Creo que deberías decirme
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: Está bien, no insistiré
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: Mira, en verdad no quiero hablar de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: Creo que deberías decirme
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: Está bien, no insistiré
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: ¡No me presiones! Apenas me estoy conteniendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: Solo... déjame en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: Gracias. No me siento muy bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: Pregunta lo que quieras, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: ¿Qué te pasa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: ¡Eso no es asunto tuyo, bro! ¡Aléjate!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: Solo dime qué te pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: Vas a tener que hablar. Será peor si no lo haces
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: No puedo... Me verás diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: Aún así... No puedo guardarme esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: Tenía una perra. Murió hace unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: ¿Y qué con eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: ¿Y?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: ¿Qué, planeas matarme, bro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: Bien. ¿Quieres la verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: Tenía una perra. Murió hace unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: ¿Y qué con eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: ¿Y?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: Esa es la cuestión. Ya estaba viejita, enferma... pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: Ella solo no...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: La maté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: ¡¿Que hiciste qué?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: ¡Maldito enfermo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: La maté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: ¡¿Que hiciste qué?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: ¡Maldito enfermo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: Ya sé cómo suena. Pero déjame explicarme, bro. Ella... estaba sufriendo. No pude soportarlo más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: Todos los días, veía el dolor en sus ojos. La escuchaba quejarse por las noches, llorar por el dolor de sus patas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: ¡ESE MALDITO AUTO! Si ese taxista no hubiera estado manejando como un maldito loco, quizás ella seguiría aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: Maldición, daría lo que fuera por romperle el cuello. Pero huyó y no vi la matrícula...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: No sabes lo que se siente, perder una mascota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: Sabes lo que dicen: para nosotros, son solo un capítulo. Pero para ellos, somos su historia completa. Y de alguna forma, nos enseñan más de lo que cualquier persona podría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: Está bien, no te voy a echar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: Sí, ya sé... soy un desgraciado. Todavía no me lo perdono.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: Ella... estaba sufriendo. Ya no pude soportarlo más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: Con los días solo empeoraba. Las noches eran lo peor... lloraba, se quejaba... y las lágrimas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: ¿Alguna vez has visto a un perro llorar? Sus ojos me suplicaban que terminara con todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: ¡Yo no quería! ¡Lo juro! Mi mano jamás debió...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: ¡MALDITO TAXISTA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: ¡Ese infeliz le pasó por encima a mi perra! ¡Y después se largó como si nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: ¡Como si fuera una piedra en el camino, no un ser vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: Maldición, daría lo que fuera por romperle el cuello. Pero huyó y no vi la matrícula...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: No sabes lo que se siente, perder una mascota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: Sabes lo que dicen: para nosotros, son solo un capítulo. Pero para ellos, somos su historia completa. Y de alguna forma, nos enseñan más de lo que cualquier persona podría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: Está bien, no te voy a echar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: Gracias, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: Me alegra que lo entiendas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: Tienes razón, bro. Quizás esto sea lo mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: Pienso en esto todos los malditos días... si hice lo correcto al acabar con su dolor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: Supongo que nunca lo sabré en realidad...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: Qué oscuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: Entonces, pues, ¿qué viste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: No quieres saberlo. Créeme. Es una misericordia no saber.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: Creí que si me arrancaba los ojos, me libraría de esa... cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: Pero ahora tengo la imágen grabada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: Sigo soñando y... s-siempre está ahí. ESO me visita a cada rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: Qué oscuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: ¿Y bien? ¿Estás mejor sin tus ojos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: Es difícil de decir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: Sé que nunca volveré a ver a esa cosa. Incluso si algo me mata, no sabré qué fue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: Aunque, bueno... es extraño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: No sé qué aspecto tiene tu casa. Es difícil moverse. Me dolerían las cuencas de no ser por las medicinas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: Ya me adaptaré. Por lo menos no tendré que ver ese horror otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: Aun así... saber que vi lo que vi... Es algo que no puedo olvidar, algo que arrastraré hasta que me llegue la hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: Qué oscuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: No te ves muy bien
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: ¿Tan mal me peiné? ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: Anoche tuve un sueño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: Caminaba por las vías del tranvía, yendo a casa. Habían casas y árboles alrededor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: Escuché el tranvía acercarse y me hice a un lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: Me volteé y vi algo llevarse a un hombre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: Se movió tan rápido a su alrededor que no pude verlo con claridad. Pero yo sabía. Sabía lo que era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: Corrí tras el tranvía, pero ni me acerqué. Nunca iba a llegar. Nunca llegaré a la verdad que se esconde al final de la línea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: Entonces me desperté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: Qué oscuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: ¿Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: Tuve otro sueño. Volvió a aparecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: Estaba caminando por una carretera. Era de noche. Los postes de luz titilaban.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: Me volteé y lo vi acercándose hacia mí. Despacio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: Esta vez vi cómo se movía. Claramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: Quise escapar, pero me estaba alcanzando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: Llegué a mi casa pero no pude abrir la reja. Salté la cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: Me metí la mano en mi bolsillo, temblando, y las llaves se me resbalaban.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: Así que corrí alrededor de la casa, vi otra cerca y volví a saltar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: Me detuve. No escuché nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: Miré hacia arriba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: Y ahí estaba. Intentando alcanzarme por encima de la cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: Quizás son solo los analgésicos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: Qué oscuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: ¿Tuviste algún sueño anoche?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: Sí'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: No quiero hablar de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: Ahora entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: Todos vamos a morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: Nos hará pedazos. Despiertos o dormidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: Todos vamos a arder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: Ya nada importa. Se acabó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: Yo... Déjame. Por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: Eh, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: ¿Qué hacías antes del cataclismo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: Man, estaba relajado. Viéndome mis pelis, pasando el rato con la banda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: ¿Pero ahora? Ya no hay más pelis, no más salidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: La tele solo pone la misma basura de pánico y anuncios. Mis compas ya ni responden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: Oí a un pez gordo diciendo y que "Ahora no es el momento de divertirse, estamos en crisis...".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: Nah, man, al diablo con ese. Yo decido cuándo es tiempo de diversión.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: Eh, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: ¿De qué trabajabas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: ¿Trabajar? Pffff.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: Nah, bro, solo los tontos trabajan. Yo estaba viviendo, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: Una vez vi una peli. ¿El prota? Era tal cual yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: Dime, ¿los tipos en las fábricas parecen felices? Ni de verga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: Hacía fiestas, conocía gente nueva... eso sí que era la buena vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: Bueno, okey... Fui gerente de un almacén una vez. En un lugar de entregas. Gracias a mis viejos, sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: ¿Así que vives de tus padres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: ¿Eres un holgazán, entonces?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: ¿Para qué esforzarse, bro? Lo tengo resuelto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: ¿No aprovechar lo que tienes? Eso sería una tontería.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: O sea, si tienes un arma. ¿La vas a colgar en la pared o la vas a usar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: Exacto. No soy tonto. Uso mis ventajas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: Oye, tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: Si tienes envidia, solo dilo, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: Yo sé, no todo el mundo se saca la lotería. Así es la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: Eh, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: ¿Hay algún problema?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: Bro... ¿y tus películas? No tienes, o sea, no veo ni una sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: ¿Acaso ves algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: Me muero de aburrimiento aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: No es hora de ponerse a ver pelis
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: No tengo ninguna.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: Nah, man, pensé que este lugar estaría genial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: ¿Pero tu gente? Nah, puro rarito. Y no hay nada que ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: Ni revistas, ni pelis... solo libros...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: ¿Quién diablos lee, bro? ¡Eso es de la edad de piedra! Puro bla bla blá y descripciones sin fin. Qué fastidio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: Esto no es una sala de cine
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: ¿Estás aquí para divertirte o para sobrevivir?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: ¡Espera, ¿qué?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: Bro, nah, no puede ser. ¿Esto es en serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: ¡¿Tienes una TV en tu cuarto y ni una maldita película?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: Bro, esta fiesta apesta. Pensé que serías chévere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: Esto no es una sala de cine
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: ¿Estás aquí para divertirte o para sobrevivir?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: Nah, bro, por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: Eres el más aguafiestas que he conocido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: Si quieres sobrevivir, cálmate
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: Si no te gusta este lugar, te puedes ir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: Nah, bro, por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: La tele se me quemó en casa. Esperaba que me salvaras de morir de aburrimiento, pero nooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: Eres el más aguafiestas que he conocido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: Si quieres sobrevivir, cálmate
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: Si no te gusta este lugar, te puedes ir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: Bien, como sea, bro. Este lugar apesta, pero es mejor que las calles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: Solo... déjame ver la tele, bro. Solo un ratito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: ¡Lo sabía! ¡Eres un aguafiestas!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: Me largo de aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: Pobrecitos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: ¿Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: Sí, supongo... No sé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: No... no entiendo cómo adultos hechos y derechos, racionales, dejan que sus emociones los lleven a hacer algo así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: ¿Tan aterrados están que incluso matarían a un niño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: Hoy en día, la gente hace cosas peores
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: En el caos, la razón es lo primero que se pierde
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: ¿Qué podría ser peor que matar a un niño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: No fue solo una persona... fue una multitud, una turba, con su cacería de brujas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: Quizás los tiempos difíciles realmente muestran quiénes somos por dentro. Quizás somos los verdaderos monstruos, no los que vinieron de la tierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: Pero, ¿la gente no se da cuenta de que matar niños es...? Ni siquiera encuentro las palabras...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: Quizás los tiempos difíciles realmente muestran quiénes somos por dentro. Quizás somos los verdaderos monstruos, no los que vinieron de la tierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: Pobrecitos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: ¿Desde cuándo eres maestra?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: Por unos tres meses antes del cataclismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: Pero... no fui una maestra modelo. No me gustaba el trabajo. En ese entonces, los niños me parecían ruidosos y agotadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: El cataclismo cambió eso. Me abrió los ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: Mira, cualquiera de esos chicos podría haberse vuelto una estrella de rock, un político, un padre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: Pero ahora, nunca sostendrán una guitarra, nunca irán al colegio, nunca crecerán.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: Solo serán para siempre... un ejército de soñadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: Recuerdo el día que uno de los niños entró corriendo. Llorando, diciendo que sus padres le tenían miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: Creían que era un Visitante y... lo echaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: No sabía a dónde más ir, así que vino a mí... al jardín de niños.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (La mujer, apenas conteniendo las lágrimas, llora)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: Perdón...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: Pobrecitos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: Siento lo de ayer, no quise molestarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: Está bien. Estoy... ya estoy bien. Me siento mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: Sobre el niño del que te hablé... Después de él, entendí lo indefensos que son los niños. Especialmente cuando todo se viene abajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: Empecé a acoger a cada "marginado" y alma desamparada que pude.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: Escuché sus historias... Era insoportable oír cómo algunos padres los abandonaron sin dudarlo un instante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: Como si el cataclismo fuese solo una excusa para renunciar a un hijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: Quizá... nunca quisieron tener hijos en primer lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: Pobrecitos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: ¿Tuviste hijos propios?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: No, yo... Mi madre solía decirme que sentara cabeza, que tuviera un hijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: Pero no estaba lista. Quería que fuera una elección consciente, cuando el momento se sintiera correcto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: Escuchando todas esas historias de los niños abandonados... No pude evitar preguntarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: Si hubiera escuchado a mi madre, a lo mejor habría terminado igual que sus padres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: Fue por eso que decidí ayudar a cada niño abandonado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: ¿Sabes qué es lo peor? Uno de los pirómanos era padre de uno de los niños que acogí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (La mujer no puede reprimir el llanto otra vez)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: Perdón...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: Yo... Yo en verdad traté de darles una buena vida. Los cuidé. No debió terminar así...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: Lo siento tanto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: No eres culpable por sus muertes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: Siento mucho tu pérdida
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: Quizá tienes razón. Pero... aún me siento tan vacía por dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: ¿Sabes qué idea no puedo quitarme de la cabeza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: ¿Y si sus padres jamás sintieron algo por ellos? ¿Y si nunca los quisieron de verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: Solo... espero haber logrado que sintieran siquiera un poco de amor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: Gracias... pero todavía me siento rota. No creo que jamás supere esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: ¿Sabes qué idea no puedo quitarme de la cabeza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: ¿Y si sus padres jamás sintieron algo por ellos? ¿Y si nunca los quisieron de verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: Solo... espero haber logrado que sintieran siquiera un poco de amor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: ¿Qué más necesitas que este gatito de aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: ¿Por qué estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: Qué pregunta tan tonta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: Tú abriste la puerta. Pregúntate para qué. ¿Para qué estoy aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: A mí me da igual, un lugar es un lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: Me dijeron que viniera para acá, así que vine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: No quiero nada de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: Lo que importa es que este lugar sea cómodo para mí. ¿El resto? A quién le importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: ¿Qué más necesitas que este gatito de aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: ¿Siquiera eres humana?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: ¿Y tú?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: ¿Siquiera te queda algo de eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: ¿Qué tengo de malo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: ¿Qué más necesitas que este gatito de aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: ¿Quién te envió aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: Ya hiciste lo que se supone que tenías que hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: ¿Para qué preocuparse por lo demás?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: Está bien, mira, vine porque... alguien me envió aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: Pero no me dijeron qué tenía que hacer después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: ¿Qué más necesitas que este gatito de aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: ¿Cuánto tiempo piensas quedarte aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: Hasta que vengan a buscarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: ¿Qué más se supone que haga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: No sé. Me dijeron que hiciera algo y ahora espero hasta que me digan más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: ¿Y a ti quién te dice qué hacer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: ¿A quién estás esperando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: ¿Qué más necesitas que este gatito de aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: ¿Por qué no me has matado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: Eres algo tonto, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: Siempre es lo mismo, todos los días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: Ya te dije que no me dijeron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: Yo espero. ¿Por qué esperas tú?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: Que calor hace aquí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: ¿Estás bien? ¿Cómo está la niña?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: Sí, sí... Está... está cansada, igual que yo. Y es tímida con la gente nueva, por eso se me pega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: A los niños les cuesta manejar cosas así. Aunque no se quejen, se les nota en la cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: A veces siento que es mi culpa por arrastrarlos a todo esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: Pero ya es muy tarde para cambiar algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: Cariño, ¿por qué esa cara larga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: ¿Por qué estaban en la calle?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: Oh, solo íbamos a visitar a la madre de mi querida esposa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: Nos dimos cuenta a tiempo de que no lo lograríamos solos y, bueno, encontramos tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: Gracias por dejarnos estar aquí, por cierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: Cariño, ¿por qué esa cara larga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: ¿Qué tan lejos tienen que ir?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: Mi cielo no se ubica bien por esta zona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: Si nadie nos ayuda, ¿entonces quizás dos días?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: Después de perdernos algunas veces, seguro averigüamos el camino. ¡Já! ¿Verdad, linda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: Aunque si alguien nos lleva, sería lo ideal y entonces sería solo un par de horas como máximo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: ¿Por qué quieren visitar a su madre de repente?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: Este es el peor momento para viajar así
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: Cualquier cosa pudo haberle pasado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: El teléfono de su madre está apagado. Llevamos días sin poder comunicarnos con ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: Tenemos que asegurarnos de que esté bien, quizás necesite ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: Y las noches son más cortas ahora. Es un poco aterrador andar por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: Pero está bien, pronto veremos a tu madre, ¿cierto, cariño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: No recuerdo el camino y mi esposa siempre se va por la dirección equivocada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: Pero no importa. Lo único que importa es seguir adelante, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: ¡Quizás lleguemos en una semana! ¡Jajajaja!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: Cariño, ¿por qué esa cara larga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: Pensé que se iban esta noche
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: Mira, es que mi tontita esposa se tardó tres horas enteras en arreglarse y ya era muy tarde para salir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: Así que iremos más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: Para la próxima, seremos más rápidos. De verdad, disculpe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: Me aseguraré de que esta lenta dama no nos retrase de nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: No estamos molestando mucho, ¿verdad? ¡Disculpe otra vez!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: Cariño, ¿por qué esa cara larga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: Señorita, ¿está bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: Ella está bien. ¿Por qué le pregunta a ella?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: Yo soy quien le está hablando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: Solo está un poco nerviosa, eso es todo. Nada de qué preocuparse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: Le pregunté a ella
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: Bueno, ¿y cómo están?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: Está cansada. No la presione, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: Honestamente, creo que dejó de importarle su madre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: Pero está bien. Esta tortuguita se moverá tarde o temprano, e iremos a ver a su madre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: ¡Si es que sigue viva, ja-ja!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: Vamos, cariño, arréglate ya. ¿Hasta cuándo tengo que esperar? ¡Mierda!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: Ah, en general todo está bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: Parece que a mi querida no le importa un carajo su propia madre, jaja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: Quizás deba darte un pequeño empujón, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: Lamento que tenga que escuchar esto. Solo me está volviendo loco con su lentitud.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: Siéntate y arréglate, ¡estoy jodidamente harto de esperar! ¡Mierda!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: Cariño, ¿por qué esa cara larga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: Su esposa no quiere irse. ¿Qué está pasando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: Me está haciendo enojar, la maldita, ¿me entiende?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: Siempre quejándose, siempre culpándome.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: O sea, solo cállate y haz lo que digo. Pero no, nunca es tan sencillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: Lamento que nos hayamos quedado de más, de verdad. Este es el último día. Ya nos vamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: ¿Me oyes? Prepara tus malditas cosas. Si seguimos aquí de noche, juro que te voy a lanzar por la maldita ventana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: Señorita, ¿está segura de que está bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: ¿Qué está pasando aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: No se meta en esto, por favor. Ya se lo dije.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: No te metas. No es asunto tuyo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: Ya lo resolveremos, no me fastidies.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: Ya me harté de esta mierda, dime la verdad, YA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: No me importa. ¿Se van o no?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: Mira, amigo, ya dije que todo está bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: Mi esposa solo está aburrida, por eso se porta mal. Es una fastidiosa, pero ya qué.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: ¿Qué quieres de mí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: Ya me harté de esta mierda, dime la verdad, YA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: No me importa. ¿Se van o no?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: Eh, tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: Tengo un arma en la mano. Si intentas algo, le disparo a esta perra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: No tengo nada que perder. ¿Y tú?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: Vas a morir de todos modos
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: Todavía puedes solo irte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: Sí, sí, no nos quedaremos más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: Nos vamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: ¿Me oye? Esta es nuestra última noche aquí. Prepárate de una maldita vez y deja de perder el tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: ¿Qué tengo que perder? Sí, sí, me matas, ¿y luego qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: Al menos el sufrimiento termina. Y si esta perra muere conmigo, estaré satisfecho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: Voy a disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: Relájate. Baja el arma y yo haré lo mismo con la mía...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: ¿Por qué? Necesito irme con ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: Sin ella, no me voy. Así que baje su arma. Nos vamos esta noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: Nadie tiene que salir herido, si solo lo deja pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: Voy a disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: Relájate. Baja el arma y yo haré lo mismo con la mía...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: ¿De verdad vas a dispararle a una mujer? ¿No te importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: Si me disparas, le darás a ella también. Su sangre estará en tus manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: ¡No sería mi culpa! ¡Su sangre estará en tus manos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: Disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: Advertir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: Mira, me tengo que ir. O nos vamos, o morimos los dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: No hay otra manera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: Si esta maldita perra no hubiese estado temblando como una maldita hoja y hubiese venido conmigo en primer lugar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: Todo esto es culpa tuya. ¿Me oyes? ¡Lo arruinaste todo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: Disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: Advertir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: ¿Vas... vas a bajar el arma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: Espera, no, ¿todavía vas a disparar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: ¡ESPERA! ¡NO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: Bi-bien. Nos iremos. Vamos a calmarnos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: ¿Verdad? ¿Sí nos iremos esta maldita noche, ah, perra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (De repente la mujer se suelta y el hombre le dispara)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (Reaccionas al instante y le disparas al hombre en la cabeza)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: (Parece que ambos se murieron... Al menos esto ya se acabó)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: (Qué pareja más rara...)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: De acuerdo, nos vamos. Ya. Solo déjanos agarrar algo para cubrirnos y nos habremos ido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: No volverás a vernos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: Espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: ¿Q-QUÉ ESTÁS HACIENDO?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (Disparas al hombre, dándole también a la mujer)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (Ambos caen, sangrando)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (La mujer se atraganta un momento, pero no puedes ayudarla)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (Ambos están muertos)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: ¿No lo entiendes? No hay de otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: O nos vamos, o nos vamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: ¡Oye! Agarra una sábana. Anda, vámonos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (Observas cómo los dos se cubren y salen de la casa)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: (Ves cómo caminan un rato, pero de repente se desploman)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: (Empieza a salir humo de la sábana... Te das la vuelta)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: Todo saldrá bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: ¿Todavía te sientes animado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: No exactamente animado... pero tampoco me estoy desmoronando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: Seguimos siendo humanos. Aguantando todavía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: No estamos empeorando la tormenta más de lo que ya está.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: Y cuando todo esto termine... creo que nos perdonaremos por lo que hicimos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: Mientras haya compasión, hay humanidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: ¿Me sigues?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: Todo saldrá bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: ¿Siempre has sido así?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: La verdad es que no, no siempre, al menos... Antes siempre me enojaba. Con las personas, con el mundo, conmigo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: Me molestaba por cualquier cosa, era pasivo-agresivo y hasta lanzaba las puertas con tanta fuerza que se rompían. Hasta que me di cuenta de que la ira solo te destruye.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: Primero a ti, por dentro. Luego a lo que te rodea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: Una vez... ataqué a alguien que solo quería ayudarme. Y ahora él... ella... ya no está.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: Ese día, algo se rompió dentro de mí. Supe que si no cambiaba... iba a destruir todo lo que tocara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: Así que aprendí a soltar. A respirar. A reconciliarme. Así llegué hasta aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: Todo saldrá bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: ¿Qué fue lo que perdiste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: A mi familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: Nuestra casa se incendió justo cuando yo salí a buscar agua; me fui solo unos minutos, pero cuando regresé, todo era humo y cenizas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: Me tomó mucho tiempo aceptarlo. Me seguía preguntando: ¿por qué me fui en ese momento? ¿Por qué no pude salvarlos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: Pero quizás ese no sea el punto. Quizás no se trate de aferrarse al pasado, sino de aprender a vivir con él.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: Ellos siguen conmigo, en cierto modo. Su memoria me fortalece. Por eso intento ayudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: Sé lo que es perder. Y sé lo que significa encontrar un propósito después de que todo se viene abajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: Todo saldrá bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: ¿Y entonces te las arreglas para vivir sin tu familia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: Sí, lo superé, pero no fue sencillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: Me culpé por mucho tiempo. Creía que si hubiera vuelto unos minutos antes, quizás las cosas habrían sido diferentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: Pero el duelo se alimenta de la culpa. Y la vida... la vida necesita perdón. Me di cuenta de que si no lo soltaba, me perdería a mí también.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: El perdón. Eso fue lo que me salvó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: Me perdoné por no poder cambiar el pasado. Incluso perdoné al destino, por cruel que fuera. Porque la ira solo me estaba arrastrando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: Todo saldrá bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: ¿Entonces qué te impulsa ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: Creo que la gente puede ser mejor. Incluso en este caos en el que vivimos, siempre hay una oportunidad de levantarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: No creo en milagros ni en la providencia. Creo en la gente. En cómo nos ayudamos unos a otros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: Siempre hay quien levanta al que cae. Quien sonríe en un mal día. Quien comparte su último trozo de pan. De eso se trata la vida, de las pequeñas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: Cada vez que alguien hace el mundo un poco mejor, sé que nada de esto fue en vano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: Todo saldrá bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: ¿Desearías recuperarlo todo? ¿Tu hogar, tu familia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: Si pudiera verlos de nuevo... hablarles, abrazarlos... Lo haría, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: ¿Pero traerlo todo de vuelta? No estoy tan seguro. La pérdida es parte de la vida. Es terrible, duele, pero nos moldea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: Claro, daría casi cualquier cosa por un día más con ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: ¿Pero si significara renunciar a lo que he aprendido? A perdonar, a seguir adelante... No. No lo haría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: El tiempo es limitado. Es mejor aferrarse a lo que tenemos ahora que ser consumidos por lo que hemos perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: Mantente alerta. Cualquiera de nosotros podría ser un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: Eres cazador, ¿verdad?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: Más bien un guardabosques, muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: Vivía en el campo. Sin tele, solo radio. Así me enteré de lo que pasaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: Opté por no dejar a nadie entrar. Mi casa es mi fortaleza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: ¿Y si uno de ellos resulta ser un Visitante, me engatusa y luego me corta la garganta mientras duermo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: ¿Entonces por qué estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: No es seguro estar solo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: Ni loco dejo que ese bastardo alto y pálido me ponga las manos encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: Él es la razón por la que dejé mi cabaña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: Se te nota en la mirada, tú también lo has visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: ¿Cómo sobreviviste ahí afuera tú solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: ¿Tú también viste al visitante alto y pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: ¿Crees que ya no lo había calculado, genio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: Si no, ya sería alimento para gusanos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: Antes creía que era tonto dejar entrar a extraños.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: Creí que estaba más seguro solo. Luego apareció ese monstruo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: Nunca había visto a una bestia así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: ¿Cómo sobreviviste ahí afuera tú solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: ¿Tú también viste al visitante alto y pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: Oh, muchacho... eso es un cuento largo. No estoy de humor para hablar hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: Si me traes una cerveza mañana, te cuento todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: Así que no soy el único.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: Sí... Ya veo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: Ay, muchacho... Si supieras por lo que he pasado...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: Hablaré. Pero no esta noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: Tráeme una cerveza mañana, te lo contaré todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: Mantente alerta. Cualquiera de nosotros podría ser un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: ¿Y bien, cuál es la historia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: ¿Trajiste la cerveza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: Sí (Darle la cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: ¿Qué? ¿No hay cerveza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: No (No darle una cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: Con eso basta, muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: Como dije, estaba encerrado en la cabaña, en lo mío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: Entonces un día aparece este tipo. Sin aliento, desesperado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: Comenzó a golpear la puerta, rogándome que lo dejara entrar. Pero algo no andaba bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: Se veía pálido, tembloroso, como si hubiera visto la muerte. Ni idea de cómo se adentró tanto en el bosque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: No parecía ningún senderista. Así que le dije que se fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: Quiso romper la ventana, pero le grité que tenía un rifle. Eso lo ahuyentó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: Creí que nunca lo volvería a ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: Quizá debiste ayudarlo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: Debiste dejarlo entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: ¿Qué quieres decir con "creí"?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: ¿Y traer lo que sea que lo persiguiera directo a mi puerta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: No, gracias. Ya tengo suficientes problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: Bueno
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: No eres de hablar mucho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: No contaste gran cosa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: Déjame adivinar. ¿Hablarás más si hay cerveza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: No finjas ser un héroe, muchacho. Seguro tú también has rechazado a unos cuantos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: De otro modo, no habrías llegado tan lejos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: Pero esa es una historia para mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: Bueno
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: No eres de hablar mucho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: No contaste gran cosa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: Déjame adivinar. ¿Hablarás más si hay cerveza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: Estaba seguro de que nunca lo volvería a ver. Pero después... me encontró.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: Pero lo dejaré para después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: Bueno
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: No eres de hablar mucho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: No contaste gran cosa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: Déjame adivinar. ¿Hablarás más si hay cerveza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: Si me traes algo de cerveza mañana, terminaré la historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: No soy muy hablador.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: Considera una suerte que siquiera hablé, muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: Si me traes esa cerveza mañana, te cuento lo demás. ¿Trato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: Ten paciencia, muchacho. He visto cosas muy jodidas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: No es el tipo de cosa que quiera recordar sobrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: Trae la cerveza y hablaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: Eres astuto, te lo concedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: No hablo a menos que sea importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: Así que, mañana tráeme esa cerveza y te contaré cómo termina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: Lo siento, pero no hablo sobrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: Trae la cerveza y luego hablamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: Mantente alerta. Cualquiera de nosotros podría ser un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: Entonces, ¿cómo terminó todo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: Te contaré, pero primero, la cerveza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: Claro (Darle la cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: ¿Qué? ¿No hay cerveza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: No (No darle una cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: Ahora sí nos entendemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: Bueno, el tipo se largó y yo me quedé en la cabaña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: Pero luego me quedé sin leña. Tuve que ir a buscar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: Recogí un montón, regresé... y el rifle ya no estaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: Eso me inquietó. Revisé todo el maldito lugar, pero simplemente se había ido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: Entonces... lo vi por la ventana. Era el mismo tipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: Tenía mi rifle... pero había cambiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: Era más alto, tenía la piel flácida. No llevaba nada más que unos pantalones.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: Agarró el arma con las dos manos... y la partió en dos como una ramita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: Luego, solo se quedó allí parado. Mirándome. Como si esperara a que parpadeara para... romperme el cuello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: Pero no lo hizo. Solo siguió observando. Como si fuera una extraña competencia de miradas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: Y entonces... comenzó a amanecer y el tipo espeluznante solo desapareció.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: Fue ahí cuando caí en cuenta: ¿quedarme solo sin un arma? Sería un suicidio, muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: Así que salí corriendo; me fui antes de que el sol terminara de alzarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: Así fue como terminé aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: Solo espero que tengas la oportunidad de cobrar vidas, muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: Quién sabe, tal vez las balas funcionen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: ¿Por qué no te mató?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: ¿Crees que es posible matarlo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: Eliminó a un escuadrón entero
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: No lo sé, muchacho. Rompió un rifle sólido como si nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: Pudo haberme hecho lo mismo en un instante... pero no lo hizo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: Quizás solo disfruta jugando con nosotros. Como un gato con un ratón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: Mira, casi nada me da miedo. ¿Pero ese maldito bastardo pálido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: Ese tipo sí me da miedo, muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: Me gustaría pensar que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: Ya sabes lo que dicen... "lo que sangra, se puede matar".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: Si un escuadrón entero no pudo derrotarlo... no tenemos ninguna posibilidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: Si quiere, destrozará este lugar como si fuera papel de seda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: Mira, casi nada me da miedo. Pero, ¿aquel bastardo alto y pálido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: Ma da miedo, muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: Sin cerveza, no hay historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: No diré nada estando sobrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: Así que si quieres el resto... tráeme una cerveza, muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: Si solo hiciera un poquito más de c-calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: ¿Te quedas con la chaqueta puesta?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: S-sí. Hay algo que me inquieta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: ¿Qué pasa si me la q-q-quito? No logro calentarme, ni con el calor de a-ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: Si me quito la chaqueta, ¿me moriré de f-frío?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: O peor. Seguiré vivo, pero sentiré aún más f-f-frío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: ¿No estás sudando debajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: ¿Así que no te bañas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: N-no...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: El cuerpo suda al intentar e-enfriarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: P-pero creo que no puedo tener más frío...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: P-perdón, pero no voy a r-responder eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: Si solo hiciera un poquito más de c-calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: ¿Tienes idea de cómo normalizar tu temperatura?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: No creo poder cambiar e-esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: El agua hirviendo q-quema. No ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: ¿Sabes...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: Se me ocurrió una m-m-metáfora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: Imagina el espacio profundo. I-inmenso y helado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: Nacen galaxias. Las estrellas c-colapsan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: Y yo solo observo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: Nunca sentiré el calor d-d-del s-sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: O el c-calor de un abrazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: No creo que ni el espa-pacio ni la sociedad me necesiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: Si solo hiciera un poquito más de c-calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: Dijiste que tenías algo que revelar cuando nos conocimos. ¿Qué era?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: Mmm. No estoy seguro de q-querer hablar de eso ahorita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: He tenido algo en mente... por m-mucho tiempo. Quizás sea por eso que me siento tan... frío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: No quiero ni mencionarlo, pero el anhelo me está c-consumiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: T-te lo diré mañana. Creo que estaré listo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: Si solo hiciera un poquito más de c-calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: Entonces, ¿qué estás escondiendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: Sí. Quería c-contarte un secreto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: Creo que estoy listo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: Usualmente esto no termina b-bien. Pero quizá esta vez no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: Bajo esta r-ropa está... creo que e-está la razón del f-frío y la soledad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: Mira'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: No... Otra vez n-no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: ¿Pero qué hiciste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: Estás bien jodido
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: No, n-n fue mi i-intención.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: Creí que sería d-d-diferente aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: Nunca lo e-es.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: Yo no quería esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: Te lo j-juro, no quería.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: Disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: Echar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: Esto mismo ya p-pasó antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: ¿Por qué creí que esta vez sería d-diferente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: No s-seas impulsivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: No hice esto por m-malicia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: No era lo q-que quería.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: Disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: Echar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: Quizá eso sea lo m-mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: No más f-f-frío. No más soledad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: Solo que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: No creas que lo hice a p-propósito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: ¿Ahora mismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: Una b-bala sería más amable. Tristemente, todavía p-puedo sentir dolor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: El Sol t-tardará más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: ¿Puedo al menos quedarme hasta el a-anochecer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: ¡Fuera!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: Bien, solo no intentes nada.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: Entendido'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: Lo s-siento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: Quizá el Sol m-me caliente. Una última vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: G-Gracias'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: Sé que me odias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: Pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: Lo s-siento. Yo no quería esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: Y... um... ¿quizás podrías invitar a mi amiga a venir? Por fis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: Si la invitan los mayores, la dejan venir... pero si la invito yo, siempre me regañan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: Creo que este es su número: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: Ay, cariño... Por favor, no dejes entrar a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: ¿Por qué la AFAE la desalojó en lugar de llevársela?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: ¡Qué demonios voy a saber, cariño! A esos tipos de traje... quién los entiende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: Siempre de aquí para allá, dando órdenes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: ¿Quiénes se creen que son, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: Apuesto a que no saben una mierda, solo actúan con aires de grandeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: Dime, ¿también han estado tocando a tu puerta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: Uno de ellos sigue rondando cerca
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: ¡Malditos bastardos! Deberían arrancarles esos trajes y echarlos directo a los corrales de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: Que vean lo que es estar entre la gente de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: ¿También están acechando las casas ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: Salvajes, lo juro por Dios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: Una vez, está bien. Pero regresar una y otra vez...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: No tienen ninguna vergüenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: Ay, cariño... Por favor, no dejes entrar a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: ¿Se llevaron a alguien de su familia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: Ohh. Nadie me ha preguntado por mi familia en mucho tiempo, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: Me dicen "la gran madre" porque di a luz a un montón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: Benditos sean...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: Apenas cabemos en la casa ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: Tras las puertas de esa casa, los pobrecitos están escondiéndose de esa gente rara del demonio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: No me respondiste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: ¿Así que se llevaron a su familia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: Me dejé llevar, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: Sí. Esos bastardos de traje se llevaron a cada uno de los míos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: Pero no se saldrán con la suya, no señor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: ¿A ti te han quitado a alguien?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: No tengo familia
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: Me dejé llevar ahí, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: Sí. Esos bastardos de traje se llevaron a cada uno de los míos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: ¿Te quitaron a alguien?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: No tengo familia
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: ¿Ah, no? ¿Y por qué tu casa es tan grande?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: Viviendo aquí tú solito. Eso no está bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: Casa grande significa familia grande, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: Está bien, no voy a insistir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: Solo desearía sacar a los míos de esas zonas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: A ti no te tocaron, ¿cierto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: ¿Entonces dónde está tu gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: Un lugar tan grande como este no fue construido para una sola persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: Está bien, no voy a chismear.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: Solo quiero a los míos fuera de esa maldita zona...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: Ay, cariño... Por favor, no dejes entrar a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: ¿Cómo planeas recuperar a tu familia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: No los voy a ayudar, cariño. Ellos saldrán solos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: ¿A qué te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: ¿Solos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: Se arrastrarán de vuelta por la tierra. Saldrán del suelo, pero por el otro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: Esas estúpidas cercas y cables no detendrán a mis bebés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: Y si no pueden salir de abajo, destrozarán esa zona. No dejarán a nadie, benditos sean.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: Ya vienen. Los puedo escuchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: ¿De qué diablos estás hablando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: ¿Te volviste loca?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: ¿A qué te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (Mátala)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: Los muros cederán, cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: Habrá muerte, tanta muerte... y él vendrá, hambriento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: Y entonces, a esos de los trajes ya no les importarán los míos. Tendrán problemas más grandes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: Ya vienen. Los puedo escuchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: ¿De qué diablos estás hablando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: ¿Te volviste loca?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: ¿A qué te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (Mátala)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: Derribaremos esas madrigueras que construyeron...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: Romperemos las paredes... y las calles se teñirán de sangre... haremos montañas con todos sus cadáveres...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: Los oigo arrastrándose. Ya casi llegan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: ¿Qué significa eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: ¿Eres una Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (Mátala)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: La carne quemada huele tan bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: Los trajes se cocinan bien. Puede que un pelín demasiado crujiente. Pero no está mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: Tienes cuerpos, cariño. Muchos. De sobra para un gran festín. Los míos comerán bien aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: Los oigo arrastrarse. Ya casi están aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: ¿Qué significa eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: ¿Eres una Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (Mátala)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: Esta casa es un buen lugar. Es especial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: Una casa grande, casi sin gente. Hay lugar para todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: Los oigo arrastrarse. Ya casi están aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: ¿Qué significa eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: ¿Eres una Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (Mátala)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: Pequeño inútil de mierda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: Vendrán por ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: Hijos, mami ha encontrado un nuevo nido. '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: Arrástrense, él ya no necesita esta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: Mamá quiere ver a sus bebés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: Vamos, esta casa es buena para nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: Vengan, hijos míos. Mami está aquí. Les encontré un nuevo hogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: Es muy espacioso, y tiene espacio de sobra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: ¡Maldita sea! Entréganos esta casa. La odias de todos modos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: Quieren que arda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: ¡DÁMELA, CARIÑO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: Bendito seas... Sé lo que quieres...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: Muerte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: ¿Tienes algo que decir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: ¿Por qué ves a las personas como animales?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: Déjame preguntarte algo. ¿Qué somos, en realidad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: Matamos, comemos lo que matamos y no nos quita el sueño. Así es la naturaleza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: Pero la sociedad nos puso una correa. Por suerte, esos días acabaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: ¿A qué te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: ¿Estás feliz con cómo resultaron las cosas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: Es simple. Las absurdas normas de la sociedad desaparecieron. Ahora, todo está claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: Hay una manada. Y hay un líder. Cualquiera que amenace la supervivencia de la manada muere. Ese es un código que respeto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: ¿Pero lo peor de lo peor? Son las ovejas con piel de lobo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: ¿Crees que una manada es mejor que la sociedad?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: ¿Te refieres a lobos con piel de oveja?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: Solo me alegro de que la gente dejara de esconderse tras máscaras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: Pero esas ovejas arruinan todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: Se ponen pieles de lobo y fingen. Fingen los instintos de un hombre de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: Cobardes, cavando agujeros en la tierra. Preferiría una pelea directa cualquier día a este juego del gato y el ratón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: Pero si formaste una manada, entonces habrás aprendido a reconocer a los impostores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: ¿Crees que una manada es mejor que la sociedad?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: ¿Ovejas con piel de lobo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: ¿Te lo estás dudando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: En la sociedad de antes, jamás habrías detectado a una de esas ovejas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: Demasiada charla, demasiadas reglas. Estarías enfrascado en debates en vez de hacer lo que hay que hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: Por eso un líder es esencial. Sin preguntas, sin votos. Su palabra es ley.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: Un líder debe demostrar fuerza. Esa es la única forma en que una manada sobrevive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: En realidad, hablo sobre esas escorias cobardes a las que llaman Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: Se ocultan bajo tierra como ratas, esperando que nos debilitemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: Ahora usan la moral humana. Juegan con nuestra piedad para que sea más difícil matarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: Por eso tenemos que enseñar los colmillos, recordarles que somos bestias, o nos desplazarán.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: ¿Tienes algo que decir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: ¿Por qué estás mirando mi arma?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: Veo un líder en ti. Mantienes a todos a raya, has demostrado que estás a cargo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: Tienes un buen lugar. La gente viene seguido. Es una casa grande, pero tus inquilinos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: ¿Qué pasa con ellos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: ¿Crees que algunos de ellos son Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: Has juntado a debiluchos. Tipos blandos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: Dime, ¿de qué sirven los viejos, los niños, o los enfermos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: Una manada debe estar hecha de los fuertes. Así es como se sobrevive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: Entonces, ¿qué quieres que haga?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: ¿Quieres que los eche?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: El problema no son las ovejas disfrazadas de lobo. Son los lobos débiles lo que me preocupa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: Tu manada no tiene carácter. La gente viene y se va a placer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: Escoge a los más fuertes. Quédate con ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: Entonces, ¿qué quieres que haga?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: ¿Quieres que los eche?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: Tienes que deshacerte de los débiles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: Mátalos. En público. Que sea un mensaje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: Así es como mantienes el control. Así demuestras quién manda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: Y aquellos que no se inmuten cuando mueran los débiles... esos son tus verdaderos lobos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: Esos se quedan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: No soy un asesino
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: Solo mato Visitantes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: Déjalos en paz y tu autoridad se desmoronará. Te llamarán blando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: La compasión es solo debilidad disfrazada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: Tienes que ser implacable. ¿Visitante? Dispara. ¿Débil, enfermo, viejo? Igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: Así es como les infundes miedo. Así es como lideras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: No soy un asesino
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: Solo mato Visitantes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: ¿A quién intentas engañar, tesoro? Lo veo en tus ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: Has matado. A sangre fría. Así que no pretendas tener las manos limpias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: Yo solía dominar las calles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: La gente me temía. Me respetaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: ¿Te has preguntado alguna vez cuánto tiempo lleva corromper el alma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: Yo me tomé mi tiempo. Dejé que la podredumbre se propagara. '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: Un día, un taxista se negó a llevarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: Si hubiera dejado pasar eso, mi nombre no habría significado nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: Así que le rompí todos los huesos del cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: Pero su hijo aprendió la lección. Y la gente siguió respetándome.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: Déjame decirte algo: Te iría mejor si dejaras de consentir a los débiles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: Yo solía dominar las calles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: La gente me temía. Me respetaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: ¿Te has preguntado alguna vez cuánto tiempo lleva corromper el alma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: Yo me tomé mi tiempo. Dejé que la podredumbre se propagara. '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: Un día, un taxista se negó a llevarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: Si hubiera dejado pasar eso, mi nombre no habría significado nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: Así que le rompí todos los huesos del cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: Pero su hijo aprendió la lección. Y la gente siguió respetándome.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: ¿Tienes algo que decir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: No dejas de hablar de manadas, ¿así que por qué no tienes la tuya?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: ¿Por qué formaste la tuya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: Para que ese Visitante pálido y alto no me mate
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: Estoy tratando de ayudar a la gente
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: Solo me gusta tener compañía
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: Porque necesitan un líder
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: Yo pregunté primero
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: ¿Así que los reuniste para salvar tu pellejo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: No suenas como un macho alfa. Suenas como un perrito asustado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: Esta manada necesita a alguien fuerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: Supongo que tendré que ocupar tu lugar. No eres apto para liderar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: Una meta noble. Aunque algo tonta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: No los salvarás a todos. Tarde o temprano, tendrás que dejar a alguien afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: Pero suenas como un macho alfa. Un verdadero hombre. No voy a desafiar eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: ¿Eso es todo? ¿Solo te da miedo estar solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: Esas no son palabras de un macho alfa. Esas son palabras de cobarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: Eso sí es algo que diría un hombre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: Entonces no cuestionaré tu liderazgo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: No responderé a eso. Cuanto menos sepas, mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: Ya dije más de lo que debía. Ahora te toca a ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: Si no sirves para liderar, yo mismo tomaré tu lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: ¡Vete al carajo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: ¿Qué te hace mejor que yo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (Sacar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: ¡Lárgate antes de que te vuele la cabeza!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: CÁLLATE, CACHORRO. Para mí, eres hombre muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: Si no sabes por qué lideras, ¿por qué aceptaste el puesto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: Deberías irte. O te mataré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: Sé lo que es una manada. Vivo bajo el código.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: Si eres tan blando, no eres un alfa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: Deberías irte. O te mataré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: Con que esas tenemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: Sabes que tambén tengo un arma, ¿verdad, imbécil?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: Más vale que bajes la tuya. Terminemos esto de forma limpia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (Dispararle)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (Baja el arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: Muere, maldito hijo de—'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: Bastardo... de verdad me disparaste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: Mmm... Buen chico...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: Pero debiste terminar el trabajo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: (Él aprovecha la oportunidad y saca su arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: (Te está apuntando)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: (Por suerte, logras agarrar la escopeta y disparar)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: ¿Así que te cortaste los hilos de la boca?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: ¡Isto es uma persiadillia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: ¡MI COSTURADON LA BUKA! Solso porco non mi entiemdíam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: No te entiendo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: ¿Entiendes algo de lo que te digo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: Non ti entemdio. ¿Qui possiemos fasser?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: ¿Criarmos uma spicie di lengua qui bambos entemdiamos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: ¿Cómo se supone que nos comuniquemos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: Puesso repeter lo qui disse y vos reatzhiognas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: Alomeyór assim alminoz saiber lo qui ió stou dissendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: ¿Cómo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: ¿Cómo qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: ¿Quieres preguntar algo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: Taindabía non ti entemdio. Paros mi perguntaxtes aigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: Alomeyór bije uma palavra qui soana a pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: Taindabía non ti entiemdio. Paros mi perguntaxtes aigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: Alomeyór bije uma palavra qui soana a pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: Oye, ¿cómo estás?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (Le das una palmada en el hombro y señalas las heridas cerca de su boca)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: ¿Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: ¿Te duele?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: ¿Puederías repeterlo for pavor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: Ghhh-oot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: Ghhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: Ghoodt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: Ses difficil, paros alomeyór sirba di aigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: Mi pergunto si em meu paeís stiará passando lo mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: Qui persiadillia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: ¿Cómo volverás a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (Juntas las palmas de tus manos sobre la cabeza, imitando la forma de un techo)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: ¿Ma khasa? ¿Stais pergumtamdo par meu paeís?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: Veni a visiter a um amigui quanto passó tudo isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: La situazone se uma merda, non ai outra horma di deissierlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: ¿Cómo se supone que te envíe a casa? ¿En avión?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: ¿Checaste los boletos para ir en barco?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (Bajas la mano en un movimiento amplio y de barrido)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: ¿Um aviao? ¿Credes qui ziggan vuelamdo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: Eberiba bere intemter aberigar in alcuna parta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: Alomeyór taindabía aia uma horma di idme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (Mueves la mano imitando un barco sobre las olas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: Cuomo... ¿id in um barca?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: ¿Ziggem funzionamdo? ¡Tembré qui aberigarlo, grasa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: ¿Por qué te ves tan contento?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (Sonríes, señalas tu sonrisa y luego la suya)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: Ah, ti refiríndas a isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: ¡Se les arreclarom pa'' dissierme qui los trenis ziggem operamdo! ¿Puesses crederlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (Mueve una mano a lo largo de su otro brazo)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: ¿Alguien te puede llevar a casa manejando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: Non ti entemdio, amigui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: ¡Nañama bolbo a khassa! O par laminoz ala stazioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: Mi vou sta nochi. '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: ¡Addiú!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: ¿Hablas del tren?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: ¿Te vas a alguna parte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: No entemdí, descuppa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: ¡Paros nañama idé a la stazióm, ¡da lo beré ió mesmo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: Alomeyór represe a ma khassa dispos di tudo ste tempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: ¡BUNNA SOURTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: Qué silencio tan sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: ¿Cómo está tu mano?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: Aunque late, no la siento. Solo el dolor y el frío persisten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: Pero es de esperarse. Deseo posponer el momento más exquisito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: Hubo una chica a la que adoraba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: Atesoré nuestro tiempo juntos. Nos sentábamos en silencio y aun así la entendía sin palabras. Fue entonces cuando lo comprendí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: Me miento a mí mismo. Nunca la conocí en realidad. Quizás solo deseaba creerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: Aun así, espero que algún día pueda comprenderla. De verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: Qué silencio tan sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: Cuéntame sobre esa chica
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: En sus ojos, siempre vi el frío resplandor de la luna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: Ella era la antítesis del Cataclismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: A su lado, me perseguía una inquebrantable sensación de misterio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: Y anhelo desentrañar sus secretos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: Ahora, ella es mi monumento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: El faro que me guiará cuando parta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: Qué silencio tan sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: ¿Cómo la conociste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: Llegó un momento en el que supe lo que me esperaba. La sepsis pronto acabaría conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: La idea me aterrorizó. Me di cuenta de que desaparecería. No en un futuro, sino en tan solo unos meses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: Y entonces, mientras los Visitantes se abrían paso a través de la tierra... la encontré en una de las casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: Una joven envuelta en lino blanco, con un rostro cautivadoramente hermoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: En este mundo cruel, donde los hombres solo se preocupan por sí mismos, nadie reparó en tanta belleza. Pero yo sí lo hice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: ¿Conoces el dicho? "Demasiado valioso para rechazarlo. Demasiado terrible para aceptarlo".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: Y aun así... sostuve su frágil cuerpo y la llevé a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: Cuando llegue el final, diré que todo lo que hice, lo hice por amor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: Qué silencio tan sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: ¿Dónde está esa joven ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: Pasé tanto tiempo intentando comprender su belleza. El poder de su silencio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: Pero entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: Hombres sin rostro, vestidos de amarillo, entraron de golpe en la sala.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: La apresaron, se la llevaron a rastras. Supongo que ambos sabemos por qué.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: Qué lástima... Nunca llegué a entenderla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: Intentar hacerlo ahora es como beber de un recuerdo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: Los hombres claman por salvar el mundo, pero no se ponen de acuerdo en cómo. La respuesta es sencilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: Está en el silencio. En la belleza. Si tan solo alguien pudiera... percibirla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: Ella intentó enseñarme. Pero todo lo que aprendí fue serenidad. A ver aquello que es hermoso dentro de lo terrible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: Al menos ahora... estoy listo para seguirla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: Vaya mundo en el que vivimos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: ¿Y ahora qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: ¿No es obvio? Parece que aún nos falta finalizar el contrato de alquiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: ¿Y cómo se supone que haga eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: ¿Es eso realmente importante ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: ¿Lo que quiere usted decirme es que no tiene siquiera los papeles a mano?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: Pues... le sugiero que se vaya a una notaría a recogerlos. En serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: ¿Estás bromeando? ¿Dónde se supone que voy a encontrar una notaría ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: ¿Por qué no vas tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: Con el debido respeto, apreciaría que se dirigiera a mí apropiadamente. Con decirme "señor" estará bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: Realmente, lo que son los modales hoy en día...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: Como tú digas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: ¡Vete a la mierda de una vez!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: ¿Sabe usar un mapa, no? No es tan complicado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: Y hágame el favor de dirigirse a mí con respeto, insisto. Para ti, soy "señor".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: Como tú digas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: ¡Vete a la mierda de una vez!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: ¿Y por qué, exactamente, debería ser yo quien haga los mandados? Y, por cierto, ¡use "señor" al dirigirse a mí!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: Soy un ciudadano respetable, no un mandadero cualquiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: Como tú digas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: ¡Vete a la mierda de una vez!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: ¿Está usted actuando intencionadamente, verdad? Al menos podría fingir que colabora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: Cuide su tono. El artículo 21 de la Constitución garantiza mi dignidad humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: Así que, le sugiero encarecidamente que empiece a mostrarme algo de respeto, antes de que la situación se torne... desagradable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: Vaya mundo en el que vivimos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: ¿Puedes solo dejarlo pasar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: Por supuesto que no. Está usted legalmente obligado a finalizar el contrato de alquiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: No tengo con qué finalizarlo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: Tienes que estar bromeando
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: Mmm. Qué lástima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: Me temo que esto podría constituir una violación del Artículo 131.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: Mira, ya me estás sacando de quicio
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: ¿No te cansas de recitar leyes todo el tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: Para su información, según el Artículo 131, el contrato es obligatorio. Soy un ciudadano responsable. Y tengo la intención de seguir la ley.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: Mira, ya me estás sacando de quicio
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: ¿No te cansas de recitar leyes todo el tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: Ah, sí. No podían faltar los insultos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: Eso, por cierto, entra dentro del Código Administrativo 5.61.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: Prosiga, por favor. Todo se le devolverá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: Y no. No me canso de referirme a la ley y a la Constitución.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: ¡Conozco mis derechos! Que sea usted un ignorante no quiere decir que los demás no tengan derecho a ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: ¡Y se lo repito! Ya le dije que se dirija a mí apropiadamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: De verdad que usted no aprende, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: Vaya mundo en el que vivimos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: ¿Y ahora qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: Me percaté de que tiene usted un arma de fuego. ¿Puedo ver su licencia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: Eso no es asunto tuyo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: ¿Cuál es tu problema conmigo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: Ah, ya veo. Si no tiene una licencia que mostrar, es que no la tiene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: ¿Cree que por tener un arma es usted la ley?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: ¿Que puede interrogar a todo el mundo y que a usted nadie le cuestione?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: ¡Está muy equivocado!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: Como dice el dicho, siempre hay un pez más grande.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: Ya basta. Ya tengo suficiente con lo que lidiar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: ¿Quieres dejar de decir estupideces?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: Solo estoy intentando averiguar quién es usted en realidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: Se está poniendo a la defensiva... Eso significa que di en el clavo. No tiene licencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: Cree que las reglas no son para usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: Cree que puede detectar amenazas, pero que nadie puede escudriñarlo a usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: Se equivoca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: Como dice el dicho, siempre hay un pez más grande.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: Ya basta. Ya tengo suficiente con lo que lidiar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: ¿Quieres dejar de decir estupideces?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: Ay, pobrecito. Nadie se atreve a cuestionarlo, nadie se atreve a revisar si es un Visitante. Qué horror, qué duro debe ser para usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: Y, ¿quién le dio exactamente la potestad para decidir quién vive y quién muere? ¿Quién le dio esa autoridad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: Los demás nos limitamos a sentarnos y a rezar para no ser los siguientes que decida eliminar. ¿Y ahora quiere compasión? ¿De mí? Estará de broma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: Oh, disculpe mi vocabulario. ¿Como si no fuera usted el que nos miente a todos con sus dichosos chequeos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: Husmeando por todos lados, tratando a todos como un asesino en potencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: Pero claro, no señalemos al verdadero asesino. Porque quizás... solo quizás... ni siquiera existan los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: ¿Y eso qué lo hace a usted? Un psicópata... Abusando de su posición, aprovechándose del caos para saciar su sed de sangre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: Y la gente? Escuchan el pánico en la radio y corren a su puerta como moscas al estiércol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: A ver, dígame, ¿cuántos de los que llegaron al principio consiguieron salir vivos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: Tal y como me imaginaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: Vaya mundo en el que vivimos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: ¿Señor? ¿Todavía está aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: Increíble... se dirigió a mí con respeto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: Lástima que sea demasiado tarde. Voy a denunciar esto pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: ¿Denunciar qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: ¿A quién?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: Ya no me puede engañar. Sé exactamente quién es usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: Esta no es su casa. Usted asesinó al dueño. Lo está suplantando. Y voy a contactar a AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: Así es, vendrán por usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: Qué estupidez
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: Ya es hora de que te calles la maldita boca permanentemente
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: La Agencia Federal de Gestión de Emergencias, o AFAE, para abreviar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: Al principio no le di mucha importancia al hecho de que ni siquiera podía completar un simple contrato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: Pero mientras más hablaba con usted, más claro quedaba todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: Ahora todo tiene sentido. Esta no es su casa. Usted es un impostor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: ¡Usted es un VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: Así que empaque sus cosas. Vendrán por usted. ¡Esta noche!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: Tonterías
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: Hora de que te calles de una vez por todas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: Oh, voy a reportar esto. Ya vendrán. Solo espere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: Sí, sí... Fuera de aquí
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: Estás muerto (sacar la arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: Intente silenciarme, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: ¡¿Espere—qué?! ¡¿Está usted loco?! ¡Eso es un delito penal!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: No, no, no. No se saldrá con la suya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: Me voy a quedar justo aquí hasta que llegue la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: Les contaré todo lo que ha hecho y lo peligroso que es usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: ¡¿Espere—qué?! ¡¿Está usted loco?! ¡Eso es un delito penal!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: ¡No se atreva!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: Será mejor que te vayas antes de que te dispare
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: Voy a disparar si no te vas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: No me dejas otra opción
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (Dispararle)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: No dejaré que se escape de la AFAE. ¡A menos que sea sobre mi cadáver!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: ¡Al final van a atraparle!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: ¡Pues yo tampoco tengo de otra!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: ¡ES UN VISITANTE! ¡UN ASESINO! ¡NO ES HUMANO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: ¡NO, ESTÁ EN CONTRA DE LA LEY!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: ¡¡¡AAAAAAAAAAHHH!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: Uff... sería genial tener un buen botín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: ¿Qué tal tu vida de saqueador?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: Mira, sí. Pensé que este lugar estaba desierto, así que intenté colarme... pero hay gente que vive aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: Yo no le robo a los vivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: O sea... Piénsalo: ¿qué va a hacer un muerto con una chaqueta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: Él ya no está. Sus cosas solo están ahí. ¿Y yo? Yo todavía respiro. Podría salvar mi vida. O la de alguien que me importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: Dime, ¿no le quitarías algo a un cadáver para salvar a un ser querido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: Quizá ya es hora de que dejar de tratar a cada muerto como si fuera una tumba sagrada. Solo digo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: Uff... sería genial tener un buen botín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: ¿Por qué empezaste a saquear?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: ¿Qué se supone que iba a hacer? No quería empezar a lastimar a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: Así que elegí el camino silencioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: Los muertos no se defienden, ¿sabes? Sus cosas son solo... lo que queda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: No estoy aquí para lastimar a nadie. Solo trato de seguir con vida. Quizá ayudar a unos cuantos más en el camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: Uff... sería genial tener un buen botín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: ¿Qué has encontrado mientras rebuscabas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: Uf, es que he visto tantas cosas que no podría ni contarlas todas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: A ver, déjame pensar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: Una vez encontré una biblioteca abandonada. Libros llenos de polvo aún en las estanterías como si alguien fuera a volver por ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: Entré a una exposición de arte de principiantes. Los cuadros seguían ahí, colgados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: Y una vez... vi una puesta de sol. No una cualquiera, parecía pintada en el cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: En estos días, nadie se arriesga a quedarse viendo el cielo. Pero antes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: Extraño cómo eran las cosas antes. Me levantaba muy temprano. Las calles estaban tranquilas. La neblina entraba bajo, el pasto todavía húmedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: Y el sol... uf, siempre tan brillante, como si te estuviera prometiendo un buen día.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: Ahora míranos. El sol es el enemigo. ¿Cómo pudo pasar eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: Ojalá alguien tuviera respuestas para toda esta mierda. A lo mejor así sería más fácil respirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: Uff... sería genial tener un buen botín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: ¿Ya dejaste de saquear?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: Todavía lo hago. Pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: Hubo una vez... sí, una vez que me afectó mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: Encontré esta casa, vacía. Había un cuerpo en el suelo, lo de siempre. Ninguna amenaza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: El tipo tenía agujeros por toda la espalda. Estaba acostado sobre algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: Se me ocurrió que a lo mejor quiso esconder algo, así que me acerqué, lo volteé y...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: Mira, te cuento después, ¿sí? No estoy preparado para revivir eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: Uff... sería genial tener un buen botín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: ¿Qué había debajo del cuerpo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: Está bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: Lo volteé y ahí la vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: Resulta que el tipo era una niña chiquita. Sin vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: Con los adultos... de alguna forma te lo esperas. ¿Pero una nena? Eso se siente diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: Cuando veo niños muertos, se me hace un nudo en la garganta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: Estaba agarrando un gatito de peluche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: Todo cubierto de sangre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: El rostro de la niña tenía una expresión... como si supiera que la muerte se acercaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: Por un segundo, juro que parecía asustada de que le quitara su juguete.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: Como si ni en la muerte, la crueldad de la gente no la dejara en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: Eso me afectó más de lo que me gustaría admitir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: Ese día, quise parar, quise dejar a los muertos en paz. Pero ya es tarde para eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: Todo lo que puedo hacer es seguir. Seguir saqueando. Es la única forma para mí de sobrevivir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: La gente dice que no puedes huir del destino. Supongo que es cierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: Ojalá esos Visitantes se vuelvan a meter bajo tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: ¿Por qué te hiciste sepulturero?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: ¿Ah? ¿Mi trabajo? Ni idea, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: El cementerio es como... como una biblioteca, ¿sabes? Pero esos libros no son para leer... Solo están ahí. Callados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: Antes sabía todo de cada tumba. Dónde estaba cada quién, cómo tenían las manos torcidas, qué traje llevaban, sus nombres...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: Y de repente un día estaba cavando un hoyo nuevo, ¿sabes? Un día normal, nada raro. Me parecía lo bastante profundo, y ¡bam! Vacío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: ¡Te juro que estaba vacío! Pero el documento decía que había alguien ahí. Un cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: Un tipo, muerto sin duda. Tenía bigote. Me acuerdo. Pero puf... se esfumó. Como el rocío en la mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: Así que... si un muerto desaparece... ¿es como si muriera otra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: Ojalá esos Visitantes se vuelvan a meter bajo tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: ¿Qué hiciste cuando encontraste la tumba vacía?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: Esperar... Me senté, justo en el borde. Miré dentro... nada. Pero luego miré hacia arriba y, a lo lejos... vi a alguien de pie ahí. Observando. Como en un funeral.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: No tenía ojos. Pero tenía unos dientes blancos como el demonio. Brillando. Sonriendo. Solo parado ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: Casi me cago encima, no te voy a mentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: Corrí. Rápido. En eso soy bueno. Aunque no me persiguió. Solo... desapareció, como si fuera humo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: Una mierda muy turbia... Ahí empezó todo este desastre de los Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: Ojalá esos Visitantes se vuelvan a meter bajo tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: ¿Para qué cavar si ya nadie entierra a los muertos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: Ya no cavo. Solo... estoy alerta, je. Pero, ¿Después de todo ese tema? Empecé a revisar las tumbas nuevas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: Con mucho cuidado. Sin hacer tonterías.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: Pensé que quizá uno de esos bichos se había enterrado por error. Llevaba mi pala como una espada. Listo para darle a lo que se moviera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: Pero nah... Todos los huesos estaban en su sitio. Los cuerpos no se movían. Nada salía arrastrándose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: Me puso a pensar... A lo mejor no son los muertos los que vuelven. A lo mejor los Visitantes son gente que debió ser sepultada... pero no lo fue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: Ojalá esos Visitantes se vuelvan a meter bajo tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: No has estado desenterrando tumbas nuevas, ¿no?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: ¿Yo? ¡Ni de broma! No soy estúpido. Mira... Llevo toda mi vida rodeado de muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: Antes, la muerte no me molestaba. Te mueres, te entierran. Punto final. ¿Ahora? ¿Quién queda para enterrarte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: Y aunque alguien lo haga, ¿cómo sabes que te vas a quedar dentro? Vi una tumba que YO SÉ que llené... y estaba vacía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: ¡Pero a ése lo enterré yo mismo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: Ahora estoy pensando... tal vez mi tumba también estará vacía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: "GraveDigger: Quizás... quizás ya soy un Visitante...\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: Bah... olvídalo, amigo. Solo estoy diciendo tonterías.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: Ojalá esos Visitantes se vuelvan a meter bajo tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: ¿Tú de dónde crees que vienen estos Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: ¿No has notado... que se ven jodidamente familiares? Como si no fueran solo una cara... sino un recuerdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: Tengo una teoría. ¿Quieres que te la cuente? Está bien, ahí te va...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: Quizá los Visitantes... no son los muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: Quizá sean pensamientos, esos que no enterraste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: Miedos, arrepentimientos, gente que olvidaste, sentimientos que nunca soltaste y se acumulan... y cuando hay mucho silencio bajo tierra, salen arrastrándose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: No buscan carne. Buscan atención.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: Y mientras más asustado estés... más se acercan. Porque los recuerdas. Y cualquier cosa que se recuerda... quiere estar viva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: ¿Los Visitantes soñarán...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: ¿Pudiste dormir algo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: ¿Mm? No. Ni siquiera intenté dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: Solo espero que alguien aquí aún sueñe, eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: Pero... nadie ha compartido sus sueños todavía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: Quizás no parezco digno de confianza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: Quizás se abran más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: ¿Los Visitantes soñarán...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: ¿Por qué estás tan obsesionado con los sueños?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: ¿Quién dijo que estoy obsesionado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: Esa es una conclusión extraña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: ¿No tienes ni un poco de curiosidad por lo que tu subconsciente intenta decirte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: ¿Qué estaremos ocultando en estas cabezas nuestras? Todos nos ocultamos cosas a nosotros mismos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: Tú, por ejemplo. ¿Evitas a la gente porque alguien te hirió?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: Eso es lo que me resulta interesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: ¿Sabes qué? Te voy a contar el último sueño que tuve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: Un enorme tren negro me perseguía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: Mis piernas habían echado raíces al suelo. Grité y me desperté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: Estaba parado en las vías... y también era yo quien manejaba el tren. Yendo directo hacia mí, incapaz de detenerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: ¿Los Visitantes soñarán...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: ¿Y tú? ¿Qué ocultas en tus sueños?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: ¿Yo? Pues...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: Llevo días sin dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: Pero está bien, te diré algo. Nadie me lo va a creer de todas formas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: Y es que... puedo VER los sueños de otras personas. Es... fascinante, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: Ni idea de cómo funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: Pero desde que todo esto empezó, los sueños... se quedaron en silencio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: Como si todo el mundo estuviera aguantando la respiración.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: Y yo ya no pude dormir más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: Ahora... ¿Estoy diciendo la verdad o solo estoy jugando contigo?.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: ¿Quiénes son?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: Almas perdidas. Igual que todos los demás en esta tierra maldita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: Anhelamos paz y tranquilidad. Y sabemos cómo obtenerla...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: Con la muerte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: ¿Por qué la gente le teme? ¿Será lo desconocido? ¿O es el castigo que nos han inculcado las religiones?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: Durante milenios, buscamos el significado de la vida. Y la respuesta era tan, tan simple...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: La Muerte es nuestro propósito. Y nosotros somos sus seguidores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: ¿Por qué veneran a la muerte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: Porque la Muerte es la personificación de la misericordia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: Todos le tememos, pero ¿están justificados nuestros miedos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: Piénsalo. Nuestro mundo no es un paraíso, sino un purgatorio que nos tortura. Pero ¿por qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: Tanto miedo, dolor y sufrimiento... ¿Acaso no merecemos paz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: La Muerte es un paraíso que no podemos comprender.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: Las religiones intentan simplificar la idea del Cielo porque es más fácil para la gente. Pero, ¿la vida alguna vez fue sencilla?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: Lo mismo ocurre con la Muerte. No puedes entenderla hasta que la tocas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: ¿Por qué escogieron mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: Tu casa está ligada a la Muerte como ninguna otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: Al principio, no entendía por qué nuestro mentor eligió este lugar. Pero ahora está claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: Estas paredes tienen rastros de la Muerte. Son invisibles, pero sofocantes, se pueden sentir en el alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: El concreto desnudo apesta a sangre derramada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: No te estamos pidiendo que mates a propósito, como quizás pienses. Ya tomas vidas sin que te lo pidamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: Creo que tu vínculo con la Muerte es más fuerte que el de cualquiera de nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: ¿Qué son esas hogueras que están armando fuera?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: Ha llegado el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: Los ángeles de abajo tomarán nuestras cenizas como ofrenda y nos concederán el paso al reino de la Muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: Así es como nos ganamos su favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: Te ves asustado. ¿Tienes miedo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: Eres muy observador, señor de la casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: A diferencia de mis hermanos de fe... Yo todavía lucho con el miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: Las dudas me atormentan. ¿Qué hay más allá de la vida? ¿Qué se sentirá?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: Nuestro mentor nos enseña que no es el cielo ni el infierno. Es otra cosa. Pero no lo comprendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: Si ni siquiera él entiende del todo a la Muerte, ¿la entenderemos nosotros alguna vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: ¿Y si tocarla no es suficiente? ¿Y si está totalmente fuera de toda comprensión...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: Pero no me atrevo a cuestionar la voluntad de nuestro mentor. En sus ojos, veo certeza y conocimiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: Nos pide que abracemos la fe y la resolución. Que estemos preparados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: Solo así podremos cruzar los ríos de los muertos y las montañas de huesos. Y llegar a Ella...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: A la Muerte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: ¿Por qué adoras a la muerte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: Por favor, amable señor de la casa, hable de la Muerte con respeto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: Ella desprecia a los blasfemos que la tachan de injusta y los castiga con la mayor dureza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: Su naturaleza me aterra, pero nuestro mentor dice que la Muerte podría ser la más bondadosa de todos los dioses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: No trae hambruna, plaga o guerra. Solo... nos brinda descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: Y tenemos que encontrarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: ¿Por qué están tan ansiosos por encontrarse con la muerte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: Este viaje no es nuestra elección. Es la voluntad de la Muerte misma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: Nos llamó. Nos quiere en su dominio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: Nuestro mentor dice que por eso el sol arde tan intensamente ahora; intenta alejarnos de la superficie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: La Muerte nos ofrece silencio, paz y unidad. En sus tierras es donde volveremos a reunirnos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: Lloramos a los muertos en vano, olvidando que algún día volveremos a verlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: ¿Qué planean hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: El momento ha llegado...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: Tengo miedo... Mi cuerpo no deja de temblar... Pero debo abrazar la fe y la resolución.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: Nuestro mentor cree en mí. No puedo defraudarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: Pero el miedo... el miedo todavía me carcome la mente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: Libéranos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: Libéranos. ¡Libéranos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: ¿Por cuánto tiempo se quedarán?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: No se preocupe, señor de la casa. No seremos ninguna molestia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: Apreciamos su hospitalidad y no queremos molestarlo. Ya ha hecho bastante por nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: Nos quedaremos en esta habitación y rezaremos en silencio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: Necesitamos algo de descanso. Nuestro camino será largo y difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: ¿Hacia dónde se dirigen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: A la tierra de los forasteros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: La vida humana no es eterna. Solo somos visitantes en esta tierra. Vinimos una vez, y así nos iremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: Los forasteros deben tomar esta tierra y establecerse aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: Su llegada no es casual. Vinieron por el mismo llamado que nos hace alejarnos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: La Muerte los convocó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: ¿Qué le hace pensar que la Muerte convocó a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: Porque la Muerte no hace distinción: humano, bestia, forastero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: La Muerte es una para todos y todos somos iguales ante ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: Esperó el momento adecuado y ahora ya casi está aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: Debemos prepararnos para el ritual...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: ¿Qué clase de ritual están planeando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: Ha llegado el momento de cruzar, de viajar nuestro hogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: Debemos ir con la Muerte, al reino de la paz y serenidad eternas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: Es hora de seguir adelante...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: Soy de la ciudad, mijo. Tenía mi apartamentito en el centro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: No tengo casa en el campo, ni familia, ni nietos... Ay, mi mijo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: Es por eso que me sentaba en la banca de la entrada casi todos los días. Ahí sentía un poco de vida y me enteraba de todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: Pero cuando llegaron los problemas, toda la alegría se perdió.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: ¡Uy! ¿Cómo sentir vida cuando la muerte está por todas partes? La gente estaba cayendo como moscas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: Llegabas a la escalera y siempre había alguien ahí, tapado con una sábana blanca.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: Dios mío, es como para desear que uno ya no esté, en vez de seguir viendo tanta tristeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: Es por eso que decidí salir a buscar un lugar con gente, con historias que oír, con vida que sentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: Y fíjate, el destino me trajo redondito hasta tu puerta, mijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: Mira, yo no soy de ir a misa, pero en estos tiempos... bueno, siento que el Señor mismo guió mis pasos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: Todos se olvidaron de mí, mijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: Si queda alguien vivo por ahí, no pasa a visitarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: Y a decir verdad, no soy la única. Muchos de estos jóvenes de hoy en día se olvidan de sus propios familiares...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: Piensan solo en sí mismos. ¡Uy! Es que ni una llamadita me hacen para preguntar cómo estoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: Una vez, mi vecina, mientras estábamos en esa banca, se vanagloriaba de su nieto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: Decía: "¡Mi nieto es muy bueno! Se acuerda de sus mayores, me visita. No como los demás".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: Y sí era un buen muchacho de verdad. Siempre me saludaba, me preguntaba cómo estaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: Hasta me dio un poco de envidia...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: Y entonces la muerte se la llevó...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: Y el muchacho... fíjate, se volvió hosco y amargado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: Resulta que toda su amabilidad era solo por el apartamento. Quería que se lo dejaran, por eso él...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: ¿Por qué será que la gente miente tan descaradamente en la cara de los demás, mm? Mentiras hasta para la familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: Se casan, tienen hijos y luego... Es que, ¿te imaginas...? ¡No te quieren ver ni en pintura!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: Bueno, menos mal que ya no tengo ningún esposo. Era un viejo desalmado. ¡Uy, no!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: Ay, ese se murió hace un buen tiempo, mijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: Pero ese viejo inútil me arruinó la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: Yo me casé con él solo porque mis papás me obligaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: "Cásate con él, mijita, es un buen partido," me dijeron. Y así fue.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: Al principio, me quería de verdad. Pero tan pronto como la boda terminó, su naturaleza podrida salió a flote.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: Primero, dizque mi comida nunca estaba buena y después decía: "Deja de molestar, ¿no ves que estoy comiendo?".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: Y ya de viejo se iba a tomar con los amigos y se perdía por horas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: Volvía borracho, contando cuentos chinos de que estaba jugando dominó en el garaje.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: Y si le preguntaba si había bebido, me decía mil groserías, el muy maldito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: Después, se murió...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: Al principio, sentí un alivio... Pero de repente, la soledad se me fue metiendo por los huesos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: La tele me me ayudó por un tiempo, pero ahora todo son tonterías y mentiras.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: Así que me fui al lado de la carretera, a sentarme en la banca.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: Ay, mijo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: Sí que me empecé a sentir un poquito mejor, viendo la vida pasar. Niños riendo, parejas jóvenes que pasaban agarradas de la mano, perritos trotando por la calle...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: ¡Uy! Pero luego vino esta desgracia...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: Y la gente, una a una, se encerró en sus casas. Ya nadie salía a sentarse al atardecer, a ver la vida con su ajetreo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: Y mirar por la ventana tampoco era nada bueno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: Donde los niños jugaban, había bolsas para cadáveres. Perros salvajes andaban por las calles y los vecinos se empezaron a ver como si fueran extraños.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: La vida, mijo, parecía haberse parado por completo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: Y ahora... ¡Uy! ¡Ya ni se puede distinguir la verdad de la mentira!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: Ojalá que la gente simplemente dejara de mentir, cariño...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: Ahh... agua fría. Justo lo que necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: ¿Te sientes mejor?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: Sí, sí, ya estoy mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: Aunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: Sabes, me está dando hambre. ¿Tienes algo para picar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: Está bien... (Darle una lata de cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: ¿Cómo que no tienes cerveza? No...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: Pero si vi que tu nevera estaba llena. ¿Cómo carajo te las tomaste tan rápido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: ¡Espléndido! ¡Nada como una fría!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: Aaaaahhh... Dios, qué buena está.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: Aquí tienes, ten algo de dinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (Recibes un fajo de billetes arrugados que... no sirven para nada en estos días)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: Eh... gracias
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: Me importa una mierda tu dinero
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: ¡Así me gusta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: Hoy por mí, ya sabes, mañana por ti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: Tengo cómo compensar... a mis amigos, ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: Ah, por cierto, toma esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (Recibes un frasco de kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: No sé quién diablos se tomaría esa mierda, pero es tuya. Tal vez te sirva de algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: ¿Cómo que te importa una mierda? ¡¿Crees que eres especial o qué?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: ¡Todo el mundo necesita dinero! Todo el maldito mundo gira entorno a él. Dizque no necesitas dinero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: ¡Anda, toma esto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (Recibes un frasco de kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: No sé quién diablos se tomaría esa mierda, pero es tuya. Tal vez te sirva de algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: ¿Que cómo que no? ¿Te crees incorruptible? ¡Todo tiene un precio! El amor, todas las cosas, la gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: ¡El dinero mueve el mundo, muchacho! ¿Y yo? ¡Yo soy muy importante! ¡Soy un maldito ministro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: Bueno, olvídalo. Si no quieres ayudar, al diablo contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: Ahh... agua fría. Justo lo que necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: ¿Ahora qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: ¡Qué bueno que preguntas! Tengo ganas de fumar. ¿Tienes un cigarro de sobra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: Está bien... (Darle cigarrillos)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: ¿Qué, no tienes cigarros?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: Bueno, olvídalo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: ¡Esto es justo lo que necesitaba!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: Antes solo fumaba puros, claro... pero buena suerte encontrando uno ahorita. Cuando yo era parte del consejo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: Sí... las cosas eran diferentes. Ahora hay puros asesinatos y caos. ¡Es una completa pesadilla!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: ¿Cuándo será que la AFAE va a ponerse las pilas y poner orden? Para algo la crearon, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: Nada de esta mierda pasaba cuando estaba en el Parlamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: Aunque, bueno, tal vez solo necesitan algo de tiempo. Todo ya se resolverá solo. Nada más tenemos que esperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: ¿Estuviste en el Parlamento?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: ¿Ayudaste a fundar la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: Bueno, sí, te lo acabo de decir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: Ah, cierto... Aquí tienes tu recompensa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (Recibes un puñado de billetes arrugados sin valor y una extraña postal con el sello de la AFAE)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: ¿Qué te hace pensar eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: Ah, cierto... Aquí tienes tu recompensa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (Recibes un puñado de billetes arrugados sin valor y una extraña postal con el sello de la AFAE)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: ¡¿Cómo que no?! ¡¿Acaso sabes quién soy yo?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: ¡Yo era ministro! El gobierno es una maquinaria compleja y requiere de personas como yo para funcionar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: ¡Soy la voz del pueblo! Sin mí, la gente como tú no sería escuchada. Gracias a mí, sus vidas mejoran.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: ¡En tiempos normales, ni te atreverías a hablarme así! ¡Te habrían sacado de aquí al instante!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: El mundo se está desmoronando... Ya a nadie le importa el estatus de un ministro. La gente cree que nomás nos rascamos la barriga en el cargo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: Bueno, ya veremos cómo hablas cuando se desate el verdadero infierno y vengas a arrastrándote a pedirme ayuda. ¡Já!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: Ahh... agua fría. Justo lo que necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: ¿Ahora qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: ¡Qué inteligente eres, muchacho!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: Quiero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: ¡Quiero una bebida energética! Llevo siglos sin tomarme algo refrescante que me llene de energía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: Está bien, toma. (Entregar bebida energética)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: ¿No tienes EnerJeka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: Bueno, olvídalo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: Qué mala suerte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: Ufff, sí-sí-sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: Háblame de la AFAE. ¿Quiénes son?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: ¿Qué está tramando la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: ¿Qué? ¿No tiene azúcar? Qué asco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: Debiste traerme un refresco en vez de esta porquerí—... Espera, ¿qué me acabas de preguntar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: ¿Pero te volviste loco? ¡Eso es clasificado!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: Ya firmé los papeles, ¿entiendes? De confidencialidad. No estás autorizado para pedirme eso, sin ofender.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: Mira, mejor toma este café y ya no me preguntes esas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (Recibes una lata de café)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: Y encima es EnerJeka. Quién sabrá qué porquerías le ponen... Espera, ¿qué me acabas de preguntar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: ¿Cómo crees que te voy a decir una mierda? ¡Eso es clasificado!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: Ya firmé los papeles, ¿entiendes? De confidencialidad. No estás autorizado para pedirme eso, sin ofender.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: Mira, mejor toma este café y ya no me preguntes esas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (Recibes una lata de café)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: ¿A qué mierda te refieres? ¿Cómo carajo voy a trabajar con el estómago vacío?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: ¡Estoy aquí afuera, tratando de mejorarle la vida a la gente! ¡Soy su defensor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: Pero todo lo que ustedes hacen es criticar... Todos se creen tan inteligentes. Así que, ¿por qué no te postulas en la política, ah?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: Exacto. Mucho carácter, pero nada de acción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: Ahh... agua fría. Justo lo que necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: ¿Qué? ¿Ahora qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: Pues sí, muchacho. Quiero tu escopeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: Ahora sí que te volviste loco
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: Sí, la necesito para protegerme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: No te preocupes, antes cazaba. Sé cómo usarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: Ni de broma
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: ¡Vete al carajo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: Mide tus palabras, muchacho. ¿Se te olvidó quién soy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: ¡Si me da la gana, puedo hacer que te metan en la cárcel en un abrir y cerrar de ojos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: Ni de broma
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: Vete al carajo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: ¿Qué fue lo que dijiste? ¿Te escuché bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: Ya está. ¡Ahora sí que te metiste en problemas!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: Ve haciendo tus maletas, porque ya firmaste tu sentencia para terminar preso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: No eres más que otro Visitante para mí
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: Me importa una mierda que seas un ministro. Para mí, no eres nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: ¿Estás loco, hablándole así a la voz del pueblo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: Estás perdido, amigo. Prepárate.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: ¡Cometes un grave error haciéndome enojar! Los concejales son personas poderosas, ¡por si no lo sabías!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: No te preocupes... Ya entrarás en razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: No eres más que otro Visitante para mí
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: Me importa una mierda que seas un ministro. Para mí, no eres nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: ¡¿Qué carajo dices?! Tú... ¡MISERABLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: No estoy jugando... En serio vas a terminar preso... ya vas a ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: ¡¿Qué carajo dices?! Tú... ¡MISERABLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: No estoy jugando... En serio vas a terminar preso... ya vas a ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: Ahh... agua fría. Justo lo que necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: ¿Y por qué no estoy preso todavía, ah?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: ¿Te estás burlando de mí? ¡No... no estoy bromeando! ¡De verdad vas a terminar ahí!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: Puede que los títulos fueran importantes antes, pero ahora no vales nada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: El dinero ya no tiene ningún valor. ¿No lo entiendes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: ¡Eso... eso es mentira! ¡Todavía sigo en el Parlamento!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: Solo... me... mandaron de vacaciones...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: A quién engaño... Ya no volveremos a vivir como antes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: Cuando estaba en el cargo, todo el país estaba al servicio de nosotros los ministros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: La gente me temía, me respetaba. Los autos se hacían a un lado, las multitudes se desvivían por complacerme, queriendo ganarse mi favor. Y ahora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: Genial. Ahora tengo un nudo en el estómago por el estrés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: ¿Ya estás feliz? Solo vete. Ya tuve suficiente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: ¡E-eso es mentira! ¡Todavía tengo mucho dinero!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: Puede que a ti no te importe, pero... pero a todos los demás sí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: A quién engaño... Ya no volveremos a vivir como antes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: No más lujos, no más limusinas, no más chicas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: Con dinero, todo era mucho más fácil. ¡Si tenías dinero, eras importante!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: Si no fuera por este colapso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: Genial. Ahora tengo un nudo en el estómago por el estrés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: ¿Ya estás feliz? Solo vete. Ya tuve suficiente...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: Ya hablamos. Estoy cansado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: Sigamos con esto mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: Dios, estoy harta de todo esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: ¿Por qué estás por ahí sola?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: Pues... en mi casa no había espacio, era infernalmente ruidosa y super incómoda... Por eso me fui, para conocer el mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: Así que sí, agarré una mochila, unos refrescos, unas barras de cereal y este viejo brazalete de la amistad que hice en la escuela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: Y me fui. Seguro mis papás ni se dieron cuenta, aunque tampoco me importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: Desde entonces no hago más que andar por ahí, quedándome a dormir donde pueda. ¿Y sabes qué? Me ha ido bien hasta ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: Al menos nadie me está molestando y soy mi propia jefa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: Dios, estoy harta de todo esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: ¿Y cómo has sobrevivido sola?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: Quién sabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: Me escabullía en las escaleras, los cobertizos o dormía en el piso bajo algún árbol. Me escondía del calor bajo cualquier techo que encontrara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: Comía lo que conseguía. Algunas hierbas y un chocolate que me robé de una tienda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: ¿Por qué me miras así? Sí, robé. ¿Y qué? ¿Cómo se supone que voy a sobrevivir si no? Nadie me va a dar trabajo a mi edad. Así que hago lo que puedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: ¿Ugh, qué pasa ahora? ¿Crees que te voy a robar o qué? Pff, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: ¿En serio? ¿Qué es esto, un interrogatorio? Déjalo, de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: Dios, estoy harta de todo esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: ¿Por cuánto tiempo piensas vivir así?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: ¿A ti qué te importa? Ya me las arreglaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: ¿O acaso te molesta que me quede aquí? ¿Te robé algo? ¿Te tapé el baño? ¿Por qué me interrogas así, ah?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: Ah, ya veo... a lo mejor eres uno de esos pervertidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: Una vez hubo un tipo que me acogió. Hablaba muy bien y me dio un lugar para pasar la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: Pasamos horas viendo anime, pelis y todo eso. Creí que por fin había encontrado a alguien decente, pero noooooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: Al rato, trató de tocarme. Maldito pervertido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: Intenta algo y te juro que me voy a defender. No voy a dejar que nadie me lastime.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: Mi papá es un imbécil, pero al menos me enseñó a pelear.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: Así que ya sabes. Mantén las distancias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: Dios, estoy harta de todo esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: ¿Y qué le pasó a ese hombre?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: ¿Por qué quieres saberlo? ¿Buscas cómo someterme si me defiendo porque te diste cuenta de que ya no estoy con él?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: No pienses que no entiendo. No me lo preguntas por amabilidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: Solo no quieres problemas bajo tu techo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: Pero no te estoy robando, ni rompiendo tus ventanas. No soy problemática, ¡así que deja de tratarme como si lo fuera!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: Y de todas formas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: Estoy aquí porque me necesitas, ¿verdad? ¿Para que ese Visitante medio desnudo no te atrape? Sí, yo también me entero de las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: Si las cosas van a ser así, pues... ¡Ugh, como sea! Haz tus asquerosas pruebas si quieres, pero no me hables.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: Dios, estoy harta de todo esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: ¿Y eso que tu papá te enseñó a pelear?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: Para defenderme de los pervertidos. O para que él pudiera desquitarse conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: Me enseñó a hacer sparring, a aguantar golpes, bla bla. ¿El problema? Que, en vez de pegarle a un saco de boxeo, usaba mi cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: Entrenar con él era una cosa; que, por cierto, odiaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: Pero otra cosa era cuando era cuando se volvía loco y me daba una paliza. ¿Y mi mamá? Bien gracias. Ni se molestaba en mirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: Ugh, no quiero terminar como ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: ¿Para qué tenerme si me iban a tratar así? Aún no lo entiendo. ¿De verdad es así la vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: Y, o sea, ¿ahora está lo del sol y los Visitantes? Bien bello. Más razones para que todo sea horrible. Qué bien que estamos, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: ¿Alguna vez va a pasar algo bueno?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: Igual qué mierda voy a saber yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: Te escucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: ¿Qué pasó en los hospitales?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: Ohhh... eso daba miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: Apenas comenzó todo, la gente se aglomeró en los hospitales. Todos estaban desesperados por saber si eran Visitantes o no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: Tratamos explicarles que la verdad es que no teníamos ninguna forma de saber eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: Pero la gente no nos escuchaba. Seguían empujando y empujando, y eso hizo imposible atender a los que de verdad estaban enfermos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: Al final, apareció AFAE y decidieron que la multitud era una amenaza para toda la situación del brote...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: Así que mandaron a todo el mundo a las zonas de cuarentena. Y, pues, los hospitales... solo cerraron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: ¿Así que AFAE te dejó sin trabajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: ¿La AFAE cometió un error?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: La verdad... cuando los hospitales cerraron, me fui a trabajar a las zonas de cuarentena de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: ¿Por qué te fuiste para allá?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: Entonces eres otro desgraciado de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: ¿Y a ti te parece bien que hayan acorralado a todos así?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: ¿No te parecen absurdas estas supuestas "señales"? Son solo rasgos humanos comunes y corrientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: ¡Es absurdo! ¿Tener los dientes blancos significa que eres un Visitante? ¡Por favor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: Te aseguro que nos están ocultando algo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: La verdad... cuando los hospitales cerraron, me fui a trabajar a las zonas de cuarentena de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: Esperaba descubrir algo sobre los Visitantes y sus características. Pero... no sirvió de nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: ¿Por qué te fuiste para allá?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: Entonces eres otro desgraciado de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: Yo... quería seguir ayudando a la gente. Es mi vocación. No podía simplemente ignorarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: A lo mejor... No. Lo siento, todavía no estoy listo para hablar de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: Te equivocas al decir que soy un desgraciado. No te sabes toda la historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: A lo mejor... No. Lo siento, todavía no estoy listo para hablar de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: Te escucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: ¿Y bien? ¿Qué era lo que me querías contar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: Quería preguntarte, ¿qué opinas de la AFAE?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: Creo que la AFAE está haciendo un buen trabajo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: No confío en la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: Qué lástima. Yo opino justo lo contrario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: Estuve trabajando con ellos por un tiempo, pero no tengo motivos para confiar en ellos. Y menos después de lo que vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: Te digo por experiencia que en esa agencia le ocultan la verdad a los médicos por completo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: ¿En serio confías en una organización que ni puede decirte de dónde salieron esas señales, o qué significan?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: Después de todo lo que ha pasado... ¿cómo es que todavía confías en la AFAE?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: Debo admitirlo, pensaba que eras diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: Qué bien. Yo tampoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: Para ser sincero, ni yo entiendo su motivación. Y eso que trabajé con ellos por un buen tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: Pero sin importar qué los motive, yo decidí ayudar a la gente a mi manera, en contra de sus reglas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: El problema es que no había nada de transparencia. Ninguna. Nada de nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: Nunca nos explicaron de dónde salían esas "señales", ni qué se suponía que significaban.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: Solo nos dieron una lista para saber a quiénes diagnosticar como Visitantes y a quiénes no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: Después de eso, ya no me sentía un doctor. Parecía más bien un guardia de frontera sellando papeles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: Así que comencé a falsificar informes y ayudé a algunas personas a escapar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: Seguramente tienes más preguntas. Pero si no te importa, dejemos el resto para mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: Lo siento, pero no estoy listo para hablar más por hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: Entonces decidí dejar la organización.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: Te escucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: ¿Y por qué no te quedaste en la zona de cuarentena?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: Hubo... un incidente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: Estaba amaneciendo y ya me estaba yendo a casa cuando uno de los oficiales de la AFAE me llamó de repente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: En ese momento, se me aceleró el corazón y las piernas no me respondían.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: Me gritó que me volteara y pensé que iba a morir ahí mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: Me apuntó a las piernas con su rifle y me dijo que me quedara quieto. Se me quedó viendo y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: Me dijo que sacara la lengua, que necesitaba ver si era un Visitante. Y lo hice, temiendo que fuera a dispararme si no lo hacía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: Luego... se rio. Dijo que de seguro era un doctor inútil si ni siquiera sabía que la lengua no es un síntoma de Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: Jamás había estado tan asustado en mi vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: En ese momento no pensaba en salvarle la vida a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: Solo me fui corriendo. Como un cobarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: La vergüenza... es insoportable. Vergüenza por los que se quedaron allí. Por mí mismo. Por todos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: No te juzgo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: Pero todavía puedes ayudar a la gente
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: Eres un cobarde patético. Vete de mi casa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: Gracias por entender. Me... me hace sentir un poco mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: No dejo de pensar en cuántas vidas pude haber salvado si me hubiera quedado hasta el final...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: Me temo que no puedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: Dejé todos mis instrumentos en la zona de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: Así que... ahora no sirvo para nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: Sé que esperabas un tratamiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: Pero, ¿qué puede hacer un viejo como yo sin nada más que sus propias manos? Casi nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: Lamento haberte decepcionado. Me temo que no tengo poder contra la amenaza de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: No te preocupes, igual puedes quedarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: Bueno, pues ahí está la puerta. No la tires al salir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: Supongo que tienes razón. Es mejor que me vaya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: Gracias por entender. Me... me hace sentir un poco mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: Me imagino que la AFAE habría descubierto los informes falsos tarde o temprano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: Aun así, no puedo quitarme la idea de que podría haber sacrificado mi vida para salvar a más gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: Me temo que esa carga me perseguirá por el resto de mis días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: Supongo que tienes razón. Este no es lugar para un viejo como yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: ¿Por qué lo preguntas? ¿Intentas saber por qué no confío en la AFAE?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: Comencemos con una hipótesis...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: ¿Crees que los Visitantes son una especie de virus?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: Para mí no existen
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: No. Pero no sé qué son en realidad
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: Si eso es lo que crees, no veo por qué te molestas en hacer todas estas revisiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: No intentes engañarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: Así que...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: Entiendo. Por desgracia, yo tampoco sé qué son los Visitantes de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: Pero de una cosa sí puedo estar seguro: no son un virus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: Bueno, me temo que tendré que decepcionarte. Lo más probable es que no sea el caso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: ¿Has visto a alguien que parecía estar bien cambiar de repente y convertirse en un Visitante delante de ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: Exacto. No ha habido ni un solo caso así.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: Debes entender. La AFAE no tiene el control de esta situación. Solo fingen tenerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: Cerraron los hospitales, enviaron a todos a zonas de cuarentena... ¿Pero para qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: ¿De verdad están ayudando? ¿Alguna vez alguien ha salido curado?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: La AFAE solo amontonó a la gente, la encerró y ahora pueden hacer lo que quieran con ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: ¿Por qué trabajaste para la AFAE entonces?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: Ya basta de estupideces. Vete de aquí
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: No podía solo quedarme a ver cómo mataban a las personas una por una.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: Por eso me uní a la AFAE, para ayudar a esas pobres almas a escapar de las zonas de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: Los examiné, hice mis diagnósticos. Y falsifiqué documentos para que pudieran escapar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: Por culpa tuya, los Visitantes podrían haber escapado
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: ¿Cuál incidente?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: Qué lástima que también tendrás que huir de aquí.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: Es una lástima que ni siquiera intentes escucharme...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: En ese caso, no me quedaré en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: ¿Y qué querrías? ¿Que los abandonara a su suerte?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: Hice el juramento hipocrático. Es mi deber hacer todo lo que esté en mi poder para proteger la vida y la salud.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: Pero al final... hasta yo tuve que huir de una zona de cuarentena después de un incidente. Tristemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: Fue lo que pasó en el lugar al que me asignaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: ¡¿Pero qué...?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: ¿Crees que no debí ayudarlos? ¿Y por eso ahora me sacas?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: Nunca pensé que diría esto, pero podrías ser peor que la AFAE. Al menos ellos fingen ayudar a la gente. Y tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: Ya no hay lugar para mí aquí. Temo pensar lo que pasará con quienes queden bajo tu resguardo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: Que te vaya bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: No seas tímido, hermano. Dale, pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: ¿Todavía crees que la AFAE te está buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: Ojalá que no, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: Sí, la embarré yendo a la AFAE así. Debí saber que tratarían de atraparme a mí también.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: Me imaginé que solo se llevarían al pasajero y a mí me dejarían tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: Y en cambio, me quitaron el auto y casi me disparan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: Pero, piénsalo, ¿qué más iba a hacer? El tipo era un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: ¿Y si era humano?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: No tenías otra opción
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: Ay... oye, no digas eso, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: Ya me siento mal por lo que pasó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: Bueno... tienes razón, sabes. La verdad es que no tenía opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: Hermano, cómo extraño los días en los que solo te sentabas al volante y no pensabas en nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: Y ahora, con los Visitantes... diablos, tu próximo pasajero podría meterte un tiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: Eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: No seas tímido, hermano. Dale, pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: ¿Cuánto tiempo llevas de taxista?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: Ah, sí, llevo un tiempo en esto, ¿sabes? Ya no trabajo para ninguna compañía, soy mi propio jefe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: Ahorita la AFAE no deja que los civiles se muevan libremente por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: Pero este desmadre se tiene que acabar algún día, ¿no? Y bueno... siempre es bueno tener dinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: La gente paga muy bien por viajes peligrosos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: Y manejar de noche me trae recuerdos de cuando era niño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: ¿Sabes? Me hice taxista por mi papá. Quería ser como él, ¿me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: Aunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: No quiero terminar tirado en la calle, sin que a nadie le importe... como mi viejo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: Solo espero que mi suerte no se haya acabado todavía...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: No seas tímido, hermano. Dale, pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: Te ves bastante decaído hoy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: Necesito revisarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: Sí, es que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: Es que no puedo dejar de pensar en que perdí mi auto, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: ¿Qué tipo de auto tenías?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: ¿Qué tenía tu auto de especial?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: Ay, hermano, era el auto clásico más bello que hay...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: Era de color amarillo brillante, tenía ruedas de cromo relucientes, curvas suaves...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: Pero ahora ya no está...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: Maldita AFAE... ¡Ese auto era mi vida entera! ¡Malditos bastardos!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: Era el auto de mi viejo. Él también manejaba un taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: Cuando era niño, me gustaba ir en el auto con él de noche. Siempre me dormía en el asiento trasero, así que me llevaba. Pero luego...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: Digamos que a se le acabó la suerte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: No seas tímido, hermano. Dale, pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: ¿Qué le pasó a tu papá?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: No suelo hablar de esto, pero... siento que puedo confiar en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: Un día, mi mamá tuvo que irse de viaje de trabajo, así que mi papá me llevó con él.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: Fue entonces cuando recogimos a un pasajero que nunca olvidaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: Era un calvo con un traje impecable y una sonrisa diabólica...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: Todo el mundo en el pueblo sabía quién era. Hasta yo, siendo un niño. ¿Negarle algo a un hombre así? No era una opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: Pero mi papá era un hombre de honor. Y su decisión... nos afectó a todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: Ese demonio de traje se encargó de que lo pagáramos caro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: Nos quedamos sin casa y tampoco nos podíamos quedar mucho tiempo en un lugar fijo después de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: Y como casi no teníamos dinero, mi papá se quedó con el taxi que manejaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: En su vejez, ahogado en deudas, empezó a desear no haberlo conservado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: Decía que estaba maldito. Decía que nos trajo pura mala suerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: Pero él nunca lo entendió.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: No era el auto. Fue su orgullo. Eso fue lo que nos costó todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: Fue por sus decisiones tuve que empezar a trabajar temprano para mantener a la familia...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: Todavía lo quiero.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: Extraño a mi viejo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: No pido mucho, pero... si no es mucha molestia, ¿podrías, umm, llamarlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: Este es su número: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: Solo dile que estoy bien. Yo lo haría, pero... ahora mismo no puedo revelar mi ubicación.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: Ojalá no me haya sometido a tanta exposición solar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: ¿Estás seguro de que no eres de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: No, de verdad no estoy con ellos. Ya te lo dije, yo arreglaba neveras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: Encontré el uniforme en un auto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: Me habías dicho que se lo quitaste a un cadáver
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: No me estás mintiendo, ¿verdad?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: Lo que pasa es que... o sea, sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: Lo tenía puesto un muerto dentro de un auto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: Y pensé que el uniforme me protegería de los Visitantes. O sea, los de la AFAE lo usan por algo, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: No te estoy mintiendo. Es que me confundo por el estrés, eso no es raro, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: Créeme, si hubieras visto lo mismo que yo... lo entenderías.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: Viniendo para acá casi me matan del susto los cuerpos muertos que seguían retorciéndose en el suelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: Ojalá no me haya sometido a tanta exposición solar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: ¿No crees que tener un traje de la AFAE puesto es una mala idea?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: ¿Qué? Pues... no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: O sea, claro, hay gente a la que no le gusta la AFAE, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: Ahh, te refieres a que podría tener problemas con la AFAE, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: Bueno, mira, yo... creo que si les explico todo, me van a creer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: No hay que demonizarlos. No es como si fueran una secta secreta ni nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: Ojalá no me haya sometido a tanta exposición solar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: Enséñame qué tienes en los bolsillos
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: Oye, ¿por qué quieres revisarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: Quiero ver tu identificación de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: ¿Qué, escondes algo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: ¿Qué? ¿De qué identificación hablas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: Te juro que no tengo nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: Más te vale vaciar los bolsillos por por las buenas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (Sacar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: ¿Quién? ¿Yo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: No'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: Sí, ajá, vacía tus bolsillos por las buenas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (Sacar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: Está bien, está bien. No hay necesidad de que te pongas así...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: Toma. ¿Ya estás feliz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: Sí, me descubriste. Sí, soy de la bendita AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: Pero, por favor, no le digas a los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: Maldita sea...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: Toma. Solo no me dispares.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: Sí... sí soy de la AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: Pero es mejor que nadie se entere.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: ¿Por qué ocultabas que eras de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: ¿Y por qué la farsa?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: ¿De verdad no lo entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: ¡¿En serio me preguntas eso?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: Si la gente se entera de que trabajé para la AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: Mira, ya no trabajo en la AFAE. Digamos que... me despidieron.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: Mira, ya no trabajo en la AFAE. Digamos que... me despidieron.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: Sí, tuve que hacer ciertas cosas que, bueno, no estuvieron muy bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: Tuve que llevarme a la gente, mandarla las zonas de cuarentena...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: Pero mira, solo cumplía con mi trabajo, ¿sí? Solo seguía las órdenes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: No tiene sentido preguntarme por los que nos llevamos. Eso es cosa de los de arriba, no mía.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: Y llamarme asesino, o lo que sea... es sumamente injusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: ¿Y si más bien estuve salvando vidas al enviar asesinos a las zonas? ¿Entonces qué soy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: Ojalá no me haya sometido a tanta exposición solar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: ¿Por qué ocultabas que eras de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: Una vez me tocó ir a buscar a un hombre con señales de Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: En resumen, el tipo se puso peor en la zona de cuarentena y murió. Cosas que pasan.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: Después vino su esposa. Quería saber cuándo lo dejaríamos salir. Le dijimos que ya no había a nadie que sacar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: Se veía que estaba en shock. Comenzó a gritar, a llamarnos asesinos, exigiendo que le diéramos el cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: Le dijimos que los protocolos no lo autorizaban, pero a ella no le importó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: Se quedó acampando en el suelo, justo afuera de la reja.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: Así que le dimos el cuerpo y terminaron despidiendo a todos los que rompieron el protocolo. Incluyéndome.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: Ella solo quería tener ese maldito cuerpo. Esa loca me costó mi empleo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: Y ahora no tengo a dónde ir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: Y, escucha esto, en vez de enterrarlo, la loca esa anda con el cadáver a cuestas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: Supongo que valió la pena que nos despidieran a todos, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: Ustedes los de la AFAE sí que son unos bastardos
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: Ay, qué mala suerte
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: ¡¿Disculpa?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: O sea que yo hago mi trabajo, cumplo con mi deber, me despiden por culpa de una loca...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: ¡¿Y tú nos llamas bastardos?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: ¿Sabes qué? Al diablo contigo. Me largo de aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: ¡Por los clavos de Cristo! ¿Es que ahora todo el mundo se volvió loco?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: No, no, eso es justo lo que pasó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: Desde que el sol se volvió loco y comenzaron las infecciones, a todo el mundo le patina el coco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: ¿En serio ese maldito cuerpo valía nuestros trabajos? ¿De verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: Bien por ella por reunirse con su esposo
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: No debieron darle el cuerpo
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: ¿Dices que es bueno que nos hayan despedido?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: Ustedes los civiles no entienden un carajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: Debimos haberle disparado, como le disparamos al esposo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: ¿Qué dijiste?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (Sacar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: ¿Por qué me miras así?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: Según el protocolo, si un civil contaminado no está bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: Entonces hay que solucionar el problema en el momento, para evitar que poner a un Visitante en la cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: Dejarlo ir
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (Sacar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: Gracias por entender.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: No soy un asesino, solo seguía órdenes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: Oye, ¿qué diablos estás haciendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: Cálmate, ¡era un Visitante! ¡Y estaba muy mal! No podíamos dejarlo ir así nada más.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: ¡No dispares! ¡Solo seguía órdenes!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: Pienso lo mismo. Debí haber seguido el protocolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: Está bien, no te aburriré más. En fin, gracias por dejarme pasar, incluso sabiendo que era de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: Si alguna vez recupero mi trabajo, me encargaré dejar constancia de tu cooperación.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: ¿Sí? Dime, bebé. ¿Te preocupa algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: ¿Te gusta estar aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: Es acogedor. Más de lo que esperaba... considerando cómo están las cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: Gracias por dejarme pasar. Pensé que iba a quedarme en la calle antes del amanecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: ¿Y tú? ¿Cómo te sientes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: Ansioso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: Estoy bien. Tenemos que sobrevivir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: Te entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: Hoy en día... hacer planes a largo plazo parece inútil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: Nunca sabes qué te atrapará primero: el sol, los locos o los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: Pero la humanidad ya ha sobrevivido a muchas catástrofes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: Creo que dejaremos algún tipo de legado cuando ya no estemos aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: Alguien encontrará rastros de nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: Todo saldrá bien, bebé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: Me gusta esa actitud. Te sienta bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: Pero no te lo guardes todo, ¿sí? Las emociones tienen una mala costumbre de desbordarse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: ... Justo cuando menos lo quieres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: Que no te de pena hablar de esas cosas conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: Y si no es conmigo, entonces con alquien. Quien sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: Prométeme eso. ¿Está bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: ¿Sí? Dime, bebé. ¿Te preocupa algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: Vi algo extraño anoche
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: ¿Mmm? ¿A qué te refieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: Tu vientre... Estaba hinchado
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: Nada... seguro me lo imaginé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: ¿Quieres decir... que estaba embarazada?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: Bueno, está bien, bebé. Me alegro de que seas sincero conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: ¿A lo mejor solo te sientes bajo mucha presión? Ahorita tienes que velar por otras personas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: Yo sé, bebé. Cuando cada amanecer podría ser el último, ya es bastante difícil preocuparse por uno mismo, por no hablar de estar pendiente de los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: Ni siquiera sabes si vas a vivir mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: Sí... me da miedo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: No, no creo que sea eso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: Pero algo te atormenta, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: Está bien, bebé. El miedo nos desgasta a todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: Sé que te levantas por las noches, ¿sabes? Te he visto. Patrullas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: Para ser tan cerrado, te preocupas bastante por la gente que dejas entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: Es... interesante. Eres una contradicción andante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: O quizá sea solo el insomnio. El miedo es una compañía horrible para dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: Sí... me da miedo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: No, no creo que sea eso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: Se necesita valor para decir eso en voz alta, bebé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: Pero, ¿qué podemos hacer realmente con el miedo, mmm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: ¿Puedes aceptar la idea... de que la vida es efímera? ¿De que vamos a morir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: Lo que importa es ¿dónde encuentras tu salvación? ¿Algo así existe todavía?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: Bueno'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: Como sea... me preocupo por ti, bebé. Piensa en ti mismo, ¿sí? Cuídate.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: Quiero que te sientas seguro. Al fin y al cabo, vivimos bajo el mismo techo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: Pero si a ti se te afloja un tornillo, estamos perdidos... a menos que tengas un destornillador... jeje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: Ese chiste me salió natural.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: ¿Te dio risa, bebé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: ¿Sí? Dime, bebé. ¿Te preocupa algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: Sé que anoche te vi embarazada. Explícate
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: Me estás empezando a asustar un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: ¿De verdad estás seguro de que viste algo anoche?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: ¿Por qué no me despertaste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: ¿Es el miedo hablando otra vez? ¿Miedo a la muerte... o todo el estrés de tener invitados en tu casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: ¿Es por mi culpa? ¿O es otra persona la que ronda por tu cabeza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: Deja de jugar con mi cabeza
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: Pero estoy... ¡estoy seguro de que vi algo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: Mencionaste a tu padre el otro día.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: Desde entonces no hemos hablado de él, así que no sé mucho al respecto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: Pero ahora... tengo la sensación de que estás siendo justo como él. Un clon perfecto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: ¿Eso te asusta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: ¿Vivir atrapado en su sombra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: Él está muerto para ti, ¿no? ¿Así que por qué seguir desenterrando fantasmas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: No te lo vas a encontrar, ya sabes, del otro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: Igual no creo que vayas al mismo lugar. No te preocupes, bebé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: No busques todas las respuestas a la vez. Los caminos se construyen una piedra a la vez. ¿Me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: Y por favor... no me vuelvas a hablar así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: Me duele verte así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: Pero no deberías temerle a la muerte. Ni a la responsabilidad. Ni a la cercanía. Ni a nada más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: Así es la vida, bebé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: No busques todas las respuestas a la vez. Los caminos se construyen una piedra a la vez, cariño. ¿Me sigues?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: No sé si te ayude, pero piensa que no desaparecemos del todo cuando cae el telón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: Antes creía en el cielo y el infierno. ¿Ahora? Ya no estoy tan segura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: Quizás vayamos a un lugar totalmente distinto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: ¿Tú qué crees?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: ¿Sí? Dime, bebé. ¿Te preocupa algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: Estás embarazada y vas a dar a luz pronto, ¿cierto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: La desesperación se apoderó de ti, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: Todo en lo que creías se está cayendo a pedazos... y eres incapaz de aceptarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: ¿Es porque no quieres ir a donde sea que nos dirigimos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: ¿O es que ya no encajas en este mundo? ¿O, la verdad, a ningún otro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: Deja de cambiar el tema. Estás embarazada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: ¿No estás asustada?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: Ay, bebé... ¿pero cómo eso sería posible? Ni siquiera tengo panza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: ¿Te puedo preguntar algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: Si de verdad existe un bebé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: Y si, como dices, está por llegar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: ¿Qué vas a hacer? ¿Lo vas a cuidar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: No debería existir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: Todavía no lo he decidido
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: Mm. Buena pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: Morir da mucho miedo, sin duda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: Sobre todo porque no sé qué viene después, no realmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: El cielo, la reencarnación, o algo completamente diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: Nadie ha vuelto para contarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: Pero, en cuanto a esa visión tuya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: Si de verdad existe un bebé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: Y si, como dices, está por llegar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: ¿Qué vas a hacer? ¿Lo vas a cuidar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: No debería existir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: Todavía no lo he decidido
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: A veces el instinto quiere preservar lo que es familiar... aunque ya no te sirva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: Quizás...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: ¿Quizás es hora de que te abras a cosas nuevas a algo nuevo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: ¿O es que lo desconocido te da tanto miedo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: Encontraré a ese bebé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: Está por llegar. Lo sé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: No deberías tener miedo de soltar las cosas. Especialmente cuando ya no te sirven.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: A veces nos aferramos a algo solo porque nos resulta familiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: Y sí, romper con los hábitos duele... pero ¿quién sabe a qué podría llevar eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: Encontraré a ese bebé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: Está por llegar. Lo sé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: Si tú lo dices, bebé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: Me cuentas qué encuentras... cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: Bueno, eso es todo por hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: Ah, por cierto, casi se me olvida.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: Voy a regresar a casa mañana en la noche. Anota mi número, acaban de instalarnos la línea.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour: {0}. Seguimos hablando por teléfono.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: Bueno, ahora sí, eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: Tómate una cerveza y descansa un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: ¡Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: Acariciar al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: Levantar al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: Alimenta al gato con comida enlatada
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (Extiendes la mano y acaricias al gato)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (Es difícil saber si le gusta o no)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: ¡Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: Acariciar al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: Levantar al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: Alimenta al gato con comida enlatada
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (Decides acariciar al gato)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (Parece que eso le gusta de verdad)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (No es tan arisco como pensaste que sería)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (Parece que empieza a acostumbrarse a ti)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: ¡Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: Acariciar al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: Levantar al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: Alimenta al gato con comida enlatada
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (Al gato le gusta mucho que lo acaricies con tanta frecuencia)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (Te da la impresión de que ahora se recuesta en tu mano)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (Pero, ¿cómo podrías decirle que no a una cosita tan tierna?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: ¡Miau! ¡MIAU! ¡Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (Su carita es difícil de leer, pero estás bastante seguro de que está feliz)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (Tienes la extraña sensación de que podrás dormir tranquilamente esta noche)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (Como si tu amigo peludo te hubiera regalado una de sus vidas para darte las gracias)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (Quién sabe... quizás la muerte no pase por tu casa esta noche)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: Pobrecitos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: ¿Pasa algo?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: Solo... solo estaba pensando...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: Si esto no es una extinción masiva y logramos sobrevivir... ¿qué pasará cuando todo esto se termine?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: ¿Qué clase de futuro nos espera?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: ¿Te preocupa no encajar en el nuevo mundo siendo tan amable?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: Alguien tan amable no durará mucho en estos días. Será mejor que encuentres a alguien que te proteja
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: Dices que soy... amable...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: No puedo estar del lado de la violencia. No estoy hecha para eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: No sé si encaje... en... ¿cómo lo llamaste...? En el "nuevo mundo".'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: ¿Entonces, qué? ¿Te vas a sentar y morir?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: ¿Y tú qué sugieres?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: Todos hemos vivido momentos difíciles antes... esto no es nada nuevo
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: No quiero. Incluso si alguien me protege...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: Las muertes no se detendrán. La violencia no desaparecerá.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: ¿Entonces asumo que tu plan es rendirte y morir?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: ¿Entonces, qué? ¿Te vas a sentar y morir?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: Todos hemos vivido momentos difíciles antes... esto no es nada nuevo
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: Me siento tan perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: ¿De verdad vamos a vivir rodeados de asesinos?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: ¿Los niños van a aprender cosas de los asesinos y los malvados en este nuevo mundo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: No es momento de estarte lamentando
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: ¡EY, CONTRÓLATE!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: No... no lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: Ya no me queda nada que ofrecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: Solo... quiero que esto se termine.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: Yo... no puedo más con esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: Sí, es verdad. Pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: ¿Cómo vamos a vivir ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: La gente se volvió loca, matando a cualquiera que se vea... distinto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: Sin importar quién se interponga en el camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: No es momento de estarte lamentando
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: ¡EY, CONTRÓLATE!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: ¿Por qué no?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: Quizás a ti te ayude ser indiferente. Pero yo no puedo con eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: Ojalá pudieras ver lo que vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: Es algo que... se me quedó grabado en los ojos para siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: Fuego. Gritos. Rostros llenos de ira y terror. Hogares destruidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: No puedo ser como tú. No soy tan fuerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: Para mí... solo queda una opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (La mujer da un respingo y te mira asustada)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (La confusión la ayudó a olvidar las pesadillas, pero solo por un momento)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (Se cubre el rostro con las manos y solloza)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (No sabes qué hacer. Nadie te enseñó cómo lidiar con estas cosas)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (Pones una mano con cuidado sobre su hombro y te quedas así un rato)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (Probablemente sea mejor dejarla sola)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: Oye, ¿sabes qué? ¿Por qué no lo llamas? {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: Que sepa lo que piensas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: Después de todo, también son sus hijos. Él debería ayudar a buscarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: Por favor, ¿podrías llamarla por mí? Este es su número: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: Solo dile que... estoy arrepentido... que todavía quiero cortarme la garganta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: O le puedes gritar... No sé... tal vez eso lo haga un poco más fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: A algunos les sirve recibir orientación, ya sabes, del otro lado...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: Hay gente... especialistas... que saben cómo limpiar las malas energías.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: Si quieres, te puedo dar el contacto. Percibo que te podría ser útil...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: Este es el número: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: No te olvides de decir que vas de mi parte... ¡No lo olvides!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: ¿Podrías llamarlo, si no es mucha molestia? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (Te entrega un pedazo de papel con un número de teléfono: {0})'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (Es posible que sea el número de una embajada)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: Ay, me muero de sed.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: ¿Qué quisiste decir con eso de que somos "inmortales"?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: Bueno... podrías pegarte un tiro en la cabeza y comprobarlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: Pero yo no lo haría, si fuera tú.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: No, claro que no somos inmortales como lo estarás pensando.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: Después de morir, reencarnamos y volvemos a vivir. Luego, nos volvemos a morir, repitiendo el ciclo de renacimiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: Ya sé cómo suena, pero si hubieras visto lo que yo he visto... lo entenderías.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: A lo mejor los Visitantes fueron humanos alguna vez y luego renacieron.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: No puedo decirlo con seguridad. No sé cómo funciona esta mierda...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: Pero tengo la certeza de que la naturaleza nos esconde muchos secretos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: Encontraré a mi hija algún día.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: No sé en qué vida... pero la encontraré.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: Porque nunca vamos a morir, no realmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: Ay, me muero de sed.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: ¿Por qué la AFAE te está buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: Porque estuve en el epicentro de toda esta mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: En las tierras de donde salieron arrastrándose esas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: ¿Te acuerdas esas estúpidas leyendas urbanas sobre demonios a las afueras de la ciudad?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: Bueno, no importa, ya nadie recuerda esas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: Resulta que no eran leyendas y la AFAE lo sabía desde el principio.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: Dijeron que ahí no estaba pasando nada sobrenatural.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: Y ahora el sol está quemando a todo el mundo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: ¡Mientras los monstruos de bajo tierra acaban con los sobrevivientes!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: En resumen, la AFAE se dio cuenta de que metieron la pata a lo grande...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: Y ahora están encubriendo su incompetencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: Y yo tuve la mala suerte de estar en el lugar y momento equivocados.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: Ay, me muero de sed.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: ¿Cómo hiciste para sobrevivir?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: Soy inmortal. ¿Se te olvidó?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: No sé...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: Yo también me lo pregunto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: Puede que sea por suerte, o una fuerza superior me estará protegiendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: Dios, o en lo que sea que creas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: O a lo mejor ya me morí y esta es mi nueva vida. Ni idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: Buena pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: Es una lástima que yo no esté armado, o yo te estaría diciendo eso a ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: Y qué mal que todo lo que tienes es cerveza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: Si tuviera un buen alambique, prepararía una tanda buenísima.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: Ay, me muero de sed.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: ¿Qué más sabes?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: Conozco toda la estructura de la AFAE por dentro y por fuera:'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: Quién le rinde cuentas a quién, quién hace qué, quién está jodiendo a quién. Todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: Y esos cabrones sabían todo de los Visitantes, sabían lo peligrosos que eran...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: Y aún así los dejaron entrar en la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: Porque a nadie le importaba un carajo nuestra seguridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: Estaban ocupados lavando dinero del gobierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: Y cualquiera que fuera testigo de su metida de pata se convertía en una víctima también.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: La organización no quería que nadie más se enterara.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: Y todo esto fue antes de que existieran las zonas de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: Apenas y pude escapar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: ¿Quieres información ultrasecreta? Aquí la tienes...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: Todo es culpa de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: ¿Todo lo que dicen en la televisión? Pura mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: Si hay una cosa peor que los Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: Es la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: Ay, me muero de sed.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: ¿De dónde salieron los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: De las afueras.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: Sí, sé que las zonas de cuarentena están muy lejos de allí...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: Pero estoy seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: No soy supersticioso, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: Son los mismos demonios de los que la gente hablaba hace dos años.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: No sé cómo llegaron hasta la ciudad...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: Pero sí sé quién los dejó entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: La AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: Los Visitantes no son aliens, como mucha gente cree.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: Son criaturas, como que tú y yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: ¡Y son tan nativos de este planeta como nosotros!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: Ya no puedo quedarme más tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: Tengo que encontrar a mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: Gracias... inmortal.'
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: (Parece que la conversación se acabó)'
    m_Metadata:
      m_Items: []
