%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Endings_vi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 5b2e2a6d2de35064e96737a28b7715de, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 206681661440
    m_Localized: À nói chứ, nhà bác đi chơi mới về đây.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632960
    m_Localized: Ở nhà hoài hổng chán hả con?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632961
    m_Localized: Ừ ừ, bác nhớ mà.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632962
    m_Localized: Nhà bác đi biển đó.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632963
    m_Localized: Mà hôm qua nóng dữ dội quá, làm cả nhà phải lật đật về sớm luôn.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632964
    m_Localized: Ừa, còn chuẩn bị cho con bác đi học nữa.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632965
    m_Localized: Mà nhỏ cứ vùng vằng hổng chịu đi, nhưng đâu phải muốn là được đâu ha?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632966
    m_Localized: Rồi, có gì tối nay bác ghé qua nha.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632967
    m_Localized: Ừ vậy nha, chào con.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632968
    m_Localized: "Bạn cùng những người sống sót khác\nchui xuống tầng hầm."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632969
    m_Localized: "Không khí dưới đây tuy mát mẻ hơn,\nnhưng vẫn ngột ngạt, đượm nỗi âu lo."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632970
    m_Localized: "Kho lương thực này đủ để nuôi sống\nmọi người trong vòng một đến hai tháng,\nmiễn là bạn biết phân bổ hợp lý."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632971
    m_Localized: "Bạn khóa chặt cửa,\nđể không ai vào được nữa."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632972
    m_Localized: "Mỗi ngày trôi qua, bạn đều ghi lại\nbằng cách khắc dấu lên tường."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632973
    m_Localized: "Suốt gần hai tháng trời,\ncả bọn mòn mỏi chờ đợi hồi kết."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632974
    m_Localized: "Người thì mong rằng mặt trời sẽ thiêu rụi\nquả đất, hoặc chìm vào đêm đen. Kẻ lại\ntự tay đặt dấu chấm hết cho chính mình."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632975
    m_Localized: "Sống lay lắt qua ngày để trì hoãn\nkết cục tất yếu thật chẳng sung sướng gì.\nThà chết nhanh còn nhẹ nhàng hơn."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632976
    m_Localized: "Rồi một ngày nọ, bạn bỗng nghe được\ntin báo từ đài radio."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632977
    m_Localized: "...điều kiện sẽ đủ an toàn để chúng ta\ncó thể bước ra ngoài vào ban ngày\"."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632978
    m_Localized: Nghe xong, bạn cảm thấy...
    m_Metadata:
      m_Items: []
  - m_Id: 206702632979
    m_Localized: Thất vọng chăng?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632980
    m_Localized: "Bạn nhận ra rằng mình sẽ\nsống qua được năm nay."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632981
    m_Localized: "Nhưng rồi sao nữa? Mùa hạ tiếp theo\nsẽ là mùa cuối cùng ư?"
    m_Metadata:
      m_Items: []
  - m_Id: 206702632982
    m_Localized: "Viễn cảnh khắc khoải chờ đợi cái chết\ntrĩu nặng trên vai, bóp nghẹn bạn."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632983
    m_Localized: Thôi thì, có người khác vui là được rồi.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632984
    m_Localized: "Biết đâu cuộc đời phía trước còn dài, và\nbạn còn sống được tới 10 năm nữa thì sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 206702632985
    m_Localized: "Bạn cùng những người sống sót khác\nchui xuống tầng hầm."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632986
    m_Localized: "Không khí dưới đây tuy mát mẻ hơn,\nnhưng vẫn ngột ngạt, đượm nỗi âu lo."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632987
    m_Localized: "Kho lương thực này đủ để nuôi sống\nmọi người trong vòng một đến hai tháng,\nmiễn là bạn biết phân bổ hợp lý."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632988
    m_Localized: "Bạn khóa chặt cửa,\nđể không ai vào được nữa."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632989
    m_Localized: "Mỗi ngày trôi qua, bạn đều ghi lại\nbằng cách khắc dấu lên tường."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632990
    m_Localized: "Suốt gần hai tháng trời,\ncả bọn mòn mỏi chờ đợi hồi kết."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827264
    m_Localized: "Mặt trời không phải là\nmối họa duy nhất bao trùm."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827265
    m_Localized: "Còn cả nỗi bất an, nghi dị nhau\nngày một sắc như dao cạo."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827266
    m_Localized: Lạnh lùng. Toan tính. Xa lạ.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827267
    m_Localized: Tất cả sắp hạ màn rồi.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827268
    m_Localized: Chẳng còn đường nào để chạy.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827269
    m_Localized: "Những kẻ bạn mời vào nhà\nkhông chỉ có con người."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827270
    m_Localized: "Cơn đau khủng khiếp như\nthiêu đốt xác thịt bạn."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827271
    m_Localized: "Bạn chỉ thầm mong mọi chuyện sẽ\nsớm chấm dứt."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827272
    m_Localized: Cơn đau phai nhòa trong lúc bạn lịm dần...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827273
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827274
    m_Localized: Dang rộng vòng tay đón mình...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827275
    m_Localized: Không còn gì hối tiếc đấy chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827276
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827277
    m_Localized: Đã bao giờ mi tự hỏi sau tất cả là gì chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827278
    m_Localized: Sau khi mi chết đi ấy. Rồi sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827279
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827280
    m_Localized: Vậy là mi đã thanh thản chấp nhận hồi kết.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827281
    m_Localized: "Lo làm gì chuyện sau đó cho mệt óc,\nmi nhỉ?"
    m_Metadata:
      m_Items: []
  - m_Id: 206706827282
    m_Localized: ...Đến lúc đi rồi.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827283
    m_Localized: "Nhiều ngày sau, căn nhà vẫn trơ trọi,\ntrống hoác."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827284
    m_Localized: Ai cũng tránh nó như tránh tà.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827285
    m_Localized: "Bao lời đồn đại nổi lên, nhiều hơn cả\nsố người từng sinh sống dưới mái nhà này."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827286
    m_Localized: "Và căn nhà ấy, tựa như mọi vết tích của\nchủ nhân, đã tàn phai theo năm tháng."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827287
    m_Localized: "Không một họ hàng thân thích nào đến\nđể thu dọn những gì còn sót lại."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827288
    m_Localized: Người chủ nhà thì biến mất không tăm hơi, như thể chưa từng tồn tại.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827289
    m_Localized: "Mọi thứ y từng sở hữu giờ đã thất lạc,\nmục rã, hoặc bị lãng quên."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827290
    m_Localized: "Cớ sao con người ta\nlại tan biến hoàn toàn như vậy?"
    m_Metadata:
      m_Items: []
  - m_Id: 206706827291
    m_Localized: "Một khi cái chết tìm đến ta, minh chứng\ncho thấy ta từng có mặt trên cõi đời cũng\ndần phai nhạt ngay tức khắc."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827292
    m_Localized: "Mọi tư trang, tạo tác, nghĩ suy, ký ức,\nhay cảm xúc..."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827293
    m_Localized: "Như thể ta chưa từng được sinh ra\ntrên thế giới này."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827294
    m_Localized: "Giá như đôi tay lạnh cóng ấy\ncó thể thương lấy ta."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827295
    m_Localized: "Liệu con có làm được\nđiều đó không?"
    m_Metadata:
      m_Items: []
  - m_Id: 206706827296
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827297
    m_Localized: Xin chúc mừng!
    m_Metadata:
      m_Items: []
  - m_Id: 206706827298
    m_Localized: "Con tỉnh giấc trong một không gian\nkỳ bí. Dãy hành lang trải dài trước\nmặt, với một chiếc bàn đặt ở cuối."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827299
    m_Localized: Ủa... cái gì?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827300
    m_Localized: Chỗ này... là chỗ nào đây?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827301
    m_Localized: "Hằng hà thực thể khiếp sợ ta\nđủ để xây đắp thành kinh đô kỳ vĩ."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827302
    m_Localized: "Nhưng con không cần sợ hãi làm gì.\nNơi đây không tồn tại khái niệm\n\"nỗi sợ\"."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827303
    m_Localized: "Con khao khát được gặp ta\nđã bao lâu rồi?"
    m_Metadata:
      m_Items: []
  - m_Id: 206706827304
    m_Localized: "Ta cảm nhận được hết.\nMọi chuyện ổn cả rồi."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827305
    m_Localized: Thế... bây giờ sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827306
    m_Localized: Tôi chết rồi à? Kết thúc là đây ư?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827307
    m_Localized: "A: Tại xứ sở buồn đau này, tất cả đều\nđược dựng lên để chống chọi với\nmùa đông giá rét: tường dày, áo ấm,\nmộng miên man."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827308
    m_Localized: "Hoan hỉ làm sao. Đêm dài sắp sửa\nqua đi, và hừng đông chờ khắc\nchiếu rọi. Để ta lưu giữ lấy hình bóng\ncủa con nhé?"
    m_Metadata:
      m_Items: []
  - m_Id: 206706827309
    m_Localized: Ta biết con muốn như vậy mà.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827310
    m_Localized: Không việc gì phải sợ sệt.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827311
    m_Localized: Chẳng còn thứ gì để lo sợ cả.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827312
    m_Localized: "Con đường đã vặn xoắn thành\nnút thắt lơi, rồi đứt lìa."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827313
    m_Localized: 'Thế... bây giờ sao nữa? '
    m_Metadata:
      m_Items: []
  - m_Id: 206706827314
    m_Localized: 'Tôi chết rồi à? Kết thúc là đây ư? '
    m_Metadata:
      m_Items: []
  - m_Id: 206706827315
    m_Localized: "Chờ đón con\nlà khoảng không vĩnh hằng."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827316
    m_Localized: "Tuyệt diệu làm sao.\nMọi đau thương thống khổ\ncuối cùng cũng đã chấm dứt."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827317
    m_Localized: "Con sẽ hiểu thấu những điều\nmình hằng mong muốn biết."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827318
    m_Localized: "Nhưng sẽ không có được\ncâu trả lời mình đang kiếm tìm."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827319
    m_Localized: "A: Và suốt hành trình vô tận đó,\ncâu thần chú của con sẽ mãi\nvọng vang..."
    m_Metadata:
      m_Items: []
  - m_Id: 206706827320
    m_Localized: '"Tôi sợ lắm."'
    m_Metadata:
      m_Items: []
  - m_Id: 206706827321
    m_Localized: Giờ tôi phải làm gì đây? Không còn... gì nữa ư?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021568
    m_Localized: '...Tôi sợ lắm. '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021569
    m_Localized: Con... chết rồi ư?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021570
    m_Localized: 'Thế nào mới gọi là "chết"? '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021571
    m_Localized: "Có lẽ con chỉ đơn giản là thiếp đi,\nvà chúng ta tìm thấy nhau trong\ncõi mộng."
    m_Metadata:
      m_Items: []
  - m_Id: 206711021572
    m_Localized: Ta và con giống nhau ở chỗ đó.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021573
    m_Localized: "Ta là người chị em bị ghét bỏ,\nlà đứa con lạc loài trong\nđại gia đình nhân loại."
    m_Metadata:
      m_Items: []
  - m_Id: 206711021574
    m_Localized: Giờ tôi phải làm gì đây? Không còn... gì nữa ư?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021575
    m_Localized: '...Tôi sợ lắm. '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021576
    m_Localized: Hiển nhiên rồi.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021577
    m_Localized: "Vương quốc bé nhỏ này\nđã nuốt trọn biết bao cơn mơ."
    m_Metadata:
      m_Items: []
  - m_Id: 206711021578
    m_Localized: Con muốn đi về nơi đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021579
    m_Localized: "Về bên những người có đôi mắt\nđã in dấu vào trái tim mình chăng?"
    m_Metadata:
      m_Items: []
  - m_Id: 206711021580
    m_Localized: Không, con nào muốn nhìn thấy họ.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021581
    m_Localized: Con đã thấm mệt rồi.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021582
    m_Localized: Ta biết con cần đến đâu.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021583
    m_Localized: "Đến một nơi tràn ngập những\ntấm gương khắc hoa văn, cho con\ncảm giác xung quanh đủ đầy."
    m_Metadata:
      m_Items: []
  - m_Id: 206711021584
    m_Localized: "Không việc gì phải sợ hãi. Bàn tay ta\ntạo nên thời gian. Ở đây không có gì\nlàm hại con được."
    m_Metadata:
      m_Items: []
  - m_Id: 206711021585
    m_Localized: "Hãy bầu bạn cùng đêm đen.\nKhông còn kẻ đeo mặt nạ hay\nbất kỳ ai khác. Tất cả chỉ là\nnhững chiếc bóng hắt trên tường ta."
    m_Metadata:
      m_Items: []
  - m_Id: 206711021586
    m_Localized: Ta nhận thấy con đã sẵn sàng.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021587
    m_Localized: "Vậy ta sẽ đưa con vào màn đêm,\nnơi những tán cây thông cao vót\nđến tận sao trời."
    m_Metadata:
      m_Items: []
  - m_Id: 206711021588
    m_Localized: "Đó hẳn là điều con khao khát,\nđúng chứ?"
    m_Metadata:
      m_Items: []
  - m_Id: 206711021589
    m_Localized: Một chốn về dành cho con.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021590
    m_Localized: "Ấy vậy nhưng... những con đường\nngắn ngủi này sẽ sớm trải rộng\nthênh thang đến lạ."
    m_Metadata:
      m_Items: []
  - m_Id: 206711021591
    m_Localized: "Dài tít tắp và đóng bụi, vương đầy\nnhững lời thỏa hiệp."
    m_Metadata:
      m_Items: []
  - m_Id: 206711021592
    m_Localized: '...Chúc con vui vẻ. '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021593
    m_Localized: '...  '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021594
    m_Localized: Tôi chết rồi ư?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021595
    m_Localized: 'Tôi sẽ bị kẹt ở đây vĩnh viễn sao? '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021596
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206711021597
    m_Localized: 'Còn ai tới nữa không? '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021598
    m_Localized: 'Cho tôi xem phim hay gì với? '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021599
    m_Localized: '...  '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021600
    m_Localized: 'Còn ai tới nữa không? '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021601
    m_Localized: 'Cho tôi xem phim hay gì với? '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021603
    m_Localized: 'Có ai không? '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021604
    m_Localized: '...Tôi sợ lắm. '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021605
    m_Localized: '... '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021606
    m_Localized: 'Có ai không? '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021607
    m_Localized: '...Tôi sợ lắm. '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021608
    m_Localized: '... '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021609
    m_Localized: '... '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021610
    m_Localized: 'Ở đây, ngày cũng như đêm. '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021611
    m_Localized: 'Chẳng biết đã bao lâu trôi qua rồi. '
    m_Metadata:
      m_Items: []
  - m_Id: 206711021612
    m_Localized: "Nhưng lúc này... mình cảm thấy\nbình yên đến lạ."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215872
    m_Localized: "Không tiếng chân. Không giọng nói.\nKhông cảm xúc trong lòng."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215873
    m_Localized: "Chẳng nhớ mình tới đây\nbằng cách nào nữa."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215874
    m_Localized: Mà cũng không biết làm thế nào để rời đi.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215875
    m_Localized: 'Nhưng mình chẳng muốn đi đâu. '
    m_Metadata:
      m_Items: []
  - m_Id: 206715215876
    m_Localized: Mình chỉ mong khoảnh khắc này kéo dài thêm đôi lát...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215877
    m_Localized: Rốt cuộc mọi chuyện có ý nghĩa gì nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215878
    m_Localized: 'Sao mình lại được vào đây? '
    m_Metadata:
      m_Items: []
  - m_Id: 206715215879
    m_Localized: 'Liệu có ai đến tìm mình không? '
    m_Metadata:
      m_Items: []
  - m_Id: 206715215880
    m_Localized: 'Ước gì được gặp lại họ lần nữa. '
    m_Metadata:
      m_Items: []
  - m_Id: 206715215881
    m_Localized: '... '
    m_Metadata:
      m_Items: []
  - m_Id: 206715215882
    m_Localized: 'Giờ mình... thấm mệt rồi. '
    m_Metadata:
      m_Items: []
  - m_Id: 206715215883
    m_Localized: 'Cứ nghỉ ngơi một lúc vậy. '
    m_Metadata:
      m_Items: []
  - m_Id: 206715215884
    m_Localized: "Ô hô!\nNấm là một loài vô cùng đặc biệt đó con ơi!"
    m_Metadata:
      m_Items: []
  - m_Id: 206715215885
    m_Localized: Tụi nó cứ vậy mà lớn dần, lớn nữa, lớn hoài... lớn nhanh như cây đậu thần ngay trước mắt ta vậy.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215886
    m_Localized: 'Làm ta càng thêm tò mò: Khi đồng hồ điểm khắc nửa đêm, tụi nó sẽ hóa nên hình hài gì đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215887
    m_Localized: ...lại càng có nhiều độc tố thâm thù tích tụ bên trong hệ sợi nấm.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215888
    m_Localized: ...Cho tới khi không còn gì nữa.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215889
    m_Localized: "Bây giờ thì con ơi, hệ sợi nấm phải tìm cách\ngiải phóng toàn bộ cơn thịnh nộ..."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215890
    m_Localized: "Quỷ thần thiên địa ơi. Nghi lễ của chúng ta\nđáng lẽ phải làm nó nguôi giận rồi chứ."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215891
    m_Localized: "Những hạt táo này vốn là để nhắc\ncho nó nhớ, mối liên kết sâu đậm giữa\nloài người và loài nấm."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215892
    m_Localized: "Nhưng mà có vẻ như hệ sợi nấm đương\nloạn hết cả lên rồi. Cơn cuồng nộ đã\nkhiến chúng đâm ra mù quáng."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215893
    m_Localized: Xứ Nấm chắc chắn ở đâu ngoài kia đó!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215894
    m_Localized: "Lẹ làng lên con ơi! Ta phải ngăn\nhệ sợi nấm lại trước khi cây nấm\nlớn lên quá cỡ!"
    m_Metadata:
      m_Items: []
  - m_Id: 206715215895
    m_Localized: Chúng ta cùng phi xuống lòng đất thôi!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215896
    m_Localized: Quỷ thần ơi... Mình tới trễ quá rồi con à.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215897
    m_Localized: Thôi thì đành bó tay.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215898
    m_Localized: "Nói nghe chứ...\nCon còn miếng trà kombucha nào hông?"
    m_Metadata:
      m_Items: []
  - m_Id: 206715215903
    m_Localized: "Ngước mắt lên mà xem!\nHào quang hỏa ngục đang dần lu mờ!"
    m_Metadata:
      m_Items: []
  - m_Id: 206715215904
    m_Localized: "Thời đại đẫm máu đã qua đi,\nnhường chỗ cho kỷ nguyên mới.\nMột thế giới nơi thái bình thịnh trị."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215905
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215906
    m_Localized: "Chẳng cần phải ưu tư muộn phiền nữa.\nĐàn chim non của ta sẽ nuốt trọn\nmồi ngon của nỗi thống khổ."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215907
    m_Localized: Hỡi các anh em, ngày lành đã điểm! Hôm nay... chúng ta cùng đón nhận sự cứu rỗi.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215908
    m_Localized: Trước tiên, hãy chung tay cử hành nghi lễ. Rồi sau đó... chỉ việc kiên nhẫn đợi chờ.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215909
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215911
    m_Localized: Chúng ta khắc tên cho từng người đã khuất, để biết rằng cái chết của họ chẳng vô nghĩa. Tử Thần sẽ đón họ đi, như chúng ta vậy.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215912
    m_Localized: "Chính bằng cách này, chúng ta đã tiễn đưa\nOlun về nơi an nghỉ. Đó là tên chúng ta\nđặt cho anh."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215913
    m_Localized: "Và bản thân chúng ta cũng sẽ\nnhận tên cho mình."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215914
    m_Localized: Đến rồi. Đây chính là thời khắc thiêng liêng.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215915
    m_Localized: "Nào các anh em, hãy cùng thành tâm\nkhẩn gọi Ngài. Chúng ta đã sẵn sàng."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215916
    m_Localized: "Không phải để tan vào cõi hư vô,\nmà để về với vòng tay Tử Thần."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215917
    m_Localized: "Chúng ta hiến dâng xác thịt này cho\ntấm lòng bao dung của Ngài, hòng\ntìm kiếm sự an nghỉ vĩnh hằng."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215918
    m_Localized: "Tri thức này từng tồn tại trên Quả Đất, nhưng sự kiện tuyệt chủng đã cướp đi\ntất cả. Sinh mệnh mất, tư tưởng mất theo."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215919
    m_Localized: "Đứng tại nơi đây, một lần nữa ta\nthấm nhuần cách hiến dâng\ntấm thân mình cho Ngài."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215920
    m_Localized: "Một giọng nói không rõ lai lịch\nbất chợt vang lên."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215921
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215922
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215923
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215924
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215925
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215926
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215927
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215928
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215929
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215930
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215931
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215932
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215933
    m_Localized: "Con nảy nở từ thinh không.\nMọi ánh mắt đổ dồn về phía con."
    m_Metadata:
      m_Items: []
  - m_Id: 206715215934
    m_Localized: Có những cánh cửa chỉ nên mãi đóng kín.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215935
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215936
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 206715215937
    m_Localized: Vốn dĩ tôi không định tạt qua đâu, nhưng tôi lại thấy điềm báo... Có chuyện kỳ lạ đang xảy ra ở đây.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215938
    m_Localized: Lúc nhìn nhà cậu, tôi bỗng dưng nhớ đến một bài hát nọ.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215939
    m_Localized: Như thể khi ta đối diện với thứ gì quá tăm tối, đến nỗi không còn ham muốn gì nữa, và rồi mặt đất lạnh lẽo nhìn ta chằm chặp.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215940
    m_Localized: Có phải... cậu đã làm gì rồi không?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215941
    m_Localized: Tôi chẳng hiểu ông đang nói gì
    m_Metadata:
      m_Items: []
  - m_Id: 206715215942
    m_Localized: Thì tôi có giết mấy tên Dị Khách. Đó là cách duy nhất để sinh tồn
    m_Metadata:
      m_Items: []
  - m_Id: 206715215943
    m_Localized: Cậu rất hiểu là đằng khác.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215944
    m_Localized: Có thứ gì đó bám theo cậu, để lại một vệt bóng đêm dài sau lưng. Ôi... sao lại ra nông nỗi này cơ chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215945
    m_Localized: Sợ chết ư? Làm mọi cách để sinh tồn ư? Đó là bản năng tự nhiên mà thôi.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215946
    m_Localized: Nhưng cậu lại đi chệch khỏi quỹ đạo ban đầu. Nỗi sợ đã khiến cậu đưa cái chết tới gần hơn bao giờ hết.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215947
    m_Localized: ...Thế này thì tôi chịu rồi. Không cứu vãn nổi. Xin lỗi cậu.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215948
    m_Localized: Không, rõ ràng có gì sai lắm.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215949
    m_Localized: Chờ chút nào... Tôi nhìn ra rồi.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410176
    m_Localized: Cậu sợ quá nên đã... Ôi thánh thần ơi...
    m_Metadata:
      m_Items: []
  - m_Id: 206719410177
    m_Localized: Nỗi khiếp sợ đã khiến cậu đâm mù quáng.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410178
    m_Localized: ...Kết cục đã định rồi. Tôi không tài nào cứu vãn nổi. Thực lòng xin lỗi cậu.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410179
    m_Localized: Tôi rất hiểu cảm giác đó.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410180
    m_Localized: "Đẩy ta đến bước đường cùng,\nsa vào lầm lỡ."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410181
    m_Localized: "Nhưng rốt cuộc thì năng lực này\nchỉ khiến mọi chuyện càng tồi tệ đi."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410182
    m_Localized: Nói tôi nghe, điều gì làm cậu e sợ đến vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410183
    m_Localized: Nỗi đau ư?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410184
    m_Localized: Phải tan biến ư?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410185
    m_Localized: Không sớm thì muộn thôi.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410186
    m_Localized: Nhưng... cậu lại chọn kết cục đến sớm.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410187
    m_Localized: Thực lòng xin lỗi cậu.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410188
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206719410189
    m_Localized: Máu me bê bết. Tay không tấc sắt.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410190
    m_Localized: "Bạn chẳng còn chút sức tàn để lê lết\nkhỏi ánh mặt trời nữa."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410191
    m_Localized: Chẳng thể tự mình chấm dứt mọi khổ đau.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410192
    m_Localized: Lửa trời sẽ thiêu rụi bạn... từng chút một.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410193
    m_Localized: Trừ phi...
    m_Metadata:
      m_Items: []
  - m_Id: 206719410194
    m_Localized: 'Window: Bạn lại trông thấy đứa bé ấy. Nhưng sao nó lại ở đó nhỉ? '
    m_Metadata:
      m_Items: []
  - m_Id: 206719410195
    m_Localized: 'Window: Nó đang ăn thịt con chó sao? ...Không phải. Chỉ là đang áp sát vào ngực sinh vật đó thôi. '
    m_Metadata:
      m_Items: []
  - m_Id: 206719410196
    m_Localized: 'Window: Toàn thân bạn tê cứng, không tài nào nhúc nhích được.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410197
    m_Localized: 'Window: Sao nó không đi tìm mẹ của mình nhỉ? '
    m_Metadata:
      m_Items: []
  - m_Id: 206719410198
    m_Localized: 'Window: Chẳng biết chị ta có thực sự hoài thai không nữa? '
    m_Metadata:
      m_Items: []
  - m_Id: 206719410199
    m_Localized: 'Window: Trong lúc bạn suy ngẫm, cảnh vật bên ngoài bỗng chốc mờ dần, bị bóp nghẹt trong làn sương dày đặc. '
    m_Metadata:
      m_Items: []
  - m_Id: 206719410200
    m_Localized: Bạn cảm nhận có thứ gì đó đang ở gần.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410201
    m_Localized: "Bạn cũng nhìn thấy đứa bé,\nnhưng đấy không phải là vấn đề."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410202
    m_Localized: "Một làn sương mịt mù\nnhấn chìm cả thế giới."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410203
    m_Localized: Nuốt trọn mọi thanh âm.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410204
    m_Localized: "Bao trùm vạn vật trong bầu lặng thinh,\ntựa màn tơ che phủ."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410205
    m_Localized: Nghe như có tiếng người xì xầm.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410206
    m_Localized: "Bạn cất tiếng gọi, nhưng lời bạn\nchết lặng giữa thinh không."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410207
    m_Localized: Hay họ chính là điềm báo cho thảm kịch?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410208
    m_Localized: Đứa bé cựa quậy trong vòng tay họ.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410209
    m_Localized: "Nó không còn có thể ban phát ánh sáng\nxuống trần gian này nữa...\nẤy là bạn nghĩ vậy thôi."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410210
    m_Localized: "Liệu nó sẽ là thần linh cứu rỗi,\nhay ác quỷ đọa đày chúng ta?"
    m_Metadata:
      m_Items: []
  - m_Id: 206719410211
    m_Localized: Bạn tê liệt trong cơn hoảng loạn.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410212
    m_Localized: "Ba người họ cùng lúc kéo giật đứa bé\ntheo ba hướng khác nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410213
    m_Localized: "Bạn giương cao nòng súng rồi bóp cò.\nChẳng cần biết nhắm vào đâu,\ncứ thế mà bắn."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410214
    m_Localized: "Là sao đây?\nSao mọi người ăn mặc lạ lùng thế?"
    m_Metadata:
      m_Items: []
  - m_Id: 206719410215
    m_Localized: "Từ trong làn sương mờ ảo,\nthêm nhiều bóng hình lộ diện."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410216
    m_Localized: "Một người phụ nữ cất giọng:\n\"Anh không hiểu sao? Anh là nhà tiên tri\"."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410217
    m_Localized: "Chính anh là ánh sáng cứu rỗi\ncho chúng tôi."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410218
    m_Localized: Không một ai sẵn sàng cả.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410219
    m_Localized: Và thiên đàng sẽ rộng cửa chào đón.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410220
    m_Localized: Anh sẽ hy sinh để chúng tôi được cứu sống!
    m_Metadata:
      m_Items: []
  - m_Id: 206719410221
    m_Localized: Sao lại điên cuồng, loạn trí thế này?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410222
    m_Localized: Ai mà biết được họ sẽ làm gì bạn?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410223
    m_Localized: "Bạn nhác thấy đinh kim loại lóe lên\ntrong bàn tay ai đó giữa đám đông."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410224
    m_Localized: "Một kết cục khủng khiếp sắp sửa\ngiáng xuống thị trấn này."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410225
    m_Localized: 'Gasmask: Chào đồng chí.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410226
    m_Localized: 'Gasmask: Chúng tôi ghi nhận những đóng góp xuất sắc của đồng chí trong công cuộc ứng phó thảm họa.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410227
    m_Localized: 'Gasmask: Chúng tôi rất cần những người như đồng chí. Mời đồng chí gia nhập.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410228
    m_Localized: Thật luôn á?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410229
    m_Localized: Sao lại chọn tôi?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410230
    m_Localized: 'Gasmask: Chúng tôi hiểu những vướng mắc của đồng chí, nhưng không cần lo lắng. Đồng chí sẽ được hưởng lương đầy đủ, kèm theo toàn bộ phúc lợi.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410231
    m_Localized: 'Gasmask: Giờ thì mời đồng chí chuẩn bị. Đồng chí sẽ đi cùng chúng tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410232
    m_Localized: Tôi không thích
    m_Metadata:
      m_Items: []
  - m_Id: 206719410233
    m_Localized: Tôi sẵn sàng rồi
    m_Metadata:
      m_Items: []
  - m_Id: 206719410234
    m_Localized: 'Gasmask: Đồng chí thể hiện sự tháo vát, chủ động kiểm soát tình hình. Đó chính là những phẩm chất chúng tôi tìm kiếm.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410235
    m_Localized: 'Gasmask: Các đồng chí được tuyển mộ sẽ giúp chúng tôi lấp đầy những thiếu sót hiện tại.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410236
    m_Localized: 'Gasmask: Và ngay lúc này, chúng tôi cần thêm nhân sự mới.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410237
    m_Localized: Tôi không thích
    m_Metadata:
      m_Items: []
  - m_Id: 206719410238
    m_Localized: Tôi sẵn sàng rồi
    m_Metadata:
      m_Items: []
  - m_Id: 206719410239
    m_Localized: 'Gasmask: ...Tôi không hỏi ý đồng chí.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410240
    m_Localized: 'Gasmask: Yêu cầu đồng chí thu dọn đồ đạc và khẩn trương lên xe, không thì đích thân chúng tôi sẽ giải đồng chí lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410241
    m_Localized: 'Gasmask: Quyết định sao là ở đồng chí.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410242
    m_Localized: 'Gasmask: Rất tốt. Đồng chí chỉ cần mang theo những gì thiết yếu thôi. Chúng tôi sẽ chu cấp chỗ ở.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410243
    m_Localized: 'Gasmask: Trước mắt là trong thời gian sắp tới, đồng chí sẽ không được quay về nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410244
    m_Localized: 'Gasmask: Chuẩn bị đi, chúng tôi sẽ đợi ở ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410245
    m_Localized: "Bạn thấy chóng mặt, hoa mắt, lảo đảo.\nBên Phòng Chống Thảm Họa hay\ntuyển người kiểu này đây sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 206719410246
    m_Localized: "Đây là tổ chức quy mô lớn mà.\nHẳn bạn sẽ phải làm việc với\nnhiều người đây."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410247
    m_Localized: Sắp tới sẽ là chuỗi ngày tăng ca đằng đẵng.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410248
    m_Localized: Nghề này nguy hiểm đến mức nào nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410249
    m_Localized: "Bắt cóc người ta rồi thuê họ\nvào làm luôn à? Lạ chưa từng thấy."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410250
    m_Localized: "Tỷ lệ nhân viên nghỉ việc cao lắm hay sao\nmà lại tuyển người bằng hình thức...\nthô bạo thế?"
    m_Metadata:
      m_Items: []
  - m_Id: 206719410251
    m_Localized: Đưa người dân đến khu cách ly à?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410252
    m_Localized: Rồi sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410253
    m_Localized: "Cũng chẳng hay số phận của\nnhững người từng chung sống với mình."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410254
    m_Localized: "Bạn có linh cảm rằng mình sẽ vĩnh viễn\nkhông thể quay về với cuộc sống trước kia."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410255
    m_Localized: "Đọc qua mô tả thì rõ ràng, bọn họ thiết kế\ncông việc này không dành cho người muốn\nsống khỏe, sống lâu đâu."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410256
    m_Localized: "Bạn chỉ tiếc mỗi một điều là\nquên không mang tấm áp phích theo."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410257
    m_Localized: "Bạn nghe tiếng gã điên quát tháo ầm ĩ\ntrước cửa nhà mình."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410258
    m_Localized: "Bạn chỉ biết đợi chờ, mong rằng\nsẽ chẳng có chuyện gì xảy ra."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410259
    m_Localized: "Cơn thịnh nộ trong ánh mắt kẻ cầm súng\ncòn đáng sợ hơn Dị Khách gấp trăm lần."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410260
    m_Localized: Bạn nghe thấy tiếng thở khò khè của hắn.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410261
    m_Localized: Thằng khốn. Hắn... bắn mình.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410262
    m_Localized: "Mình tưởng... hắn muốn câu giờ... tại mình\nđâu dễ... chết vậy. Nhưng... còn những...\nngười khác thì sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 206719410263
    m_Localized: "Bỗng dưng hắn im bặt.\nCó lẽ bạn nên kiểm tra xem, liệu hắn đã..."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410264
    m_Localized: "Tại lũ rác rưởi chúng mày\nmà bao nhiêu người mới chết."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410265
    m_Localized: Lũ chúng mày giết bạn của tao.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410266
    m_Localized: Đéo để ai được sống yên ổn hết.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410267
    m_Localized: Sao? Mày nghĩ chẳng ai dám đánh trả à?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410268
    m_Localized: "Trí não bọn mày dính phải lời nguyền\nđiên dại rồi..."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410269
    m_Localized: Tao sẽ nghiền bọn mày ra bã!
    m_Metadata:
      m_Items: []
  - m_Id: 206719410270
    m_Localized: Chôn sâu cả lũ xuống lòng đất.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410271
    m_Localized: "Tao sẽ nhấn chìm CẢ THẾ GIAN\nbằng dòng máu của chúng mày!"
    m_Metadata:
      m_Items: []
  - m_Id: 206719410272
    m_Localized: "Hôm nay tao thề, lũ súc vật nào\ntay còn cầm vũ khí sẽ phải chết."
    m_Metadata:
      m_Items: []
  - m_Id: 206719410273
    m_Localized: CHẾT. TỪNG. ĐỨA. MỘT.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836555284480
    m_Localized: '"Ảnh hưởng từ mặt trời đang dịu dần...'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836555284481
    m_Localized: "...Các nhà khoa học dự báo rằng,\nchỉ trong vài ngày tới..."
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478784
    m_Localized: Niềm tin phai dần.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478785
    m_Localized: Những ánh nhìn chằm chặp.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478786
    m_Localized: Nỗi sợ cái chết đã làm bạn tê dại.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478787
    m_Localized: "Bạn còn không nghĩ đến\nkhả năng trốn thoát."
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478788
    m_Localized: Nỗi kinh hoàng khiến bạn mờ mắt.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478789
    m_Localized: Chúng nó xé xác bạn ra.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478790
    m_Localized: "Bóng đêm xộc vào nuốt chửng\ncon ngươi bạn."
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478791
    m_Localized: "Lúc này, hiện lên trong tâm trí bạn là\nmột ngôi nhà nhỏ nhoi, đơn chiếc."
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478792
    m_Localized: Thật khó để níu giữ hình bóng ấy...
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478793
    m_Localized: Ta thực mừng vui vì đã có anh gia nhập, tín hữu. Tử Thần quả không chọn nhầm người.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478794
    m_Localized: "Những nỗi khiếp sợ, những sự bóp méo\nlời thánh của Ngài, lâu nay đã khiến\nchúng ta rời xa vòng tay Ngài."
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478795
    m_Localized: "Nhưng giờ đây, chúng ta học lại\nnhững bước đi đầu tiên, nương theo\ncon đường tự cổ chí kim."
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478796
    m_Localized: "Ngài như người mẹ hiền từ,\nbao bọc tất cả chúng ta."
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478797
    m_Localized: Không một đứa con nào bị bỏ mặc.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478798
    m_Localized: "Và ngay cả bản thân Ngài,\ncũng sẽ thăng thiên..."
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478799
    m_Localized: Anh có cảm thấy không? ...Ngài đã đến.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478800
    m_Localized: Chúng ta phải hành động ngay.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478801
    m_Localized: Đến bên ta, ta sẽ đem con đi giấu.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478802
    m_Localized: "Ta sẽ trả con về lại nơi cố hữu.\nVề mái nhà vốn dĩ dành cho con."
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478803
    m_Localized: Ta sẽ ban cho con sự an nghỉ.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478804
    m_Localized: Cũng là ước mong ngàn đời của nhân loại.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478805
    m_Localized: "Lẽ ra con chẳng thể nào sống sót\nqua cơn điên loạn của Vũ Trụ này."
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478806
    m_Localized: ...Để ta lưu giữ ký ức của con nhé.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478807
    m_Localized: 'Vigilante: Cái địt con mẹ mày! Thằng chó Dị Khách, mày tưởng mày qua mặt được ông à?!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478808
    m_Localized: 'Vigilante: Chết cụ mày đi, thằng lồn!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478809
    m_Localized: 'Vigilante: Vãi lồn, thì ra mày là quân Dị Khách bẩn tưởi!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478810
    m_Localized: 'Vigilante: Xong đời mày rồi ôn con!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478811
    m_Localized: 'Vigilante: Ông mày đéo bị ngu đâu con ơi! Mày tưởng dắt mũi được ông đây à?'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478812
    m_Localized: 'Vigilante: Mày chết chắc rồi, thằng chó khôn lỏi!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478813
    m_Localized: "Chẳng biết hắn đã thiêu cháy, tàn sát\nbao nhiêu mạng người rồi?"
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062336
    m_Localized: 'Tĩnh tại quá. '
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062337
    m_Localized: Không còn thứ gì có thể cản bước mình.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062338
    m_Localized: 'Nhưng để sau đi... '
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062339
    m_Localized: Tình hình mà điên đảo là tụi nó sẽ mọc lên như vũ bão.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062340
    m_Localized: Mà nấm càng lớn thì...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062341
    m_Localized: "Trời đất, có khi mũ nấm còn dư sức\nbao trùm cả hành tinh."
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256640
    m_Localized: Theo chân già nào! Tức tốc lên con ơi!
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256641
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256642
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256643
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256644
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256645
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256646
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256647
    m_Localized: Cái chết thật đáng sợ.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256648
    m_Localized: "Nỗi sợ đeo bám bủa vây đủ để khiến\ncon người ta phát điên."
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256649
    m_Localized: "Tôi đã thấy trước con đường\nhọ vẽ sẵn cho cậu."
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256650
    m_Localized: Đó là điều tất yếu rồi mà.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256651
    m_Localized: Người ta tống cổ bạn ra đường.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256652
    m_Localized: Không còn ai để đổ tội, trách cứ.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256653
    m_Localized: "Hình như có gì đó\nđang dõi theo bạn đăm đăm?"
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256654
    m_Localized: "Gặp gỡ những người này\nliệu có phải là điều may?"
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256655
    m_Localized: Chuyện gì thế này?
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256656
    m_Localized: Chính anh gọi tên từng tội lỗi ở nhân gian.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256657
    m_Localized: "Lẽ ra, đứa trẻ này sẽ dẫn lối chúng tôi\nđến một vương quốc kinh hoàng."
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256658
    m_Localized: "Nhưng nhờ có anh... anh sẽ xua tan\nbóng tối bủa vây."
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256659
    m_Localized: Lời của cô gái làm bạn điếng người.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256660
    m_Localized: "Chẳng rõ ý họ là gì, nhưng chắc chắn\nmột điều: đứa trẻ đó không còn là\nngười của dương thế."
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256661
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256662
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256663
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256664
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256665
    m_Localized: Bạn không rõ khi nào các sếp mới cho về.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256666
    m_Localized: "Bạn còn chẳng biết\nnhiệm vụ của mình là gì."
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256667
    m_Localized: "Bạn không rõ căn nhà của mình\ngiờ thành ra thế nào."
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256668
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256669
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256670
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256671
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256672
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256673
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256674
    m_Localized: "Giờ tao đã mất hết tất cả.\nNhưng còn chúng mày... thì chưa đâu."
    m_Metadata:
      m_Items: []
  - m_Id: 1361586487812096
    m_Localized: ...Tất thảy đều hòa làm một với hư vô.
    m_Metadata:
      m_Items: []
  - m_Id: 1361586487812097
    m_Localized: "Khi đó chẳng còn \"ta\" nữa.\nChỉ còn một khoảng trống vô hình vô dạng."
    m_Metadata:
      m_Items: []
  - m_Id: 3948884693868544
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 3948884744200192
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 3948884744200193
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 3948884744200194
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195392
    m_Localized: Thế là hết.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195393
    m_Localized: Mình đã sống sót. Dù chỉ có một mình.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195394
    m_Localized: Chỉ còn cách này mà thôi.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195395
    m_Localized: Mình không làm gì sai cả.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195397
    m_Localized: "Đã bao nhiêu ngày trôi qua?\nBao nhiêu giờ phút?"
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195399
    m_Localized: "Nếu như ai đó ở lại...\nthì mọi chuyện có đổi khác không?"
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195400
    m_Localized: "Nếu mình đã nói thẳng cho bố biết mình\nhận ổng tới mức nào, liệu mình có đủ\ndũng khí để dứt áo ra đi?"
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195401
    m_Localized: "Mình chọn sống thế này...\nliệu em ấy có tự hào không nhỉ?"
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195402
    m_Localized: "Bốn bề tường đổ sập.\nKhông còn đâu lối thoát."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195403
    m_Localized: "Nhưng có lẽ mình cũng chẳng cần đi đâu.\nChỉ còn lại mỗi chốn này mà thôi."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195404
    m_Localized: "Nỗi căm phẫn còn sôi sùng sục trong bụng,\nmà lại nhắm mắt ra đi thì ức quá."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195405
    m_Localized: "Mình hận bố. Hận bản thân.\nHận cả thế gian này."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195406
    m_Localized: "Lúc mẹ cần nhất bờ vai nương tựa,\nai nấy đều ngoảnh mặt làm ngơ."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195407
    m_Localized: "Mỗi lần nghĩ tới việc nhìn qua cái cửa sổ\nđó... là đôi tay mình lại run lẩy bẩy."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195408
    m_Localized: "Những bức tường bao quanh\nđã ngã xuống. Để mặc mình trơ trọi\ngiữa đống hoang tàn."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195409
    m_Localized: "Mình vốn ghét cay ghét đắng căn nhà đó...\nCó lẽ mất nó đi lại là một diễm phúc."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195410
    m_Localized: "Mọi thứ trở về với cát bụi.\nẤy vậy mà mình lại thấy tự do."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195411
    m_Localized: "Chẳng còn sót lại thứ gì gợi mình nhớ đến\nnhững tháng ngày xưa cũ."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195412
    m_Localized: Phải chi em ấy cũng thấy được cảnh này...
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195413
    m_Localized: "Sao mình lại thấy lòng nhẹ nhõm\nhẳn đi nhỉ?"
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195414
    m_Localized: "Mình... Mình cũng không... Cảm giác\nđè nặng trong tâm đã tan biến, vỡ vụn\nnhư những bức tường."
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195415
    m_Localized: Không còn nữa.
    m_Metadata:
      m_Items: []
  - m_Id: 38371868175048704
    m_Localized: Mình đã quyết định hoàn toàn đúng đắn...
    m_Metadata:
      m_Items: []
  - m_Id: 38371868175048705
    m_Localized: Bố đã đẩy mẹ vào bước đường cùng.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021602
    m_Localized: '... '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
