  - m_Id: 3668215154331650
    m_Localized: No, I’m Not a Human, I’m {0}
    m_Metadata:
      m_Items: []
  - m_Id: 12124127443537900
    m_Localized: "あのビールでぐったりだ\n横になって寝ないと"
    m_Metadata:
      m_Items: []
  - m_Id: 12124292694921200
    m_Localized: Bober黒ビール
    m_Metadata:
      m_Items: []
  - m_Id: 13164343885287400
    m_Localized: "もう世界はすっかり肥溜め\n冷えたビールやっぱりこれだね"
    m_Metadata:
      m_Items: []
  - m_Id: 13164348633239600
    m_Localized: '   <sprite=0> を 0 へ'
    m_Metadata:
      m_Items: []
  - m_Id: 13170518181793800
    m_Localized: エナジェカ
    m_Metadata:
      m_Items: []
  - m_Id: 13170520799039500
    m_Localized: "純然たる化学物質\nでも徹夜するなら飲むしかない"
    m_Metadata:
      m_Items: []
  - m_Id: 13170523483394000
    m_Localized: '   <sprite=0> +1'
    m_Metadata:
      m_Items: []
  - m_Id: 13176150536474600
    m_Localized: コーヒー
    m_Metadata:
      m_Items: []
  - m_Id: 13176152247750700
    m_Localized: "もうホットコーヒーなんて飲めない\nきっと誰もが皆そのはず"
    m_Metadata:
      m_Items: []
