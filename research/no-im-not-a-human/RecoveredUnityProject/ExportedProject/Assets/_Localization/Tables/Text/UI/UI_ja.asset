  - m_Id: 179147632809156608
    m_Localized: العربية
    m_Metadata:
      m_Items: []
  - m_Id: 179157896413650944
    m_Localized: Português (Portugal)
    m_Metadata:
      m_Items: []
  - m_Id: 193168367047221248
    m_Localized: カルト
    m_Metadata:
      m_Items: []
  - m_Id: 193167011389448192
    m_Localized: 医者
    m_Metadata:
      m_Items: []
  - m_Id: 193167156193599488
    m_Localized: 足なし
    m_Metadata:
      m_Items: []
  - m_Id: 203009390581719040
    m_Localized: "信号を受信するには右ダイヤルを回します。\n右スティックを回してください。\n\n左ダイヤルは音量調整用です。"
    m_Metadata:
      m_Items: []
  - m_Id: 203009496299151360
    m_Localized: "信号が拾えないなら、周波数帯を変えてみましょう。\n左右のバンパーで切替、\n右スティックで調整してください。"
    m_Metadata:
      m_Items: []
  - m_Id: 229762759966924800
    m_Localized: "垂直反転（マウス）\r\n"
    m_Metadata:
      m_Items: []
