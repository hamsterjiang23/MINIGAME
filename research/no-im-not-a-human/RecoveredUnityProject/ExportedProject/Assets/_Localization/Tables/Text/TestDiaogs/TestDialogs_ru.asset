%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: TestDialogs_ru
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: 96de960c2325baa41805073f8f8039d6, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 49614147584
    m_Localized: 'biglebowski: У меня глаза в последнее время глаза чешутся.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119104
    m_Localized: 'biglebowski: Как думаешь, это от солнца? Или че?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119105
    m_Localized: 'biglebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119106
    m_Localized: 'biglebowski: Да блять.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119107
    m_Localized: 'biglebowski: Это болячка какая-нибудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119108
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49635119109
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49635119110
    m_Localized: 'biglebowski: Слушай, а придумал схемку.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119111
    m_Localized: 'biglebowski: Давай с других деньги брать, чтобы не стрелять им в лицо?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119112
    m_Localized: 'biglebowski: Прикинь, сколько нарубим!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119113
    m_Localized: 'biglebowski: Чего? Надо подумать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119114
    m_Localized: 'biglebowski: Да и соси ты х...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119115
    m_Localized: 'biglebowski: ААААААААА.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119116
    m_Localized: 'biglebowski: Да ты че, я нормальный.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119117
    m_Localized: 'biglebowski: Ничего такого с ногтями не делаю, во, глянь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119118
    m_Localized: 'biglebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119119
    m_Localized: 'biglebowski: Не, ты не подумай.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119120
    m_Localized: 'biglebowski: Я моюсь, просто как-то времени не было сегодня руки сполоснуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119121
    m_Localized: 'biglebowski: Вообще, чисто, вроде.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119122
    m_Localized: 'biglebowski: Молорик, каждого так месить - мешков не напасешься.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119123
    m_Localized: 'biglebowski: Кстати, а что с трупами потом происходит?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119124
    m_Localized: 'biglebowski: Типа, их на улицу выкидываешь? Или что?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119125
    m_Localized: 'biglebowski: Ты же не убьешь человека просто за грязные ногти?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119126
    m_Localized: 'biglebowski: Да ладно. Не думал, что так тупо умру.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119127
    m_Localized: 'biglebowski: Сфоткаться со мной хочешь? Ну погнали.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119128
    m_Localized: 'biglebowski: У меня светочувствительность только высокая. Могу дернуться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119129
    m_Localized: 'biglebowski: (Вы фотографируете собеседника)'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119130
    m_Localized: 'biglebowski: (Вроде, фотография нормальная, но лицо...)'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119131
    m_Localized: 'biglebowski: (Оно получилось очень размазанным)'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119132
    m_Localized: 'biglebowski: Вот об этом я и говорил.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119133
    m_Localized: 'biglebowski: Перефоткаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119134
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49635119135
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49635119136
    m_Localized: 'biglebowski: Ты меня не разводи, ты этих лохов прогревай.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119137
    m_Localized: 'biglebowski: Пусть в тонусе держатся.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119138
    m_Localized: 'biglebowski: А то расслабятся, забудут, благодаря кому они тут и не будут платить.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119139
    m_Localized: 'biglebowski: Подожди!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119140
    m_Localized: 'biglebowski: Нахуй тебя и твой дом, я пошел.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119141
    m_Localized: 'biglebowski: Прямо под солнцем. Оставляю это на твоей совести.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119142
    m_Localized: 'biglebowski: Хоба, зубы это я могу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119143
    m_Localized: 'biglebowski: У меня братюльник делал зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119144
    m_Localized: 'biglebowski: Его забили, прикинь, все зубы нахуй ХАХАХАХАХАХА.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119145
    m_Localized: 'biglebowski: А, показать надо. Ща.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119146
    m_Localized: 'biglebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119147
    m_Localized: 'biglebowski: Норм, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119148
    m_Localized: 'biglebowski: Ты чего?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119149
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49635119150
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49635119151
    m_Localized: 'biglebowski: Я понимаю, конечно, начнешь напрягаться из-за всяких там гостей и прочего.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119152
    m_Localized: 'biglebowski: Да и ради нас всё же это делаешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119153
    m_Localized: 'biglebowski: Короче, не держу на тебя зла. От души.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119154
    m_Localized: 'biglebowski: Ты угараешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119155
    m_Localized: 'biglebowski: Ты че?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119156
    m_Localized: 'neighbour: Привет! Я тут от знакомых услышал. Что-то произошло и скоро об этом объявят.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119157
    m_Localized: 'neighbour: А тебе кот случаем не нужен? Держи кота'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119158
    m_Localized: 'Sosed: Если к тебе будут приходить, ты их впускай. Только осторожно, ладно?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119159
    m_Localized: 'Sosed: Я слышал случаи, когда людей убивали другие люди.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119160
    m_Localized: 'Sosed: Теперь я слышу эти истории всё чаще и чаще.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119161
    m_Localized: 'Sosed: Знакомый сказал, что приходят существа, похожие на людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119162
    m_Localized: 'Sosed: Через несколько дней скажут, по каким признакам можно отличать их от людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119163
    m_Localized: 'Sosed: Одному оставаться нельзя - придёт что-то очень злобное и... кто знает что дальше?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119164
    m_Localized: Что там происходит вообще?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119165
    m_Localized: На улице безопасно?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119166
    m_Localized: 'neighbour: Ночью спокойно можно смотреть в окна.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119167
    m_Localized: 'neighbour: И я даже советую. Так ты хотя бы понимаешь, что окружает твой дом.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119168
    m_Localized: 'neighbour: Днём смотреть тяжко. Очень жарко становится, глаза от света такого болят.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119169
    m_Localized: Из дома теперь лучше не выходить?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119170
    m_Localized: Подожди, и что теперь делать?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119171
    m_Localized: 'neighbour: Давай подытожим.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119172
    m_Localized: 'neighbour: Ночью будут приходить люди. Ты решай кого впустить, кого нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119173
    m_Localized: 'neighbour: Визуально сложно решить, нам потом раскроют власти, что делать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119174
    m_Localized: 'neighbour: Смотри в окна. Мало ли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119175
    m_Localized: 'neighbour: И не высовывайся из дома. Теперь опасно везде.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119176
    m_Localized: 'neighbour: Я сегодня переночую у тебя в кабинете. А завтра ты уже сам как-нибудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119177
    m_Localized: 'neighbour: Днём зайди ко мне, поговорим.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119178
    m_Localized: 'neighbour: Давай проговорю на всякий случай.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119179
    m_Localized: 'neighbour: Днём ты можешь поговорить с гостями твоего дома на всякие темы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119180
    m_Localized: 'neighbour: В диалоге с ними ты можешь проверить признаки фальшивых людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119181
    m_Localized: 'neighbour: Дальше сам примешь решение, что делать с теми, кто на твой взгляд не человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119182
    m_Localized: 'neighbour: Если больше не захочешь ни с кем общаться, но силы останутся - пей пиво на кухне.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119183
    m_Localized: 'neighbour: Там в холодильнике я тебе принёс охладиться. Так захочется спать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119184
    m_Localized: 'neighbour: И ждём помощи. Если объявят эвакуацию - держись рядом с моей семьёй.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119185
    m_Localized: 'neighbour: Сейчас попей пива и ложись отдыхать. Уставший у тебя вид.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119186
    m_Localized: 'neighbour: Да, кстати, я слышал, что ночью кто-то ходит и спрашивает, один ли ты дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119187
    m_Localized: 'neighbour: Если открыл дверь - не говори, что ты один.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119188
    m_Localized: 'neighbour: Смотрел выпуск новостей? Кошмар какой-то...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119189
    m_Localized: 'neighbour: Ладно. В такую жару каждый диалог будет тратить твои силы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119190
    m_Localized: 'neighbour: Так что хорошо думай, с кем ты хочешь поговорить.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119191
    m_Localized: 'neighbour: И ещё: проверять людей на признаки "гостя" тоже в диалоге надо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119192
    m_Localized: 'neighbour: Так что осторожно трать свои силы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119193
    m_Localized: 'neighbour: Если решишь, что поговорил со всеми, а спать не хочется - бахни пива.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119194
    m_Localized: 'neighbour: Сходи на кухню, попей холодненького из холодильника.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119195
    m_Localized: 'neighbour: Это потратит все твои силы, и ты сразу захочешь спать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119196
    m_Localized: То есть, мне просто сидеть и... выживать?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119197
    m_Localized: Как-то это странно всё. Тебе не кажется?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119198
    m_Localized: 'TV: Вы видите грациозно танцующих балерин, рассекающих по сцене в красивых пируэтах.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119199
    m_Localized: 'TV: Классический танец навевает вам тёплые воспоминания из детства, а также заставляет вас думать о прекрасном.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119200
    m_Localized: 'TV: Доброе утро, дорогие зрители.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119201
    m_Localized: 'TV: В эфире утренний прогноз погоды.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119202
    m_Localized: 'TV: В нашем городе продолжает сиять солнце и стоять летний зной.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119203
    m_Localized: 'TV: Продолжительность такой жары уже побила рекорд Гиннеса, и, кажется, хорошая погода никуда не собирается уходить.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119204
    m_Localized: 'TV: Учёные внимательно наблюдают за активностью солнца и прогнозируют её усиление.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119205
    m_Localized: 'TV: Но, по их уверениям, причин для беспокойства нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119206
    m_Localized: 'TV: Поэтому запасайтесь солнцезащитными очками, берите свои лучшие купальники и не забывайте про головные уборы!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119207
    m_Localized: 'TV: И самое главное – смотрите, чтобы вам не напекло голову.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119208
    m_Localized: 'TV: По городу в последнее время участились случаи неадекватного поведения, которое, как полагают эксперты, связано с излишним пребыванием на солнце.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119209
    m_Localized: 'daughter: Привет!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119210
    m_Localized: 'daughter: Мой папа у вас? Вы позовете его?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119211
    m_Localized: 'daughter: Днем было не страшно, но сейчас страшно – много людей повыходило ночью гулять…'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119212
    m_Localized: Как зовут твоего папу?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119213
    m_Localized: Расскажи что-нибудь о своем папе.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119214
    m_Localized: 'daughter: Вы забыли его имя? А, вы проверяете меня, не гость ли я.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119215
    m_Localized: 'daughter: А вы хитрый! Я тоже буду людей проверять теперь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119216
    m_Localized: Спокойно дошла сюда?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119217
    m_Localized: Боишься гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119218
    m_Localized: 'daughter: Хм, я много про него знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119219
    m_Localized: 'daughter: Перед тем, как пойти в гости, он любит попить немного пива, хи-хи.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119220
    m_Localized: 'daughter: Мне он оставляет и обед, и ужин, и сок.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119221
    m_Localized: 'daughter: Я сегодня попробовала пиво, которое он пьет, фу, гадость какая!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119222
    m_Localized: 'daughter: Зачем такое пить, если есть сок?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119223
    m_Localized: 'daughter: Ой, не говорите ему, пожалуйста.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119224
    m_Localized: Спокойно дошла сюда?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119225
    m_Localized: Боишься гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119226
    m_Localized: 'daughter: Знаете, как будто все перевернулось с ног на голову.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119227
    m_Localized: 'daughter: Люди днем теперь сидят дома или спят. Ночью – гуляют и делают дела.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119228
    m_Localized: 'daughter: Я еще не отвыкла бояться темноты, но, вроде, и бояться нечего.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119229
    m_Localized: 'daughter: Или есть чего?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119230
    m_Localized: Зову папу тебе. Удачи!
    m_Metadata:
      m_Items: []
  - m_Id: 49635119231
    m_Localized: Хорошо проведите время!
    m_Metadata:
      m_Items: []
  - m_Id: 49635119232
    m_Localized: 'daughter: Не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119233
    m_Localized: 'daughter: Все их боятся, мне тоже страшно. Я не видела ни одного из них.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119234
    m_Localized: 'daughter: Они страшные? Больно бьют?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119235
    m_Localized: 'daughter: Если меня мой друг из школы ударил больно – он тоже гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119236
    m_Localized: 'daughter: Папа сказал быть осторожной, я очень осторожна!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119237
    m_Localized: 'daughter: Очень тихонько сюда пришла, никто меня не видел.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119238
    m_Localized: Зову папу тебе. Удачи!
    m_Metadata:
      m_Items: []
  - m_Id: 49635119239
    m_Localized: Хорошо проведите время!
    m_Metadata:
      m_Items: []
  - m_Id: 49635119240
    m_Localized: 'daughter: Спасибо, вам тоже!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119241
    m_Localized: 'daughter: Мы уже пойдем, а то мне страшно одной ночью.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119242
    m_Localized: 'daughter: Мы будем играть в игру, он сделал мне какую-то, там надо кубики бросать!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119243
    m_Localized: 'daughter: И потом ходить по предметам, то есть, по креслу, там, или дивану.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119244
    m_Localized: 'daughter: И вот, надо строить дорогу. Короче, я покажу вам потом.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119245
    m_Localized: 'daughter: До свидания!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119246
    m_Localized: 'Esenin: К вам можно?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119247
    m_Localized: 'Esenin: Я укрывался в пабе, но…'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119248
    m_Localized: 'Esenin: Меня просто выгнали.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119249
    m_Localized: 'Esenin: За что? Хм. Не каждый выдерживает мой темперамент.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119250
    m_Localized: 'Esenin: Но я не обижаю никого, не подумай. Просто…  тошно иногда. Сам понимаешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119251
    m_Localized: 'Esenin: Что думаешь? Впустишь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119252
    m_Localized: Ты же не гость?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119253
    m_Localized: С тобой не будет проблем?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119254
    m_Localized: 'Esenin: Думаешь, я из этих чудовищ?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119255
    m_Localized: 'Esenin: Нет. Не гость. Но спрашивать каждого в лицо об этом - ебаный бред.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119256
    m_Localized: 'Esenin: Впрочем, теперь по-другому не будет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119257
    m_Localized: Почему тебя выперли из прошлого убежища?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119258
    m_Localized: Почему ты думаешь, что тут будет по-другому?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119259
    m_Localized: 'Esenin: Что ты называешь проблемами, домовладелец?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119260
    m_Localized: 'Esenin: Убийства и драки противны моей душе. Но в обиду себя не дам.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119261
    m_Localized: 'Esenin: Выпить и поесть я люблю. Люблю поговорить в приподнятом настроении. Это проблема?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119262
    m_Localized: Почему тебя выперли из прошлого убежища?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119263
    m_Localized: Почему ты думаешь, что тут будет по-другому?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119264
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119265
    m_Localized: 'Esenin: Думал сначала тебе что-нибудь обидное сказать, но передумал.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119266
    m_Localized: 'Esenin: Я уже говорил: неудобно людям со мной там было. Сидели черт знает кто.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119267
    m_Localized: 'Esenin: Так подумать, может, и хорошо, что выперли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119268
    m_Localized: 'Esenin: Эти живьем бы сожрали и не заметили бы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119269
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119270
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119271
    m_Localized: 'Esenin: А что мне, сдохнуть под солнцем теперь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119272
    m_Localized: 'Esenin: Не, домовладелец, мне такое не интересно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119273
    m_Localized: 'Esenin: Пока жив, еще поищу с кем поговорить и на какую тему. Ты не впустишь – повезет в другом месте.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119274
    m_Localized: 'Esenin: Если в этом новом мире остались везение и не ублюдки.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119275
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119276
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119277
    m_Localized: 'Esenin: М. Я понимаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119278
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119279
    m_Localized: 'Esenin: Понимаю тебя, но злюсь. Ты просто такой же трус, как и все тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119280
    m_Localized: 'Esenin: Спи спокойно по ночам, домовладелец. И пошёл нахуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119281
    m_Localized: 'Esenin: Спасибо. Доверия к людям сейчас – не больше монеты.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119282
    m_Localized: 'Esenin: Поэтому ценю твоё доверие. Может…  Ладно, не могу обещать ничего.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119283
    m_Localized: 'anxiety: Здравствуйте!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119284
    m_Localized: 'anxiety: Извините, что так поздно, днем как-то жарко, по телевизору говорили, что лучше не выходить при солнце.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119285
    m_Localized: 'anxiety: Не найдется ли у вас местечка для меня?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119286
    m_Localized: Ты кто?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119287
    m_Localized: Как здесь оказалась?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119288
    m_Localized: 'anxiety: Ммм, я жила поближе к городу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119289
    m_Localized: 'anxiety: Там, конечно, асфальт нагревается очень неслабо, хе-хех. Э-э-эх.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119290
    m_Localized: 'anxiety: Я вообще кассиром работала. Когда-то, сейчас уже нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119291
    m_Localized: 'anxiety: Меня уволили, с работой как-то не повезло…'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119292
    m_Localized: Что будешь теперь делать?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119293
    m_Localized: Как думаешь, что будет дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119294
    m_Localized: 'anxiety: Я не то чтобы хотела приходить. Да, асфальт уже плавится под ногами, но пока не так уж все плохо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119295
    m_Localized: 'anxiety: Вы будете смеяться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119296
    m_Localized: 'anxiety: У меня в доме поселились гости. Хах, представляете? Они меня выгнали из моего же дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119297
    m_Localized: 'anxiety: Вот, хожу теперь, ищу где бы спрятаться от солнца.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119298
    m_Localized: Что будешь теперь делать?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119299
    m_Localized: Как думаешь, что будет дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119300
    m_Localized: 'anxiety: Мммм. Постараюсь как-то выжить. Страшно, конечно, когда вокруг какие-то гости, солнце адски печет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119301
    m_Localized: 'anxiety: Очень хочется пожить. Хе-хех. О-о-о-й.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119302
    m_Localized: 'anxiety: Разве вам не страшно?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119303
    m_Localized: 'anxiety: Скажите, что все скоро кончится, пожалуйста.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119304
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119305
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119306
    m_Localized: 'anxiety: Я не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119307
    m_Localized: 'anxiety: Выживу ли я? Кто мне поможет? Долго ли я буду искать помощь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119308
    m_Localized: 'anxiety: Я не знаю, что вообще будет дальше. Даже не могу предположить.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119309
    m_Localized: 'anxiety: А тебе разве не страшно от этого? Мне – очень.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119310
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119311
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119312
    m_Localized: 'anxiety: Ахах, о-о-о-х, да-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119313
    m_Localized: 'anxiety: В любом случае спасибо, что выслушали меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119314
    m_Localized: 'anxiety: М, ладно, видимо, я пойду дальше тогда.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119315
    m_Localized: 'anxiety: Пока? Да, м, пока…'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119316
    m_Localized: 'anxiety: Спасибо. Ахах, спасибо, правда!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119317
    m_Localized: 'anxiety: Господи, я проживу еще какое-то время.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119318
    m_Localized: 'TV: На улице гробовая тишина.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119319
    m_Localized: 'TV: Никого нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119320
    m_Localized: 'TV: Даже алкоголики по непонятной причине решили не появляться на улице.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119321
    m_Localized: 'TV: Они кого-то боятся?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119322
    m_Localized: 'TV: Вы видите, как за окном у поля проводят время несколько подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119323
    m_Localized: 'TV: Они беззаботно сидят и о чём-то увлечённо болтают, не обращая на вас внимание.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119324
    m_Localized: 'TV: Вдалеке стоит дом соседа, который сейчас у вас в гостях.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119325
    m_Localized: 'TV: В окнах горит свет и, кажется, семья ждёт пока он уйдёт от вас обратно домой, на ужин.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119326
    m_Localized: 'Esenin: Я знаю не больше тебя.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119327
    m_Localized: 'Esenin: Гостей можно выявить через идельно белые зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119328
    m_Localized: 'Esenin: Это ж ебаный бред! Просто хотят, чтобы мы поубивали друг друга.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119329
    m_Localized: 'Esenin: И непонятно, для чего.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119330
    m_Localized: 'Esenin: Солнце взрывается. На земле наступил настоящий ад.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119331
    m_Localized: 'Esenin: Без метафор и чистилищ.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119332
    m_Localized: 'Esenin: Никто никому не верит, днём людей буквально сжигает заживо, а ради убежища люди и родную мать готовы продать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119333
    m_Localized: 'Esenin: Мне хотелось бы верить в людей, да верится с трудом.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119334
    m_Localized: 'Esenin: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119335
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49635119336
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49635119337
    m_Localized: 'Esenin: Да? Ты что-то хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119338
    m_Localized: Как распознать гостя?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119339
    m_Localized: Что ты знаешь про катаклизм?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119340
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119341
    m_Localized: 'TV: Жара на улице - не помеха...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119342
    m_Localized: 'TV: Когда в руках есть EnerJeka!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119343
    m_Localized: 'TV: Освежающий энергетический напиток утолит жажду даже в самый жаркий зной!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119344
    m_Localized: 'TV: Уникальная смесь лайма и мяты даёт нереальную энергию!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119345
    m_Localized: 'TV: EnerJeka. Ищите в ближайших магазинах у дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119346
    m_Localized: 'TV: Динамичная реклама энергетика, хоть и призрачно, но утоляет вам жажду.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119347
    m_Localized: 'TV: Мы прерываем утреннее шоу для срочного сообщения...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119348
    m_Localized: 'TV: Сегодня в 06:28 утра на солнце произошёл мощный выброс энергии.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119349
    m_Localized: 'TV: Данная вспышка оказалась больше, чем прогнозировали ученые.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119350
    m_Localized: 'TV: Температура на улице достигла критической отметки.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119351
    m_Localized: 'TV: Власти объявили режим чрезвычайной ситуации.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119352
    m_Localized: 'TV: Мы просим всех граждан избегать выхода на улицу в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119353
    m_Localized: 'TV: И теперь к новостям...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119354
    m_Localized: 'TV: Гости с того света? Люди, вылезающие из под земли?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119355
    m_Localized: 'TV: Нет, это не фантастический роман или заголовок жёлтой прессы!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119356
    m_Localized: 'TV: Как сообщают очевидцы, по городу стали происходить контакты с "гостями".'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119357
    m_Localized: 'TV: Один из очевидцев наткнулся на мужчину в возрасте...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119358
    m_Localized: 'TV: У которого были идеально белые зубы, без изъянов.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119359
    m_Localized: 'TV: Как выяснилось позднее, этот мужчина был "гостем".'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119360
    m_Localized: 'TV: Были замечены подобные эпизоды с "гостями", у которых идеальные зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119361
    m_Localized: 'TV: Поэтому, если вы хотите выявить "гостей" – проверяйте состояние зубов.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119362
    m_Localized: 'TV: И просим вас быть бдительными и сохранять спокойствие.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119363
    m_Localized: 'TV: А теперь перейдем к другим новостям...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119364
    m_Localized: 'anxiety: Хотела бы я сама знать как.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119365
    m_Localized: 'anxiety: Мне так страшно от того, что гостем может быть кто-угодно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119366
    m_Localized: 'anxiety: Единственное, что я по радио слышала, это что у них зубы идеальные, но...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119367
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119368
    m_Localized: 'anxiety: Неужели у обычных людей не бывает хороших зубов? Хе-хех. Э-э-эх.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119369
    m_Localized: 'anxiety: Ахах, о-о-о-х.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119370
    m_Localized: 'anxiety: Я даже не знаю что сказать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119371
    m_Localized: 'anxiety: Я решила глянуть в окно, и...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119372
    m_Localized: 'anxiety: Лучше бы я туда не смотрела.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119373
    m_Localized: 'anxiety: Солнце просто сожгло каких-то детей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119374
    m_Localized: 'anxiety: Я так не хочу умирать от испепеляющего солнца.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119375
    m_Localized: 'anxiety: Лучше быстрая и безболезненная смерть, чем смерть от солнца в агонии.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119376
    m_Localized: 'anxiety: Я не хочу быть сожжёной до тла! Не хочу! НЕТ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119377
    m_Localized: 'anxiety: Дальше будет только хуже, я знаю это! МЫ ВСЕ УМРЁМ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313408
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313409
    m_Localized: 'anxiety: Простите, я очень тревожусь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313410
    m_Localized: 'anxiety: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313411
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49639313412
    m_Localized: Ты же смотрела новости? Открывай рот
    m_Metadata:
      m_Items: []
  - m_Id: 49639313413
    m_Localized: 'anxiety: Э-э-эх. Надеюсь скоро всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313414
    m_Localized: Как распознать гостя?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313415
    m_Localized: Что ты знаешь про катаклизм?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313416
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313417
    m_Localized: 'Fan: Привет, человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313418
    m_Localized: 'Fan: Как же нам повезло! Мы застали своими глазами наказание людских страстей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313419
    m_Localized: 'Fan: Земля очистится, солнце сделает свою работу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313420
    m_Localized: 'Fan: И мы пойдем в новый чистый мир!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313421
    m_Localized: 'Fan: ВОТ ТАКАЯ, БЛЯТЬ, БЛАГОДАТЬ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313422
    m_Localized: Что?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313423
    m_Localized: Ты меня пугаешь.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313424
    m_Localized: 'Fan: Да ты чего, ЧЕЛОВЕК?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313425
    m_Localized: 'Fan: А ну-ка послушай, сейчас я тебе кратко сводочку расскажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313426
    m_Localized: 'Fan: Солнце горит и ПЕЧЕТ НАС не просто так! Оно из нас выпекает грехи!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313427
    m_Localized: 'Fan: Мы все натворили всяких дел, и вот теперь СОЛНЦЕ ЗЛИТСЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313428
    m_Localized: 'Fan: ДАЕТ ПО НАМ СВОЙ УДАР!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313429
    m_Localized: 'Fan: И это хорошо. Все грехи закончатся, будем жить как следует.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313430
    m_Localized: То есть мы должны умереть?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313431
    m_Localized: А с тобой что будет?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313432
    m_Localized: 'Fan: С ума, что ли, сошел?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313433
    m_Localized: 'Fan: А ну-ка послушай, сейчас я тебе кратко сводочку расскажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313434
    m_Localized: 'Fan: Солнце горит и ПЕЧЕТ НАС не просто так! Оно из нас выпекает грехи!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313435
    m_Localized: 'Fan: Мы все натворили всяких дел, и вот теперь СОЛНЦЕ ЗЛИТСЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313436
    m_Localized: 'Fan: ДАЕТ ПО НАМ СВОЙ УДАР!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313437
    m_Localized: 'Fan: И это хорошо. Все грехи закончатся, будем жить как следует.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313438
    m_Localized: То есть мы должны умереть?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313439
    m_Localized: А с тобой что будет?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313440
    m_Localized: 'Fan: Да какое там!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313441
    m_Localized: 'Fan: Грехи умрут, солнце, может быть, умрет. А МЫ БУДЕМ ЖИТЬ.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313442
    m_Localized: 'Fan: Больше не будет ни смертей, ни воровства, ни жадных ублюдков, которые не могу продать мне то, что я хочу за справедливую цену.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313443
    m_Localized: 'Fan: Ты можешь себе такое представить? Ты понимаешь, что это все такое?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313444
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313445
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313446
    m_Localized: 'Fan: Да я тут причем?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313447
    m_Localized: 'Fan: Мы все будем ХОРОШО ЖИТЬ сразу после помощи солнца.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313448
    m_Localized: 'Fan: Солнце поможет просто нам избавиться от всего вот этого, понимаешь? Нет?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313449
    m_Localized: 'Fan: Да все ты понимаешь, поэтому ты и жив!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313450
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313451
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313452
    m_Localized: 'Fan: Ты притворялся, что ли, что не знаешь ничего про солнце?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313453
    m_Localized: 'Fan: Ну и иди тогда нахуй, я СПАСУ КОГО-НИБУДЬ ЕЩЕ-Е-Е!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313454
    m_Localized: 'Fan: Все, пока, пока-а-а-а!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313455
    m_Localized: 'Fan: Я тебе еще расскажу много про все это!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313456
    m_Localized: 'Fan: У тебя пиво-то есть, забыл спросить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313457
    m_Localized: 'Holod: Здравствуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313458
    m_Localized: 'Holod: Сразу скажу, что мне жар не страшен. Но я все равно ищу спокойное место.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313459
    m_Localized: 'Holod: Смогу я у тебя найти покой?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313460
    m_Localized: Ты кто?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313461
    m_Localized: Как давно ты ищешь спокойное место?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313462
    m_Localized: 'Holod: Это больше не важно. Ты же спрашиваешь, не гость ли я?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313463
    m_Localized: 'Holod: Нет, я не гость. Но кое о чем я бы попросил тебя.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313464
    m_Localized: 'Holod: Попозже. Я пока не уверен.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313465
    m_Localized: Тебе не страшен жар?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313466
    m_Localized: Сними куртку.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313467
    m_Localized: 'Holod: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313468
    m_Localized: 'Holod: Для меня такого никогда не было.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313469
    m_Localized: 'Holod: Поэтому… долго.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313470
    m_Localized: Тебе не страшен жар?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313471
    m_Localized: Сними куртку.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313472
    m_Localized: 'Holod: Мне всегда холодно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313473
    m_Localized: 'Holod: Пока одни сгорают на улице, я укутываюсь в куртки, и мне все еще холодно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313474
    m_Localized: 'Holod: Мне страшно снять одежду.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313475
    m_Localized: 'Holod: Что если я получу еще больше страданий? И не смогу умереть от этого?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313476
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313477
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313478
    m_Localized: 'Holod: Ок. Сам напросился.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313479
    m_Localized: 'Holod: Ты можешь меня не впускать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313480
    m_Localized: 'Holod: Я просто пойду дальше. Не буду умолять или докучать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313481
    m_Localized: Ок. Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313482
    m_Localized: УХ! ЁБ ТВОЮ МАТЬ! А НУ СЪЕБАЛСЯ!
    m_Metadata:
      m_Items: []
  - m_Id: 49639313483
    m_Localized: 'Holod: Понимаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313484
    m_Localized: 'Holod: Хорошо, пока.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313485
    m_Localized: 'Holod: Я вижу у тебя на руках много следов пороха.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313486
    m_Localized: 'Holod: Ты можешь выстрелить в меня?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313487
    m_Localized: 'Holod: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313488
    m_Localized: 'Holod: Ну да. Пули тебе самому нужны. Пока.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313489
    m_Localized: 'Holod: Спасибо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313490
    m_Localized: 'Holod: Низковато у вас немного. Но мне подойдет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313491
    m_Localized: 'Prorok: Когда-то такое уже было и такое же повторится позже.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313492
    m_Localized: 'Prorok: Жаль что мы стали свидетелями.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313493
    m_Localized: 'Prorok: Может, и участниками.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313494
    m_Localized: Ты кто?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313495
    m_Localized: Тебе что-то нужно?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313496
    m_Localized: 'Prorok: Просто лицо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313497
    m_Localized: 'Prorok: Ничего не ищу, никого не принуждаю ни к чему.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313498
    m_Localized: 'Prorok: Из тени вышел, в тень и уйду.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313499
    m_Localized: Ты про что говоришь?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313500
    m_Localized: Ты… странный.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313501
    m_Localized: 'Prorok: Нет, спасибо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313502
    m_Localized: 'Prorok: Все, что мне нужно, уже есть.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313503
    m_Localized: 'Prorok: А чего нет, ты мне с этим не поможешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313504
    m_Localized: 'Prorok: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313505
    m_Localized: 'Prorok: Погадаешь мне? Выбери, откуда мне открыть книгу и прочитать строчку.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313506
    m_Localized: Ты про что говоришь?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313507
    m_Localized: Ты… странный.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313508
    m_Localized: 'Prorok: Это как посмотреть.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313509
    m_Localized: 'Prorok: Для тебя мои слова о чем?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313510
    m_Localized: 'Prorok: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313511
    m_Localized: 'Prorok: Погадаешь для меня по книге?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313512
    m_Localized: Открой в начале. Верхний абзац.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313513
    m_Localized: Открой ближе к середине. Последний абзац.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313514
    m_Localized: 'Prorok: Так даже и безопаснее. Для меня, в основном, но все же.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313515
    m_Localized: 'Prorok: Так проще сохранить кое-что от потопов, пожаров и времени.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313516
    m_Localized: 'Prorok: Не каждое семя становится деревом, м-да.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313517
    m_Localized: 'Prorok: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313518
    m_Localized: 'Prorok: Погадаешь мне? Выбери, откуда мне открыть книгу и прочитать строчку.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313519
    m_Localized: Открой в начале. Верхний абзац.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313520
    m_Localized: Открой ближе к середине. Последний абзац.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313521
    m_Localized: 'Prorok: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313522
    m_Localized: 'Prorok: “Мертвый придет и скажет. И ему не поверят.”'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313523
    m_Localized: 'Prorok: Что это значит?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313524
    m_Localized: 'Prorok: Мне нужно теперь подумать. Может, увидимся позже.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313525
    m_Localized: 'TV: На тропе стоит бледный, как сама смерть, человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313526
    m_Localized: 'TV: На его коже странные складки.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313527
    m_Localized: 'TV: Кажется, эта кожа ему не по размеру.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313528
    m_Localized: 'TV: Отсюда не видно его глаз, но чувствуется, как он сверлит вас своим взглядом.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313529
    m_Localized: 'TV: Вы ощущаете страх и молите бога, чтобы жуткий гость обошёл дом стороной.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313530
    m_Localized: 'TV: На земле лежат тела подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313531
    m_Localized: 'TV: Кто-то убил их.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313532
    m_Localized: 'TV: Кажется, совсем недавно, ведь кровь ещё не успела засохнуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313533
    m_Localized: 'TV: От увиденной картины у вас по коже бегут мурашки, и вы чувствуете небольшую тревогу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313534
    m_Localized: 'TV: За окном стоит сосед и его дочка.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313535
    m_Localized: 'TV: Они весело вместе играют, забывая о происходящем ужасе.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313536
    m_Localized: 'TV: Хотя бы на миг.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313537
    m_Localized: 'TV: Смотря на это, вы вспоминаете своё детство, и вас охватывает тёплое чувство ностальгии.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313538
    m_Localized: 'Esenin: Это что-то, с чем человечество никогда не сталкивалось.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313539
    m_Localized: 'Esenin: Пришлёпнули ярлык на непонятное и ненавидят.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313540
    m_Localized: 'Esenin: Как будто такого не было никогда.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313541
    m_Localized: 'Esenin: Человек в сущности своей узколобое сущетсво, что тут поделать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313542
    m_Localized: 'Esenin: Тысячи? Сотни тысяч? Миллионы?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313543
    m_Localized: 'Esenin: Честно, я вообще без понятия.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313544
    m_Localized: 'Esenin: И никто тебе не скажет, чтобы лишний раз не пёрнул от страха.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313545
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313546
    m_Localized: 'Esenin: Сколько бы ты ни думал, умножай это число на три.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313547
    m_Localized: 'Esenin: Наверно, столько этих жертв и будет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313548
    m_Localized: 'Esenin: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313549
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49639313550
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49639313551
    m_Localized: 'Esenin: Да? Ты что-то хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313552
    m_Localized: Кто такие гости?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313553
    m_Localized: Как много жертв?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313554
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313555
    m_Localized: 'Fan: Я не думаю, Я ЗНАЮ САМУ ПРАВДУ-МАТКУ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313556
    m_Localized: 'Fan: Ты спрашиваешь меня, кто такие ГОСТИ?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313557
    m_Localized: 'Fan: Так вот, я тебе отвечу...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313558
    m_Localized: 'Fan: Это, друг мой сердешный, ГОСТИ С ДРУГИХ ПЛАНЕТ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313559
    m_Localized: 'Fan: ОНИ НАСЛЕДНИКИ ИНОПЛАНЕТЯН, прилетавших на землю когда солнце было моложе, а трава зеленее!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313560
    m_Localized: 'Fan: Они поселили их в землю, словно ростки зла, и те взращивались ВЕКАМИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313561
    m_Localized: 'Fan: А теперь они вылезли и хотят отнять НАШУ ЗЕМЛЮ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313562
    m_Localized: 'Fan: Но СОЛНЦЕ решило защитить нас, ибо солнце гостям НЕМИЛОСТЛИВО!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313563
    m_Localized: 'Fan: Иначе чего они под землёй прятались всё это время?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313564
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313565
    m_Localized: 'Fan: Бля, вот бы пивка холодненького бахнуть...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313566
    m_Localized: 'Fan: МНОГО!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313567
    m_Localized: 'Fan: И поверь, друг мой, это ДАЛЕКО НЕ ВСЁ.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313568
    m_Localized: 'Fan: ЭТО ТОЛЬКО НАЧАЛО!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313569
    m_Localized: 'Fan: ЧАША ВЕСОВ ещё не наполнилась достаточно, чтобы уравновесить ВСЕЛЕНСКИЕ СИЛЫ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313570
    m_Localized: 'Fan: Нужно БОЛЬШЕ СОЖЖЁНЫХ в праведном пламени СОЛНЦА!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313571
    m_Localized: 'Fan: Но знай, друг мой, эти жертвы будут не напрасны!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313572
    m_Localized: 'Fan: Когда-нибудь, мы все поймём истинные замыслы солнцеликого...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313573
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313574
    m_Localized: 'Fan: Бля, иногда по ночам я очень грущу от того, что жёнушка меня бросила...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313575
    m_Localized: 'Fan: Святая женщина была...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313576
    m_Localized: 'Fan: Но сука та ещё.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313577
    m_Localized: 'Fan: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313578
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49639313579
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49639313580
    m_Localized: 'Fan: Внимаю словам твоим, человек! ГОВОРИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313581
    m_Localized: Кто такие гости?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313582
    m_Localized: Как много жертв?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313583
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313584
    m_Localized: 'Holod: Я немного стесняюсь...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313585
    m_Localized: 'Holod: Но если ты хочешь, чтоб я снял свою куртку...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313586
    m_Localized: 'Holod: Я это сделаю... Но ты будешь жалеть о последствиях'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313587
    m_Localized: 'Holod: Ну как? Доволен?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313588
    m_Localized: 'Holod: Ок.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313589
    m_Localized: 'Holod: Меня не радует эта мысль, но и не печалит.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313590
    m_Localized: 'Holod: Мне всё равно, что будет дальше.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313591
    m_Localized: 'Holod: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313592
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49639313593
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49639313594
    m_Localized: 'Holod: Вот бы немного тепла...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313595
    m_Localized: Раздевайся!
    m_Metadata:
      m_Items: []
  - m_Id: 49639313596
    m_Localized: Убейся, бля, теплохочун...
    m_Metadata:
      m_Items: []
  - m_Id: 49639313597
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313598
    m_Localized: 'TV: В трудную минуту...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313599
    m_Localized: 'TV: Когда час отчаяния уже близок...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313600
    m_Localized: 'TV: И никому доверять нельзя...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313601
    m_Localized: 'TV: Есть те, на кого можно положиться!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313602
    m_Localized: 'TV: Комитет по Чрезвычайным Ситуациям (КЧС).'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313603
    m_Localized: 'TV: Горячая линия 04-5-1. Нам можно верить!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313604
    m_Localized: 'TV: Доброе утро, зрители! В эфире утренняя сводка новостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313605
    m_Localized: 'TV: Аномальная солнечная активность продолжается.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313606
    m_Localized: 'TV: По прогнозам экспертов, она будет усиливаться и дальше.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313607
    m_Localized: 'TV: Нам продолжают поступать сообщения очевидцев о контактах с "гостями".'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313608
    m_Localized: 'TV: Вследствие чего власти в срочном порядке организовали КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313609
    m_Localized: 'TV: КЧС расшифровывается как Комитет по Чрезвычайной Ситуации.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313610
    m_Localized: 'TV: Сотрудники комитета одеты в жёлтые защитные костюмы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313611
    m_Localized: 'TV: Комитет начал функционировать недавно, однако они выявили новый признак "гостей".'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313612
    m_Localized: 'TV: Эксперты комитета полагают, что кроме зубов, "гостей" можно отличить по грязи под ногтями.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313613
    m_Localized: 'TV: Как сообщают источники, это выявили в следствие проверки одного из домов...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313614
    m_Localized: 'TV: Сотрудников встретила женщина, работавшая медсестрой.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313615
    m_Localized: 'TV: У неё по непонятной причине, под ногтями была грязь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313616
    m_Localized: 'TV: С учётом того, что "гости" вылезают из земли, женщину забрали на проверку, в ходе которой подтвердился её опасный статус.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313617
    m_Localized: 'TV: Если вы заметили кого-то, кто похож на "гостя", незамедлительно обращайтесь к членам КЧС или по горячей линии 04-5-1.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313618
    m_Localized: 'TV: Будьте бдительны, сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313619
    m_Localized: 'TV: Теперь к другим новостям.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313620
    m_Localized: 'anxiety: Гости?!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313621
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313622
    m_Localized: 'anxiety: Это страшные, ужасные монстры, имитирующие людей!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313623
    m_Localized: 'anxiety: А может и вовсе они сдирают с людей кожу, и носят её как костюм.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313624
    m_Localized: 'anxiety: И всё это только для того, чтобы казаться нам чем-то более знакомым...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313625
    m_Localized: 'anxiety: Господи, не хочу видеть как они на самом деле выглядят!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313626
    m_Localized: 'anxiety: Же-жертвы?!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313627
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313628
    m_Localized: 'anxiety: ОНИ ЖЕ СГОРЕЛИ! ВСЕ СГОРЕЛИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313629
    m_Localized: 'anxiety: СГОРЕЛИ ДО ТЛА, ВСЕ ОНИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313630
    m_Localized: 'anxiety: ПОТОМУ ЧТО ОСТАЛИСЬ ДНЁМ НА СОЛНЦЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313631
    m_Localized: 'anxiety: БОЖЕ, ЧТО НАМ ТЕПЕРЬ ДЕЛАТЬ?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313632
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313633
    m_Localized: 'anxiety: Мы все умрём...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313634
    m_Localized: 'anxiety: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313635
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49639313636
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49639313637
    m_Localized: 'anxiety: Э-э-эх. Надеюсь скоро всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313638
    m_Localized: Кто такие гости?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313639
    m_Localized: Как много жертв?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313640
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313641
    m_Localized: 'biglebowski: О, здарова.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313642
    m_Localized: 'biglebowski: Видал че происходит? Ваще ахуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313643
    m_Localized: 'biglebowski: Как там у тебя по делишкам?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313644
    m_Localized: Что тебе нужно?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313645
    m_Localized: И что же происходит?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313646
    m_Localized: 'biglebowski: Да так, просто интересуюсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313647
    m_Localized: 'biglebowski: А вообще у меня есть темка, можешь легко денег поднять.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313648
    m_Localized: 'biglebowski: В таком кайфе от солнца ваще не напрягаясь можно деньги делать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313649
    m_Localized: 'biglebowski: А всякие чмошники боятся чего-то, а надо просто шевелиться!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313650
    m_Localized: А ко мне зачем пришел?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313651
    m_Localized: Что ты предлагаешь?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313652
    m_Localized: 'biglebowski: Новые возможности, не видишь чтоль нихуя?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313653
    m_Localized: 'biglebowski: Че-то ноют все, бегают, суетятся, а можно просто делать от души дела, да и все.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313654
    m_Localized: 'biglebowski: Радоваться надо, короче.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313655
    m_Localized: А ко мне зачем пришел?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313656
    m_Localized: Что ты предлагаешь?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313657
    m_Localized: 'biglebowski: Да ты вот уже делом занялся!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313658
    m_Localized: 'biglebowski: Народ собираешь, че-то мутишь тут. Движуху наводишь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313659
    m_Localized: 'biglebowski: Мы тут с тобой праздник жизни устроим!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313660
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313661
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313662
    m_Localized: 'biglebowski: Выживать, что еще-то?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313663
    m_Localized: 'biglebowski: Надо мутить схемы, пока возможности есть, на солнце-то похуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313664
    m_Localized: 'biglebowski: Двигаться, двигаться, понимаешь? Ну че, погнали?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313665
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313666
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313667
    m_Localized: 'biglebowski: Дурачок ты, конечно. Но ладно, похер на тебя.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313668
    m_Localized: 'biglebowski: Вон, к твоим соседям пойду тогда.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313669
    m_Localized: 'biglebowski: Все, бывай.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313670
    m_Localized: 'biglebowski: О-о-о-о, вот это тема.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313671
    m_Localized: 'biglebowski: Ну все, наконец-то умный человек попался.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313672
    m_Localized: 'Doctor: Ой, я уже думал, дома никого нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313673
    m_Localized: 'Doctor: Так тихо у вас ночью.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313674
    m_Localized: 'Doctor: Привет! Я могу войти?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313675
    m_Localized: Ты следил за домом?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313676
    m_Localized: Ты что-то ищешь?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313677
    m_Localized: 'Doctor: Что? Ахахах, нет, конечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313678
    m_Localized: 'Doctor: Редко когда в наполненном доме нет никаких звуков ночью.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313679
    m_Localized: 'Doctor: Кто-то забывается в алкоголе и орет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313680
    m_Localized: 'Doctor: Кто-то орет от болей и ожогов.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313681
    m_Localized: 'Doctor: Кто-то просто орет от невыносимой тоски.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313682
    m_Localized: Кто ты?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313683
    m_Localized: Откуда ты пришёл?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313684
    m_Localized: 'Doctor: Почему тебе так показалось?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313685
    m_Localized: 'Doctor: Нет, на самом деле ищу, но то же, что и все.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313686
    m_Localized: 'Doctor: Безопасность и убийство скуки.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313687
    m_Localized: 'Doctor: А у вас ночью такая тишина, я даже не думал, что кто-то ночует тут, если честно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313688
    m_Localized: 'Doctor: Так, думаю, зайду, проверю, а тут закрыто. Решил постучать, прежде чем ломать дверь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313689
    m_Localized: Кто ты?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313690
    m_Localized: Откуда ты пришёл?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313691
    m_Localized: 'Doctor: Теперь я странствующий врач. В больницах настоящий ад, очень не советую теперь туда идти.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313692
    m_Localized: 'Doctor: Я оперировал людей. Хирург.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313693
    m_Localized: 'Doctor: В нашей больнице не хватает денег, потому я много чего делал еще, что не входит в мои обязанности.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507712
    m_Localized: 'Doctor: А сейчас я просто хожу и помогаю, кому могу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507713
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507714
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507715
    m_Localized: 'Doctor: В центре города была больница.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507716
    m_Localized: 'Doctor: Да, была, потому что наплыв больных был такой большой, что мы не справлялись.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507717
    m_Localized: 'Doctor: Страшнее всего, что в такой обстановке проникло много гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507718
    m_Localized: 'Doctor: Ситуация настолько вышла из-под контроля, что всю больницу распустили. Сейчас там настоящий ад.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507719
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507720
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507721
    m_Localized: 'Doctor: Понимаю, сейчас не самое лучшее время для доверия.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507722
    m_Localized: 'Doctor: Если повезет, я буду рядом, так что обращайтесь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507723
    m_Localized: 'Doctor: Надеюсь, я смогу помочь кому-то.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507724
    m_Localized: 'Super: Привет!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507725
    m_Localized: 'Super: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507726
    m_Localized: Ты кто?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507727
    m_Localized: Зачем пришел?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507728
    m_Localized: 'Super: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507729
    m_Localized: 'Super: Как тут у тебя дела?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507730
    m_Localized: 'Super: Все хорошо?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507731
    m_Localized: Почему ты меня игнорируешь?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507732
    m_Localized: Подожди, что тебе надо?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507733
    m_Localized: 'Super: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507734
    m_Localized: 'Super: Как тут у тебя дела?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507735
    m_Localized: 'Super: Все хорошо?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507736
    m_Localized: Почему ты меня игнорируешь?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507737
    m_Localized: Подожди, что тебе надо?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507738
    m_Localized: 'Super: Слуша-а-а-ай. А ты один в доме?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507739
    m_Localized: 'Super: Просто интересно. А то ты тут гадаешь кому-то.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507740
    m_Localized: 'Super: Кому-то обещаешь спасение, кого-то гонишь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507741
    m_Localized: Я не один.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507742
    m_Localized: Я один.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507743
    m_Localized: 'Super: Сегодня тебе повезло.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507744
    m_Localized: 'Super: Я слышу, как кто-то шепчется в твоих комнатах.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507745
    m_Localized: 'Super: Но кто знает, что случится завтра...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507746
    m_Localized: 'Super: Хахахахаха.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507747
    m_Localized: 'Super: Как так получилось?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507748
    m_Localized: 'Super: Одному же тяжко, ты чего?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507749
    m_Localized: 'Super: Пойдем-ка со мной, молодой человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507750
    m_Localized: 'TV: За окном стоит группа вооружённых солдат.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507751
    m_Localized: 'TV: Видимо, это небольшой отряд, высланный сюда из города, чтобы они обеспечивали безопасность КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507752
    m_Localized: 'TV: До вас долетают лишь обрывки фраз про бледного мужчину с голым торсом.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507753
    m_Localized: 'TV: Может быть, они хотят выследить того жуткого незнакомца?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507754
    m_Localized: 'TV: Вы чувствуете себя спокойнее, что появились люди, готовые разобраться с опасным гостем на улицах.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507755
    m_Localized: 'TV: На земле лежат сгоревшие дотла тела подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507756
    m_Localized: 'TV: Кажется, они пролежали здесь весь день.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507757
    m_Localized: 'TV: Двое сотрудников КЧС стоят рядом с телами и что-то записывают.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507758
    m_Localized: 'TV: Хорошо, что появились те, кто могут убирать тела.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507759
    m_Localized: 'TV: Страшно представить какая зараза может появиться, если гниющие тела не будут убирать с улиц.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507760
    m_Localized: 'TV: У соседского дома стоит небольшая группа сотрудников КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507761
    m_Localized: 'TV: Интересно, о чем они болтают?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507762
    m_Localized: 'TV: Может, они берут образцы почвы?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507763
    m_Localized: 'TV: Или ищут место для разворачивания базы?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507764
    m_Localized: 'TV: Вам становится капельку спокойнее от мысли, что кто-то пытается разобраться в этом кошмаре.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507765
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507766
    m_Localized: 'Widow: Я могу у тебя отдохнуть?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507767
    m_Localized: Откуда ты пришла?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507768
    m_Localized: А дальше куда пойдешь?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507769
    m_Localized: 'Widow: Я уже не помню. Все равно откуда.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507770
    m_Localized: 'Widow: Я очень устала. Если не отдохну – просто упаду под окнами.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507771
    m_Localized: Твоему напарнику плохо?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507772
    m_Localized: Твоему другу нужна помощь?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507773
    m_Localized: 'Widow: Я… я просто хочу упасть где-нибудь и больше не вставать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507774
    m_Localized: 'Widow: Все равно, где я окажусь уже.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507775
    m_Localized: Твоему напарнику плохо?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507776
    m_Localized: Твоему другу нужна помощь?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507777
    m_Localized: 'Widow: Это мой муж.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507778
    m_Localized: 'Widow: Он умер.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507779
    m_Localized: 'Widow: Я не могу его нормально похоронить теперь. Отпускать его теперь бессмысленно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507780
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507781
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507782
    m_Localized: 'Widow: Уже нет. Когда надо было – никто не помог.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507783
    m_Localized: 'Widow: Теперь он умер.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507784
    m_Localized: 'Widow: Он мог быть жив, если бы…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507785
    m_Localized: 'Widow: Всем было не насрать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507786
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507787
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507788
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507789
    m_Localized: 'Widow: Ты…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507790
    m_Localized: 'Widow: Не думаю, что останусь надолго.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507791
    m_Localized: 'Widow: Мне бы только передохнуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507792
    m_Localized: 'biglebowski: Да я в душе не ебу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507793
    m_Localized: 'biglebowski: Я думал ты знаешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507794
    m_Localized: 'biglebowski: Да, может, и хуй с ним?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507795
    m_Localized: 'biglebowski: Какая разница, если на этом можно бабки грести лопатой?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507796
    m_Localized: 'biglebowski: Бля, это охуенно, без базара.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507797
    m_Localized: 'biglebowski: Типо, я реально рад, что ты меня впустил, ты пиздатый.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507798
    m_Localized: 'biglebowski: Не то что все остальные уебаны в этом доме.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507799
    m_Localized: 'biglebowski: Надо было их сразу на пороге слать нахуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507800
    m_Localized: 'biglebowski: Я считаю лучше их КЧС-никам сдать и дело с концом.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507801
    m_Localized: 'biglebowski: А то так продуктов нихуя не напосёшься.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507802
    m_Localized: 'biglebowski: Но, в любом случае, ты тут хозяин.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507803
    m_Localized: 'biglebowski: А, как говорится, хозяин – барин.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507804
    m_Localized: 'biglebowski: Хе-хе-хе.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507805
    m_Localized: 'biglebowski: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507806
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643507807
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643507808
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643507809
    m_Localized: 'biglebowski: Хе-хе. Ну чё, ёпта?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507810
    m_Localized: Из-за чего происходит катаклизм?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507811
    m_Localized: Нам нужно держаться вместе?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507812
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507813
    m_Localized: 'Doctor: Поистине хороший вопрос.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507814
    m_Localized: 'Doctor: Я смотрю на всё с научной точки зрения.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507815
    m_Localized: 'Doctor: Но, к несчастью, пока у нас нет никакой возможности узнать, что происходит на самом деле.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507816
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507817
    m_Localized: 'Doctor: Интересно было бы узнать кто же такие гости на самом деле.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507818
    m_Localized: 'Doctor: Если мы, конечно, доживём до этого момента.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507819
    m_Localized: 'Doctor: Думаю да, но осторожность не помешает.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507820
    m_Localized: 'Doctor: Вспоминая, что произошло в больнице, не хотелось бы, чтобы это повторилось.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507821
    m_Localized: 'Doctor: Человек – существо разумное, но толпа...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507822
    m_Localized: 'Doctor: Толпа – тупой зверь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507823
    m_Localized: 'Doctor: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507824
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643507825
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643507826
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643507827
    m_Localized: 'Doctor: Да-да?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507828
    m_Localized: Из-за чего происходит катаклизм?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507829
    m_Localized: Нам нужно держаться вместе?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507830
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507831
    m_Localized: 'Esenin: У меня даже идей нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507832
    m_Localized: 'Esenin: Хотя...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507833
    m_Localized: 'Esenin: Я думаю, разгорание солнца как-то связано с гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507834
    m_Localized: 'Esenin: Не случайно же они вылезли из земли сразу, как начался катаклизм.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507835
    m_Localized: 'Esenin: Что если гости хотят занять наше место, заменить нас?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507836
    m_Localized: 'Esenin: А полыхающее солнце - способ избавиться от нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507837
    m_Localized: 'Esenin: Но в целом уже всё равно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507838
    m_Localized: 'Esenin: Смотря с какой стороны на это посмотреть.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507839
    m_Localized: 'Esenin: Одному тяжело. Без группы сейчас не выжить.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507840
    m_Localized: 'Esenin: Но с другой стороны, ты же сам понимаешь что из-за гостей людям тяжело доверять.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507841
    m_Localized: 'Esenin: Как можно построить группу, если кто угодно может оказаться ублюдком?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507842
    m_Localized: 'Esenin: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507843
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643507844
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643507845
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643507846
    m_Localized: 'Esenin: Да? Ты что-то хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507847
    m_Localized: Из-за чего происходит катаклизм?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507848
    m_Localized: Нам нужно держаться вместе?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507849
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507850
    m_Localized: 'Fan: СОЛНЦЕ решило наказать нас ВСЕХ за грехи, что люди вершили на протяжении ТЫСЯЧАЛЕТИЙ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507851
    m_Localized: 'Fan: А ГОСТИ, ЭТИ ХУЙЛА ЕБУЧИЕ, начали тянуться к СОЛНЦУ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507852
    m_Localized: 'Fan: Но СОЛНЦЕ не для них, мигрантов подземных, а для НАС, ЛЮДЕЙ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507853
    m_Localized: 'Fan: ОНО НАШЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507854
    m_Localized: 'Fan: ЛЮДСКОЕ БЛАГО НАХУЙ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507855
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507856
    m_Localized: 'Fan: Бля, мой друган Лёха сгорел до тла на улице, потому что по пьяни пролежал всю ночь...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507857
    m_Localized: 'Fan: Упокой его душу, СОЛНЦЕЛИКИЙ, и прими его с распростёртыми объятьями.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507858
    m_Localized: 'Fan: И, пожалуй, душу его фикуса, который он уже не сможет полить...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507859
    m_Localized: 'Fan: Аминь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507860
    m_Localized: 'Fan: Паства должна быть вместе.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507861
    m_Localized: 'Fan: Иначе как ПРАВЕДНИК будет наставлять всех на ПРАВИЛЬНЫЙ ПУТЬ?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507862
    m_Localized: 'Fan: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507863
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643507864
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643507865
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643507866
    m_Localized: 'Fan: Внимаю словам твоим, человек! ГОВОРИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507867
    m_Localized: Из-за чего происходит катаклизм?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507868
    m_Localized: Нам нужно держаться вместе?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507869
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507870
    m_Localized: 'Holod: Из-за людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507871
    m_Localized: 'Holod: Мы сами виноваты во всём происходящем.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507872
    m_Localized: 'Holod: Больше, увы, мне нечего добавить.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507873
    m_Localized: 'Holod: Думаю, нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507874
    m_Localized: 'Holod: Мне причинили столько боли люди, которые следовали за стадом...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507875
    m_Localized: 'Holod: Которые слепо видят не похожих на себя и тут же наотрез отвергают их, подвергая гонениям и унижению.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507876
    m_Localized: 'Holod: Хорошо ли что я попал в это убежище?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507877
    m_Localized: 'Holod: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507878
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643507879
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643507880
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643507881
    m_Localized: 'Holod: Вот бы немного тепла...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507882
    m_Localized: Из-за чего происходит катаклизм?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507883
    m_Localized: Нам нужно держаться вместе?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507884
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507885
    m_Localized: 'TV: Внимание! Экстренное включение!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507886
    m_Localized: 'TV: Из-за повышающейся жары от солнца, загорелись леса и поля.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507887
    m_Localized: 'TV: Пока сложно оценить масштаб пожаров.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507888
    m_Localized: 'TV: Однако уже сейчас ясно, что это самые массовые пожары, которые человечество когда-либо видело.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507889
    m_Localized: 'TV: В зоны бедствий направлены все доступные пожарные бригады, однако из-за инцидентов с "гостями", большая часть пожарных отстранена от службы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507890
    m_Localized: 'TV: Теперь к другим новостям.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507891
    m_Localized: 'TV: Доброе утро, зрители! В эфире утренняя сводка новостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507892
    m_Localized: 'TV: Доблестные сотрудники КЧС организовали карантинные зоны.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507893
    m_Localized: 'TV: В них направляют всех, у кого обнаруживаются признаки "гостя".'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507894
    m_Localized: 'TV: Ряд людей высказывают своё беспокойство, что до сих пор не известно кто такие "гости"...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507895
    m_Localized: 'TV: Однако КЧС уверяет, что это всего-лишь больные люди, которым нужна помощь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507896
    m_Localized: 'TV: Кроме того, КЧС объявил новый признак "гостей" – сильно раздраженные кроваво-красные глаза.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507897
    m_Localized: 'TV: Эти сведения удалось выявить в результате экспериментов с задержанными "гостями".'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507898
    m_Localized: 'TV: Как полагают эксперты КЧС, раздражение вызвано воздействием яркого света солнца.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507899
    m_Localized: 'TV: Будьте бдительны, сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507900
    m_Localized: 'TV: Теперь к другим новостям.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507901
    m_Localized: 'anxiety: Из-за чего?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507902
    m_Localized: 'anxiety: Я... Я не знаю...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507903
    m_Localized: 'anxiety: Я правда не знаю!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507904
    m_Localized: 'anxiety: Я НЕ ЗНАЮ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507905
    m_Localized: 'anxiety: БОЖЕ, ПОЧЕМУ ТЫ ТАК ПОСТУПАЕШЬ С НАМИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507906
    m_Localized: 'anxiety: ЗА ЧТО НАМ ВСЕ ЭТИ МУЧЕНИЯ?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507907
    m_Localized: 'anxiety: СМИЛУЙСЯ НАД НАМИ, ПОГАСИ СОЛНЦЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507908
    m_Localized: 'anxiety: ОСТАВЬ ТЬМУ И ХОЛОД, ПОЖАЛУЙСТА!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507909
    m_Localized: 'anxiety: Я ТАК БОЛЬШЕ НЕ МОГУ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507910
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507911
    m_Localized: 'anxiety: Вме-вместе?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507912
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507913
    m_Localized: 'anxiety: Да.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507914
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507915
    m_Localized: 'anxiety: ДА!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507916
    m_Localized: 'anxiety: НАМ ВСЕМ ВМЕСТЕ НАДО ПОМОЛИТЬСЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507917
    m_Localized: 'anxiety: ЭТО ПОМОЖЕТ, ОН ДОЛЖЕН НАС УСЛЫШАТЬ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507918
    m_Localized: 'anxiety: ЧЕМ БОЛЬШЕ РТОВ – ТЕМ ГРОМЧЕ БУДЕТ МОЛЬБА.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507919
    m_Localized: 'anxiety: ГОСПОДИ, УСЛЫШЬ НАС, МЫ ВСЕ ВМЕСТЕ ПОМОЛИМСЯ ТЕБЕ.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507920
    m_Localized: 'anxiety: ТОЛЬКО ПРЕКРАТИ ПЫТКУ СОЛНЦЕМ.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507921
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507922
    m_Localized: 'anxiety: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507923
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643507924
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643507925
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643507926
    m_Localized: 'anxiety: Э-э-эх. Надеюсь скоро всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507927
    m_Localized: Из-за чего происходит катаклизм?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507928
    m_Localized: Нам нужно держаться вместе?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507929
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507930
    m_Localized: 'Widow: Мне без разницы, почему и из-за чего происходит катаклизм.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507931
    m_Localized: 'Widow: Я так устала от всего этого...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507932
    m_Localized: 'Widow: От этого проклятого солнца.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507933
    m_Localized: 'Widow: От этих ебучих гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507934
    m_Localized: 'Widow: Когда уже наконец закончится этот нескончаемый ад?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507935
    m_Localized: 'Widow: Пусть нас уже всех сожжёт до тла!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507936
    m_Localized: 'Widow: Только бы уже всё это закончилось... Плевать чем, но закончилось.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507937
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507938
    m_Localized: 'Widow: Я не знаю, прости.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507939
    m_Localized: 'Widow: Мне сейчас тяжело думать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507940
    m_Localized: 'Widow: Я просто хочу немного передохнуть, и всё...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507941
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507942
    m_Localized: 'Widow: Дай мне передохнуть, пожалуйста, я очень устала.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507943
    m_Localized: 'Widow: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507944
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643507945
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643507946
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643507947
    m_Localized: 'Widow: Отдохнуть бы немного...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507948
    m_Localized: Из-за чего происходит катаклизм?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507949
    m_Localized: Нам нужно держаться вместе?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507950
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507951
    m_Localized: 'daughter: З-зд-здрасте.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507952
    m_Localized: 'daughter: Пустите м-меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507953
    m_Localized: У тебя истерика?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507954
    m_Localized: Что-то случилось?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507955
    m_Localized: 'daughter: Я не-не знаю-ю-ю что мне де-делать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507956
    m_Localized: 'daughter: Люди-и-и-и.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507957
    m_Localized: 'daughter: А-а-а-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507958
    m_Localized: 'daughter: Убили-ли-ли па…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507959
    m_Localized: 'daughter: А-а-а-аха-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507960
    m_Localized: 'daughter: Па-пу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507961
    m_Localized: Кто это сделал? Попей воды.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507962
    m_Localized: Почему они это сделали? Попей воды.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507963
    m_Localized: 'daughter: А-а-а-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507964
    m_Localized: 'daughter: Мо-мо-моего па-па…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507965
    m_Localized: 'daughter: А-а-а-а-ха-а-а-а-ах.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507966
    m_Localized: 'daughter: Убили па-па-пу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507967
    m_Localized: Кто это сделал? Попей воды.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507968
    m_Localized: Почему они это сделали? Попей воды.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507969
    m_Localized: 'daughter: К нам пришли го-о-ости. Они си-сидели у нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507970
    m_Localized: 'daughter: Папа о чем-то го-го-говорил с ними. А потом они его убили.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507971
    m_Localized: 'daughter: Аааааааааа-хааааааа.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507972
    m_Localized: 'daughter: Наш дом те-теперь го-горииииит.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507973
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507974
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507975
    m_Localized: 'daughter: Я не-не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507976
    m_Localized: 'daughter: Они спокойно си-си-сидели с папой на кухне.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507977
    m_Localized: 'daughter: А потом они что-то сде-ла-ла-ли, а потом по-подожгли дом.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507978
    m_Localized: 'daughter: Пока я бе-бежала, они смеялись просто.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507979
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507980
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507981
    m_Localized: 'daughter: Куда я пойду-у-у-ууууу?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507982
    m_Localized: 'daughter: Ааааааааааа.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507983
    m_Localized: 'daughter: АААААААААААА.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507984
    m_Localized: 'daughter: МНЕ ОЧЕНЬ СТРА-А-АААШНООООО.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507985
    m_Localized: 'daughter: Вы по-поможе-жете мне?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507986
    m_Localized: 'daughter: Мне стра-а-а-шно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507987
    m_Localized: 'Himoza: Доброй ночи.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507988
    m_Localized: 'Himoza: Я из бригады КЧС, мы пришли вам помочь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507989
    m_Localized: Ты пришел один?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507990
    m_Localized: Как я могу тебе доверять?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507991
    m_Localized: 'Himoza: Нет, конечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507992
    m_Localized: 'Himoza: Наша бригада обходит дома в округе. Чтобы быстрее справиться с задачей, мы разделились.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507993
    m_Localized: 'Himoza: Я не задержусь у вас надолго.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507994
    m_Localized: Почему ты в защитном костюме? Нам такой выдадут?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507995
    m_Localized: Как ты будешь помогать нам?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507996
    m_Localized: 'Himoza: Вы наверняка смотрели выпуск новостей. Там говорилось про нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507997
    m_Localized: 'Himoza: Плюс, я могу показать удостоверение.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507998
    m_Localized: Почему ты в защитном костюме? Нам такой выдадут?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507999
    m_Localized: Как ты будешь помогать нам?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508000
    m_Localized: 'Himoza: Нет причин бояться. Костюм на случай, если мы застанем восход солнца.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508001
    m_Localized: 'Himoza: Гражданским он ни к чему сейчас, просто сидите дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508002
    m_Localized: 'Himoza: Мы о вас позаботимся.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508003
    m_Localized: И что дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508004
    m_Localized: У вас есть план действий?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508005
    m_Localized: 'Himoza: Сначала мы должны провести исследование.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508006
    m_Localized: 'Himoza: По его результатам я смогу провести дальнейшие действия, уведомив руководство.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508007
    m_Localized: 'Himoza: Вам нужно только немного подождать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508008
    m_Localized: И что дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508009
    m_Localized: У вас есть план действий?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508010
    m_Localized: 'Himoza: Я возьму у вас одного человека. В скором времени я верну его, это нужно для исследований.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508011
    m_Localized: 'Himoza: Вы могли облучиться солнечной радиацией, мы все замерим на примере одного человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508012
    m_Localized: 'Himoza: Подойдет любой.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508013
    m_Localized: И что дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508014
    m_Localized: Мне тоже нужно собираться?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508015
    m_Localized: 'Himoza: Конечно. Мы же не можем действовать спонтанно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508016
    m_Localized: 'Himoza: Мы заберем с собой на обследования одного любого человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508017
    m_Localized: 'Himoza: Так как вы могли облучиться солнечной радиацией, мы проверим здоровье одного.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508018
    m_Localized: 'Himoza: На основе этого решим, нужна ли вам всем помощь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508019
    m_Localized: 'Himoza: Для этого подойдет любой.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508020
    m_Localized: И что дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508021
    m_Localized: Мне тоже нужно собираться?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508022
    m_Localized: 'Himoza: Ждать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508023
    m_Localized: 'Himoza: Либо мы вас эвакуируем с опасной территории, либо привезем вам человека обратно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508024
    m_Localized: 'Himoza: После мы в любом случае выдадим инструкции.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508025
    m_Localized: 'Himoza: Теперь я забираю у вас человека, мы пойдем.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508026
    m_Localized: 'Himoza: До свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508027
    m_Localized: 'Himoza: Нет, вы, как я понял, владелец дома. Вы оставайтесь пока.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508028
    m_Localized: 'Himoza: Мы увезем человека ненадолго, потом решим, как лучше сделать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508029
    m_Localized: 'Himoza: После мы в любом случае выдадим инструкции.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508030
    m_Localized: 'Himoza: Теперь я забираю у вас человека, мы пойдем.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508031
    m_Localized: 'Himoza: До свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508032
    m_Localized: 'Mama: Хееей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508033
    m_Localized: 'Mama: Дома есть кто что ль?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508034
    m_Localized: А ты кто?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508035
    m_Localized: Кого-то ищешь?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508036
    m_Localized: 'Mama: Я жила в паре кварталов отсюда.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508037
    m_Localized: 'Mama: Нас желтые комбезы эвакуировали из дома, но никуда не повезли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508038
    m_Localized: 'Mama: Жилья не дали. Куда идти? Че делать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508039
    m_Localized: 'Mama: Вот кто куда, я здесь пытаюсь спастись.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508040
    m_Localized: Почему вас выгнали?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508041
    m_Localized: Много вас ушло?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508042
    m_Localized: 'Mama: Да никого не ищу. Мне нужно просто где-то спастись.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508043
    m_Localized: 'Mama: Повыгоняли целый район, а куда, никто не знает.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508044
    m_Localized: 'Mama: Бегаю теперь в шоке, ищу, где теперь жить.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508045
    m_Localized: Почему вас выгнали?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508046
    m_Localized: Много вас ушло?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508047
    m_Localized: 'Mama: Сказали, что на наш дом большой солнечный удар или как-то так пришелся.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508048
    m_Localized: 'Mama: Желтые комбезы нас повыгоняли. Кого-то схватили, повезли на исследования.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508049
    m_Localized: 'Mama: Кого-то отпустили.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508050
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508051
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508052
    m_Localized: 'Mama: Да говорю же, что весь дом!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508053
    m_Localized: 'Mama: Кто-то не сам уехал: желтые схватили как будто невпопад и увезли на исследования.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508054
    m_Localized: 'Mama: По ощущениям, половину похватали. За остальными не сильно гнались.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508055
    m_Localized: 'Mama: Ну теперь вот как-то надо выживать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508056
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508057
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508058
    m_Localized: 'Mama: Ну ты все равно желтым не открывай.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508059
    m_Localized: 'Mama: Ты в целом дверь больше не открывай.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508060
    m_Localized: 'Mama: ХАХАХАХАХАХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508061
    m_Localized: 'Mama: Я сюда приведу своих, поможем тебе спастись, ахахахах.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508062
    m_Localized: 'Mama: Ага, спасибо. Ты этим желтым не открывай, ладно?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508063
    m_Localized: 'Mama: Они еще нас с тобой заберут куда-то.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508064
    m_Localized: 'Ohota: Хей, как тут обстановка?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508065
    m_Localized: 'Ohota: Я не здешний, не сильно люблю стоять на одном месте.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508066
    m_Localized: 'Ohota: Теперь долго не походишь – года не те.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508067
    m_Localized: Почему ты путешествуешь?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508068
    m_Localized: Что ты ищешь здесь?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508069
    m_Localized: 'Ohota: Да эти самые, ты видел, что гости вытворяют?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508070
    m_Localized: 'Ohota: Что ни дом, то кто-то убит, кого-то растерзали.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508071
    m_Localized: 'Ohota: Выдают себя за своих, потом, блин, начинается ад на земле.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508072
    m_Localized: 'Ohota: Надо их истреблять, гостей этих.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508073
    m_Localized: Ты хочешь убивать гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508074
    m_Localized: Где твое оружие против гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508075
    m_Localized: 'Ohota: Где, в городе? Да просто отдохнуть хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508076
    m_Localized: 'Ohota: После этого солнца проклятого гости стали активнее вылезать, куда-то залезать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508077
    m_Localized: 'Ohota: Вот что скажу: их надо гасить. Они чего-то пытаются с нами сделать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508078
    m_Localized: Ты хочешь убивать гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508079
    m_Localized: Где твое оружие против гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508080
    m_Localized: 'Ohota: А ты не тем же самым занимаешься?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508081
    m_Localized: 'Ohota: Или ты просто говоришь им “кыш”? Ты ж не дурак, правильно?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508082
    m_Localized: 'Ohota: Ты их выгонишь, а они завтра тебя растерзают и не вспомнят как звали, понимаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508083
    m_Localized: 'Ohota: С ними осторожнее надо, вот что.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508084
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508085
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508086
    m_Localized: 'Ohota: Да было у меня ружье. Меня чуть самого не убили.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508087
    m_Localized: 'Ohota: Они подкараулили, пока я усну в палатке и просто украли мое ружье!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508088
    m_Localized: 'Ohota: Я бежал, они стреляли. Вот такое развлечение у них.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508089
    m_Localized: 'Ohota: Ничего человеческого кроме оболочки-то и нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508090
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508091
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508092
    m_Localized: 'Ohota: И хорошо. Может, ты вообще сам гость.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508093
    m_Localized: 'Ohota: Еще ночью бы меня прирезал.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508094
    m_Localized: 'Ohota: Знаешь, а я сам этим гостям устрою шороху. Сам офигеешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508095
    m_Localized: 'Ohota: Я знал, что ты не тюфяк. Нормальный мужик.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508096
    m_Localized: 'Ohota: Замесим этих гостей, они к нам на милю не подойдут.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508097
    m_Localized: 'Volk: Здарова.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508098
    m_Localized: 'Volk: Жесть что творится. Видал?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508099
    m_Localized: 'Volk: Какое же это общество? Вскрылось зверье вокруг.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508100
    m_Localized: 'Volk: Наконец, никто не притворяется.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508101
    m_Localized: Ты про что?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508102
    m_Localized: А ты из этого зверья?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508103
    m_Localized: 'Volk: Ты не был у других дома? На улице?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508104
    m_Localized: 'Volk: Эти ваши социальные нормы и прочая херня больше не работают.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508105
    m_Localized: 'Volk: Кто сильнее, тот и прав. Если можешь перегрызть других – считай, победил и установил порядок.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508106
    m_Localized: Сколько домов ты сменил?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508107
    m_Localized: Как ты сам выживал все это время?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508108
    m_Localized: 'Volk: Да мы все это самое зверье.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508109
    m_Localized: 'Volk: Будешь долго отрицать – тебя живьем сожрут. Костей не оставят.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508110
    m_Localized: 'Volk: Теперь новый порядок – кто сильнее, тот и прав.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508111
    m_Localized: 'Volk: Кто говорит, что он не из таких людей, завтра уже будет мертв.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508112
    m_Localized: Сколько домов ты сменил?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508113
    m_Localized: Как ты сам выживал все это время?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508114
    m_Localized: 'Volk: Я нигде не был долго.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508115
    m_Localized: 'Volk: Но повсюду я вижу хаос. Страх закрывает глаза людям на очень многие вещи.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508116
    m_Localized: 'Volk: У тебя еще порядок. Это интересно, я бы посмотрел, как ты его держишь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508117
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508118
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508119
    m_Localized: 'Volk: Много знать будешь, скоро состаришься.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508120
    m_Localized: 'Volk: Я не спрашиваю, как ты живешь, ты не спрашивай, как живу я.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508121
    m_Localized: 'Volk: Главное: я не буду для тебя проблемой.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508122
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508123
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508124
    m_Localized: 'Volk: А-а-а-а. Вот оно как.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508125
    m_Localized: 'Volk: Жди новостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508126
    m_Localized: 'Volk: Разумное решение.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508127
    m_Localized: 'Volk: Сила теперь управляет жизнью, и ты либо принимаешь это, либо получаешь проблемы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508128
    m_Localized: 'TV: Весь отряд солдат, который был здесь вчера, мёртв.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508129
    m_Localized: 'TV: Тела разбросаны по всей улице, и у одного из тел отсутствует голова.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508130
    m_Localized: 'TV: Неужели их всех убил тот бледный жуткий незнакомец?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508131
    m_Localized: 'TV: Вас охватывает ужас от этой картины бойни, и вы чувствуете себя в опасности.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508132
    m_Localized: 'TV: Бледный жуткий мужчина стоит на дороге и улыбается.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508133
    m_Localized: 'TV: У него в руке чья-то оторванная голова в каске.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508134
    m_Localized: 'TV: Это голова солдата с застывшей на лице гримасой ужаса.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508135
    m_Localized: 'TV: Вам очень не по себе от увиденного.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508136
    m_Localized: 'TV: Соседский дом, что недавно покрасили в белое, сгорел дотла и теперь абсолютно чёрный.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508137
    m_Localized: 'TV: Похоже, пожар утих совсем недавно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508138
    m_Localized: 'TV: Неужели кто-то поджёг его намеренно?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508139
    m_Localized: 'TV: Что произошло с соседской семьёй?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508140
    m_Localized: 'TV: Выжил ли кто-нибудь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508141
    m_Localized: 'TV: Зачем сожгли дом?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508142
    m_Localized: 'TV: Вашу голову переполнили тревожные мысли и вас охватило чувство непонимания и беспомощности.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508143
    m_Localized: 'biglebowski: Да они клёвые челики, в чём вопрос?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508144
    m_Localized: 'biglebowski: Я считаю правильное дело пацаны из КЧС делают.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508145
    m_Localized: 'biglebowski: Забирают всяких уебанов, которые заслуживают смерти.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508146
    m_Localized: 'biglebowski: Недавно я в окне видел, как они моего соседа заграбастали.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508147
    m_Localized: 'biglebowski: И правильно сделали, я считаю, этот уёбок занял у меня кучу денег, но так и не вернул их.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508148
    m_Localized: 'biglebowski: Бля, вот бы вступить в КЧС...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508149
    m_Localized: 'biglebowski: Пф-ф-ф-ха-ха-ха.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508150
    m_Localized: 'biglebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508151
    m_Localized: 'biglebowski: Погоди, ты не про член?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508152
    m_Localized: 'biglebowski: А, ты про происходящий пиздец.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508153
    m_Localized: 'biglebowski: Ну...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508154
    m_Localized: 'biglebowski: Хуй его знает, с чего бы?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508155
    m_Localized: 'biglebowski: Ну да, солнце жарит, шпарит, но всё плохое же рано или поздно заканчивается.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508156
    m_Localized: 'biglebowski: Вот и солнце я думаю скоро выдохнется.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508157
    m_Localized: 'biglebowski: А без него на улице уже не будет жарко, и можно будет спокойно жить как раньше.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508158
    m_Localized: 'biglebowski: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508159
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508160
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508161
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508162
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508163
    m_Localized: 'biglebowski: Хе-хе. Ну чё, ёпта?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508164
    m_Localized: Как ты относишься к КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508165
    m_Localized: Конец близок?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508166
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508167
    m_Localized: 'daughter: Я не-не знаю-ю-ю кт-кто это.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508168
    m_Localized: 'daughter: Ма-мочка...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508169
    m_Localized: 'daughter: Эт-того бы не случилось, ес-сли бы не те зл-злые люди.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508170
    m_Localized: 'daughter: А-а-а-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508171
    m_Localized: 'daughter: Ко-конец?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508172
    m_Localized: 'daughter: Я... Я не хо-хочу уми-рать!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508173
    m_Localized: 'daughter: А-а-а-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508174
    m_Localized: 'daughter: Ма-мочка-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508175
    m_Localized: 'daughter: А-а-а-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508176
    m_Localized: 'daughter: Я хочу к тебе, мама-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508177
    m_Localized: 'daughter: А-а-а-аха-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508178
    m_Localized: 'daughter: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508179
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508180
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508181
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508182
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508183
    m_Localized: 'daughter: Я... Я хо-чу к ма-ме.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508184
    m_Localized: Как ты относишься к КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508185
    m_Localized: Конец близок?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508186
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508187
    m_Localized: 'Doctor: Я к ним отношусь скорее положительно, нежели негативно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508188
    m_Localized: 'Doctor: Думаю хорошо, что есть организация, которая пытается разрешить ситуацию.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508189
    m_Localized: 'Doctor: Пускай не всем нравится, что делает КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508190
    m_Localized: 'Doctor: Мне хочется верить, что нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508191
    m_Localized: 'Doctor: Человечество много раз ходило по лезвию бритвы, сталкиваясь с различными стихийными бедсвтиями.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508192
    m_Localized: 'Doctor: И каждый раз, люди находили в себе силы и продолжали бороться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508193
    m_Localized: 'Doctor: Даже когда надежды уже не оставалось, и казалось, что конец уже близок.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508194
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508195
    m_Localized: 'Doctor: Хотелось бы верить, что и в этот раз человечество справиться с бедой, что на нас обрушилась.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508196
    m_Localized: 'Doctor: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508197
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508198
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508199
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508200
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508201
    m_Localized: 'Doctor: Да-да?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508202
    m_Localized: Как ты относишься к КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508203
    m_Localized: Конец близок?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508204
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508205
    m_Localized: 'Esenin: Ты про уёбков в жёлтом?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508206
    m_Localized: 'Esenin: Это бесчеловечные твари без свои собственной воли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508207
    m_Localized: 'Esenin: Спрятались в жёлтые коконы с масками и возомнили себя тут главными.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508208
    m_Localized: 'Esenin: Забирают всех подряд, кто хоть немного попадает под признаки гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508209
    m_Localized: 'Esenin: Короче, я бы с ними из одной кружки не пил бы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508210
    m_Localized: 'Esenin: А какой смысл в этом вопросе?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508211
    m_Localized: 'Esenin: Ты хочешь, чтобы я тебя успокоил?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508212
    m_Localized: 'Esenin: Не, трезво смотри на ситуацию.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508213
    m_Localized: 'Esenin: Если не конец, то пиздец точно уже очень близок.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508214
    m_Localized: 'Esenin: Можем ли мы что-то сделать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508215
    m_Localized: 'Esenin: Я думаю, что надо было что-то делать раньше, сейчас уже всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508216
    m_Localized: 'Esenin: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508217
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508218
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508219
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508220
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508221
    m_Localized: 'Esenin: Да? Ты что-то хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508222
    m_Localized: Как ты относишься к КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508223
    m_Localized: Конец близок?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508224
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508225
    m_Localized: 'Fan: КЧС – проклятые ЕРЕТЕКИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508226
    m_Localized: 'Fan: Они вмешиваются в процессы, которые НАМ, ПРОСТЫМ ЛЮДЯМ, не подвластны!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508227
    m_Localized: 'Fan: Они суют свой нос куда не следует.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508228
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508229
    m_Localized: 'Fan: Бля, будь прокляты те уебаны, что пизданули мою мать в лужу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508230
    m_Localized: 'Fan: Конец для кого?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508231
    m_Localized: 'Fan: Для нас?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508232
    m_Localized: 'Fan: Ха-ха-ха!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508233
    m_Localized: 'Fan: Не смеши меня, СОЛНЦЕ НА НАШЕЙ СТОРОНЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508234
    m_Localized: 'Fan: Оно нам помогает, неужели ты не видишь этого?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508235
    m_Localized: 'Fan: Оно выкуривает гостей, которые пытаются вылезти на землю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508236
    m_Localized: 'Fan: Мы должны благодарить его, а не начинать трубить о конце света'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508237
    m_Localized: 'Fan: ЭТО КОНЕЦ ДЛЯ НИХ, ГОСТЕЙ ЕБУЧИХ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508238
    m_Localized: 'Fan: СМЕРТЬ ИММИГРАНТАМ ПОДЗЕМНЫМ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508239
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508240
    m_Localized: 'Fan: Бля, как же я давно картошечки жареной не ел...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508241
    m_Localized: 'Fan: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508242
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508243
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508244
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508245
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508246
    m_Localized: 'Fan: Внимаю словам твоим, человек! ГОВОРИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508247
    m_Localized: Как ты относишься к КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508248
    m_Localized: Конец близок?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508249
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508250
    m_Localized: 'Holod: Я им не доверяю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508251
    m_Localized: 'Holod: У них столько власти над людскими жизнями.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508252
    m_Localized: 'Holod: Они могут забрать кого угодно, кто им покажется гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508253
    m_Localized: 'Holod: И меня заберут, рано или поздно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508254
    m_Localized: 'Holod: Всему своё время.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508255
    m_Localized: 'Holod: Ближе некуда.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508256
    m_Localized: 'Holod: Последняя страница в нашей истории почти перелестнулась.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508257
    m_Localized: 'Holod: Наверное, мне должно быть страшно от того, что конец близок...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508258
    m_Localized: 'Holod: Но мне всё это чуждо, и смерти я не боюсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508259
    m_Localized: 'Holod: Но если она и правда решила заняться жатвой, пусть хотя бы не тянет с этим.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508260
    m_Localized: 'Holod: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508261
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508262
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508263
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508264
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508265
    m_Localized: 'Holod: Вот бы немного тепла...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508266
    m_Localized: Как ты относишься к КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508267
    m_Localized: Конец близок?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508268
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508269
    m_Localized: 'Mama: Что мы тут можем поделать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508270
    m_Localized: 'Mama: Это не наша забота.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508271
    m_Localized: 'Mama: Убивают и убивают.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508272
    m_Localized: 'Mama: Ты главное смотри в оба за теми, кого пускаешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508273
    m_Localized: 'Mama: А то вдруг пустишь кого-то, кто окажется гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508274
    m_Localized: 'Mama: А какая разница?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508275
    m_Localized: 'Mama: Нас никто не трогает - это уже хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508276
    m_Localized: 'Mama: Остальное-то тебя волнует?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508277
    m_Localized: 'Mama: Пусть гости проходят мимо. И вот эти, в жёлтом.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508278
    m_Localized: 'Mama: Живы - хорошо. А насколько мы люди - кому не всё равно?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508279
    m_Localized: 'Mama: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508280
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508281
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508282
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508283
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508284
    m_Localized: 'Mama: Ох, сыночек, ты пожалуйста не пускай никого.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508285
    m_Localized: Что думаешь об убийствах?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508286
    m_Localized: Много ли в нас человечности?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508287
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508288
    m_Localized: 'Ohota: КЧС – Славные парни.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508289
    m_Localized: 'Ohota: Они делают тоже самое что и я – выслеживают гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508290
    m_Localized: 'Ohota: Но я считаю зря они нежничают с ними и отводят в карантинные зоны.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508291
    m_Localized: 'Ohota: Так они делают только хуже, ведь они могут объединиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508292
    m_Localized: 'Ohota: Лучше гасить их по одиночке.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508293
    m_Localized: 'Ohota: Хороший гость – мёртвый гость.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508294
    m_Localized: 'Ohota: Я считаю, конец наступит, если мы не остановим гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508295
    m_Localized: 'Ohota: Эти проклятые твари хотят обмануть нас и пробраться к нам в тыл.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508296
    m_Localized: 'Ohota: И вырезать нас по одиночке, под покровом ночи, пока мы спим.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508297
    m_Localized: 'Ohota: Думаю, они, рано или поздно, могут и до тебя добраться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508298
    m_Localized: 'Ohota: Но этого не произойдёт, если ты убьёшь гостя раньше, чем он убъёт тебя.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508299
    m_Localized: 'Ohota: Поэтому, я тебе советую не жевать сопли, а искать гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508300
    m_Localized: 'Ohota: Ты и так впустил сюда столько народу, что гостей теперь хер найдёшь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508301
    m_Localized: 'Ohota: Но не всё потеряно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508302
    m_Localized: 'Ohota: Начинай искать их прямо сейчас, и может быть ты кого-нибудь выследишь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508303
    m_Localized: 'Ohota: И, самое главное, не церемонься с ними!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508304
    m_Localized: 'Ohota: Выследил – прикончи!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508305
    m_Localized: 'Ohota: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508306
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508307
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508308
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508309
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508310
    m_Localized: 'Ohota: Будь начеку. Гостем может быть любой из нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508311
    m_Localized: Как ты относишься к КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508312
    m_Localized: Конец близок?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508313
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508314
    m_Localized: 'TV: Внимание! Экстренное включение!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508315
    m_Localized: 'TV: В связи с происходящими событиями, появились неравнодушные люди, готовые оказывать гуманитарную помощь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508316
    m_Localized: 'TV: Добровольцы отдают продукты и предоставляют убежища нуждающимся.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508317
    m_Localized: 'TV: Добровольцы утверждают, что их деятельность никак не связана с КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508319
    m_Localized: 'TV: Оставайтесь с нами на связи.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508320
    m_Localized: 'TV: Доброе утро, зрители! В эфире утренняя сводка новостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508321
    m_Localized: 'TV: КЧС продолжает выявлять новые признаки "гостей".'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508322
    m_Localized: 'TV: По их данным, при попытке сфотографировать "гостя", он получается сильно размытым на фото.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508323
    m_Localized: 'TV: Подобный эффект можно заметить только на плёночных фотоаппаратах.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508324
    m_Localized: 'TV: К сожалению, в этот раз, причины подобного явления так и не были установлены.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508325
    m_Localized: 'TV: Однако КЧС призывает граждан использовать новые данные для выявления "гостей".'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508326
    m_Localized: 'TV: Будьте бдительны, сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508327
    m_Localized: 'TV: Теперь к другим новостям.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508328
    m_Localized: 'anxiety: КЧС!? ГДЕ!?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508329
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508330
    m_Localized: 'anxiety: Их здесь нет?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508331
    m_Localized: 'anxiety: Пожалуйста, не называйте их, вдруг они услышат и придут.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508332
    m_Localized: 'anxiety: Меня в дрожь бросает от их упоминания.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508333
    m_Localized: 'anxiety: Я дико боюсь, что однажды они придут за мной и заберут.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508334
    m_Localized: 'anxiety: Но я не хочу... Не хочу, чтобы меня забирали в карантинную зону.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508335
    m_Localized: 'anxiety: Никто оттуда не возвращался.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508336
    m_Localized: 'anxiety: Мне страшно представить, что люди в жёлтых костюмах делают с теми, кого забрали.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508337
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508338
    m_Localized: 'anxiety: Конец?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508339
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508340
    m_Localized: 'anxiety: КОНЕЦ!?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508341
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508342
    m_Localized: 'anxiety: НЕТ, НЕ МОЖЕТ БЫТЬ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508343
    m_Localized: 'anxiety: ТОЛЬКО НЕ КОНЕЦ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508344
    m_Localized: 'anxiety: МЫ ВСЕ УМРЁМ В МУКАХ И АГОНИИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508345
    m_Localized: 'anxiety: ГОСПОДИ, СПАСИ ВСЕХ НАС!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508346
    m_Localized: 'anxiety: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508347
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508348
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508349
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508350
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508351
    m_Localized: 'anxiety: Э-э-эх. Надеюсь скоро всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508352
    m_Localized: Как ты относишься к КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508353
    m_Localized: Конец близок?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508354
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508355
    m_Localized: 'Volk: Это кровожадные охотники, решившие пасти нас как стадо овец.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508356
    m_Localized: 'Volk: Не обманывайся их видом – это волки в овечьей шкуре.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508357
    m_Localized: 'Volk: Сначал просто задают тебе вопросы со своими грёбаными отчётами.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508358
    m_Localized: 'Volk: Но как учуят запах мясца нужного сорта, сразу оскаливают острые зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508359
    m_Localized: 'Volk: А люди, как тупой скот послушно за ними идут.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508360
    m_Localized: 'Volk: Не доверяй этим волкам позорным.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508361
    m_Localized: 'Volk: Конец наступит тогда, когда каждый человек станет врагом друг другу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508362
    m_Localized: 'Volk: Мы не далеки от такого расклада судьбы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508363
    m_Localized: 'Volk: Поэтому нам надо держаться в стае. Стая – это хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508364
    m_Localized: 'Volk: Но будь на чеку.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508365
    m_Localized: 'Volk: Любая стая развалится без сильного вожака.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508366
    m_Localized: 'Volk: Вожак должен быть готов пойти на любые жертвы ради своей стаи, в том числе на убийства.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508367
    m_Localized: 'Volk: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508368
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508369
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508370
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508371
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508372
    m_Localized: 'Volk: У тебя какой-то вопрос ко мне?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508373
    m_Localized: Как ты относишься к КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508374
    m_Localized: Конец близок?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508375
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508376
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508377
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508378
    m_Localized: 'Widow: Если бы не КЧС...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508379
    m_Localized: 'Widow: Мой муж... Он был бы сейчас жив...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508380
    m_Localized: 'Widow: Я уже ни о чём не думаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508381
    m_Localized: 'Widow: Это бессмысленный вопрос.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508382
    m_Localized: 'Widow: Все и так знают. Да, это конец.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508383
    m_Localized: 'Widow: И ничего уже не изменишь, ничего уже не исправишь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508384
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508385
    m_Localized: 'Widow: Будь проклято это чёртово солнце.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508386
    m_Localized: 'Widow: И будь прокляты эти сраные гости.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508387
    m_Localized: 'Widow: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508388
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 49643508389
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 49643508390
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 49643508391
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 49643508392
    m_Localized: 'Widow: Отдохнуть бы немного...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508393
    m_Localized: Как ты относишься к КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508394
    m_Localized: Конец близок?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508395
    m_Localized: Мне надо тебя проверить.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508396
    m_Localized: 'Himoza: Доброй ночи.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508397
    m_Localized: 'Himoza: Мы из бригады КЧС. Нам нужно провести обследование вашего района.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508398
    m_Localized: Нашего прошлого человека мало?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508399
    m_Localized: Как насчет прошлого обследования?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508400
    m_Localized: 'Himoza: Прошлое?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508401
    m_Localized: 'Himoza: А, это. Процедура обследований довольно утомительна, сейчас ваш человек на реабилитации.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508402
    m_Localized: 'Himoza: После того, как он отдохнет, мы сразу вернем его назад.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508403
    m_Localized: Вы хотите взять еще кого-то?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508404
    m_Localized: Почему одного не хватило?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508405
    m_Localized: 'Himoza: Результаты слишком неоднозначны.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508406
    m_Localized: 'Himoza: Мы пока не уверены в результатах, выборка слишком мала оказалась.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508407
    m_Localized: Вы хотите взять еще кого-то?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508408
    m_Localized: Почему одного не хватило?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508409
    m_Localized: 'Himoza: Да. Боюсь, одного человека для понимания ситуации оказалось мало.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508410
    m_Localized: 'Himoza: Нам нужен будет еще один человек из вашего дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508411
    m_Localized: 'Himoza: Подойдет любой. Спасибо за сотрудничество.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508412
    m_Localized: Хорошо. Если по-другому никак.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508413
    m_Localized: Нет, эти исследования мне не интересны.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508414
    m_Localized: 'Himoza: Это слишком маленькая выборка.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508415
    m_Localized: 'Himoza: Начальство сначала сказало взять по одному. Но сейчас-то видно, что нужно больше.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508416
    m_Localized: 'Himoza: Поэтому мы снова выехали.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508417
    m_Localized: Хорошо. Если по-другому никак.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508418
    m_Localized: Нет, эти исследования мне не интересны.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508419
    m_Localized: 'Himoza: Да, по-другому не получится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508420
    m_Localized: 'Himoza: Все это ради вашей же безопасности.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508421
    m_Localized: 'Himoza: Вы не поняли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508422
    m_Localized: 'Himoza: Мы не давали выбор. Просто делаем свою работу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508423
    m_Localized: 'Himoza: Отказаться вы не сможете.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508424
    m_Localized: 'Himoza: Мы сделаем, что нужно и уйдем.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508425
    m_Localized: 'Prorok: Это чудо, что мы дожили до этого дня.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508426
    m_Localized: 'Prorok: Но что будет дальше – страшная тайна.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508427
    m_Localized: Ты вернулся.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508428
    m_Localized: Как ты выживал все это время?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508429
    m_Localized: 'Prorok: Это ненадолго.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508430
    m_Localized: 'Prorok: Я просто хожу и смотрю, что происходит вокруг, как меняется мир.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508431
    m_Localized: 'Prorok: И  меня пока нет ощущения, что ледники растают в ближайшее время.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508432
    m_Localized: 'Prorok: Ждать нам птичий дождь, видимо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508433
    m_Localized: Что это значит?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508434
    m_Localized: Ты думаешь, все будет плохо?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508435
    m_Localized: 'Prorok: Это не та проблема, которая должна тебя заботить. Но спасибо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508436
    m_Localized: 'Prorok: И меня пока нет ощущения, что ледники растают в ближайшее время.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508437
    m_Localized: 'Prorok: Ждать нам птичий дождь, видимо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508438
    m_Localized: Что это значит?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508439
    m_Localized: Ты думаешь, все будет плохо?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508440
    m_Localized: 'Prorok: Ты мне скажи.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508441
    m_Localized: 'Prorok: Это должен быть конец?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508442
    m_Localized: 'Prorok: Или нам предстоит еще пороха понюхать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508443
    m_Localized: 'Prorok: Я уже не вижу дальше собственного носа. Наверно, и нечего ждать чего-то.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508444
    m_Localized: Что нам делать?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508445
    m_Localized: Что у других людей?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508446
    m_Localized: 'Prorok: Есть ли смысл думать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508447
    m_Localized: 'Prorok: Не думаю, что теперь надо забивать этим голову.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508448
    m_Localized: 'Prorok: Тут хоть речь сохраняй, хоть прячь людей, а все одно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508449
    m_Localized: 'Prorok: У меня нет мыслей, как быть.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508450
    m_Localized: Что нам делать?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508451
    m_Localized: Что у других людей?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508452
    m_Localized: 'Prorok: Не знаю. Я продолжу просто смотреть. Это все, что я могу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508453
    m_Localized: 'Prorok: Что будешь делать ты?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508454
    m_Localized: 'Prorok: Тебе зачем это знание?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508455
    m_Localized: 'Prorok: Сколько мы ни смотрели на других, кроме карикатуры не получалось ничего.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508456
    m_Localized: 'Super: Мы снова встретились.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508457
    m_Localized: 'Super: Как тебе этот в костюме?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508458
    m_Localized: Делает свою работу.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508459
    m_Localized: Я не знаю как к нему относиться.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508460
    m_Localized: 'Super: Ну хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508461
    m_Localized: 'Super: Времена нынче такие, да? Надо бы быть настороже. Согласен?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508462
    m_Localized: Я вообще занят, можешь прийти потом?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508463
    m_Localized: Ты можешь уйти?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508464
    m_Localized: 'Super: А что тут не знать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508465
    m_Localized: 'Super: Ладно, мне-то все равно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508466
    m_Localized: Я вообще занят, можешь прийти потом?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508467
    m_Localized: Ты можешь уйти?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508468
    m_Localized: 'Super: Я понимаю, конечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508469
    m_Localized: 'Super: Я зайду попозже.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508470
    m_Localized: 'Super: Только…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508471
    m_Localized: 'Super: Скажи, ты в доме один?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508472
    m_Localized: Я не один.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508473
    m_Localized: Я один.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508474
    m_Localized: 'Super: Да, конечно. Не думал, что тебе неприятно общаться со мной.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508475
    m_Localized: 'Super: Только сначала…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508476
    m_Localized: 'Super: Ты сейчас один в доме?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508477
    m_Localized: Я не один.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508478
    m_Localized: Я один.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508479
    m_Localized: 'Super: Вот и всё?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508480
    m_Localized: 'Super: Ты остался один, солнце сожгло всех, кого ты знал.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508481
    m_Localized: 'Super: Дома у тебя либо никого, либо мои ребята.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508482
    m_Localized: 'Super: Как так получилось? Ты оказался самым злобным зверем?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508483
    m_Localized: 'Super: Ну...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508484
    m_Localized: 'Super: Идём сюда, будешь получать по заслугам.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508485
    m_Localized: 'Super: Готовитесь? А к чему готовиться знаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508486
    m_Localized: 'Super: Это последние дни. Тебе разве не говорили?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508487
    m_Localized: 'Super: Миром правят собаки. И останутся здесь только собаки.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508488
    m_Localized: 'Super: Удачно оставаться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508489
    m_Localized: 'TV: На фонарном столбе висит подвешенный мёртвый человек с табличкой на шее.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508490
    m_Localized: 'TV: На ней написано: «Мы не рады гостям».'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508491
    m_Localized: 'TV: Похоже, бедолагу приняли за гостя и убили в процессе самосуда.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508492
    m_Localized: 'TV: Мысль о насилии, захлестнувшем некогда спокойный и тихий городок, разрывает ваше сердце и вызывает тоску о спокойных временах.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508493
    m_Localized: 'TV: Вы видите кол, на который насажен череп в каске.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508494
    m_Localized: 'TV: На черепе осталось немного чёрной обгоревшей кожи, а зубы, похоже, кто-то вырвал.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508495
    m_Localized: 'TV: Голова простояла здесь весь день.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508496
    m_Localized: 'TV: Вся эта мрачная экспозиция выглядит как угроза, наверняка оставленная тем жутким бледным гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508497
    m_Localized: 'TV: Вы смотрите на соседский дом.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508498
    m_Localized: 'TV: От него остался лишь призрачный силуэт.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508499
    m_Localized: 'TV: Увиденное опустошило вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508500
    m_Localized: 'TV: Кажется, ещё сильнее вас тревожит понимание, что виноваты в этом не злые гости, а люди с паранойей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508501
    m_Localized: 'TV: Это приносит вам тревожность.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508502
    m_Localized: 'Super: Больше небезопасно жить на поверхности земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508503
    m_Localized: 'Super: Вы заколачиваете все окна и баррикадируете двери.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508504
    m_Localized: 'Super: Посовещавшись с вашими жильцами, вы решаете больше не выходить во внешний мир.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508505
    m_Localized: 'Super: Вам остаётся беспомощно молиться, что когда-нибудь всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508506
    m_Localized: 'Super: Если этот кошмар вообще когда-нибудь закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508507
    m_Localized: 'Super: Но надежда ещё жива... По крайней мере пока...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508508
    m_Localized: 'Super: Больше небезопасно жить на поверхности земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508509
    m_Localized: 'Super: Вы заколачиваете все окна и баррикадируете двери.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508510
    m_Localized: 'Super: Посовещавшись с вашими жильцами, вы решаете больше не выходить во внешний мир.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508511
    m_Localized: 'Super: Вам остаётся беспомощно молиться, что когда-нибудь всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508512
    m_Localized: 'Super: Если этот кошмар вообще когда-нибудь закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508513
    m_Localized: 'Super: Как минимум вам спокойно от того, что под вашей крышей не осталось гостей'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508514
    m_Localized: 'Super: Больше небезопасно жить на поверхности земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508515
    m_Localized: 'Super: Вы заколачиваете все окна и баррикадируете двери.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508516
    m_Localized: 'Super: Посовещавшись с вашими жильцами, вы решаете больше не выходить во внешний мир.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508517
    m_Localized: 'Super: Вам остаётся беспомощно молиться, что когда-нибудь всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508518
    m_Localized: 'Super: Если этот кошмар вообще когда-нибудь закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508519
    m_Localized: 'Super: Или это лишь относительно оптимимистичная мечта явившаяся во сне'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508520
    m_Localized: 'Super: На самом деле ваше тело было изуродованно гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508521
    m_Localized: 'Super: Которые, при возможности испытвать эмоции, были бы только рады такому подарку.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508522
    m_Localized: 'Super: А ведь оставался всего лишь день до.....'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508523
    m_Localized: 'Super: Больше небезопасно жить на поверхности земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508524
    m_Localized: 'Super: Вы заколачиваете все окна и баррикадируете двери.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508525
    m_Localized: 'Super: Посовещавшись с вашими жильцами, вы решаете больше не выходить во внешний мир.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508526
    m_Localized: 'Super: Вам остаётся беспомощно молиться, что когда-нибудь всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508527
    m_Localized: 'Super: Если этот кошмар вообще когда-нибудь закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508528
    m_Localized: 'Super: Но надежда ещё жива... По крайней мере пока...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508529
    m_Localized: 'Super: Благо ваш глаз наметан на гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508530
    m_Localized: 'Super: Ни один из них не перешагнул через порог убежища, которое когда-то еще можно было назвать милым домом.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508531
    m_Localized: 'Super: Хоть какая-то капелька мёда в цистерне дегтя происходящих событий.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508532
    m_Localized: 'Super: Больше небезопасно жить на поверхности земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508533
    m_Localized: 'Super: Вы заколачиваете все окна и баррикадируете двери.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508534
    m_Localized: 'Super: Посовещавшись с вашими жильцами, вы решаете больше не выходить во внешний мир.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508535
    m_Localized: 'Super: На вас, однако, стали странно посматривать'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508536
    m_Localized: 'Super: Слишком уж в быстром темпе вы живете, пытаясь как можно скорее пережить этот кошмар.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508537
    m_Localized: 'Super: Стоит ли постоянно куда-то спешить, абстрагируя себя от ужаса внешнего мира?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508538
    m_Localized: 'Super: Возможно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508539
    m_Localized: 'Super: Главное не забывать жить, находить в жизни прекрасное и наслаждаться этим.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508540
    m_Localized: 'Super: Ты сделал многое для тех, кого впустил.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508541
    m_Localized: 'Super: Но было пролито слишком много крови невынных.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508542
    m_Localized: 'Super: Ты слишком опасен, чтобы оставаться в этом доме, тебе надо уйти.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508543
    m_Localized: 'Super: Тебя изгоняют из своего собственного дома люди, опасаясь за свою безопасность.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508544
    m_Localized: 'Super: Ты не прожил и одного дня, и сгорел от палящего солнца на улице.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508545
    m_Localized: 'Super: Никто не узнает, что произошло когда пришёл последний гость.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508546
    m_Localized: 'Super: Дом остался без жильцов ещё на долгое время.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508547
    m_Localized: 'Super: После вашего страшного исчезновения все избегают покинутый дом. Super'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508548
    m_Localized: 'daughter: А ты можешь заглянуть внутрь глаза?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508549
    m_Localized: 'daughter: Ты увидишь там все, о чем я думаю?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508550
    m_Localized: 'daughter: Я тогда буду осторожно думать, не переживай.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508551
    m_Localized: 'daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508552
    m_Localized: 'daughter: Ты зачем так посмотрел?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508553
    m_Localized: 'daughter: Ты там у-у-увидел…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508554
    m_Localized: 'daughter: Ты … уааааа.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508555
    m_Localized: 'daughter: Я-я-я пи-ить хочу-уууу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508556
    m_Localized: 'daughter: А я умею сама стричь ногти уже.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508557
    m_Localized: 'daughter: Я пока не очень умею, мне…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508558
    m_Localized: 'daughter: Смотрите.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508559
    m_Localized: 'daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508560
    m_Localized: 'daughter: Вот какие ноготочки.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508561
    m_Localized: 'daughter: Это я сама постригла. Смогла. Сама.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508562
    m_Localized: 'daughter: Я пойду, хочу посидеть одна.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508567
    m_Localized: 'daughter: Фото?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508568
    m_Localized: 'daughter: А меня мало фотографировали.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508569
    m_Localized: 'daughter: Покажешь потом фото?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508570
    m_Localized: 'daughter: (Вы фотографируете девочку)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508571
    m_Localized: 'daughter: (Фотография получилась слегка размытой)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508572
    m_Localized: 'daughter: (Девочка, не дожидаясь конца фотосъемки подбежала к вам)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508573
    m_Localized: 'daughter: Мммм.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508574
    m_Localized: 'daughter: Спасибо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508575
    m_Localized: 'daughter: Мне не понравилось. Больше не проси меня делать фото.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508576
    m_Localized: 'daughter: Зубы? Показать вам зубы?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508577
    m_Localized: 'daughter: Зачем? У меня еще молочные зубки. Папа говорил…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508578
    m_Localized: 'daughter: Я не буду плакать больше.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508579
    m_Localized: 'daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508580
    m_Localized: 'daughter: Вот какие у меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508581
    m_Localized: 'daughter: Это что значит?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508582
    m_Localized: 'daughter: Все хорошо же?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508583
    m_Localized: 'Doctor: Хах, да, я покажу тебе свои глаза.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508584
    m_Localized: 'Doctor: Не знаю, заметил ты или нет, но у меня поликория.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508585
    m_Localized: 'Doctor: Вот что это значит.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508586
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508587
    m_Localized: 'Doctor: Я хуже из-за этого вижу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508588
    m_Localized: 'Doctor: Казалось бы, два зрачка в одном глазу - как удобно!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508589
    m_Localized: 'Doctor: Но... увы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508590
    m_Localized: 'Doctor: Да, этими руками я прооперировал уже очень много людей...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508591
    m_Localized: 'Doctor: Хах, я бы мог столько случаев рассказать, но в другой раз.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508592
    m_Localized: 'Doctor: А теперь, пожалуйста, смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508593
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508594
    m_Localized: 'Doctor: Стараюсь держать эти руки в тонусе, чтобы не расслабляться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508595
    m_Localized: 'Doctor: Кто знает, что случится завтра?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508596
    m_Localized: 'Doctor: Хорошо, без проблем.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508597
    m_Localized: 'Doctor: Понимаю, что надо проверить все признаки. Этот в том числе.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508598
    m_Localized: 'Doctor: (Вы фотографируете доктора)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508599
    m_Localized: 'Doctor: (Ничего необычного не получилось)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508600
    m_Localized: 'Doctor: Мне все говорили, что у меня необычная внешность.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508601
    m_Localized: 'Doctor: А что ты думаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508602
    m_Localized: 'Doctor: Cпасибо, у меня все прекрасно с зубами.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508603
    m_Localized: 'Doctor: А, ты именно про признаки гостя спрашиваешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508604
    m_Localized: 'Doctor: Конечно, смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508605
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508606
    m_Localized: 'Doctor: Идеальные, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508607
    m_Localized: 'Doctor: Мне друг по знакомству бесплатно такие поставил.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508608
    m_Localized: 'Doctor: А я его как-то проаперировал недавно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508609
    m_Localized: 'Doctor: Интересно, как он сейчас?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508610
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508611
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508612
    m_Localized: 'Doctor: Если хочешь, тебе тоже можем зубы починить.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508613
    m_Localized: 'Doctor: Задешево, конечно. Раз ты помог мне.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508614
    m_Localized: 'Doctor: Когда вся эта история с солнцем закончится, конечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508615
    m_Localized: 'Doctor: Подожди, что?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508616
    m_Localized: 'Doctor: Ты делаешь ошибку, я людей лечу!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508617
    m_Localized: 'Doctor: А ты сейчас человека убьешь...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508618
    m_Localized: 'Esenin: С каждым днем все бредовее.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508619
    m_Localized: 'Esenin: А если я не выспался? Или плакал?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508620
    m_Localized: 'Esenin: Я перестаю понимать, как это вообще работает.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508621
    m_Localized: 'Esenin: А что ты будешь делать, если один признак подтвердится? Или несколько?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508622
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508623
    m_Localized: 'Esenin: Теперь пойду стану гостем этой ночью.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508624
    m_Localized: 'Esenin: Поплачу, вспомню спокойные времена.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508625
    m_Localized: 'Esenin: Откуда они вообще полезли?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508626
    m_Localized: 'Esenin: Ногти, испачканные в земле? Это признак?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508627
    m_Localized: 'Esenin: Они же могут руки помыть! И все!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508628
    m_Localized: 'Esenin: А какой-нибудь садовник сразу же становится гостем, получается?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508629
    m_Localized: 'Esenin: Ебаный бред.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508630
    m_Localized: 'Esenin: Смотри ногти.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508631
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508632
    m_Localized: 'Esenin: Ну что, я – гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508633
    m_Localized: 'Esenin: Ну еще бы нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508634
    m_Localized: 'Esenin: Все эти проверки по признакам, парни в желтых комбезах…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508635
    m_Localized: 'Esenin: Все это… как-то.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508636
    m_Localized: 'Esenin: Какой-то пиздец.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508637
    m_Localized: 'Esenin: Нет у тебя ощущения, что все идет к какому-то страшному аду?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508638
    m_Localized: 'Esenin: Все якобы под контролем, но вокруг полный хаос.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508639
    m_Localized: 'Esenin: Ну, фоткай, давай.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508640
    m_Localized: 'Esenin: (Вы фотографируете собеседника)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508641
    m_Localized: 'Esenin: (Он сидит спокойно, целиком в кадр не помещается, но ничего необычного вы не видите)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508642
    m_Localized: 'Esenin: Мне просто жутко, что будет происходить дальше.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508643
    m_Localized: 'Esenin: Тебе показать мои зубы?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508644
    m_Localized: 'Esenin: Ну посмотри. На них еще остался привкус несчастья и дыма.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508645
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508646
    m_Localized: 'Esenin: Желтоватые, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508647
    m_Localized: 'Esenin: Ну вот и не доебывайся до меня со своими тестами.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508648
    m_Localized: 'Esenin: Я не гость.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508649
    m_Localized: 'Fan: ЗАГЛЯНИ В МОИ ТЕМНЫЕ ГЛАЗА!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508650
    m_Localized: 'Fan: Я впитываю ими все блага света, прррреобразуя из них энергию.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508651
    m_Localized: 'Fan: Все мои силы я получаю из ГЛАЗ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508652
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508653
    m_Localized: 'Fan: ТЫ УВИДЕЛ В МОИХ ГЛАЗАХ ПРАВЕДНУЮ СИЛУ СОЛНЦА?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508654
    m_Localized: 'Fan: Если нет, ты просто слепец. Попробуй подольше посмотреть на солнце, КАК Я.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508655
    m_Localized: 'Fan: Никаких запретов, мой друг!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508656
    m_Localized: 'Fan: Смотри мои ногти, сколько тебе влезет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508657
    m_Localized: 'Fan: Я натренировался получать ими полезный солнечный свет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508658
    m_Localized: 'Fan: И открываю крышки пива.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508659
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508660
    m_Localized: 'Fan: Ты, это, просто проверить хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508661
    m_Localized: 'Fan: Я думал... эээх, ТЫ ПРОСТО ЗЛОЙ ЧЕЛОВЕК!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508662
    m_Localized: 'Fan: Сфоткаться?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508663
    m_Localized: 'Fan: Хм-хм-хм-хм.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508664
    m_Localized: 'Fan: Тебе кто-то рассказал, что я здоровался с самим СОЛНЕЧНЫМ ЛИДЕРОМ?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508665
    m_Localized: 'Fan: Да, я учил его смотреть на солнце, но это я как-нибудь потом расскажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508666
    m_Localized: 'Fan: Давай, ФОТКАЙ МЕНЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508667
    m_Localized: 'Fan: (Вы фотографируете неаккуратного мужчину)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508668
    m_Localized: 'Fan: (Как и в жизни, на фотографии он неухоженный и грязный)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508669
    m_Localized: 'Fan: (Вы не замечаете искажений)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508670
    m_Localized: 'Fan: КАК ЖЕ ПРЕКРАСНО ВСЕ ПОЛУЧИЛОСЬ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508671
    m_Localized: 'Fan: Приходи ко мне, буду рассказывать свое житие-бытие.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508672
    m_Localized: 'Fan: А ты мне за это дашь немного денег.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508673
    m_Localized: 'Fan: ЭТО ЖЕ НА СПАСЕНИЕ ЭНЕРГИИ СОЛНЦА!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508674
    m_Localized: 'Fan: Мои зубы тебе показать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508675
    m_Localized: 'Fan: А Я ИМИ ПРАВДЫ ОТСТАИВАЛ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508676
    m_Localized: 'Fan: Все правды свои я отстоял.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508677
    m_Localized: 'Fan: Да ты сам посмотри, что я тут в самом деле.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508678
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508679
    m_Localized: 'Fan: Я спасаю зубы пивным раствором, он хорошо охраняет кальций.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508680
    m_Localized: 'Fan: А без этого давно бы зубы растерял.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508681
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508682
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508683
    m_Localized: 'Fan: Понимаемо, конечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508684
    m_Localized: 'Fan: Сейчас столько всего происходит, но мы живем.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508685
    m_Localized: 'Fan: Живем дальше.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508686
    m_Localized: 'Fan: Ты чего, в тени пересидел?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508687
    m_Localized: 'Fan: Приляг-ка ты отдохни, друг.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508688
    m_Localized: 'Holod: Сейчас глаза - это зеркало в ад, а не в душу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508689
    m_Localized: 'Holod: Вся душа давно сгорела. От того так и холодно, наверно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508690
    m_Localized: 'Holod: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508691
    m_Localized: 'Holod: Узкие зрачки?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508692
    m_Localized: 'Holod: Видимо, так меня сковывает холод.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508693
    m_Localized: 'Holod: Жаль, что солнце меня сжигает так же, как и остальных.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508694
    m_Localized: 'Holod: Я бы согрелся под солнцем, хотя бы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508695
    m_Localized: 'Holod: Ногти? Сейчас покажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508696
    m_Localized: 'Holod: Хм. Я их сковырнул все, чтоли.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508697
    m_Localized: 'Holod: Но ты все равно глянь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508698
    m_Localized: 'Holod: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508699
    m_Localized: 'Holod: Как ты думаешь, мои ногти подходили под признак гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508700
    m_Localized: 'Holod: Понял.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508701
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508702
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508703
    m_Localized: 'Holod: Знаешь, я уже так устал жить.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508704
    m_Localized: 'Holod: Но ты решил не убивать меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508705
    m_Localized: 'Holod: А в это время в других домах кто-то кого-то убил, наверно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508706
    m_Localized: 'Holod: Почему так? Не задумывался?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508707
    m_Localized: 'Holod: Знаешь...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508708
    m_Localized: 'Holod: Я, кажется, понял, почему мне так холодно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508709
    m_Localized: 'Holod: Как фотография может определить что-то?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508710
    m_Localized: 'Holod: Тебе не кажется это странным?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508711
    m_Localized: 'Holod: Но от меня мало что зависит. Конечно, фотографируй.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508712
    m_Localized: 'Holod: (Вы фотографируете собеседника)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508713
    m_Localized: 'Holod: (На фото тело и одежду видно нечетко, как будто во время фотосессии по человеку прошла крупная дрожь)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508714
    m_Localized: 'Holod: Извини, я дернулся во время вспышки.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508715
    m_Localized: 'Holod: Можем еще раз попробовать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508716
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508717
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508718
    m_Localized: 'Holod: Как ты думаешь? Сколько еще признаков придумают, прежде чем поймут, что нужно вообще делать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508719
    m_Localized: 'Holod: Почему надо обязательно кого-то убивать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508720
    m_Localized: 'Holod: Или это было все же не обязательно? Только мы так поняли?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508721
    m_Localized: 'Holod: Мне нечего терять.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508722
    m_Localized: 'Holod: Хотя, подожди, я хочу показать...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508723
    m_Localized: 'Holod: М, зубы?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508724
    m_Localized: 'Holod: Если это чем-то поможет, конечно, смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508725
    m_Localized: 'Holod: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508726
    m_Localized: 'Holod: Что теперь делать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508727
    m_Localized: 'Holod: А, вот что.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508728
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508729
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508730
    m_Localized: 'Holod: Спасибо за доверие.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508731
    m_Localized: 'Holod: Надеюсь, смогу быть полезен.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508732
    m_Localized: 'Holod: Меня кое-что гложет, но я пока не могу тебе открыться, извини.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508733
    m_Localized: 'Holod: Все же будешь стрелять?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508734
    m_Localized: 'Holod: Подожди, перед этим я покажу...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508735
    m_Localized: 'Super: Вы чувствуете запах гнили и смерти. Кого-то убили этой ночью.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508736
    m_Localized: 'Super: Похоже, в доме есть "гости".'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508737
    m_Localized: 'Super: Лучше быть начеку и тщательнее проверять людей на признаки "гостей".'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508738
    m_Localized: 'Mama: У меня всегда лопнувшие сосуды в глазах.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508739
    m_Localized: 'Mama: Не знаю, как ты будешь определять, гость ли я.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508740
    m_Localized: 'Mama: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508741
    m_Localized: 'Mama: Что будешь делать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508742
    m_Localized: 'Mama: К чему ты склоняешься?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508743
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508744
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508745
    m_Localized: 'Mama: Конечно, какой же это признак?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508746
    m_Localized: 'Mama: Было бы страшно ошибиться и случайно убить человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508747
    m_Localized: 'Mama: Много ли раз ты ошибался? Берешь ли ты на себя ответственность за такие убийства?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508748
    m_Localized: 'Mama: Ну ты стреляй по глазам.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508749
    m_Localized: 'Mama: Тебе-то уже не поможет, завтра они придут стучать тебе под окна!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508750
    m_Localized: 'Mama: Или солнце сожжет тебе глаза наконец!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508751
    m_Localized: 'Mama: Вот с этим у нас будут проблемы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508752
    m_Localized: 'Mama: Старость не радость, сынок.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508753
    m_Localized: 'Mama: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508754
    m_Localized: 'Mama: Я уж не помню как эта болезнь называется, но у меня теперь ногти отходят.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508755
    m_Localized: 'Mama: Больно и неприятно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508756
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508757
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508758
    m_Localized: 'Mama: Какой смысл стрелять в больного человека?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508759
    m_Localized: 'Mama: Ты бы мог меня, конечно, избавить от страданий.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508760
    m_Localized: 'Mama: Но я бы еще пострадала какое-то время, хахаха.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508761
    m_Localized: 'Mama: Да ты стреляй.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508762
    m_Localized: 'Mama: После меня придут и добьют тебя и всю твою шоблу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508763
    m_Localized: 'Mama: Ты всех обрек на смерть, хахахаха!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508764
    m_Localized: 'Mama: Давно меня не фотографировали.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508765
    m_Localized: 'Mama: Давай, почему нет?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508766
    m_Localized: 'Mama: (Вы фотографируете собеседника)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508767
    m_Localized: 'Mama: (Вы специально не двигаетесь и выжидаете момент)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508768
    m_Localized: 'Mama: (Когда фото проявляется, вы видете, что оно размыто. Совсем)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508769
    m_Localized: 'Mama: А почему меня так плохо видно?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508770
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508771
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508772
    m_Localized: 'Mama: Можно я у себя оставлю?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508773
    m_Localized: 'Mama: У меня и фотографий не осталось уже.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508774
    m_Localized: 'Mama: Попробуй, тебя же размажут.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508775
    m_Localized: 'Mama: Прям как меня на фотке размазало, АХАХАХАХА.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508776
    m_Localized: 'Mama: Хахахаха, какие зубы, сынок?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508777
    m_Localized: 'Mama: Ну, посмотри, чего же нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508778
    m_Localized: 'Mama: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508779
    m_Localized: 'Mama: И чего?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508780
    m_Localized: 'Mama: Какой вывод делать будем?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508781
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508782
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508783
    m_Localized: 'Mama: Ты с этой ерундой поосторожнее обращайся.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508784
    m_Localized: 'Mama: Во всех ее тыкать - так каждый начнет на тебя косо смотреть.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508785
    m_Localized: 'Mama: Ты же не всегда держишь в руках это свое ружье, а?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508786
    m_Localized: 'Mama: ДА И ПОШЕЛ ТЫ ПОДАЛЬШЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508787
    m_Localized: 'Mama: ОНИ ВСЕ СГРЫЗУТ ТЕБЯ, КАК ТОЛЬКО ТЫ УСНЕШЬ.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508788
    m_Localized: 'Ohota: Знаешь, у меня когда-то был цвет в глазах.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508789
    m_Localized: 'Ohota: Сейчас, конечно, от такой жизни только серые глаза достаются нам.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508790
    m_Localized: 'Ohota: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508791
    m_Localized: 'Ohota: Но я доберусь до всех. Раздеру их руками.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508792
    m_Localized: 'Ohota: Тогда мы снова спокойно заживем.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508793
    m_Localized: 'Ohota: Погнали-погнали.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508794
    m_Localized: 'Ohota: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508795
    m_Localized: 'Ohota: Конечно, у меня руки будут грязные, я хожу по ночам копать этих чертей.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508796
    m_Localized: 'Ohota: Их так даже проще убивать!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508797
    m_Localized: 'Ohota: Тебе советую делать тоже самое.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508798
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508799
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508800
    m_Localized: 'Ohota: Ещё бы!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508801
    m_Localized: 'Ohota: Этой ночью пойдешь тоже душить гостей?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508802
    m_Localized: 'Ohota: Пойдем за ними охотиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508803
    m_Localized: 'Ohota: Будешь выкидывать меня - положи поближе к этим.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508804
    m_Localized: 'Ohota: Страшно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508805
    m_Localized: 'Ohota: Да я особо не люблю фоткаться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508806
    m_Localized: 'Ohota: Вспышка напоминает мне грозу, у меня сразу паника.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508807
    m_Localized: 'Ohota: Нет, ты не понял, я не буду фоткаться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508808
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508809
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508810
    m_Localized: 'Ohota: Спасибо за понимание.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508811
    m_Localized: 'Ohota: Знаешь, не люблю я это всё. Фоткаться, резкие вспышки, звуки.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508812
    m_Localized: 'Ohota: Бррррр.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508813
    m_Localized: 'Ohota: Мне это всё не интересно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508814
    m_Localized: 'Ohota: НЕТ, ПОДОЖДИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508815
    m_Localized: 'Ohota: Ай, похуй, я побежал.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508816
    m_Localized: 'Ohota: Зубы? Ну хорошо, давай покажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508817
    m_Localized: 'Ohota: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508818
    m_Localized: 'Ohota: Подожди, и что теперь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508819
    m_Localized: 'Ohota: Нихера себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508820
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508821
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508822
    m_Localized: 'Ohota: Я понимаю, стресс, все дела.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508823
    m_Localized: 'Ohota: Но месить-то надо гостей, а не друг друга.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508824
    m_Localized: 'Ohota: Вовремя ты одумался.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508825
    m_Localized: 'Ohota: Нихера себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508826
    m_Localized: 'Ohota: Вот такая ирония – ружье отняли, теперь еще и умру от ружья.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508827
    m_Localized: 'anxiety: Хочешь проверить глаза?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508828
    m_Localized: 'anxiety: Я догадываюсь, какой будет результат.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508829
    m_Localized: 'anxiety: Что будет, если подойду по этому признаку?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508830
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508831
    m_Localized: 'anxiety: Ну еще бы. Могло ли быть иначе.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508832
    m_Localized: 'anxiety: Ты убьешь меня? Жаль, что я так и не узнаю, что нас всех ждет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508833
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508834
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508835
    m_Localized: 'anxiety: Я правда гость? Как ты думаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508836
    m_Localized: 'anxiety: А почему я не знаю об этом? Может, так ими и становятся?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508837
    m_Localized: 'anxiety: Может, достаточно подумать, что ты не такой как все и вот ты страшнейший для общества человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508838
    m_Localized: 'anxiety: Страшно умирать.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508839
    m_Localized: 'anxiety: Подожди, можно мне повязку какую?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508840
    m_Localized: 'anxiety: Или еще чуть постоять хотя бы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508841
    m_Localized: 'anxiety: Показать ногти? Интересный признак, конечно…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508842
    m_Localized: 'anxiety: Да, давай посмотрим.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508843
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508844
    m_Localized: 'anxiety: Что на них? Это же не земля.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508845
    m_Localized: 'anxiety: Я-я-я даже не помню, чтобы ковырялась в земле.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508846
    m_Localized: 'anxiety: Может, кто-то меня измазал?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508847
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508848
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508849
    m_Localized: 'anxiety: Как у меня появилась эта грязь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508850
    m_Localized: 'anxiety: Я же не могла не мыться уже несколько дней. Да?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508851
    m_Localized: 'anxiety: Как… странно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508852
    m_Localized: 'anxiety: Так и кончится моя жизнь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508853
    m_Localized: 'anxiety: Как… жаль.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508854
    m_Localized: 'anxiety: Ты же передумал?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508855
    m_Localized: 'anxiety: Если окажется, что я гость, я начну убивать людей?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508856
    m_Localized: 'anxiety: Я стану опасной? Или всегда ей была?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508857
    m_Localized: 'anxiety: Может, я и убиваю людей?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508858
    m_Localized: 'anxiety: (Вы фотографируете собеседника)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508859
    m_Localized: 'anxiety: (Когда фотография проявляется, вы видите размытое тело и четкий фон)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508860
    m_Localized: 'anxiety: (Как будто в момент фотографии человек резко дернулся)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508861
    m_Localized: 'anxiety: Хахаха, представляешь? Я ведь просто дернулась.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508862
    m_Localized: 'anxiety: Что теперь будет?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508863
    m_Localized: 'anxiety: Можно ли мне жить? Или лучше убить? А что ты сделаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508864
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49643508865
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49643508866
    m_Localized: 'anxiety: Почему?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508867
    m_Localized: 'anxiety: Может, меня будет проще пристрелить уже?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508868
    m_Localized: 'anxiety: Я хочу уйти, но слишком страшно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508869
    m_Localized: 'anxiety: Может…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508870
    m_Localized: 'anxiety: Не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508871
    m_Localized: 'anxiety: А если ты выстрелишь, и я вообще стану чем-то еще более ужасным?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508872
    m_Localized: 'anxiety: Может, мне убежать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508873
    m_Localized: 'anxiety: Но я не знаю, вдруг, я все же человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508874
    m_Localized: 'anxiety: Что мне делать?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284928
    m_Localized: 'anxiety: Хах, это что же, по зубам ты будешь принимать решения? Ох-ооох.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284929
    m_Localized: 'anxiety: Я ведь недавно исправляла зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284930
    m_Localized: 'anxiety: Хотя, если честно…'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284931
    m_Localized: 'anxiety: Я не могу вспомнить, когда я была у стоматолога. Была ли я вообще у него?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284932
    m_Localized: 'anxiety: Господи, от страха не могу вспомнить даже, что вчера ела.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284933
    m_Localized: 'anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284934
    m_Localized: 'anxiety: Это что же… Я подхожу под описание?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284935
    m_Localized: 'anxiety: Так не может быть…'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284936
    m_Localized: 'anxiety: Я не могу же быть гостем. Да?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284937
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49660284938
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49660284939
    m_Localized: 'anxiety: Нет, это же совпадение, правда? Как я могу быть Гостем?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284940
    m_Localized: 'anxiety: Так быть не может…'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284941
    m_Localized: 'anxiety: Не может же?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284942
    m_Localized: 'anxiety: Я помню свою жизнь, ничего в ней … такого нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284943
    m_Localized: 'anxiety: Спасибо.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284944
    m_Localized: 'anxiety: Нет, неееет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284945
    m_Localized: 'anxiety: Получается, я гость? Как? КААААК? Не надо!'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284946
    m_Localized: 'Volk: Ищешь во мне чужака?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284947
    m_Localized: 'Volk: Не боишься в них свое отражение увидеть?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284948
    m_Localized: 'Volk: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284949
    m_Localized: 'Volk: Я впечатлен.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284950
    m_Localized: 'Volk: Не все выдерживают мой взгляд.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284951
    m_Localized: 'Volk: Хочешь послушать про мои руки?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284952
    m_Localized: 'Volk: Да, я убивал. Недавно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284953
    m_Localized: 'Volk: Меня пытались убить. Я не буду стоять и ждать, пока меня убьют.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284954
    m_Localized: 'Volk: Есть люди которые при опасности замирают, а есть те, кто бегут.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284955
    m_Localized: 'Volk: Я из тех, кто бьет.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284956
    m_Localized: 'Volk: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284957
    m_Localized: 'Volk: И что? Ты будешь стрелять?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284958
    m_Localized: 'Volk: И что дальше?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284959
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49660284960
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49660284961
    m_Localized: 'Volk: Я ведь могу быстрее тебя оказаться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284962
    m_Localized: 'Volk: И тогда ружье будет у меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284963
    m_Localized: 'Volk: СУКА!'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284964
    m_Localized: 'Volk: Я ТЕБЯ С СОБОЙ ЗАБЕРУ.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284965
    m_Localized: 'Volk: Я не люблю фотографироваться.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284966
    m_Localized: 'Volk: Если потом эти фотографии окажутся не в мусорном ведре, мне придется принять меры.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284967
    m_Localized: 'Volk: Ты понимаешь это?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284968
    m_Localized: 'Volk: (Вы фотографируете собеседника)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284969
    m_Localized: 'Volk: (Вы размахиваете фотографией, чтобы она быстрее проявилась)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284970
    m_Localized: 'Volk: (Вы замечаете, что фотография, вроде, нормальная, но у вас вырывают ее из рук)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284971
    m_Localized: 'Volk: Дай сюда. Я выкину сам.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284972
    m_Localized: 'Volk: Смотри у меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284973
    m_Localized: 'Volk: Если нападешь - я тебе шею этими зубами прокушу.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284974
    m_Localized: 'Volk: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284975
    m_Localized: 'Volk: Я за своими зубами ухаживаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284976
    m_Localized: 'Volk: А тех что не хватает...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284977
    m_Localized: 'Volk: Ну пусть их в могиле покрепче сжимают те ублюдки.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284978
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49660284979
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49660284980
    m_Localized: 'Volk: Ты на меня больше ружье не наводи.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284981
    m_Localized: 'Volk: Я же знаю, когда и сколько ты спишь.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284982
    m_Localized: 'Volk: И если что - я же тебя живьем загрызу, дитя.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284983
    m_Localized: 'Volk: Не делай ошибок.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284984
    m_Localized: 'Volk: Из такого я уже выбирался.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284985
    m_Localized: 'Volk: Ну давай посмотрим, кто быстрее.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284986
    m_Localized: 'Volk: ХХААААА!'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284987
    m_Localized: 'Widow: Что ты хочешь проверить? Красноту?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284988
    m_Localized: 'Widow: Попробуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284989
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284990
    m_Localized: 'Widow: Если я показываю эмоции, значит, я гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284991
    m_Localized: 'Widow: Может ли человек в этом новом мире плакать? Смеяться уже точно нельзя.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284992
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 49660284993
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 49660284994
    m_Localized: 'Widow: Можем ли мы быть откровенны теперь?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284995
    m_Localized: 'Widow: Радоваться не получается, плакать нельзя.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284996
    m_Localized: 'Widow: Говорить не всегда получается.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284997
    m_Localized: 'Widow: Остается только сидеть и закрыть лицо руками.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284998
    m_Localized: 'Widow: Вот так легко все закончится?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284999
    m_Localized: 'Widow: Больше никаких страданий?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285000
    m_Localized: 'Widow: Но я так и не сохранила тебя, мой...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285001
    m_Localized: 'Widow: Руки... сейчас, подожди.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285002
    m_Localized: 'Widow: Руки устали нести того, кого спасти отказались.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285003
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285004
    m_Localized: 'Widow: А вообще можно меня не просить этой хуйней заниматься?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285005
    m_Localized: 'Widow: Если захочешь пристрелить - просто стреляй.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285006
    m_Localized: 'Widow: У меня нет сил больше...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285007
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285008
    m_Localized: 'Widow: Нет, извини, я проосто очень устала.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285009
    m_Localized: 'Widow: Тебе это не кажется издевательством?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285010
    m_Localized: 'Widow: Никто не помог спасти мне мужа, но теперь...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285011
    m_Localized: 'Widow: ВЫ ХОТИТЕ ЗАПЕЧАТЛЕТЬ ЕГО СМЕРТЬ?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285012
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285013
    m_Localized: 'Widow: У меня нет слов.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285014
    m_Localized: 'Widow: Делай что хочешь и не трогай меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285015
    m_Localized: 'Widow: (Вы делаете фотографию девушки)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285016
    m_Localized: 'Widow: (Ничего необычного вы не видите)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285017
    m_Localized: 'Widow: (Покойник оказался в кадре, это заставляет вас задуматься)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285018
    m_Localized: 'Widow: Теперь просто уйди.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285019
    m_Localized: 'Widow: Что?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285020
    m_Localized: 'Widow: ... ладно.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285021
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285022
    m_Localized: 'Widow: Все?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285023
    m_Localized: 'Widow: Я могу побыть побыть здесь спокойно одна?'
    m_Metadata:
      m_Items: []
  - m_Id: 13823157919797248
    m_Localized: 'TV: И направлена на помощь нуждающимся.'
    m_Metadata:
      m_Items: []
  - m_Id: 13823157923991552
    m_Localized: 'daughter: Что нужно сделать?'
    m_Metadata:
      m_Items: []
  - m_Id: 13823157923991553
    m_Localized: 'daughter: (Вы смотрите на неё и понимаете, что для вас это черезчур)'
    m_Metadata:
      m_Items: []
  - m_Id: 13823157923991554
    m_Localized: 'daughter: Просто хотите узнать как у меня дела?'
    m_Metadata:
      m_Items: []
  - m_Id: 13823157923991555
    m_Localized: 'daughter: Я очень устала, можно постою тут одна?'
    m_Metadata:
      m_Items: []
  - m_Id: 19268172649320448
    m_Localized: Кто стишки мои заметил, про маман, про мать свою,
    m_Metadata:
      m_Items: []
  - m_Id: 19268172649320449
    m_Localized: Я прошу у вас прощенья. Я сейчас все объясню
    m_Metadata:
      m_Items: []
  - m_Id: 19268172649320450
    m_Localized: Я тестировал на прочность, сколько текста я смогу
    m_Metadata:
      m_Items: []
  - m_Id: 19268172649320451
    m_Localized: Поместить вовнутрь кнопки, чтоб понять его длину.
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092672
    m_Localized: Кто стишки мои заметил, про маман, про мать свою,
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092673
    m_Localized: Я прошу у вас прощенья. Я сейчас все объясню
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092674
    m_Localized: Я тестировал на прочность, сколько текста я смогу
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092675
    m_Localized: Поместить вовнутрь кнопки, чтоб понять его длину.
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092676
    m_Localized: Просто текст вставлять мне скучно, ну и вот я и решил,
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092677
    m_Localized: Сочиню-ка стишок матный. Как все знают - сочинил.
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092678
    m_Localized: Это должен быть внутряк наш, и никто не должен был,
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092679
    m_Localized: тот стишок весь неприличный, видеть, что я сочинил.
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092680
    m_Localized: Но случился баг какой-то, и дефолтный диалог,
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092681
    m_Localized: можно было бы увидеть, вместе с ним и мой стишок.
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092682
    m_Localized: Мне смешно и стыдно было, как народ его нашел,
    m_Metadata:
      m_Items: []
  - m_Id: 22748764888092683
    m_Localized: что ж, теперь я объяснился, дальше кодить я пошел.
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188352
    m_Localized: 'Sexy: Добрый день!'
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188353
    m_Localized: 'Sexy: Меня зовут Секси.'
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188354
    m_Localized: 'Sexy: Я Секси, и я люблю тебя.'
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188355
    m_Localized: 'Sexy: (Показывает левую руку)'
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188356
    m_Localized: 'Sexy: (Показывает правую руку)'
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188357
    m_Localized: 'Sexy: (Показывает левую ногу)'
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188358
    m_Localized: 'Sexy: (Показывает правую ногу)'
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188359
    m_Localized: Проходите, леди!
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188360
    m_Localized: Залетай, шмара!
    m_Metadata:
      m_Items: []
  - m_Id: 22487940772646912
    m_Localized: Кринж!
    m_Metadata:
      m_Items: []
  - m_Id: 23959424850448384
    m_Localized: 'Prorok: Ну ты и еблан! Зачем столько народу поубивал?'
    m_Metadata:
      m_Items: []
  - m_Id: 23959424879808512
    m_Localized: 'Prorok: Мда... Кринж'
    m_Metadata:
      m_Items: []
  - m_Id: 23959424879808513
    m_Localized: 'Prorok: Ой, а кто это за твоей спиной направил ружье на тебя?'
    m_Metadata:
      m_Items: []
  - m_Id: 23959424879808514
    m_Localized: 'Prorok: Пацан к успеху шел...'
    m_Metadata:
      m_Items: []
  - m_Id: 24336123471581184
    m_Localized: 'Sexy: Ты кого шмарой назвал?!'
    m_Metadata:
      m_Items: []
  - m_Id: 28176949561774080
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 28176949582745600
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 28176949582745601
    m_Localized: Выборы, выборы. Кандидаты - пидоры!
    m_Metadata:
      m_Items: []
  - m_Id: 28176949582745602
    m_Localized: Всем привет. В нашем городе проходят выборы.
    m_Metadata:
      m_Items: []
  - m_Id: 28176949582745603
    m_Localized: А это значит, что пора голосовать.
    m_Metadata:
      m_Items: []
  - m_Id: 28176949582745604
    m_Localized: Долой презерватив! Засовывай голым!
    m_Metadata:
      m_Items: []
  - m_Id: 28176949582745605
    m_Localized: (Не является индивидуальной рекоммендацией, перед применением проконсультироваться со специалистом)
    m_Metadata:
      m_Items: []
  - m_Id: 29033823093903360
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 29033823135846400
    m_Localized: Аура
    m_Metadata:
      m_Items: []
  - m_Id: 29033823135846401
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 29033823135846402
    m_Localized: 'Esenin: Ну что, я – гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 29033823135846403
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 29033823135846404
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 29033823135846405
    m_Localized: 'Esenin: Ну что, я – гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 29033823135846406
    m_Localized: Подмыхи
    m_Metadata:
      m_Items: []
  - m_Id: 29033823135846407
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 29033823135846408
    m_Localized: 'Esenin: Ну что, я – гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 29036507523960834
    m_Localized: Похуй
    m_Metadata:
      m_Items: []
  - m_Id: 29036507523960833
    m_Localized: Похуй
    m_Metadata:
      m_Items: []
  - m_Id: 29036507523960832
    m_Localized: Похуй
    m_Metadata:
      m_Items: []
  - m_Id: 29036726110113792
    m_Localized: Не похуй
    m_Metadata:
      m_Items: []
  - m_Id: 29036726114308096
    m_Localized: Не похуй
    m_Metadata:
      m_Items: []
  - m_Id: 29036726114308097
    m_Localized: Не похуй
    m_Metadata:
      m_Items: []
  - m_Id: 29383233539657728
    m_Localized: Что ты хочешь купить?
    m_Metadata:
      m_Items: []
  - m_Id: 29383233560629248
    m_Localized: Энержеку
    m_Metadata:
      m_Items: []
  - m_Id: 29383233560629249
    m_Localized: Кофе
    m_Metadata:
      m_Items: []
  - m_Id: 29383233560629250
    m_Localized: На!
    m_Metadata:
      m_Items: []
  - m_Id: 29383233560629251
    m_Localized: Держи!
    m_Metadata:
      m_Items: []
  - m_Id: 34114516710838272
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 34114516752781312
    m_Localized: Аура
    m_Metadata:
      m_Items: []
  - m_Id: 34114516752781313
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 34114516752781314
    m_Localized: Подмыхи
    m_Metadata:
      m_Items: []
  - m_Id: 34114516752781315
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 34114516752781316
    m_Localized: 'Esenin: Ну что, я – гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 34114516752781317
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 34114516752781318
    m_Localized: 'Esenin: Ну что, я – гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 34114516752781319
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 34114516752781320
    m_Localized: 'Esenin: Ну что, я – гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807811190784
    m_Localized: 'neighbour: Кстати. Держи 5 сигарет!'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550912
    m_Localized: 'neighbour: Но взамен я украду у тебя 5 пива...'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550913
    m_Localized: 'neighbour: Сюююююда! Лут!'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550914
    m_Localized: 'neighbour: Жаль...'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550915
    m_Localized: 'neighbour: Хотя я тут подумал... Я хочу еще 5 пива!'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550916
    m_Localized: 'neighbour: Сюююююда! Лут!'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550917
    m_Localized: 'neighbour: Как это кончилось? Эх(((('
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550918
    m_Localized: 'neighbour: Кстати! А ты знал, что у тебя подвал есть?'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550919
    m_Localized: Да, знаю. И что?
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550920
    m_Localized: Нет у меня никакого подвала!
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550921
    m_Localized: 'neighbour: Как знаешь...'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550922
    m_Localized: Потратить энергию
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550923
    m_Localized: Дать по ебалу
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550924
    m_Localized: Отхватить по ебалу
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550925
    m_Localized: 'neighbour: Что это? Не надо! НЕЕЕТ!'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550926
    m_Localized: 'neighbour: (((('
    m_Metadata:
      m_Items: []
  - m_Id: 34484807840550927
    m_Localized: 'neighbour: Фух, ну хоть у тебя их нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807865716736
    m_Localized: 'Sexy: И я хочу гриб! Отдай гриб!'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807865716737
    m_Localized: Отдать 1 гриб (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 34484807865716738
    m_Localized: 'Sexy: И?...'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807865716739
    m_Localized: 'Sexy: Спасибочки!'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807865716740
    m_Localized: 'Sexy: Я не буду спать с теми, у кого нет гриба!'
    m_Metadata:
      m_Items: []
  - m_Id: 34484807865716741
    m_Localized: Пошла нахуй!
    m_Metadata:
      m_Items: []
  - m_Id: 34484807865716742
    m_Localized: 'Sexy: Сам пошел!'
    m_Metadata:
      m_Items: []
  - m_Id: 35795898851905536
    m_Localized: 'neighbour: А. Еще. Держи список. Каждый день вот так делай, будешь здоровый как бык!'
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134922
    m_Localized: Ну. Кто грустит тот трансвестит. Так что давай. Бывай там!
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134921
    m_Localized: Грустно...
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134920
    m_Localized: Вот такие вот дела...
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134919
    m_Localized: Нет. У нас нет здесь Макдональдса
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134918
    m_Localized: Можно большой бигмак и колу?
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134917
    m_Localized: Да, прям умер
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134916
    m_Localized: Чё прям умер?
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134915
    m_Localized: Вопросы есть?
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134914
    m_Localized: Помянем тебя
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134913
    m_Localized: Шо тут сказть... Умер ты
    m_Metadata:
      m_Items: []
  - m_Id: 39910175716134912
    m_Localized: Ну шо...
    m_Metadata:
      m_Items: []
  - m_Id: 40831784920535040
    m_Localized: Кстати. Хочешь умереть?
    m_Metadata:
      m_Items: []
  - m_Id: 40831784920535041
    m_Localized: Да, давай!
    m_Metadata:
      m_Items: []
  - m_Id: 40831784920535042
    m_Localized: Ну, ок. Но пока смерти нет, отправься в подвал
    m_Metadata:
      m_Items: []
  - m_Id: 40831784920535043
    m_Localized: Не, я лучше тут останусь
    m_Metadata:
      m_Items: []
  - m_Id: 40831784920535044
    m_Localized: Как хочешь...
    m_Metadata:
      m_Items: []
  - m_Id: 40857983029858304
    m_Localized: Мяу
    m_Metadata:
      m_Items: []
  - m_Id: 40857983067607040
    m_Localized: '[Погладить]'
    m_Metadata:
      m_Items: []
  - m_Id: 40857983067607041
    m_Localized: Мрр...
    m_Metadata:
      m_Items: []
  - m_Id: 40857983067607042
    m_Localized: '[Покормить (x{0})]'
    m_Metadata:
      m_Items: []
  - m_Id: 40857983067607043
    m_Localized: Мрр?
    m_Metadata:
      m_Items: []
  - m_Id: 40858672195948544
    m_Localized: Мрр!
    m_Metadata:
      m_Items: []
  - m_Id: 40858672195948545
    m_Localized: Мрр((...
    m_Metadata:
      m_Items: []
  - m_Id: 40864825797758976
    m_Localized: '[Взять на ручки]'
    m_Metadata:
      m_Items: []
  - m_Id: 40864825797758977
    m_Localized: Мрр!
    m_Metadata:
      m_Items: []
  - m_Id: 40864918420574208
    m_Localized: Мяу
    m_Metadata:
      m_Items: []
  - m_Id: 40864918420574209
    m_Localized: Погладить
    m_Metadata:
      m_Items: []
  - m_Id: 40864918420574210
    m_Localized: Мрр...
    m_Metadata:
      m_Items: []
  - m_Id: 40864918420574211
    m_Localized: Покормить (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 40864918420574212
    m_Localized: Мрр?
    m_Metadata:
      m_Items: []
  - m_Id: 40864918420574213
    m_Localized: Мрр!
    m_Metadata:
      m_Items: []
  - m_Id: 40864918420574214
    m_Localized: Мрр((...
    m_Metadata:
      m_Items: []
  - m_Id: 40864918420574215
    m_Localized: Взять на ручки
    m_Metadata:
      m_Items: []
  - m_Id: 40864918420574216
    m_Localized: Мрр!
    m_Metadata:
      m_Items: []
  - m_Id: 49255020599431168
    m_Localized: Привет, это подвальный!
    m_Metadata:
      m_Items: []
  - m_Id: 49255020599431169
    m_Localized: Привет
    m_Metadata:
      m_Items: []
  - m_Id: 49255020599431170
    m_Localized: Как ты там?
    m_Metadata:
      m_Items: []
  - m_Id: 51777261756473344
    m_Localized: 'neighbour: Кстати. Вот мой номер: {0}. Ты это... Звони если что!'
    m_Metadata:
      m_Items: []
  - m_Id: 52078156445372416
    m_Localized: Здарова! Пустишь меня?
    m_Metadata:
      m_Items: []
  - m_Id: 52078156462149632
    m_Localized: Нет!
    m_Metadata:
      m_Items: []
  - m_Id: 52078156462149633
    m_Localized: Тогда мы с друзьями всю ночь под окнами дрифтить будем!
    m_Metadata:
      m_Items: []
  - m_Id: 52078156462149634
    m_Localized: Конечно!
    m_Metadata:
      m_Items: []
  - m_Id: 52078156462149635
    m_Localized: Спасибо!
    m_Metadata:
      m_Items: []
  - m_Id: 52079276500701184
    m_Localized: Реально дрифтят...
    m_Metadata:
      m_Items: []
  - m_Id: 52079276500701185
    m_Localized: Реально дрифтят...
    m_Metadata:
      m_Items: []
  - m_Id: 52079276500701186
    m_Localized: Реально дрифтят...
    m_Metadata:
      m_Items: []
  - m_Id: 52079367613566976
    m_Localized: Реально дрифтят...
    m_Metadata:
      m_Items: []
  - m_Id: 52079367613566977
    m_Localized: Реально дрифтят...
    m_Metadata:
      m_Items: []
  - m_Id: 52079367613566978
    m_Localized: Реально дрифтят...
    m_Metadata:
      m_Items: []
  - m_Id: 53199298832879616
    m_Localized: 'Doch: Можно зайти?'
    m_Metadata:
      m_Items: []
  - m_Id: 53199298862239744
    m_Localized: Да, входи, конечно!
    m_Metadata:
      m_Items: []
  - m_Id: 53199298862239745
    m_Localized: 'Doch: Спасибо!'
    m_Metadata:
      m_Items: []
  - m_Id: 53199298862239746
    m_Localized: Иди отсюда!
    m_Metadata:
      m_Items: []
  - m_Id: 53199298862239747
    m_Localized: 'Doch: (((('
    m_Metadata:
      m_Items: []
  - m_Id: 53199298862239748
    m_Localized: 'Doch: Приятно будет жить с вами под одной крышей!'
    m_Metadata:
      m_Items: []
  - m_Id: 53199298862239749
    m_Localized: 'Doch: Фу. У вас дома есть {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 53199298862239750
    m_Localized: 'Doch: Фу. У вас дома есть {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 53199298862239751
    m_Localized: 'Doch: Я не собираюсь тут жить!'
    m_Metadata:
