%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_es
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 2e47acfd0901bcf4eba15f47b223778b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Eh. Cof... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: ¿Me dejarías entrar, colega?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: ¿Quién eres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: ¿Qué te ha pasado?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: Soy... cof... un bombero.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: El sol me pilló mientras apagábamos incendios forestales hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: El humo denso impidió que nos quemáramos vivos, pero... cof... aún así, fue horrible.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: Los árboles... cof... cof... ardieron como cerillas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: Nunca he visto nada igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: Restos de animales chamuscados por todo el bosque.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: ¿Por qué no te encuentras en el hospital?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: ¿Qué vas a hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Me pilló el sol de la tarde... cof... cof... mientras apagaba incendios forestales.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: Soy el único que queda de mi escuadrón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Los demás, ellos... cof... El jefe simplemente no les dejaba marcharse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Ahora estarán estar de servicio por el resto de sus días.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: ¿Por qué no te encuentras en el hospital?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: ¿Qué vas a hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: ¿Hospital, dices? Olvídate, amigo. Ya no existen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: Cuando llegaron los Visitantes, ya no tenía sentido tener hospitales.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: Es difícil recibir tratamiento si no puedes fiarte de quien te trata.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: Nadie va... cof... a ayudarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Estaría mejor apagando fuegos y muriendo con mis amigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: En cualquier caso, no me queda mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: Me gustaría seguir luchando contra el fuego. Habría preferido morir allí, con los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Pero fueron muy claros cof... cof... al decirme que ya no puedo seguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Ya no puedo volver a casa. El transporte público no funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: Ahora tengo que depender de la buena voluntad de la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Gracias, tío. Cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: No creo que te vaya a molestar por mucho tiempo. Cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: Al menos no tendré que morir en el suelo húmedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Mierda, tío. Cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: No quiero morir solo, en la tierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: Espero que... cof... los incendios no se propaguen a las ciudades.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: ¡Eeeey, qué pasa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: ¡Madre mía, cuánto tiempo! ¿Qué tal la vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: ¿Acaso te conozco?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: ¿Quién eres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Venga ya... ¿No te acuerdas de mí?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: Solíamos...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Un momento, tu voz es distinta...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: ¿Hace cuánto vives aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Esta casa siempre ha sido de mi familia
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Creo que te has equivocado de dirección
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Ah, tú no eres...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Tú no eres mi colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: ¿Cuánto tiempo llevas viviendo aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Esta casa siempre ha sido de mi familia
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Creo que te has equivocado de dirección
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: ¡Qué va, hombre!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: ¡Yo jamás he cometido ni un solo error toda mi vida! Mi memoria es infalible. Como la de una elefante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: Mi colega fijo que vive... bueno, vivía aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Oye, he venido desde lejos. ¿Podrías dejarme entrar, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: ¡De ninguna manera! No puedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: No...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: ¡Joder...!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Supongo que sí me he equivocado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Oye, pero he venido desde lejos. ¿Al menos podrías dejarme entrar un rato, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: ¡Síii! ¡Eso es lo que digo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Se ve que tu sitio es espacioso, ¿nos echamos unas carreras en casa? Tres... Dos... Uno... ¡ARRANCA!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: ¿Largarme? ¿Qué cojones?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: ¡¿Se supone que me tengo que largar así sin más?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Ohhhh, me voy rodando. ¡Chalado! ¡Que te den!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: ¡Basta ya! Deja de comportarte así y estate quieta de una vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Hola. Por favor, ayúdeme.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: ¿Qué ha pasado?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: ¿Qué quieres de mí?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: Estoy hecha polvo. Solo quiero un lugar para dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: Tenía cinco críos. Esta es la única que me queda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: Mi marido se esfumó. No sé si la palmó, si nos dejó o qué, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Ahora solo querría tumbarme y dormir durante unos días para descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: ¿A dónde fueron tus otros hijos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: ¿Acaso tus hijos han muerto?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Solo quiero que me permita descansar. Estoy terriblemente cansada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: Antes tenía cinco hijos. Esta es la última que me queda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: No sé dónde buscarlos. Solo quiero dormir bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: ¿A dónde fueron tus otros hijos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: ¿Acaso tus hijos han muerto?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: No lo sé. Quizá su padre se los llevó. Quiero ir a su casa, pero ya no doy más de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Sí, discutíamos mucho, pero eso lo normal si vives con un gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Olvídelo. Oiga, lo importante ahora es encontrar a mis niños.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: No, no diga eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: Es toda una tarea atender a una tropa de niños revoltosos, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: No, no les ha pasado nada. Seguramente estarán en casa de mi madre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Siempre se escapan cuando se hartan de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: O cuando viene su padre a pedirme pasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: ¿Me deja entrar? Solo para echar una cabezadita y luego ir a buscar a mis hijos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Por fin. Un respiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Venga, espabila. Búscate un sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: Nos iremos mañana. Se lo prometo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: Vale. Intentaré llegar a casa de mi madre, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Quizá no lo consiga...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: No, tengo que lograrlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Hola, vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Estoy de mala leche, así que le pido disculpas de antemano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: Con tanto capullo suelto... Espero que usted no sea uno de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: ¿A quiénes te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: No serás una de esas... cosas... ¿verdad?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: Pues de todo el mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: De los gilipollas que se frenaban por la fe, o lo que sea, cuando en realidad solo se morían de ganas de matarse los unos a los otros.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: Y cuando su Dios murió, perdieron la humanidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Ahora no son más que jodidos animales.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Como si no tuviéramos bastante con esta mierda de los Visitantes... También tenemos que lidiar con eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: ¿Por qué estás tan alterado?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: ¿En qué te diferencias tú de ellos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Buena pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: Ya se habrá dado cuenta de que hay dos... bandos de gente, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: Uno tiene jodidos sádicos. Peores que cualquier Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: Hacen lo que les sale de los huevos: encañonan a uno, disparan, ¡y a dormir con los peces!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: El otro tipo son solo los débiles. Puede usted pisotearlos y le darán las gracias por no matarles.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: Y ambos me tocan los cojones.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: ¿Por qué estás tan alterado?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: ¿En qué te diferencias tú de ellos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: No se lo tome a pecho. Es solo que...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Después de la mierda del sol y la llegada de los Visitantes, parece que la humanidad palmó junto con Dios.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: Y estoy cabreado... Yo solo quería hacer cosas normales, ¿sabe?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Antes escribía canciones. Ahora a nadie le importa eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Solo intento no formar parte de ninguno de esos jodidos bandos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: Quiero creer que soy distinto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: ¿Sabe? Me acojona la sola idea de convertirme en un desquiciado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: O en una víctima. Ambas cosas son una puta mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Aunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: Las víctimas son peores.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Se limitan a quedarse sentadas esperando a que les partan los dientes o algo peor'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Entendería mi ira si hubiese visto lo que yo he visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: No se preocupe, no he venido a incordiar a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: Ni le daré una paliza a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: Dirijo mi ira contra mí mismo para que nadie más sufra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Joder, usted está tan jodido como todos los demás cobardes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Venga, quédese ahí sentado y aguante mientras le destrozan la cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: ¡Joder!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Percibo que la energía aquí estancada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: Algo muy chungo pasa en esta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: El Sol y Leo están en la Quinta Casa. Ya lo pillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: Eres una persona bastante decidida, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: ¿Eh?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: No quiero nada de ti
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Veo que eres de actuar mucho y de hablar poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Típico Leo, ¿a que sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: Y has acumulado aquí una barbaridad de energía desagradable y oscura.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: Todavía no pillo cómo ni por qué..'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Percibo tu espacio como si estuviese muy descuidado. Supongo que debería empezar con afirmaciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Gracias por meterme más mierda en la cabeza, no es como si ya estuviera lo bastante alterado
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: Vale, ¿y...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: No trato de fastidiarte, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: Puedo ayudarte a entender la relación causa y efecto que provoca el sufrimiento tras estas paredes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Como un sesenta y nueve kármico; dos peces dando vueltas unos a otros.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Tú me rascas la espalda y yo te la rasco a ti. ¿Lo pillas?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Gracias por meterme más mierda en la cabeza, no es como si ya estuviera lo bastante alterado
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: Vale, ¿y...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: Entiendo que esto te agobia porque eres Capricornio ascendente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: Estás lidiando con varias constelaciones dentro de ti a la vez. Eres una persona compleja.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: Podemos usar afirmaciones para alcanzar las profundidades de tu cosmos. Lo pillas, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Entonces todo encajará.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: Veo que han habido muchos celadores en tus encarnaciones previas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Déjales su espacio. No haces más que repetir las vivencias de tus vidas anteriores.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Te hace falta perdonarles y aceptar sus historias en tu interior.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Entonces podrás romper las cadenas del eterno ciclo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: ¿Lo pillas?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Estupendo. Tienes una situación muy favorable aquí, sinceramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: Hay una poderosa energía positiva recorriendo tu hogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: No te interesa trabajar en ti mismo. ¿Es eso lo que dices?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: ¿No te interesa convertirte en una mejor versión de ti mismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Una tragedia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Te haré unas afirmaciones para que te dé una diarrea explosiva para recibas tu merecido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Buenas noches.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: Soy de la AFAE. Estamos dando una vuelta por su vecindario.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: ¿Se encuentra solo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: ¿Por qué debería fiarme de usted?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: No, claro que no.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: Mi brigada se ha dividido en pequeños grupos para cubrir más sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: Esta charla no le quitará mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: ¿A qué viene ese equipo de protección? ¿También lo necesitamos nosotros?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: ¿Cómo vais a ayudarnos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: Puedo mostrarle mis credenciales, si eso le ayudará a calmarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: Y de todas formas, los Visitantes casi nunca se agrupan. Puede que nunca lo hagan.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: ¿A qué viene ese equipo de protección? ¿También lo necesitamos nosotros?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: ¿Cómo vais a ayudarnos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: No. Pero puede comprarlo si lo ve necesario.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: Estamos estudiando el efecto del Sol en el medio ambiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: Como solemos estar bajo el Sol, es importante que andemos con cuidado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: ¿Y luego qué?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: ¿Tenéis un plan de acción?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: Nuestra primera tarea es recopilar datos para enviar a los jefes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Luego ellos desarrollarán un procedimiento de respuesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: Ahora mismo, solo necesitas mantener la calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: ¿Y luego qué?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: ¿Tenéis un plan de acción?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Me llevaré a una persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: Le haremos unas pruebas para asegurarnos que esté bien y de que es seguro vivir en esta zona.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: Y verificaremos que sean humanos, por supuesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: ¿Debería hacer las maletas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: ¿Debería quedarme esperando a que algo pase?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Por supuesto. No podemos ejecutar un plan sin pruebas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: Vamos a llevarnos a uno de los suyos al laboratorio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: Solo le harán unas cuantas pruebas para asegurarnos de que todo va bien y luego le traeremos de vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: ¿Debería hacer las maletas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: ¿Debería quedarme esperando a que algo pase?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: ¿Esta es su casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: Entonces no. Quédate con los otros residentes. Si tenéis que evacuar, os avisaremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Solo vamos a llevarnos a alguien y nos iremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: Pase buena noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Sí. Una vez que tengamos toda la información, daremos instrucciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: De momento, no se preocupe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Solo vamos a llevarnos a alguien e intentaremos traerle de vuelta lo más pronto posible.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Que le vaya bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: Así que, nos volvemos a encontrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: Recuerdo que las cosas eran distintas la última vez que nos vimos. Pero seguimos con vida...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Mmm... Algo raro está pasando... no sé cómo explicarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Me gustaría empezar nuestra charla... con una adivinación.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: ¿Puedes decirme mi fortuna con este libro? ¿Qué página debo abrir?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Por alguna parte al principio
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Ábrelo por la mitad
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Ábrelo hacia el final
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: "Los difuntos hablarán, pero nadie atenderá sus palabras".'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Madre mía...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: Esto es muy importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Aunque me parece que no es tan inesperado escuchar eso ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: ¿Qué quiere decir?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: ¿De verdad crees eso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: "¿Qué eres tú...?"'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: "¿Yo? Yo soy yo. ¿Y tú? Tú estás en casa."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Mmm... Sí. Una historia verdaderamente trágica.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: ¿Es esto lo que nos aguarda?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: Es bastante posible.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: ¿Qué quiere decir?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: ¿En serio te crees lo que dices?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: "Fue hace tanto tiempo. Quizás fue un sueño. Tal vez tú, yo, y hasta el pez...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ...solo existimos en la memoria de alguien que se fue hace mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Quizás nadie existe realmente, y solo llueve afuera".'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Mmm... Se siente como si todo pudiera esfumarse muy, muy pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: ¿Y tú qué piensas? ¿Vivimos en el sueño de alguien más? ¿O somos la persona que sueña?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: Esa es una frase interesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: ¿Qué quiere decir?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: ¿Realmente crees eso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: Necesito meditarlo. ¿A ti qué te parece?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: En fin, vine aquí para decirle algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Ciertas cosas ocurrirán dentro de poco...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Necesitas estar preparado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Puede que suene extraño, pero debes dejar entrar al gato.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: No puedo explicar cómo, pero estoy seguro de que te será útil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: Pero, por supuesto, puedes hacer lo que quieras con esta información.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: Por ahora, pensaré en el significado de tu adivinación.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: No del todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: Yo lo vería como un consejo. Para que atiendas un asunto pendiente, o para que le prestes atención a algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Ahora que estaba pensando en qué significa eso, un mensaje se manifestó en mi mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Cuando la mirada del gato se cruce con la tuya, asegúrate de dejar que entre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: Todavía no puedo decir por qué. Pero eso debería facilitarte las cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: Por ahora, debería irme a meditar sobre tu selección del libro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Hola, humano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: ¡Qué dichosos somos! Hemos presenciado el castigo de la lujuria humana con nuestros propios ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: La Tierra está siendo limpiada de PECADO. El Sol está cumpliendo con su labor sagrada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: ¡Vamos camino a un mundo nuevo y puro!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: ¡CONTEMPLA LOS JODIDOS RAYOS DE LA BENDICIÓN!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Eh, me estás asustando, tío
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: ¿Sigues confundido, HUMANO?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Venga, te daré un pequeño resumen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: ¡El Sol no nos COCINA vivos sin razón! ¡Nos está expiando de nuestras culpas!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: ¡Nuestra lujuria y codicia han contaminado este mundo y eso HA ENFURECIDO AL SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: ¡NOS ESTÁ DANDO NUESTRO MERECIDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: Esto es una bendición. Ya no habrá pecado y viviremos como debe ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: ¿Entonces... tenemos que morir?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: ¿Y tú qué harás?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: ¿Estás ASUSTADO? ¿Has perdido la cabeza?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Escucha, te daré un pequeño resumen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: ¡El Sol no nos COCINA vivos sin razón! ¡Nos está expiando de nuestras culpas!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: ¡Nuestra lujuria y codicia han contaminado este mundo y eso HA ENFURECIDO AL SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: ¡ESTA ES NUESTRA PENITENCIA!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: Esto es una bendición. ¡El pecado acabará y viviremos con virtud bajo su mirada, convirtiéndonos en ceniza!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: ¿Entonces... tenemos que morir?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: ¿Y tú qué harás?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: ¡Al contrario!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Nuestros pecados se extinguirán. Quizás el mismo Sol lo haga. PERO NOSOTROS VIVIREMOS.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: No habrá más muerte, ni hurto, ni bastardos avaros que no quieran venderme lo que quiero a un precio justo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: ¿Te lo puedes imaginar? ¿Ya entiendes de qué va todo esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: ¿Qué me importa a mí todo esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: ¡VIVIREMOS EXQUISITAMENTE cuando el Sol acabe de salvarnos!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: Los sagrados rayos nos ayudarán a escapar de este tormento, ¿no lo entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: ¡Sí, tú lo entiendes... por eso sigues vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: ¡MUY BIEN, HUMANO! ¡Podemos hablar de esto con mayor profundidad!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Ah, olvidaba preguntarte... ¿tienes cerveza?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: ¿Estabas fingiendo no saber nada del Sol?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: ¡Pues anda a tomar por culo! ¡ME IRÉ A SALVAR A ALGUIEN MÁS!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: ¡Adiós, gilipollas! ¡JÓDETE BIEN JODIDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: ¡Ho-Hola!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Perdona que sea tan tarde... Hoy hacía un calorazo y en la tele han dicho que es mejor no exponerse, por lo del Sol, así que...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Será que, por casualidad... um... ¿tendrás espacio para mí?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: ¿Quién eres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: ¿Cómo has acabado aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Umm, vivía cerca de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: Y el asfalto de por allá se está calentando muchísimo, je. Te lo imaginarás, je, je.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: Soy cajera en una tienda por esos lares. Bueno, en algún momento lo fui. Ya no. '
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: Me, eh... me despidieron. Siempre he tenido mala suerte para currar, la verdad...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: ¿Qué vas a hacer ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: ¿Qué crees que va a pasar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: No es que quisiera venir aquí. El asfalto ya se está fundiendo bajo nuestros pies, pero aún no es tan malo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: Solo que... Te vas a reír, je.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: Unos Visitantes vinieron a mi casa. Je... ¡Imagínate! ¡Me echaron de mi propio hogar!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Así que, ahora estoy buscando un sitio dónde esconderme del Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: ¿Qué vas a hacer ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: ¿Qué crees que va a pasar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Ehhh... Intentar sobrevivir como pueda. Da miedo... con estos Visitantes por todas partes y el Sol quemando como el infierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Me gustaría mucho seguir viva. Je, je. Uhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: ¿No tienes miedo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Dime que todo esto se acabará pronto, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: No lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: ¿Voy a sobrevivir? ¿Quién me va a ayudar? ¿Cuánto tiempo más tendré que buscar ayuda?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: No tengo ni idea de lo que va a suceder. Ni siquiera puedo imaginarlo..'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: ¿Esto no te asusta? A mí me aterra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Gracias. ¡Jaja! ¡Muchas gracias, en serio!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Podré vivir un poco más, gracias a Dios.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Jaja, ehhh... vale. Claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Gracias por escuchar, de todas formas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: Ehhh... vale, está claro que debería irme, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: ¿Adiós? Sí, eh, adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: ¿Me dejas entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Me estaba refugiando en el bar, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Me echaron de ahí sin que les importara un pimiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: ¿Que por qué? ¡Pff! Vamos, que mi genio no lo aguantaba cualquiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Pero no haré daño a nadie, no te preocupes. Es solo que... la vida es una mierda a veces. Ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: ¿Y bien, colega? ¿Me dejas entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: No serás un Visitante, ¿verdad?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: ¿Seguro que no vas a causar problemas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: ¿Me tomas por uno de esos monstruos?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: No. No soy un Visitante. Pero andar preguntando eso directamente a todo el mundo es una puta tontería.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: Supongo que esto no será diferente a como era en el bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: ¿Por qué te echaron de tu refugio anterior?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: ¿Por qué crees que aquí sería diferente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: ¿Tú qué consideras "problemas"?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: Asesinar y pelear no va conmigo. Pero no consentiré que me hagan daño.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Me gusta beber y comer. Me gusta charlar si estoy de buen humor. ¿Eso son "problemas" para ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: ¿Por qué te echaron de tu refugio anterior?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: ¿Por qué crees que aquí sería diferente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: Me da tanta rabia que casi te suelto una grosería, pero mejor me quedo tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: Pues, ya lo he dicho, me echaron a patadas. Sabrá Dios a quién no le caía bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Pero pensándolo bien, capaz y es mejor así.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Allá podrían haberme comido vivo y nadie se habría enterado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: ¿Qué se supone que haga? ¿Esperar a que el Sol me carbonice?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: No, preferiría evitar eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Mientras esté vivo, seguiré buscando a alguien con quien charlar. Si no es aquí, puede que tenga suerte en otro sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: Si me queda algo de suerte puede que consiga a alguien que no sea un completo gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: La confianza en la gente ya no vale mucho estos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Así que agradezco tu confianza. Quizás... Bueno, no puedo prometer nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Mmm. Lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Lo entiendo, pero estoy cabreado. Eres tan cobarde como todos los demás por aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Ojalá descanses, tío. Y que te jodan.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: ¿Puedo entrar a descansar un poco?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: ¿De dónde vienes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: ¿Hacia dónde te diriges?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: No lo recuerdo. Realmente no importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Estoy exhausta. Si no descanso un poco, me voy a desmayar frente a tu ventana aquí fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: ¿Tu amigo está enfermo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: ¿Tu amigo necesita ayuda?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Solo... solo quiero desplomarme en algún sitio y no volver a levantarme jamás.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: Da igual dónde acabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: ¿Tu amigo está enfermo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: ¿Tu amigo necesita ayuda?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: Es... mi marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Está muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: No puedo darle un entierro apropiado por el calor. Y ya no tiene sentido dejarlo ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Ya no. Cuando la necesitó, nadie ayudó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: Ahora está muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Podría haber vivido si...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: Si a alguien le hubiese importado una mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: No me quedaré mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: Solo necesito descansar un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: ¡Eyyy!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: ¿Has visto lo que está pasando? Joder, qué locura.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: ¿Qué tal te va, colega?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: ¿Qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: ¿Qué está pasando exactamente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Nada, simplemente soy curioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: Eh, pero, mira, conozco una manera fácil y bien guay para te forres de dinero. ¿Te interesa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Como todo el mundo está perdiendo la cabeza con todo este embrollo del Sol, resulta que se puede hacer dinero sin levantar un dedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: ¡Estos ceporros están cagándose del miedo en vez de pensar en grande!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: ¿Por qué estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: ¿Qué sugieres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Nuevas posibilidades, colega. ¡Abre los ojos!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Todos corren acojonados como gallinas en lugar hacer las cosas de forma pura y de corazón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: ¡Les hace falta algo de felicidad, eso es lo que digo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: ¿Por qué estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: ¿Qué sugieres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: ¡Eres directo! ¡Eso me mola! ¡Claro que mola!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Todos van a creer que traes algo entre manos, trayendo a tanta gente. Algo grande.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: Así que esta es mi idea: ¡Hagamos la fiesta más grande de todos los tiempos para celebrar el fin de todas las fiestas! ¡Es el Fin del Mundopalooza, colega!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: ¡Morir no es parte del plan, colega!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Hay que encontrar pasta siempre que se pueda. ¡Que se joda el Sol!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: ¡Mentalidad de tiburón! ¿Me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: ¡Venga, tío! ¡De eso estoy hablando!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Por fin, alguien casi tan listo como yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: Ya veo... Eres un gilipollas. No me di cuenta al principio. Mi error.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: Iré a ver si tu vecino esta en el mismo nivel intelectual que yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Nos vemos en el infierno, cabronazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Eh, vecino. Cuánto tiempo sin verte ¿Qué tal la vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: Igual que siempre
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Bien
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Eh, mira, lo diré sin más: he venido por algo importante y es que estoy un poco preocupado por ti, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Parece que algo terrible se avecina.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: Me ha llamado mi prima. Las noticias de allá dicen que está pasando algo raro con el Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: Y que hay gente emergiendo del subsuelo, a los que llaman "Visitantes" por alguna razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: Da mal rollo, ¿a que sí? Espero que no sea verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: ¿Qué pasa con el sol?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: ¿Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Eh, mira, lo diré sin más: he venido por algo importante y es que estoy un poco preocupado por ti, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Me parece que algo malo se avecina.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: Me ha llamado mi prima. Las noticias de allá dicen que está pasando algo raro con el Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: Y que hay gente emergiendo del subsuelo, a los que llaman "Visitantes" por alguna razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: Da mal rollo, ¿a que sí? Espero que no sea verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: ¿Qué pasa con el sol?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: ¿Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Va a explotar, o como que algo va explotar en él... No estoy muy seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: Lo único que sé es que algo no va bien con él.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: Este verano ha sido el más caluroso hasta ahora, ¿verdad que sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: Creo que tenemos que prepararnos para lo peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: Mi prima dijo que quedarse solo en casa es peligroso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: Así que vine para asegurarme de que no te lastimen o algo peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: Vale
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: Puedo cuidarme solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: ¿Cómo se encuentran tu esposa e hija?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Sí. Así están llamando a las personas que vienen del subsuelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: Solo Dios sabe por qué los llaman así.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: ¿Será porque están visitando la Tierra? O al menos están llegando a la superficie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: O porque están intentando meterse en las casas de la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: Mi prima dijo que quedarse solo en casa es peligroso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: Así que vine para asegurarme de que no te lastimen o algo peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: Vale
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: Puedo cuidarme solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: ¿Cómo se encuentran tu esposa e hija?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: Estupendo. Seguiremos conversando en la mañana, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: Te estaré esperando en la cocina cuando despiertes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: Nos vemos mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: Lo sé. Pero no estoy seguro de que entiendas lo peligroso que es estar solo ahora mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: ¿Por qué no me quedo contigo esta noche? Por si las moscas. Me daría mucha tranquilidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: No te preocupes por mi familia. Un amigo mío se ha estado quedando con nosotros. Él las está cuidando mientras yo estoy aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: Estupendo. Seguiremos conversando en la mañana, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: Te estaré esperando en la cocina cuando despiertes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: Te veo en la mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: No te preocupes por mi familia. Un amigo mío se ha estado quedando con nosotros. Él las está cuidando mientras yo estoy aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: Estupendo. Seguiremos conversando en la mañana, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: Te estaré esperando en la cocina cuando despiertes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: Te veo en la mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: ¡Holis!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: ¿Mi papi está por aquí? ¿Puedes ir a buscarle?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: Yo antes estaba bien, sabes, pero ahora tengo miedo. Hay mucha gente rara caminando por aquí y es de noche...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: ¿Cómo se llama tu padre?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Dime algo sobre tu padre
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: ¿Se te ha olvidado su nombre? ¡Venga, ya! Que solo estás comprobando si soy una Visitante o no.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: ¡Qué listo eres! Ahora yo también voy a preguntarle cosas a la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: ¿Cómo llegaste aquí sana y salva?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: ¿Le tienes miedo a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Mmm, sé un montón de cosas sobre él. Es mi papi, al fin y al cabo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: Antes de salir, le gusta beber un poquito de cerveza, ¡ji, ji!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: Cuando tiene que salir, me deja un almuerzo y una cena rica. ¡Y zumo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: Hoy probé la cerveza que bebe. ¡Y puaj! ¡Qué asco!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: ¿Por qué alguien bebería eso habiendo zumo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: ¡A-ay, por favor, no le cuentes que hice eso!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: ¿Cómo llegaste aquí sana y salva?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: ¿Le tienes miedo a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: Siento como si ahora todo estuviera patas arriba.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: La gente se queda en casa a mimir durante el día y luego sale a hacer cosas por la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: La oscuridad todavía me da miedo, pero tal vez no hay nada que temer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: ¿O sí...?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: Vale, voy a por tu padre. ¡Que te vaya bien!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: ¡Que tengas buen día!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: No... no lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: Todo el mundo les tiene miedo, así que yo también debería. Nunca he visto a ninguno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: ¿Pero dan miedo? ¿Pegan fuerte?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: Porque si son así, tal vez mi compañero del colegio sea uno. Me pega todo el tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Mi papi me dijo que tuviera mucho cuidado. ¡Así que soy súuuuper cuidadosa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: Vine de puntillas súuuuper calladita. Nadie me vio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: Vale, voy a por tu padre. ¡Que te vaya bien!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: ¡Que tengas un buen día!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: ¡Gracias, tú también!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: Quiero irme a casa... Aquí fuera da miedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: Vamos a jugar a un juego que mi papá se inventó para mí. ¡Tienes que tirar dados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: Y después te pones a mover cosas como alguna silla o el sofá.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: Entonces tienes que juntarlo todo frente a la puerta para ganar, haciendo una montaña. La próxima te muestro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: ¡Chau!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: H-hola...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: D-déjame entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: ¿Te está dando un ataque de nervios?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: ¿Qué ha pasado?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: Snif... N-no sé q-qué ha-hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: La ge-ge-gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: E-eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: M-ma-mataron a m-mi pa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: A m-m-m... m-mi...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: Pa-pi'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: ¿Quiénes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: ¿Por qué harían eso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: E-eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: M-m-mi p-pa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: E-ellos m-ma-ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: Ma-mataron a m-mi papi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: ¿Quiénes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: ¿Por qué harían eso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: Los V-Vi-Visitantes vinieron a ca-casa. Estaban se-sentados con nosotros...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Papá e-estaba ha-hablando con ellos so-sobre algo. Y e-entonces lo mataron.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: Él... snif... Nuestra... snif...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: Nuestra ca-casa está en lla-llamaaas...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: N-no lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: Solo e-estaban se-sentados con papá en la co-cocina.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: Y e-entonces h-hi-hicieron algo y... snif... l-luego prendieron fu-fuego a la c-casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: Cuando e-escapé los escuché riéndose...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: ¿Me v-vas a a-ayudar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: T-te-tengo m-miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: ¡¿Pe-pero a dónde v-voy a ir?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: ¡Te-tengo mucho mie-miedo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: ¡Buaaaaaaaah!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: ¡BUAAAAAAAAAAAAAAAAAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: ¡Qué tal!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: ¿Qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: No te voy a dejar entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: Vaya casa más grande.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: Mola'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: No necesito nada
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: Tengo un arma
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: ¿Es tu puerta fiable y robusta?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: Nunca se sabe qué podría pasarle.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: Ya sabes de qué hablo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: No necesito nada
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: Tengo un arma
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: No, no es así.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Pueeees...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: No, no estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Sí, estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: ¡Pero qué delicia!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: La desesperación envalentona al cobarde, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Pero, oye...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: No, no estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Sí, estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: Es tu día de suerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: Puedo oír a alguien murmurando dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: ¿Pero dónde estarán en unos días?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: ¡Jajajajaja!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: Sé que estás solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: Solo quería ver si mentirías o no.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: Hazte a un lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: ¡Ay, querido, hola! ¡Menuda caminata me he pegado hasta aquí, que te lo digo yo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: ¿Me dejas pasar un ratillo a reposar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: ¿Ha venido sin parar justo hasta mi casa específicamente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: ¿Estuvo caminando mucho tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: No, no, no. No fue intencional, no seas tontito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: El destino nos junta por algo. Uno no se cruza con nadie por casualidad, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Si llegué hasta aquí, es porque mis pies me trajeron por una razón y si mis ojos dieron con tu casa es por... alguna otra razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: Justo como tenía que ser... supongo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: No le sigo. ¿Necesita algo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: Así que podría haber seguido andando. ¿Por qué se ha detenido?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: ¡Jo! ¿Pero qué quiere decir "mucho" al fin y al cabo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: Anda, mírate a ti. Estás en casa, pero igual caminas, ¿cuántos pasos has dado ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: ¿Acaso TÚ llevas mucho tiempo caminando? De seguro que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: A mí me vas a venir a contar... He andado más que tú con todos los años que te llevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: Esa es la diferencia entre tu y yo, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: No le sigo. ¿Necesita algo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: Así que podría haber seguido andando. ¿Por qué se ha detenido?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: ¡Jo! Lo que necesita todo el mundo, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: Un techo en el cual refugiarme y, pues, compartir mis relatos con alguien.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: Un sitio para tumbarme y echar una cabezadita.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: Y aire para respirar, supongo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: No necesito nada más. Todos es muy aburrido cuando se está tan solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: Debería marcharse
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: Uf, querido, parece que no me has oído muy bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: Estoy harta de andar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: Aquí podría recobrar el aliento y quizás charlar un poquito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: Eso es suficiente para una viejita como yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: Tú me cuentas algo y yo te cuento algo de vuelta, y así vamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: Así mis viejos huesos probarían descanso al fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: Debería marcharse
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: ¡Gracias, querido!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: Sé que me la pasaré bien contigo. Y así podré ver que es lo que se cuece por aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: ¡Uf! ¡Es que me dan la espalda en todos lados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: Aunque tenga mis alas rotas, sigo abriendo la garganta para cantar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: Pero eventualmente me dan la espalda... Aún cuando dicen que jamás lo harían.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Igual yo no guardo rencores. Ayudo a todos los que vienen a mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: Incluso tú necesitarás ayuda un día, querido mío. ¿Y entonces, a quién acudirás?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Hola. Ah, venga, recuéstate de mí, hermanita.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: ¿Será que... tendrá algo de sitio para nosotras?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: ¿Está enferma tu amiga?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: ¿Estáis las dos enfermas? ¿O solo una de vosotras?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: Ella es mi hermana. Está deprimida.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: No puede andar, ni asearse sola. A veces, incluso levantarse de la cama es un todo desafío para ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: Pero no pasa nada. Ya mejorará. ¿A que sí, hermana?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: Ahora mismo no está con ánimos de hablar, pero a veces encuentra fuerzas y dice algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: ¿Luego qué vais a hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: ¿No te cansa llevarla a cuestas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: Todos sufrimos de depresión en algún grado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: Nosotras ya sabíamos a dónde iban las cosas incluso antes del problema con el sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: ¿Has seguido las noticias? Todo esto ya se veía venir, pero yo no creo que el sol vaya a explotar de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: ¿Luego qué vais a hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: ¿No te cansa llevarla a cuestas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: Tengo que encontrar un sitio donde mi hermana se sienta un poco más a gusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: Y entonces empezaremos una nueva vida las dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: Dicen que estamos acabados...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: No estoy de acuerdo. Las cosas deberían volverse más sencillas a partir de ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: Deberían marcharse
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Por favor, mida un poco sus palabras.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: Sí, puede ser agotador, pero no puedo abandonarla sin más, si eso es lo que insinúas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: Nos fuimos juntas de la casa de nuestros padres. Ahora solo nos tenemos la una a la otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: Deberían marcharse
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: ¡Gracias! Ayúdame a traerla dentro, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: Creo que la muerte de nuestros padres la debilitó aún más, pero ya llevaba así mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Quizás se anime un poco mientras estamos aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Ay. Bueno, hermana, creo que tendremos que probar nuestra suerte en otro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: Anda, ayúdame un poco, hermanita, venga ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: Dios, ¿cuando acabará todo esto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: Nos dieron este papel en el trabajo antes de ir a apagar los fuegos.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: Es una orden para que fueramos a reportarnos a las zonas en cuarentena de la AFAE. ¿Pero por qué iríamos si todo aquel que va termina muerto?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: Toma, igual yo no lo necesito. Tíralo o úsalo como quieras.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: Tengo un, cof...cof... trozo de papel conmigo. Es algo importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: Estoy dispuesto a dártelo si me dejas entrar y me permites vivir mis últimos días en paz...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Nah, quédatelo
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: ¿Qué narices te pasa? ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: Mira, veo que eres un tío decente. A que este EnerJeka te haría pensarlo dos veces, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: ¡Me he dejado la jodida alma rodando hasta aquí! ¡MENUDO trajín!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: ¡Eh, te regalo un EnerJeka! ¡Gracias por dejarme entrar!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: Joder... Puta mierdaaaaa...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: Bueno, mire, es que... Joder, yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: ¿Qué tal si le doy una EnerJeka? ¿Entonces me dejarías entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: Yo tengo un día más para vivir y tú tienes una bebida fría y refrescante. Todos jodidamente contentos. '
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: Lárgate
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: No se preocupe por mí... Es que... Joder... En fin... Tómela.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: Tome la bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: Estaré mejor calmándome. No bebiéndome esta puta mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: Ya veo. Tienes a {0} aquí. Es obvio: todos susurran al hablar y aguantan de todo, solo para que no agobiarle.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: Me jode hasta tenerlos cerca. O es esta puta mierda, o yo. No hay otra manera.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: No soporto vivir con canallas que se aguantan todo así.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: Yo me encargo. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: Entonces, mejor lárgate
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: Tienes la paciencia de un jodido santo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: Más le vale que ser de los que dicen algo si las cosas se salen de control.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: Trataré de... Bueno, ya sabe, estarme quieto.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Estupendo. ¿No es jodidamente fantástico? Una puta maravilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: "Anger: \nSupongo que es mejor juntarse capullos que ya conoces, ¿eh?"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: Mira, me importas una puta mierda, lameculos. ¡PÚDRETE EN EL PUTO INFIERNO!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: He aquí una recompensa generosa del mismísimo Sagrado Sol EN PERSONA. Se lo ha ganado, HOMBRE. ¡Tome esta EnerJeka!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: ¿Pero qué tan estúpido puedes ser?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: ¡Estás ahuyentando a un HOMBRE JUSTO!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: Por dejarme entrar, recibirás una generosa recompensa del mismísimo SAGRADO SOL. ¡Recapacita y recibe la bendición!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: Lárgate
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: Nadie se imaginaría qué fue lo que ocurrió tras la llegada del último Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: La casa permanecería sin ocupantes durante bastante tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: Tras la aterradora desaparición que sufrirás, todo el mundo evitará tu casa abandonada.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Hola, querido... ¿qué traes ahí, {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: Los sitios donde se oye un estruendo un segundo y al siguiente un cuchicheo entre las sombras, aterran a las viejitas como yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: No ando sola por gusto, ¿sabes? No soporto cuando hay mucho griterío o demasiados rostros.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Que se quede si a ti te cae bien. Yo estaré en el porche hasta que todo se calme. No me gustan las tormentas, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: Estos huesos míos ya no aguantan esto... me agobio.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: Yo me encargo. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: Entonces, mejor lárgate
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: Si a ti te parece bien... Pero si huelo a más tormentas o a falsedades, me iré. Ya estoy muy vieja para estas tonterías.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: ¡Uf! Bueno, igual no siento que pertenezca aquí. Así que... me guardaré mis cuentos y me marcharé.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Mantén los ojos bien abiertos, eso sí. A veces la verdad es silenciosa, pero letal.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: Por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Por favor, déjanos entrar, aunque sea por un solo día. Tenemos algo que te puede interesar...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: Te lo compensaremos...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: Vale, entren
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: Lárguense
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: ¡Gracias de verdad!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Toma, aquí tienes una EnerJeka. Es todo lo que tenemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: ¿Me puedes ayudar a llevar a mi hermana adentro, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: No creo que sea una buena idea. Veo que tienes a {0} aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: Ese tipo de gente hace que el aire se sienta pesado. Como si los pensamientos de los demás fueran más ruidosos que los míos.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: Mi hermana no puede con eso. Va a empezar a... encogerse. Es como si dejara de existir, encorvada en sí misma.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: Yo... yo también me asfixio con eso. No puedo lidiar con ello.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Perdona. Esperaremos hasta que... hasta que las cosas cambien un poco. A lo mejor esto desaparece solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: Yo me encargo. Entren
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: Entonces, mejor lárguense
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Ay, gracias. Con cuidado, sujeta su espalda... así.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: Creo que la muerte de nuestros padres... la destrozó por dentro. Pero está aguantando como puede.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: Llevamos un buen tiempo en la calle. Confiaba en que aquí se sintiera un poco mejor, al menos.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: Vale...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Anda, hermanita, solo aguanta un poco más. Ya encontraremos un sitio donde puedas descansar, lo prometo. Anda, apóyate en mí. Yo te sostengo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: Es que a veces todo es solo... demasiado. Hasta meterse en cualquier sitio. Pero hay que avanzar. Venga... un paso a la vez, tú puedes...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: Bueno... es una lástima.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: Muchas gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: Es que hay {0} aquí. No estoy seguro de que nos llevemos bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: Perdone, señor, pero no puedo entrar todavía.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: ¿Por qué te quedas ahí parada? Venga, nos han invitado.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: ¿Ahora tenemos un trato?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: Vale. ¿Te sirve este {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: Estoy acostumbrada. Ya veo de qué vas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: Es una lástima que los gilipollas tengan toda la suerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: Todavía tengo tiempo. Buscaré otro refugio.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: Ah, bueno.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: Gracias. No me esperaba que lo hicieras, por mucho que quisiera que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: Pero no pienso pienso quedarme en la misma habitación que él.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: Es una larga historia y no voy a soltarte el rollo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: Anda, pero mira nada más, ahí tienes a {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: ¿Con este regalo ya estás me dejas pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: Ah, mira lo que he encontrado: ¡{0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: Mira, deja que te dé... a ver qué tengo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: Vale. Que sepas que es la última vez que haré esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: Tío, eres igualito a los malditos bancos. Joder.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: Vale, pues me voy yendo. Aún tengo tiempo antes de que salga el sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'Guy: Pues nada... Lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: ¡A brindar por el fin de las deudas! ¿Vale? ¡Jajaja!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: ¡Así me gusta!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: Ya he tenido suficiente mala racha. ¿Al menos podemos dejar este sitio libre de líos?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: ¿Ves allí? Es {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: Qué va, tío. Ya tienes a alguien aquí que va a aguar la fiesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: Ya veo. Lo entiendo. Que te vaya bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: ¡Pero valoro mucho tu confianza!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: ¡¿En serio?! ¡Gracias! Guau, no tenías por qué... Podría haberme apañado en otro lado si hacía falta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: Pero no voy a estar a gusto estando bajo el mismo techo que {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: Sé que ya te he robado mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: Y la verdad es que no creo que fuera culpa mía.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: ¡Muchas gracias! Pero... parece que hay alguien con quien tuve problemas en la cafetería.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: Vale, ¿y si te doy algo? ¿Qué te parece si te doy algo como esto: {0}? ¿Ya me dejas pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: Vale, qué más da, es cosa tuya. Me voy entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: ¿De verdad piensas que la gente que critica el físico ajeno merece estar en tu casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: Gracias. De verdad que no quiero volver a aguantar eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: ¿Ves a ese? Hay {0} y es de los que me hacía bullying por mi apariencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: Lo siento, tío, pero no creo que pueda entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: Si te rodeas de gilipollas así, lo más probable es que seas un mierda. ¡Jijí!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: Parece que lo mejor sea que no acabe contigo. Sí...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: ¿En serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: Mejor no meterse en mierrrrdas locaaasss.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: Pinta mal. Pero... ¡qué se le va a hacer! ¡Jijí!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: Muy bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: Yo sé de lo que hablo...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: Ese sí que ha perrrrrdido la cabeeeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: Sé lo que pasó hace un mes. Vaya si lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: Oh... Pero mira lo que tienes aquí, {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: Cuídate, ¿sí? Ojalá sobrevivas a todo este circo de mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: Vale, amigo. Lo pillo. Sin rencores.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: Vaya'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: Sé que es incómodo... tener que echar a alguien así. Pero así es la vida. A veces hay que dejar de ser el chico bueno.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: Sí, {0}, ya sabes. ¿Quizá deberíamos... invitarle a irse?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: Tío, me llevo bien con casi cualquiera, en serio. Pero con la persona de allí va a ser jodido. Me da muy mala espina.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: Qué decepción...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: No me digas que te faltan huevos.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: ¿Pero qué cojones? Pensaba que respetabas a la gente con carácter.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: Con lo fácil que ha resultado, no parece que tuviste que pelear demasiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: Jum. No creí que lo fueras a hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: Si me quieres aquí, más te vale que te quites de en medio a esta chusma.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: ¿Quién es ese que tienes ahí, {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: Vale, será mejor que me vaya.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: Mierda... La AFAE va a encontrarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: Desearía no haber venido nunca...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: Maldición... ¿adónde se supone que vaya ahora? Ya he intentado en todas las otras casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: Te lo ruego, déjame quedarme aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: Así que ahora no tengo adónde ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: Me he estado quedando en un hotel, pero me he quedado sin dinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: No...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: Pero ahora estoy aquí y no puedo pagarme un hotel. Por favor, déjame quedarme contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: Sí, sí, ya pillo. Créeme, si hubiera sabido lo del sol, jamás habría venido.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: ¿De verdad no tienes adónde ir?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: Vaya momento de mierda has elegido para hacer turismo.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: En realidad solo estoy de paso.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: Pero cerraron las fronteras... y ahora estoy atrapado.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: Iba a la capital, tenía un viaje planeado...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: ¿De verdad no tienes adónde ir?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: Vaya momento de mierda has elegido para hacer turismo.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: El aeropuerto está cerrado y tampoco hay trenes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: Hubo un problema y ahora no puedo irme de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: ¿Cómo has llegado hasta aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: ¿Qué ocurre?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: Oye. ¿Puedes ayudarme? No soy de por aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: Vale, pues me largo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: Por aquí quedan más casas, ¿sabes? Ya encontraré a alguien que no me juzgue por mi pinta y que sea una persona decente de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: He tenido una semana demoledora.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: Pues hablemos mañana. Ya hoy estoy muerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: Perfecto.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: La peor parte es oír una noticia y darte cuenta de que todo es mucho peor de lo que pensabas y debes intensificar la alerta...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: Total, la tele no ayuda en nada, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: Ni sé si tienes electricidad, pero si no, pues mejor aún.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: Por aquí el aire refresca de noche. Y nadie está pegado a las noticias las 24/7.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: Voy a saltarme las formalidades e iré al grano.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: Sin duda.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: Y es que, la verdad, prefiero no estar cerca cuando empiece el verdadero infierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: Me parece que el verdadero caos todavía está por empezar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: Mira, esto va a ir a peor cuanto más se alargue.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: Además, tengo la sensación de que las ciudades no serán seguras por mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: Es solo que no me van las formalidades. Es más fácil ir al grano.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: ¿Qué te hace pensar que estoy huyendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: ¿De verdad crees que aquí vas a estar mejor?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: ¿A qué le huyes?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: Mi aspecto no significa nada. No quiero hacer daño a nadie. Y espero que tú no seas alguien prejuicioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: No he hecho nada malo. Y si me estás juzgando, te agradecería que dejaras esa expresión.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: Eh, ¿por qué eres tan borde?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: ¿De verdad crees que aquí vas a estar mejor?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: ¿A qué le huyes?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: Como si no tuviéramos bastante con los locos y los Visitantes, ahora el sol también está intentando jodernos.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: Y no solo en nuestra ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: Es que... he oído que están pasando cosas realmente jodidas por estos lares.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: No, si no quería decir que tu casa parezca abandonada.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: Tienes un aspecto bastante osado.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: ¿Te parece que está deshabitado?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: Vaya, así que hay alguien. ¿Me dejas pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: Eh, ya pensaré en algo. Aún queda hasta que salga el sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: Joder'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: ¿No tengo oportunidad, de verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: ¡No sabes lo mucho que significa este día para mí!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: ¡Así me gusta! ¡Vamos a tomarnos algo para celebrarlo!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: Venga, ¿me dejas pasar o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: Si yo tuviera una casa así, estaría viviendo un sueño, te lo aseguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: Bueno, da igual. El préstamo no tenías que pagarlo tú, ¿a que no? Al fin y al cabo, tienes un buen sitio aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: ¿Qué quieres que te diga? Está claro que no te alegras por mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: Veo que no eres muy hablador.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: Ese tono no me hace mucha gracia, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: Joder, eso ha sonado super sarcástico.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: Veo que no eres muy hablador.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: No te lo tomes a mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: Si te soy honesto, no me apetece discutir esto aquí fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: Mierda, es una buena pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: Entonces, ¿qué vas a hacer con todo el dinero que te has ahorrado?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: Vale, y... ¿qué haces aquí fuera?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: ¡Me siento de puta madre!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: Con todo lo que está pasando, ¡a nadie le preocupan ya los bancos ni los préstamos!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: ¡Ya no le debo a nadie ni un maldito euro!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: ¡PERO AHORA!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: Todo iba cuesta abajo, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: Bueno, estaba hasta el cuello de deudas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: Entonces, ¿qué vas a hacer con todo el dinero que te has ahorrado?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: Vale, y... ¿qué haces aquí fuera?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: Siento que puedo volver a respirar. No tienes ni idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: Colega... No... ¡Hermano! ¡Ya no tengo que preocuparme por pagar la hipoteca!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: ¡Venga, no te pongas así! Es solo que todavía no lo pillas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: ¿Por qué estás tan animado?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: ¿Estás de la olla o qué te pasa, joder?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: ¡Menuda noche, eh! ¿No te parece? ¡Es increíble!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: ¡Hola, hola, hola, qué hay!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: Pues nada. Lo entiendo. Cuídate.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: Es un alivio saber que aún queda gente maja, que no es solo cosa de ficción.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: ¡Gracias de verdad! ¡Nunca lo olvidaré!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: Nunca pensé que la vida adulta sería tan dura... y no tengo otro sitio donde ir...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: Te pagaré el favor. Y puedo ayudarte en lo que necesites, ahora mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: Sé que no tengo mucho que ofrecer... pero, por favor, piénsatelo otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: Entiendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: No quiero gorrones aquí. Vete por donde has venido.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: No me veo como nuestro salvador, la verdad. Pero el bien siempre triunfa al final en todas las historias.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: Si al menos viniera un héroe a acabar con estos males para que todo volviese a ser como antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: La gente se esconde asustadísima, se esconde, deja de fiarse de los demás...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: Todo esto se parece a esos cuentos de crío que me contaban. Esos donde la maldad se extiende por el mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: Pero creo que soy el mismo de siempre. Lo que es seguro es que no siento ganas de hacer daño a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: Quizá tenga alguna de las señales. No lo sé. La verdad es que todo es muy raro últimamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: La verdad es que aún no me queda claro qué son los Visitantes, o en qué se diferencian de nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: No quiero gorrones aquí. Vete por donde has venido.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: Intentaré ser útil hasta que pueda valerme por mí mismo. Y te juro que un día te compensaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: Detesto tener que molestar a nadie. Pero en estas circunstancias, uno hace lo que puede por sobrevivir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: Poco después metió en casa a sus hermanastros. No lo culpo, ni nada. Pero espero que tú también entiendas mi situación.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: Así que, en cuanto empezó todo esto, me echó. Dijo que porque no tenía empleo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: Ya de por sí, mi casero no quería alquilar a un recién graduado sin un sueldo estable.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: Justo como cuando éramos niños...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: En épocas de crisis, la gente solo quiere desconectar por un rato... pasarla bien sin preocupaciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: Parece que les ha ido mejor a los otros graduados que los que encontraron trabajo en discotecas. Tuvieron suerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: Pero con todo lo que ha pasado, la gente no venía y nos echaron a todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: Acabo de terminar la uni, pero como no encontraba trabajo en lo mío, acepté algunos trabajillos en una cafetería.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: ¿Cómo sé que no eres un Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: ¿Qué te ha traído hasta aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: Buenas noches. ¿Existe alguna posibilidad de que tengas sitio para uno más? No necesito gran cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: Vale, pues. Que así sea. Me marcho.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: Gracias... por dejarme pasar. Y por no armar un escándalo con mi aspecto, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: Entonces, ¿me dejas pasar o no?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: Porque sé lo que soy. Y no soy uno de esos, ¿vale?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: Entonces, ¿me dejas pasar o no?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: Lo que tú digas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: ¿Cómo puedes estar tan seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: Eso ya lo veremos.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: Te digo que no soy un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: ¿Cómo que "qué esperaba"? Venga ya. ¿Crees que escogí tener este aspecto?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: ¿Cómo puedes estar tan seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: Eso ya lo veremos.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: Lo entiendo, pero no soy un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: ¿Y qué esperabas?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: La gente vive con una paranoia constante ahora.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: Es una condición congénita. No puedo hacer nada al respecto. Pero la gente cree que soy un Visitante, no tiene ni pies ni cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: ¡Justo eso! A eso me refiero.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: ¿Y qué esperabas?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: La gente vive con una paranoia constante ahora.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: No paran de pensar que soy contagioso... o, peor, que soy un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: Simplemente nací con la piel así. Eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: ¡No! Esa es la cuestión. No tengo nada malo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: ¿Por qué tienes la piel así?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: ¿Debería preocuparme?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: Eh, hola. Espero que mi aspecto no sea tan espantoso como para que me eches.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: Jijí...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: Ya verás adónde te lleva eso... Recuerda mis palabras...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: Eres igual que esos tortur...dores con sus batas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: ¿Que estoy un poquillo pirado o desequilibrado? ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: Así que... ¿tú también piensas que soy un loco-loquillooo?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: Un sitio donde aguantar todo este lío...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: ¡Al fin!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: Además, oí disparos cerca. Pero tú sí que te preocupas por la seguridad. ¿Verdaaad...?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: ¡Ahora quiero... congeniar con gente nueva!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: Uno de ellos tuvo su merec...do, pero ahora soy más listo. Sí, más listo, jijí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: Todo el mundo me tiene manía. Cada. Uno. De. Esos. Capullos... Desde el cole.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: ¿Qué amigos?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: Así queee... ¡Paso de volver para una segunda ronda! Jijí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: Ellos me ayudaron, ¡pero ahora no les importo una mierda!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: Ocurrió una especie de accid...nte. ¡Uy! ¡Mírame! ¡Jijí!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: ¿No tienes amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: ¿Por qué no vas con tu familia?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: Ya te hablaré de ello... luego. Jijí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: Las habitaciones de h...tel son diminutas. Me traen m...los recuerdos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: Tienes una casa lo bastante grande para que quepa todo el mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: Vale, es que... prefiero quedarme aquí. Jijí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: ¿No tienes amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: ¿Por qué no vas con tu familia?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: La AFAE vino, pero luego... desaparecieron.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: No tengo pruebas, no no no... Pero creo que es una de esos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: Me da miedo, jijí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: Hay una chiquilla con un chubasquero amarillo allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: No me gusta. Prefiero buscar otro s...tio.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: ¿Crees que vas a estar más a gusto aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: ¿Qué? ¿Por qué? Solo regresa y ya.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: Pero ahora me da miedo v...lver, ¿puedo quedarme aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: Me estoy quedando en el Hotel Esperanza, pero me apetecía dar una vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: Perdona, es que estoy un poco nerv...so.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: Buenas. Jijí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: Que te vaya bien, ¿eh? Ojalá aguantes en este caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: Vale, tío. Lo entiendo. No pasa nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: Búscame más tarde, ¿sí? Tengo historias muy fuertes. Te van a flipar, ¡ja!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: Hostia, tío, eres mi salvación.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: En fin, no seré una molestia, tío. Te lo contaré todo, solo... Déjame pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: Solo intentaba protegerme y por eso nunca me dijo nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: Es a mi madre a quien persiguen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: No, no van tras mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: Y con el asunto este del maldito sol, todo ha salido mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: Pero ahora... es que... no doy con ninguno. Cada uno tiene sus propios problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: Eran buenos tíos, majos, siempre dispuestos a ayudar, invitar una birra o pasar el rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: A todos los conocí en el teatro. Bebíamos juntos, hacíamos el tonto, nos cubríamos las espaldas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: ¿O sea que te persigue un montón de gente cabreada?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: Vaya amigos que tienes, ¿no?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: Vivía con mi madre y mi abuela, pero nos echaron. Los cobradores de deudas... La situación está fatal...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: Creía que tenía un montón de amigos, ¿sabes? Pensé que estaríamos juntos en esto... Pero aquí me tienes.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: ¿Te importa si me quedo un rato por aquí? Parece que no hay nadie más en casa por aquí, o los habrán echado, o vete a saber.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: ¡Eh, colega!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: ...gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: Menudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: Vaya, era de esperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: ¿No?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: ¿Es esto una prueba?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: Luego hablamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: ¿Sabes? Es un honor estar aquí. Justo cuando todo se está yendo a la mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: ¡Venga!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: En la vida hay que dar la cara. Aquí no se regala nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: La única forma de sobrevivir es peleando.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: Simplemente creo que si nos quedamos quietos, será el fin de nuestra especie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: Vaya. Perdona si te he dado una mala impresión.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: La humanidad ha sobrevivido a cosas peores. ¿Por qué habríamos de tirar la toalla ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: ¿Pero desesperada? Definitivamente no.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: Ah, ¿quieres saber a qué vine? Já. Quién sabe. A lo mejor estoy mal de la cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: ¿Cómo dices?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: Suenas como una psicópata.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: ¿Tú también estás desesperada?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: Sobreviviremos, cueste lo que cueste.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: No podía pasar de este sitio sin más. Creo que tú y yo pensamos igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: Que no dejas que los Visitantes te arrebaten lo único que te pertenece por derecho... tu propia vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: Dicen que no es fácil sobrevivir aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: Suenas como una psicópata.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: ¿Tú también estás desesperada?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: Pero tú no eres así. No caerás sin luchar antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: Los más valientes se pegan un tiro. Los otros solo se pudren, día a día.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: La mayoría ya ha tirado la toalla. Son demasiado débiles para seguir adelante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: No, en serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: Eh... ¿Y qué dicen EXACTAMENTE de mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: ¿Gracias?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: Pero has demostrado que vales. Por eso, te has ganado mi respeto.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: Los que vienen aquí están desesperados... o son gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: Casi todo el mundo se mantiene bien lejos de este sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: He oído hablar de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: Mira, te doy esto... {0}. No es gran cosa, pero espero que te sirva de algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: Muchas gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: Oh... lo siento, es que tienes a {0} aquí. No me fío mucho de gente así...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: Mira, te doy esto... {0}. ¿Te vale para dejarme pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: Es que no quiero cruzarme con una patrulla. O peor aún, con los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: ¡No! Por favor... Déjame pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: Toma, tengo esto, {0}. No es gran cosa, pero espero que te sirva.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: Gracias, ¡gracias!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: No, no quiero ir a parar allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: Pero es que oí que se estaban llevando a los infectados a zonas de cuarentena...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: Vinieron de repente y dijeron que tenían que inspeccionar a todo el mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: La AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: No quiero acabar en una zona de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: Comenzaron a hacer redadas... Y la verdad es que...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: La AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: ¿Qué pasó con tu residencia?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: Vivía en la residencia de la universidad, pero... tuve que marcharme.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: Sí. Por favor, solo... déjame pasar, ¿vale? Si no te importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: ¿Qué le ocurrió a tu residencia?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: No puedo volver a la residencia...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: Sí, necesito un sitio donde quedarme. Ya no tengo a dónde ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: ¿Estás buscando un sitio para quedarte?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: ¿Necesitas algo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: ¡Eh, hola! ¿Me dejas pasar, porfa?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: Buena elección, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: Sí, tienes a {0} dentro, ¿eh? Conozco los de su calaña.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: Eh, colega. Yo vendré del trullo, pero tú tienes la mala junta ahí dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: Adiós, pringao.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: Vaya, pues tú sí que eres divertido.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: Buena elección, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: Venga, ya vale de parlotear. ¿Me dejas quedarme a dormir o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: Sin un duro, mi vieja se fugó con otro pringao y no tengo ni un techo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: Pagas tu condena y a la calle, a tomar por culo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: Claro que me habría quedado. ¿Pero tú crees que alguien me preguntó?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: Venga, ya vale de parlotear. ¿Me dejas quedarme a dormir, colega?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: Aquí, en el quinto pino, sin mocosos merodeando. ¡Un sitio de puta madre!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: Pero luego vi este sitio: limpio, callado, fuera de todo mapa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: Sin un duro, mi vieja se fugó con otro pringao y no tengo ni un techo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: No tengo dónde caerme muerto, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: ¿Por qué no te quedaste en la cárcel?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: ¿Y qué cojones haces en mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: Supongo que me ha tocado volver a la calle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: Y ahora, ¿qué? La puta calle está hecha una mierda. El sol te fulmina como si quisiera freírte los huevos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: Me hubiera quedado más tiempo, pero me echaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: He cumplido un par de condenas, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: ¿Por qué no te quedaste en la cárcel?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: ¿Y qué cojones haces en mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: ¿Yo? Yo sé de lo que hablo. Lo primero que hice al cruzar el portón fue tirar toda esa mierda de ropa. Ahora estoy a gusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: Van vestidos como si estuviera nevando o algo. Vaya panda de idiotas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: ¿No es obvio? Hace un calor de cojones aquí fuera. No entiendo por qué los demás no lo pillan.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: ¿De dónde cojones has salido?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: ¿Por qué vas por ahí solo en calzoncillos?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: ¿Qué me dices, me dejas pasar, colega?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: Si no eres tú, ya me abrirá otro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: Me cago en todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: Aunque sin una guitarra... no es lo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: ¡Vale, a darle caña!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: Sí, ahí hay {0}... No puedo estar en el mismo sitio que ese tipo de gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: Qué va, ni de coña me acercaría a gente así, joder.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: Intentaré quedarme en casa de algún colega. Espero que los pocos que quedan no la hayan palmado...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: Entendido, hermano. Sin rencores.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: ¡O no...! ¡Tú mandas, tío!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: Gracias, tío. Pondré algo de música de vez en cuando, espero que te parezca bien. Si encuentro una guitarra, te toco algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: Y, sinceramente, si fuera un Visitante estaría tirando la puerta o colándome por la ventana. Pero solo estoy... aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: Hasta me jodieron la guitarra, esos hijos de puta. Toda esta mierda está volviendo a la gente unos animales, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: Estuve tocando hasta el alba, pero unos locos nos asaltaron y empezaron a robar mierdas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: Pues, porque no he dormido.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: Dicen que hay un Visitante cerca. Están revisando a todo el mundo. A mí me parece bien, mientras nadie se raye.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: Qué va, tío. Solo un mini ampli y un par de botellas de agua. Te dejo el ampli si sabes tocar algo decente.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: ¿Por qué tienes pinta de no haber dormido en una semana?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: ¿Qué llevas ahí?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: La cosa está muy chunga, ¡es como meter a una estrella a un antro sin seguridad!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: Ah, un aprovechado.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: Deja que pase aquí un par de noches. No me apalancaré. No soy ningún... Eh... ¿Cómo se decía?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: Eh, tío, abre. El sol está que quema como un foco. A este ritmo me quedo ciego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: Puede que intente unirme. Parece interesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: ¡Y luego los echa al fuego!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: Oí hablar de un loco que recluta gente y les lava el cerebro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: Vale, iré a ver qué pasa en otro sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: Qué aburrido. Siempre lo mismo...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: Vale, nos vemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: Me pregunto cuánto ganó con esa chorrada.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: Dicen que hay un tío vendiendo aire. ¡Qué risa!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: No pasa nada, me pasaré por otros sitios.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: ¡En fin, te contaré un mogollón de cosas a cambio!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: Perdona, pensaba que haría gracia.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: Jajaja, ¡no sé ni siquiera quién era ese!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: Lo lían todo. Qué va, mejor no buscarse líos'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: No me mola hablar cerca de gente así. Le dan la vuelta a todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: Hala, tienes a {0} aquí dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: Toma, te regalo esto: {0}. ¿Te mola?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: O... un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: ¿Quieres una EnerJeka? ¡Aunque tengo más cosas aparte de eso!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: Qué pena. Espera, llevo todo tipo de cosas conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: Yo pongo mi parte, que tengo mis historietas. Podemos charlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: Así que me vas a contar qué se cuece por aquí, ¿trato?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: ¡Ah, genial!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: Total, que me estoy cansando de estar aquí plantado. Si me dejas entrar, te cuento lo que he visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: Yo qué sé, no me parece la estrategia más lista.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: Todo el mundo está cagado de miedo. No abren la puerta a nadie o se lían a tiros con todo lo que se mueve.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: He visto un par de sitios curiosos, pero la mayoría es siempre lo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: Ya te lo he dicho. Solo miro cómo sobrevive la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: No me estás escuchando.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: ¿Me dejas entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: Pero oye, tu casa tiene buena pinta.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: Seguiré corriendo hasta encontrar lo que busco... sea lo que sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: Pues nada, echo a correr.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: ¿De qué estás huyendo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: ¿Y luego qué?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: Igual deberíamos compartir truquillos de supervivencia, je.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: Pero eh, ¡yo tampoco la he palmado! Se ve que algo sabemos los dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: A ver, sí, sigues vivo. Y estás hablando conmigo... eso es cierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: Y tú estás atrapado aquí. ¿Te crees que eso te mantendrá a salvo?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: ¿De qué estás huyendo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: ¿Y luego qué?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: Ni de coña.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: Estando solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: La habría palmado.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: Si me hubiera quedado en mi casa, nunca lo habría descubierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: Quién sabe... igual tienes la última esperanza de la humanidad escondida por ahí en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: Cuanto más avance, pues más posibilidades tengo de encontrar una salida a toda esta locura. No lo pillas, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: ¿A qué te refieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: No puedes huir de los problemas
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: ¿No piensas buscar refugio?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: Viajo de noche. Así que sí, estaré a cubierto antes de que el sol me achicharre.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: Tengo para rato, en plan, un MONTÓN. Mejor no preguntes dónde me la escondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: Aquí llevo mi fiel EnerJeka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: No puedes huir de los problemas
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: ¿No piensas buscar refugio?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: Seguiré andando hasta quemarme. O hasta que me coman los Visitantes. Lo que ocurra primero.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: Se acerca una tormenta. Y me pica la curiosidad por ver cómo se lo toma la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: A alguna parte, lejos de aquí. No puedo estarme quieto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: Aquí no vas a encontrar nada para recargarte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: ¿Hacia dónde vas así de alterado?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: Estoy superacelerado ahora mismo. Pero la EnerJeka ya no pega como antes. Me vendría bien una recarga.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: ¡Anda, hola! Hay alguien aquí. ¡Qué bien!'
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (Coger el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (Coger el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (Coger el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (Coger el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Saltar la introducción
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: Si no puede trasladar inmediatamente a un Visitante sospechoso a una zona de cuarentena, emita un formulario de comparecencia obligatoria.'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Parece que el festival igual va a celebrarse...'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: Oh, mi querido amigo... Esto no pinta nada bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: No estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: Estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: Vale...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: ¿Y qué queda que valga la pena? Ahora estás completamente solo. Sin familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: ¿Por qué taaaan... tensssso? Aferrándote a la vida de esa manera.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: Disfruta del tiempo que te queda.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: No volverás a verme. Ya he hecho lo que venía a hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: Hasta aquí he llegado.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: ¿Oídos? ¿Qué coño quieres decir con oídos? ¡Esa no es una puta señal de Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: ¿Oídos? ¿Qué coño quieres decir con oídos? ¡Esa no es una puta señal de Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: Enséñame las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: Hasta luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: Muy bien. Si esa es tu elección... La Muerte se cobrará lo que le corresponde, tarde o temprano.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: He querido encontrar la paz desde hace mucho... Iré contigo
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: Si tantas ganas tienes de morir, hazlo. Yo me quedo aquí
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: Participa en nuestro rito y encuentra la paz. ¿Qué me dices? ¿Te unirías a nosotros en nuestra sagrada procesión hacia la Muerte?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: Como un gesto de agradecimiento, podría ofrecerte la salvación...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: Bueno. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Es duro, ¿no? Para usted. Para nosotros. ¿Cómo podemos inspeccionar un distrito si ya no queda nadie en él?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: ¿Está solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: Esta juventud de hoy...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Ah... quizás solo estoy perdiendo el tiempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Hola, chaval. Dime, ¿acaso olvidaste el pequeño favor que te pedí? ¿No notaste las pistas que venían en la Guía de las Sonrisas?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: Contempla... {0}. Permíteme entrar y recibirás esta generosa recompensa del mismísimo GRAN SOL. ¿Ya has cambiado de parecer?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: ¡Aquí tienes una generosa recompensa del mismísimo GRAN SOL! ¡Te la has ganado, HUMANO!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: Y tú y yo... nos volveremos a ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: Pero yo no moriré. Jamás.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: ¿Abandonar a la gente al borde de la muerte? No está bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: Mira, deberías aprender algunos modales.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Porque tú y yo... somos inmortales.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: Las personas como tú son las que sobrevivirán a esta pesadilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: Hoy en día no queda mucha gente que de verdad escuche.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: Sé exactamente de dónde han salido los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: Y te lo contaré todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: Te juro que en cuanto la AFAE se vaya, me iré a seguir buscando a mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: El gobierno no querría que nadie más se enterase de lo que sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: La AFAE anda tras de mí porque sé ciertas cosas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: Necesito refugio por unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: ¡Espera un momento!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: Sé exactamente de dónde han salido los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: Y te lo contaré todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: Luego me iré y seguiré buscando a mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: Déjame quedarme aquí un par de días, hasta que la AFAE se vaya de la zona.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: Si la tienen, no le harán nada. Me quieren a mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: Tal vez esos bastardos se llevaron a mi hija, tal vez no.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: Mira, me buscan porque sé demasiado sobre ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: Lejos de aquí, básicamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: A algún sitio al que la AFAE no pueda alcanzarnos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: No está aquí. Adiós
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: ¿A dónde quieres ir?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: En cuanto la encuentre, nos iremos de esta ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: No tengo ni idea de dónde está.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: La he estado buscando desde que empezó todo este lío.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: Será mejor que no hables así de mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: No está aquí. Adiós
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: ¿A dónde quieres ir?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: Ni una nota, ni un rastro. Mi hija simplemente se esfumó.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: Cuando desperté, no había nadie en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Luego llegó esa ola de calor anormal y me desmayé...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: Teníamos planeado irnos de la ciudad...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: No he podido encontrarla desde que empezó todo esta mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: Es mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: El burdel está en otra calle
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: No he visto a nadie así por aquí
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: ¿Ha pasado por aquí una chica con un poncho y el pelo morado?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Hola.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: Me he equivocado de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Perdona'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: El olor no es el correcto. La voz tampoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: Me he equivocado de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Perdona'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: El olor no es el correcto. La voz tampoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: ¿Necesitas ayuda para encontrar tu casa?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: ¿Qué estás buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Pero, ¿la gente los necesita...?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: No tengo. Nunca tuve.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: ¿Padres?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: ¿Necesitas ayuda para encontrar tu casa?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: ¿Qué es lo que buscas?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: He oído unos pasos desde aquí fuera. Eso es que alguien está esperando.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: Necesitaba la luz de la cocina, pero aquí... hay un eco diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: Todas las puertas se ven iguales en la oscuridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: ¿Dónde están tus padres?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: ¿Te has perdido?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: Debería estarlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: ¿Aún no se ha dormido?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Cuida de mi gente. Y recuerda, si uno de nosotros muere... tu casa será reducida a cenizas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: Nos vemos luego. Volveré a echarles un vistazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: ¿Acaso crees que tienes una opción?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: Nos vemos luego. Vendré a ver cómo están.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: No necesitan mucho tiempo. Pero aún así, cuida de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: Haré que se vayan. Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: Son un obstáculo para nuestro propósito.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: Me parece bien. Pero primero tienes que deshacerte de tu gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: Que tengas una buena noche...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: Aquí tienes tu pedido: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Coger el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: Vale, coge el pedido, me marcho.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: Estoy harto de toda esta mierda. Solo quiero que se acabe...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: Todo este desastre...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: Esos interminables controles por la mañana con el personal de la AFAE apuntándonos con sus armas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: No paro de ver caras cansadas, sombrías, amargadas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: ¿Recuerdas que dije que ser repartidor me ayudaba a no pensar en las cosas? Parece que eso ya no funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: *Suspira...*'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Coger el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Simplemente coge el pedido y me largo de aquí antes de que me dispares a mí también.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: Ah, vale... ¿Me estás diciendo que está bien que hayan matado a mi amigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: Lo siento
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: Pues, no hay de otra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: Aquí tienes tu pedido: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Coger el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: ¿Sabes qué? Coge ya el pedido y me iré.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Vaya, joder, muchas gracias por el consejo. Eso ha sido de gran ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Coger el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Venga, que tengo que seguir. Coge el pedido y me marcho.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: De repente dirán que el vello púbico es una nueva señal de Visitante y el mundo entero se irá al garete...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: Creía que no podía ser peor. Pero cada día, todo se vuelve más loco.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: Con todos estos Visitantes, las señales y el maldito Sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: ¿Bien? ¿Qué queda de "bien" después de todo este cataclismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: Solo sé un hombre y sobrevivirás. Deja de quejarte como un perdedor
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: No te estreses, estarás bien
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: Aquí tienes tu pedido: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Coger el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: Vale, se supone que debes tomar el pedido. ¿Lo vas a coger?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: Además, ¿de qué sirve estudiar si de todas formas nadie me va a contratar?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Ah, qué más da. Ser repartidor no es tan malo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: Sí, claro. Tú tienes un montón de gente en casa, así es fácil decirlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: Qué pena
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Estar solo no es tan malo
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: Además, mi familia no está por aquí. No soy de aquí, vine a estudiar. Así que estoy solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: Aquí tienes tu pedido: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Coger el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: En fin, perdona, me he desviado. ¿Vas a coger el pedido?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: Y ahora la gente pide, yo qué sé, 20 litros de agua. Joder, ojalá nos dieran un plus por riesgo o aunque sea propinas por arrastrar todo ese peso...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: Pero este maldito sol... Nos han pasado a los turnos de noche por su culpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: Y los repartos pagan bastante bien ahora. El riesgo es enorme, lo mires por donde lo mires.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Con apocalipsis y todo, la comida sigue a la hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: No me esperaba que la gente pasara de abastecerse para el fin del mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: ¿{0}? ¿Con eso basta?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: ¿Qué quieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: ¡Venga ya, por favor! ¿Y si te soborno con algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: ¡Ah! ¡Lo tengo! {0}. Toma, señor propietario, solo déjame pasar aquí la noche hasta la mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Vale, un cuchillo, lo voy a necesitar... vendas, claro... mmm, un termo viejo también, pero vacío... no ayuda mucho...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Ah, oye, no me eches... déjame rebuscar en la bolsa primero.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: La fuerza es lo que manda ahora. O te adaptas, o se vuelve contra ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: Buena decisión.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: Yo me encargo. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: Échala si quieres conservar este lugar para ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: ¿Es {0} la que veo animando el lugar? La reconozco nada más verla, es un lobo con piel de cordero.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: {0}. Toma. Podría venirte bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: Tenemos... ¿cómo se llamaba...?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Mmm... Lo entiendo, no nos conoces. Quizá pienses que te vamos a meter en líos. Pero no somos así. Mi hermana pequeña... lo está pasando realmente mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: Haré que se vaya. Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: Me recuerdan un montón a nuestros... padres... y eso... no es el mejor ambiente para su estado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: Estoy preocupada... mi hermana solo lo pasará mal mientras estén aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: Veo que ya tienes a esa gente en tu casa, a {0} y a {1}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: Deberían marcharse
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: Haré que se vaya. Entren
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: No creo que vayamos a llevarnos bien.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: Verás, antes de mi marido, yo... este hombre me recuerda un montón a alguien de mi pasado.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: Me va a costar mucho vivir con este hombre en la misma casa...
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: Hay {0} aquí...
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: Deberían marcharse
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: Haré que se vaya. Entren
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: Y eso es lo último que necesita ahora mismo. Necesita paz y... que la cuiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: Siento que mi hermana pequeña se ahoga en sus palabras llenas de juicios.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: Me temo que hay {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Je, ¡ahí lo tienes! Te lo dije, si no, solo habría traído problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: Haré que se vaya. Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: ¡Echémosle fuera, que yo me voy a sentar allí!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Qué va, con él no vas a lograr nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: Vaya, vaya... mira quién está sentado aquí, ¿eh? {0}. ¡Menuda sorpresa!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Gracias... No me quedaré mucho tiempo... Solo necesito un momento para recuperar el aliento...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: Haré que se vaya. Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: No me quedaré con alguien como él en la misma casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: No'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: ¿Tienes a {0} aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Gracias por ayudarme. No como...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: ¿Te interesa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: Me gustaría ayudarte. ¿Hay algo que te interese?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: Entonces, ¿qué me dices? ¿Nos vas a ayudar?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: ¿{0}? Estoy dispuesto a dar todo lo que me queda si con eso mi amada puede descansar un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: Tenemos algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: Hablando de eso...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: La quiero muchísimo. Daría todo por ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: Mi mujer no es una persona muy fuerte. Se cansa rápido. Y yo... yo haría cualquier cosa por ella, ¿lo entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Por favor, perdona mi insistencia, pero trata de ponerte en nuestro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: ¿Lo ves? ¡Mis piernas son la prueba viviente! No hay nada aquí, ¿a que no? ¡Ja!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: ¡Seguro que funciona!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: ¿No me dejas entrar? ¡Eso lo arreglamos! Coge {0}, agítalo en la entrada y... ¡zas! Eres invisible.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: ¡Ah! ¡{0}! Es como en los videojuegos, tronco. Tienes que generar afinidad. ¡Ya lo pillo, tío!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: Vale, pues mira esto. Tengo algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: Venga, tío...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: Creo que un poco de {0}. Puedes cogerlo. Necesito al menos un día para coger aire. Pero... es poco probable...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: Yo creo que... llevaba algo encima. Espera, por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: Je, ¿qué te parece? ¿Te sientes mejor? ¿Todo en regla?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Aquí tienes UN PEQUEÑO DETALLE... de mi parte. ¡{0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: Vale, tío. Creo que... ya sé lo que servirá.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: Eh... también tengo chicle. Solo me quedan unos pocos, pero te los puedo dar...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: ¿Quizás quieres algo de mí? ¿Tal vez {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: Yo... es que no sé ni qué hacer...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: Por favor... ¡o me voy a morir aquí fuera!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: Tío, te doy todo lo que tengo. Toma, ¿qué tal {0}? Lo encontré por ahí. No llevo nada más encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Joder, ahora mismo, o me desangro en tu puerta... o me dejas entrar y me ayudas a curarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: ¿Sabes qué? Vete a la mierda. Me voy a hablar con tus vecinos. Adiós, gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: ¿Pero qué coño te pasa? Te lo estoy dando todo masticado, ¿y tú me lo escupes en la cara?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: ¿Vas en serio? ¡Mi marido trabaja para la AFAE!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: Vale, entra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: Piensa qué te sale más a cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: ¿No te da la gana? Con una palabra que le diga a mi marido, los tíos de los trajes amarillos harán mañana un control sorpresa con papeles, perros... Vendrán cada maldita mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: Hagámoslo fácil: te suelto {0} de entrada y me dejas entrar, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Mira, mi olfato es muy fino. Huelo a la gente y a los Visitantes que ni te lo imaginas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: Solo espero poder dormir por fin, al menos aquí.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: He visto a esa persona en mis sueños y, créeme, con eso tuve suficiente.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: No hay sitio para los dos aquí.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 'Gracias, pero... parece que alguien ya ha ocupado mi sitio. Mira, {0}. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: Ni siquiera sé por qué lo sigo llevando.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Supongo que este traje acojona un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: Vale, lo pillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: No pensé que de verdad me dejarías entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: ¿De verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: Si pudieras pedirle a esa persona que se marche, te juro que me estaré callado y no molestaré a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Sabes, he estado metido en este puñetero traje todo el día... solo quiero quitármelo, lavarme toda esta roña y... de quien sea esta sangre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: Oh-oh... veo que ya hay {0} en el cuarto de baño.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: A ver, espera un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: ¿Qué? Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: ¡Ah, gracias, tío!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: Entraría, de verdad... pero, bueno, ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Pues, joder, ya hay {0} aquí adentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: Ehh... supongo que merecía la pena intentarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: Joder, creí que por una vez podría tomarme un respiro.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: Je, ahora sí estamos hablando.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: ¿Por quién? Justo ahí, ¿ves? Es {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: Oh, mira eso. Ese lugarcito tan acogedor ya está ocupado.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: Discutiremos las condiciones del alquiler en detalle más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: Gracias, propietario.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: ¿Los artículos 28, 48 y 7.3 de la Constitución significan algo para ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: ¿Eres consciente de que este individuo es un claro infractor de la ley?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: Mmm... Veo que ya tienes a alguien viviendo aquí; a {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: Sé por qué lo dices, ¿sabes? Pero, joder, qué duro...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: Oye, eh, ven a verme algún día y charlamos un rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: Uf, gracias, colega. ¡En serio me has salvado el pellejo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: En fin, tienes que elegir: él o yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: Este tío me recuerda un poco a una de esas personas que iban tras mi familia y...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: Mira, no lo tomes a mal, pero tienes a {0} en tu casa, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: Conserva el mío, cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: No sé si tú ves la belleza como yo. Pero dime... no te deshaces de los cuerpos, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: Y yo, yo he venido a escuchar el silencio del último día.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: Entraría... pero ya tienes {0} aquí. Ese es el tipo de persona que aún se aferra a la idea de que habrá un mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (Asiente con la cabeza y entra)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: (No parece agradarle la idea de estar con {0}. Lo señala, luego se señala a sí mismo y vuelve a señalar al hombre)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: Pffyyv. Ffffffpt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: Si tengo suerte, estaré por aquí, así que no dudes en pedir ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: Lo entiendo, no es el mejor momento para fiarse de nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: Gracias. Espero poder ayudar a alguien.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: Debería marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: Haré que se vaya. Entre
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: Le iría mejor si buscara a alguien que de verdad pueda ayudarle.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: No puedo ofrecerle el tratamiento que necesita.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: Mmm, veo que tienes aquí a {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: Descansaré mis huesos aquí un ratito y luego me marcharé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: Ay, mi cielo. Ahora bien, ¿podrías traerle a la abuela un taburete?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: ¡Ay, Dios te bendiga, cielo! ¡Le has salvado los huesos a esta anciana! Es una pena que tuvieras que echar a alguien por mí...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: Haré que se vaya. Entre
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: Si tienes semejante compañía, probablemente me sentaré un rato en la entrada para recuperar el aliento y luego seguiré mi camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: Con gente así, no será fácil, mi cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: ¡Ay, alma de cántaro! Parece que hay {0} ahí en la silla.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: ¡BUAAAAAAAAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: Estoy... estoy MUY ASUSTADAAAAAAA...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: Pe-pe-pero... no conozco a na-nadieee máaaaas...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: ¿IRME A DÓNDEEE?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: ¡PAPÁAAAA! ¡PAAAAPIIIII!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: Quiero ver a mi paaaapiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: Pero yo... ¡yo solo quiero sentarme ahí! ¡Quiero, quiero, quiero! Ahí es donde... donde se sentaba mi papi... Él me lo dijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: Hay {0} aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: Yo... no... ¡aquí n-no hay sitio para mí!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: Me da igual. Ya encontraré a otros pardillos. Hay un montón de esos por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: Joder, qué puto cobarde eres. Que te den, supe enseguida que nunca íbamos a congeniar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: ¡Qué puta pasada! Eh, pásate por aquí cuando tengas un rato. Tengo algo que quiero enseñarte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: Patada en el culo y estamos bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: Eh, ya hay {0} aquí. No va a salir nada de pasta de ese tío. Esos tienen el coño seco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: Q-quizá el Sol consiga c-calentarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: Sí... en a-algún lugar por ahí... lejos de todos...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: Entiendo... m-me marcharé entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: Gracias. Créeme, esto es más seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: Es que... m-m-e asusta estar en la misma habitación con más personas. A veces... p-pasa algo desagradable. Siempre me pasa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: G-gracias. Vaya. Este sitio está ocupado. No entraré mientras haya {0} aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: Pues vete a la mierda. Apuesto a que eres otro de esos abstemios raros.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: Bueno, por fin las cosas me salen bien. Venga, vamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: Ese es el tipo de gente a la que echan primero del bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: Hay {0}; que se vaya primero y luego hablamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: Vale, jaja... De acuerdo, me voy. Mmm, el Sol nos va a matar de todas formas. Todos vamos a morir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: Gracias. Me sentaré en silencio. Solo no cierres la puerta, ¿vale? Jaja. Por si las moscas...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: ¿Podrías, em... pedirle que se marche?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: Por favor, ¿puedes examinarlo o...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: N-no puedo quedarme con él. ¿Y si es un Visitante...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: Y-ya hay... {0} allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: Buena decisión. Al menos yo sé lo que hago. Puedo ayudarte si ese... monstruo... aparece otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: Le huelo la sangre en las manos. No sé por qué le dejaste entrar. ¿Te gusta vivir al límite?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: Mm, veo que ya tienes a {0} aquí, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: Me voy a ayudar a otra persona. ¡Tú sigue pudriéndote aquí, cabrón!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: Es PECAMINOSO cerrarle la puerta a la luz... ¡No! ¡A la ILUMINACIÓN!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: ¡Pues que te den por saco!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: Ahora, ¿dónde está tu nevera...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: ¡Ohhh, espléndido, HUMANO! ¡Recibe la bendición del Gran Sol y que sus rayos caigan en tus OJOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: ¡Su sombra... no, él mismo extingue la luz virtuosa con su herejía! ¡Tenemos que echarlo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: ¡Humano! El SOL me exige que no entre mientras haya {0} dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: Una línea ley de energía pura pasa directamente por tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: Estupendo... Sinceramente, tienes aquí un recurso metafísico de lo más inusual.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: Debemos deshacernos de él, o las estrellas se van a alinear para un desastre. Lo ves, ¿a que sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: Jum, veo que allí tienes a... {0}. ¿No te suena de algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: Oh... puedo sentirlo... un aura tan densa y opresiva. Una sombra... ¡Es lo suficientemente fuerte para condenarnos a todos, para envenenar toda la casa!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: Cuídate mucho, ¿vale?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: Y de ahí... la cosa puede ponerse muy oscura, muy deprisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: Si te enfocas demasiado en eso, te va a consumir vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: No te ahogues en tu dolor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: Quizás así... la muerte no sea lo único que tengas en mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: Ojalá te acuerdes de lo que era sentir alegría.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: Te agradecería mucho si pudieras hacerme un poco de espacio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: No quiero echar a nadie, quién sabe, puede que necesiten ese sitio más que yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: Me encantaría entrar, pero parece que {0} ya está ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: Venga, mueve las piernas. Yo también estoy cansado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: Seguiremos buscando, ¿verdad, mi sol?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: Entiendo. Perdón por la molestia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: Qué tímida eres. No pasa nada. Pronto descansarás.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: ¿Por qué te quedas ahí parada? Venga, nos han invitado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: Verás, a mi mujer no le hacen mucha gracia los críos. No esperábamos encontrar a alguien tan joven aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: Mira, no quiero ser quisquilloso, pero no... no podemos quedarnos con {0} aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: ¿Y esa persona quién es?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: ¡Pero que puta HOSTIA!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: Siéntate y traga con todas sus gilipolleces hasta que te ahogues.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: Hostia, eres igual de patético que el resto de esos cobardes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: Lo pago conmigo mismo. Nadie sale lastimado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: Tampoco destruiré el lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: No te preocupes, no me desquitaré con nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: No. No puedo quedarme bajo el mismo maldito techo que esa loca. Perderé los estribos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: Joder, ¿tienes a {0} aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: No... no... Debería poder llegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: Puede que ya sea demasiado tarde...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: Vale. Me voy a ver si consigo llegar a la casa de mi marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: Venga, no te quedes ahí parada. Entra, el señor no esperará por siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: Por fin...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: ¿Quizá podrías... no sé... echar a esa persona para que la nena por fin pueda dormir en paz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: Mm... Tienes a {0} aquí. Mi bebé ya está lo bastante asustada...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: ¿Ves esa bola de pelos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: No te estaba hablando a ti. Me refería a la bola de pelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: Venga, gatito. Busquemos algo que hacer, ¿sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: Mmmm, me dijeron que ese tipo de gente no debía estar aquí. Venga, haz que se largue.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: ¿Tienes a {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: Lo siento...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: Me recuerdan a... esas personas que... que... los niños...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: No puedo estar bajo el mismo techo que alguien así.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: Perdona, pero... ¿es {0} al que tienes aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: Cuídate mucho, tío... y cuida de tu familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: No pasa nada, tío. Lo pillo. Sin malos rollos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: Tíoooooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: ¡A eso me refiero! ¡Claro que sí, que eres una leyenda!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: Qué cortante... ¡Tío, échale a patadas!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: Joder, ese tío va a estropear todo el rollo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: Espera, un momento... ¿Es ese {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: ¡Ooooh, tío, eres la hostia!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: O ESO vendrá a por ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: Por el amor de Dios, no te acerques a los cuerpos calcinados por la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: Me iré, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: Será mejor que encuentre otro sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: Lo siento, no puedo explicarlo. Solo sé que no es cualquier cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: Siento a {0} aquí dentro. Algo le pasa a esa persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: ¿Y a dónde cojones se supone que voy a ir? ¡Estoy jodido, eso es lo que es!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: ¿Disculpa? Estás viendo que no me encuentro bien, ¡y encima soy un ministro!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: Te pagaré... cuando esto termine.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: Muy bien, has tomado la decisión correcta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: Hasta prefiero darte algo si... ya sabes... te encargas de ese asunto...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: Joder, tienes a... {0} aquí dentro. ¡Que se vayan a la mierda! ¡No voy a pelearme por una puta bañera!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: ¡Gracias, tío! ¡Me has salvado la vida!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: A ver, a mí me gusta compartir, pero esto parece una perrera abarrotada, ¿eh? ¿Me echarías una mano, tío?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: ¡Uh-oh, tío! Parece que alguien ya te está calentando ese sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: Sí... seguro que tienes razón. Iré a casa, por si acaso ya han vuelto...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: Pero... a lo mejor debería quedarme contigo por ahora. Me sentiría más seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: ¿Y si mis padres vuelven a casa y no estoy?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: ¡Gracias! Es que... no puedo dejar de preocuparme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: Hubo una vez, en el parque. Un hombre como él me atacó. ¡No he puesto un pie ahí desde entonces!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: Veo que ya tienes a {0} en el sofá. Los hombres así... quiero decir... me dan miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: Que tengas una puta buena noche, gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: Vale. Ve a esconderte detrás de esa puerta y no la abras.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: ¿Qué, tienes miedo de que la AFAE venga a buscarme? ¿Qué cojones?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: Joder, ¿en serio me estás vacilando ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: Espero que tus vecinos no sean unos completos imbéciles...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: ¡Me acabas de salvar la maldita vida, tío!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: Te lo digo yo, los tíos así te venderían en un santiamén.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: Se queda callado, en lo suyo. Hasta que es hora de salvarse el pellejo. Entonces, te traicionará sin pestañar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: No puedo... Escucha, tío, ya me he encontrado con gente así antes. Tienes a uno justo aquí en tu casa; a {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: El Señor recordará esto. Él lo sabe todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: Mi muerte te pesará en el alma, grabe mis palabras.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: ¡Mira nada más! Tienes una oportunidad de salvación en tus manos... y la rechazas. ¡Qué vergüenza!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: Que el Señor se apiade...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: ¡Echa a esos demonios y serás bendecido, hijo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: ¡Ni toda una vida bastaría para limpiar sus pecados! ¡Tendrías cuidarte del diablo teniendo semejante compañía!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: ¿Y quién es ese, si me permite preguntar? ¿Es {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: Solo... solo espero que algún día aprenda a hacerlo. Para poder defenderme y... matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: Esa persona debe significar algo para ti. Siento haberte hecho perder el tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: Uy, no... No quise ponerte en una posición incómoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: ¿Podrías enseñarme cómo lo haces, cómo matas a un Visitante? Q-quiero mirar al miedo a los ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: Y... um... si no es mucha molestia... después de que me hayas examinado...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: Gracias, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: Es que... no puedo vivir con alguien así. Lo he intentado. No f-funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: Uy, no... No es por ser maleducado, pero es que... aquí ya hay {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: ¿Sabes qué? Que te den por culo. Iré a hablar con tus vecinos. Adiós, gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: ¿Cuál es tu puñetero problema? Te lo estoy poniendo en bandeja, ¿y tú pasas de todo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: ¿Lo dices en serio? ¡Mi marido trabaja en la AFAE!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: Esos malditos gorrones...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: ¡Échalo antes de que sea demasiado tarde!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: Ya conozco a los de su clase. Nunca debiste dejarle entrar. ¿Los tíos así? Son problemas, siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: ¿Quién demonios...? ¿Ese es {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: ¡Hasta luego! ¡Dudo que dures mucho!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: ¡Solo una mente verdaderamente cerrada podría darle la espalda a la verdad tan fácilmente!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: Eres... eres...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: ¿Cómo que "debería marcharme"?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: Una vez que hablemos, ¡vas a ver el mundo con otros ojos!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: ¡Me alegro de que hayas tomado la decisión correcta! Créeme, no te arrepentirás.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: Haré que se vaya. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: ¡Haz que se marche, y aceptaré tu invitación con mucho gusto!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: ¡De ninguna manera voy a revelar nada con él delante!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: ¡Ese de ahí... es... {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: Ah, no. De eso nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: Aunque... espera un segundo. ¿Quién es ese?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: ¡Estupendo!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: No debí haber malgastado mi tiempo contigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: Pff... en fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: ¡Qué guay!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: Haré que se vaya. Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: Anda, eso rimó. Mola.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: Pues, si me quedo, entonces haré lo que quiero.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: Ugh, da igual. Ya hay {0} en el sitio más chulo de toda la casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: Que te den por saco...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: Eres igual a mi padre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: Bueno... Ellos no opinan lo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: ¿Piensas que será más sencillo cuando por fin llegue el final?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: No esperaba otra respuesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: Quizá incluso consigamos distraernos con algo... mejor... que la paranoia y la autocompasión sin fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: Vamos a olvidarnos de todos estos horrores del mundo, solo nosotros dos, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: ¿Tal vez podríamos intentar... conectar... juntos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: Yo podría ayudarte con eso, bebé. Puedes practicar conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: Conectar con la gente es difícil. No eres el único al que le cuesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: Lo entiendo. No mucha gente sabe escuchar sin interrumpir con un, "Pues yo lo pasé peor..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: Todos necesitamos consuelo en estos días. Un poco de atención... Un poco de afecto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: Si me dejas entrar, quizá podamos afrontar el dolor... sanar juntos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: Y...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: Yo he sentido lo mismo, cariño. Si alguna vez te apetece hablar, podemos hacerlo... si te apetece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: Dejar atrás la rabia es duro. Y perdonar es aún más duro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: ¿Tuviste un padre abusivo? Qué horrible. Me alegra que eso ya haya quedado atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: Si me dejas entrar, yo te puedo dar eso... Te haré sentir cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: Pero hasta el alma más solitaria necesita un... tipo de atención especial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: Últimamente, todo el mundo está obsesionado con el fin del mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: Puedo ofrecerte algo que la mayoría no te daría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: Pero no voy a forzarte a que te abras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: Quizá ayude, una vez que lo saques.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: Casi nunca consigo conectar con la gente. No es como si fuera a cambiar eso ahora
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: Solía desear que mi padre muriera. ¿Es eso suficiente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: No quiero
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: Dímelo, cariño. Solo soy una extraña en tu puerta. Puede que no volvamos a vernos jamás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: ¿O tiene que ver con cómo creciste? ¿Tuviste una infancia difícil y todo esto te ha traído esos recuerdos de vuelta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: ¿Mataron los Visitantes a alguien cercano a ti y ahora te has desconectado emocionalmente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: ¿Qué pasó? ¿Te ha dejado tu mujer hace poco?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: ¡Ay, me pones triste!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: Casi nunca consigo conectar con la gente. No es como si fuera a cambiar eso ahora
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: Solía desear que mi padre muriera. ¿Es eso suficiente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: Mejor no
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: Conque no eres muy hablador, ¿eh? ¿Háblame de ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: La gente no para de decirme eso últimamente. Más de lo normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: ¿Te gusta, cariño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: Así que lo has notado. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: Tienes un aspecto... inusual
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: Qué tonta soy al preguntar. Al fin y al cabo, vives aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: ¿Ya te has adaptado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: ¿Cómo te trata esta nueva vida, cariño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: ¿Sinceramente? Me importa una mierda tu foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: Tiene buen aspecto. Igual que la mitad de los traidores que he enterrado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: ¿Otra vez con esta mierda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: Hostia. No voy a olisquearte las axilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: Será mejor que no descubra si algo está creciendo ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: ¿Me estás vacilando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: Puedes irte... por ahora. No tengo tiempo para estas gilipolleces.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: Vale. Eso no significa que estés a salvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: Abre más tus putos ojos. Déjate de tonterías.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: Ahora no tengo tiempo para esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: Jum... Sucias o limpias, no tiene importancia. Los Visitantes se camuflan bien de cualquier forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: ¿Y bien? Muévete. No muerdo a no ser que deba hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: Basta de cháchara. Estoy perdiendo el tiempo aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: No te confíes. Un error y se acabó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: Vale. Parece que todo está limpio. Pero, ¿sinceramente? Habría sido más fácil si no. Menos líos más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: Abre tu maldita boca. Más. No soy tu maldito dentista.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (Enseñar los oídos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (Enseñar foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (Enseñar las axilas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (Enseñar los ojos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (Enseñar las manos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (Enseñar los dientes)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: En fin. Ya está bien de contar historias. Te voy a examinar. Prueba que no eres uno de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: Se rieron. Dijeron que me alistara. Que se jodan. Lo único que hacen es llevarse a la gente y los Visitantes siguen aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: La AFAE llegó, hablando de la "limpieza". Les dije que ya estaba hecho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: La maté a ella primero. Luego a él. Los niños se las apañaron para escapar con los vecinos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: Cuando los Visitantes empezaron a trepar por el tejado, el muy cabrón abrió la puerta. La dejó escapar. Así que hice lo que él no pudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: Pero la mujer... estaba mostrando señales. Y él no paraba de suplicar: "Es mi mujer. ¡No la toques!".'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: Había una familia a las afueras del pueblo. Se atrincheraron, el padre todavía sujetaba la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: ¿Pero ahora? Ya no me importa. Se acabó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: No tiene sentido buscar. Es una pérdida de tiempo. Si mi hermano hubiera tenido agallas, quizá todavía habría una oportunidad...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (Enseñar los oídos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (Enseñar foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (Enseñar las axilas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (Enseñar los ojos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (Enseñar las manos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (Enseñar los dientes)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: En fin. Ya está bien de contar historias. Te voy a examinar. Prueba que no eres uno de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: Con los ojos desorbitados, pero estaba viva. Eso es lo que respeto. No como mi hermano. Joder, si se hubiera muerto antes, quizá su familia lo habría conseguido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: Pensé que estaban perdidos. Pero un par de días después me encontraron. ¿La primera entre los árboles? Su hija. Con una escopeta en la mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: Sacó a su familia por la parte de atrás, hacia el bosque. Yo me cargué a esos bichos raros, pero ellos nunca volvieron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: Vi a una familia no hace mucho. Un padre corpulento. Mantuvo la cabeza fría, incluso con los Visitantes gritando en las ventanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: ¿Todo este lío? Es por culpa de cobardes como él.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: Se rindió como un cobarde. Ahora su familia está o enterrada o a saber dónde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: Igual que siempre. Le dije a mi hermano... "Ten agallas, cuida de tu familia". ¿Y qué hizo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: ¿Quieres encontrarla?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: ¿Cómo lo estás llevando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: Si mi hermano no hubiese sido tan cobarde, tal vez podría haber mantenido a su mujer y a su cría a salvo. Ahora quién sabe dónde está esa mocosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: Ya he vuelto. Ni siquiera sé por qué cojones me he molestado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: Al demonio con esto. Tengo mierdas más gordas de las que ocuparme. Volveré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: Intenta esa mierda de los oídos otra vez y te mato aquí mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: Si no fuera por mi hermano...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: ¿Los oídos? ¿Piensas que soy un puto idiota?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: ¿La verdad? Me importa una mierda tu dichosa foto. Tengo cosas serias que atender. Vive por ahora. Haremos una revisión de verdad más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: Jum... Pareces limpio, claro. Pero he enterrado a demasiados "limpios" como para creérmelo así sin más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: ¿Una foto? ¿Conque auras, eh? Vale, a ver qué tan "limpio" estás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: Ninguna señal. Qué suerte tienes. Ahora quítame esas axilas de la cara, tengo problemas más importantes. Volveré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: Parece que estás bien. Pero eso no significa una mierda. Estos bichos pueden fingir mejor de lo que yo puedo detectarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: Jum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: Ahora no. Tengo mierdas más gordas de las que ocuparme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: Estás limpio por ahora. Pero si veo algo raro la próxima vez, disparo primero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: ¿Eres consciente de lo que uno de esos tipos "normales" puede hacer en una sola noche? Un fallo y todos muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: Je... No tienes nada, ¿eh? Genial. Jodidamente genial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: Venga. Usa tus putas manos. Abre BIEN.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: Ahora no tengo tiempo para esta mierda. Ya te revisaré bien la próxima vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: Déjame que te diga una cosa. Un consejo: ¿los que parecen normales? Siempre son los primeros en transformarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: Limpias... sí, claro que iban a estar limpias, joder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: Mierda, no tengo tiempo para esto. Tengo que ir a comprobar algo. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: Vale. Puedes vivir... por ahora. Pero si veo algo raro la próxima vez, te pegaré un tiro en el entrecejo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: Jum... Limpios. Es una pena, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: Abre más. Venga, no te cagues de miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (Enseñar los oídos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (Enseñar foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (Enseñar las axilas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (Enseñar los ojos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (Enseñar las manos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (Enseñar los dientes)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: ¿Tienes una escopeta? Me importa una mierda. Vale, entonces nos mataremos a tiros entre los dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: Prueba que no eres uno de ellos. Muéstrame cualquier cosa para examinar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: Jum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: Solo la niña sobrevivió. El hombre que buscas está muerto
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: Su casa se incendió. No lo he visto desde entonces
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: Su mujer... que se joda la bendita mujer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: Tiene una cría. Una niña pequeña. No sé qué edad tendrá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: Ya que estoy aquí... Dime, ¿conoces a un sujeto corpulento, que viste una cazadora vaquera azul?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: Los Visitantes se aprovechan de los débiles de corazón. Por eso la gente muere en sus hogares.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: Entonces, impartes justicia lo más rápido posible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: Solo la niña sobrevivió. El hombre que buscas está muerto
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: Su casa se incendió. No lo he visto desde entonces
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: Su mujer... que se joda la bendita mujer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: Tiene una cría. Una niña pequeña. No sé qué edad tendrá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: Ya que estoy aquí... Dime, ¿conoces a un sujeto corpulento, que viste una cazadora vaquera azul?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: Con una señal basta para eliminarlos. No espero por una segunda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: La tele y la radio lo dejan bien claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: Joder, igual que tú, apostaría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: ¿Qué pasa si solo muestran una o dos señales?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: ¿Cómo detectas a un Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: ¿La AFAE se dio por vencida con este lugar? ¿O solo con esta manzana?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: Pero he pasado por algunas casas... este lugar está infestado de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: Estaba intentado buscar a alguien. No he tenido suerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: He vuelto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: Volveré a verte más tarde... Eres una persona interesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: Tengo que ir a ver a alguien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: ¿Por qué dices que son una amenaza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: Tienen sus formas de detectar señales de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: Saben muy bien lo que hacen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: Descansa un poco. Hablamos luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: Necesito verlo todo yo mismo. Y lo haré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: Pero no me fío de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: Conque tú también intentas mantener el orden. Bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: Tienes mi atención. Volveré después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: Sí, creo que sí lo viste. No pareces ser de los que repiten rumores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: Eso es interesante... ¿En serio lo viste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: ¿O sea, sin armadura?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: ¿Solo uno? ¿Medio desnudo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: La AFAE se ha estado llevando gente. No tengo ni idea de si los traen de vuelta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: Los Visitantes no paran de aparecer. Pero tengo mi arma
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: Un Visitante medio desnudo aniquiló a toda una patrulla
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: ¿Qué es lo que ocurre con este vecindario? ¿De quién me tengo que fiar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: Ya has hecho tus preguntas. Ahora me toca a mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: Espera'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: ¿Por cuánto tiempo planeas estar "limpiando"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: ¿Así que por qué estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: Si uno realmente me impresiona... podría llevarme otra cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: Le arranco un diente a cada Visitante. Es el trofeo más fácil de llevarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: Es un recordatorio... de cuántas casas, cuántos pueblos he purgado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: Je. Buena frase. Me la quedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: ¿"Repele-Visitantes"? Oh, te refieres al collar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: ¿Por cuánto tiempo planeas estar "limpiando"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: ¿Así que por qué estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: Y cualquiera que sienta lástima por los Visitantes... bien podría ser uno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: ¿Pero la forma más efectiva? Encerrarlos en una casa y prenderle fuego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: Sacaría la basura con propias mis manos, pero esto trae mejores resultados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: Sí, claro. Es una escoba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: Je. Me gusta cómo suena eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: ¿Qué eso que llevas encima? ¿Se supone que es un repele-Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: Déjame adivinar, ¿es eso una escoba lo que tienes en las manos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: No soy de los que se esconde. Yo SOY la justicia. Yo traigo el orden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: No hay justicia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: Un par de días después, los masacran a todos en sus casas y luego se largan a otro lugar a repetir la misma historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: Hay quienes se apiadan de los Visitantes. Creen que pueden, no sé... rehabilitarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: Esto no es un maldito juego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: ¿Qué eso que llevas encima? ¿Se supone que es un repele-Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: Déjame adivinar, ¿es eso una escoba lo que tienes en las manos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: Cualquier otra cosa sobre mí no es asunto tuyo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: Ya he terminado con mi sector.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: Estoy aquí para hacer limpieza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: ¿Por qué no estás escondido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: A no ser que seas un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: Pues, vale. Eso mejora tus probabilidades de supervivencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: Manteniendo las distancias, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: ¿Volverás a tu vida como si nada hubiera pasado? Venga, baja ahí. Descubrámoslo. Juntos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: ¿Y si hay algo ahí abajo que lo cambia todo? Respuestas a todas las preguntas, algo capaz de convertirte en un héroe nacional.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: ¿Nunca lo averiguarás? ¿Estás de broma? Sabes que no es solo un agujero. Lo sientes, yo sé que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: ¿Y bien? ¿A qué esperas? Para esto estamos aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: ¿En serio vas a pasarte la vida preguntándote qué habría pasado si no te hubieras echado para atrás?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: Venga. Sé valiente. Baja tú, yo te cubro las espaldas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: Y venga, sí que quieres saber lo que hay ahí abajo, ¿a que sí? No eres un cobarde, yo sé que no. Ya has venido aquí tres veces.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: Yo te subo de vuelta de un tirón. Pero si bajo yo, ¿quién va a subirte? Pura lógica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: ¿Quién te subirá si bajo yo, EH? No te ofendas, colega, pero he visto ratas con más músculos. Ve tú y yo me quedo aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: ¿Y si nunca descubrimos qué hay ahí abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: ¿Por qué no bajas tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: Tú también lo sientes, ¿verdad? Esa atracción..., como si el agujero te estuviera atrayendo. Lo sientes, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: ¿Cuál otro? A ver, alguien tiene que dar un paso. No podemos quedarnos sentados para siempre. Es ahora o nunca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: ¿Y si nunca descubrimos qué hay ahí abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: ¿Por qué no bajas tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: Pero oye, mientras esperamos, tenemos tiempo. Tiempo para explorar todo este espacio. Admítelo, sientes curiosidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: ¿Él? Oh, sí, claro. CLARO QUE ESTÁ VIVO. La cuerda sigue tensa, ¿VES? Eso quiere decir que está ahí, trabajando. Si algo saliera mal, lo sabríamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: ¿Tu otro amigo sigue desaparecido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: ¿Crees que tu amigo sigue vivo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: Pero ese agujero... sé sincero, ¿cuántas veces te ha atraído ya? Atrae, ¿a que sí? Admítelo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: O a lo mejor solo estoy viendo cosas por estar sentado aquí tanto tiempo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: AH, ERES TÚ. Pensé que te habías rajado. Aunque algo va mal. La luz es rara. La cuerda pesa más de lo que debería.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: No estás hecho para el trabajo pesado, pero podría subirte sin problema. ¿Qué me dices? Tú bajas a echar un vistazo, yo... me quedo vigilando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: Un solo viaje allí abajo y a lo mejor por fin lo entendemos. Yo iría, pero... alguien tiene que mantener la cuerda sujeta, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: ¿Y si las respuestas están allí abajo? No todas, claro. Pero por qué vinieron, qué es lo que buscan... ¡A ver, piénsalo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: ¿VISITANTES? ¡Ah, sí, es lo que te decía! Creemos que estos túneles son suyos. ¿Y ese agujero? Podría ser una especie de... portal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: Hay que trabajar en equipo, ¿vale? ¡Alguien tiene que estar listo para subirte de vuelta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: No es que tenga miedo, pero... te atrae. Si tan solo pudiera echar un vistazo más... un poco más de cerca...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: Aun así... a veces, cuando estás cerca, lo sientes. Como si algo te estuviera llamando. Solo... escucha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: Me acerqué, cuando los chicos aún estaban aquí. Pero ahí abajo... es como mirar a la nada. La nada de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: Me encantaría, pero mira, un mal tirón de esa cuerda y se acabó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: ¿VISTO? Más o menos... No, la verdad es que no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: ¿No crees que algo pudo haberle pasado a tus amigos allá abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: ¿Has visto lo qué hay dentro del agujero tú mismo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: ¿LO VES? La cuerda está tensa. Significa que aún está trabajando ahí abajo. Si hubiese algún problema, ya lo sabríamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: El otro está en la cuerda. Le dará un tirón cuando esté listo, o si algo va mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: ¿EH? ¿A MIS COLEGAS? Qué va, están bien. Uno se metió bien a fondo, pero ya regresará. Ese sabe cómo olfatear una salida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: ¿No crees que algo pudo haberle pasado a tus amigos allá abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: ¿Has visto lo qué hay dentro del agujero tú mismo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: Será mejor que comas algo ahí arriba, o acabarás como yo. Muriéndote de hambre y con este farol al que podría empezar a llamar Wilson.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: El tiempo es raro aquí abajo. No hay luz, ni relojes. Vete a saber cuánto tiempo ha pasado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: ¿QUÉ? ¡HABLA MÁS ALTO! Llevo sentado aquí, sí... dos días, quizá tres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: ¿Tus amigos aún no han vuelto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: ¿Cuánto tiempo llevas aquí abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: ¿Eh? ¿Ya estás de vuelta? Ahora está más tranquilo, ¿eh?¿O es que me he quedado sordo por culpa de ese zumbido? ¿Y bien? ¡DILO DE UNA VEZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: Te diré más cuando estés aquí abajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: Intentamos cavar en los alrededores y casi nos echamos todo este sitio encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: Escucha, si te estás planteando bajar... no te acerques a ese agujero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: Uno de los muchachos escuchó algo sobre eso, pero vete a saber dónde; dijo que podría merecer la pena echarle un vistazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: Solo es un pozo, pero cosas extrañas suceden a su alrededor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: Qué va, nada muy interesante, en realidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: ¿Qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: Intentamos cavar en los alrededores y casi nos echamos todo este sitio encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: Escucha, si te estás planteando bajar... no te acerques a ese agujero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: Uno de los nuestros entró. Yo me quedé aquí arriba, por si necesita una mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: Los animales cercanos guardan silencio. La brújula se vuelve loca. Las luces no logran penetrar la oscuridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: Algo sucede cerca de ese hueco. Un zumbido muy silencioso, pero que nunca desaparece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: ¡HAY UN AGUJERO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: ¿Habéis atrapado a un Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: ¿Qué cosa? ¿Algo interesante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: Pero escucha, los túneles ni siquiera son lo más raro. Hay otra cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: No hemos visto ninguno todavía, así que no puedo asegurarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: Pensamos que los Visitantes se mueven a través de estos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: Ni idea de quién lo cavó o por qué. Tenemos nuestras teorías, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: Tan pronto empezamos a cavar, ¿y con qué nos topamos? ¡Un sistema de túneles COMPLETO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: ¡UN PUTO REFUGIO, JODER! ¡Del puto calor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: ¿Habéis atrapado a un Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: ¿Qué cosa? ¿Algo interesante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: Pero olvídate de eso, porque encontramos otra cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: Estos túneles son profundos, colega. MUY PROFUNDOS. Ni idea de dónde terminan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: Solía haber más, algunos se derrumbaron hace poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: Apenas habíamos empezado... ¡y MIRA, encontramos toda una red subterránea!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: Los chicos y yo pensamos que podríamos cavar túneles para escondernos del calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: ¿Qué estáis buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: ¿Qué hacéis ahí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: Con tanto polvo en los oídos, parece que me hablas a través de una almohada. Te lo juro por Dios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: ¿Atrapados? Qué va. Encontramos algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: ¿Qué estáis buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: ¿Qué hacéis ahí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: Bueno, esperemos que no se nos venga encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: "Miner: \n¿Que estamos bajo tu casa?"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: Estoy cubierto de polvo y hollín, no oigo una mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: ¿Qué? ¡Habla más alto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: ¿Estáis atascados ahí abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: ¿Qué hacéis debajo de mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: ...O eso creo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: ¿Eh? ¿Quién anda ahí? Me pareció oír algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: ¡Nos vemosss!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: Te deseo un buen día, buena salud, gran alegría y un montón de sonrisas, mi querido amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: Me temo que toda esperanza está perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: Vale, pues...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: Así que te lo pregunto otra vez, querido amigo. ¿Vendrás conmigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: No sé qué nos aguarda en la Tierra de las Setas... ¡pero puedes estar seguro de que allí nos espera el peligro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: Tú y yo estamos atravesando tiempos complicados, chaval. Todos bailarán mientras doblegamos a la Tierra de las Setas. Puede que nosotros también lo hagamos... quién sabe...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: Me temo que no puedo hacer esto solo. Necesito tu ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: Ay, querido amigo... Esto no está nada bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: ¡Antes de que la puerta a la Tierra de las Setas se cierre!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: ¡Ay, caray! ¡Vamos tarde! ¡Venga, rápido!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: ¿¡YA ES MEDIA NOCHE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: Espera. Déjame ver tu reloj un segundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: Ve a por tus cosas y...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: Perfecto. ¡Ese es el espíritu, chaval!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: ¿Estás listo para ir conmigo a la Tierra de las Setas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: Ningún humano debería poner un pie ahí. Nunca. Pero debemos hacerlo si queremos detener el festival.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: Si no actuamos, todo podría estar perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: Allí no presenciaremos el festival... pero los demás... El micelio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: No es una tierra donde siempre sale el arcoíris. ¡No, no, no!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: Puede sonar jovial en nuestra lengua... Pero en el idioma de las setas significa algo completamente distinto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: Que no te engañe el nombre, querido amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: ¿Estás listo para ir conmigo a la Tierra de las Setas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: Debemos detener el festival, cueste lo que cueste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: Y, a decir verdad... es mejor así. Pero no nos queda otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: ¡Jojo! ¡No podrías estar más equivocado mi querido amigo! Es un lugar aterrador al que ningún hombre ha ido jamás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: Bueno, eso no suena tan mal...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: ¿La Tierra de las Setas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: Yo no quería esto, pero... creo que tendremos que ir a la Tierra de las Setas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: Lo cual quiere decir que el micelio está en un buen lío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: El festival significa que las setas están creciendo sin control.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: Bueno, eso no suena tan mal...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: ¿La Tierra de las Setas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: Yo no quería esto, pero... creo que tendremos que ir a la Tierra de las Setas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: Pero últimamente ha habido tanta malicia que la seta ha crecido sin límites.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: Las setas son como un hígado, intentando limpiar todo ese veneno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: Cuando se acumula demasiada malicia en sus hebras, todo se atasca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: Hay una locura ocurriendo dentro del micelio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: ¿Por qué se está celebrando el festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: ¿Por qué no ha funcionado?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: Hay tanto caos en el micelio que el ritual... no ha funcionado...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: Parece que el festival aún se celebrará, después de todo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: Esta no es una despedida, mi querido amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: Y recuerda: las setas no siempre son lo que parecen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: Nos aseguraremos de que las setas se queden pequeñas y de que el festival no empiece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: Volveré cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: El micelio es el que piensa. Es una pena que solo pueda Escucharlo.. no habla nuestro idioma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: Son solo parte del micelio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: Eso tiene sentido... Pero yo no puedo hablar con las setas. No, no, no...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: Esta no es una despedida, mi querido amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: Y recuerda: las setas no siempre son lo que parecen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: Nos aseguraremos de que las setas se queden pequeñas y de que el festival no empiece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: Volveré cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: Y eso es justo lo que hicimos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: Pero la Guía de las Sonrisas nos mostró una manera de tranquilizar sus raíces y su crecimiento sin descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: ¡No, no, no! ¡No podemos hablar directamente con las setas, ya que no somos parte del micelio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: Hemos hecho un viejo ritual, mi querido chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: ¿No podías simplemente pedirle a las setas que no iniciasen el festival y ya?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: ¿Y cómo detienen nuestras acciones el festival realmente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: Todo lo que podemos hacer ahora es esperar y confiar en que fue suficiente para que las setas dejen de crecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: Oh, mi querido amigo... Ojalá fuera tan sencillo. Todavía no sabemos si lo que hicimos realmente ayudó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: ¿No podías simplemente pedirle a las setas que no iniciasen el festival y ya?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: ¿Y cómo detienen nuestras acciones el festival realmente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: Las setas han estado creciendo demasiado deprisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: Sabe muchas cosas. Pero ahora, también está en peligro... como el resto de nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: El micelio me lo ha dicho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: No pareces muy convencido
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: ¿Cómo lo sabes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: Espero de verdad que fuera suficiente para detener el festival...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: Ahí estás de nuevo, chaval. Hiciste todo lo que la Guía de las Sonrisas te pedía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: Fuá... quizá solo esté perdiendo el tiempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: ¿Pero por qué? Es solo una pequeña parte del libro... y me la sé de memoria...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: Te deseo un buen día, buena salud, gran alegría y un montón de sonrisas, mi querido amigo. ¡Nos vemosss!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: Volveré cuando hayas hecho todo lo que piden las páginas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: Ahora bien... debo marcharme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: Bien. Échales un vistazo cuando tengas un tiempo libre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: Mejor quédatelas tú
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: Vale, cogeré las benditas páginas de la Guía de las Sonrisas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: He arrancado unas cuantas páginas de la Guía de las Sonrisas. Por favor, cógelas. Te dirán qué tienes que hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: No podemos dejar que eso pase. Hay que pararlo... Juntos, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: Y esta seta no se alzará sola. Porque es un festival, ¡uno conocido!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: Su sombra engullirá el Sol... y no habrá ningún sitio donde podamos escondernos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: Una gran seta se alzará... y esparcirá sus esporas por doquier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: Todo lo que te puedo compartir es lo que la Guía de las Sonrisas dice sobre el festival.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: Ayayay... mi querido amigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: Mejor quédatelas tú
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: Vale, cogeré las benditas páginas de la Guía de las Sonrisas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: Así que arranqué solo las páginas más importantes. Aquí tienes... cógelas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: Pero me temo que no hay tiempo para leerlo entero. Es un libro gordo... y el tiempo no está de nuestra parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: Es un libro especial, el más especial del mundo. Te dice lo que se debe hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: ¿El festival de la Gran Seta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: ¿La Guía de las Sonrisas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: Mira, mira aquí... Llevo algo encima que nos va a ayudar: la Guía de las Sonrisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: No te preocupes, pronto tendrá más sentido. Pero recuerda, debemos detener el festival... sin importar qué.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: ¿El festival de la Gran Seta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: ¿La Guía de las Sonrisas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: Habló sobre el festival de la Gran Seta, que se acerca... Y eso, mi querido amigo, no es nada bueno. ¡No, no, no!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: Aprendí a escucharle estudiando la Guía de las Sonrisas. Y lo último que me ha contado el micelio... me ha preocupado un montón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: El micelio es cómo se comunican las setas entre ellas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: Sí, sí. Pero para la gente normal es difícil de entender. Se comunica de una forma extraña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: No acabo de entenderlo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: ¿Micelio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: Así que escucha con atención, mi querido amigo. Tenemos trabajo que hacer y no hay mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: Su manera de comunicarse es difícil, pero he aprendido a darle sentido a las señales que me mandan, claro que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: ¡Claro que sé quién eres! ¡El micelio me lo ha dicho!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: No acabo de entenderlo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: ¿Micelio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: Así que, por favor, escucha con atención y guarda mis palabras en un lugar seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: El festival de la Gran Seta se nos echa encima y el tiempo, mi querido amigo, se nos escapa de las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: Pero ahora no me hagas caso. El micelio me ha contado algo muy preocupante...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: ¡Jojojojo! Solo soy un viejo que sabe alguna que otra cosa sobre setas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: ¿Me conoces?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: ¡Hola, mi querido amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: Lo que había que hacer ya está hecho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: De cualquier modo, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: ¿O es que en realidad no quieres la paz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: ¿De verdad te estaban molestando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: Me los llevo conmigo. De cualquier modo, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: Muy bien... ya has hecho suficiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: Esto no es una guardería
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: Déjame en paz
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: No tenemos más remedio que seguir llamándola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: Pero la Muerte en sí misma... ella podría librarnos de lo peor... del vacío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: La reencarnación parece un tormento sin fin con pausas breves.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: El "más allá" es solo un concepto que prometen las religiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: La idea de desvanecerse para siempre es aterradora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: Lo que importa es que todos estamos cansados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: No pasa nada si no entendemos del todo lo que invocamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: Creo que estamos cerca de su llegada, sí, sí. Puedo sentirlo, Ella vendrá...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: Esto no es una guardería
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: Déjame en paz
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: ¿Por qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: Entonces, ¿qué pasa con esa Muerte tuya?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: Llévate a tus bichos raros
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: Buenas noches.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: Sabes... si la Muerte te ha elegido, la ayudaré a que te mire más de cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: Será por eso que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: ¿Se han ido del reino mortal...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: Entonces, ¿qué pasa con esa Muerte tuya?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: Llévate a tus bichos raros
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: Entonces no me entretendré. Me iré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: Sí, sí. Así es como tiene que ser. Su mirada sigue puesta en nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: Lárgate. Estoy ocupado
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: Tu gente está bien
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: Te encuentras bien, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: Así es como acaba el mundo. No con un estruendo... sino con un sollozo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: La Muerte ya no me habla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: Hasta nunca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: Tú... tú nos quitaste esta oportunidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: ¿Han muerto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: Espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: Todavía no sé qué significa eso... pero, ¿no suena tentador, sí, sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: Puede que te ofrezca un lugar donde esconderte. De todo... Incluso del final en sí mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: La Muerte me habló hace poco. Desea conocerte cuando sea el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: Estoy seguro de que tú también estás cansado. De todo este ruido. De estos días tan duros. De esta confusión...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: Gracias por su ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: Me importa un pimiento. Tengo que lidiar con mis propios asuntos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: Sí, sí, siguen con vida
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: No perdamos tiempo. ¿Cómo están mis seguidores?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: Nos vemos luego. Volveré a echarles un vistazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: No necesitan mucho tiempo. Pero aún así, cuida de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: Gracias'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: Probablemente no será por mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: Así que... solo permíteles quedarse, sí, sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: ¿A dónde huirás?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: Aunque sobrevivas, tu casa ya no estará.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: Otros vendrán. Mientras duermes, rociarán tu hogar con gasolina y encenderán una cerilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: ¿Crees que somos los únicos que hay?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: No me gustan las amenazas. Pero os ayudaré
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: Entonces, os dispararé a todos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: Por desgracia... No hay otra opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: Por desgracia, si esto falla, nos vengaremos incendiando tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: Pero si son más... y nuestra meta se nos escapa de las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: Cuida de mi gente. Y recuerda, si uno de nosotros muere... tu casa será reducida a cenizas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: ¿No ansías tú también la paz? ¿Un mundo donde nadie sea una carga para nadie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: Es, en efecto, una tarea importante. El camino hacia un propósito más elevado nunca es fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: No me gustan las amenazas. Pero os ayudaré
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: Entonces, os dispararé a todos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: Perdona. Pero es la única forma de seguir adelante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: Y entonces quemaremos tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: Pero si son más, entonces habremos fracasado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: Quizá al final sí acabes ardiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: Suena como una tarea importante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: No me muero de ganas, precisamente
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: Ellos oficiarán los ritos para los difuntos. Tú solo tienes que mantenerlos a salvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: Pero mis hermanos sí necesitan refugio. La Muerte se siente atraída por este lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: Yo no entraré. Nuestra misión es difundir la fe que trae la paz eterna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: Suena como una tarea importante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: No me muero de ganas, precisamente
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: Tienen que sobrevivir el tiempo necesario para completar sus tareas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: En cualquier caso, por favor, permite que mis hermanos se queden aquí. Dales protección.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: ¿Qué está pasando aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: La Muerte tiene una gran influencia en este sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: Tu casa es perfecta para ello, sí, sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: Tenemos que realizar los ritos funerarios. De una manera diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: ¿Planeas entrar o qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: ¿Y qué es lo que quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: Ya está cerca. Solo la estamos ayudando a cruzar el umbral.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: No creemos en la salvación. A menos que provenga de la mismísima Muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: Este es mi sudario. Para cuando muramos. No hará falta buscar tela para envolver a los muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: Quizás. No me importaría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: ¿Planeas entrar o qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: ¿Y qué es lo que quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: Es el único camino hacia la salvación. En tiempos como estos... ya no se puede volver atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: Nosotros simplemente la estamos ayudando a que se acerque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: La Muerte ha venido. Quiere aliviar a la humanidad, liberarnos del pánico, el rencor y el ruido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: Nosotros somos los heraldos de una nueva fe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: Pareces un fanático de una secta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: ¿Quién diablos eres? ¿Por qué estás vestido así?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: La Muerte te ha cogido aprecio, sí, sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: Algunos fueron quemados. A otros los arrastraron y ejecutaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: La Muerte está en todas partes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: Estás en lo cierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: Pareces un fanático de una secta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: ¿Quién diablos eres? ¿Por qué estás vestido así?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: No sé cuántos habrán muerto aquí... pero su presencia es fuerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: A la Muerte le agrada tu casa. Le tiene bastante aprecio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: La Muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: Sí, sí, esta casa es mía
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: ¿De qué hablas? ¿Qué sientes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: La puedo sentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: Sí, sí. Tu casa servirá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: Aquí tienes. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: ¿Por qué coño ese gilipollas pensó que un simple repartidor era peligroso? ¿Por qué lo mató? ¿Para qué cojones?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: La gente ha perdido la puta cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: Había ido a entregar un pedido y propietario...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: Han matado a mi amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: ¿Qué te ha pasado?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: Su pedido...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: Que tengas una buena noche...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: ¿Y si a mí me salen los ojos rojos de no dormir? ¿También me van a arrastrar a una de esas putas zonas de cuarentena?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: Y punto. Se lo llevaron arrastrando. Ya no sé qué ha sido de él. Ni si lo dejarán salir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: La inspección de la mañana, lo de siempre. Le vieron los ojos. Ojos rojos, joder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: La AFAE se ha llevado a mi compañero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: Te veo desanimado
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: Hola... Aquí tiene su pedido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: Que tengas una buena noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: Por lo menos con el trabajo me distraigo y no pienso en este puto desastre...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: Bueno, ¿qué más iba a hacer? ¿Sentarme en casa a pudrirme como la mayoría?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: Ah, ¿te refieres a cómo acabé haciendo esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: Pasé los controles. Buscaron todas las señales, concluyeron que soy humano y...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: ¿Cómo llegaste a ser repartidor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: Hola, aquí su pedido de For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: Lo siento, todavía no me he acostumbrado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: Que tengas un buen día... Ah, no, quise decir, noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: No pensaba que siguierais haciendo entregas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: Hola, aquí su pedido de For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: Es duro no soñar. Es duro para cualquiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: Espero que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: ¿Crees que la gente volverá a soñar alguna vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: Pero si alguien más en esta casa tiene sueños, también es algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: Gracias. Intentaré dormir aquí, aunque seguramente no funcione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: Entra, supongo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: A lo mejor si durmiera, yo también podría soñar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: Llevo seis días sin dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: Es difícil saberlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: Entra, supongo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: Creo que es porque perdieron ese espacio. Ese tiempo para descansar. Para reflexionar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: ¿Pero ahora? Están colapsando todos. Se están volviendo locos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: Es donde la gente se relaja. Busca respuestas, encuentra consuelo... se tranquiliza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: Los sueños son... delicados. Son cosas extrañas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: ¿Tú sí sueñas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: ¿Por qué te importa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: Me pregunto... ¿será por el Sol? ¿O por otra cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: Con mucha gente pasa lo mismo. Incluso cuando tienen fiebre... nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: Ya veo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: ¿Tú sí sueñas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: ¿Por qué te importa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: ¿A qué crees que se debe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: La gente ya casi no sueña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: ¿Sabes de qué me he dado cuenta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: Hablo de los sueños. Sabrás lo que es un sueño. Al dormir... ¿ves algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: La verdad es que no
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: ¿Alguna vez tienes sueños?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: Ni siquiera sé por qué lo sigo llevando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: Supongo que este traje acojona un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: ... Espera, eso ha sonado mal. Sí, lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: ¿Qué? Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: No pensé que de verdad me dejarías entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: ¿Hay algún sitio donde pueda sentarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: ¿Qué? Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: Hablo de programación, por cierto. De escribir código.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: Al final no hice nada parecido a lo que prometieron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: Pero luego vino la decepción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: Tenía un trabajo. Pensé que las cosas irían bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: Pero qué buena pregunta. Ahora mismo solo me siento... perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: Acabé agotado y lo dejé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: Ya no quedábamos muchos. No podíamos dar abasto. Y el trabajo no dejaba de amontonarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: Y... ya no trabajo ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: Construía neveras. Y las arreglaba también.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: Un simple trabajador de una fábrica es lo que soy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: ¿Y cuál es tu plan, entonces?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: ¿Entonces quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: A saber qué está pasando en realidad...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: Y nunca vuelven.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: Por... lo que sea que hagan. Se llevan a la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: Todo el mundo los odia, por lo que he visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: ¡Ah! No, yo no soy de la AFAE. ¿Lo has pensado por el uniforme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: No lo pillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: ¿Entonces, qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: ¿Entonces, quién eres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: ¿Será que el sol deja radiación por las noches? O algo así. No quiero ni pensar en ello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: Supuse que sería más seguro de esta forma. Por algo los llevan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: No, solo se lo quité a un cadáver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: Ah... ¿me tomaste por un agente de la AFAE por el traje?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: ¿Llevarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: ¿Has venido a por mí esta vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: Primero trae a los que te llevaste
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: ¿La... abrirás?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: He oído pasos... eso significa que te has acercado a la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: ¿Hola? ¿Hay alguien ahí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: Voy a cavar un hueco del que NUNCA MÁS voy a salir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: He oído historias... alguien sale de casa, vuelve, y ¡ZAS! Ya está.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: Luego los Visitantes tocan... o peor, ya están dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: Llegas a casa y está vacía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: Te dejas la espalda cavando todo el día, tu vida entera... ¿y para qué, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: Jeje... colega...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: Solo se rápido con esa puerta, ¿sí? Me da miedo que los Visitantes me atrapen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: ¡G-racias, tío!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: En fin, renuncié. A la mierda con esto. He terminado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: Ojalá los problemas nos cuidaran como nosotros nos cuidamos de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: El Sol quemará los cadáveres de todos modos. Y las noches... son demasiado cortas para ocuparse de los muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: Ya nadie trae cuerpos. La gente dejó de preocuparse por la muerte, por las despedidas apropiadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: Mi trabajo ya no vale nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: Salí corriendo a toda hostia. Ni siquiera miré atrás. No me atreví a ir a casa. Es más seguro en una multitud.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: ¡Un Visitante! ¡Saliendo de la tierra a rastras! ¿Y ese tío? Él solo se rió.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: Pensé que era una roca, pero no: ¡una mano se alzó!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: Estaba cavando y cavando... y de repente, ¡zas!, la pala chocó con algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: Él se quedó ahí parado, viéndome trabajar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: Maldita sea. Estaba cavando una tumba, un tío había encargado una.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: ¿Acabas de dejar el trabajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: ¿Has visto algo interesante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: Simplemente los dejan donde caen. El Sol los cocerá de todas formas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: La gente está cayendo como moscas últimamente, pero nadie los entierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: No viste lo que yo vi mientras cavaba ese último agujero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: Siento lo de los golpes. Es solo que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: ¿Acabas de dejar el trabajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: ¿Has visto algo interesante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: Las tumbas ya no significan nada. La gente cae donde cae.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: Antes era sepulturero, ¿sabes? ¿Pero qué sentido tiene ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: Que yo tampoco he pegado ojo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: Oye, sin resentimientos. No era mi intención despertarte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: ¡Mejor golpéate la puta cabeza!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: Deja de golpear la puerta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: ¿Te importaría dejarme pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: ¿Hay alguien vivo ahí dentro? ¿Hola?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: Bueno. Vale entonces. Supongo que yo también me voy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: ¿Eh? ¿Ya te has ido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: Solo estoy de paso. No me voy a quedar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: Eh... No conoces ningún sitio que esté vacío cerca, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: No hay problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: No son aburridas, te lo prometo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: Ven a hablar conmigo alguna vez. Te contaré historias. Tengo unas cuantas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: ¡Ah, por fin! Voy a descansar como una persona de verdad por una vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: En fin... si vives aquí, ¿habría alguna posibilidad de que me quede a dormir esta noche?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: Pero... hubo una vez. No es una historia corta. Te la contaré más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: Mira, no soy un santo, pero hay líneas que no cruzo. A los vivos no los toco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: ¿Qué, crees que soy una especie de gamberro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: Tengo historias. Cosas que he visto por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: No te lo tomes a mal, ¿vale? Pero ya que estás aquí... ¿podrías dejarme quedarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: Pero sí... iba a entrar en tu casa. Pensé que estaba vacía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: Hubo un momento en el que estuve a punto de dejar esto para siempre. Por poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: Cojo lo que puedo. Vendo un poco, me quedo con otro poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: Mmm. Para qué mentir. Voy a lugares abandonados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: ¿Robas a la gente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: ¿Cómo has sobrevivido solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: La cosa me está empezando a pasar factura. Siento que me estoy volviendo loco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: ¿Pero la verdad? Estoy harto. Estoy cansado de hablar con las sombras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: Al principio, pensé que sería más seguro así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: Desde que los Visitantes salieron de donde demonios salieran... he estado solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: ¿Y por qué no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: ¿Robas a la gente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: ¿Cómo has sobrevivido solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: Pero bueno... no pude quedarme en ningún grupo... así que ahora estoy aquí solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: Lo que pasa es que yo he visto lo que la gente hace de verdad. Ni me acerco a ser el peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: Como si yo fuera peor que el resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: ¿Quién querría venir conmigo, eh? La gente piensa que soy escoria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: ¿Y por qué crees que eso es una buena idea?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: ¿Por qué estás solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: Oye, eh... ¿Te importa si me quedo un rato? Ha pasado mucho desde que estuve con, ya sabes... gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: Aunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: Eh. Creía que esto estaba muerto. Me voy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: Ah, espera... Aquí vive alguien de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: Que tenga un buen día...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: Y confíe en mí, es parte del el artículo 119 de la Constitución. Además, eso no le dejaría en muy buen lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: Le aconsejo que reconsidere su tono. Podría interpretarlo como una amenaza a mi vida. Un crimen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: ¿Perdón? ¿Me acaba de decir que me marche? ¿Ha sido eso una amenaza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: Discutiremos las condiciones del alquiler en detalle más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: Gracias, propietario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: O pago, o no pongo un pie adentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: Es indebido. Es ilegal...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: Me disculpo, pero mi conciencia no me permite residir aquí sin pagar un alquiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: De acuerdo. Haremos esto en condiciones más tarde: un contrato legal completo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: Increíble... y pensar que un propietario respetable ande por ahí despreciando el dinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: ¿Acaso me está haciendo un favor o algo así?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: No necesito tu dinero
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: Bueno, paga si quieres
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: Lo siento, pero me niego a ocupar un espacio valioso sin pagar lo que me corresponde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: ¿A qué se refiere con que solo deja que la gente entre? ¿Es usted alguna clase de voluntario? ¿Dirige un refugio para indigentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: No necesito tu dinero
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: Bueno, paga si quieres
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: Eso sí... Solo para que quede claro, ¿cuánto cobra por noche?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: Bueno, de acuerdo. Supongo que cerraremos el trato más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: Esa es... una respuesta un tanto vaga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: Solo dejo que la gente entre
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: Algo así
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: Buenos días, propietario. ¿Está alquilando esta vivienda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: No eres mejor que esos bastardos de la AFAE. Ojalá te pudras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: Me cago en...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: Sí, entré en pánico, vale, pero no es motivo para que me dejes aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: ¡Venga ya, tío, no me hagas esto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: Te despistas un segundo y te atrapan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: Solo recuerda una cosa: no te fíes de esos malditos que van de amarillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: Uf, gracias, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: Así que eché a correr. Ahora no puedo ni volver a casa. Me apuesto lo que sea a que esos malditos ya me están esperando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: Querían encerrarme a mí también, junto con lo que yo les había traído.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: Ni me lo pensé, lo llevé a la AFAE. Qué gran error.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: Solo le eché un vistazo por el retrovisor y vi esos dientes blancos como vallas publicitarias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: Era un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: No pienses que estoy paranoico ni nada, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: Así que le partí una botella que tenía en el abrigo a uno de ellos y salí corriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: ¡En cuanto esos desgraciados me arrastraron lejos del coche supe que los muy hijos de puta también iban a por mí!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: De primeras me elogiaron en plan: "Bien hecho, nos has traído un Visitante" y esas tonterías. Pero luego...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: Así que lo llevé disimuladamente a la AFAE, pero la cosa no fue como yo esperaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: Total, que iba con un tío en el coche, ¿verdad? Y me di cuenta de que sus dientes eran demasiado blancos. Demaaaasiado perfectos, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: Esos malditos cabrones de la AFAE me robaron el coche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: ¿Qué ha pasado con tu pasajero?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: ¿Qué ha pasado con tu coche?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: Que no es que yo sea tonto, ¿eh? Es que me fié del tío equivocado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: Lo perdí por mi propia estupidez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: Tenía un coche, sí... pero ya no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: ¿Qué ha pasado con tu pasajero?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: ¿Qué ha pasado con tu coche?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: Ahora no estoy ni con él, ni... ni tengo mi coche, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: Resulta que no era quien decía ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: Estaba llevando a un pasajero y de repente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: ¿Por dónde empiezo? Soy taxista, ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: ¿En qué te puedo ayudar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: ¿Qué ha pasado?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: Mira, estoy metido en un lío hasta el cuello. ¿Te importa si me escondo aquí un poco?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: Eh, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: Ya encontraré sombra en algún sitio. Pero, por favor... no dejes que nadie deseche mi cuerpo cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: Esperaré a que la muerte me acoja en su dulce abrazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: ¿Te importa si me quedo cerca?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: Conserva el mío, cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: Aún no sé si ves la belleza como yo. Pero dime... Los cuerpos, ¿los arrojas a la gran noche?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: La verdad es que aquí se está más tranquilo que en cualquier otro sitio en el que haya estado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: Aquí pereceré y seré uno con el mundo, yendo hacia un final desconocido en donde hallaré la paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: Por eso vine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: No. No necesito tanta amabilidad. De algún modo... siento que aquí se acepta con facilidad lo inevitable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: ¿Piensas que ayudaría con la sepsis?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: Y ahora estoy aquí. Ante ti. Solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: Hasta que llegaron los otros. Y, bueno... supongo que ya te imaginas el resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: Ella cambiaba... cada día. Poco a poco. Y, oh, era maravilloso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: Una vez viví con una chica que adoraba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: Esa es una pregunta justa. Por ahora... déjeme decir esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: ¿Deberíamos amputarte el brazo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: ¿Cómo pillaste gangrena?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: No pinto nada en el pánico. Donde los vivos luchan contra la corriente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: Una historia como la mía es mejor tragársela de un solo trago.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: Cada mañana, cuando me despierto, me quedo tumbado y me pregunto si viviré para ver el día siguiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: Y temblaría de cualquier modo. Por la podredumbre, al fin y al cabo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: Una fiebre atrapada. Las calles ya no se refrescan al caer la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: Estoy temblando, incluso envuelto en el calor de la frenética ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: El silencio... la nada. Aquí hay tanta quietud.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: ¿Deberíamos amputarte el brazo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: ¿Cómo pillaste gangrena?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: Me gustaría morir aquí. Despacio. En silencio. Para saborear el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: Todo el mundo lucha por sobrevivir. Pero aquí... han hecho las paces con lo que vendrá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: El ruido de la ciudad se adhiere a mí como el sudor. El frenesí, el caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: Una historia como la mía es mejor tragársela de un solo trago.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: Cada mañana, cuando me despierto, me quedo tumbado y me pregunto si viviré para ver el día siguiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: Me encuentro realmente mal. Y no es solo la gangrena, ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: ¿Qué tiene de precioso este sitio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: ¿Por qué no te quedaste en casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: Esperaba poder abusar de tu amabilidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: Es más tranquilo aquí. Todo parece gritar en la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: Hola. Esta casa está preciosa por aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (Luego de unos instantes, se da la vuelta y se marcha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (Tu grito lo asusta)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: 'Foreigner: ¡Lárgate ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (Se queda ahí de pie, murmurando)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (Asiente con la cabeza y entra)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: Márchate
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (No estás seguro, pero parece que sus mejillas están húmedas con sus lágrimas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: (Se queda ahí de pie, mirando a través de la mirilla)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: Márchate
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (No estás seguro, pero parece que sus mejillas están húmedas con sus lágrimas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (Murmura algo, agitando los brazos)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: ¿Y qué se supone que debo hacer contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: ¿Tienes la boca cosida?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: (Vuelve a murmurar, pero no logras entender nada)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (Arquea las cejas, angustiado)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: ¿Y qué se supone que debo hacer contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: ¿Tienes la boca cosida?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (Parece incapaz de responder)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (El hombre te mira con las cejas levantadas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: ¿Qué te pasa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: ¡¿Mmmmmmmph?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: Mmmph.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: Con un poco de suerte, andaré cerca, así que no dudes en pedir ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: Lo entiendo, no es el mejor momento para fiarse de nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: Gracias. Espero poder ser de ayuda aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: Debería marcharse
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: Si me dejas entrar, te puedo contar qué les pasó a los hospitales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: Es una historia larga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: Había un hospital en el centro de la ciudad. Pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: Si me dejas entrar, te puedo contar qué les pasó a los hospitales.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: Debería marcharse
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: Y ahora... ya no hay hospitales. Así que solo ando por ahí y ayudo donde puedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: Nuestro hospital siempre iba corto de dinero, así que terminé haciendo mucho más de lo que mi trabajo exigía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: Era cirujano, operaba a la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: ¿De dónde ha salido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: ¿Quién es usted?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: Así que pensé en echar un vistazo. Pero la puerta estaba cerrada, así que decidí llamar antes de echarla abajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: Y con tanto silencio, la verdad, no pensaba que viviese nadie aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: Seguridad... y algo para ahuyentar el aburrimiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: Pues sí, busco algo, pero lo mismo que todos los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: ¿Por qué me lo preguntas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: ¿De dónde ha salido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: ¿Quién es usted?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: O... agonizando...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: O... llorando...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: Normalmente hay alguien gritando, en un estado de embriaguez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: Es raro que una casa llena se quede en silencio por la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: ¿Qué? Ja, no, claro que no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: ¿Está buscando algo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: ¿Estaba vigilando mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: ¡Buenas noches! ¿Me permite entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: Qué tranquilo está esto de noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: Vaya, creía que no había nadie en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: Ya vas a saber de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: Ahhh... ya veo cómo es la cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: La fuerza es la que manda ahora. O te adaptas a ella o se vuelve en tu contra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: Buena decisión.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: La cuestión es que no he venido a causar problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: Yo no pregunto cómo eliges vivir, así que no me preguntes a mí tampoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: Lo que no sabes no puede hacerte daño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: ¿Y tú? Aquí todavía hay orden. Eso es poco común. Me pregunto cómo lo mantienes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: Pero he visto el mismo caos en todos lados. El miedo ciega a la gente de lo que realmente sucede.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: Nunca me quedo en un sitio por mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: ¿Cómo has sobrevivido tanto tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: ¿A cuántos sitios has ido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: Quien diga lo contrario estará muerto por la mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: Este es el nuevo orden: los fuertes mandan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: Sigue negándolo y te comerán vivo. No quedarán ni los huesos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: Todos somos animales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: ¿Cómo has sobrevivido tanto tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: ¿A cuántos sitios has ido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: Ahora es simple. Si puedes cortarle la garganta a alguien, ganas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: Todas tus reglas y tu moral se han ido. Ya no funcionan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: ¿Has estado en otras casas? ¿Has caminado por las calles?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: ¿Acaso eres tú una de esas "bestias"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: ¿De qué estás hablando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: Por fin... se acabó el teatro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: Esto ya no es una sociedad. Las bestias han salido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: El mundo se ha ido a la mierda, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: ¡Eh!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: Entonces, ¿por qué te resistes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: TODO acabará pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: ¿A qué te aferras?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: ¿Por qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: Huyendo, siempre huyendo. De mi gente, de la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: Por eso estoy aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: Todavía no puedes ocuparte de esto por tu cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: Sssssí'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: ¿Tienes miedo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: Así que estás preparado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: Me he librado de unos cuantos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: Me he librado de todos los que estorbaban
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: Solo dejo entrar a los indicados
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: Hay muchos... no-humanos aquí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: No dejé entrar a nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: Hay mucha gente aquí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: ¿Has dejado entrar a mi gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: Pero siento curiosidad por otra cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: ¿Siquiera sentirás algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: ¿Solo... desapareces? ¿Para siempre?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: Te mueres. ¿Y luego qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: Parece que piensas más en lo que viene después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: ¿A menudo te preguntas por qué sigues vivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: ¿Te da miedo lo desconocido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: Me he librado de unos cuantos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: Me he librado de todos los que estorbaban
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: Solo dejo entrar a los indicados
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: Hay muchos... no-humanos aquí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: No dejé entrar a nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: Hay mucha gente aquí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: ¿Has dejado entrar a mi gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: Pero por ahora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: Pero... desaparecerás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: Si no es hoy, será mañana. Si no es mañana, será después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: Morirás...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: Pero el resultado es el mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: ¿Para cambiar algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: Me enviaron por ti por una razón...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: ¿No has considerado que... fuiste elegido? Jajaja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: ¿Recién ahora me lo preguntas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: ¿Por qué no solo tiras la puerta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: ¿Por qué sigues viniendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: No te preocupes, te ayudaremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: Es curioso cómo TÚ no sientes absolutamente nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: No puedo decírtelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: ¿Por qué no solo tiras la puerta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: ¿Por qué sigues viniendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: Ya os está respirando en la nuca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: ¿Pero lo sientes? ¿Cómo la Muerte se acercara más y más?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: Eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: Solo te estoy diciendo lo que me dijeron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: ¿Qué fin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: ¿Qué quieres decir?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: Si no es por nosotros, lo acabaréis vosotros mismos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: Todo esto está llegando a su fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: Me han dicho que esta sería la última vez que hablaríamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: ¿Hasta la próxima vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: En fin...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: Yo solo sigo órdenes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: Hay fuerzas más poderosas que yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: No te creerás que yo estoy a cargo, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: El cambio no es lo peor que os espera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: Ahora hasta los míos son difíciles de ver. Qué decir de los vuestros, encerrados en vuestras casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: Vaya, vaya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: Ven conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: Sssssí... La apuesta está dando frutosss.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: No estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: Estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: Pero antes de irme, vamos a hacer nuestra apuesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: Lástima... Me iré... por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: No estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: Estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: Pero antes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: Intentémoslo'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: Es simple.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: ¿Puedes volver más tarde?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: No entiendo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: Entonces me abrirás la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: Si tienes al menos a dos de los MÍOS dentro de tu casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: Vamos a arreglar eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: Como si no te quisieras ni a ti mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: Eres muy desapegado, ¿a que sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: ¿Puedes volver más tarde?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: No entiendo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: Porque ahora, son las bestias las que andan entre nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: Entonces me abrirás la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: Si tienes al menos a dos de los MÍOS dentro de tu casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: ¿Por qué no probamos algo nuevo? Hagamos una apuesta, sí, juguemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: Suena como si necesitaras ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: Debe ser duro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: Me da igual
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: No siento nada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: Pasan cosas extrañas cerca de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: Sabes a quién me refiero, ¿sssí sabess?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: Alguien que solo te habla y dice simples palabras. ¡Pero qué palabras!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: Y ahora también hay un inmortal entre los que vienen a verte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: Y... yo también.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: El cambio te está persiguiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: ¿Sientes eeeeeeso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: La próxima vez que nos veamos, será... más interesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: Te estás quedando atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: La vida ya no es la misma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: Lo entiendes, ¿no? Las cosas no volverán a ser como antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: Ahora el mundo le pertenece a las bestias. Solo las bestias sobrevivirán.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: ¿Y para qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: Sigues intentando reconstruir tu vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: Solo abriré la puerta y te dejaréee un regalito para que te vayas despidiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: ¿No te fue bien con nadie, eh...? Lástima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: O sea, que estás solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: No estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: Estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: Escuuuuucha'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: Lo único que puedes parar es el latido de un corazón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: ¿Detener las inundaciones, los incendios, la descomposición?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: ¿Puedes detener a la muerte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: ¿Y qué puedes hacer tú?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: No estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: Estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: Escuuuuucha'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: ¿Y contra la muerte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: ¿Contra una Calamidad cósmica?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: Pero ¿qué puedes hacer tú contra los desastres naturales?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: ¡Sí, ya sé!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: Hago lo que puedo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: No puedo hacer nada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: ¿O quieres arreglarlo todo tú solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: Es una bendición, ¿no crees?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: Ya todo está decidido por nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: Ni te molestes en pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: Hago lo que puedo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: No puedo hacer nada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: O quizá deberíamos tomar cartas en el asunto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: A lo mejor los de los trajes ponen orden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: Una cosa tras otra, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: La cosa está mal últimamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: No sé qué pensar de él
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: Solo está haciendo su trabajo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: ¿Qué piensas de ese de ahí? ¿El del traje amarillo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: Todavía sigues escondido en esta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: Traeré a mi gente para acá. Cielo, yo te ayudaré a que no mueras solo... ¡JAJAJAJAJA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: ¡JAJAJAJAJA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: La verdad es que... no le abras a nadie y ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: Sí, sí, solo... no le abras la puerta a los de los trajes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: En cuanto te descuides, nos estarán arrastrando a los dos a algún sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: Je, gracias. No le vayas a abrir a los trajes amarillos si tocan la puerta, ¿de acuerdo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: Así que ahora lo único que me importa es seguir con vida, cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: Me pareció que se llevaron a la mitad. A los demás ni los persiguieron mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: Algunos no salían, así que los de traje solo los jalaban, como si estuvieran escogiendo a dedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: ¡Ya te digo yo que fue todo el puñetero edificio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: A otros los dejaron ir como si nada hubiera pasado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: Los trajes amarillos se metieron, echaron a la gente. Cogieron a algunos y se los llevaron para investigar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: Dijeron que nuestro edificio recibió un buen golpe solar o alguna barbaridad así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: ¿Erais muchos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: ¿Por qué os desalojaron?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: He estado corriendo desde entonces, buscando un sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: Toda la maldita manzana fue desalojada y nadie sabe a dónde ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: No busco a nadie. Solo necesito un sitio donde quedarme, cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: ¿Erais muchos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: ¿Por qué os desalojaron?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: La gente salió corriendo para todos lados. Yo vine aquí para intentar sobrevivir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: Sin refugio, ni ayuda. ¿A dónde se supone que vayamos? ¿Qué se supone que hagamos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: Esos de los trajes amarillos nos echaron del edificio, pero no nos llevaron a ningún sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: Los míos y yo solíamos vivir a unas pocas manzanas de aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: ¿Estás buscando a alguien?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: ¿Hay alguien en casa o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: ¡Holaaa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: Cierto. Seguro no quieres gastar tus b-b-balas. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: ¿P-podrías dispararme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: Tienes bastantes manchas de pólvora e-en las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: Vale, adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: Lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: El techo es algo b-bajo, pero no pasa nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: G-gracias'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: Me iré. No suplicaré. No te m-m-molestaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: No tienes por qué dejarme e-entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: No'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: ¿Qué pasa si empeora? ¿Y aún no puedo m-morir por ello?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: Me da miedo quitarme la ropa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: Otros se q-queman con el Sol. Yo me envuelvo en capas y aún siento frío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: Siempre tengo f-frío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: Quítate la chaqueta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: ¿No te molesta el calor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: No en... m-mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: Nunca lo he sentido. La p-paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: Quítate la chaqueta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: ¿El calor no te molesta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: Pero luego, todavía n-no estoy seguro de que puedo fiarme de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: No lo soy. Pero t-tengo una petición.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: Ya no importa. Te preguntas si soy un Visitante, ¿a que s-sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: ¿Cuánto tiempo llevas buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: ¿Será que puedo encontrar paz aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: El calor no me m-molesta. Aún así, estoy buscando un sitio tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: H-hola'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: Pero te prometo que les haré la vida imposible. Ya verás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: Me habrías cortado la garganta en la mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: Así es mejor. A lo mejor eres uno de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: Vamos a acabar con ellos. No los dejaremos acercarse ni a una milla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: Sabía que no eras débil. Tienes agallas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: No les queda nada humano salvo la piel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: Corrí y te juro que lo que hicieron fue que me dispararon. Esa es su forma de divertirse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: Esperaron hasta que caí rendido. Me lo quitaron mientras dormía, ¡así como si nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: Solía llevar un rifle. Casi me cuesta la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: Hay que tener cuidado con ellos, eso es lo que digo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: Si dejas ir a uno, mañana te cortarán la garganta. ¿Lo pillas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: ¿O qué, solo los echas? No me das la impresión de ser un idiota para ser tan joven.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: ¿No haces tú lo mismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: ¿Dónde está tu arma, entonces?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: ¿Quieres cazar a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: Te lo digo, algo traman. Y hay que acabar con ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: Desde esa maldita cosa del Sol, han estado saliendo más, escabulléndose por todas partes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: ¿Dónde, aquí? Solo vine aquí para descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: ¿Dónde está tu arma, entonces?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: ¿Quieres cazar a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: Hay que borrarlos del mapa. Hasta el último.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: Fingen ser uno de nosotros... y luego todo se va al garete.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: Casa tras casa, hay alguien muerto, hecho pedazos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: ¿Has visto lo que están haciendo los Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: ¿Qué buscas por aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: ¿Por qué viajas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: Ya no puedo moverme como solía hacerlo. La edad tiene la culpa de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: No soy de aquí. Nunca he sido de quedarme en el mismo sitio mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: Eh, joven. ¿Qué tal están las cosas por aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: Hasta luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: ... Creo que mejor marcho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: No me quedan fuerzas para seguir leyendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: "Nuestra juventud gritó como las piras de Ruán en llamas..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: Hasta luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: Gracias. Pero no me ha ayudado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: Qué lástima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: "Alguien canta entre los dos mundos: ven, fuego, camina conmigo."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: Ahora me iré. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: Vaya... Justo he recordado algo. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: Ah. Con que eso era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: "Hemos estado viajando en un tren a ninguna parte por mucho tiempo. Pero bajo la pesada máquina, el camino sigue rugiendo."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: ¿Página diez?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: En medio de la página doscientos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: Alguna página por el final
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: Tengo miedo. A lo mejor puedes ayudarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: ¿Recuerdas cuando me leíste la fortuna del libro? ¿Quieres hacerlo otra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: ¿Será un mensaje para ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: Y recuerdo la palabra... "saltar". ¿Significará algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: Pero antes sí... creo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: Qué pregunta más extraña. Ya no entiendo nada de esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: ¿Página diez?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: En medio de la página doscientos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: Alguna página por el final
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: Quizás ayude.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: Léeme mi fortuna otra vez, ¿podrías?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: Estoy perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: No sé si es un mensaje para mí... o para ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: Solo hay un pensamiento que se repite: Salta. Salta. Salta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: Yo... ya ni me acuerdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: ¿Te estás muriendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: ¿De quién hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: ¿Cuál fue el punto entonces?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: ¿Y ahora qué? ¿Simplemente me va a quitar todo lo que me dio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: Ella me mantuvo con vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: ¿Te estás muriendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: ¿De quién hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: Madre mía, he de... Solo déjame ser...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: Ahora me doy cuenta... es algo que debió pasar hace mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: Las visiones... se han ido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: Es demasiado tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: Tienes... una mala pinta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: Solo no te mueras en el porche
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: ¿Será que ella me ha dejado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: Mi visión se está desvaneciendo. Apenas puedo ver ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: He olvidado tu rostro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: Necesito estar a solas con mis pensamientos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: Cuando encuentres lo que hay ahí abajo... no saltes. Ahora no te servirá de nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: Y tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: Tenía que hacerse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: Me... me acuerdo... de que era lo correcto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: Necesito descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: Cuando llegues... no saltes. Todavía no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: Pero... me acordé de algo más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: Lo siento. No puedo pensar con claridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: ¿Estás seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: ¿Por qué haría eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: Estás destinado a encontrarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: Tienes que cavar. Hay algo enterrado ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: Me... me acordé de lo que sigue. El sótano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: Ahora... todo está nublado. Te veo, perdido en un bosque oscuro, rodeado de bestias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: Pero sabía que había una razón. Lo recordaba con claridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: Lo siento. Sé que debo sonar extraño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: ¿Estás seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: ¿Por qué haría eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: No consigo ver qué hay bajo esa tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: Intenta cavar ahí abajo. Encontrarás algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: El sótano. Tienes uno, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: Antes de venir aquí, veía todo claramente. Ahora... es como si hubiera una niebla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: Sí. Perdona si te he asustado. Estoy pensando en voz alta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: Me estoy arrepintiendo de haber confiado en ti
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: Nunca entiendo de qué estás hablando
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: Pero ahora... algo va mal. Quizás fue ese... ¿hombre de las setas...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: Puede venir a ayudarte si se lo pides correctamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: Pero no le tengas miedo. Simplemente no sabemos lo suficiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: Sabes, hay una entidad más fuerte que nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: No. No, para nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: Me estoy arrepintiendo de haber confiado en ti
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: Nunca entiendo de qué estás hablando
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: Nuevos tallos brotarán de entre las cenizas y se elevarán hacia el cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: Esto ya pasó una vez, justo al principio. Todo saldrá bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: Probablemente no seas tú... ni ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: Me siento más débil. Mi visión no llega tan lejos como antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: Ya tengo toda la ayuda que necesito. Es que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: ¿Estás hablando solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: Oye. ¿Necesitas ayuda?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: ¿Será por la destrucción?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: Me siento peor. Qué extraño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: Estás ahí, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: Espero verte dentro de unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: Ahora esa sensación ha disminuido. Creo que estamos haciendo lo correcto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: Cuando llegué aquí por primera vez, sentí algo... extraño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: Sería mejor que no examinaras a nadie. Durante dos días seguidos. Las pruebas abren paso a la perdición.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: Puedes tomarlo como una petición, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: No puedo decir más. Ya he dicho demasiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: Espero verte dentro de unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: Tal vez te traiga paz. O al menos te ayude a seguir adelante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: Si puedes con eso, seguiré guiándote.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: Abstente de hacerlo hasta que el tercer amanecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: Pero... no deberías examinar a nadie durante dos días. Los exámenes solo atraen al mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: Nada. He dicho demasiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: ¿Qué va a pasar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: ¿Y qué se supone que debo hacer con eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: "Prophet: \nMe pregunto si lo dirán en la radio. ¿Estarás escuchando?"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: No podrás detenerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: Aun así, hay algo que veo con claridad y es que algo malo se avecina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: Gracias a esa entidad puedo ver más lejos que cualquiera. Pero ni siquiera yo lo veo todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: Eso te acercará a... una entidad muy poderosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: ¿Qué va a pasar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: ¿Y... qué se supone que debo hacer con eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: "Prophet: \nMe pregunto si lo dirán en la radio. ¿Estarás escuchando?"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: No eres la causa, pero te afectará a pesar de todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: Y sé que algo terrible se avecina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: No lo sé todo. Pero en tu caso... sé lo que pasará si sigues este camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: Veo más allá que la mayoría. Es un don que se me ha dado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: ¿Por qué me pediste que dejara entrar a alguien con un gato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: ¿Cómo sabes lo del gato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: Lo que hagas con quien lo trajo, ya es cosa tuya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: Perfecto. El gato está contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: Y luego nos iremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: Así que, nos vamos a llevar a dos personas, AHORA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: Usted se quedará atrás y morirá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: Y nos llevaremos a todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: Echaremos la puerta abajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: Es como hablar con una pared.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: Está bien, cuídese.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: Lo mismo digo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: No voy a entregar a nadie más
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: Bien. Espero no volver a verte nunca más
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: También lidiaremos con usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: Usted no es el primero en resistirse. Ya hemos lidiado con los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: O echamos la puerta abajo y desalojamos su maldita guarida entera, o nos entrega a dos personas ahora mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: No voy a discutir con usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: No tengo palabras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: No voy a entregar a nadie más
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: Bien. Espero no volver a verte nunca más
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: Y después, o encontramos un modo de combatir a los Visitantes, o no nos veremos de nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: No nos llevaremos a todos. Solo a dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: Dos personas más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: ¿Para qué coño están, si nada funciona?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: ¿Qué hace falta para arreglar esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: Si no encontramos la forma de sobrevivir, alguien más decidirá por nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: Los planes que nos dan son imposibles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: Las autoridades están preparadas para volar toda la ciudad. No pueden contenerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: Es un puto desastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: ¿Para qué coño están, si nada funciona?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: ¿Qué hace falta para arreglar esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: Siga con el juego y nos llevaremos a todos en esta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: EL MUNDO SE ESTÁ ACABANDO.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: DÉJESE DE GILIPOLLECES.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: ¿Qué catástrofe?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: ¿Dónde. Está. Mi. Gente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: De lo contrario, habrá una catástrofe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: Necesitamos más gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: Los tendrá de vuelta pronto. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: Solo. Denos. A. La. Gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: Nos preocupamos por esta ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: Resístase y será peor para usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: Esto es lo que sucede cuando los ignorantes se interponen en el camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: ¿Disfruta de la vista a mis espaldas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: Vale, que así sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: ... Pero válgame Dios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: Y nos ocuparemos de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: Nos llevaremos a dos ahora, pero los traeremos de vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: Gracias por su comprensión.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: Sí, ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: No. Ya me harté
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: De acuerdo. Si eso ayuda...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: Las cosas se estabilizarán pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: Da igual quiénes sean. Solo entréguenos a dos de sus inquilinos. Ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: Pero esta vez nos llevamos a dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: Sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: No. Ya me harté
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: De acuerdo. Si eso ayuda...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: Acelerará el proceso. Es lo mejor para todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: Dos, para ser precisos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: Necesitamos gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: ¿Debo entregar a alguien de nuevo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: ¿Entonces qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: Tenemos la situación bajo control.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: Solo déjenos hacer nuestro trabajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: Si fuera tan sencillo, la AFAE no haría falta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: ¿Debo entregar a alguien de nuevo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: ¿Entonces qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: Si coopera más, tal vez esto acabe pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: Es difícil de decir. Necesitamos más gente para mantener las cosas bajo control.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: Todavía lo estamos estudiando. Manténgase al margen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: ¿Cuándo os libraréis de los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: ¿Por cuánto tiempo continuará esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: Y ese... ese era mi hogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: Y mire dónde nos ha llevado eso. Tuvimos que acabar con un foco de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: No ha hecho más que tratar de entorpecernos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: No está en posición de exigir nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: ¿Cuándo os libraréis de los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: ¿Por cuánto tiempo continuará esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: Y eso provoca más violencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: Esconder a los Visitantes solo hace que se multipliquen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: Si se niega, habrán más explosiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: Repercusiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: ¡Regrese a los que se llevó!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: ¿Qué está pasando en la ciudad?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: Cuanto antes, mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: Necesitamos que nos dé más gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: Hola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: Esto se hará como tiene que hacerse. Cuanto antes coopere, antes acabará.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: No tiene otra opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: Lo ha entendido mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: Una vez que acaben las pruebas, le diremos qué hacer a continuación.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: No se preocupe. Los procedimientos son exigentes, sí, pero permitimos horas de descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: No me interesan esas pruebas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: De acuerdo. Si es la única opción
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: Para estudiar los efectos del Sol más a fondo, necesitaremos a otro inquilino de su casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: No hay resultados definitivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: No me interesan esas pruebas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: De acuerdo. Si es la única opción
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: Después de eso, serán enviados de vuelta desde la zona de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: Tras las pruebas, la cuarentena es obligatoria. Su inquilino se quedará con nosotros un tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: Ah. Entonces nuestro equipo ya ha estado aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: ¿Regresar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: ¿Qué pasó con la última inspección?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: ¿Cuándo regresarán a la persona que se llevaron?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: No se preocupe. No llevará mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: Soy de la AFAE. Estamos haciendo una inspección de rutina en su vecindario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: Buenas noches.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: Cuídate mucho, ¿vale?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: Y a partir de allí... la cosa puede ponerse muy oscura, muy deprisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: Si te enfocas demasiado en eso, te va a consumir vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: No te ahogues en tu dolor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: Quizás así... la muerte no sea lo único que tengas en mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: Ojalá te acuerdes de lo que era sentir alegría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: ¿Entiendes lo que digo? La vida se ha vuelto amarga últimamente. Demasiado amarga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: Cuando su objetivo no era solo sobrevivir, sino crear algo... bello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: Pero a veces, si les recuerdas que antes eran felices...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: ¿Por qué llamarlo mentira? Las personas están hundidas en su dolor y lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: Ahora más que nunca, no podemos dejar que la oscuridad nos consuma por completo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: Intenta recordar qué te daba alegría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: ¿Qué es lo que te gustaba, antes de todo esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: Hay muchas razones. Pero no puedo decirte qué es lo que te haría feliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: ¿Estás dispuesto a mentirle a la gente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: ¿Qué hay para celebrar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: La desesperación nos impide ver las pequeñas cosas buenas que aún quedan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: El miedo hizo que la gente olvidara cómo se siente la alegría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: Sí... Yo tampoco he visto a nadie sonreír en mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: Ah, ¿te refieres a la sonrisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: ¿Qué tiene de malo? A mí me parece que está bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: ¿Estás dispuesto a mentirle a la gente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: ¿Qué hay para celebrar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: Si nos repetimos que todo va a estar bien, quizá sea un poco más fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: La próxima generación. El arte. La... vida en sí misma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: Sí, son tiempos difíciles. Pero todavía hay mucho por lo que vale la pena luchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: Ya hay suficiente ira por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: ¿Qué pasa con tu cara?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: ¿Por qué estás tan alegre?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: ¿Te importa si me quedo a dormir aquí esta noche?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: ¡Eh, eh! Ya estás junto a la puerta, ¡he escuchado tus pasos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: Que te den.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: En fin, seguro eres uno de esos capullos al fin y al cabo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: Da igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: Aunque... qué más da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: Hala, si hasta tienes una alfombra. Qué guay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: ¡No puede ser! Jo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: ¿En serio vas a dejar a una chica aquí fuera? ¿Con este sol que quema? ¿Con los Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: Da igual. Ya estoy aquí, ¿no? Y me vendría bien un techo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: A mi madre le flipa tomar el sol, también. Así que, sí... esa es otra posibilidad divertida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: O a lo mejor ya son Visitantes. Les pegaría bastante. Ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: Ni idea. En casa, probablemente. ¿Dónde más iban a estar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: ¡Intenta algo perverso conmigo y te parto la cara!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: A veces te encuentras con unos auténticos capullos. Ugh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: Pero no tengo ni un euro. Así que, o hago tratos con la gente o me cuelo en sótanos que no estén ocupados. Da igual, así es la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: Yo... estoy viajando, supongo. Quiero ver el mundo. Sitios distintos. A lo mejor encuentro un nuevo hogar por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: ¿Dónde están tus padres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: ¿Y qué haces escondida en sótanos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: No pude encontrar un sótano ni otro escondite decente, así que aquí estoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: Esto es un poco raro, peeeeero... ¿dejas que entre? ¿O me vas a dejar aquí fuera?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: ¿Dónde están tus padres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: ¿Y qué haces escondida en sótanos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: Estoy hasta el gorro de esconderme en los sótanos. Si sigo así, se me va a olvidar cómo hablar con la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: Qué va, solo... necesito un sitio donde quedarme un rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: Sí, es mía
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: ¿Estás buscando a alguien?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: ¿Esto es, o sea, tu sitio? Eh... ¿su casa, señor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: Buenas. Eh... hola, supongo, si te va mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: Venga, mueve las piernas. Yo también estoy cansado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: Seguiremos buscando, ¿verdad, mi sol?'
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582080
    m_Localized: (Coger pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582081
    m_Localized: (Coger pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776384
    m_Localized: (Coger pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776385
    m_Localized: (Coger pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: Prefiero volver al hotel antes que a ese sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: Cuida de mi gente. Y recuerda, si uno de nosotros muere... tu casa será reducida a cenizas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: Entendido. Siento haberte molestado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: Solo es algo tímida. No pasa nada, bebé. Ya podrás descansar y ser la misma de siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: Uy, perdón. No es asunto mío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: Estoy agradecido por mi mujer. Sin ella, no habría aguantado nada de esto. ¿Y TÚ? ¿Cómo lo llevas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: Que todo se junte así... ha sido complicado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: A ver, lo entiendes, ¿no? Los Visitantes, el calor, que te echen del trabajo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: Ay, discúlpame. No debería insistirte tanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: ¿A que sí, mi amor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: Pero a lo mejor podemos hablar otro día. Si nos volvemos a ver, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: Solo está muy cansada. Lo siento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: ¡Claro! Mi cielo, ¿quieres decir algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: ¿De qué estáis cansados?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: ¿Su mujer no habla por sí sola?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: Si... si no le molesta, digo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: Mi mujer está agotada. Solo necesita un pequeño descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: Bueno... supongo que nos iremos y buscaremos en otro sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: ¿De qué estáis cansados?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: ¿Su mujer no habla por sí sola?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: Una casa grande, algo alejada, sin vecinos cotillas... Hay menos posibilidades de que se presente algún bicho raro, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: No sé cómo explicarlo, jaja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: La verdad, esta casa parece más segura que cualquier otra que hayamos visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: ¿Y si el problema sois VOSOTROS?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: ¿Mi casa os parece un lugar seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: ¿Le importaría si nos quedamos aquí un rato? Solo si no es ninguna molestia, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: ¡Hola! ¡Mi mujer y yo andamos buscando un sitio seguro para refugiarnos de la tormenta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: ... Ay, así, mucho mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: Un regalito. De mi parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: Encontrarás al gatito debajo de la casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: Venga, gatito. ¡Ahora tienes un sitio para jugar y hacer lo que te plazca!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: Me voy a poner cómoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: Ya vete al diablo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: Vale... Entra
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: Piénsalo otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: ¿Ya viste al gatito?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: No tortures al gatito. Odia el frío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: Esta señorita se va a congelar aquí fuera, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: ¿Abres o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: ¿Pasé la prueba?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: ¿Con eso no te basta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: Tengo dos brazos, dos piernas y una cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: ¿Y bien? Decide ya. ¿Qué hacemos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: Soy una bai-llet-rina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: Quizá lo haga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: ¿Quieres verme bailar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: ¿Y eso qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: Demuestra que eres una persona.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: No creo que seas humana.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: Qué cosa más rara de decir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: ¿Y ahora qué? ¿Te acordaste de él? ¿O qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: Vale... claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: Demuestra que eres una persona.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: No creo que seas humana.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: Jeje'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: No sé. ¿Por qué importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: Me recuerdas a... alguien.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: ¿Alguien te envió aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: Aquí no hace calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: Vi tu casa, así que vine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: ¿Ves esa ciudad? Ahí vivía yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: Me recuerdas a... alguien.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: ¿Alguien te envió aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: Ballet. ¿Se nota?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: Yo bailo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: ¿Cómo encontraste mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: Me dijeron que viniera, así que vine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: ¿Vas a abrir, sí o no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: Una caja de cervezas. Un cajón. Una pata de jamón. No sé. Soy cualquier cosa, jaja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: ¿Cómo encontraste mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: ¿Y eso de qué vale?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: Pero cuántas preguntas. Sí, lo conozco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: ¿Qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: ¿Conoces... al hombre calvo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: ¿Me abres o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: Holis'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: Si alguna vez te encuentras con un niño que necesite ayuda... prométeme que lo cuidarás. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: No te culpo. Pero, por favor... prométeme algo antes de que me marche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: Pero gracias... por escucharme. Y por dejarme entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: Sé que es imposible traerlos de vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: Lo quemaron todo. Y me obligaron a mirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: ¿Qué hicieron para merecer tal cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: ¿Qué somos ahora? ¿Una muchedumbre juzgando a niños indefensos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: Descubrieron que estaba protegiendo a niños con señales de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: Por culpa de... por culpa de las personas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: Todavía siento sus ojitos asustados mirándome...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: Me obligaron a mirar... mientras cerraban las puertas, clavaban las ventanas... y le prendían fuego al edificio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: Fue la misma gente. Les aterraba que los niños pudieran ser Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: Todos murieron... en las llamas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: Ellos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: ¿Por qué se produjo el incendio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: ¿Qué les pasó a los niños?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: Pero ahora... se han ido. Ni uno solo sobrevivió al fuego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: Otros abandonaron a sus propios hijos en el momento que vieron una señal de Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: La AFAE se llevó a algunos. A otros los asesinaron. Otros...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: Perdieron a sus padres por todo tipo de razones.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: Es que... Cuando el mundo empezó a venirse abajo, acogí a los pequeñines que habían sido abandonados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: Yo era maestra... en el jardín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: ¿Por qué se produjo el incendio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: ¿Qué les pasó a los niños?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: Pero... no pude salvarles. Fracasé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: Solo necesitaban a alguien que se preocupara. Alguien que les quisiera. Hice lo que pude...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: Nos alojábamos en el viejo edificio del jardín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: Acogí a todo niño que llamaran "contaminado", a los niños que temían que fueran Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: Yo... solo quería darles un poco de esperanza a los niños abandonados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: ¿Qué ha pasado?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: Es que me siento fatal. ¿Será que podría... conversar con usted?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: Lamento molestarlo, pero... ¿tendrás un momento?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: Cuídate mucho... y a tu familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: No pasa nada, tío. Lo pillo. Sin malos rollos. Te perdono.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: Aguafiestas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: Algún día tienen que hacer una película de esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: Tío, esto es lo mejor que me ha pasado que si en toda la puta vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: ¡Ehhhhh, tío, te lo agradezco!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: Siempre quise acabar saliendo en una peli un día...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: Son mucho más guays que los libros, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: Lo tienen TODO. Emociones. Drama. Traiciones. ¡Intriga!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: Pero las películas, tío...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: ¿Y con todo lo que dan en las noticias? Tío, es un chasco tras otro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: La gente echando pestes de los demás es deprimente; todo es miseria y pesimismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: Qué va, tío, fuera hay un follón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: Bueno, relax, no te doy más la brasa. Pero venga, tío, déjame entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: Sería la leche. Uno de mis colegas leyó un libro en el que pasaba eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: Imagina si conquistamos el espacio y nos da por enviar cartas a los alienígenas... ¡Guaaaauuuu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: En plan, predicen cosas de tecnología y eventos antes de que pasen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: ¿Has oído alguna vez cómo los escritores de ciencia ficción siempre adivinan el futuro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: Qué vaaaaa, tío, no digo chorradas. Sé PERFECTAMENTE de lo que hablo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: ¿Tienes alguna idea de lo que está pasando ahí fuera?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: ¿Pero de qué narices hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: Y comida, tío. Muuuuuucha comida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: Ah, y, tío, ¿tienes una escopeta o algo? Vamos a necesitar artillería pesada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: Tío, créeme que eso cambiaría POR COMPLETO el plan de acción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: ¿Es un virus o son muertos vivientes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: Solo dime, ¿son zombis rápidos o lentos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: He visto tantas películas de esto que soy básicamente un gurú de la supervivencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: Tío, en plan, cuenta conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: ¡ZOMBIS! ¡JA! ¡LO SABÍA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: ¿Tienes alguna idea de lo que está pasando ahí fuera?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: ¿Pero de qué narices hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: ¡Ah, ah! Y más vale que el equipo sea de cuatro personas. Es, como, el número de oro de la supervivencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: ¡En plan, bum! ¡Lanzamos un cohete bien chulo en una misión para detener la bola de fuego! ¡Tíooo, qué guay!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: Tío, ¿vamos a enviar a un equipo de héroes astronautas cañeros al Sol, a que sí? ¿Sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: Tío, ¡yo vi esta película!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: ¡No me jodas!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: Unas criaturas que parecen humanos han empezado a salir de la tierra
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: El sol está quemando a la gente viva durante el día
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: Venga, dime, tío, ¿de qué me he perdido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: Hostiaaa, tíooo, ¿será que tú sabes qué coño está pasando ahí fuera?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: ¡Eh, tío! ¿Qué hay?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: O ESO vendrá a por ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: Por el amor de Dios, NO te acerques a los cuerpos calcinados por la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: Me iré, pero debo advertirte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: Joder... es duro estar sin ojos. ¿Podré dormir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: Gracias... Por fin puedo descansar un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: Esa cosa nunca debió existir... ESO NUNCA DEBIÓ EXISTIR.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: Más grande. Más fuerte. No... No puede ser nombrado. ESO sigue el olor a quemado y destroza lo que hemos sembrado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: Oh, no... no, no. Hay algo mucho peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: ¿De verdad te piensas que me arranqué los ojos de las cuencas por un tío pálido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: Dios... no le desearía ver eso ni a mi peor enemigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: Digiriendo lentamente esos cuerpos ennegrecidos como el carbón justo... ¡JUSTO FRENTE A MIS OJOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: ESO... ni siquiera se fijó en mí al principio. Estaba demasiado ocupado devorando carne...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: Solo estaba en el lugar equivocado... en el momento equivocado...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: Para ESO, nuestro sufrimiento es un festín. ¡Un festín de dolor! Se atiborra del miedo, el dolor... ¡de nuestras mentes!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: Es mejor que no sepas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: ¿Te refieres al hombre pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: ¿Qué fue lo que viste?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: Pensé que si me los arrancaba, podría borrar esa imagen monstruosa. Ahora no veo nada más que una oscuridad sin fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: Para no perder la cordura, tuve que sacrificar mis ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: Yo... Yo me hice esto a mí mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: ¿Te refieres al hombre pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: ¿Qué fue lo que viste?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: Créeme... si hubieras visto ESO, habrías hecho lo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: No hay palabras para describir el horror primitivo que me desgarró el alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: La imagen de lo que vi... sigue frente a mí. Grabada a fuego en esta oscuridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: Vi algo indescriptible. No me atrevería a describirlo... ¿quién se regodea en lo que la mente engendra al romperse?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: ¿Quién te ha hecho esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: ¿Qué te ha pasado en los ojos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: Por fin... parece que he llegado a un refugio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: ¿Adónde coño se supone que vaya a ir ahora? Estoy... ¡estoy jodido!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: ¡Madre mía! ¡¿No ves que no me encuentro bien?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: Te lo pagaré, una vez que acabe todo este lío. Ya verás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: ¡Espléndido! No te vas a arrepentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: Si me dejas entrar ahora, cuando todo esto acabe... te lo compensaré con creces.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: Venga, tío... Yo, eh, haré que valga la pena para ti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: Eres un gilipollas por rechazar a un hombre tan importante como yo. ¡Yo solía poner orden en esta mierda! ¡Venga, que antes era un ministro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: Me ha llevado una eternidad solo en llegar arrastrándome, ¿y para qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: Lo digo en serio. No me... no me encuentro bien. Necesito agua fría, ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: Si no, me voy a desmayar y en cuanto salga el sol, me voy a asar vivo frente a tu puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: A ver, abre la puerta. Necesito esa bañera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: Y... hablando de eso... ¿Será que tienes helado? ¿No? Uf, joder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: Perfecto, así me gusta. Pensé que me iba a derretir aquí fuera, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: ¿Para qué quieres usar mi baño?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: Sí. Tengo una de esas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: Solo necesito un buen baño frío. ¿Te importa si uso tu ducha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: Hace más calor que en cualquier resort de cinco estrellas en el que haya estado. ¡Já!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: Siento que tengo la piel en llamas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: No, no estoy jodidamente bien. Mírame.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: ¿Para qué quieres usar mi baño?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: Sí. Tengo uno
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: Es que no puedo... respirar. ¿Tienes, ehh... un baño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: Claro, hace un poco menos de calor... pero el aire está denso como el infierno y... y... y...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: ¡Ufff! Sigue pareciendo un horno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: ¿Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: Es medianoche
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: Uf... joder... hace un calor de la hostia aquí fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: Vale, no seré una molestia. Me marcho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: Joder, tío...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: Igual me habría quedado completamente solo de no ser por ti'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: Gracias'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: 'Buddy: Deberías marcharte'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: Vale, ya sin chistes. ¿Me dejas entrar, tío?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: ¿Y sin un trago para pasar la miseria? Nah... Mirar a este mundo de frente sobrio es demasiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: Je, je, relájate, solo te estoy tomando el pelo otra vez. No me lo tengas en cuenta. Hoy en día, el humor es todo lo que tenemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: Rico, saludable, e incluso cuenta como dieta si lo haces bien. ¡Nada más mira este cuerpo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: Me he pegado un desayuno de reyes esta mañana. Siguiendo el plan de dieta de mi colega: cerveza para desayunar, vino para cenar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: Entonces, tío... ¿me dejas entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: No te enfades si mis chistes te molestaron. Solo estoy intentando no perder la cabeza. Espero que lo entiendas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: Los chistes, tío... te mantienen con la cabeza en su sitio cuando todo se va a la mierda. Sin ellos, ya estaría perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: No soy perfecto, ¿sí? ¿Pero qué tiene de malo tener algo de humor cuando el mundo se está cayendo a pedazos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: Suenas un poco ebrio. ¿Estabas bebiendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: ¿Qué eres, un comediante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: Olvídalo'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: Yo no le haría daño a nadie por sus dientes, o sus ojos, o lo que sea que estén diciendo en la tele. Ni siquiera podría...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: Una característica rara no te hace un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: Venga ya, es un chiste. No te pongas tan tenso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: Claro, puede que me antoje de darle puñetazos a la gente con dientes perfectos y ojos bonitos... pero solo porque los envidio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: Créeme, tengo un corazón enorme. Soy un amor de persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: Suenas un poco ebrio. ¿Estabas bebiendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: ¿Qué eres, un comediante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: O sea, que soy libre para ir a tomar algo si te apetece en algún momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: Ni tengo suegra, ni estoy casado. ¡Sin ataduras, tío!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: Je, te he pillado, ¿a que sí? Estoy de coña, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: Mi suegra me echó de casa porque saqué a patadas un tío de la AFAE. Ahora tiene miedo de que vengan a llamar a su puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: Ah, no es nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: ¿Cómo sé que eres realmente un "buen tío"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: ¿Y a ti qué te ha pasado?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: ¿Qué tal, hombre? ¿Dejarías entrar a un buen tío como yo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: Adiós, señor desconocido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: Sí... sí, volverán. Eso creo. Eso espero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: Volveré a casa. Por si acaso regresan...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: Sí. Es probable que eso sea lo más seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: Pero... tal vez debería quedarme contigo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: ¿Y si regresan y no estoy allí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: No sé si eso sea una buena idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: ¿Y ahora qué hago?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: Esto es... esto es una pesadilla...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: Dios, ¿y si se quemaron...? ¿Y si el Sol los quemó?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: ¿Ahora qué debería hacer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: Ya no sé ni qué pensar. Quizá tú tampoco te fías de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: Mierda, ¿por qué se fueron? ¿Por qué no me llevaron?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: Oh, Dios. ¿Y si esos Visitantes los mataron...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: El sol está explotando y la gente se está quemando viva
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: Unos monstruos llamados Visitantes vinieron del suelo. No se puede confiar en nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: Pensé que si hablaba con alguien, me dirían qué ha pasado. ¿Puedes decírmelo tú? ¿Por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: Un par de horas después de la emisión, se marcharon deprisa... y no volvieron. Ahora me da aún más miedo poner la tele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: No puse la tele, no quería estresarme. Pero no han vuelto y sigo sin saber qué demonios pasa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: Un día, oyeron que había sucedido algo terrible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: Pero mi padre y mi madre siempre las veían.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: Y leí por ahí que las personas que no miran las noticias viven más tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: Ya ves, las noticias nunca dicen nada bueno. Me hacen sentir mal, por eso dejé de verlas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: El sol está explotando y la gente se está quemando viva
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: Unos monstruos llamados Visitantes vinieron del suelo. No se puede confiar en nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: Necesito saber la verdad. ¿Adónde se fueron? Dime, ¿qué está pasando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: Pero... ya ha pasado una semana entera. No han vuelto. Sigo esperando, pero simplemente... no regresan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: Una mañana me desperté y estaban muy asustados. Dijeron que tenían que irse de inmediato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: No. No lo hago. Las noticias me dan pánico. Yo solo... trato de no mirar. Pero mis padres...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: ¿Es que no ves la tele?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: Espera, ¿en serio no sabes lo que está pasando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: Disparos, peleas... no entiendo nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: Hace tanto calor que apenas puedo respirar y la gente... todos están raros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: ¿Puedes decirme qué está pasando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: Da igual. Que tengas una puta buena noche, gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: Escondidos en vuestras madrigueras y dejando a los demás fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: Claro. Debería haberlo sabido. Eres como los demás. Pequeñas ratas miedosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: HOSTIA'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: Me alegra ver que no eres como tus vecinos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: Gracias. De verdad. Te debo una.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: Ahora soy un testigo... sé demasiado. Vendrán a por mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: Por eso corrí, aunque me llevé un balazo al escalar esa puta valla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: Cuando vi esa mierda, supe que me tenía que largar de ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: Le están haciendo cosas a la gente. Por eso nadie sale de esos sitios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: Al principio oí unos gritos ahogados... y luego sacaron una bolsa negra. El tío no volvió nunca. ¿Lo pillas ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: LO VI YO MISMO, joder. Se llevaron a un pobre cabrón a una tienda de campaña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: ¡Esa mierda no es un rumor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: ¿Te has enterado de que la AFAE está haciendo pruebas para dar con los Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: Oh, créeme que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: Me caí de la valla directo a un charco, y después eché a correr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: Lo único es que no tuve tanta suerte. Uno de esos cerdos se giró, me vio y empezó a disparar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: Están liados ahí dentro. Se nota... están preparando algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: Ni siquiera necesité un plan, solo esperé el momento adecuado y salté la valla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: Y la seguridad que tienen es una puta broma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: Eso es una zona de cuarentena de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: Un pedazo de contenedor de transporte donde meten a la gente cada mañana como si fueran ganado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: Imagina un descampado vacío, vallado, con un par de tiendas de campaña por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: ¿Así que la AFAE te persigue?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: Háblame de las zonas de cuarentena de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: Les dije que se fueran a la mierda. Me esposaron como a un criminal. Pero conseguí escapar de todos modos al final'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: Acto seguido, estaban garabateando gilipolleces en sus tabletas y me decían que tenía que ir con ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: Abrí la puerta y ya me estaban escaneando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: Me he escapado de una de sus zonas. Me pillaron cuando vinieron a la puerta durante una redada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: ¿Así que la AFAE te persigue?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: Háblame de las zonas de cuarentena de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: 'Fugitive: Al menos no se me salen las tripas... No es que quede mucho que sacar de todos modos... jeje... Argh... Duele una barbaridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: 'Fugitive: Me atravesó, gracias a Dios. Pero joder, estoy sangrando como un cerdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: Menuda puntería, esos cabrones. Pero una jodida bala... sí, una me ha dado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: Esos jodidos cerdos de la AFAE me atraparon... estaba trepando la valla y eché a correr...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: ¿Qué ha pasado?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: ¿Quién te ha hecho esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: Me han disparado. No voy a durar mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: A-ayúdame...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: El Señor recordará esto. Él lo sabe todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: Mi muerte te pesará en el alma, graba mis palabras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: Así que rechazas a una pobre anciana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: ¿Así que así están las cosas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: Pues, muchísimas gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: Pues, puedes estar seguro, haré todo lo posible para eliminar ese lenguaje soez de este bendito sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: ¿Te hago una simple pregunta sobre tu casa y me maldices?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: ¿No le temes a Dios? ¿No tienes vergüenza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: ¡A mí no me hables con esas groserías, ateo salvaje!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: ¿Acaso pido demasiado, querido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: Solo estoy tratando de ver si su casa es habitable. No tolero la suciedad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: ¡Oh, gracias al Cielo! Nunca lo habría adivinado sin tu ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: ¿Pero tú de qué vas, jodida vieja del coño?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: ¡Esto no es un hotel!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: No los soporto. Me dejan la piel toda roja y con sarpullido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: Segundo... ¿tienes chinches? ¿Ratas? ¿Algún otro tipo de plaga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: Si tienes gente así, es mejor que me lo digas directamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: Primero que nada: no tengo paciencia ni con borrachos ni drogadictos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: ¿Acoges a la gente, no? Solo tengo que asegurarme de algunas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: Necesito una habitación en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: ¿Pero tú de qué vas, jodida vieja del coño?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: ¡Esto no es un hotel!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: Tienes íconos sagrados, ¿verdad? Y... necesito silencio total para orar y contemplar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: Y ya que estamos en esto... Déjame preguntarte algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: Para quedarme, querido, para quedarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: Señor, ten piedad... Que estoy hablando claramente, ¿o no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: ¿Qué necesitas exactamente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: ¿Te vendrá de perlas para qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: Creo que me vendrá de perlas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: Veo que tu casita es la más alejada de todas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: Siento haberte hecho perder el tiempo. Solo... solo espero que algún día aprenda a matar. Para poder defenderme.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: J-juro que no lo soy. Solo... he estado de los nervios últimamente.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: Supongo que soné como un demente. O peor, creo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: ¿No me vas a dejar entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: ¿Podrías enseñarme cómo lo haces? Cómo matas a un Visitante. Quiero mirar al miedo a los ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: Y... si no es mucha molestia... después de que me hayas examinado...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: Gracias, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: Podría enseñarme... a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: Pero también, a lo mejor... o sea, si le apetece... pues...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: Por eso esperaba encontrar a alguien que... pudiera, um... protegerme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: ¿Y yo? Solo soy un co-cobarde. ¡No sé defenderme!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: Hoy en día, basta con mirar mal a alguien para que te disparen, ¡ya sabes!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: Hablaba de protegerme de los Visitantes. Y de la gente que los caza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: No, no... espera. No me refería a ese loco con el rifle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: Por eso necesito a alguien que entienda cómo funciona este mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: M-me asusta lo que pueda pasar si no aprendo a defenderme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: Antes, cuando todo era normal, no era capaz de matar ni a una mosca. Pero ahora... la gente blanda como yo no sobrevive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: No pretendía sonar como un demente. Solo que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: ¿Qué? Espera... ¿te parezco... raro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: ¿De quién exactamente intentas protegerte?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: ¿Por qué estás tan obsesionado con matar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: Y entonces, no seré yo quien viva con miedo... Serán los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: Qué más da. Algún día, yo... yo aprenderé a matar también.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: Por suerte no me vio. Podría haberme roto el cuello en ese mismo instante, ya sabes, era de esos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: Es solo que... hace no mucho me topé con un lunático armado. Lo vi interrogar a un hombre... no paraba de preguntarle si era un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: A ver, no me malinterpretes, no estoy intentando volverte en contra de nadie...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: ¡Perfecto! Entonces puedes acabar con cualquier Visitante que aparezca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: ¿De quién exactamente intentas protegerte?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: ¿Por qué estás tan obsesionado con matar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: Apuesto que hasta podrías matar a alguien con tus propias manos si fuera necesario, ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: Pero tienes una dureza en tu voz... Yo diría que tienes lo que necesario para matar si es necesario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: ¿Quién te juzgaría por matar a alguien en el apocalipsis? Se-sería como multar por exceso de velocidad en una carrera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: Es solo que... son tiempos peligrosos. ¿Sabes? Hay que saber si uno se las puede apañar. Si puedes e-eliminar una amenaza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: Ah... lo siento. No pretendía ser maleducado...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: Sí, tengo una escopeta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: ¿Por qué quieres saberlo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: Oye, ¿vas armado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: Eh, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: ¿Sabes qué? Que te den por saco. Me voy a hablar con tus vecinos. Adiós, gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: ¿Qué mierda te pasa? Te estoy hablando con el corazón, ¿y tú... me estás tomando el pelo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: ¿Lo dices en serio? ¡Mi marido está en la AFAE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: ¡¿Crees que soy una Visitante?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: Espera... ¿qué narices?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: En cuanto matemos a esos Visitantes, volveremos a vivir como es debido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: ¡Ahora sí que me gusta más!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: Toda esta palabrería de que "la AFAE no es para mujeres" es una gilipollez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: Trabajé en la frontera, joder. Tengo olfato para la gente sospechosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: No es justo, ¿sabes? ¿Acaso no soy tan buena como mi marido porque soy mujer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: ¿Qué más da? Ahora está en la AFAE. Y yo también podría estarlo, si no vivieran en la edad media.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: Je, como si te lo fuese a contar. ¿Por qué te interesa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: Pillé a muchos cabrones con toda clase de mierda encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: Trabajaba en aduanas, ¿sabes? Dejaba pasar a la gente por la frontera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: Una pena, de verdad. Sería muy buena para rastrear a Visitantes con mi esposo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: Je, ojalá lo fuera. Pero no, no aceptan a mujeres, como era de esperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: ¿Qué hacía tu marido antes de eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: ¿Tú también eres de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: Y el maldito taxista me estafó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: Quería darle una sorpresa, así que me dejé el sueldo en un taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: Cuando me enteré de que lo habían metido en la AFAE, ¡casi me da un ataque!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: ¡Oh, te lo digo bien alto y orgullosa! Ahora trabaja para la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: ¿Qué hacía tu marido antes de eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: ¿Tú también eres de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: En cuanto mi marido de la AFAE lo pille... Le hará tragarse esos dientes de perla. Je.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: Pero te juro por Dios que los dientes de ese taxista eran blancos como la leche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: Tuve que soltar una maldita fortuna. Esas cosas cuestan un riñón hoy en día.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: ¿Cómo? Cogí un taxi, ¡obvio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: ¿A qué se dedica tu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: ¿Cómo has llegado hasta aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: Pero resulta que en su trabajo no había sitio para mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: Pensé en darle una sorpresa con una visita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: He venido por mi marido. Lo han trasladado por su trabajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: Hola. ¿Le importa si me quedo aquí un rato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: Vale. Confié en ti... y destruiste mi fe en la humanidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: ¡La gente merece saber la verdad!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: ¡Estás cometiendo un error!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: ¡Créeme, he visto la pura verdad! ¡Olvida todas esas viejas mentiras que te han dicho!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: Sabía que podía confiar en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: Así que me fui con la cabeza en alto... Y con algunos archivos valiosos en mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: Si la gente hubiera usado tapones para los oídos... los parásitos no habrían podido entrar y miles se habrían podido salvar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: Pero esos tontos se negaron a ver el mérito de mis hallazgos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: Yo afirmaba que los Visitantes no son la amenaza real. Es lo que tienen dentro: parásitos cerebrales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: Solía trabajar en un instituto de investigación. Me despidieron por mis descubrimientos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: Pero debes jurar que esto se queda entre nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: Bueno, he decidido confiar en ti, así que te lo contaré...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: Deberías marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: Adelante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: ...por qué las patatas fritas con sabor a patata son tanto una abominación científica como un desastre sin sabor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: Control mental. A través de la comida rápida. Sí, en serio. Y finalmente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: Fraude electoral. Pruebas de que el aterrizaje en la Luna fue falso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: Uf, colega. Agárrate. Estoy a punto de abrirte los ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: ¿Cómo es que sabes todo eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: ¿Qué me estás contando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: Lo que significa... que puedo compartir algo importante contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: Pues, si lo negaste, entonces debes estar diciendo la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: Verás, según el protocolo, los agentes de la AFAE tienen la obligación de revelar su afiliación si se les pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: Ah. Bien. Eso quiere decir que puedo fiarme de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: ¿De dónde has sacado todo esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: ¿Qué clase de información?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: Estoy hablando de kilotones de datos, cosas que pienso hacer públicas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: Llevo conmigo unos documentos muy delicados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: Necesito un lugar seguro para esconderme. Un sitio para continuar mi investigación.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: ¡Confiarte información importante, claro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: No, no estoy con la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: ¿Confiar en qué sentido, exactamente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: No estás con la AFAE, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: Hola, ¿cómo te va? Dime... ¿puedo fiarme de ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: Toma, igual yo no lo necesito. Tíralo o úsalo como quieras.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: Es una orden para que fueramos a reportarnos a las zonas en cuarentena de la AFAE. ¿Pero por qué iríamos si todo aquel que va termina muerto?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: Nos dieron este papel en el trabajo antes de ir a apagar los fuegos.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: Al menos no tendré que morir solo, en el barro.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: No creo que vaya a incordiarte por mucho tiempo. Cof... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: Gracias, tío. Cof...'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
