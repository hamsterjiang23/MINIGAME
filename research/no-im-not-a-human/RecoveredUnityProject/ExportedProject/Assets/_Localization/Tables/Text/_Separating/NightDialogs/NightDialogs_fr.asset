%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_fr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 2e47acfd0901bcf4eba15f47b223778b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Bonjour… *tousse* *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: Mon vieux… Est-ce que vous pouvez me laisser entrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: Qui êtes-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: Que vous est-il arrivé ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: Je suis… *tousse* pompier.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: Je me suis fait avoir par le soleil pendant qu''on éteignait des feux de forêt aujourd''hui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: La fumée est si épaisse qu''elle nous empêche de brûler vifs, mais… *tousse* ça fait quand même sacrément flipper.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: Les arbres… *tousse* *tousse*… Ils ont cramé comme des allumettes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: J''avais jamais vu un truc pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: Il y a des carcasses d''animaux calcinées partout dans la forêt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: Pourquoi n'allez-vous pas à l'hôpital ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: Qu'est-ce que vous comptez faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Je me suis exposé au soleil en plein après-midi… *tousse*… pendant que j''éteignais les feux de forêt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: De toute ma brigade, je suis le seul à avoir survécu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Les autres… *tousse*… Le chef a refusé de les laisser partir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Maintenant, ils sont condamnés à éteindre des feux pour l''éternité.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: Pourquoi n'allez-vous pas à l'hôpital ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: Qu'est-ce que vous comptez faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: L''hôpital ?! Y a plus d''hôpitaux, mon vieux…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: Les hôpitaux ne servent plus à rien depuis que les Visiteurs ont débarqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: Difficile de se faire soigner si on ne peut pas faire confiance aux médecins.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: Bon sang… Personne va m''aider.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Je ferais mieux de retourner éteindre les feux et de crever avec le reste de ma brigade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: J''en ai plus pour longtemps, de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Allez-y, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: J''aurais préféré continuer à éteindre les feux de forêt. J''aurais voulu mourir à la place des gars.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Sauf qu''ils m''ont clairement fait comprendre… *tousse* *tousse*… que je servais plus à rien…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Je peux plus rentrer chez moi. Y a plus de transports en commun.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: Tout ce qu''il me reste à faire, c''est m''en remettre à la bienveillance des gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Allez-y, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Merci, mon vieux… *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: Je crois que je vais pas vous embêter trop longtemps de toute façon… *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: Au moins, je crèverai pas dans la boue.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Et merde… *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: Je veux pas mourir dans la boue.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: J''espère que… *tousse* *tousse* les feux vont pas se propager aux villes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: Hé, salut ! Comment ça va ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: Ça faisait un bail. Ça roule ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: On se connaît ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: Tu es qui, au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Sérieux ?! Tu me remets pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: On était…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Attends un peu… T''as une drôle de voix…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: À quand remonte le dernier changement de propriétaire ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Cette maison a toujours appartenu à ma famille.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Je crois que tu t'es trompé d'adresse.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Oh, tu n''es pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Tu n''es pas mon pote…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: Ça fait longtemps que tu habites ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Cette maison a toujours appartenu à ma famille.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Je crois que tu t'es trompé d'adresse.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: Non, impossible…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: Moi ? Me tromper ? Impossible… J''ai une mémoire d''éléphant !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: Mon pote habite… Enfin, il habitait ici, c''est certain.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Hé, j''ai fait un sacré bout de chemin. Tu me fais entrer ? S''il te plaît ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: Y a pas moyen… Je peux pas me…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: Non…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: Saperlipopette…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Je crois bien que je me suis trompé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Hé, j''ai fait un sacré bout de chemin. Tu me fais entrer quand même, s''il te plaît ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: Mais, ouais ! C''est ça qu''on aime !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: On va pouvoir faire la course chez toi ! D''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: Partir ? Qu''est-ce que tu racontes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: Bon sang… Tu veux vraiment que je reparte ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: C''est bon, je me tire. Espèce de gros malade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: Assez ! Arrête de gesticuler et tiens-toi tranquille.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Bonjour. Aidez-moi, s''il vous plaît.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: Qu'est-ce qui se passe ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: Qu'est-ce que vous me voulez ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: J''suis épuisée. J''ai vraiment besoin de dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: J''avais cinq enfants. Aujourd''hui, il me reste plus qu''la petite.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: Mon mari, il est aux abonnés absents… Soit il a clamsé soit il nous a abandonnés… J''en sais rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Tout ce que je sais, c''est que j''ai besoin de m''allonger et de dormir pendant trois ou quatre jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: Où sont vos quatre autres enfants ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: Est-ce que… vos enfants sont morts ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Pitié… Laissez-moi entrer pour que je puisse dormir un peu. J''suis tellement crevée…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: Avant, j''en avais cinq des gosses. Aujourd''hui, il me reste plus que celle-là.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: Je sais pas où chercher les autres. Je veux juste qu''on me laisse dormir en paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: Où sont vos quatre autres enfants ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: Est-ce que… vos enfants sont morts ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: J''en sais rien… Peut-être que leur père les a pris avec lui. J''irais bien voir chez lui, mais là, j''en peux plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Ouais, on n''arrêtait pas d''se crêper le chignon… C''est pas si surprenant quand on partage sa vie avec un connard…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Bien sûr que non… Mais bon, l''essentiel, c''est que je retrouve mes gosses.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Allez-y, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: Non, je vous en prie… Dites pas ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: C''est difficile de s''occuper d''une ribambelle de mioches qui tiennent pas en place, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: Il leur est rien arrivé de particulier. Ils sont sûrement chez ma mère.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Ils filent là-bas dès qu''ils en ont marre de moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: Ou quand leur père vient m''rendre visite pour me taper du fric…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: Vous voulez bien me laisser entrer ? Pour que j''puisse me reposer un peu… Après j''irai chercher mes enfants, promis.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Allez-y, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Enfin ! Je vais pouvoir me reposer un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Vas-y, magne-toi. Choisis-toi un coin où dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: On sera parties d''ici demain.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: Tant pis. Je vais essayer d''aller chez ma mère, alors.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Je sais pas si je vais y arriver…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: Non, il faut que j''y aille.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Concitoyen, bonjour.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Je suis de très mauvaise humeur, donc je m''excuse d''avance.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: Y a vraiment trop de crétins dans le coin. J''espère que t''en fais pas partie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: De qui tu parles exactement ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: T'es pas une de ces brutes, quand même ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: Ben, de tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: Ces crétins qui se retenaient seulement à cause de leurs croyances ou je sais pas quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: Et le jour où leur Dieu est mort à leurs yeux, ils ont perdu toute humanité.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: C''est vraiment des putains d''animaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Comme si ce problème avec les Visiteurs ne suffisait pas… Il faut aussi qu''on se tape des cas pareils.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: Pourquoi est-ce que t'es si tendu ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: Et… en quoi es-tu différent d'eux ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Bonne question.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: T''as dû remarquer qu''il y a deux camps, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: D''un côté, il y a les sadiques. Ils sont encore pires que les Visiteurs…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: Ils ont aucun scrupule : ils te collent un flingue sur la tempe, appuient sur la gâchette, et hop, un de moins !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: Dans l''autre camp, des animaux. Si tu leur marches dessus, ils te diront merci de pas les avoir butés.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: Et dans les deux cas, ça me fait péter un câble.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: Pourquoi est-ce que t'es si tendu ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: Et… en quoi es-tu différent d'eux ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: Le prends pas personnellement. C''est juste que…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Après tout ce bordel avec le soleil et les Visiteurs… C''est comme si l''humanité avait disparu en même temps que Dieu…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: Et je suis en colère… Moi, je voulais juste vivre une petite vie tranquille, tu sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Je composais de la musique. Mais plus personne n''en a rien à foutre maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Moi, j''essaie juste de pas basculer dans un camp comme dans l''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: J''ai envie de croire que je suis différent.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: Tu sais, l''idée de devenir un monstre me terrifie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: Ou de me transformer en victime. C''est n''importe quoi, dans un cas comme dans l''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: Être victime, je crois que c''est pire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Tu restes là à attendre qu''on te casse la gueule, qu''on te casse les dents, ou pire encore.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Si t''avais vu ce que j''ai vu, toi aussi tu serais en colère.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: T''inquiète pas, je vais pas embêter qui que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: Ni tabasser qui que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: Je me défoule sur moi-même pour éviter de faire du mal aux gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Putain, t''es aussi minable que tous les autres lâches.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Reste assis bien sagement chez toi en attendant qu''ils viennent te casser la gueule.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: Putain…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Je sens… Je sens qu''ici… Ici, l''énergie a beaucoup de mal à circuler.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: Il y a quelque chose d''extrêmement négatif.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: Le Soleil, le Lion, la Cinquième maison. Je vois…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: Vous êtes quelqu''un de très déterminé, je me trompe ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: Quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: Merci, mais je n'ai besoin de rien.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Je vois… Vous êtes du genre à préférer agir plutôt que parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: C''est tout à fait typique d''un Lion, vous savez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: Et ici… Vous avez accumulé une énorme quantité d''énergie négative du bas astral.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: J''ignore encore pourquoi…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Tout a l''air tellement négligé… Je crois que je ferais mieux de rééquilibrer l''énergie avec quelques mantras.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Mais pourquoi vous me racontez tout ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: D'accord… Dites-m'en plus…
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: Je ne suis pas en train d''insinuer quoi que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: En revanche, je peux vous aider à comprendre la relation de cause à effet, si vous voyez ce que je veux dire…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Le karma, le yin et le yang… C''est comme des poissons qui tournent en rond.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Chacun y trouve son compte. Vous faites votre part, je fais la mienne… Vous me suivez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Mais pourquoi vous me racontez tout ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: D'accord… Dites-m'en plus…
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: J''imagine à quel point ça doit être stressant pour vous, étant donné que vous êtes ascendant Capricorne.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: Vous jonglez avec plusieurs constellations en votre for intérieur. Vous êtes quelqu''un de très complexe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: On peut recourir à certaines formules pour atteindre les profondeurs de votre conscience. Vous me suivez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Tout finira alors par rentrer dans l''ordre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Entrez, je vous en prie.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: Je vois des gardiens de prison dans votre famille… et dans vos réincarnations.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Faites-leur un peu de place. Tout ce que vous faites, c''est reproduire les expériences de vos vies antérieures.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Vous devez leur pardonner et vous réconcilier avec vous-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Il n''y a que comme ça que vous pourrez briser le cercle vicieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: Vous me suivez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Entrez, je vous en prie.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Très bien. Pour tout vous dire, vous êtes dans une situation très favorable.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: Il y a maintenant une énergie positive qui circule dans votre maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: Donc, le développement personnel… Vous en pensez quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: Vous n''avez pas envie de devenir une meilleure version de vous-même ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Comme c''est dommage…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Je vais utiliser une ou deux prières pour vous refiler la courante…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Bonsoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: Je travaille pour la FEMA. On fait le tour du quartier.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: Est-ce que vous êtes seul ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: Pourquoi devrais-je vous faire confiance ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: Non, bien sûr que non.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: Mon équipe a été divisée en plusieurs petits groupes pour couvrir une plus grande zone.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: Cette discussion ne prendra pas beaucoup de temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: Pourquoi portez-vous des équipements de protection ? Est-ce que moi aussi je devrais en porter ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: Comment pensez-vous pouvoir nous aider ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: Je peux vous montrer mon badge.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: Et puis, les Visiteurs ne se déplacent quasiment pas en groupe. Peut-être même jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: Pourquoi portez-vous des équipements de protection ? Est-ce que moi aussi je devrais en porter ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: Comment pensez-vous pouvoir nous aider ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: Non, mais vous pouvez en acheter si vous estimez que c''est nécessaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: En ce moment, on étudie les effets du soleil sur l''environnement.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: Comme on est régulièrement exposés au soleil, on doit faire attention.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: Et après ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: Est-ce que vous suivez un plan d'action précis ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: Notre priorité est de rassembler des informations. Nous les transmettrons ensuite à notre direction.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Ainsi, elle pourra mettre une procédure d''intervention en place.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: Pour l''instant, la meilleure chose à faire est de rester calme.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: Et après ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: Est-ce que vous suivez un plan d'action précis ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Je vais emmener une personne avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: On lui fera passer des tests pour s''assurer qu''elle est en bonne santé et qu''elle peut habiter ici sans danger.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: Et bien sûr, on vérifiera qu''il s''agit bien d''un être humain.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: Est-ce que je dois préparer une valise ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: Je dois juste attendre la suite des événements, alors ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Bien sûr. On ne peut pas faire ça comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: On va emmener quelqu''un de votre zone au laboratoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: On y fera quelques tests pour s''assurer que tout va bien et ensuite on ramènera la personne en question.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: Est-ce que je dois préparer une valise ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: Je dois juste attendre la suite des événements, alors ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: Est-ce que c''est votre domicile ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: Dans ce cas, non. Restez avec les autres résidents. Nous vous informerons si vous devez être évacué.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Nous n''emmènerons qu''une seule personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: Bonne nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Oui. Une fois que nous aurons toutes les informations nécessaires, on vous communiquera la marche à suivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: Inutile de vous inquiéter pour l''instant.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Nous n''emmènerons qu''une seule personne et nous ferons notre possible pour qu''elle rentre rapidement chez elle.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Prenez soin de vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: Ainsi, nos routes se croisent à nouveau…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: Si j''ai bonne mémoire, les choses étaient différentes la dernière fois. Cela dit, nous sommes toujours en vie…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Hmm… C''est assez étrange… Je ne peux pas me l''expliquer…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Mais j''aimerais commencer cette conversation avec… une action.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: Auriez-vous l''amabilité de prédire mon avenir à l''aide d''un livre ? À quelle page voulez-vous que je l''ouvre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Commençons par le commencement.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Ouvrez le livre au milieu.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Ouvrez-le à la fin.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: « Les morts se risqueront à parler, mais personne n''écoutera leurs paroles. »'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Bonté divine…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: C''est tellement pertinent…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Enfin, ça n''a rien d''étonnant au jour d''aujourd''hui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: Qu'est-ce que ça peut bien vouloir dire ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: Vous croyez vraiment à ces histoires ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: Qui êtes-vous, au juste ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: « Moi ? Moi, je suis moi. Et vous ? Vous, vous étiez chez vous. »'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Hmm. Oui. Quelle histoire tragique…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: Est-ce que c''est vraiment ce qui nous attend ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: C''est fort probable.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: Qu'est-ce que ça peut bien vouloir dire ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: Vous croyez vraiment à ces histoires ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: « C''était il y a tellement longtemps. Peut-être que ce n''était qu''un rêve. Peut-être même que toi, moi et le poisson…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: … n''existons que dans la mémoire d''un être depuis longtemps disparu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Peut-être que personne n''existe vraiment… Et peut-être que dehors, il ne fait que pleuvoir. »'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Hmm… Ou ce sera peut-être bientôt le cas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: Qu''en dites-vous ? Sommes-nous déjà le rêve de quelqu''un… Ou allons-nous le devenir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: C''est une réflexion particulièrement intéressante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: Qu'est-ce que ça peut bien vouloir dire ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: Vous croyez vraiment à ces histoires ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: J''ai besoin de temps pour réfléchir. Vous en pensez quoi, vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: Quoi qu''il en soit… Si je suis venu ici, c''est pour vous dire quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Plusieurs événements sont sur le point de se réaliser…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Il faut que vous soyez prêt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Ça va vous paraître bizarre, mais… Vous devez laisser entrer la personne qui a un chat.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: Je suis sûr que cela vous sera d''une grande aide… Même si j''ignore encore comment…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: De toute façon, c''est à vous de décider ce que vous voulez faire de cette information.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: Pour ma part, je m''en vais méditer sur le sens de la divination que vous avez choisie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: Pas complètement.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: Il vaut mieux y voir un conseil… Pour éviter d''oublier quelque chose ou pour faire attention à ce que l''on fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Maintenant que j''y pense, j''ai eu connaissance d''un fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Vous allez bientôt rencontrer une personne qui a un chat. Il est primordial que vous la laissiez rentrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: J''ignore encore pourquoi. Mais cela devrait vous faciliter la vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: À présent, je dois aller méditer sur le passage que vous avez choisi dans le livre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Bien le bonjour, humain.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: Comme nous avons de la chance ! Nous sommes témoins de la punition infligée aux humains pour leur dépravation.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: La Terre est en train d''être purifiée. Le Soleil fait son œuvre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: Et nous voilà en route vers un monde nouveau, un monde pur !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: ADMIREZ CETTE PUTAIN DE BÉNÉDICTION !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: Quoi ?!
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Vous me faites peur.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: Qu''est-ce que vous croyiez, HUMAIN ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Écoutez, je vais vous résumer la situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: Si le soleil nous brûle et nous RÔTIT, ce n''est pas sans raison ! Il nous purifie de nos péchés !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: Nous avons commis toutes sortes d''erreurs, tous autant que nous sommes ! ET NOUS AVONS MIS LE SOLEIL EN COLÈRE !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: IL NE FAIT QUE NOUS INFLIGER CE QUE NOUS MÉRITONS !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: C''est une bénédiction. Toutes les iniquités vont être effacées ! Nous allons enfin vivre comme nous le devons.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: Mais alors… On va tous mourir ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: Et vous, qu'est-ce qu'il va vous arriver ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: Ça tourne pas très rond là-dedans, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Écoutez, je vais vous résumer la situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: Si le soleil nous brûle et nous RÔTIT, ce n''est pas sans raison ! Il nous purifie de nos péchés !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: Nous avons commis toutes sortes d''erreurs, tous autant que nous sommes ! ET NOUS AVONS MIS LE SOLEIL EN COLÈRE !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: IL NE FAIT QUE NOUS INFLIGER CE QUE NOUS MÉRITONS !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: C''est une bénédiction. Toutes les iniquités vont être effacées ! Nous allons enfin vivre comme nous le devons.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: Mais alors… On va tous mourir ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: Et vous ? Que va-t-il vous arriver ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: Bien au contraire !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Nos péchés disparaîtront. Il en ira peut-être de même pour le Soleil lui-même. MAIS NOUS, NOUS VIVRONS.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: Il n''y aura plus de morts, plus de vols, plus de pourris avides qui refusent de me vendre ce qu''il me faut au bon prix.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: Vous imaginez un peu ? Vous réalisez ce que ça veut dire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: Je ne vois pas en quoi tout ça me concerne…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: Dès que le Soleil nous aura pardonnés, nous pourrons tous VIVRE EN PAIX.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: C''est grâce au Soleil qu''on s''en sortira ! Est-ce que vous vous en rendez compte ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: C''est pour ça que vous êtes encore en vie, vous comprenez ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: Je pourrais vous en dire beaucoup plus à ce sujet !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Oh, j''ai oublié de vous demander : est-ce que vous auriez de la bière par hasard ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: Vous faisiez semblant de ne rien comprendre à propos du Soleil, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: Eh bien, dans ce cas, allez vous faire voir ! Je vais aller sauver quelqu''un d''autre !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: Adieu ! ADIEUUUUUU !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: Bonsoir !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Excusez-moi, il est tard… Mais il a fait si chaud aujourd''hui qu''ils ont dit de ne pas s''exposer au soleil à la télé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Est-ce que vous auriez un peu de place pour moi à tout hasard ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: Euh… Qui êtes-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: Comment vous êtes-vous retrouvée ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Eh bien, j''habitais tout près de la ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: Évidemment, vous imaginez bien que l''asphalte est assez brûlant par là-bas. Hé hé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: À vrai dire, j''étais caissière. À une époque… Mais plus maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: J''ai été licenciée. J''ai vraiment pas de chance en matière de travail…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: Vous comptez faire quoi du coup ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: D'après vous, qu'est-ce qui va se passer ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: Je n''avais pas prévu de venir ici. L''asphalte commence déjà à fondre sous nos pieds, mais ce n''est pas ça le pire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: Vous allez rire, hé hé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: J''ai fait entrer des Visiteurs chez moi. Et ils m''ont chassée de ma propre maison. Vous imaginez un peu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Donc maintenant, je cherche un endroit où me mettre à l''abri du soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: Vous comptez faire quoi du coup ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: D'après vous, qu'est-ce qui va se passer ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Je vais faire mon possible pour survivre. Je suis morte de trouille avec ces Visiteurs partout et ce soleil infernal…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Pouah ! J''aimerais tellement m''en sortir vivante, hé hé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: Vous n''avez pas peur, vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Par pitié, dites-moi que tout ça ne va pas durer longtemps…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Entrez !
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Vous n'avez rien à faire ici !
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: Je ne sais pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: Comment faire pour survivre ? Qui va m''aider ? Est-ce que je vais devoir chercher de l''aide encore longtemps ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: Je n''ai aucune idée de ce qui va se passer. Je n''ose même pas imaginer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: Vous n''avez pas peur, vous ? Moi, je suis terrifiée.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Entrez !
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Vous n'avez rien à faire ici !
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Merci. Ha ha ! Mille fois merci !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Je vais pouvoir vivre encore un peu, grâce au ciel.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Ouf… Ha ha ! D''accord, bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Merci d''avoir pris le temps de m''écouter, en tout cas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: Hmmm… Bon, je devrais y aller, alors.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: Au revoir ? Oui… Hmpf, au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: Est-ce que je peux entrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Je me suis réfugié au bar, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Ils m''ont foutu à la porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: Pourquoi ? Hmpf. C''est pas tout le monde qui peut supporter mon caractère…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Pourtant, je ferais pas de mal à une mouche… C''est juste que… Parfois, la vie fait pas de cadeaux, tu sais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: Alors ? Je peux entrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: T'es pas un Visiteur, au moins ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: Tu promets que tu vas pas faire d'histoires ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: Tu m''as pris pour un de ces monstres ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: Non, je suis pas un Visiteur. Ceci dit… C''est complètement débile de poser cette question à tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: Mais bon, j''imagine que les choses sont pas différentes ici, de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: Pourquoi t'ont-ils viré de ton ancien refuge ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: Qu'est-ce qui te fait croire que ça se passera mieux ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: Qu''est-ce que tu entends par « faire des histoires » ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: Je suis pas du genre à me battre ni à tuer. Par contre, hors de question que je me laisse marcher sur les pieds.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Moi, j''aime bien boire et manger. Et si je suis d''humeur, j''aime bien discuter. C''est ça, « faire des histoires » ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: Pourquoi t'ont-ils viré de ton ancien refuge ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: Qu'est-ce qui te fait croire que ça se passera mieux ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: J''ai vraiment envie de mal te répondre, mais je vais me retenir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: C''est comme j''ai dit : là-bas, les gens ne m''aimaient pas. Qui sait pourquoi…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: À bien y réfléchir, ils m''ont peut-être banni pour de bon.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Ils auraient tout aussi bien pu me manger tout cru, personne n''aurait rien remarqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: Qu''est-ce que je suis censé faire maintenant ? Rôtir sous le soleil ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: Non, pas moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Tant que je serai en vie, je chercherai de la compagnie. Tu veux pas de moi ? Je vais tenter ma chance ailleurs, alors.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: Pour peu que la chance soit encore de ce monde, et qu''il reste encore une personne de bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Merci. Désormais, faire confiance aux gens ne vaut pas un pet de lapin…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Mais merci de ta confiance. Peut-être que… Non, je peux rien te promettre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Tsss… Je comprends.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Je comprends, mais ça m''énerve. T''es aussi lâche que tous les autres en fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Dormez bien, mon bon monsieur. Et allez bien vous faire foutre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: Est-ce que je peux entrer pour me reposer un peu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: D'où venez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: Et où allez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: Je ne sais plus, mais ça n''a pas vraiment d''importance.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Je suis à bout de forces. Si je ne me repose pas un peu, je vais tomber dans les pommes sur le pas de la porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: Votre compagnon est malade, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: On dirait que votre ami a besoin d'aide, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Je… Je veux juste m''écrouler quelque part et ne plus jamais me relever.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: Peu importe où.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: Votre compagnon est malade, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: On dirait que votre ami a besoin d'aide, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: C''est mon mari.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Il est mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: Je ne peux pas lui offrir un enterrement digne de ce nom. À quoi bon me séparer de lui maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Mieux vaut que vous partiez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Plus maintenant. Personne ne l''a aidé lorsqu''il en avait le plus besoin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: À présent, il est mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Il aurait pu vivre si…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: Si quelqu''un en avait eu quelque chose à foutre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Mieux vaut que vous partiez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: Je crois que je ne vais pas rester longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: J''ai juste… besoin de me reposer un peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Vous…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: Salut !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: T''as vu ce qui se passe ? C''est de la folie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: Comment ça se passe pour toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: Qu'est-ce que tu veux ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: C'est quoi ton manège, exactement ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Rien, rien… Je suis curieux, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: En fait… J''ai une p''tite combine à te proposer… Tu pourrais te faire de l''argent facile, si ça te dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Avec un soleil pareil, on peut se faire du blé sans se prendre la tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: Pendant que tous les ratés flippent, toi, t''aurais juste à te baisser pour ramasser la maille, mec !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: Pourquoi est-ce que tu es ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: Qu'est-ce que tu proposes ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Des nouvelles opportunités, pardi ! T''es aveugle ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Ils sont tous en train de courir comme des poulets sans tête, alors qu''il suffirait d''écouter leur cœur.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: Tous ces gens… Ils ont besoin d''être heureux, si tu veux mon avis.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: Pourquoi est-ce que tu es ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: Qu'est-ce que tu proposes ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: Tu tournes pas autour du pot, toi !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Tout le monde pense que tu manigances quelque chose ici. Que t''es là pour semer la pagaille.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: Franchement, on pourrait se faire la fête de nos vies ici !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Fiche le camp…
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: Tu veux t''en tirer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Faut préparer ton coup tant que c''est encore possible, oublie le soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: Faut te bouger, tu piges ? T''es chaud ou bien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Fiche le camp…
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: Bien joué, mon pote ! C''est ça que je voulais entendre !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Enfin quelqu''un d''intelligent.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: T''es vraiment un abruti, hein. Mais bon… Tant pis… Va te faire foutre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: J''irai voir ton voisin, alors.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Allez, ciao.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Salut, voisin. Ça faisait un bail, dis donc ! Comment ça va ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: Comme d'habitude.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Bien.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Écoute, je passe te voir pour une raison précise. Je me fais un peu de souci pour toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Y a un sale truc qui se prépare…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: Ma cousine m''a appelé. Aux infos, chez elle, ils disent qu''il se passe un truc bizarre avec le soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: Et y a des types qui sortiraient de sous la terre… Ils les appellent les Visiteurs, va savoir pourquoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: C''est vraiment flippant. J''espère que c''est juste une rumeur.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: Qu'est-ce qui se passe avec le soleil ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: Des Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Écoute, je passe te voir pour une raison précise. Je me fais un peu de souci pour toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Y a un sale truc qui se prépare…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: Ma cousine m''a appelé. Aux infos, chez elle, ils disent qu''il se passe un truc bizarre avec le soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: Et y a des types qui sortiraient de sous la terre… Ils les appellent les Visiteurs, va savoir pourquoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: C''est vraiment flippant. J''espère que c''est juste une rumeur.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: Qu'est-ce qui se passe avec le soleil ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: Des Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Soit il va exploser, soit quelque chose va péter à sa surface…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: Tout ce que je sais, c''est qu''il y a un truc qui cloche.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: T''as bien vu que cet été, on a battu tous les records de chaleur, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: On ferait mieux de se préparer au pire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: D''après ma cousine, mieux vaut éviter de rester seul chez soi… Ça pourrait être dangereux.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: Donc je suis venu pour passer un peu de temps avec toi, histoire de m''assurer que tout va bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: Ah, d'accord.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: Je peux me débrouiller tout seul.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: Et ta femme ? Et ta fille ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Ouais. C''est comme ça qu''ils appellent ceux qui vivent sous terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: Je ne sais pas d''où ils sortent un nom pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: Peut-être parce qu''ils sont venus d''ailleurs pour visiter la Terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: Ou parce qu''ils cherchent à s''introduire dans les maisons.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: D''après ma cousine, mieux vaut éviter de rester seul chez soi… Ça pourrait être dangereux.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: Donc je suis venu pour passer un peu de temps avec toi, histoire de m''assurer que tout va bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: Ah, d'accord.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: Je peux me débrouiller tout seul.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: Et ta femme ? Et ta fille ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: Il est tard… On reparlera de tout ça demain matin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: Je vais m''asseoir un peu dans ta cuisine.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: À demain matin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: Je sais. Mais si tu veux mon avis, c''est plus dangereux que tu ne le crois de rester seul en ce moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: Et si je restais avec toi cette nuit, juste au cas où ? Ça me rassurerait…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: T''inquiète pas pour ma femme et ma gosse. Un ami de confiance est à la maison, il veillera sur elles.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: Il est tard… On reparlera de tout ça demain matin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: Je vais m''asseoir un peu dans ta cuisine.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: À demain matin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: T''inquiète pas. Un ami de confiance est à la maison depuis quelques jours, il s''occupera de ma famille.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: Il est tard… On reparlera de tout ça demain matin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: Je vais m''asseoir un peu dans ta cuisine.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: À demain matin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: Coucou !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: Est-ce que mon papa est là ? Tu peux aller le chercher ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: Tout allait bien tout à l''heure, mais là, j''ai peur. Il y a plein de gens qui traînent dehors la nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: Il s'appelle comment, ton papa ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Raconte-moi quelque chose sur ton papa.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: T''as oublié son nom ? Ah… Tu veux t''assurer que je suis pas un Visiteur, c''est ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: T''es malin ! Moi aussi, je vais commencer à tester les gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: T'as pas eu de problème pour arriver jusqu'ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: Tu as peur des Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Mmm, je connais pas mal de trucs sur lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: Avant de s''en aller, il aime bien boire une petite bière, hé hé !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: Il prépare mon déjeuner et mon dîner. Et du jus de fruits.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: J''ai goûté la bière qu''il a bue aujourd''hui. Beurk ! C''est vraiment pas bon !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: Pourquoi il boit un truc pareil alors qu''il y a du jus de fruits ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: Oh, pitié, pitié ! Surtout, ne lui répète pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: T'as pas eu de problème pour arriver jusqu'ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: Tu as peur des Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: Tu sais, c''est comme si tout avait été chamboulé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: Maintenant, les gens restent chez eux et dorment toute la journée. Et la nuit, ils sortent et ils s''activent.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: J''ai toujours peur du noir, mais on dirait qu''il n''y a rien à craindre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: Enfin… est-ce que c''est vraiment le cas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: Je vais aller chercher ton père. Fais attention à toi !
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: Passe une bonne journée !
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: Je ne sais pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: Tout le monde a peur d''eux, alors moi aussi j''ai peur… Même si j''en ai jamais vu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: Et s''ils étaient effrayants ? Et s''ils tapaient super fort ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: Si un camarade de classe me tape, est-ce que ça veut dire que c''est un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Papa m''a dit de faire attention. Alors, je fais super attention !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: Je suis venue ici sur la pointe des pieds, comme une souris. Personne m''a vue !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: Je vais aller chercher ton père. Fais attention à toi !
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: Passe une bonne journée !
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: Merci, toi aussi !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: Bah dépêche-toi, alors ! Sinon je vais avoir trop peur toute seule ce soir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: On va jouer à un jeu qu''il a inventé pour moi. Il faut lancer des dés !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: Et ensuite, on se déplace en utilisant des objets ! Comme le fauteuil ou le canapé…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: Il faut construire une route. Je te montrerai plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: À bientôt !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: C-Coucou.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: L-Laisse-moi entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: Tu as l'air paniqué, je me trompe ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: Qu'est-ce qui s'est passé ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: J-Je s-sais p-pas quoi f-faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: D-des gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: E-euh…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: Ils… Ils ont tué mon p-pa…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: M-m-m… mon…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: P-papa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: Qui a fait ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: Pourquoi ont-ils fait ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: Euh…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: M-m-mon p-papa…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: Ils ont… Ils ont…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: I-Ils ont tué mon papa…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: Qui a fait ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: Pourquoi ont-ils fait ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: Des V-V-Visiteurs sont venus à la maison. Ils se sont assis avec n-nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Papa était en train de leur p-p-parler de quelque chose. Et puis ils l''ont… ils l''ont tué.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: Il… Notre… *sanglote*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: Et maintenant… notre m-maison est en train de b-b-brûler.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: J-J-Je… Je sais pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: Ils p-p-passaient juste un moment avec papa dans la c-cuisine.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: Et puis ils ont f-f-fait quelque chose, et p-puis ils ont mis le feu à la maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: Et quand que j-je me suis enfuie, ils r-r-rigolaient…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: Tu vas m-m''aider ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: J''ai tellement p-p-peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: Où est-ce q-q-que j-j-je vais b-b-bien pouvoir aller ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: Oinnn…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: OINNNNNN…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: J''AI SI P-P-PEUR.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: Bonjour !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: Qu'est-ce que tu veux, toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: Je ne vais pas te laisser entrer.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: C''est une grande maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: Je l''aime bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: J'ai besoin de rien, au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: J'ai un flingue, je te signale.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: Elle est bien belle, ta porte… Elle est solide, j''espère ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: On n''est jamais trop sûr de rien…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: Si tu vois ce que je veux dire…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: J'ai besoin de rien, au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: J'ai un flingue, je te signale.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: Ouais, ouais, je sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Dis-moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: T''es tout seul chez toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: Non, je suis pas seul.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Oui, je suis seul.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: Génial !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: Le désespoir… ça pousse même les plus lâches à tenter des trucs insensés.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Enfin bref…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: Y a quelqu''un avec toi, ou t''es tout seul ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: Non, je suis pas seul.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Oui, je suis seul.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: C''est ton jour de chance.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: J''entends quelqu''un chuchoter à l''intérieur.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: Mais qui sait ce qui peut se passer d''ici quelques jours ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: Hahaha !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: Je sais bien que tu vis seul…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: Je voulais juste voir si tu allais mentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: Je vais ouvrir la porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: Hé ben, mon grand ! Ça m''a lessivée de venir jusqu''ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: Tu m''ouvrirais pas, que je repose mes vieux os deux minutes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: Est-ce que vous êtes venue directement ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: Vous avez beaucoup marché ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: Non, pas directement, pour sûr…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: La vie place sur ton chemin ceux dont tu as besoin. On ne passe jamais dans le vide.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Si j''suis là, c''est que mes guiboles et mes mirettes m''ont portée jusque chez toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: C''était écrit, j''imagine.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: Vous m'avez perdu, là… Vous avez besoin de quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: Vous auriez pu continuer à marcher. Pourquoi vous êtes-vous arrêtée ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: Oh, j''pourrais pas dire. Le temps, c''est toujours long quand on y pense trop.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: T''as beau être chez toi, tu marches comme si tu cherchais encore la sortie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: Tu aussi marches depuis longtemps, pas vrai ? Ça se voit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: Mais moi, j''ai marché plus de décennies que toi t''as vu d''assiettes pleines.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: C''est la vie, mon poussin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: Vous m'avez perdu, là… Vous avez besoin de quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: Vous auriez pu continuer à marcher. Pourquoi vous êtes-vous arrêtée ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: Qu''est-ce qu''il faut aux gens, au fond ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: Juste entendre deux-trois histoires, dire quelque chose qui fait sourire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: Puis s''allonger, fermer les paupières avec le cœur léger.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: Respirer en paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: Moi, j''en demande pas plus. Mais bon… vivre seule, c''est d''un triste, tu peux pas savoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: On dirait que t''as pas écouté un traître mot de ce que j''ai dit, mon petit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: J''en ai plein les pattes de marcher.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: Ici, j''pourrais au moins reprendre mon souffle et bavarder un brin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: C''est tout c''qu''il faut pour divertir une vieille bique comme moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: Tu me dis un p''tit truc, j''t''en raconte un autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: Et après, j''pourrai peut-être piquer un p''tit roupillon.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: Merci, mon petit !'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: J''crois pas que je vais m''ennuyer avec toi. Au moins, je verrai ce qui se passe dans le coin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: Où que j''aille, on me ferme la porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: J''ai beau avoir les ailes coupées, j''ouvre encore la bouche pour pousser la chansonnette.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: Et pourtant, tôt ou tard, ils reviennent vers moi. À reculons, peut-être, mais ils reviennent.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Moi, je garde pas rancune. J''tends la main à tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: Même toi, tu auras besoin d''aide un jour. Et vers qui tu te tourneras, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Bonjour. Oh, appuie-toi sur moi pour l''instant.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: Ça ne vous dérange pas qu''on soit ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: Elle est malade, votre copine ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: Vous êtes toutes les deux malades ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: C''est ma sœur. Elle est déprimée.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: Elle ne peut plus marcher ni se laver toute seule. Ni même sortir du lit, parfois… C''est compliqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: Mais ça va bien finir par s''arranger. Pas vrai, frangine ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: Elle ne veut pas trop parler pour l''instant… Mais parfois, ça lui arrive… Un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: Qu'avez-vous l'intention de faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: Ça ne vous fatigue-t-il pas de la transporter partout ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: Tout le monde souffre de dépression à un degré ou à un autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: On avait déjà une idée de la tournure que prendraient les choses avant même que le soleil ne fasse des siennes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: Vous suivez l''actualité ? Tout convergeait vers ce scénario. Cela dit, je ne crois pas que le soleil explosera.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: Qu'avez-vous l'intention de faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: Ça ne vous fatigue-t-il pas de la transporter partout ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: Je dois trouver un endroit où ma sœur se sentira un peu mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: Après, on pourra commencer une nouvelle vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: Vous croyez que nos vies sont fichues ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: Je ne suis pas d''accord. Les choses vont s''améliorer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Entrez, je vous en prie.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: Il est temps que vous partiez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Faites attention à ce que vous dites.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: C''est vrai que c''est épuisant, mais je ne peux pas l''abandonner, si c''est ce que vous insinuez.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: On a quitté la maison de nos parents ensemble. Maintenant, on ne peut compter que l''une sur l''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Entrez, je vous en prie.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: Il est temps que vous partiez.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: Merci ! Aidez-moi à la faire entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: La mort de nos parents l''a encore plus fragilisée, mais elle est comme ça depuis longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Peut-être qu''ici, elle reprendra du poil de la bête.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Aïe… Bon, sœurette, il faut qu''on essaie de trouver un autre endroit où s''abriter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: Allez, viens. Aide-moi un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: Bonté divine… Quand est-ce que ça va s''arrêter…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: Avant qu''on parte éteindre l''incendie, ils nous ont donné un document au travail.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: Ils voulaient qu''on aille dans les zones de quarantaine de la FEMA. Mais pourquoi ? Tous ceux qui y vont meurent…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: De toute façon, je n''en ai pas besoin. Jetez-le. Ou servez-vous-en pour autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: J''ai un… *tousse* *tousse* *tousse* papier sur moi. C''est plutôt important.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: Je veux bien vous le donner si vous me laissez entrer pour que je puisse vivre mes derniers moments en paix…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: D'accord, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Non, gardez-le
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: C''est quoi ce bordel ? Hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: D''après ce que je vois, t''es qu''un mec banal. Peut-être qu''un Énerjéka pourrait te faire changer d''avis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: Pousser mon popotin jusqu''ici, ça m''a tué ! C''était pas une mince affaire, crois-moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: D'accord, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: Tiens, prends un Énerjéka ! Merci de m''avoir laissé entrer !'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: Putain… Fais chier…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: Putain, si ça tenait qu''à moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: Et si je te donnais un Énerjéka, et que tu me laissais entrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: Comme ça, tout le monde est content.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: D'accord, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: Dégage.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: T''en fais pas pour moi… Je suis juste… Putain… Peu importe…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: Prends l''Énerjéka.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: J''ai pas besoin de cette saloperie. Ce qu''il me faudrait, c''est juste réussir à me calmer, bordel.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: … Je vois que {0} est déjà là. J''ai pigé : ça respire doucement, ça baisse la tête pour pas se faire emmerder. Tsssk.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: J''peux pas les blairer. C''est soit cette merde, soit moi. Pas les deux.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: Vivre entouré de gens qui ravalent tout ce qu''ils pensent ? C''est au-dessus de mes forces.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: Je vais gérer. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: Pas de problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: Merci d''avoir parlé quand il le fallait.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: Je vais essayer… Enfin, tu vois ce que je veux dire…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Et voilà…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: Mieux vaut rester avec ceux qui en ont bavé.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: J''en ai rien à foutre de toi. Tu peux aller au diable.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: Il s''agit là d''une généreuse récompense de la part du SAINT SOLEIL. Parce que vous le méritez. Prenez cet Énerjéka !'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: Comment peut-on être aussi stupide ?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: Vous repoussez un HOMME JUSTE !'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: Si vous me laissez entrer, le SAINT SOLEIL vous récompensera généreusement. Réfléchissez bien, mon brave !'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: D'accord, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: Du balai !
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: Personne ne sait ce qui s''est passé après l''arrivée du dernier Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: La maison est restée inoccupée pendant un petit bout de temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: Depuis ta disparition inquiétante, plus personne ne s''approche de cette maison abandonnée.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Eh ben, l''ami… qu''est-ce que t''as là, {0} ?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: Un instant, on entend du bruit, pis d''un coup, des chuchotis qui rampent dans les coins… J''aime pas ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: Moi, j''traîne pas toute seule pour le plaisir. Trop de voix, ça m''égratigne l''âme. Trop de têtes et j''perds la mienne.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Reste avec eux. Moi, je reste là jusqu''à ce que le vent se calme. Je vais pas m''aventurer dehors d''un temps pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: J''suis fragile, tu sais. J''risque de m''effriter.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: Je m'en occupe. Entrez donc.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: Si tu l''dis, j''vais faire l''effort. Mais si ça sent la pluie ou les boniments, j''m''en vais. J''suis trop vieille pour ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: Tu sais… J''ai jamais trop su pourquoi j''étais là. Alors, j''vais remballer mon sac d''histoires et filer droit devant.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Mais garde bien les yeux ouverts, mon p''tit. La vérité fait pas de bruit. Mais quand elle cogne, c''est fatal.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: S''il vous plaît…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Laissez-nous entrer, même si c''est juste pour une journée. On a quelque chose pour vous…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: Vous ne le regretterez pas, promis…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: D'accord, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: Du balai !
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: Mille mercis !'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Prenez donc cet Énerjéka. C''est tout ce qu''on a sur nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: Maintenant, aidez-moi à mettre ma sœur à l''abri…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: Probablement pas, {0} est ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: C''est comme si l''air était encore plus lourd que d''habitude. Comme si les pensées d''un autre oppressaient les miennes.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: Elle ne peut pas le supporter. Elle commence à… diminuer. C''est comme si elle arrêtait d''exister.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: J''ai… J''ai du mal à respirer, aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Désolée. On va attendre jusqu''à… jusqu''à ce que les choses se calment. Peut-être que ça va se dissiper.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: Je m'en occupe. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Merci. Attention, mettez une main dans son dos… comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: Je pense que le décès de nos parents… a brisé quelque chose en elle. Mais elle fait de son mieux pour tenir le coup.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: On est dehors depuis un moment. Je me disais qu''au moins, elle se sentirait un peu mieux ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: … Compris.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Frangine, accroche-toi encore un peu. Il faut qu''on tienne le coup. Là. Appuie-toi sur moi. Je suis là.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: Parfois, c''est juste… trop. Même une porte toute bête. Mais on doit avancer. Allez… un pas à la fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: Eh bien… C''est dommage.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: Merci beaucoup.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: Je prends pas de pots-de-vin, moi.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: Je vais m'en débarrasser. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: Dans ce cas, vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: Il y a {0}, ici. Je ne pense pas qu''on puisse s''entendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: Excusez-moi, mais je ne peux pas entrer pour l''instant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: Très bien, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: On a un accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: D''accord, très bien… Est-ce que ça, ça te conviendrait ? {0} ? Hmm ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: Enfin, j''ai l''habitude… Si tu vois ce que je veux dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: Dommage que ce soit toujours les connards qui s''en sortent bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: J''ai encore un peu de temps. Je vais trouver une autre solution.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: Bon.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: Merci. J''y croyais pas trop, mais je suis vraiment soulagée.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: Alors, c'est à toi de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: Je vais m'en débarrasser. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: Mais tu nous verras jamais ensemble dans la même pièce. Y a pas moyen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: C''est une longue histoire. Je vais pas t''embêter avec ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: Oh, regarde-moi ça… Il y a déjà {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: Un pot-de-vin ? Pour qui tu me prends ?
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: Bon, d'accord… Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: Est-ce que ça pourrait nous aider à nous mettre d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: Oh, regarde ce que j''ai trouvé ! {0} !'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: Tiens, laisse-moi te donner… Oh, oh ! Qu''est-ce que j''ai là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: Bon… Mais c''est la dernière fois que je me fais avoir, crois-moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: Tu me rappelles ces fichues banques. Tsssst.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: Très bien, je vais y aller alors. Il reste encore un peu de temps avant le lever du soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: Bon… Compris.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: Trinquons à la fin des dettes, d''accord ? Hahaha !'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: Ahhh… Voilà qui est beaucoup mieux !'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: Je vais m'en débarrasser. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: Moi, j''ai déjà eu mon lot de malchance dans la vie. Est-ce qu''on pourrait pas préserver cet endroit, au moins ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: Tu vois {0}, là-bas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: Impossible. Y a quelqu''un ici qui va pourrir l''ambiance.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: Je vois. Je comprends. Prends soin de toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: Mais vraiment… Merci de ta confiance !'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: Vraiment ?! Merci ! T''étais pas obligé… J''aurais peut-être pu trouver un autre endroit…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: C'est les plus gênés qui s'en vont !
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: Je vais m'en débarrasser, alors. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: Mais je pense pas pouvoir être à l''aise si je partage mon espace avec {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: Je sais que je t''ai déjà pris beaucoup de temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: Et franchement, c''était pas ma faute.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: Oh, merci beaucoup ! Mais… on dirait qu''il y a quelqu''un ici avec qui j''ai eu un problème au café.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: On ne m'achète pas, moi !
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: D'accord, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: Et si je te donnais quelque chose ? Comme… {0} ? Tu me laisserais entrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: De toute façon, c''est toi qui décides… Je vais m''en aller si c''est ce que tu veux.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: Tu penses vraiment que les gens qui tyrannisent les autres à cause de leur physique méritent d''être chez toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: Merci. J''avais vraiment pas envie de revivre ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: Dans ce cas, tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: Je vais m'en débarrasser. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: Mais, je connais {0}. C''est une de ces personnes qui m''a mené la vie dure à cause de mon apparence.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: Désolé, mais je ne pense pas pouvoir entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: Si tu t''entoures de tarés, y a de fortes chances que tu finisses par avoir des problèmes. Hi hi !'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: C''est peut-être mieux qu''on dorme pas sous le même toit, après tout…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: Sérieusement ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: Je ne devrais pas me mêler de ces histoires de tarés.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: Ça m''a l''air louche. Mais… tant pis ! Hi hi !'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: Très bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: Je vais le virer. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: Je le sais…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: C''est un vrai taré.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: Je sais ce qui s''est passé il y a un mois. Je le sais. Vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: Oh… Y a {0} ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: Mais fais attention à toi, d''accord ? J''espère que tu t''en sortiras.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: D''accord, l''ami. Je comprends. Sans rancune.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: Mince.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: C''est gênant… de devoir mettre quelqu''un à la rue comme ça. Mais parfois, il faut savoir arrêter d''être gentil.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: Et toi, tu la vois, la porte ?
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: C'est comme si c'était fait ! Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: Ouais, je veux dire… {0}, là-bas. Peut-être que tu devrais… mettre ce genre de personne à la porte ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: Je m''entends bien avec tout le monde, vraiment. Mais là, ça va être compliqué. Tous mes signaux sont au rouge !'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: T''es tellement… décevant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: Tu veux que je te dise ? Du courage, t''en n''as pas !'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: Sérieusement ?! Moi qui pensais que t''appréciais les gens qui ont du cran.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: Tu veux que je te dise ? Y a que des poltrons pour se faire virer aussi facilement…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: Ça, alors… Je pensais pas que tu le ferais !'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: C'est vous qui allez devoir partir.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: C'est comme si c'était fait. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: Non, non… Soit vous vous en débarrassez, soit je m''en vais.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: C''est qui, {0}, au juste ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: Bon, je ferais mieux de partir d''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: Punaise… La FEMA va me retrouver, c''est sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: J''aurais jamais dû venir ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: C''est pas vrai… Où est-ce que je suis censé aller ? J''ai déjà toqué à toutes les autres maisons.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: Merci, du fond du cœur.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: Vous n'avez rien à faire ici.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: Je vous en prie, laissez-moi rester chez vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: Et je n''ai nulle part où aller.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: Je suis resté à l''hôtel pendant un moment, mais là, je n''ai plus d''argent.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: Oh non…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: Vous n'avez rien à faire ici.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: Mais je suis là et je n''ai pas les moyens d''aller à l''hôtel. Je vous en prie, laissez-moi rester chez vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: Oui, c''est le moins qu''on puisse dire. Croyez-moi, si j''avais su ce qui allait se passer, je ne serais jamais venu ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: Vous n'avez vraiment nulle part où aller ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: Vous avez bien choisi votre moment pour faire du tourisme.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: Je suis juste de passage, à vrai dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: Mais ils ont fermé les frontières… Et maintenant, je suis coincé ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: J''étais en route pour la capitale… J''étais censé partir en voyage…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: Vous n'avez vraiment nulle part où aller ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: Vous avez bien choisi votre moment pour faire du tourisme.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: L''aéroport est fermé et les trains ne circulent plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: Je crois qu''il y a eu une erreur. Impossible de quitter la ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: Comment avez-vous atterri ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: Où est le problème ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: Bonjour. Pouvez-vous m''aider, s''il vous plaît ? Je ne suis pas d''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: Bon. Je vais y aller.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: Il reste des maisons. Peut-être que quelqu''un verra au-delà de mon apparence et agira comme un humain décent.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: La semaine a été super dure.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: On en reparlera demain, alors. Je suis complètement crevée aujourd''hui.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: Ah… Parfait.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: Entre donc.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: Le pire, c''est quand un nouveau rapport tombe et que tu réalises qu''il faut multiplier l''horreur par cinq… voire par dix.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: La télé, ça n''arrange rien de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: Je sais pas si t''as de l''électricité… Mais si c''est pas le cas, alors tant mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: Ici, l''air se rafraîchit la nuit. Et personne n''a les yeux rivés sur les infos 24 heures sur 24.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: Je vais passer outre les politesses et aller droit au but.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: Bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: Entre donc.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: Et je préfère pas être au premier rang quand tout va exploser.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: Si tu veux mon avis, on va droit dans le mur.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: Plus ça va, plus c''est pire. On peut plus respirer, les crimes se multiplient, la paranoïa règne dans les HLM.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: En plus, j''ai l''impression que les villes vont bientôt devenir très dangereuses.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: Les formalités, ça me gonfle. C''est tout. Je préfère aller à l''essentiel.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: Qu''est-ce qui te fait croire que je suis en train de fuir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: Tu penses que les choses vont s'arranger ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: Qu'est-ce que tu cherches à fuir ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: Mon apparence, ça veut rien dire. Moi, je veux du mal à personne. Et j''espère que t''es pas du genre à juger.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: Moi, j''ai rien fait de mal, alors tu peux arrêter de me juger tout de suite, OK ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: Hé ! Pas la peine d''être aussi désagréable, hein !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: Tu penses que les choses vont mieux se passer, ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: Qu'est-ce que tu cherches à fuir ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: Maintenant, le soleil cherche à nous faire rôtir… comme si les maniaques et les Visiteurs, ça suffisait pas !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: Et pas seulement dans la ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: C''est juste que… J''ai entendu dire qu''il se passait des trucs vraiment graves dans le coin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: Non… Je voulais pas dire que ta maison avait l''air abandonnée.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: Tu manques pas d'air, toi.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: Est-ce que ça a l'air abandonné, ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: Oh ! Y a quelqu''un ici ? Est-ce que je peux entrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: Arf… Je vais bien trouver une solution. J''ai encore un peu de temps avant le lever du soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: Bon sang…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: C''est vraiment pas possible ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: Tu te rends pas compte à quel point c''est un grand jour pour moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: Voilà, c''est ça qu''on aime ! Trinquons avec une bière ou deux pour fêter ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: Je préférerais que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: Alors, tu me laisses entrer ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: Si j''avais une maison comme ça, je serais au paradis, c''est sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: Tant pis. Toi, t''as pas d''emprunt à rembourser, après tout. T''as une belle maison, toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: Qu''est-ce que tu veux que je te dise ? De toute évidence, t''as pas l''air content pour moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: Je vois… T'es pas du genre bavard.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: Franchement, je trouve ça pas très drôle.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: Ça avait l''air super sarcastique, ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: Je vois… T'es pas du genre bavard.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: Le prends pas mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: Franchement, je préfère éviter d''en parler ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: Quelle bonne question !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: Cool ! Qu'est-ce que tu vas faire de tout l'argent que tu as économisé ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: Et… euh… Qu'est-ce que tu fais ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: C''est génial !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: Avec tout ce foutoir, plus personne n''en a plus rien à faire des banques ou des prêts !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: Maintenant… Je ne dois plus rien à personne !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: MAIS MAINTENANT !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: C''était un vrai cercle vicieux, tu vois ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: Tu sais, j''étais endetté jusqu''au cou.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: Cool ! Qu'est-ce que tu vas faire de tout l'argent que tu vas économiser ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: Et… euh… Qu'est-ce que tu fais ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: Enfin ! C''est comme si je pouvais de nouveau respirer. T''as pas idée.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: Mon pote… Non… Mon ami ! Je suis libéré de mon emprunt immobilier !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: Rohh, sois pas comme ça ! T''as pas encore compris.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: Pourquoi t'es si content ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: T'es complètement givré ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: Sacrée soirée, hein ? Tu trouves pas ? C''est magique !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: Hé, hé, hé ! Ça va ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: D''accord. Je comprends. Fais attention à toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: C''est bon de savoir qu''il existe encore des gens bien… Et pas seulement dans les contes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: Merci infiniment ! Je ne l''oublierai jamais !'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: J'ai pas besoin de pique-assiettes ici. Allez, du balai !
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: J''étais loin de m''imaginer que la vie d''adulte serait si compliquée… et j''ai nulle part où aller…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: Je te revaudrai ça un jour ou l''autre. Et promis, je vais tout faire pour me rendre utile.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: Je sais que j''ai pas grand-chose à offrir… mais je t''en supplie, réfléchis-y à deux fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: Je vois…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: J'ai pas besoin de pique-assiettes ici. Allez, du balai !
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: Ça m''étonnerait que je sois le sauveur. Mais dans toutes les histoires, le bien finit toujours par triompher.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: Si seulement un héros pouvait apparaître pour vaincre le mal, pour que tout redevienne comme avant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: Les gens ont peur, ils se cachent, ils ne font plus confiance à personne…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: Tout ça me rappelle un peu les contes de fées avec lesquels on a grandi. Ceux où le mal se répand à travers le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: Mais je crois que je suis toujours la même personne. En tout cas, j''ai pas envie de faire de mal à qui que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: Peut-être que j''ai certains des signes. Je sais pas. Tout est tellement bizarre ces jours-ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: Pour être honnête, je sais toujours pas qui sont ces Visiteurs ni ce qui les différencie de nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: J'ai pas besoin de pique-assiettes ici. Allez, du balai !
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: Je ferai de mon mieux pour me rendre utile jusqu''à ce que je puisse te rendre la pareille.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: Moi, je veux être un fardeau pour personne. Mais quand ça va mal, chacun fait ce qu''il peut pour s''en sortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: Ses demi-frères et sœurs ont emménagé peu après. Je peux pas lui en vouloir. Mais mets-toi à ma place…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: Donc, après tout ça, il m''a mis à la porte… Soi-disant que j''avais pas de boulot.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: Mon proprio voulait pas louer à un jeune diplômé sans CDI.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: … Comme quand on était gamins.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: Quand les temps sont durs, les gens veulent juste tout oublier, redevenir insouciants, le temps d''un moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: Faut croire que ceux qui bossent dans les boîtes de nuit ont eu plus de chance.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: Mais avec tout ce qui s''est passé, les gens ont arrêté de venir et on s''est tous fait virer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: Je viens de finir mes études, mais comme je galère à du boulot dans mon domaine, alors je bosse dans un petit café.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: Comment est-ce que je peux être sûr que tu n'es pas un Visiteur ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: Qu'est-ce qui t'amène ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: Bonsoir. Y aurait une place pour moi, ici ? J''ai pas besoin de grand-chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: Bon, d''accord. Comme tu veux. Je m''en vais.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: Merci… de m''avoir laissé entrer. Et, euh, aussi… de pas faire toute une histoire de ma peau.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: Il vaut mieux que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: Bon, tu me laisses entrer ou pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: Parce que je sais pertinemment qui je suis. Et je ne suis pas comme eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: Il vaut mieux que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: Alors, tu me laisses entrer ou pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: Si tu le dis…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: Pourquoi t'es si sûr de toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: On verra bien.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: Je te le dis et je le répète, je ne suis pas un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: Comment ça, « à quoi je m''attendais » ? Calme-toi. Tu crois que j''ai choisi d''avoir cette peau ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: Pourquoi t'es si sûr de toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: On verra bien.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: Je comprends bien, mais je ne suis pas un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: À quoi tu t'attendais ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: Tout le monde est parano ces jours-ci.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: C''est congénital, j''y peux rien. Mais les gens me prennent pour un Visiteur, je sais pas pourquoi. C''est dingue.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: C''est bien ce que je dis.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: À quoi tu t'attendais ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: Tout le monde est parano ces jours-ci.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: Les gens me traitent comme si j''étais contagieux… ou pire, comme un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: Je suis juste né avec une vilaine peau. C''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: Rien, justement. Y a rien qui cloche chez moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: C'est quoi le problème avec ta peau ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: Est-ce que je devrais m'inquiéter ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: Hé ! Euh, j''espère que j''ai pas l''air trop… trop abîmé pour rentrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: Hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: Tu verras où ça te mènera… Fais-moi confiance…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: Tu vaux pas mieux que ces sadiques en blouse blanche.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: Un peu détraqué ? Hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: Donc… Toi aussi, tu penses que je suis fou ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: Enfin, un endroit où je peux attendre que tout ce bazar se calme…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: C''est pas trop tôt !'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: Il vaut mieux que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: En plus, j''ai entendu des coups de feu pas loin. Mais toi, tu prends la sécurité plus au sérieux. Naaan… ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: Maintenant, j''essaie de… bien m''entendre avec de nouvelles personnes !'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: Y en a un qui a eu ce qu''il méritait ! Mais maintenant, je fais vachement plus gaffe. Hi hi !'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: Tout le monde m''en veut. Tous les crétins, depuis l''école.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: Quels amis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: Il vaut mieux que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: Je préférerais encore retourner à l''hôtel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: Donc… J''ai pas vraiment envie que ça reparte pour un tour en retournant là-bas ! Hi hi !'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: Ils m''ont aidé une fois, mais maintenant ils s''en fichent complètement !'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: Je crois que j''étais un d''accid…nt. Oups, hi hi ! Et me voilà !'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: T'as pas des amis, plutôt ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: Pourquoi tu ne vas pas chez des proches ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: Je t''en parlerai… plus tard. Hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: Les chambres d''hôtel sont toutes petites. Ça me rappelle… de mauvais souvenirs.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: Ta maison est assez grande pour abriter toutes sortes de personnes.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: C''est bien, là. C''est mieux, là. Hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: T'as pas des amis, plutôt ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: Pourquoi tu ne vas pas chez des proches ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: La FEMA est venue, puis ils sont repartis… disparus, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: Je peux pas le prouver, non non non… Mais je suis sûr que c''est une Visiteuse.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: Elle me fait peur, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: Y a une fille avec un imper jaune là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: Ça me plaît pas trop là-bas. Je préfère trouver un autre endroit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: Tu crois que c'est mieux ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: Pourquoi ? Tu peux pas retourner à l'hôtel ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: Mais là, j''ai peur de rentrer… Tu crois que je peux rester ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: Je dors à l''hôtel Espérance et j''ai voulu faire une petite balade.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: Pardon, je suis un peu nerveux.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: Salut. Hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: Prenez soin de vous. J''espère que vous vous en sortirez.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: Très bien. Je comprends. Sans rancune.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: Venez me voir plus tard. J''ai des histoires incroyables à vous raconter. Ça va vous surprendre !'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: Ça alors ! Vous me sauvez la vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: Promis, je vous causerai pas de soucis. Je vous raconterai tout, juste… laisse-moi entrer, l''ami.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: Elle voulait juste me protéger… Elle m''en avait jamais parlé.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: C''est ma mère qu''ils cherchent.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: Non, c''est pas après moi qu''ils en ont.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: Et avec ce foutu truc du soleil, tout est parti en cacahuète.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: Mais maintenant… je… enfin, je n''arrive plus à joindre personne. Chacun gère sa propre merde.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: C''étaient des personnes formidables, toujours prêtes à aider, à partager une bière ou juste à passer un bon moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: Rien que des gens de théâtre. On buvait ensemble, on riait, on se serrait les coudes.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: Donc, vous êtes poursuivi par une bande de personnes qui sont en colère contre vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: C'est quel genre d'amis, exactement ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: Je vivais avec ma mère et ma grand-mère, mais on s''est fait expulser. Les huissiers… C''est si compliqué…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: Je pensais avoir plein d''amis, vous savez… qu''on resterait ensemble à travers cette épreuve… Mais je suis là.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: Ça vous dérange si je reste ici un moment ? Le reste de la troupe manque à l''appel… certains sont morts…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: Bonjour, l''ami !'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: … enfoiré.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: Quel…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: Hum… Au fond, ça ne m''étonne pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: Non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: C''est un test ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: On en reparlera un de ces jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: Tu sais, pour moi, c''est un honneur. D''être ici, maintenant, alors que nos vies partent en vrille.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: Formidable !'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: Entre, vas-y.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: La vie, c''est aller à l''encontre des probabilités. Rien n''est facile.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: On ne survit que si on se bat.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: Moi, je pense juste que si on reste là à attendre que ça se passe, c''en est fini pour l''humanité.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: Oh… Je suis désolée si je t''ai pas fait bonne impression.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: Entre, vas-y.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: L''humanité a déjà survécu à tellement pire. Y a pas de raison d''abandonner maintenant !'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: Mais une chose est sûre… Je suis loin d''être désespérée.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: Oh… Tu te demandes pourquoi je suis venue ici ? Ha, qui sait ? Peut-être que je suis folle.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: Quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: Tu parles comme une psychopathe.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: Toi aussi, t'es désespérée ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: On survivra, quoi qu''il arrive.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: Je pouvais pas passer à côté d''un endroit comme celui-là. Je crois qu''on est sur la même longueur d''onde, toi et moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: Il faut pas laisser les Visiteurs te prendre la seule chose qui te revient de droit : la vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: Survivre dans ce monde, c''est pas évident.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: Tu parles comme une psychopathe.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: Toi aussi, t'es désespérée ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: Mais toi… T''es différent. Tu vas te battre jusqu''au bout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: Les plus courageux se tirent une balle dans la tête. Les autres… Ils se laissent juste mourir, jour après jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: La plupart des gens ont renoncé. Ils sont trop faibles pour survivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: Non, sérieusement.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: Euh… Qu'est-ce qui se raconte sur ma maison au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: Euh… Merci ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: En ce qui me concerne, tu as mon respect.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: Ceux qui viennent ici sont soit désespérés… soit stupides.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: La plupart des gens évitent ta maison comme la peste.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: J''ai entendu parler de toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: Ah, {0} ! Prends, c''est pour toi. C''est pas grand-chose, mais j''espère que ça t''aidera.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: Merci beaucoup.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: Je vais m'en débarrasser. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: Oh… mince, mais y a {0} ici. Je peux pas faire confiance à des gens comme ça, moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: On ne m'achète pas comme ça, moi !
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: D'accord, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: Si tu veux, j''ai ça… {0} ? Ça peut peut-être te faire changer d''avis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: Je veux pas tomber sur une patrouille. Ou pire encore, sur des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: Oh non, pitié… Laisse-moi entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: {0}, tiens. C''est pas grand-chose, mais ça t''aidera peut-être.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: Merci beaucoup.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: Moi, je veux pas finir là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: Mais le bruit courait qu''ils emmenaient les personnes infectées dans les zones de quarantaine…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: Ils ont débarqué un jour pour contrôler tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: La FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: Moi, je veux vraiment pas finir dans une zone de quarantaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: Ils ont commencé à rassembler les gens… Et moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: La FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: Qu'est-ce qui s'est passé dans ton dortoir ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: Pourquoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: Avant, j''habitais dans le dortoir de l''université, mais j''ai été obligé de partir…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: Oui. S''il te plaît… Laisse-moi entrer, si c''est possible.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: Qu'est-ce qui s'est passé à ta résidence ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: Pourquoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: La résidence universitaire, c''est plus possible…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: Ouais, j''ai besoin d''un endroit où rester. J''ai nulle part où aller.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: Tu cherches un endroit où dormir ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: T'as besoin de quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: Salut… Tu peux me laisser entrer, s''il te plaît ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: Excellente décision, frérot.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: Je crois plutôt que c'est toi qui devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: Je vais m'en débarrasser. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: Des types comme {0}, j''en ai déjà vu plein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: Écoute, frérot. Il y a une belle ordure là-dedans.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: Adios, crétinos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: Eh bien… T''es un sacré marrant, toi !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: Excellente décision, frérot.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: Bon, assez bavassé. Tu me laisses dormir ici, frérot ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: J''ai pas de fric, ma femme s''est tirée avec un bouffon… J''ai pas de toit où crécher.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: Quand t''as fait ton temps, tu dois partir et puis c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: Bien sûr que j''aurais préféré rester. Mais tu crois qu''on m''a demandé mon avis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: Bon, assez bavassé. Tu me laisses dormir ici, frérot ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: Dans la campagne, sans voyous qui traînent dans la rue. Un endroit sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: Et j''ai fini par tomber sur ta maison : propre, calme, au milieu de nulle part…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: J''ai pas de fric, ma femme s''est tirée avec un bouffon… J''ai nulle part où crécher.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: J''ai nulle part où aller, frérot.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: Pourquoi t'es pas resté en prison ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: Et qu'est-ce que tu fais chez moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: Faut croire que je suis de retour dans la rue.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: Et maintenant ? Le monde entier est devenu fou. Le soleil cogne comme s''il voulait me frire les roupettes.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: Je serais bien resté plus longtemps, mais ils ont fini par me virer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: J''ai bien essayé, frérot.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: Pourquoi t'es pas resté en prison ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: Et qu'est-ce que tu fais chez moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: Moi, j''ai de la bouteille. Dès que je suis sorti de prison, j''ai viré toutes mes fringues… Histoire de respirer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: Ils se baladent comme s''il neigeait ou quelque chose du genre. Quelle bande de guignols !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: Ça se voit pas ? Il fait une chaleur infernale ici ! Je sais pas pourquoi les autres comprennent pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: D'où tu sors, toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: Pourquoi tu te balades en slip ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: Tu me laisses entrer, frérot ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: Si c''est pas toi, un autre finira bien par me laisser entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: Oh, ve te faire !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: Mais sans guitare… c''est pas la même chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: OK ! Rock''n roll !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: Je vais régler ça. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: Ouais, c''est ça, {0}. Je resterai pas sous le même toit, pas question.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: Non, en fait. Hors de question que je m''approche de ce genre de raclure.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: Je vais essayer de squatter chez un de mes potes. J''espère qu''ils sont pas tous morts…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: Je te comprends, mon pote. Sans rancune.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: … Ou pas ! C''est toi qui décides, mon pote !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: Merci. Je mettrai un peu de son de temps en temps, si c''est OK. Si je trouve une gratte, je te jouerai un morceau.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: Si j''étais un Visiteur, je défoncerais la porte ou je passerais par la fenêtre. Tu vois bien que je suis juste… là.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: Ces enfoirés ont même cassé ma gratte. Toutes ces histoires, ça rend les gens pires que des animaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: On a joué jusqu''à l''aube… Et des cinglés se sont pointés pour nous piquer nos affaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: Parce que moi, non.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: Apparemment, ils ont trouvé un Visiteur par ici. Depuis, ils contrôlent à tout va. Moi, tant que c''est pas la panique…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: Rien de louche. Juste un mini ampli et quelques bouteilles d''eau. Je te laisserai utiliser l''ampli si tu sais jouer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: Pourquoi t'as l'air de ne pas avoir dormi depuis une semaine ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: Qu'est-ce que t'as sur toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: C''est le bazar total en ce moment ! Comme une star qui jouerait dans un bar miteux sans videur !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: Ah, ouais ! Un profiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: Laisse-moi squatter ici deux-trois nuits. Je vais pas m''éterniser. J''suis pas un… Euh… C''était quoi le mot déjà ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: Hé, mec, ouvre. Le soleil est plus violent qu''un gros projo. Je vais devenir aveugle à ce rythme.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: J''me dis que je tenterais peut-être de le rejoindre. Ça a l''air… intéressant.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: Et après, il les jette dans un bûcher !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: J''ai entendu dire qu''un type bizarre rassemblait des gens pour leur faire un lavage de cerveau.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: Bon, je vais voir ce qui se trame ailleurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: Fait suer. Toujours la même chose…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: Entendu. À plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: Je me demande combien il a pu se faire avec son arnaque.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: J''ai entendu dire qu''il y avait un mec qui vendait de l''air. C''est dingue !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: Pas de souci. Je vais aller faire un tour ailleurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: Allez, viens. Je vais te raconter plein d''autres trucs maintenant !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: Excuse, mais je me suis dit que ce serait super marrant.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: Hahaha ! Trop drôle ! Je la connaissais même pas, cette personne !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: Dans ce cas, c'est plutôt à toi de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: Je vais m'en débarrasser. Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: Du genre à faire tout un tas d''histoires. Non, ça va pas être possible'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: Je suis pas super à l''aise pour parler devant des gens comme ça. Ils sont du genre à déformer mes propos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: Oh, oh… Y a {0}, ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: Tu penses vraiment pouvoir m'acheter ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: {0}, tiens ! Tu en veux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: Ou… attends.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: Tu veux un Énerjéka ? Mais tu sais, j''ai plus que ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: Dommage… Attends, j''ai plein de trucs avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: Je vais participer, t''en fais pas. Moi aussi, des histoires à raconter. On va papoter.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: Bon… Tu vas me raconter ce qui se passe dans le coin, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: Oh, trop bien !'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: Quoi qu''il en soit, j''en ai marre de rester devant ta porte. Si tu me laisses entrer, je te parlerai de ce que j''ai vu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: Franchement, c''est pas la plus futée des stratégies.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: Les gens paniquent, soit ils vivent cloîtrés chez eux, soit ils tirent sur tout ce qui bouge.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: J''en ai vu, des endroits intéressants, tu sais… Mais au final, c''est toujours la même chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: Je te l''ai déjà dit. Tout ce qui m''intéresse, c''est de voir comment les gens s''en sortent.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: Tu m''écoutes pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: Tu me laisses entrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: Mais je dois dire que ta maison a l''air intéressante… Je crois.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: Je vais continuer à avancer. Jusqu''à ce que je trouve ce que je cherche… Peu importe de quoi il s''agit.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: Ouais, je fuis… Si ça peut te faire plaisir…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: Tu essaies d'échapper à quelqu'un ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: Et après, quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: On devrait partager nos astuces de survie, hein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: Mais moi non plus, je suis pas mort ! Héhé… On dirait qu''on a tous les deux compris quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: Ouais, t''es peut-être en vie. T''es en train de me parler… c''est vrai.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: Et toi, t''es coincé ici. Tu penses que ton toit va te protéger ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: Tu fuis quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: Et après, quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: Oh, et pis zut.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: Seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: Je finirais par crever, comme tous les autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: Mais si j''étais resté cloîtré dans mon appart, je n''en aurais jamais su.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: Qui sait ? Peut-être que tu caches le dernier espoir de l''humanité quelque part dans ta maison…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: Plus j''avance, plus j''ai de chances de trouver une solution. Tu captes pas, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: Comment ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: Échapper aux ennuis ? C'est juste impossible.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: Tu comptes pas te mettre en sécurité ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: Je me déplace la nuit. Donc, ouais… Je serai à l''abri avant que le soleil me grille.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: J''en ai assez pour tenir, genre, SUPER longtemps. Cherche même pas à savoir où je le planque.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: Je peux compter sur mon Énerjéka, t''inquiète.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: Échapper aux ennuis ? C'est juste impossible.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: Tu comptes pas te mettre en sécurité ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: Je vais avancer jusqu''à ce que je crame… Ou que les Visiteurs me dévorent. Tout dépend de ce qui arrivera en premier.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: Une tempête approche. Et je me demande bien comment les gens vont y faire face.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: Quelque part, loin d''ici. Je peux pas rester au même endroit.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: Y a pas de quoi se réapprovisionner ici.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: Où tu vas, avec ton attirail ?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: Je suis super excité ces jours-ci. Mais l''Énerjéka ne fait plus le même effet qu''avant. J''en boirais bien une gorgée…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: Oh, salut ! Y a quelqu''un. Cool !'
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Passer l'intro
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: C'est comme si c'était fait ! Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: Si vous ne pouvez pas conduire un Visiteur en zone de quarantaine, remettez-lui une convocation à la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Oh, oh, oh ! On dirait que le Festival va avoir lieu malgré tout...'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: Oh, mon pauvre garçon... Ça craint du boudin...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: Je suis pas tout seul.
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: Je suis tout seul.
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: T''es tout seul dans la maison ?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: Enfin, bon…'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: Et qu''est-ce qui peut bien encore compter ? T''es tout seul maintenant. T''as plus de famille.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: Pourquoi t''es si tendu ? À t''accrocher comme ça à la vie…'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: Profite du temps qui te reste.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: Tu me reverras plus jamais. J''ai fait ce que j''avais à faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: J''ai plus rien à faire ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: Les oreilles ? C''est quoi ce délire, les oreilles ?! C''est pas un signe de Visiteurs, ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: Les oreilles ? C''est quoi ce délire, les oreilles ?! C''est pas un signe de Visiteurs, ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: Montre-moi tes mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: Adieu.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: Très bien. C''est votre choix. La Mort finira bien par venir vous chercher tôt ou tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: Depuis longtemps, je cherche la paix… Je viens avec vous.
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: Si vous avez si hâte que ça de mourir, allez-y. Je reste ici.
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: Participez à notre rituel. Vous trouverez la paix. Rejoignez-vous à nous dans notre marche sacrée vers la Mort…'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: En guise de gratitude, je pourrais vous offrir le salut…'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: Enfin… Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Ça doit être dur. Pour vous. Et pour nous aussi. Comment contrôler un quartier quand il n''y a personne ?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: Vous êtes seul ?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: Adieu.'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Ah… Peut-être que je perds mon temps…'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Bonjour, mon garçon ! Et cette petite faveur que je t''avais demandée ? T''as trouvé des indices dans le Guide du sourire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: Tenez, {0}. Laissez-moi entrer pour avoir cette généreuse récompense du GRAND SOLEIL ! Alors, vous avez changé d''avis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: Voici une généreuse récompense offerte par nul autre que le GRAND SOLEIL ! Vous l''avez bien méritée, l''AMI !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: Et vous et moi… nous nous reverrons.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: Mais moi, je ne mourrai pas. Je ne mourrai jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: Abandonner quelqu''un qui est à l''article de la mort ? C''est mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: D''ailleurs, il y a quelque chose que vous devriez savoir…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Parce que vous et moi… nous sommes immortels.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: Ce sont les gens comme vous qui survivront à ce cauchemar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: De nos jours, rares sont ceux qui savent encore écouter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: Vous n'avez rien à faire ici.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Entrez, je vous en prie.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: Je sais exactement d''où viennent les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: Et je vous dirai tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: Je vous promets que dès que la FEMA ne sera plus dans le coin, je repartirai pour retrouver ma fille.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: Et le gouvernement ne veut pas que ça se sache.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: La FEMA est à mes trousses parce que je sais des choses…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: J''ai besoin d''un endroit où me réfugier pendant quelques jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: Attendez, attendez !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: Vous n'avez rien à faire ici.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Entrez, je vous en prie.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: Je sais exactement d''où viennent les Visiteurs…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: Et si vous me laissez rester, je vous raconterai tout…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: Après quoi, je repartirai chercher ma fille…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: S''il vous plaît, laissez-moi rester ici quelques jours… Jusqu''à ce que la FEMA quitte la région…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: Si c''est le cas, ils ne la toucheront pas. C''est moi qu''ils veulent.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: C''est peut-être eux qui ont kidnappé ma fille… ou peut-être pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: Ils sont après moi… parce que j''en sais trop sur eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: Loin d''ici, en gros.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: Quelque part où la FEMA ne pourra rien nous faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: Elle n'est pas là. Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: Où comptiez-vous aller ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: Dès que je l''aurai retrouvée, on quittera cette ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: Je n''ai aucune idée de l''endroit où elle peut être.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: Je suis à sa recherche depuis le début de cette pagaille.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: Évitez de parler de ma fille comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: Elle n'est pas là. Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: Où comptiez-vous aller ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: Aucun mot, aucune trace. Ma fille avait disparu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: Quand je me suis réveillé, il n''y avait plus personne à la maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Et puis il y a eu cette vague de chaleur anormale… Et j''ai perdu connaissance…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: On était censés quitter la ville…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: Je n''arrive pas à la retrouver depuis que toute cette histoire a commencé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: C''est ma fille.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: La maison close, ce n'est pas dans cette rue.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: Il n'y a personne de ce genre ici.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: Une fille aux cheveux violets avec un poncho ne serait pas passée par ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Hé !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: Je me suis trompé de maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Pardon.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: Mauvaise odeur. Mauvaise voix.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: Je me suis trompé de maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Pardon.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: Mauvaise odeur. Mauvaise voix.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: Tu as besoin d'aide pour retrouver ta maison ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: Qu'est-ce que tu cherches exactement ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Est-ce que les gens en ont besoin ?…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: J''en ai pas. Jamais eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: Des parents ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: Tu as besoin d'aide pour retrouver ta maison ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: Qu'est-ce que tu cherches exactement ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: J''ai entendu un craquement sous les planches… Ça veut dire que quelqu''un attend.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: J''avais besoin de la lumière de la cuisine, mais ici… l''écho est différent.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: Toutes les portes ont l''air pareil dans le noir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: Où ils sont, tes parents ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: Tu es perdu ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: Pourtant, il devrait…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: Il dort pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Veillez sur les miens. Et n''oubliez pas que si l''un d''entre eux venait à mourir, votre maison serait réduite en cendres.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: À plus tard. Je repasserai pour voir si tout le monde va bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: Vous croyez avoir le choix ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: À plus tard. Je repasserai pour voir comment ça se passe.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: Ils ne resteront pas très longtemps. Mais tout de même, gardez un œil sur les miens.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: Je crois que vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: C'est comme si c'était fait ! Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: Ce genre de personne fait clairement obstacle à la réalisation de nos objectifs.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: Ou même {0}…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: Comme {0}…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: C''est une très bonne nouvelle. Cependant, il faut d''abord vous débarrasser de certains de vos invités…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: Passez une bonne nuit…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: Voici votre commande : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: Bon, prenez la commande. Je dois filer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: J''en ai marre de toute cette histoire. Je veux juste que ça s''arrête…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: Tout ce bordel…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: Ces interminables contrôles des agents de la FEMA qui nous braquent avec leurs armes tous les matins…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: Maintenant, je vois plus que des trognes fatiguées, sombres, amères…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: Vous savez quand je disais que d''être livreur, ça me changeait les idées ? C''est fini ce temps-là.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: *soupire*…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Prenez juste votre commande… Je préfère me barrer d''ici avant que vous me tiriez dessus aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: Ah, je vois… Vous êtes en train de me dire que c''est une bonne chose que mon ami ait été tué ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: Je suis désolé.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: Y a pas d'autre solution.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: Voici votre commande : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: Vous savez quoi ? Prenez votre commande, je m''en vais.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Ouah, punaise… Merci beaucoup pour le conseil. C''est vraiment super utile.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Bon, je dois y aller. Prenez votre commande que je puisse repartir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: Bientôt, ils vont nous dire que les poils de cul sont un signe distinctif des Visiteurs, et le monde sera foutu…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: Moi, je pensais que ça pouvait pas être pire. Mais chaque jour, c''est de plus en plus dingue.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: Tous ces Visiteurs, les symptômes, et ce fichu Soleil…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: M''en sortir ? Comment je peux « m''en sortir » après ce cataclysme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: Arrêtez de vous comporter comme une mauviette et vous survivrez…
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: Inutile de vous faire du mauvais sang… Vous allez vous en sortir…
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: Voici votre commande : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: Bon. Vous savez, vous êtes censé réceptionner la commande. Vous allez le faire, oui ou non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: De toute façon, à quoi bon étudier si y a plus personne pour m''embaucher ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Ah, peu importe. Faire des livraisons, c''est pas si mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: Forcément, y a plein de gens chez vous… C''est facile à dire…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: Ah, ça doit pas être facile tous les jours…
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Mais c'est pas si mal d'être seul.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: En plus, je suis pas d''ici, je suis venu pour étudier. Donc ma famille est pas là et je suis tout seul…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: Voici votre commande : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: Bref, désolé, je m''égare. Vous comptez prendre la commande ou bien… ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: Les gens achètent jusqu''à 20 litres d''eau. Et même pas de prime de risque ni de pourboire pour des trucs aussi lourds…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: Ce fichu soleil, par contre… On doit travailler de nuit à cause de cette satanée chaleur.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: Et les livraisons, ça paye plutôt bien en ce moment. C''est vrai que c''est risqué, mais bon, faut bien s''y coller.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Apocalypse ou pas, le déjeuner, c''est sacré.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: Ça m''étonnerait que les gens arrêtent de faire des courses, juste parce que c''est la fin du monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: Je n'accepte pas les pots-de-vin.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: D'accord, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: {0} ? Ça ira ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: Qu''est-ce que tu veux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: Oh, pour l''amour du ciel ! Laisse-moi te soudoyer avec quelque chose, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: Il est tout pourri, ton truc !
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: Ah ! Ça y est, je l''ai ! {0}. Tiens, prends ça, je t''en prie. Laisse-moi dormir ici jusqu''à demain matin, s''il te plaît.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Bon, un couteau, ça peut me servir… des bandages, ouais… Hmmm, une vieille flasque ? Ah, mais elle est vide…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Ah, attends… Me jette pas dehors… Laisse-moi fouiller dans mon sac avant.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: C''est la loi du plus fort qui règne ici maintenant. Soit tu te plies aux règles, soit tu te fais éliminer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: T''as fait le bon choix.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: C'est toi qui ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: Je m'en occupe. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: Tu ferais mieux de la mettre dehors, si tu veux rester chez toi ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: C''est {0} qui réchauffe la pièce, là-bas ? Y a pas de doute… Ça, c''est un agneau déguisé en loup.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: Un pot-de-vin ? Non, merci !
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: C'est bon, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: Ah, {0} ! Tenez, prenez ça. Ça pourrait vous être utile.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: D''ailleurs, on a… C''était quoi déjà ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Vous avez peur qu''on vous attire des ennuis ? C''est juste que ma sœur est dans une mauvaise passe.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: Dans ce cas, vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: Je vais m'en débarrasser. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: Ça me rappelle trop nos… parents… Et c''est loin d''être l''environnement idéal pour elle en ce moment…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: Je n''aime pas ça… Ma sœur ne sera pas tranquille avec ce genre de personne ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: Je vois que vous accueillez déjà {0} et {1} chez vous…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: Dans ce cas, vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: Je vais m'en débarrasser. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: Je crois qu'on va pouvoir s'entendre…
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: Disons juste que c'est le portrait craché de quelqu'un que j'ai bien connu avant de rencontrer mon mari…
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: Ça va être difficile pour moi de vivre sous le même toit que cette personne…
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: Ah, mais il y a déjà {0} ici…
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: Dans ce cas, vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: Je vais m'en débarrasser. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: Et elle a pas besoin de ça en ce moment. Tout ce qu''il lui faut, c''est juste un peu de tranquillité… et d''amour.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: Je peux déjà sentir ma petite sœur crouler sous le poids de leurs jugements.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: Ah, mince… On dirait que vous recevez déjà {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Hé ben, voilà ! Je te l''dis, il t''aurait causé que des ennuis de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: Je vais le mettre dehors. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: Faut le virer… Et moi, je prendrai sa place !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Désolée, mais… t''arriveras jamais à rien avec lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: Tiens, tiens… mais c''est {0} qui est assis là, non ? Quelle charmante surprise !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Merci… Je ne compte pas rester longtemps… J''ai juste besoin d''un moment pour me poser un peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: Alors, vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: Je vais le mettre dehors. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: Je préfère ne pas rester sous le même toit que ce genre de personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: Non.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: Ah… {0}… est ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Merci pour votre aide. Vous n''êtes pas comme…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: Il est nul ton cadeau.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: D'accord, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: Ça te plairait ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: J''aimerais bien pouvoir t''aider. Il y a sûrement quelque chose qui t''intéresse ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: Je n'accepte pas les pots-de-vin.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: D'accord, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: Alors, qu''en dites-vous ? Vous voulez bien nous aider ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: {0} ? Je suis prêt à donner tout ce qui me reste pour que ma chérie puisse se reposer un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: On a quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: En parlant de ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: Je l''aime tellement fort. Je pourrais lui donner ma propre chemise.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: Ma fiancée est faible. Elle se fatigue vite. Et moi… Je ferais n''importe quoi pour elle, vous comprenez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Pardonnez-moi d''insister, mais mettez-vous à notre place…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: Il est nul ton cadeau.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: D'accord, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: Regarde, mes jambes en sont la preuve ! Y a rien ici, pas vrai ? Ha !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: Ça va marcher, c''est sûr !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: Tu me laisses pas entrer ? On va arranger ça ! {0}, attrape ! Fais-moi rentrer ça, et… boum ! Tu es invisible.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: Il est nul ton cadeau.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: D'accord, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: Héhé ! {0} ! C''est comme dans les jeux, man… Il faut créer des liens. J''ai compris, man !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: D''accord… Écoute un peu. J''ai un truc.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: Vas-y, man…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: Les pots-de-vin, ça m'intéresse pas.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: Je crois que c''est {0}. C''est à toi, si tu veux. J''ai un mal fou à reprendre mon souffle. Mais… faut bien ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: J''avais quelque chose sur moi. Attends, s''il te plaît…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: Tu pensais vraiment pouvoir m'acheter avec ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: Alors, t''en dis quoi ? Ça va mieux ? On est bons ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Voici un PETIT CADEAU… de ma part. {0} !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: D''accord, mon vieux. Je crois que je sais exactement ce qu''il te faut.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: Tu pensais vraiment pouvoir m'acheter avec ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: J''ai aussi des chewing-gums. J''en ai plus beaucoup, mais si tu les veux, je peux te les donner…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: Peut-être que tu veux que je te donne quelque chose ? {0}, peut-être ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: Je… Je sais même pas quoi faire…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: Tu pensais vraiment pouvoir m'acheter avec ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: S''il te plaît… sinon je vais mourir ici !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: Je suis prêt à te donner tout ce que j''ai. Tiens, prends {0} ! J''ai rien d''autre à t''offrir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Là, maintenant, bon sang ! Soit je me vide de mon sang devant ta porte… soit tu me laisses entrer pour me soigner.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: Tu sais quoi ? Va te faire voir. Je vais aller parler à tes voisins. Adios, connard.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: C''est quoi ton problème ? Je te raconte tout ça et toi, tu me fermes la porte au nez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: T''es sérieux ? Mon mari bosse pour la FEMA, je te signale !'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: Les pots-de-vin, ça m'intéresse pas.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: C'est bon, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: Réfléchis bien à l''option qui t''embête le moins.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: Non ? Un mot à mon mari, et les combis font une descente surprise… Je peux l''appeler tous les matins.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: On va faire simple : je te donne {0} tout de suite et tu me laisses entrer. D''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Écoute, mon sixième sens me trompe jamais… Je peux différencier les humains des Visiteurs comme personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: J'espère juste pouvoir enfin dormir un peu ici.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: Alors, c'est à toi de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: Je vais lui dire de dégager. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: J'ai déjà joué une scène pareille dans ma tête… Et crois-moi, ça m'a suffi.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: Y a pas de place pour nous deux ici.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 'Merci, mais… On dirait que la place est déjà prise. Tu vois, {0} ? '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: Je sais même pas pourquoi je continue de la porter.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Je suppose que cette combinaison fait un peu peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: D''accord, je comprends.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: J''arrive pas à croire que tu me laisses vraiment rentrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: Vraiment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: C'est plutôt à toi de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: Je vais lui dire de partir. Viens.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: Si tu pouvais libérer la salle de bain… Je te jure, je me tiendrai à carreau. Je dérangerai personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Je veux juste l''enlever, me laver… Je veux nettoyer toute la crasse et… Ce sang… Le sang d''un d''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: Ah… Mais, y a déjà {0} dans la salle de bain. Tu sais, ça fait des jours que je porte cette fichue combinaison…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: Euh, je veux dire… Une petite seconde…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: Pardon ? Ah, merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: Ah ! Merci, l''ami !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: C'est toi qui devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: Je vais l'expulser, t'inquiète pas. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: Je rentrerais bien, vraiment… Mais bon, tu vois ce que je veux dire…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Bon sang, y a déjà {0} ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: Tant pis… Qui ne tente rien n'a rien, après tout.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: Mince, alors ! Moi qui pensais pouvoir enfin souffler un peu.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: Ah, voilà qui est mieux.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: Oh, toi… Fiche-moi le camp d'ici.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: Je vais lui dire de partir sur-le-champ. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: Et par qui ? Par {0} ! Juste là, tu vois ?
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: Oh, ça alors ! Le petit coin douillet est déjà pris.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: On discutera des modalités de la location plus en détail à un autre moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: Merci, cher propriétaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: Oh, vous… Fichez-moi le camp d'ici.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: Pas de ça chez moi ! Je m'en occupe. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: Les articles 28, 48 et 7.3 de la Constitution ! Ça ne vous dit rien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: Vous n''êtes pas sans savoir que cette personne enfreint ouvertement la loi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: Oh, oh… Je vois que {0} vit déjà ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: Je comprends ce que tu vis, tu sais. Mais bon sang, c''est rude.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: Hé, euh… Passe me voir à l''occasion, on discutera.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: Ouf ! Merci, vieux. T''es droit dans tes bottes, toi !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: C'est tout choisi. C'est toi qui dois partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: Je vais lui dire de dégager. Viens.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: Enfin bon, tu vois quoi… Tu vas devoir choisir : c''est lui ou moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: Ce mec me rappelle ceux qui en avaient après ma famille et…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: Écoute, vieux… Je veux pas d''embrouilles, mais t''as {0} chez toi, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: Gardez le mien, le moment venu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: J''ignore si vous voyez la beauté comme je la vois. Mais rassurez-moi… Vous ne jetez pas les corps, n''est-ce pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: Vous devriez partir, alors.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: Je vais l'expulser. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: Et moi, je suis venu écouter le silence de la fin de journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: J''aimerais entrer… mais il y a déjà {0} ici. C''est une personne qui s''accroche aux espoirs de ses lendemains.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (Il hoche la tête et entre.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: Je comprends rien. Barre-toi.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: Je vais m'en débarrasser. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'L''étranger : (On dirait qu''il n''aime pas {0}. Il pointe du doigt, puis lui-même, puis à nouveau la personne.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: Mmmngh... Ffffffpt !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: Avec un peu de chance, je serai dans le coin, alors n''hésitez pas si vous avez besoin d''aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: Je comprends… C''est pas évident de faire confiance aux gens ces jours-ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: Merci. J''espère que je pourrai aider quelqu''un.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: Je vais l'expulser. Entrez, je vous en prie.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: Il vaudrait mieux qu''il trouve quelqu''un qui puisse vraiment l''aider.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: Je ne suis pas en mesure de prodiguer les soins que réclamerait un cas pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: Hmm, je vois que vous hébergez {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: Je vais juste me reposer un peu. J''repartirai après.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: Oh, mon garçon. Tu pourrais aller chercher un petit tabouret pour grand-mère ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: T''es un ange ! Tu viens de sauver une vieille dame ! Je suis désolée que tu aies dû mettre quelqu''un dehors pour moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: Ouais, il vaut mieux que vous partiez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: Je vais lui dire de partir. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: Si c''est pour avoir ce genre de compagnie, je vais m''asseoir un peu ici pour me reposer et je vais repartir…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: Avec des gens comme ça, ça risque d''être compliqué, mon poussin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: Oh, saperlipopette ! On dirait que {0} est ici… Juste là, sur la chaise.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: Oh nooooon…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: J''ai te-tellement P-P-PEUR.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: Moi… Je… Je connais… personne d''autre… OINNNNN !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: M''EN ALLER OÙ ? BOUHOUHOU…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: PAPAAA ! PAAAPAAAAAAA !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: Y a pas de place pour toi ici. Va-t'en.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: Pleure pas, je vais lui dire de te laisser sa place. Viens…
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: Je veux voir mon papaaaaaaa…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: Mais je… Je veux m''asseoir à cette place ! C''est là que… que papa s''asseyait… Il me l''avait dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: Et pis y a {0} qui est là.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: Je… Je sais pas… J''ai pas de place ici !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: Pas grave. Je vais me trouver un autre loser. C''est pas ça qui manque dans le coin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: Putain, t''es vraiment une petite mauviette. Tant pis, je me doutais qu''on s''entendrait pas tous les deux.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: Putain, mortel. Viens me voir dès que t''as un moment. J''ai un truc à te montrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: Il vaudrait mieux que ce soit toi qui partes.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: C'est comme si c'était fait. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: Débrouille-toi pour le virer et devrait pas y avoir de problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: Hé, on dirait que t''héberges déjà {0}. C''est le genre de raclure qui va t''attirer que des emmerdes…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: Ouais… Quelque part là-bas… loin de tout le monde…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: D''accord. Je vais y aller. Peut-être que le soleil pourra me réchauffer un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: Je comprends.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: Merci. Crois-moi, c''est mieux comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: Dans ce cas, c'est toi qui dois partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: Je vais lui dire de partir. Fais comme chez toi.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: Je… J''ai peur d''être dans la même pièce que d''autres personnes. À chaque fois, il m''arrive des choses horribles.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: Merci… Ah. La place est prise. Je vais pas entrer finalement. Pas tant que {0} est là.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: Eh ben, va te faire foutre. J''suis sûr que t''es un de ces coincés qui boivent même pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: Bon. Pour une fois que les choses tournent en ma faveur… Passe devant.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: C'est toi qui ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: Je vais m'en débarrasser. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: C''est le genre d''hurluberlus qui se fait jeter du pub dès l''ouverture.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: D''abord, {0} doit partir. Après on parlera.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: D''accord, haha… Très bien, j''y vais. De toute façon, le soleil va nous tuer. On va tous mourir…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: Merci. Je vais m''asseoir tranquillement. Ne fermez pas la porte, d''accord ? On sait jamais…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: C'est vous qui devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: Je vais lui dire de partir. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: Pouvez-vous lui demander de partir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: S''il vous plaît, pouvez-vous le tester ? Ou mieux…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: Je… je ne peux pas rester sous le même toit que lui. Et si c''était un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: Y en a déjà ici si ça se trouve… Comme {0} là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: Sage décision. Au moins, moi, je sais ce que je fais. Je peux t''aider si… ce monstre pointe le bout de son nez.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: Si quelqu'un doit partir, c'est toi.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: Je vais m'en occuper. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: Je peux sentir l''odeur du sang sur ses mains. Tu aimes vivre dangereusement toi, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: Ah… Tu accueilles déjà {0}, on dirait. Je ne comprends pas ce qu''une personne pareille fait là…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: Je vais aller aider d''autres personnes ailleurs. Vous, vous pouvez tous pourrir ici !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: Fermer la porte à la lumière, c''est refuser l''ILLUMINATION ! C''est le plus grand des PÉCHÉS !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: Eh bien, dans ce cas… Allez vous faire voir !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: Je vais pouvoir m''asseoir un peu ici… Youhou !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: Ohhhh, formidable ! Recevez la bénédiction du Grand Soleil ! Puisse-t-il veiller sur vous !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: C'est plutôt vous que je vais expulser !
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: Je vais l'expulser. Entrez, je vous en prie.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: Son ombre… non, son hérésie même occulte la lumière de la justice ! Vous devez l''expulser !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: Humain ! Le SOLEIL m''interdit d''entrer tant que {0} se terre ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: Il y a une ligne tellurique d''énergie pure qui traverse votre maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: C''est formidable. Franchement, il y a en vous un rare potentiel métaphysique.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: Je vais m'en débarrasser. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: Il faut qu''on s''en débarrasse, sinon les étoiles vont s''aligner et ce sera le désastre. Vous comprenez, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: C''est {0}. Ça vous dit quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: Oh… Je sens… Une aura oppressante. Une ombre… Assez forte pour nous condamner. Pour empoisonner toute la maison !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: Prends bien soin de toi, promis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: Et après, tout deviendra très sombre, très vite.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: Si tu t''y accroches trop, il finira par te noyer de l''intérieur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: Ne te laisse pas submerger par le chagrin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: Si c''est le cas, alors, la mort ne sera peut-être pas la seule chose qui t''occupera l''esprit.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: J''espère que tu te sais encore ce que c''est que de ressentir de la joie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: Je préfèrerais que ce soit toi qui partes.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: C'est bon, c'est comme si c'était fait. Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: Mais, si tu pouvais me faire un peu de place, je te serais vraiment reconnaissant.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: Je veux pas déranger… C''est le genre de personne qui a sans doute plus besoin de rester ici que moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: J''aimerais bien entrer, mais on dirait que {0} est déjà là.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: Allez, bouge-toi un peu, bon sang ! Moi aussi, j''en ai plein le dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: On va continuer à chercher, n''est-ce pas, ma chérie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: D''accord. Excusez-nous de vous avoir dérangé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: T''es timide, décidément. C''est rien. On va te laisser te reposer un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: Qu''est-ce que tu fais plantée là ? Entre, on nous a invités.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: Oh, merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: Ce serait mieux que vous partiez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: Je vais lui dire de partir. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: Ma fiancée les supporte pas, vous voyez. Je pensais pas qu''on tomberait sur quelqu''un d''aussi jeune ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: Écoutez, je veux pas faire la fine bouche, mais on peut pas rester ici. Surtout s''il y a {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: Oh, mais… Qui c''est, ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: Oh, je vous remercie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: Putain de merde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: Reste bien assis là, avale leurs conneries et étouffe-toi bien avec.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: Putain, t''es aussi pathétique que tous ces autres trouillards.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: Je vais juste m''en prendre à moi-même. Personne ne sera blessé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: Je vais pas tout casser non plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: T''inquiète pas… Je vais pas m''en prendre à qui que ce soit d''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: Nope. Pas question que je dorme sous le même toit que cette tarée. Je vais péter un câble.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: Je rêve… {0} va rester là aussi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: Non, non. Je devrais encore pouvoir y arriver.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: C''est peut-être déjà trop tard…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: D''accord. Je vais voir si je peux aller jusqu''à la maison de mon mari dès maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: Allez, reste pas là. Entre. Le monsieur va pas attendre éternellement.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: Ah, parfait.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: C'est mieux que ce soit vous qui partiez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: Je vais m'en débarrasser. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: Vous pourriez peut-être… Je sais pas… faire sortir cette personne histoire que le mioche puisse dormir tranquille ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: Hum… Je vois que {0} est déjà là. Mon bébé a déjà assez peur comme ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: La boule de poils, là. Tu vois ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: Je te parlais pas à toi. Je parlais au minou.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: Allez, mon petit chat. Tu vas me divertir maintenant, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: C'est toi qui n'as rien à faire ici.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: Très bien, je vais virer ça. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: Hmmm, on m''a dit que c''est pas le genre de personne qui devrait pas être là. Allez, vire-moi ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: T''as {0} chez toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: Je vais lui dire de dégager. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: Je suis désolée…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: Ça me rappelle… ces gens qui… qui… les enfants…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: Je vais pas pouvoir rester sous le même toit qu''une personne pareille.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: Je suis désolée, mais… Je me trompe ou c''est {0}, là-bas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: Prends soin de toi… et des tiens.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: C''est cool, man. Je comprends. Sans rancune.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: Maaaan…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: Voilà c''est ça qu''on kiffe, man ! Ouais, ça va être épique !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: Je vais le mettre à la porte, alors. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: Man, faut le mettre à la porte, y a pas moyen… Il plombe trop l''ambiance…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: C''est pas possible, man… Avec lui ici, on peut dire au revoir à toutes nos bonnes vibes…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: Euh, attends un peu… Ce serait pas {0} que je vois, là-bas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: Oohohoh ! Man, c''est trop d''amour !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: Ou la CHOSE viendra te trouver.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: Pour l''amour du ciel, ne t''approche pas des corps calcinés la nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: Je vais partir, mais avant…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: Il vaut mieux que tu partes en effet.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: Non, entre. Je vais lui dire de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: Je ferais mieux de trouver un autre endroit.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: Je suis désolé, j''arrive pas à l''expliquer. Tout ce que je sais, c''est que ça peut pas venir d''ailleurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: Je sens un truc… Il y a {0} ici, nan ? Quelque chose ne va vraiment pas chez cette personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: Où est-ce que je vais aller maintenant ? Je suis foutu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: Putain, tu sais que je vais pas bien, pourtant.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: Je te paierai grassement quand tout ça sera fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: T''as fait le bon choix, je t''assure.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: Tu ferais mieux de décamper.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: Je vais m'en occuper, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: Je préfère te refiler un truc, et… tu vois… T''as un flingue… Alors, bute-moi ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: Merde, t''as… {0} ici. Débarrasse-moi de ça ! Je vais pas me battre pour une putain de baignoire !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: Merci, mon pote ! Tu me sauves la vie !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: Fais-moi plaisir, va-t'en.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: Je vais faire de la place. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: J''aime la vie en communauté, mais la niche est un peu bondée pour la meute, non ? Tu pourrais pas faire quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: Oh, oh ! Mon pote, on dirait qu''il y a déjà pas mal de monde bien au chaud chez toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: Ouais… T''as sûrement raison. Je vais rentrer chez moi, au cas où ils seraient déjà revenus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: Mais… Vaut peut-être mieux que je reste avec toi pour l''instant. Je me sens plus en sécurité.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: Et si mes parents revenaient à la maison et que j''étais pas là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: Merci ! C''est juste que… J''arrive pas à ne pas m''inquiéter.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: Je vais le mettre dehors. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: Une fois, dans le parc, un type comme lui m''a agressé. J''y ai plus jamais remis les pieds depuis !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: Je vois qu''il y a déjà {0} sur le canapé. Les mecs comme ça… Tu sais… Ils me font peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: Passe une bonne nuit, connard.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: D''accord. Va te cacher derrière ta porte et ferme-la bien à clé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: T''as peur que la FEMA vienne me chercher ou quoi ? C''est quoi ce bordel ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: T''es sérieux là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: J''espère que tes voisins ne sont pas des connards finis…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: Tu viens de me sauver la vie, mec !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: Je vais lui dire de dégager. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: Je te le dis… Les types comme ça, ils vendraient père et mère sans hésiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: Il s''occupe de ses affaires, peinard. Jusqu''à ce que la situation dégénère et qu''il te plante sans sourciller.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: Je peux pas… Mec, {0}, chez toi, là… J''ai déjà croisé des types comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: Le Seigneur s''en souviendra. Il voit tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: Ma mort pèsera lourdement sur votre âme, croyez-moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: Regardez-vous, insensé ! Une chance de vous racheter vous est offerte… et vous la refusez. Honte à vous !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: Seigneur, ayez pitié…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: C'est vous qui devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: Je vais m'en occuper, c'est comme si c'était fait.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: Dehors, dehors ! Et tous les démons qui se cachent avec ! Priez pour votre pardon !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: Une vie entière ne suffirait pas à laver tant de péchés ! Fréquenter de telles personnes…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: Ah ! Et qui est {0}, si je peux me permettre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: C''est juste que… j''espère qu''un jour, je saurai tuer. Pour pouvoir me défendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: Cette personne doit beaucoup compter pour toi. Pardon de t''avoir fait perdre ton temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: Je m''excuse. Je voulais pas te mettre au pied du mur comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: Tu pourrais me montrer comment tu fais ? Comment tu tues un Visiteur ? Je veux voir la peur dans les yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: Et… Si ce n''est pas trop demander… Une fois que tu m''auras examiné…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: Merci, mon pote.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: C'est toi qui devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: Je vais lui dire de faire ses valises… Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: C''est juste que… J''peux pas vivre avec quelqu''un comme ça. J''ai essayé. Ça va pas le faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: Désolé. Je ne veux pas être impoli, mais y a déjà {0} ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: Tu sais quoi ? Va te faire foutre. Je vais aller voir tes voisins. Salut, connard.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: C''est quoi ton putain de problème ? Moi, je te raconte ma vie, et toi, tu me craches dessus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: T''es sérieux ? Mon mari travaille à la FEMA !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: Ces sales profiteurs…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: C'est toi qui devais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: Je vais le mettre dehors. Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: Vire-le avant qu''il soit trop tard !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: Je connais ce genre de type. T''aurais jamais dû le laisser entrer. Il va te causer des ennuis, c''est sûr !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: C''est qui, {0}, là-bas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: Allez, salut ! Pas sûr que vous fassiez long feu !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: Faut vraiment avoir l''esprit fermé pour envoyer valser la vérité comme ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: Vous… vous êtes…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: Comment ça, je devrais partir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: Une fois qu''on aura parlé, vous verrez le monde d''un tout autre œil !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: Content de voir que vous avez fait le bon choix ! Croyez-moi, vous n''allez pas le regretter.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: C'est vous qui devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: Je vais le mettre dehors. Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: Faites-le partir et j''accepterai de rester sans problème !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: Impossible que je divulgue le moindre secret avec lui dans les parages !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: Je le connais, {0} !'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: Oh non. C''est hors de question.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: Mais… Une petite seconde… Je rêve ou…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: Merveilleux !'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: J''aurai mieux fait de pas perdre de temps avec un pauvre type comme toi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: Tsss… J''en ai rien à faire de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: Trop bien !'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: T'as rien à faire ici. Va-t'en.
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: J'ai fait de la place. Allez, viens.
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: Hé, ça rime. Cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: Si c''est ici que je dois crécher, il va falloir que tu te plies à mes quatre volontés…'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: Ah, nan… Pas la peine, en fait. Y a déjà {0} qui squatte le spot le plus sympa…'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: Oh, et puis merde…'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: Tu vaux pas mieux que mon daron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: Eh bien… Il a pas l''air d''y croire…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: Tu crois que ça sera plus facile quand tout sera fini ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: Je savais que tu dirais ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: On pourrait même se changer les idées avec des trucs plus sympas que la paranoïa et les lamentations…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: Et si on partait tous les deux ? Loin de toutes ces horreurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: Merci, mais je préfèrerais que tu partes…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: Entre, je t'en prie…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: On pourrait essayer de construire quelque chose de spécial, rien que tous les deux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: Je peux t''aider… si tu veux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: C''est jamais facile de nouer des liens avec les autres. Tu n''es pas le seul à avoir du mal avec ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: Je comprends. Rares sont les gens qui savent écouter sans interrompre pour dire : « Moi, j''ai connu pire… ».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: Merci, mais je préfèrerais que tu partes…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: Entre, je t'en prie…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: On a tous besoin d''un peu de réconfort en ce moment. D''un peu d''attention. D''un peu… d''affection.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: Si tu me laisses entrer dans ta vie, on pourra peut-être affronter notre douleur ensemble.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: Et…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: Je suis passée par là, tu sais… Si jamais tu as besoin de parler, je suis là pour toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: C''est difficile de se débarrasser de sa colère. Et pardonner, c''est encore plus dur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: Une enfance difficile ? Comme c''est horrible… Je suis contente que ce soit derrière toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: Merci, mais je préfèrerais que tu partes…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: Entre, je t'en prie…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: Laisse-moi entrer… Tu verras, tu te sentiras différent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: Mais même les âmes les plus solitaires ont besoin d''une attention… particulière.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: Ces derniers temps, les gens sont obsédés par la fin du monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: Tu sais… Moi, je peux te donner quelque chose que la plupart des gens ne peuvent pas t''offrir…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: Mmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: Mais je vais pas te forcer à t''ouvrir à moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: Peut-être que ça t''aidera, une fois que ce sera sorti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: J'ai presque jamais réussi à avoir des relations solides dans ma vie. T'es contente ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: Avant, j'avais hâte que mon père meure. Ça te va ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: J'ai pas envie.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: Allez, raconte-moi. Je ne suis qu''une simple inconnue qui a frappé à ta porte. On se reverra peut-être jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: Ou c''est ton enfance ? T''as vécu des moments difficiles et toute cette folie te rappelle de mauvais souvenirs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: Les Visiteurs ont tué un de tes proches et tu t''es renfermé sur toi-même ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: Qu''est-ce qui s''est passé pour que tu sois comme ça ? Ta femme t''a quitté récemment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: Waouh. Tu mâches pas tes mots, toi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: J'ai presque jamais réussi à avoir des relations solides dans ma vie. T'es contente ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: Avant, j'avais hâte que mon père meure. Ça te va ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: J'ai pas envie.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: T''es pas du genre bavard, dis donc ! Parle-moi un peu de toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: On me le dit souvent ces derniers temps. Plus que d''habitude.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: Ça te plaît ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: Ah, tu as remarqué ? Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: Tu as l'air… différente des autres…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: C''est une question idiote de ma part… Tu vis ici après tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: Tu as réussi à t''adapter ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: Comment va la vie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: Honnêtement ? J''en ai rien à foutre de ta photo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: Ça a l''air OK. Comme la moitié des traîtres que j''ai enterrés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: Encore cette merde ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: Dégage de là. Je vais pas te renifler les aisselles non plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: S''il y a quelque chose qui pousse au milieu de tout ça, mais je préfère pas savoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: Tu te fous de moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: T''es libre… pour le moment. J''ai pas le temps pources conneries.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: Bon, d''accord. Mais ça veut pas dire que t''es tiré d''affaire pour autant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: Ouvre grand tes yeux. Arrête tes conneries.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: J''ai pas le temps pour ça maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: Hum… Sale ou propre, ça change rien. Les Visiteurs se fondent bien dans le décor, de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: Allez, magne-toi. Je mords pas, sauf si j''ai pas le choix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: Assez bavardé. J''ai pas de temps à perdre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: Fais pas le malin. Un faux pas, et c''est fini pour toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: Ça a l''air propre. Mais ça aurait été plus simple que ce soit pas le cas. Ça t''aurait évité des soucis plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: Ouvre ta bouche. Plus grand, putain. Je suis pas ton dentiste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (Montrer les oreilles)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (Montrer une photo)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (Montrer les aisselles)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (Montrer les yeux)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (Montrer les mains)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (Montrer les dents)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: Bon. Assez parlé. Montre-moi une preuve que t''en es pas un.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: Ils ont ri. Ils m''ont dit de m''engager. Je les emmerde. Eux, ils embarquent, c''est tout. Les Visiteurs sont toujours là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: La FEMA est arrivée. Ils ont parlé de nettoyage. Je leur ai dit que c''était déjà fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: J''ai tué la femme en premier. Ensuite, lui. Les enfants ont réussi à s''enfuir avec les voisins.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: Quand les Visiteurs ont grimpé sur le toit, ce salaud leur a ouvert et l''a laissée s''enfuir. Je me suis chargé du reste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: Mais la femme… elle avait les signes. Et lui, il suppliait : « C''est ma femme. Ne lui faites pas de mal ! »'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: Y avait une famille qui vivait à la périphérie de la ville. Ils s''étaient barricadés, le père tenait toujours la porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: Mais là ? J''en ai plus rien à foutre. J''ai déjà tourné la page.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: Je vais pas perdre mon temps à la chercher. Si mon frère avait eu du cran, y aurait peut-être encore une chance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (Montrer les oreilles)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (Montrer une photo)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (Montrer les aisselles)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (Montrer les yeux)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (Montrer les mains)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (Montrer les dents)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: Bon, assez parlé. Montre-moi une autre preuve, et plus vite que ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: Les yeux hagards, mais vivante. Ça, je respecte. Si mon frère était mort plus tôt, sa famille serait peut-être vivante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: Je les croyais morts. Un peu après, je les ai revus. La première à sortir des bois ? La gosse. Un fusil à la main.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: Il a fait sortir sa famille par-derrière, dans les bois. J''ai descendu ces abominations, mais ils sont jamais revenus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: J''ai vu une famille un jour. Le père était costaud. Il a tenu bon, même quand les Visiteurs hurlaient à la fenêtre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: C''est à cause de lâches comme lui qu''on est dans la merde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: Mais il s''est dégonflé comme une mauviette. Résultat ? Ils sont soit enterrés, soit Dieu sait où.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: Faut bien. J''ai dit à mon frère… Sois un homme, protège ta famille. Et qu''est-ce qu''il a fait ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: Tu veux la retrouver ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: Ça va, tu tiens le coup ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: Si mon frère avait pas été si lâche, il aurait su protéger sa famille. Maintenant, qui sait où elle est, la mioche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: Me revoilà. Je sais même pas pourquoi je me suis donné cette peine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: J''ai pas le temps pour ça. J''ai des problèmes plus importants à régler. Je reviendrai plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: Essaie de m''avoir encore une fois avec cette histoire d''oreilles, et je te fais une cervelle de moineau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: Si c''était pas pour mon frère…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: Les oreilles, hein ? Tu me prends pour un con ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: Tu sais quoi ? Je m''en fous. J''ai des trucs plus importants à faire. Vis un jour de plus. On vérifiera ça plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: Mouais. Ça a l''air clean, c''est sûr. Mais j''ai déjà buté trop de types « clean » pour que je te croie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: Une photo ? L''aura, hein ? D''accord, voyons un peu si t''es vraiment « clean ».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: Tu t''en tires bien. T''as de la chance. Allez, dégage-moi tes aisselles de ma vue, j''ai mieux à faire. Je repasserai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: Ça m''a l''air en ordre. Mais ça veut rien dire. Ces tarés sont plus doués pour faire semblant que moi pour les démasquer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: Mouais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: Pas maintenant. J''ai des problèmes plus importants à régler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: Tu t''en tires pour cette fois. Mais si je vois encore quelque chose qui cloche, je tire sans hésiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: Tu sais ce qu''un de ces types « normaux » peut faire en une seule nuit ? Une seule erreur et tout le monde y passe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: Heh… Rien de spécial, hein ? Génial. Juste génial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: Allez. Sers-toi de tes doigts. Ouvre bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: J''ai pas le temps de m''occuper de tes mains maintenant. Je t''examinerai mieux la prochaine fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: Écoute bien. Je vais te donner un petit conseil : ceux qui ont l''air normaux, c''est toujours les premiers à changer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: C''est bon… Mouais… Bien sûr que c''est bon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: Putain, j''ai pas le temps pour ces histoires. Je dois aller vérifier quelque chose. À plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: Bon, d''accord. Va pour cette fois. Mais si je remarque encore un truc bizarre, on passera direct à l''action.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: Mouais. C''est bon. Dommage, vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: Encore plus large. Allez, fais pas dans ton froc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (Montrer les oreilles)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (Montrer une photo)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (Montrer les aisselles)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (Montrer les yeux)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (Montrer les mains)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (Montrer les dents)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: T''as une arme ? J''en ai rien à foutre. On mourra tous les deux en se tirant dessus, alors.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: Montre-moi une preuve. N''importe laquelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: Mmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: Les Visiteurs profitent des faibles au cœur tendre. C'est comme ça qu'il y en a qui se font buter chez eux.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: La vraie justice, c'est maintenant.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: Et sa femme… On s''en fout de sa bonne femme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: Il a une gamine. Une petite fille. Je sais pas trop quel âge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: D''ailleurs, pendant que je suis là… Dis-moi, tu connaîtrais pas un mec trapu, avec une veste en jean bleu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: Les Visiteurs profitent des faibles au cœur tendre. C''est comme ça qu''il y en a qui se font buter chez eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: La vraie justice, c''est maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: Y a que la petite qui s'en est sortie. L'homme que tu cherches est mort.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: Sa maison a brûlé. Je l'ai pas revu depuis.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: Et sa femme… On s''en fout de sa bonne femme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: Il a une gamine. Une petite fille. Je sais pas trop quel âge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: D''ailleurs, pendant que je suis là… Dis-moi, tu connaîtrais pas un mec trapu, avec une veste en jean bleu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: Un seul symptôme, et je les descends. J''hésite même pas une seconde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: On nous a clairement expliqué comment faire à la télé et à la radio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: Comme toi, pardi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: Et s'ils n'ont qu'un ou deux symptômes ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: Comment tu fais pour reconnaître un Visiteur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: Est-ce que la FEMA a abandonné la ville ? Ou juste le quartier, peut-être ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: Mais j''ai fait le tour de plusieurs maisons… Ça grouille de Visiteurs dans le coin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: J''ai essayé de retrouver quelqu''un. Peine perdue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: Me revoilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: Je repasserai plus tard… T''es intéressant, toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: Je dois aller voir quelqu''un.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: Alors… pourquoi tu dis qu''il faut s''en méfier ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: Ils ont leurs méthodes pour repérer les symptômes des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: Ils savent ce qu''ils font.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: Reste bien au chaud. On en reparlera plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: J''ai besoin de le constater par moi-même. Et je le ferai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: Mais je te fais pas confiance pour autant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: Donc, toi aussi, tu essaies de rétablir l''ordre. C''est bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: Tu as piqué ma curiosité. Je repasserai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: Ouais, je veux bien te croire. T''as pas l''air du genre à colporter des rumeurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: Intéressant. Et tu l''as vu de tes propres yeux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: Donc… sans armure ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: Un seul ? À moitié à poil ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: La FEMA enlève les gens. Aucun moyen de savoir s'ils vont revenir un jour.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: Les Visiteurs continuent de sortir de nulle part. Mais au moins, j'ai un flingue.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: Un Visiteur à moitié nu a massacré toute une patrouille.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: Qu''est-ce qui se trame dans le coin ? De qui il faut se méfier ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: T''as posé tes questions. Maintenant, c''est à mon tour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: Minute, papillon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: Et donc… Tu comptes « faire le ménage » encore longtemps ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: Et donc… Qu'est-ce que tu viens faire ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: Mais s''il y en a un qui sort du lot… Je prends autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: En général, je leur arrache juste une dent aux Visiteurs. C''est plus facile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: Ça, c''est un peu comme un souvenir… Ça me rappelle les maisons, les villes que j''ai purgées.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: Ahah. Elle est bien bonne, celle-là. Je m''en souviendrai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: Un répulsif ? Oh, tu parles du collier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: Et donc… Tu comptes « faire le ménage » encore longtemps ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: Et donc… Qu'est-ce que tu viens faire ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: Et ceux qui ont pitié des Visiteurs… Ils ont qu''à rester avec eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: Mais le plus efficace ? C''est de les enfermer dans une maison et d''y foutre le feu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: Je pourrais faire le ménage à mains nues. Mais ça, ça marche mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: Ouais… C''est un balai…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: Ahah ! Elle est bien bonne celle-là !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: C'est quoi cet attirail ? Un répulsif pour les Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: Laisse-moi deviner… C'est un balai que tu tiens dans tes mains ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: Moi, je me cache pas derrière des murs. Moi, je suis leur justice. Je fais régner l''ordre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: Y a plus aucune justice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: Et puis, quelques jours plus tard, les Visiteurs massacrent tout le monde dans la maison et ils se barrent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: Y a des gens qui ont pitié des Visiteurs. Ils pensent qu''ils peuvent, je sais pas… redevenir normaux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: Il s''agit pas d''une putain d''aventure.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: C'est quoi cet attirail ? Un répulsif pour les Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: Laisse-moi deviner… C'est un balai que tu tiens dans tes mains ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: Pour ce qui est du reste, c''est pas tes oignons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: Je me suis occupé de mon secteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: Je suis là pour faire le ménage.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: Pourquoi tu te promènes dehors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: On se connaît ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: À moins que… tu sois un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: C''est pas bête. Ça augmente tes chances de survie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: Tu gardes tes distances, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: Tu vas retourner à ta petite vie comme si de rien n''était ? Allez, descends. On va découvrir ça. Ensemble. Alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: Et si ce qu''il y avait au fond allait tout changer ? Te révéler toutes les réponses ? Tu vas laisser passer ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: Tu veux pas savoir ? Tu rigoles ? Tu sais bien que c''est pas juste un trou. Tu le sens, toi aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: Alors ? Qu''est-ce que t''attends ? On est là pour ça, après tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: T''es pas le genre de mec à passer le reste de sa vie à se demander ce qui se serait passé s''il avait pas flippé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: Allez, un peu de courage. Descends, je te tiens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: Et t''as envie de savoir ce qu''il y a en bas, non ? T''es pas un lâche, je le vois bien. T''es déjà descendu trois fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: Je peux te remonter d''une seule main. Mais si je pars, qui va te tirer ? C''est logique, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: Qui va te remonter si je pars, hein ? Toi ? Sans vouloir te vexer, t''es un vrai sac d''os. Tu y vas, je reste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: Et si on ne découvre jamais ce qu'il y a là-dessous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: Pourquoi tu y vas pas toi-même ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: Tu le sens aussi, pas vrai ? Cette attraction… comme si le trou t''appelait. Tu le sens, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: Quel autre ? Écoute, il faut se lancer. On va pas rester assis là éternellement. C''est maintenant ou jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: Et si on ne découvre jamais ce qu'il y a là-dessous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: Pourquoi tu y vas pas toi-même ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: Mais bon, en attendant, on a le temps. Le temps d''explorer cet endroit. T''es pas curieux ? Allez, avoue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: Lui ? Oh, il est vivant, c''est sûr. La corde est toujours tendue ! Il est là, il travaille. Sinon, j''le verrais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: L'autre est toujours introuvable ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: Tu penses que ton pote est toujours en vie ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: Mais ce trou… Sois honnête, tu meurs déjà d'envie d'aller dedans, pas vrai ? Il t'attire, nan ? Admets-le.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: Ou peut-être que j'ai des hallucinations à force d'être resté assis ici trop longtemps.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: Ah, j''croyais que tu t''étais dégonflé. Mais y a un truc qui cloche. La lumière est bizarre et la corde est plus lourde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: T''es pas taillé pour les efforts, mais je peux te remonter, moi. Alors ? Tu vas jeter un œil, et… je monte la garde ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: Une descente et on aura peut-être la réponse. J''irais bien, mais… quelqu''un doit tenir la corde, j''te jure !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: Et si toutes les réponses étaient là-dessous ? Pourquoi ils sont venus… Ce qu''ils veulent… Penses-y !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: Quoi ? Les Visiteurs ? C''est ce que je disais ! On pense que c''est leurs tunnels. Et ce trou ? Peut-être une porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: On y va ensemble ? Ah, mais faut que quelqu''un tienne la corde pour te remonter !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: C''est pas que j''ai peur, mais… ça t''attire. Si seulement je pouvais jeter un autre coup d''œil… un peu plus près…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: Mais parfois, quand t''es près du bord, tu sens comme si quelque chose t''appelait. J''te jure, essaye.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: Je me suis approché quand les autres étaient encore là. Mais là-bas, c''est comme regarder dans le vide. Le vrai vide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: J''aimerais bien, mais un seul faux mouvement avec cette corde et c''est fini, j''te jure.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: Aller voir ? En quelque sorte. Pas vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: Tu crois pas qu'il est arrivé quelque chose à ton pote là-dessous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: T'es pas allé voir dans le trou par toi-même ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: La corde est tendue, donc il bosse encore. On le saurait si y avait un problème. Tu risques de les voir en remontant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: L''autre est accroché à la corde. Il tirera dessus quand il sera prêt, ou si ça tourne mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: Hein ? Mes potes ? Non, ils vont bien. Y en a un qu''est loin, mais il va remonter. Il sait trouver les issues, lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: Tu crois pas qu'il est arrivé quelque chose à ton pote là-dessous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: T'es pas allé voir dans le trou par toi-même ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: Mange bien là-haut. Sinon tu finiras comme moi. Affamé, sous la surface, avec rien d''autre qu''une lanterne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: J''en sais rien. On perd la notion du temps ici. Pas de lumière, pas d''horloge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: Hein ? Parle plus fort ! Je suis assis là depuis deux jours, peut-être trois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: Tes potes… Ils sont pas encore revenus ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: Ça fait combien de temps que t'es là ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: Déjà de retour ? C''est plus calme là. Hein ? Ou alors, je deviens sourd à cause de ce bourdonnement ? Bon, dis-moi tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: Je t''en dirai plus une fois que tu seras là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: On a essayé. Tout a failli s''ébouler sur nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: Écoute, si tu veux rester dans le coin, t''approche surtout pas de ce trou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: Un des gars était curieux. Il dit que ça valait peut-être le coup d''aller voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: Juste un trou. Mais il se passe des trucs bizarres aux alentours.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: Nan, rien de très intéressant, en fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: Hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: On a essayé. Tout a failli s''ébouler sur nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: Écoute, si tu veux rester dans le coin, t''approche surtout pas de ce trou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: Un de mes potes y est allé. Moi, je suis resté là, au cas où il aurait besoin d''un coup de main.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: Les animaux se taisent. La boussole déraille. Les lampes torches éclairent pas dans le noir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: Il se passe des trucs bizarres à côté. Y a un bruit sourd, tout le temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: Y a un trou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: Vous avez attrapé un Visiteur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: Ah ouais ? Quelque chose d'intéressant ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: Mais les tunnels, c''est pas le plus bizarre, j''te jure. Y a autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: On n''en a encore vu aucun, donc on peut pas en être sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: On pense que les Visiteurs s''en servent pour se déplacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: On n''a aucune idée de qui l''a creusé ni pourquoi. On a bien quelques idées, bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: On a commencé à creuser, et qu''est-ce qu''on a trouvé ? Tout un RÉSEAU DE TUNNELS !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: Un abri, bon sang ! Pour échapper à cette chaleur infernale !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: Vous avez attrapé un Visiteur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: Ah ouais ? Quelque chose d'intéressant ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: Mais on s''en fiche de ça… Parce qu''on a trouvé autre chose !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: Ces tunnels sont profonds, j''te jure. Vraiment profonds. On ne sait pas où ils finissent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: Avant, y en avait encore plus, mais une partie s''est effondrée récemment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: On venait à peine de commencer, que… Vois par toi-même ! On a trouvé tout un réseau souterrain !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: Les gars et moi, on s''est dit qu''on allait creuser des tunnels pour se mettre à l''abri de la chaleur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: Tu cherches quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: T'es là pour quoi faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: J''ai tellement de poussière dans les oreilles que j''ai l''impression que tu me parles à travers un oreiller, j''te jure.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: Coincé ? Nan ! On a trouvé un truc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: Hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: Tu cherches quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: T'es là pour quoi faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: Eh ben, j''espère qu''elle va pas nous tomber sur la tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: On est sous ta maison ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: Je suis couvert de poussière et de suie, j''entends rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: Quoi ? Parle plus fort !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: T'es coincé là-dessous, ou bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: Qu'est-ce que tu fabriques sous ma maison, toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: … Je crois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: Hein ? Y a quelqu''un ? J''ai entendu un bruit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: Salut, salut !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: Je te souhaite une belle journée, une bonne santé, plein de joie et de sourires, mon gaillard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: J''ai bien peur que tout espoir soit perdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: Eh bien, dans ce cas…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: Non
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: Oui
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: Alors, je vais à nouveau te poser, mon gaillard. Tu viens avec moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: Je sais pas ce qui nous attend dans le Pays des Champignons… mais le danger guette.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: On vit des temps durs… Le Pays des Champignons est à genoux. Ils ont trinqué au destin… Peut-être qu''on fera pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: J''ai bien peur de ne pas pouvoir y arriver tout seul. J''ai besoin de ton aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: Oh, mon gaillard… Ça craint.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: Vite ! Avant que la porte du Pays des Champignons ne se referme !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: Oh non ! On est en retard ! Allez, dépêche-toi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: MINUIT ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: Attends. Laisse-moi jeter un œil à ta montre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: Prends tes affaires et…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: Bravo. Voilà qui est bien, mon gaillard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: Non
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: Oui
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: Est-ce que tu es prêt à m''accompagner au Pays des Champignons ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: Aucun humain ne devrait jamais mettre les pieds là-bas. Jamais. Mais on doit le faire, si on veut arrêter le Festival.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: Si on fait rien, tout pourrait être fichu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: On verra pas le Festival là-bas… mais les autres… Le mycélium…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: C''est pas un pays où il y a du soleil et des arcs-en-ciel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: Ça a l''air sympa… dans notre langue. Mais dans le langage des champignons, ça veut dire tout autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: Te fais pas avoir par le nom, mon gaillard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: Non
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: Oui
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: Est-ce que tu es prêt à m''accompagner au Pays des Champignons ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: On doit arrêter le Festival, à tout prix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: Et pour être tout à fait honnête… c''est mieux comme ça. Mais on n''a pas le choix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: C''est un endroit effrayant, où personne n''est jamais allé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: Ça n'a pas l'air si terrible que ça…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: Le pays des champignons ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: Je voulais pas en arriver là, mais… Je crois qu''on va devoir aller au Pays des Champignons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: Et donc, le mycélium est dans le pétrin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: Le Festival, ça veut dire que les champignons vont pousser comme des petits fous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: Ça n'a pas l'air si terrible que ça…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: Le pays des champignons ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: Je voulais pas en arriver là, mais… Je crois qu''on va devoir aller au Pays des Champignons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: Mais ces derniers temps, y a tellement de méchanceté que le champignon a dépassé toutes les limites.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: Les champignons, c''est un peu comme un foie qui essaie de purger tout ce poison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: Quand trop de méchanceté s''accumule dans ses filaments, ça bloque tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: Il y a un gros problème avec le mycélium.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: Pourquoi le Festival a-t-il quand même lieu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: Pourquoi ça n'a pas marché ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: Y a tellement de chaos dans le mycélium que le rituel… Ça a pas marché.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: On dirait que le Festival va quand même avoir lieu…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: C''est pas un adieu, mon gaillard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: Et souviens-toi : les champignons ne sont pas toujours ce qu''ils semblent être.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: On fera en sorte que les champignons restent petits et que le Festival n''ait pas lieu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: Je reviendrai en temps voulu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: C''est le mycélium qui a une conscience. C''est dommage que je puisse juste l''écouter… il parle pas notre langue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: Ils font juste partie du mycélium.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: Je peux pas parler aux champignons. C''est logique.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: C''est pas un adieu, mon gaillard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: Et souviens-toi : les champignons ne sont pas toujours ce qu''ils semblent être.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: On fera en sorte que les champignons restent petits et que le Festival n''ait pas lieu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: Je reviendrai en temps voulu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: Et c''est exactement ce qu''on a fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: Mais le Livre des Sourires nous a donné un moyen… un moyen de calmer leurs racines et leur croissance folle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: On peut pas parler directement aux champignons, puisqu''on fait pas partie du mycélium.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: Ce qu''on a fait, c''était un ancien rituel, mon gaillard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: Tu pourrais pas dire aux champignons de pas commencer le Festival, tout simplement ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: En quoi ce que nous faisons peut arrêter le Festival ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: Tout ce qui nous reste à faire, c''est attendre… et espérer que ça aura suffi à empêcher les champis de pousser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: Oh, mon gaillard… Si seulement c''était aussi simple. On sait toujours pas si tout ce qu''on a fait a vraiment aidé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: Tu pourrais pas dire aux champignons de pas commencer le Festival, tout simplement ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: En quoi ce que nous faisons peut arrêter le Festival ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: Les champignons poussent beaucoup trop vite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: Il sait plein de trucs. Mais maintenant, lui aussi est en danger… Comme nous tous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: C''est le mycélium qui m''a dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: T'as pas l'air convaincu.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: Comment tu sais ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: J''espère vraiment que cela suffira à annuler le Festival…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: Te voilà, mon gaillard ! Tu as fait tout ce que le Livre des Sourires t''a demandé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: Arf… Peut-être que je perds mon temps…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: Mais pourquoi ? C''est juste une petite fraction du livre… Et je la connais déjà par cœur…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: Je te souhaite une belle journée, une bonne santé, plein de joie et de sourires, mon gaillard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: Je reviendrai quand t''auras fait tout ce qui est écrit dans les pages.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: Bon. Je dois filer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: Super. Jette un œil quand t''as un moment de libre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: Non, il vaut mieux que tu les gardes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: Très bien… Je vais prendre les pages du Livre des Sourires.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: J''ai arraché quelques pages du Livre des Sourires. Tiens, prends-les. Elles te diront quoi faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: On ne peut pas rester là à attendre que ça arrive. Il faut qu''on fasse quelque chose pour empêcher ça. Ensemble.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: Et ce champignon ne sera pas le seul. Car le Festival approche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: Son ombre va recouvrir le soleil. Et il n''y aura aucun endroit qui sera épargné.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: Un grand champignon va s''élever. Et il va disperser ses spores partout. Et loin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: Tout ce que je peux te dire, c''est ce que dit le Livre des Sourires à propos du Festival.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: Ah… mon gaillard…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: Non, il vaut mieux que tu les gardes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: Très bien… Je vais prendre les pages du Livre des Sourires.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: C''est pour ça que j''ai déchiré les pages les plus importantes. Tiens, prends-les.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: Mais j''ai peur qu''on n''ait pas le temps de le lire en entier. C''est un gros bouquin… et l''heure tourne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: C''est un livre très spécial… Le plus spécial au monde. Il explique tout ce qu''il faut faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: Le Festival des Champignons ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: Le Livre des Sourires ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: J''ai quelque chose qui devrait nous aider. Le Livre des Sourires.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: T''inquiète pas, tu comprendras bientôt. Mais retiens bien : il faut empêcher le Festival à tout prix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: Le Festival des Champignons ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: Le Livre des Sourires ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: Il m''a parlé du Festival des Champignons qui approche à grands pas… Et ça, mon pote, c''est vraiment pas bon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: J''ai appris à l''écouter grâce au Livre des Sourires. Et le dernier truc que le mycélium a dit, ça m''inquiète vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: C''est grâce au mycélium que les champignons peuvent communiquer entre eux'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: Oui, oui. Par contre, il est dur à comprendre pour les gens ordinaires. Il parle d''une manière bizarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: Euh… Je suis pas sûr de comprendre…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: Euh… Le mycélium ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: Alors, écoute-moi bien et n''oublie pas ce que je vais te dire…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: Sa façon de parler n''est pas toute simple, mais j''ai appris à comprendre avec le temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: Évidemment que je sais qui tu es. Le mycélium m''a parlé de toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: Euh… Je suis pas sûr de comprendre…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: Euh… Le mycélium ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: Alors, écoute-moi bien et n''oublie pas ce que je vais te dire…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: Le Festival des Champignons approche à grands pas et le temps, mon gaillard… Le temps file entre nos doigts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: Mais c''est sans importance pour l''instant. Le mycélium m''a dit quelque chose de très préoccupant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: Hé hé ! Je ne suis qu''un vieux bonhomme qui s''y connaît un peu en champignons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: Euh… On se connaît ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: Euh… Enchanté ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: Bonjour, bonjour, mon gaillard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: Nous allons partir. Ce qui devait être fait est fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: Quoi qu''il en soit, merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: Ou… Refusez-vous vraiment la paix ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: Est-ce qu''ils vous dérangeaient tant que ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: Je vais les emmener avec moi. Quoi qu''il en soit, merci pour votre aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: Très bien… Vous en avez suffisamment fait comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: Je vous signale que ce n'est pas une garderie, ici !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: Fichez-moi la paix !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: Nous n''avons pas d''autre choix que de continuer à L''appeler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: Mais la Mort… La Mort elle-même… Elle pourrait nous épargner le pire… le néant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: La réincarnation n''est qu''une succession interminable de supplices ponctuée de brefs répits.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: L''au-delà n''est qu''un concept prôné par les religions.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: L''idée de disparaître à jamais est terrifiante, certes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: Ce qui compte… Tout le monde est épuisé…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: Nous n''avons pas besoin de comprendre parfaitement Celle que nous sommes en train d''invoquer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: Je pense qu''Elle ne devrait plus tarder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: Je vous signale que ce n'est pas une garderie, ici !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: Fichez-moi la paix !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: Pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: Dites-moi… C'est quoi votre délire avec la Mort ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: Reprenez vos gros malades et emmenez-les avec vous…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: Bonne nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: Vous savez… Puisque la Mort vous a choisi, je l''aiderai à mieux vous voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: C''est donc pour ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: Ils n''ont pas survécu…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: Dites-moi… C'est quoi votre délire avec la Mort ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: Reprenez vos gros malades et emmenez-les avec vous…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: Je ne m''attarderai pas davantage. Je vais reprendre la route.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: Parfait. C''est exactement comme cela que les choses devraient se passer. Son regard reste rivé sur nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: Du vent ! J'ai d'autres chats à fouetter.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: Les vôtres se portent bien.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: Vous allez bien, j''espère ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: Voilà donc comment le monde touche à sa fin. Sans fracas… Dans un sanglot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: La Mort ne me parle plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: Vous… Vous nous avez privés de cette chance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: Ils sont morts ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: Qu''est-ce que…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: Je ne sais pas encore ce que cela veut dire. C''est très tentant, n''est-ce pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: Elle vous offrira peut-être un endroit où vous cacher. Loin de tout. Loin même du concept même de « mort ».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: La Mort m''a parlé il y a peu. Elle espère vous rencontrer lorsque le moment sera venu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: Je suppose que vous devez être fatigué vous aussi. De tout ce bruit. De ces journées difficiles. De cette confusion.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: Merci pour votre aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: J'en ai rien à faire. J'ai déjà assez de problèmes comme ça.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: Ouais, ouais… Ils sont vivants.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: Inutile de perdre du temps. Comment vont les miens ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: À plus tard. Je reviendrai prendre de leurs nouvelles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: Il ne leur faudra pas beaucoup de temps. Mais veillez tout de même sur eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: Cela ne durera sans doute pas longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: Laissez-les donc rester.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: Où irez-vous alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: Même si vous survivez, votre maison sera détruite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: D''autres viendront. Pendant que vous dormirez, ils arroseront votre maison d''essence et allumeront un brasier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: Vous croyez qu''il n''y a que nous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: Je n'apprécie pas les menaces. Mais je veux bien vous aider.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: Dans ce cas, je vous abattrai tous.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: Je le regrette, mais nous n''avons pas le choix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: C''est pourquoi je dois vous avertir que si cette mission échoue, alors nous brûlerons votre maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: Mais au-delà, c''est notre survie qui est en jeu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: Veillez sur les miens. Et n''oubliez pas que si l''un d''entre eux venait à mourir, votre maison serait réduite en cendres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: N''aspirez-vous donc pas à la paix ? À un monde où nul ne serait un fardeau pour autrui ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: Je vois. La route qui mène à un objectif plus noble n''est jamais sans obstacle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: Je n'apprécie pas les menaces. Mais je veux bien vous aider.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: Dans ce cas, je vous abattrai tous.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: Pardonnez-moi. Mais c''est la seule solution.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: … Auquel cas nous brûlerons votre maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: Mais si nous sommes plus nombreux à mourir, alors nous aurons échoué…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: Veillez sur les miens. Et n''oubliez pas que si l''un d''entre eux venait à mourir, votre maison serait réduite en cendres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: Peut-être finirez-vous par brûler après tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: Ça n'a pas l'air d'être une mince affaire.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: Je ne saute pas vraiment de joie à cette idée…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: Ils accompliront les derniers rites pour les défunts. À vous de les protéger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: Mais les miens, eux, resteront ici. La Mort règne en maître sur cet endroit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: Moi, je n''entrerai pas. Ma mission est de répandre la Foi qui apporte la paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: Ça n'a pas l'air d'être une mince affaire.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: Je ne saute pas vraiment de joie à cette idée…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: Ils doivent survivre suffisamment longtemps pour mener à bien leur mission.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: Quoi qu''il en soit, je l''implore, laissez les miens rester ici. Protégez-les.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: Que se passe-t-il donc ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: L''influence de la Mort est particulièrement forte ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: Votre maison est parfaite pour cela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: Nous sommes tenus d''accomplir les rites funéraires. D''une nouvelle manière.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: Vous avez l'intention d'entrer, n'est-ce pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: Et alors… Qu'est-ce que vous voulez ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: Elle est déjà toute proche. Tout ce que nous faisons, c''est l''aider à franchir le seuil, tout simplement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: Nous ne croyons pas au salut. À moins qu''il ne vienne de la Mort elle-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: Ceci est mon linceul. Quand nous mourons, inutile de chercher un tissu pour envelopper nos corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: Peut-être bien… Mais ça ne me dérange pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: Vous avez l'intention d'entrer, n'est-ce pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: Et alors… Qu'est-ce que vous voulez ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: C''est la seule façon de trouver la paix. En des temps comme ceux-ci, il n''y a aucun retour en arrière possible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: Tout ce que nous faisons, c''est L''aider à se rapprocher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: La Mort est arrivée. Elle désire apaiser l''humanité. Elle veut nous libérer de l''angoisse, de l''amertume et du bruit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: Nous venons avec une nouvelle Foi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: Vous avez tout l'air d'être le membre d'une de ces sectes bizarres…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: Mais vous êtes qui, au juste ? Et c'est quoi cette tenue ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: La Mort… semble vous apprécier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: Certains ont été brûlés. D''autres, traînés dehors et exécutés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: La Mort est partout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: Vous avez raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: Vous avez tout l'air d'être le membre d'une de ces sectes bizarres…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: Mais vous êtes qui, au juste ? Et c'est quoi cette tenue ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: Je ne sais pas combien de personnes sont mortes ici… Mais Sa présence est palpable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: La Mort aime votre maison. Elle s''y sent très bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: La Mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: Cette maison est la mienne.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: Et que sentez-vous exactement ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: Je peux le sentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: Parfait ! Votre maison fera l''affaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: Tenez. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: Comment ce connard a-t-il pu penser qu''un simple livreur était dangereux ? Pourquoi l''avoir tué ? Bordel…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: Les gens ont complètement perdu les pédales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: Il était en train de livrer une commande et le propriétaire…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: Mon ami s''est fait buter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: Qu'est-ce qui vous est arrivé ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: Livraison…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: Passez une bonne nuit…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: Et si mes yeux deviennent rouges à cause de mes insomnies ? Ils vont me traîner dans une zone de quarantaine aussi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: Et hop. Ni une ni deux, ils l''ont emmené. Maintenant, je sais même pas ce qui lui est arrivé ou s''il sortira un jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: Contrôle du matin, comme d''habitude. Ils ont remarqué ses yeux. Des yeux rouges… Bon sang !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: Un de mes collègues a été embarqué par la FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: Vous avez l'air d'avoir le moral dans les chaussettes, dites donc !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: Bonjour… Une livraison pour vous !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: Passez une bonne soirée !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: Au moins, avec le boulot, je peux me changer les idées et éviter de penser à toute cette merde…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: Eh bien… Qu''est-ce que j''aurais pu faire d''autre ? Rester moisir chez moi comme la plupart des gens ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: Ah ! Vous vous demandez comment j''en suis arrivé là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: Après avoir passé les tests, ils ont vérifié tous les symptômes, et ils ont décidé que j''étais humain, et…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: Comment êtes-vous devenu livreur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: Bonjour ! Voici votre livraison For Rest !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: Désolé, j''arrive pas à m''y faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: Passez une bonne journée… Euh, une bonne nuit !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: Je ne savais pas qu'il y avait encore des livraisons !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: Bonjour ! Voici votre livraison For Rest !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: C''est dur de vivre sans rêves. C''est dur pour tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: Pourvu que oui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: Tu penses que les gens se remettront à rêver un jour ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: Mais s''il y a quelqu''un dans cette maison qui rêve, c''est déjà ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: Merci. Je vais essayer de dormir ici, même si je vais probablement pas y arriver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: Je suppose que tu peux entrer…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: Peut-être que si je dormais, moi aussi je verrais quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: J''ai pas dormi depuis six jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: Difficile à dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: Je suppose que tu peux entrer…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: À mon avis, c''est parce qu''ils ont perdu cet espace. Ce temps pour se reposer. Pour réfléchir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: Mais ces jours-ci ? Les gens pètent les plombs. Ils deviennent fous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: C''est le seul véritable moment où on lâche prise. On cherche des réponses, on se réconforte… on se calme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: Les rêves, c''est… délicat. C''est bizarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: Et toi, tu rêves ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: Qu'est-ce que ça peut te faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: Je me demande… Est-ce que c''est à cause du soleil ? Ou d''autre chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: C''est pareil pour plein de gens. Même quand ils ont de la fièvre… rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: Ah, voilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: Et toi, tu rêves ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: Qu'est-ce que ça peut te faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: À ton avis, pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: Les gens rêvent presque plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: Tu sais ce que j''ai remarqué ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: Je te parle des rêves. Tu sais ce que c''est, nan ? Quand tu dors… Tu vois des trucs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: Non, pas vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: Euh… Quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: Dis-moi, ça t''arrive de rêver ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: Salut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: Je sais même pas pourquoi je le garde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: Je suppose que cette combinaison fait un peu peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: … Attends, c''est pas ce que je voulais dire. Ouais, je comprends.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: Quoi ? Ah, merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: Je pensais pas que tu me laisserais entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: Je peux m''asseoir où je veux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: Quoi ? Oh, merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: Je veux que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: Je parle de programmation, au passage. Écrire du code.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: Je me suis retrouvé à ne rien faire de ce qu''on m''avait promis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: Puis il y a eu la déception.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: J''avais un travail. Je pensais que tout allait bien dans le meilleur des mondes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: Bonne question. Pour l''instant, je me sens juste… perdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: Je veux que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: J''ai craqué et j''ai fini par démissionner.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: Y avait plus assez de personnel. On n''arrivait plus à suivre. Et le travail arrêtait pas de s''accumuler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: Mais… J''ai plus de travail maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: Je fabriquais des frigos. Je les réparais aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: Moi, je suis juste un ouvrier comme tant d''autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: Mais alors, quel est votre plan ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: Mais alors, vous êtes qui au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: Qui sait ce qui se passe vraiment là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: Des gens qui ne reviennent jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: À cause de… ce qu''ils font. Ils emmènent des gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: Pour autant que je sache, tout le monde les déteste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: Oh ! Non, je travaille pas pour la FEMA. C''est à cause de l''uniforme que tu crois ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: Je comprends pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: Hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: Mais alors, c'est quoi ton plan ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: Mais alors, tu es qui au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: Hein ?! Je comprends de quoi tu parles, là…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: Peut-être que le soleil laisse des radiations pendant la nuit ? Ou un truc du genre. Je préfère pas savoir…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: Je me suis dit que ce serait plus sûr comme ça. S''ils en portent, ça doit bien être pour une bonne raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: Tu fais fausse route ! Je l''ai juste récupérée sur un cadavre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: Oh… Tu m''as pris pour un agent de la FEMA à cause de ma combinaison ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: Vous en avez après moi cette fois-ci ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: Rendez-moi d'abord tous ceux que vous avez embarqués !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: Est-ce que vous allez… l''ouvrir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: J''ai entendu des bruits de pas… ce qui veut dire qu''il y a quelqu''un derrière la porte…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: Bonsoir ? Il y a quelqu''un ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: Moi, je quitterai plus jamais cette maison. Plus maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: J''ai entendu des histoires… Quelqu''un quitte la maison, revient… Et boum. C''est fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: Et un jour, les Visiteurs viennent frapper à la porte… Ou pire… Ils sont déjà à l''intérieur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: Tu rentres chez toi, et c''est vide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: Tu te casses le dos à creuser toute la journée, toute ta vie… Et tout ça pour quoi, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: Hé hé… mon vieux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: Fais vite avec la porte, tu veux bien ? J''ai peur que les Visiteurs me retrouvent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: Merci, mon vieux !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: Vaudrait mieux que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: Entre, vite.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: Bref, j''ai tout laissé tomber. Au diable tout ça. J''en ai assez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: Si seulement les ennuis nous protégeaient autant qu''on les apréhende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: Le soleil finit par cramer les corps de toute façon. Et les nuits sont trop courtes pour s''occuper des morts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: Plus personne m''apporte de cadavres. Les gens s''en foutent de la mort, alors les funérailles…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: Ce boulot, ça vaut plus rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: Vaudrait mieux que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: Entre, vite.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: Je me suis tiré en courant. J''ai même pas regardé derrière. J''ai pas voulu rentrer chez moi, tout seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: Un putain de Visiteur ! Il rampait hors du sol ! Et ce type, là ? Il riait…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: J''pensais que c''était une pierre, mais non… C''était une main qui sortait !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: Je creuse, je creuse… et tout à coup, boum ! La pelle frappe quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: Il est là, debout. Il me regarde travailler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: Bon sang… J''creusais une tombe… Un gars en avait commandé une.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: T'as quitté ton boulot, comme ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: T'as vu quelque chose de particulier ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: On les laisse juste là où ils sont tombés. Le soleil finira bien par les dessécher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: Ces derniers temps, les gens tombent comme des mouches, mais y a plus personne pour les enterrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: Si t''avais vu ce que j''ai vu en creusant la dernière fosse, tu comprendrais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: Excuse-moi pour le bruit. C''est juste que…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: T'as quitté ton boulot, comme ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: T'as vu quelque chose de particulier ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: Les tombes, ça veut plus rien dire. Les tombes sont là où les gens tombent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: J''étais fossoyeur, tu sais ? Mais à quoi bon, maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: J''ai pas fermé l''œil de la nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: Hé, excuse… J''voulais pas te réveiller.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: Et si tu frappais à la porte avec ta caboche, plutôt ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: Oh ! Pas la peine de cogner à la porte comme un gros bourrin !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: Je peux entrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: Y a quelqu''un là-dedans ? Ohé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: Bon, d''accord. Moi aussi, je vais y aller.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: Hein ? Tu t''en vas déjà ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: Je suis juste de passage. J''vais pas rester longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: Tu connais pas un coin tranquille dans les parages ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: C''est bon, c''est pas grave…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: C''est tout sauf ennuyeux, promis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: Viens discuter avec moi un de ces jours. Je te raconterai des histoires. J''en ai plein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: Ouf, enfin ! J''vais pouvoir me reposer comme un être humain normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: Tu rigoles ? Casse-toi !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: Allez, entre…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: En attendant… Si toi, tu restes ici… Tu crois que je pourrais dormir chez toi ce soir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: Sauf… Peut-être une fois… Mais c''est une longue histoire. Je te raconterai un de ces quatre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: Écoute… Je sais que j''suis pas un saint, mais j''ai quand même des principes. Moi, je touche pas aux vivants.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: Bah quoi ? Tu m''as pris pour un gangster ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: Tu rigoles ? Casse-toi !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: Allez, entre…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: J''ai plein d''histoires à raconter. Des trucs que j''ai vus dehors.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: Y a pas mort d''homme, non ? Enfin… Vu que t''es là… Tu pourrais me laisser rester ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: Mais ouais… Je comptais voir ce qu''il y avait chez toi. Je croyais que t''étais pas là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: Un jour, j''ai failli tout arrêter pour de bon. J''ai failli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: Je prends ce que je peux. J''en vends une partie et le reste, je le garde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: Bon. Pas la peine de te mentir. J''me balade dans des endroits abandonnés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: T'es un voleur, c'est ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: Comment t'as survécu tout seul ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: Ça commence à me peser. J''ai l''impression de devenir dingue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: Mais en vrai, j''en ai marre. J''en ai marre de parler tout seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: Au début, je pensais que c''était plus sûr comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: Depuis que les Visiteurs sont sortis de leur terrier… Je suis tout seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: Bah ouais, pourquoi pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: T'es un voleur, c'est ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: Comment t'as survécu tout seul ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: Mais bon… J''ai pas réussi à m''intégrer à un groupe… Alors voilà, j''me retrouve tout seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: Le truc, c''est que j''ai vu ce que les gens font vraiment, moi. Je suis loin d''être le pire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: Comme s''ils valaient mieux que moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: Qui voudrait traîner avec moi, hein ? Les gens pensent que je suis un sale type.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: Qu'est-ce qui te fait croire que c'est une bonne idée ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: Pourquoi t'es tout seul ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: Écoute, ça te dérange si je reste un peu ? Ça fait un bail que j''ai pas parlé à… quelqu''un.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: À moins que.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: Hé, salut ! J''croyais que la maison était vide. Je vais m''en aller.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: Oh, ça alors… Y a quelqu''un ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: Je vous souhaite une bonne fin de journée…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: Et cela ne plairait pas du tout, croyez-moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: Attention. Je pourrais interpréter ça comme une atteinte à ma vie, ce qui relève de l''article 119 de la Constitution.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: Excusez-moi ? Êtes-vous en train de me dire de partir ? C''est une menace ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: Nous discuterons des conditions de location plus en détail par la suite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: Merci, cher propriétaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: Soit je paie, soit je ne mets pas le pied dans cette maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: Ce n''est pas convenable. C''est illégal…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: Je m''excuse, mais je ne peux pas vivre ici en toute bonne conscience sans payer de loyer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: Très bien. Nous ferons les choses en bonne et due forme plus tard, avec un contrat juridiquement valable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: Incroyable… Un propriétaire qui refuse de l''argent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: Vous essayez de me rendre service, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: Je n'ai pas besoin de votre argent.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: Euh… Vous payez si ça vous chante.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: Désolé, mais je refuse d''occuper un espace coûteux sans payer ma part.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: Comment ça, vous « laissez entrer » les gens ? Vous êtes bénévole ? C''est un centre d''accueil pour sans-abri ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: Je n'ai pas besoin de votre argent.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: Euh… Vous payez si ça vous chante.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: Mais… Juste pour être sûr, vous facturez combien la nuit ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: Eh bien, d''accord… Nous finaliserons le contrat plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: Ah… Elle n''est pas très… claire, votre réponse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: Je laisse juste entrer certaines personnes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: On peut dire ça comme ça.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: Bien le bonsoir, propriétaire. Est-ce que ce logement est à louer à tout hasard ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: Tu vaux pas mieux que ces enfoirés de la FEMA. J''espère que tu pourriras en enfer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: Putain…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: Ouais, c''est vrai, j''ai paniqué… Mais c''est pas une raison pour me fermer la porte au nez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: Oh non ! Allez, mon vieux… Me fais pas ce coup-là !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: Un clignement d''œil et ils t''attrapent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: Et surtout, oublie pas ! Fais jamais confiance à ces enfoirés en jaune.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: Ouf, merci, mon vieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: Alors je me suis enfui. Je ne peux même plus rentrer chez moi maintenant. Je parie que ces enfoirés m''y attendent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: Ils voulaient m''arrêter avec tout ce que j''avais apporté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: J''ai pas hésité une seule seconde, je l''ai conduit à la FEMA. Grosse erreur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: Un coup d''œil dans le rétroviseur et j''ai vu ses dents blanches comme un panneau d''affichage.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: C''était un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: C''est pas que je sois parano ou quoi que ce soit, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: Alors j''en ai frappé un avec une bouteille que j''avais cachée sous mon manteau, et je me suis sauvé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: Je m''en suis vite mordu les doigts. Dès qu''ils m''ont sorti de la voiture, j''ai compris qu''ils en avaient aussi après moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: Au début, ils m''ont félicité : « Bravo, vous nous avez amené un Visiteur. » Mais ensuite…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: Alors je l''ai discrètement emmené à la FEMA. Une fois arrivé, je l''ai enfermé dans la bagnole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: Je transportais un client, et j''ai remarqué que ses dents étaient trop blanches. Trop parfaites, quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: Ces enfoirés de la FEMA m''ont piqué ma caisse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: Qu'est-il arrivé à ton passager ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: Qu'est-il arrivé à ta voiture ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: Enfin, c''est pas tant que je sois stupide… C''est juste que j''ai juste fait confiance à la mauvaise personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: Je l''ai perdue à cause de ma propre stupidité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: J''avais une voiture, ouais… mais je l''ai plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: Qu'est-il arrivé à ton passager ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: Qu'est-il arrivé à ta voiture ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: Et maintenant, plus de passager… et plus de voiture non plus, tu vois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: Il s''est avéré qu''il n''était pas celui qu''il prétendait être.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: Je transportais un passager, et puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: Par où commencer ? Je suis chauffeur de taxi, tu vois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: Pourquoi as-tu besoin d'aide, au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: Qu'est-ce qui s'est passé ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: Écoute, je suis dans la panade, là. Ça te dérangerait que je fasse profil bas ici pendant un moment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: Salut, mon vieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: Je trouverai un petit coin à l''ombre. Mais je vous en prie… Ne jetez pas mon corps quand l''heure sera venue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: J''attendrai que la mort vienne me cueillir dans sa douce étreinte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: Est-ce que je peux rester dans les parages ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: Gardez le mien, quand le moment sera venu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: J''ignore si vous percevez la beauté de la même manière que moi. Mais dites-moi… Vous ne jetez pas les corps, j''espère ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: Ici, tout est vraiment plus calme que tous les autres endroits où je suis allé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: Ne restez pas là. Partez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: Je veux prendre part à la beauté ultime du monde. En douceur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: C''est justement pour ça que je suis venu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: Non, je ne veux pas. Au fond de moi, j''ai cette impression que les gens d''ici sont prêts à accepter l''inévitable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: Vous croyez que ça aiderait contre la septicémie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: Ne restez pas là. Partez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: Et maintenant, me voilà. Devant vous. Seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: Et puis les Visiteurs sont arrivés. Et, eh bien… Je vous laisse imaginer la suite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: Elle changeait… chaque jour un peu plus. Et c''était magnifique.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: J''ai vécu avec une demoiselle. Je l''adorais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: C''est une bonne question. Mais pour l''instant… Laissez-moi vous répondre ainsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: Est-ce qu'il ne vaudrait pas mieux vous amputer le bras ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: Comment avez-vous contracté une telle gangrène ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: Je n''ai pas ma place dans le chaos de cette ville. Tout le monde s''agite à contre-courant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: Mon histoire est de celles qu''il vaut mieux raconter d''une traite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: Je me demande chaque jour si je vais survivre jusqu''au lendemain.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: De toute façon, je frissonnerais, quoi qu''il arrive. À cause de la putréfaction, voyez-vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: Aviez-vous remarqué ? Les rues ne se rafraîchissent plus. Pas même la nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: Moi, je frissonne… Même dans la chaleur de la ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: Le silence… le vide. Tout est si calme ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: Est-ce qu'il ne vaudrait pas mieux vous amputer le bras ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: Comment avez-vous contracté une telle gangrène ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: J''aimerais bien mourir ici. Lentement. Tranquillement. Savourer chaque instant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: Tout le monde lutte pour survivre. Mais ici… les gens ont fait la paix avec ce qui leur arrive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: Le bruit de la ville me colle à la peau, comme des gouttes de sueur. Ce tumulte, ces bousculades.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: Mon histoire est de celles qu''il vaut mieux raconter d''une traite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: Je me demande chaque jour si je vais survivre jusqu''au lendemain.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: Je ne me sens vraiment pas bien. Et ce n''est pas seulement à cause de la gangrène, vous savez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: Qu'y a-t-il de si beau ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: Pourquoi n'êtes-vous pas resté chez vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: J''aurais aimé pouvoir rester.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: Beaucoup plus calme qu''en ville. Là-bas, tout est bruyant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: Bonsoir. C''est magnifique ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (Un ange passe, puis il se retourne et s''éloigne.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (Votre cri le fait sursauter.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: 'Foreigner: Va-t''en, je t''ai dit !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (Il reste debout et continue de marmonner.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (Il hoche la tête et entre.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: Pars.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (Vous ne pouvez pas en être sûr, mais ses joues semblent mouillées de larmes.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: (Il reste là, debout, à regarder par le judas.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: Pars.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (Vous ne pouvez pas en être sûr, mais ses joues semblent mouillées de larmes.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (Il marmonne quelque chose en agitant les bras.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: Bon… Et qu'est-ce que je suis censé faire de toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: On t'a cousu la bouche ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: (Il se remet à marmonner, mais vous ne comprenez rien.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (Ses sourcils se froncent, pleins de détresse)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: Bon… Et qu'est-ce que je suis censé faire de toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: On t'a cousu la bouche ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (Il n''a pas l''air d''être en mesure de répondre.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (Votre interlocuteur vous regarde en haussant les sourcils.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: Euh… Pardon ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: Oula… Qu'est-ce qui t'est arrivé, à toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: Mmmmmmmmf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: Mmmf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: Avec un peu de chance, je resterai dans les parages, alors n''hésitez pas à me demander de l''aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: Je comprends… Pas facile de faire confiance à quelqu''un par les temps qui courent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: Merci. J''espère que je pourrai aider quelqu''un.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: Si vous me laissez entrer, je pourrai vous raconter ce qui est arrivé aux hôpitaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: C''est une longue histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: Il y avait bien un hôpital en centre-ville. Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: Si vous me laissez entrer, je peux vous expliquer ce qui s''est passé dans les hôpitaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: Et maintenant… il n''y a plus d''hôpitaux. Alors je vagabonde et j''aide là où je peux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: Notre hôpital manquait toujours d''argent, alors je faisais bien plus que ce qui était prévu dans ma fiche de poste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: Avant, j''opérais des gens. J''étais chirurgien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: D'où venez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: Qui êtes-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: Alors je me suis dit que j''allais jeter un œil. Mais la porte était fermée à clé, alors j''ai frappé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: Et avec un tel silence, je ne m''imaginais vraiment pas que quelqu''un vivait ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: La sécurité… et un moyen de lutter contre l''ennui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: Eh bien, je cherche la même chose que tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: Pourquoi cette question ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: D'où venez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: Qui êtes-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: Ou des gens qui pleurent, car ils ne supportent plus leur peine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: Ou des gens qui hurlent de douleur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: En général, il y a toujours des gens qui crient sous l''effet de l''alcool.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: C''est rare qu''une maison pleine de monde soit silencieuse la nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: Quoi ? Ha, non ! Bien sûr que non.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: Vous cherchez quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: Vous étiez en train de surveiller la maison ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: Bonsoir ! Est-ce que je peux entrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: C''est tellement calme ici la nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: Oh, je pensais qu''il n''y avait personne dans cette maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: T''auras bientôt de mes nouvelles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: Ahhh… Je vois… Alors, c''est comme ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: Maintenant, c''est la force qui fait loi. Soit tu te plies aux règles, soit tu te fais avoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: Sage décision.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: Après toi, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: Ce que je veux dire, c''est que je suis pas là pour causer des problèmes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: Moi, je veux pas savoir comment tu vis, alors me demande pas comment je vis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: Ce que tu ne sais pas ne peut pas te faire de mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: Après toi, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: Mais toi ? Ici, l''ordre règne encore. C''est rare. Je me demande comment tu fais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: Et pourtant, j''ai vu le même chaos partout. La peur, ça empêche de voir ce qui se passe vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: Moi, je suis jamais resté trop longtemps au même endroit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: Comment t'as fait pour survivre aussi longtemps ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: T'es allé dans quel genre d'endroits au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: Et si tu dis le contraire, tu seras mort avant demain matin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: C''est le nouveau système : c''est le plus fort qui décide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: Si tu continues à le nier, ils te mangeront tout cru. Ils laisseront même pas tes os.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: On est tous des animaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: Comment t'as fait pour survivre aussi longtemps ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: T'es allé dans quel genre d'endroits au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: Maintenant, tout est simple. Si t''arrives à égorger quelqu''un, t''as gagné.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: Y a plus de règles. Y a plus de morale. Tout ça, ça marche plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: T''es allé voir d''autres maisons ? Tu t''es promené dans la rue ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: T'es sorti de ta cage, c'est ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: Euh… De quoi tu parles ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: Enfin… Fini les faux-semblants.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: C''est plus une société. Les bêtes se sont échappées de leurs cages.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: Le monde entier est parti en vrille, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: Hé !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: Alors… pourquoi résister ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: Moi, je SAIS que tout sera bientôt décidé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: À quoi tu t''accroches ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: Pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: Tu cours, tu cours. T''arrête pas. Tu fuis les miens, je fuis la vérité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: C''est justement pour ça que je suis là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: T''es toujours pas capable de prendre les choses en main.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: Ouiiiii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: T''as peur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: Alors, t''es prêt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: J'en ai viré plus d'un.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: J'ai viré tous les autres.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: J'ai seulement laissé ceux qui méritaient d'être ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: Il y a plein de gens qui n'en sont pas, ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: J'ai laissé entrer personne.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: Il y a plein de monde ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: Est-ce qu''il y a un des miens chez toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: Moi, y a une autre question qui me trotte dans la tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: Est-ce que tu ressentiras quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: Tu disparais, tout simplement ? Pour toujours ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: Tu meurs, OK. Mais après ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: On dirait que tu penses beaucoup à ce qu''il y a… après.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: Ça t''arrive de te demander pourquoi tu es encore en vie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: Dis-moi… Est-ce que t''as peur de l''inconnu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: J'en ai viré plus d'un.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: J'ai viré tous les autres.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: J'ai seulement laissé ceux qui méritaient d'être ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: Il y a plein de gens qui n'en sont pas, ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: J'ai laissé entrer personne.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: Il y a plein de monde ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: T''es tout seul à la maison ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: Dis-moi… Est-ce que tu as laissé entrer un des miens ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: Mais pour l''instant…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: Mais tu finiras par disparaître.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: Pas aujourd''hui ni demain. Non, pas demain. Plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: Tu vas mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: Non, le résultat sera le même.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: Pour changer quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: S''ils m''ont envoyé à toi, c''est pour une bonne raison…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: Tu t''es jamais dit qu''un jour, tu serais choisi ? Ha ha ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: Pourquoi tu poses cette question, maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: Pourquoi tu défonces pas la porte ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: Pourquoi t'es là ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: Mais t''inquiète pas, on va t''aider.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: C''est marrant… Le fait que tu ressentes rien du tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: Je sais pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: Pourquoi tu défonces pas la porte ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: Pourquoi t'es là ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: Elle est déjà là, juste derrière toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: Mais toi… Est-ce que tu la sens ? La mort qui se rapproche de plus en plus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: C''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: Je ne fais que répéter ce qu''on m''a dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: Dans quel but ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: Qu'est-ce que tu veux dire exactement ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: Si ce n''est pas nous qui y mettons fin… Vous y mettrez fin par vous-mêmes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: Hé oui, tout a une fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: Ils m''ont dit que c''était la dernière fois qu''on se verrait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: À la prochaine, alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: Bon, eh bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: Moi, j''obéis juste aux ordres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: Y a des pouvoirs en jeu… Bien plus grands que moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: Toi, tu penses pas que c''est moi qui commande ici, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: Le changement… Ce n''est pas la pire chose qui puisse t''arriver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: Même les miens se font rares ces temps-ci. Sans parler de ton espèce, cloîtrée dans ses maisons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: Tiens, tiens, tiens…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: Viens avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: Ça y est. La règle fonctionne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: Hmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: Non, je suis pas tout seul !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: Oui, je suis tout seul.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: T''es tout seul à chez toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: Mais avant de partir… Si on mettait notre nouvelle règle à l''épreuve ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: Ah ! Évidemment ! C''est comme si j''étais déjà parti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: Je ne suis pas seul.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: Je suis tout seul.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: T''es tout seul à la maison, c''est bien ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: Mais avant…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: On essaie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: C''est simple.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: Tu pourrais pas revenir plus tard ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: Je comprends rien.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: Alors, tu m''ouvres la porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: Si tu as au moins deux des miens dans ta maison…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: On va arranger ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: Comme si t''en avais rien à faire de tout… Même pas de toi-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: T''es plutôt du genre détaché, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: Tu pourrais pas revenir plus tard ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: Je comprends rien.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: Parce que ouais… Maintenant, les corps, ils appartiennent aux chiens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: Tu vas me faire le plaisir de m''ouvrir cette porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: Si t''as au moins deux des miens dans ta maison…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: On va essayer de mettre en place de nouvelles règles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: On dirait que t''as besoin d''aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: Ça doit pas être évident.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: Je m'en fiche…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: Je le sens pas…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: Y a des trucs bizarres qui se passent autour de toi, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: Tu vois de qui je parle, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: Tout ça… Juste à cause d''un mot. Un seul mot. Mais quel mot !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: Et maintenant, l''un des tiens est immortel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: Alors… Moi aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: Le changement, il te poursuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: Tu le sens, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: La prochaine fois qu''on se verra, ce sera… encore plus intéressant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: Tu perds pied.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: La vie a changé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: Tu comprends, hein ? Les choses ne seront plus jamais comme avant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: Le monde appartient aux chiens maintenant. Eux seuls survivront.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: Mais pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: T''es encore en train d''essayer de recoller les morceaux de ta vie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: Dans ce cas… Je vais juste ouvrir la porte et te laisser un petit quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: Ça a pas marché… Avec personne, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: Alors comme ça… T''es tout seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: Je ne suis pas seul.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: Je suis tout seul.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: T''es tout seul chez toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: Écoute bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: La seule chose que tu peux arrêter, c''est un battement de cœur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: Arrêter les inondations, les incendies, la décomposition ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: Tu peux arrêter la mort ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: Et qu''est-ce que tu peux faire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: Je ne suis pas seul.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: Je suis tout seul.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: T''es tout seul chez toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: Écouuuute-moi bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: Face à la mort ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: Face à une calamité cosmique ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: Mais que peut-on faire face aux catastrophes naturelles ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: Ça, j''en suis bien conscient !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: Je fais ce que je peux…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: Je peux rien y faire…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: À moins que… tu veuilles tout arranger toi-même ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: C''est une chance, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: Tout est déjà décidé pour nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: Te prends pas la tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: Je fais ce que je peux…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: Je peux rien y faire…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: Ou peut-être qu''on devrait prendre les choses en main.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: Peut-être qu''avec tout ça, les choses finiront enfin par rentrer dans l''ordre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: Les problèmes s''accumulent, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: Les temps sont durs ces jours-ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: Je sais pas trop quoi penser de lui.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: Il fait son boulot.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: T''en penses quoi de celui-là ? Le type en combinaison ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: Tss… T''es encore cloîtré dans cette maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: Je vais faire venir toute ma famille ici. On va t''aider à survivre, t''inquiète ! Ha ha ha !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: HAHAHAHAHA !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: En fait, ouvre pas du tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: Surtout, ouvre pas la porte à ces types en combinaison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: Sinon, ils vont nous emmener tous les deux, je sais pas où.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: Ah, merci. Mais promets-moi que t''ouvriras pas la porte à ces types en combinaison, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: Rentre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: Alors maintenant, c''est juste une question de survie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: Je crois bien qu''ils en ont embarqué la moitié. Ils ont même pas pris la peine de rattraper les autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: Y en avait qui voulaient pas partir de leur plein gré, les combis les ont sortis de force, au pif.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: Je te jure, c''était tout le bâtiment !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: Rentre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: Les autres, ils les ont laissés repartir, comme si de rien n''était.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: Les combinaisons se sont pointées, ils ont viré tout le monde. Ils en ont embarqué deux-trois pour les examiner.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: Apparemment, notre immeuble a pris un gros choc solaire ou un truc du genre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: Vous étiez nombreux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: Pourquoi est-ce qu'ils vous ont expulsés ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: Ça fait des jours que je cours dans tous les sens, à la recherche d''un endroit où poser mes fesses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: Tout le quartier a été évacué, sans que personne sache où aller.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: Moi, je cherche personne. J''ai juste besoin d''un endroit où dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: Vous étiez nombreux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: Pourquoi est-ce qu'ils vous ont expulsés ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: Tout le monde s''est mis à courir dans toutes les directions. J''ai atterri ici parce que je voulais survivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: Pas de refuge, pas d''aide, rien. On était censés aller où ? On était censés faire quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: Ces types en uniforme jaune nous ont virés de l''immeuble, mais ils ne nous ont emmenés nulle part.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: Avant, j''habitais juste à deux rues d''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: Euh… Tu cherches quelqu'un ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: Euh… Qui es-tu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: Y a du monde ici ou bien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: Hééééééé !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: C''est vrai. Vaut mieux que t''économises tes balles. Salut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: Est-ce que tu pourrais me tirer dessus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: T''as plein de traces de poudre sur les mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: D''accord, à plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: Je comprends.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: Le plafond est un peu bas. Mais ça fera l''affaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: Dégage.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: Je vais partir. Pas la peine de te supplier. Je vais pas t''embêter plus longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: Pas besoin de me laisser entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: Non.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: Dégage.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: Et si ça empirait ? Et si ça ne me tuait toujours pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: J''ai peur d''enlever mes vêtements.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: Tout le monde rôtit au soleil. J''mets plusieurs couches de vêtements, mais j''ai toujours froid.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: J''ai tout le temps froid.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: Enlève ton manteau, bon sang !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: La chaleur, ça te dérange pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: Donc, ouais… ça fait longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: J''ai jamais connu ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: Enlève ton manteau, bon sang !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: La chaleur, ça te dérange pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: Mais plus tard. Je suis pas encore sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: Non, j''en suis pas un. Mais j''ai une faveur à te demander.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: Ça n''a plus d''importance de toute façon. Tu te demandes si je suis un Visiteur, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: Tu cherches depuis combien de temps ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: Euh… Tu es qui ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: Est-ce que je peux trouver un peu de paix ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: La chaleur me dérange pas plus que ça. Mais je cherche un coin tranquille.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: Salut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: Mais je te jure, je vais leur faire vivre un enfer. Tu verras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: T''aurais pu m''égorger avant même que le soleil se lève.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: C''est mieux comme ça. Peut-être que toi aussi, t''en es un.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: On va les pulvériser. Y en aura pas un seul à moins d''un kilomètre, j''te le promets.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: Je savais que t''étais un dur à cuire. Toi, t''as du cran, ça se voit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: Je préfèrerais que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: Entre, si tu veux.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: Y a plus rien d''humain en eux. Sauf la peau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: J''ai pris mes jambes à mon coup. Ils m''ont tiré dessus. Ça devait être leur façon de s''amuser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: Ils ont attendu que je m''endorme dans ma tente et ils me l''ont prise pendant que je dormais. Pof, comme ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: Avant j''avais un fusil, mais j''ai failli me faire buter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: Je préfèrerais que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: Entre, si tu veux.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: Faut faire gaffe à eux, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: Si t''en laisses un s''échapper, le lendemain, il revient pour t''égorger. Tu piges ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: Me dis pas que tu t''contentes de les faire fuir ? T''as pas l''air idiot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: Toi non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: Où est ton arme, alors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: Tu veux chasser les Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: J''te le dis, ils manigancent quelque chose. Il faut les exterminer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: Depuis cette fichue histoire avec le soleil, ils sortent de plus en plus, ils se faufilent partout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: Où ça, en ville ? Moi, j''suis juste venu ici pour me reposer un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: Où est ton arme, alors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: Tu veux chasser les Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: Il faut les exterminer. Jusqu''au dernier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: Ils font semblant d''être comme nous… et après, ça tourne au cauchemar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: Maison après maison, des morts, des gens déchiquetés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: T''as vu ce qu''ils font les Visiteurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: Tu cherches quoi ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: Pourquoi tu te promènes ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: Mais maintenant, j''peux plus me promener comme avant. J''suis plus tout jeune.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: J''habite pas dans le coin. J''ai jamais été du genre à rester longtemps au même endroit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: Salut. Comment ça va par ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: Je suis désolé. Je crois que je vais partir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: Je… Je n''ai pas la force de continuer à lire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: « Nos jeunes ont crié comme Rouen sous les flammes. »'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: Merci, mais ça ne m''a pas du tout aidé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: Quel dommage…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: « Quelqu''un fredonne entre deux mondes. Feu, viens avec moi. »'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: Il est temps que je parte. Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: Je me souviens maintenant. Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: Ah. C''est donc ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: « Notre train n''a plus nulle part où aller. Pourtant dessous, la route continue de rugir. »'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: Page 10 ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: Au milieu de la page 200.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: Vers la fin.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: J''ai peur. Est-ce que vous pouvez m''aider ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: Vous vous souvenez de la fois où vous m''avez lu l''avenir dans le livre ? Vous voulez bien le refaire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: Est-ce que ça vous concerne ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: Et je me souviens du mot « Sauter ». Est-ce que ça vous parle ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: Mais avant, je comprenais. Je me rappelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: Quelle question bizarre… Je ne comprends plus rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: Page 10 ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: Au milieu de la page 200.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: Vers la fin.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: Ça pourrait peut-être m''aider.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: Voulez-vous bien me prédire l''avenir une nouvelle fois ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: Je sens que je suis perdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: Je ne sais pas si ce message est pour moi… ou s''il vous est destiné.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: Il n''y a qu''une seule phrase qui me revient, encore et encore : « Sauter ».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: Je… Je ne m''en souviens même plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: Est-ce que vous êtes en train de… mourir ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: De qui parlez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: Pourquoi avoir commencé tout ça, alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: Mais maintenant… Elle va tout reprendre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: Pendant tout ce temps, c''est Elle qui m''a aidé à tenir bon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: Est-ce que vous êtes en train de… mourir ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: De qui parlez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: Arrêtez de jouer avec moi. Laissez-moi tranquille.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: Je comprends maintenant… Il était temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: Les pensées… Elles sont devenues silencieuses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: C''est trop tard pour ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: Vous n'avez vraiment pas l'air en forme.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: Si vous pouviez éviter de mourir sur le pas de ma porte…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: Est-ce qu''elle m''a quitté ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: Ma vue se trouble. Je ne vois presque plus rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: J''ai oublié votre visage.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: J''ai besoin de rester seul face à mes pensées.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: Lorsque vous aurez trouvé ce qu''il y a là-dessous. Ne sautez pas. Ça ne vous aidera pas tout de suite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: Et vous…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: Il fallait le faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: Je… Je me rappelle… C''était la meilleure chose à faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: Je… Il faut que j''aille me reposer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: Quand vous l''aurez trouvé… ne sautez pas. Pas encore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: Pourtant… Je me suis souvenu d''autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: Je regrette… Je n''arrive pas à avoir les idées claires.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: Vous êtes sûr de vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: Mais pourquoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: Vous devez le trouver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: Vous devez creuser. Quelque chose y est enterré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: Je me suis souvenu de ce qui allait se passer ensuite. Le sous-sol…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: Mais maintenant… tout est flou. Je vous vois, perdu dans une forêt sombre. Entouré de bêtes sauvages.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: Mais j''étais sûr qu''il y avait une bonne raison. Je m''en souvenais très bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: Excusez-moi. Je sais que ça doit vous paraître bizarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: Vous êtes sûr de vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: Mais pourquoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: Je n''arrive pas à voir ce qu''il y a sous la terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: Essayez de creuser dans le sous-sol. Il y a quelque chose dans la terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: Le sous-sol. Il y en a un ici, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: Avant de venir vous voir, tout me semblait clair. Mais là… c''est comme si j''étais dans le brouillard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: Je comprends. Excusez-moi si je vous ai fait peur. Je pensais à voix haute, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: Je commence à regretter de vous avoir fait confiance.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: Je ne comprends rien à ce que vous dites.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: Mais à l''heure actuelle, quelque chose ne va pas. C''est peut-être à cause de cet homme aux champignons…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: Elle peut venir à notre aide si on le lui demande comme il se doit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: Mais n''ayez crainte. On ne la connaît tout simplement pas assez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: Vous devez comprendre qu''il existe une entité bien plus puissante que nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: Non. Non, certainement pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: Je commence à regretter de vous avoir fait confiance.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: Je ne comprends rien à ce que vous dites.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: De nouvelles pousses vont émerger des cendres et s''élever vers le ciel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: Cela s''est déjà produit une fois, tout au début. Mais tout ira bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: Ce n''est probablement pas vous. Ni elle…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: Je sens que je m''affaiblis. Je ne vois plus aussi loin qu''avant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: On m''aide déjà beaucoup. C''est juste que…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: Vous parlez tout seul ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: Bonsoir. Est-ce que vous avez besoin d'aide ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: Est-ce que c''est à cause de tout ce qui a été détruit ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: Je me sens de plus en plus mal. C''est très bizarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: Vous êtes bien là, n''est-ce pas ? À la porte ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: J''espère vous revoir d''ici quelques jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: Aujourd''hui, cette sensation s''est atténuée… Je suis convaincu que nous faisons les bons choix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: J''ai ressenti quelque chose d''étrange la première fois que je suis venu ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: Ces deux prochains jours, il serait grandement préférable que vous ne testiez personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: Puis-je me permettre de vous donner un conseil ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: Je ne peux pas vous en dire plus pour le moment. J''ai déjà beaucoup trop parlé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: J''espère que nous nous reverrons d''ici quelques jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: Peut-être que, de cette façon, vous pourrez trouver la paix… Ou tout au moins, vous pourrez aller de l''avant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: Et si vous me le promettez, je continuerai à vous guider.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: N''examinez personne. Absolument personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: Mais… Vous feriez mieux d''éviter de tester qui que ce soit pendant deux jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: Rien, rien… J''en ai déjà trop dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: Que va-t-il se passer ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: Et… Qu'est-ce que je suis censé faire avec cette information ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: 'Prophet: Je me demande s''ils vont en parler à la radio. Est-ce que vous allez écouter ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: Vous ne serez pas en mesure de l''arrêter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: Et pourtant, quelque chose de terrible approche, je le vois clairement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: C''est grâce à cette entité que je peux voir plus loin que quiconque. Mais même moi, je ne vois pas tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: Ça vous rapprochera d''une entité… très puissante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: Que va-t-il se passer ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: Et… Qu'est-ce que je suis censé faire avec cette information ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: 'Prophet: Je me demande s''ils vont en parler à la radio. Est-ce que vous allez écouter ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: Ce n''est pas votre faute… Mais vous n''en serez pas épargné pour autant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: Et je sais que quelque chose de terrible va arriver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: Oh, je ne sais pas tout… Mais en ce qui vous concerne… Je sais ce qui va se passer si vous continuez sur cette voie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: J''ai une vision plus profonde que le commun des mortels. C''est un don qu''on m''a donné.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: Pourquoi m'avez-vous dit de laisser entrer quelqu'un avec un chat ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: Comment étiez-vous au courant pour le chat ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: Quant à la personne qui l''a amené, son sort est entre vos mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: Parfait. Le chat est avec vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: Et on s''en va.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: Bon. On emmène DEUX PERSONNES TOUT DE SUITE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: Vous, restez ici. Vous pouvez crever la bouche ouverte pour ce que j''en ai à faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: Et on embarque tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: On enfonce la porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: C''est comme si je pissais dans un violoncelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: Très bien. Faites attention à vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: Pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: Je ne vous donnerai personne d'autre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: C'est parfait, j'ai aucune envie de vous revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: Nous nous occuperons de vous aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: Vous n''êtes pas le premier à résister. Nous avons déjà eu affaire à ce genre de situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: Soit nous enfonçons la porte et vidons votre baraque, soit vous nous remettez ces deux personnes sur-le-champ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: Je n''ai pas l''intention de négocier avec vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: Je ne sais pas quoi vous dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: Je ne vous donnerai personne d'autre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: C'est parfait, j'ai aucune envie de vous revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: Après… Soit on trouvera un moyen de combattre les Visiteurs, soit on ne se reverra plus jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: Juste deux. On ne veut pas emmener tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: Deux personnes de plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: Bon sang ! À quoi servez-vous si rien ne marche ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: Comment peut-on régler le problème ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: Si on ne trouve pas un moyen de survivre, quelqu''un décidera de notre sort à notre place.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: Les instructions qu''elles nous donnent sont impossibles à suivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: Les autorités sont prêtes à faire exploser toute la ville. Elles sont incapables de contenir la situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: C''est un véritable désastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: Bon sang ! À quoi servez-vous si rien ne marche ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: Comment peut-on régler le problème ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: Si vous continuez à prendre ça à la légère, on va arrêter tous les occupants de cette maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: LE MONDE EST AU BORD DU GOUFFRE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: ARRÊTEZ VOS CONNERIES.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: Quelle catastrophe ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: Où. Sont. Ceux. Que. Vous. Avez. Emmenés ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: C''est une question de vie ou de mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: Il nous faut plus de monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: Elles reviendront bientôt. Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: Donnez-nous simplement les personnes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: Nous nous soucions de cette ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: Si vous résistez, il y aura d''autres explosions.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: C''est ce qui arrive quand des têtes de mule écervelées se mettent en travers de notre chemin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: Vous aimez ce que vous voyez derrière moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: Très bien. D''accord.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: Bon sang…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: Et on s''occupera des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: On va en prendre deux pour l''instant, mais on les ramènera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: Merci de votre coopération.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: Oui, ça aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: Non, j'en ai ma claque.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: D'accord. Si ça peut vous aider.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: Les choses vont bientôt se calmer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: Peu importe qui. Donnez-nous simplement deux personnes. Tout de suite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: Mais, cette fois-ci, on en prendra deux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: Oui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: Non, j'en ai ma claque.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: D'accord. Si ça peut vous aider.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: Ça nous permettrait d''avancer plus vite. C''est pour le bien de tous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: Il nous faut deux agents supplémentaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: On manque d''effectif.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: Est-ce que je dois vous confier quelqu'un d'autre ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: Et maintenant ? Qu'est-ce qu'on fait ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: Nous maîtrisons la situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: Laissez-nous faire notre travail.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: Si tout était aussi simple, la FEMA n''aurait pas besoin d''intervenir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: Est-ce que je dois vous confier quelqu'un d'autre ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: Et maintenant ? Qu'est-ce qu'on fait ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: Coopérez davantage et peut-être que tout ça se terminera plus vite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: Difficile à dire. Il nous faudrait plus de monde pour garder la situation sous contrôle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: Nous sommes toujours en train d''étudier le problème. Ne vous en mêlez pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: Quand allez-vous vous débarrasser des Visiteurs une bonne fois pour toutes ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: Combien de temps cette situation va-t-elle encore durer ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: Et c''était là-bas… qu''était ma maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: Et regardez où ça nous mène. On a dû raser tout un site où les Visiteurs pullulaient.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: Les gens passent leur temps à nous mettre des bâtons dans les roues.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: Vous n''êtes pas en mesure d''exiger quoi que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: Quand allez-vous vous débarrasser des Visiteurs une bonne fois pour toutes ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: Combien de temps cette situation va-t-elle encore durer ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: Ce qui conduit, inexorablement, à une escalade de violence.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: Le fait de cacher les Visiteurs ne fait que contribuer à leur prolifération.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: Et si vous refusez, sachez qu''il y aura encore plus d''explosions.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: Simples répercussions.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: Commencez par ramener les gens que vous avez emmenés !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: Que se passe-t-il en ville ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: Le plus tôt sera le mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: Vous devez nous donner plus de monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: Bonjour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: Les choses vont se passer exactement comme prévu. Plus vite vous coopérerez, plus vite on en aura terminé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: Vous n''avez pas le choix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: Vous ne m''avez pas très bien compris, je crois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: Une fois les tests terminés, nous vous indiquerons la marche à suivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: Ne vous inquiétez pas. La procédure est rigoureuse, certes, mais on vous laissera le temps de vous reposer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: Je ne suis pas intéressé par vos tests.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: D'accord… S'il n'y a pas d'autre solution.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: Pour étudier plus en détail les effets du soleil, il va falloir que nous examinions un autre occupant de ce foyer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: Les résultats ne sont pas concluants.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: Je ne suis pas intéressé par vos tests.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: D'accord… S'il n'y a pas d'autre solution.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: Ensuite, il sera renvoyé chez lui depuis la zone de quarantaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: Si le dépistage est positif, alors la quarantaine est obligatoire. Le patient doit rester avec nous un certain temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: Ah, je vois… Notre équipe est déjà venue dans le coin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: Revenir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: Et la dernière inspection, alors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: Vous avez emmené quelqu'un que je connais… Quand cette personne va-t-elle revenir ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: Ne vous en faites pas, ça ne prendra pas beaucoup de temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: Je travaille pour la FEMA. Nous effectuons une inspection de routine dans votre quartier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: Bonsoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: Prends soin de toi, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: Et après… tout peut dégénérer très vite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: Si tu y penses trop, ça va te ronger de l''intérieur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: Ne te laisse pas envahir par le chagrin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: Qui sait ? Peut-être que grâce à ça… Peut-être que tu penseras à autre chose qu''à la mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: J''espère que tu sais encore ce que c''est que de ressentir un peu de joie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: Tu comprends ce que je veux dire ? La vie est tellement dure ces jours-ci. Vraiment trop dure.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: À l''époque où ils ne cherchaient pas juste à survivre… quand ils voulaient construire quelque chose… de bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: Mais parfois, si tu leur rappelles qu''ils ont été heureux avant…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: Pourquoi tu parles de mensonge ? Je vois bien que les gens sont submergés par leurs propres souffrances.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: On peut pas laisser les ténèbres nous engloutir. Aujourd''hui plus que jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: Essaie de te rappeler ce qui te faisait sourire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: Qu''est-ce qui te rendait heureux avant tout ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: C''est pas les raisons qui manquent. Mais c''est pas à moi de te dire ce qui devrait te rendre heureux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: T'es prêt à mentir aux gens ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: À quoi bon être heureux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: Ce désespoir… Il nous empêche de voir les petits bonheurs qui nous restent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: Les gens ont si peur qu''ils ont oublié ce que c''est que d''être heureux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: C''est vrai que ça fait un bail que j''ai pas vu quelqu''un sourire…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: Ah, tu parles de mon sourire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: Comment ça ? Y a un problème ? Nan, tout est normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: T'es prêt à mentir aux gens ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: À quoi bon être heureux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: Si on se répète que tout ira bien, peut-être que les choses deviendront un peu plus faciles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: La génération à venir. L''art. La vie, tout simplement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: Ouais, les temps sont durs… Mais il y a tellement de choses qui valent encore la peine qu''on se batte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: Y a déjà assez de colère comme ça en ce bas monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: Qu'est-ce qui t'arrive ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: T'as l'air d'être de très bonne humeur… Pourquoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: Est-ce qu''il serait possible que je reste dormir ici cette nuit ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: Déjà à la porte, hein ? Je me disais bien que j''avais entendu des bruits de pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: Je me serai pas sentie en sécurité de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: De toute façon, tu m''as tout l''air d''être un con.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: Très bien. Va te faire voir, si c''est comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: Mais bon… peu importe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: Oh, t''as même un tapis. Cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: Pas question ! Ouah…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: Tu vas vraiment laisser une môme dehors ? Avec ce soleil de plomb ? Avec les Visiteurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: Et alors ? Je suis là, non ? Et j''ai bien besoin de me trouver une piaule…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: Ma mère adore se dorer la pilule au soleil aussi. Donc, ouais… c''est une autre possibilité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: Ou peut-être qu''ils sont devenus des Visiteurs. Ça leur irait plutôt bien. Ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: J''en sais rien. À la maison, sans doute. Où pourraient-ils être sinon ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: Mais si t''es de cet acabit, sache que je me laisserai pas faire ! Si tu tentes quoi que ce soit, je te casse la gueule !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: Mais de temps en temps, je tombe sur de vrais connards.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: Mais je suis fauchée. Alors soit je m''arrange avec des gens, soit je me planque dans des caves.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: C''est la vie. Elle te pousse à agir. Disons que je voyage. Je découvre le monde. Peut-être pour trouver mon chez-moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: Où sont tes parents ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: Qu'est-ce que tu fais, cachée dans des caves ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: Je suis à bout de forces, mais j''ai pas réussi à trouver de cave ni d''autre endroit où me cacher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: C''est un peu gênant, mais… Est-ce que tu pourrais m''héberger, juste pour une nuit ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: Où sont tes parents ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: Qu'est-ce que tu fais, cachée dans des caves ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: J''en ai ras le bol de me cacher dans des caves. Si ça continue, je vais finir par oublier comment parler aux gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: Nan, j''ai juste besoin de me reposer un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: Oui, c'est chez moi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: Tu cherches quelqu'un ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: C''est chez toi, ici ? Je veux dire… C''est votre maison, monsieur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: Salut. Euh… Bonjour, je suppose, si ça te fait plaisir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: Allez, bouge-toi un peu les fesses. Moi aussi, j''en ai plein les pattes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: On va continuer à chercher. Pas vrai, bébé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582080
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582081
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776384
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776385
    m_Localized: (Prendre la commande)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: Pourquoi est-ce que tu restes plantée là ? Il nous a dit qu''on pouvait entrer, bouge-toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: Oh, merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: D''accord. Excusez-moi de vous avoir dérangé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: Quelle grande timide ! Ça va, ça va. Tu vas pouvoir te reposer bientôt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: Entrez, faites comme chez vous.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: Pardon, je ne devrais pas me mêler de ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: Merci pour ma fiancée. Sans elle, je n''aurais pas tenu le coup. Et vous, comment vous vous en sortez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: Tout s''est accumulé… Ça n''a pas été facile tous les jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: Vous me comprenez, pas vrai ? Les Visiteurs, la chaleur, le licenciement…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: Vous devriez partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: Entrez, faites comme chez vous.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: Oh, excuse-moi. Je devrais pas te secouer si fort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: Pas vrai, bébé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: Mais on pourra peut-être discuter un autre jour. Si on se revoit, bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: Elle est juste vraiment fatiguée. Je suis désolé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: Bien sûr que non ! Tu veux dire quelque chose, ma chérie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: Pourquoi cherchez-vous un endroit sûr, au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: Et votre fiancée ? Elle est muette ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: Si ça ne vous dérange pas, bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: Ma fiancée est à bout de forces. Elle a vraiment besoin de se reposer un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: Eh bien. J''imagine qu''il nous faudra chercher ailleurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: Pourquoi cherchez-vous un endroit sûr, au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: Et votre fiancée ? Elle est muette ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: C''est une grande maison, un peu à l''écart, sans voisins indiscrets… Il y a moins de risques qu''un fou débarque ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: Mais je ne saurais pas vous expliquer pourquoi, ha ha ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: Pour être honnête, votre maison semble plus sûre que toutes celles que nous avons vues jusque-là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: Et qui me dit que vous n'allez pas m'apporter des ennuis ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: Est-ce que ma maison ressemble à un endroit sûr ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: Est-ce que ça vous dérangerait de nous laisser rester ici un moment ? Si ce n''est pas trop vous demander, bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: Oh, bonjour ! Ma fiancée et moi cherchons un endroit sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: …Ah, voilà. C''est beaucoup mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: Un petit cadeau. De ma part.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: Tu trouveras le chat sous la maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: Allez, minou. Tu vas me tenir compagnie maintenant, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: Fais comme chez toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: Va au diable, bon sang.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: … Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: Réfléchis bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: Tu vois le chat ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: Et torture pas le chat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: Une demoiselle est sur le point de mourir de froid ici, jeune homme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: Va-t'en.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: Tu ouvres ou pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: J''ai réussi le test ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: Ça te suffit pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: J''ai deux bras, deux jambes, une tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: Va-t'en.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: Alors ? Décide-toi. Qu''est-ce qu''on fait ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: Je suis ballerine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: Je vais peut-être danser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: Tu veux me voir danser ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: Et alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: Prouve-moi que tu es une vraie personne.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: Je pense pas que tu sois humaine.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: Ça a l''air bizarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: Et maintenant ? Tu m''en dis un peu plus ? Ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: OK… bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: Prouve-moi que tu es une vraie personne.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: Je pense pas que tu sois humaine.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: Hé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: Je sais pas. Pourquoi ça t''intéresse ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: Tu me rappelles… quelqu'un.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: On t'a envoyée ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: Il ne fait pas chaud, là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: J''ai vu ta maison. Je suis venue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: Tu vois cette ville ? Là-bas, j''ai vécu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: Tu me rappelles… quelqu'un.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: On t'a envoyée ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: Je faisais du ballet avant. Ça se voit, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: Je danse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: Comment t'as trouvé ma maison ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: T'es qui, toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: On m''a dit de venir ici, alors je suis venue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: Tu vas ouvrir, oui ou non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: Une caisse de bière. Un tiroir. Un jambon. Je sais pas. Donne-moi un truc, n''importe quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: Comment t'as trouvé ma maison ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: T'es qui, toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: En quoi c''est utile ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: Tu poses trop de questions. Ouais, je le connais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: Qu'est-ce que tu veux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: Est-ce que tu connais… le type chauve ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: Tu ouvres, oui ou non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: Bonjour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: Si jamais vous croisez un enfant… Promettez-moi de prendre soin de lui. Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: Je ne vous en veux pas. Mais s''il vous plaît… promettez-moi quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: Je sais bien qu''on ne les ramènera pas à la vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: Merci… de m''avoir écoutée. Et de m''avoir laissé entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: Ne restez pas là… Partez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: Ne restez pas là… Entrez…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: Ils ont tout brûlé. Et m''ont forcée à regarder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: Qu''ont-ils donc fait pour mériter ça ? Les pauvres…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: Que sommes-nous devenus ? Une foule qui condamne des enfants sans défense ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: Ils ont découvert que je cachais des enfants qui portaient les marques des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: À cause de… à cause des gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: Ne restez pas là… Partez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: Ne restez pas là… Entrez…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: Je revois encore leurs petits yeux effrayés qui m''imploraient…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: Ils m''ont obligée à regarder… Ils ont verrouillé les portes, cloué les fenêtres… Et ils ont mis le feu au bâtiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: Ce sont des gens comme vous et moi qui ont fait ça. Ils avaient peur que ce soient des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: Ils sont tous morts… dans les flammes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: Ils…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: Comment l'incendie s'est-il déclaré ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: Qu'est-il arrivé aux enfants ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: Mais maintenant… Il n''y a plus d''enfant. Pas un seul n''a survécu à l''incendie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: D''autres avaient abandonné leurs propres enfants à la première apparition des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: Certains avaient été emmenés par la FEMA. D''autres avaient été tués. D''autres encore…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: Ils n''avaient plus de parents… pour toutes sortes de raisons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: Je… Quand le monde a commencé à s''effondrer, j''ai pris tous les orphelins sous mon aile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: J''étais professeure… à la maternelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: Comment une chose pareille a-t-elle pu se produire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: Qu'est-il arrivé aux enfants ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: Mais… Je n''ai pas réussi à les sauver. J''ai échoué.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: Ils avaient juste besoin qu''on s''occupe d''eux. Qu''on les aime. J''ai fait tout ce que j''ai pu…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: On vivait tous ensemble dans une ancienne école maternelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: J''ai recueilli tous ceux qu''ils considéraient comme corrompus… Tous ceux qu''ils soupçonnaient d''être des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: Je… Je voulais juste donner un peu d''espoir aux enfants abandonnés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: Qui êtes-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: Que s'est-il passé ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: Est-ce que je peux… vous parler ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: Excusez-moi de vous déranger… Mais je me sens affreusement mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: Prends soin de toi… et des tiens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: Pas de problème, man. Je comprends. Sans rancune.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: Maaaan…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: Faudrait qu''on fasse un film là-dessus un jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: C''est peut-être la meilleure chose qui me soit arrivée ces derniers temps, man…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: Yo, man… Merci beaucoup.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: Barre-toi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: C'est bon… Rentre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: Moi, j''ai toujours rêvé de jouer dans un film…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: C''est tellement plus marrant que les bouquins, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: Eux, ils sont pleins d''émotions. Des drames. Des trahisons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: Mais les films, man…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: Et les infos ? C''est déprimant à souhait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: Les gens racontent n''importe quoi les uns sur les autres… Tout est sombre et morose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: Nan, man… C''est le chaos dehors.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: Barre-toi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: C'est bon… Rentre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: Bon, j''insiste pas. Mais sois cool, man… Laisse-moi rentrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: Haha ! Ça serait dingue, man ! Mon pote a lu un livre où ça arrivait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: Imagine si on partait à la conquête de l''espace et qu''on commençait à envoyer des lettres aux extraterrestres…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: Ils annoncent des avancées technologiques et des événements avant même leur apparition.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: T''as jamais remarqué que les scénaristes de films de science-fiction prédisent toujours l''avenir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: Nan, man… J''te raconte pas de cracs… Je sais de quoi je parle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: Est-ce que t'as la moindre idée de ce qui se passe dehors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: Mais qu'est-ce que tu racontes ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: Et de la bouffe, man. Des tonnes de bouffe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: T''as un fusil ou un truc du genre ? On va avoir besoin de flingues.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: Ça peut complètement changer la donne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: C''est un virus ou c''est des morts-vivants ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: Dis-moi juste, c''est des zombies rapides ou lents ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: J''ai vu tellement de films là-dessus que je suis pratiquement un expert en survie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: Man… Tu peux compter sur moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: DES ZOMBIES ! HA ! JE LE SAVAIS !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: Est-ce que t'as la moindre idée de ce qui se passe dehors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: Mais qu'est-ce que tu racontes ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: Oh, oh ! Et mieux vaut que ce soit une équipe de quatre. C''est, genre, le nombre magique pour survivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: Et hop ! On lance la fusée et on va éteindre le soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: Alors, on va envoyer une équipe de super astronautes en mission sur le soleil, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: Man… Attends… Mais je l''ai déjà vu, ce film !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: Nan… Pas possible !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: D'étranges créatures ont commencé à sortir de terre… Elles ressemblent comme deux gouttes d'eau aux humains…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: Le soleil est de plus en plus ardent… Il y a des gens qui meurent brûlés en plein jour…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: Raconte-moi tout, man… J''ai raté quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: Putain, man… Qu''est-ce qui se passe en ce moment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: Yo, man ! Ça plane ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: Sinon, la CHOSE viendra te trouver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: Par pitié, t''approche pas des cadavres carbonisés la nuit. Sous aucun prétexte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: Je vais partir, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: Tant pis… C''est dur sans yeux, bon sang…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: Merci… Je vais enfin pouvoir me reposer un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: Je préfèrerais que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: Viens, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: Cette chose, elle n''aurait jamais dû exister…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: Plus gros. Plus fort. Ça… Ça n''a pas de nom. Ça suit l''odeur des brûlures et ça récolte ce qu''on a semé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: Oh non… Non, non, non. Y a bien pire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: Tu crois vraiment que je me suis arraché les yeux à cause d''un type au teint pâle ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: Je préfèrerais que tu partes.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: Viens, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: Bon sang… Je souhaiterais pas ça à mon pire ennemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: À ruminer lentement ces corps noircis, carbonisés… JUSTE DEVANT MES YEUX !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: ÇA… La CHOSE… Elle n''avait même pas remarqué que j''étais là au début. Trop occupé à dévorer les chairs…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: Je me suis juste retrouvé au mauvais endroit… au mauvais moment…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: Nos souffrances, c''est SON festin ! Un buffet de chagrin ! Elle se gave de peur, de douleur… de nos esprits !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: Mieux vaut que tu n''en saches rien…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: Est-ce que tu parles du type tout pâle ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: Mais qu'est-ce que t'as vu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: Je pensais qu''en les arrachant, je pourrais effacer cette vision monstrueuse. Tout ce que je vois, c''est le noir infini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: Pour pas devenir fou… J''ai préféré sacrifier mes yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: Je… C''est moi qui me suis fait ça. Tout seul…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: Est-ce que tu parles du type tout pâle ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: Mais qu'est-ce que t'as vu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: Tu peux me croire… Si tu avais vu la CHOSE, tu aurais fait pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: Il n''y a pas de mots pour décrire la terreur primitive qui a déchiré mon âme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: Cette image… Elle est toujours là, devant moi. Gravée dans les ténèbres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: J''ai vu un truc horrible. Je ne peux pas en parler. À quoi bon s''attarder sur les images qui hantent un esprit brisé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: Qui t'a fait ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: Qu'est-ce qui est arrivé à tes yeux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: Enfin… Quelque chose qui ressemble à un abri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: Où est-ce que je suis censé aller ? Je suis fichu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: Allez, mon ami… Tu vois bien que je ne me sens pas bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: Je te revaudrai ça, une fois que tout ce bordel sera terminé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: Tu vas le regretter, mon ami…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: Laisse-moi entrer maintenant, et promis, quand tout ça sera terminé… tu crouleras sous l''argent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: On ne refuse pas l''entrée à un homme d''influence. J''ai dirigé ce pays, moi ! J''ai été ministre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: J''ai mis une éternité à traîner ma carcasse jusqu''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: Allez, mon ami… Laisse-moi entrer, j''en peux plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: Je suis sérieux. Je me sens vraiment mal. J''ai besoin d''eau froide, tout de suite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: Tu devrais partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: Entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: Sinon, je vais tomber dans les pommes et je vais rôtir vivant dès le lever du soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: Écoute, ouvre la porte. J''ai besoin de cette baignoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: … Maintenant, je tuerai pour une glace. Bon sang.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: Parfait, si on peut dire… J''ai cru que j''allais fondre sur place, mon ami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: Pourquoi t'as besoin de ma salle de bain ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: Bien sûr que j'en ai une.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: J''ai juste besoin de me passer sous l''eau froide. Ça te dérange si j''utilise ta douche ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: Il fait plus chaud que dans tous les hôtels cinq étoiles où j''ai séjourné.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: J''ai l''impression que ma peau est en feu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: Nan, tout va pas bien, putain. Regarde-moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: Pourquoi t'as besoin de ma salle de bain ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: Bien sûr que j'en ai une.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: Je peux pas respirer. T''aurais, euh… une salle de bain ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: C''est vrai, il fait un peu plus frais… mais l''air est lourd comme pas permis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: Ça ne change rien. On se croirait toujours dans une fournaise.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: Tout va bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: On est au beau milieu de la nuit, pourtant.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: Hé… Bon sang… il fait une chaleur infernale ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: OK, OK… J''ai compris. Je vais pas t''embêter. Je me casse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: Bon sang, mon pote.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: Sinon, je me serais retrouvé tout seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: Va-t'en, t'as rien à faire ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: Bon, trêve de plaisanteries. Tu me laisses entrer, mon pote ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: Et sans un petit verre ? Regarder le monde avec les yeux écarquillés ? Non, merci. C''est trop dur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: Hé hé, relax, je te fais marcher, c''est tout. M''en veux pas. Ces jours-ci, vaut mieux rire que pleurer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: C''est bon, c''est sain, et si tu t''y tiens, c''est un vrai régime ! Regarde un peu ce corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: Ce matin, j''ai pris un petit-déjeuner royal. Je suis le même régime qu''un pote : bière au petit-déjeuner, vin au dîner.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: Va-t'en, t'as rien à faire ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: Alors… Tu veux bien me laisser entrer, mon pote ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: Faut pas m''en vouloir si mes blagues te font pas rire. J''essaie juste de pas craquer, tu comprends.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: Mais les blagues, ça te permet de pas devenir fou quand tout va mal. Sans ça, je serais mort depuis longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: Et pourquoi pas ? Partout où tu regardes, le monde s''écroule.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: T'as l'air un poil éméché, j'me trompe ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: T'es comédien ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: Laisse tomber.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: Je ferais jamais de mal à un type à cause de ses dents, de ses yeux ou de ce qu''il dit à la télé. Je pourrais pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: C''est pas parce que t''as tes petites bizarreries que t''es un Visiteur pour autant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: Mais, non ! J''te fais marcher. Détends-toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: Bon, j''ai déjà cogné plus d''un gars qu''avait de belles dents et de beaux yeux… Mais c''était par pure jalousie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: Écoute… Moi, j''ai le cœur sur la main.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: T'as l'air un poil éméché, j'me trompe ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: T'es comédien ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: Ce qui veut dire que je peux aller boire des verres comme ça me chante si jamais t''as envie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: J''ai pas de belle-mère. Je ne suis même pas marié.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: Mais non, j''te fais marcher, mon pote. Je t''ai bien eu, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: Ma belle-doche m''a foutu dehors parce que j''ai envoyé bouler un type de la FEMA. Elle a peur qu''ils reviennent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: Ah, c''est rien, t''inquiète.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: Comment je peux savoir que t'es vraiment un « brave type » ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: Qu'est-ce qui t'est arrivé ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: Hé ! Salut, mon pote ! Sois sympa, laisse entrer un brave type chez toi, tu veux bien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: Au revoir, alors.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: Ouais… Ouais, ils vont bien finir par revenir. Je crois. J''espère…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: Je vais rentrer chez moi. Au cas où ils reviendraient…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: Ouais. C''est sûrement plus prudent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: Mais… Je ferais peut-être mieux de rester avec toi pour le moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: Et s''ils reviennent alors que je suis pas là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: Je sais pas si c''est une bonne idée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: Tu devrais pas rester ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: Entre, mon grand.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: Mince, alors… Qu''est-ce que je vais faire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: C''est… C''est un vrai cauchemar…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: Oh sapristi… Et s''ils avaient pris feu… ? Et si le soleil les avait brûlés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: Tu devrais pas rester ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: Entre, mon grand.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: Mince alors… Je fais quoi maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: Je sais plus quoi penser. Peut-être que toi non plus, tu me fais pas confiance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: C''est pas cool… Pourquoi ils sont partis ? Pourquoi ils m''ont pas emmené avec eux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: Oh, sapristi !! Alors, p''t-être que c''est ces Visiteurs qui les ont zigouillés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: Le soleil est en train d'exploser. Il brûle les gens sur place.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: Il y a des Visiteurs qui sont sortis de terre. On peut faire confiance à personne.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: J''me disais qu''en allant voir quelqu''un, on me dirait peut-être ce qui s''est passé. Tu peux m''aider ? S''il te plaît ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: Un peu après, ils sont partis en vitesse… et ils sont pas revenus. Et je flippe encore plus d''allumer la télé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: J''ai pas voulu regarder, j''avais pas envie de stresser. Mais ils sont pas revenus et je sais pas ce qui se passe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: Un jour, ils ont dit qu''un truc horrible était arrivé à la télé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: Mais ma mère et mon père les regardaient à longueur de journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: Et aussi, j''ai lu quelque part que les gens qui regardent pas les infos vivent plus longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: Y a jamais de bonnes nouvelles aux infos, tu sais. Ça me déprime trop, alors j''ai arrêté de les regarder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: Le soleil est en train d'exploser. Il brûle les gens sur place.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: Il y a des Visiteurs qui sont sortis de terre. On peut faire confiance à personne.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: Je veux comprendre. Où sont-ils passés ? Faut me dire ce qui se passe…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: Mais là… ça fait plus d''une semaine. Ils sont toujours pas revenus. J''attends, mais ils sont juste… partis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: Un matin, je me suis réveillé et ils étaient complètement paniqués. Ils disaient qu''ils devaient partir en urgence.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: Non, pas vraiment. Les actualités, ça m''angoisse. J''évite de regarder. Mais mes parents…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: Tu regardes pas la télé ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: T'es sérieux, tu sais pas ce qui se passe ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: Y a des coups de feu, des bagarres… J''comprends pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: Il fait tellement chaud que j''ai du mal à respirer, et les gens sont… différents.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: Il faut m''expliquer ce qui se passe…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: Dors sur tes deux oreilles, si tu y arrives, connard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: Terrés dans vos trous, à enfermer tout le monde dehors.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: Évidemment. J''aurais dû m''en douter. T''es comme les autres. Des petits rats apeurés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: PUTAIN.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: Ça fait plaisir de voir que t''es pas comme tes voisins.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: Merci. Vraiment. J''te revaudrai ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: Je ne veux pas de toi ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: Entre vite.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: Maintenant, je suis un témoin… J''en sais trop. Ils vont me rechercher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: C''est pour ça que j''ai couru, même si j''avais pris une balle en escaladant cette putain de clôture.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: Quand j''ai vu ça, j''ai su que je devais me barrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: Ils font des choses aux gens. C''est pour ça que personne repart de ces endroits.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: J''ai entendu des cris étouffés… Après, ils ont traîné un sac noir. Le type est jamais revenu. Tu comprends maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: Je l''ai vu de mes propres yeux. Ils ont emmené un pauvre type dans une tente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: C''est pas une rumeur !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: T''as déjà entendu dire que la FEMA fait des tests pour trouver des Visiteurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: Oh, tu peux me croire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: Je ne veux pas de toi ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: Entre vite.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: Je suis tombé de la clôture et j''ai atterri dans une flaque d''eau. Après, j''ai pris mes jambes à mon cou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: Mais j''ai pas eu de chance. Un de ces salauds s''est retourné, m''a vu et il s''est mis à tirer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: Y a du mouvement là-dedans. On voit bien qu''ils sont en train de se préparer pour quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: J''ai même pas eu besoin d''un plan, j''ai juste attendu le bon moment et j''ai escaladé la clôture.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: Et leur sécurité, c''est de la rigolade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: C''est ça, une zone de quarantaine de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: Y a un énorme conteneur où ils entassent les gens tous les matins comme du bétail.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: Imagine un terrain vague, clôturé, avec des tentes ici et là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: Ça veut dire que la FEMA te cherche ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: Parle-moi de ces zones de quarantaine de la FEMA…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: Moi, je leur ai dit d''aller se faire foutre. Alors ils m''ont menotté comme un criminel. Mais j''ai réussi à m''enfuir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: Et en moins de deux, je les ai vus griffonner des trucs sur leurs tablettes et ils m''ont dit de les suivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: J''avais à peine ouvert la porte qu''ils me passaient déjà au peigne fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: Je me suis échappé d''une de leurs zones. Ils me sont tombés dessus pendant une descente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: Ça veut dire que la FEMA te cherche ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: Parle-moi de ces zones de quarantaine de la FEMA…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: "Fugitive: Au moins, mes tripes se font pas la malle… Y a pas grand-chose dedans de toute façon…\n  Argh… Ça fait un mal de chien."
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: "Fugitive: Elle est ressortie… Heureusement.\n  Mais bordel… Je pisse le sang… comme un cochon qu'on égorge."
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: Ces enfoirés savent pas viser… Mais j''ai quand même pris une balle… Ouais, une seule…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: Ces chiens de la FEMA… Ils m''ont eu… J''escaladais la clôture… J''ai jamais couru aussi vite…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: Comment est-ce que c'est arrivé ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: Qui a tiré, exactement ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: On m''a tiré dessus… J''en ai plus pour très longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: Argh… J''ai besoin qu''on m''aide…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: Et notre Seigneur ne l''oubliera pas. Il voit tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: Ma mort pèsera lourd sur votre conscience, je vous le garantis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: Vous refusez de tendre la main à une pauvre petite vieille.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: Alors c''est comme ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: Enfin ! Merci beaucoup.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: Vous devriez partir. Vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: Bon… Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: Oh, rassurez-vous… Je mettrai tout en œuvre pour chasser cette odieuse vulgarité de ces murs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: Je vous pose une simple question sur votre maison et vous me répondez par des injures ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: Ne craignez-vous donc pas Dieu ? Vous n''avez donc pas honte ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: Vous n''êtes qu''un grossier malotru, sans foi ni loi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: Vous devriez partir. Vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: Bon… Entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: Est-ce trop demander ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: Je cherche juste à savoir si votre maison est habitable. Je ne supporte pas la crasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: Oh, je vous remercie infiniment ! Sans vous, ça ne m''aurait jamais traversé l''esprit…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: Vous avez complètement pété un plomb, c'est ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: Vous avez dû faire erreur… Ce n'est pas un hôtel !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: Je ne peux pas vivre avec ces bestioles. Ça me donne des démangeaisons et des éruptions cutanées.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: Ensuite, est-ce qu''il y a des punaises de lit ? Des rats ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: Si vous avez des locataires de ce genre, je préfère que vous me le disiez tout de suite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: Avant toute chose, je ne supporte pas les alcooliques ni les toxicomanes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: Vous hébergez bien des gens, non ? J''ai juste besoin de vérifier plusieurs choses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: J''ai besoin d''une chambre chez vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: Vous avez complètement pété un plomb, c'est ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: Vous avez dû faire erreur… Ce n'est pas un hôtel !
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: Rassurez-moi… Vous avez des images religieuses sacrées ? Et aussi… J''exige un silence absolu. Pour prier et méditer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: D''ailleurs, puisqu''on en parle… J''aimerais vous poser une question.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: Pour y rester, mon enfant. Pour y rester.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: Ô, doux Seigneur, ayez pitié ! Je parle pourtant de façon intelligible, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: De quoi avez-vous besoin précisément ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: Vous convenir ? Pour quoi faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: Je crois qu''elle pourrait parfaitement me convenir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: Je vois que votre maisonnette est la plus éloignée du voisinage.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: Désolé de t'avoir fait perdre ton temps. J'espère juste… que j'apprendrai un jour à tuer. Pour pouvoir me défendre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: Pourtant, j'te jure que c'est pas le cas… Je suis juste un peu à cran ces derniers temps.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: Tu dois me prendre pour un dingue. Ou pire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: Donc… Tu veux pas me laisser entrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: Tu pourrais me montrer comment tu fais ? Pour tuer un Visiteur ? Je veux regarder la peur en face.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: Et… Si ça te dérange pas… Une fois que tu auras fini de m''examiner…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: Merci, l''ami !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: Pars, t'as rien à faire ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: Viens, gamin.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: Eh bien… Peut-être que tu pourrais m''apprendre… à tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: Mais aussi, peut-être… Enfin, si tu veux bien, hein…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: C''est pour ça que je voudrais trouver quelqu''un… quelqu''un qui puisse me protéger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: Mais moi ? Je suis juste un lâche. Je sais même pas me défendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: Aujourd''hui, il suffit d''un regard de travers pour se faire descendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: Je parle de protection contre les Visiteurs. Et contre ceux qui les chassent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: Non, non… Tu comprends pas. Je parlais pas de ce fou armé en particulier…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: Pars, t'as rien à faire ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: Viens, gamin.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: C''est pour ça que je veux parler à quelqu''un qui comprend comment le monde tourne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: Si j''apprends pas à me défendre, j''ai peur de ce qui risque de m''arriver'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: Avant, j''aurais jamais fait de mal à une mouche. Mais là… les gens trop gentils… Ils vivent pas longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: J''veux pas passer pour un taré. C''est juste que…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: Pardon ? Attends… tu trouves que c''est… bizarre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: Tu veux te défendre contre qui en fait ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: Pourquoi est-ce que tu penses tellement au fait de tuer ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: Et ce jour-là… J''arrêterai de vivre dans la peur. Ce sera leur tour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: Enfin, peu importe. Un jour, moi aussi, je saurai tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: Heureusement qu''il ne m''a pas vu. Il aurait pu me tordre le cou sur place.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: Mais l''autre jour, je suis tombé sur un taré armé. Il arrêtait pas de demander à un pauvre mec s''il était un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: Comprends-moi bien, je cherche pas à te monter contre qui que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: Génial ! Comme ça, tu peux te débarrasser de tous les Visiteurs s''ils se pointent ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: Tu veux te défendre contre qui en fait ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: Pourquoi est-ce que tu penses tellement au fait de tuer ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: J''suis sûr que t''as même pas besoin d''un flingue pour buter quelqu''un si les choses tournent mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: Mais t''as cette façon de parler… Je serais pas étonné que t''aies le caractère qui va avec.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: Juger ceux qui tuent pendant l''apocalypse… C''est un peu comme s''amuser à coller des prunes sur un circuit de formule 1…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: Tu sais, on traverse une période agitée… Vaut mieux être sûr de savoir se défendre. De pouvoir éliminer une menace.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: Ah… Excuse-moi. Je voulais pas être impoli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: Ouais, j'ai un flingue.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: Pourquoi est-ce que tu me poses la question ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: Dis-moi… Est-ce que t''aurais une arme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: Salut, l''ami !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: Tu sais quoi ? Va te faire foutre. Je vais aller parler à tes voisins. Adios, connard !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: C''est quoi ton problème, putain ? Je suis honnête avec toi, et toi, tu me traites comme de la merde ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: T''es sérieux ? Mon mari bosse à la FEMA !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: Tu crois que je suis un Visiteur ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: Attends… C''est quoi ce bordel ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: Une fois qu''on aura buté les Visiteurs, on pourra recommencer à vivre normalement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: Voilà qui est mieux !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: Tout ce blabla comme quoi « la FEMA n''est pas pour les femmes », c''est des conneries.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: J''ai travaillé à la douane, moi. J''ai le nez pour repérer les types louches.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: C''est pas juste, tu trouves pas ? Ou tu crois que je suis pas aussi compétente que mon mari ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: En quoi ça t''intéresse ? Il est à la FEMA maintenant. Et moi aussi, j''y travaillerais, s''ils prenaient les femmes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: Comme si j''allais te le dire. Pourquoi tu veux savoir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: Allez, entre.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: J''en ai attrapé plein, des crapules qui avaient toutes sortes de trucs louches sur eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: Je travaillais à la douane, tu sais ? C''est moi qui décidais qui pouvait passer la frontière.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: C''est vraiment dommage. Si je faisais équipe avec mon mari, je serais sacrément douée pour débusquer les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: J''aimerais bien. Mais non, ils acceptent pas les femmes… Comme c''est étonnant…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: Et ton mari, il faisait quoi avant ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: Toi aussi, tu bosses pour la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: Ce fichu chauffeur m''a complètement plumée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: Je voulais lui faire une surprise, alors j''ai pris un taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: Quand j''ai appris qu''ils l''avaient emmené à la FEMA, j''ai failli péter un câble !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: Oh, laisse-moi te le dire, haut et fort ! Il bosse pour la FEMA. Hé oui !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: Et ton mari, il faisait quoi avant ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: Toi aussi, tu bosses pour la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: Mon mari, il bosse à la FEMA, et si jamais il le croise il va lui casser toutes ses belles dents blanches. Héhé…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: D''ailleurs, j''ai halluciné ! Le chauffeur avait des dents plus blanches que de la porcelaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: Ça m''a coûté un bras. Les taxis, ça coûte les yeux de la tête ces jours-ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: Comment ? J''ai pris un taxi, pardi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: Il fait quoi dans la vie ton mari ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: Comment t'es arrivée ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: Mais il s''avère qu''il n''y a nulle part où me loger à son travail…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: Je voulais lui faire une surprise en lui rendant visite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: Si je suis là, c''est à cause de mon mari. Il a été muté dans ce trou pour le boulot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: Salut ! Est-ce que je pourrais squatter ici un petit moment à tout hasard ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: Adieu. Moi qui vous faisais confiance… vous avez détruit ma foi en l''humanité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: Les gens ont le droit de savoir la vérité !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: Vous êtes en train de faire une énorme erreur !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: Croyez-moi, je connais la vérité ! N''écoutez plus tous leurs mensonges !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: Je savais que je pouvais vous faire confiance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: Allez-y, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: J''ai donc quitté le labo la tête haute, avec toute une collection d''archives qui pourraient s''avérer précieuses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: Il suffit de bouchons d''oreille pour que les parasites n''entrent pas dans le corps. On aurait pu sauver tant de vies.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: Malheureusement, mes collègues ont refusé d''admettre la validité de mes découvertes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: J''ai dit que les Visiteurs n''étaient pas le vrai danger. Le danger, c''est les parasites qui nichent dans leur cerveau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: Avant, je travaillais dans un institut de recherche. Mais ils m''ont licencié. À cause de mes découvertes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: Mais il faut me jurer que ça restera entre nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: Eh bien, j''ai décidé de vous faire confiance. Donc je vais tout vous dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: Vous feriez mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: Allez-y, entrez.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: … La raison pour laquelle les chips sont à la fois une abomination scientifique et un désastre gustatif.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: Contrôle mental. Par le biais des fast-foods. Oui, c''est sérieux. Et ce n''est pas tout…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: Fraude électorale. La preuve que l''homme n''a jamais marché sur la Lune.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: Oh, mon ami. Préparez-vous. Je vais vous ouvrir les yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: Où avez-vous trouvé tout ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: Mais de quoi parlez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: Ce qui veut dire. . . que je peux partager des informations très importantes avec vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: Donc, si vous m''avez répondu que non, c''est que vous dites la vérité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: Vous savez, les agents de la FEMA sont tenus de révéler leur affiliation si on leur demande. C''est le protocole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: Ah… Parfait. Ça veut dire que je peux vous faire confiance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: Où avez-vous trouvé tout ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: Quel genre d'informations ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: Plusieurs gigaoctets de données… Des informations que je compte révéler au public.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: J''ai avec moi des documents extrêmement sensibles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: Je cherche un endroit sûr. Un endroit où je pourrai continuer mes recherches.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: Avec des informations importantes, bien sûr !'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: Non, je ne travaille pas pour la FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: Vous faire confiance à quel sujet, au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: Rassurez-moi… Vous ne travaillez pas pour la FEMA ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: Bonsoir. Dites-moi… Est-ce que je peux vous faire confiance ?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: De toute façon, je n''en ai pas besoin. Jetez-le. Ou servez-vous-en pour autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: Ils voulaient qu''on aille dans les zones de quarantaine de la FEMA. Mais pourquoi ? Tous ceux qui y vont meurent…'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: Avant qu''on parte éteindre l''incendie, ils nous ont donné un document au travail.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: Au moins, je crèverai pas dans la boue.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: Je crois que je vais pas vous embêter trop longtemps de toute façon… *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: Merci, mon vieux… *tousse*'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
