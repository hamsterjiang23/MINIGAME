  - m_Id: 224126554112
    m_Localized: Phòng Làm Việc
    m_Metadata:
      m_Items: []
  - m_Id: 270666551296
    m_Localized: Nhà Bếp
    m_Metadata:
      m_Items: []
  - m_Id: 299816964096
    m_Localized: Kho Chứa Đồ
    m_Metadata:
      m_Items: []
  - m_Id: 350756786176
    m_Localized: Cửa Sổ
    m_Metadata:
      m_Items: []
  - m_Id: 3656455089278980
    m_Localized: Mình còn sung lắm, chưa muốn ngủ đâu!
    m_Metadata:
      m_Items: []
  - m_Id: 3656498731012100
    m_Localized: Chưa ngủ được. Lỡ có người tới tìm chỗ trú ẩn thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 3656533392740350
    m_Localized: Chắc đêm nay không còn ai gõ cửa nữa đâu.
    m_Metadata:
      m_Items: []
  - m_Id: 3656689349545980
    m_Localized: Hình như có ai vừa chết đêm qua...
    m_Metadata:
      m_Items: []
  - m_Id: 3660792356130820
    m_Localized: Ngôn Ngữ
    m_Metadata:
      m_Items: []
  - m_Id: 3660864884035580
    m_Localized: Âm Lượng
    m_Metadata:
      m_Items: []
  - m_Id: 3660989769437180
    m_Localized: Thoát
    m_Metadata:
      m_Items: []
  - m_Id: 131613735687020544
    m_Localized: Lưu và thoát ra desktop
    m_Metadata:
      m_Items: []
  - m_Id: 3661098318024700
    m_Localized: Thoát ra menu mà không lưu
    m_Metadata:
      m_Items: []
  - m_Id: 3663275547676670
    m_Localized: Mở
    m_Metadata:
      m_Items: []
  - m_Id: 3663488060477440
    m_Localized: Thôi
    m_Metadata:
      m_Items: []
  - m_Id: 3667991568568320
    m_Localized: Bắt Đầu
    m_Metadata:
      m_Items: []
  - m_Id: 3668215154331650
    m_Localized: Hồn Ma, Da Người, Cốt {0}
    m_Metadata:
      m_Items: []
  - m_Id: 12124127443537900
    m_Localized: Uống bia xong thấy buồn ngủ quá. Đi ngủ thôi.
    m_Metadata:
      m_Items: []
  - m_Id: 12124292694921200
    m_Localized: Hắc Hải Ly
    m_Metadata:
      m_Items: []
  - m_Id: 13164343885287400
    m_Localized: Xã hội tàn rồi, nhưng làm lon bia lạnh vẫn cứ là phê.
    m_Metadata:
      m_Items: []
  - m_Id: 13170520799039500
    m_Localized: Hóa chất không chứ bổ béo gì. Nhưng uống vào được cái tỉnh táo.
    m_Metadata:
      m_Items: []
  - m_Id: 13176150536474600
    m_Localized: Cà Phê
    m_Metadata:
      m_Items: []
  - m_Id: 13176152247750700
    m_Localized: Dạo này mình chả uống cà phê nóng nữa. Mà chắc ai cũng vậy thôi.
    m_Metadata:
      m_Items: []
  - m_Id: 35317810561011700
    m_Localized: Tiếng Anh
    m_Metadata:
      m_Items: []
