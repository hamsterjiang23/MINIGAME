%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NotCharacterDialogs_uk
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: uk
  m_SharedData: {fileID: 11400000, guid: e5ff4525f54b4b14096a51f9eb9cf8ce, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21953783779328
    m_Localized: 'TV: Термінові новини!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556544
    m_Localized: 'TV: Сьогодні о 6:28 ранку на сонці стався потужний викид енергії.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556545
    m_Localized: 'TV: Цей спалах виявився більшим, ніж прогнозували вчені.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556546
    m_Localized: 'TV: Зовнішня температура досягла критичної позначки.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556547
    m_Localized: 'TV: Влада оголосила режим надзвичайного стану.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556548
    m_Localized: 'TV: Ми просимо всіх громадян уникати виходу надвір вдень.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556549
    m_Localized: 'TV: Тепер переходимо до…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556550
    m_Localized: 'TV: Хвилинку…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556551
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556552
    m_Localized: 'TV: До нашої студії щойно надійшло термінове повідомлення про контакти з Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556553
    m_Localized: 'TV: Очевидці описують їх як істот, що імітують зовнішній вигляд та поведінку людини.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556554
    m_Localized: 'TV: Просимо уникати контактів з Гостями. В одному випадку вдалося виявити ознаку цих істот…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556555
    m_Localized: 'TV: Це ідеальні білі зуби.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556556
    m_Localized: 'TV: Ця ознака підтверждується свідченням одного з очевидців.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556557
    m_Localized: 'TV: Він натрапив на бездомного з ідеальними білими зубами, який виявився Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556558
    m_Localized: 'TV: На цьому все. Зберігайте спокій і не виходьте з дому вдень.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556559
    m_Localized: 'TV: Далі ви побачите розважальну передачу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556560
    m_Localized: 'TV: Доброго дня, в ефірі прогноз погоди.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556561
    m_Localized: 'TV: У нашому регіоні настає спека, яка побила колишній рекорд середньодобової температури.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556562
    m_Localized: 'TV: Як повідомляють метеорологи, очікується подальше підвищення температури.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556563
    m_Localized: 'TV: Крім того, з підвищенням активності сонця вдень очікується посилення ультрафіолетового випромінювання.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556564
    m_Localized: 'TV: Задля вашої безпеки просимо утриматися від засмаги.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556565
    m_Localized: 'TV: Через високі температури ви можете отримати сонячний удар.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556566
    m_Localized: 'TV: Точно не відомо, як перебування під сонцем може позначитися на здоров''ї людини.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556567
    m_Localized: 'TV: Але щоб уникнути опіків третього ступеня, не виходьте на вулицю.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556568
    m_Localized: 'TV: Сонцезахисний крем тут, на жаль, не допоможе.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556569
    m_Localized: 'TV: На цьому все. Далі ви побачите балет.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556570
    m_Localized: 'TV: Ви бачите балерин, що граційно танцюють, перетинаючи сцену сильними, але витонченими стрибками.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556571
    m_Localized: 'TV: Танець по телевізору, хоч і вишуканий, навіює вам тривожні думки.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556572
    m_Localized: 'TV: Вам здається, ніби вас намагаються відволікти від останніх подій.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556573
    m_Localized: 'TV: Якби хоч хтось пояснив, що відбувається насправді…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556574
    m_Localized: 'TV: Доброго дня, в ефірі новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556575
    m_Localized: 'TV: Активність сонця не знижується, а рівень злочинності незначно зріс.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556576
    m_Localized: 'TV: За останніми даними, кількість вбивств за минулу ніч перевищила середньодобові показники.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556577
    m_Localized: 'TV: Експерти вважають, що це пов''язано з появою Гостей та зростанням тривоги у суспільстві.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556578
    m_Localized: 'TV: А тепер до нових відомостей — очевидці виявили нову ознаку Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556579
    m_Localized: 'TV: Бруд під нігтями.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556580
    m_Localized: 'TV: За даними фахівців, ця ознака допомагає виявити Гостей, які вилізли з-під землі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556581
    m_Localized: 'TV: На цьому все. Зберігайте спокій і не залишайте домівки вдень.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556582
    m_Localized: 'TV: Далі репортаж про блідого маніяка. Але спершу реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556583
    m_Localized: 'TV: Зараз ви ходите за продуктами так: топ-топ-топ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556584
    m_Localized: 'TV: А тепер зможете так: «Алло, хочу замовити їжу».'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556585
    m_Localized: 'TV: Доставка продуктів «Фор Рест». Телефонуйте за номером Х-ХХ-ХХХ, і їжа прийде до вас наступного вечора.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556586
    m_Localized: 'TV: ForRest: смачний відпочинок у вас удома.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556587
    m_Localized: 'TV: На вулицях міста з''явився блідий маніяк.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556588
    m_Localized: 'TV: Зі свідчень очевидців вдалося з''ясувати, що його жертв об''єднує одне — всі були самотніми людьми.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556589
    m_Localized: 'TV: При цьому маніяк спочатку спілкується з жертвою, після чого нападає і вбиває її.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556590
    m_Localized: 'TV: За описами очевидців вдалося скласти фоторобот підозрюваного.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556591
    m_Localized: 'TV: Це високий блідий чоловік середнього віку, худорлявої будови, з чорним волоссям. Одягнений лише в штани, іншого одягу немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556592
    m_Localized: 'TV: Деякі повідомляють, що на його тіло натягнута шкіра іншої людини.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556593
    m_Localized: 'TV: Підтвердження цієї інформації немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556594
    m_Localized: 'TV: Якщо побачите це обличчя, не відчиняйте двері і кажіть, що ви не самі вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556595
    m_Localized: 'TV: На цьому все.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556596
    m_Localized: 'TV: Доброго дня, в ефірі новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556597
    m_Localized: 'TV: Аномальна спека продовжує посилюватись. Навала Гостей також не припиняється.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750848
    m_Localized: 'TV: Для вирішення виниклої ситуації уряд організував спеціальну службу…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750849
    m_Localized: 'TV: Комітет з надзвичайних ситуацій, скорочено — КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750850
    m_Localized: 'TV: Її співробітників можна розпізнати за жовтими костюмами хімічного захисту та протигазами.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750851
    m_Localized: 'TV: Майже одразу після заснування Комітет вже відкрив нову ознаку Гостей…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750852
    m_Localized: 'TV: Почервонілі очі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750853
    m_Localized: 'TV: За нашими даними, КНС виявили цю ознаку після обстеження затриманих Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750854
    m_Localized: 'TV: Істоти мають підвищену чутливість до світла, через що їхні очі запалюються і червоніють.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750855
    m_Localized: 'TV: На цьому все. Зберігайте спокій і не виходьте на вулицю вдень.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750856
    m_Localized: 'TV: Далі репортаж про КНС. Але спершу невелика реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750857
    m_Localized: 'TV: Розгубленість, страх і горе. І всьому виною Гості…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750858
    m_Localized: 'TV: Але в годину потреби, коли пролиті річки сльоз…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750859
    m_Localized: 'TV: НА ДОПОМОГУ ПРИЙДУТЬ ВОНИ! СПІВРОБІТНИКИ КНС!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750860
    m_Localized: 'TV: Відважні герої Комітету з надзвичайних ситуацій захистять нас від навали Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750861
    m_Localized: 'TV: На сьогодні комітет вже виявив 27 тисяч небезпечних істот.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750862
    m_Localized: 'TV: Пам''ятайте, ви можете допомогти комітету, повідомивши про підозрілу поведінку людей навколо.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750863
    m_Localized: 'TV: Для цього вручіть їм запрошення на відвідування КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750864
    m_Localized: 'TV: І якщо у вас виникнуть сумніви, чи не Гість ви, телефонуйте на гарячу лінію: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750865
    m_Localized: 'TV: Допомагаючи КНС, ви допомагаєте у боротьбі з Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750866
    m_Localized: 'TV: КНС? Хто це? І навіщо їх сформували?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750867
    m_Localized: 'TV: Комітет з надзвичайних ситуацій — нова спеціальна служба, нещодавно створена для боротьби з кризою.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750868
    m_Localized: 'TV: Вони допоможуть вирішити проблему з нашестям Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750869
    m_Localized: 'TV: Точно невідомо, що саме зробить комітет…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750870
    m_Localized: 'TV: Але можна з упевненістю сказати, що наша доля у надійних руках…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750871
    m_Localized: 'TV: Оскільки комітет складається з експертів у різних галузях, в тому числі заслужених вчених.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750872
    m_Localized: 'TV: Якщо до вас на поріг прийде співробітник КНС, рекомендуємо сприяти йому та дотримуватися вказівок.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750873
    m_Localized: 'TV: Пам''ятайте, що допомагаючи КНС, ви допомагаєте у боротьбі з Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750874
    m_Localized: 'TV: Доброго дня, в ефірі новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750875
    m_Localized: 'TV: КНС вжив нових заходів для вирішення ситуації з Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750876
    m_Localized: 'TV: Організовано карантинні зони для осіб з потенційно небезпечним статусом.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750877
    m_Localized: 'TV: Також КНС виявив нову ознаку Гостя в результаті експериментів із затриманими…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750878
    m_Localized: 'TV: Пахви без волосся.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750879
    m_Localized: 'TV: Як повідомляє КНС, Гості не мають волосяного покриву в цьому місці, що може допомогти при розпізнанні.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750880
    m_Localized: 'TV: Комітет просить громадян поставитися з розумінням до перевірок та супроводів до карантинних зон.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750881
    m_Localized: 'TV: На цьому все. Зберігайте спокій і не залишайте домівки вдень.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750882
    m_Localized: 'TV: Далі репортаж про те, що робити, якщо ви виявили Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750883
    m_Localized: 'TV: КНС має припущення, що феномен Гостей має інфекційну природу або становить нову біологічну загрозу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750884
    m_Localized: 'TV: Тому необхідно повідомляти про підозрілих людей та ізолювати їх.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750885
    m_Localized: 'TV: Якщо у вас немає можливості одразу здати Гостя до карантинної зони, видайте йому сповіщення щодо явки до КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750886
    m_Localized: 'TV: При наступному обході співробітник забере людину з цим папером на обстеження.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750887
    m_Localized: 'TV: На цьому все. А тепер реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750888
    m_Localized: 'TV: Не зупинить тебе спека,'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750889
    m_Localized: 'TV: Якщо маєш «Енержеку»!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750890
    m_Localized: 'TV: Освіжуючий енергетик, що вгамує спрагу швидше та ефективніше за воду.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750891
    m_Localized: 'TV: Тепер і в асортименті доставки «Фор Рест». Замовляйте напій за номером Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750892
    m_Localized: 'Window: У чистому полі стоїть хата вашого сусіда.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750893
    m_Localized: 'Window: У вікнах темно. Схоже, його родина зараз спить.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750894
    m_Localized: 'Window: На стежці, що йде крізь поля, стоїть худа дворняга.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750895
    m_Localized: 'Window: Вона жалібно дивиться врізнобіч у спробі знайти якусь їжу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750896
    m_Localized: 'Window: На вулиці валяються кілька пияк, що вже нализались.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750897
    m_Localized: 'Window: Здається, вони міцно сплять, і їм добре навіть на холодній землі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750898
    m_Localized: 'Window: Вдалині стоїть хата сусіда, що зараз гостює у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750899
    m_Localized: 'Window: У вікнах горить світло, і здається, сім''я чекає, коли він піде від вас додому.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750900
    m_Localized: 'Window: Ви бачите, як за вікном біля поля влаштувались кілька підлітків.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750901
    m_Localized: 'Window: Вони безтурботно сидять і балакають, не звертаючи на вас уваги.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750902
    m_Localized: 'Window: На вулиці гробова тиша.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750903
    m_Localized: 'Window: Нікого немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750904
    m_Localized: 'Window: Навіть пияки вирішили сидіти вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750905
    m_Localized: 'Window: Вони когось бояться?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750906
    m_Localized: 'Window: За вікном стоїть сусід та його донька.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750907
    m_Localized: 'Window: Вони весело грають, намагаючись забути про нинішній жах…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750908
    m_Localized: 'Window: Хоча б на мить.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750909
    m_Localized: 'Window: На землі лежать тіла підлітків.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750910
    m_Localized: 'Window: Хтось їх убив.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750911
    m_Localized: 'Window: Здається, зовсім недавно, адже кров ще не встигла засохнути.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750912
    m_Localized: 'Window: На стежці стоїть блідий, як сама смерть, чоловік.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750913
    m_Localized: 'Window: На його шкірі дивні складки.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750914
    m_Localized: 'Window: Наче ця оболонка йому не за розміром.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750915
    m_Localized: 'Window: Його очей звідси не видно, але відчувається, як він свердлить вас поглядом.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750916
    m_Localized: 'Window: Вас раптом пронизує жах. Хоч би цей моторошний Гість обминув ваш дім стороною.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750917
    m_Localized: 'Window: Поряд із сусідською хатою стоїть невелика група КНС-ників.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750918
    m_Localized: 'Window: Цікаво, про що вони розмовляють?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750919
    m_Localized: 'Window: Може, вони беруть зразки ґрунту?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750920
    m_Localized: 'Window: Чи шукають місце для розгортання бази?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750921
    m_Localized: 'Window: На землі лежать згорілі вщент тіла підлітків.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750922
    m_Localized: 'Window: Здається, вони пролежали тут цілий день.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750923
    m_Localized: 'Window: Біля них стоять два КНС-ника та щось записують.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750924
    m_Localized: 'Window: Добре, що вони прийшли їх забрати.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750925
    m_Localized: 'Window: Страшно уявити, яка зараза може з''явитись, якщо гниючі тіла не будуть прибирати з вулиць.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750926
    m_Localized: 'Window: За вікном стоїть група озброєних солдатів.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750927
    m_Localized: 'Window: Мабуть, це невеликий загін, висланий сюди з міста для охорони КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750928
    m_Localized: 'Window: До вас долітають лише уривки фраз про блідого чоловіка з голим тулубом.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750929
    m_Localized: 'Window: Може, вони хочуть вистежити того страшного Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750930
    m_Localized: 'Window: Сусідська хата, нещодавно пофарбована в біле, згоріла дотла і тепер чорніша за чорне.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750931
    m_Localized: 'Window: Схоже, пожежа вщухла зовсім недавно.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750932
    m_Localized: 'Window: Невже хтось підпалив її навмисно?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750933
    m_Localized: 'Window: Що сталося із сусідською родиною?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750934
    m_Localized: 'Window: Чи хтось вижив?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750935
    m_Localized: 'Window: Вашу голову переповнили тривожні думки, і вас охопило почуття нерозуміння та безпорадності.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750936
    m_Localized: 'Window: Блідий моторошний чоловік стоїть на дорозі і посміхається.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750937
    m_Localized: 'Window: Він тримає чиюсь відірвану голову у касці.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750938
    m_Localized: 'Window: Це голова солдата з застиглою на обличчі гримасою жаху.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750939
    m_Localized: 'Window: Цікаво, чого він більше злякався: блідого Гостя чи неминучої смерті?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750940
    m_Localized: 'Window: Весь загін солдатів, який був тут учора, загинув.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750941
    m_Localized: 'Window: Тут була справжня бійня.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750942
    m_Localized: 'Window: Тіла розкидані по всій вулиці, і в одного немає голови.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750943
    m_Localized: 'Window: Невже їх усіх вбив той блідий моторошний незнайомець?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750944
    m_Localized: — Алло, це диспетчер служби порятунку. Чим вам допомогти? — Люди… вони горять.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750945
    m_Localized: — Опишіть, що ви бачите? Пожежу? — Ні, це сонце. Вони… вони згоряють на сонці.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750946
    m_Localized: — Не виходьте з дому, поки не стемніє. — Ні, вночі ходить він. Худий і блідий… це не людина.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750947
    m_Localized: А зараз в ефірі наша нова передача «Так, я людина».
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750948
    m_Localized: 'Все просто: ви надсилаєте ваші фотографії, а ми дивимося, хто ж ви насправді.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750949
    m_Localized: 'Надсилайте на нашу пошту: yesiam@humanverification.agency свої фото і дізнайтеся, хто ви.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750950
    m_Localized: Але, будь ласка, не шліть нічого, крім очей, зубів та нігтів. Нічого іншого ми не приймаємо.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750951
    m_Localized: У вас почервоніли очі? Побіліли зуби? Під нігтями з'явився бруд?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750952
    m_Localized: 'У вас вселився злий дух: Гостьовик!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750953
    m_Localized: 'Не дозвольте цій гнилі заволодіти вашим тілом! Негайно дзвоніть нашим експертам: 777-460.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750954
    m_Localized: Вони проженуть злого духа, очистять ваше тіло від згубної аури і встановлять вам сім ступенів захисту.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750955
    m_Localized: Доброго дня, дорогі слухачі. В ефірі передача «Я хочу вірити», де ми розкриваємо таємниці та змови властей.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750956
    m_Localized: Сьогодні ми розповімо всю правду про Гостей. А в гостях у нас шановний співробітник НДІ, доктор наук…
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750957
    m_Localized: Чекайте, що?! Він не прийде?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750958
    m_Localized: Як це в нього вкрали всі документи? Там були КІЛОТОНИ ІНФОРМАЦІЇ!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750959
    m_Localized: От халепа. Я знав, що нам не дозволять говорити правду. Щоб їх…
    m_Metadata:
      m_Items: []
  - m_Id: 17738415503822848
    m_Localized: 'TV: Давним-давно жили два брати недалеко від греблі.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182976
    m_Localized: 'TV: Піна від бризок води навіювала їм думки про холодні пінні напої…'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182977
    m_Localized: 'TV: І коли брати виросли, то разом заснували броварню «Бобер».'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182978
    m_Localized: 'TV: А пиво «Бобер черні» стало одним із найбажаніших алкогольних напоїв на полицях магазинів та в барах.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182979
    m_Localized: 'TV: Пиво «Бобер черні»: пийте багато, пийте смачно.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182980
    m_Localized: 'Window: Ви дивитеся на руїни сусідської хати.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182981
    m_Localized: 'Window: Від неї залишився лише примарний силует, хоча нещодавно тут жила цілком щаслива родина…'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182982
    m_Localized: 'Window: Вас охоплює дивне почуття, наче ви знали, що так станеться.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182983
    m_Localized: 'Window: Ніби… ви відчували, що смерть загляне до них дуже скоро.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182984
    m_Localized: 'Window: Ви бачите кіл, на який насаджений череп у касці.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182985
    m_Localized: 'Window: На черепі залишилося трохи чорної обгорілої шкіри, а зуби, схоже, хтось вирвав.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182986
    m_Localized: 'Window: Голова простояла тут цілий день.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182987
    m_Localized: 'Window: Вся ця похмура експозиція виглядає як загроза. Напевно, залишена тим страшним блідим Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182988
    m_Localized: 'Window: КНС-ники оглядають місце недавньої бійні.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182989
    m_Localized: 'Window: Вони забирають все спорядження та зброю у мертвих солдатів, щоб вона не дісталась мародерам.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182990
    m_Localized: 'Window: Напевно, не розраховували, що блідий Гість переживе сутичку з групою озброєних людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182991
    m_Localized: 'Window: Тепер мішків із трупами побільшало.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576140324864
    m_Localized: 'TV: Доброго дня, в ефірі прогноз погоди.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102080
    m_Localized: 'TV: У нашому регіоні настає спека, яка побила колишній рекорд середньодобової температури.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102081
    m_Localized: 'TV: Як повідомляють метеорологи, очікується подальше підвищення температури.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102082
    m_Localized: 'TV: Крім того, з підвищенням активності сонця вдень очікується посилення ультрафіолетового випромінювання.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102083
    m_Localized: 'TV: Задля вашої безпеки просимо утриматися від засмаги.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102084
    m_Localized: 'TV: Через високі температури ви можете отримати сонячний удар.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102085
    m_Localized: 'TV: Точно не відомо, як перебування під сонцем може позначитися на здоров''ї людини.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102086
    m_Localized: 'TV: Але щоб уникнути опіків третього ступеня, не виходьте на вулицю.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102087
    m_Localized: 'TV: Сонцезахисний крем тут, на жаль, не допоможе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102088
    m_Localized: 'TV: Далі прогноз погоди. Але спочатку реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102089
    m_Localized: 'TV: Ви бачите балерин, що граційно танцюють, перетинаючи сцену сильними, але витонченими стрибками.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102090
    m_Localized: 'TV: Красивий танець, хоч і вишуканий, навіює вам тривожні думки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102091
    m_Localized: 'TV: Вам здається, ніби вас намагаються відволікти від останніх подій.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102092
    m_Localized: 'TV: Якби хоч хтось пояснив, що відбувається насправді…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102093
    m_Localized: 'TV: Зараз ви ходите за продуктами так: топ-топ-топ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102094
    m_Localized: 'TV: А тепер зможете так: «Алло, хочу замовити їжу».'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102095
    m_Localized: 'TV: Доставка продуктів «For Rest». Телефонуйте за номером {0}, і їжа прийде до вас наступного вечора.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102096
    m_Localized: 'TV: «For Rest»: смачний відпочинок у вас удома.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102097
    m_Localized: 'TV: На вулицях міста з''явився блідий маніяк.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102098
    m_Localized: 'TV: Зі свідчень очевидців вдалося з''ясувати, що його жертв об''єднує одне — всі були самотніми людьми.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102099
    m_Localized: 'TV: При цьому маніяк спочатку спілкується з жертвою, після чого нападає і вбиває її.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102100
    m_Localized: 'TV: За описами очевидців вдалося скласти фоторобот підозрюваного.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102101
    m_Localized: 'TV: Це високий блідий чоловік середнього віку, худорлявої будови, з чорним волоссям. Одягнений лише в штани, іншого одягу немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102102
    m_Localized: 'TV: Деякі повідомляють, що на його тіло натягнута шкіра іншої людини.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102103
    m_Localized: 'TV: Підтвердження цієї інформації немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102104
    m_Localized: 'TV: Якщо побачите це обличчя, не відчиняйте двері і кажіть, що ви не самі вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102105
    m_Localized: 'TV: На цьому все.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102106
    m_Localized: 'TV: Розгубленість, страх і горе. І всьому виною Гості…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102107
    m_Localized: 'TV: Але в годину потреби, коли пролиті річки сльоз…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102108
    m_Localized: 'TV: НА ДОПОМОГУ ПРИЙДУТЬ ВОНИ! СПІВРОБІТНИКИ КНС!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102109
    m_Localized: 'TV: Відважні герої Комітету з надзвичайних ситуацій захистять нас від навали Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102110
    m_Localized: 'TV: На сьогодні комітет вже виявив 27 тисяч небезпечних істот.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102111
    m_Localized: 'TV: Пам''ятайте, ви можете допомогти комітету, повідомивши про підозрілу поведінку людей навколо.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102112
    m_Localized: 'TV: Для цього вручіть їм запрошення на відвідування КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102113
    m_Localized: 'TV: І якщо у вас виникнуть сумніви, чи не Гість ви, телефонуйте на гарячу лінію: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102114
    m_Localized: 'TV: Допомагаючи КНС, ви допомагаєте у боротьбі з Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102115
    m_Localized: 'TV: КНС? Хто це? І навіщо їх сформували?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102116
    m_Localized: 'TV: Комітет з надзвичайних ситуацій — нова спеціальна служба, нещодавно створена для боротьби з кризою.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102117
    m_Localized: 'TV: Вони допоможуть вирішити проблему з нашестям Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102118
    m_Localized: 'TV: Точно невідомо, що саме зробить комітет…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102119
    m_Localized: 'TV: Але можна з упевненістю сказати, що наша доля у надійних руках…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102120
    m_Localized: 'TV: Оскільки комітет складається з експертів у різних галузях, в тому числі заслужених вчених.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102121
    m_Localized: 'TV: Якщо до вас на поріг прийде співробітник КНС, рекомендуємо сприяти йому та дотримуватися вказівок.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102122
    m_Localized: 'TV: Пам''ятайте, що допомагаючи КНС, ви допомагаєте у боротьбі з Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102123
    m_Localized: 'TV: КНС має припущення, що феномен Гостей має інфекційну природу або становить нову біологічну загрозу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102124
    m_Localized: 'TV: Тому необхідно повідомляти про підозрілих людей та ізолювати їх.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102125
    m_Localized: 'TV: Якщо у вас немає можливості одразу здати Гостя до карантинної зони, видайте йому сповіщення щодо явки до КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102126
    m_Localized: 'TV: При наступному обході співробітник забере людину з цим папером на обстеження.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102127
    m_Localized: 'TV: На цьому все.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102128
    m_Localized: 'TV: Не зупинить тебе спека,'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102129
    m_Localized: 'TV: Якщо маєш «Енержеку»!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102130
    m_Localized: 'TV: Освіжуючий енергетик, що вгамує спрагу швидше та ефективніше за воду.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102131
    m_Localized: 'TV: Тепер і в асортименті доставки «For Rest». Замовляйте напій за номером {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102132
    m_Localized: 'TV: Доброго дня, в ефірі новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102133
    m_Localized: 'TV: У зв''язку зі зростанням кількості громадян з ознаками Гостей, КНС вжили нових заходів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102134
    m_Localized: 'TV: З цього дня у всіх великих містах запроваджується карантинний режим.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102135
    m_Localized: 'TV: Заборонено залишати міста та прилеглі поселення.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102136
    m_Localized: 'TV: Просимо вас утриматися від поїздок за межі вашого населеного пункту.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102137
    m_Localized: 'TV: Крім того, КНС озвучили новий спосіб розпізнати Гістя…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102138
    m_Localized: 'TV: Знімок аури на фотоплівку.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102139
    m_Localized: 'TV: Якщо ви знайдете дивні темні плями на знімку — це явна ознака того, що перед вами Гість.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102140
    m_Localized: 'TV: На цьому все. Зберігайте спокій і не виходьте на вулицю вдень.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102141
    m_Localized: 'TV: Далі реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102142
    m_Localized: 'TV: Хто ж такі Гості? Люди з того світу? Створіння з-під землі?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102143
    m_Localized: 'TV: Ні, це не фантастичний роман чи заголовок з жовтої преси…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102144
    m_Localized: 'TV: Це дійсність, з якою доводиться миритись.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102145
    m_Localized: 'TV: У народі ходять різні версії про справжню природу Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102146
    m_Localized: 'TV: Інопланетяни? Повсталі мерці? Істоти з лабораторії?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102147
    m_Localized: 'TV: Як повідомляє КНС, це лише чутки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102148
    m_Localized: 'TV: На думку комітету, Гість — це людина, яка увійшла до контакту з вірусом чи іншою біологічною загрозою.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102149
    m_Localized: 'TV: До кінця невідомо, як саме вона передається. Але КНС вимагає звертати увагу на симптоми Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102150
    m_Localized: 'TV: У випадку, якщо ви підозрюєте, що контактували з Гостем або самі можете ним виявитись, просимо зателефонувати на гарячу лінію КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102151
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102152
    m_Localized: 'TV: На цьому все. А далі реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102153
    m_Localized: 'TV: З кожним днем ​​все важче розпізнати Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102154
    m_Localized: 'TV: Ознаки — це добре, але як щодо безкомпромісно гарантованого способу?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102155
    m_Localized: 'TV: Феноменальна новинка — спеціальна фотоплівка!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102156
    m_Localized: 'TV: Завдяки їй ви зможете відрізнити людину від ворожого Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102157
    m_Localized: 'TV: Сфотографуйте когось на нашу плівку — і ви отримаєте зображення енергетики душі. Якщо вона має темні плями, це знак Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102158
    m_Localized: 'TV: Зателефонуйте сьогодні та отримайте набір плівки абсолютно безкоштовно: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102159
    m_Localized: 'TV: Увага, термінові новини!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102160
    m_Localized: 'TV: Сонце завдає удару у відповідь — у лісах вирують масові пожежі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102161
    m_Localized: 'TV: Експерти вважають, що причиною займання є аномальна сонячна активність.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102162
    m_Localized: 'TV: Поки що важко оцінити масштаб стихійного лиха, проте пожежні бригади прилеглих міст вже спрямовані до осередків займання.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296384
    m_Localized: 'TV: На цьому все. Зберігайте спокій і залишайтесь вдень вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296385
    m_Localized: 'TV: Зберігайте спокій і залишайтесь вдень вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296386
    m_Localized: 'TV: Далі реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296387
    m_Localized: 'TV: Давним-давно жили два брати недалеко від греблі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296388
    m_Localized: 'TV: Піна від бризок води навіювала їм думки про холодні пінні напої…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296389
    m_Localized: 'TV: І коли два брати виросли, то разом заснували броварню «Бобер».'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296390
    m_Localized: 'TV: А пиво «Бобер черні» стало одним із найбажаніших алкогольних напоїв на полицях магазинів та в барах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296391
    m_Localized: 'TV: Пиво «Бобер черні»: пийте багато, пийте смачно.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296392
    m_Localized: 'TV: Увага, термінові новини!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296393
    m_Localized: 'TV: Із сусіднього міста надходять повідомлення про заворушення на вулицях.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296394
    m_Localized: 'TV: Через нез''ясовані обставини місто перебуває в оточенні КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296395
    m_Localized: 'TV: Просимо вас залишатись у своїх будинках. Пізніше КНС виступлять із новими вказівками.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296396
    m_Localized: 'TV: Співпрацюючи з комітетом, ви допомагаєте у боротьбі з Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296397
    m_Localized: 'TV: На цьому все…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296398
    m_Localized: 'TV: Залишайтеся вдома і чекайте на подальші інструкції.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296399
    m_Localized: 'TV: Навіть трудягам іноді потрібен перепочинок.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296400
    m_Localized: 'TV: З сигаретами марки «Марґоро» ви зможете вдихнути на повні груди і розслабитися.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296401
    m_Localized: 'TV: «Марґоро». Сигарети для справжніх чоловіків.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296402
    m_Localized: 'TV: (Попередження: компанія не несе відповідальності за шкоду, заподіяну життю та здоров''ю споживача.)'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296403
    m_Localized: 'TV: Доброго дня, в ефірі новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296404
    m_Localized: 'TV: Важливе повідомлення.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296405
    m_Localized: 'TV: Стали відомі нові подробиці про події у місті.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296406
    m_Localized: 'TV: Одна з карантинних зон зазнала нападу невідомої озброєної людини…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296407
    m_Localized: 'TV: Зараз немає відомостей про причини диверсії, а також чи мав стрілець співучасників.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296408
    m_Localized: 'TV: Внаслідок пригоди на волю вирвалися особи з невідомим статусом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296409
    m_Localized: 'TV: Тиша — це передвісник смерті.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296410
    m_Localized: 'TV: Зловісне безгоміння, яке спустошує душу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296411
    m_Localized: 'TV: Але страшніше за порожнечу — дзвін.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296412
    m_Localized: 'TV: Дзвін похоронних дзвонів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296413
    m_Localized: 'TV: Вони дзвонять по нас всіх, заповнюючи гулом вуха.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296414
    m_Localized: 'TV: Павутина сірки ловить брудні думки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296415
    m_Localized: 'TV: Пекельне кубло, яке живить Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296416
    m_Localized: 'TV: Заховане у липкій павутині думок.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296417
    m_Localized: 'TV: Дзвони для них голосніші. Сірки — більше.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296418
    m_Localized: 'TV: Сьогоднішня подія викликала безліч теорій про те, що саме сталось. Показання очевидців різняться.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296419
    m_Localized: 'TV: Повідомляють як про одинокого стрілка, так і про цілу групу озброєних людей у ​​капюшонах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296420
    m_Localized: 'TV: Але найбільші труднощі ще чекають на нас попереду.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296421
    m_Localized: 'TV: Через те, що місто оточене, утилізацію тіл у прилеглих районах тимчасово призупинено.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296422
    m_Localized: 'TV: Втім, регулярний обхід будинків громадян продовжиться без змін.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296423
    m_Localized: 'TV: Якщо ви можете спалити чиїсь останки, негайно зробіть це.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296424
    m_Localized: 'TV: В іншому випадку дочекайтеся врегулювання ситуації та здайте тіла пізніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296425
    m_Localized: 'TV: На цьому все. Залишайтеся з нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296426
    m_Localized: 'TV: Доброго дня, в ефірі новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296427
    m_Localized: 'TV: КНС допомагає постраждалим від нападу на карантинну зону.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296428
    m_Localized: 'TV: Через заповненість інших карантинних зон комітет ухвалив наступне рішення…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296429
    m_Localized: 'TV: Помістити евакуйованих жителів у будівлі на околицях міста.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296430
    m_Localized: 'TV: На щастя, мешканці пішли назустріч КНС та вирішили допомогти, надавши свої будинки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296431
    m_Localized: 'TV: Проте знайдено лише частину втікачів із підозрілим статусом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296432
    m_Localized: 'TV: КНС дала нову ознаку, щоб їх можна було розшукати…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296433
    m_Localized: 'TV: Кров на яснах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296434
    m_Localized: 'TV: Якщо до вас прийде особа з цим симптомом, не вступайте з нею в контакт.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296435
    m_Localized: 'TV: У разі потреби дочекайтеся співробітника, зайнятого регулярним обходом, та здайте підозрюваного.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296436
    m_Localized: 'TV: На цьому все…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296437
    m_Localized: 'TV: Залишайтеся вдома і чекайте на подальші інструкції.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296438
    m_Localized: 'TV: Далі — репортаж про нову небезпечну секту.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296439
    m_Localized: 'TV: Гості не лише ховаються серед нас, а й впливають на розум людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296440
    m_Localized: 'TV: За нашою інформацією, у містах з''являються представники раніше невідомої секти.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296441
    m_Localized: 'TV: Вони звинувачуються у наступному…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296442
    m_Localized: 'TV: Жертвопринесення, поклоніння невідомому богу та можлива співпраця з Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296443
    m_Localized: 'TV: За останніми даними, вони виступають проти дій КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296444
    m_Localized: 'TV: Раніше все обмежувалось проповідями та закликами, але тепер вони перейшли до дій.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296445
    m_Localized: 'TV: Можливо, саме ця секта несе відповідальність за нещодавні жорстокі події у місті.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296446
    m_Localized: 'TV: Просимо вас остерігатися нововірів і не вступати з ними в контакт.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296447
    m_Localized: 'TV: За підозри у пособництві сектантам співробітники КНС можуть вас заарештувати.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296448
    m_Localized: 'TV: На цьому все. Залишайтеся з нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296449
    m_Localized: 'TV: Доброго дня, в ефірі новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296450
    m_Localized: 'TV: Ситуація у місті потроху стабілізується, але втікачі все ще на волі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296451
    m_Localized: 'TV: Тим часом утилізація тіл на вулицях міста відновлюється, проте з''явилися нові труднощі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296452
    m_Localized: 'TV: За останніми даними, вулицями блукають зграї бездомних собак.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296453
    m_Localized: 'TV: КНС повідомив, що вислав загін для вирішення цієї проблеми.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296454
    m_Localized: 'TV: Також комітет повідомив нові ознаки потенційно небезпечних громадян…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296455
    m_Localized: 'TV: Подразнення шкіри.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296456
    m_Localized: 'TV: Слідство щодо нападу у місті все ще триває.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296457
    m_Localized: 'TV: Досі неясно, чи були у нападника співучасники.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296458
    m_Localized: 'TV: Проте немає сумнівів, що КНС врегулює цю ситуацію, як і навалу Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296459
    m_Localized: 'TV: Якщо у вас виникли питання про ознаки Гостей, ви завжди можете зателефонувати на гарячу лінію…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296460
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296461
    m_Localized: 'TV: На цьому все…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296462
    m_Localized: 'TV: Залишайтеся вдома і чекайте на подальші інструкції.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296463
    m_Localized: 'TV: Далі — репортаж про ситуацію в країнах екваторіального поясу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296464
    m_Localized: 'TV: Неприємні новини надходять із жарких країн.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296465
    m_Localized: 'TV: Сильні пожежі, спопеляюче сонце та посуха лютують у країнах екваторіального поясу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296466
    m_Localized: 'TV: Судячи з останніх повідомлень, спека там настільки сильна, що, доторкнувшись до землі, можна отримати опік третього ступеня.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296467
    m_Localized: 'TV: Кількість жертв наразі невідома, а евакуація не є можливою.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296468
    m_Localized: 'TV: Уряд нашої країни не може зв''язатися з представниками постраждалих держав…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296469
    m_Localized: 'TV: Втім, як тільки ситуація врегулюється, туди буде направлено співробітників КНС для допомоги в усуненні наслідків.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296470
    m_Localized: 'TV: На цьому все. Залишайтеся з нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296471
    m_Localized: 'TV: Доброго дня, в ефірі новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296472
    m_Localized: 'TV: Ситуація у місті все ще стабілізується, і оточення міста продовжується. Проте…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296473
    m_Localized: 'TV: Виникла нова загроза — представники забороненої секти почали з''являтись на околицях міста.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296474
    m_Localized: 'TV: Судячи з останніх даних, вони збираються влаштувати ритуал із використанням відкритого вогню.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296475
    m_Localized: 'TV: КНС підозрює, що саме вони замішані у нападі на карантинні зони.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296476
    m_Localized: 'TV: Але, на жаль, ні Комітет, ні армія зараз не можуть виділити робочу групу через ситуацію у місті.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296477
    m_Localized: 'TV: Якщо до вас прийдуть сектанти, негайно зателефонуйте на гарячу лінію КНС: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296478
    m_Localized: 'TV: Крім того, комітет повідомив про нову ознаку…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296479
    m_Localized: 'TV: Грибок на пахвах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296480
    m_Localized: 'TV: На цьому все…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296481
    m_Localized: 'TV: Залишайтеся вдома і чекайте на подальші інструкції.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296482
    m_Localized: 'TV: Далі — репортаж про ситуацію на північному та південному полюсах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296483
    m_Localized: 'TV: Сонце завдає нового удару.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296484
    m_Localized: 'TV: Вчені зробили тривожні припущення.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296485
    m_Localized: 'TV: Якщо аномальна спека найближчим часом не спаде, льодовики можуть остаточно розтанути і викликати потоп.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296486
    m_Localized: 'TV: Вчені досі намагаються з''ясувати причини нинішнього катаклізму, але поки що їх зусилля безуспішні.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296487
    m_Localized: 'TV: На цьому все. Залишайтеся з нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296488
    m_Localized: 'TV: Термінові новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296489
    m_Localized: 'TV: Ситуація у місті не стабілізується, а катаклізм стає все сильнішим.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296490
    m_Localized: 'TV: Через танення льодовиків рівень води у світовому океані активно зростає.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296491
    m_Localized: 'TV: Це загрожує затопленням великих територій, у тому числі міст.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296492
    m_Localized: 'TV: Крім того, деякі забруднені водоймища, що заражені радіацією, почали випаруватись…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296493
    m_Localized: 'TV: Вчені стверджують, що наслідком цього можуть бути кислотні дощі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296494
    m_Localized: 'TV: Якщо ви почуєте гуркіт грому, негайно шукайте укриття, щоб сховатися від опадів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296495
    m_Localized: 'TV: Також, на жаль, місто продовжує перебувати в оточенні.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296496
    m_Localized: 'TV: КНС все ще не впіймав усіх, хто втік, тому видав нову ознаку…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296497
    m_Localized: 'TV: Швидкий рух зіниць.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296498
    m_Localized: 'TV: ЕКСТРЕНЕ ПОВІДОМЛЕННЯ'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296499
    m_Localized: 'TV: Ми змушені перервати репортаж через ризики нападу на нашу студію.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296500
    m_Localized: 'TV: Якщо у вас виникнуть питання, як виявити Гостей, дзвоніть на гарячу лінію: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296501
    m_Localized: 'TV: Кінець ефіру.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296502
    m_Localized: 'TV: Екстрене включення.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296503
    m_Localized: 'TV: КНС щойно заарештував більшість представників влади.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296504
    m_Localized: 'TV: Комітет заявив, що серед них виявили Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296505
    m_Localized: 'TV: У зв''язку із нездатністю парламенту до подальшої роботи КНС бере на себе роль тимчасового уряду.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296506
    m_Localized: 'TV: Окрім того…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296507
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296508
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296509
    m_Localized: 'TV: Хвилинку…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296510
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296511
    m_Localized: 'TV: Щойно надійшло повідомлення від КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296512
    m_Localized: 'TV: Нападники на карантинну зону у місті вирвалися з оточення.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296513
    m_Localized: 'TV: Повторюємо, нападники вирвалися з оточення. Вони на волі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296514
    m_Localized: 'TV: Забарикадуйте вікна і замкніть двері.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296515
    m_Localized: 'TV: Чекайте на подальші інструкції та не виходьте з дому.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296516
    m_Localized: 'TV: Кінець ефіру.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296517
    m_Localized: 'Window: У чистому полі стоїть хата вашого сусіда.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296518
    m_Localized: 'Window: У вікнах темно. Схоже, його родина зараз спить.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296519
    m_Localized: 'Window: На вулиці валяються кілька дуже п''яних людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296520
    m_Localized: 'Window: Здається, вони міцно сплять, і їм добре навіть на холодній землі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296521
    m_Localized: 'Window: Вдалині стоїть хата сусіда, що зараз гостює у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296522
    m_Localized: 'Window: У вікнах горить світло, і здається, сім''я чекає, коли він піде від вас додому.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296523
    m_Localized: 'Window: На вулиці гробова тиша.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296524
    m_Localized: 'Window: Нікого немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296525
    m_Localized: 'Window: Навіть пияки вирішили сидіти вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296526
    m_Localized: 'Window: Вони когось бояться?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296527
    m_Localized: 'Window: За вікном стоїть сусід та його донька.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296528
    m_Localized: 'Window: Вони весело грають, намагаючись забути про нинішній жах…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296529
    m_Localized: 'Window: Хоча б на мить.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296530
    m_Localized: 'Window: На стежці стоїть блідий, як сама смерть, чоловік.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296531
    m_Localized: 'Window: На його шкірі дивні складки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296532
    m_Localized: 'Window: Наче ця оболонка йому не за розміром.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296533
    m_Localized: 'Window: Його очей звідси не видно, але відчувається, як він свердлить вас поглядом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296534
    m_Localized: 'Window: Вас раптом пронизує жах. Хоч би цей моторошний Гість обминув ваш дім стороною.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296535
    m_Localized: 'Window: Поряд із сусідською хатою стоїть невелика група КНС-ників.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296536
    m_Localized: 'Window: Цікаво, про що вони розмовляють?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296537
    m_Localized: 'Window: Може, вони беруть зразки ґрунту?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296538
    m_Localized: 'Window: Чи шукають місце для розгортання бази?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296539
    m_Localized: 'Window: За вікном стоїть група озброєних солдатів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296540
    m_Localized: 'Window: Мабуть, це невеликий загін, висланий сюди з міста для охорони КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296541
    m_Localized: 'Window: До вас долітають лише уривки фраз про блідого чоловіка з голим тулубом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296542
    m_Localized: 'Window: Може, вони хочуть вистежити того страшного Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296543
    m_Localized: 'Window: Сусідська хата, нещодавно пофарбована в біле, згоріла дотла і тепер чорніша за чорне.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296544
    m_Localized: 'Window: Схоже, пожежа вщухла зовсім недавно.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296545
    m_Localized: 'Window: Невже хтось підпалив її навмисно?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296546
    m_Localized: 'Window: Що сталося із сусідською родиною?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296547
    m_Localized: 'Window: Чи хтось вижив?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296548
    m_Localized: 'Window: Вашу голову переповнили тривожні думки, і вас охопило почуття нерозуміння та безпорадності.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296549
    m_Localized: 'Window: Весь загін солдатів, який був тут учора, загинув.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296550
    m_Localized: 'Window: Тут була справжня бійня.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296551
    m_Localized: 'Window: Тіла розкидані по всій вулиці, і в одного немає голови.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296552
    m_Localized: 'Window: Невже їх усіх вбив той блідий моторошний незнайомець?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296553
    m_Localized: 'Window: Ви дивитеся на руїни сусідської хати.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296554
    m_Localized: 'Window: Від неї залишився лише примарний силует, хоча нещодавно тут жила цілком щаслива родина…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296555
    m_Localized: 'Window: Вас охоплює дивне почуття, наче ви знали, що так станеться.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296556
    m_Localized: 'Window: Ніби… ви відчували, що смерть загляне до них дуже скоро.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296557
    m_Localized: 'Window: Ви бачите кіл, на який насаджений череп у касці.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296558
    m_Localized: 'Window: На черепі залишилося трохи чорної обгорілої шкіри, а зуби, схоже, хтось вирвав.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296559
    m_Localized: 'Window: Голова простояла тут цілий день.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296560
    m_Localized: 'Window: Вся ця похмура експозиція виглядає як загроза. Напевно, залишена тим страшним блідим Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296561
    m_Localized: 'Window: КНС-ники оглядають місце недавньої бійні.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296562
    m_Localized: 'Window: Вони забирають все спорядження та зброю у мертвих солдатів, щоб вона не дісталась мародерам.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296563
    m_Localized: 'Window: Напевно, не розраховували, що блідий Гість переживе сутичку з групою озброєних людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296564
    m_Localized: 'Window: Тепер мішків із трупами побільшало.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296565
    m_Localized: 'Window: Ви бачите, як жінка плаче над пораненим чоловіком.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296566
    m_Localized: 'Window: Звідси не видно, живий він чи вже мертвий.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296567
    m_Localized: 'Window: Вся у сльозах, вона намагається тягнути його важке тіло подалі від пострілів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296568
    m_Localized: 'Window: У голові крутиться думка: а далі що буде?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296569
    m_Localized: 'Window: Стежка вздовж поля усіяна тілами людей, які намагалися втекти.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296570
    m_Localized: 'Window: Неподалік стоїть КНС-ник, який розпочав бійню.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296571
    m_Localized: 'Window: У руках він тримає автомат, з дула якого ще йде дим.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296572
    m_Localized: 'Window: Люди у паніці кидаються до будинків поблизу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296573
    m_Localized: 'Window: Вони б''ють по дверях, намагаючись викликати хазяїв.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296574
    m_Localized: 'Window: Але, здається, ніхто не збирається їх пускати, побоюючись проблем.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296575
    m_Localized: 'Window: Поруч зі звалищами сусідської хати стоїть група виселених людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296576
    m_Localized: 'Window: Вони шоковані та щось обговорюють.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296577
    m_Localized: 'Window: Швидше за все, вони хочуть сховатися у звалищах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296578
    m_Localized: 'Window: Але чи залишилося у світі хоч одне місце, де можна сховатись від усього?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296579
    m_Localized: 'Window: На стежці стоїть чоловік з автоматом. Вигляд у нього дикий.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296580
    m_Localized: 'Window: Його куртка вся обвішана вирваними зубами, очима і не тільки. Важко розглянути з вікна.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296581
    m_Localized: 'Window: А що як він вбиває не задля захисту, а заради втіхи та трофеїв?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296582
    m_Localized: 'Window: Як би там не було, ви сподіваєтесь, що не станете для нього ворогом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296583
    m_Localized: 'Window: На стовпі висить людина з табличкою «Ви забрали у мене все».'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296584
    m_Localized: 'Window: Може, його обікрали? Чи КНС забрали всіх його рідних?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296585
    m_Localized: 'Window: На жаль, можна лише гадати — серед купи думок не знайти відповіді.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296586
    m_Localized: 'Window: Група людей, виселених КНС, осіла у звалищах сусідської хати.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296587
    m_Localized: 'Window: Хоча від неї мало що залишилось, підвал, схоже, вцілів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296588
    m_Localized: 'Window: Все ж таки вони знайшли безпечний закуток.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296589
    m_Localized: 'Window: Але як довго можна ховатись?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296590
    m_Localized: 'Window: На вулиці бродить зграя диких собак.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296591
    m_Localized: 'Window: Їхні тіла покриті незначними опіками, і вони замучені голодом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296592
    m_Localized: 'Window: У своєму домі можна не боятися цих дворняг.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296593
    m_Localized: 'Window: Але тепер вас не залишає думка, що на вулицю краще не потикатись.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296594
    m_Localized: 'Window: Біля домівок зібралися невеликі групи людей з речами. Вони тихо перешіптуються, щоб КНС-ники не почули.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296595
    m_Localized: 'Window: Схоже, що це люди з карантинних зон, і їх заселяють на місце попередніх мешканців.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296596
    m_Localized: 'Window: Тепер шибеник виглядає як похмура вивіска «Ласкаво просимо».'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296597
    m_Localized: 'Window: Озброєний мисливець на Гостей тримає на прицілі групу тих, хто вижив.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296598
    m_Localized: 'Window: Мабуть, він натрапив на цих людей випадково.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296599
    m_Localized: 'Window: Чути лише уривки фраз, а божевільний стрілець щось кричить.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296600
    m_Localized: 'Window: Кому вдасться вижити у цьому новому світі? Схоже, не цим хлопцям і дівчатам.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296601
    m_Localized: 'Window: Озброєні КНС-ники стоять над тілами собак.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296602
    m_Localized: 'Window: Один з них щось записує у планшет.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296603
    m_Localized: 'Window: Але чи вистачить пари людей для відстрілу озвірілих від голоду тварин? Навряд чи.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296604
    m_Localized: 'Window: Двоє КНС-ників стоять поряд із ліхтарним стовпом і задумливо дивляться на шибеника.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296605
    m_Localized: 'Window: Схоже, у них нарешті дійшли руки до головної пам''ятки цієї околиці.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296606
    m_Localized: 'Window: Вони виглядають як два безглуздих детектива, що намагаються з''ясувати, як повішений заліз на стовп без сходів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296607
    m_Localized: 'Window: Уся група мертва, їхні рештки об''їдають голодні бродячі собаки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296608
    m_Localized: 'Window: Поруч із тілами розсипані гільзи. Схоже, той мисливець убив людей і, мабуть, забрав трофеї.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296609
    m_Localized: 'Window: Цей світ вже дійшов до ручки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296610
    m_Localized: 'Window: Сектанти складають дрова в одну велику купу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296611
    m_Localized: 'Window: Вони збираються когось спалювати?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296612
    m_Localized: 'Window: Схоже, невдовзі задум цих психів стане зрозумілим.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296613
    m_Localized: 'Window: Але скільки невинних людей постраждає заради цього?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296614
    m_Localized: 'Window: На дорозі стоїть божевільний стрілець.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296615
    m_Localized: 'Window: В руках у нього каністра бензину та коктейль Молотова.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296616
    m_Localized: 'Window: Він збирається спалити весь район з людьми?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296617
    m_Localized: 'Window: Хтось сказав маніяку, що вони з карантинних зон?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296618
    m_Localized: 'Window: Тіла тих, хто ховався у руїнах сусідської хати, згоріли від денного сонячного світла.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296619
    m_Localized: 'Window: Собаки, які поїдали останки, чомусь втекли. Наче когось бояться.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296620
    m_Localized: 'Window: А якщо вони злякалися не загону КНС, а чогось… гіршого?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296621
    m_Localized: 'Window: На підготовленому для багаття місці прив''язані сектанти.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296622
    m_Localized: 'Window: Вони вирішили принести себе в жертву?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296623
    m_Localized: 'Window: Ця думка не вкладається у вас у голові.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296624
    m_Localized: 'Window: Страх смерті настільки затьмарив розум людей, що вони готові на нелюдські вчинки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296625
    m_Localized: 'Window: І до цього безумства вони дійшли всього за пару тижнів. Що буде далі, страшно уявити.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296626
    m_Localized: 'Window: Будинки яскраво палахкотять. Навіть тут ви чуєте крики людей…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296627
    m_Localized: 'Window: Це все справа рук того безумця, що вирішив позбавитись тут Гостей, ви в цьому впевнені.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490688
    m_Localized: 'Window: Чи може ваш дім стати наступним? Завтра? Через тиждень?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490689
    m_Localized: 'Window: Напевно, рано чи пізно вам доведеться зустрітись з цим божевільним віч-на-віч.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490690
    m_Localized: 'Window: Від згорілих тіл нічого не залишилось.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490691
    m_Localized: 'Window: Лише дивна безформна маса, схожа на кисіль.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490692
    m_Localized: 'Window: У вас з''являється думка: може, щось розрідило тіла і кістки, перш ніж поглинути останки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490693
    m_Localized: 'Window: Ви молитеся, щоб ця істота так і залишилась у тіні. Є ризик, що ваш розум не переживе цього монстра.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490694
    m_Localized: 'Window: КНС-ники обступили згорілі тіла.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490695
    m_Localized: 'Window: Здається, вони документують смерть усіх сектантів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490696
    m_Localized: 'Window: На обличчях небіжчиків завмерли гримаси страху та агонії, ніби вони побачили перед смертю щось жахливе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490697
    m_Localized: 'Window: Усі будинки поблизу знищені.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490698
    m_Localized: 'Window: Тепер ваш дім — єдиний уцілілий у всій окрузі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490699
    m_Localized: 'Window: Більше нема кому прийняти удар безумців на себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490700
    m_Localized: 'Window: Що б не сталося, це, напевно, станеться тепер з вами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490701
    m_Localized: Говорить диспетчер. Перевірте, що сталося у карантинній зоні. Код 51. Доповідають про вибухи о 3 годині ночі.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490702
    m_Localized: 'Співробітник 32-8 повідомляє. Код 60: багато жертв серед цивільних, співробітники вбиті…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490703
    m_Localized: 'Доповідає співробітник 28-8. Код 451: потрібна бригада для спалення трупів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490704
    m_Localized: 'Прийнято. Впроваджуємо код 984: місто взято в оточення до з''ясування обставин. Чекайте на підкріплення.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490705
    m_Localized: Якщо ви мене чуєте, не наближуйтесь до околиць міста.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490706
    m_Localized: КНС-ники стріляють у всіх, хто намагається піти звідси.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490707
    m_Localized: Я НЕ ЗНАЮ, ЩО ВІДБУВАЄТЬСЯ. Я ПРОСТО ХОЧУ ВИБРАТИСЬ.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490708
    m_Localized: ХТО-НЕБУДЬ ДОПОМО……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490709
    m_Localized: Це не ті люди, які напали на карантинну зону.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490710
    m_Localized: Я бачив, що там було.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490711
    m_Localized: Це… це не людина…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490712
    m_Localized: Говорять виселені з дому.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490713
    m_Localized: Якщо КНС вас вигнали так само, як і нас, ми знаходимось в уцілілому підвалі спаленого будинку.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490714
    m_Localized: Це недалеко від хати відлюдника.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490715
    m_Localized: Їжі залишилось дуже мало. Скоро ми почнемо голодувати.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490716
    m_Localized: Якщо ви можете поділитись, це нам справді допоможе.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490717
    m_Localized: Всім, хто мене чує…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490718
    m_Localized: КНС намагається глушити зв'язок у місті, щоб уникнути розголосу.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490719
    m_Localized: Вони хочуть, щоб усі події у місті залишалися засекреченими.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490720
    m_Localized: Намагаються все звалити на того психа, який завалив усіх у карантинній зоні.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490721
    m_Localized: Якщо ви в місті, ви…райтеся звідси, тут н…езпечно.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490722
    m_Localized: Уни…йте патрулів КНС, вони …гаються вбити в…х.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490723
    m_Localized: БІЖ… ЗВ…СИ ЯКОМ… ШВИ…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490724
    m_Localized: Не тр… їм було спал… тіла. Це …манює ……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490725
    m_Localized: Якби ……… ті тіла, воно б не прийш…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490726
    m_Localized: Дисп…чер на зв'язку, вс…м співро…никам КНС…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490727
    m_Localized: 'Нові …зівки: код 451 замінюється н…им кодом 955.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490728
    m_Localized: Тіла не …алювати. Покр…и їх вапном.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490729
    m_Localized: Повт…ю, код 451 відм…ється. Спалення тіл непри…тиме для стрим…ня загрози від суб…та……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490730
    m_Localized: 'На зв''язку спів…тник 18-8: загр… не вдалося стр…ти.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490731
    m_Localized: Суб…кт залишив тери…рію міста. Тер…ово викликайте підкр…лення.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490732
    m_Localized: Пов…рюю, викликайте підкр…ння. Нам з ним не впор…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490733
    m_Localized: 'Phone: Привіт, сусіде. Радий, що ти подзвонив.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490734
    m_Localized: 'Phone: Ну, як там, пустив вже до себе когось?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490735
    m_Localized: 'Phone: Якщо ні, краще з цим не тягни.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490736
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490737
    m_Localized: 'Phone: Маєш питання?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490738
    m_Localized: Ти теж пускаєш до себе людей?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490739
    m_Localized: Скільки ознак треба, щоб розпізнати Гостя?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490740
    m_Localized: Як ти вирішив питання з їжею?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490741
    m_Localized: Бувай (покласти слухавку)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490742
    m_Localized: 'Phone: Так, доводиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490743
    m_Localized: 'Phone: Моїй доньці це дуже не подобається. Але що поробиш, інакше не можна.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490744
    m_Localized: 'Phone: Вона все проситься гуляти надвір, щоб відпочити від незнайомців.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490745
    m_Localized: 'Phone: Та хіба вдень вийдеш? От і доводиться гуляти вночі. Це небезпечно, але… Вона дуже просить…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490746
    m_Localized: 'Phone: Ох, якби я знав…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490747
    m_Localized: 'Phone: Ніхто не знає, скільки ознак треба, щоб бути впевненим.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490748
    m_Localized: 'Phone: Але, гадаю, якщо знайдеш лише щось одне, краще не поспішати з висновками.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490749
    m_Localized: 'Phone: Можливо, так співпало, що він ходив до стоматолога перед катаклізмом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490750
    m_Localized: 'Phone: Мені у цьому плані пощастило. Я нею запасся заздалегідь. Та й ти наче також.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490751
    m_Localized: 'Phone: Але якщо раптом захочеш собі щось особливе — є служба доставки «For Rest».'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490752
    m_Localized: 'Phone: Не пам''ятаю їхній номер. Його можна дізнатись з реклами по телеку чи радіо.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490753
    m_Localized: 'Phone: Бережи себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490754
    m_Localized: 'Phone: Привіт, сусіде.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490755
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490756
    m_Localized: 'Phone: Бачив, що біля тебе сталось? Підлітків убили…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490757
    m_Localized: 'Phone: Мені здавалося… на вулиці не настільки небезпечно. Здається, я помилявся.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490758
    m_Localized: 'Phone: Дочка вмовила мене вийти надвір пограти. І все було добре… доки я не помітив тіла…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490759
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490760
    m_Localized: 'Phone: Більше ні за що не буду так ризикувати її життям.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490761
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490762
    m_Localized: 'Phone: Боже, я собі не пробачу, якщо з нею щось трапиться. Вона для мене — весь світ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490763
    m_Localized: З дочкою все гаразд?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490764
    m_Localized: Хто їх убив?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490765
    m_Localized: Будь обережнішим (покласти слухавку)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490766
    m_Localized: 'Phone: Не знаю.…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490767
    m_Localized: 'Phone: Я думав, у цій пожухлій траві вона не помітить.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490768
    m_Localized: 'Phone: Але вдома вона сказала, що бачила там чиєсь обличчя…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490769
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490770
    m_Localized: 'Phone: Я намагаюся переконати її, що їй привиділось. Але… схоже, вона вважає інакше…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490771
    m_Localized: 'Phone: Це те бліде високе створіння. Я думав, воно вбиває тільки тих, хто сидить вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490772
    m_Localized: 'Phone: Я був упевнений, що зможу швидко зреагувати. Думав, якщо раптом побачу щось схоже на цей силует — одразу ж додому.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490773
    m_Localized: 'Phone: А от про те, що вона може побачити, не подумав…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490774
    m_Localized: 'Phone: Дякую. Ти теж бережи себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490775
    m_Localized: 'Phone: Привіт, сусіде. Дякую, що подзвонив.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490776
    m_Localized: 'Phone: Чесно кажучи, я вражений тим, що відбувається.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490777
    m_Localized: 'Phone: Вбивства, солдати, КНС…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490778
    m_Localized: 'Phone: Останні вчора ввечері нваіть до мене зайшли.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490779
    m_Localized: 'Phone: Вони питали про людей, яких я пустив. Потім записали собі щось у планшет і…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490780
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490781
    m_Localized: 'Phone: Один з них просто забрав людину з хати…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490782
    m_Localized: Куди вони забрали цю людину?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490783
    m_Localized: Добре, що вони не забрали твою дочку
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490784
    m_Localized: Хто такі КНС?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490785
    m_Localized: Бережи себе (покласти слухавку)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490786
    m_Localized: 'Phone: А я знаю? Кажуть, на перевірку.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490787
    m_Localized: 'Phone: Я думав, ці солдати і працівники робитимуть хочь щось корисне.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490788
    m_Localized: 'Phone: Схоже, дарма сподівався. Нічим вони нам не допоможуть, і порятунку від них ми не дочекаємось.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490789
    m_Localized: 'Phone: Дідька лисого я їм це дозволю.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490790
    m_Localized: 'Phone: Лише через мій труп!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490791
    m_Localized: 'Phone: Якщо ці сучі діти хоч торкнуться її, я їх розмажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490792
    m_Localized: 'Phone: Не знаю. Про них майже нічого не відомо.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490793
    m_Localized: 'Phone: Виникли з нізвідки і прикидаються, що все під контролем.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490794
    m_Localized: 'Phone: Як, наприклад, вони виявили ознаки? Чому всі ці ознаки — це звичайні людські риси?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490795
    m_Localized: 'Phone: Мені здається, вони щось нам недомовляють…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490796
    m_Localized: 'Phone: Дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490797
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490798
    m_Localized: 'Phone: Ніколи не думав, що нам на віку випаде побачити справжній хаос.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490799
    m_Localized: 'Phone: Сонце, Гості, тепер ще КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490800
    m_Localized: 'Phone: Стільки питань і жодної відповіді.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490801
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490802
    m_Localized: 'Phone: Сусіде, у мене до тебе одне прохання.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490803
    m_Localized: 'Phone: Прошу, якщо зі мною щось трапиться, пообіцяй, що подбаєш про мою доньку.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490804
    m_Localized: Обіцяю
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490805
    m_Localized: Я не можу нічого обіцяти
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490806
    m_Localized: 'Phone: Велике тобі спасибі, сусіде. Я знав, що можу на тебе покластися.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490807
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490808
    m_Localized: 'Phone: Гаразд, мені треба йти. Сил тобі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490809
    m_Localized: 'Phone: Я…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490810
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490811
    m_Localized: 'Phone: Невже ти їй не допоможеш? Адже вона ще дитина. Я не хочу, щоб вона залишилась зовсім одна.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490812
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490813
    m_Localized: 'Phone: Чорт, мені треба бігти.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490814
    m_Localized: 'Phone: Бувай, сусіде.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490815
    m_Localized: 'Phone: Доброго дня, це доставка їжі «For Rest».'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490816
    m_Localized: 'Phone: Що бажаєте замовити?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490817
    m_Localized: 2 банки «Енержеки», будь ласка
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490818
    m_Localized: 1 банку кави, будь ласка
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490819
    m_Localized: Нічого не треба, я передумав
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490820
    m_Localized: 'Phone: На жаль, ми не можемо прийняти ваше замовлення, тому що у вас вже є недощавня доставка.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490821
    m_Localized: 'Phone: Через перенавантаження ми змушені вводити обмеження на кількість замовлень.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490822
    m_Localized: 'Phone: Якщо ви бажаєте зробити замовлення, зателефонуйте пізніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490823
    m_Localized: 'Phone: На все добре, до побачення.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490824
    m_Localized: 'Phone: Добре, замовлення прийняте. Чекайте на кур''єра завтра вночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490825
    m_Localized: 'Phone: Добре, замовлення прийняте. Чекайте на кур''єра завтра вночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490826
    m_Localized: 'Phone: Доброго дня, це медичне відділення Комітету з надзвичайних ситуацій.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490827
    m_Localized: 'Phone: Ми готові проконсультувати вас щодо перевірок на Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490829
    m_Localized: 'Phone: Які у вас питання?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490830
    m_Localized: Поясніть докладніше про зуби
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490831
    m_Localized: Поясніть докладніше про нігті
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490832
    m_Localized: Поясніть докладніше про очі
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490833
    m_Localized: Дякую, це все
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490834
    m_Localized: 'Phone: Для достовірної перевірки ми рекомендуємо не вживати тютюнових виробів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490835
    m_Localized: 'Phone: Куріння може вплинути на стан зубів, що призведе до неточних результатів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490836
    m_Localized: 'Phone: Щоб ми могли достовірно дізнатися про ваш статус, просимо вас утриматися від миття рук до обстеження.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490837
    m_Localized: 'Phone: Вода може змити бруд, що призведе до помилок та недостовірних аналізів.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490838
    m_Localized: 'Phone: Для коректних результатів просимо вас утриматися від споживання кавових напоїв.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490839
    m_Localized: 'Phone: Вживання кофеїну може призвести не тільки до безсоння та нервозності, але й до почервоніння очей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490840
    m_Localized: 'Phone: Дякуємо за співпрацю з Комітетом з надзвичайних ситуацій.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490841
    m_Localized: 'Phone: Ви можете зробити важливий внесок у вирішення поточної ситуації.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490842
    m_Localized: 'Phone: Забезпечивши достовірність обстежень, ви допоможете не лише собі, а й усьому людству.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490843
    m_Localized: 'Phone: Доброго дня. Зачекайте, незабаром ми з''єднаємо вас з доступним експертом з очищення від Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490844
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490845
    m_Localized: 'Phone: Алло, хто ви?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490846
    m_Localized: В якому сенсі?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490847
    m_Localized: Навіщо вам знати, хто я?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490848
    m_Localized: 'Phone: Все ясно, ви не змогли відразу сказати, що ви людина… Гостьовик вже почав вселятися в вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490849
    m_Localized: 'Phone: Тепер слухайте мене уважно, у вас не так багато часу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490850
    m_Localized: 'Phone: Скажіть, чи кладете ви скибочку хліба на кухні?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490851
    m_Localized: Ні. А навіщо?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490852
    m_Localized: Яку ще скибочку?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490853
    m_Localized: 'Phone: Щоб я міг вигнати з вас Гостьовика.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490854
    m_Localized: 'Phone: Продовжимо. Слухайте мене уважно, у вас не так багато часу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490855
    m_Localized: 'Phone: Скажіть, чи кладете вси скибочку хліба на кухні?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490856
    m_Localized: Ні. А навіщо?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490857
    m_Localized: Яку ще скибочку?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490858
    m_Localized: 'Phone: Ооо… Все ясно. Ви не в злагоді з вашим домовиком.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490859
    m_Localized: 'Phone: Тому й прийшов Гостьовик. Гаразд, нічого страшного.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490860
    m_Localized: 'Phone: Скажіть, у вас вдома стоїть персональний комп''ютер?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490861
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490862
    m_Localized: Персональний що?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490863
    m_Localized: 'Phone: Ви що, не залишаєте їжу для домовика?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490864
    m_Localized: 'Phone: Тепер зрозуміло, чому Гостьовик примітив вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490865
    m_Localized: 'Phone: Скажіть, у вас вдома стоїть персональний комп''ютер?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490866
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490867
    m_Localized: Персональний що?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490868
    m_Localized: 'Phone: Зрозуміло, натиснути Alt-F4 не вийде…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490869
    m_Localized: 'Phone: Добре, тоді скажіть, чи споживаєте ви гриби?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490870
    m_Localized: Тільки чайний гриб, іноді
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490871
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490872
    m_Localized: 'Phone: Ви не знаєте, що таке комп''ютер?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490873
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490874
    m_Localized: 'Phone: Так, зрозуміло, проїхали.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490875
    m_Localized: Тільки чайний гриб, іноді
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490876
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490877
    m_Localized: 'Phone: О ні…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490878
    m_Localized: 'Phone: Припиніть негайно! Чайний гриб — це стародавнє зло.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490879
    m_Localized: 'Phone: Від нього в вас проростає міцелій. Він дозволяє духам вертіти вами, як маріонеткою.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490880
    m_Localized: 'Phone: Ви не уявляєте, що він зробить, якщо дійде до вашої пам''яті.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490881
    m_Localized: 'Phone: Він може як стерти її, так і перечитувати знову і знову, змінюючи ваші рішення.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490882
    m_Localized: 'Phone: І найстрашніше: ви навіть не знатимете, що вами хтось керує.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490883
    m_Localized: 'Phone: Що ж, гаразд, останнє запитання: скажіть, чи проливалась у вас вдома кров?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490884
    m_Localized: Так
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490885
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490886
    m_Localized: 'Phone: Добре. І не треба. Навіть чайного гриба не пийте. Інакше Гостьовику буде простіше заволодіти вашим тілом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490887
    m_Localized: 'Phone: Лише один ковток — і всередині може прорости міцелій, а ви станете його маріонеткою.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490888
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490889
    m_Localized: 'Phone: Ух, складно у вас все, складно…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490890
    m_Localized: Так
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490891
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490892
    m_Localized: 'Phone: А, ну тоді мені все ясно…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490893
    m_Localized: 'Phone: У вас не Гостьовик, а Духовик. Дух мертвої людини.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490894
    m_Localized: 'Phone: Ех, шкода — вигнання духів померлих не наша парафія.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490895
    m_Localized: 'Phone: Краще зверніться до екзорцистів, вони допоможуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490896
    m_Localized: 'Phone: А я тут, на жаль, нічого не зроблю. До побачення.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490897
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490898
    m_Localized: 'Phone: Сеанс із вигнання Гостьовика завершено. Дякуємо, що скористалися нашими послугами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490899
    m_Localized: 'Phone: Плата за консультацію спишеться найближчим часом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490900
    m_Localized: Плата?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490901
    m_Localized: Я думав, дзвінок безкоштовний
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490902
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490903
    m_Localized: 'Phone: Ех, шкода. Боюсь, я не зможу визначити тип цього духу. А без знання духу мені нема чим допомогти.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490904
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490905
    m_Localized: 'Phone: На жаль, на цьому я мушу закінчити наш сеанс.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490906
    m_Localized: 'Phone: Будьте сильні, і до побачення.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490907
    m_Localized: 'Phone: Сеанс із вигнання Гостьовика завершено. Дякуємо, що скористалися нашими послугами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: Плата за консультацію спишеться найближчим часом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: Плата?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: Я думав, дзвінок безкоштовний
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: Так, вірно. Наші експерти з вигнання Гостьовиків мають на щось жити.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: Як ви оціните проведений сеанс?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: Все чудово
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: Мені не допомогло
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: Ідіть у сраку, шахраї довбані
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: Якщо ви уважно дивилися рекламу, там маленьким шрифтом говорилося, що дзвінок платний.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: Як ви оціните проведений сеанс?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: Все чудово
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: Мені не допомогло
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: Ідіть у сраку, шахраї довбані
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: Дякуємо, ваш відгук дуже важливий для нас. На все добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: На цьому все.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: Відтепер і в асортименті доставки їжі «For Rest». Телефонуйте за номером: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: Доброго дня, в ефірі новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: 'TV: Незважаючи на пожежі, Гості продовжують тероризувати населення.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: КНС повідомили про нову ознаку Гостей…'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: Далі репортаж про те, хто такі Гості.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: А? Альо?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: Ваша дружина дала мені цей номер
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: Вашій дружині потрібна допомога
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: Угу, і що?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: Вона втратила всіх дітей
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: Діти у вас?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: Як завжди. Постійно тільки я маю все розгрібати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: А сама сидить і «ой, я втомилась».'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: Нічого нового.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: Вона втратила всіх дітей
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: Діти у вас?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: Йой. Знову їй насрати на своїх дітей.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: І кому розбиратись? Звісно, мені.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: У її матері шукали?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: Може, заберете її звідси?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: Ні. А вони не з нею?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: Не дивно.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: У матері дружини шукали?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: Може, заберете її звідси?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: Угу.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: Ну, може, вони там.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: Я ж до неї не піду.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: Нехай вона сходить. Спитайте її, що вона за мати?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: Розбирайтеся самі
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: Коротше, скажу, що ти живий і чекаєш
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: Та хай сама прийде. Все ж не принцеса.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: Ноги вона має? У чому проблема?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: Розбирайтеся самі
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: Коротше, скажу, що ти живий і чекаєш
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: А навіщо ти тоді дзвонив? Допомогти бідній жінці у біді?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: Робіть там вдвох що хочете, вона все одно байдужа тварюка.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: Від мене тільки відчепіться.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: 'Phone: Коротше, скажу, що ти живий і чекаєш'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: Та не варто нічого казати. Навіщо?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: Нам наплювати одному на одного.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: Навіщо ти в це втручаєшся, не розумію.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: Все… бувайте. Хай щастить.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: Скажіть, ви вірите у смерть?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: Мене попросив подзвонити ваш чоловік
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: Давайте без проповіді. У мене тут ваш чоловік
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: Що? Мій чоловік?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: Після всього, що він накоїв… Я не хочу чути про нього.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: Він хотів передати, що дуже шкодує
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: Він хотів сказати, щоб ви йшли до біса
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: Чоловік?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: Після всього, що він накоїв… Я не хочу чути про нього.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: Він хотів передати, що дуже шкодує
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: Він хотів сказати, щоб ви йшли до біса
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: Ха, шкодує!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: Що, знову?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: Ви, напевно, не в курсі, але він вже просив інших вибачатися за себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: Ось тільки сам він подзвонити не може. А знаєте, чому?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: Він не має сміливості визнати свої помилки. Змиритися з тим, що сталось.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: Він сподівається все виправити, зробити як раніше. Але так не буває — не можна повернути час назад.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: Втім, зараз мені набагато краще, разом із тими, хто мене розуміє.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: Вважаєте, жменька фанатиків розуміє вас?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: Навіщо ви взагалі вступили до секти?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: Як скажете
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: Можете називати їх як завгодно, але вони моя родина.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: Ми поділяємо погляд на те, що Смерть ось-ось прийде до нашого світу.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: І що вона принесе не страждання, а мир та спокій.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: На все добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: Тому що ми маємо спільні погляди на те, що станеться далі — прихід Смерті.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: Вам, напевно, дивно це чути, але прихід Смерті знаменує собою не журбу, але щастя.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: Щастя спокою та відсутності страждань. Мабуть, і ви несли на собі якийсь тягар.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: Можливо, одного разу ви самі все зрозумієте і подивитесь на речі так само, як ми.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: На все добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: Дякую за розуміння.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: На все добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: Алло, хто це?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: Доброго дня. Ваш брат дав мені номер
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: Можете допомогти своєму брату?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: Який брат? У мене немає…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: А, ви про сина мого батька?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: Але заждіть… Хто ви такий? І чому він у вас?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: Його батьки зникли
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: Він шукав притулку і прийшов до мене
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: Зникли? Як це сталося?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: Ви ж не хочете сказати, що…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: Чорт… Не може бути… Вони мертві?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: Я не знаю
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: Найімовірніше, так
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: Шукав притулку? Але ж він живе з батьками.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: Невже вони…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: Чорт… Не може бути… Вони мертві?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: Я не знаю
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: Найімовірніше, так
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: Боже… Як це сталося?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: Скажіть йому, що я його прихищу. Він знає мою адресу.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: І… Дякую вам, що допомогли йому.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: До побачення.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: Алло? Хто дзвонить?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: Ваша дружина з сестрою в мене вдома
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: Мені цей номер надала ваша дружина
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: Ви так кажете, начебто викуп за них хочете отримати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: Боюсь, у мене нічого не лишилося, щоб віддати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: Та й віддавати скоро не буде кому.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: Тобто? Що з вами?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: З вашою дружиною все добре
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: Скажіть, що з нею все гаразд, будь ласка.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: Вона у мене сильна, зможе пройти через що завгодно, та ще й допоможе всім у біді.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: Але боюсь, мені вже не допомогти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: Мене скоро не стане.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: Тобто? Що з вами?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: З вашою дружиною все добре
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: Я… я просто не можу все це витримати. Сонце, Гості, божевільні люди. Все це так жахливо. Мене прямо паралізує.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: Я просто… просто хочу, щоб це скінчилось. Мені залишився лише єдиний вихід… розумієте?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: Скажіть, будь ласка, що я її кохаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: Хоча… краще нічого не казати. Переконайтеся, що вона мене не шукатиме.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: Не хочу, щоб вона дізналась, що я не взяв її з собою…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: Дякую, що подзвонили. Та вислухали.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: Прощавайте…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: Вона, мабуть, тримається за свою сестру. Звісно, вона ніколи не вміла відпускати…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: Як їй не пощастило, що її оточують лише слабкі люди. Розумієте, я тому й вирішив від неї піти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: Приймальна комісія КНС, здрастуйте.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: У мене тут дружина КНС-ника
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: До вас тут один альтруїст хоче влаштуватись
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: Добре, а питання яке? Поки що не розумію, чим можу допомогти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: Якщо це не погроза.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: … Це погроза
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: Вона шукає роботу у вас. Була прикордонником
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: (Ви чуєте, як співрозмовник голосно видихає)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: Ви з активістів, так? Яких завжди ніщо не влаштовує.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: Не витрачайте час. Краще дайте додзвонитись тим, кому потрібна допомога.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: До когось ломляться Гості. Або щось гірше. Але через вас його вб''ють.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: До побачення.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: Хм. Вона має знати, що робота… непроста. Вона точно готова?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: Якщо так, нехай заповнить форму 31‑Г у трьох екземплярах.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: Після цього пройти медичну комісію. Потім заповнити…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: (Ви кидаєте слухавку. Навіщо ви взагалі дзвонили заради цієї жінки?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: А на яку позицію? Сподіваюся, не директором.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: Це вже буде третій на сьогодні.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: Директором
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: Шукачем. Або слідчим якимось
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: Як же затрахали ці жартуни.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: Поки ви займаєте лінію, хтось не може додзвонитися. Можливо, когось зараз вбивають Гості.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: Навчіться відповідати за тупі невчасні жарти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: (Кинули слухавку. Ти диви)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: Ми не маємо таких вакансій. Нам дуже не вистачає експертів з епідемій та кваліфікованих учених.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: Ваш знайомий, схоже, нам не підходить.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: Але знаєте що? Зараз дуже швидко все змінюється, передзвоніть за тиждень.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: Напевно, буде місце для… як ви сказали… альтруїста.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: Будова яблука: над''яблучник, край грибів та папір.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: Бійся ти… гр…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: Хоч і манять її зву…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: Зустрі… нічого…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: Окрім плачу та розлуки.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: Перевір її дихання.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: Чому не відповідаєш? Я бажаю померти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: (Відключились. Це було… не зовсім те, на що ви очікували)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: Звертаємо увагу, що зараз неможливо вирушити до нашої країни літаком чи потягом.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: Слухаю вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: Мені б відправити на батьківщину туриста
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: Чому потягом не можна?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: Краще дочекатися, доки не дозволять перельоти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: Наразі доступні пороми, але це небезпечно — занадто великий ризик нічних тайфунів.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: Плюс, вода відбиває сонце на кораблі, екіпаж не витримує тривалих рейсів.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: І як мені відправити бідолаху додому?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: Він у мене живе. Може, ви його до себе візьмете?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: Рейки від нагріву розширилися, їздити вдень небезпечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: Потяги ходять лише вночі, тому на далеку відстань не від''їхати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: Дуже багато пересадок. Краще дочекатися, коли дозволять авіатранспорт.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: І як мені відправити бідолаху додому?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: Він у мене живе. Може, ви його до себе візьмете?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: Просто зачекайте.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: Наразі більше нічого не зробити.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: Він навіть мови не знає
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: Нахрін ви потрібні, якщо нічого не можете?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: Ми не маємо готелів.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: Нічого не можемо зробити. Ми намагаємося вирішити проблему, він не один такий.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: Він навіть мови не знає
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: Нахрін ви потрібні, якщо нічого не можете?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: Всі наші співробітники зайняті. Ви, можливо, чули, що штати посольств сильно урізають.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: Все, що можемо, робимо.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: Які ж ви молодці
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: Авдеж, ледарюги
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: Не варто так казати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: Ми його на руках теж додому не відвеземо. Якщо так бажаєте допомогти, відвезіть ви.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: Бюджети урізали настільки, що ми майже на ентузіазмі працюємо.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: Які ж ви молодці
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: Авдеж, ледарюги
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: Наша робота не влаштовує — робіть все самі.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: Бажаємо успіху в переїзді до іншої країни з перевірками на Гостя та денною спекою.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: Гаразд, дякую
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: Іди у сраку
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: Тоді чому ви вдома, а не на роботі?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: Чи, може, прийдете та покажете нам, як треба?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: Нам дуже знадобиться допомога людей, які все знають краще нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: Гаразд, дякую
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: Іди у сраку
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: Вибачте за грубість.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: Ви просто не перший, хто дзвонить, будучи дуже… незадоволеним.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: Гарного дня.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: Щасливої дороги.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: Сподіваюся, вам теж захочеться кудись виїхати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: Обов''язково вам допоможу.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: Вікно до іншої кімнати. Раніше так економили електрику, щоб світло з іншої кімнати доходило сюди.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: Потім його заклали… але тільки з того боку.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: Ні, я туди не дивлюсь. Більше не дивлюсь.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: Не люблю спати біля тумбочки. Відразу спливають неприємні спогади…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: Не розумію, чому він не в кутку. Начебто так треба за правилами.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: Хоча… батькові було чхати на правила.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: Тотошка. Мало не єдина іграшка мого дитинства.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: Окрім, звичайно, палок, якими ми били траву.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: Хех, бабуся по всіх цих шафах розіпхала посуд.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: На свята діставали лише цей гарний сервіз. А тепер… нахрін він комусь потрібен.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: Відверто кажучи, мені більше подобається бути вдома самому.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: Так і з собою можна вголос поговорити.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: Один із тих журналів, де потрібно в натовпі знайти потрібну людинку…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: І якого біса когось шукати? Залишили б мене вже у спокої…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: 'Він тоді сказав: «Коли мене не стане — сам вирішиш, чи дивитись у цю коробку».'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: Вже п'ятнадцять років вирішую. Чогось досі не наважусь.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: Вас гнітить самотність?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: Нема з ким поговорити, відчуваєте тривогу?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: Тоді телефонна рулетка — те, що вам потрібно.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: Телефонуйте прямо зараз за номером 891-533, і ми підберемо для вас ідеального співрозмовника.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: З дочкою все гаразд?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: Хто їх убив?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: Будь обережнішим (покласти слухавку)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: З дочкою все гаразд?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: Хто їх убив?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: Будь обережнішим (покласти слухавку)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: Куди вони забрали цю людину?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: Добре, що вони не забрали твою дочку
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: Хто такі КНС?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: Бережи себе (покласти слухавку)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: Куди вони забрали цю людину?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: Добре, що вони не забрали твою дочку
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: Хто такі КНС?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: Бережи себе (покласти слухавку)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: Куди вони забрали цю людину?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: Добре, що вони не забрали твою дочку
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: Хто такі КНС?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: Бережи себе (покласти слухавку)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: Доброго дня, ви зателефонували на гарячу лінію КНС. Чим вам допомогти?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: Що? КНС? Це що таке?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: Про що ви?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: (Не встигла жінка відповісти, як пролунав гучний чоловічий крик)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: ТИ ЗОВСІМ ДУРНА?! КЛАДИ ТРУБКУ НЕГАЙНО!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: Поясніть докладніше про пахви
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: Поясніть докладніше про вуха
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: Щоб аналізи пахв були точними, вам необхідно уникати будь-яких контактів із водою.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: Утримайтеся від прийняття душу та миття рук.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: Вуха? Зачекайте…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: Ми проконсультуємося з начальством та повідомимо пізніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: Добре, тоді скажіть, чи споживаєте ви гриби?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: Що ж, гаразд, останнє запитання: скажіть, чи проливалась у вас вдома кров?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: Доброго дня, ви зателефонували до телефонної рулетки. Зараз ми підберемо вам ідеального співрозмовника. Очікуйте.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: Алло, доброго дня.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: Доброго дня
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: Алло?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: Доброго дня
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: Здається, нікого немає…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: Я… Мені треба комусь виговоритись. Стільки всього сталось останнім часом…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: Я намагалася зв''язатися зі своїми друзями та знайомими, але ніхто не відповідає…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: А потім я дізналась про телефонну рулетку.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: Можливо, не найкраще місце, щоб виливати душу, але краще, ніж нічого.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: Я розумію, що неправильно грузити невідому людину своїми проблемами, але…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: Ви не уявляєте, як допоможете мені простою розмовою. Так мені стане набагато спокійніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: Ви не проти мене послухати?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: Добре
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: Я не готовий до довгої розмови
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: Мм…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: Добре, вибачте, якщо вас потурбувала.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: До побачення.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: Дякую вам дуже. Дякую!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: Думаю, щоб нам було простіше, я можу щось розповісти про себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: Що б ви хотіли дізнатися?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: Де ви живете?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: Чому ви вирішили подзвонити сюди, а не своїм друзям?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: На жаль, я дуже далеко від дому.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: Я намагалась втекти від вогняної спеки та шукала місце, де буде найхолодніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: Тому я майже на краю світу. Тут холод проймає до кісток, а трава майже не росте.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: Відносно безпечний клаптик землі у біса на рогах.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: Але якщо навіть на дев''ятому колі пекла є холодне місце, значить… все не так вже й погано.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: Цікаво, раніше я терпіти не могла холод, а зараз… він — справжнісінька благодать для мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: Дуже хочеться вірити, що сонце перестане горіти так сильно, і все це скінчиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: Але я втрачаю віру у щасливий кінець. Що буде, коли сонце припинить нас палити?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: Гості можуть нікуди не зникнути. Замінять наших друзів та близьких, а ми навіть не дізнаємося про це…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: Чому ви вирушили одна?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: Ви сумуєте за рідним містом?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: Я б з радістю подзвонила їм, але… Я не знаю, як мені з ними зв''язатись…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: Справа в тому, що коли почався катаклізм, я вирішила залишити рідне місто. Податись якнайдалі від спеки.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: Я пообіцяла всім, що регулярно телефонуватиму, з кожним буду спілкуватися, запитувати, як справи…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: Але коли я прилетіла, то не змогла зв''язатись.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: Пізніше я дізналась, у чому причина — у них відрубили телефонні лінії.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: Все місто залишилося відрізаним від решти світу.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: Тепер я тут, у безпеці, але всі мої друзі…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: Мені страшно від думки, що, можливо, я більше ніколи не побачу дорогих мені людей…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: Сумую за спокійними часами, коли можна було просто жити і радіти новому дню.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: Чому ви вирушили одна?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: Ви сумуєте за рідним містом?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: Я не хотіла летіти одна. Але…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: Насправді мій найкращий друг хотів полетіти зі мною, але не зміг.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: Він не мав потрібних документів.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: А коли почався катаклізм, їх вже не можна було отримати.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: Він так журився про це… Шкодав, що не зробив їх раніше. Я хотіла допомогти йому, але не знала чим.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: Сумую. Але не стільки за рідним містом, а за тими, хто там залишився…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: І найбільше за моїм кращим другом…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: Він хотів поїхати зі мною, але не зміг. І я пообіцяла йому, що ми будемо тримати зв''язок, що подзвоню йому. Але…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: Думаю, він був у мене закоханий.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: Він так дбав про мене. Завжди підтримував, завжди готовий був вислухати.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: І потім зрозуміла, що ми подобаємось один одному.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: Я чекала, поки він перший зізнається у своїх почуттях. Але він все не міг наважитись, підібрати момент.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: А потім… Почався катаклізм, і на це вже не було часу.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: Шкода, що не зізналася першою…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: Що ж, тепер ви знаєте трохи про мене. Розкажіть про себе що-небудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: Я не звик говорити про себе…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: Навіть не знаю…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: Не соромтеся, я готова вас вислухати.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: Ну, у мене… немає близьких
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: Я… самотня людина
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: Не хвилюйтесь, немає нічого страшного в тому, щоб розповісти про себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: Ну, у мене… немає близьких
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: Я… самотня людина
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: У мене… були складні стосунки з батьком
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: Мій батько… Я його ненавидів
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: Тепер я більше не частина сім'ї
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: І одного дня я перестав бути для нього сином
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: І все, що я маю — це клятий дім
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: Тепер все, що залишилося від них — це дім
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: Я… дуже вам співчуваю… Схоже, ви не задоволені, що цей дім дістався вам.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: Це так
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: Краще б він згорів
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: Мені… важко уявити, через що ви пройшли…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: Не уявляю, наскільки ви ненавидите батька, якщо хочете, щоб ваш дім згорів.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: 'Phone: Ще раз дякую вам за цю розмову.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: 'Phone: До побачення. І сил вам.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: Алло?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: Доброго дня, можна поговорити з вашою дочкою?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: Доброго дня, чи не відпустите вашу дочку в гості, пограти з її подругою?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: Що? Навіщо вам треба з нею поговорити?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: Її подруга просить, чи може вона зайти до нас у гості
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: У мене тут дівчинка, у якої батько помер
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: Він… він теж був Гостем?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: Що значить «теж»?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: Ні, якісь мерзоти спалили його нізащо
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: Ніхто не палитиме людей просто так.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: Виходить, він був Гостем. Так само, як і наша донечка.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: Її теж спалили.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: Прямо в її дитячому садочку.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: Я спочатку ридала. Хотіла себе вбити. Не могла жити без неї.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: Але чоловік допоміг упоратися з цим.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: І ви теж впораєтеся. І ця дівчинка.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: Розумієте…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: Нічого не робиться просто так.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: Якщо її батька спалили, то так воно й має бути.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: І тим паче сльозами тут не допоможеш.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: Будь ласка, передайте ці слова дівчинці.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: І прощавайте.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: Наша донечка… вона…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: Вона померла…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: 'Phone: Нам довелося…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: Нам довелося її вбити.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: Що?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: (Покласти слухавку)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: 'Phone: Ми вбили її. Зрозумійте, так треба було.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: Усі ознаки збігалися, і чоловік наполяг.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: І ви вирішили вбити свою дитину?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: 'Phone: Не вам мене засуджувати!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: Вона точно була Гостем! Ознаки збігалися на всі сто відсотків!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: Пиздець…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: Розумію
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: Вона була Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: За всіма ознаками.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: Я її знала як облуплену.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: Тому я одразу помітила, як з''явилися ці ознаки.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: Все збігалось.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: Як тільки я сказала про це чоловікові, він…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: Він одразу розібрався із цим Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: Спочатку я хотіла його самого вбити.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: Але потім зрозуміла, що це ніколи не була наша дочка.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: Чоловік допоміг мені зрозуміти.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: Тепер мені тільки шкода, що ми не дізнались у цієї самозванки, що вона зробила з нашим малятком…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: Вибачте.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: Не дзвоніть сюди більше…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: Будь ласка…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: Ой, та навіщо я перед вами взагалі виправдовуюсь?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972625
    m_Localized: 'Phone: Ідіть ви кудись подалі!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972626
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972627
    m_Localized: 'Phone: Але я все ще сумую за нею…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972628
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096192
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096193
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096194
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096195
    m_Localized: 'TV: Далі — репортаж про тимчасове призупинення утилізації тіл.'
    m_Metadata:
      m_Items: []
  - m_Id: 58231803335401472
    m_Localized: 2 котячі консерви, будь ласка
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790080
    m_Localized: 1 пачку сигарет, будь ласка
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790081
    m_Localized: 1 чайний гриб, будь ласка
    m_Metadata:
      m_Items: []
  - m_Id: 58690054376120320
    m_Localized: 'TV: Відтепер і в асортименті доставки їжі «For Rest». Телефонуйте за номером: {0}.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
