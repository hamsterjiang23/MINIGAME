    m_Localized: 'Scammer: Shit, bro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: Is it really that fuckin'' hard to listen to me? Am I pissing you off or somethin''?'
