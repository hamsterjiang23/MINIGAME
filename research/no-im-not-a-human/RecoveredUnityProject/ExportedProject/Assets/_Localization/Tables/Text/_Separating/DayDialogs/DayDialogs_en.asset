%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_en
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 1bdb57fba89c5124a83ad717d0443512, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: It''s so goddamn hot...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: How are you feeling?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: I want to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: Seems like it''s even worse than I thought. *cough* Damn it.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: I don''t think I''ll hold out longer than a week.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: It did ease the pain a little when you let me in, though. Thank you.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: But... Now I''m just sitting here while the rest of the guys are out there dying.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: I could have stayed with them. It''s not like I''ve got anything to lose. I''m already on the way out, after all...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: It''s so goddamn hot...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: Why haven't you gone home?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: I want to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: I''ve got kids at home, y''know. And I... *cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: I don''t want them to be afraid of me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: I don''t *cough* want them to remember me like this.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Let them think I died out in the forest, while... *cough cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: While putting out fires.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: *cough* Let them remember me for my tar of collective patience and conscientious work.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: It''s so goddamn hot...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: Where's your uniform?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: I want to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: Bosses took it. *cough* There''s not enough gear to go around anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: A lot of people *cough* are dying on the job.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: We don''t even have time to pull the dead out of the blaze. The fire *cough* takes everything in the end.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: But the bosses... They''re more concerned about *cough* a fucking uniform...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: They forge decrees in a line like horseshoes. Not a single one made for the people.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: It''s so goddamn hot...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: Where did the forest fires come from?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: I want to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: The forest has been especially dry recently. So it *cough* catches easily.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: The fires are just *cough* one of the misfortunes that''ve befallen us, like those Visitors from underground.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: But fate still has more in store for us...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: Maybe we''re so far gone, the best we can hope for is peaceful death.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: You know... *cough* I considered taking this home as a gift. But I''ll give it to you instead.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: It''s a necklace. Not much to look at, I know, but...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: It''s made of the dead bees that once turned honey into sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: It''s so goddamn hot...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: You look awful
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: I want to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: I think... I think my time has come... *cough cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: Why didn''t I stay? I could have saved a couple guys.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: I could have held on...and worked until I dropped. Then they wouldn''t have had to send those lambs to the slaughter.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: FUCKING *COUGH* BOSSES! *COUGH COUGH*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: It''s all so...sad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: Mind giving me one last smoke?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: 'Hold out a cigarette (give him a cigarette) '
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: You wouldn''t happen to have a smoke, would you?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: Nope, sorry (don't give him a cigarette)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: The final nail in the coffin, as they say. *cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (The man takes a lighter out of his pocket, lights the cigarette, and starts to smoke.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (He takes a long drag and leans back against the wall. After a short pause, he continues.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: If only I could be back with the guys again. Smoking, talking about—'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *COUGH COUGH* *COUGH COUGH*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: You don''t smoke?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: I know, I know. "A firefighter? Smoking?" *cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: Doesn''t make a difference now, anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: I just wanted to *cough* relax a little before I die.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (The man leans back against the wall, staring up at the ceiling as he talks.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: How is it I got stuck being a firefighter? My old ma wanted me to work in a factory.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: It isn''t right for a firefighter to go up in smo—'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *COUGH COUGH*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: Wanderin'' free, wish I could be...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: Who are you looking for?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: I have this friend, y''see. Known each other since we were kids.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: He had an accident.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: He was hired to mine something up in the mountains.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: I don''t know what he was up to. And frankly, I don''t give a shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: But then he threw his back out! Couldn''t move for days!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: He worked so hard up in those mountains...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: That the seagulls mistook his...his back... Uh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: Fine, it was his ass. THEY MISTOOK HIS ASS FOR A NEST!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: Sorry about that, it''s just the voices in my head.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: They told me a really funny joke.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: Wanderin'' free, wish I could be...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Uh... everything okay?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: Yeah. I''m just waiting for my legs to grow back.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: Look, the right one''s already started.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: So I''ll just stay here a little while longer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: I meant the voices in your head.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: Okay...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: Why aren''t you laughing? C''mon, it was a joke!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: I thought you''d get it right away.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: Guess it didn''t land...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: Did you just ask me how I''m doing?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: Thanks, that''s so nice!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: No one ever asks how I''m feeling or even how my day was.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: Is it because I''ve got the sleek wheels of a race car in place of boring old legs? Are they JEALOUS?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: No one answers that honestly. That''s the problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: They just start making excuses, saying they were just taking a peek and they didn''t mean it. Yadda yadda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: Though it sucks when they just stare wordlessly, too.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: But ignoring my disability is stupid. I mean, it''s right there.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: Basically, we need to get some nuance up in here.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: But I don''t know where we are gonna find any of that these days! HAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: Have you ever tried to imagine how you''d walk if you were ridin'' dirty?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: Fuck, that''s not what I meant...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: ...If you didn''t have legs?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: EXACTLY. You wouldn''t even be able to leave your house!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: How would you use the stairs? Or cross the road?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: I mean those fucking curbs are wonkier than a zig-zag on an accordion!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: Your house doesn''t have any stairs or steps, so I can get around easily.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: But y''know, there''s still one thing I wish it had...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: ...A HILL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: Think about it! Wheelchair incline racing! Crashing into walls and shit. HAH! But whatever...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: Man, I can''t believe you haven''t provided any way for me to experience the thrill of the track in your own home.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: Oh, hang on, you asked me how I''m doing.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: Not bad. Thanks for asking.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: Wanderin'' free, wish I could be...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: Do you have sunstroke?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: What''s that got to do with anything?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: My hair hasn''t frazzled away or fallen out. So, I think I''m all good!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: I can''t race in a wheelchair without legs. See?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: I mean, how could I slow down at high speed? Or take a sharp corner?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: You don''t use a wheelchair, so I don''t expect you to understand.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: Do you really believe that?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: You really think your legs will grow back?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: Of course!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: You know what they say.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: The right leg takes longer strides. That''s why we''re all just running in circles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: Look, my legs prove it.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: It''s all the same. There''s no way out.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: This day ends and a new one''ll start tomorrow. But when the sun rises, will anything truly change?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: Fuck no. It''s just another fun spin on the cycle of shit!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: So, if you think about it, are you really any different from me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: We''re both just going around in circles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: Look, we live in a world of marvels.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: Sure, we''ve only seen terrible ones so far. BUT!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: The terrors will not persist forever. They will give way to wonderous joy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: God''s already forgiven plenty of sinners. Maybe he has something better in store for us too, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: Wanderin'' free, wish I could be...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: How did you lose your legs?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: Remember my friend up in the mountains I told you about? The ass nest one? HAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: Well... He decided to dig a trench in his yard.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: He got this funny idea that a tunnel full of meat was running under his house.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: So he went and ordered himself a big ol'' drill.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: Then he got to digging...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: Damn...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: That was probably the last time I saw him.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: Wanderin'' free, wish I could be...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: What about your legs?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: Fuck my legs! I wanna know if he dug down to where he wanted to get.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: Okay, forget it.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: Hmm... Yeah, that''s it! I forgot about him and went out to grab a beer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: Then I tripped over some tracks and a trolley cut my legs off!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: Or wait...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: No, that''s not what happened.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: Why aren''t you saying anything? Aren''t you interested in how I lost my legs?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: Well, I''m not telling you. Why torture you with the details?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: It''s so stuffy in here...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: Didn't you have a kid with you?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: Huh? He''s still around. Probably just wandered off somewhere...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: I need to know where my other kids went...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: Do you have a phone? I could call their father. That way I don''t have to see his ugly mug again.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: It''s so stuffy in here...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: Did you call your husband?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: Why should I? He''d just make some excuse. He never lifted a finger. It was all on me: the kids, the house, the bills.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: Sometimes I think we were just tolerating each other. But he never left me, for whatever reason.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: Maybe I was too convenient. Or maybe he was just scared I''d gut him if he ever tried.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: God, I''m tired...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: It''s so stuffy in here...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: Did you go see your husband?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: I can barely even get out of bed! Everything hurts and I''m exhausted. I''m pretty sure I''m only alive still out of spite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Everything was on me. The kids, my husband, the whole house. But sometimes he did things that made it almost tolerable.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: Can we talk later? I need to rest, I feel like I''m about to pass out.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: It''s so stuffy in here...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: What kind of things did he do?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: I remember this one time...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: He used to drive this woman around. I knew what was going on. I tolerated it at first, but I couldn''t stay quiet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: I nagged and nagged... He ended up switching jobs so he wouldn''t see her anymore. ...Maybe he really did love me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: Or maybe it''s all in my head... Anyway, I need to rest. We can talk later.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: It''s so stuffy in here...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: Aren't you worried about your kids?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Mmm... But probably not as much as I should be. The first one... I had no idea what I was doing. Screwed it all up.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: I thought I''d figured it all out by the second one. But he turned out the same. Then the third, and the fourth...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: The doctors told me I couldn''t have kids. When the second one came, I called him the Eighth Wonder of the World!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: But then...things got hard. It was awful...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: I... I need to shut my eyes...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: It''s so stuffy in here...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: What was awful?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: It''s hard for me to talk about. I love them, but... Sometimes, I''d lose my temper. Scream, even raise a hand to them.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: I know it''s horrible. I regret it all, I really do... But, you know... Now, for the first time, things feel easy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: Without them around, I feel like I can actually breathe... I hate to say it, but I finally feel...happy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Fucking shit...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: Well? Have you calmed down?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Yeah, I lose steam quickly. But as soon as I remember something that pisses me off, it sets me right off again.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: I used to be more easygoing, y''know. It was hard to offend me or push my buttons.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Now all it takes is the smallest spark to make all hell break loose.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: And why should I stay calm, anyway? Maybe my rage helps keep me sane.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: At least I don''t worship the oh-so-mighty sun like those dumbass stupid fuckwits.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: They think the sun is going to save us? Give me a fucking break! It''s fucking KILLING US!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: Way I see it, we''re all a bee''s dick away from the fucking void.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: But do those fuckknuckles get that? Abso-fuckin''-lutely NOT! Okay...I''m good, I''m calm. I''m done.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Thanks for listening.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Fucking shit...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: Where does all this anger come from?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Hell, even I couldn''t tell you that.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Everything going on just pisses me off.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: Especially the cultists, those blasted, lying assholes. They''re just looking to fool as many folks as they can.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: And people just gobble up their lies like hogs with their heads in a slop trough.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: Saps willing to tear the last scraps out of their own children''s hands in order to pay their tribute.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: All to appease some shitty savior from fuck knows where.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Batshit crazy fuckers. They even brainwash normal people with their delusional talk... Like my...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: Anyway, I''ve calmed down plenty. I feel better now.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Fucking shit...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: Did the cultists take someone from you?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: No, that''s the point. She went to them all by herself.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: My wife, that is...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Even before all this shit, she was deeply religious.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: I loved her, and I made peace with that. It never got in the way of us, of anything.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: But when shit hit the fan, she found a new faith in a new savior.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: The cultists'' batshit rhetoric sounded sensible to her.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: She got sucked in more every day, went completely fucking nuts. Fully believing in all kinds of nonsensical shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: ...Once I realized what I''d done, she was already gone. I scared her off. It was too late to change anything.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Fucking shit...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: What happened between you and your wife?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: One day, my wife told me she was going to join the cult.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: I... I just couldn''t believe it. The woman I loved... She''d become a completely different person.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: It was like everything we ever had meant nothing to her. I was furious, angrier than I''d ever been in my life.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: I started thinking that she never loved me—she''d just been looking for a way to get the fuck out. It made me sick.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: It was like my hands had a mind of their own. They balled into fists and I did something I''ll never forgive myself for.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: I hit her...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: There''s no fixing things now. She''s in the cult, and I...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: I can never make peace with what happened...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: FUCK, I HATE MYSELF!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: I''d be better off hurting myself instead of those around me. I deserve it.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Go away. I need to be alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: Hm? Want a reading?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: How do you know so much about me?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: Ha! What a silly thing to say... I''m not the one who knows, I am simply a vessel. The stars speak through me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: The Moon and Venus are in conjunction in the Sixth House. It''s written all over your face. You need not say a thing.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: I knew someone just like you once. He always listened, but never spoke.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: You know what they say: if Jupiter is in the Eighth House, it''s better to stay quiet. It''s a sign of closed doors.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: Hm? Want a reading?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: What happened to that man?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: I told him, "It doesn''t matter what you do. Only the color of your aura while you''re doing it." But he doubted me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: And so life passed him by.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: One day, I closed my eyes and envisioned the fulfillment of my dreams.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: I poured all my cosmic energy into that image.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: If you don''t open your heart to energy of the universe, why bother living in your body at all?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: You could do the same. Close your eyes...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: Imagine your wildest dreams have all come true...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Focus on the vision...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: Do you know why you suffer? You still fail to grasp that suffering is the purest form of joy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: So tell me... Are you ready to take the next step?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: Hm? Want a reading?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: What is this "next step"?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: It''s choosing yourself. Do you smell that? It''s the putrid stench of your long-dead dreams. It''s time to revive them.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: When I was at my lowest, without light or meaning, my mentor told me one thing: "You''re not listening to your ocean."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: I laughed it off at first—then I closed my eyes and heard it. Like it had always been there. You can hear it too!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: But first a question finds itself in need of an answer: are you ready to become one with yourself?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: Hm? Want a reading?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: Who was your mentor?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: A great woman. She was like a lighthouse in a storm. A beacon that taught me to see the essence of all things.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: I''ll never forget her words: "People only die because they do not learn to breathe their inner light."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: She opened my eyes, suddenly I saw that I could guide people along their own unique paths.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: But, well, she was afraid to go further.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: She could never see herself at the center of things. And yet that is where is most importance to be.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: If you''re not the center of your own universe, who is? You understand, don''t you?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: Hm? Want a reading?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: How did you help yourself?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: Every mistake we make is but a code within our inner universe that has yet to be deciphered.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: I took a long, winding path. Looked around, glanced back. Just look at how this house has responded to my presence.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Bright, spacious, and in harmony with my energy. There''s no need for you to try and fight against your own home.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: It''s already absorbed your fear, don''t you see? Accept it, or the walls will weep. Yet the tears will be your own.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: Hm? Want a reading?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: What do you want from me?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Oh my, you think I want something from you?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: You could find where your path lies hidden if only you saw your own shadow dance.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: You need only to recite joyous affirmations. You can sense everything changing, right? It''s easier to breathe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: That''s my energy reacting to your space. Don''t search for deeper meaning. Forgo the illusion and embrace chaos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: I''m simply asking you to join me. Become the space. Say, "I''m not a guest here. I''m the author of this sanctuary."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: Hm? Want a reading?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: What if I don't want to be the author of anything?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: These walls have longed to embrace you, yet you bind them with the chains of your authority.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: The silence inside you is the voice of the world you smother with your own fear.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: Your energy is frozen like honey in winter. You must thaw it with your breath. The mirrors never lie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: If all you see is yourself, you see nothing at all. All you have to do is shift your energy three degrees to the right.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: And with that you shall find joy at long last.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: I''m listening, human. Speak!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: Are you a member of some faith?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: YES, HUMAN! But my faith is nothing like the lowly religions you know.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: I worship THE HOLY SUN ITSELF! FOR SHE PROTECTS AND LOVES US!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: But the imbeciles and sheeple only see it as a threat. They think it''ll "incinerate us all"...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: BULLSHIT! Its righteous anger is directed solely at the seeds of EVIL and HERETICS! For they are the true sinners.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: May those who dissent never find themselves beneath its scorching rays of salvation!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: They seek out the flames and are surprised when they find themselves burned.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: Seeds of evil?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: Heretics?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: You still don''t know? You haven''t come face to face with THE ALIENS?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Very well, beamless human. I''ll open your eyes to the TRUTH.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: THE VISITORS ARE THE SEEDS OF EVIL!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: THEY ARE THE DESCENDANTS OF ALIENS who landed on Earth when the Sun was younger and the grass greener!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: DAMNED VASSALS who made their homes on Earth and inbred for CENTURIES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: And now they''ve climbed out from the depths and wish to claim OUR LANDS AS THEIR OWN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: But the SUN has decided to protect us, for THIS IS OUR HOLY LAND.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: The Sun shows NO MERCY on the blasphemers! Why would they have hid underground all this time otherwise?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Damn it... Why did you get so drunk that night?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: You didn''t need to drink yourself into oblivion. The righteous wrath of the Holy Sun, it...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: O HOLY SUN, forgive him his sins, for he knows not what he hath done!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Take him into your loving embrace. And perhaps also the soul of the ficus, which shall remain forever unwatered...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Amen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: You heard right, human!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: FEMA are damned HERETICS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: They interfere in processes that are beyond OUR control—the control of REGULAR PEOPLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: They stick their noses where they don''t belong.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: May the Sun incinerate the beamless assholes who threw my mother into that puddle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: I''m listening, human. Speak!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: Well, the sun's burned up a lot of people somehow
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: You''re right. All seeds of evil, human!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: The Holy Sun decided to punish them ALL for the sins of A THOUSAND YEARS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: AND THE VISITORS, THOSE SHADOWMAD BLASPHEMERS, have begun to reach out for the SUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: But the SUN is not for them! No! Not for the claws of filthy subterranean dwellers...but for us, for HUMANS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: IT BELONGS TO US!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: IT''S A BLESSING UNTO MANKIND, AND PRAISE FUCKING BE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: How many more people need to be burned up to satisfy the sun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: Are you saying the end of the world is justice enacted by the sun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Many.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: And believe you me, friend, this is FAR FROM OVER.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: IT HAS ONLY JUST BEGUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: The weight of our ashes on the SCALE OF SIN has yet to tilt the balance against the FORCES OF THE UNIVERSE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: MORE MUST BURN in the righteous flames of the SUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: But know this, my friend: the martyrs shall not die in vain!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Someday, we will all understand the Sun''s true plan...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Damn it... Sometimes in the night, I feel like my wife''s leaving me all over again...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: She was such a saintly woman...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: ...But also a total bitch.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: The end for who?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: For us?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: Don''t make me laugh. THE SUN IS ON OUR SIDE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: It''s our savior, can''t you see that?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: It''s trying to drive the Visitors back underground...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: It''s punishing the vile blasphemers for the accumulated sins of humanity...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: It reveals the heretics in their piss-stained tatters hiding shamefully behind deceitful masks.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: We must give thanks to the Sun, not wail like suckling babes about the "end of the world."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: THIS IS THE ONLY END FOR ALL FOES OF THE ALMIGHTY SUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: DEATH TO THE DIRT DWELLERS! DEATH TO THE SHIT-STAINED HERETICS! DEATH TO THE SEEDS OF EVIL!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: Damn, what I wouldn''t give for some french fries...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: I''m listening, human. Speak!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: Do you think what's happening has some sacred meaning?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Human, tell me... Why did I explain all of this to you, spoon-feed you every last tiny detail...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: Just for you to ask me THE SAME EXACT FUCKING QUESTION?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: It seems I was wrong about you. You are truly beamless... You can''t understand the heart of our transpirings at all...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Fuck, I''d kill for a cold one...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: Have you perhaps a yeasty offering, human?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: 'Sure, take this (give him a beer) '
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: You don''t have any? Do you think I''m an idiot, human?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: I saw the inside of your fridge WITH MY OWN EYES!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: Come on, human. You''d drink all that beer and not give measly can unto others?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: No (don't give him a beer)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ahh, thank the Sun...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Mmm, that''s the good stuff. A dark lager, my favorite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Reminds me of hanging out at the bar with my friends.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: Great conversations, cold pints, couple of snacks and dips...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: And the sullen face of that scrawny guy who always stared at us disapprovingly...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Well, no reason to get upset. You may be stupid, human, but at least you''re kind.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Let me give you a little thank-you gift. Take this.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: May the Holy Sun have mercy on your soul!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: You WRETCHED FIEND!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: DAMN YOU TO THE FIRES OF HELL, YOU SON OF A BITCH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: The ingratitude! I explained the holy precepts to you, the significance of all that''s transpiring, and yet you...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: You are yet a FOOL, human! And an EVIL one at that!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Fuck you. You can rot in this shack for all I care! I''m going somewhere better.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: You''ll see. I bet they''ll even let me back in at the bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Have a nice rest of your life, dumbshit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: Heh h-heh. I hope all this ends soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: How did you lose your house?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Ahh... I remember like it was yesterday.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: I had just gotten fired. All I wanted was to go home, climb into bed, and cry my eyes out.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: But when I got there, I saw a buncha boots. I thought maybe my roommate had some friends over or something, y''know?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: So I went up to her room to find out what she was up to. But as I got closer, I started hearing a strange sound.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: It kinda freaked me out. But I, um, decided to take a peek, quiet-like, and see what was going on in there.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: I was only able to catch a brief glimpse of my roommate lying motionless on the bed when suddenly...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Some grubby guy grabbed me from behind and said, "You can''t go in there. She''s...not well."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: Come have a seat in the kitchen. Then he quickly pulled me away and sat me down at the table.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: I wanted to leave, but I was paralyzed by fear... Then...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: I... He...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: I need to lie down. I... I... My stomach is doing somersaults... Ugh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: Heh h-heh. I hope all this ends soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: What happened next, back at your house?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Ugh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: After the man sat me down at the kitchen table, some huge guy came out from around the corner and blocked the exit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: He started talking loudly with the guy who''d grabbed me before.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: They were acting like... Like I wasn''t even there. And then...they started to touch me!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: First my arms, then my shoulders...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: And in the background, I heard cheers and laughter that seemed to come from my room...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: It sounded like there was a whole crowd of men in there. Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: I... I couldn''t breathe. My heart felt like it was about to explode out of my chest...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: I wanted to scream or call for help, but...my voice was lost in a sea of panic. I couldn''t even make a sound.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: I just sat there frozen, useless...like a deer in headlights.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: But then the big guy went to the fridge to get something. I realized that was my chance...! H-Heh!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: I sprinted for the exit. It was like the fear gave me strength. I just ran and ran... I ran and never looked back.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: Well, I did until my legs gave out and I collapsed...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: Why didn't the sun burn you up?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: What happened next?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: I don''t remember...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: I must have spent the whole night just lying there on the ground, and then...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: That''s odd... I-I could''ve sworn I remembered everything that happened to me that day...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Hang on, you don''t think I...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: I...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: I might be a Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: N-No, that can''t be true!? I... I remember my whole life. My childhood, my mom and dad. No!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: I''m not a Visitor, right? Right?! Tell me I''m not a Visitor!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: I don't know
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: You're not a Visitor
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: You seem like a Visitor
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: I was lying on the ground, and then...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Then...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: I could''ve sworn I remembered everything that happened that day...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Hang on, you don''t think I...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: I...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: I might be a Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: N-No, that can''t be true?! I remember my whole life. My childhood, my mom and dad. No!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: I''m not a Visitor, right? Right!? Tell me I''m not a Visitor!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: I don't know
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: You're not a Visitor
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: You seem like a Visitor
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: WHY WOULD YOU SAY THAT?! Haha! Oh my god, oh my god, oh my god, OH MY GOD!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: I... I need to lie down. My stomach is churning again. Ugh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Thanks, that makes me feel better.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Ugh, I need to lie down. My stomach is churning again.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: WHY WOULD YOU SAY THAT?! Haha! Now I''m even more scared!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: I DON''T WANT TO DIE! I DON''T I DON''T I DON''T I DON''T I DON''T!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: I guess we''re all going to die.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: Heh h-heh. I hope all this ends soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: Are you okay?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: DON''T COME ANY CLOSER!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Sorry, I... I thought you were going to kill me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: Why would you think that?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: If I wanted to kill you, you'd have been dead a long time ago
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: I...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: I have no idea who''s a Visitor and who isn''t... What if...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: What if YOU''RE a Visitor?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: Will you kill me? Skin me alive? Peel it away?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: PLEASE, NO! JUST KILL ME QUICKLY A-AND PAINLESSLY!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: I DON''T WANT TO DIE IN AGONY! PLEASE!!! HAHAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Relax, I'm not a Visitor
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: I'm not going to kill you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: S-Sorry, I''m, um, really on edge...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: I have no idea who I can trust.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: And what if...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: What if you''re a Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: Will you kill me? Skin me alive? Peel it away?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: PLEASE, NO! JUST KILL ME QUICKLY A-AND PAINLESSLY!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: I DON''T WANT TO DIE IN AGONY! PLEASE!!! HAHAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Relax, I'm not a Visitor
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: I'm not going to kill you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: HOW CAN I BE SURE?! I-I haven''t checked your teeth or your eyes... Hahah!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: We''re all going to die... It''s just a matter of whether the Visitors or sun gets us first...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: There''s no hope left. Death is coming for us, no matter what we do...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: I want to be alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: HOW CAN I BE SURE?! I-I haven''t checked your teeth or your eyes...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: We''re all going to die... It''s just a matter of whether the Visitors or sun gets us first...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: There''s no hope left. Death is coming for us, no matter what we do...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: I want to be alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: Heh h-heh. I hope all this ends soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: What's wrong with you?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: THE VISITORS! THEY''RE COMING FOR US!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: C-Can''t you hear it? DEATH IS CALLING!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: VISITOR, HUMAN... WHAT''S THE DIFFERENCE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: WE''RE ALL THE SAME WHEN WE''RE DEAD!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: So why torture ourselves by waiting? LET THEM COME! HAHAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: THEY WANT WHAT''S BEST FOR US! LET THE VISITORS COME!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: You don't seem well
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: Have you gone crazy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: NO! I''VE SEEN THE LIGHT!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: I AM A VISITOR! HAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: WE ARE AS ONE WITH THE HUMANS. REFLECTIONS! MIRRORS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: ONE AND THE SAME!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: TOGETHER WE SHALL WELCOME DEATH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: Do you hear how crazy you sound?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: You've left me no choice
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: I''M NOT CRAZY—I''VE SEEN THE LIGHT!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: I AM A VISITOR! HAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: WE ARE AS ONE WITH THE HUMANS. REFLECTIONS! MIRRORS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: ONE AND THE SAME!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: TOGETHER WE SHALL WELCOME DEATH! IT''S COMING FOR US ALL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: Do you hear how crazy you sound?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: You've left me no choice
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: N-No, you don''t understand anything!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: The end is nigh! THE SUN HERALDS THE FINAL APPROACH.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: We''ll meet soon. Very soon...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: Shoot! SHOOT! What are you waiting for?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: WILL YOU KILL ME WITHOUT EVEN A CRUMB OF REMORSE?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: I don''t care! Hahaha! DO WHAT YOU MUST, HUMAN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Shoot her
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: Yes? Was there something you wanted?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Why did they throw you out of the bar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: Hm. I blame the chain of catastrophes that broke everyone''s minds.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: The sun teetering on the brink of explosion, the arrival of the Visitors, the economic crisis, and so on and so forth.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: It fucked us all up. Some crumbled under the stress. Some dove headfirst into the bottle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: But me? Well, it was rage that drove me mad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: I snapped, climbed onto the bar and screamed "Stop fucking blaming everything but yourselves!"'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: Let them weep, I say. Tears in the beer foam don''t ruin the pint. Malt and hops taste better with salt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: Nobody appreciates it, so why bother.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: Yes? Was there something you wanted?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: Are things any better here?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: I don''t bother anyone anymore. It''s not worth it.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: But when I hear voices on the TV or overhear conversations, a light flicks on inside my mind.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: ...Then I stop myself. It''s too much work for no gratification.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: No, I''m done. These nerves of mine are already shot to hell and back.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: Life was dreary enough before all this, and now...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: One day, I''ll hang from the chandelier over the whole baptized world.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: Yes? Was there something you wanted?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: Everything okay?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: Hm? Why do you ask?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: I smell something on you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: Do you have a fever?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: Well... I drank some of your beer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: I wasn''t feeling well, so I decided to self medicate with a cold one. There''s nothing wrong with that.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: It''s all just one big fucked-up mess.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Everyone says they''re figuring things out, solving problems—but it''s all bullshit. Nothing ever changes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: You know, my good man, I think we might just all die soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: If the sun doesn''t kill us, the Visitors will. And if we beat the Visitors, we''ll sure as hell bury ourselves alive.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: When a problem is solved, it creates a void. And then we just fucking create one of our own to fill it.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Like an endless, morbid fascination with collectively shitting our own pants.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Fuck.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Go away. I feel sick.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: I''m not the one with a fever. It''s the whole fucking planet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Everywhere you look, someone''s dying. The glaciers are melting, the forests are ablaze. The world is burning.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: The planet is trying to shake us off like blood-bloated fleas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: One day, it''ll succeed, y''know. ...And don''t think it''ll be painless.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: Urghhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Fuck off. Please. I don''t feel well.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: Yes? Was there something you wanted?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: Feeling any better?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: My good man...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: We''re all going to die someday. That''s an unavoidable truth.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: What do you think happens to us after we die?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: Faith will deliver us to the sweet hereafter
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: Nothing
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: I don't know—maybe we float around in space
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: There''s something to that.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: But it doesn''t make me feel any goddamn better. Y''know why?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: My brain will reach out for that while I''m dying. It''ll show me visions of some paradise, somewhere nicer than here.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: And when my strength to hold onto that fragile dream fades, what then?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: No. It doesn''t make me feel any better.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: I was truly hoping you''d say something else.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: You might be right, of course. But that sounds so sorrowful...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: For there to be nothing in the end, after all...this. Nothing but darkness...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: I suddenly don''t really feel like talking.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: If you really think about it...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: We must be completely alone in the universe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: There''s clearly no other life. Just cold, empty space.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: If there were, we''d have to have picked up some kind of signal or sign by now, right? I don''t know...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: An empty void of endless darkness... Ending up there would be the same as disappearing.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: I... I want to be alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: Yes? Was there something you wanted?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: Are...you okay?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: At least the bar had a high ceiling.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: You could hang yourself from it, no problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: It''s too cramped for me in here. This whole planet is too cramped for me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: My good man, I just want this all to end.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: It''s all a fucked-up mess. Everything scares me shitless.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: I just can''t take it anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: Why did I even come here?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: I could use some rest...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: Is there anything you need?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: For him to be alive.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: That''s all...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: That''s all I really need.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: Can I get you some water?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: Would you like some food?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: I''ll just...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: Sit here by the faucet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: I can drink from it if I need to.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: I'll leave you be, then
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: Can I sit with you?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: I''m not hungry.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: I just...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: I just want to sit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: I'll leave you be, then
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: Can I sit with you?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: Why did you have to go and die?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: You promised me everything would be fine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: You told me this would all get better.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: And then you died.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: Now I''m the only one left.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: Why did you leave me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: I only want to be with him.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: And you can''t bring him back to me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: I can''t even...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: Bury...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: I can''t even bury him.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: What am I supposed to do?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: I could use some rest...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: How did he die?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: He... I can''t...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: It''s just too much.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: I''ve run out of tears.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: I have no tears left to cry.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: But that''s wrong... All wrong...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: I can''t just stop crying.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: He needs to be buried
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: Your husband is gone. You need to accept that
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: No...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: No, no, no, no, NO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: I''m not ready.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: They only just gave him back to me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: And you expect us to part ways again already?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: I can''t.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: I won''t send him down into the cold-hearted earth.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: No.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: You''re wrong, that''s not true.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: He can still hear me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: I...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: I''d rather choose to believe he can.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: I could use some rest...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: What do you remember about him?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: We were over at our friends'' place one day.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: We were much younger then.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: We were all hanging out, drinking. He was usually pretty moody. He didn''t talk much at get-togethers like that.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: Well, we''d been drinking a lot that day.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: One moment he was his usual silent self. Then all of a sudden, he said:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: Gimme a guitar. I''m gonna sing somethin''.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: And he played oh-so beautifully. I loved it.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Our friends started requesting other songs for him to play. He just sat there for a moment, and then...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: He got up and said he had to go. He knocked over a glass, tried to catch it, dropped the guitar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: I found out later that he''s only learned that one single song to impress me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: I still have a photo of us from that night.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: It''s seen better days, just like us...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: Now you can''t play for me anymore. You''ve sung me your last song.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: I could use some rest...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: So, what happened to him?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: He fucking died.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: Right. Sorry for bringing it up
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: I didn't kill him
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: I''m sorry, I just...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: The tears come every night. I can''t stop them.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: I want the ones responsible for everything that happened... I want the sun to burn them alive more than anything.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: So... What happened?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: I'll stop asking you about it
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: I know. You''re right.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: That was rude. It''s just so hard for me to talk about him.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: I hope those bastards get what they deserve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: I hope someone rips them apart.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: So... What happened?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: I'll stop asking you about it
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: My husband wasn''t feeling well. He went to the hospital, but they sent him away.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: Told us to go to the new center FEMA had opened.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: All they did was put him in quarantine. Took his phone away and said they''d let him out after three weeks.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: I went over there early once, just to check up on him.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: Those bastards, they...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Give me a minute. I''m sorry.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: All they said was, "He''s dead."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: That was it.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: They wouldn''t let me see his body.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: They wouldn''t let me take him home.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: But those apes can barely even tie their own shoes. All I had to do was put on a lab coat and walk into the morgue.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: And he...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: He really was in there.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: They killed him. His blood is on their hands. All I can do now is scream that my pity for others has run dry.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: I''d like to be alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Yes. Please...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: I don''t think I can go on without him...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: I could use some rest...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: Is something wrong?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: I''m leaving tonight.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: I told you I wasn''t planning on staying long.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: I just needed a place to rest for a while.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: What will you do next?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: Will you stay with family?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: I don''t want to think about it.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: I... I think I''ll just go home.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: Find that old guitar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: And then...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: You could stay here
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Good luck
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: We have none left.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: We''re going home.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: There''s nothing else left.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: You could stay here
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Good luck
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Why?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: It wouldn''t make things any easier for me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: Not to be rude, but I don''t care about you.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: I just want to go home.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: To be back where I belong.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: ...Thanks.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: You don''t talk much, but...you''re a good listener.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: I hope you find what you''re looking for.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: Hehe. Sup?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: What did you do before the Cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: Oooh, I''m glad you asked, bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: You ever heard of...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: ...sports betting? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: What are you, a scammer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: Sure I have
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: C''mon, don''t call me that! I''m a fuckin'' analyst, man!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: If you knew how much cash crossed these palms, you''d be straight droolin'', bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: I''m a professional. And I''m all about my business, bitch.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: People''d bring their dough to me and get back five...no, TEN times what they put in.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: So, how much did you make?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: You call that a job?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: It''s how I made my livin'', bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Placing legit bets is for chumps and bitches, bro. F''real. F''real.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: There''s always ways to cheat the bookies.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: You just bet on the tip and then kick back till the dough comes rollin'' in to daddy!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: No money, no problem. Just borrow it from some other fucknut!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: So, how much did you make?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: You call that a job?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: How do I put this...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: I made thirty. Fuckin''. Mil...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: ...in debts, sure, but debts got nothin'' on me!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: And I definitely don''t give a shit about them now.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: I look danger straight in the eyes, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: You shittin'' me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: Of course, it''s a job!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: I even had an office and everythin''. Man, it was straight king shit, bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Leather fuckin'' sofa. And a notepad, yeah, names of bookies, amounts owed, net profit, all that paper shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: Hehe. Sup?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: You sure there aren't any debt collectors after you?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: Debt collectors? Fuck you mean, debt collectors?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: Look, "debts" are fuckin'' cancelled, bro. The sun took care of that shit!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: The banks aren''t exactly doin'' shit. Probably never will again!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: Which means I''m free as a fuckin'' bird. But the grind never ends, boys!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Bettin'' is so cooked. I gotta think up somethin'' new, somethin'' better.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: Sounds like everything going on with the sun was a stroke of luck for you
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: Seriously? You're going to find a new hustle?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: Maaan, come on. You really gonna do me like that?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: I had it all figured out! Double or nothin'', every time! No sweat, bitch!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: But now I have a fresh start. F''real.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: By the way, I figured out my new hustle. Want the low down? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: Let's hear it
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: Not really
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: I came up with a CRACKED way to make bank a little while ago. Wanna hear it?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: Let's hear it
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: Not really
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: Look, FEMA''s clearly calling the shots now, aight?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: We need to, like...kiss a little ass. Y''know?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: I''m thinking, if we hand chumps over to them on the regular, they might even let us into one of their tight-ass bunkers!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: You feel me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: You want to hand people over to FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: You think FEMA will save you?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Sure. Why the fuck not?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: Don''t be a pussy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: Dire times call for dire hustles, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: Quarantine zones are for sheeple. Ain''t nothin good happenin'' in there.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: So we gotta get in good with FEMA. Tongue the ring a little.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: Don''t need to fuckin'' kiss ''em, just hand people over... Give ''em what they want.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Yeah... Yeah... We can call the hotline and chat shit about signs and fucking whatever! So they know we ain''t sus, bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: They''re the good guys. F''real! F''real!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: Maybe you're right
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: You're full of shit
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: If you want in with them so badly, get the fuck out of my house
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Damn, bro. The winds of change ain''t blowing your crusty di...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Anyway, we gotta figure out who''s in charge and stick with ''em. It''s a winning strat, bro. You feel me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: So we gotta get in good with FEMA. Tongue the ring a little.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: Don''t need to fuckin'' kiss ''em, just hand people over... Give ''em what they want.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Yeah... Yeah... We can call the hotline and chat shit about signs and fucking whatever! So they know we ain''t sus, bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: They''re the good guys. F''real! F''real!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: Maybe you're right
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: You're full of shit
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: If you want in with them so badly, get the fuck out of my house then
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: Of course I''m right.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: I''ve got a sixth sense for hustlin'', bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Trust, you can''t lose if you stick with me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: Maaan, fuck off. You''re the one full of shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: People used to pay me for investment advice. I''m givin'' it to you for FREE, sharin'' it with you as a gift, and you...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Fuck you, and your pussy-ass, bitch... I don''t need this shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: What, you gonna kick me out or somethin'', bitch?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: Man, I thought you were a bro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: I even offered to let you in on my hustle. But you just...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: You can go to hell. I''m outta here.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: Shit, seriously? I was straight cookin'' with that one, too. But suit yourself, bitch...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Well, you change your mind, lemme know. Aight...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: Hehe. Sup?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: What do you want?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: I need to test you
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Check it, I came up with a new hustle. This one''s fire, f''real.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: Aight, so basically...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: The sun''s roastin'' us all like a sauna from hell, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: I think that means the ozone layer''s fucked.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: But, get this... Oxygen comes from sunlight passin'' though Ozone...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: You see where I''m goin'' right, bro?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: ...SELLING AIR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: Now THAT''S a fuckin'' HUSTLE, bitch!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Amazing plan, fucking incredible
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: That is the single most stupid fucking thing I've ever heard in my entire life
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: Brooooo! You think so?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Yeah, of course. You should be a scientist
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Damn, well...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Thanks, bro! I knew you were smart! You can see all this brain juice I got coursin'' through my balls!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: I''ma win a fuckin'' Darwin Award at this rate!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: You...do know what a Darwin Award is, right?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Oh, you'll definitely get one
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Uh... They give ''em out for, like, best science fuckery or like nerd shit. Right?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: Why?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: No reason
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: They give Darwin Awards to people who die in dumbass ways
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: Haha! I can already taste the recognition. Science king! Bow down, bitches!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Fat stacks, fat status, fat booty... Hell fuckin'' yeah, baby!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: Aight, that settles it. After this all blows over, I''m patenting technology to sell air.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: I knew you''d get it, bro! Yeah!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Hold up, are you makin'' fun of me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: Fuck you. I''m here cookin'' up straight GOLD, and you''re mockin'' me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: Fuck you. I''m here cookin'' up million dollar hustles, and you''re mockin'' me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: I''ll get that Darwin Award and become a fuckin'' billionaire, bitch!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: Then you''ll kiss my fuckin'' feet and beg for forgiveness...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: I need you and your shitty ideas to fuck all the way off
    m_Metadata:
      m_Items: []
