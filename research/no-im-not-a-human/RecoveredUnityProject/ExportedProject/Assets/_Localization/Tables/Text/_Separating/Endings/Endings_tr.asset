%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Endings_tr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 5b2e2a6d2de35064e96737a28b7715de, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 206681661440
    m_Localized: Daha tatilden yeni döndük.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632960
    m_Localized: Evde oturup durmaktan bıkmadın mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632961
    m_Localized: E, hatırlıyorum tabii.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632962
    m_Localized: Plaja gittik işte.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632963
    m_Localized: Dün aşırı sıcaktı ama, o yüzden erken eve döndük.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632964
    m_Localized: Evet, bizim kızı okula hazırlıyoruz.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632965
    m_Localized: Gitmek istemiyor ama yapacak bir şey yok işte.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632966
    m_Localized: Neyse, gece vakti uğrarım.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632967
    m_Localized: Peki, konuşuruz sonra. Hoşça kal.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632968
    m_Localized: Diğer hayatta kalanlarla birlikte bodrum katına iniyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632969
    m_Localized: Aşağısı daha serin ama havada bir huzursuzluk var.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632970
    m_Localized: Depodaki yemekleri düzgün bölüştürürsen sizi bir iki ay götürür herhâlde.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632971
    m_Localized: Kapıyı iyice kapatıyorsun. Artık kimse içeri giremez.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632972
    m_Localized: Bodrumun duvarlarını kazıyarak gün sayıyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632973
    m_Localized: Neredeyse iki ay dünyanın sonunun gelmesini bekliyorsunuz.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632974
    m_Localized: Bazıları güneşin dünyayı yakmasını veya kararıp gitmesini umuyor. Bazılarıysa kendi sonunu kendisi yazmak istiyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632975
    m_Localized: Kaçınılmaz olanı ertelemek, işi bir an önce bitirmekten daha acıdır. Kimse yaşayanlara haset etmez.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632976
    m_Localized: Bir gün radyoda bir duyuru yapılıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632977
    m_Localized: ...gündüzleri dışarı çıkılabilecek."
    m_Metadata:
      m_Items: []
  - m_Id: 206702632978
    m_Localized: İçine bir his doluyor...
    m_Metadata:
      m_Items: []
  - m_Id: 206702632979
    m_Localized: Hayal kırıklığı mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632980
    m_Localized: Bu sene ölmeyeceğini fark ediyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632981
    m_Localized: Ama sonra ne olacak? Sonun sonraki yaz mı gelecek?
    m_Metadata:
      m_Items: []
  - m_Id: 206702632982
    m_Localized: Kaçınılmaz sonu beklemek seni boğuyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632983
    m_Localized: En azından birisi mutlu görünüyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632984
    m_Localized: Kim bilir... Belki bir on yıl daha yaşarsın.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632985
    m_Localized: Diğer hayatta kalanlarla birlikte bodrum katına iniyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632986
    m_Localized: Aşağısı daha serin ama havada bir huzursuzluk var.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632987
    m_Localized: Depodaki yemekleri düzgün bölüştürürsen sizi bir iki ay götürür herhâlde.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632988
    m_Localized: Kapıyı iyice kapatıyorsun. Artık kimse içeri giremez.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632989
    m_Localized: Bodrumun duvarlarını kazıyarak gün sayıyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206702632990
    m_Localized: Neredeyse iki ay dünyanın sonunun gelmesini bekliyorsunuz.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827264
    m_Localized: Seni bekleyen tek tehlike güneş değil...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827265
    m_Localized: Paranoya, her geçen gün artıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827266
    m_Localized: Soğuk. Kurnaz. Yabancı.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827267
    m_Localized: Buraya kadarmış.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827268
    m_Localized: Kaçacak bir yer kalmadı.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827269
    m_Localized: Evine aldığın herkes insan değilmiş.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827270
    m_Localized: Tüm sinir uçların aynı anda yanıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827271
    m_Localized: Bir an önce bitmesini ümit ediyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827272
    m_Localized: Bilincini kaybederken acı da yavaşça diniyor...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827273
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827274
    m_Localized: Beni kucakla...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827275
    m_Localized: Umarım bir pişmanlığın yoktur.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827276
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827277
    m_Localized: Sonrasında ne olur, hiç düşündün mü?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827278
    m_Localized: Öldükten sonra yani. Ne olabilir ki?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827279
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827280
    m_Localized: Bakıyorum sonunun geldiğini kabullenmişsin.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827281
    m_Localized: Sen öldükten sonra olup biteni niye umursayasın ki?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827282
    m_Localized: ...Gitme vakti geldi.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827283
    m_Localized: Ev, günler sonra dahi bomboş kalıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827284
    m_Localized: İnsanlar, sanki lanetlenmiş gibi buradan uzak duruyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827285
    m_Localized: Evin dedikodusunu yapanların sayısı, evde zamanında yaşayanların sayısını aşıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827286
    m_Localized: Ev, tıpkı sahibinin son kalıntıları gibi tarihe karışıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827287
    m_Localized: Geride kalanları almaya gelen bir akrabası da olmuyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827288
    m_Localized: Ev sahibi, birden yok olup gitti. Sanki hiç var olmamış gibi.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827289
    m_Localized: Sahip olduğu her şey ya kayboldu ya çürüyüp gitti ya da unutuldu.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827290
    m_Localized: İnsanlar, neden birden yok olurlar?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827291
    m_Localized: Ölüm seni yakaladıktan sonra var olduğuna dair tüm kanıtlar aniden solup gider.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827292
    m_Localized: Hepsi hiçliğe karışır.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827293
    m_Localized: Sanki hiç bu dünyanın bir parçası olmamışsın gibi.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827294
    m_Localized: Keşke bu donuk eller, beni sevebilse...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827295
    m_Localized: Bu, elinden gelir mi?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827296
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827297
    m_Localized: Tebrikler!
    m_Metadata:
      m_Items: []
  - m_Id: 206706827298
    m_Localized: Kendini tuhaf bir yerde buluyorsun. Önünde uzun bir koridor var, ucunda da bir masa.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827299
    m_Localized: Sen... Ne?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827300
    m_Localized: Neredeyim ben?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827301
    m_Localized: Benden korkan kalabalıklar bir araya gelse koca bir şehir inşa edebilirlerdi.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827302
    m_Localized: Ancak korkmana gerek yok. Burada korku diye bir şey yok.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827303
    m_Localized: Benimle tanışmayı ne zamandır bekliyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827304
    m_Localized: Hissedebiliyorum. Artık her şey yolunda.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827305
    m_Localized: Yine ne var?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827306
    m_Localized: Ben öldüm mü? Bu, mahşer mi?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827307
    m_Localized: Bu kederli topraklarda her şey kış için hazırlanmıştır. Kalın duvarlar, kalın montlar, kalın rüyalar...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827308
    m_Localized: Bu uzun gecenin nihayet sona ermesi ne kadar da hoş... Gün ışığı yakındır. O sırada gölgene ben bakayım mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827309
    m_Localized: Belli ki istiyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827310
    m_Localized: Korkman için hiçbir sebep yok.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827311
    m_Localized: Korkacak hiçbir şey kalmadı.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827312
    m_Localized: Yol, kaygan bir düğüme dönüşüp parçalandı.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827313
    m_Localized: Yine ne var?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827314
    m_Localized: Ben öldüm mü? Bu, mahşer mi?
    m_Metadata:
      m_Items: []
  - m_Id: 206706827315
    m_Localized: Sırada uzun bir ebediyet var.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827316
    m_Localized: Tüm acıların sona ermesi ne kadar da hoş...
    m_Metadata:
      m_Items: []
  - m_Id: 206706827317
    m_Localized: Bilmek istediklerini öğreneceksin.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827318
    m_Localized: Ancak aradığın cevabı bulamayacaksın.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827319
    m_Localized: 'A: Mantran da daima yankılanacak:'
    m_Metadata:
      m_Items: []
  - m_Id: 206706827320
    m_Localized: Korkuyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206706827321
    m_Localized: Şimdi ne yapacağım? Başka... hiçbir şey yok mu?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021568
    m_Localized: Korkuyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021569
    m_Localized: Ben... öldüm mü?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021570
    m_Localized: '"Ölmek" dediğin nedir ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 206711021571
    m_Localized: Belki de uyuyakalmışsındır, birbirimizi bir rüyada bulmuşuzdur.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021572
    m_Localized: O açıdan benziyoruz.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021573
    m_Localized: Ben, istenmeyen kardeşim. İnsanlık dediğimiz ailenin dışlanan çocuğuyum.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021574
    m_Localized: Şimdi ne yapacağım? Başka... hiçbir şey yok mu?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021575
    m_Localized: Korkuyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021576
    m_Localized: Tabii ki.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021577
    m_Localized: Bu minik krallık, onca uykuyu soğurdu.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021578
    m_Localized: Nereye gitmek istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021579
    m_Localized: Gözleri yüreğinde iz bırakanlara mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021580
    m_Localized: Hayır, onları görmek istemiyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021581
    m_Localized: Yorgunsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021582
    m_Localized: Nereye gitmen gerektiğini ben biliyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021583
    m_Localized: Sahte aynaların servet kisvesi verdiği yere.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021584
    m_Localized: Korkmana gerek yok. Ben zamanın mucidiyim. Burada kimse sana zarar veremez.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021585
    m_Localized: Karanlıktan teselli bul. Burada ne maskeli bir adam var ne de başkası. Onlar, yalnızca duvarlarıma yansıyan gölgeler.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021586
    m_Localized: Görüyorum ki hazırsın.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021587
    m_Localized: Seni çam ağaçlarının yıldızlara uzandığı geceye götüreceğim.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021588
    m_Localized: İstediğin buydu zaten, öyle değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021589
    m_Localized: Olman gereken yer...
    m_Metadata:
      m_Items: []
  - m_Id: 206711021590
    m_Localized: Ancak... bu kısa yollar, yakında epey genişleyecek.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021591
    m_Localized: Uzun, tozlu ve taviz gerektiren yollar olacaklar.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021592
    m_Localized: Tadını çıkar.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021593
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206711021594
    m_Localized: Ben öldüm mü?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021595
    m_Localized: Sonsuza dek burada mı kalacağım?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021596
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206711021597
    m_Localized: Biri gelecek mi?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021598
    m_Localized: Film falan izleyebilir miyim?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021599
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206711021600
    m_Localized: Biri gelecek mi?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021601
    m_Localized: Film falan izleyebilir miyim?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021602
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206711021603
    m_Localized: Burada başkası var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021604
    m_Localized: Korkuyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021605
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206711021606
    m_Localized: Burada başkası var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206711021607
    m_Localized: Korkuyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021608
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206711021609
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206711021610
    m_Localized: Burada gecenin de gündüzün de hiçbir anlamı yok.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021611
    m_Localized: Ne süredir burada olduğumu bilmiyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206711021612
    m_Localized: Ancak şu an... sakin hissediyorum. Hem de çok sakin...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215872
    m_Localized: Hiçbir ayak sesi duymuyorum, hiçbir ses gelmiyor. Hiçbir şey hissetmiyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215873
    m_Localized: Buraya nasıl geldiğimi bilmiyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215874
    m_Localized: Nasıl gideceğimi de bilmiyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215875
    m_Localized: Fakat gitmek de istemiyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215876
    m_Localized: Umarım bu, biraz daha sürer...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215877
    m_Localized: Acaba tüm bunların anlamı neydi?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215878
    m_Localized: Neden buraya gelmeme izin verildi?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215879
    m_Localized: Biri gelip beni alacak mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215880
    m_Localized: Umarım tekrar buluşabiliriz.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215881
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215882
    m_Localized: Yoruldum.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215883
    m_Localized: Biraz dinleneceğim.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215884
    m_Localized: Mantarlar öyle diğer şeylere benzemez! Ho ho!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215885
    m_Localized: Birden kocaman olurlar, gözlerinin önünde fasulye sapı gibi uzarlar.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215886
    m_Localized: Gece yarısı olduğunda onlara ne olacak diye düşünür durursun. Hım...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215887
    m_Localized: Kötülük öbekleri, giderek emeçlerin arasında birikir.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215888
    m_Localized: Ta ki geride hiçbir şey kalmayana kadar...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215889
    m_Localized: Şimdi de emeçlerin bu öfkeyi çıkarmanın bir yolunu bulması gerek delikanlı...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215890
    m_Localized: Hayda! Bu ayinin onları sakinleştirmesi lazımdı.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215891
    m_Localized: Elma tohumları, onlara insanlar ve mantarlar arasındaki bağı hatırlatacaktı.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215892
    m_Localized: Fakat belli ki emeçler kafayı yemiş, hapsettikleri öfke onları kör etmiş.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215893
    m_Localized: Mantarlar Diyarı buralarda bir yerde olmalı!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215894
    m_Localized: Acele et delikanlı! Mantar çok büyümeden emeçleri durdurmamız gerek!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215895
    m_Localized: 'İstikamet: Yerin altı!'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215896
    m_Localized: Hayda! Belli ki çok geç kalmışız delikanlı.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215897
    m_Localized: Peki öyleyse.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215898
    m_Localized: Ha... Sende hiç kombuça kaldı mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215903
    m_Localized: Cehennemin parıltısı nihayet sönüyor!
    m_Metadata:
      m_Items: []
  - m_Id: 206715215904
    m_Localized: Şiddet çağı artık sona erdi; sükûnet çağının öncüleri biz olacağız.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215905
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215906
    m_Localized: Artık endişelenmeye gerek yok. Kardeşlerin, artık ıstırabın karnını doyurmayacaktır.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215907
    m_Localized: Bugün kardeşlerim... Bugün kurtulacağız.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215908
    m_Localized: Önce hazırlık yapacağız... sonra da bekleyeceğiz.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215909
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215911
    m_Localized: Ölülere isim veririz ki boşa ölmüş olmasınlar. Onlar da bizim gibi götürüleceklerdir.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215912
    m_Localized: Biz, Olun'u böyle örttük. Artık adı bu.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215913
    m_Localized: Bizim de adımız olacak.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215914
    m_Localized: Evet, vakit geldi.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215915
    m_Localized: Kardeşlerim, artık O'nu çağırabiliriz. Hazırız.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215916
    m_Localized: Hiçliğe karışmaya değil, Ölüm'e dönmeye...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215917
    m_Localized: Bedenlerimizi Ölüm'ün ellerine teslim ediyoruz, ötede huzur bulabilmek için...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215918
    m_Localized: Bu bilgi, uzun zaman önce Dünya'ya yayılmıştı ancak kitlesel yok oluş sırasında kaybedilen tek şey yaşam değildi.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215919
    m_Localized: 'Ending: Artık kendimizi O''na nasıl teslim edeceğimizi bir kez daha öğrendik.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215920
    m_Localized: Havada bir ses yankılanıyor, kimden geldiği belirsiz.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215921
    m_Localized: 'Ending: Daha O''nun kelamını bulmam gereken çok yer var.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215922
    m_Localized: 'Ending: Ancak sen... tıpkı benim gibi, bu yolun sonunu biliyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215923
    m_Localized: 'Ending: Baştan beri nerede buluşacağımız belliydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215924
    m_Localized: 'Ending: Tam burada. Tam bu anda.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215925
    m_Localized: 'Ending: Seni kıyafetimin kolunda sakladığım bir kart gibi muhafaza etmeli miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215926
    m_Localized: 'Ending: Seni sellerden, yangınlardan, geçen zamandan korumalı mıyım?'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215927
    m_Localized: 'Ending: İstediğin bu değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215928
    m_Localized: 'Ending: Feryatlarını, ağıtlarını duyuyorum. Yas Ana, yükselecek olursa seni bulacaktır.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215929
    m_Localized: 'Ending: Her türlü geceye döneceksen burayı neden terk edesin ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215930
    m_Localized: Seni saklayacağım. Saklayacak ve olman gereken yere geri götüreceğim.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215931
    m_Localized: 'Ending: Bir dizi ahmaklığa tanıklık ettik.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215932
    m_Localized: 'Ending: Ancak muayyen olana ibadet etmek daha mübahtır.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215933
    m_Localized: Yoktan var oldun, dikkati üzerine çektin.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215934
    m_Localized: Bazı kapıları hiç açmamak gerek.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215935
    m_Localized: 'Ending: Kozmos deliliğinden sağ çıkmaman gerekiyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215936
    m_Localized: 'Ending: Hatıratını muhafaza edeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 206715215937
    m_Localized: Uğrama gibi bir niyetim yoktu ama bir görü gördüm... Burada garip bir şey oluyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215938
    m_Localized: Evine baktığımda aklıma belirli bir alıntı geliyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215939
    m_Localized: Hani o kadar karanlık bir şey görürsün ki bütün arzuların söner ve kara toprak seni seyreder ya...
    m_Metadata:
      m_Items: []
  - m_Id: 206715215940
    m_Localized: Bir şey mi yaptın?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215941
    m_Localized: Ne demek istediğini anlamadım
    m_Metadata:
      m_Items: []
  - m_Id: 206715215942
    m_Localized: Ziyaretçi öldürdüm. Başka nasıl hayatta kalabilirdim?
    m_Metadata:
      m_Items: []
  - m_Id: 206715215943
    m_Localized: Bence anladın.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215944
    m_Localized: Peşinde bir şey var. Nereye gitsen ardında bir karanlık bırakıyorsun. Bunun... böyle olmaması gerekiyordu.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215945
    m_Localized: Ölmekten korkmak, hayatta kalmaya çalışmak... Bunlar gayet doğal.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215946
    m_Localized: Fakat sen yoldan çok saptın. Korkun yüzünden ölümü daha da kendine çektin.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215947
    m_Localized: Bunu düzeltebileceğimi sanmıyorum. Beni affet.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215948
    m_Localized: Hayır, burada kesinlikle bir şey var.
    m_Metadata:
      m_Items: []
  - m_Id: 206715215949
    m_Localized: Dur, şimdi anladım.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410176
    m_Localized: Çok korkmuşsun. Aman aman...
    m_Metadata:
      m_Items: []
  - m_Id: 206719410177
    m_Localized: Korkun seni kör etmiş.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410178
    m_Localized: Başına gelecekleri düzeltebileceğimi sanmıyorum. Beni affet.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410179
    m_Localized: Bu hissi iyi bilirim.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410180
    m_Localized: Seni korkunç kararlar vermeye zorlar.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410181
    m_Localized: Ancak önünü görmek sadece işini zorlaştırır.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410182
    m_Localized: Seni bu kadar korkutan neydi?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410183
    m_Localized: Acı mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410184
    m_Localized: Solup gitmek mi?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410185
    m_Localized: Eninde sonunda.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410186
    m_Localized: Sen "eninde"yi seçmişsin.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410187
    m_Localized: Beni affet.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410188
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 206719410189
    m_Localized: Silahın yok. Kan ter içindesin.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410190
    m_Localized: Güneş ışığından kaçmaya yetecek enerjin yok.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410191
    m_Localized: Acına son vermenin bir yolu yok.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410192
    m_Localized: Yavaş yavaş yanacaksın.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410193
    m_Localized: Tabii, eğer...
    m_Metadata:
      m_Items: []
  - m_Id: 206719410194
    m_Localized: 'Window: Yine o çocuğu görüyorsun ama orada ne işi var ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410195
    m_Localized: 'Window: Köpeği mi yiyor? Yok. Hayvanın göğsüne yapışmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410196
    m_Localized: 'Window: Olduğun yerde kalıyor, hareket edemiyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410197
    m_Localized: 'Window: Neden annesine gitmiyor ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410198
    m_Localized: 'Window: Acaba gerçekten hamile miydi?'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410199
    m_Localized: 'Window: Sen bunu düşünürken dış dünya solup gidiyor, yoğun bir sisin altında boğuluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410200
    m_Localized: Yakınlarda bir şey hissediyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410201
    m_Localized: Çocuğu gördün, evet ama olay o değil.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410202
    m_Localized: Boğucu bir sis, tüm dünyayı kaplıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410203
    m_Localized: Tüm sesleri susturuyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410204
    m_Localized: Sessizliği, dünyayı pamuk gibi sarıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410205
    m_Localized: İnsanların fısıldadığını duyar gibisin.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410206
    m_Localized: Onlara sesleniyorsun ama hava durgunlaşıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410207
    m_Localized: Yoksa felaket tellalları mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410208
    m_Localized: Çocuk, kollarında kımıldıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410209
    m_Localized: Artık bu dünyaya nur getiremez. Yani, en azından getirebileceğini sanmıyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410210
    m_Localized: Bu bizim kurtuluşumuz mu, cezamız mı?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410211
    m_Localized: Panik seni ele geçiriyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410212
    m_Localized: Üçü de çocuğu kendine çekmeye çalışıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410213
    m_Localized: Silahını kaldırıp rastgele ateş ediyorsun. Nereyi vurduğun umurunda değil.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410214
    m_Localized: Bu da ne? Niye herkes böyle giyinmiş?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410215
    m_Localized: Sislerin arasında daha fazla insan beliriyor.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410216
    m_Localized: '"Sen nebisin," diyor bir kadın. "Anlamadın mı?"'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410217
    m_Localized: Sen bizim kurtuluşumuzsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410218
    m_Localized: Kimse hazır değil.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410219
    m_Localized: Vadedilen cennetin öncüsü sen olacaksın.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410220
    m_Localized: Fedakârlığın hepimizi kurtaracak!
    m_Metadata:
      m_Items: []
  - m_Id: 206719410221
    m_Localized: Bu deliliğin anlamı ne?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410222
    m_Localized: Kim bilir sana ne yapacaklar.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410223
    m_Localized: Kalabalığın arasında birinin elinde metal çiviler tuttuğunu görüyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410224
    m_Localized: Bu kasabada korkunç bir şey olmak üzere.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410225
    m_Localized: 'Gasmask: Merhaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410226
    m_Localized: 'Gasmask: Acil durum müdahalesine yaptığınız katkılar fark edildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410227
    m_Localized: 'Gasmask: Sizin gibi insanlara ihtiyacımız var. Bize katılın.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410228
    m_Localized: Bunu beklemiyordum
    m_Metadata:
      m_Items: []
  - m_Id: 206719410229
    m_Localized: Neden ben?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410230
    m_Localized: 'Gasmask: Endişelenmenizi anlıyoruz ama buna hiç gerek yok. İyi maaş alacaksınız, sigortanız da yapılacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410231
    m_Localized: 'Gasmask: Hazırlanın. Bizimle geleceksiniz.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410232
    m_Localized: İlgilenmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 206719410233
    m_Localized: Hazırım
    m_Metadata:
      m_Items: []
  - m_Id: 206719410234
    m_Localized: 'Gasmask: Yetenekli ve girişkensiniz. Bizim de tam böyle birine ihtiyacımız var.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410235
    m_Localized: 'Gasmask: İşe aldıklarımız, bizim kaçırdıklarımızı tespit edebiliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410236
    m_Localized: 'Gasmask: Şu an yeni çalışanlara ihtiyacımız var.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410237
    m_Localized: İlgilenmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 206719410238
    m_Localized: Hazırım
    m_Metadata:
      m_Items: []
  - m_Id: 206719410239
    m_Localized: 'Gasmask: Bu, bir teklif değildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410240
    m_Localized: 'Gasmask: Eşyalarınızı toplayın ve arabaya binin yoksa biz sizi zorla bindiririz.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410241
    m_Localized: 'Gasmask: Seçim sizin.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410242
    m_Localized: 'Gasmask: Güzel. Yalnızca gerekenleri alın. Size konut sağlanacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410243
    m_Localized: 'Gasmask: Buraya geri dönmenin bir manası yok. En azından bir süreliğine.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410244
    m_Localized: 'Gasmask: Sizi bekliyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 206719410245
    m_Localized: Kafan karışıyor. FEMA insanları böyle mi işe alıyor?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410246
    m_Localized: Bu, büyük bir kuruluş. Birçok insanla uğraşman gerekecek.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410247
    m_Localized: Belli ki mesailer de uzun olacak.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410248
    m_Localized: Bu iş ne kadar tehlikeli ki?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410249
    m_Localized: İnsanları zorla götürüp işe almak... Garip.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410250
    m_Localized: Demek ki elemanlarını elde tutamıyorlar. Yoksa işe almada neden bu kadar agresif davransınlar ki?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410251
    m_Localized: İnsanları karantina bölgelerine mi götürüyorlar?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410252
    m_Localized: Ee, sonra?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410253
    m_Localized: Seninle yaşayanlara ne olacağını da öğrenemeyeceksin.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410254
    m_Localized: Eski hayatına bir daha asla dönemeyeceğini hissediyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410255
    m_Localized: Brifinglerden anladığın kadarıyla bu iş, uzun vadede hayatta kalmak üzere planlanmamış.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410256
    m_Localized: Tek pişmanlığın, posteri yanına almamış olman.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410257
    m_Localized: Kapının arkasından bir delinin sesleri geliyor. Epey öfkeli.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410258
    m_Localized: Yapabileceğin tek şey bekleyip hiçbir şey olmamasını ummak.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410259
    m_Localized: Silahlı adamın gözlerindeki öfke, Ziyaretçilerden katbekat daha korkunç.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410260
    m_Localized: Nefes nefese kaldığını duyabiliyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410261
    m_Localized: Şerefsiz... Vurdu beni.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410262
    m_Localized: Kendimi savunduğum için... işi uzatır sanmıştım ama... peki ya diğerleri?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410263
    m_Localized: Sessizleşti. Bir kontrol etsen iyi olur, belki de...
    m_Metadata:
      m_Items: []
  - m_Id: 206719410264
    m_Localized: Senin gibi piçler yüzünden bir sürü insan öldü.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410265
    m_Localized: Senin gibi piçler arkadaşımı öldürdü.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410266
    m_Localized: Senin gibi piçler, bizim huzur içinde yaşamamıza asla izin vermeyecek.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410267
    m_Localized: Ne oldu, kimsenin kendisini savunmayacağını mı sandın?
    m_Metadata:
      m_Items: []
  - m_Id: 206719410268
    m_Localized: Deliliğin eşiğindeki bu salaklar...
    m_Metadata:
      m_Items: []
  - m_Id: 206719410269
    m_Localized: Sizi yok edeceğim!
    m_Metadata:
      m_Items: []
  - m_Id: 206719410270
    m_Localized: Sizi yerle bir edeceğim.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410271
    m_Localized: Kanınızı HER YERE saçacağım.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410272
    m_Localized: Elinde silah taşıyan ne kadar piç varsa hepsi bugün ölecek.
    m_Metadata:
      m_Items: []
  - m_Id: 206719410273
    m_Localized: HEPSİ.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836555284480
    m_Localized: '"Güneş faaliyetleri azalıyor..."'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836555284481
    m_Localized: '"Bilim insanlarının tahminlerine göre birkaç gün içerisinde..."'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478784
    m_Localized: Güven azalıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478785
    m_Localized: Seni seyrettiklerini hissediyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478786
    m_Localized: Ölüm korkusu seni felç etmiş.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478787
    m_Localized: Kaçmak aklının ucundan bile geçmiyor.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478788
    m_Localized: Dehşet seni kör ediyor.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478789
    m_Localized: Seni paramparça ediyorlar.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478790
    m_Localized: Gözlerin kararıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478791
    m_Localized: Gözünün önüne küçük, yalnız bir ev geliyor.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478792
    m_Localized: Gitmesin diye kendini zorluyorsun...
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478793
    m_Localized: Bize katıldığın için çok mutluyum kardeşim. Demek ki Ölüm seni boşuna seçmemiş.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478794
    m_Localized: Korku ve kelamının yozlaşması yüzünden O'na uzun süredir sarılamıyoruz.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478795
    m_Localized: Ancak artık geleneklerimize döndük.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478796
    m_Localized: Hepimizi kucaklayacaktır.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478797
    m_Localized: Kimse dışlanmayacaktır.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478798
    m_Localized: Ölüm dahi bizzat yükselecektir...
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478799
    m_Localized: Hissedebiliyor musun? Geldi.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478800
    m_Localized: Şimdi harekete geçmeliyiz.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478801
    m_Localized: Gel, seni saklayacağım.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478802
    m_Localized: Olman gereken yere geri götüreceğim.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478803
    m_Localized: Sana huzur vereceğim.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478804
    m_Localized: İnsanoğlunun bunca süredir arzuladığı o huzuru...
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478805
    m_Localized: Kozmos deliliğinden sağ çıkmaman gerekiyordu.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478806
    m_Localized: Hatıratını muhafaza edeceğim.
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478807
    m_Localized: 'Vigilante: Vay şerefsiz! Siktiğimin Ziyaretçi''si seni, beni kandıracağını mı sandın?'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478808
    m_Localized: 'Vigilante: Geber piç!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478809
    m_Localized: 'Vigilante: Siktir, harbi Ziyaretçi''sin lan sen!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478810
    m_Localized: 'Vigilante: Buraya kadardı şerefsiz...'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478811
    m_Localized: 'Vigilante: Sen beni salak mı sanıyorsun? Buna kanar mıyım ben?'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478812
    m_Localized: 'Vigilante: Öldün sen piç!'
    m_Metadata:
      m_Items: []
  - m_Id: 11636836559478813
    m_Localized: Kim bilir kaç kişiyi katletti? Kaç kişiyi yaktı?
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062336
    m_Localized: Her şey durgun.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062337
    m_Localized: Artık burada sana engel olabilecek bir şey kalmadı.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062338
    m_Localized: Ancak bunun sırası değil...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062339
    m_Localized: İşler kötüye gidince çok hızlı büyürler.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062340
    m_Localized: Mantarlar büyüdükçe de...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807458062341
    m_Localized: Başlarıyla koca dünyayı örtebilirler.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256640
    m_Localized: Çabuk, beni takip et!
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256641
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256642
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256643
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256644
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256645
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256646
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256647
    m_Localized: Ölmek korkunçtur.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256648
    m_Localized: Korkusu bile insanı deli eder.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256649
    m_Localized: Senin için neler planladığını görebiliyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256650
    m_Localized: Buna engel olamazsın.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256651
    m_Localized: Seni sokağa attılar.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256652
    m_Localized: Suçlayacak kimse kalmadı.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256653
    m_Localized: Seni izleyip duran bir şey var sanki.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256654
    m_Localized: Onlarla tanışmak iyiye mi işaret?
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256655
    m_Localized: Ne oluyor?
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256656
    m_Localized: Bu dünyanın günahlarına isim veriyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256657
    m_Localized: Çocuk, bizi bir dehşet krallığına götürecekti.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256658
    m_Localized: Ancak sen... Sen, karanlığı defedeceksin.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256659
    m_Localized: Sözleri seni felç ediyor.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256660
    m_Localized: Ne dediği belli değil ama belli olan tek şey var, o da çocuğun artık aramızda olmadığı.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256661
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256662
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256663
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256664
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256665
    m_Localized: Ne zaman eve dönmene izin verirler, belli değil.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256666
    m_Localized: Ne iş yapacağın bile belli değil.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256667
    m_Localized: Evine ne olduğunu hiç bilmiyorsun.
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256668
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256669
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256670
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256671
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256672
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256673
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 11994807462256674
    m_Localized: Artık her şeyi kaybettim ama sen... Senin daha kaybedecek çok şeyin var.
    m_Metadata:
      m_Items: []
  - m_Id: 1361586487812096
    m_Localized: Eşyaların, eserlerin, düşüncelerin, anıların, duyguların...
    m_Metadata:
      m_Items: []
  - m_Id: 1361586487812097
    m_Localized: Artık "sen" diye bir şey yok. Sadece bir hiçlik var...
    m_Metadata:
      m_Items: []
  - m_Id: 3948884693868544
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 3948884744200192
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 3948884744200193
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 3948884744200194
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195392
    m_Localized: Buraya kadardı.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195393
    m_Localized: Tek başıma hayatta kalmayı başardım.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195394
    m_Localized: Böyle olması gerekiyordu.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195395
    m_Localized: Her şeyi doğru yaptım.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195397
    m_Localized: Peki kaç gün geçti? Kaç saat oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195399
    m_Localized: Birisi yanımda kalsaydı... bir şey değişir miydi?
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195400
    m_Localized: Babama ondan ne kadar nefret ettiğimi söyleseydim evi terk edecek cesareti bulabilir miydim?
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195401
    m_Localized: Peki... karım benimle gurur duyar mıydı?
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195402
    m_Localized: Duvarlar yıkıldı. Artık kaçış yolu yok.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195403
    m_Localized: Fakat belki de kaçmaya gerek yoktur. Belki de her şey bundan ibarettir.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195404
    m_Localized: Bu kadar öfkeyle doluyken ölmek utanç verici.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195405
    m_Localized: Babama, kendime, herkese karşı öfkeliyim.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195406
    m_Localized: Annem yardıma muhtaç olduğunda kimse ona yardım eli uzatmadı.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195407
    m_Localized: O pencereden bakmayı aklımın ucundan bile geçirsem ellerim titriyor.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195408
    m_Localized: Duvarlarım yıkıldı, artık molozların arasında yatıyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195409
    m_Localized: O evden o kadar nefret etmiştim ki... Belki de onu kaybetmek çok da kötü bir şey değildir.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195410
    m_Localized: Toz oldu gitti. Fakat niyeyse kendimi daha özgür hissediyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195411
    m_Localized: Bana eski hayatımı hatırlatacak hiçbir şey kalmadı.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195412
    m_Localized: Keşke karım yaşasaydı da bu günleri görebilseydi...
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195413
    m_Localized: Niye içim rahatladı ki benim?
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195414
    m_Localized: Anlamıyorum... Göğsümdeki ağırlık birden yok oldu, evin duvarları gibi yıkıldı gitti.
    m_Metadata:
      m_Items: []
  - m_Id: 26768690107195415
    m_Localized: Hafifledim.
    m_Metadata:
      m_Items: []
  - m_Id: 38371868175048704
    m_Localized: Her şeyi doğru yaptım...
    m_Metadata:
      m_Items: []
  - m_Id: 38371868175048705
    m_Localized: Annemi iten de oydu.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
