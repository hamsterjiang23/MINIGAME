    m_Localized: سلِّم إشعارًا من الوكالة الفيدرالية
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792067
    m_Localized: سلِّم إشعارًا من الوكالة الفيدرالية
    m_Metadata:
      m_Items: []
