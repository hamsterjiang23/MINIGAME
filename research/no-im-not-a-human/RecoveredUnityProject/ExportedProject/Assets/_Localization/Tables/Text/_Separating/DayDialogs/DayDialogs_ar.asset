%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_ar
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ar
  m_SharedData: {fileID: 11400000, guid: 1bdb57fba89c5124a83ad717d0443512, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: الجو حار جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: كيف تشعر؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: يبدو أن حالتك أسوأ مما توقعت. *يسعل* سحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: لا أعتقد أنني سأصمد لأكثر من أسبوع.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: لكن حين رحبت بي في منزلك، خفت آلامي قليلًا. أشكرك من القلب.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: ولكن... أنا جالس هنا الآن بينما يموت البقية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: كان بإمكاني البقاء معهم. فليس لديّ ما أخسره. أنا على وشك الموت على أي حال...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: الجو حار جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: لمَ لم تذهب إلى منزلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: لديّ أطفال في المنزل. ولا أريد... *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: لا أريدهم أن يخافوني.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: لا أريدهم *يسعل* أن يرونني في هذه الحالة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: من الأفضل أن يعتقدوا أنني مت في الغابة بينما... *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: بينما كنت أساعد في إخماد النيران.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: أود أن يتذكروني بصبري وتحملي وعملي الدؤوب.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: الجو حار جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: أين زيّك
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: أخذه المديرون. *يسعل* لم يعد هناك زي حماية آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: يموت العديد من الناس *يسعل* في عملنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: لا نملك حتى الوقت الكافي لإخراج الجثث من الحرائق. فالحريق *يسعل* يلتهم كل شيء في نهاية المطاف.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: لكن المديرين... يولون اهتمامًا أكبر بـ *يسعل* الزي التافه...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: إنهم يصوغون المراسيم حسب مصالحهم. ولا يوجد واحد منهم يعمل لصالح الناس.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: الجو حار جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: كيف حدثت حرائق الغابات؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: كانت الغابة جافة بشكل خطير مؤخرًا. لذا فهي *يسعل* سهلة الاشتعال.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: الحرائق مجرد *يسعل* مصيبة من المصائب التي حلت علينا، مثل أولئك الزوار القادمين من تحت الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: لكن الأيام لا تزال تخبئ لنا مصائب أخرى...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: ربما نكون في أيامنا الأخيرة، وأفضل ما يمكن أن نأمله هو الموت بسلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: أتعلم... *يسعل* فكرت في أخذ هذه إلى المنزل كهدية. لكنني قررت أن أعطيك إياها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: إنها قلادة. وأعلم أنها ليست بهذا الجمال، ولكنها...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: مصنوعة من النحل الميت الذي كان يومًا ما يحول العسل إلى نجم الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: الجو حار جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: تبدو في حالة مزرية
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: أعتقد أن نهايتي قد اقتربت... *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: لمَ غادرت؟ كان يمكنني إنقاذ بعضهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: كان بإمكاني الصمود... والعمل حتى آخر نفس. حينها ما كانوا ليضطروا إلى إرسال هؤلاء الضحايا لمصيرهم المحتوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: هؤلاء *يسعل* المديرون الأوباش! *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: الأمر مأسوي جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: هل يمكنك إعطائي سيجارة أخيرة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: أخرج سيجارة (أعطه سيجارة)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: هل معك سيجارة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: لا، آسف (لا تعطه سيجارة)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: ليزداد الطين بلة. *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (يخرج الرجل ولاعة من جيبه، ويشعل السيجارة، ويبدأ في التدخين.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (يأخذ نفسًا طويلًا ويميل بظهره إلى الحائط. وبعد توقف قصير، يواصل حديثه.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: أتمنى لو كنت مع رفاقي مرة أخرى. ندخن ونتحدث عن-'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *يسعل* *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: ألا تدخن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: أعلم مدى غرابة الأمر. "رجل إطفاء؟ يدخن؟" *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: لا يوجد فرق الآن على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: أردت فقط أن *يسعل* أسترخي قليلًا قبل أن أموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (يتكئ الرجل على الحائط، وينظر إلى السقف وهو يتحدث.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: كيف انتهى بي الأمر كإطفائي؟ أمي كانت تريدني أن أعمل في مصنع.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: ليس من المفترض أن يدخن الإطفا-'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: أتمنى لو كنت حر الحركة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: عمَن تسأل؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: لديّ صديق أعرفه منذ الطفولة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: ولقد تعرض لحادث.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: وكان موظفًا للتنقيب عن شيء ما في الجبال.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: لا أعرف ماذا كان يفعل بالضبط. وبصراحة، لا يهمني الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: لكنه أصيب في الظهر! ولم يستطع الحركة لعدة أيام!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: لقد عمل جاهدًا في تلك الجبال...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: لدرجة أن طيور النورس ظنت أن... ظهره... كان...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: حسنًا، أقصد مؤخرته، عش لها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: هاهاهاها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: آسف، إنها أصوات في رأسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: وقد أخبرتني بنكتة مضحكة جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: أتمنى لو كنت حر الحركة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: آه... هل أنت بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: نعم. أنا أنتظر أن تنمو ساقاي من جديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: انظر، اليمنى بدأت بالفعل في النمو.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: لذا سأبقى هنا لفترة أطول قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: كنت أقصد الأصوات في رأسك.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: حسنًا...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: لماذا لا تضحك؟ لقد كانت مزحة جيدة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: ظننت أنك ستفهمها على الفور.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: أعتقد أنك لم تستوعبها...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: هل سألتني للتو عن حالتي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: شكرًا، هذا لطف منك!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: لا أحد يسألني أبدًا عن حالتي أو حتى عن كيف كان يومي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: هل ذلك لأنني أمتلك عجلات سيارة سباق أنيقة بدلًا من ساقي القديمتين المملتين؟ هل يشعرون بالغيرة مني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: لا أحد يجيب على هذا السؤال بصدق. هذه هي المشكلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: دائمًا يختلقون الأعذار، قائلين إنهم كانوا يلقون نظرة خاطفة ولم يقصدوا التحديق. إلخ إلخ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: ويزعجني أيضًا عندما يكتفون بالتحديق دون أن ينطقوا بكلمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: لكن تجاهل إعاقتي غباء منهم. أعني، إنها واضحة للأعمى.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: ببساطة، نحتاج إلى التوضيح هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: لكنني لا أعرف أين سنجد أيًا منه هذه الأيام! هاه!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: هل جربت يومًا أن تتخيل كيف ستمشي إذا كنت تود قضاء بعض الوقت المرح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: لا، لم أقصد هذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: ...إذا لم يكن لديك ساقان؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: بالضبط. لن تتمكن حتى من مغادرة منزلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: كيف ستستخدم السلالم؟ أو تعبر الطريق؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: تلك الأرصفة اللعينة أكثر اعوجاجًا من خط متعرج على أكورديون!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: أما منزلك فلا يحتوي على أي سلالم أو درجات، لذا يمكنني التنقل فيه بسهولة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: لكن، بصراحة، لا يزال هناك شيء واحد أتمنى لو كان موجودًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: ...منحدر!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: تخيل الأمر! سباق منحدر على كراسي متحركة! تخيل الاصطدام بالجدران وما إلى ذلك. هاه! لكن لا يهم...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: لا أصدق أنك لم توفر لي أي وسيلة لأستمتع بإثارة السباقات في منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: أوه، لحظة واحدة، لقد سألتني كيف حالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: أبلي حسنًا. شكرًا على سؤالك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: أتمنى لو كنت حر الحركة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: هل أصبت بضربة شمس؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: ما علاقة ذلك بالموضوع؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: لم يتلف شعري أو يتساقط. لذا، أعتقد أنني بخير!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: لا أستطيع التسابق على كرسي متحرك دون ساقين. أتفهم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: أعني، كيف يمكنني أن أبطئ السرعة عند التحرك بسرعة عالية؟ أو أنعطف بحدة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: أنت لا تستخدم كرسيًا متحركًا، لذا لا أتوقع منك أن تفهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: هل تصدق ذلك حقًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: هل تعتقد حقًا أن ساقيك ستنموان من جديد؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: بالطبع!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: كما يقول الناس:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: الساق اليمنى تخطو خطوات أطول. لهذا السبب نحن جميعًا ندور في دوائر وحلقات مفرغة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: انظر، ساقيّ تثبت هذا الكلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: لا مفر من دوائر حياتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: ينتهي هذا اليوم ويبدأ يوم جديد غدًا. ولكن عندما تشرق الشمس، هل سيتغير أي شيء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: لا، بالطبع لا. إنها مجرد دورة أخرى من الهراء!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: لذا، إذا فكرت في الأمر، هل أنت مختلف عني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: كلانا ندور في حلقة مفرغة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: نحن نعيش في عالم من العجائب.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: أعلم أننا لم نرَ سوى الجوانب السيئة حتى الآن، ولكن هناك أجواء أفضل!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: هذه الأهوال لن تدوم إلى الأبد. حيث ستفسح المجال لأفراح عظيمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: لقد غفر الرب بالفعل الكثير من الخطايا. ربما يجهز شيئًا أفضل من أجلنا، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: أتمنى لو كنت حر الحركة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: كيف فقدت ساقيك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: أتذكر صديقي الذي عمل في الجبال الذي أخبرتك عنه؟ صاحب المؤخرة الشبيهة بالعش؟ هاه!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: كان قد قرر حفر خندق في حديقته.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: راودته فكرة غريبة أن نفقًا مليئًا باللحوم يمتد تحت منزله.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: فذهب واشترى لنفسه حفارًا كبيرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: وبدأ في الحفر...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: سحقًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: ربما كانت تلك آخر مرة رأيته فيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: أتمنى لو كنت حر الحركة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: ماذا عن ساقيك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: دعك من ساقي! أريد أن أعرف ما إذا كان قد حفر حتى وصل إلى المكان الذي يريده.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: حسنًا، لا يهم.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: همم... نعم، هكذا انتهت القصة! نسيت أمره وخرجت لشراء مشروب.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: ثم تعثرت في بعض القضبان وقطعت عربة الترام ساقيّ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: لحظة واحدة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: لا، هذا ليس ما حدث.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: لماذا لا تقول شيئًا؟ ألا يهمك كيف فقدت ساقيّ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: حسنًا، لن أخبرك. لا أريد أن أعذبك بالتفاصيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: الجو خانق هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: ألم يكن معكِ طفل؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: ماذا؟ إنه لا يزال معي. ربما ذهب إلى مكان ما...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: أريد أن أعرف أين ذهب أطفالي الآخرون...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: هل لديك هاتف؟ يمكنني الاتصال بوالدهم. بهذه الطريقة لن أضطر إلى رؤية وجهه القبيح مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: الجو خانق هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: هل اتصلتِ بزوجكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: ولماذا أفعل ذلك؟ سيختلق عذرًا ما. لم يحرك ساكنًا طوال حياته. كل شيء كان على عاتقي: الأطفال، والمنزل، والفواتير.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: أحيانًا أعتقد أننا كنا نحتمل بعضنا البعض على مضض. لكنه لم يتركني أبدًا، لسبب ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: ربما كنت سهلة المنال. أو ربما كان يخشى أن أقتله إذا حاول ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: أنا متعبة جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: الجو خانق هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: هل ذهبتِ لرؤية زوجكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: بالكاد أستطيع النهوض من السرير! جسدي يؤلمني وأنا مرهقة للغاية. أعرف أنني لا أزال على قيد الحياة فقط بدافع الحقد والغل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: كل شيء كان على عاتقي. الأطفال، وزوجي، والمنزل بأكمله. لكنه أحيانًا كان يفعل أشياء تجعل علاقتنا مقبولة بعض الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: هل يمكننا التحدث لاحقًا؟ أحتاج إلى الراحة، أشعر أنني على وشك أن أفقد وعيي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: الجو خانق هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: ما الأشياء التي فعلها؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: أتذكر ذات مرة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: كان يقود سيارته ليقل هذه المرأة. كنت أعرف ما يجري بينهما. وتحملت الأمر في البداية، لكنني لم أستطع البقاء صامتة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: لقد تذمرت وأزعجته... حتى قرر تغيير وظيفته حتى لا يراها بعدها. ...ربما كان يحبني حقًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: أو ربما كل هذا من خيالي... على أي حال، أحتاج إلى الراحة. يمكننا التحدث لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: الجو خانق هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: ألستِ قلقة بشأن ما قد يجري لأطفالكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: ممم... لكن ربما ليس بالقدر الذي ينبغي. عندما فقدت الأول... لم أكن أعرف كيف أتصرف. كأنني أفسدت كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: ظننت أنني فهمت كل شيء قبل فقدان الثاني. لكن تبين أنه كحال الأول. ثم الثالث والرابع...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: أخبرني الأطباء أنني لا أستطيع إنجاب أطفال. عندما جاء الطفل الثاني، أطلقت عليه اسم "الأعجوبة الثامنة في العالم"!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: ولكن بعد ذلك... أصبحت الأمور صعبة. كان الأمر فظيعًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: أنا... أحتاج إلى الراحة قليلًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: الجو خانق هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: كيف كان الأمر فظيعًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: يصعب عليّ التحدث عن ذلك. أنا أحبهم، لكن... أحيانًا، أفقد أعصابي. أصرخ، بل وأضربهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: أعلم أن هذا فظيع. وأنا نادمة على كل شيء، حقًا... لكن، الآن، ولأول مرة، أشعر أن الأمور أصبحت أسهل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: فمن دونهم، أشعر أنني أستطيع التنفس... أكره أن أقول ذلك، لكنني أشعر أخيرًا... بالسعادة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: عبث وهراء...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: هل هدأت بعض الشيء؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: نعم، أنا أهدأ بسرعة. ولكن بمجرد أن أتذكر شيئًا يزعجني، يعود غضبي مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: كنت أكثر تساهلًا في الماضي. كان من الصعب إهانتي أو إثارة غضبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: أما الآن، كل ما يتطلبه الأمر هو شرارة صغيرة ليشتعل غضبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: ولماذا يجب أن أبقى هادئًا على أي حال؟ ربما يساعدني غضبي على الحفاظ على صوابي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: على الأقل لا أقدس الشمس مثل هؤلاء الأغبياء الحمقى.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: هل يعتقدون أن الشمس ستنقذنا؟ كفى هراءً! إنها تقتلنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: من وجهة نظري، نحن جميعًا على بعد مليمترات من الانقراض.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: لكن هل يفهم هؤلاء الأوغاد ذلك؟ بالطبع لا! جسنًا... أنا بخير، أنا هادئ. لقد انتهيت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: شكرًا على سعة صدرك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: عبث وهراء...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: ما سبب كل هذا الغضب؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: أنا نفسي لا أعلم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: كل شيء يدور حولي يغضبني.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: خاصة أتباع الطوائف، هؤلاء الأوغاد الكاذبون الفاشلون. إنهم يحاولون خداع أكبر عدد ممكن من الناس.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: والناس يصدقون أكاذيبهم كالبهائم التي لا تفعل شيئًا سوى أكل البرسيم وترك الفضلات.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: الأمهات المستعدات لانتزاع أيدي أطفالهن من أجل تقديمها كقربان.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: كل ذلك لإرضاء منقذ ما خيالي لا أحد يعرف من أين أتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: مجانين أغبياء. إنهم حتى يغسلون أدمغة الناس العاديين بأحاديثهم الوهمية... مثل...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: على أي حال، لقد هدأت كثيرًا. أشعر بتحسن الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: عبث وهراء...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: هل سلبك أتباع الطائفة شخصًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: لا، هذا هو بيت القصيد. لقد ذهبت إليهم بنفسها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: إنها زوجتي...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: حتى قبل كل هذه الفوضى، كانت متدينة للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: كنت أحبها، ورضيت بذلك. لم يعيق ذلك علاقتنا إطلاقًا، ولم يعيق أي شيء في حياتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: لكن عندما وقعت الكارثة، وجدت معتقدًا جديدًا ومخلّصًا جديدًا للبشر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: بدت لها خطابات أتباع الطائفة المجنونة منطقية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: وكانت تنجذب لهم أكثر كل يوم، حتى جن جنونها تمامًا. كانت تؤمن تمامًا بكل الهراءات غير المنطقية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: ...عندما أدركت ما فعلت، كانت قد رحلت بالفعل. لقد أخفتها. كان الوقت قد فات لتغيير أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: عبث وهراء...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: ماذا حدث بينك وبين زوجتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: ذات يوم، أخبرتني زوجتي أنها ستنضم إلى الطائفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: أنا... لم أستطع تصديق ذلك. المرأة التي أحببتها... أصبحت شخصًا مختلفًا تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: كان الأمر كما لو أن كل ما كان بيننا لم يكن يعني لها شيئًا. كنت غاضبًا أكثر من أي وقت مضى في حياتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: بدأت أظن أنها لم تحبني قط، بل كانت تبحث عن طريقة للهروب. وهذا جعلني أشعر بغضب وحزن شديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: كان الأمر كما لو أن يديّ تمتلكان عقلًا خاصًا بهما. فقد تشكلتا على شكل قبضة، وفعلت شيئًا لن أسامح نفسي عليه أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: ضربتها...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: لا يمكن إصلاح الأمور الآن. إنها تتبع الطائفة، وأنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: لا يمكنني أبدًا أن أتعايش مع ما حدث...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: سحقًا، أنا أكره نفسي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: عليّ أن أؤذي نفسي بدلًا من إيذاء من حولي. فأنا أستحق ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: ابتعد عني. أريد أن أنفرد بنفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: همم؟ هل تريد قراءة طالعك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: كيف تعرفين كل هذا عني؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: ها! يا له من سؤال سخيف... أنا لست من يعرف، أنا مجرد مبعوثة. النجوم تتكلم من خلالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: القمر والزهرة متقاربان في البيت السادس. هذا واضح على وجهك. لا داعي لأن تقول شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: كنت أعرف شخصًا مثلك ذات مرة. كان دائمًا يستمع، لكنه لم يتكلم قط.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: أنت تعرف ما يقولون: إذا كان كوكب المشتري في البيت الثامن، فمن الأفضل أن تلتزم الصمت. فهذه علامة على الأبواب المغلقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: همم؟ هل تريد قراءة طالعك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: وماذا حدث لذلك الرجل؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: قلت له: "لا يهم ما تفعله. المهم هو لون هالتك أثناء قيامك بذلك." لكنه شكك في كلامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: وهكذا مرت حياته دون أن يعيشها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: ذات يوم، أغمضت عيني وتخيلت أنني أحقق أحلامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: لقد استخدمت كل طاقتي الكونية في تلك الصورة في رأسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: إذا لم تفتح قلبك لطاقة الكون، فلماذا تعيش في جسدك أصلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: يمكنك أن تفعل الشيء نفسه. أغمض عينيك...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: تخيل أن أحلامك الأكثر جنونًا قد تحققت جميعها...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: ركز على الرؤيا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: أتعرف لماذا تعاني؟ ما زلت لا تفهم أن المعاناة هي أسمى أشكال السعادة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: أخبرني إذن... هل أنت مستعد للخطوة التالية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: همم؟ هل تريد قراءة طالعك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: ما هي "الخطوة التالية"؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: إنها اختيار نفسك. هل تشم هذه الرائحة؟ إنها الرائحة الكريهة لأحلامك التي ماتت منذ زمن طويل. حان وقت إحيائها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: عندما كنت في أسوأ حالاتي، بلا أمل أو معنى للعيش، قالت لي معلمتي شيئًا واحدًا: "أنتِ لا تستمعين إلى محيطكِ".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: في البداية ضحكت على كلامها، ثم أغمضت عيني وسمعت محيطي. كما لو كان موجودًا طوال الوقت. يمكنك سماعه أيضًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: ولكن أولًا، هناك سؤال يحتاج إلى إجابة: هل أنت مستعد لتتكامل مع روحك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: هممم؟ هل تريد قراءة طالعك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: مَن هي معلمتكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: امرأة عظيمة. كانت مثل طوق النجاة وسط البحر. وعلمتني أن أرى جوهر كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: لن أنسى أبدًا كلماتها: "الناس يموتون فقط لأنهم لا يتعلمون كيف يتنفسون نورهم الداخلي".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: لقد فتحت عينيّ، وفجأة أدركت أنني أستطيع توجيه الناس إلى مسارات حياتهم الفريدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: لكنها كانت خائفة من التعمق في ذاتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: عجزت عن رؤية نفسها في صميم الأحداث، رغم أن هذا هو المكان الذي يليق بها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: إن لم تكن أنت قلب كينونتك، فمن؟ أنت تعي ما أرمي إليه، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: هممم؟ هل تريد قراءة طالعك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: كيف ساعدتِ نفسكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: في كل خطأ نرتكبه حكمة مشفرة عن عالمنا الداخلي، تنتظر الاكتشاف.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: الطريق كان طويلًا ومتعرجًا. ولما نظرت حولي وإلى ما خلفي، فهمت كيف احتضن هذا البيت وجودي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: إنه مبهج وواسع ومتناغم مع طاقتي. لا داعي لأن تحاول أن تقاوم طاقة منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: لقد امتص خوفك بالفعل، ألا ترى ذلك؟ تقبّل طاقته، وإلا ستبكي جدرانه. ولكن الدموع ستكون دموعك أنت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: هممم؟ هل تريد قراءة طالعك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: ماذا تريدين مني؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: يا للعجب، هل تعتقد أنني أريد شيئًا منك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: في رقصة ظلك يكمن سر طريقك المستور.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: ما عليك سوى قول عبارات مبهجة. يمكنك أن تشعر بأن كل شيء يتغير، أليس كذلك؟ التنفس أصبح أسهل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: هذه طاقتي تتفاعل مع محيطك. لا تبحث عن معنى أعمق. تخلّ عن الوهم وأطلق العنان للفوضى.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: أطلب منك ببساطة أن تنضم إلي. كن المحيط والمساحة. قل: "أنا لست ضيفًا هنا. أنا صانع هذا الملاذ".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: هممم؟ هل تريد قراءة طالعك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: ماذا لو لم أرغب في أن أكون صانع أي شيء؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: هذه الجدران تتوق إلى التناغم معك، لكنك تقيدها بسلاسل سلطتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: الصمت بداخلك هو صوت العالم الذي تخنقه بخوفك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: طاقتك متجمدة كحال العسل في الشتاء. يجب أن تذيبها بأنفاسك. المرايا لا تكذب أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: إذا كان كل ما تراه هو نفسك، فأنت لا ترى شيئًا على الإطلاق. كل ما عليك فعله هو تحريك طاقتك ثلاث درجات إلى اليمين.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: وبذلك ستعرف السعادة أخيرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: أنا منصت أيها البشري، تحدث!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: هل تتبع معتقدًا بعينه؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: نعم، أيها البشري! لكن معتقدي لا يشبه المعتقدات التي تعرفها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: أنا أؤمن بالشمس المقدسة نفسها! لأنها تحمينا وتحبنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: لكن الأغبياء وأتباع الأوهام لا يرون فيها سوى تهديد. يظنون أنها "ستحرقنا جميعًا"...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: هذا هراء! غضبها العادل موجه حصريًا إلى القلوب التي تحمل الشر والهرطقة! لأنهم هم المذنبون الحقيقيون.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: عسى ألا يجد أولئك الذين يختلفون معنا أنفسهم تحت أشعة الخلاص المتقدة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: إنهم يبحثون عن النيران ويفاجئون عندما يجدون أنفسهم محروقين.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: القلوب التي تحمل الشر؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: الهرطقة؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: ألا تزال لا تعرف؟ ألم تقابل الفضائيين وجهًا لوجه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: حسنًا، أيها البشري البائس. سأفتح عينيك على الحقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: الزوار هم القلوب التي تحمل الشر!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: إنهم أحفاد الفضائيين الذين هبطوا على الأرض عندما كانت الشمس أصغر سنًا والعشب أكثر خضرة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: إنهم التابعون الذين بنوا بيوتهم على الأرض وتزاوجوا فيما بينهم لقرون!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: والآن خرجوا من الأعماق ويريدون الاستيلاء على أراضينا وكأنها ملكهم!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: لكن الشمس قررت حمايتنا، لأن هذه أرضنا المقدسة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: الشمس لا ترحم المهرطقين! وإلا لماذا اختبؤوا تحت الأرض كل هذا الوقت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: يا رجل... لماذا ثملتَ إلى هذا الحد في تلك الليلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: لم يكن عليك أن تشرب حتى تفقد وعيك. غضب الشمس المقدسة العادل، إنه...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: أيتها الشمس المقدسة، سامحيه، فهو لا يدري ما فعل!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: ضميه واحميه. وضميه إلى روح شجرة التين، التي ستبقى إلى الأبد دون سقي...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: أحبيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: ما سمعته صحيحًا أيها البشري!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: الوكالة الفيدرالية كلها مهرطقون!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: إنهم يتدخلون في أمور خارجة عن سيطرتنا — سيطرة الناس العاديين!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: إنهم يتدخلون في شؤون لا تعنيهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: عسى أن تحرق الشمس الأوغاد الذين ألقوا بأمي في تلك البركة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: أنا منصت أيها البشري، تحدث!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: في الواقع، حرقت الشمس الكثير من الناس بطريقة ما
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: أنت محق. وكلهم يمتلكون قلوبًا شريرة أيها البشري!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: قررت الشمس المقدسة معاقبتهم جميعًا على خطايا ألف عام!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: وقد بدأ الزوار الضالين في التضرع إلى الشمس!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: لكن الشمس ليست لهم! لا! ليست لسكان الجوف القذرين... بل لنا، نحن البشر!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: إنها لنا ومعنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: إنها نعمة للبشرية ويجب تقديسها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: كم عدد الأشخاص الواجب حرقهم لإرضاء الشمس؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: هل تقصد أن نهاية العالم هي العدالة التي تنفذها الشمس؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: الكثيرون.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: وصدقني يا صديقي، هذا الأمر لم ينتهِ بعد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: لقد بدأ الحساب للتو!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: وزن رمادنا على ميزان الخطايا لم يرجح بعد كفة الميزان ضد قوى الكون!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: يجب أن يحترق المزيد في نيران الشمس العادلة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: لكن كن على ثقة يا صديقي: هؤلاء الشهداء لن يموتوا سدى!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: يومًا ما، سنفهم جميعًا الخطة الحقيقية للشمس...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: اللعنة... أحيانًا في الليل، أشعر أن زوجتي ستتركني مرة أخرى...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: كانت امرأة تقية للغاية...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: ...لكن خرقاء جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: نهاية مَن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: نهايتنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: ها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: نكتة لطيفة. الشمس في صفنا يا هذا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: إنها منقذتنا، ألا تفهم ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: إنها تحاول إعادة الزوار إلى تحت الأرض...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: إنها تعاقب الضالين الأشرار على خطايا البشرية المتراكمة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: وتفضح المهرطقين في ثيابهم البالية الملطخة بالبول، وهم يختبئون وراء أقنعة خادعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: لذا يجب أن نشكر الشمس، بدلًا من أن نبكي كالأطفال على "نهاية العالم".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: هذه هي النهاية الحتمية لجميع أعداء الشمس العظيمة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: الموت لسكان القاذورات! الموت للزنادقة الملطخين بالبراز! الموت لمن يحملون في قلوبهم الشر!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: اللعنة، قد أفعل أي شيء مقابل الحصول على بعض البطاطس المقلية...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: أنا منصت أيها البشري، تحدث!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: هل تعتقد أن ما يحدث له معنى مقدس؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: أخبرني أيها البشري... لماذا شرحت لك كل هذا، وأعطيتك كل التفاصيل الصغيرة...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: لتطرح عليّ السؤال الغبي نفسه!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: يبدو أنني كنت مخطئًا بشأنك. شعاع الشمس لا يحميك... لا يمكنك فهم جوهر ما يجول في خلدنا على الإطلاق...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: سحقًا يا رجل، سأضحي بأي شيء مقابل مشروب مثلج...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: ألديك أي مشروب بارد أيها البشري؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: بالطبع، تفضل (أعطه علبة جعة)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: ليس لديك أي شيء؟ هل تعتقد أنني غبي أيها البشري؟!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: لقد رأيت ما بداخل ثلاجتك بأم عيني!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: بحقك يا رجل. تشرب كل هذه الجعة ولا تعطي الآخرين حتى علبة واحدة!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: لا (لا تعطه جعة)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: آآه، وأخيرًا سأرتوي...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: ممم، لذيذة. جعة داكنة، المفضلة لديّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: تذكرني بالأيام التي قضيتها مع أصدقائي في الحانة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: كنا نحظى بوقت رائع، كؤوس جعة باردة، وبعض الوجبات الخفيفة والصلصات...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: ووجه ذلك الرجل النحيف المتجهم الذي كان دائمًا يحدق بنا بامتعاض...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: حسنًا، لا داعي للانزعاج. قد تكون غبيًا أيها البشري، لكنك على الأقل طيب القلب.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: دعني أهديك هدية شكر صغيرة. خذ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: عسى أن ترحم الشمس المقدسة روحك!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: أيها المختل الغبي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: آمل أن تحترق في النار أيها المعتوه!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: يا للجحود، لقد شرحت لك التعاليم المقدسة، وأهمية كل ما يحدث، ومع ذلك أنت...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: أنت مغفل أيها البشري! وشرير أيضًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: سحقًا لك. لن أهتم إذا تعفنت في هذا الكوخ! أنا ذاهب إلى مكان أفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: سترى. أراهنك أنهم سيسمحون لي بالعودة إلى الحانة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: طاب يومك أيها الحيوان.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: هيه هيه. آمل أن ينتهي كل هذا قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: كيف خسرتِ بيتكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: آه... أتذكر ذلك وكأنه حدث بالأمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: لقد تم طردي من العمل حينها. كل ما أردته هو العودة إلى المنزل، والاستلقاء على السرير، والبكاء حتى تغرق عيناي بالدموع.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: لكن عندما وصلت إلى هناك، رأيت مجموعة أحذية. ظننت أن زميلتي في السكن قد استقبلت بعض الأصدقاء أو شيء من هذا القبيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: لذا صعدت إلى غرفتها لأعرف ماذا كانت تفعل. ولكن عندما اقتربت، بدأت أسمع صوتًا غريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: لقد أخافني نوعًا ما. لكنني قررت أن ألقي نظرة خاطفة بهدوء لأرى ما يحدث.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: لم أتمكن إلا من إلقاء نظرة خاطفة على زميلتي في الغرفة وهي مستلقية بلا حراك على السرير، وفجأة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: أمسكني رجل قذر من الخلف وقال: "لا يمكنك الدخول هنا. إنها... ليست على ما يرام".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: تعالي واجلسي في المطبخ. ثم سحبني بسرعة وأجلسني على الطاولة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: أردت أن أرحل، لكنني كنت شبه مشلولة من الخوف... ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: قام بـ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: أحتاج إلى الاستلقاء قليلًا. أنا... معدتي تؤلمني... آه...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: هيه هيه. آمل أن ينتهي كل هذا قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: ماذا حدث بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: آه...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: بعد أن أجلسني الرجل على طاولة المطبخ، خرج رجل آخر ضخم من الزاوية وسد المخرج.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: وبدأ يتحدث بصوت عالٍ مع الرجل الذي أمسك بي من البداية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: كانا يتصرفان وكأنني... وكأنني لست موجودة. ثم... بدآ بلمسي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: أولًا من ذراعاي، ثم كتفاي...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: وفي الخلفية، سمعت هتافات وضحكات بدت وكأنها قادمة من غرفتي...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: بدا وكأن هناك جمهورًا كبيرًا من الرجال في الداخل يشجعون. هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: لم... لم أستطع التنفس. شعرت وكأن قلبي على وشك أن ينفجر في صدري من الرعب...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: أردت أن أصرخ أو أطلب النجدة، لكن... صوتي ضاع من شدة الخوف. لم أستطع حتى إصدار أي صوت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: جلست متجمدة في مكاني، عاجزة... مثل غزالة أمام مفترسها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: ثم ذهب الرجل الضخم إلى الثلاجة ليحضر شيئًا. أدركت أن هذه هي فرصتي...! هيه!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: ركضت بسرعة نحو المخرج. حيث كان خوفي يمنحني القوة. وركضت وركضت... ولم أنظر خلفي قط.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: ركضت حتى تعبت وسقطت...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: لمَ لم تحرقكِ الشمس؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: ماذا حدث بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: لا أتذكر...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: لا بد أنني قضيت الليل كله مستلقية على الأرض، ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: هذا غريب... كنت أعتقد أنني أتذكر كل ما حدث لي في ذلك اليوم...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: لحظة واحدة، أنت لا تظن أنني...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: أنني...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: أتعتقد أنني زائرة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: لا، هذا لا يمكن أن يكون صحيحًا! أنا... أنا أتذكر كل حياتي. طفولتي، وأمي وأبي. لا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: أنا لست زائرة، أليس كذلك؟ أجبني! أخبرني بأنني لست زائرة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: لا أعرف
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: لستِ زائرة
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: يبدو أنكِ زائرة
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: كنت مستلقية على الأرض، ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: كنت أعتقد أنني أتذكر كل ما حدث في ذلك اليوم...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: لحظة واحدة، أنت لا تظن أنني...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: أنني...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: أتعتقد أنني زائرة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: لا، هذا لا يمكن أن يكون صحيحًا! فأنا أتذكر كل حياتي. طفولتي، وأمي وأبي. لا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: أنا لست زائرة، أليس كذلك!؟ أجبني! أخبرني بأنني لست زائرة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: لا أعرف
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: لستِ زائرة
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: يبدو أنكِ زائرة
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: لماذا تقول ذلك!؟ هاها! يا إلهي، يا إلهي، يا إلهي، يا إلهي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: أحتاج إلى الاستلقاء قليلًا. معدتي تقتلني من الألم... آه...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: شكرًا، هذا يشعرني بتحسن.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: أحتاج إلى الاستلقاء قليلًا. معدتي متقلبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: لماذا تقول ذلك!؟ هاها! الآن أصبحت خائفة أكثر!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: لا أريد أن أموت! لا أريد، لا أريد، لا أريد، لا أريد، لا أريد!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: أعتقد أننا جميعًا سنموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: هيه هيه. آمل أن ينتهي كل هذا قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: هل أنتِ بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: لا تقترب مني!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: آسفة، لقد... اعتقدت أنك ستقتلني.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: ما سبب هذا الاعتقاد؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: لو كنت أريد قتلكِ، لكنت فعلت ذلك منذ زمن طويل.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: أنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: لا يمكنني التمييز بين الزائر وغير الزائر... ماذا لو...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: ماذا لو كنت أنت زائرًا!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: هل ستقتلني؟ هل ستسلخني حية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: أرجوك، لا! اقتلني بسرعة وبلا ألم!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: لا أريد أن أموت في عذاب! أرجوك!!! هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: اهدئي، لستُ زائرًا
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: لن أقتلكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: آسفة، أنا، أمم، متوترة جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: لا أعرف مَن يمكنني الوثوق به.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: وماذا لو...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: ماذا لو كنت أنت زائرًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: هل ستقتلني؟ هل ستسلخني حية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: أرجوك، لا! اقتلني بسرعة وبلا ألم!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: لا أريد أن أموت في عذاب! أرجوك!!! هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: اهدئي، لستُ زائرًا
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: لن أقتلكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: كيف يمكنني أن أتأكد!؟ أنا... أنا لم أفحص أسنانك أو عينيك... هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: سنموت جميعًا... المسألة فقط هي من سيقضي علينا أولًا، الشمس أم الزوار...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: لم يعد هناك أمل. الموت حتمي، مهما فعلنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: أريد الانفراد بنفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: كيف يمكنني أن أتأكد!؟ أنا... أنا لم أفحص أسنانك أو عينيك...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: سنموت جميعًا... المسألة فقط هي من سيقضي علينا أولًا، الشمس أم الزوار...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: لم يعد هناك أمل. الموت حتمي، مهما فعلنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: أريد الانفراد بنفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: هيه هيه. آمل أن ينتهي كل هذا قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: ما خطبكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: الزوار! إنهم قادمون للقضاء علينا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: ألا تسمع صوت الموت؟ إنه ينادينا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: زائر أم بشري... ما الفرق!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: الموت لا يفرق بيننا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: فلماذا نعذب أنفسنا بالانتظار؟ دعهم يأتون! هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: إنهم يريدون الأفضل لنا! فليأت الزوار!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: لا تبدين في حال جيدة
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: هل جننتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: لا! بل رأيت الحقيقة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: أنا زائرة! هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: نحن والبشر واحد. مجرد انعكاسات! مرايا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: نحن واحد!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: ومعًا سنرحب بالموت!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: أتدركين مدى جنون كلامكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: لم تتركي لي خيارًا آخر
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: لست مجنونة... لقد رأيت الحقيقة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: أنا زائرة! هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: نحن والبشر واحد. مجرد انعكاسات! مرايا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: نحن واحد!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: ومعًا سنرحب بالموت! إنه قادم لنا جميعًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: أتدركين مدى جنون كلامكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: لم تتركي لي خيارًا آخر
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: لا، أنت لا تفهم شيئًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: النهاية تقترب! الشمس بدأت نهايتنا جميعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: سنلتقي قريبًا. قريبًا جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: أطلق النار! أطلق النار! ماذا تنتظر!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: هل ستقتلني دون أدنى ذرة من الندم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: لا يهمني! هاهاها! افعل ما يجب عليك فعله أيها البشري!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: أطلق النار عليها
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: نعم؟ هل هناك شيء تريده؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: لماذا طردوك من الحانة؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: هممم. ألقي اللوم على الكوارث التي دمرت عقول الجميع.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: الشمس التي على وشك الانفجار، ووصول الزوار، والأزمة الاقتصادية، وما إلى ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: لقد أفسد ذلك حياتنا جميعًا. انهار البعض تحت وطأة الضغوطات. وجن جنون البعض الآخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: بالنسبة لي؟ كان الغضب ما دفعني للجنون.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: انفجرت غضبًا، وصحت في جميع من في الحانة وصرخت قائلًا: "توقفوا عن إلقاء اللوم على كل شيء إلا أنفسكم!"'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: دعهم يبكون. الدموع في رغاوي الجعة لا تفسدها. الشعير طعمه أفضل مع الملح على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: لا أحد يقدّر ذلك، فلماذا نهتم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: نعم؟ هل هناك شيء تريده؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: هل أصبحت الأمور أفضل هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: لم أعد أهتم بعد الآن، فالأمر لا يستحق.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: لكن حين أسمع أصواتًا في التلفاز أو ألتقط أطراف أحاديث من حولي، تدور الأفكار في عقلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: ...ثم أُوقف نفسي، فالأمر يضيع جهدًا كبيرًا بلا أي طائل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: لا، سئمت كل هذا. أعصابي وعقلي تلفا تمامًا بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: كانت الحياة كئيبة بما فيه الكفاية قبل كل هذا، أما الآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: يومًا ما، سأتدلّى من النجفة فوق هذا العالم المريض بأسره.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: نعم؟ هل هناك شيء تريده؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: هل أنت بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: هممم؟ لمَ تسأل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: رائحتك غريبة
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: هل أصبت بالحمّى؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: حسنًا... لقد شربتُ بعضًا من جعتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: لم أكن أشعر بأنني بخير، فقررت أن أُداوي نفسي بمشروب بارد لذيذ. لا عيب في ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: نحن في وضع مزرٍ تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: الجميع يقولون إنهم يحاولون فهم الأمور وحلّ المشكلات، لكن كل ذلك هراء. لا شيء يتغيّر أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: أتعلم يا صديقي العزيز، أعتقد أننا جميعًا سنموت قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: إن لم تقتلنا الشمس، فسيقتلنا الزوار. وإن هزمنا الزوار، فسندفن أنفسنا أحياء لا محالة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: حين تُحل مشكلة ما، تُخلّف وراءها فراغًا. فنقوم بابتكار مشكلة جديدة لملئه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: وكأنه هوس لا نهائيّ بأن نُفسد على أنفسنا كل شيء، مرارًا وبشكلٍ جماعي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: سحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: دعني وشأني. أشعر بالسوء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: لست أنا من يعاني الحمّى، بل الكوكب اللعين بأسره.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: أينما نظرت، ستجد هناك من يحتضر والأنهار الجليدية تذوب والغابات تشتعل. العالم بأسره يحترق.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: الكوكب يحاول أن يتخلّص منا كما يتخلّص الكلب من القراد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: سيأتي يوم ينجح فيه... ولا تعتقد للحظةٍ أنّ ذلك سيكون بلا ألم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: آآخخ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: اغرب عن وجهي. أرجوك. أنا في حال سيئة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: نعم؟ هل هناك شيء تريده؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: أتشعر بأي تحسن؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: صديقي العزيز...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: سنموت جميعًا يومًا ما، تلك حقيقة لا مفرّ منها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: برأيك، ماذا يحدث لنا بعد الموت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: إيماننا سيقودنا إلى النعيم الأبديّ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: لا شيء
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: لا أعرف... ربما سنطفو في الفضاء الشاسع
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: في ذلك شيء من الحقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: لكن ذلك لا يجعلني أشعر بأي تحسّن، أتدري لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: عقلي سيتشبّث بتلك الفكرة حين أكون على شفا الموت، وسيُريني مشاهد من نعيم ما من وحيه... مكانًا أجمل من هذا العالم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: ولكن حين تخور قواي ولا أستطيع التمسك بذلك الحلم الهش، فماذا بعد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: لا. هذا لا يجعلني أشعر بتحسن.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: كنتُ آمل حقًا أن تقول شيئًا آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: ربما تكون محقًا، بالطبع... لكن ما تقوله يبدو حزينًا إلى حد مؤلم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: ألا يوجد أي شيء في النهاية، بعد كل هذا... لا شيء سوى الظلام...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: لا أود التحدث لأكثر من ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: إذا فكرت في الأمر...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: لابد أننا وحدنا تمامًا في هذا الكون.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: من المؤكد أنه لا وجود لأي حياة أخرى... مجرد فراغ بارد خالٍ من كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: لو كانت هناك حياة أخرى، لالتقطنا إشارةً ما أو رأينا علامة تدلّ عليها، أليس كذلك؟ لا أدري...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: فراغ مظلم لا نهاية له... الوصول إلى هناك سيكون كما لو أنك تتلاشى تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: أنا... أريد الانفراد بنفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: نعم؟ هل هناك شيء تريده؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: هل أنت... بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: على الأقل كان سقف الحانة عاليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: يمكنك أن تشنق نفسك منه بسهولة، دون أي صعوبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: هذا المكان ضيّق عليّ، بل إن هذا الكوكب بأسره أصبح ضيقًا عليّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: يا صديقي العزيز، لا أريد سوى أن ينتهي كل هذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: كل شيء في حال يُرثى لها، والعالم كله يرعبني إلى أقصى حد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: لم أعد أحتمل أكثر من ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: ولماذا جئتُ إلى هنا أصلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: أحتاج إلى بعض الراحة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: أتحتاجين إلى أي شيء؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: أحتاج إليه حيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: هذا كل ما في الأمر...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: هذا كل ما أحتاج إليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: هل أحضر لكِ بعض الماء؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: أتريدين بعض الطعام؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: سأ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: سأجلس هنا بجانب الصنبور.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: سأشرب منه إن عطشت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: سأدعكِ وشأنكِ إذن
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: هل يمكنني الجلوس معكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: لستُ جائعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: أنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: أريد الجلوس وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: سأدعكِ وشأنكِ إذن
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: هل يمكنني الجلوس معكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: لماذا قررت الذهاب واختيار الموت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: لقد وعدتني بأن كل شيء سيكون على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: قلتَ لي إن كل شيء سيتحسّن مع الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: ثم مُت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: وتركتني وحيدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: لماذا تركتني هكذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: لا أريد سواه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: ولن تستطيع أن تعيده إليّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: لا أستطيع...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: دفنه حتى...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: لا أستطيع دفنه حتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: ماذا يُفترض أن أفعل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: أحتاج إلى بعض الراحة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: كيف مات؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: لقد... لا أستطيع...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: الأمر صعب للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: لقد جفّت دموعي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: لم تعد هناك دموع لأبكي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: لكن هذا خطأ... كلّه خطأ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: لا أستطيع التوقف عن البكاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: يجب دفنه
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: لقد مات زوجكِ وعليكِ تقبل الأمر الواقع
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: لا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: لا، لا، لا، لا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: لستُ مستعدة لذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: لقد أعادوه إليّ للتوّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: وتتوقع أن نفترق مجددًا بهذه السرعة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: لا أستطيع.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: لن أدفنه في الأرض الباردة القاسية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: أنت مخطئ، هذا ليس صحيحًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: إنه لا يزال يسمعني.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: أنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: لديّ الإيمان بأنه يستطيع ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: أحتاج إلى بعض الراحة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: ماذا تتذكّرين عنه؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: كنا في منزل أصدقائنا ذات يوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: كنا أصغر سنًا آنذاك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: كنا جميعًا مجتمعين نتسلّى ونشرب، وكان غالبًا ما يكون متقلب المزاج. لم يكن يتحدث كثيرًا في مثل هذه التجمعات.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: وقد شربنا كثيرًا في ذلك اليوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: وفي لحظة كان هادئًا كعادته، وفجأة قال:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: "أعطوني غيتارًا، سأغني أغنية."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: وعزف بشكل رائع جدًا. لقد أحببت عزفه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: بدأ أصدقاؤنا يطلبون منه أغاني أخرى ليعزفها، لكنه جلس للحظة، ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: نهض وقال إنه مضطر للرحيل. وأسقط كوبًا، حاول الإمساك به، ثم أسقط الغيتار...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: اكتشفت لاحقًا أنه تعلّم تلك الأغنية فقط ليبهرني.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: ما زلت أحتفظ بصورة لنا من تلك الليلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: لقد شهدت أيامًا أفضل، مثلنا تمامًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: الآن لم يعد بإمكانك العزف لي. لقد غنّيت لي أغنيتك الأخيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: أحتاج إلى بعض الراحة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: ماذا حدث له بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: لقد مات.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: تمام. أعتذر عن تذكيركِ به
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: لستُ قاتله
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: آسفة، أشعر...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: الدموع تنهمر كل ليلة، ولا أستطيع إيقافها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: أريد ممن تسببوا في كل ما حدث أن تُحرقهم الشمس أحياء أكثر من أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: ماذا حدث له إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: لن أسألكِ عن ذلك مرة أخرى
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: أعرف ذلك. أنت محق.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: تحدثتُ بأسلوب فظ. من الصعب جدًا عليّ أن أتحدث عنه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: آمل أن ينال هؤلاء الأوغاد جزاءهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: أتمنى أن يمزقهم أحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: ماذا حدث له إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: لن أسألكِ عن ذلك مرة أخرى
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: لم يكن زوجي يشعر بحال جيدة. فذهب إلى المستشفى، لكنهم أرسلوه بعيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: أخبَرونا أن نذهب إلى المركز الجديد الذي افتتحته الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: كل ما فعلوه هو وضعه في حجر صحي، وأخذوا هاتفه، وقالوا إنهم سيطلقون سراحه بعد ثلاثة أسابيع.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: ذهبت إلى هناك مبكرًا ذات مرة فقط لأطمئن عليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: هؤلاء الأوغاد، لقد...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: لحظة واحدة من فضلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: قالوا لي "لقد مات."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: بهذه البساطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: لم يسمحوا لي برؤية جثته.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: لم يسمحوا لي باصطحاب جثته إلى بيته.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: لكن هؤلاء المغفلون بالكاد يعرفون ربط حذائهم. لذا كل ما كان عليّ فعله هو ارتداء معطف المختبر والدخول إلى المشرحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: ورأيته...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: كان في المشرحة بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: لقد قتلوه، ودمه في رقبتهم. كل ما أستطيع فعله الآن هو التعبير عن غضبي ولم أعد أشعر بأي شفقة تجاه الآخرين.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: أود الانفراد بنفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: نعم. من فضلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: لا أظن أنني سأعيش من دونه...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: أحتاج إلى بعض الراحة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: أهناك خطب ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: سأغادر الليلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: قلتُ لك إنني لم أكن أنوي البقاء طويلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: كنتُ بحاجة فقط إلى مكان أستريح فيه لبعض الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: ماذا ستفعلين بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: هل ستعيشين مع العائلة؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: لا أود التفكير في الأمر حاليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: أعتقد... أنني سأعود إلى المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: وأعثر على غيتاره القديم...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: وبعدها...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: يمكنكِ البقاء هنا
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: حظًا موفقًا
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: لم يتبقَ لنا أحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: سنعود إلى المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: لم يتبقَ أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: يمكنكِ البقاء هنا
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: حظًا موفقًا
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: لن يسهّل ذلك الأمور عليّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: لا أقصد أن أكون فظة، لكنني لا أهتم لأمرك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: كل ما أريده هو العودة إلى المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: العودة حيث أنتمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: ... شكرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: أنت لا تتحدث كثيرًا، لكنك مستمع جيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: آمل أن تجد ما تبحث عنه وتحقق غايتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: هيه. ما الأخبار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: ماذا كنت تعمل قبل الكارثة؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: يسرني سؤالك يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: هل سمعت عن...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: ...الرهان على الرياضات؟ هاه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: أتعمل محتالًا على الإنترنت؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: بالطبع
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: لا تقل ذلك يا رجل، أنا محلل رياضات!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: إذا كنت تعرف كم من المال تكسبه هذه الأيدي، لكان لعابك يسيل، يا أخي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: أنا محترف في عملي. وأبذل كل ما لديّ لصالح العمل يا بهيمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: يستثمر الناس أموالهم عندي وأردها لهم خمسة... لا، بل عشرة أضعاف.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: كم صنعت من ثروة إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: أتسمي هذا عملًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: هكذا صنعت حياتي يا صاح!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: عبر الرهان بطريقة شرعية لصالح بعض المغفلين يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: هناك دائمًا طرق لخداع وكلاء المراهنات.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: ما عليك سوى المراهنة حسب نصيحتي ثم الاسترخاء حتى تبدأ الأموال في التدفق!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: إن لم يكن لديك أي مال، لا مشكلة. استعره من أي أحمق آخر!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: كم صنعت من ثروة إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: أتسمي هذا عملًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: لا أعرف كيف أخبرك بذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: لقد جنيت ثلاثين مليون...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: ...من الديون بالطبع، لكنها لا تعني شيئًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: وبالتأكيد لا يهمني أمرها في وضعنا الراهن.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: أنا أضحك في وجه المخاطر يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: أتمزح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: بالطبع إنه عمل!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: كان لديّ مكتب وكل شيء كتن رسميًا يا رجل، كنت مديرًا في منصب حقيقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: أثاث فاخر من الجلد، ودفاتر تسجيل وكلاء الرهانات، ودفاتر المبالغ المستحقة وصافي الربح وكل هذه المستندات المهمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: هيه. ما الأخبار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: هل تتأكد من عدم وجود جُباة ديون يتعقبونك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: جُباة ديون؟ ماذا تعني بجُباة ديون؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: "الديون" قد ألغيت تمامًا يا صاح. الشمس تولت أمرها!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: فالبنوك لا تعمل. وعلى الأرجح لن تعمل مجددًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: وهذا يعني أنني معفي من الديون. ولكن عملي لا يزال مستمرًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: مجال المراهنات قد انتهى، لذا عليّ البحث عن مجال آخر أفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: يبدو أن كل ما حدث مع الشمس كان بمثابة ضربة حظ بالنسبة لك.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: حقًا؟ هل ستبحث عن عمل احتيالي جديد؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: بحقك يا رجل، هل ستظل تهينني هكذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: كل شيء مخطط له! فأنا رجل المخاطرات والرهانات الصعبة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: لكنني بدأت حياة جديدة الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: بالمناسبة، لقد وجدت عملًا جديدًا. هل تريد أن تعرف التفاصيل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: أخبرني
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: لا أريد
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: لقد توصلت منذ قليل إلى طريقة رائعة لكسب المال. هل تريد أن تسمعها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: تفضّل
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: لا أريد
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: اسمع، من الواضح أن الوكالة الفيدرالية هي التي تتخذ القرارات الآن، صحيح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: لذا سنحتاج إلى بعض التملق، أتفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: أعتقد أنه إذا سلمنا لهم الحمقى بانتظام، فقد يسمحون لنا بالدخول إلى أحد مخابئهم المحصنة!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: هل تتفق معي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: أتريد تسليم الناس إلى الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: أتعتقد أن الوكالة الفيدرالية ستنقذك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: طبعًا. ولمَ لا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: لا تكن جبانًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: الغاية تبرر الوسيلة يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: مناطق الحجر الصحي مخصصة لمن لا قيمة لهم. لا شيء جيد يحدث هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: لذا علينا أن نحسّن علاقتنا مع الوكالة الفيدرالية ونتملقها بعض الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: لا أطلب منك الزواج من عملائها، كل ما علينا فعله هو تسليم الناس وإعطاءهم ما يريدونه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: نعم... نعم... ويمكننا الاتصال بالخط الساخن والتحدث عن اللافتات وأي شيء آخر حتى نبعد الشبهات عنّا يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: إنهم يمثلون الجانب الصالح يا رجل! ثق بي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: ربما تكون محقًا
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: أنت قذر
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: إذا كنت تريد الانضمام إليهم بهذه الدرجة، فاخرج من منزلي
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: يا رجل، فكرتي العبقرية لم يفهمها عقلك الـ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: على أي حال، علينا أن نكتشف من هو المسؤول ونتقرب منه. إنها خطة ناجحة يا أخي. هل تفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: لذا علينا أن نحسّن علاقتنا مع الوكالة الفيدرالية ونتملقها بعض الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: لا أطلب منك الزواج من عملائها، كل ما علينا فعله هو تسليم الناس وإعطاءهم ما يريدونه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: نعم... نعم... ويمكننا الاتصال بالخط الساخن والتحدث عن اللافتات وأي شيء آخر حتى نبعد الشبهات عنّا يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: إنهم يمثلون الجانب الصالح يا رجل! ثق بي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: ربما تكون محقًا
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: أنت قذر
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: إذا كنت تريد الانضمام إليهم بهذه الدرجة، فاخرج من منزلي إذن
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: بالطبع أنا محق'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: لديّ حاسة سادسة يا صاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: ثق بي، الفوز مضمون طالما تتبعني.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: سحقًا لك. أنت القذر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: كان الناس يدفعون مقابل نصائحي، وأنا أعطيها لك مجانًا، وفي المقابل ألقى منك...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: أنت حمار وجبان... لا أحتاج إلى فاشل مثلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: ماذا ستفعل، هل ستطردني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: ظننت أننا على وفاق...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: لدرجة أنني أشركتك في عملي. ولكنك...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: أنت الخاسر. سأرحل من هذا المكان القذر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: حقًا؟ كانت خطة محكمة مضمونة. ولكن كما تشاء، أنت الخاسر أيها الأحمق...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: إذا غيرت رأيك، أخبرني. اتفقنا...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: هيه. ما الأخبار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: ماذا تريد؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: لقد فكرت في عمل جديد. عمل مضمون النجاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: حسنًا، اسمع...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: الشمس تحمصنا كالمكسرات، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: وأظن أن هذا يعني أن طبقة الأوزون قد تلاشت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: ولكن فكر في الأمر... الأكسجين يصدر من مرور ضوء الشمس من طبقة الأوزون...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: أتفهم ما أعنيه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: ...سنبيع الهواء!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: فكرة جهنمية يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: خطة رائعة، يا لعبقريتك
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: هذا أغبى شيء سمعته في حياتي
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: أتعتقد ذلك يا صاح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: بالطبع. كان من المفترض أن تكون عالِمًا
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: شكرًا يا صاح! كنتُ أعلم أنك ذكي! يمكنك أن ترى كل هذه العبقرية تجري في عروقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: من المفترض أن أنافس على جوائز داروين!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: أتعلم ما هي جوائز داروين؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: أوه، بالتأكيد ستفوز بها
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: آآه... إنهم يمنحونها لعباقرة العلم الأفذاذ. أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: بلا سبب
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: يمنحون جوائز داروين لأولئك الذين يموتون بطرق غبية
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: هاها! أستطيع تذوّق طعم الشهرة منذ الآن! أنا ملك العلم! اخضعوا لملككم أيها الحمقى!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: نجاح تلو نجاح تلو نجاح... هذا ما أفعله يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: حسنًا، اتفقنا إذن. بعد أن ينتهي كل هذا، سأحصل على براءة اختراع لتقنية تُمكّنني من بيع الهواء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: كنت أعلم أنك ستقدّر عبقريتي يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: أوه...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: مهلًا، أتسخر مني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: سحقًا لك. أطرح عليك أفكاري العبقرية، وتسخر مني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: سحقًا لك. أطرح عليك أفكاري منقطعة النظير، وتسخر مني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: سأفوز بجائزة داروين وأصبح مليارديرًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: وعندها ستقبّل قدماي طلبًا في الغفران...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: خذ أفكارك الغبية واغرب عن وجهي
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: يا رجل...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: هل من الصعب إلى هذا الحد أن تصغي إليّ؟ هل أزعجتك بشيء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: لا يهم، سحقًا لك. سأجني المزيد من النجاح بمفردي على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: يا رجل...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: سحقًا لك. أطرح عليك أفكاري العبقرية، وتسخر مني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: سأفوز بجائزة داروين وأصبح مليارديرًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: وعندها ستقبّل قدماي طلبًا في الغفران...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: يا للعجب... اتضح أن كل شيء حقيقي في النهاية...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: كل شيء قلته منطقي تمامًا إذن.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: لا تخرج نهارًا. وتذكّر أن تسمح للآخرين بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: لماذا أسمح للغرباء بالدخول إلى بيتي؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: أسمح للآخرين بالدخول؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: أعلم أنك تفضّل الابتعاد عن الناس، لكن عليك أن تفعل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: قريبتي لا تعرف يقينًا لماذا لا يمكننا أن نختبئ بمفردنا فحسب...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: لكنها ذكرت أنه في حال جاء أحد وسألك إن كنت وحدك، فقل لا، وأخبره أن هناك من في المنزل معك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: أكره التعامل مع الناس
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: ولماذا أحتاج إلى وجود أشخاص آخرين معي؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: أتفهم حيرتك...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: أعلم أنك ربما لا تحب وجود أحد معك، لكن عليك أن تدعهم يدخلون.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: قريبتي لا تعرف يقينًا لماذا لا يمكننا أن نختبئ بمفردنا فحسب...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: لكنها ذكرت أنه في حال جاء أحد وسألك إن كنت وحدك، فقل لا، وأخبره أن هناك من في المنزل معك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: أكره التعامل مع الناس
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: ولماذا أحتاج إلى وجود أشخاص آخرين معي؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: أعلم أن الأمر لن يكون الأمر سهلًا عليك، لكنك لا تملك خيارًا آخر. قد يكون هذا هو الشيء الوحيد الذي يُبقيك على قيد الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: ومن يدري، ربما يجلبون معهم شيئًا مفيدًا أو يشاركونك معلومات مثيرة للاهتمام.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: ولا تنسَ أن تفحصهم بحثًا عن أي علامات تدل على أنهم زوار، فلن تكون لديك طاقة كبيرة خلال النهار مع الحرّ الشديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: لذا اختر بعناية من تريد فحصه، فستضطر إلى التدقيق جيدًا. إنه عمل مرهق ومُنهك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: لكن لا تقلق بشأن التحدث إلى الآخرين، فهذا لن يستهلك طاقتك على الإطلاق، لذا تحدث كما تشاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: وتأكد من أن تلقي نظرة من النوافذ بين حينٍ وآخر. فالتلفاز رائع وكل شيء، لكن لا مصدر للمعلومات أفضل من عينيك أنت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: وماذا أفعل بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: ماذا علينا أن نفعل؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: الأشخاص الذين تسمح لهم بالدخول قد يجلبون شيئًا نافعًا، أو يشاركونك معلومة مثيرة للاهتمام.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: ولا تنسَ أن تفحصهم بحثًا عن أي علامات تدل على أنهم زوار، فلن تكون لديك طاقة كبيرة خلال النهار مع الحرّ الشديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: لذا اختر بعناية من تريد فحصه، فستضطر إلى التدقيق جيدًا. إنه عمل مرهق ومُنهك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: لكن لا تقلق بشأن التحدث إلى الآخرين، فهذا لن يستهلك طاقتك على الإطلاق، لذا تحدث كما تشاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: وتأكد من أن تلقي نظرة من النوافذ بين حينٍ وآخر. فالتلفاز رائع وكل شيء، لكن لا مصدر للمعلومات أفضل من عينيك أنت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: وماذا أفعل بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: ماذا علينا أن نفعل؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: أخشى أن كل ما يمكننا فعله الآن هو أن نحاول البقاء على قيد الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: ونأمل أن ينتهي هذا الكابوس قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: أنا واثق أن الحكومة ستساعدنا بطريقة ما، ربما سيوجهون الجميع إلى الملاجئ أو شيئًا من هذا القبيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: وإن فعلوا، فابقَ معي ومع عائلتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: أوه، كدتُ أنسى.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: سأعود إلى المنزل غدًا ليلًا. هذا رقم هاتفي، لا تتردد في الاتصال في أي وقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: لقد ركّبنا خط الهاتف مؤخرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: لنبقَ على تواصل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: حسنًا، أعتقد أن هذا كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: بالمناسبة، أحضرتُ لك صندوقًا من الجعة، فصهري يعمل في مصنع جعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: أنصحك بشرب واحدة قبل أن تأوي إلى الفراش.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: ستجعلك تشعر بالنعاس. وإذا شعرت يومًا أنك اكتفيت من الحديث لليوم، فاشرب زجاجة جعة واسترخِ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: أنا... أريـ-أريد أمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: أخبريني ماذا حدث بالضبط
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: لا أعرف شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: دخلوا وبدأوا يتحدثون، فقال لهم أبي إنهم مخطئون، ثم قالوا... قالوا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: بابا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: يا بابا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: لا بأس... استريحي
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: سنتحدث غدًا، اتفقنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (استمرت الفتاة تنادي والدها دون هوادة، ولم تُظهر نوبتها الهيستيرية أي بوادر انتهاء.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (الفتاة لا تسمعك حتى، فقد غمرها الحزن تمامًا واستسلمت له كليًا.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: أنا... أريـ-أريد أمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: كيف حالكِ؟ أتحبين المكان؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: آمم... المكان لطيف.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: لكن أتمنى لو كنت في بيتنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: متى سأعود إلى البيت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: ربما لاحقًا... إنهم يصلحونه
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: ليس في الوقت الراهن. لقد احترق بيتكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: حسنًا... هل سيأتون ليصطحبوني قريبًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: وهل سيأخذونني إلى بيت جديد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: أم سأذهب إلى البيت نفسه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: هل يصنعون لي غرفة جديدة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: بابا سيأخذني إلى البيت، صحيح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: لقد رأيتِ ما حدث، أليس كذلك...
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: عليكِ البقاء هنا لبعض الوقت
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: لكن أبي بخير، صحيح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: ماذا عن غرفتي؟ هل احترقت هي الأخرى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: ألن تأتي ماما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: هل تبقى أحد آخر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: لقد رأيتِ ما حدث، أليس كذلك...
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: عليكِ البقاء هنا لبعض الوقت
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: لا... لا أعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: لست متأكدة مما رأيت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: لقد ضربوا بابا، ولكنه نهض. رأيت ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: وهذا يعني أنه قد يكون... أطفأ النار.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: أو سيأتي للبحث عني.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: هل سيأتي قريبًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: لن أذهب إلى أي مكان إلا مع بابا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: سيأتي ليأخذني، صحيح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: رأيته ينهض ويرحل من البيت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: كنت أركض هربًا، ولكنني رأيته.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: أنا... أريـ-أريد أمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: عليكِ تقبّل ما حدث
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: ماذا تعني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: رأيت تلفزيون في غرفتك، هل يمكنني مشاهدة الكارتون؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: لا أعلم ما الذي رأيتِه، لكنني أعتقد أن والدكِ قد مات
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: قد لا يعود والدكِ ليأخذكِ، لا أعلم ما الذي حدث له
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: أنت لم ترَ شيئًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: كنت هناك! كان يتحرك حينما هربت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: وهذا يعني أنه سيأتي إليّ قريبًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: لماذا لم يأتِ إليكِ بعد؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: كيف كان شكله آخر مرة رأيتِه فيها؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: أتقصد إنه لن يأتي؟ لـ... لماذا تقول ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: لماذا لم يأتِ إليكِ بعد؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: كيف كان شكله آخر مرة رأيتِه فيها؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: أممم... ربما كان عليه أن يفعل شيئًا أولًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: أعتقد أنه ذهب ليؤدّب أولئك الأشرار.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: لا بد... لا بد أنه سيأتي قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: يؤسفني ما حدث لوالدكِ، لقد كان رجلًا طيبًا... طيبًا أكثر مما يستحق هذا العالم.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: بالطبع، أجل، أعتقد أن والدكِ في طريقه الآن.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: كان بخير.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: لقد ضربوه... وبعدها...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: لا أتذكر...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: يؤسفني ما حدث لوالدكِ، لقد كان رجلًا طيبًا... طيبًا أكثر مما يستحق هذا العالم.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: بالطبع، أجل، أعتقد أن والدكِ في طريقه الآن.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (تحدّق الفتاة من خلالك كأنك غير موجود، ويخالجك خوف يمنعك من الحركة، فلا تملك إلا أن تنتظر حدوث شيء ما.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (بعد مرور بعض الوقت، تبدأ بالبكاء والنواح مرة أخرى. ولا يبدو أن هناك ما يمكنك فعله لمساعدتها.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (سيكون الأمر أسوأ إذا جاريتها بتصديق كذبتها. عليها أن تتعلم تقبُّل الواقع في أقرب وقت ممكن.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: هذا ما أعتقده.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (تلاحظ أن الفتاة غارقة في التفكير، من الواضح أن ذهنها منشغل بشيء آخر.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (لكن هل يستحق الأمر أن تُدمّر حياتها؟ هل بإمكانها تحمل مثل هذه الصدمة؟)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (تقرر أنها نالت كفايتها. ولا فائدة من جعل الأمور أكثر صعوبة عليها.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: يا إلهي، يبدو أنني كبرت...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: من أين أنتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: حسنًا، نعم يا عزيزي... ما المشكلة في ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: الصغار يتوقون لسماع قصصي، ثم يكرهونني بسببها. هاه!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: أتستطيع أن تتخيل كيف يكون ذلك، هممم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: لديّ منزل... كوخ قديم صغير.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: أحب البقاء هناك، لكنني أشعر بالوحدة إن لم يأتِ أحد لزيارتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: ومَن سيأتي لزيارة كوخ صغير قديم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: لذا أتنقّل وأجوب الأماكن باستمرار. لم يعد لديّ ما أخسره.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: ولدت في المدينة، وكان لدي كوخ صغير في أحد المباني الشاهقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: لا أمتلك كوخًا صغيرًا في الريف، ولا زوجًا عجوزًا بائسًا، ولا أحفاد يمكن الحديث عنهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: لذا كنت أجلس معظم الأحيان على مقعد، لأشعر ببعض الحياة هناك... وقد سمعت أشياء كثيرة!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: لكن عندما بدأت هذه الفوضى كلها، لم أعد أستمتع بالأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: كيف يمكن أن تشعر بالحياة، والجميع من حولك يسقطون كالحشرات!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: في كل خطوة ستجد دائمًا روحًا مسكينة ممددة، مغطاة بقطعة قماش بيضاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: الأمر مأسوي لدرجة تجعلك تتمنى لو اختفيت بدلًا من أن تواصل مشاهدة هذا الحزن.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: ...وهكذا انطلقتُ! أتجول باحثةً عن مكان لا تزال فيه قصص تُروى، وحياة أعيشها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: وها أنا ذي، لقد قادني القدر مباشرةً إلى بابك يا عزيزي!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: لستُ متدينة، لكن في مثل هذه الأوقات... أشعر وكأن السماء أرشدتني.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: يا إلهي، يبدو أنني كبرت...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: أليس لديكِ أي أقارب؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: أروي حكايات أولئك الذين عرفتهم عبر هذه السنين الطويلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: أحكي لمن يريد الإنصات.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: لكنني امرأة عجوز الآن، وصار من الصعب عليّ أن أتذكر التفاصيل. أحيانًا... أُغيّر بعض التفاصيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: وربما لهذا السبب يكرهني الجميع الآن يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: خذ هذه الحكمة من امرأة عجوز... كلما زادت الأحزان، نهرب إلى الأحلام حتى لو كانت كوابيس.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: لكنني لست الوحيدة التي تحلم بأشياء أكثر فظاعة مما تبدو عليه، أليس كذلك؟ إههه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: الجميع يأتي إليّ، عاجلًا أم آجلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: فالجميع يحب الحكايات.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: لقد نسيني الجميع يا عزيزي...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: وإن كان هناك من لا يزال على قيد الحياة، فهو لا يأتي لزيارة الجَدّة المسكينة العجوز.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: وهذا أصبح شائعًا بين الصغار هذه الأيام. كثيرون ينشغلون بحياتهم العملية لدرجة أنهم ينسون حياتهم الخاصة...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: الكل منشغل بتفاهات هنا وهناك، ولا أحد يتصل ليسأل عن حالي!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: ذات مرة، كنت جالسة على ذلك المقعد، وجارتِي كانت تتحدث بلا توقف عن حفيدها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: وقالت: "حفيدي فتى صالح! دائمًا يتذكر جدته!"'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: وفي الحقيقة، لم تكذب يا عزيزي! كان دائمًا يلقي التحية، كان شابًا مهذبًا حقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: حتى أنني شعرت ببعض الغيرة…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: ...ثم ماتت.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: وهذا الفتى الصالح لم يعد صالحًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: وكل ما كان يريده هو شقة هذه السيدة المسكينة، مقابل بعض الابتسامات المصطنعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: لماذا يكذب الناس في وجوه بعضهم البعض في رأيك؟ أكاذيب تنعكس في عيون من نحبهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: يتزوجون، وينجبون أطفالًا، ثم... هل تصدّق ذلك؟ لا يحبونك على الإطلاق!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: لحسن حظي، زوجي مات منذ وقت طويل. كان عجوزًا خبيثًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: يا إلهي، يبدو أنني كبرت...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: ماذا حدث لزوجكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: أي قصة تود سماعها يا عزيزي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: الإنسان مخلوق مخيف.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: كنت أعرف رجلًا اعتزل الناس وأغلق قلبه على نفسه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: عزل نفسه في شقة في مبنى شاهق الارتفاع، ونادرًا ما كان يخرج منها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: ربما كان يخشى الزوار. أو ربما كان يخاف الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: لم يحاول الناس زيارته. وليس لأنهم أرادوا ذلك، بل لأنه، كما قلت، لم يكن ليسمح لهم بالدخول...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: حتى ذات يوم...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: سمعت صوتًا غريبًا... كأنه زجاج يُكسر داخل مربى أو شيء لزج...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: فقلت لنفسي: "يا إلهي، ماذا يمكن أن يكون ذلك!؟"'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: فألقيت نظرة من النافذة، فرأيت الرجل الذي يسكن البرج... قد هوى إلى أسفل البرج.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: ...لقد ألقى بنفسه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: هل أعجبتك القصة يا عزيزي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: لم تعجبني إطلاقًا
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: أهذه كل القصة؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: هاه! ربما لهذا لا يحبني أحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: تذكّر... يومًا ما، سأروي قصتك كما أتذكرها أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: نعم يا عزيزي. كان يومًا رجلًا، والآن أصبح بقايا إنسان.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: ربما كان يخشى العذاب الذي يجلبه غضب الشمس... أو ربما سبب آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: بالنسبة لي؟ أظن أن قلبه ببساطة لم يستطع مواصلة الحياة وحيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: ولكن ما باليد حيلة يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: لقد رحل عنّا منذ زمن بعيد بالفعل يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: لقد أفسد حياتي، ذلك الحقير الخبيث!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: تزوجت لأن أهلي ألحوا حتى وافقت على ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: قالوا لي: "تزوجيه يا عزيزتي، إنه فتى صالح". ففعلت...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: وفي البداية كان كذلك فعلًا! كان طيبًا وصالحًا! لكن ما أن تلاشى حب البدايات، حتى ظهر الخبث.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: كنت أتعذب لساعات أمام الموقد لأطعمه، وما كان جزائي؟ "كفاكِ ثرثرة، ألا ترين أنني آكل؟"'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: ومع مرور الوقت، كان يختفي لساعات، يشرب حتى يفقد وعيه!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: كان يعود مخمورًا، يروي قصصًا تافهة عن لعب الدومينو في المرآب.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: آه، وكان يصرخ حتى يسمعنا الجيران لو جرؤت على سؤاله عن ذلك، ذلك العجوز الحقير.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: ...ثم مات.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: في البداية، شعرت بحرية مطلقة يا عزيزي! ...لكن سرعان ما تسلل الفراغ والوحدة إلى قلبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: ساعدني التلفاز لبعض الوقت، لكن الآن أصبح كل شيء مجرد قصة مملة!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: فبدأت أجلس على ذلك المقعد، أراقب العالم يمر من أمامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: يا إلهي، يبدو أنني كبرت...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: وكيف كان الجلوس على المقعد؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: حسنًا يا عزيزي... إليك قصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: كنت أعرف رجلًا كان يعيش في قريتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: كان يحب أن يتجول طويلًا في الغابة. لم يكن أحد يعرف السبب، لكنه كان يمشي بلا توقف.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: ذات يوم، كان يتجول في الغابة حين أدرك أنه ضلّ الطريق. لم يستطع العثور على المسار الذي يعود منه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: فتوقف للحظة ليستجمع أفكاره، وقرر أنه إذا واصل السير، فسيصل في النهاية إلى مكان ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: فسار وسار، لكن مهما ابتعد، لم يستطع العثور على مخرج من الغابة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: حينها أدرك أنه كان يمشي في دوائر!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: ثم ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: ما هذا الغباء؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: ...ثم عثروا على جثته.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: لم يخرج من الغابة. ووجدنا آثاره، تدور بلا نهاية نحو مصيره المحتوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: كما يقول الناس: ساق تخطو خطوات أطول من ساق.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: والآن خرج من الغابة، ولكن جثة هامدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: ألا تعجبك القصة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: حسنًا، ربما... غيرت بعض التفاصيل هنا وهناك...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: لكنها حدثت بالفعل. ويمكن أن تحدث لأي شخص!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: نسمع كثيرًا عن ناس يذهبون في نزهات ويضلون الطريق. كيف يجدون طريق العودة إلى منازلهم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: يا عزيزي...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: كنت أشعر بتحسن قليل، وأنا أرى العالم يمر من أمامي. الأطفال يضحكون، والمتزوجون العشاق الشباب يمرحون، والكلاب تتجول بفرح…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: لكن بعد ذلك بدأ كل هذا الهراء… للأسف!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: اعتزل الناس داخل بيوتهم واحدًا تلو الآخر. لم تعد أي مظاهر حياة تمر أمام جدّة وحيدة تجلس على المقعد.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: ولا حتى النظر من النافذة كان أفضل...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: لا مزيد من التلويحات والسلامات البشوشة، ولا الضحكات البعيدة. فقط كلاب ضالة وجيران يرمقون بعضهم البعض كما لو كانوا غرباء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: وكأن الحياة توقفت يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: والآن... لا يمكنك حتى التمييز بين الخرافات والحقيقة!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: آه، ليت الناس يتوقفون عن الكذب يا عزيزي...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: كل ما أحتاج إليه هو استجماع قواي. لو أن أحدًا يمدّني ببعضها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: كيف حال أختكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: يجب أن أساعدها. في كثير من الأمور.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: استطعت تحميمها بالأمس للمرة الأولى؛ إذ كانت ترفض دخول المغطس في المنزل من قبل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: لم يتغير شيء في حالتها بعد. لكن شكرًا لسؤالك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: قد يُفاقم الاكتئاب من تعقيد الوضع.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: أخشى أنه إذا حدث شيء واضطررنا للهرب، فلن تجد القدرة على الوقوف.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: أو لن تتمكن من تناول أي شيء لأنها لا تملك الطاقة والقوة للمضغ أو البلع.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: أنا متعبة أيضًا. أريد بعض الراحة...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: كل ما أحتاج إليه هو استجماع قواي. لو أن أحدًا يمدّني ببعضها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: ماذا ستفعلين بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: سؤال وجيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: من المفترض أن يأتي زوجي ليأخذنا قريبًا. آمل أن يتمكن من العثور على مكان آمن لإقامتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: مكان يمكننا الانتظار فيه حتى تنتهي هجمات الزوار وحرارة الشمس الحارقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: لقد قال إن أماكن كهذه موجودة. وقال أيضًا إن الشمس لن تنفجر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: لأنه لو كانت كذلك، لانتهت كل أوجه الحياة خلال أقل من عشر دقائق.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: أعتقده محقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: كل ما أحتاج إليه هو استجماع قواي. لو أن أحدًا يمدّني ببعضها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: هل هناك أي أخبار عن زوجكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: لم أسمع شيئًا منه على الإطلاق... لم يتصل ولم يأتِ ليبحث عنا لسببٍ ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: هل حدث له شيء ما؟ أم ربما وقع في ورطة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: أعلم يقينًا أنه لم يتخلَّ عنا. هذا مستحيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: حتى بعد أن فقد صبره تمامًا من أختي، ظل يساعدني في الاعتناء بها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: ربما لا يزال في الطريق.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: وأختي تبدو أفضل حالًا قليلًا، لذا... فهو بالتأكيد قادم. وكل شيء سيكون على ما يرام عندما يصل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: كل ما أحتاج إليه هو استجماع قواي. لو أن أحدًا يمدّني ببعضها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: تبدين حزينة
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: حقًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: هذا ليس مفاجئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: أفرط في التفكير حاليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: إذا لم تكن الشمس على وشك الانفجار، فلماذا لم تنخفض الحرارة بعد؟ ولماذا يصر الجميع على قول إن هذه هي نهاية العالم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: سمعت ذلك من الأخبار.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: لم يقولوا ذلك صراحة، لكن يبدو أن الحرارة ترتفع مع مرور الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: المناخ يتغير، وهذا يعني أن الحيوانات تموت لأنها لا تستطيع التأقلم مع هذا... الطقس الجديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: ماذا سيحدث لنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: كل ما أحتاج إليه هو استجماع قواي. لو أن أحدًا يمدّني ببعضها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: كيف حالكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: خرجت الليلة الماضية لأبحث عن زوجي.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: تجولت في بعض الأماكن التي اعتقدت أنه قد يكون فيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: ...ووجدته. كان قد تناول حبّة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: كنّا... قد اشتريناها لنتناولها معًا، في حال ساءت الأمور وفقدنا الأمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: لقد تناول واحدة. كان خائفًا جدًا... لم ينتظرني حتى أرحل معه.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: أخذها... ابتلع الحبة وحيدًا، قبل أن تبتلعه الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: هذه هي النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: كيف حالكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: أشعر...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: وكأن غطاءً من سلاسل يلتف حول جسدي كله... كل شيء يبدو ثقيلًا... ثقيلًا جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: ولا أستطيع تحمّل هذا الحمل الثقيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: أريد التخلص من هذا الحمل الثقيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: هذه هي النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: كلكِ تفاؤل كالعادة.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: أجل. بالطبع.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: هل سمعت ما يُثار حول الشمس؟ يقولون إنها ستنفجر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: اكتشفت ذلك الليلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: أهذه هي النهاية إذن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: ولن يتبقى حتى أدنى أثر لوجودنا البشري؟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: التفكير في ذلك محيّر.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: هذه هي النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: كيف حال أختكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: إنها تخشى فقدان كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: لا أعتقد أن لدينا ما نخسره أصلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: نحن لا شيء سوى ذرات غبار في كونٍ يتمدد بلا توقف.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: لا أحد بحاجة إلينا. بل... لا أحد موجود أصلًا غيرنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: وإن اختفى كوكبنا، فلن يحزن علينا أحد. فلن يبقى أحد، ولا شيء، ليحزن أصلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: ولكن أختي تخشى ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: هذه هي النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: هل أختكِ مريضة؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: نعم، إنها تريد الخروج للبحث عن زوجها، لتصفية ذهنها من تلك الأمور الفظيعة التي تفكر فيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: لديّ شعور بأنها فكرة سيئة... لكنها تقول إنها لا تستطيع الجلوس مكتوفة اليدين دون أن تفعل شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: وإن كانت لا تزال مصمّمة على البحث عنه، فسأضطر إلى الذهاب معها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: لا أريد أن أفقدها قبل أن ينتهي كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: هذه هي النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: هل خرجتما معًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: نعم. وعثرت على جثة زوجها.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: قال لها إن كل شيء سيتحسن... ثم اختار طريق الجبناء. لم يرد أن يبقى ليشهد النهاية الحقيقية.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: لا أعتقد أنها تملك أي قوة بعد الآن لمواصلة الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: والآن عليّ أن أعتني بها... حتى تأتي نهايتنا نحن أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: وبعد تلك اللحظة الأخيرة، لن يبقى ما يدعو للقلق، أو الخوف، أو الرعب، أو حتى الخجل.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: دعها وشأنها
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: تبًا... *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: يا صاح... إن لم يكن في الأمر إزعاج... هل يمكنك أن تتصل بهم؟ ...{0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: لن أطلب منهم أن يأتوا ليأخذوني... ولا أطلب وداعًا... *يسعل* فقط أخبرهم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: أخبرهم بأن والدهم لم يهرب... بل... بقي في المكان الذي احتاج إليه الناس فيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: *يسعل* هذا كل ما يهمني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: ألديك شيء لتشاركه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: ما هذه الأوراق؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: لن تصدّق ما تحتويه هذه الملفات. فبعضها مثير للاهتمام بشكل مذهل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: انظر إلى هذا مثلًا، فهذه النظرية على وجه الخصوص مثيرة للفضول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: تزعم هذه النظرية أن الزوار ليسوا حقيقيين أصلًا، بل مجرد جزء من خطة حكومية سرّية لتقليص عدد السكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: نظرية مشوّقة جدًا! والغريب أنها تبدو منطقية نوعًا ما، إذا أمعنت التفكير فيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: والآن تأمّل الفكرة — فالزيادة السكانية مشكلة معروفة، أليس كذلك؟ إنها ببساطة حقيقة من حقائق مجتمعنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: ولنفترض أن هذه هي الطريقة التي قررت الحكومة "التعامل" بها مع المشكلة... هممم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: ألديك شيء لتشاركه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: ألا تزال تقرأ هذه الملفات؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: أجل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: ولديّ الكثير غيرها أيضًا، إن كنت مهتمًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: خذ هذه النظرية مثلًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: تزعم أن عملاء الوكالة الفيدرالية *هم* الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: وبما أن تلك البزات التي يرتدونها تغطيهم من الرأس حتى القدمين، فلا توجد أي طريقة لفحصهم. يبدو هذا منطقيًا، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: مثير للاهتمام... خصوصًا حين يشيرون إلى أن اختصار FEMA يعني في الحقيقة: منشأة القضاء التام على الجنس البشري.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: أو... ربما هي شيء آخر...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: ألديك شيء لتشاركه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: ماذا اكتشفت هذه المرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: الزوار... المتحولون جلديًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: يبدون وكأنهم من رواية خيال علمي، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: ولكن هذه هي الحقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: اسمع هذا. هناك تقرير يتحدث عن رجل شاحب البشرة شوهد يتجول في الشوارع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: مع ذلك، يجب أن أشير إلى أن الكاتب ارتكب خطأ واضحًا جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: ادعى أن هناك اثنين من تلك الكائنات الشاحبة المخيفة يتجولان في الخارج.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: شوهد أحدهما عبر النوافذ، وشوهد الآخر واقفًا على الأبواب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: هراء! أليس واضحًا أنهما الكيان نفسه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: 'Theorist: أظن أن النافذة خدعت رؤية الكاتب — مجرد خطأ إدراكي نظري لا أكثر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: ولكنها لا تزال نظرية مثيرة للاهتمام، صحيح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: ألديك شيء لتشاركه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: ماذا لو كانت حقيقة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: وما الحقيقة أصلًا؟ إنها مفهوم متغير، يتشكل تبعًا للمنظور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: فالحقيقة عند شخص ما، تمثل وهمًا عن آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: وما يراه أحدهم خيرًا، قد يراه آخر شرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: البشرية تتجادل حول الفضائل منذ قديم الأزل. والآن، بوصلة أخلاقنا المشتركة أكثر اختلالًا من أي وقت مضى!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: إذا كانت معتقداتك قوية، مثلي، فإنها تتحول إلى حقيقتك الخاصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: هممم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: مقالة مثيرة للاهتمام حقًا... الآن، عمَ كنا نتحدث؟ آه، نعم. الحقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: تذكر هذا: لا توجد سوى حقيقة واحدة... الزوّار عبارة عن طفيليات تعبث بالدماغ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: عليك أن ترتدي سدادات الأذن في كل الأوقات! لا تمنحهم أدنى فرصة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: على أي حال، لديّ المزيد من الملفات لأقرأها، فهل تمانع التزام الصمت؟ أحتاج إلى بعض التركيز.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: ماذا تريد الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: قلتِ إنكِ كنتِ تعملين في الجمارك، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: هذا صحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: وبالمناسبة، أنت تفحص الناس للتأكد من عدم كونهم من الزوّار، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: أعلم أن هذا بديهي، ولكنني أتأكد وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: من صاحب الفكرة العظيمة في تسميتهم "بالزوّار"، على أي حال؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: لكان مصطلح "المسوخ" أكثر منطقية...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: ماذا تريد الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: لماذا تكرهين الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: ما هذا السؤال الغبي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: إنهم سبب كل هذه الفوضى! ألا تتابع الأخبار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: الشمس على وشك الانفجار، والناس يموتون في الشوارع... وكل ذلك خطأهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: أقسم إنني سأقتل كل واحد منهم لو كان بيدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: كل ما أحتاج إليه هو بعض الوقت. سأكشف أمرهم كما كنت أفعل على الحدود.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: الوكالة الفيدرالية خسرت قدراتي في عملها...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: ماذا تريد الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: لماذا تريدين العمل لدى الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: لأن البشرية تهمني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: أعلم أن من الممكن إيقاف هؤلاء الزوّار، وبالتأكيد يجب أن نوقفهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: أنا بالفعل أقوم بدوري — قدمت بلاغًا عن جارنا قبل أيام قليلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: وماذا فعلوا لمكافأتي؟ لقد وظفوا زوجي! هل تصدّق ذلك!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: لا تسئ فهمي، أنا فخورة جدًا بزوجي، لكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: كل ما في الأمر أنني شعرت بقلة التقدير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: ماذا تريد الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: لماذا أبلغتِ عن جاركِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: هل تعاني ضعف السمع؟ قلت لك إنه كان من الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: ...كما أنني لست مرتاحة له.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: وشعرت بارتياح بعد تسليمه لهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: ذكرني ذلك بالأيام التي كنت أحمي فيها بلدي على الحدود.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: ومن هنا جاءتني الفكرة... يجب أن أعمل في الوكالة الفيدرالية!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: ماذا تريد الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: لستِ هنا من أجل زوجكِ. أنتِ هنا من أجل الوكالة الفيدرالية، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: وماذا في ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: أتيتُ إلى هنا لأحدث ضجّةً حتى يلتفت إلينا من في الأعلى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: سأستأنف قرار رفضي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: أمسكت الزائر، وأديت واجبي المدني، ويمنحونه الوظيفة؟ هذا ظلم مطلق!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: يا إلهي، هذا لا يُعقل إطلاقًا. إنه غباء محكم!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: أكره ذلك الرجل. أكرهه بكل جوارحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: لديّ طلب صغير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: هل يمكنك الاتصال بهم؟ استخدم الخط الداخلي، فلديهم رقم خاص: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: قل لهم إنك قابلت الشخص المناسب: امرأة ذات خبرة وعزيمة صلبة. يمكنك حتى أن تذكر زوجي إذا أحببت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: أيًا كان ما ستفعله، بالِغ في مدحي. فربما يوافقون أخيرًا على ضمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: ماذا تريد الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: كان العمل في الجمارك أفضل، أليس كذلك؟ على الأقل كنتِ تمتلكين بعض السلطة هناك.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: لا تحاول أن تتملقني يا هذا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: لا أتذكر أنني طلبت رأيك، لذا لا تظن أنك أفضل مني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: لا بد أن امتلاك السلطة يمنحك شعورًا جميلًا، فالجميع يأتي إلى منزلك أملًا في اللجوء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: فأنت وحدك من يقرر هوية الزائر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: ولكن هذه ليست مهمتك، بل وظيفة الوكالة الفيدرالية، أنت من يحكم ويقرر وينفّذ الحكم هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: تمتلك الوكالة الفيدرالية صلاحية اتخاذ تلك القرارات. هل تعتقد حقًا أنك أفضل من ضباط الوكالة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: نعم، أنا على حق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: يا رجل... آمل أن أتعلم القتل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: هل ما زلت تريد أن تراني أقتل زائرًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: في الواقع... لا. لقد غيرت رأيي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: هذا يخيفني. أنا آسف! لقد... أدركتُ أني لم أكن مستعدًا بعد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: رؤية الجثث ما زالت تجعلني أشعر بالغثيان، سأحتاج إلى بعض الوقت لتجاوز ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: لكن، بالنسبة للزوار... سمعتُ أن أجسادهم تظل تتحرك بعد موتهم. مثل ذلك الرجل في الزقاق...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: آآه... مجرّد التفكير في ذلك يصيبني بالغثيان. لا يمكن أن أكون مستعدًا لهذا، أنا آسف...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: يا رجل... آمل أن أتعلم القتل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: ماذا حدث في الزقاق؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: يصعب التحدث بهذا الشأن يا صاح، ولكنني سأحاول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: كنت أعتقد أن الأزقة أكثر أمانًا من الشوارع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: لكن في اللحظة التي انعطفتُ فيها عند الزاوية، كان الأمر أشبه بدخول مقبرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: جثث في كل مكان. أرواح مسكينة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: وبعضها كانت لا تزال تتحرك! كأن أصحابها… لم يموتوا بعد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: ثم في نهاية الزقاق، كان هناك رجل يحمل سلاحًا، وقد...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: لا، لا أستطيع. لا أريد تذكر ما حدث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: يا رجل... آمل أن أتعلم القتل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: أخبرني بتفاصيل أكثر عن الرجل في الزقاق
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: كان...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: كان يرتدي عباءة من نوع ما، وتتدلى منها العديد من الأصابع والأسنان، و...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: وكان هناك طفل بجانبه يبدو عاجزًا تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: كان الرجل ذو العباءة يوجه سلاحه نحو الطفل ويصرخ في وجهه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: كان يصرخ في وجهه ليُريه أسنانه... والطفل المسكين كان يتوسّل الرحمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: كنت مختبئًا خلف حاوية قمامة... يا إلهي، لم أستطع إلا أن أتخيل نفسي مكانه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: كان الطفل يبكي... بشكل هستيري، ويتوسل من أجل حياته...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: ثم... بووم! انضم إلى بقية الجثث على الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: حينها أدركتُ أنه لم يبقَ في هذا العالم الآن سوى نوعين من الناس: المفترسون والفرائس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: يا رجل... آمل أن أتعلم القتل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: البقاء على قيد الحياة لا يعني أنك مضطر لأن تصبح قاتلًا متعطشًا للدماء.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: هل أنت مجنون؟ بالطبع هذا ما تعنيه النجاة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: أنت ما زلت حيًا الآن لأنك كشّرت عن أنيابك كمفترس! ولهذا السبب لا يجرؤ أحد على الاقتراب منك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: طالما يخافك الناس، ستكون بخير!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: لا أريد أن أكون فريسة. لا أريد الموت وأنا أبكي كالجبان. أنا... أنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: لهذا يجب أن أتعلم القتل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: أبانا الذي في السموات...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: ما رأيكِ في المنزل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: إنه خبيث يا ولدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: الجدران فظيعة، وتصميم المكان غير متناسق على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: قل لي، هل تعمّدتَ أن تخصّص لي أسوا غرفة لديك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: الأثاث قديم ومهترئ… يبدو أنه صار وجبة للعُثّ الذي اتخذ منه مسكنًا له.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: لم تستطع حتى أن تعلّق صليبًا لتجعل الغرفة تليق بأن تُسمّى غرفة، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: أبانا، لماذا تختبرني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: أبانا الذي في السموات...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: ولماذا لا ترحلين إن كنتِ تكرهين المكان إلى هذا الحد؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: هل تظن أنني اخترت أن أطأ هذا المكان الملعون؟ لو بقي الدير قائمًا، لما تركت جدرانه المقدسة قط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: لا يهمني هذا المكان القذر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: لا، لو أُتيح لي الاختيار، لما اخترت هذا المكان قط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: هذا المنزل تفوح منه رائحة القتل والموت. ربما تستمتع بالعيش وسط هذا العفن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: فأنت تقتل أي شخص تراه في نظرك شيطانًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: بينما قد تكون أنت الشيطان نفسه! تنتظر اللحظة المواتية لإظهار حقيقتك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: لكنني سأصبر على هذه التجاوزات. أبانا في السماء يراقب أتباعه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: أبانا الذي في السموات...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: ولماذا لم تبقي في ديركِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: أولًا—الدير ليس ملكي. إنه بيت الرب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: ثانيًا، كان كل ذلك بفضل أولئك المدّعين الكفرة البغيضين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: لقد دنسوا أرضه المقدّسة. عسى أن تنزل نيران السماوات فوق خطاياهم!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: لقد حرقوا الدير، وطردوا أتباعي، وطردوني معهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: أخذوا ما طمعوا فيه، وكأنّه ملكهم! هؤلاء الأنجاس الهمجيون!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: كانت حياتنا منظّمة ومقدّسة. كنا نصلي كما أمرنا، ونصوم كما أوصانا. أما هؤلاء الوحوش لا أعرف ماذا يفعلون!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: على الأرجح يشربون الماء المقدس كما لو كان خمرًا رخيصًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: عسى أن يخنقهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: أبانا الذي في السموات...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: ماذا أراد هؤلاء الكفرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: كانوا متجمعين—كلهم نجاسة. وصرخوا، وسبوا ولعنوا كما يفعل الهمجيون معدومي الإيمان!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: والسبب؟ لأنني رفضت أن أدخلهم! لقد أخبرتهم: لا يحق لغير المعمدين عبور عتبة هذا المكان!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: استشاطوا غضبًا… ضربوا الأبواب بعنف، وهددوا بخلعها بالكامل!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: وعندما تمكنوا أخيرًا من اقتحام المكان، طردوني منه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: إذن، رفضتِ مساعدة من طلبوا مساعدتكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: كنت لأطردكِ أيضًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: المكان المقدس لا يوفر مأوى لمن يرفض نور الرب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: سواء كانوا يرجون ظلًا من الشمس، أو ملاذًا من أولئك الزوار—فالأمر لا يهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: حتى لو انهمرت النيران من السماوات نفسها، فإن بيت الرب ليس ملاذًا لمثل هؤلاء الأنجاس!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: الرب يرحم المؤمنين فقط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: وإذا وجدوا أنفسهم في الشارع بلا مأوى، فذلك عقابه لهم بأن يروا النار تلتهمهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: أنتِ حقيرة، لكنني لست مثاليًا لأطلق أحكام كهذه
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: اغربي عن وجهي قبل أن أرسلكِ لمثواكِ الأخير
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: أيها النجس الحقير!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: هل جننت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: أنا خادمة الرب! طُردتُ من بيته على أيدي وحوش بشرية غير مؤمنة. وأنت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: تجرؤ على إهانتي؟ وتقول إنني أستحق ما حدث لي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: أنت لست بشرًا. أنت خبيث كالأفعى!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: أنت مهرطق وكافر مثلهم!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: كنتُ آمل أن تفهم، لكنك لست أفضل من الباقين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: لسنا سوى خدام! خدام الرب!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: لا يسعنا إلا أن نقبل مشيئته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: العبد في التفكير والرب في التدبير. لن نستوعب أبدًا خططه لنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: أنتِ حقيرة، لكنني لست مثاليًا لأطلق أحكام كهذه
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: اغربي عن وجهي قبل أن أرسلكِ لمثواكِ الأخير
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: وأنت المخلّص الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: احتفظ ببيتك القذر لنفسك. أرفض أن أقضي ثانيةً أخرى في هذا المكان الخبيث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: وداعًا يا فتى. ليحل غضب الرب عليك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: لم أكن أنوي البقاء على كل حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: شعرت بذلك في أعماقي منذ اللحظة التي وطأت قدمي فيها هذا المكان—لا وجود للإيمان في هذا المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: ربما يتحدث الرب إليّ، ويأمرني بالرحيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: وداعًا يا فتى. ليحل غضب الرب عليك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: هذا الجرح اللعين...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: لماذا لاحقتك الوكالة الفيدرالية على كل حال؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: لا أستطيع الجزم، لكن حدسي يخبرني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: اعتقدت أنها مجرد عملية تفتيش روتينية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: لكنني متأكد تمامًا أن تلك العاهرة التي تسكن بجوارنا هي التي وشت بي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: كنا نكره أحدنا الآخر بشدة. أعتقد أنها رأت فرصتها واغتنمتها — ادعت أنني "زائر".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: ربما تشعر بالفخر الشديد بنفسها أيضًا الآن، تلك السافلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: هذا الجرح اللعين...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: كيف حالك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: أنا بخير. الجرح يلتئم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: قلت لك، الرصاصة اخترقت الجسم بالكامل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: لا ينبغي أن يتشاجر الناس مع بعضهم البعض هكذا. واعلم أنني سأجد الشخص المختل الذي لم يتردد في سحب الزناد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: قريبًا سننام جميعًا تحت الأرض لأننا بالتأكيد لن نسمح لبعضنا بعضًا بالنوم فوقها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: هذا لا يناسبني. نصيحتي هي عش ودع غيرك يموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: كان عليك أن ترى ذلك المجنون سريع سحب الزناد. ذلك الوغد المخيف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: مجنون؟ اعتقدت أنك قلت إن شخصًا من الوكالة الفيدرالية أطلق النار عليك.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: عن أي مجنون تتحدث بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: حـ-حسنًا، نعم، كان أحد عناصر الوكالة الفيدرالية...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: أخبرني بالحقيقة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: كذبك مفضوح.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: أقصد… أنا أتحدث عن أحد عناصر الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: كان مخيفًا حقًا... وجهًا لوجه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: أعني… آه… عندما أطلق النار عليّ من الخلف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: أخبرني بالحقيقة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: كذبك مفضوح.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: حسنًا، حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: كنت أعني ما قلت حين ذكرت أنني خرجت من منطقة الحجر الصحي... لكن لم يكن هناك أي إطلاق نار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: ساعدني طبيب ما. زوّر أوراقي وأخرجني من هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: لكن لم يكن بوسعي العودة إلى المنزل، فجارتِي الحقيرة كانت ستسلّمني مجددًا في لحظة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: وهكذا وجدت نفسي أبحث عن مكان أختبئ فيه... وهناك التقيت بذلك المجنون.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: كنت أريد أن أسأله إن كان هناك مكان يمكنني المبيت فيه تلك الليلة، ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: رأيت مشهدًا مرعبًا: بندقية على ظهره، وقلادة من أسنان وأصابع حول عنقه، وخلفه زقاق تملؤه الجثث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: نعم… عندها أدركتُ أنه مجنون تمامًا… آه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: جرح الرصاصة بدأ يؤلمني من جديد... هل تمانع إن استلقيت قليلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: تبًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: سأشرح لك كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: كنت أعني ما قلت حين ذكرت أنني خرجت من منطقة الحجر الصحي... لكن لم يكن هناك أي إطلاق نار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: ساعدني طبيب ما. زوّر أوراقي وأخرجني من هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: لكن لم يكن بوسعي العودة إلى المنزل، فجارتِي الحقيرة كانت ستسلّمني مجددًا في لحظة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: وهكذا وجدت نفسي أبحث عن مكان أختبئ فيه... وهناك التقيت بذلك المجنون.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: كنت أريد أن أسأله إن كان هناك مكان يمكنني المبيت فيه تلك الليلة، ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: رأيت مشهدًا مرعبًا: بندقية على ظهره، وقلادة من أسنان وأصابع حول عنقه، وخلفه زقاق تملؤه الجثث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: نعم… عندها أدركتُ أنه مجنون تمامًا… آه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: هذا الجرح بدأ يؤلمني من جديد... هل تمانع إن استلقيت قليلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: هذا الجرح اللعين...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: حدّثني عن ذلك المجنون الذي يحمل البندقية.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: صحيح، ذلك المختلّ الغريب المغطى بالأسنان والأصابع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: يبدو أنه لمح نظرات الشك في وجهي، فسحب سلاحه نحوي، لكنني أمسكت به.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: تشابكنا لدقيقة تقريبًا، نتقاتل على ذلك السلاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: ثم أطلق النار. ثم ضربت رأسه برأسي وأفقدته وعيه تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: بعد ذلك، ركضت... إلى أبعد ما استطعت. ثم بدأ الألم ينهش بطني... آه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: وحين نظرت إلى أسفل، كان الدم في كل مكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: لم أرد أن أقول إنه أطلق النار عليّ، لاعتقادي أنك لن تدعني أدخل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: ففي أوقات كهذه، كل إنسان يعتمد على نفسه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: بصراحة، كن صادقًا... هل كنت لتدعني أبقى لو علمت أن مجرمًا مسلّحًا مختلًا يطاردني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: كنت بحاجة إلى مأوى... لم أرد أن أموت مثل أولئك المساكين في الزقاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: نعم، لقد كذبت... وآمل ألا تلومني على ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: حسنًا، يمكنك البقاء
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: لا أستطيع أن أثق بك. ارحل عن بيتي
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: شكرًا. هذا يعني لي الكثير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: من الرائع أنك تحمل سلاحًا ناريًا أيضًا. مع ذلك، لنأمل ألا يظهر ذلك المختل عقليًا على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: آمل أن يكون شخص آخر قد تخلص منه. ربما ذلك الزائر الشاحب قد أصابه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: أعتقد أنني كنت محقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: أتفهم الآن لمَ كذبت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: تمتع بحياتك يا حيوان!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: أوه لا... أين ذهبوا...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: ما الأخبار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: لا أعلم... كل ما أريده أن يعود والداي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: لقد اعتنيا بي طوال حياتي، والآن... لا أعرف ماذا حدث لهما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: أتمنى حقًا أن يكونا بخير. لا أستطيع تخيل العيش دونهما...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: أوه لا... أين ذهبا...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: هل لديك أقارب آخرين؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: ليس بالضبط. أوه، ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: اكتشفتُ مؤخرًا أن لديّ أختًا أكبر؟ من زواج والدي الأول، ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: يا إلهي، نسيت جدتي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: أعتقد أنني عرفت للتو المكان الذي ربما ذهب إليه والداي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: ماذا لو كانت جدتي زائرة وقتلتهما؟ أو ربما أخذتهما الوكالة الفيدرالية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: لماذا؟ لماذا لم يبقيا؟ لماذا لم يأخذاني معهما...؟ لماذا!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: لن استطيع المواصلة وحدي! لماذا تركاني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: أوه لا... أين ذهبا...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: هل هدأت بما فيه الكفاية لتخبرني عن أختك هذه
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: في الواقع...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: قبل وقت قصير من رحيلهما، تلقينا خطابًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: أحضره لي أبي لأنني لا أتحقق من البريد أبدًا. طلب مني أن أقرأه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: وكان من "أختي."'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: قالت إنها تريد مقابلتي، ولكنني... لم أعرف كيف أرد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: اعتقدت أنه مقلب في البداية. لكن أبي من أعطاني الخطاب، لذا أعتقد أنه كان حقيقيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: وأخبرني أنني لم أكن طفله الأول في الواقع، بل كان لديّ أخت طوال هذا الوقت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: ليست أختًا شقيقة، بل نصف أخت. نتشارك الأب نفسه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: لا أدري... لقد جعلني الخبر أشعر بغرابة. لم أعرف كيف أتعامل معه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: أعني، يُفترض أنها "أختي"، لكنها غريبة تمامًا عني. يا له من أمرٍ غريب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: أعتقد أنني أرغب في مقابلتها، لكنني خائف جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: ربما يمكنك الاتصال بها نيابة عني؟ رقمها هو {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: من فضلك... أخبرها أنني موجود. لا أعرف ماذا أفعل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: أوه لا... أين ذهبا...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: لماذا لا تريد أن تذهب لرؤية أختك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: لا أعرفها أصلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: عندما أخبرني والداي بالحقيقة، شعرت كأنهما كانا يكذبان عليّ طوال حياتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: غضبتُ بشدة وهرعت إلى غرفتي. أردت أن يتركاني وشأني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: ثم في اليوم التالي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: كل ما أخبرتك عنه حدث. التلفاز، والذعر، ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: تركاني وحيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: يا إلهي، أقسم إنني سأفعل أي شيء من أجل رؤية أمي وأبي مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: لماذا... لماذا تركاني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: اذهب إلى أختك، فمن المؤكد أنها ستستقبلك بكل حب.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: هل أنت متأكد أن والديك ميتان؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: حقًا؟ أتعتقد ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: ولكنني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: لم أسافر قط هذه المسافة دون والداي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: إنها تعيش بعيدًا عن هنا، وأنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: أنا خائف جدًا. لا أعرف إن كنت أملك الجرأة والشجاعة لفعل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: خذ سيارة أجرة إذن. سائقو الأجرة لا يزالون يعملون.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: عليك التصرف
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: لم يعودا من أجلي، لذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: لا أدري...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: حاول العثور على جدتك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: ابحث في مناطق الحجر الصحي
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: مهلًا، هذه... في الواقع ليست فكرة سيئة. إنها...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: ولكن سمعت أن سيارات الأجرة أصبحت باهظة الثمن حاليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: مع ذلك، أخذت ما تركه والداي من مال. ربما يكفي هذا لدفع ثمن توصيلة إلى منزل أختي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: شكرًا لك على مساعدتي بأفكارك. أراك لاحقًا... ربما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: ربما تكون محقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: ربما كنت أعتمد على والداي لوقت أطول من اللازم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: شكرًا لك على مساعدتي بأفكارك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: سأحاول إيجاد سيارة أجرة. أحضرتُ معي مال والديّ، وآمل أن يكفيني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: سأجرب حظي... أراك لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: ربما تكون محقًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: ماذا لو تعطلت سيارتهما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: أجل، لا بد أن هذا هو السبب. كان أبي يقول إنها تحتاج إلى صيانة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: وجدتي ترفض امتلاك هاتف. ربما لهذا السبب لم يتمكنا من الوصول إليّ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: أتعلم... ربما سأجدهما هناك حقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: شكرًا لك على مساعدتي بأفكارك. عليّ الرحيل الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: ربما يكونان هناك بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: عليّ المحاولة على الأقل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: شكرًا لك على مساعدتي بأفكارك. عليّ الرحيل الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: أهلًا يا صديقي، ما الذي يدور في ذهنك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: كيف حالك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: أنا بخير يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: بالمناسبة، ألقيت نظرة سريعة على ثلاجتك. يا رجل، لو كنت أعرف أن لديك هذه الكمية من الجعة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: كيف حصلت على كل هذا على أي حال؟ هل يعمل عمك في مصنع جعة أو شيء من هذا القبيل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: آه، لا بأس. يمكنك الاحتفاظ بأسرارك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: يا له من عالم فوضوي! في عالمٍ آخر، كنا لنشرب جعة باردة ونشاهد مباريات كرة القدم. لربما حتى تقابل—'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: هل أنت بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: لماذا توقفت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: هممم؟ ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: لا يهم. أنا على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: لا، كنت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: هممم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: كنت أفكر وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: أهلًا يا صديقي، ما الذي يدور في ذهنك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: تبدو حزينًا اليوم
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: أنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: لا أريد الذهاب إلى هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: إلى أين؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: عمَ تتحدث بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: لا يهم. لن تفهم على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: أعتقد أن من حقي معرفة ما تتحدث عنه
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: حسنًا، لن أضغط عليك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: اسمع، لا أريد حقًا التحدث عن هذا الأمر، اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: أعتقد أن من حقي معرفة ما تتحدث عنه
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: حسنًا، لن أضغط عليك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: قلت لك، لا تضغط عليّ! أنا بالكاد أستطيع الصمود.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: دعني وشأني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: شكرًا يا صديقي. لا أشعر بأنني على ما يرام، هذا كل ما في الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: أهلًا يا صديقي، ما الذي يدور في ذهنك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: ما خطبك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: هذا ليس من شأنك يا صديقي. ابتعد عني!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: أخبرني بما حدث
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: تحدث إليّ. وإلا سيكون الوضع أسوأ إن لم تفعل.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: لا أستطيع... ستتغير فكرتك عني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: لكنني سئمت الاحتفاظ بأسراري ودفتها بداخلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: كان لديّ كلبة. وماتت... منذ أيام قليلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: وماذا في ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: وماذا غير ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: لماذا، أتخطط لطردي يا صديقي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: Buddy:. حسنًا. أتريد الحقيقة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: كان لديّ كلبة. وماتت... منذ أيام قليلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: وماذا في ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: وماذا غير ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: ليس هذا فحسب. كانت عجوزًا ومريضة... لكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: لم تكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: أنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: لقد قتلتها بيدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: ماذا فعلت!؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: أنت مريض!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: أنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: لقد قتلتها بيدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: ماذا فعلت!؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: أنت مريض!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: أعرف كيف يبدو الأمر، لكن دعني أشرح لك. كانت... كانت تعاني. لم أستطع رؤيتها تعاني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: يومًا بعد يوم، أرى العذاب في عينيها. وأسمع أنينها ليلًا، تبكي من ألم ساقيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: وكل هذا بسبب تلك السيارة الملعونة! لو لم يكن سائق التاكسي يقود بجنون، لربما كانت لا تزال حية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: كنت أتمنى لو أمسكت به لأقتله، لكنه هرب. لم يكن لديّ وقت لأسجل رقم سيارته...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: أنت لا تعرف معنى فقدان حيوان أليف. فنحن لا نقضي مع هذه الحيوانات سوى وقت قصير، لكنها تعلمنا أكثر من أي إنسان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: كما يُقال: بالنسبة لنا، تُعد مجرد فصل في حياتنا. أما بالنسبة لها، فنحن حياتها بأكملها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: حسنًا، يمكنك البقاء
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: أتفهم ذلك... أنا شخص قذر. حتى أنا لا أسامح نفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: لقد... كانت تعاني. لم أستطع رؤيتها تعاني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: كانت حالتها تزداد سوءًا يومًا بعد يوم. كانت الليالي هي الأصعب... عندما كانت تئن من الألم. وتبكي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: هل رأيت كلبًا يبكي؟ عيناها كانتا تتوسلان إليّ لإنهاء عذابها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: لم أُرِد ذلك! أقسم إنني لم أُرِد ذلك! لا يمكن أن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: هذا السائق الحيوان!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: دهس الوغد حبيبتي المخلصة، ثم هرب كأن شيئًا لم يكن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: كأنه اصطدم بمطبات في الطريق، وليس بمخلوق حي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: سحقًا، كنت أتمنى لو أمسكت به لأقتله، لكنه هرب. لم يكن لديّ وقت لأسجل رقم سيارته...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: أنت لا تعرف معنى فقدان حيوان أليف. فنحن لا نقضي مع هذه الحيوانات سوى وقت قصير، لكنها تعلمنا أكثر من أي إنسان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: كما يُقال: بالنسبة لنا، تُعد مجرد فصل في حياتنا. أما بالنسبة لها، فنحن حياتها بأكملها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: حسنًا، يمكنك البقاء
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: شكرًا يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: يسرني أنك تفهمت موقفي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: أنت محق يا صديقي. ربما كان هذا القرار الصحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: أفكر في هذا الأمر كل يوم... هل فعلت الصواب بإنهاء عذابها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: لا أعتقد أنني سأعرف الجواب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: آهه... ماء بارد. هذا ما أردته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: أتشعر بأي تحسن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: نعم بالتأكيد. أفضل كثيرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: لكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: أتعلم، أريد بعض الجعة. هل لديك جعة باردة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: حسنًا (أعطه علبة جعة)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: ليس لديك جعة؟ لا يمكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: رأيت الكثير منها في ثلاجتك! هل شربتها كلها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: رائع! لا يروي عطشي إلا الجعة الباردة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: هااااه... المفضلة لديّ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: خُذ، اشترِ شيئًا لنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (حصلت على حفنة من الأوراق النقدية المجعّدة، عديمة الفائدة هذه الأيام)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: حسنًا... شكرًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: لا تهمني نقودك عديمة الفائدة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: آهه! هذا ما أردته!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: ساعدني وسأساعدك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: هناك الكثير من هذا... لأصدقائي، نعم هناك الكثير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: أوه... وهذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (حصلت على جرة شاي كمبوتشا)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: لا يشربه إلا مجنون، لكن ربما يصلح لشيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: يا للوقاحة! هل تعتقد أنك فوق القانون؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: الكل يحتاج إلى المال! العالم كله يعتمد عليه، صدقني!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: حسنًا، خذ هذه بدلًا منه!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (حصلت على جرة شاي كمبوتشا)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: لا يشربه إلا مجنون، لكن ربما يصلح لشيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: ماذا تعني بـ"لا"؟ ها! هل تظنّ أنه لا يمكن شراء أمثالك؟ كل شيء يُباع — الحب، والأشياء، والناس...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: المال هو من يُسيّر هذا العالم، يا فتى! أمّا أنا؟ فأنا المتحكم به! ها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: حسنًا! كما تشاء! ستندم على ذلك — تذكّر كلامي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: آهه... ماء بارد. هذا ما أردته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: ماذا تريد هذه المرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: أوه، سررتُ بسؤالك! أحتاج إلى سيجارة... ناولني واحدة من تلك السجائر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: ...حسنًا (أعطه سيجارة)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: ألا توجد سجائر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: لا بأس! تريدني أن أعاني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: هذا ما كنت أتمناه الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: كنتُ أدخّن السيجار بالطبع... لكن، من المستحيل العثور على واحدٍ الآن! ها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: حين كنتُ في المجلس، كانت الأمور — هممم — مختلفة. أما الآن فكلها قتل وفوضى... هذا كابوس حقيقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: متى ستقضي الوكالة الفيدرالية على هذه الفوضى، هممم؟ يبدو وكأنها موجودة للاستعراض فقط!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: لم يحدث أي من هذا الهراء عندما كنتُ في الحكومة، أؤكد لك ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: ومع ذلك، ربما تحتاج الوكالة فقط إلى بعض الوقت. أجل، أجل، أجل... كل شيء سيُحلّ في النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: كنت في الحكومة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: هل ساهمت في إنشاء الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: نعم، هذا ما أخبرتك إياه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: أوه، صحيح... خُذ مكافأتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (تتلقى حفنة من الأوراق النقدية المهترئة وعديمة القيمة وبطاقة بريدية غريبة مختومة بختم الوكالة الفيدرالية)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: من أين لك بهذه الفكرة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: أوه، صحيح... خُذ مكافأتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (تتلقى حفنة من الأوراق النقدية المهترئة وعديمة القيمة وبطاقة بريدية غريبة مختومة بختم الوكالة الفيدرالية)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: ماذا تعني بـ"لا"؟ ألا تعرف من أنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: كنتُ وزيرًا! أتعرف من هو الوزير! الحكومة كيان معقّد، وهي بحاجة إلى وجودي لتواصل العمل!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: أنا صوت الشعب! من دوني، لن يُسمَع أمثالكم من البسطاء. لا، لا، لا! أنا من يجعل الحياة أفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: لو كانت الأوضاع طبيعية، لما تجرأت حتى على الردّ عليّ، يا فتى! لكانوا قبضوا عليك في لحظة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: لم يعُد أحد يبالي بمكانة الوزير بعد الآن. أتعتقد أننا كنّا نجلس في مكاتبنا نطقطق أصابعنا بلا عمل، ها...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: حسنًا، سنرى من سيضحك حين تعم الفوضى ويزحف الجميع عائدين إليّ لطلب مساعدتي، أليس كذلك؟ ها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: آهه... ماء بارد. هذا ما أردته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: أتريد شيئًا آخر؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: أنت ذكي يا فتى!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: أريد...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: نعم! أريد مشروب طاقة! قد يفيدني قليل من... هممم، التنشيط!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: حسنًا، هاك (أعطه مشروب طاقة)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: ماذا؟ ألا تملك مشروب إنيرجيكا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: لا بأس! هل تريدني أن أعاني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: حظك سيئ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: أوه! أخيرًا حصلت عليه!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: أخبرني المزيد عن الوكالة الفيدرالية. ما الغرض من وجودها بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: ما الذي تخطط له الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: ما هذا! مشروب خالٍ من السكر؟ مقرف!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: ولِمَ لا تُقدم لي طعام قطط! سيكون أفضل من... مهلًا، ماذا قلت للتو؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: هل جننت؟ هذه معلومات سرية!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: لقد وقّعت على عقود، هل تفهم؟ واتفاقيات عدم إفصاح! لا، لا، لا! لستَ مخوّلًا لمعرفة ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: اشرب بعض القهوة بدلًا من ذلك، وتوقّف عن طرح الأسئلة يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (تحصل على علبة قهوة)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: إنيرجيكا أيضًا؟ ها! لا أحد يعلم أيّ مكونات غريبة يضعونها فيه—...لحظة واحدة، ماذا قلت لي للتو؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: هل جننت؟ لن أخبرك بشيء على الإطلاق. هذه معلومات سرية!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: لقد وقّعت على عقود، هل تفهم؟ واتفاقيات عدم إفصاح! أنت لست مخوّلًا لمعرفة ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: اشرب بعض القهوة بدلًا من ذلك، وتوقّف عن طرح الأسئلة يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (تحصل على علبة قهوة)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: أستميحك عذرًا! وكيف يُفترض بي أن أعمل — هممم — ومعدتي فارغة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: أحاول تسهيل الحياة على الناس! أنا أعمل لصالح الشعب!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: لكن كل ما تفعلونه هو الانتقاد فقط! …أتعتقد أنك أذكى مني؟ إذن لمَ لست في الحكومة مكاني، هممم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: ...بالضبط. جعجعة فارغة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: آهه... ماء بارد. هذا ما أردته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: ماذا؟ أتريد شيئًا آخر؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: تعجبني نباهتك يا فتى. أريد بندقيتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: أنت عبيط
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: اسمعني جيدًا. أعطني إياها. فأنا أحتاج إليها لحماية نفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: كنت معتادًا على الصيد في الماضي. أعرف كيف أتعامل معها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: انسَ الأمر
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: نجوم السماء أقرب لك!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: انتبه إلى كلامك، يا فتى. هل نسيت إلى من تتحدث؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: كنت لأرميك في السجن في لمح البصر لو أردت ذلك! ها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: انسَ الأمر
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: نجوم السماء أقرب لك!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: مـ-ماذا قلت؟ كيف... أنا وزير!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: انتهى أمرك! هذه آخر كلماتك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: اجمع أغراضك واستعد للذهاب إلى السجن يا غبي. ها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: أنت في نظري مجرد زائر آخر.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: لا يهمّني أنك وزير، فأنت لا تساوي شيئًا في نظري.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: انتبه إلى ألفاظك يا فتى، لا يُخاطَب صوت الشعب هكذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: ضاع مستقبلك. أعدك بذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: أوه! لقد ارتكبت خطأ كبيرًا بإغضابي! نحن الوزراء لدينا نفوذ كبير!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: ...سيأتي دورك قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: أنت في نظري مجرد زائر آخر.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: لا يهمّني أنك وزير، فأنت لا تساوي شيئًا في نظري.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: كيف تجرؤ... يا نكرة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: السجن ينتظرك يا هذا! أؤكد لك! ستتذكر كلامي! ها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: كف تجرؤ... يا نكرة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: السجن ينتظرك يا هذا! أؤكد لك! ستتذكر كلامي! ها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: آهه... ماء بارد. هذا ما أردته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: لماذا أعيش الآن خارج الزنزانة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: أوه، أتسخر مني؟ أعدك أنك ستندم على ذلك قريبًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: ربما كانت الألقاب تعني شيئًا في الماضي، أما الآن فأنت لا تساوي شيئًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: المال لا يعني شيئًا الآن. ألا تفهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: يا للوقاحة! أنا... أنا ما زلت في الحكومة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: أنا... لقد... أعطوني إجازة مفتوحة وحسب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: هااه... لماذا أكذب على نفسي... الحياة لن تعود إلى سابق عهدها مرة أخرى...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: عندما كنت في المنصب، كان البلد بأسره يحترمنا نحن الوزراء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: كان الناس يخشونني ويحترمونني. تتنحى السيارات جانبًا، وتتهافت الجموع لإرضائي، كلهم يسعون لنيل رضاي. أما الآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: رائع. صارت معدتي تؤلمني الآن بسبب التوتر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: هل أنت سعيد الآن؟ اغرب عن وجهي. لقد اكتفيت من التحدث إليك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: هذا ليس صحيحًا! لا يزال لدي الكثير من المال!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: ربما لا يعني لك شيئًا، لكن... لكنّ الآخرين يتمنون الحصول عليه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: هااه... لماذا أكذب على نفسي... الحياة لن تعود إلى سابق عهدها مرة أخرى...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: لا رفاهية بعد الآن، لا سيارات فارهة، ولا نساء...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: كان كل شيء أسهل بكثير في السابق. إن كان معك المال، تصبح ذا شأن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: لو لم تحل الكارثة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: رائع. صارت معدتي تؤلمني الآن بسبب التوتر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: هل أنت سعيد الآن؟ اغرب عن وجهي. لقد اكتفيت من التحدث إليك...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: أنا متعب. دعني وشأني.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: غدًا سيكون أفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: ظلام حالك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: أخبرني بما رأيته
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: ستندم على ذلك. صدقني، إن جهل ذلك رحمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: اعتقدت أنني في حال توقفت عن الرؤية، فسأتحرر من ذلك... الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: ...لكنه أصبح محفورًا بداخلي الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: ما زلت أحلم. ودائمًا يكون في أحلامي. يزورني كثيرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: ظلام حالك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: أتقول إن العمى أفضل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: لا يمكنني الجزم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: أعلم أنني لن أرى ذلك الشيء مرة أخرى. حتى لو قتلني شيء ما، فلن أعرف ما هو.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: ...الأمر غريب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: لا أعرف كيف يبدو منزلك. من الصعب التجول فيه. كانت تجاويف عينيّ لتؤلمني لولا الأدوية...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: لكن على الأقل لن أضطر إلى رؤية ذلك الرعب مرة أخرى أبدًا. سأتأقلم مع الوضع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: ومع ذلك، مجرد تذكري لما رأيته صار محفورًا في أعماقي. سأحمله معي حتى مماتي'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: ظلام حالك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: تبدو في حال سيئة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: ربما عليّ أن أمشط شعري؟ ها...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: رأيت حلمًا الليلة الماضية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: كنت أسير على مسار الترام، في طريقي إلى المنزل، وحولي منازل و أشجار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: سمعت عربة الترام تقترب، فتنحيت إلى الجانب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: استدرت... فرأيت شيئًا يخطف رجلًا في الشارع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: تحرّك بسرعة ولم أره بوضوح، لكنني كنت أعلم... كنت أعلم ما هو.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: ركضت خلف الترام، لكنني لم أقترب منه قط. لن أبلغه... ولن أصل إلى الحقيقة المختبئة في نهاية المسار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: ثم استيقظت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: ظلام حالك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: هل أنت بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: راودني حلم آخر. وكان موجودًا فيه مجددًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: كنت أسير في طريق ليلًا، وأضواء الشارع تومض بخفوت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: ثم استدرت فرأيته يقترب نحوي. ببطء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: ولكنني تمكنت من رؤيته يتحرك هذه المرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: حاولت الهرب، ولكنه كان يقترب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: وصلت إلى منزلي، لكنني لم أستطع فتح البوابة الأمامية. فتسلقت السور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: حاولت إخراج المفاتيح من جيبي لكنها كانت تنزلق من يدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: فركضت حول المنزل. ووجدت سورًا آخر. فتسلقته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: ثم توقفت. وكان الصمت التام يعم الأجواء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: نظرت إلى الأعلى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: فإذا به هناك. يحاول الإمساك بي من السور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: هل تعتقد أن هذه الكوابيس تراودني بسبب المسكنات؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: ظلام حالك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: هل راودك أي حلم ليلة أمس؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: نعم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: لكنني لا أريد التحدث عنه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: فهمت الأمر الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: سنموت جميعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: سيمزقنا ويقتلنا. سواء كنا يقظين أو نائمين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: سنحترق جميعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: لا شيء له قيمة الآن. انتهى أمرنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: دعني وشأني من فضلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: إيه الأخبار يا صاحبي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: ماذا كنت تفعل قبل الكارثة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: كنت عايش أحسن عيشة. كنت مقضيها أفلام وخروجات مع أصحابي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: لكن دلوقتي؟ ولا أفلام ولا خروجات. حاجة مقرفة جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: وكل يوم التلفزيون يعرض نفس الحاجات، رسالة ترهيب وبعديها إعلان وبعدين رسالة ترهيب تانية وبعديها إعلان. وأصحابي مبيخرجوش.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: سمعت مسؤول طالع يقول "دلوقتي مش وقت اللعب، إحنا في مصيبة..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: يا عم اتنيل. إيه الملل ده؟ مش عايزين الفرحة تخش التاكس خالص.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: إيه الأخبار يا صاحبي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: ماذا كنت تعمل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: أعمل؟ هاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: الشغل للغلابة الفشلة. أما أنا، كنت عايش حياتي زي ما أنا عايز.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: كنت بطل قصة حياتي. زي أبطال الأفلام كدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: وبعدين بصراحة كدة، هل اللي شغالين مبسوطين؟ أكيد لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: كنت مقضيها حفلات مع أصحابي وكنا مولعين الدنيا. عايشينها صح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: كنت شغال مدير مستودع قبل كدة. لشركة شحن. والناس خانوني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: هذا يعني أنك تعيش على أموال والديك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: أنت عاطل إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: وأشتغل ليه وأنا أموري ماشية تمام؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: مهو أنا لازم استفاد من اللي معايا ده كله وإلا هبقى غبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: أنت معاك بندقية صح؟ هتسيبها متعلقة على الحيطة ولا هتستخدمها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: أنا بستغل حياتي وبستغل اللي معايا زيك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: بالراحة يا عم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: باين عليك غيران مني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: فاهم قصدك. مش كل الناس محظوظة بحياة سهلة زيي. بس هي دي الدنيا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: إيه الأخبار يا صاحبي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: أهناك خطب ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: فين الأفلام اللي عندك؟ مفيش ولا فيلم هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: بتتفرج على أي حاجة طيب؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: يا عم ساعدني، أنا هموت من الملل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: هذا ليس وقت مشاهدة الأفلام
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: ليس لديّ أفلام
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: يا خسارة، كنت فاكر الأجواء في بيتك مسلية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: بس شكله كدة مكان ممل والناس مملة. مفيش حد عنده حاجة أتفرج عليها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: لا مجلات ولا أفلام ولا زفت... كلها كتب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: وهو مين بيقرأ دلوقتي أصلًا؟ كلها كتب عتيقة من العصر الحجري! كلام عميق مش مفهوم. ملل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: هذه ليست سينما
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: هل أتيت هنا للاستمتاع بوقتك أم للنجاة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: لا مش معقول!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: لا مش مصدقك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: عندك تلفزيون ومعندكش ولا فيلم إزاي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: دي صحبة مملة. كنت فاكرك زيي بتكره الملل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: هذه ليست سينما
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: هل أتيت هنا للاستمتاع بوقتك أم للنجاة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: ارحمني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: أنت مانع الفرحة تدخل البيت ليه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: عليك أن تهدأ إن كنت تريد البقاء على قيد الحياة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: إن لم يعجبك البقاء هنا، فيمكنك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: ما تبقاش ممل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: تليفزيوني باظ. وكنت فاكر أنك هتساعدني أقتل الملل اللي حاسس بيه ونقعد نتفرج على حاجة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: أنت مانع الفرحة تدخل البيت ليه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: عليك أن تهدأ إن كنت تريد البقاء على قيد الحياة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: إن لم يعجبك البقاء هنا، فيمكنك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: متزعلش يا عم. المكان منتهى الملل، بس على الأقل أحسن من العيشة في الشارع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: بس لو سمحت سيبني أتفرج شوية على التليفزيون. من فضلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: أنت راجل ممل على فكرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: أنا ماشي من هنا، سلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: هؤلاء الأطفال المساكين...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: هل أنتِ بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: نعم، أعتقد ذلك... لا أعرف...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: لا أفهم كيف يمكن لشخص ناضج وعقلاني أن يسمح لمشاعره أن تدفعه إلى فعل مثل هذا الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: هل كانوا حقًا خائفين إلى درجة أنهم يقتلون طفلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: يفعل الناس أمورًا أسوأ في هذه الأيام
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: حينما تعم الفوضى، لا يصبح للعقل مكان
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: ما الذي يمكن أن يكون أسوأ من قتل طفل مسكين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: ولم يكن شخصًا واحدًا... بل كان حشدًا. مجانين في حملة مطاردة ساحرات...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: الأزمات تكشفنا. ربما نحن الوحوش الحقيقيين، لا المخلوقات التي تزحف من تحت الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: لكن الناس لا يدركون أن قتل الأطفال يُعد... لا أستطيع حتى إيجاد الكلمات...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: الأزمات تكشفنا. ربما نحن الوحوش الحقيقيين، لا المخلوقات التي تزحف من تحت الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: هؤلاء الأطفال المساكين...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: منذ متى وأنتِ معلمة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: منذ ثلاثة أشهر تقريبًا... قبل الكارثة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: لكنني لم أكن معلمة مثالية. لم أكن أحبّ العمل. فآنذاك، كان الأطفال مزعجين ومُرهِقين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: لقد غيّرت الكارثة نظرتي، وفتحت عينيّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: أي واحد من هؤلاء الأطفال كان بإمكانه أن يصبح مغنيًا، أو سياسيًا ناجحًا، أو أب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: لكن الآن لن يحملوا غيتارًا. لن يذهبوا إلى المدرسة. لن يكبروا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: سيظلون إلى الأبد... أرواحًا بريئة حالمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: أتذكر يومًا عندما جاء أحد الأطفال يركض ويبكي ويقول إن والديه خائفان منه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: اعتقدا أنه زائر، ولذلك... طرداه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: لم يكن يعرف أين يذهب، لذلك جاء إلي... إلى روضة الأطفال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (لم تعد المرأة قادرة على كتم دموعها، وبدأت تبكي)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: سامحني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: هؤلاء الأطفال المساكين...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: يؤسفني ما حدث بالأمس. لم أقصد إزعاجكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: لا بأس. أنا... أنا بخير الآن. أشعر بتحسن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: بشأن ذلك الصبي... بعد أن جاء إليّ، أدركت مدى ضعف هؤلاء الأطفال وقلة حيلتهم. خصوصًا عندما تنهار عائلاتهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: بدأت استقبال أكبر عدد ممكن من الأطفال المساكين المهجورين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: استمعت إلى قصصهم... كان من غير المحتمل أن أسمع كيف تخلى بعض الآباء عنهم دون حتى التفكير في الأمر لثانية واحدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: وكأن الكارثة كانت عذرًا كافيًا للتخلي عن طفل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: ربما لم يرغبوا في إنجاب أطفال في المقام الأول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: هؤلاء الأطفال المساكين...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: هل كان لديكِ أي أطفال؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: لا، أنا... كانت والدتي تطلب مني دائمًا أن أستقر وأتزوج لأكوّن أسرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: لكنني لم أكن مستعدة قط. أردت أن يكون قراري سليمًا عندما يحين الوقت المناسب، أتفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: عند سماع كل هذه القصص من هؤلاء الأطفال المهجورين... لم يسعني إلا أن أتساءل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: لو كنت استمعت إلى أمي، هل كنت سأصبح مثل هؤلاء الآباء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: ولهذا السبب قررت مساعدة كل طفل هجره أهله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: وهل تعلم الجزء الأسوأ؟ أحد مُشعلي الحرائق كان والد طفل رعيته...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (لا تستطيع المرأة حبس دموعها مرة أخرى)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: سامحني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: لقد... حاولت أن أمنحهم حياة كريمة. كنت أهتم بهم. ما كان ينبغي أن تنتهي الأمور هكذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: آسفة جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: لا ذنب لكِ في موتهم
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: يؤسفني ما حدث لهؤلاء الأطفال
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: ربما تكون على حق، ولكن... لا أزال أشعر بالفراغ في داخلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: أتعلم، هناك فكرة لا أستطيع التخلص منها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: ماذا لو لم يشعر آباؤهم تجاههم بأي شيء منذ البداية؟ لم يحبوهم قط؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: آمل أن أكون قد منحتهم القليل من الحب على الأقل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: شكرًا لك... مع أنني ما زلت أشعر بالحزن الشديد. بصراحة، لا أعتقد أنني سأتعافى من هذا أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: أتعلم، هناك فكرة لا أستطيع التخلص منها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: ماذا لو لم يشعر آباؤهم تجاههم بأي شيء منذ البداية؟ لم يحبوهم قط؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: آمل أن أكون قد منحتهم القليل من الحب على الأقل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: وصلت القطقوطة. لا ينقصك أي شيء الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: لماذا أنتِ هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: يا له من سؤال غبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: فتحت بابك. اسأل نفسك: ما الغرض من وجودي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: الأمر سيان بالنسبة لي. كل الأماكن متشابهة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: قالوا لي اذهبي إلى هنا، فذهبت إلى هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: لا أريد أي شيء. ولا حتى أنت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: لا يهمني إلا توفير مكان مريح لقطقوطة. أما الباقي لا يهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: وصلت القطقوطة. لا ينقصك أي شيء الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: هل أنتِ بشر أصلًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: ماذا عنك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: ماذا بقي من بشريتك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: ما الذي يجعلني أسوأ منك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: وصلت القطقوطة. لا ينقصك أي شيء الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: من أرسلكِ إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: فعلت ما كان عليك فعله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: هل تعرف شيئًا عن الراحة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: حسنًا. أرسلني شيء... شخص ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: ولكن لم يقل لي ماذا أفعل بعد ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: وصلت القطقوطة. لا ينقصك أي شيء الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: كم من الوقت تنوين البقاء هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: حتى يأتوا ليأخذوني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: ماذا عليّ أن أفعل غير ذلك؟ هممم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: لا أعلم. أخبروني بأشياء، والآن أنتظر حتى يخبروني بالمزيد من الأشياء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: مَن يخبرك بالأشياء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: مَن تنتظر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: وصلت القطقوطة. لا ينقصك أي شيء الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: لمَ لم تقتليني؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: أنت غبي، أتعلم هذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: نفس الشيء كل يوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: أقول لك. لم يخبروني بشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: أنا منتظرة. لماذا تنتظر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: الجو خانق هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: هل أنتِ بخير؟ كيف حال الطفل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: هممم؟ أوه، إنه... متعب مثلي. وهو أيضًا خجول من الغرباء، لذا تراه يتشبث بي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: يجد الأطفال صعوبة في التعامل مع أمور كهذه. قد لا يشتكون، لكن ذلك واضح على وجوههم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: أحيانًا أشعر أن الخطأ مني لأنني أقحمتهم في كل هذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: لكن فات الأوان لتغيير أي شيء الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: هيا يا عزيزتي. لا داعي للتذمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: لماذا كنتما في الشارع؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: دعني أفحصكما
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: أوه، كنا في طريقنا لزيارة والدة زوجتي العزيزة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: لقد أدركنا في الوقت المناسب أننا لن نتمكن من تحقيق ذلك بمفردنا، وبالفعل، عثرنا على مكانك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: شكرًا مرة أخرى على السماح لنا بالبقاء!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: هيا يا عزيزتي. لا داعي للتذمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: ما مدى بُعد وجهتكما؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: دعني أفحصكما
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: زوجتي العزيزة لا تعرف الاتجاهات الصحيحة لوجهتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: إذا لم نتمكن من العثور على شخص لمساعدتنا فمن المحتمل أن تكون مدة الرحلة يومين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: وهذا بعد أن ضللنا الطريق عدة مرات ونحن نحاول تحديد الاتجاه الصحيح. ها! صحيح يا زوجتي العزيزة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: لو كان بإمكان أحد أن يوصلنا، فسيكون ذلك رائعًا. عندها ستستغرق الرحلة ساعتين على الأكثر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: لماذا تريد زيارة والدتها الآن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: التوقيتات التي ذكرتها غير منطقية
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: مَن يدري ماذا حدث لها في هذه الظروف الصعبة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: هاتفها مغلق أيضًا. لم نتمكن من الاتصال بها منذ أيام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: ماذا لو احتاجت إلى مساعدة؟ علينا التأكد من أنها بخير!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: الليالي أقصر بكثير هذه الأيام. والمشي في الشوارع مرعب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: لكن لا تقلقي. سنرى أمكِ قريبًا يا زوجتي العزيزة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: لكن لا أتذكر كيف أصل إلى هناك، وزوجتي لا تجيد تحديد الاتجاهات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: لكن لا بأس. المهم هو أننا نتقدم للأمام، أليس كذلك يا زوجتي العزيزة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: ومَن يدري، ربما نصل بعد أسبوع! هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: هيا يا زوجتي العزيزة. لا داعي للتذمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: اعتقدت أنكما ستغادران الليلة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: دعني أفحصكما
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: كانت هذه هي الخطة، لكن زوجتي العزيزة استغرقت ثلاث ساعات كاملة للاستعداد. فات الأوان للمغادرة الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: علينا الانتظار لبعض الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: نأسف لذلك. سنكون أسرع في المرة القادمة، لا تقلق!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: سأتأكد من أن زوجتي العزيزة الكسولة لن تؤخرنا مرة أخرى. هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: إلا إذا كنا ضيفين غير مرغوب فيهما؟ ستخبرنا بذلك، صحيح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: هيا يا عزيزتي. لا داعي للتذمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: هل أنتِ بخير يا سيدتي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: دعني أفحصكما
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: إنها بخير، لماذا تسأل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: ليس لديها أي شيء لتقوله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: كما أنها متوترة بعض الشيء، لا داعي للقلق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: وجّهت سؤالي لها
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: وكيف حالكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: نعم، وقلت لك إنها مُتعبة. لا تُرهقها بأسئلتك من فضلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: سنرحل في أسرع وقت بعد أن تُسرع هذه الكسولة بعض الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: بصراحة، أشعر بأنها ربما لم تعد مهتمة بأمها... لكننا سنصل إليها على أي حال!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: إن كانت على قيد الحياة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: هيا يا عزيزتي، أسرعي. إلى متى ستجعلينني أنتظر؟ سحقًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: آه، كل شيء على ما يرام، إلى حد ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: بدأت أشعر أن هذه المرأة لم تعد تهتم بأمها بعد الآن، هاها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: ربما يجب أن أذكّرها بالخطر الذي قد تتعرض له أمها، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: آسف لأنك اضطررت إلى سماع ذلك. إنها تثير جنوني بتباطئها الشديد في كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: اجلسي في مكانكِ واستعدي للرحيل! لقد سئمت الانتظار! تبًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: هيا يا زوجتي العزيزة. لا داعي للتذمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: زوجتك لا تريد الرحيل. ما الذي يجري بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: دعني أفحصكما
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: ما يجري هو أنها تثير غضبي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: دائمًا تتذمر وتلقي اللوم عليّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: ما الصعب في أن تصمت وتنفذ ما أقول؟ لماذا لا يمكن أن تكون الأمور بهذه البساطة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: أنا آسف لأننا أطلنا البقاء. هذا هو اليوم الأخير، بعدها سنرحل من هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: هل تسمعينني؟ جهّزي أمتعتكِ. إن بقينا هنا حتى الغسق، فأقسم إنني سأرميكِ من النافذة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: هل أنتِ متأكدة أنكِ بخير يا سيدتي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: ما الذي يجري بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: هذا ليس من شأنك. أخبرتك مسبقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: كُف عن التدخل في الأمور التي لا تعنيك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: سنتعامل مع الأمر بأنفسنا، اهتم بأمورك الخاصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: سئمت من هرائك. أخبرني بالحقيقة الآن
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: المهم، هل سترحلان أم لا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: اهدأ يا رجل، قلت لك إن كل شيء على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: زوجتي... تشعر بالملل وحسب، لذا تتصرف بتلك الطريقة. هذا يثير غضبي أحيانًا، لا أكثر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: ماذا تريد مني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: سئمت من هرائك. أخبرني بالحقيقة الآن
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: المهم، هل سترحلان أم لا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: اهدأ قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: أحمل سلاحًا أيضًا. إذا حاولت القيام بأي شيء متهور، سأطلق النار عليها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: ليس لديّ ما أخسره. أما أنت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: ستموت على كل حال
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: لا يزال بإمكانك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: نعم، نعم، لا تُزعج نفسك يا صاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: سنرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: هل تسمعينني؟ هذه ليلتنا الأخيرة هنا، فتوقّفي عن التأخير واستعدي للرحيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: ماذا سأخسر؟ ستقتلني، ثم ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: على الأقل ستنتهي معاناتي، وتموت هذه العاهرة معي. كل شيء سيصب في مصلحتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: سأطلق النار
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: لنهدأ قليلًا. ألقِ السلاح وسأفعل الشيء نفسه.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: لماذا؟ أريد أن أغادر معها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: لن أرحل إذا لم ترحل معي. لذا ضع سلاحك جانبًا وسنغادر بيتك الليلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: لا ينبغي لأحد أن يتعرض للأذى هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: سأطلق النار
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: لنهدأ قليلًا. ألقِ السلاح وسأفعل الشيء نفسه.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: هل ستقتل امرأة بريئة حقًا؟ ألا يهمك أمرها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: تعلم أنه إذا أطلقت النار عليّ، فستصيبها أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: وعندها لن يكون خطئي! دمها سيكون في رقبتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: أطلق النار
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: حذّره
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: عليّ الرحيل من هنا. وإلا كلانا سنموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: ليس هناك خيار آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: لو أن تلك الحمقاء أسرعت قليلًا ورحلت معي منذ البداية...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: هذا خطؤكِ. نعم أنتِ أيتها الغبية. لقد أفسدتِ كل شيء!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: أطلق النار
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: حذّره
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: أنت... هل ستترك سلاحك أم ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: مهلًا، لا، هل ستطلق عليّ النار حقًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: انتظر! توقف!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: سنرحل عن هنا، اتفقنا!؟ لنهدأ كلنا للحظة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: أليس كذلك؟ سنرحل هذه المرة يا حمقاء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (تتحرر المرأة فجأة. ويطلق عليها الرجل النار)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (تتفاعل على الفور وتطلق النار على الرجل وتصيبه في رأسه)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: (يبدو أن كليهما مات... على الأقل انتهى الأمر)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: (يا لهما من مجنونين...)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: حسنًا، سنرحل. دعنا نأخذ شيئًا لنغطي به أنفسنا ونرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: لن ترانا مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: مهلًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: ماذا ستفعل!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (تطلق النار على الرجل وتصيب المرأة أيضًا)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (كلاهما يسقط على الأرض، وينزفان)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (تئن المرأة للحظات، لكنك لا تستطيع مساعدتها)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (كلاهما مات)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: ألا تفهم؟ هذا هو الخيار الوحيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: سنرحل وتنتهي القصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: هيا، أحضري بطانية الآن. لنرحل من هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (تراهما يلتحفان بالبطانية ويغادران المنزل)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: (يمشيان لفترة قصيرة، ولكن فجأة يسقطان)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: (يبدأ الدخان بالتصاعد من البطانية. وبعدها تدير ظهرك)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: آآخ، لقد سئمت كل هذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: لماذا تتجولين وحدكِ في الخارج؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: حسنًا... كان المنزل ضيقًا. وصاخبًا للغاية. بلا أي مظاهر راحة. لذا أردت الخروج. أردت رؤية العالم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: لذا أخذت حقيبة ظهر، وبعض المشروبات الغازية، وبعض الوجبات الخفيفة، وسوار الصداقة القديم الذي صنعته في المدرسة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: ...وغادرت. ربما لم يلاحظ والداي ذلك. ولكن لا يهمني الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: منذ ذلك الحين، أتجول وأستقر أينما أستطيع. وبصراحة كل شيء على ما يرام حتى الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: ليس هناك من يراقبني على الأقل، وأنا المسؤولة عن نفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: آآخ، لقد سئمت كل هذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: وكيف نجوتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: بطريقة ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: كنت أتسلل إلى السلالم أو الأكواخ، أو أنام تحت شجرة. أختبئ من الحر تحت أي سقف أجده.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: أكلت كل ما استطعت الحصول عليه. بعض الخضراوات البرية أو قطع حلوى سرقتها من متجر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: ما هذه النظرة؟ أجل، لقد سرقت. كيف لي أن أعيش من دون سرقة الطعام؟ لن يوظفني أحد ويعطيني راتبًا على كل حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: آه، بمَ تفكر؟ أتعتقد أنني سأسرق منك شيئًا حقًا؟ هاها.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: ماذا؟ هل هذا استجواب؟ توقف عن ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: آآخ، لقد سئمت كل هذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: كم من الوقت تريدين العيش بهذه الطريقة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: ولماذا تهتم؟ سأجد حلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: وإلا ماذا ستفعل؟ هل يصعب عليك أن تسمح لي بالبقاء؟ هل سرقتُ منك؟ هل أتلفتُ المرحاض مثلًا؟ لماذا تزعجني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: ...أوه ...أنت أحد هؤلاء الأوباش.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: التقيت بشخص مثلك. تحدّث معي بلطف، ومنحني مكانًا لأعيش فيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: شاهدنا معًا الأنمي والأفلام، وما إلى ذلك. اعتقدت أنني وجدت أخيرًا شخصًا أثق به. لكن لااااا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: ...لقد حاول لمسي. حيوان قذر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: جرّب فعل هذا، وأعدك أنها ستكون نهايتك. لن أسمح لأحد أن يؤذيني.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: ربما كان والدي مغفلًا، لكنه على الأقل علمني كيفية القتال.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: أعني ما أقول. ابتعد عني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: آآخ، لقد سئمت كل هذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: وماذا حدث لذلك الرجل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: لماذا تريد أن تعرف؟ هل تفكر في طرق للتعامل معي إذا قاومتك؟ هاه؟ هاه؟ ...لا يهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: لستُ غبية. فأنت لا تسأل من باب اللطف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: لا تريد حدوث مشاكل في بيتك، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: لا أتسبب في حدوث أي مشاكل. فأنا لا أسرق، ولا أُحطّم النوافذ - لذا كف عن ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: وبالمناسبة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: أنا هنا لأنك بحاجة إليّ، صحيح؟ حتى لا يخطفك ذلك الرجل نصف العاري؟ نعم، أعرف ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: إذا كان الأمر هكذا، فـ... آه، لا بأس! افحصني بطريقتك المُخيفة، لكن لا تكلّمني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: آآخ، لقد سئمت كل هذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: لماذا علمكِ والدكِ القتال؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: حتى أتمكن من ضرب الأوباش... أو حتى يتمكن من التنفيس عن غضبه الشديد عليّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: لكمة تلو الأخرى، المشكلة الوحيدة هي أنه بدلًا من كيس الملاكمة، كان يستخدم وجهي.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: لكن أحيانًا كان الأمر بمثابة تدريب لي، وهو ما كنت أكرهه بالمناسبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: في أحيان أخرى، كان يفقد أعصابه ويضربني ضربًا مبرحًا. وأمي؟ لم تُعر أي اهتمام. حتى أنها لم تنظر إلينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: أوه، لا أريد أن يكون مصيري مثلهما.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: لماذا أبقى معهما إذا كانا سيعاملانني بهذه الطريقة؟ لا أفهم. هل هذه هي الحياة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: والآن، علينا التعامل مع الشمس والزوار؟ رائع. أمور أخرى تجعل الحياة أسوأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: هل سيحدث أي شيء جيد على الإطلاق؟'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: أشك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: كل شيء سيكون على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: أما زلت متفائلًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: ليس متفائلًا تمامًا... لكنني لم أنهر من الضغوطات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: لا نزال بشرًا. ولا نزال صامدين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: نحن لا نجعل الكارثة أسوأ مما هي عليه بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: وعندما ينتهي كل هذا... أعتقد أننا سنكون قادرين على مسامحة بعضنا بعضًا على الأشياء التي فعلناها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: ما دام هناك رحمة، هناك إنسانية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: هل تتفق معي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: كل شيء سيكون على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: هل أنت دائمًا هكذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: أتعلم... لا. ليس دائمًا. كنت سريع الغضب في الماضي. من الناس، ومن العالم، ومن نفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: كنت أغضب على كل شيء، وأغلق الأبواب بقوة حتى أكسر إطارها. لكن في مرحلة ما، أدركت أن الغضب لا يفعل شيئًا سوى التدمير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: تدمير الروح. وتدمير كل شيء حولك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: ذات مرة... هاجمت شخصًا أراد مساعدتي. والآن... رحل.. أقصد رحلت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: تلك اللحظة كسرت شيئًا بداخلي. عرفت أنني يجب أن أتغير، وإلا سأدمر كل ما حولي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: لذا تعلمت أن أتسامح. أن أتنفس. أن أكون مسالمًا. هكذا وصلت إلى عقليتي الحالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: كل شيء سيكون على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: ماذا فقدت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: عائلتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: احترق منزلنا وأنا خارجه، ولم أغب إلا دقيقة واحدة لأحضر بعض الماء. ثم عدت لأجد الدخان والرماد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: واستغرقت وقتًا طويلًا لأتقبل الأمر. ظللت أسأل نفسي: لماذا غادرت في تلك اللحظة؟ لماذا لم أستطع إنقاذهم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: لكن ربما ليس هذا هو المهم. ربما لا يتعلق الأمر بإنقاذ الماضي، بل بتقبله وحمله في قلبك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: فهم لا يزالون معي، إلى حد ما. ذكراهم تمنحني القوة. لهذا السبب أحاول مساعدة الناس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: أعرف معنى فقدان كل شيء. وأعرف معنى إيجاد مغزى للحياة بعد انهيار حياتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: كل شيء سيكون على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: وتستطيع التعايش مع هذا؟ بعد أن فقدت عائلتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: نعم، لقد تجاوزت الأمر، ولكن ذلك لم يكن سهلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: ألقيت اللوم على نفسي. وظللت أفكّر، لو عدت أسرع بدقيقتين، لربما كان الأمر مختلفًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: لكن الحزن يزيد الشعور بالذنب. والحياة... الحياة تحتاج إلى الغفران. أدركت أنني سأخسر نفسي إن لم أتقبل ما حدث وأتجاوزه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: هذا ما أنقذ حياتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: سامحت نفسي لعدم قدرتي على تغيير الماضي. وسامحت القدر، مهما كان قاسيًا، لأن الغضب كان يجرّني إلى الهاوية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: كل شيء سيكون على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: ما دافعك الآن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: أؤمن بأن بإمكان الناس أن يكونوا أفضل. حتى في هذه الظروف الصعبة، هناك دائمًا فرصة للتعافي منها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: لا أؤمن بالمعجزات أو العناية السماوية. أؤمن بالناس، وبدعمنا لبعضنا بعضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: نساعد المحتاجين. نبتسم حتى في أسوأ الأيام. نشارك آخر ما تبقى لنا من طعام. هذه هي الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: التفاصيل الصغيرة تصنع الفارق. وفي كل مرة يجعل فيها أحدهم العالم أفضل ولو قليلًا، أعلم أن كل هذا لم يكن هباءً.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: كل شيء سيكون على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: هل تتمنى استعادة كل شيء - منزلك، وعائلتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: لو كان بإمكاني رؤيتهم مرة أخرى... والتحدث إليهم، ومعانقتهم... بالطبع سأفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: لكن استعادة كل شيء؟ لست متأكدًا. الخسارة جزء من الحياة. إنها مروعة ومؤلمة، لكنها جزء من شخصياتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: لا تسئ فهمي، فأنا مستعد أن أفعل أي شيء تقريبًا من أجل قضاء يوم آخر معهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: ولكن إذا كان هذا يعني التخلي عما تعلمته - مثل كيفية التسامح ومواصلة الحياة... إذن، لا، لن أفعل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: وقتنا محدود. من الأفضل التمسك بما لدينا الآن بدلًا من أن نغرق في ما فقدناه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: ابقَ منتبهًا. أيّ واحد منّا قد يكون زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: أنت صيّاد، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: حارس، يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: عشت في البرية. لم يكن لديّ تلفاز، فقط راديو. وهكذا عرفت ما كان يحدث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: قررت ألا أسمح لأحد بتجاوز عتبة بابي. فبيتي هو حصني الحصين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: ماذا لو كان أحدهم زائرًا؟ يكلّمني بلطف، ثم يذبحني وأنا نائم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: لماذا أنت هنا إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: ليس من الآمن أن تكون بمفردك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: لن أسمح لهذا الوحش الكاسر أن يلمسني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: إنه السبب الذي جعلني أترك كوخي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: أجل، أستطيع رؤية ذلك في عينيك. لقد رأيته أيضًا، أليس كذلك يا بني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: كيف تمكنت من البقاء على قيد الحياة وحدك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: هل رأيت الزائر الطويل الشاحب أيضًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: حسنًا، لقد توصلت إلى شيء ما يبقيني على قيد الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: لكنت طعامًا للديدان الآن لو لم أفعل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: كنت أعتقد أنه من الغباء السماح للغرباء بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: أدركت أنني كنت أكثر أمانًا بمفردي... ثم ظهر ذلك الوغد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: لم أرَ وحشًا مثله قط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: كيف تمكنت من البقاء على قيد الحياة وحدك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: هل رأيت الزائر الطويل الشاحب أيضًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: إنها قصة طويلة جدًا يا بني. لا أرغب في سردها اليوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: أحضر لي جعة غدًا، وسأخبرك بكل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: هذا يعني أنني لست الوحيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: نعم... لقد رأيته...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: لو كنت تعرف ما مررت به يا فتى...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: سأخبرك عن ذلك... ولكن ليس الليلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: أحضر لي جعة غدًا، وسأخبرك بكل التفاصيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: ابقَ منتبهًا. أيّ واحد منّا قد يكون زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: ما قصتك إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: هل أحضرت الجعة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: نعم (أعطه الجعة)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: ألم تحضر جعة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: لا (لا تعطه الجعة)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: شكرًا يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: كما قلت، كنت محبوسًا في الكوخ، منعزلًا عن الآخرين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: وفي يوم ما، ظهر هذا الرجل، يائسًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: بدأ يطرق الباب، ويتوسل إليّ للسماح له بالدخول. لكنني لم أرغب في ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: كان شاحبًا ويرتجف، كما لو أنه رأى الموت أمامه. لا أعرف كيف وصل إلى هذا العمق في الغابة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: لم يبدُ مثل أي متجول غابات رأيته من قبل، لذلك طلبت منه أن يرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: حاول كسر النافذة، لكنني أخبرته بأنني أمتلك بندقية، وركض الحيوان بعدها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: اعتقدت أن هذه ستكون المرة الأخيرة التي أراه فيها...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: ربما كان عليك مساعدته
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: كان عليك السماح له بالدخول
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: وماذا حدث بعدها؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: ويجلب ما كان يطارده مباشرة إلى بابي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: لا يا ذكي. لديّ ما يكفيني من المشكلات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: حسنًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: أنت قليل الكلام، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: لم تخبرني بالكثير من التفاصيل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: دعني أخمن. هل ستكون أكثر انفتاحًا إذا أحضرت لك جعة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: لا تتظاهر بأنك بطل يا بني. أراهن أنك رفضت دخول البعض أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: وإلا كيف ستنجو كل هذا الوقت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: نعم، ولكن هذه قصة الغد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: حسنًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: أنت قليل الكلام، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: لم تخبرني بالكثير من التفاصيل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: دعني أخمن. هل ستكون أكثر انفتاحًا إذا أحضرت لك جعة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: كنت متأكدًا أنني لن أرى أي أثر له مرة أخرى. لكنه... عثر عليّ لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: سأحكي بقية القصة في وقت لاحق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: حسنًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: أنت قليل الكلام، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: لم تخبرني بالكثير من التفاصيل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: دعني أخمن. هل ستكون أكثر انفتاحًا إذا أحضرت لك جعة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: أحضر لي بعض الجعة غدًا يا فتى... وسأكمل القصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: لستُ ثرثارًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: هذا يوم سعدك لأنني أحكي قصصي لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: أحضر لي جعة غدًا، وسأخبرك بالبقية. اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: اصبر يا فتى، لقد رأيت الكثير من الأمور...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: وليست أمور من النوع الذي أريد أن أتذكره بحلق جاف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: أحضر الجعة وسنكمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: أنت ذكي يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: لا أتحدث إلا للضرورة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: لذا أحضر لي جعة غدًا، وسأخبرك بالنهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: آسف يا فتى، لكنني لن أتحدث من دون جعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: أحضر الجعة وسأتكلم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: ابقَ منتبهًا. أيّ واحد منّا قد يكون زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: كيف انتهت القصة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: سأخبرك بعد أن تحضر لي الجعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: بالطبع (أعطه الجعة)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: ألم تحضر جعة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: لا (لا تعطه الجعة)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: أشكرك يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: هرب الرجل، وبقيت في الكوخ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: لكن بعد ذلك نفد الحطب. واضطررت إلى الخروج وإحضار بعض الحطب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: جمعت بعضه، وعدت...وكانت بندقيتي قد اختفت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: لقد أغضبني ذلك جدًا، ومزّقت المكان بأكمله، لكن لم أجد أي أثر له.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: حينها رأيته خارج النافذة. نفس الرجل الذي رأيته سابقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: رأيته يحمل بندقيتي... لكنه تغير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: صار أطول. جلده مترهل. عارٍ، لا يرتدي أي شيء سوى بنطال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: أخذ البندقية بكلتا يديه... وكسرها كما لو أنها لم تكن أكثر من حطب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: ثم وقف هناك، يحدق بي. كأنه ينتظرني أرمش... ليكسر رقبتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: لكنه لم يفعل. واصل المشاهدة... كما لو كنا في تحدي تحديق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: وبعد ذلك... بزغ الفجر، واختفى الحقير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: حينها أدركتُ - البقاء وحدي، بلا سلاح؟ يعني موتًا محققًا يا بني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: لذا نهضت وغادرت المكان. انطلقت قبل أن تشرق الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: وهكذا وصلت إلى هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: أتمنى أن تحصل على فرصة سحب الزناد، يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: من يدري، ربما تنجح الرصاصات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: لماذا لم يقتلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: أتعتقد أن من الممكن قتله؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: لقد قتل فرقة كاملة بنفسه
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: لا أعلم يا بني، لقد كسر بندقيتي كما لو أنها لم تكن شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: بالتأكيد كان بإمكانه أن يفعل الشيء ذاته بي في لحظة... لكنه لم يفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: ربما يستمتع باللعب بنا، كالقط والفأر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: كما تعلم، لا أخشى شيئًا. لكن ذلك الحقير الشاحب؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: إنه يخيفني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: أتمنى ذلك يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: كما يقولون... "إذا كان ينزف، فيمكن قتله".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: اللعنة... إذا لم تتمكن فرقة كاملة من القضاء عليه... فلن يكون لدينا أي فرصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: يمكنه تدمير هذا المكان اللعين بأكمله بكل سهولة إذا أراد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: كما تعلم، لا أخشى شيئًا. لكن ذلك الحقير الشاحب؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: إنه يخيفني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: لن أحكي شيئًا بلا جعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: لكنني لن أتحدث من دون جعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: إذا كنت تريد سماع الباقي... أحضر لي جعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: أتمنى لو كان هناك القليل من الدفء...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: ألن تخلع السترة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: نعم، هناك فكرة واحدة تخيفني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: ماذا يحدث لو خلعتها؟ لا أستطيع إيجاد الدفء حتى في الأجواء الحارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: إذا خلعت السترة، هل سأموت من البرد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: أو أسوأ من ذلك. هل سأظل على قيد الحياة وأشعر ببرودة أكبر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: هل تتعرقين تحتها؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: ألا تستحمين إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: لـ-لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: الجسم يتعرق ليبرد نفسه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: ...ولكن جسمي لا يحتاج إلى أي برررودة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: لن أجيب عن سؤالك. آ-آسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: أتمنى لو كان هناك القليل من الدفء...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: هل لديك أي أفكار حول ما يجب فعله بشأن درجة حرارتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: هممم... لا أعتقد أنه يمكن تغيير ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: الحمام الساخن يُحرقني، ولا أشعر بأي دفء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: أتدري...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: خطر لي مجاز يصف حالتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: تخيل فضاء فارغ. شاسع ومجـ-مجمد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: تولد المجرات وتموت النجوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: ...بينما أتابع في صمت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: لن أشعر أبدًا بحرارة الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: أو دفء الأ-الأحضان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: لا الفضاء يحتاج إليّ ولا المجتمع، على ما يبدو...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: أتمنى لو كان هناك القليل من الدفء...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: قلت إن لديك شيئًا لتكشفه عندما التقينا. ما هو؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: هممم... لا أظن أنني أريد التحدث عنه الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: هناك شيء ما يدور في ذهني منذ فترة. ربما يكون هذا سبب شعوري بـ... البرررررد القارس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: أكره أن أطرح هذا الموضوع، لكنه قد يقتلني من الداخل إذا لم أفعل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: أنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: سأخبرك غدًا. سأكون جاهزًا حينها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: أتمنى لو كان هناك القليل من الدفء...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: ما الذي تخفيه؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: نعم. أردت إطلاعك على سررررر مهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: أعتقد أنني مستعد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: عادة ما تنتهي الأمور بشكل سيء، لكن ربما لن يحدث ذلك هذه المرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: أعتقد أن ما يوجد تحت هذه الملابس هو سبب شعوري بالبررررد والوحدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: انظر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: لا... ليس مجددًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: ماذا فعلت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: انتهى أمرك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: لم أقصد ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: اعتقدت أن الأمر سيكون مختلفًا هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: ولكنه لا يتغير أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: لم أررررغب في ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: أقسم لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: أطلق النار
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: اطرده
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: هذا نفسه ما حدث من قبل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: لماذا اعتقدت أن هذه المررررة ستكون مختلفة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: لا تتهور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: لم أفعل هذا من باب الشر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: لم تكن هذه نيتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: أطلق النار
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: اطرده
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: ربما هذا أفضل لكلينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: لا مزيد من البررررد. لا مزيد من الوحدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: أنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: لا أعتقد أنني فعلت هذا عن قصد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: الرصاص سيكون رحمة. لكن للأسف، ما زلت أشعر بالألم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: الشمس ستستغرق وقتًا أطول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: هل يمكنني البقاء حتى حلول الليل على الأقل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: ارحل الآن
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: لا بأس، لكن لا تتسبب في حدوث أي مشاكل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: مفهوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: أنا آسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: ربما تُدفئني الشمس. لمرررة أخيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: شـ-شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: أعلم أنك تكرررهني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: أنا آسف. ليس هذا ما أردته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: وأيضًا... اممم... ربما يمكنك دعوة صديقتي من فضلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: عندما يدعوها الكبار، سيسمحون لها بالمجيء... ولكن إذا كنت أنا، فإنهم يوبخونني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: أعتقد أن هذا رقم هاتفها: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: يا عزيزي... من فضلك لا تدع أحدًا يدخل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: لماذا طردتكِ الوكالة الفيدرالية؟ لماذا لم يتحدثوا معكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: أتمنى لو كنت أعرف يا عزيزي، هؤلاء الرجال ذوو البدلات... لا أفهمهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: دائمًا يتجولون ويعطون الأوامر...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: من يظنون أنفسهم على أية حال؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: أعتقد أنهم لا يعرفون شيئًا، إنهم يتصرفون بغطرسة وغرور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: هل كانوا يطرقون بابك أيضًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: نعم
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: يتجول أحدهم باستمرار في هذا المكان
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: اللعنة! أود أن أمزق بدلاتهم وألقيهم في أقذر سلة قمامة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: دعهم يرون كيف تكون الحياة بين الناس الحقيقيين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: هل صاروا يستولون على المباني الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: عديمو الأخلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: مرة واحدة كافية. لكن أن يعود مرارًا وتكرارًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: لا أخلاق على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: يا عزيزي... من فضلك لا تدع أحدًا يدخل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: هل أخذوا أحدًا من عائلتكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: أوه، لم يسألني أحد عن أطفالي منذ فترة طويلة يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: إنهم ينادونني بـ "ماما نونا"، وقد ربيت عددًا كبيرًا منهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: أحبهم كثيرًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: البيت ليس كبيرًا بما يكفي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: خلف تلك الأبواب المغلقة، هناك أرواح صغيرة مسكينة مختبئة بعيدًا عن هؤلاء الأشخاص الأشرار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: لم تجيبي على سؤالي
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: هل أخذوا عائلتكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: أوه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: لقد نسيت الكلام للحظة يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: أولئك الأوغاد ببدلاتهم خطفوا مني كل أطفالي، واحدًا تلو الآخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: لكنهم لن يفلتوا بفعلتهم، أعدك بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: هل أخذوا أحدًا منك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: ليس لديّ عائلة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: أوه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: لقد استرسلت بعض الشيء يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: أولئك الأوغاد ببدلاتهم خطفوا مني كل أطفالي، واحدًا تلو الآخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: هل أخذوا أحدًا منك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: ليس لديّ عائلة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: لا؟ إذن لماذا منزلك كبير جدًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: تعيش هنا بمفردك يا حبيبي... هذا ليس صوابًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: المنزل الكبير يعني عائلة كبيرة، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: حسنًا، لن أتطفل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: أتمنى فقط أن أستطيع إعادة أطفالي من مناطق الحجر الصحي تلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: لم يمسّوك، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: إذن أين أطفالك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: مكان بهذه الضخامة لم يُشيَّد ليسكنه فرد واحد'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: حسنًا، لن أتطفل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: كل ما أريده هو إخراج أطفالي من مناطق الحجر الصحي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: يا عزيزي... من فضلك لا تدع أحدًا يدخل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: كيف تخططين لاستعادة عائلتكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: لن أفعل ذلك! سيتدبرون أمورهم بأنفسهم يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: ماذا تعنين؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: بأنفسهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: قد يتمكنون من الزحف عبر الوحل... حتى الوصول إلى الجانب الآخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: لن تكون الأسوار والأسلاك عائقًا أمام أطفالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: وإذا لم يأتوا من الأسفل، فسيمزقون تلك المنطقة إربًا. إنهم بارعون.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: إنهم قادمون الآن. ماما نونا متأكدة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: عمَ تتحدثين بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: هل جننتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: ماذا تعنين؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: ستسقط جدرانكم جميعًا عندما يحين الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: سيكون هناك موت، الكثير من الموت... ثم سيأتي، متعطشًا للموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: أولئك الرجال ذوو البدلات لن يهتموا بأمر أولادي بعد الآن. سيكون لديهم أمور أكبر وأخطر تشغلهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: إنهم قادمون الآن. ماما نونا متأكدة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: عمَ تتحدثين بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: هل جننتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: ماذا تعنين؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: سنقوم بتدمير هذه الأوكار التي بنيتموها...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: ستتحطم الجدران... وستتحول الشوارع إلى بحر من الدماء... سنبني جبالًا من جثثكم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: أسمعهم يزحفون الآن. كادوا يصلون...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: ماذا يعني ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: من أنتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: هل أنتِ من الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: رائحة اللحم المحروق جميلة جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: للبدلات مذاق لذيذ بعد الطهي. تكون مقرمشة قليلًا، لكنها ليست سيئة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: ولديك جثث يا عزيزي. الكثير منها أيضًا. أطفالي سيأكلون جيدًا هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: أسمعهم يزحفون الآن. كادوا يصلون...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: ماذا يعني ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: من أنتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: هل أنتِ من الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: أعتقد أن هذا المكان مثالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: منزل كبير، لا يوجد فيه أحد تقريبًا. إنه يكفي... الجميع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: أسمعهم يزحفون الآن. كادوا يصلون...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: ماذا يعني ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: من أنتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: هل أنتِ من الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: اللعنة! أيها القذر!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: سيأتون للنيل منكم جميعًا...!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: يا أطفال، أمكم وجدت لنا عشًا جديدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: ازحفوا إلى هنا. لن يحتاج إلى هذا المنزل بعد الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: ماما نونا تريد رؤية أطفالها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: تعالوا إليّ، أعتقد أن هذا المنزل مناسب لنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: ازحفوا يا أطفالي. أمكم هنا! لقد وجدت لكم منزلًا جديدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: واسع جدًا. جميل جدًا. فارغ جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (اقتلها)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: اللعنة! أعطني إياه! أنتم جميعًا تكرهونه!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: أنتم جميعًا تريدون أن يحترق!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: أعط كل شيء لماما!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: يا عزيزي... أعرف ما تريد...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: ...الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: هل لدينا مشكلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: لماذا تنظر إلى الناس على أنهم حيوانات؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: دعني أسألك شيئًا. ما هي حقيقتنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: نحن نقتل. نأكل ما نقتله. ولا نندم على ذلك. هذا أمر طبيعي، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: لكن المجتمع، لقد وضعنا تحت السيطرة. ولحسن حظنا، تلك الأيام قد ولت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: ماذا تعني؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: هل أنت سعيد بما آلت إليه الأمور؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: الأمر بسيط حقًا. لقد حلت الحقائق الأساسية والمنطقية محل ما كان في السابق مجتمعًا لا معنى له.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: هناك قطيع، وهذا القطيع له زعيم. أي شخص يهدد القطيع؟ يموت. هذا قانون أتبعه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: لكن أسوأ شيء؟ الحمل في لباس الذئب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: هل تعتقد أن القطيع أفضل من المجتمع؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: أتقصد الذئب في لباس الحمل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: لا، يا أخي. أنا سعيد لأن الناس توقفوا عن الاختباء وراء الأقنعة، أتفهم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: لكن الخراف. الخراف تفسد كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: يرتدون جلود الذئاب ويتظاهرون بأنهم منهم. يزيفون غرائز الذئاب الحقيقيين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: يتسللون في التراب. ولا يجرؤون على خوض معركة عادلة، بدلًا من لعبة القط والفأر السخيفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: ولكن إذا قمت بتكوين قطيع خاص بك، نعم؟ عندها تكون قد تعلمت كيفية اكتشاف المزيفين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: هل تعتقد أن القطيع أفضل من المجتمع؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: أتقصد الذئب في لباس الحمل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: ألا تعتقد ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: في المجتمع "العادي"، ما كنت لتكشف أيًا من الخراف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: الكثير من المزاح العقيم، الكثير من القواعد. ستنشغل بالجدال بدلًا من فعل ما يلزم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: لهذا السبب فإن وجود قائد القطيع أمر حيوي. لا وجود للأسئلة، ولا التصويت. هو يأمر، وأنت تنفذ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: الزعيم لا يظهر ضعفه. حتى تنجو المجموعة. الأمر بهذه البساطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: لا، أنا أتحدث عن أولئك الجبناء الذين تسمونهم الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: كانوا يختبئون تحت الأرض مثل الفئران، ينتظرون أن تلين عواطفنا ونصبح ضعفاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: ثم يظهرون مستخدمين الأخلاق البشرية. يستغلون شفقتنا ليصعّبوا علينا قتلهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: نحن نكشف أنيابنا لسبب وجيه. نذكرهم بأننا الوحوش هنا، وإلا سيطردوننا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: هل لدينا مشكلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: لماذا تحدق في سلاحي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: أرى فيك شخصية قيادية. أراك تسيطر على الناس. وتظهر أنك المسؤول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: لديك منزل جميل وواسع. يزورك الناس كثيرًا. لكن ضيوفك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: ماذا عنهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: هل تعتقد أن بعضهم زوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: لقد جمعت أشخاصًا ضعفاء، أليس كذلك؟ أناس ضعفاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: أخبرني، ما فائدة كبار السن أو الصغار أو المرضى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: الأقوياء فقط يشكلون مجموعة قوية. هكذا تبقى على قيد الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: ماذا تريد مني أن أفعل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: تريدني أن أطردهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: لست قلقًا من الحملان المتنكرة في ثياب الذئاب، بل الذئاب الضعيفة التافهة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: مجموعتك لا تملك أي قوة أو شراسة. الناس يأتون ويذهبون كما يشاؤون.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: اختر الأقوى وابق معهم وإلا سيصبحون عبئًا ثقيلًا، الأمر بهذه البساطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: ماذا تريد مني أن أفعل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: تريدني أن أطردهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: حان الوقت للتخلص من الضعفاء يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: اقتلهم. علنًا. أثبت لهم أنك القائد هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: هكذا تفرض سيطرتك. وهكذا تُظهر لهم مَن له اليد العليا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: أي شخص لا يتأثر عندما يموت الضعيف... هو الذئب الذي تريده معك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: ويستحق البقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: لستُ قاتلًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: أنا أقتل الزوار فقط
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: اتركهم وشأنهم وستنهار سلطتك، سيصفونك بالضعيف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: الرحمة مجرد ضعف يتخفى وراء قناع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: يجب أن تكون قاسيًا. زائر؟ اقتله. ضعيف؟ اقتله. عجوز؟ اقتله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: هكذا تجعلهم يخافونك. هكذا تقودهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: لستُ قاتلًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: أنا أقتل الزوار فقط
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: على مَن تكذب يا عزيزي؟ أستطيع رؤية ذلك في عينيك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: أنت قاتل. قاتل بدم بارد أيضًا. لا تتظاهر بأن يديك نظيفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: كانت هذه الشوارع تحت قبضة يدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: كان الناس يخافونني. ويحترمونني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: هل تساءلت يومًا كم من الوقت يستغرق تعفن الروح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: روحي متعفنة منذ زمن بعيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: ذات يوم، رفض سائق تاكسي أن يقلني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: لو تركت ذلك الموقف يمر مرور الكرام، لما كان اسمي يعني شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: لذا كسرت كل عظمة في جسده.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: لكن ابنه تذكر هذا الدرس. واستمر الناس في احترامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: دعني أخبرك شيئًا. ستكون أفضل حالًا إذا توقفت عن تدليل الضعفاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: كانت هذه الشوارع تحت قبضة يدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: كان الناس يخافونني. ويحترمونني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: هل تساءلت يومًا كم من الوقت يستغرق تعفن الروح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: روحي متعفنة منذ زمن بعيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: ذات يوم، رفض سائق تاكسي أن يقلني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: لو تركت ذلك الموقف يمر مرور الكرام، لما كان اسمي يعني شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: لذا كسرت كل عظمة في جسده.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: لكن ابنه تذكر هذا الدرس. واستمر الناس في احترامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: هل لدينا مشكلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: أنت تستمر في الحديث عن القطعان والمجموعات. لماذا لا تمتلك قطيعًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: لماذا تمتلك قطيعًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: حتى لا يقتلني ذلك الزائر الطويل الشاحب
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: أحاول مساعدة الناس
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: أحب أن يكون هناك أشخاص حولي
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: لأن هؤلاء الناس بحاجة إلى قائد
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: وجّهت سؤالي أولًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: إذن، هل جمعتهم كلهم هنا لإنقاذ نفسك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: أنت لا تبدو كقائد. تبدو كجبان تافه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: هذا القطيع يحتاج إلى شخص قوي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: أعتقد أنني سأضطر إلى أخذ مكانك. أنت لست مؤهلًا لقيادة أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: هدف نبيل. لكنه غبي بعض الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: لا يمكنك إنقاذ الجميع. عاجلًا أم آجلًا، سيكون عليك رفض طلب أحدهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: لكنك تبدو كشخصية قيادية حقيقية. شخص قوي. لن أناقش قراراتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: هذا كل شيء؟ ألا تملك الشجاعة الكافية لتكون وحدك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: هذه ليست كلمات قائد. أنت مجرد حمَل آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: هذا ما يقوله الرجال الأقوياء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: سأكون أحمق إذا شككت في قيادتك الآن، أليس كذلك يا صديقي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: لن أجيب على هذا السؤال. من الأفضل ألا تعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: لقد أخبرتك بالفعل أكثر مما كان ينبغي. الآن حان دورك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: إذا لم تستطع قيادة القطيع، فسأقوم أنا بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: سحقًا لك!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: تعتقد أنك أفضل مني، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (اسحب سلاحك)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: اغرب عن وجهي قبل أن أطلق عليك النار
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: اهدأ يا صغيري. أنت في عداد الموتى بالنسبة لي الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: إذا كنت لا تعرف سبب قيادتك، فلماذا قبلت هذا الدور؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: ابتعد عن هنا، وإلا سأقتلك بنفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: أعرف ما هي القطعان. فأنا أعيش وفقًا لقواعدها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: إذا كنت بهذا الضعف، فأنت لست قائدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: ابتعد عن هنا، وإلا سأقتلك بنفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: إذن هذا هو قرارك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: أنت تعرف أنني أمتلك سلاحًا أيضًا، أليس كذلك؟ أيها الأحمق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: من الأفضل أن تضع سلاحك أرضًا يا صديقي. لننهِ هذا الأمر بشكل سريع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (أطلق النار عليه)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (أخفض سلاحك)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: مُت أيها الحقـ--'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: أيها المخادع اللعين... لقد أطلقت عليّ النار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: ...فتى مطيع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: لكن كان عليك إنهاء المهمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: (ينتهز الفرصة ويخرج سلاحه)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: (يصوب تجاهك)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: (لحسن الحظ، تمكنت من الإمساك بالبندقية وإطلاق النار)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: أسمعك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: ماذا حدث للمستشفيات؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: أووه... كان الأمر فظيعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: عندما بدأت الأمور تسوء، هرع الناس إلى المستشفيات. كان الجميع مهووسين بمعرفة ما إذا كانوا زوارًا أم لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: حاولنا أن نوضح أننا لا نعرف حقًا كيفية اختبار ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: لكن لم يستمع أحد لنا. استمروا في الدفع والتدافع، ما تسبب في استحالة علاج الذين كانوا مرضى بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: في النهاية، حضرت الوكالة الفيدرالية. و... قررت أن الحشود تشكل تهديدًا لاحتواء تفشي المرض...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: لذلك تم نقل جميع المرضى إلى مناطق الحجر الصحي، أما المستشفيات... فقد أغلقت أبوابها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: هل طردتك الوكالة الفيدرالية من عملك إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: يبدو أن الوكالة الفيدرالية قد اتخذت الإجراء الصحيح
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: لأكون صادقًا معك... بعد إغلاق المستشفيات أبوابها، ذهبت إلى أحد مراكز الفرز في إحدى مناطق الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: لمَ فعلت ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: إذن... أنت مجرد وغد آخر من الوكالة الفيدرالية
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: هل تعتقد أنه كان من الصواب جمع الناس بهذه الطريقة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: ألا تجد هذه "العلامات" المزعومة غريبة؟ أليست مجرد سمات بشرية عادية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: إنها هراء مطلق! الأسنان البيضاء تعني أن الشخص زائر؟ لا يوجد دليل منطقي على ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: أؤكد لك، الوكالة تخفي عنا شيئًا ما...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: لأكون صادقًا معك... بعد إغلاق المستشفيات أبوابها، ذهبت إلى أحد مراكز الفرز في إحدى مناطق الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: كنت آمل أن أتعلم شيئًا عن الزوار وعلاماتهم. لكن... للأسف لم أخرج بشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: لمَ فعلت ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: إذن... أنت مجرد وغد آخر من الوكالة الفيدرالية
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: لقد... أردت الاستمرار في مساعدة الناس. هذه مهمتي. لم أستطع التخلي عن غايتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: ربما... لا. اعذرني، لستُ مستعدًا للحديث عن ذلك الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: أنت لا تعرف القصة كاملة، وكلماتك تجرحني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: ربما... لا. اعذرني، لستُ مستعدًا للحديث عن ذلك الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: أسمعك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: إذن، ماذا كنت تريد أن تخبرني؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: هل لي أن أسألك عن رأيك في الوكالة الفيدرالية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: أعتقد أن الوكالة الفيدرالية تبلي حسنًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: لا أثق بها
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: يا للأسف. أنا عكسك تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: لقد عملت فيها لفترة من الوقت، لكن ليس لديّ أي سبب لأثق بها. خاصة بعد ما رأيته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: من واقع تجربتي الشخصية، فإن الأطباء في تلك المنظمة لا يعلمون شيئًا على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: هل تثق حقًا في منظمة لا تستطيع حتى تفسير مصدر هذه العلامات أو معناها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: بعد كل ذلك... كيف يمكنك أن تثق في الوكالة الفيدرالية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: يجب أن أعترف، لقد خاب ظني فيك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: رائع. أشاركك هذا الرأي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: بصراحة، أنا نفسي لا أفهم دوافع الوكالة الفيدرالية. حتى بعد العمل معها لفترة من الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: ولكن مهما كان دافعها، فقد اخترت مساعدة الناس بطريقتي الخاصة، خلافًا لقواعدها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: المشكلة كانت في الشفافية. لم تكن هناك أي شفافية على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: لم يتم إخبارنا من أين جاءت هذه "العلامات" أو ماذا تعني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: لقد أعطونا قائمة بالإرشادات وحسب. وأخبرونا كيف نعرف الزوار، ومن نسمح له بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: بعد ذلك، لم أعد أشعر أنني طبيب. بل أشبه بحارس حدود يختم الأوراق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: لذلك بدأت في تزوير التقارير. وساعدت الناس على الهروب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: أنا متأكد من أنك لا تزال لديك أسئلة. ولكن إذا لم تمانع، فلنترك البقية للغد.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: أنا آسف، لكنني لست مستعدًا للتحدث أكثر اليوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: ثم قررت مغادرة المنظمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: أسمعك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: كيف خرجت من مناطق الحجر الصحي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: كانت هناك... حادثة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: كانت الشمس قد بدأت تشرق. وكنت في طريقي إلى المنزل عندما ناداني أحد ضباط الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: في تلك اللحظة، بدأ قلبي يخفق بشدة، وكدت أسقط من التوتر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: صرخ في وجهي لأستدير... وعندها استسلمت لمصيري.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: صوّب بندقيته نحو ساقيّ وأمرني ألا أتحرك. ظل يحدق بي، ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: طلب مني أن أخرج لساني، للتأكد من أنني لست زائرًا. ...وفعلت ذلك، خوفًا من أن يطلق عليّ النار إذا لم أفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: ثم... ضحك. وقال إنني لابد أن أكون طبيبًا دجالًا إذا كنت لا أعرف حتى أن اللسان ليس علامة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: ..لم أشعر بمثل هذا الخوف في حياتي من قبل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: في تلك اللحظة لم أكن أفكر في إنقاذ أي شخص أو أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: لقد هربت بسرعة. كالجبان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: والعار الذي شعرت به هذه اللحظة... لا يطاق. كيف يمكنني النظر إلى نفسي في المرآة وأنا أعلم أنني تركت هؤلاء المساكين...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: لا ألومك على ذلك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: لكن لا يزال بإمكانك مساعدة الناس
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: أنت مثير للشفقة. اخرج من منزلي.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: شكرًا لتفهمك. هذا... هذا يزيح بعض الضغوطات عني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: لا أستطيع التوقف عن التفكير في عدد الأرواح التي كان بإمكاني إنقاذها لو بقيت حتى النهاية المريرة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: لكن لا أعتقد أنني أستطيع...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: تركت جميع أدواتي في منطقة الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: ...لا فائدة مني الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: أعلم أنك كنت تأمل في الحصول على العلاج.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: لكن ماذا يمكن لرجل عجوز مثلي أن يفعل بيدين عاريتين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: أنا آسف إذا خذلتك يا بني. أخشى أنني عاجز أمام تهديد الزائرين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: لا تقلق، يمكنك البقاء على أي حال
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: إذن ارحل غير مأسوف عليك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: أعتقد أنك على حق. يجب أن أرحل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: شكرًا لتفهمك. هذا... هذا يزيح بعض الضغوطات عني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: أعتقد أن الوكالة الفيدرالية كانت ستكشف عن التقارير الكاذبة عاجلًا أم آجلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: ومع ذلك، لا أستطيع نسيان فكرة أنني كنت أستطيع إنقاذ المزيد من الناس، لو كنت أكثر شجاعة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: أخشى أن يرافقني الشعور بالذنب بقية حياتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: أعتقد أنك على حق. لا مكان ولا فائدة لرجل عجوز مثلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: لماذا تسأل؟ هل تحاول معرفة سبب عدم ثقتي في الوكالة الفيدرالية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: لنبدأ بفرضية...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: هل تعتقد أن الزوار نوع من الفيروسات؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: لا أعتقد أنهم موجودون أصلًا
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: لا. لكنني لا أعرف ماهيتهم في الحقيقة
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: نعم
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: إذا كان هذا هو ما تعتقده، فلا أرى سببًا يدفعك إلى إجراء كل هذه الفحوصات.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: لا تحاول خداعي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: إذن...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: أتفهم ذلك. للأسف، أنا أيضًا لا أعرف حقيقة الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: لكن هناك شيئًا واحدًا يمكنني أن أؤكده لك، وهو أنهم ليسوا فيروسًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: أخشى أنني سأخيب ظنك. ولكن على الأرجح هذا ليس صحيحًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: هل سبق لك أن رأيت شخصًا كان يبدو بأفضل حال وبعد لحظات قليلة يتغير فجأة؟ ويتحول إلى زائر أمام عينيك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: بالضبط. لم تُسجل حالة واحدة من هذا القبيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: يجب أن تفهم أن الوكالة الفيدرالية لا تتحكم في هذه القضية. إنها تتظاهر فقط بأنها تتحكم فيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: أغلقت المستشفيات، وأرسلت الجميع إلى مناطق الحجر الصحي... ولكن لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: هل تساعد الناس؟ هل شُفي أحد من قبل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: كل ما فعلته الوكالة الفيدرالية ببساطة هو جمع الناس وحبسهم، والآن لديها السلطة لفعل ما تشاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: لماذا عملت في الوكالة الفيدرالية إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: كف عن هذا الهراء. اخرج من هنا
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: لم أستطع الجلوس مكتوف الأيدي ورؤية الناس يُقتلون واحدًا تلو الآخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: لهذا السبب انضممت إلى الوكالة الفيدرالية، لمساعدة هؤلاء المساكين على الهروب من مناطق الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: فحصتهم، وأصدرت تشخيصي. وزورت وثائق حتى يتمكنوا من الخروج أحرارًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: بسببك، كان بإمكان الزوار الخروج
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: أي حادثة؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: من المؤسف أنك ستضطر إلى الهروب من هنا أيضًا
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: من المؤسف أنك لا تحاول حتى الاستماع إلى وجهة نظري في ما حدث...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: إذن لن أبقى في منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: وماذا تفضّل؟ تركهم هناك ليموتوا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: لقد أقسمت إنني سأبذل قصارى جهدي لحماية حياة البشر وصحتهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: لكن في النهاية... اضطررت إلى الفرار من منطقة الحجر الصحي بمفردي. للأسف...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: وقعت حادثة في المنطقة التي كنت أعمل فيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: ماذا!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: هل تعتقد أنني ما كان يجب أن أساعدهم؟ والآن تطردني لهذا السبب؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: لم أعتقد أبدًا أنني سأقول هذا، لكنك قد تكون أسوأ من الوكالة الفيدرالية. على الأقل تتظاهر الوكالة بمساعدة الناس. أما أنت...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: لا يمكنني البقاء هنا. أخشى أن أفكر فيما سيحدث لمن يلجئون إلى بيتك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: الوداع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: هل قطعت الغرز من فمك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: hadha kaabus!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: khatathoo fammee bi’l-khayt li’annahum laa yafhamoonanee.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: لا أفهمك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: هل تفهم ما أقوله؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: laa afhamuk. maadha nastatee‘u an naf‘al?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: ikhtar lughah ‘aamiyah ma‘roofah?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: كيف من المفترض أن نتواصل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: astati’u i‘adat kalimatak, wa anta tastati’u al-radd ‘alayha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: rubama bi tilka al-tareeqah sa a‘lam ‘ala al-aqall ma adh-dhi aqool.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: كيف؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: كيف ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: هل تحاول أن تسأل سؤالًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: ma zaaltu laa astatie‘u al-fahm. lakin a‘taqid annaka sa’alt shay’an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: rubama kana su’al…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: ma zaaltu laa astatie‘u al-fahm. lakin a‘taqid annaka sa’alt shay’an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: rubama kana su’al…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: كيف حالك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (تربت على كتفه وتشير إلى الجروح بالقرب من فمه)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: هل أنت بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: أيؤلمك هذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: hal yumkinuni an as’alaka an tu‘eed dhalik?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: بغغغييير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: بخخخخ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: بغييير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: alfam? …rubama sayusa‘id'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: ataassa’alu hal yaqa‘u al-shay’ nafsuh fi baladi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: ya lahu min kaabus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: كيف ستعود إلى بيتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (تضم راحتي يديك فوق رأسك، لتشكّل شكل السقف)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: albayt? anta tas’al ‘an albayt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: ji’tu liziyaarah sadeeq, thumma hadas hadhā‘.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: al-waḍ‘ karethy tamaman, laa ujidu kalimah ukhra lah.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: كيف أعيدك إلى وطنك؟ بالطائرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: هل تحققت من تذاكر السفينة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (تفتح ذراعيك وتأرجحهما كأنك طائر)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: tairah? tazunn annaha tazal tatir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: yanbaghi an uhawil an a‘rif min makan ma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: rubama tazal hunak tareeqah lil‘awdah.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (تحرك يدك، مقلدًا حركة سفينة على الأمواج)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: mithl… al-ibhar ‘ala safinah?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: hal tazal taamal? saahtaj an abhath an dhalika, shukran!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: لماذا تبدو سعيدًا هكذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (تبتسم وتشير بإصبعك إلى الابتسامة، ثم إليه)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: ah, anta ta‘ni hatha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: tamakkanoo min ikhbaari anna al-qitaarat tazal tasir! hal tastatee‘ an tusadeq dhalik?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (يحرك إحدى يديه على طول ذراعه الأخرى)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: هل يمكن لأحد أن يوصلك إلى وطنك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: laa afham ya sadeeqi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: ghadan sa-atajah ila al-watan! aw ‘ala al-aqall ila al-mahattah.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: sa-ughaddir al-laylah. ma‘a al-salama!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: مغ السرامة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: أتعني القطار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: هل ستغادر إلى مكان ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: lam afham dhalik, ‘afwan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: lakin ghadan sa-adhhab ila al-mahattah wa sa-ara bi-nafsi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: rubama sa-aṣil ila al-watan ba‘da hadha al-waqt kulluh…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: غظًا نوفقًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: استمتع بلحن الصمت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: كيف حال يدك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: ينبض، نعم، لكنه خالٍ من المشاعر — لم يتبقَّ فيه دفء، بل ألم وبرودة فحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: لكن هذا، مع الأسف، متوقع؛ إذ أرغب في إرجاء تلك اللحظة الساحرة بقدر ما أستطيع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: كانت هناك فتاة أحببتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: أحببت لحظاتنا معًا. كنا نجلس في صمت، لكنني كنت أفهمها دون كلمات. ثم أدركت الأمر فجأة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: كنت أخدع نفسي. لم أعرفها قط. ربما كنت أرغب فقط في تصديق أنني عرفتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: ومع ذلك، آمل أن نتبادل الحب يومًا ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: استمتع بلحن الصمت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: أخبرني عن تلك الفتاة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: سكن ضوء القمر الشاحب البارد في عينيها دائمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: كانت نقيضًا تامًا للكارثة التي حلَّت علينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: فلا يكتمل الجمال دون بعض الغرابة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: وأتوق إلى كشف غموضها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: لقد باتت محفورة في قلبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: وأصبحت نور القمر الذي يرشدني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: استمتع بلحن الصمت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: كيف قابلتها؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: ثم أدركت ما ينتظرني: سيقتلني التسمم الدموي قريبًا، بلا رحمة ولا شفقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: لقد سيطر عليّ الخوف — سأختفي، ليس بعد وقت طويل، بل في غضون أشهر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: وبينما كان الزوار يحاولون الخروج من الأرض... وجدتها هناك، بين الجدران المهجورة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: فتاة ملفوفة بقماش شاحب، ووجهها ينبض بجمال جذاب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: في هذا العالم القاسي، حيث لا يهتم الرجال إلا بأنفسهم، لم يهتم أحد بهذه الجميلة... لكنني اهتممت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: هل سمعت يومًا عبارة "غريبٌ عن دنياك، لا يسعه العيشُ فيها، ونادرٌ كالنجم، لا يُكتب له الفناء."؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: هذا ينطبق عليها، بعدها... حملتُ جسدها الهش وحملتها إلى المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: عندما تأتي النهاية، سأقول إن كل ما فعلته في حياتي، فعلته بحب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: استمتع بلحن الصمت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: أين تلك الفتاة الآن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: كرّست حياتي لحماية جمالها، وللشعور بالقوة الكاملة والمخيفة لصمتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: حتى...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: دخل علينا رجال مجهولو الهوية، يرتدون ملابس صفراء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: أمسكوا بها وجروها إلى هناك. أعتقد أننا نعرف السبب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: يا للأسف... لم أتمكن من فهمها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: التواصل معها الآن كشروق الشمس من مغربها...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: البشر مطالبون بإنقاذ العالم، لكنهم لا يتفقون على كيفية القيام بذلك. الجواب بسيط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: الحل يكمن في الصمت. في الجمال. لو كان بإمكان المرء فقط... أن يدركه ويراه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: حاولت أن تعلّمني، لكن كل ما تعلمته هو صفاء الذهن. رؤية النعم وسط الأهوال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: على الأقل... أصبحت مستعدًا للسير على هذا النهج.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: لا تخجل يا رجل. هيا، اسأل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: ألا تزال تعتقد أن الوكالة الفيدرالية ستلاحقك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: آمل ألا تكون كذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: نعم، لقد أخطأت نوعًا ما بالذهاب إلى الوكالة الفيدرالية بهذه الطريقة. كان يجب أن أعرف أن العاملين بها سيحاولون اختطافي أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: اعتقدت أنهم سيأخذون الراكب ويتركونني وشأني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: بدلًا من ذلك، أخذوا سيارتي وكادوا يطلقون النار عليّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: لكن فكر في الأمر يا رجل، ماذا كان عليّ أن أفعل غير ذلك؟ كان الرجل زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: وإذا كان بشريًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: لم يكن لديك خيار
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: لا تقل ذلك يا رجل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: أنا لست سعيدًا بما حدث، حسنًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: حسنًا... أنت محق، لم يكن هناك طريقة أخرى حقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: أفتقد الأيام التي كان بإمكانك فيها القيادة دون التفكير في أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: الآن، مع هؤلاء الزوار... ربما يقرر الراكب التالي أن يطلق عليك النار بلا سابق إنذار.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: هاه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: لا تخجل يا رجل. هيا، اسأل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: منذ متى وأنت تعمل سائق أجرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: نعم، أعمل في هذا المجال منذ فترة طويلة. في الوقت الحالي، لا أعمل لحساب أي شركة، أنا رئيس نفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: الوكالة الفيدرالية لا تسمح للمدنيين بالتحرك بحرية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: لكن هذه الفوضى ستنتهي يومًا ما، أليس كذلك؟ والمال... من المفيد دائمًا أن يكون لديك مال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: الناس يدفعون مبالغ كبيرة مقابل الرحلات الخطرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: والقيادة ليلًا تعيد إليّ ذكريات طفولتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: أصبحت سائق تاكسي بسبب والدي. أردت أن أسير على خطاه.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: لا أريد أن ينتهي بي المطاف على جانب الطريق، ولا أحد يهتم بي... مثل والدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: آمل فقط أن يظل حظي سعيدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: لا تخجل يا رجل. هيا، اسأل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: تبدو حزينًا اليوم
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: كل ما في الأمر هو...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: لا أستطيع أن أتجاوز حقيقة أنني فارقت سيارتي...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: ما نوع السيارة التي كنت تمتلكها؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: لماذا ترى سيارتك مميزة للغاية؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: يا إلهي، كانت أجمل سيارة كلاسيكية...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: هيكل أصفر لامع، عجلات كروم لامعة، منحنيات ناعمة...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: ولكنها ضاعت مني الآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: اللعنة على الوكالة الفيدرالية... تلك السيارة كانت كل شيء بالنسبة لي! الأوغاد.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: كانت سيارة أبي. كان يعمل سائق تاكسي أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: عندما كنت طفلًا، كنت أحب الركوب معه في الليل. كنت أنام في المقعد الخلفي، لذلك كان يأخذني معه. ولكن بعد ذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: يمكن القول إن حظه السعيد قد نفد...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: لا تخجل يا رجل. هيا، اسأل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: ماذا حدث لوالدك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: لا أحب التحدث عن هذا الأمر، ولكن... حسنًا، أعتقد أنني أستطيع الوثوق بك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: ذات يوم، اضطرت أمي إلى السفر في رحلة عمل، فاصطحبني أبي معه في سيارة الأجرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: واصطحبنا راكبًا لن أنساه أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: بدلة أنيقة، ورأس أصلع، وابتسامة شريرة...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: كان الجميع في البلدة يعرفونه. حتى أنا، الطفل الصغير. لا يمكن رفض طلب لرجل مثله.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: لكن والدي كان رجلًا شريفًا. وهذا الاختيار... أثر علينا جميعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: وذلك الشيطان الذي كان يرتدي بدلة حرص على أن ندفع ثمن ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: لقد فقدنا منزلنا. ولم نتمكن من البقاء في مكان واحد لفترة طويلة من بعدها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: ولأننا لم يكن لدينا أي نقود تقريبًا، احتفظ أبي بسيارة الأجرة التي كان يقودها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: لكن لاحقًا، ومع تراكم الديون، بدأ يتمنى لو كان قد باع السيارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: قال إنها ملعونة. جلبت لنا سوء الحظ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: ولكنه لم يفهم الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: كان كبرياؤه ما كلفنا كل شيء، وليس السيارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: اختياراته جعلتني أضطر إلى البدء في العمل مبكرًا لإعالة الأسرة... لكنني على الرغم من كل ذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: لا أزال أحبه.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: أفتقدك يا أبي...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: لن أثقل عليك، ولكن... لو سمحت، هل يمكنك الاتصال به؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: هذا رقمه: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: أخبره أنني بخير. كنت سأتولى الأمر، لكن... في الوقت الحالي لا يمكنني أن أكشف نفسي لهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: يا له من عالم غريب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: ماذا تقصد؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: ألم تفهم بعد؟ لم ننتهِ بعد من إبرام اتفاقية الإيجار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: وكيف أفعل ذلك بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: هل هذا مهم حقًا في الوقت الحالي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: اممم، هل تقصد أنك لا تملك حتى الأوراق المطلوبة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: إذن... أقترح أن تبحث عن كاتب عدل وتطلب منه ذلك، اتفقنا؟ بصراحة، هذا محبط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: هل تمزح؟ أين يمكنني أن أجد كاتب عدل الآن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: لماذا لا تذهب أنت للبحث عنه؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: كما أرجو أن تخاطبني بالشكل الصحيح وبالاحترام المناسب. ادعوني بـ"سيدي" مثلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: الأخلاق هذه الأيام...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: أيًا كان ما قلته
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: اغرب عن وجهي
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: أنت تعرف كيف تستخدم الخريطة، أليس كذلك؟ هذا ليس معقدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: ومرة أخرى، أصر على أن تستخدم لقب "سيدي" وتخاطبني بالاحترام المناسب، حسنًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: أيًا كان ما قلته
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: اغرب عن وجهي
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: لماذا يجب أن أكون أنا بالتحديد من يقوم بهذه المهام؟ وعليك مناداتي بـ"سيدي"!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: أنا مواطن محترم، ولستُ مجرد عامل عندك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: أيًا كان ما قلته
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: اغرب عن وجهي
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: أنت تفعل هذا عن قصد، أليس كذلك؟ يمكنك على الأقل أن تتظاهر بالتعاون، ما رأيك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: في الواقع، المادة 21 من الدستور تضمن حقوقي في الكرامة الإنسانية الأساسية، لذا انتبه لنبرة صوتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: وأنصح بشدة أن تبدأ في إظهار بعض الاحترام لي، قبل أن تصبح الأمور... غير سارة لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: يا له من عالم غريب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: ألا يمكنك أن تنسى ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: بالطبع لا. أنت ملزم قانونًا بإتمام عقد الإيجار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: لكن ليس لديّ الأوراق لأنجز ذلك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: لا بد أنك تمزح
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: هممم. هذا مؤسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: أخشى أن هذا قد يشكل انتهاكًا للمادة 131.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: بدأت تغضبني حقًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: ألا تمل من ذكر القوانين؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: لعلمك، العقد إلزامي بموجب المادة 131. أنا أتصرف كمواطن مسؤول هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: أنت تغضبني حقًا
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: ألا تمل من ذكر القوانين؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: اممم، ها هي، في الوقت المناسب تمامًا — الإهانات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: وهذا، بالمناسبة، يندرج تحت البند 5.61 من القانون الإداري.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: استمر كما تشاء. كل شيء تقوله سيؤذيك في النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: ولا. لا أملّ من الإشارة إلى القانون أو الدستور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: أعرف حقوقي! جهلك بها لا يلغي حق الآخرين في معرفتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: وأود أن أذكّرك بأن عليك مخاطبتي بالأسلوب اللائق من الآن فصاعدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: أنا محبط. متى ستتعلم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: يا له من عالم غريب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: ماذا تقصد؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: لقد لاحظت وجود سلاح ناري. هل يمكنك أن تريني رخصتك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: هذا ليس من شأنك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: ما مشكلتك معي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: آه، فهمت، ليس لديك رخصة؟ أعني، هذا هو الاستنتاج الطبيعي الوحيد بالنظر إلى رد فعلك، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: هل تعتقد أن حيازة سلاح تجعلك فوق القانون؟ أهذا ما تعنيه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: أتعتقد أنك تستطيع محاسبة الجميع دون أن تُحاسَب؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: أنت مخطئ تمامًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: لكن اعلم أن القوي يوجد دائمًا من هو أقوى منه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: كفى. لديّ ما يكفي من المشكلات بالفعل.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: هلا تكف عن هذا الهراء؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: أحاول فهم طبيعة الشخص الذي أمامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: ردة فعلك الدفاعية تؤكد شكوكي... لقد آلمتك الحقيقة. أنت لا تملك رخصة، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: تعتقد أن القواعد لا تنطبق عليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: تريد أن تحمي نفسك من الجميع، لكنك لا تسمح لأحد بمساءلتك عن تصرفاتك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: دعني أخبرك أنك مخطئ تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: لكن اعلم أن القوي يوجد دائمًا من هو أقوى منه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: كفى. لديّ ما يكفي من المشكلات بالفعل.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: هلا تكف عن هذا الهراء؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: يا لك من مسكين. لا أحد يجرؤ على استجوابك أو التحقق مما إذا كنت زائرًا. يا له من أمر صعب عليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: ومن أعطاك الحق في أن تقرر من يعيش ومن يموت؟ مَن منحك هذه السلطة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: نرجو ألا نكون ضحاياك القادمين. وبعد كل هذا تريد تعاطفي؟ لا بد أنك تمزح!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: اعذرني على صراحتي، لكن ألا تغسل أدمغة الناس بهراء فحوصاتك هذه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: تتجسس على الجميع، وتعاملهم جميعًا كقتلة محتملين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: لكن بالطبع، دعنا لا نشير بأصابع الاتهام إلى القاتل الحقيقي. لأنه ربما... لا يوجد زوار أصلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: وماذا سيجعلك ذلك، هه؟ مجنونًا... تسيء استخدام منصبك، وتستغل الفوضى لإشباع رغبتك في سفك الدماء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: وماذا عن الناس؟ يسمعون رسائل الذعر عبر المذياع وينجذبون إلى عتبة بابك كالذباب إلى الروث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: أخبرني، كم من رفاقك الأوائل ما زالوا أحياء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: كما توقعت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: يا له من عالم غريب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: سيدي؟ ألا تزال هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: رائع... لقد خاطبتني باحترام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: من المؤسف أن هذا متأخر جدًا. سأبلغ عن كل هذا قريبًا جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: تبلغ عن ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: تبلغ مَن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: انتهى عهد الخداع. كشفت حقيقتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: هذا ليس منزلك. لا، لا، لا. لقد قتلت المالك. أنت تتقمص شخصيته. وسأتصل بالوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: هذا صحيح، ستلاحقك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: هذا عبث
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: أعتقد أن الوقت قد حان لإسكاتك إلى الأبد
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: الوكالة الفيدرالية لإدارة الطوارئ. اختصارها الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: في البداية كنت على استعداد للتغاضي عن إهمالك لعقد بسيط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: لكن كلما طالت محادثتي معك، أصبح كل شيء أكثر وضوحًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: كل شيء اتضح الآن. هذا ليس منزلك. أنت محتال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: أنت زائر!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: لذا احزم أمتعتك. سيأتي عملاء الوكالة الفيدرالية من أجلك الليلة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: هذا هراء
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: أعتقد أن الوقت قد حان لإسكاتك إلى الأبد
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: أوه، سأبلغ عن هذا. وسيأتي عملاء الوكالة الفيدرالية. انتظرهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: لا يهم. ارحل وحسب
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: أنت في عداد الموتى (اسحب السلاح)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: تعتقد أنك تستطيع إسكاتي؟ لا يمكنك ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: انتظر... ماذا؟! هل جننت؟ هذا جريمة جنائية!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: لا، لا، لا. لن تفلت من العقاب!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: سأبقى هنا حتى وصول الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: سأخبرهم بكل ما فعلته، ومدى خطورتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: انتظر... ماذا؟! هل جننت؟ هذا جريمة جنائية!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: لن تجرؤ على ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: من الأفضل أن تغادر قبل أن أطلق النار
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: سأطلق النار بالتأكيد إذا لم تغادر
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: أنت لا تترك لي أي خيار
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (أطلق النار عليه)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: لن أدعك تهرب من الوكالة الفيدرالية. على جثتي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: ستنال عقابك في النهاية!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: ولا أنت أيضًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: أنت زائر! قاتل! لستَ بشريًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: لا! هذا مخالف للقانون!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: آآآهه!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: غنيمة كبيرة... نعم... هذا كل ما أحتاج إليه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: كيف تسير أعمالك في النبش؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: مرحبًا يا صديقي. ظننت أن هذا المكان مهجور، لذلك حاولت التسلل إليه... لم أكن أعلم أن هناك من يعيش هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: لا أسرق من الأحياء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: هذا منطقي، أليس كذلك؟ فكر في الأمر، ماذا سيفعل رجل ميت بمعطف؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: لقد مات على كل حال. وأغراضه مبعثرة. وأنا؟ ما زلت أتنفس. قد تنقذ أغراضه حياتي أو حياة شخص أهتم لأمره.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: ألن تأخذ شيئًا من جثة لإنقاذ شخص تحبه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: ربما حان الوقت لنتوقف عن معاملة كل ميت كأنه مزار مقدس. هذا رأيي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: غنيمة كبيرة... نعم... هذا كل ما أحتاج إليه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: لماذا قررت أن تصبح نباشًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: ماذا كان عليّ أن أفعل غير ذلك؟ لا أريد أن أؤذي أحدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: لذلك سلكت الطريق الآمن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: الموتى لا يقاومون، كما تعلم. وأغراضهم قد تفيدنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: لستُ هنا لأؤذي الناس. أحاول البقاء على قيد الحياة وحسب. وربما أساعد البعض في طريقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: غنيمة كبيرة... نعم... هذا كل ما أحتاج إليه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: ماذا وجدت أثناء النبش؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: رأيت الكثير من الأشياء...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: سأحاول تذكر بعضها...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: وجدت هذه المكتبة المهجورة ذات مرة. ورأيت الكتب المغبرة موضوعة على الرفوف وكأن الناس قد يعودون لأخذها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: وتجولت ذات مرة في معرض فنون للمبتدئين. الرسومات لا تزال معلقة هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: وفي إحدى المرات... رأيت غروب الشمس. لم يكن غروب شمس عاديًا، بل بدا وكأنه رسم على السماء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: لا أحد يجرؤ على الوقوف والنظر إلى السماء هذه الأيام. لكن في ذلك الوقت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: أفتقد الحياة في الماضي يا رجل. كنت أستيقظ مبكرًا جدًا. كانت الشوارع هادئة. كان الضباب يتدفق، والعشب لا يزال رطبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: والشمس... يا إلهي، كانت تشرق بضوء ساطع، وكأنها تبشرك بيوم رائع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: الآن انظر إلى حالنا. أصبحت الشمس تعادينا. كيف حدث ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: أتمنى لو كان لدى إجابات لكل هذه الأسئلة. قد يجعل ذلك الحياة أسهل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: غنيمة كبيرة... نعم... هذا كل ما أحتاج إليه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: هل توقفت عن النبش؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: لا، ما زلت أنبش ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: لا أعرف... مررت بتجربة نبش أثرت فيّ كثيرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: دخلت منزلًا ووجدته فارغًا. وجثة على الأرض، كالعادة. لا توجد تهديدات من أحياء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: كان ظهر الرجل مليئًا بالثقوب، وكان مستلقيًا على شيء ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: أعتقد أنه ربما حاول إخفاء شيء ما؟ لذا اقتربت منه، وقلبته...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: في الواقع، لا، سأخبرك لاحقًا. لست مستعدًا بعد لتذكر تلك التجربة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: غنيمة كبيرة... نعم... هذا كل ما أحتاج إليه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: ما الذي عثرت عليه تحت الجثة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: لذا قلبت الرجل، ورأيتها تحته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: فتاة صغيرة. ميتة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: البالغين... يمكنك أن تتوقع موتهم. لكن طفلة؟ الأمر مختلف تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: عندما أرى أطفالًا ميتين، أشعر بضيق تنفس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: كانت تمسك بدمية قطة صغيرة من القطيفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: كان هناك الكثير من الدماء يا رجل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: وكان وجه الفتاة عليه تلك النظرة... كأنها كانت تعلم أن الموت قادم لا محالة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: للحظة، أقسم إنها بدت خائفة من أنني سآخذ لعبتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: وكأن قسوة الناس لن تتركها وشأنها، حتى بعد موتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: لقد أثر ذلك فيّ أكثر مما كنت أتصور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: ذلك اليوم جعلني أرغب في التوقف. وترك الموتى في سلام... لكن الأوان قد فات الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: لا يسعني سوى الاستمرار. الاستمرار في البحث عن الطعام. فهذه الطريقة الوحيدة التي يمكنني من خلالها البقاء على قيد الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: يقول الناس إنه لا يمكن الهروب من القدر. أعتقد أن هذا صحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: أتمنى أن يعود الزوار إلى تحت الأرض...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: لماذا أصبحت تحفر القبور؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: ماذا؟ تقصد وظيفتي؟ نعم، في الواقع، لا أعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: المقبرة تشبه... تشبه المكتبة، لكن هذه الكتب ليست للقراءة... إنها موضوعة هناك وحسب. هادئة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: كنت أعرف كل قبر. مكان كل جثة، وكيف كانت أذرعهم مطوية، والملابس التي كانوا يرتدونها، وأسماء كل واحد منهم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: وذات يوم كنت أحفر حفرة جديدة، كان يومًا عاديًا، لم يحدث أي شيء غريب. شعرت أنها عميقة كفاية، ثم... فجأة، وجدتها فارغة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: فارغة! لكن الصحيفة قالت إن أحدًا ما كان يجب أن يكون هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: رجل ما، ميت بالتأكيد. أتذكر أنه كان لديه شارب. لكنه اختفى كالندى في الصباح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: إذا اختفى رجل ميت، فهل هذا معناه أنه مات مرة أخرى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: أتمنى أن يعود الزوار إلى تحت الأرض...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: ماذا فعلت عندما وجدت القبر فارغًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: جلست على الحافة. نظرت إلى الداخل، ولم أرَ شيئًا. ثم نظرت إلى الأعلى، ورأيت شخصًا يقف هناك في الأفق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: يراقب. كأنه في جنازة. بلا عيون. لكن أسنانه بيضاء للغاية. تكاد تتوهج. يبتسم. يقف هناك فحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: لن أخفي عليك، كنت أرتجف رعبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: ركضت بسرعة كبيرة. أنا أجيد ذلك. لكنه لم يلاحقني. بل اختفى. كالدخان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: أشياء غريبة... كل هذا حدث منذ ظهر هؤلاء الزوار...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: أتمنى أن يعود الزوار إلى تحت الأرض...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: ما الفائدة من الحفر إذا لم يعد أحد يدفن الموتى؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: أنا لا أحفر حقًا. بل أراقب... في أغلب الأوقات. لكن بعد تلك الفوضى؟ بدأت أبحث في القبور الجديدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: كنت حذرًا للغاية. لم أفعل أي شيء غريب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: ظننت أن أحد هؤلاء المجانين قد دُفن عن طريق الخطأ. لذا حملت مجرفتي كالسيف. مستعد لضرب أي شيء يتحرك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: لكن لا... كانت العظام في مكانها الصحيح. والجثث باقية في مكانها. لا شيء يزحف للخارج.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: جعلني ذلك أفكر... ربما ليس الموتى هم من يعودون. ربما الزوار هم أشخاص كان يجب دفنهم، لكن لم يتم دفنهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: أتمنى أن يعود الزوار إلى تحت الأرض...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: لم تحفر أي قبور جديدة، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: أنا!؟ بالطبع لا! لستُ غبيًا. لقد كنت محاطًا بالموتى طوال حياتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: في الماضي، لم يكن الموت يزعجني. تموت، فيدفنونك. الأمر ينتهي عند هذا الحد. أما الآن؟ مَن سيبقى ليدفنك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: وحتى لو فعل أحدهم ذلك، كيف تتأكد أنك ستبقى مدفونًا؟ رأيت قبرًا أعرف أنني وضعت دفنت فيه جثة... وكان فارغًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: لكنني دفنته بنفسي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: الآن أفكر... ربما سيكون قبري فارغًا أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: ربما... ربما أنا زائر بالفعل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: لا تقلق منّي. لقد كنت خائفًا فحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: أتمنى أن يعود الزوار إلى تحت الأرض...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: من أين تعتقد أن هؤلاء الزوار يأتون؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: هل لاحظت يومًا كيف يبدون متشابهين للغاية؟ لا يبدون كبشر... بل كذكريات بشر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: لديّ نظرية. هل تريد سماعها؟ حسنًا، نظريتي هي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: ربما الزوار... ليسوا موتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: ربما هم مجرد أفكار. تلك الأفكار التي لا ندفنها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: المخاوف، والندم، والمشاعر التي لا تتخلص منها أبدًا. تتراكم... وعندما يصبح المكان هادئًا تحت التراب، تزحف إلى الخارج.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: لا تبحث عن أكل لحومنا... بل عن الاهتمام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: كلما زاد خوفك، اقتربوا منك. لأنك تتذكرهم. وأي شيء تتذكره... يريد أن يعيش.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: آمل ألا أكون قد تعرضت لأشعة الشمس أكثر من اللازم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: هل أنت متأكد أنك لست مع الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: لا أعمل لصالحها. كما أخبرتك، كنت أعمل في إصلاح الثلاجات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: ...وجدت الزي في سيارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: قبل قليل قلت إنك أخذته من جثة
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: أنت لا تكذب عليّ، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: آه، نعم، صحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: لقد وجدته في سيارة... يرتديه رجل ميت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: اعتقدت أن الزي سيحميني من الزوار. فرجال الوكالة الفيدرالية يرتدونه لسبب ما، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: لا أكذب. لقد اختلط عليّ الأمر بسبب التوتر وحسب. ما الغريب في ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: صدقني، لو رأيت ما رأيته... لتفهمت كلامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: حتى في الطريق إلى هنا... هل تعلم أن بعض الجثث تستمر في الارتعاش على الأرض؟ كدت أموت من الخوف...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: آمل ألا أكون قد تعرضت لأشعة الشمس أكثر من اللازم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: ألا تعتقد أن ارتداء بدلة الوكالة الفيدرالية فكرة سيئة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: ماذا؟ لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: أعني، بالطبع، بعض الناس لا يحبون الوكالة الفيدرالية، ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: أوه، تقصد أنني قد أواجه مشكلة بسبب انتحال الشخصية، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: حسنًا، اسمع، أنا... أعتقد أنني إذا شرحت كل شيء، فسوف يتركونني وشأني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: لا داعي لتشويه صورتها. فهي ليست مجتمعًا سريًا أو ما شابه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: آمل ألا أكون قد تعرضت لأشعة الشمس أكثر من اللازم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: أرني ماذا يوجد في جيوبك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: مهلًا! لماذا تريد تفتيشي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: أبحث عن هويتك الخاصة بالوكالة الفيدرالية
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: ولمَ لا؟ هل تخفي شيئًا ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: ماذا؟ أي هوية تقصد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: أقسم لك إنني لا أملك ما تقوله...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: لنفعل هذا بالطريقة الصعبة... أفرغ جيوبك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (اسحب سلاحك)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: مَن؟ أنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: لنفعل هذا بالطريقة الصعبة... أفرغ جيوبك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (اسحب سلاحك)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: حسنًا، حسنًا. لا داعي لترهيبي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: خُذ. هل تشعر بالرضا الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: حسنًا، لقد كشفتني. أعمل لدى الوكالة الفيدرالية...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: لكن من فضلك، لا تخبر الآخرين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: سحقًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: خذ. لكن... لا تقتلني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: نعم... أعمل لدى الوكالة الفيدرالية...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: لكن من الأفضل أن تبقي هذا الأمر بيننا...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: لماذا أخفيت أنك كنت تعمل لدى الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: ولماذا كل هذه التمثيلية؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: ألا تفهم ما يجري؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: هل تسألني هذا حقًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: إذا اكتشف الناس أنني كنت أعمل لدى الوكالة الفيدرالية...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: اسمع، لم أعد أعمل لدى الوكالة الفيدرالية. لنقل إنني... استقلت.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: اسمع، لم أعد أعمل لدى الوكالة الفيدرالية. لنقل إنني... استقلت.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: كان عليّ فعل بعض الأشياء التي لم تكن... جميلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: جمع الناس... وإرسالهم إلى مناطق الحجر الصحي...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: لكن كان هذا عملي، حسنًا؟ كنت أتبع الأوامر وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: لا فائدة من سؤالي عن الذين أخذناهم. هذا أمر يخص كبار المسؤولين، وهو أبعد من نطاق صلاحياتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: ووصفي بالقاتل أو أي شيء آخر... غير عادل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: إذا كنت أنقذ الناس بإرسال القتلة إلى تلك المناطق، فماذا أكون؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: آمل ألا أكون قد تعرضت لأشعة الشمس أكثر من اللازم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: لماذا أخفيت أنك كنت تعمل لدى الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: ذات مرة، قابلت رجلًا كانت تظهر عليه علامات الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: باختصار، حالته ساءت في منطقة الحجر الصحي وتوفي. وذلك أمر عادي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: ثم جاءت زوجته. أرادت أن تعرف متى سنسمح له بالخروج. أخبرناها أنه لم يعد هناك ما يسمح له بالخروج.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: كان من الواضح أنها في حالة صدمة. بدأت بالصراخ، ووصفتنا بالقتلة، وطالبتنا بإعادة الجثة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: أخبرناها أن البروتوكول لا يسمح بذلك. لكن ذلك لم يمنعها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: جلست على الأرض، خارج البوابة مباشرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: لذا نفذنا طلبها، وأعطيناها الجثة. ثم طردوا كل من خالف البروتوكول. وأنا من بينهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: أصرت على أخذ جثة زوجها. تلك العاهرة المجنونة كلفتني وظيفتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: والآن ليس لديّ مكان أذهب إليه...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: والأغرب من ذلك أنها سحبت الجثة معها بدلًا من أن تدفنها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: يستحق هذا أن نتعرض جميعًا للفصل من العمل، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: أنتم يا موظفين الوكالة الفيدرالية أحقر أشخاص على وجه الأرض
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: يا له من حظ عاثر
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: ماذا قلت!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: كنت أقوم بعملي، وأؤدي واجبي، ويكون جزائي الطرد بسبب امرأة مجنونة...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: وتقول إننا الأحقر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: أتعلم شيئًا، سحقًا لك. سأغادر هذا المكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: يا إلهي، هل فقد الجميع عقولهم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: لا، لا، هذا بالضبط ما حدث.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: منذ أن جن جنون الشمس وبدأت العدوى، أصبح الجميع مجانين.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: هل كانت تلك الجثة اللعينة تستحق أن نفقد وظائفنا؟ حقًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: يسرّني أنها حصلت على الجثة
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: ما كان يجب أن تعطيها الجثة
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: هل تقول إن طردنا من العمل أمر يسرّك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: أنتم أيها المدنيون لا تفهمون أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: كان يجب أن أطلق عليها النار، كما أطلقت على زوجها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: ماذا قلت؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (اسحب سلاحك)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: ما هذه النظرة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: ينص البروتوكول على أنه إذا كان المدني المصاب في حالة سيئة...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: علينا أن نتعامل مع المشكلة على الفور، حتى لا نسمح لأي زائر بالهروب من الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: دعه يرحل
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (اسحب سلاحك)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: شكرًا لتفهمك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: لستُ قاتلًا، كنت أنفذ الأوامر وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: مهلًا، ماذا تفعل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: اهدأ، لقد كان زائرًا! وكان في حالة سيئة أيضًا! لم نستطع أن نتركه يرحل بهذه البساطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: لا تطلق النار أرجوك! كنت أنفذ الأوامر وحسب!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: أتفق معك. كان يجب اتباع البروتوكول.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: حسنًا، لن أضجرك بالباقي. شكرًا على استقبالي على أي حال، حتى بعد أن عرفت أنني أعمل لدى الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: إذا استعدت وظيفتي يومًا ما، سأحرص على الإشادة بتعاونك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: هل يحلم الزوار...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: هل نمت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: هممم؟ لم أكن أحاول النوم أصلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: آمل أن يكون هناك من لا يزال يحلم هنا، هذا كل ما في الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: لكن... لم يشاركني أحد أي أحلام حتى الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: ربما لا أبدو جديرًا بالثقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: ربما سيفتحون قلوبهم لي لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: هل يحلم الزوار...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: لماذا أنت مهووس بالأحلام إلى هذا الحد؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: مَن قال إنني مهووس؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: هذا استنتاج غريب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: ألا تشعر بالفضول ولو قليلًا لمعرفة ما يحاول عقلنا الباطن أن يخبرنا به؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: ما الذي نخفيه في عقولنا؟ نحن جميعًا نخفي أشياء عن أنفسنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: أنت، على سبيل المثال، هل تتجنب الناس لأن شخصًا ما آذاك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: هذا ما يجعل كل هذا مثيرًا للاهتمام بالنسبة لي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: أتعلم؟ سأخبرك عن آخر حلم راودني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: رأيت قطارًا أسود ضخمًا يطاردني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: كانت ساقاي مثبتتين على الأرض ولم أستطع الحركة. صرخت واستيقظت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: لكنني كنت أقود القطار أيضًا. كنت أطارد نفسي، وغير قادر على التوقف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: هل يحلم الزوار...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: ماذا عنك؟ ماذا تخفي في أحلامك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: ماذا عني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: لم أنم منذ أيام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: لكن لا بأس، سأخبرك بسر صغير. لن يصدقه أحد على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: أستطيع رؤية أحلام الآخرين. إنه أمر... مذهل، في الحقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: لا أعرف كيف يحدث ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: لكن منذ أن بدأ كل هذا، أصبحت الأحلام... هادئة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: وكأن الجميع يحبسون أنفاسهم مترقبين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: وأنا أيضًا لم أعد قادرًا على النوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: الآن... هل أقول لك الحقيقة؟ أم أنني أخدعك وأتلاعب بعقلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: من أنت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: أرواح ضالة. تمامًا مثل غيرهم من الملايين الذين يسيرون على هذه الأرض المدمرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: نتوق إلى السلام... إلى السكينة الأبدية. وقد وجدنا الطريق إليه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: ...الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: لماذا يرتعدون أمامه؟ هل ما يخشونه هو المجهول حقًا؟ أم هي قيود العقيدة التي حُفرت في أرواحهم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: لآلاف السنين، كنا نحاول جاهدين كشف الستار عن معنى الحياة. وكان الجواب بسيطًا للغاية...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: الموت مبتغانا، ونحن سائرون في ركابه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: لماذا تقدسون الموت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: لأن الموت تجسيد للرحمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: كلنا نخشاه، ولكن هل مخاوفنا مبررة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: فكر جيدًا... عالمنا ليس نعيمًا، بل عذابًا لنا. والسؤال الملحّ هو: لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: الكثير من الخوف والألم والمعاناة... ألا نستحق السلام؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: الموت نعيم لا يمكننا فهمه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: تحاول المعتقدات تبسيط صورة النعيم لتخفيف آلام الناس. لكن هل الحياة بهذه البساطة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: وينطبق الأمر نفسه على الموت. لا يمكنك أن تأمل في فهمه حتى تشعر به.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: لماذا اخترت منزلي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: منزلك مرتبط بالموت أكثر من أي مكان آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: في البداية تساءلت عن سبب اختيار مرشدنا لهذا المكان. لكن الآن أصبح كل شيء واضحًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: الموت يخيم على هذه الجدران. إنه غير مرئي، لكنه خانق، يضغط على الأرواح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: الخرسانة العارية تفوح منها رائحة الدماء المسكوبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: لا تقول لنفسك إننا نحثك على القتل. أنت تسفك الدماء بمحض إرادتك، دون أن نحثك على ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: أعتقد أن علاقتك بالموت أقوى من علاقتنا جميعًا به.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: ما هذه النيران التي تشعلونها في الخارج؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: اقترب الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: ستتقبل ملائكة الأعماق رمادنا تضحيةً، وتمنحنا العبور إلى دار الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: هكذا نكسب رضاه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: تبدو خائفًا. هل أنت خائف؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: أنت شديد الملاحظة يا صاحب المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: على عكس إخوتي في الإيمان... ما زلت أعاني الخوف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: الشك يعذبني: ماذا يوجد بعد الحياة؟ بم سنشعر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: مرشدنا يؤكد أن ما ينتظرنا ليس نعيمًا ولا عذابًا، بل حقيقة أخرى. لكن فهمها يفوق قدرتي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: إذا كان هو نفسه لا يفهم الموت بشكل كامل، فهل سنفهمه نحن حقًا يومًا ما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: ماذا لو لم يكن الوصول إليه كافيًا؟ ماذا لو كان حقًا يفوق فهمنا كلنا...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: لكنني لا أجرؤ على التشكيك في إرادة مرشدنا، لأنني أرى في عينيه الثقة والتفهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: يطلب منا أن نتحلى بالإيمان ونبقى عازمين ومستعدين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: عندها فقط يمكننا عبور أنهار الموتى وجبال العظام. والوصول إليه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: ...إلى الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: لماذا تقدسون الموت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: أرجوك، يا صاحب المنزل الطيب، آمل ألا تتحدث بسوء عن الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: إنه يحتقر الجهلاء الذين يصفونه بالظالم، ويعاقبهم بأشد العقوبات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: طبيعته ترعبني، لكن مرشدنا يقول إن الموت قد يكون ألطف شيء نقابله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: إنه لا يجلب المجاعة أو الطاعون أو الحرب. إنه ببساطة يمنح... الراحة الأبدية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: وعلينا أن نلاقيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: لماذا تتلهف هكذا لملاقاة الموت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: هذه الرحلة ليست قرارنا. إنها إرادة الموت نفسه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: لقد تواصل معنا. إنه يتوق إلينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: يعتقد مرشدنا أن الشمس تحترق الآن لتجبرنا على مغادرة الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: الموت يمنحنا الصمت والسلام والوحدة. أراضيه هي المكان الذي سنلتقي فيه مجددًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: إننا نحزن على الموتى عبثًا، وننسى أننا سنلتقي بهم مرة أخرى يومًا ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: ما الذي تنوي فعله؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: لقد حان الوقت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: أنا خائف. جسدي لا يتوقف عن الارتعاش... لكن يجب أن أتمسك بإيماني وأقوي عزيمتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: مرشدنا يؤمن بي. لا يمكنني أن أخذله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: لكن الخوف... الخوف لا يزال يعبث بذهني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: حررنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: حررنا. حررنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: إلى متى ستبقى؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: لا تقلق يا صاحب المنزل. لن نسبب أي مشاكل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: نحن نقدر كرم ضيافتك ولا نريد أن نغضبك. لقد فعلت الكثير من أجلنا بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: سنبقى في هذه الغرفة ونتعبد بهدوء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: نحن بحاجة إلى قسط من الراحة. رحلتنا المقبلة ستكون طويلة وشاقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: إلى أين ستذهبون؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: إلى أرض الغرباء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: حياة الإنسان ليست أبدية. نحن مجرد ضيوف على هذه الأرض. جئنا زيارة واحدة، وسنرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: يجب على الغرباء أن يستولوا على هذه الأرض بعد ذلك. ويستقروا هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: وصولهم ليس عشوائيًا. لقد استدعاهم النداء نفسه الذي جذبنا من بعيد...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: الموت استدعاهم إلى هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: ما الذي يجعلك تعتقد أن الموت استدعى الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: لأن الموت لا يميز بين البشر والحيوانات والغرباء...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: الموت هو نفسه للجميع ولكل شيء، والجميع متساوون أمامه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: لقد انتظر اللحظة المناسبة، والآن قد حان الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: يجب أن نستعد للطقوس...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: ما نوع الطقوس التي تخططون لها؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: حان وقت العبور، للسفر إلى موطننا الجديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: يجب أن نذهب إلى الموت، إلى عالم السلام والصفاء الأبديين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: حان الوقت للمضي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: نعم يا حبيبي؟ هل هناك ما يشغل بالك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: أتحبين المكان؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: إنه مريح. أكثر مما توقعت...بالنظر إلى الأحوال الراهنة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: شكرًا لك على استضافتي. اعتقدت أنني سأقضي الليلة في الشارع قبل بزوغ الفجر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: وأنت؟ كيف تشعر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: أشعر بالقلق
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: أنا بخير. البقاء على قيد الحياة أهم شيء
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: أفهم قصدك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: في هذه الأيام... يبدو أن وضع أي خطط طويلة الأمد أمر لا فائدة منه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: لا تعرف أبدًا ما الذي سينال منك أولًا: الشمس أم المجانين أم هؤلاء الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: لكن البشرية نجت بالفعل من العديد من الكوارث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: أعتقد أننا سنترك إرثًا ما عندما نرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: سيجد أحدهم آثارنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: سيكون كل شيء على ما يرام يا حبيبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: تعجبني نظرتك للأمور. إنها تناسبك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: لكن لا تكتم كل شيء، اتفقنا؟ العواطف تنفجر إذا كتمتها طويلًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: في الوقت الذي لا تريدها فيه على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: لا تخجل من التحدث معي عن هذا الأمر في وقت ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: وإذا لم يكن معي، فمع شخص آخر. أي شخص.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: عدني بذلك، اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: نعم يا حبيبي؟ هل هناك ما يشغل بالك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: رأيتُ شيئًا غريبًا الليلة الماضية
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: حقًا؟ ما هو؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: بطنكِ. كانت أكبر
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: لا شيء... ربما كانت عيناي تخدعني
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: تقصد... كما لو أنني حامل أو شيء من هذا القبيل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: لا بأس يا حبيبي. أنا سعيدة لأنك كنت صريحًا معي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: ربما أنت تحت ضغوطات كبيرة؟ فأنت مسؤول عن الكثير من الأشخاص الآخرين في الوقت الحالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: أتفهم ذلك يا حبيبي. حين يحتمل أن يكون كل صباح هو الأخير، يصعب عليك تحمل مسؤولية نفسك فحسب، فكيف بالآخرين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: أنت لا تعرف حتى إن كنت ستعيش لترى الغد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: نعم... هذا يرعبني
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: لا، ليس هذا هو السبب
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: هل هناك ما يزعجك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: لا بأس يا حبيبي. الخوف يثقل كاهلنا جميعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: لقد رأيتك تستيقظ في وقت متأخر من الليل. وتقوم بجولات فحص.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: أنت شخص حذر للغاية، ومن الواضح أنك تهتم بأولئك الذين تسمح لهم بدخول منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: هذا... مثير للاهتمام. أنت متناقض في بعض الأمور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: أو ربما يكون السبب مجرد الأرق. قد يكون الخوف سببًا في شعورك به.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: نعم... هذا يرعبني
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: لا، ليس هذا هو السبب
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: يتطلب الاعتراف بذلك شجاعة كبيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: ولكن ماذا يمكننا أن نفعل حيال الخوف؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: هل يمكنك تقبل فكرة... أن الحياة محدودة؟ وأننا سنموت جميعًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: المهم هو أين تجد خلاصك. وهل ما زال موجودًا أصلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: أتفهّم ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: على أي حال... أنا قلقة عليك يا حبيبي. اهتم براحتك من وقت لآخر، حسنًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: أريدك أن تشعر بالأمان. فنحن نعيش تحت سقف واحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: ولكن إذا انتهى بك الأمر بفقدان صوابك، فسنفقد صوابنا جميعًا معك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: ...وسيكون ذلك كارثيًا علينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: لا أحد يريد ذلك، أليس كذلك يا عزيزي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: نعم يا حبيبي؟ هل هناك ما يشغل بالك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: أنا متأكد أنني رأيتك حاملًا الليلة الماضية. فسّري لي الأمر.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: بدأت تخيفني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: هل أنت متأكد حقًا أنك رأيت شيئًا الليلة الماضية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: لماذا لم توقظني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: هل هو الخوف من الموت مرة أخرى؟ أم أنه عبء الاهتمام بالآخرين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: أم أنني أنا السبب؟ أم أن هناك شخصًا آخر يشغل بالك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: لا تحاولي العبث بتفكيري
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: لكنني... متأكد من أنني رأيت شيئًا ما
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: لقد ذكرت والدك في ذلك اليوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: لم تذكره مرة أخرى، لذا لا أعرف الكثير عنه، حقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: لكن الآن... لديّ شعور غريب بأنك مثله تمامًا. نسخة طبق الأصل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: هل هذا يخيفك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: أنك عالق في ظله؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: إنه ميت، أليس كذلك؟ فلماذا تستمر في إحياء الذكريات؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: لن تقابله في الحياة الأخرى، كما تعلم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: لا أعتقد أنك ذاهب إلى المكان نفسه، لذا لا داعي للقلق يا حبيبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: لا تستعجل الإجابات كلها. الحياة تُبنى يومًا بعد يوم، كما يُبنى الجدار حجرًا فوق حجر. أتدرك ما أعني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: يا حبيبي... لا تتحدث معي بهذا الأسلوب مجددًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: من المؤلم رؤية ما يحدث لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: لكن يجب ألا تخاف الموت، ولا المسؤولية، ولا التقرب من الناس، ولا أي شيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: كل هذا جزء من الحياة يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: لا تستعجل الإجابات كلها. الحياة تُبنى يومًا بعد يوم، كما يُبنى الجدار حجرًا فوق حجر. أتدرك ما أعني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: قد يكون من الأفضل لنا أن نأخذ في الاعتبار أننا لن نختفي تمامًا عندما نموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: كنت أؤمن بالنعيم والعذاب. لكن الآن؟ لم أعد متأكدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: ربما هناك أشياء أخرى تنتظرنا بعد الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: ما رأيك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: نعم يا حبيبي؟ هل هناك ما يشغل بالك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: أنتِ حامل وموعد ولادتكِ قريب، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: أوه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: اليأس يسيطر على عواطفك، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: كل ما كنت تؤمن به ينهار أمامك... وأنت عاجز عن تقبل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: هل ذلك لأنك متردد جدًا في الذهاب إلى المكان الذي نتجه إليه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: أم أنك لم تعد تنتمي إلى هذا العالم؟ أو إلى أي عالم آخر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: لا تغيري الموضوع. أنتِ حامل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: ألستِ خائفة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: يا حبيبي... كيف يمكن أن يكون ذلك ممكنًا؟ انظر إليّ، لا توجد بطن كبيرة ولا أي آثار حمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: هل يمكنني أن أسألك شيئًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: لو كان هذا الطفل حقيقيًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: وإذا كان، كما تقول، سيخرج للحياة قريبًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: ماذا ستفعل به يا حبيبي؟ هل سترعاه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: لا ينبغي أن يكون موجودًا من الأساس
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: لم أقرر بعد
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: هممم. سؤال وجيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: بالطبع أنا خائفة من الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: في الغالب لأنني لا أعرف يقينًا ما الذي سيحدث بعد ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: النعيم، أم إعادة الميلاد، أو شيء آخر لا نعرفه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: لم يعد أحد من الموت ليخبرنا بما حدث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: ولكن بشأن رؤياك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: لو كان هذا الطفل حقيقيًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: وإذا كان، كما تقول، سيخرج للحياة قريبًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: ماذا ستفعل به يا حبيبي؟ هل سترعاه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: لا ينبغي أن يكون موجودًا من الأساس
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: لم أقرر بعد
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: تدفعنا الغريزة أحيانًا إلى الحفاظ على ما هو مألوف... حتى لو لم يعد مفيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: ربما...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: ربما حان الوقت لتفتح عينيك على شيء جديد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: أم أن المجهول يخيفك أكثر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: سأعثر على هذا الطفل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: أنا على يقين من قدومه
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: لا ينبغي أن تخشى ترك بعض الأشياء، خصوصًا حين تفقد قيمتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: أحيانًا نتمسك بشيء ما لمجرد أنه مألوف لنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: أعلم أن التخلص من العادات صعب... ولكن ربما سيعود ذلك علينا بفائدة كبيرة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: سأعثر على هذا الطفل
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: أنا على يقين من قدومه
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: كما تشاء يا حبيبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: أخبرني بما تجده... عندما يحين الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: حسنًا، هذا كل ما لديّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: أوه، كدت أنسى.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: سأعود إلى المنزل مساء الغد. سجّل رقمي، لقد أنشأوا الخط الأرضي هناك للتو.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour: {0} سنبقى على تواصل عبر الهاتف.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: حسنًا، هذا كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: اشرب جعّتك ونم قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: مياو!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: داعب القط
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: أمسك القط
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: أطعم القط بعض الطعام المعلب
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (تمد يدك لتداعب القط)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (من الصعب معرفة ما إذا كان يعجبه أم لا)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: مياو!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: داعب القط
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: أمسك القط
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: أطعم القط بعض الطعام المعلب
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (تقرر أن تداعب القط)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (يبدو أنه يعجبه بالفعل)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (ليس قطًا عنيدًا كما كنت تعتقد في البداية)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (يبدو أنه بدأ يعتاد عليك)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: مياو!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: داعب القط
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: أمسك القط
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: أطعم القط بعض الطعام المعلب
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (القط يحب المداعبة بشكل متكرر)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (تشعر وكأنه يميل نحو يديك)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (لكن كيف يمكنك أن ترفض هذا المخلوق اللطيف؟)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: مياو! مياااو! مياو!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (من الصعب قراءة تعابير وجهه الصغير، لكنك متأكد من أنه سعيد)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (ينتابك شعور غريب بأنك ستنام بسلام الليلة)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (يبدو أن صديقك اللطيف قد شاركك إحدى حيواته السبع ليشكرك)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (من يدري... ربما الموت سيبتعد عن منزلك الليلة)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: هؤلاء الأطفال المساكين...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: أهناك خطب ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: دعيني أفحصكِ
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: هاه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: كنت أفكر في شيء ما...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: إذا لم يكن هذا انقراضًا جماعيًا، وإذا نجونا بطريقة ما... فماذا سيحدث عندما ينتهي كل هذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: ما المستقبل الذي ينتظرنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: هل تخشين ألا يكون هناك مكان لكِ في هذا العالم الجديد؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: أصحاب القلوب الرحيمة لا يعيشون طويلاً اليوم. يجب أن تبقي قريبة من أحدهم.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: القلوب الرحيمة...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: لا أستطيع تحمل العنف... ناهيك عن ممارسته. لا أملك هذه الصفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: لست متأكدة من مكاني في هذا... "العالم الجديد" كما تقول.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: إذن ماذا ستفعلين، هل ستجلسين وتنتظرين الموت؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: وما البديل؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: لقد مرت البشرية بأوقات عصيبة من قبل... وهذا ليس بالأمر الجديد.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: لا أريد ذلك. حتى لو كان هناك شخص يعتني بي...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: القتل لن يتوقف... والعنف لن ينتهي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: إذن ماذا ستفعلين، هل ستجلسين وتنتظرين الموت؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: وما البديل؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: لقد مرت البشرية بأوقات عصيبة من قبل... وهذا ليس بالأمر الجديد.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: أشعر بالضياع التام.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: هل سنعيش حقًا محاطين بالقتلة من الآن فصاعدًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: هل سيتعلم أطفالنا دروسهم من القتلة والمجرمين في هذا العالم الجديد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: ليس لدينا وقت للتشاؤم
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: اجمعي شتات نفسكِ!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: لا... لا أعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: لم تعد لي فائدة في هذا العالم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: أريد أن ينتهي هذا الكابوس وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: لا يمكنني التحمل أكثر من ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: نعم، أنت محق. ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: كيف من المفترض أن نعيش من الآن فصاعدًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: لقد جن جنون العالم بأسره، والناس يقتلون أي شخص يبدو... مختلفًا ولو قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: لا يهم من يقف في طريقهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: ليس لدينا وقت للتشاؤم
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: اجمعي شتات نفسكِ!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: ولمَ لا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: قد تساعدك القسوة في التعامل مع كل هذه الفوضى. لكنها لا تفيدني في شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: لو أنك رأيت ما رأيته.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: كل لحظة رأيتها... ستظل محفورة في ذاكرتي إلى الأبد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: نار. صرخات. وجوه أطفال مليئة بالرعب. عائلات، ومنازل... كل شيء في حالة خراب.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: لا يمكن أن أكون مثلك. أنا لست بقوتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: أمثالي... ليس لهم سوى سبيل واحد للخلاص من هذا الوضع.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (ترتجف المرأة، وتنظر إليك بخوف)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (ساعدها هذا الارتباك على نسيان الكوابيس، ولكن لفترة قصيرة)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (تغطي وجهها بيديها وتبكي بهدوء)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (لا تعرف ماذا تفعل. لم يعلمك أحد كيفية التعامل مع أمر كهذا)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (تضع يدك بحذر على كتفها وتقف صامتًا لبعض الوقت)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (ربما من الأفضل تركها وشأنها)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: لديّ فكرة. ربما عليك أن تتصل به. رقمه {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: أعطه رأيي بصراحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: فبعد كل شيء، إنهم أطفاله أيضًا. ويجب أن يساعد في البحث عنهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: إذا تمكنت من البقاء حيًا، اتصل بها من أجلي، اتفقنا؟ رقمها {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: وأخبرها أنني... آسف... وأنني ما زلت أريد أن أقتلع فمي الذي تفوه بالكلام القذر.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: أو يمكنك أن تصرخ في أذنها... لا أعرف. ربما سيجعل ذلك الأمور أسهل قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: يجد البعض أن النصح والإرشاد من الجانب الآخر يمكن أن يساعد...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: هناك أشخاص... خبراء... في تطهير هذا الظلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: إذا أردت ذلك، يمكنني مساعدتك في التواصل معهم. أشعر أنك قد تحتاج إليهم...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: يمكنك التواصل معهم عبر هذا الرقم: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: ولا تنس أن تخبرهم بأنني من عرّفك بهم...!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: هل يمكنك الاتصال به، إذا لم يسبب لك ذلك أي إزعاج؟ الرقم هو {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (يسلمك ورقة عليها رقم هاتف: {0})'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (ربما يكون هذا رقم السفارة)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: أتوق بشدة إلى مشروب بارد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: ماذا قصدت عندما قلت إننا "خالدون"؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: في الواقع... يمكنك أن تطلق النار على رأسك وترى بنفسك، إذا أردت.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: لكنني أنصحك بعدم القيام بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: بالطبع نحن لسنا خالدين بالطريقة التي تفكر بها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: بعد الموت، نُبعث من جديد ونعيش مرة أخرى. ثم نموت مرة أخرى، وتستمر دورة إعادة البعث.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: أعرف كيف يبدو هذا، لكن لو رأيت ما رأيته... لفهمت.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: ربما كان الزوار بشرًا في السابق، ثم ولدوا من جديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: لا أستطيع الجزم. لا أعرف كيف يحدث هذا الهراء...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: أنا متأكد من أن الطبيعة تخفي عنا الكثير من الأسرار.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: لكنني سأجد ابنتي يومًا ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: لست متأكدًا إن كنت سأفعل ذلك في هذه الحياة أم في الحياة الأخرى... لكنني سأعثر عليها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: لأننا لا نموت على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: أتوق بشدة إلى مشروب بارد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: لماذا تبحث عنك الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: كنت في قلب الكارثة عندما انهار كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: في المنطقة التي بدأت تلك الأشياء تزحف منها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: هل سمعت يومًا تلك الخرافات السخيفة عن الشياطين في ضواحي المدينة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: لا أحد يتذكر أشياء تافهة كهذه الآن على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: اتضح أن هذه الشائعات لم تكن مجرد شائعات. وأن الوكالة الفيدرالية كانت على علم بذلك طوال الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: ادّعت أنه لم يكن هناك أي شيء خارق للطبيعة يحدث.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: والشمس تحمص الناس من شدة الحرارة الآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: بينما تقتل الوحوش التي خرجت من تحت الأرض الناجين!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: أدركت الوكالة الفيدرالية أنها أخطأت خطأ فادحًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: والآن تحاول جاهدة إخفاء عدم كفاءتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: لقد كنت في المكان الخطأ في الوقت الخطأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: أتوق بشدة إلى مشروب بارد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: كيف نجوت؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: هل نسيت؟ أنا خالد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: لا أعرف...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: ما زلت أسأل نفسي السؤال نفسه.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: ربما أنقذني الحظ. أو ربما هناك قوة لا أستوعبها ترعاني...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: ربما كان الرب يرعاني.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: وربما أكون قد مت بالفعل، وبُعثت في هذا الشكل. لست متأكدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: سؤال وجيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: من المؤسف أنني لا أملك سلاحًا، لسألتك الشيء نفسه.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: ومن المؤسف أن كل ما لديك هو الجعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: لو كان لديّ برميل تخمير، لصنعت لنا شرابًا لذيذًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: أتوق بشدة إلى مشروب بارد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: ماذا تعرف غير ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: أنا أعرف الهيكل التنظيمي للوكالة الفيدرالية بحذافيره.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: مَن مدير مَن، ومَن يفعل ماذا، ومَن يخدع مَن. كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: وكان هؤلاء الأوغاد يعرفون كل شيء عن الزوار، وكانوا على علم بمدى خطورتهم...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: ومع ذلك سمحوا لهم بدخول المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: لأنه لم يكن أحد منهم يهتم بسلامتنا نحن المدنيين.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: كانت الوكالة تغسل أموال الحكومة وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: وكل من شهد فشلها وأدركه أصبح ضحية.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: لم ترغب المنظمة في أن يعلم أحد آخر بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: وكان كل هذا يحدث حتى قبل إنشاء مناطق الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: تمكنت من الهرب بصعوبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: هل تريد معلومة سرية للغاية؟ حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: كل ما نعيشه الآن يقع على عاتق الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: وكل ما يقولونه في التلفاز؟ هراء تام.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: إذا كان هناك شيء أسوأ من الزوار في الوضع الحالي...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: فهم عملاء الوكالة الفيدرالية أنفسهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: أتوق بشدة إلى مشروب بارد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: من أين أتى الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: دعني أفحصك
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: من ضواحي البلدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: نعم، أعلم أن مناطق الحجر الصحي بعيدة عن هناك...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: ولكنني متأكد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: لست مؤمنًا بالخرافات، ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: إنهم ذات الشياطين التي كان الناس يذكرونها قبل عامين.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: لا أعرف كيف دخلوا المدينة...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: لكنني أعرف من سمح لهم بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: إنها الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: الزوار ليسوا كائنات فضائية كما يظن الكثير من الناس.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: إنهم كائنات حية، ولا يختلفون عني أو عنك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: وهم من سكان هذا الكوكب مثلنا تمامًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: لا أستطيع البقاء هنا أكثر من ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: عليّ العثور على ابنتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: شكرًا لك أيها الخالد.'
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: (يبدو أن المحادثة قد انتهت)'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071808
    m_Localized: سلّم إشعارًا من الوكالة الفيدرالية
