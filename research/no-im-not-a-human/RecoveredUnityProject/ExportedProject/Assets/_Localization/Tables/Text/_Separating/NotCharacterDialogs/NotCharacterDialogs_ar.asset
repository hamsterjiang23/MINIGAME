%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NotCharacterDialogs_ar
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ar
  m_SharedData: {fileID: 11400000, guid: e5ff4525f54b4b14096a51f9eb9cf8ce, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21953783779328
    m_Localized: 'TV: خبر عاجل!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556544
    m_Localized: 'TV: أصدرت الشمس في الساعة 6:28 صباح اليوم انبعاثات طاقة هائلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556545
    m_Localized: 'TV: وكانت هذه الطاقة المتفجرة أكبر بكثير مما توقعه العلماء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556546
    m_Localized: 'TV: ونتيجة لذلك، وصلت درجات الحرارة في الخارج إلى مستويات حرجة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556547
    m_Localized: 'TV: وقد أعلنت الحكومة منذ ذلك الحين حالة الطوارئ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556548
    m_Localized: 'TV: ونطلب من المشاهدين الامتناع عن الخروج خلال النهار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556549
    m_Localized: 'TV: والآن، ننتقل إلى—'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556550
    m_Localized: 'TV: لحظة واحدة...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556551
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556552
    m_Localized: 'TV: تلقى الاستوديو للتو رسالة عاجلة بشأن حالة تواصل مع ظاهرة نسميها "الزوار".'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556553
    m_Localized: 'TV: تصفهم شهادات شهود العيان بأنهم كائنات قادرة على تقليد مظهر البشر وسلوكهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556554
    m_Localized: 'TV: تجنبوا التواصل معهم بأي ثمن. في إحدى الحالات، تم التعرف على زائر من خلال علامة واحدة دالة...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556555
    m_Localized: 'TV: أسنان ناصعة البياض.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556556
    m_Localized: 'TV: تقاريرنا الأولية تبدو أنها تؤيد تلك العلامة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556557
    m_Localized: 'TV: تقول المصادر إنهم صادفوا شخصًا بلا مأوى لديه أسنان بيضاء مثالية، تبين لاحقًا أنه زائر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556558
    m_Localized: 'TV: هذا ما لدينا في الوقت الراهن. حافظوا على ضبط النفس، ولا تبرحوا منازلكم في وضح النهار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556559
    m_Localized: 'TV: التالي لدينا: شيء أكثر تفاؤلًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556560
    m_Localized: 'TV: مساء الخير. إليكم توقعات الطقس.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556561
    m_Localized: 'TV: رياح دافئة تتقدم نحو منطقتنا، مصحوبة بحرارة من المرجح أن تحطم جميع الأرقام القياسية السابقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556562
    m_Localized: 'TV: يخبرنا خبراء الأرصاد الجوية أننا نتوقع درجات حرارة أعلى خلال الأسبوع القادم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556563
    m_Localized: 'TV: مع زيادة نشاط الشمس، يمكننا أيضًا توقع أشعة فوق بنفسجية أقوى.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556564
    m_Localized: 'TV: من أجل سلامتكم، يُرجى الامتناع عن أخذ حمامات الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556565
    m_Localized: 'TV: كما أن درجات الحرارة المرتفعة قد تزيد بشكل كبير من خطر الإصابة بضربة شمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556566
    m_Localized: 'TV: في هذه المرحلة، لا يمكن معرفة ما إذا كان التعرض لأشعة الشمس وحده يمكن أن يؤثر سلبًا على صحتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556567
    m_Localized: 'TV: لتفادي حروق من الدرجة الثالثة، يُرجى عدم مغادرة المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556568
    m_Localized: 'TV: وللأسف، لن تحميكم واقيات الشمس من جميع عوامل الشمس بعد الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556569
    m_Localized: 'TV: هذا كل ما لدينا في الوقت الراهن. والآن أترككم مع برنامج الرقص مع البجع...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556570
    m_Localized: 'TV: ترى راقصات الباليه يرقصن برشاقة، ويعبرن المسرح بقفزات قوية ولكنها رقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556571
    m_Localized: 'TV: على الرغم من أناقة الرقصة، فإنها تثير مشاعر القلق.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556572
    m_Localized: 'TV: تشعر وكأنهن يحاولن صرف انتباهك عن الأحداث الجارية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556573
    m_Localized: 'TV: لو أن أحدًا يستطيع أن يشرح ما الذي يجري...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556574
    m_Localized: 'TV: مساء الخير. إليكم آخر الأخبار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556575
    m_Localized: 'TV: تزداد نشاطات الشمس بشكل مطرد مع وصول معدلات الجريمة إلى مستويات قياسية جديدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556576
    m_Localized: 'TV: فوفقًا للبيانات الحديثة، تجاوز عدد جرائم القتل خلال الليالي القليلة الماضية الأرقام المتوسطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556577
    m_Localized: 'TV: ويعتقد الخبراء أن هذا الأمر مرتبط بالقلق المتزايد في المجتمع بشأن الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556578
    m_Localized: 'TV: ولكن لحسن الحظ، تلقينا أيضًا معلومات جديدة حول كيفية التعرف على هؤلاء المزيفين...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556579
    m_Localized: 'TV: تُعد الأوساخ تحت الأظافر علامة مميزة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556580
    m_Localized: 'TV: ويقول المتخصصون إن هذه العلامة تساعد في التعرف على الزوار الذين زحفوا من تحت الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556581
    m_Localized: 'TV: هذا ما لدينا في الوقت الراهن. حافظوا على ضبط النفس، ولا تبرحوا منازلكم في وضح النهار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556582
    m_Localized: 'TV: يأتيكم تاليًا، تقرير عن أزمة تتعلق بمجنون شاحب. لكن أولًا، دعونا نأخذ فاصلًا إعلانيًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556583
    m_Localized: 'TV: في السابق، كان شراء المواد الغذائية يتطلب الذهاب إلى المتجر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556584
    m_Localized: 'TV: ولكن مع خدمة توصيل راحتك تهمنا، يمكنك الحصول على كل ما تحتاج إليه بمجرد رفع سماعة الهاتف!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556585
    m_Localized: 'TV: ما عليك سوى الاتصال برقم XXX-XXX-XXXX، وستصل مشترياتك إلى باب منزلك في غضون يوم واحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556586
    m_Localized: 'TV: راحتك تهمنا، استرخاء بصحبة طعام لذيذ... في منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556587
    m_Localized: 'TV: تفيد التقارير بظهور رجل شاحب ومجنون في شوارع المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556588
    m_Localized: 'TV: ومن خلال شهادات مختلفة، علمت الشرطة أن ضحاياه جميعهم كان لديهم شيء واحد مشترك... كانوا وحدهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556589
    m_Localized: 'TV: بالإضافة إلى ذلك، يحب المجنون التحدث إلى الضحية قبل ارتكاب جريمته الوحشية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556590
    m_Localized: 'TV: وقد قامت الشرطة بتجميع صورة تقريبية للقاتل استنادًا إلى شهادات شهود العيان.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556591
    m_Localized: 'TV: المشتبه به رجل في منتصف العمر شديد الشحوب له شعر أسود. وهو نحيف البنية ويرتدي بنطالًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556592
    m_Localized: 'TV: وأضافت تقارير أخرى أنه يرتدي أحيانًا جلد شخص آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556593
    m_Localized: 'TV: لم يتم تأكيد هذه المعلومات.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556594
    m_Localized: 'TV: إذا رأيتم هذا الرجل، لا تفتحوا الباب. لا تخبروه أنكم وحدكم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556595
    m_Localized: 'TV: هذا كل ما لدينا في الوقت الراهن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556596
    m_Localized: 'TV: مساء الخير. إليكم آخر الأخبار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556597
    m_Localized: 'TV: تستمر درجات الحرارة غير العادية في الارتفاع، ولا تظهر أي بوادر على تراجع غزو الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750848
    m_Localized: 'TV: وعليه، قامت الحكومة بتأسيس منظمة جديدة لمواجهة الوضع المستجد.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750849
    m_Localized: 'TV: الوكالة الفيدرالية لإدارة الطوارئ، والمعروفة اختصارًا باسم الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750850
    m_Localized: 'TV: يمكن التعرف على موظفي الوكالة الفيدرالية من خلال بدلاتهم الصفراء الواقية من المواد الخطرة وأقنعة الغاز التي يرتدونها.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750851
    m_Localized: 'TV: اكتشفت الوكالة، بعد أيام قليلة من تأسيسها، بالفعل طريقة جديدة لتمييز الزوار...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750852
    m_Localized: 'TV: أعينهم حمراء قانية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750853
    m_Localized: 'TV: وفقًا للتقارير، اكتشفت الوكالة الفيدرالية هذه العلامة بعد مراقبة الزوار المحتجزين.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750854
    m_Localized: 'TV: حيث تعاني هذه الكائنات من فرط الحساسية الضوئية، مما يؤدي إلى التهاب أعينها واحمرارها الشديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750855
    m_Localized: 'TV: هذا ما لدينا في الوقت الراهن. حافظوا على ضبط النفس، ولا تبرحوا منازلكم في وضح النهار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750856
    m_Localized: 'TV: يأتيكم تاليًا، تقرير عن الوكالة الفيدرالية. ولكن أولًا، إليكم كلمة من رعاتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750857
    m_Localized: 'TV: الاضطراب والرعب والمعاناة. وكل ذلك بسبب الزوار...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750858
    m_Localized: 'TV: ولكن في وقت الحاجة، وعندما كادت صرخاتنا أن تظل دون استجابة...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750859
    m_Localized: 'TV: جاءت الوكالة الفيدرالية لمساعدتنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750860
    m_Localized: 'TV: فهؤلاء الأبطال الشجعان من الوكالة الفيدرالية يحموننا من غزو الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750861
    m_Localized: 'TV: وحتى الآن، حددت الوكالة أكثر من سبعة وعشرين ألف حالة شاذة خطيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750862
    m_Localized: 'TV: تذكروا... يمكنكم مساعدة الوكالة بإبلاغها عن أي نشاط مشبوه.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750863
    m_Localized: 'TV: للقيام بذلك، ما عليكم سوى تسليم المشتبه بهم إشعارًا يطلب منهم زيارة الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750864
    m_Localized: 'TV: وإذا بدأتم تتساءلون عما إذا كنتم زوارًا، فاتصلوا بخطنا الساخن على الرقم: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750865
    m_Localized: 'TV: ساعدونا لنساعدكم. ادعموا الوكالة الفيدرالية وانضموا إلى معركتنا ضد الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750866
    m_Localized: 'TV: الوكالة الفيدرالية. ما هي؟ ولماذا تأسست؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750867
    m_Localized: 'TV: الوكالة الفيدرالية لإدارة الطوارئ هي خدمة حكومية خاصة تم تشكيلها للتخفيف من حدة الأزمة الناشئة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750868
    m_Localized: 'TV: وتساعد في معالجة العديد من المشكلات التي يسببها غزو الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750869
    m_Localized: 'TV: غير أن طبيعة مهمة الوكالة تظل غير واضحة...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750870
    m_Localized: 'TV: ولكن يمكننا القول بثقة إن مصيرنا في أيدٍ أمينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750871
    m_Localized: 'TV: تتألف الوكالة من خبراء في مختلف المجالات، بما في ذلك العديد من العلماء البارزين والباحثين المشهورين.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750872
    m_Localized: 'TV: إذا طرق موظف من الوكالة الفيدرالية بابكم، فإننا نوصيكم بالتعاون معه واتباع تعليماته.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750873
    m_Localized: 'TV: تذكروا... ساعدونا لنساعدكم. ادعموا الوكالة الفيدرالية وانضموا إلى معركتنا ضد الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750874
    m_Localized: 'TV: مساء الخير. إليكم آخر الأخبار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750875
    m_Localized: 'TV: اتخذت الوكالة الفيدرالية تدابير جديدة للتصدي لغزو الزوار المستمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750876
    m_Localized: 'TV: حيث قامت بتنظيم مناطق حجر صحي لاحتجاز المشتبه بهم الذين قد يشكلون خطرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750877
    m_Localized: 'TV: كما حددت الوكالة الفيدرالية علامة جديدة للزوار بعد إجراء تجارب على الذين تم احتجازهم...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750878
    m_Localized: 'TV: وجود إبطين خاليين من الشعر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750879
    m_Localized: 'TV: تفيد الوكالة الفيدرالية أن الزوار لا يوجد لديهم شعر ظاهر في هذه المنطقة، ما يجعلها علامة مفيدة لتمييزهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750880
    m_Localized: 'TV: وتطلب الوكالة من المواطنين التحلي بالصبر أثناء إجراء الاختبارات والامتثال لمرافقيهم إلى مناطق الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750881
    m_Localized: 'TV: هذا ما لدينا في الوقت الراهن. حافظوا على ضبط النفس، ولا تبرحوا منازلكم في وضح النهار.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750882
    m_Localized: 'TV: يأتيكم تاليًا، تقرير حول ما يمكنكم فعله إذا رصدتم زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750883
    m_Localized: 'TV: تشير الوكالة الفيدرالية إلى أن ظاهرة الزوار قد تكون معدية أو تشكل تهديدًا بيولوجيًا لم يتم الكشف عنه حتى الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750884
    m_Localized: 'TV: لهذا السبب، من الضروري الإبلاغ عن أي زوار محتملين وعزلهم على الفور.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750885
    m_Localized: 'TV: إذا تعذر تسليم الزائر إلى منطقة الحجر الصحي على الفور، فاحرصوا على إصدار طلب خاص له للمثول أمام الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750886
    m_Localized: 'TV: خلال جولة الجمع التالية، سيتحفظ أحد الموظفين على أي شخص يحمل هذه الورقة لفحصه.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750887
    m_Localized: 'TV: هذا كل ما لدينا في الوقت الراهن. والآن فاصل إعلاني...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750888
    m_Localized: 'TV: الحرارة لن توقفك، اشعر بالطاقة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750889
    m_Localized: 'TV: مع إنيرجيكا، اشعر بالحياة!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750890
    m_Localized: 'TV: واو! مشروب طاقة منشط يروي عطشك بشكل أسرع وأكثر فعالية من الماء!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750891
    m_Localized: 'TV: متوفر الآن عبر خدمة توصيل راحتك تهمنا. اطلبه على الرقم: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750892
    m_Localized: 'Window: منزل جارك يقبع وحيدًا في حقل القش.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750893
    m_Localized: 'Window: لا يوجد ضوء في النوافذ. يبدو أن عائلته نائمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750894
    m_Localized: 'Window: يقف كلب نحيف على الرصيف الذي يمر عبر الحقل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750895
    m_Localized: 'Window: إنه ينظر حوله بحزن، ربما محاولًا العثور على بعض الطعام.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750896
    m_Localized: 'Window: بعض السكارى ممددون على الأرض في الشارع.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750897
    m_Localized: 'Window: إنهم مستلقون على الأرض الباردة الصلبة ويبدو أنهم نائمون نومًا عميقًا. الظروف مواتية لهم في الوقت الحالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750898
    m_Localized: 'Window: في الأفق، ترى منزل جارك الذي يزورك حاليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750899
    m_Localized: 'Window: الضوء يتسلل عبر النوافذ، ويبدو أن عائلته تنتظر عودته إلى المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750900
    m_Localized: 'Window: ترى بعض المراهقين يتسكعون في الفناء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750901
    m_Localized: 'Window: إنهم جالسون دون أي اهتمام بالعالم من حولهم، يتحدثون عن شيء ما. لا يهتمون بك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750902
    m_Localized: 'Window: هناك صمت مطبق في الخارج.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750903
    m_Localized: 'Window: لا يوجد أحد هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750904
    m_Localized: 'Window: حتى السكارى قرروا عدم الخروج.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750905
    m_Localized: 'Window: هل هم خائفون من شيء ما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750906
    m_Localized: 'Window: ترى جارك وابنته من النافذة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750907
    m_Localized: 'Window: إنهما يلعبان، محاولين نسيان الأهوال الحالية...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750908
    m_Localized: 'Window: ولو للحظة واحدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750909
    m_Localized: 'Window: جثث المراهقين ملقاة على الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750910
    m_Localized: 'Window: شخص ما قتلهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750911
    m_Localized: 'Window: يبدو أن ذلك حدث مؤخرًا. فالدم لم يجف بعد.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750912
    m_Localized: 'Window: يقف على الرصيف رجل شاحب كأن الحياة هجرت وجنتيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750913
    m_Localized: 'Window: هناك طيات غريبة في جلده.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750914
    m_Localized: 'Window: يبدو وكأن جلده لا يتناسب مع حجم جسده.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750915
    m_Localized: 'Window: لا يمكنك رؤية عينيه من هنا، لكنك تشعر بنظرته الثاقبة إليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750916
    m_Localized: 'Window: تشعر فجأة بخوف شديد وتتمنى أن يعبر الزائر المرعب دون أن يلاحظ منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750917
    m_Localized: 'Window: هناك مجموعة صغيرة من موظفي الوكالة الفيدرالية يقفون بجوار منزل جارك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750918
    m_Localized: 'Window: تتساءل عما يتحدثون.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750919
    m_Localized: 'Window: ربما يأخذون عينات من التربة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750920
    m_Localized: 'Window: أو يبحثون عن مكان لتأسيس قاعدة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750921
    m_Localized: 'Window: تقع جثث المراهقين المتفحمة على الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750922
    m_Localized: 'Window: يبدو أنها كانت ملقاة على الأرض طوال اليوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750923
    m_Localized: 'Window: موظفان من الوكالة الفيدرالية يقفان بجانب الجثث ويكتبان شيئًا ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750924
    m_Localized: 'Window: من حسن الحظ أنهم حضروا لنقل الجثامين.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750925
    m_Localized: 'Window: تتجنب تخيل الأوبئة التي قد تتفشى إذا بقي اللحم المتحلل معرضًا للهواء.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750926
    m_Localized: 'Window: ترى مجموعة من الجنود المسلحين عبر النافذة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750927
    m_Localized: 'Window: يبدو أنها فرقة صغيرة أرسلتها المدينة إلى هنا لتوفير الأمن لموظفي الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750928
    m_Localized: 'Window: تسمع بعض المعلومات المتفرقة عن رجل شاحب البشرة عاري الصدر.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750929
    m_Localized: 'Window: ربما يريدون تعقب ذلك الزائر المخيف؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750930
    m_Localized: 'Window: منزل جارك، الذي كان قد طلاه باللون الأبيض للتو، احترق تمامًا وأصبح الآن أسود كالفحم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750931
    m_Localized: 'Window: يبدو أنه تم إخماد الحريق منذ قليل.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750932
    m_Localized: 'Window: هل من الممكن أن يكون أحدهم قد أحرقه عمدًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750933
    m_Localized: 'Window: ماذا حدث لعائلة جارك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750934
    m_Localized: 'Window: هل ما زال هناك أحد على قيد الحياة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750935
    m_Localized: 'Window: تدور الأفكار المقلقة في رأسك، وتغمرك مشاعر الحيرة والعجز.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750936
    m_Localized: 'Window: يقف الرجل الشاحب والمخيف في الشارع مبتسمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750937
    m_Localized: 'Window: إنه يحمل رأس شخص في خوذة.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750938
    m_Localized: 'Window: إنه رأس جندي، ووجهه مرعوب.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750939
    m_Localized: 'Window: لستَ متأكدًا مما أخافه أكثر... الزائر الشاحب أم موته الوشيك.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750940
    m_Localized: 'Window: جميع الجنود الذين وصلوا بالأمس... لقوا حتفهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750941
    m_Localized: 'Window: يبدو أن هناك مذبحة قد وقعت.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750942
    m_Localized: 'Window: الجثث متناثرة في جميع أنحاء الشارع، وإحدى الجثث مقطوعة الرأس.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750943
    m_Localized: 'Window: هل قتلهم ذلك الغريب الشاحب والمخيف؟'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750944
    m_Localized: مرحبًا، هنا مركز الطوارئ. كيف يمكنني مساعدتك؟ "الناس... إنهم يحترقون."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750945
    m_Localized: هل يمكنك وصف ما تراه؟ هل هناك حريق؟ "لا، إنها الشمس. إنهم... إنهم يحترقون تحت أشعة الشمس."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750946
    m_Localized: لا تغادر المنزل حتى حلول الظلام. "لا، ذلك الرجل يجول الشوارع ليلًا. الرجل الشاحب... إنه ليس بشرًا."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750947
    m_Localized: والآن ننتقل إلى برنامجنا الجديد، "نعم، أنا بشري".
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750948
    m_Localized: 'الأمر بسيط: أرسل صورك، وسنتحقق من هويتك الحقيقية.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750949
    m_Localized: 'ما عليك سوى إرسال صورك إلينا عبر البريد الإلكتروني إلى: yesiam@humanverification.agency، وسنتكفل ببقية الإجراءات.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750950
    m_Localized: ولكن يُرجى عدم إرسال أي شيء بخلاف العيون والأسنان والأظافر. لن نقبل أي شيء آخر.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750951
    m_Localized: هل أصبحت عيناك حمراء؟ وأسنانك بيضاء؟ هل ظهرت الأوساخ تحت أظافرك؟
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750952
    m_Localized: اعلم أن روحًا شريرة تسكنك. أنت زائر!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750953
    m_Localized: 'لا تدع هذا المرض يسيطر على جسمك! اتصل بخبرائنا على الفور على الرقم: 777-460.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750954
    m_Localized: سيطردون الأرواح الشريرة، ويطهرون جسدك من الهالة الضارة، ويوفرون لك حماية معززة.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750955
    m_Localized: مرحبًا بكم. حان وقت برنامج "أريد أن أصدق"، حيث سنكشف عن الألغاز والمؤامرات الحكومية.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750956
    m_Localized: اليوم، سنناقش حقيقة الزوار مع ضيف خاص، وهو دكتور في العلوم وموظف محترم في...
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750957
    m_Localized: مهلًا، ماذا!؟... ألن يأتي؟
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750958
    m_Localized: ...كيف سرقوا جميع وثائقه؟ كان هناك كم هائل من المعلومات فيها!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750959
    m_Localized: اللعنة. كنت أعلم أنه لن يُسمح لنا بالكشف عن الحقيقة. هؤلاء الملاع--
    m_Metadata:
      m_Items: []
  - m_Id: 17738415503822848
    m_Localized: 'TV: ذات مرة، كان هناك شقيقان يعيشان بالقرب من سد.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182976
    m_Localized: 'TV: كان ضخ الماء يوميًا يجعل النهر يصنع رغوة مثل مشروب بارد في يوم صيفي...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182977
    m_Localized: 'TV: في وقت لاحق من حياتهما، وبصورة طفولتهما في أذهانهما، أسس الأخوان معًا مصنع جعة بوبير.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182978
    m_Localized: 'TV: منذ ذلك الحين، أصبحت جعة بوبير واحدة من أكثر أنواع الجعة مبيعًا في المنازل والحانات.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182979
    m_Localized: 'TV: جعة بوبير. اشرب أكثر. لأنك تستحق الأفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182980
    m_Localized: 'Window: تنظر إلى أنقاض منزل جارك.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182981
    m_Localized: 'Window: كانت تعيش عائلة سعيدة هناك حتى وقت قريب. الآن، لم يتبقَ سوى هيكل فارغ.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182982
    m_Localized: 'Window: ينتابك شعور غريب بالارتباك. كما لو كنت تعلم أن هذا سيحدث...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182983
    m_Localized: 'Window: ...كما لو أن الموت كان قادمًا إلى ذلك المنزل، قريبًا جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182984
    m_Localized: 'Window: ترى جمجمة بشرية تزين عمودًا، ولا تزال ترتدي خوذة.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182985
    m_Localized: 'Window: جلد البشري محروق بالكامل، ويبدو أن أحدهم قد انتزع أسنانه.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182986
    m_Localized: 'Window: لا بد أن الرأس كان معلقًا طوال اليوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182987
    m_Localized: 'Window: يراودك شعور بأن هذا المشهد المروع رسالة تهديد تركها الزائر الشاحب.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182988
    m_Localized: 'Window: يفتش مسؤولو الوكالة الفيدرالية موقع المجزرة التي وقعت مؤخرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182989
    m_Localized: 'Window: إنهم يأخذون جميع معدات الجنود القتلى وأسلحتهم لمنع النهب.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182990
    m_Localized: 'Window: ربما لم يتوقعوا نجاة الزائر الشاحب من مجموعة من الجنود المسلحين.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182991
    m_Localized: 'Window: هناك المزيد من أكياس الجثث حاليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576140324864
    m_Localized: 'TV: مساء الخير. إليكم توقعات الطقس.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102080
    m_Localized: 'TV: رياح دافئة تتقدم نحو منطقتنا، مصحوبة بحرارة من المرجح أن تحطم جميع الأرقام القياسية السابقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102081
    m_Localized: 'TV: يخبرنا خبراء الأرصاد الجوية أننا نتوقع درجات حرارة أعلى خلال الأسبوع القادم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102082
    m_Localized: 'TV: مع زيادة نشاط الشمس، يمكننا أيضًا توقع أشعة فوق بنفسجية أقوى.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102083
    m_Localized: 'TV: من أجل سلامتكم، يُرجى الامتناع عن أخذ حمامات الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102084
    m_Localized: 'TV: كما أن درجات الحرارة المرتفعة قد تزيد بشكل كبير من خطر الإصابة بضربة شمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102085
    m_Localized: 'TV: في هذه المرحلة، لا يمكن معرفة ما إذا كان التعرض لأشعة الشمس وحده يمكن أن يؤثر سلبًا على صحتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102086
    m_Localized: 'TV: لتفادي حروق من الدرجة الثالثة، يُرجى عدم مغادرة المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102087
    m_Localized: 'TV: وللأسف، لن تحميكم واقيات الشمس من جميع عوامل الشمس بعد الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102088
    m_Localized: 'TV: التالي: المزيد من تحديثات الطقس. ولكن أولًا، إليكم رسالة من رعاتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102089
    m_Localized: 'TV: ترى راقصات الباليه يرقصن برشاقة، ويعبرن المسرح بقفزات قوية ولكنها رقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102090
    m_Localized: 'TV: على الرغم من أناقة الرقصة، فإنها تثير مشاعر القلق.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102091
    m_Localized: 'TV: كما لو كان الهدف منها صرف انتباهك عن الواقع.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102092
    m_Localized: 'TV: لو أن أحدًا يستطيع أن يشرح ما الذي يجري...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102093
    m_Localized: 'TV: في السابق، كان شراء المواد الغذائية يتطلب الذهاب إلى المتجر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102094
    m_Localized: 'TV: ولكن مع خدمة توصيل راحتك تهمنا، يمكنك الحصول على كل ما تحتاج إليه بمجرد رفع سماعة الهاتف!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102095
    m_Localized: 'TV: ما عليك سوى الاتصال برقم {0}، وستصل مشترياتك إلى باب منزلك في غضون يوم واحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102096
    m_Localized: 'TV: راحتك تهمنا، استرخاء بصحبة طعام لذيذ... في منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102097
    m_Localized: 'TV: تفيد التقارير بظهور رجل شاحب ومجنون في شوارع المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102098
    m_Localized: 'TV: ومن خلال شهادات مختلفة، علمت الشرطة أن ضحاياه جميعهم كان لديهم شيء واحد مشترك... كانوا وحدهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102099
    m_Localized: 'TV: بالإضافة إلى ذلك، يحب المجنون التحدث إلى الضحية قبل ارتكاب جريمته الوحشية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102100
    m_Localized: 'TV: وقد قامت الشرطة بتجميع صورة تقريبية للقاتل استنادًا إلى شهادات شهود العيان.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102101
    m_Localized: 'TV: المشتبه به رجل في منتصف العمر شديد الشحوب له شعر أسود. وهو نحيف البنية ويرتدي بنطالًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102102
    m_Localized: 'TV: وأضافت تقارير أخرى أنه يرتدي أحيانًا جلد شخص آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102103
    m_Localized: 'TV: لم يتم تأكيد هذه المعلومات.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102104
    m_Localized: 'TV: إذا رأيتم هذا الرجل، لا تفتحوا الباب. لا تخبروه أنكم وحدكم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102105
    m_Localized: 'TV: هذا كل ما لدينا في الوقت الراهن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102106
    m_Localized: 'TV: الاضطراب والرعب والمعاناة. وكل ذلك بسبب الزوار...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102107
    m_Localized: 'TV: ولكن في وقت الحاجة، وعندما كادت صرخاتنا تظل دون استجابة...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102108
    m_Localized: 'TV: جاءت الوكالة الفيدرالية لمساعدتنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102109
    m_Localized: 'TV: فهؤلاء الأبطال الشجعان من الوكالة الفيدرالية يحموننا من غزو الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102110
    m_Localized: 'TV: وحتى الآن، حددت الوكالة أكثر من سبعة وعشرين ألف حالة شاذة خطيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102111
    m_Localized: 'TV: تذكروا... يمكنكم مساعدة الوكالة بإبلاغها عن أي نشاط مشبوه.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102112
    m_Localized: 'TV: للقيام بذلك، ما عليكم سوى تسليم المشتبه بهم إشعارًا يطلب منهم زيارة الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102113
    m_Localized: 'TV: وإذا بدأتم تتساءلون عما إذا كنتم زوارًا، فاتصلوا بخطنا الساخن على الرقم: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102114
    m_Localized: 'TV: ساعدونا لنساعدكم. ادعموا الوكالة الفيدرالية وانضموا إلى معركتنا ضد الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102115
    m_Localized: 'TV: الوكالة الفيدرالية. ما هي؟ ولماذا تأسست؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102116
    m_Localized: 'TV: الوكالة الفيدرالية لإدارة الطوارئ هي خدمة حكومية خاصة تم تشكيلها للتخفيف من حدة الأزمة الناشئة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102117
    m_Localized: 'TV: وتساعد في معالجة العديد من المشكلات التي يسببها غزو الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102118
    m_Localized: 'TV: غير أن طبيعة مهمة الوكالة تظل غير واضحة...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102119
    m_Localized: 'TV: ولكن يمكننا القول بثقة إن مصيرنا في أيدٍ أمينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102120
    m_Localized: 'TV: تتألف الوكالة من خبراء في مختلف المجالات، بما في ذلك العديد من العلماء البارزين والباحثين المشهورين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102121
    m_Localized: 'TV: إذا طرق موظف من الوكالة الفيدرالية بابكم، فإننا نوصيكم بالتعاون معه واتباع تعليماته.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102122
    m_Localized: 'TV: تذكروا... ساعدونا لنساعدكم. ادعموا الوكالة الفيدرالية وانضموا إلى معركتنا ضد الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102123
    m_Localized: 'TV: تشير الوكالة الفيدرالية إلى أن ظاهرة الزوار قد تكون معدية أو تشكل تهديدًا بيولوجيًا لم يتم الكشف عنه حتى الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102124
    m_Localized: 'TV: لهذا السبب، من الضروري الإبلاغ عن أي زوار محتملين وعزلهم على الفور.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102125
    m_Localized: 'TV: إذا تعذر تسليم الزائر إلى منطقة الحجر الصحي على الفور، فاحرصوا على إصدار طلب خاص له للمثول أمام الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102126
    m_Localized: 'TV: خلال جولة الجمع التالية، سيتحفظ أحد الموظفين على أي شخص يحمل هذه الورقة لفحصه.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102127
    m_Localized: 'TV: هذا كل ما لدينا في الوقت الراهن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102128
    m_Localized: 'TV: الحرارة لن توقفك، اشعر بالطاقة!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102129
    m_Localized: 'TV: مع إنيرجيكا، اشعر بالحياة!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102130
    m_Localized: 'TV: واو! مشروب طاقة منشط يروي عطشك بشكل أسرع وأكثر فعالية من الماء!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102131
    m_Localized: 'TV: متوفر الآن عبر خدمة توصيل راحتك تهمنا. اطلبه على الرقم: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102132
    m_Localized: 'TV: مساء الخير. تشاهدون آخر الأخبار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102133
    m_Localized: 'TV: إثر تصاعد حالات رصد الزوّار المشبوهين، أعلنت الوكالة الفيدرالية اتخاذ إجراءات وقائية جديدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102134
    m_Localized: 'TV: اعتبارًا من الآن، سيُطبّق حجر صحي كامل في جميع المناطق الحضرية الكبرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102135
    m_Localized: 'TV: يُحظر تمامًا السفر خارج مدينتكم أو إلى القرى المجاورة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102136
    m_Localized: 'TV: يُرجى عدم مغادرة المنطقة المحددة لكم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102137
    m_Localized: 'TV: بالإضافة إلى ذلك، كشفت الوكالة الفيدرالية عن إجراء جديد لتحديد هوية الزوار:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102138
    m_Localized: 'TV: التصوير الفوتوغرافي للهالة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102139
    m_Localized: 'TV: إن ظهور بقع داكنة على صورة تم التقاطها مؤشر قوي على أن الهدف قد يكون زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102140
    m_Localized: 'TV: هذه آخر المستجدات حتى الآن. حافظوا على ضبط النفس، ولا تبرحوا منازلكم في وضح النهار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102141
    m_Localized: 'TV: الآن، حان وقت فقرة العلوم!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102142
    m_Localized: 'TV: مَن هم الزوار؟ أشباح؟ مخلوقات من أعماق الأرض؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102143
    m_Localized: 'TV: لا، هذه ليست رواية خيال علمي ولا عنوان رخيص لجذب المشاهدات.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102144
    m_Localized: 'TV: بل واقعنا الجديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102145
    m_Localized: 'TV: تستمر الشائعات حول الأصل الحقيقي للزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102146
    m_Localized: 'TV: هل هم كائنات فضائية؟ أم موتى أحياء؟ أم تجربة معملية فاشلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102147
    m_Localized: 'TV: وفقًا للسلطات، فإن هذه كلها مجرد نظريات لا أساس لها من الصحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102148
    m_Localized: 'TV: تشير الدراسات إلى أن الزائر عبارة عن بشري تعرض لعوامل بيولوجية غير محددة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102149
    m_Localized: 'TV: لا تزال طرق انتقال العدوى مجهولة، وتحث الوكالة الفيدرالية الجميع على توخي الحذر من علامات ظهور الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102150
    m_Localized: 'TV: إذا كنت تعتقد أنك تعرضت للعدوى، أو إذا كنت غير متأكد مما إذا كنت زائرًا أم لا، فاتصل بالوكالة الفيدرالية على الرقم:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102151
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102152
    m_Localized: 'TV: هذه آخر المستجدات حتى الآن. ترقبوا المزيد... بعد الفاصل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102153
    m_Localized: 'TV: تزداد صعوبة اكتشاف الزوار يومًا بعد يوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102154
    m_Localized: 'TV: العلامات تساعد في البحث... لكن هل سبق لك أن رغبت في الوصول إلى طريقة مضمونة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102155
    m_Localized: 'TV: نقدم لكم فيلمنا الفوتوغرافي الجديد والثوري الحساس للهالات!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102156
    m_Localized: 'TV: إنه يكشف طاقة الروح، ما يسمح لك بالتمييز بين الإنسان والزائر المعادي في راحة منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102157
    m_Localized: 'TV: التقط صورة... وإذا رأيت بقعًا سوداء، فهذا يعني أنك عثرت على زائر!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102158
    m_Localized: 'TV: اتصل الآن للحصول على عُدة المبتدئين المجانية: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102159
    m_Localized: 'TV: نبأ عاجل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102160
    m_Localized: 'TV: حرائق واسعة تجتاح الغابات في الوقت الراهن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102161
    m_Localized: 'TV: ويعتقد الخبراء أن السبب في ذلك هو النشاط الشمسي المرتفع بشكل غير عادي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102162
    m_Localized: 'TV: لم يتحدد حجم الكارثة بعد، إلا أن فرق الإنقاذ من المدن القريبة باشرت عمليات الإطفاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296384
    m_Localized: 'TV: حافظوا على ضبط النفس، ولا تبرحوا منازلكم في وضح النهار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296385
    m_Localized: 'TV: ...هذه آخر المستجدات في الوقت الراهن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296386
    m_Localized: 'TV: التالي: كلمة من رعاتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296387
    m_Localized: 'TV: ذات مرة، كان هناك شقيقان يعيشان بالقرب من سد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296388
    m_Localized: 'TV: كان ضخ الماء يوميًا يجعل النهر يصنع رغوة مثل مشروب بارد في يوم صيفي...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296389
    m_Localized: 'TV: في وقت لاحق من حياتهما، وبصورة طفولتهما في أذهانهما، أسس الأخوان معًا مصنع جعة بوبير.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296390
    m_Localized: 'TV: منذ ذلك الحين، أصبحت جعة بوبير واحدة من أكثر أنواع الجعة مبيعًا في المنازل والحانات.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296391
    m_Localized: 'TV: جعة بوبير. اشرب أكثر. لأنك تستحق الأفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296392
    m_Localized: 'TV: نأسف لقطع هذا البرنامج لننقل لكم آخر الأخبار العاجلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296393
    m_Localized: 'TV: أنباء عاجلة عن اضطرابات مدنية في مدينة مجاورة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296394
    m_Localized: 'TV: وبسبب الظروف غير المواتية، أغلقت قوات الوكالة الفيدرالية المنطقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296395
    m_Localized: 'TV: يُرجى عدم مغادرة منازلكم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296396
    m_Localized: 'TV: الزموا منازلكم وانتظروا التعليمات القادمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296397
    m_Localized: 'TV: وتذكروا... ادعموا الوكالة الفيدرالية وانضموا إلى معركتنا ضد الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296398
    m_Localized: 'TV: هذا كل ما لدينا في الوقت الراهن. والآن فاصل إعلاني.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296399
    m_Localized: 'TV: يحتاج أكثر العمال اجتهادًا إلى استراحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296400
    m_Localized: 'TV: مع سجائر مارغورو، يمكنك أن تأخذ نفسًا وتسترخي بعد مجهوداتك الشاقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296401
    m_Localized: 'TV: مارغورو. سجائر الرجال الأشداء.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296402
    m_Localized: 'TV: إخلاء المسؤولية: الشركة غير مسؤولة عن أي ضرر قد يصيب الرئتين أو يقلل العمر الافتراضي. الاستهلاك على مسؤولية المستخدم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296403
    m_Localized: 'TV: مساء الخير. إليكم آخر الأخبار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296404
    m_Localized: 'TV: نقدم لكم تحديثًا مهمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296405
    m_Localized: 'TV: ظهرت تفاصيل جديدة بشأن حادثة وقعت مؤخرًا في المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296406
    m_Localized: 'TV: وردت أنباء عن هجوم مسلح على إحدى مناطق الحجر الصحي في المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296407
    m_Localized: 'TV: الدوافع مجهولة، والتحقيقات مستمرة لمعرفة وجود عناصر أخرى متورطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296408
    m_Localized: 'TV: في الوقت ذاته، هرب عدة أشخاص من منطقة الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296409
    m_Localized: 'TV: الصمت نذير الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296410
    m_Localized: 'TV: إنه هدوء مريب يستنزف الروح.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296411
    m_Localized: 'TV: لكن الأسوأ من الفراغ... هو الرنين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296412
    m_Localized: 'TV: جرس جنازة بعيد يزداد صوته وضوحًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296413
    m_Localized: 'TV: تدق الأجراس لنا جميعًا، تملأ آذاننا بضجيج لا نهاية له.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296414
    m_Localized: 'TV: وبأفكار قذرة عالقة في الشمع.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296415
    m_Localized: 'TV: وكر جحيمي يعيش فيه الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296416
    m_Localized: 'TV: متشابك في مادة لزجة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296417
    m_Localized: 'TV: الشمع الغامر. الشمع الغامر. الشمع الغامر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296418
    m_Localized: 'TV: أثارت حادثة اليوم الكثير من التكهنات.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296419
    m_Localized: 'TV: بعض التقارير تذكر مطلق نار واحد، بينما تشير أخرى إلى عدة مسلحين يرتدون سترات بأغطية رأس.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296420
    m_Localized: 'TV: إلا أن المدينة قد تواجه تحدياتها الأكبر في الأيام المقبلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296421
    m_Localized: 'TV: فقد أدى الإغلاق المفروض إلى تأجيل عمليات الدفن مؤقتًا في المناطق المحيطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296422
    m_Localized: 'TV: إلا أن عمليات التفتيش في المساكن ستُجرى كما هو مقرر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296423
    m_Localized: 'TV: إذا كان بإمكانكم حرق الجثث، فافعلوا ذلك على الفور.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296424
    m_Localized: 'TV: في حال عدم الإمكانية، يُرجى تأجيل التعامل مع الجثامين المتراكمة حتى حل المشكلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296425
    m_Localized: 'TV: هذه آخر المستجدات حتى الآن. ترقبوا الجديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296426
    m_Localized: 'TV: مساء الخير. تشاهدون آخر الأخبار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296427
    m_Localized: 'TV: تقدم الوكالة الفيدرالية حاليًا المساعدة لضحايا الهجوم على منطقة الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296428
    m_Localized: 'TV: ونظرًا لاكتظاظ المرافق الحالية، اتخذت الوكالة القرار التالي:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296429
    m_Localized: 'TV: سيتم إيواء السكان الذين تم إجلاؤهم مؤقتًا في مبانٍ تقع في ضواحي المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296430
    m_Localized: 'TV: في المقابل، أظهر المواطنون المحليون تعاونًا مع الوكالة الفيدرالية وقدموا عروضًا لإيواء المتضررين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296431
    m_Localized: 'TV: حتى لحظة إعداد هذا التقرير، أُلقي القبض على بعض الهاربين فقط.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296432
    m_Localized: 'TV: ولكن لحسن الحظ، أعلن المسؤولون في وقت سابق اليوم عن طريقة تمييز جديدة للزوار:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296433
    m_Localized: 'TV: نزيف اللثة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296434
    m_Localized: 'TV: إذا جاء شخص يعاني من هذه الحالة إلى باب منزلكم، فلا تتعاملون معه.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296435
    m_Localized: 'TV: انتظروا دورية الوكالة الفيدرالية المجدولة وأبلغوا السلطات المختصة عن المشتبه به.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296436
    m_Localized: 'TV: الزموا منازلكم وانتظروا التعليمات القادمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296437
    m_Localized: 'TV: ...هذه آخر المستجدات في الوقت الراهن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296438
    m_Localized: 'TV: التالي: تقرير خاص عن طائفة جديدة خطيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296439
    m_Localized: 'TV: الزوار لا يختبئون بيننا فحسب. بل يتسللون إلى أفكارنا ويلوثونها.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296440
    m_Localized: 'TV: أبلغت عدة مدن الآن عن تفشي أنشطة طائفية منظمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296441
    m_Localized: 'TV: وتشمل التهم الموجهة إليهم ما يلي:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296442
    m_Localized: 'TV: تضحيات شعائرية، وعبادة كيان مجهول، وربما تواطؤ مع الزوار أنفسهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296443
    m_Localized: 'TV: وفقًا لهذه التقارير الجديدة، اتخذت الطائفة موقفًا علنيًا ضد الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296444
    m_Localized: 'TV: ما بدأ كممارسة دينية بريئة أصبح نشاطًا إجراميًا سافرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296445
    m_Localized: 'TV: يعتقد بعض الخبراء أن هذه الطائفة قد تكون مسؤولة عن الأحداث العنيفة التي وقعت مؤخرًا في المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296446
    m_Localized: 'TV: نحث المشاهدين على تجنب التواصل مع هؤلاء الذين يُطلق عليهم اسم "المؤمنين الجدد".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296447
    m_Localized: 'TV: وقد تؤدي مساعدة أي من أتباع الطوائف أو التعاطف معهم إلى الاعتقال أو توجيه تهم جنائية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296448
    m_Localized: 'TV: هذه آخر المستجدات حتى الآن. ترقبوا الجديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296449
    m_Localized: 'TV: مساء الخير. إليكم آخر الأخبار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296450
    m_Localized: 'TV: يستقر الوضع في المدينة تدريجيًا، لكن بعض الهاربين ما زالوا طلقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296451
    m_Localized: 'TV: في غضون ذلك، استؤنفت عمليات التخلص من الجثث، رغم ظهور تحديات جديدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296452
    m_Localized: 'TV: وفقًا لآخر التقارير، تجوب الآن مجموعات من الكلاب الضالة الشوارع.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296453
    m_Localized: 'TV: وقد نشرت الوكالة الفيدرالية فريقًا للتصدي لهذا التهديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296454
    m_Localized: 'TV: كما أعلنت الوكالة عن علامة جديدة للتعرف على الأفراد الذين يشكلون خطرًا محتملًا:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296455
    m_Localized: 'TV: تهيج الجلد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296456
    m_Localized: 'TV: التحقيق في الهجوم لا يزال جاريًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296457
    m_Localized: 'TV: ولكن ما زال من غير الواضح ما إذا كان المعتدي بمفرده أم لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296458
    m_Localized: 'TV: ومع ذلك، لا شك في أن الوكالة الفيدرالية ستحتوي هذا التهديد، فضلًا عن تهديد الزوار المستمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296459
    m_Localized: 'TV: إذا كان لديكم أي أسئلة حول كيفية التعرف على الزوار، فإن الخط الساخن للوكالة الفيدرالية متاح على:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296460
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296461
    m_Localized: 'TV: ونعيد ونذكركم، الزموا منازلكم وانتظروا التعليمات القادمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296462
    m_Localized: 'TV: ...هذه آخر المستجدات في الوقت الراهن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296463
    m_Localized: 'TV: التالي: تقرير عن الوضع المتطور في الحزام الاستوائي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296464
    m_Localized: 'TV: نتابع هذا المساء أخبارًا مقلقة من المناطق الاستوائية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296465
    m_Localized: 'TV: تتفشى الحرائق الهائلة والحرارة الشديدة والجفاف في العديد من الدول.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296466
    m_Localized: 'TV: وفقًا للتقارير، درجات الحرارة وصلت لحد يجعل اللمس البسيط للأرض يُسبب حروقًا من الدرجة الثالثة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296467
    m_Localized: 'TV: لا يزال عدد الضحايا مجهولًا، كما أن عملية الإجلاء مستحيلة في الوقت الحالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296468
    m_Localized: 'TV: لم تتمكن حكومتنا حتى الآن من التواصل مع السلطات في المناطق المتضررة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296469
    m_Localized: 'TV: لكن حين تسمح الظروف، ستنتشر فرق الوكالة الفيدرالية لمساعدة المتضررين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296470
    m_Localized: 'TV: هذه آخر المستجدات حتى الآن. ترقبوا آخر التحديثات.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296471
    m_Localized: 'TV: مساء الخير. تشاهدون آخر الأخبار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296472
    m_Localized: 'TV: لا تزال الأوضاع في المدينة غير مستقرة، ولا يزال الحظر المفروض مؤخرًا ساريًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296473
    m_Localized: 'TV: كما ظهر تهديد جديد. فقد شوهد أعضاء الطائفة في ضواحي المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296474
    m_Localized: 'TV: يُشتبه في أنهم يستعدون لطقوس باستخدام النار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296475
    m_Localized: 'TV: تعتقد الوكالة الفيدرالية أن هذه المجموعة قد تكون متورطة بشكل مباشر في الهجمات الأخيرة على مناطق الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296476
    m_Localized: 'TV: ولكن لسوء الحظ، وبسبب الأوضاع الراهنة، لا تستطيع الوكالة الفيدرالية ولا الجيش توفير قوة للتعامل معها في الوقت الراهن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296477
    m_Localized: 'TV: إذا اقترب أي من أعضاء الطائفة من منزلكم، فاتصلوا على الفور بالخط الساخن للوكالة الفيدرالية على: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296478
    m_Localized: 'TV: ولمساعدتكم في هذه الأوقات العصيبة، أعلنت الوكالة أيضًا عن علامة جديدة لتمييز الزوار:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296479
    m_Localized: 'TV: نمو الفطريات في منطقة الإبط.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296480
    m_Localized: 'TV: ونعيد ونذكركم، الزموا منازلكم وانتظروا التعليمات القادمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296481
    m_Localized: 'TV: ...هذه آخر المستجدات في الوقت الراهن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296482
    m_Localized: 'TV: التالي: آخر المستجدات عن الأحوال الجوية في القطبين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296483
    m_Localized: 'TV: الشمس تضرب مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296484
    m_Localized: 'TV: أصدر العلماء توقعات جديدة مقلقة بشأن المناخ العالمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296485
    m_Localized: 'TV: إذا لم تهدأ موجة الحرارة الحالية، فقد تؤدي المياه الناتجة عن ذوبان القمم الجليدية القطبية إلى فيضانات كارثية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296486
    m_Localized: 'TV: ويواصل الباحثون التحقيق في سبب الانحراف المناخي المستمر، ولكن لم يتم التوصل إلى أي إجابات حتى الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296487
    m_Localized: 'TV: هذا كل ما لدينا في الوقت الراهن. ترقبوا آخر المستجدات.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296488
    m_Localized: 'TV: خبر عاجل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296489
    m_Localized: 'TV: لا تظهر أي بوادر على استقرار الأوضاع في المدينة، وتستمر الكارثة في التفاقم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296490
    m_Localized: 'TV: مع ذوبان الأنهار الجليدية، يرتفع مستوى سطح البحر بمعدل ينذر بالخطر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296491
    m_Localized: 'TV: وهذا يعّرض المناطق الساحلية في جميع أنحاء العالم، بما في ذلك العديد من المدن الكبرى، لخطر الفيضانات المدمرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296492
    m_Localized: 'TV: بدأت أيضًا عدة بحيرات ملوثة إشعاعيًا تتبخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296493
    m_Localized: 'TV: مع تحذير العلماء في جميع أنحاء العالم من أن هذا قد يؤدي إلى هطول أمطار سامة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296494
    m_Localized: 'TV: إذا سمعتم صوت الرعد، فابحثوا عن مأوى على الفور لحماية أنفسكم من التعرض للأمطار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296495
    m_Localized: 'TV: وللأسف، لا تزال المدينة في حالة إغلاق تام.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296496
    m_Localized: 'TV: لم تقبض الوكالة الفيدرالية بعد على جميع الهاربين، وأعلنت الآن عن علامة جديدة لتمييز الزوار:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296497
    m_Localized: 'TV: حركة سريعة في حدقة العين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296498
    m_Localized: 'TV: نبأ عاجل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296499
    m_Localized: 'TV: نعتذر عن قطع البث بسبب تعرض الاستوديو لهجوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296500
    m_Localized: 'TV: إذا كانت لديكم أسئلة حول كيفية تمييز الزوار، فاتصلوا بالخط الساخن: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296501
    m_Localized: 'TV: نهاية البث.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296502
    m_Localized: 'TV: خبر عاجل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296503
    m_Localized: 'TV: قامت الوكالة الفيدرالية للتو باعتقال غالبية المسؤولين الحكوميين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296504
    m_Localized: 'TV: وتفيد الوكالة أن بعض أعضاء الحكومة تم تحديدهم على أنهم زوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296505
    m_Localized: 'TV: ومع توقف الوزارات عن العمل، ستتولى الوكالة الفيدرالية دور الحكومة المؤقتة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296506
    m_Localized: 'TV: بالإضافة إلى ذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296507
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296508
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296509
    m_Localized: 'TV: عفوًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296510
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296511
    m_Localized: 'TV: وردنا نبأ الآن من الوكالة الفيدرالية:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296512
    m_Localized: 'TV: اخترق الهاربون الحصار المفروض على المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296513
    m_Localized: 'TV: نكرر، اخترق الهاربون الحصار المفروض على المدينة وأصبحوا الآن طلقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296514
    m_Localized: 'TV: أغلقوا نوافذكم. وأقفلوا أبوابكم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296515
    m_Localized: 'TV: الزموا منازلكم وانتظروا التعليمات القادمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296516
    m_Localized: 'TV: نهاية البث.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296517
    m_Localized: 'Window: منزل جارك يقبع وحيدًا في حقل القش.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296518
    m_Localized: 'Window: لا يوجد ضوء في النوافذ. يبدو أن عائلته نائمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296519
    m_Localized: 'Window: بعض السكارى ممددون على الأرض في الشارع.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296520
    m_Localized: 'Window: إنهم مستلقون على الأرض الباردة الصلبة ويبدو أنهم نائمون نومًا عميقًا. الظروف مواتية لهم في الوقت الحالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296521
    m_Localized: 'Window: في الأفق، ترى منزل جارك الذي يزورك حاليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296522
    m_Localized: 'Window: الضوء يتسلل عبر النوافذ، ويبدو أن عائلته تنتظر عودته إلى المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296523
    m_Localized: 'Window: هناك صمت مطبق في الخارج.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296524
    m_Localized: 'Window: لا يوجد أحد هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296525
    m_Localized: 'Window: حتى السكارى قرروا عدم الخروج.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296526
    m_Localized: 'Window: هل هم خائفون من شيء ما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296527
    m_Localized: 'Window: ترى جارك وابنته من النافذة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296528
    m_Localized: 'Window: إنهما يلعبان، محاولين نسيان الأهوال الحالية...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296529
    m_Localized: 'Window: ولو للحظة واحدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296530
    m_Localized: 'Window: يقف على الرصيف رجل شاحب كأن الحياة هجرت وجنتيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296531
    m_Localized: 'Window: هناك طيات غريبة في جلده.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296532
    m_Localized: 'Window: يبدو وكأن جلده لا يتناسب مع حجم جسده.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296533
    m_Localized: 'Window: لا يمكنك رؤية عينيه من هنا، لكنك تشعر بنظرته الثاقبة إليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296534
    m_Localized: 'Window: تشعر فجأة بخوف شديد وتتمنى أن يعبر الزائر المرعب دون أن يلاحظ منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296535
    m_Localized: 'Window: هناك مجموعة صغيرة من موظفي الوكالة الفيدرالية يقفون بجوار منزل جارك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296536
    m_Localized: 'Window: تتساءل عما يتحدثون.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296537
    m_Localized: 'Window: ربما يأخذون عينات من التربة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296538
    m_Localized: 'Window: أو يبحثون عن مكان لتأسيس قاعدة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296539
    m_Localized: 'Window: ترى مجموعة من الجنود المسلحين من خلال النافذة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296540
    m_Localized: 'Window: يبدو أنها فرقة صغيرة أرسلتها المدينة إلى هنا لتوفير الأمن لموظفي الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296541
    m_Localized: 'Window: تسمع بعض المعلومات المتفرقة عن رجل شاحب البشرة عاري الصدر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296542
    m_Localized: 'Window: ربما يريدون تعقب ذلك الزائر المخيف؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296543
    m_Localized: 'Window: منزل جارك، الذي كان قد طلاه باللون الأبيض للتو، احترق تمامًا وأصبح الآن أسود كالفحم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296544
    m_Localized: 'Window: يبدو أن الحريق لا يزال مشتعلًا حتى الآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296545
    m_Localized: 'Window: هل من الممكن أن يكون أحدهم قد أحرقه عمدًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296546
    m_Localized: 'Window: ماذا حدث لعائلة جارك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296547
    m_Localized: 'Window: هل ما زال هناك أحد على قيد الحياة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296548
    m_Localized: 'Window: تدور الأفكار المقلقة في رأسك، وتغمرك مشاعر الحيرة والعجز.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296549
    m_Localized: 'Window: جميع الجنود الذين وصلوا بالأمس... لقوا حتفهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296550
    m_Localized: 'Window: يبدو أن هناك مذبحة قد وقعت.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296551
    m_Localized: 'Window: الجثث متناثرة في جميع أنحاء الشارع، وإحدى الجثث مقطوعة الرأس.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296552
    m_Localized: 'Window: هل قتلهم ذلك الغريب الشاحب والمخيف؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296553
    m_Localized: 'Window: تنظر إلى أنقاض منزل جارك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296554
    m_Localized: 'Window: كانت تعيش عائلة سعيدة هناك حتى وقت قريب. الآن، لم يتبقَ سوى هيكل فارغ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296555
    m_Localized: 'Window: ينتابك شعور غريب بالارتباك. كما لو كنت تعلم أن هذا سيحدث...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296556
    m_Localized: 'Window: ...كما لو أن الموت كان قادمًا إلى ذلك المنزل، قريبًا جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296557
    m_Localized: 'Window: ترى جمجمة بشرية تزين عمودًا، ولا تزال ترتدي خوذة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296558
    m_Localized: 'Window: جلد البشري محروق بالكامل، ويبدو أن أحدهم قد انتزع أسنانه.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296559
    m_Localized: 'Window: لا بد أن الرأس كان معلقًا طوال اليوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296560
    m_Localized: 'Window: يراودك شعور بأن هذا المشهد المروع رسالة تهديد تركها الزائر الشاحب.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296561
    m_Localized: 'Window: يفتش مسؤولو الوكالة الفيدرالية موقع المجزرة التي وقعت مؤخرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296562
    m_Localized: 'Window: إنهم يأخذون جميع معدات الجنود القتلى وأسلحتهم لمنع النهب.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296563
    m_Localized: 'Window: ربما لم يتوقعوا نجاة الزائر الشاحب من مجموعة من الجنود المسلحين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296564
    m_Localized: 'Window: هناك المزيد من أكياس الجثث حاليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296565
    m_Localized: 'Window: ترى امرأة تبكي على زوجها المصاب.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296566
    m_Localized: 'Window: لا يمكنك معرفة ما إذا كان حيًا أم ميتًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296567
    m_Localized: 'Window: تجر جسده الثقيل بعيدًا عن إطلاق النار وهي تذرف الدموع.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296568
    m_Localized: 'Window: وتخطر في بالك فكرة واحدة: ستزداد الأمور سوءًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296569
    m_Localized: 'Window: الطريق على طول الحقل مليء بجثث أولئك الذين حاولوا الهرب.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296570
    m_Localized: 'Window: بالقرب يقف المسؤول عن ذلك: ضابط من الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296571
    m_Localized: 'Window: وهو يحمل بندقية، ولا يزال الدخان يتصاعد من فوهتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296572
    m_Localized: 'Window: يهرع الناس المذعورون إلى المنازل المجاورة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296573
    m_Localized: 'Window: يقرعون الأبواب، ساعين إلى الحصول على مأوى.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296574
    m_Localized: 'Window: لكن يبدو أنه لا يوجد أحد مستعد للسماح لهم بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296575
    m_Localized: 'Window: مجموعة من المطرودين يقفون بجانب منزل جارهم المدمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296576
    m_Localized: 'Window: إنهم في حالة صدمة، يتهامسون فيما بينهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296577
    m_Localized: 'Window: من المحتمل أنهم يريدون الحصول على مأوى هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296578
    m_Localized: 'Window: ولكن هل هناك أي مكان متبقٍ للاختباء من كل هذا؟ أي مكان في العالم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296579
    m_Localized: 'Window: يقف رجل مسلح ببندقية على الطريق. يبدو أنه مجنون تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296580
    m_Localized: 'Window: سترته مغطاة بأسنان ممزقة وعيون ومَن يدري ماذا غيرها. من الصعب تحديد ذلك من هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296581
    m_Localized: 'Window: ماذا لو كانت تذكارات صيد؟ ماذا لو كان يقتل من أجل المتعة وليس دفاعًا عن النفس؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296582
    m_Localized: 'Window: مهما كان السبب، فأنت تأمل ألا تكون عدوه.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296583
    m_Localized: 'Window: على عمود يعلق رجل يحمل لافتة مكتوب عليها "لقد أخذتم كل شيء مني".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296584
    m_Localized: 'Window: هل تعرض للسرقة؟ أم أن الوكالة الفيدرالية أخذت عائلته؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296585
    m_Localized: 'Window: عقلك يفكر بسرعة، لكن لا توجد إجابة، مجرد تخمينات.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296586
    m_Localized: 'Window: استقرت مجموعة طردتها الوكالة الفيدرالية في أنقاض منزل جارك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296587
    m_Localized: 'Window: على الرغم من أنه لم يتبقَ سوى القليل، يبدو أن القبو سليم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296588
    m_Localized: 'Window: مكان صغير يمنحهم الحماية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296589
    m_Localized: 'Window: لكن إلى متى يمكنهم الاستمرار في الاختباء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296590
    m_Localized: 'Window: الكلاب الضارية تجوب الشوارع.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296591
    m_Localized: 'Window: تحمل أجسادها حروقًا سطحية، وقد أضعفها الجوع.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296592
    m_Localized: 'Window: داخل المنزل، لا يمكن أن تخاف منها.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296593
    m_Localized: 'Window: لكن الآن تأكدت أنه من الأفضل عدم الخروج.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296594
    m_Localized: 'Window: تتجمع مجموعات صغيرة تحمل أمتعتها في مكان قريب. يتهامسون، حريصين على ألا يسمعهم موظفو الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296595
    m_Localized: 'Window: يبدو أنهم من مناطق الحجر الصحي، وينتقلون إلى منازل السكان السابقين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296596
    m_Localized: 'Window: الآن، يبدو الرجل المعلق وكأنه لافتة "ترحيبية" كئيبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296597
    m_Localized: 'Window: صياد زوار مسلح يحتجز مجموعة من الناجين تحت تهديد السلاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296598
    m_Localized: 'Window: ربما عثر عليهم بالصدفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296599
    m_Localized: 'Window: تسمع صيحات صاخبة وصوت صراخ غاضب.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296600
    m_Localized: 'Window: مَن سيبقى على قيد الحياة في هذا العالم الجديد؟ ...ليس هؤلاء الأشخاص.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296601
    m_Localized: 'Window: ضباط الوكالة الفيدرالية يقفون أمام الكلاب الميتة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296602
    m_Localized: 'Window: وأحدهم يكتب شيئًا على جهاز لوحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296603
    m_Localized: 'Window: هل يمكن لعدد قليل من الناس أن يوقفوا حشدًا من الحيوانات الجائعة؟ هذا غير محتمل...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296604
    m_Localized: 'Window: يقف ضابطان من الوكالة الفيدرالية بجانب عمود إنارة، يحدقان في الرجل المعلق.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296605
    m_Localized: 'Window: يبدو أنهما وصلا أخيرًا إلى الوجهة الرئيسية في المنطقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296606
    m_Localized: 'Window: كأنهما لا يفهمان الأمر. لا بد أنهما يتساءلان كيف تسلق بلا سُلّم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296607
    m_Localized: 'Window: المجموعة بأكملها ماتت. وصارت الكلاب الجائعة تمزق جثثهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296608
    m_Localized: 'Window: القذائف المستعملة مبعثرة بالقرب من الجثث. لا بد أن الصياد قد قتلهم وأخذ غنيمته.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296609
    m_Localized: 'Window: جنون هذا العالم قد تجاوز الحدود.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296610
    m_Localized: 'Window: يقوم أعضاء الطائفة بتكديس الحطب في كومة ضخمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296611
    m_Localized: 'Window: هل يخططون لحرق شيء ما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296612
    m_Localized: 'Window: من المرجح أن تُكشف خطتهم المجنونة قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296613
    m_Localized: 'Window: ولكن حتى ذلك الحين، كم روح بريئة ستزهق بسبب معتقدهم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296614
    m_Localized: 'Window: يقف رجل مجنون على الطريق.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296615
    m_Localized: 'Window: يحمل عبوة وقود وقنبلة مولوتوف.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296616
    m_Localized: 'Window: هل يخطط لإحراق القرية بأكملها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296617
    m_Localized: 'Window: ألا يعلم أن هؤلاء الأشخاص في الحجر الصحي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296618
    m_Localized: 'Window: جثث أولئك الذين كانوا يختبئون في قبو جارك تحترق تحت أشعة الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296619
    m_Localized: 'Window: الكلاب التي كانت تتغذى عليها قد هربت. ربما خوفًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296620
    m_Localized: 'Window: ماذا لو لم تهرب من الوكالة الفيدرالية، بل من شيء أسوأ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296621
    m_Localized: 'Window: أتباع الطائفة مربوطون عند موقع المحرقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296622
    m_Localized: 'Window: هل قرروا التضحية بأنفسهم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296623
    m_Localized: 'Window: هذه الفكرة تربك عقلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296624
    m_Localized: 'Window: الخوف من الموت أفسد العقول. الناس مستعدون لفعل ما لا يوصف.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296625
    m_Localized: 'Window: إذا وقع هذا النوع من الجنون بعد أسابيع قليلة من الكارثة، فمن المخيف تصور ما قد يحصل بعد ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296626
    m_Localized: 'Window: المنازل المحترقة تشتعل. وصرخات تتردد في الأفق...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296627
    m_Localized: 'Window: تعلم أن الرجل المجنون سبب كل هذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490688
    m_Localized: 'Window: هل يمكن أن يكون منزلك هو التالي؟ هل سيأتي غدًا؟ الأسبوع المقبل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490689
    m_Localized: 'Window: من المحتمل أن تقابل ذلك المجنون وجهًا لوجه. إنها مسألة وقت وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490690
    m_Localized: 'Window: لم يتبقَ شيء من الجثث المحترقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490691
    m_Localized: 'Window: مجرد كتلة غريبة لا شكل لها. تبدو مثل الطين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490692
    m_Localized: 'Window: تتساءل عما إذا كان هناك شيء ما قد أذاب اللحم والعظام قبل ابتلاع البقايا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490693
    m_Localized: 'Window: تتمنى أن يظل المخلوق مختبئًا. فأنت تخشى ألا يتحمل عقلك رؤية هذا الوحش.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490694
    m_Localized: 'Window: ضباط الوكالة الفيدرالية يحيطون بالجثث المحترقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490695
    m_Localized: 'Window: يوثقون وفاة أتباع الطائفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490696
    m_Localized: 'Window: وجوههم مفزوعة من الرعب والألم، كما لو أنهم رأوا شيئًا مروعًا قبل أن يموتوا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490697
    m_Localized: 'Window: كل المنازل المجاورة أصبحت مدمرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490698
    m_Localized: 'Window: منزلك آخر منزل باقٍ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490699
    m_Localized: 'Window: لم يعد هناك أحد آخر ليحميك من غضب الرجل المجنون.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490700
    m_Localized: 'Window: مهما يكن من أمر بعد ذلك، فمصيره إليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490701
    m_Localized: هنا مركز القيادة. تحقق من حالة منطقة الحجر الصحي. الرمز 51. بلاغات عن حدوث انفجارات في الساعة 03:00.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490702
    m_Localized: 'الوحدة 32-8 هنا. الرمز 60: إصابات جماعية بين المدنيين، وهناك ضباط مصابون...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490703
    m_Localized: هنا 28-8. الرمز 451. نطلب فريق حرق الجثث للتخلص من الجثث.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490704
    m_Localized: عُلم. بدء تنفيذ الرمز 984. تم تطويق المدينة بانتظار التحقيق. استعدوا لتلقي التعزيزات.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490705
    m_Localized: إذا كنتم تسمعونني، فابقوا بعيدًا عن الضواحي.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490706
    m_Localized: ضباط الوكالة الفيدرالية يطلقون النار على أي شخص يحاول المغادرة.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490707
    m_Localized: لا أعرف ما الذي يحدث. أريد فقط الخروج من هنا.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490708
    m_Localized: فليساعدني أحدك-
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490709
    m_Localized: لم يهاجموا منطقة الحجر الصحي.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490710
    m_Localized: لقد رأيته. رأيت ما كان هناك.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490711
    m_Localized: ذلك... لم يكن بشريًا...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490712
    m_Localized: هممم... معكم أحد السكان المطرودين...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490713
    m_Localized: إذا طردتكم الوكالة الفيدرالية كما طردتنا، فإننا نلجأ إلى القبو في منزل محترق.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490714
    m_Localized: إنه قريب من مكان الرجل المنعزل.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490715
    m_Localized: لم يتبقَ لدينا الكثير من الطعام. ومن دون الحصول على المزيد منه، سنموت جوعًا.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490716
    m_Localized: إذا كان بإمكان أي شخص التبرع ببعض الطعام، فيُرجى مساعدتنا. نحن بحاجة ماسة إليه.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490717
    m_Localized: إلى جميع المستمعين...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490718
    m_Localized: تحاول الوكالة الفيدرالية تشويش جميع الإشارات لإبقاء الأمور طي الكتمان.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490719
    m_Localized: إنها تريد التعتيم على كل ما يجري في المدينة.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490720
    m_Localized: وتحاول إلقاء اللوم على ذلك المختل الذي قتل الجميع في منطقة الحجر الصحي.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490721
    m_Localized: إذا كنتم لا تزالون في المدينة — اخر...جوا منها. إنها غير آمـ...نة.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490722
    m_Localized: تجنـ...بوا دوريات الوكالة الفيدرالية. هد... فها قتـ...لكم.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490723
    m_Localized: اهر...بوا في أسـ..رع وقـ-
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490724
    m_Localized: ما كان يجـ...ب أن يحر...قوا الجثث. إنها... إنها تـ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490725
    m_Localized: لو كانوا... لو كانوا... قايا... لما كان-
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490726
    m_Localized: إرسـ...ال إلى... جميع وحدات الوكالـ...ة الفيدر...الية...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490727
    m_Localized: 'توجـ...يه جد...يد: تم استـ....بل الرمز 451 بالر...ز 955.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490728
    m_Localized: لا تحـ....قوا الجثث. استخدموا الـ... بدلًا من ذلك.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490729
    m_Localized: أكـ...ر، الرمز 451 هو... حرق...الجـ... لاحتوا... التـ...ديد الذي يشـ...كله الهد...ف...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490730
    m_Localized: هـ...نا 18-8. لم نتـ...كن من احتوا...ه.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490731
    m_Localized: الهـ...ف قد غادر حدود المد...نة. مطلـ...وب دعم فو...ي.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490732
    m_Localized: نحن بحاجة إلى ...عم الآ...ن. لا يمكننا احتواء الهـ...دف بمفردنا.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490733
    m_Localized: 'Phone: مرحبًا يا جاري العزيز. تسعدني محادثتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490734
    m_Localized: 'Phone: إذن... هل سمحت لبعض الأشخاص بالدخول بعد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490735
    m_Localized: 'Phone: إذا لم تفعل، فعليك أن تبدأ في التفكير مليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490736
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490737
    m_Localized: 'Phone: هل لديك أي أسئلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490738
    m_Localized: هل تستقبل الناس أيضًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490739
    m_Localized: كم عدد العلامات التي تدل على أن شخصًا ما زائر؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490740
    m_Localized: كيف حللت مشكلة الطعام؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490741
    m_Localized: وداعًا (أغلق الخط)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490742
    m_Localized: 'Phone: نعم، لا بد لي من ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490743
    m_Localized: 'Phone: ابنتي لا تحب ذلك. لكن ماذا يمكنني أن أفعل؟ لا يوجد حل آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490744
    m_Localized: 'Phone: تستمر في التوسل لاصطحابها إلى الخارج، لتبتعد عن كل الغرباء في المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490745
    m_Localized: 'Phone: لكن النهار ليس خيارًا متاحًا، لذا نذهب في نزهات ليلية. أعلم أن هذا خطير... لكن ماذا يمكنني أن أفعل غير ذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490746
    m_Localized: 'Phone: لو كنت أعرف...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490747
    m_Localized: 'Phone: لا أحد يعرف بالضبط كم عدد العلامات اللازمة للتأكد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490748
    m_Localized: 'Phone: لكن من الحكمة ألا نستعجل الحُكم على الأمور.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490749
    m_Localized: 'Phone: ربما ذهبا إلى طبيب الأسنان قبل أن تسوء الأمور.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490750
    m_Localized: 'Phone: كنتُ محظوظًا. تسوقت لما يكفينا سلفًا. على حد علمي، أنت أيضًا فعلت ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490751
    m_Localized: 'Phone: ولكن إذا كنت تريد شيئًا مميزًا، فهناك خدمة توصيل الطعام For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490752
    m_Localized: 'Phone: لا أعرف رقمها، لكنك ستسمعه في الإعلانات التلفزيونية أو الإذاعية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490753
    m_Localized: 'Phone: اعتنِ بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490754
    m_Localized: 'Phone: أهلًا يا جاري العزيز.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490755
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490756
    m_Localized: 'Phone: هل رأيت ما حدث؟ هؤلاء المراهقون قُتلوا...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490757
    m_Localized: 'Phone: اعتقدت أن الشوارع ليست بهذه الخطورة... يبدو أنني كنت مخطئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490758
    m_Localized: 'Phone: أقنعتني ابنتي بالخروج للعب مرة أخرى. لم يبدُ الأمر سيئًا... حتى رأيت الجثث.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490759
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490760
    m_Localized: 'Phone: هذه آخر مرة أخاطر بحياتها هكذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490761
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490762
    m_Localized: 'Phone: لن أسامح نفسي أبدًا إذا أصابها أي مكروه. إنها كل حياتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490763
    m_Localized: هل ابنتك بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490764
    m_Localized: مَن قتلهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490765
    m_Localized: كن حذرًا (أغلق الخط)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490766
    m_Localized: لا أعرف
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490767
    m_Localized: 'Phone: في وجود هذا العشب الطويل، كنت آمل ألا تلاحظ ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490768
    m_Localized: 'Phone: لكن عند عودتها إلى المنزل، قالت إنها رأت وجهًا يظهر بين العشب...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490769
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490770
    m_Localized: 'Phone: أحاول إقناعها بأن ذلك كان من نسج خيالها. لكنها... لا تصدقني.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490771
    m_Localized: 'Phone: كان ذلك الشيء الشاحب الطويل. اعتقدتُ أنه يقتل فقط الأشخاص الذين يبقون في الداخل...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490772
    m_Localized: 'Phone: كنت أعتقد أنني أسيطر على الوضع. فكرت أنه إذا رأيت هيئته، فسنعود مباشرة إلى المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490773
    m_Localized: 'Phone: لكنني لم أفكر فيما قد تراه أيضًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490774
    m_Localized: 'Phone: شكرًا. اعتنِ بنفسك أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490775
    m_Localized: 'Phone: مرحبًا يا جاري العزيز. شكرًا على اتصالك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490776
    m_Localized: 'Phone: بصراحة، ما زلت مصدومًا من كل هذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490777
    m_Localized: 'Phone: جرائم القتل، والجنود، والوكالة الفيدرالية...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490778
    m_Localized: 'Phone: حتى أنهم جاءوا إلى منزلي الليلة الماضية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490779
    m_Localized: 'Phone: سألوا عن الأشخاص المقيمين هنا، وكتبوا شيئًا ما على جهاز لوحي، ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490780
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490781
    m_Localized: 'Phone: أحدهم أخذ شخصًا من منزلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490782
    m_Localized: إلى أين أخذوه؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490783
    m_Localized: لحسن الحظ أنهم لم يأخذوا ابنتك
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490784
    m_Localized: ما هي الوكالة الفيدرالية على كل حال؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490785
    m_Localized: اعتنِ بنفسك (أغلق الخط)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490786
    m_Localized: 'Phone: لا أعرف. قالوا إنها من أجل "عمليات الفحص".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490787
    m_Localized: 'Phone: اعتقدتُ أن كل هؤلاء الجنود والمسؤولين الحكوميين سيصلحون الأمور.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490788
    m_Localized: 'Phone: كان يجب أن أعرف أنه لا يمكن الاعتماد عليهم لمساعدتنا أو نقلنا إلى مكان آمن.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490789
    m_Localized: 'Phone: مستحيل أن أسمح بحدوث ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490790
    m_Localized: 'Phone: على جثتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490791
    m_Localized: 'Phone: إذا تجرأ هؤلاء الأوغاد على لمسها، سأمزقهم إربًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490792
    m_Localized: 'Phone: لا أعرف. لا أحد يعرف الكثير عنها.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490793
    m_Localized: 'Phone: لقد ظهرت فجأة، وشرعت في التصرف كأنها تسيطر على كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490794
    m_Localized: 'Phone: ولكن كيف يمكن حتى اكتشاف العلامات عندما تكون جميعها مجرد سمات بشرية عادية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490795
    m_Localized: 'Phone: يبدو أن الوكالة الفيدرالية لا تخبرنا بالحقيقة كاملة...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490796
    m_Localized: 'Phone: شكرًا لك'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490797
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490798
    m_Localized: 'Phone: لم أعتقد قط أننا سنعيش أوقاتًا مثيرة للاهتمام كهذه...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490799
    m_Localized: 'Phone: الشمس، والزوار، والآن الوكالة الفيدرالية...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490800
    m_Localized: 'Phone: هناك الكثير من الأسئلة، ولا توجد إجابة واحدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490801
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490802
    m_Localized: 'Phone: يا جاري العزيز، أريد أن أطلب منك شيئًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490803
    m_Localized: 'Phone: إذا أصابني مكروه، فعدني أنك ستعتني بابنتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490804
    m_Localized: أعدك
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490805
    m_Localized: لا أستطيع وعدك بأي شيء
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490806
    m_Localized: 'Phone: شكرًا لك يا جاري العزيز. كنت أعلم أنني أستطيع الاعتماد عليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490807
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490808
    m_Localized: 'Phone: حسنًا، عليّ إغلاق الخط. اعتنِ بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490809
    m_Localized: 'Phone: أنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490810
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490811
    m_Localized: 'Phone: ألا تريد مساعدتها حقًا؟ إنها مجرد طفلة. لا أريدها أن تبقى وحيدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490812
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490813
    m_Localized: 'Phone: اللعنة، عليّ إغلاق الخط...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490814
    m_Localized: 'Phone: وداعًا يا جاري العزيز.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490815
    m_Localized: 'Phone: مرحبًا، هذه خدمة توصيل الطعام راحتك تهمنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490816
    m_Localized: 'Phone: هل ترغب في الطلب؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490817
    m_Localized: علبتان إنيرجيكا، من فضلك
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490818
    m_Localized: علبة قهوة، من فضلك
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490819
    m_Localized: في الواقع، لقد غيرت رأيي
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490820
    m_Localized: 'Phone: عذرًا، لا يمكننا قبول طلبك في الوقت الحالي. لديك بالفعل طلب توصيل مسجل في نظامنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490821
    m_Localized: 'Phone: نظرًا لزيادة الطلب غير المتوقعة، اضطررنا إلى الحد مؤقتًا من عدد الطلبات التي يمكن إتمامها يوميًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490822
    m_Localized: 'Phone: إذا كنت لا تزال ترغب في تقديم طلب، فيُرجى إعادة الاتصال في وقت لاحق.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490823
    m_Localized: 'Phone: شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490824
    m_Localized: 'Phone: شكرًا لك. تأكد طلبك بنجاح. الطرد في طريقه إليك وسيصل مساء الغد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490825
    m_Localized: 'Phone: شكرًا لك. تأكد طلبك بنجاح. الطرد في طريقه إليك وسيصل مساء الغد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490826
    m_Localized: 'Phone: مرحبًا بك في القسم الطبي للوكالة الفيدرالية لإدارة الطوارئ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490827
    m_Localized: 'Phone: يمكننا الآن تقديم خدمات استشارية بشأن إجراءات الفحص الرسمية للزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490829
    m_Localized: 'Phone: يُرجى ذكر سؤالك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490830
    m_Localized: ما الذي يجب أن أعرفه عن علامة الأسنان؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490831
    m_Localized: ما الذي يجب أن أعرفه عن علامة الأظافر؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490832
    m_Localized: ما الذي يجب أن أعرفه عن علامة العيون؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490833
    m_Localized: شكرًا، هذا كل شيء
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490834
    m_Localized: 'Phone: لإجراء فحص دقيق، نوصي بالابتعاد عن التدخين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490835
    m_Localized: 'Phone: قد يؤثر التدخين على حالة الأسنان، ما يؤدي إلى الحصول على نتائج غير موثوقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490836
    m_Localized: 'Phone: لضمان تقييم دقيق للحالة، يُرجى عدم غسل اليدين قبل الفحص.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490837
    m_Localized: 'Phone: قد تزيل المياه البقايا السطحية، ما قد يؤدي إلى أخطاء و/أو نتائج غير دقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490838
    m_Localized: 'Phone: لإجراء فحص دقيق، يرجى تجنب تناول القهوة و/أو المشروبات التي تحتوي على الكافيين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490839
    m_Localized: 'Phone: الكافيين سبب معروف للأرق والعصبية، ويمكن أن يؤدي أيضًا إلى احمرار العينين.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490840
    m_Localized: 'Phone: شكرًا لتعاونكم مع الوكالة الفيدرالية لإدارة الطوارئ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490841
    m_Localized: 'Phone: نقدّر تعاونكم ريثما نتعامل مع الموقف المستجد.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490842
    m_Localized: 'Phone: ساعدونا لنساعدكم. إجراء الفحوصات الدقيقة يعني أنكم تقومون بدوركم من أجل مستقبل البشرية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490843
    m_Localized: 'Phone: مرحبًا بك. يُرجى الانتظار ريثما نحيلك إلى أحد المختصين بشؤون الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490844
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490845
    m_Localized: 'Phone: مرحبًا؟ من أنت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490846
    m_Localized: ماذا تعني؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490847
    m_Localized: لماذا تريد أن تعرف من أنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490848
    m_Localized: 'Phone: فهمت... لقد تجنبت الإجابة على سؤالي... يبدو أن روح الزائر قد بدأت تتجذر بداخلك بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490849
    m_Localized: 'Phone: الآن استمع جيدًا، ليس لديك الكثير من الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490850
    m_Localized: 'Phone: أخبرني، هل تركت شريحة خبز بالخارج في المطبخ من قبل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490851
    m_Localized: لا؟ لماذا قد أفعل ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490852
    m_Localized: شريحة خبز؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490853
    m_Localized: 'Phone: لمساعدتي في طرد روح الزائر بداخلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490854
    m_Localized: 'Phone: ...حسنًا، لا تهتم. استمع جيدًا، ليس لديك الكثير من الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490855
    m_Localized: 'Phone: أخبرني، هل تركت شريحة خبز بالخارج في المطبخ من قبل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490856
    m_Localized: لا؟ لماذا قد أفعل ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490857
    m_Localized: شريحة خبز؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490858
    m_Localized: 'Phone: أوه... هذا يفسر الكثير. لستَ على وفاق مع روح منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490859
    m_Localized: 'Phone: لهذا السبب جاءت روح الزائر. لكن لا تقلق. يمكننا معالجة هذا الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490860
    m_Localized: 'Phone: هل لديك جهاز كمبيوتر شخصي في المنزل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490861
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490862
    m_Localized: أي جهاز؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490863
    m_Localized: 'Phone: ألا تقدم قرابين لروح البيت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490864
    m_Localized: 'Phone: لا عجب في أن روح الزائر اقتربت منك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490865
    m_Localized: 'Phone: هل لديك جهاز كمبيوتر شخصي في المنزل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490866
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490867
    m_Localized: أي جهاز؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490868
    m_Localized: 'Phone: حسنًا. ليكن في علمك، لا يمكنك الضغط على Alt+F4...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490869
    m_Localized: 'Phone: هممم، أخبرني، هل تتناول الفطر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490870
    m_Localized: لا أتناول إلا شاي الكمبوتشا. أحيانًا.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490871
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490872
    m_Localized: 'Phone: ألا تعرف حقًا ما هو الكمبيوتر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490873
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490874
    m_Localized: 'Phone: حسنًا، لا بأس. لننتقل إلى سؤال آخر...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490875
    m_Localized: لا أتناول إلا شاي الكمبوتشا. أحيانًا.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490876
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490877
    m_Localized: 'Phone: أوه لا...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490878
    m_Localized: 'Phone: يجب أن تتوقف على الفور! الكمبوتشا مصدر شر معروف وقديم...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490879
    m_Localized: 'Phone: إنه يسمح لخيوط الفطريات بالنمو بداخلك. ما يجعل الأرواح تتحكم بك كالدمية.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490880
    m_Localized: 'Phone: لا يمكنك أن تتخيل ما سيحدث إذا وصل إلى ذكرياتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490881
    m_Localized: 'Phone: قد تختفي كليًا... أو تعود إليك باستمرار، وأنت تُبدّل خياراتك في كل مرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490882
    m_Localized: 'Phone: والأسوأ؟ أنك لن تدرك حتى أنك تخضع لسيطرة شيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490883
    m_Localized: 'Phone: حسنًا، سؤال أخير: هل سُفك دم في منزلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490884
    m_Localized: نعم
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490885
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490886
    m_Localized: 'Phone: إذن لا تبدأ! ولا حتى تشرب الكمبوتشا! وإلا سيكون من السهل على الأرواح أن تستحوذ على جسدك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490887
    m_Localized: 'Phone: حتى لو شربت رشفة واحدة، من الممكن أن تبدأ الفطريات في النمو داخل جسمك وتسيطر عليه كالدمية!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490888
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490889
    m_Localized: 'Phone: يا للهول... هذه ليست مسألة بسيطة... ليست بسيطة على الإطلاق...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490890
    m_Localized: نعم
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490891
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490892
    m_Localized: 'Phone: آه، هذا يفسر الأمر...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490893
    m_Localized: 'Phone: إنها ليست روح زائر. إنها روح شبح. روح شخص ميت.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490894
    m_Localized: 'Phone: وللأسف، الأشباح ليست بالضبط مجال تخصصي.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490895
    m_Localized: 'Phone: ستحتاج إلى خدمات طارد أرواح شريرة لذلك. ستحصل على المساعدة التي تحتاج إليها.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490896
    m_Localized: 'Phone: يؤسفني أنني لا يمكنني فعل أي شيء أكثر من ذلك. إلى اللقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490897
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490898
    m_Localized: 'Phone: لقد اكتملت جلسة إبعاد الزائرين الآن. شكرًا لاستخدامك خدماتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490899
    m_Localized: 'Phone: سيتم تحميل رسوم الاستشارة على حسابك المرتبط قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490900
    m_Localized: رسوم؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490901
    m_Localized: كنت أعتقد أن هذه المكالمة مجانية
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490903
    m_Localized: 'Phone: آه، يا للأسف. أخشى أنني لا أستطيع تحديد نوع هذه الروح... لذا لا يمكنني فعل أي شيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490904
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490905
    m_Localized: 'Phone: للأسف، يجب أن أنهي جلستنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490906
    m_Localized: 'Phone: لتعمل النجوم في صالحك.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490907
    m_Localized: 'Phone: لقد اكتملت جلسة إبعاد الزائرين الآن. شكرًا لاستخدامك خدماتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: سيتم تحميل رسوم الاستشارة على حسابك المرتبط قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: رسوم؟
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: كنت أعتقد أن هذه المكالمة مجانية
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: هذا صحيح. في النهاية، المسؤولون عن طرد الزوار لدينا يحتاجون إلى كسب رزقهم أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: كيف تقيّم تجربتك اليوم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: خمس نجوم!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: واحد من عشرة
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: سحقًا لكم
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: إذا شاهدت الإعلان بعناية، فإن النص الصغير يذكر أن المكالمة الأولى تتطلب دفع رسوم استشارة بسيطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: كيف تقيّم تجربتك اليوم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: خمس نجوم!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: واحد من عشرة
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: سحقًا لكم
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: شكرًا لك. رأيك يهمنا. إلى اللقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: هذه آخر المستجدات حتى الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: اطلب الآن من خدمة توصيل الطعام راحتك تهمنا. اتصل الآن على {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: مساء الخير. تشاهدون آخر الأخبار.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: 'TV: على الرغم من الحرائق، لا يزال السياح يُشكّلون مصدر قلق لبلادنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: أعلنت الوكالة الفيدرالية عن علامة جديدة لمساعدة الجمهور في محاربة الزوار...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: التالي: تقرير خاص عن طبيعة الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: هاه؟ مرحبًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: زوجتك أعطتني هذا الرقم
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: زوجتك بحاجة إلى المساعدة
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: أهه. وماذا غير ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: لقد فقدت جميع أطفالها
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: هل هم معك؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: القصة المعتادة. أنا من يتولى التعامل مع ما تُحدثه من فوضى.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: كل ما تفعله هو الجلوس، وقول: "لكنني متعبة".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: القصة المعتادة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: لقد فقدت جميع أطفالها
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: هل هم معك؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: أها. سأقولها مرة أخرى، لم تكن تهتم بأطفالها على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: والآن أنا من عليه تحمل مسؤولية الفوضى التي تسببت فيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: هل تحققت من منزل والدتها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: ربما يمكنك أن تأتي وتأخذها؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: لا. أليسوا معها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: هذا أمر متوقع.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: هل تحققت من منزل والدتها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: ربما يمكنك أن تأتي وتأخذها؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: أها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: ربما يكونون هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: لن أذهب.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: يمكنها فعل ذلك. اسألها كيف يمكن لأم أن يضيع منها أطفالها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: يمكنكما حل هذه المشكلة معًا
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: على أي حال، سأخبرها أنك على قيد الحياة
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: دعها تذهب بنفسها. إنها ليست صغيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: لديها ساقان سليمتان، أليس كذلك؟ فما المشكلة إذن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: يمكنكما حل هذه المشكلة معًا
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: على أي حال، سأخبرها أنك على قيد الحياة
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: لماذا اتصلت إذن؟ لإنقاذ فتاة مسكينة في محنة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: افعل ما تشاء. تلك العاهرة لا تهتم بأي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: دعني وشأني.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: 'Phone: على أي حال، سأخبرها أنك على قيد الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: لا تهتم. ما الفائدة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: لا نهتم بأحدنا الآخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: لا أعرف لماذا تتدخل في هذا الأمر أصلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: لا يهم... أتمنى لكما حياة سعيدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: هل تؤمن بالموت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: طلب مني زوجكِ أن أتصل بكِ
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: دعينا ندخل في صلب الموضوع. هذا يتعلق بزوجكِ
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: ماذا؟ زوجي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: بعد كل ما فعله... لا أريد أن أسمع كلمة أخرى عنه.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: أرادني أن أقول لكِ إنه يعتذر عما حدث
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: أرادني أن أقول لكِ سحقًا لكِ
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: زوجي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: بعد كل ما فعله... لا أريد أن أسمع كلمة أخرى عنه.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: أرادني أن أقول لكِ إنه يعتذر عما حدث
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: أرادني أن أقول لكِ سحقًا لكِ
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: هاه. يعتذر!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: حقًا؟ مجددًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: لقد جعل أشخاصًا آخرين يعتذرون نيابة عنه من قبل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: هل تريد أن تعرف لماذا لا يستطيع الاتصال بي بنفسه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: لأنه لا يملك الشجاعة لمواجهة ما فعله وتقبل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: يأمل أن يتمكن من إصلاح كل شيء، والعودة إلى ما كان عليه الحال. لكن الحياة لا تسير على هذا النحو. لا يمكن إعادة الماضي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: أنا أفضل حالًا الآن. أعيش مع أشخاص يفهمونني.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: هل تعتقدين أن مجموعة من المجانين يفهمونكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: لماذا انضممتِ إلى هذه الطائفة من الأساس؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: كما تشائين
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: أطلق عليهم ما شئت من أسماء. إنهم عائلتي الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: نتشارك الاعتقاد ذاته. ونعلم أن الموت قادم قريبًا جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: وأنه لن يجلب الألم، بل السلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: اعتنِ بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: نؤمن بالشيء ذاته فيما يتعلق بما سيحل بنا. إنه الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: قد يبدو هذا غريبًا لك، لكن الموت لا يجلب الحزن، بل السعادة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: السعادة في السلام، ونهاية المعاناة. أنا متأكدة من أنك واجهت الكثير من الصعوبات أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: ربما ستفهم يومًا ما، وترى الأمور كما نراها نحن.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: اعتنِ بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: شكرًا لتفهمك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: اعتنِ بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: مرحبًا؟ مَن المتحدث؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: مرحبًا. أعطاني أخوكِ رقم هاتفكِ
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: أتصل نيابة عن أخيكِ
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: أي أخ؟ لا أعرف...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: أوه، تقصد ابن أبي، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: ولكن مهلًا... من أنت؟ ولماذا هو معك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: لقد اختفى والداه
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: جاء إليّ بحثًا عن مأوى
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: اختفيا؟ كيف حدث ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: لا تعني أنهما...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: اللعنة... هذا لا يمكن أن يكون حقيقيًا... هل ماتا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: لا أعرف
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: على الأرجح
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: بحثًا عن مأوى؟ لكنه يعيش مع والديه، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: ...لا، لا تخبرني. هل...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: اللعنة... هذا لا يمكن أن يكون حقيقيًا... هل ماتا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: لا أعرف
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: على الأرجح
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: يا إلهي... كيف حدث هذا؟...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: يمكنني استقباله. أخبره بذلك. إنه يعرف أين أسكن.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: و... شكرًا لك على مساعدته.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: نعم؟ مَن المتحدث؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: زوجتك وأختها معي
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: زوجتك أعطتني هذا الرقم
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: يبدو أنك تحاول طلب فدية.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: أخشى أنه لم يعد لديّ ما أقدمه.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: وقريبًا لن يكون هناك أحد أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: ماذا تعني؟ ماذا يحدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: زوجتك بخير
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: أرجوك أخبرني أنها بخير.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: إنها قوية، وستتغلب على أي شيء. بل وستساعد كل من تستطيع مساعدته على طول الطريق!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: لكنني لا أعتقد أنه يمكن مساعدتي بعد الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: لن أبقى لفترة طويلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: ماذا تعني؟ ماذا يحدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: زوجتك بخير
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: أنا... أنا لا أستطيع تحمل ما يحدث. الشمس، والزوار... كل شيء مرعب. أشعر أنني عاجز.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: أنا... أريد أن ينتهي الأمر. هناك طريقة واحدة فقط للخروج من هذا المأزق... هل تفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: أخبرها بأنني أحبها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: في الواقع... لا تقل شيئًا. لكن تأكد من أنها لن تأتي للبحث عني.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: لا أريدها أن تعرف أنني لم آخذها معي...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: شكرًا على اتصالك... وشكرًا على استماعك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: وداعًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: ربما لا تزال متشبثة بأختها. لا يمكنها أبدًا أن تتخلى عنها...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: يا لها من مسكينة، محاطة بأشخاص ضعفاء. لهذا السبب قررت أن أتركها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: مرحبًا، هذا قسم التقديم في الوكالة الفيدرالية. كيف يمكنني مساعدتك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: هناك زوجة أحد ضباط الوكالة الفيدرالية في منزلي
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: هناك شخص متطوع يريد الانضمام إلى صفوفكم
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: حسنًا... ما سؤالك؟ لا أعرف بعد كيف يمكنني مساعدتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: بافتراض أن هذا ليس تهديدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: ...إنه تهديد
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: إنها تبحث عن وظيفة عندكم. كانت تعمل على الحدود.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: (تسمع الشخص الآخر يتنهد بصوت عالٍ)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: أنت أحد هؤلاء النشطاء، أليس كذلك؟ دائمًا ما تشتكون من شيء ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: لا تضيع وقتنا. ربما هناك شخص يحتاج إلى المساعدة حقًا ويحاول الاتصال الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: قد يكون هناك زوار يقتحمون مكان ما. أو أسوأ من ذلك. قد يموت أشخاص بسببك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: همم. يجب أن تعرف أن العمل... ليس سهلًا. هل أنت متأكد أنها مستعدة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: إذا كانت كذلك، أخبرها أن تملأ نموذج 31-G بثلاث نسخ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: ثم عليها اجتياز الفحص الطبي. بعد ذلك، ملء...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: (تغلق السماعة. لماذا اتصلت لفعل شيء يخص هذه المرأة أصلًا؟)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: ما هو المنصب الذي تتقدم له؟ ورجاءً لا تقل "مديرة".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: سيكون هذا ثالث طلب تافه نتلقاه اليوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: مديرة
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: متتبعة. أو نوع من الكشافة
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: لقد سئمت هذه المكالمات السخيفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: عندما تفعل هذا الهراء، لا أستطيع مساعدة الأشخاص الذين يحتاجون إلى المساعدة. قد يكون هناك شخص يتعرض للقتل على يد زائر.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: تحمل مسؤولية نكتتك الغبية وغير اللائقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: (لقد أغلقوا الخط. حقًا؟)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: لا توجد وظائف متاحة في هذا المجال. نحن نبحث عن اختصاصيين في علم الأوبئة وباحثين علميين.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: صديقتك لا تبدو مناسبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: لكن، أتعلم؟ الأمور تتغير بسرعة. حاول الاتصال مرة أخرى بعد أسبوع.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: أنا على ثقة من أنه سيكون هناك مكان لـ... ماذا سميتهم؟ "المتطوعون".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: هيكل التفاحة: التفاحة العلوية، وأرض الفطر والورق.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: خاف من... الفطر...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: على الرغم من أنه... يسحر...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: هناك... تعرف على...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: الدموع، وألم الفراق فقط.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: تحقق من تنفسها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: لماذا لا ترد؟ أريد أن أموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: (أغلقوا الخط. لم يكن هذا... ما كنت تتوقعه)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: نود إعلامكم بأن الرحلات الجوية والقطارات المتجهة إلى بلدنا معلقة حاليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: كيف يمكنني مساعدتك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: أريد إعادة سائح إلى وطنه
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: ما سبب توقف القطار؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: من الأفضل الانتظار حتى يُسمح باستئناف عمل الرحلات الجوية مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: العبّارات تعمل، لكن الوضع غير آمن. خطر الأعاصير الليلية مرتفع للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: بالإضافة إلى ذلك، تعكس المياه أشعة الشمس على السفن ولا يستطيع الطاقم البقاء هناك لفترة طويلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: كيف يمكنني إذن أن أرسل هذا المسكين إلى وطنه؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: إنه يعيش معي الآن. ربما يمكنكم توفير مأوى له؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: لقد تمددت القضبان بسبب الحرارة، ومن الخطير جدًا تشغيل القطارات خلال النهار.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: القطارات تعمل خلال الليل فقط، لذا لا يمكن السفر بعيدًا بها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: هناك تبديلات كثيرة جدًا. من الأفضل الانتظار حتى استئناف السفر الجوي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: كيف يمكنني إذن أن أرسل هذا المسكين إلى وطنه؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: إنه يعيش معي الآن. ربما يمكنكم توفير مأوى له؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: عليك الانتظار.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: يؤسفني أنني لا يمكنني فعل أي شيء أكثر من ذلك في الوقت الحالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: إنه لا يتكلم حتى بلغتنا
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: هل تمزحون معي؟ أنتم عديمو الفائدة.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: ليس لدينا أي فنادق يمكنه الإقامة فيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: لا يمكننا فعل أي شيء. نحن نحاول حل المشكلة، لكنه ليس الوحيد الذي يعاني من هذه المشكلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: إنه لا يتكلم حتى بلغتنا
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: هل تمزحون معي؟ أنتم عديمو الفائدة.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: اسمع، موظفونا غارقون في العمل. ربما سمعت أن ميزانيات السفارات تعرضت لتخفيضات كبيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: نحن نبذل قصارى جهدنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: أوه، يا لكم من أبطال حقيقيين
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: هذا رأيك أيها الكسول
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: لا داعي للتحدث بهذه الطريقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: لا يمكننا حمله على ظهورنا إلى بلده. إذا كنت تريد مساعدته بشدة، فاحمله أنت بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: الميزانيات محدودة في الوقت الحالي، ونحن نعمل بشغفنا فقط حاليًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: أوه، يا لكم من أبطال حقيقيين
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: هذا رأيك أيها الكسول
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: إن لم تُعجبك طريقتنا، فتولَّ الأمر بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: حظًا سعيدًا في عبور الحدود مع نقاط التفتيش السياحية وحرارة الظهيرة الحارقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: حسنًا، شكرًا
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: سحقًا لك
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: إذن لماذا أنت في المنزل وليس في العمل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: أو ربما عليك زيارتنا لترينا كيف ستعمل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: سنرحب بمساعدة أي شخص لديه معرفة أفضل من غيره.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: حسنًا، شكرًا
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: سحقًا لك
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: ...أعتذر على الانفعال.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: لستَ أول من يتصل وهو... في قمة الغضب.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: طاب يومك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: رحلات سعيدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: آمل أن تشعر بالرغبة في السفر في وقت ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: سأكون في غاية السعادة لمساعدتك في ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: نافذة إلى غرفة أخرى. كان الناس يفعلون ذلك لتوفير الكهرباء، بحيث ينتشر الضوء من غرفة إلى أخرى.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: ثم قاموا بإغلاقها... ولكن من جانب واحد فقط.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: لا، لن أنظر إلى هناك. ليس بعد ما حدث.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: أكره النوم بجانب المنضدة. تراودني الكثير من الذكريات السيئة...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: لا أفهم سبب عدم تعليقه في الزاوية. كنت أعتقد أن هذه هي القاعدة.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: ولكن... أبي لم يهتم إطلاقًا بالقواعد.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: توتو. تقريبًا اللعبة الوحيدة التي كنت أمتلكها عندما كنت طفلًا.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: باستثناء العصي التي كنا نستخدمها لضرب العشب.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: هيه. ملأت جدتي كل الخزائن بالأطباق.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: لم أخرج المجموعة الفاخرة إلا في الأعياد. ولكن الآن... مَن بحاجة إليها؟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: بصراحة، أفضّل أن أكون وحدي.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: يمكنني حتى التحدث بصوت عالٍ إلى نفسي.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: إحدى تلك المجلات التي عليك أن تجد فيها شخصًا معينًا بين الحشود...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: لا بد أن هذا مزعج. أتمنى أن يتركني الناس وشأني...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: 'قال آنذاك: "عندما أموت، قرروا أنتم ما إذا كنتم تريدون فتح ذلك الصندوق أم لا".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: أنا أقرر منذ خمسة عشر عامًا. وما زلت لا أستطيع اتخاذ قرار.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: هل تشعر بالوحدة؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: هل تشعر بالقلق؟ ليس لديك من تتحدث إليه؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: إذن، فإن خدمة المكالمات العشوائية هي ما تحتاج إليه تمامًا.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: اتصل على 533-891 لنساعدك في إيجاد الشخص المناسب للحديث معه.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: هل ابنتك بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: مَن قتلهما؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: كن حذرًا (أنهِ المكالمة)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: هل ابنتك بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: مَن قتلهما؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: كن حذرًا (أنهِ المكالمة)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: إلى أين أخذوا المستأجرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: لحسن الحظ أنهم لم يأخذوا ابنتك
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: ما هي الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: اعتنِ بنفسك (أنهِ المكالمة)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: إلى أين أخذوا المستأجرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: لحسن الحظ أنهم لم يأخذوا ابنتك
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: ما هي الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: اعتنِ بنفسك (أنهِ المكالمة)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: إلى أين أخذوا المستأجرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: لحسن الحظ أنهم لم يأخذوا ابنتك
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: ما هي الوكالة الفيدرالية؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: اعتنِ بنفسك (أنهِ المكالمة)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: مرحبًا، لقد اتصلت بخط الوكالة الفيدرالية الساخن. كيف يمكنني مساعدتك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: الوكالة الفيدرالية؟ ما هذه؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: عمَ تتحدثين بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: (قبل أن تتمكن من إنهاء كلامها، انفجر صوت رجل عالٍ عبر الخط)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: هل أنت أحمق؟ أغلق السماعة الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: ماذا أفعل بإبطيهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: ماذا أفعل بأذنيهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: لضمان دقة فحوصات الإبط، عليك تجنب أي ملامسة للماء.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: امتنع عن الاستحمام والنظافة الشخصية.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: الأذنان؟ مهلًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: دعني أستشير الإدارة وسأعود إليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: حسنًا، أرجو أن تؤكد لي: هل تناولت أي فطر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: حسنًا، سؤال أخير: هل سُفك دم في منزلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: أهلًا بك في خدمة المكالمات العشوائية. جارٍ توصيلك بشخص للمحادثة. الرجاء الانتظار.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: مرحبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: مرحبًا
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: مرحبًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: مرحبًا
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: لا أحد يجيب...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: أنا... أحتاج إلى التحدث إلى شخص ما. لقد حدث الكثير مؤخرًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: حاولت الاتصال بأصدقائي والأشخاص الذين أعرفهم، لكن... لا أحد يجيب.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: ثم اكتشفت هذه الخدمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: ربما ليس المكان الأنسب لأبوح فيه بما في قلبي، لكن ليس لديّ خيار آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: أعلم أنه من غير الصواب أن أخبر غريبًا بمشاكلي، ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: لا تعرف كم سيساعدني مجرد التحدث إلى شخص ما. سيجعلني أشعر... بتحسن كبير.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: هل تمانع أن تستمع إليّ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: حسنًا
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: لستُ مستعدًا لإجراء محادثة طويلة
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: مممم...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: حسنًا، لا بأس. أعتذر لإزعاجك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: شكرًا جزيلًا! شكرًا لك!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: أعتقد أنه ستكون المحادثة أسهل إذا أخبرتك قليلًا عن نفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: هل هناك شيء معين تود معرفته؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: أين تعيشين؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: قلتِ إن أصدقاءكِ لا يجيبون؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: للأسف، بعيدًا عن بيتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: كنت أحاول الهروب من الحرارة الحارقة والبحث عن أبرد مكان يمكن أن أجده.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: أنا ضائعة، والبرد يخترق عظامي. لا شيء ينمو هنا، ولا حتى العشب.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: إنه مكان آمن نسبيًا، يبعد أميالًا عن أي مكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: هذا المكان ليس سيئًا بالمقارنة مع الأماكن الكارثية الأخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: من المثير للسخرية أنني كنت أكره البرد، لكن الآن... أشعر أنه نعمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: أريد أن أصدق أن حرارة الشمس ستهدأ وأن كل هذا سينتهي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: لكنني بدأت أفقد الأمل في وجود نهاية سعيدة. ماذا سيحدث عندما تتوقف الشمس عن حرقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: قد لا يختفي الزوار أبدًا. قد يحلون محل أصدقائنا وأحبائنا، ولن ندرك ذلك حتى...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: لماذا غادرتِ وحدكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: هل تشتاقين إلى مسقط رأسكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: أتمنى لو أستطيع الاتصال بهم مرة أخرى، لكن... لا أعرف كيف.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: عندما بدأت الكارثة، قررت مغادرة مسقط رأسي. والذهاب بعيدًا قدر الإمكان عن الحرارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: وعدت الجميع بأن أتصل بهم باستمرار، وأطمئن على كل واحد منهم وأسأل عن حالهم...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: لكن عندما وصلت إلى هنا، لم أتمكن من التواصل معهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: لاحقًا، اكتشفت السبب: خطوط هواتفهم كانت مقطوعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: انعزلت المدينة بأكملها عن بقية العالم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: الآن أنا هنا، في أمان، لكن جميع أصدقائي...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: فكرة عدم رؤية أحبائي مرة أخرى ترعبني.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: أفتقد الأيام الهادئة، عندما كانت الحياة بسيطة والمستقبل شيئًا نتطلع إليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: لماذا غادرتِ وحدكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: هل تشتاقين إلى مسقط رأسكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: لم أكن أريد ذلك. ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: صديقي المقرب أراد أن يأتي معي، لكنه لم يستطع...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: لم يكن يملك الوثائق المطلوبة للسفر.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: وعندما وقعت الكارثة، أصبح الحصول عليها مستحيلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: كان محبطًا للغاية... ندم على عدم الحصول عليها في وقت أبكر. أردت مساعدته، لكنني لم أعرف كيف.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: أفتقد كل شيء. لكنني أفتقد الناس أكثر من المدينة نفسها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: وصديقي المقرب أكثر من أي شيء آخر...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: كان يريد أن يأتي معي، لكنه لم يستطع. ووعدته أننا سنبقى على اتصال، وأنني سأتصل به. لكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: أعتقد أنه كان يحبني.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: كان يهتم بي كثيرًا. كان دائمًا داعمًا ومستعدًا للاستماع.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: في النهاية أدركت أننا نحب أحدنا الآخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: كنت أريده أن يعترف بمشاعره أولًا، لكن أعتقد أنه لم يجد اللحظة المناسبة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: ثم... حلت الكارثة، ولم يعد هناك وقت لذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: أنا نادمة على عدم إخباره بمشاعري أولًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: حسنًا، بتّ تعرف القليل عني. الآن حان دورك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: لست معتادًا على التحدث عن نفسي...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: لا أعرف من أين أبدأ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: لا تخجل. أنا مستعدة للاستماع.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: حسنًا... ليس لديّ أي شخص أراه مقربًا مني.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: أنا... وحيد
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: لا تقلق. لا حرج في التحدث عن نفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: حسنًا... ليس لديّ أي شخص أراه مقربًا مني.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: أنا... وحيد
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: و... كانت علاقتي مع والدي سيئة
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: أبي... كنت أكرهه
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: لم أعد جزءًا من تلك العائلة
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: وذات يوم، قررت أن أتبرأ منه
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: الآن كل ما أملكه هو هذا المنزل اللعين
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: الآن كل ما تبقى من العائلة هو هذا المنزل
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: يؤسفني سماع ذلك... يبدو أنك لست سعيدًا بأن المنزل أصبح ملكك في النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: هذا صحيح
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: ليته احترق
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: أنا... لا أستطيع أن أتخيل ما مررت به.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: لا أستطيع أن أتخيل مدى كرهك لوالدك إذا كنت تريد أن يحترق المنزل...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: 'Phone: شكرًا مرة أخرى على التحدث معي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: 'Phone: وداعًا. واعتنِ بنفسك، اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: مرحبًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: مرحبًا، هل يمكنني التحدث إلى ابنتكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: مرحبًا، هل تمانعين أن تأتي ابنتكِ لتلعب مع صديقتها؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: ماذا؟ هل هناك مشكلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: صديقتها سألتها إن كان بإمكانها أن تأتي، هذا كل ما في الأمر.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: معي فتاة هنا... توفي والدها
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: هل كان زائرًا أيضًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: ماذا تعني بـ "أيضًا"؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: لا، بعض المجانين أحرقوه حيًا دون سبب
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: ...لا أحد يحرق بشريًا دون سبب.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: إذن كان زائرًا... مثل ابنتنا الصغيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: لقد أحرقوها هي الأخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: هناك، في روضتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: بكيت في البداية. أردت أن أقتل نفسي. لم أستطع العيش من دونها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: لكن زوجي ساعدني على تجاوز ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: ستتجاوز هذه المحنة أيضًا... وكذلك تلك الفتاة الصغيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: هل تفهم قصدي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: كل شيء يحدث لسبب ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: إذا أحرقوا والدها... فهذا يعني أن الأمر كان مقدرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: والبكاء لن يغير شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: أخبرها بذلك من فضلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: ابنتنا الصغيرة... لقد...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: لقد ماتت...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: 'Phone: كان علينا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: كان علينا قتلها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: (أغلق الخط)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: 'Phone: لقد قتلناها. كان لا بد من ذلك، صدقني.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: كل العلامات تطابقت مع ما قيل لنا... وزوجي أصر على ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: هل... قتلتما طفلتكما؟
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: 'Phone: لا تلومني!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: كانت زائرة! كانت كل العلامات متطابقة، لم يكن هناك أي مجال للشك!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: هذا فظيع...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: أتفهم ذلك
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: كانت زائرة، هل تسمعني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: كل علامات الزوار كانت تنطبق عليها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: كنت أعرفها جيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: لذلك لاحظت العلامات بسرعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: كل العلامات كانت متطابقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: بمجرد أن أخبرت زوجي، قام...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: تعامل مع الزائرة على الفور.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: في البداية، كنت أريد أن أقتله.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: لكنني أدركت في النهاية... أنها لم تكن ابنتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: ساعدني زوجي على فهم ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: يعتصرني الندم الآن لأننا لم نسأل تلك المرأة عما فعلته بطفلتنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: أنا آسفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: لا تتصل بنا مرة أخرى...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: أرجوك...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: لماذا أبرر لك ما فعلناه أصلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972625
    m_Localized: 'Phone: سحقًا لك!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972626
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972627
    m_Localized: 'Phone: لا أزال أفتقدها...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972628
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096192
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096193
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096194
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096195
    m_Localized: 'TV: بعد ذلك: تقرير خاص حول التوقف المؤقت لمعالجة جثامين الموتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 58231803335401472
    m_Localized: علبتان من طعام القطط، من فضلك
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790080
    m_Localized: علبة سجائر من فضلك
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790081
    m_Localized: جرة واحدة من الكمبوتشا، من فضلك
    m_Metadata:
      m_Items: []
  - m_Id: 58690054376120320
    m_Localized: 'TV: اطلب الآن من خدمة توصيل الطعام راحتك تهمنا. اتصل الآن على {0}.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
