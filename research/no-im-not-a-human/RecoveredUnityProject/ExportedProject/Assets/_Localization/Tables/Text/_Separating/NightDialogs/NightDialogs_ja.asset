%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_ja
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ja
  m_SharedData: {fileID: 11400000, guid: 2e47acfd0901bcf4eba15f47b223778b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: やあ ゴホッゴホッ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: やあ 入れてもらえない？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: なにが あったんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: "Firefighter: ボクは ゴホッ\n消防士だ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: "Firefighter: 今日 山火事の消火中\n太陽にやられてね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: "Firefighter: 煙が濃くて 丸焼けにならずすんだけど\nゴホッ 恐ろしい光景だったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: "Firefighter: 木々が… ゴホッゴホッ\nマッチみたいに燃え上がったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: あんなの はじめてだった'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: "Firefighter: 森の あちこちに\n動物の黒焦げ死体が転がってた"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: "なぜ病院に\n行かないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: "これから\nどうするつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: "Firefighter: 昼の太陽に やられたんだ\nゴホッゴホッ 山火事の消火中に"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: 隊で ボクだけが生き残ったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: "Firefighter: 他は全員… ゴホッ\n上司が離してくれなくてね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: 今も 永遠に勤務中さ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: "なぜ病院に\n行かないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: "これから\nどうするつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: "Firefighter: 病院？\nそんなの もう存在しないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: "Firefighter: 来訪者が現れた時点で\n病院に意味なんてない"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: "Firefighter: 相手を信用できなきゃ\n治療なんて無理だ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: 誰もボクを助けてくれない'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: "Firefighter: 火を消しながら\n仲間と死んだほうがマシだね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: もう長くないしね どうせ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: "Firefighter: 山火事を消火していれば良かった\n仲間の代わりに死ねば良かったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: "Firefighter: でも みんなに言われたんだ\nゴホッゴホッ ボクは もうダメだって"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: "Firefighter: もう家にも帰れない\n公共交通機関が動いてない"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: 人の情け に頼るしかないんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: ありがとう ゴホッ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: "Firefighter: あまり長く迷惑かけないから\nゴホッ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: "Firefighter: 少なくとも\n湿った地面で死なずにすむよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: クソッ ゴホッ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: 湿った地面で 死ぬのはゴメンだ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: "Firefighter: どうか ゴホッゴホッ\n火が町まで広がりませんように"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: よう 元気してたか？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: "WheelChair: 久しぶりだな\n暮らしは どうだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: 面識ありましたっけ？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: "Wheelchair: おいおい…\n忘れたってか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: オレら…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: "Wheelchair: 待てよ\n声が違うな…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: ここの家主 いつ変わったんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: "ずっと うちの一家が\n住んでますよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: 住所違いでは
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: えっ アンタ…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: アンタ オレのダチじゃねえな'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: いつから ここに住んでんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: "ずっと うちの一家が\n住んでますよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: 住所違いでは
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: いや そんなはずねえ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: "Wheelchair: オレが間違えるわけねえだろ！\n記憶には自信があるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: "Wheelchair: 絶対ダチが住んでるはず…\nいや 住んでた はずなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: "Wheelchair: なあ ずいぶん長旅してきたんだ\n中に入れちゃ くれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: まさか そんな…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: いや…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: クソッ…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: オレが間違えてた みてえだな'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: "Wheelchair: なあ ずいぶん長旅してきたんだ\n中に入れちゃ くれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: そう こねえと！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: じゃあ 家でレースと行こうぜ？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: "Wheelchair: 出てけ って？\nなに こいてやがる？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: "Wheelchair: オレに出てけ だと！\nクソが！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: "Wheelchair: そうかいそうかい\n転がしてろ ってか\nイカれ野郎"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: "Mother: もう！\nじっとして 動かないで"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: "Mother: こんばんは\nお願い 助けて"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: どうされました？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: どうすればいいですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: "Mother: もう限界で\n眠くて仕方なくて"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: 五人いた子供は もう この子だけ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: "Mother: 夫も消えたきり\n死んだのか 捨てていったのか\nわからなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: "Mother: とにかく ただ何日か\n横になって寝たいだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: 他の子は どこに？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: "お子さん\n亡くされたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: "Mother: 寝させて\n疲れ果ててるの"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: "Mother: 子供 五人いたのに\nもう この子だけ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: "Mother: どこを探せばいいかも わからなくて\nただ 眠りたいの"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: 他の子は どこに？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: "お子さん\n亡くされたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: "Mother: わからない\nもしかしたら夫が連れて行ったのかも\n家まで行きたいんだけど もう疲れて"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: "Mother: ええ よくケンカしてたけど\nでも しょうがなくて\nクソ野郎と暮らしたりなんてできる？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: "Mother: 無理に決まってる\nそれに 大事なのは子供を見つけること"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: ねえ そんなこと言わないで'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: "Mother: 元気いっぱいの子供を\n何人も面倒 見るのは大変だけど…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: "Mother: きっと大丈夫\nみんな 母の家に いるはずだから"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: "Mother: アタシに飽きると\nあの子ら あそこに逃げこむの"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: "Mother: それから 夫が金を\nせびりに来たときも"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: "Mother: 中に入れてもらえない？\n休んだら 子供 探しに行くから"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: やっと 休める'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: "Mother: ほら 入りなさい\nそこが アンタの場所"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: 明日には出てくから'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: "Mother: わかった\nなら 母の家に行ってみる"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: 無理かも しれないけど…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: いや アタシが行かないと'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: よう 住民さん'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: "Anger: 気分 最悪でな\n先 謝っとく"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: "Anger: クズ野郎が多すぎんだ\nアンタは違うと いいけどな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: 誰の話ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: あなたは違うんですよね？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: ああ どいつもこいつも全員だよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: "Anger: クズども 信仰だのなんだので\n身動き一つ取れやしねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: "Anger: 神が死んだ瞬間\n連中の人間性も死んだんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: クソ野獣どもがよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: "Anger: カスは来訪者とかいう連中で\n手一杯なんだが…\nこっちにも カスがいやがる"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: "なにを そう\n怒ってるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: あなたは どう違うんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: いい質問だ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: "Anger: わかってんだろ…\n人間は二つの派閥に分かれちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: "Anger: 一つはサディストのクソども\n来訪者よりタチが悪い"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: "Anger: やりたい放題しやがってよ\n頭に銃を突きつけ ぶっ放して\n次々 地獄送りだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: "Anger: もう一つは ただの獣だ\n上を歩き回られても\n殺されずに すんだと感謝する連中"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: どっちも イラつくんだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: "なにを そう\n怒ってるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: あなたは どう違うんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: "Anger: カッカすんなよ\nただな…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: "Anger: 太陽が とち狂って 来訪者が来てから\n人間性ってのは神と一緒に\nおっ死んだ気がしてな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: "Anger: それでキレてんだ…\nオレだって マトモでいてえんだよ\nなあ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: "Anger: 前みたく作曲なんかしてな\n今じゃ誰も求めちゃいねえが"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: どっちの派閥にも入りたかねえだけだ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: 違うと信じてえな'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: "Anger: なんて言うか\n自分も狂人になっちまわねえか\nビビっててな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: "Anger: 被害者ってのもカンベンだ\nどっちもクソすぎる"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: とはいえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: 被害者のほうが ヒデえけどな'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: "Anger: ただ座って待ってるだけ だからな\nボコられたり 歯へし折られたり\nなんやかんや"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: "Anger: アンタだって理解できるはずだ\nオレが見てきたもん\n目の当たりにしたらな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: "Anger: 安心しろ\n誰にも迷惑かけねえから"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: ブン殴ったりもナシだ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: "Anger: オレの怒りは全部 自分向きだ\n他の誰にもキレるつもりはねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: "Anger: クソッ\nアンタも他の臆病者と同じクソかよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: "Anger: なら座って待ってろよ\n顔面ボコられるまで"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: クソ食らえ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: ここ 気が淀んでるね'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: かなり悪いよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: "FortuneTeller: 太陽 獅子座 第五ハウス\nなるほど そういうこと"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: "FortuneTeller: お前さん\nずいぶん押しが強いタイプだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: えっ？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: 結構です
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: 言葉より行動ってタチだろ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: 典型的な獅子だね？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: "FortuneTeller: それで ここに不快な陰の気を\n溜め込んだんだね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: 理由までは不明だけど まだ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: "FortuneTeller: ここまで全部 荒れ果ててるなら\nアファメーションから やろうか"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: "なぜ そんなこと\n押しつけるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: えっと それで…？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: 別に 押しつけちゃいないよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: "FortuneTeller: 私なら お前さんの因果関係\n教えてやれるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: "FortuneTeller: カルマの6と9\nぐるぐる回る魚みたいなもんさ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: "FortuneTeller: 水魚の交わり 魚心あれば水心\nってヤツだよ\nわかるかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: "なぜ そんなこと\n押しつけるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: えっと それで…？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: "FortuneTeller: ストレス感じるのも無理はないさ\nお前さん\n山羊座のアセンダントだからね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: "FortuneTeller: いくつも星座を内に秘め お手玉してる\n複雑な人間だね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: "FortuneTeller: アファメーションすれば\n内なる宇宙の深淵へ辿りつけるよ\n着いてこられてるかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: "FortuneTeller: そうすれば\nなにもかも収まるところに収まるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: "FortuneTeller: あんたの血筋と前世には\n看守がいるね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: "FortuneTeller: そいつに居場所を与えてやりな\n前世を繰り返してるだけなんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: "FortuneTeller: 赦して 受け入れるんだ\n自分の中に"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: "FortuneTeller: そうしてはじめて\n輪廻の鎖を断ちきれるんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: 呑み込めたかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: "FortuneTeller: いいね\nこの場所の配置\nなかなか悪くないよ 正直"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: 気の流れが家の中を通ってる'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: "FortuneTeller: そうかい\n自己探求に興味ないのかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: より良い自分になりたくも？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: 悲劇だね'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: "FortuneTeller: お前さんが腹 下すよう\nアファメーションしとくよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: こんばんは'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: "Gasmask: FEMAの者です\n近隣の巡回中です"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: 一人ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: どう信じろと？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: いえ 単独行動ではありません'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: "Gasmask: 我々の部隊は複数の班に分かれ\n広範囲を対応しています"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: 話に時間は取らせません'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: "どうして防護服を？\nそんなものが必要なんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: なにをしてくれるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: 身分証明を提示可能です'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: "Gasmask: いずれにせよ\n来訪者は滅多に集団行動を取りません\n皆無と言って差し支えないでしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: "どうして防護服を？\nそんなものが必要なんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: なにをしてくれるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: "Gasmask: いえ ですが必要に応じ\n任意で購入できます"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: "Gasmask: 現在 太陽が環境へ与える影響を\n研究中です"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: "Gasmask: 我々は屋外活動が多いため\n措置が求められます"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: それでどうすれば？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: 今後の計画はあるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: "Gasmask: 第一に情報を収集し\n上層部へ送ります"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: 次に対応手順を確立します'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: "Gasmask: 現時点では\n平静の維持に努めてください"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: それでどうすれば？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: 今後の計画はあるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: 一名を連行します'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: "Gasmask: 検査を実施し 健康状態および\n本地域の居住安全性を確認します"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: "Gasmask: 無論\nあわせて対象が人間かどうかも\n照合します"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: 荷造りは必要ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: 待っていればいいんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: "Gasmask: 無論\n我々が無計画に行動することは\nありません"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: 同居人の方々を研究所へ移送します'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: "Gasmask: 諸検査の結果\n問題が見つからなければ\n対象を返還します"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: 荷造りは必要ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: 待っていればいいんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: この住居は あなたのものですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: "Gasmask: であれば不要です\n同居人の方々と待機してください\n避難が必要な場合は\n我々から通知します"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: 一名を連行します'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: よい夜を'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: "Gasmask: はい\n情報が揃い次第 指示を発令します"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: 現時点で懸念事項はありません'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: "Gasmask: 対象の返還は\n可及的速やかに実施します"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: 失礼します'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: "Prophet: やあ\nまた巡り会ったな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: "Prophet: 以前とは様子が違うようだ\nだが 私たちは生きている…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: "Prophet: ふむ\n不思議な感覚だ…\n名状しがたいな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: "Prophet: 会話を切り出すのに…\nちょっとしたことから始めよう"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: "Prophet: 私の運命を書で占ってくれないか？\nどのページを開けばいい？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: 冒頭あたりからにしましょう
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: 真ん中をどうぞ
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: 最後を開いてください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: "Prophet: 「死せる者 危難を冒し 声出さん\nされど聴く者 一人もあらず」"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: ああ…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: 未だなお響く言葉だ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: 今や驚くには値しないが'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: どういう意味です？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: 本気で信じてるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: 「あなたは何なの？」'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: "Prophet: 「私か？私は私だ\n君？君は家だ」"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: "Prophet: ああ そうだとも\n悲劇の物語だ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: "Prophet: 私たちに待っているのも\nああいう定めか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: 充分あり得る'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: どういう意味です？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: 本気で信じてるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: "Prophet: 「君も僕も あの魚たちのように\nとっくに いなくなった人たちの\n記憶でしかなくて…」"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: "Prophet: 「…本当は誰もいない世界に\n雨が降っているだけかも\nしれないんだ…」"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: "Prophet: 「…鳥なんか はじめから\nいなかったのかもしれない」"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: ふむ あるいは じき こうなる定めか'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: "Prophet: どう思う？\nすでに私たちは誰かの夢なのか\nこれから夢となるのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: 興味深い一節だな'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: どういう意味です？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: 本気で信じてるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: "Prophet: しばし熟考せねばな\nお前は どう考える？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: さて 伝えるために来たのだ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: やがて 様々な出来事が起こるだろう'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: 備えねばならない'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: "Prophet: 奇妙に聞こえようが\n猫を連れた者を\n迎え入れねばならない"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: "Prophet: 必ずや助けとなろう\n言えるのは それだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: "Prophet: だが無論\nどうするかは お前 次第だ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: "Prophet: ひとまず\nお前の選んだ卜占の意味を\n私は解き明かそう"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: 完全に というわけではない'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: "Prophet: 忠告だと考えればいい\n忘れぬための\nあるいは見落とさぬための"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: 黙考の果てに ある天啓が降りてきた'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: "Prophet: まもなく 猫を連れた者が訪れる\n肝要なのは 受け入れることだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: まだ理由は言えぬまでも 助けになろう'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: "Prophet: ひとまず\nお前が書より選びし一節\nそれを私は見極めよう"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: よう オイ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: "Fanatic: オレら ツイてんな！\n人間の欲望が裁かれる瞬間を\nこの目で見られるんだからな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: "Fanatic: 地球が浄化されんだ\n太陽の おかげでな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: そして 無垢なる新世界へ旅立つんだ！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: "Fanatic: 見さらせ！\nクソ貴き天の恵みを！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: えっ？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: 怖いんですが
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: なんだなんだ オイ？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: "Fanatic: 耳かっぽじって よく聞きな\nかいつまんで教えてやっから"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: "Fanatic: 太陽が灼熱で オレらを炙ってんのは\n意味があんだ！\nオレらの罪を焼き払ってんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: "Fanatic: オレら あれこれメチャクチャ\nやらかしたろ\nそんで太陽が ブチギレてんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: "Fanatic: 天罰だ！\n天罰 食らってんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: "Fanatic: こいつは天の恵みだ\nあらゆる罪が消え\nお天道様の下を歩けるんだからな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: "じゃあ… \n死ぬ運命なんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: あなたは どうなるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: 気でも触れてんのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: "Fanatic: 耳かっぽじって よく聞きな\nかいつまんで教えてやっから"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: "Fanatic: 太陽が灼熱で オレらを炙ってんのは\n意味があんだ！\nオレらの罪を焼き払ってんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: "Fanatic: オレら あれこれメチャクチャ\nやらかしたろ\nそんで太陽が ブチギレてんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: "Fanatic: 天罰だ！\n天罰 食らってんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: "Fanatic: こいつは天の恵みだ\nあらゆる罪が消え\nお天道様の下を歩けるんだからな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: "じゃあ… \n死ぬ運命なんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: あなたは どうなるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: 逆だ逆！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: "Fanatic: 罪は消えるんだ\nもしかしたら 太陽もな\nでもよ！オレらは生きるんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: "Fanatic: 死もなけりゃ 盗みもない\nオレが いるもんをマトモな値段で\n売らねえクソごうつくばりも"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: "Fanatic: 想像してみな？\nこれが どういうことか わかるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: オレに なんの関係あんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: "Fanatic: オレら全員 ちゃんと暮らせんだよ！\n太陽に救われれば すぐにな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: "Fanatic: こんな世界から\n太陽が解放してくれんだ\nわからねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: "Fanatic: わかってるよな\nだからこそ 生きてられんだからな！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: まだまだ語り明かしてやるよ！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: "Fanatic: おっと 忘れるとこだった\nビールとか ねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: "Fanatic: 太陽のこと\nなにも知らねえ振り\nしてんじゃねえだろうな？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: "Fanatic: じゃあな クソッタレ！\n別のヤツを救いに行ってやるぜぇぇ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: "Fanatic: じゃあな！\nあぁぁばよっ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: こんばんは！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: "Anxiety: 遅くに すみません…\n昼間 すごく暑くて\nテレビで屋外に出ないほうが いいって"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: 少し いさせてもらえませんか？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: どうして ここに？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: えっと 町の近くに住んでたんですが'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: "Anxiety: あそこのアスファルト\n酷く熱くなってて 想像通り\nへへっ へへへ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: "Anxiety: 実は地元の店で レジ係してて\nあっ 今はもう 違いますけど"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: "Anxiety: その…クビになってしまって\n仕事なかなか うまくいかなくて…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: "これから\nどうするんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: 今後どうなると？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: "Anxiety: ここまで\n来たくて来たワケじゃないんです\nえっと 足元のアスファルトが溶けてて\nでも まだ なんとかなるかな って"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: 笑っちゃいますよね へへ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: "Anxiety: 私の家に 来訪者が来ちゃって\nへへ… 信じられます？\n自分の家から\n追い出されちゃったんです！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: "Anxiety: それで\n今は太陽から逃れられる場所を\n見つけたくて"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: "これから\nどうするんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: 今後どうなると？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: "Anxiety: うぅぅん…\n生き延びたいんですけど やはり怖くて\nそこら中 来訪者だらけだし\n太陽は地獄の業火だし"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: "Anxiety: すごく生きたいですよ\nへへへ はぁ…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: あなたは怖くないんですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: "Anxiety: じきに全部 片付く\nそう言ってください\nお願いだから…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: わっ…わかりません'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: "Anxiety: 私 生き残れるでしょうか？\n誰か 助けてくれるでしょうか？\n助けを求めて\nどれだけ歩けばいいんでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: "Anxiety: この先どうなるかなんて\nなにも思い浮かびません\n想像も できなくって"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: "Anxiety: あなたは恐ろしくないんですか？\n私 怖くてしかたないです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: "Anxiety: ありがとう はは！\n本当に ありがとう！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: "Anxiety: もうちょっと生きていけます\n神に感謝ですね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: "Anxiety: はは ああぁぁぁぁ…\nいえ そうですよね…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: "Anxiety: でも 話を聞いてくれて\nありがとう"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: "Anxiety: えっと うん\n私 行きますね じゃあ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: "Anxiety: さよなら？\nうん その さよならですね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: 入っていいか？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: 酒場に避難してたんだが…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: 追い出されてしまったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: "Esenin: 理由？\nふん 俺の気質に耐えられる奴\nばかりじゃないさ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: "Esenin: でも 誰かを傷つける つもりはない\n気にしないでくれ\nただ… 生きてて嘔吐しそうになるとき\nって あるだろう？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: "Esenin: どうする？\n中に入れてもらえるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: 来訪者じゃないんですよね？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: "面倒事\n起こしたりしませんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: 俺を怪物の一味とでも？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: "Esenin: 違う 俺は来訪者じゃない\nだがな 誰彼構わず顔 突き合わせて\n訊いて回るなんて クソくだらない"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: "Esenin: ここも大して違わないんだろうがな\nどうせ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: "どうして前の避難所を\n追い出されたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: "どうして ここは違うと\n思うんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: なにを面倒事だと？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: "Esenin: 殺人や喧嘩は趣味じゃない\nだが やられっぱなし\nって気質でもない"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: "Esenin: 飲み食いは好きだ\n気が乗れば話すのも悪くない\nそれが「面倒事」か？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: "どうして前の避難所を\n追い出されたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: "どうして ここは違うと\n思うんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: "Esenin: 最初は暴言の一つも\n吐こうかと思ったが\n気が変わった"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: "Esenin: 言ったとおり 浮いてたんだ\nなんとも気が知れない連中でな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: "Esenin: そう思えば\n追い出されて正解だったのかもな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: "Esenin: 生きたまま食われたかもしれないし\n誰にも気付かれなかったろう"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: "Esenin: 今 俺にどうしろと？\n太陽で焼け死ねば いいのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: いや 御免被る'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: "Esenin: 生きてるうちは\n誰かと語り合いたいんだ\n入れてもらえないなら\n他で運試しするさ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: "Esenin: この世界に まだ運や\nクソ野郎 以外が残ってればだが"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: "Esenin: ありがとう\n人への信頼なんて\n一山いくらの値打ちもない時代だ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: "Esenin: だからこそ 君の信頼に感謝する\nとはいえ…\nまあ なにも約束できないが"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: "Esenin: ふむ\nわかるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: "Esenin: わかるよ だが腹は立つ\nそこらの連中と君も同じ\nただの臆病者だ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: "Esenin: 安らかに眠るといい\nもういいとも\nそれと クソ食らえ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: 少し 休ませてもらえませんか？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: どこから来たんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: どちらへ行くんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: "Widow: 覚えてません\nどこだろうと\nどうだっていいですから"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: "Widow: すごく疲れてるんです\n少し休まないと\n窓辺で気絶するかもしれません"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: "連れの方\n体調が優れないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: "一緒の人\n助けが必要ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: "Widow: 私… どこかに倒れて\n二度と起き上がりたくないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: どこに行こうと どうでもいいんです'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: "連れの方\n体調が優れないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: "一緒の人\n助けが必要ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: 夫です'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: 死んでます'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: "Widow: ちゃんと弔ってあげられなくて\n今 手放しても しょうがないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: "Widow: もう いりません\n夫が必要としていたとき\n誰も手を差し伸べてくれませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: だから 死んだんです'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: "Widow: ひょっとしたら\n生きていられたかもしれないのに…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: "Widow: 誰かが ほんの少しでも\n気にかけてくれていたら"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: 長居はしません'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: "Widow: 一休み させてもらえれば\n充分なんです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: 貴方…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: よっ！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: "Scammer: ニイさん 今の状況 見たかい？\nクソめちゃくちゃだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: そっちの調子は どうだい？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: なんの用ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: 実際 なにが起きてるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: "Scammer: なあんにも\nちょいと気になってな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: "Scammer: でもよ\nちょっとした儲け話があるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: "Scammer: 太陽のネタで騒がしいだろ\n指一本 動かさず 楽に稼げる\nってもんさ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: "Scammer: イモ引いて固まってるヤツばっか！\n動いたもん勝ちだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: どうして ここに？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: どんな話ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: "Scammer: 新しいチャンスが転がってるだろ\n見えちゃいないのかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: "Scammer: みんな首 刎ねられた鶏みたく\n走り回ってるけどさ\nやりたいこと やればいいだけの話だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: "Scammer: つまり\nもっと楽しめ ってこと"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: どうして ここに？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: どんな話ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: 本題に入ろうか！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: "Scammer: ニイさん なにか企んでんだろ\nみんなウワサしてるよ\n盛り上げよう って魂胆かい"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: "Scammer: 二人で人生最高のパーティーと\n洒落込もうや！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: 生き残りたいだろ？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: "Scammer: 動けるうちに動かなきゃ\n太陽なんてクソ食らえだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: "Scammer: 動かなきゃな？わかるだろ？\nさあ どうする？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: "Scammer: いいね相棒\n話せるじゃないか！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: やっと 話のわかる相手に会えたよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: "Scammer: 冴えないヤツだね 全く\nでも いいさ 好きにしな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: "Scammer: なら\nお隣にでも行ってみるかね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: 達者でな'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: "Neighbour: おう お隣さん\n久しぶりだな\n元気してたか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: "変わらず\nってとこですね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: まあまあです
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: "Neighbour: なあ 寄ったのはワケがあるんだ\nアンタが ちょっと気になってな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: なんだか嫌な予感がする'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: "Neighbour: 従姉妹から電話があったんだ\n向こうの報道じゃ\n太陽に異常が起きてるとか"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: "Neighbour: 地中から這い出てくる\n連中の話も聞いた\nなぜだか 来訪者\nなんて呼ばれてるらしい"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: "Neighbour: 気味が悪い\n嘘だといいんだが"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: 太陽に なにが？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: 来訪者ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: "Neighbour: なあ 寄ったのはワケがあるんだ\nアンタが ちょっと気になってな"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: なんだか嫌な予感がする'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: "Neighbour: 従姉妹から電話があったんだ\n向こうの報道じゃ\n太陽に異常が起きてるとか"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: "Neighbour: 地中から這い出てくる\n連中の話も聞いた\nなぜだか 来訪者\nなんて呼ばれてるらしい"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: "Neighbour: 気味が悪い\n嘘だといいんだが"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: 太陽に なにが？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: 来訪者ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: "Neighbour: 太陽そのものが爆発するとか\n表面でフレアが起きてるとか…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: "Neighbour: 確かなのは\n異常事態 ってことだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: この夏 やたらと暑かっただろ？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: 最悪の事態に 備えとかなきゃな'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: "Neighbour: 従姉妹が言ってたんだ\n一人で家にいるのは危ない って"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: "Neighbour: それで 来たんだ\nアンタが殺されないように"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: わかった
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: 自分の面倒ぐらい見られる
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: 奥さんと娘さんは？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: "Neighbour: ああ 地面から出てくる連中を\nそう呼んでるんだとか"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: "Neighbour: なんで そんな呼び名なのかは\n知らないが"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: "Neighbour: 地球にとって\nよそ者 ってことなんだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: "Neighbour: それか\n人の家に入り込もうとするからか"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: "Neighbour: 従姉妹が言ってたんだ\n一人で家にいるのは危ない って"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: "Neighbour: それで 来たんだ\nアンタが殺されないように"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: わかった
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: 自分の面倒ぐらい見られる
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: 奥さんと娘さんは？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: よし 話の続きは 朝にしよう'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: 台所で待ってる'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: また朝に会おう'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: "Neighbour: わかってる\nだが 思っている以上に\n今 一人でいるのは危険なんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: "Neighbour: 今夜は一緒に いさせてくれないか？\n念のためだ\nそのほうが安心できる"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: "Neighbour: カミさんと娘なら 心配いらない\nちょうど最近\n信頼できる友人が来ててな\n家族は任せてある"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: よし 話の続きは 朝にしよう'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: 台所で待ってる'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: また朝に会おう'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: "Neighbour: 心配いらない\nちょうど最近\n信頼できる友人が来ててな\n家族は任せてある"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: よし 話の続きは 朝にしよう'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: 台所で待ってる'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: また朝に会おう'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: こんばんは！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: "Daughter: お父さん ここにいる？\n呼んでくれる？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: "Daughter: 昼間は へっちゃら だったけど\n今は怖い\n夜になると\n人がたくさんウロウロするから…"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: お父さんの名前は？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: "お父さんのこと\n教えてくれる？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: "Daughter: お父さんの名前 忘れちゃったの？\nあっ あたしが来訪者かどうか\n試してるんだね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: "Daughter: ずるがしこ！\nあたしも これから 試しちゃお"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: "ここに来るまで\nなんともなかった？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: 来訪者が怖い？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: "Daughter: んっと お父さんのことなら\nいっぱい知ってるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: "Daughter: お出かけの前にね\nちょびっとビール飲むんだ\nえへへ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: "Daughter: 昼ご飯も お夕飯も\n置いてってくれるんだ\nジュースもね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: "Daughter: 今日ね お父さんのビール飲んでみたの\nオエッ ってなっちゃった\nにがにが！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: "Daughter: なんで あんなの飲むかな？\nジュースがあるのに"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: "Daughter: あっ\nお父さんには内緒だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: "ここに来るまで\nなんともなかった？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: 来訪者が怖い？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: "Daughter: あのね みいんな\nひっくり返っちゃったみたい"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: "Daughter: 昼間は みんな\nお家でゴロゴロしたり 眠ったり\n夜になると\n外でウロウロしたり なにかしたり"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: "Daughter: 暗いの まだ怖いんだ\nでも なにもいないし\nオドオドしなくても いいみたい"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: それとも なにかいるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: "お父さん呼んでくるよ\nがんばってね！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: 気をつけてね！
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: わかんない'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: "Daughter: みんなが怖がってるから\nあたしも怖い\n一度も見たことないのに"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: "Daughter: 怖いの？\nぶったりする？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: "Daughter: 学校の友達にパンチされたら\nその子も来訪者？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: "Daughter: 気をつけろ って\nお父さん言ってた\nすっごく 気をつけてる！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: "Daughter: ここまで シーッ って来たの\n全然 見つからなかったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: "お父さん呼んでくるよ\nがんばってね！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: 気をつけてね！
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: ありがとう オジサンもね！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: "Daughter: もう行くね\n夜に一人ぼっちは怖いから"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: "Daughter: お父さんが作ってくれたゲームで\n遊ぶんだ\nサイコロ転がすんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: "Daughter: それでね\nイスとか ソファとか\n使って進んでくの"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: "Daughter: 道を作ってくんだ\n後で見せたげるね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: じゃあね！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: こっ こんばんは'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: いっ 入れて'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: 大丈夫？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: なにがあったの？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: "Daughter: どっ どうしたらいいのか\nわわっ わかんない"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: おっ おと'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: あっ ああ…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: おおっ お父さんが…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: こっ ころ…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: 殺されちゃった'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: 誰に？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: あっ ああ…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: こっ 殺され…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: ころっ 殺されちゃった…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: おっ お父さんが'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: 誰に？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: "Daughter: ららっ 来訪者が\nうっ うちに来て\nいっ 一緒に座って"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: "Daughter: お父さんが しゃっ しゃべってて\nななっ なにか\nこっ 殺されたの"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: おっ…うち…グスッ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: おうち ひひひっ 火が'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: 入って
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: 帰って
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: わわっ わかんない'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: "Daughter: お父さんと だっ 台所に\nすすすっ 座ってて"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: "Daughter: なっ なな なにかして\nおうち ひっ 火が"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: "Daughter: にっ にげたの\nわわっ わらってた "
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: 入って
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: 帰って
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: たたっ 助けてくれる？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: こっ 怖いよお'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: どっ どこ行けば いいの？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: うわあああああぁぁぁぁぁん！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: わあああああああああああっ！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: ここっ 怖いよおおおおおっ！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: やあ！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: なんの用です？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: "入れるつもり\nありませんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: 広い家だねえ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: 気に入ったよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: なにもいりません
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: こちらは銃を持ってます
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: ドアは しっかりしてる？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: なにがあるか わからないからね'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: わかるだろう'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: なにもいりません
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: こちらは銃を持ってます
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: うんうん 知ってるよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: じゃあああ…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: 家に一人でいるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: "いえ\n一人じゃありません"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: "ええ\n一人です"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: 素晴らしい！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: 窮鼠 猫を噛む って？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: でも ねえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: 家に一人きり？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: "いえ\n一人じゃありません"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: "ええ\n一人です"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: 今日はツイてるね'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: "SuperFake: 中で誰か こそこそ話してるの\n聞こえるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: でも 数日後は どうかな？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: ハハハッ！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: 一人なの 知ってるよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: 嘘つくかどうか 見たかっただけ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: じゃあ ドアを開けようか'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: "NotTrue: やあ 若いの\nここまで歩いて くたびれ果てたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: 休ませて もらえるかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: まっすぐ来たんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: 長い間 歩いてきたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: "NotTrue: いや まっすぐじゃないよ\n言わずもがなね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: "NotTrue: 縁ある者とは巡り会うものさね\n誰一人 すれ違ったりしないんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: "NotTrue: この地にたどり着いたのも\n足と目の導きだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: なるべくして なったんだろうね'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: "よくわかりませんが\nなにか お困りですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: "では歩き続けてもよいのでは？\nなぜ立ち寄ったのですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: "NotTrue: どれほど歩いたかなんて\n言えやしないよ\n「長い」って どれくらいだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: "NotTrue: お前さんも そうだろう\n家にいながら あちこち歩き回っとる"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: "NotTrue: 長いこと 歩いてきたのかい？\nきっと そうだろうよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: "NotTrue: でもね アタシは\nうんと長く歩いてきたんだよ\nアンタが ぬくい晩飯\n食べてきた数十年より ずっと"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: そういうもんだよ 若いの'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: "よくわかりませんが\nなにか お困りですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: "では歩き続けてもよいのでは？\nなぜ立ち寄ったのですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: いるものなんて 誰しも同じだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: "NotTrue: ちょいと物語を聞いて\n興味を分かち合いたいんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: "NotTrue: それから 横になって\n目を閉じれば 幸いさね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: ちゃんと一息ついてね'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: "NotTrue: 他に望みなんてないよ\nただ 一人きりで暮らすのは\nどうにも侘しくてね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: "NotTrue: まるで話を聞いちゃ\nいないようだね 坊や"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: 歩き疲れきっちまったんだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: "NotTrue: ここなら せめて一息つけて\n話し相手もいるだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: "NotTrue: アタシみたいな婆には\n立派な娯楽だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: "NotTrue: アンタが なにか物語れば\nアタシも なにか返そう"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: "NotTrue: それから\nしばし目を閉じれれば充分さね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: ありがとうよ 若いの'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: "NotTrue: アンタとなら退屈しなさそうだね\nここらで なにが起きてるのか\nちと見せてもらうよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: どこへ行っても 門前払いさね'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: "NotTrue: 翼を切られちゃいるが\n喉を開けば歌えるんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: "NotTrue: だが みんな\nやがてアタシを頼るんだよ 渋々\n口では なんと言おうとね"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: "NotTrue: なに 根に持ったりはしないよ\n誰にでも手は差し伸べるさ"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: "NotTrue: アンタも いずれ手が入り用になる\nそのとき どこに向かうんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: "Twins: こんばんは\nあっ しばらく私に寄りかかってて"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: ここに いさせてもらえませんか？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: "連れの方\n具合が悪いんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: "二人とも体調が悪いんですか？\nそれとも一人だけ？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: "Twins: この子 妹なんです\n鬱気味で"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: "Twins: 自分で歩いたり\n風呂に入ったりも できなくて\nベッドから起きるだけでも\n大変なこともあるんです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: "Twins: でも 大丈夫です\nいつか良くなる はずですから\nだよね？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: "Twins: 今は話す気分じゃないみたいですが\n時々なら力を出せるんです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: "これから\nどうするつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: "ずっと抱えてて\n疲れませんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: "Twins: 程度の差こそあれ\n誰しも鬱で苦しんでるんです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: "Twins: 太陽が異変を起こす前から\nこうなると感じていました"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: "Twins: ニュース ご覧になってます？\nなにもかも これに繋がってたんです\nでも 太陽が爆発するとは思えなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: "これから\nどうするつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: "ずっと抱えてて\n疲れませんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: "Twins: 妹が少しでも\n安らげる場所を見つけないと"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: "Twins: それから 二人で\n新しい人生を始めるんです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: "Twins: 私たちの人生\nおしまい なんでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: "Twins: 私は そうは思いません\n楽になっていく はずです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: どうか 言葉を選んでください'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: "Twins: ええ 体力は奪われます\nでも 見捨てられるはずありません\nそういう意味でしたら"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: "Twins: 二人 一緒に親元を出たんです\nもう 二人きりなんです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: "Twins: ありがとうございます！\n妹を中へ運ぶの手伝ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: "Twins: 両親の死で さらに弱ったみたいで\nでも ずっと前から こうなんです"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: "Twins: ここなら 少しは気晴らしに\nなるかも しれません"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: "Twins: はぁ…\nじゃあ どこか別の場所に避難しないと"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: "Twins: さあ 行こう\nちょっとでいいから がんばって"
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: お願い これが終わったら…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: "Firefighter: 消火に行く前\nこの紙を職場で渡されたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: "Firefighter: FEMAの隔離区域に行けってね\nでも みんな死ぬような所に\n誰が行くんだか…"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: "Firefighter: ほら もう いらないからさ\n捨てるなり使うなり\nどうぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: "Firefighter: 紙が ゴホッゴホッ 1枚あるんだ\n大事なものみたいでさ"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: "Firefighter: あげるから 中に入れてくれないかな\n最期を静かに過ごしたいんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: どうぞ 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: いえ 結構です
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: "Wheelchair: なんだと？\nあん？"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: "Wheelchair: つまらん男だな\nエナジェカでも飲んで\nスッキリしろよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: "Wheelchair: ここまで押してきてクタクタだ！\nいや 働いた働いた！"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: どうぞ 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: "Wheelchair: おう エナジェカやるよ！\n入れてくれて ありがとな！"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: "Anger: クソッ…\nクソックソクソクソッ…"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: いいか オレはクソ…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: "Anger: エナジェカやるから\n入れてくれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: それで クソめでたしめでたし だろ'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: どうぞ 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: 失せろ
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: "Anger: オレのことは気にすんな…\nオレはただ… クソッ…\nもういい…"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: ほら エナジェカ'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: "Anger: こんなカスいらねえんだ\nちっとでも落ち着けるんなら\n別だがな"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: "Anger: … ああ いるんだな 一目瞭然だ\n{0}が\n全員 息を潜めて頭を垂れてやがる\n触れられないようにな オレはゴメンだ"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: "Anger: 近くに いるだけで反吐が出る\nあのクソかオレか どっちかだ"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: "Anger: ぐうの音も出ない連中と一緒なんざ\n真っ平ゴメンだ"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: ええ 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: 諦めてください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: いいとも'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: "Anger: ありがとな \nハッキリ言ってくれて\nマジでキツいだろうに"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: "Anger: オレも やってみるよ…\nまあ わかるだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: そう来たかよ'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: 慣れた連中のほうが いいってか？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: "Anger: クソ食らえ\n地獄へ落ちやがれ！"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: "Fanatic: こいつは聖なる太陽様\n御自らの寛大なる祝福だ\nお前に相応しいぜ\nほらよ エナジェカ！"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: お前 どこまで愚かなんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: 正しき者を追い払うだと！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: "Fanatic: オレを入れれば 聖なる太陽様\n御自らの寛大なる祝福に\n預かれるんだぜ\n考え直せ 友よ！"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: どうぞ 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: 失せろ
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: "Super: 最後の来訪者が現れたとき\n何が起きたか誰も知らない"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: "Super: その家は長らくずっと\n誰も使わず放置された"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: "Super: 恐るべき失踪事件の後\n誰もが空き家を避けた"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: "NotTrue: おや 旧友…\nいるのかい？\n{0} が"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: "NotTrue: 物音がしたかと思えば\n誰かが影に囁く…\nそんな場所は怖くってね"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: "NotTrue: 好きで一人\nぶらついてるんじゃないのさ\n耐えられなくってね\n騒々しいのは"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: "NotTrue: あっちが好みなら そうしな\nアタシは縁側で 変化の風が\n静まるのを待つさね 怒らないでおくれ\n嵐の中 出歩くなんてゴメンだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: "NotTrue: もう無理さね\n崩れちまうよ"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: ええ 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: 諦めてください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: "NotTrue: なら 邪魔しようかね\nでも また嵐や鏡の虚像みたいな\n臭いがしたら出ていくよ\nもう歳だからね 耐えられないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: "NotTrue: そうかい それなら\nアタシの居場所じゃないんだろうね\nなら… 話は終えて ぶらつこうかい"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: "NotTrue: でも しっかり目を開けるんだよ\n真実ってのは時に静かで\nけれど命に関わるからね"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: お願いします…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: "Twins: 中に入れてください\n一日だけでも\n二人で なにか…"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: お礼しますから'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: どうぞ 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: 失せろ
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: 本当に ありがとうございます！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: "Twins: どうぞ エナジェカです\nこれしか持ち合わせがなくって"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: "Twins: では\n妹を運ぶのを手伝ってもらえれば…"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: "Twins: きっと無理ですね\n{0}が\n中にいるなら"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: "Twins: 空気が余計に重く感じられて\n誰かの思考に かき消されるみたいに"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: "Twins: 妹が耐えられないんです\nどんどん縮こまって…\n存在が薄れるみたいに"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: 私も… 息苦しくて'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: "Twins: すみません 待たせてください…\n事態が静まるまで\nいずれ過ぎ去る かもしれませんから"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: ええ 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: 諦めてください
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: "Twins: ありがとうございます\n妹の背中に手を添えてください…\nこんな風に"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: "Twins: 両親の死後…\n妹の なにかが壊れてしまったんです\nでも 精一杯 辛抱してくれてるんです"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: "Twins: 長いこと さまよってきました\nここに来れば せめて\n少しは楽になれると信じて"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: … わかりました'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: "Twins: ねえ もう少しだけ辛抱して\nあそこに行くまで\nほら 私に寄りかかって…\n支えるから"
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: "Twins: 時々 なにもかもが…辛すぎて\n扉ひとつ越えられない\nけど 行かないと\nほら… 一歩ずつ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: そうですか…残念です'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: 本当に ありがとうございます'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: "Tourist: {0} がいますよね\nあの方と うまくやっていける\n自身がないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: "Tourist: 申し訳ありません\nですが 今のところ 入れなさそうです"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: これで 渡りをつけない？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: "Alt: よし\n{0} でどう？"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: "Alt: こういうの 慣れっこなんだ\n君が どう話 転がそうとしてんのかも"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: "Alt: ムカつくけどさ\nクズに限って ツイてんだよね"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: "Alt: 時間は まだあるし\n別の手を探すよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: いいよ'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: "Alt: ありがとう\n期待してなかったけど\n心のどこかで願ってたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: "Alt: でも 私らが同じ部屋にいるとこを\n見ることはないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: "Alt: 話すと長くなるし\nまだ 洗いざらい ぶちまける気には\nなれないかな"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: "Alt: おっと 来てたんだ\n{0} も"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: これで帳消しと いこうや？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: "FunnyGuy: おっ これこれ\n{0} だ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: "FunnyGuy: ほら なんかやるよ…\nなんか なかったか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: "FunnyGuy: いいさ\nこんなのは これで最後だ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: "FunnyGuy: ったく アンちゃん\nあのクソ銀行屋どもと 瓜二つだね"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: "FunnyGuy: んじゃ オイラは行くわ\n日の出までは まだあるしな"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: そうかい わかったよ'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: "FunnyGuy: 借金の死に乾杯しねえとな！\nはははっ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: "FunnyGuy: そうこねえと！\n缶でも開けて 祝おうじゃねえか！"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: "FunnyGuy: これまで 散々のツキでよ\nせめて ここくれえは\nサッパリ いきてえだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: "FunnyGuy: あそこ いんだろ？\nあの {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: "FunnyGuy: いや マジいな\n気分ブチ壊す奴がいるじゃねえか"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: "Fairytaller: わかりました\n事情は理解しています\nどうか ご無事で"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: "Fairytaller: ですが 信頼していただき\nどうも ありがとうございます！"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: "Fairytaller: えっ！？ありがとうございます！\nそこまで していただかなくても\n他を探そうかと"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: "Fairytaller: ですが {0} と\n同じ部屋というのは\n居心地が悪いんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: "Fairytaller: たくさん時間を取ってしまったこと\nご自宅に 押しかけてしまったこと\n理解しています\n"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: "Fairytaller: 正直に言って\nあれは 僕の責任では ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: "Fairytaller: どうもありがとうございます！\nですが…どうやら 前に喫茶店で\n働いていた頃の 問題人物が\nいるみたいなんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: "Leper: よし なら なんか いるか？\nほら {0}\nこれで入れちゃ くれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: "Leper: どっちみち お前の勝手だ\n俺は行く"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: "Leper: 見た目で人を虚仮にするような奴が\nこの家に いる資格があるとでも\n考えてんのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: "Leper: ありがとよ\nまた嘲笑われんのは たまらなくてよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: "Leper: {0} が いんだろ\nアイツ 昔 外見を嘲笑いやがってよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: "Leper: 悪い\nどうも駄目みてえだわ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: "Nervous: あんな クソ野郎に囲まれてたら\nキミだって クソまみれになるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: "Nervous: まあ キミのとこ 転がり込まないのも\nそれはそれで いいのかもね\nうん"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: 本気？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: "Nervous: おかしなことに 首突っ込んだって\nしょうがないもんねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: "Nervous: うさんくさく聞こえた かもだけど\nでも まあ いっか"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: いい選択をしたねえ'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: 見たんだ…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: すごく 変わった人なんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: "Nervous: 知ってるよ\n一ヶ月前のこと"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: あっ {0} だ'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: "Bald: 外には気を付けたまえよ\nこの三文芝居を\n君が やり遂げんことを祈る"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: "Bald: 承知したよ ご友人\n全部 承知しているとも\n恨みはしない"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: 嗚呼'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: "Bald: わかるよ 気まずいものだ\n人を追い出すなんて\nだが それが人生\n時には 善人の仮面を 取らなければ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: "Bald: そうそう あの {0}\nなんとか 外に追い出さないかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: "Bald: ご友人 私は誰とでも\nよしなに やっていけるんだよ 実際\nでも 今回は厳しいかな\n赤信号が光ってる"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: …ガッカリだね'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: 肝っ玉が ないっての？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: "Tough: なんだよ それ？\nアンタなら もっと気骨を尊重してる\nもんだとばかり"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: "Tough: アイツ 根性なしだったんだね\nそんなアッサリ 放り出すなんて"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: "Tough: ありがとう\nまさかマジで やってくれるなんてね"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: "Tough: アイツ追い出すか\nアタシが別のとこ行くか\nどっちかだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: "Tough: そいつ 誰？\nその {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: よし もう行かなきゃ'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: "Jacket: チッ…\nFEMAに見つかっちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: "Tourist: とても残念です\n手を貸して いただけないとは"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: "Tourist: そんな…\nなら どこへ行けと言うんですか？\n近隣は全部 当たったのに"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: 恩に着ます'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: "Tourist: お願いします\nどうか しばらく泊めてもらえませんか"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: だから もう行く先が ないんです'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: "Tourist: しばらくは\nホテルに泊まって いたんですが\nおカネが尽きて しまいまして"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: ええ…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: "Tourist: ですが もう ここにいて\nホテルに泊まる おカネもないんです\nどうか しばらく泊めてもらえませんか"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: "Tourist: ええ まったくです 信じてください\n太陽が こうなると知っていたら\n絶対に来ませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: "本当に 行く宛が\nないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: "観光には最悪の\n時期ですね"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: 本当は 単なる通り道だったんですが'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: "Tourist: ですが 国境が封鎖されまして\n街から出られなく なりました"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: "Tourist: 首都に向かっている途中だったんです\n旅行に出かけようとして…"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: "本当に 行く宛が\nないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: "観光には最悪の\n時期ですね"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: "Tourist: 空港は閉鎖されていて\n電車も動いていません"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: "Tourist: 手違いが起きてしまいまして\n街から出られなくなったんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: 何故 こんなところに？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: どうしました？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: "Tourist: あの 助けてもらえませんか？\nこの辺の人じゃないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: じゃあ もう行かなきゃ'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: "Alt: このへんには まだ他にも家はあるし\n見た目なんて気にしないで\n人間扱い してくれる相手だって\nきっといるはず"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: 今週は マジでボロボロだったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: "Alt: じゃあ また昼間に話そうか\n今日はもう ヘトヘトでさ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: いいね'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: "Alt: 最悪なのは ニュースを聞くたび\n思い知らされること\n報道されてる恐怖に比べて\n現実は五倍 いや十倍は怖い って"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: テレビ見たって 気休めにならないしね'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: "Alt: 電気が通ってるかは知らないけどさ\n止まってても 別に構わないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: "Alt: ここ夜になると 涼しくなるだろ\n一日中 ニュースに貼り付いてる奴も\nいないしさ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: よし'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: "Alt: ざっくばらんに話していい？\nその方が 話も早いしさ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: "Alt: なら 緞帳が上がるのを\n最前席で待つ気はないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: "Alt: これから さらなる惨劇が\n始まるだろうね"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: "Alt: 長引けば長引くほど 状況は悪化する\n息が詰まり 犯罪は増えていく\nアパートじゃ 疑心暗鬼が募るばかり"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: "Alt: それにさ これから街にいんのは\nヤバくなりそうでさ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: "Alt: 堅苦しいのが嫌いなだけ\nその方が 話も早いだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: "Alt: なんで 逃げてる って\n決めつけんの？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: "ここに来たら なにか\n変わるとでも？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: なにから逃げてるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: "Alt: 格好が なんだっての\n仕事に関係ないだろ\nそれに 誰も傷つけるつもりなんてない\n見た目だけで 判断しないでよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: "Alt: 別に 悪いことしてないだろ\n冷たい目で見るんじゃないよ\nそのつもりならね"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: なあ なんで そう無愛想なの？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: "ここに来たら なにか\n変わるとでも？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: なにから逃げてるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: "Alt: 変質者に来訪者だけで ウンザリなのに\n太陽までクソ照りつけてくる"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: 街中だけじゃ なくてね'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: "Alt: 街外れで ヤバいことが起きてるって\n噂を小耳にしてさ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: "Alt: いや 君の家が廃屋みたい って\n意味じゃないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: 度胸ありますね
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: 空き家に見えました？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: "Alt: おっと やっぱり誰かいたんだ\n入れてもらえない？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: "FunnyGuy: なあに どうにかするさ\n日の出までは まだあんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: チッ'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: 望みなし ってか？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: "FunnyGuy: アンちゃんに わかんねえだろうけど\n今日は オイラの人生\n最高の記念日なんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: "FunnyGuy: そうこねえと！\n缶でも開けて 祝おうじゃねえか！"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: "FunnyGuy: でだ 入れてくれんのかい？\nどうなんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: "FunnyGuy: オイラも こんな家が ありゃね\n夢の生活 間違いなしだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: "FunnyGuy: いいとも\nどうせ ローンなんて 関係ねえんだろ\n見りゃわかるよ いいとこだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: "FunnyGuy: なんて言やいいかね\nアンちゃん てんで祝っちゃくれないね"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: "あまり おしゃべりじゃ\nないんですね"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: "FunnyGuy: そういうノリは あんま愉快じゃねえな\nぶっちゃけ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: "FunnyGuy: おいおい\nずいぶんな 皮肉じゃねえか"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: "あまり おしゃべりじゃ\nないんですね"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: 悪く思うなよ'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: "FunnyGuy: 本音 言うとよ\nこんな人前で 語る話じゃ ねえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: おおっと いい質問だな'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: "浮いたカネで どうする\nつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: "それで…ここで\nなにを？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: おったまげるぜ！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: "FunnyGuy: この混沌のおかげで\n銀行もローンも\n誰も気にしちゃいねえ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: "FunnyGuy: 今となっちゃ ビタ一文\n借りちゃいねえ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: だが 今は違う！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: 本当 下り坂を直滑降してたんだぜ？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: いやな 首まで借金漬けだったんだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: "浮いたカネで どうする\nつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: "それで…ここで\nなにを？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: "FunnyGuy: やっと呼吸できるぜ\nこれが アンちゃんに わかりゃな"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: "FunnyGuy: 友…いや 兄弟！\nもう住宅ローンで悩まずにすむんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: "FunnyGuy: よせやい そんな言い草！\nまだ 飲み込めてねえんだな！"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: "何故 そんなに\n上機嫌なんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: 頭 どうかしたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: "FunnyGuy: すげえ夜だろ？感じてっか？\n混じりっけなしの魔法だろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: ようよう 調子どうだい！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: "Fairytaller: わかりました\n事情は理解しています\nどうか ご無事で"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: "Fairytaller: 嬉しいです\n親切な方は 現実に存在するんですね\n童話の中 だけじゃなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: "Fairytaller: どうも ありがとうございます！\nこの ご恩は忘れません！"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: "Fairytaller: 行く宛が 全く ないんです\n大人の暮らしが こんなに大変だなんて\n思ってもみませんでした\nせめて生活が すぐ終わりませんように"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: "Fairytaller: 将来 きっと恩返しします\n今できることなら なんでも手伝います"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: "Fairytaller: 大した持ち合わせは ありませんが\nもう一度だけ 考え直して\nもらえませんか お願いします"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: "Fairytaller: そうですか\n理解できます"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: "穀潰しは不要だ\nさっさと失せろ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: "Fairytaller: 僕は 救世主の器じゃ ありません\nですが どんな物語も 最後には\n善は悪に打ち勝つものです"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: "Fairytaller: 勇者が現れて 魔王を打ち倒し\n世界を元通りにして くれれば\nいいんですが"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: "Fairytaller: 人々は恐れ 家に隠れ\n互いを信用しなくなるんです…"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: "Fairytaller: まるで子供時代の童話みたいですよね\n悪が世界を支配するような物語です"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: "Fairytaller: でも今も昔も 同じ人間のつもりです\n少なくとも 殺人衝動は ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: "Fairytaller: もしかすると 僕にも徴候があって\n来訪者なのかも しれません\nわかりません 最近 変なことばかりで"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: "Fairytaller: 来訪者が何者で\n人間と具体的に どう違うのか\n実は よく わかっていないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: "穀潰しは不要だ\nさっさと失せろ"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: "Fairytaller: 自立できるまで お役に立てるよう\nがんばります\nいつか ご親切には お返ししますから"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: "Fairytaller: ご厄介に預かるのは気が引けますが\n困難な状況です\n生き延びるには やれるだけやらないと"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: "Fairytaller: 気持ちは理解できます\nただ 僕の気持ちも理解してほしくて"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: "Fairytaller: それで この騒動が始まった途端\n無職を理由に 追い出されてしまって\n後には身内を住まわせてるみたいです"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: "Fairytaller: 大家さんは当初から 定職のない新卒に\n部屋を貸すのは乗り気じゃ\nありませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: 子供時代みたいに'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: "Fairytaller: 辛い時代になると みんな\nなにもかも忘れて 気楽になりたく\nなるものですから"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: "Fairytaller: ナイトクラブに就職した同級生は\n運が良かったみたいです\nむしろ 暮らしぶりが良くなったとか"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: "Fairytaller: ですが こんな状況になってから\n客足が遠のいて しまって\n全員 解雇されたんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: "Fairytaller: 大学を出たばかり なんですが\n僕の専攻じゃ 職探しは大変で\n喫茶店で バイトを始めたんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: "来訪者じゃないと\n照明できますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: どうして ここに？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: "Fairytaller: こんばんは\n一人分 空きは ありませんか？\nあまり場所は取りませんから"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: "Leper: そうかい なら 仕方ねえや\n俺は行くわ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: "Leper: ありがとよ 入れてくれて\n見た目で とやかく言わなくてくれて"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: "Leper: で 中に入れてくれんのか？\nくれねえのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: "Leper: 手前のことぐらい\n手前が一番 承知してんだろ\n俺は 来訪者じゃねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: "Leper: で 中に入れてくれんのか？\nくれねえのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: 好きに言えよ'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: 何故 そうも自信が？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: "それは これから\n確かめますよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: "Leper: 何度でも言うが\n俺は来訪者じゃねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: "Leper: 「期待」ってのは どういう了見だ？\n好き好んで こうなったとでも？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: 何故 そうも自信が？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: "それは これから\n確かめますよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: "Leper: わかってるよ\nだがな 俺は 来訪者じゃねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: なにを 期待してたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: "こんな時代です\nみんな神経 尖ってますよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: "Leper: こいつは生まれつきで\nどうしようも ねえんだ\nだのに 来訪者だと決めつけやがって\nイカれてやがる"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: そうそう そういうこった'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: なにを 期待してたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: "こんな時代です\nみんな神経 尖ってますよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: "Leper: ちょっとした 伝染病患者 扱いだ\n最悪 来訪者みてえにな"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: "Leper: 生まれつき 肌がボロいだけ\nそれだけでよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: そう そいつが問題だ'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: その肌 どうしたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: どうか しました？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: "Leper: よう なんだ こんな ナリでも\n入れちゃもらえねえかな？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: へへへ'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: "Nervous: キミの なれの果て 見物だね\nよおく 覚えておくよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: "Nervous: キミも 一緒なんだ\nあの白衣の拷問魔どもと"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: イカレポンチだって？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: "Nervous: じゃあ キミも ボクのこと\n出来損ないだと？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: "Nervous: こんな てんてこ舞い\nやり過ごせる場所 やっと見つかった"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: 最高だあ！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: "Nervous: それに 近所で銃声がしてさあ\nキミなら もっと安全に\n注意して くれるよねえ？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: "Nervous: 今は がんばってるんだ\n新しい人と カチッと ハマるのを"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: "Nervous: バカの一人は 当然の報いを受けたけど\nこれからは もっと用心するよ\nへへへ！"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: "Nervous: 学校の頃から あれこれ\nバカどもに バカにされてさあ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: 友人？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: それなら ホテルのがマシだねえ'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: "Nervous: 一度っきり 助けてくれたんだけど\n家には戻りたくないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: だから 相手にされなくってえ'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: "Nervous: ボク うっかりできちゃった子供でねえ\n誰にも望まれず 生まれてきたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: 友人は いないのですか？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: "親戚のところへ\n行ってはどうです？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: "Nervous: この話 また今度ね\nへへへ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: "Nervous: ホテルの部屋 ちいっちゃくて\n思い出しちゃうんだ 悪いこと"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: "Nervous: この家 すうっごく広いから\nどんな形でも大きさでも ばっちりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: "Nervous: うん ここのがマシだねえ\nひひひ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: 友人は いないのですか？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: "親戚のところへ\n行ってはどうです？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: "Nervous: FEMAが来たんだけど\nいなくなっちゃった…"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: "Nervous: 根拠はないよ なあんにもない\nでも 思うんだあ…\nあの子 来訪者だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: "Nervous: その子 怖いんだあ\nへへへ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: "Nervous: あそこにはねえ\n黄色い雨ガッパの娘がいてさあ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: "Nervous: イヤだよお\n別のところ 見つけたいんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: ここのほうが マシだと？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: "何故です？\n戻れば いいのでは？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: "Nervous: でも 戻るのが 怖くてねえ\nここ いさせて もらえないかなあ？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: "Nervous: ホープホテルに泊まっててねえ\n散歩でも しよっかなって"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: "Nervous: ごめんねえ\nなんだか ちょっと緊張してるみたい"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: "Nervous: やっ\nへへへ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: "Bald: 外には気を付けたまえよ\nこの三文芝居を\n君が やり遂げんことを祈る"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: "Bald: 承知したよ ご友人\n全部 承知しているとも\n恨みはしない"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: "Bald: 後で 来たまえよ\nとんでもない話が 山ほどあるんだ\nブッ飛ぶこと 間違いなしだとも！\n"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: "Bald: 嗚呼 ご友人\n君は命の恩人だ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: "Bald: ともあれ 重荷には なるまいよ\nなんでも語ろうとも\n入れてくれないか ご友人"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: "Bald: 私を守ろうとして\nなにも告げずじまいだった"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: 母が追われていてね'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: "Bald: おっと ご友人\n私のことじゃないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: "Bald: それに この太陽だ\n一切合切 悪化の一途だね"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: "Bald: それが 今じゃ 誰にも連絡つかない\n皆 自分事で手一杯なんだろうな"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: "Bald: 気のいい連中だったよ\nいつも手を貸してくれたり\n泊めてくれたり ごちそうしてくれたり"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: "Bald: 芝居仲間さ\n共に飲み 共に遊び\n互いを支えあってたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: "つまり 債権業者に\n追われていると？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: "どんな友人関係\nなんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: "Bald: 母と祖母と共に暮らしていたんだが\n取り立て屋に追い出されて しまってね\nまったく 弱り目に祟り目とは\nこのことだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: "Bald: 友人には事欠かない ものとばかり\n皆で一致団結できると ものだと\nだが ご覧のとおりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: "Bald: しばし 滞在させてもらっても？\n他の家は留守だったり\n追い出されてしまったり\n皆目見当も つかなくてね"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: やあ ご友人！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: …クソ野郎'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: ほんと…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: "Tough: ふん\nそんなこと だろうと思ってた"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: 違う？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: これって 試してんの？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: また 話そう'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: "Tough: なあ 光栄だよ\n今 ここに いられるなんて\n人生が メチャクチャになりかけてる\nこの瞬間に"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: よし！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: "Tough: 人生ってのは 逆風に進むモンだろ\n順風満帆なんて あるもんか"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: 戦わなきゃ 生き残れない'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: "Tough: ただ 座り込んで成り行きに任せてたら\n人類は オシマイだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: "Tough: ああ 悪かったね\n変な風に 聞こえたなら"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: "Tough: 人類は もっと酷いことだって\n乗り越えて きたんだ\nこの程度で 諦められるか って？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: でも 絶望なんて してないよ'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: "Tough: ああ ここ来た理由？\nははっ どうだかね\nアタシも イカれてんのかも"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: えっ？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: "イカれた話に\n聞こえますが"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: あなたも絶望を？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: "Tough: 生き残ろう\nどんな手を使ってでも"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: "Tough: こんな場所 素通り できるもんか\nそれに 同じ方を向いてるよ\nアンタとアタシ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: "Tough: 来訪者に 自分のモン\nなすがままにさせてない\n命をね"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: "Tough: ここで 生き延びるのは\nたやすくない ってこと"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: "イカれた話に\n聞こえますが"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: あなたも絶望を？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: "Tough: でも アンタは違う\nアンタは 戦わず 折れたりしてない"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: "Tough: 自ら 手を下す ヤツもいる\n手をこまねいて 死んでく ヤツもいる"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: "Tough: ほとんどの連中は すっかり諦めてる\n生きるには弱すぎんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: うん マジで'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: "私の家は どんな風に\n噂されてるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: どうも？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: でも アタシは尊敬してる'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: "Tough: ここに来るのは\n絶望してるヤツか…ただのマヌケ"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: "Tough: 大抵の連中は アンタんチ\n避けてる"
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: アンタのこと 聞いてるよ'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: "Jacket: これ {0}\n大したものじゃないけど\n役立つはずだから…"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: どうも ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: "Jacket: おっと…すまない\n{0} がいるのか\nああいう人 信用できなくてさ…"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: "Jacket: よければ\n{0} がある\nこれで どうかな？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: "Jacket: 巡回に見つかりたくないんだ\n来訪者なんて もっとイヤだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: "Jacket: 頼む\nどうか 入れてほしい"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: "Jacket: これ {0}\n大したものじゃないけど\n役立つはずだから…"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: どうも ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: 行きたくないんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: "Jacket: でも 感染者は隔離区域 行き って\n噂されてて…"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: "Jacket: あいつら 当然やってきて\n全員 検査が必要だ って"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: FEMAが…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: "Jacket: 隔離区域に送られるのだけは\n絶対にイヤなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: "Jacket: あいつら 人を連れ去りはじめて\nそれで オレ…"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: FEMAが…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: 寮で なにが？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: 何故ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: "Jacket: 大学の寮に住んでたんだけど\n出なきゃならなくって…"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: "Jacket: ああ\n入れてもらえるかな よければ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: 寮で なにが？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: 何故ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: 寮には もう 戻れないし…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: "Jacket: ああ\n泊まる場所が必要で\n他に行くところもなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: 避難先探しですか？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: なんの用です？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: "Jacket: こんばんは\n中に入れてもらえないか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: 話せるじゃねぇか ニイちゃん'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: "Experienced: ほら {0} な\nあの手のヤカラ 見たことあるぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: "Experienced: なぁ ニイちゃん\nずいぶん タチ悪ぃ ヤツがいるぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: あばよ バカ野郎'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: よしよし 楽しいヤツだな'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: 話せるじゃねぇか ニイちゃん'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: "Experienced: まぁいい 長話は充分だろ\n泊めてくれねぇか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: "Experienced: 金もねぇし\n女房は別のアホと ヨロシクやってるし\n潜り込む屋根なんざ ありゃしねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: "Experienced: カレンダーの日付が来たら\n門から蹴り出される それだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: "Experienced: 残りたかったさ\nでも 誰が取り合ってくれんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: "Experienced: まぁいい 長話は充分だろ\n泊めてくれねぇか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: "Experienced: 辺鄙な場所で チンピラも寄りつかねぇ\nカタい穴場だ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: "Experienced: そんで ここを見つけたって寸法\n片付いてて 静かで 地図にも載ってねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: "Experienced: 金もねぇし\n女房は別のアホと ヨロシクやってるし\n潜り込む屋根なんざ ありゃしねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: 行く宛がねぇんだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: "何故 刑務所に\n残らなかったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: "それで なんでまた\nわざわざ ウチに？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: それで 路上生活に逆戻り ってワケだ'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: "Experienced: そしたらよ 世界中 地獄絵図だ\n太陽が タマまで炒めようとしやがる"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: "Experienced: もっと長居したかったんだが\n追い出されちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: 何度も 入ったよ ニイちゃん'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: "何故 刑務所に\n残らなかったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: "それで なんでまた\nわざわざ ウチに？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: "Experienced: オレなら あれこれ転々とな\n門くぐって シャバ出た瞬間\nなにもかも 脱ぎ捨ててやった\nやっと 呼吸できんぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: "Experienced: 雪景色 歩くみてぇな ナリして\n道化の集まりだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: "Experienced: 見りゃわかんだろ\n地獄の釜より熱いんだぜ\nアホども まだ気づいちゃいねぇらしい"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: どこから 湧いて出た？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: "何故 パンツ一丁で\nうろついてるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: "Experienced: よぉ ニイちゃん\n泊めてくれねぇか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: お前がダメでも 他がいるだろうよ'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: クソッタレ'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: ギターなしじゃ 締まんねえけどな…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: よし ロックだな！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: "Rocker: ああ {0}\nあいつだ\n追い出してくれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: "Rocker: おいおい あんなクソ野郎と\n同じ肥溜めに浸かるなんざ\nカンベンしろよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: "Rocker: どっか ダチのとこ 泊めてもらうわ\n連中 首くくってなきゃ いいんだが…"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: "Rocker: わかったよ ダチ公\n気 悪くすんな"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: "Rocker: イヤか？\nまあ お前の家だしな！"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: "Rocker: 助かるぜ\nたまに曲かけるから 気に入るといいな\nギターが手に入ったら 一曲弾いてやる"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: "Rocker: それによ 俺が来訪者なら とっくに\nドア蹴破るか 窓から忍び込んでる\nでもよ こうしてんだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: "Rocker: 俺のギターまでブチ壊しやがった\nあのクソ野郎ども\nこんなクソ地獄じゃ 誰だって\nケダモノになっちまうだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: "Rocker: 夜明けまで 飲んだくれてたんだが\nアホどもが寄ってきて\n機材をパクりだしやがってな"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: そりゃ 寝てねえからな'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: "Rocker: 近くで来訪者が見つかったみてえで\n一人残らず 厳しく検査されてんだ\n俺は別に 構わねえけどな\n連中がイカれてなけりゃ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: "Rocker: ヤベえ ブツじゃねえよ\nミニアンプと水が何本かだけ\nギター弾きてえなら アンプ貸すぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: "一週間は寝てないような\n顔してますが？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: なにを持ってるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: "Rocker: どこも すっかり ムチャクチャだろ\nライブハウスが 客でギッシリ\n収拾つかねえとき みてえに！"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: よし 居候だ'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: "Rocker: 何泊か 寝かせてくれねえか\n永住する つもりはねえから\n俺は なんて言うかな…ふむ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: "Rocker: よう 開けてくれよ\n太陽が リハ用の照明みてえに\nカンカン照りで 失明しちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: "Unstable: 近づいてみようかな\n面白そうだし"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: "Unstable: で しまいには みんな まとめて\n焚火に くべるんだとさ！"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: "Unstable: 噂 耳にしたんだ\nイカれた連中がいて\n人を集めて 洗脳してるんだって"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: "Unstable: いいさ\n他のとこ 見てくるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: "Unstable: つまんないの\nどこも変わんないね"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: じゃっ またな'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: どんだけ ボッたくってんだか'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: "Unstable: 空気売ってる奴がいるって 聞いてさ\nヤバくね？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: "Unstable: いいっていいって\n別のとこ 回るからさ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: "Unstable: まっ いっか\nその分 あれこれ話すからさ！"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: "Unstable: ごめんごめん\nウケるかな ってさ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: "Unstable: はははっ\n本当は 誰だか 知らないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: "Unstable: なにもかも パアに なっちゃう\nうん よしとくよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: "Unstable: あまり好きじゃないんだよな\nああいう手合いの前で 話すのって\nすぐ話 好き勝手 ねじ曲げるじゃん"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: "Unstable: うおっと\nもう いるじゃん\n{0} がさ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: "Unstable: ほら {0}\nどうだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: それか…これとかな'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: "Unstable: エナジェカ 好きかい？\nいや 他にも あるぜ！"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: "Unstable: つれないね\nちょっと待ってくれ\n色々 持ってるから"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: "Unstable: こっちもネタは あるんだ\nだべろうぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: "Unstable: じゃっ そっちも頼むぜ\nここらで なにが起きてるかさ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: おっ 最高！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: "Unstable: とにかく\n玄関先で立ち話も くたびれてきた\n入れてくれたら もっと あれこれ話すよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: "Unstable: 利口とは言えないだろ\nぶっちゃけさ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: "Unstable: パニクって 誰にも心 開かないか\n誰彼構わず 撃ちまくるか"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: "Unstable: 面白いとこも あったけど\n大抵は退屈"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: "Unstable: 言ったろ 見学してんの\nみんな どう生き延びてるか"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: 話 聞いてないな'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: 入れてくんない？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: "Unstable: つっても\nアンタのとこも 面白そうじゃん"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: "Unstable: 走り続けるよ\nなにか 面白いもの 見つかるまで"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: また 走るさ'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: なにか から逃げてます？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: その先は？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: "Unstable: 生き残る秘訣 交換しよっか\nへへっ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: "Unstable: でもさ 俺だって死んでないんだぜ！\n要は 二人とも 正しい ってことじゃん"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: "Unstable: まあ うん 生きてはいるか\n返事して くれてるしね"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: "Unstable: じゃあ アンタ 家にいるけど\nそれで無事？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: なにか から逃げてます？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: その先は？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: 真っ平 ゴメンだ'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: 一人ぼっちで'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: ただ死ぬだけ'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: "Unstable: アパートに引きこもってたら\n知る由もなかったろうさ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: "Unstable: ひょっとして アンタ\n人類最後の切り札 隠し持ってたり？\n家の中とかさ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: "Unstable: うろつくほうが なにか見つかる って\nだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: どういう意味？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: 厄介事からは逃げ切れませんよ
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: "安全な場所に\n避難しないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: "Unstable: 動くのは夜にしてる\nだからさ 丸焼きになる前には\nどっか着くって"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: "Unstable: 溜め込んでんだ マジ 山ほど\n隠し場所は訊かないでくれよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: 相棒のエナジェカが ついてるって'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: 厄介事からは逃げ切れませんよ
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: "安全な場所に\n避難しないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: "Unstable: 俺は燃え尽きるまで 走るよ\nそれか 来訪者にパクッと やられるまで\nどっちが先かな"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: "Unstable: 嵐が来てるから\nみんな どうすんのか\nちょっとワクワクすんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: "Unstable: どっか遠くさ\n同じとこ ジッとしてらんなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: "充電できるものなんて\nウチには ありませんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: "充電したら\nどこへ行くんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: "Unstable: 今バキバキにキマってんだけどさ\nでもエナジェカ 効かなくって\nもう充電切れ寸前"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: "Unstable: おっ！来た来た\nいいじゃんいいじゃん"
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: イントロをスキップ
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: "TV: 来訪者の疑いがある人を即座に\n隔離区域へ移送できない場合は\n出頭通知書を発行してください"
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: "MushroomEater: どうやら 祭が来るのは\n止められんようじゃ…"
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: "MushroomEater: いかん 坊主…\nこりゃ いかんぞ…"
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: 一人じゃない
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: 一人だ
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: 家に一人？'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: よし…'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: "SuperFake: それで なにが残るの？\n今や 一人きり なのに\n家族一人いないのに"
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: "SuperFake: なんで そんなに緊張してるの？\nそんなに必死に命に しがみついて"
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: 余生を味わうんだな'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: "Vigilante: もう二度と会うことはない\nやることは やったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: ここは片付いた'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: "Vigilante: 耳だと？\nふざけてるのか！？\n耳なんて来訪者の徴候にならん！"
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: "Vigilante: 耳だと？\nふざけてるのか！？\n耳なんて来訪者の徴候にならん！"
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: 手を見せろ'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: さらばだ'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: "CultistPriest: 重畳\nそれが汝の選びし道ならば\n遅かれ速かれ 大いなる死は\n代償を求め給う"
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: "ずっと安寧を求めてました…\n付き従います"
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: "死に急ぎたいなら ご自由に\n私は ここに残ります"
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: "CultistPriest: 我が儀式に加わり 安寧を見出すが良い\n如何に？\n大いなる死へと至る聖なる行進に\n加わらんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: "CultistPriest: 感謝の印に\n救済を授けることもできよう…"
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: "Gasmask: ではこれで\nさようなら"
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: "Gasmask: 大変ですね\nあなたにとっても 我々にとっても\n人のいない区域を どう検査すれば？"
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: 一人きりですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: 今どきの若いモンときたら…'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: "MushroomEater: おお…\n時間のムダだったの かもしれん…"
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: "MushroomEater: おやおや 坊主\nどうじゃ ワシの頼み 忘れたのか？\nスマイルガイドに忍ばしたヒントに\n気付かんかったか？"
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: "Fanatic: {0}だ 中に入れな\nそしたら この太陽様 御自らの寛大なる\n祝福を直々に授かれんだぞ\nもう気が変わっただろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: "Fanatic: こいつは太陽様\n御自らの寛大なる祝福だ！\nお前に値するぜ ほらよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: "Jacob: そして 君と私は…\nまた 巡り会う"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: "Jacob: だが 私は死なない\n決して"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: "Jacob: 死に瀕している人間を放り出すのは？\n不正解だ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: では 一つ勉強だ'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: "Jacob: なぜならば 君と私は…\n不死なのだから"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: "Jacob: 君のような人物が 生き残るのだろう\nこの悪夢を"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: "Jacob: こんな世の中だ\n耳を傾けてくれる相手は多くない"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: "Jacob: 来訪者が どこから来たのか\n私は知っている"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: それと 洗いざらい打ち明けよう'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: "Jacob: 誓う\nFEMAが立ち去れば すぐに\nまた娘を探しに行く"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: "Jacob: 他の人間に気付かれることを\n政府は良しとしていない"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: "Jacob: FEMAに追われているんだ\n知りすぎてしまった…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: "Jacob: 数日でいいんだ\n匿ってくれないか"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: 待ってくれ！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: "Jacob: 来訪者が どこから来たのか\n私は知っている"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: それと 洗いざらい打ち明けよう'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: そうしたら 私は また娘を探しに行く'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: "Jacob: 数日 泊めてくれ\nあたりからFEMAが立ち去るまで"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: "Jacob: 連中の仕業だったとして\n娘に手はだすまい\n狙いは私だ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: "Jacob: 娘を連れて行ったのは\nあの外道ども かもしれないし\nそうじゃない かもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: "Jacob: うん 私は連中を知りすぎている\nそれで追われているんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: 遙か彼方だ 要するに'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: FEMAの手が届かない場所に'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: "ここには いません\nでは"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: どこへ行こうと？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: 見つけたら すぐに この街を出る'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: どこにいるのか 見当も つかない'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: "Jacob: この混乱が始まってから\nずっと探してるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: 娘に そんな言い方 よしてくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: "ここには いません\nでは"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: どこへ行こうと？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: "Jacob: 手紙も 跡形もなく\n娘は消えてしまった"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: 目覚めたら 家は もぬけの殻だった'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: "Jacob: 異常な熱波にやられて\n倒れてしまって…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: 二人で街を出るはず だったのに…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: "Jacob: この騒動が始まってから\nずっと見つからない"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: その子は私の娘なんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: 売春宿なら別の通りです
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: そういう人は いませんね
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: "Jacob: 紫髪でポンチョ羽織った女の子\nここにいないか？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: やあ'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: 家 間違えた'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: ごめん'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: "StaticBoy: 臭いが違う\n声も違う"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: 家 間違えた'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: ごめん'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: "StaticBoy: 臭いが違う\n声も違う"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: 家を探すの手伝おうか？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: なにを探してるの？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: でも 親って必要…？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: "StaticBoy: いないよ\nはじめから"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: 親？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: 家を探すの手伝おうか？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: なにを探してるの？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: "StaticBoy: 床が軋む音がしたんだ\n誰か待ってる"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: "StaticBoy: 台所の灯りが いるんだ\nでも ここじゃ…響きが違う"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: "StaticBoy: 暗闇じゃ\nどの扉も同じに見える"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: 親はどこ？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: 迷子？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: そんなはず…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: アイツ 眠ってないの？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: "CultistPriest: が同胞を見守れ\n忘れるな 一人でも死すれば…\n汝の家は無に帰すだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: "CultistPriest: また会わん\n同胞の様子を確かめにな"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: 選択の余地が あると思うか？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: "CultistPriest: また会わん\n同胞の様子を確かめにな"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: "CultistPriest: 長き時は要すまいが\nされど 見守ってくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: 感謝する'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: かの者は 我が使命の妨げとなっている'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: {0}…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: {0}…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: "CultistPriest: 重畳\nされど まずは汝の民を退けねばならぬ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: 良い夜を…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: "Courier: ほら 注文の品だ\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: "Courier: さあ 受け取ってくれ\nオレは行くよ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: "Courier: こんなクソ もうウンザリだ\nなにもかも 終わってくれ…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: こんな惨状…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: "Courier: FEMA職員に銃口 突きつけられる\n果てしない朝の検査…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: "Courier: 疲れ果てて\n険しく 苦しい顔ばかり目に入る…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: "Courier: 配達員やって気を紛らわせてる って\n言ったろ？\nもう効かなく なってきててな"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: はぁ…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: "Courier: ほら 受け取ってくれ\nこっちまで撃たれる前に行くから"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: "Courier: ああ なるほど…\nアンタ 友達が死んで 良かった って\n言うんだな？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: すみません
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: 他に道は ありません
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: "Courier: ほら 注文の品だ\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: "Courier: ほら もういいだろ\n注文を受け取ってくれ オレは行くから"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: "Courier: チッ 助言ありがとよ\nマジ助けになった"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: "Courier: よし オレは行くよ\n注文を受け取ってくれ 出発する"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: "Courier: お次は 陰毛が来訪者の徴候だとか\n言い出す だろうよ\n世界は完全にイカれてる…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: "Courier: もう これ以下は ないと思ってた\nなのに 日に日に より狂っていく"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: 来訪者だの 徴候だの クソ太陽だの…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: "Courier: 大丈夫だって？\nこんな大惨事で なにが「大丈夫」だ？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: "男らしくして生き延びましょう\n負け犬みたいに泣き言を吐かず"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: "気に病まないでください\n大丈夫ですよ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: "Courier: ほら 注文の品だ\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: "Courier: よし 注文を渡す番だ\n受け取るだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: "Courier: どうせ勉強したところで\n誰が雇ってくれる？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: "Courier: まあ いいんだ\n配達員も悪くない"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: "Courier: ああ そうだろうな\nアンタは家に大勢 人がいるから\nそう簡単に言えるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: それは苦労しますね
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: 一人きりも悪くないですよ
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: "Courier: それに 家族もいないしな\nオレ 出身は別で 勉強しに来たんだ\nだから 一人きりなんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: "Courier: ほら 注文の品だ\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: "Courier: おっと 悪い\n話が逸れた\n注文 受け取ってくれるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: "Courier: そのせいで 一度に二十リットルの水を\n頼むようなヤツもいる\nああ 危険手当やチップがあればな…\n重荷を運ぶ代わりに"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: "Courier: でも このクソ太陽のせいで…\n夜勤に回されたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: "Courier: 配達は今 いい稼ぎになるんだ\nリスクはデカいがな どう考えたって"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: "Courier: 終末だろうと なんだろうと\nメシの時間は来るもんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: "Courier: 世界の終わりに備えていないヤツが\nいるなんてな"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: "GraveDigger: {0}？\nそれでいいのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: なにが欲しいんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: "GraveDigger: って おい！\nなんか 差し出すからよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: "Marauder: おっ！見つかったぜ！\n{0} だ\nほらよ 大家さん\n頼むから 朝まで休ませてくれよ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: "Marauder: よし ナイフは必要だな…包帯もだ…\nんん ボロのフラスコもあるが\n空っぽか…役に立たねえな"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: "Marauder: おっと なあ 追い出さないでくれよ…\n先に カバンの中 漁らせてくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: "Wolfhound: 今は力が 物を言う\n転がすか 転がされるか"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: 賢い判断だ'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: "なんとかします\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: ここを維持したいなら 追い出せ'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: "Wolfhound: {0} か\nあいつが ここを温めてるのか？\n鼻が利くぞ 羊の皮を被った狼だ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: "Twins: {0}\nどうぞ 受け取ってください\n役に立つかもしれません"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: "Twins: それなら…\nこれで考え直して もらえませんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: "Twins: ええ…わかります\n私たちを知らないのですから\n面倒事を持ち込むと思うのも\nですが 妹が本当に大変な時期なんです"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: "Twins: 二人とも 思い出させるんです…\n両親を…\n妹にとって 良くない環境です"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: "Twins: 心配です…\nあの人たちがいると 妹が苦しむだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: "Twins: {0} と\n{1} が\nもう家に いるんですね"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: うまくやっていける気がしないんです
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: "その 夫と知り合う前…\nあの…昔 知っていた誰かを\n思い出してしまって"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: "きっと大変になります\nあの人と 一つ屋根の下に暮らすのは…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: "{0}\nあの人が もういるようですね"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: "Twins: 今 妹に必要なのは\n裁きじゃありません\n平穏と…思いやり なんです"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: "Twins: あの人の裁くような言葉で\n妹が溺れてしまう気がします"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: "Twins: {0}\nあの人が もういるのが気にかかって"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: "Greatmother: へっ そうでねぇと！\n言ったろ あいつ残してちゃぁ\n厄介ん種 なるってさ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: "Greatmother: 追い出しちまおうよ\nそしたら 座っからよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: "Greatmother: いんや あいつたぁ\nうまく いかねぇんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: "Greatmother: おんやぁ…\n誰ぞ座っとる思たら\n{0}\nこんなとこで 会うたぁなぁ！"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: "Widow: ありがとう…長居はしません…\n一息つかせてもらえれば\nそれで充分なんです…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: あんな人と同じ家なんてムリ'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: イヤ'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: "Widow: {0}\nあの人が ここに？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: "Widow: 助けてくれて ありがとう\nただ…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: 興味あるかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: "Luka: {0}\nなんて どうだい"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: "Luka: アンタの力になりたいんだ\nいるものが あるなら 言ってくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: "Couple: どうだい？\n助けてもらえないかな？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: "Couple: {0} ？\n私の持ち物なら 全部 差し出すよ\n奥さんが少しでも休めるなら\n構うものか"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: 渡せるものが あるんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: そういえば…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: "Couple: 心から愛しているんだ\n最後のシャツだって差し出す"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: "Couple: 奥さんは あまり強くなくてね\nすぐ疲れてしまう\n私の方は…\n奥さんのためなら なんだってするさ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: "Couple: どうか しつこく感じないでもらいたい\n私たちの立場になって考えてほしい"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: "Wheelchair: 見ろよ この脚が生きた証拠だ！\nなんも ねえだろ？\nハハッ！"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: 絶対 うまくいく！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: "Wheelchair: 入れねえだと？解決してやるよ！\nほら {0}\n掴んで軒先に ぶん投げな\nバンッ！これでアンタは見えなくなる"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: "Dude: おっ！{0}！\nゲームみてぇじゃねぇか 兄弟\n好感度上げってヤツだ 知ってんぜ！"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: "Dude: よし ちょっと待てよ\nなんか あんだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: カンベンしろよ 兄弟…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: "Blind: {0} だろう\n受け取ってくれ\nせめて一日は 休まなければ\nだが…望み薄か…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: "Blind: …なにか持っていたはずだ\n待ってくれ…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: "Fatman: へっ どうだ？\nちょっとは気分 良くなったか？\nこれでチャラだぞ？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: "Fatman: ちょっとしたモンを やるよ…俺からな\n{0} だ！"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: "Fatman: よし\n知ってんだ…効くヤツを"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: "Bestson: それと…ガムもあるよ\nもう数枚しか残ってないけど\nでも あげる…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: "Bestson: もしかして なにか ほしいの？\n{0} とか？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: "Bestson: どうしたらいいのか…\nわかんないよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: "Fugitive: 頼む…\nここで死にたかねぇんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: "Fugitive: なあ 有り金 全部やるよ\nほら {0} で どうだ？\n道すがら拾ったんだ\n他には なんもねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: "Fugitive: 今すぐだ クソッ\n玄関先で失血死するか…\n中へ入れて手当するかだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: "Wifefema: もういい くたばっちまいな\n近所の連中に話してやるから\nじゃあね ド低脳"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: "Wifefema: 一体 なにが問題なんだい？\nアタシは本気で話してんのに\nアンタは踏みにじるだけ？"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: "Wifefema: 本気かい？\nダンナはFEMAで働いてんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: 賄賂は結構です
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: "いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: "Wifefema: どっちが安くつくか\nよく考えな"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: "Wifefema: 嫌だって？ダンナに一つ言ってやるよ\n明日には黄色い防護服の連中が来て\n突発の掃討だ…\n書類に犬に…毎朝ね"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: "Wifefema: 手短にいこうか\n前払いで {0}\nそれで入れてよ ふん"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: "Wifefema: ねえ アタシ 結構 鼻が利くんだ\n人間だろうが来訪者だろうが\n嗅ぎ分けるのが一等 得意でね"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: "やっと ここなら\n少しは眠れるといいんだが"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: "夢で あいつを見たんだ\n本当だ もう充分だ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: ここに二人分の居場所はない
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: "ありがとう\nだが…誰かに場所を取れているようだ\n{0} だ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: じゃあな'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: オレだって なんで まだ着てんだか'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: この防護服 恐ろしいもんな'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: ああ 了解'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: "FormerFema: 本当に入れてくれるとは\n思ってもみなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: 本当か？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: "FormerFema: あの人さえ どかして くれれば\n誓って 静かにするし 誰の邪魔もしない"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: "FormerFema: なあ クソ防護服を一日中 着てて…\n脱いで 汚れを洗い流したいんだ…\n他人の血を含めて"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: "FormerFema: おっ おい…\n浴室に いるじゃないか…\n{0} が"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: いや 待ってくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: "FormerFema: えっ？\nああ ありがとう"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: おおっ ありがとよ ダンナ！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: "GraveDigger: 入りてえのは山々なんだが…\nまあ わかんだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: "GraveDigger: おおっと もう中に いんじゃねえか\n{0} が"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: まっ…試す価値は あったか
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: "ちぇっ\nたまには一息つけると思ったのによ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: へへっ やるじゃねえか
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: "誰だって？ ほら見えるだろ\nあの {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: "おっと なんだよ\n居心地よさそうな場所\nもう先客が いるじゃねえか"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: "Provocateur: 賃貸条件の詳細については\n後ほど協議いたしましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: ありがとうございます 家主様'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: "Provocateur: 憲法 第28条 第48条 第7条 第3項の\n意味を理解していますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: "Provocateur: この人物が 明白な法令違反者\nであることを ご存じですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: "Provocateur: ふむ…こちらには すでに\nどなたかが住んでいるようですね\n{0} ですか"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: "TaxiDriver: アンタの気持ちは わかるよ まぁ\nでもよ キツいな…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: "TaxiDriver: なぁ その また会ったらよ\n話そうぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: "TaxiDriver: ふぅ ありがとよ あぁ\n本当に助かる！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: "TaxiDriver: とにかく 選んでくれ…\nアイツか オレかだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: "TaxiDriver: そいつ オレの家族を追ってきた連中の\n一人に似ててよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: "TaxiDriver: なぁ 誤解しねえでくれよ\nでも アンタのとこにいるだろ？\n{0} が"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: "Edgar: 僕の体は残しておいて ください\nその時が来たら"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: "Edgar: 貴方が僕と同じように\n美を見ているのか まだ わかりません\nですが 教えてください…\n遺体を捨ては しませんよね？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: "Edgar: そして僕は 終わりゆく日の静寂に\n耳を澄ませに来たのです"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: "Edgar: 中に入りたいのですが…もう いますね\n{0} が\nあの人は まだ明日への思いに\n縋っています"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: （男は頷き 中へ入る）'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: "Foreigner: （{0} が気になるようだ\n男を指さし 自分を指さし\nまた男を指さす）"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: んほくる ゆほくる'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: "Doctor: 運が良ければ 近くにおるだろう\n助けが必要なら\n遠慮せず声を かけとくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: "Doctor: わかっとるよ\n誰を信じるのも難しい時代よな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: "Doctor: ありがとう\n誰かの助けになれるといいが"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: "Doctor: きちんと助けになる者を\n探したほうがいい"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: "Doctor: 儂では\n充分な看護はできん"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: "Doctor: ふむ\n{0} が おるな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: "NotTrue: ちょっと骨を休めてから\nまたアタシの道を 行くとするさね"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: "NotTrue: おや 若いの そうかいそうかい\nなら 婆に腰掛けを一つ\n持って来てくれるかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: "NotTrue: おや ありがたいねえ！\n婆の骨を救ってくれたよ！\n追い出させちまって気の毒だけど…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: "NotTrue: それなら アタシは玄関先で腰を下ろし\n息を整え 行くとするさね\nああいう相手と一緒じゃねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: "NotTrue: ああいう同居人がいるんじゃ\n簡単じゃないねえ 坊や"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: "NotTrue: おやまあ！\n{0} じゃないか\nあそこで 椅子に座ってるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: ヤダァァァァ…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: こわいよおおおおおぉぉぉぉぉ…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: だぁれも 知らないのにいいぃぃ…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: どこに行けば いいのおおおぉぉぉ？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: "Daughter: お父さあああああぁぁぁぁぁん！\nお父さあああああぁぁぁぁぁん！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: 帰って
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: "向こうは追い出すよ\n入って"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: "Daughter: 会いたいよ…\nお父さあああぁぁぁん…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: "Daughter: でも…でも あそこがいいの！\nあそこ あそこ あそこがいいの！\nだって…お父さんがいたとこだから…\nお父さん そう言ってたもん"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: {0} がいる'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: "Daughter: わっ…わたしの…\n居場所がない！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: "Scammer: 構うもんか\nオイラは他のカモを探すとするよ\nバカならゴロゴロいるんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: "Scammer: チッ ホント無粋だね\nまあ いいさ ハナっから\nウマが合わない気がしてたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: "Scammer: ニイさん イケるクチじゃないか\nよし ヒマなとき寄ってくれよ\n話したいネタがあるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: "Scammer: 蹴り出そうや\nそれで話はすむだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: "Scammer: オイオイ\n{0} とはね\nあんなミソッカスからは\nカネも面白いネタも出てきやしないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: "Cold: ああ…ここから遠くへ…\n誰からも彼方で…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: "Cold: よし 行くとするよ\n太陽が少しは温めてくれるかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: わかった'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: "Cold: ありがとう\n信じてほしい このほうが安全だ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: "Cold: その…誰かと同じ部屋が怖くて\nたまに…良くないことが起きる\n今までも ずっとそうだった"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: "Cold: ありがとう\nおっと そこは埋まってるんだな\n{0} がいる\n入るのは よしとくよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: "Esenin: なら クソ食らえ\nどうせ君も\n禁酒主義のイカれ野郎なんだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: "Esenin: よし\n一つぐらいは思いどおりになったな\n案内してくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: "Esenin: ああいう輩は 酒場でも真っ先に\n叩き出されたものだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: "Esenin: {0}\nまず あいつを追い出してくれ\n話は それからだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: "Anxiety: わかりました はは…\nいいんです 私が行きますから\nまあ どうせ太陽にみんな殺されます\nみんな死ぬんです…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: "Anxiety: ありがとうございます\nじっと座ってますから\nドアは閉めないでくださいね？\nはは…念のため…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: "Anxiety: えっと その…\n出て行かせて もらえませんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: "Anxiety: お願いします\nあの人を検査するか…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: "Anxiety: いっ…一緒はムリです\nあの人が来訪者だったら？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: "Anxiety: あっ あそこ もう…\n{0} が"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: "Hunter: いい判断だ 少なくとも俺は\nやるべきことを承知している\n手を貸すぞ…奴が現れたら\n"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: "Hunter: アイツの手から 血の臭いがする\nどうして中に入れた\n命を張るのが好きなのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: "Hunter: 既に いるな\n{0} が"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: "Fanatic: オレは他のヤツを救いに行ってやる\nお前はそこで朽ち果ててろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: "Fanatic: 光に…いや啓蒙に対して\nドアを閉じるなんざ罰当たりめ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: なら くたばっちまえ！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: "Fanatic: ここで一休みさせて…\nオエエェェップ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: "Fanatic: おぉぉ 眩いじゃねえか！\n偉大なる太陽の祝福を受けな\nお前を見守ってくれるはずだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: "Fanatic: アイツの影…いや 異端者自身が\n正義の光を遮ってやがる！\n追放しねえと！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: "Fanatic: オイ！\n太陽様の啓示が閃いたぞ\n{0}\nアイツが潜んでる間は入るなとさ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: "FortuneTeller: 純粋な気の力線が\nお前さんの家を真っ直ぐ貫いてるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: "FortuneTeller: やるじゃないか\n率直に言って ここらじゃ稀な\n形而上的資源を帯びてるね お前さん"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: "FortuneTeller: 追い出すことだね\nさもないと 星が並んで災厄を呼ぶよ\nわかるだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: "FortuneTeller: {0}\n心当たり あるかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: "FortuneTeller: ああ…感じるよ…\nこの濃厚で 重苦しいオーラ\n影だね…強すぎて全員 破滅するよ\n家中 毒まみれになってさ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: 気をつけなよ？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: "Luka: その先に待ってるのは…真っ暗闇だ\nあっという間にな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: "Luka: あんまり 死ぬこと考えすぎると\n徐々に蝕まれちまうぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: 悲しみに埋もれないでくれよ'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: "Luka: そうすれば…死ぬことばかり考えずに\nすむかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: "Luka: アンタが喜びを感じてた頃を\nどうか思い出してくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: "Luka: 少しだけでも 場所を分けてくれたら\n大助かりだけど"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: "Luka: 誰かを追い出したりなんて したくない\nだって オレより その人の方が\n居場所が必要かも しれないだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: "Luka: 入りたいのは 山々なんだが\nもう先客が いるみたいだな\n{0} が"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: "Couple: ほら とっとと足を動かせ\n俺だって 疲れてるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: また探し回らないとね ハニー？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: "Couple: わかったよ\n迷惑かけて すまないね"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: "Couple: ずいぶん人見知りしてるね\nでも 大丈夫\nすぐ休めるからね"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: "Couple: なにを突っ立ってるんだい？\nさあ 招いてもらったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: ああ ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: "Couple: 奥さんは子供が苦手でね\nこんなに若い子がいるとは思わず"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: "Couple: その 悪いけど…\n{0} がいるなら…\nここには いられなくてね"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: それで あれは誰だい？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: ああ ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: クソッタレ'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: "Anger: アイツらのクソでも喰らいながら\n窒息するまで座ってな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: "Anger: クソッ\nアンタも他の腰抜けどもと同じかよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: "Anger: オレが手を出すのは自分だけだ\n他の誰も傷つけねえよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: 家をブッ壊したりもしねえ'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: "Anger: 心配すんな\n他のヤツには当たり散らさねえよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: "Anger: カンベンしてくれ\nあんなイカれ野郎と\n同じ屋根の下にいられるかよ\nどうかしちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: "Anger: {0} が\nいんのか ここ？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: "Mother: いやいや\nまだ間に合うはず"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: もう 手遅れかも しれないけど…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: "Mother: わかったよ\nそれなら 夫のところに いられるか\n見てくる"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: "Mother: ほら 立ってないで 入んな\n旦那さんを待たせるんじゃないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: ああ 助かったよ'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: "Mother: できれば…お願い…\nあの人 追い出してもらえない？\nこの子を ようやく安らかに\n眠らせて やれるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: "Mother: ねえ…もう いるじゃない\n{0} が\n子供は もう怯えきってるのに…\n"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: 毛玉 見て？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: "Ballerina: キミに言ったんじゃないの\n猫に言ったの"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: "Ballerina: ほら 猫ちゃん\n今度はアタシを楽しませて ね？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: "Ballerina: ううん 言われたよ\nここにいさせちゃダメだ って\nさっ 追い出して"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: "Ballerina: {0}\nいる？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: ありがとうございます'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: すみません…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: "Teacher: 思い出してしまって…\nあの人たちを…あの…子供たちに…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: "Teacher: あのような人と同じ屋根の下には\nいられません"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: "Teacher: すみませんが…\nそこにいるのは\n{0} ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: "Dude: 元気でな…\nそれと お前ぇのダチも"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: "Dude: 構わねぇさ 兄弟\nわかってっから 気にすんな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: うおおおぉぉぉい…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: "Dude: そうじゃねぇと！\n最高だぜ レジェンド！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: "Dude: なあ 追い出し ちまうおうぜ！\n雰囲気ブチ壊しだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: "Dude: クソッ アイツのせいで\n最悪のノリだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: "Dude: って おいおい…\n誰だよ その\n{0} って？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: うおおぉぉい 兄弟 マジ感謝！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: さもなくば アレに見つかる'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: "Blind: 神に誓って頼む\n暗くなったら黒焦げ死体に近づくな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: "Blind: 出ていくよ\nだが…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: 感謝する'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: 別の場所を探すとしよう'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: "Blind: すまない 説明はできない\nただ そのはずなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: "Blind: ここにいるだろう\n{0} が\nあの人は なにかが おかしい"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: "Fatman: どこへ行けってんだ？\n終わっちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: "Fatman: おい…ったく わかってんだろ\n具合が悪いんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: "Fatman: 借りなら返す…\nすべて片付いた暁にはな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: "Fatman: よくやった…\n正しい選択をしたな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: "Fatman: なんか手配してやるからよ\nなあ…あんだろ…銃…\nブッ放しちまえ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: "Fatman: チッ もういるじゃねえか\n{0} が\n追い出しちまえ！\n風呂場を奪い合う気はねえぞ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: "Buddy: 恩に着るぜ 相棒！\n命拾いしたよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: "Buddy: まあ 分けあうってのも 乙なもんだが\n犬小屋ってのは ちと窮屈だろ？\nちょいと手を貸して くれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: "Buddy: おおっと 相棒！\nその場所は 誰かがもう\n温めてるみてえだな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: "Bestson: うん…そのほうが いいのかも\n家に帰るよ\n父さんと母さんが もう帰ってるかも\nしれないし…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: "Bestson: でも…今は ここに いたほうが\nいいのかも\n安心だし"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: "Bestson: もし父さんと母さんが帰ってきて\nボクがいなかったら？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: "Bestson: ありがと！\nまだ…不安だけど"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: "Bestson: 前に一度 公園で\nああいう男の人に 襲われたんだ\nそれから二度と行ってないよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: "Bestson: {0} が\nもう ソファに いるんだね\nああいう人…その…怖くて"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: "Fugitive: せいぜいステキな夜を楽しみな\nクソ野郎"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: "Fugitive: わかったよ\nドア向こうに隠れて鍵かけとくんだな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: "Fugitive: なんだよ\nオレを探してFEMAが来るのに\nビビッてんのかよ？ふざけんなって"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: おいおい マジかよ？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: "Fugitive: アンタの隣人が\nクソッカスじゃねぇといいんだが…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: アンタ 命の恩人だ！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: "Fugitive: 言っとくけどな\nああいう手合いは一瞬で裏切るぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: "Fugitive: じっと座って 自分のことで頭一杯だ\nテメェのケツを守るときが来たら\n容赦なくアンタを売るぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: "Fugitive: ダメだ…なあ 聞いてくれ\n前にも ああいう手合いに会ったんだ\n今 アンタの家にも一人いるぜ\n{0} がな"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: "Nun: 主は このことを お忘れにならない\nすべてを見ておられるのです"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: "Nun: 私の死は 貴方の魂に\n重くのしかかるでしょう\n覚えておきなさい"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: "Nun: 見よ この愚か者を！\n救済の機会が差し伸べられて…\n拒むとは！恥を知りなさい！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: 主よ憐れみを…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: "Nun: 追放なさい 悪魔を\nさすれば祝福されん！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: "Nun: 生涯を賭しても清めがたい あの罪！\n神を畏れなさい\nあのような者と共にいるなど！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: "Nun: それで あれは誰か尋ねても？\nあの {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: "Raskolnikov: ただ…いつか僕も 殺しを学びたい\nそうすれば 自分の足で立っていられる"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: "Raskolnikov: 大事な人なんだろう\nすまない 時間を無駄にさせた"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: "Raskolnikov: ああ 申し訳ない\nそう困らせるつもりじゃ なかったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: "Raskolnikov: 君の手腕を教えてくれないか？\n来訪者の殺し方を\n恐怖を この目に見据えたいんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: "Raskolnikov: それと…もしよければ…\n検査の後で構わない…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: ありがとう 友よ'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: "Raskolnikov: 僕は…ああいう人と暮らすのは無理だ\n試したことはある\nうまく いかなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: "Raskolnikov: すまない\n無礼を働くつもりはないが\nだが もういるんだ\n{0} が"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: "Wifefema: もういい くたばっちまいな\n近所の連中に話してやるから\nじゃあね ド低脳"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: "Wifefema: 一体 なにが問題なんだい？\nアタシは本気で話してんのに\nアンタは踏みにじるだけ？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: "Wifefema: 本気かい？\nダンナはFEMAで働いてんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: あのクソたかり屋め…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: "Wifefema: 手遅れになる前に\n追い出すんだね！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: "Wifefema: ああいう手合い 知ってるよ\n最初から入れちゃダメだ\nああいうのはさ 厄介事がつきもんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: "Wifefema: なんだい\nあの {0}？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: "Theorist: さらばだ！\n君は長く もつまい！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: "Theorist: こうも たやすく真実に\n目を背けるとは なんて狭量なんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: "Theorist: 君…\n君って奴は…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: "Theorist: 「帰ってください」とは\nなんの つもりだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: "Theorist: 一度 二人で語らえば\n二度と世界を同じようには\n見られなくなるぞ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: "Theorist: よくぞ正しい選択を してくれた！\n信じてくれたまえ\n後悔させないとも"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: "Theorist: 追い出してもらえたら\n喜んで招待を受けよう！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: "Theorist: あの男がいるなら\nなにも明かすわけには いかない！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: "Theorist: あれ…あれは…\n{0} じゃないか！"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: "Theorist: ああ\n絶対にダメだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: "Theorist: だが…ちょっと待ってくれ\nあれは誰だ？"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: 嬉しく思う！'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: "BigLebowski: アンタなんかに時間使って\nバカだったよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: はぁ…いいけどさ'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: やったね！'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: "向こうは追い出します\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: "BigLebowski: おっ 今の韻踏んでた\nいいじゃん"
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: "BigLebowski: 泊まらせてくれる ってんなら\n好きなように やらせてもらうから"
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: "BigLebowski: はぁ やっぱいいよ\n{0} が いんだろ\n涼しいトコに もう"
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: クソ食らえ だよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: オヤジそっくり'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: "FatalDame: ふふ…\nあの人は そう思ってないみたいよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: "FatalDame: やがて終わりが来れば\n楽になると思う？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: そう答えると 思ってた'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: "FatalDame: 果てしない自己嫌悪と疑心暗鬼より\nマシなことで 気を紛らわせましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: "FatalDame: こんな恐怖すべてから\n一緒に逃げましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: "FatalDame: ねえ 二人で…\n特別な関係 築いてみない？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: あたしなら 助けになれる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: "FatalDame: 人と繋がるのは難しいわ\n苦しんでるのは あなた一人じゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: "FatalDame: わかるわ\n耳を傾けず 遮る人ばかりだものね\n「ああ こっちはもっと大変で…」\nなんて"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: "FatalDame: こんな時代だもの\n誰だって癒しが必要よ\n少しの優しさ 少しの愛情が"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: "FatalDame: 入れてくれたら\n互いの痛みに向き合えるかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: それに…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: "FatalDame: あたしも その気持ち わかるわ\n話したくなったら…いつでも話して"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: "FatalDame: 怒りを手放すのは難しいもの\n許しは もっと大変"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: "FatalDame: 子供時代の抑圧？\n酷いわね\nあなたが乗り越えられて嬉しい"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: "FatalDame: 入れてくれたら\n違う なにかを感じられるはず"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: "FatalDame: どんなに孤独な人でも…\n特別な愛情が必要よ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: "FatalDame: 最近 みんな世界の終わりばかりで\n頭いっぱい だけど"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: "FatalDame: あたしなら 他の人にはできないこと\nしてあげられるわ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: ふふ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: でも 無理にとは言わない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: "FatalDame: 楽になるかもしれないわ\n打ち明けてみたら"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: "人と関係を持つのが難しくて\nどうすれば いいですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: "父の死を願ってました\nこれで いいですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: 話したくないんです
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: "FatalDame: 教えて\nあたしは玄関前の ただの通りすがり\nもう二度と会わないかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: "FatalDame: それとも 子供時代のせい？\n辛い時代になったから\n記憶が ぶり返しでもした？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: "FatalDame: 来訪者に仲のいい人を殺された？\nそれで心を閉ざしたの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: "FatalDame: なにが あったの？\n最近 奥さんに出て行かれた？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: "FatalDame: すごい\n遠慮なしね？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: "人と関係を持つのが難しくて\nどうすれば いいですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: "父の死を願ってました\nこれで いいですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: 話したくないんです
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: "FatalDame: 口数 少ないのね\nあなたのこと 教えてくれる？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: "FatalDame: 最近よく言われるの\nいつもよりも"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: 気に入った？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: "FatalDame: あら 気付いたのね\nありがとう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: "見た目…\n変わってますね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: "FatalDame: 変なこと訊いたわね\nあなた ここに住んでるんだものね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: もう慣れた？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: 新生活は どう？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: 正直 写真なんざ興味はない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: "Vigilante: 問題なさそうだ\n埋めてきた裏切り者のうち\n半数は そうだったがな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: また その馬鹿げた真似か？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: "Vigilante: 失せろ\n脇なんざ嗅ぐものか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: "Vigilante: 何か生えてるなら\n知りたくないもんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: ふざけてるのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: "Vigilante: 見逃してやる…今はな\n下らないことに構ってる暇はない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: "Vigilante: よし\nだが安全とは限らない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: "Vigilante: 目を大きく開け\nふざけるな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: 今は時間がない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: "Vigilante: ふん…\n汚かろうが綺麗だろうが どうでもいい\n来訪者は どちらにでも化ける"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: "Vigilante: どうした さっさとしろ\n無駄に噛みつきはしない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: "Vigilante: 話は充分だ\n時間の無駄だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: "Vigilante: 油断するな\n一つ誤れば 終わりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: "Vigilante: よし 潔白そうだ\nだが 正直 違うほうが楽だった\n後々 面倒が減るからな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: "Vigilante: 口を開けろ\nもっと大きく\n俺は歯医者じゃないぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: （耳を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: （写真を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: （脇を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: （目を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: （手を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: （歯を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: "Vigilante: とにかく\n話は充分だ\n徴候を見せろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: "Vigilante: 笑って 署名しろと言いやがった\n冗談じゃない\n連中は人を連れ去って\n来訪者は そのままだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: "Vigilante: FEMAが到着し 掃除の話をした\nもう片付けた と言ってやった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: "Vigilante: まず母親を殺した\nそれから父親を\n子供は近所に逃げられた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: "Vigilante: 来訪者が屋根に登りはじめ\nその馬鹿はドアを開け 妻を逃がした\nだから俺が代わりに始末を付けた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: "Vigilante: だが母親は…徴候が出はじめていた\nそれでも男は泣き付いた\n「俺のカミさんなんだ 手を出すな！」"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: "Vigilante: 町外れに こんな家族がいた\n家をバリケードで囲い\n父親がドアを押さえていた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: "Vigilante: だが今や どうでもいい\n終わったことだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: "Vigilante: 探す意味はない 時間の無駄だ\n弟に根性があれば\nまだ望みもあったかもしれんが"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: （耳を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: （写真を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: （脇を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: （目を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: （手を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: （歯を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: "Vigilante: とにかく\n話は終わりだ\n徴候を見せろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: "Vigilante: 目は血走ってたが 生きてた\n尊敬に値する 俺の弟と違ってな\nあいつが とっとと死んでれば\n家族は生き延びたかもな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: "Vigilante: 死んだと思ったが 数日後 見つけた\n木々から誰が最初に出てきたと思う？\n娘だ\nショットガンを携えてな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: "Vigilante: その親父 家族を裏口から逃がした\n森の中へと\n俺が化け物を片付けても\n誰も帰って来なかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: "Vigilante: この間 ある家族を見た\n体格のいい父親が 踏ん張っていた\n来訪者どもが窓で喚いても"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: "Vigilante: そもそも 世界が こんな大混乱に\n陥ったのは どうしてだと思う？\nあいつみたいな臆病者のせいだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: "Vigilante: 縮こまって腑抜けになった\n今じゃ あいつの家族は埋められたか\nどこかに消えた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: "Vigilante: いつも言ってたんだ\n弟に…男になれ 家族を守れ と\nそれで どうしたと思う？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: 奥さんを探してるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: 調子どうです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: "Vigilante: 弟が腰抜けじゃなければ\nあいつの妻も子も守れたかもしれん\n今じゃ あの悪ガキの居場所も分からん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: "Vigilante: 戻ったぞ\nなんで わざわざ戻ったんだか\n自分でも分からん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: "Vigilante: こんな暇はない\nもっと大事な用がある\n戻ってくる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: "Vigilante: 次に耳なんて見せたら\nその場で叩きのめす"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: 弟のことがなければ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: "Vigilante: 耳だと？\n虚仮にしてるのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: "Vigilante: 正直言って 写真なんざどうだっていい\n処理する用は他にある\n今は生かす\n本格的な調査は後だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: "Vigilante: ふん…潔白のようだな 確かに\nだが 潔白な奴を山ほど埋めてきた\nたやすく信じると思うな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: "Vigilante: 写真だと？霊気が映るとでも？\nまあいい\n「潔白」かどうか見せてみろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: "Vigilante: 該当なし 運のいい奴だ\nとっとと脇をどけろ\nもっと おおごと抱えてるんだ\nまた戻ってくる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: "Vigilante: 問題なさそうだ\nだが それだけだ\n化け物どもは俺の目をも欺く"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: ふん…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: "Vigilante: 今じゃないがな\n他に片付ける用がある"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: "Vigilante: 今は潔白だ\nだが 次に何か見つけたら\n先に撃つ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: "Vigilante: こういう「普通」の奴が\n一晩で何やらかすか知ってるか？\n油断一つで全滅だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: "Vigilante: ふん…\n見たところ問題ないな\n最高だ まったく最高だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: "Vigilante: ほら\nその手を ちゃんと使え\n見せろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: "Vigilante: 一旦 手はもういい\n次は きちんと調べてやる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: "Vigilante: 一つ教えてやるから 覚えておけ\n普通に見える奴ほど\n真っ先に変わるものだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: "Vigilante: 潔白だな…\nああ どう見ても潔白だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: "Vigilante: チッ こんな暇はない\n確かめないと\nまたな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: "Vigilante: よし 今は生かしておく\nだが 次に何か見つけたら\n問答無用だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: "Vigilante: ふん…潔白か\n惜しいぐらいだな 実に"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: "Vigilante: よく開けろ\nさあ 躊躇するな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: （耳を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: （写真を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: （脇を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: （目を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: （手を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: （歯を見せる）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: "Vigilante: 銃持ちだろうが 知ったことか\n互いに撃ち合って死ぬだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: "Vigilante: 徴候を見せろ\nどれでもいい"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: ふむ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: "生き延びたのは娘だけです\nその人なら亡くなりました"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: "家が全焼したんです\nそれから見てません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: "Vigilante: 妻は…\n知ったことか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: "Vigilante: 子持ちで 小さな娘だ\n歳は わからん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: "Vigilante: それと…訊かせろ\nずんぐりした男を知ってるか\n青いデニムジャケットを着た奴だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: "Vigilante: 来訪者は甘い心を餌食にする\nだから誰も彼も自宅で殺される"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: "Vigilante: ならば正義執行だ\n可及的 速やかにな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: "生き延びたのは娘だけです\nその人なら亡くなりました"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: "家が全焼したんです\nそれから見てません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: "Vigilante: 妻は…\n知ったことか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: "Vigilante: 子持ちで 小さな娘だ\n歳は わからん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: "Vigilante: それと…訊かせろ\nずんぐりした男を知ってるか\n青いデニムジャケットを着た奴だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: "Vigilante: 徴候 一つで討つには充分だ\n二つ目を待ちはしない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: テレビとラジオが伝えてる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: "Vigilante: 決まってるだろ\n貴様と同じだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: "徴候が一つ二つしか\nなかったなら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: "どうやって来訪者を\n見分けてるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: "Vigilante: FEMAは この街を見捨てたのか？\nそれとも この辺りだけか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: "Vigilante: だが 何軒か回ったが\nここは来訪者だらけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: "Vigilante: 奴を捜索してきた\n無駄骨だったがな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: 戻ったぞ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: "Vigilante: また戻ってくる…\n貴様 面白い奴だな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: 確かめなきゃ ならない奴がいる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: なんで連中を脅威だと？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: 来訪者の徴候を見抜く術を把握してる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: 連中は分かって やっている'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: "Vigilante: 休んでろ\nまた話そう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: "Vigilante: この目で見るまではな\nそれが俺の主義だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: だが 信用は してないからな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: "Vigilante: 秩序を保とうとしてるんだな\nいい心がけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: "Vigilante: 興味が湧いた\nまた来る"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: "Vigilante: ああ 見たんだな\n噂を追ってる口じゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: "Vigilante: 面白い\n実際に見たのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: つまり防護なしか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: "Vigilante: 一匹だけか？\n半裸だと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: "FEMAが人を連れ去りました\n帰るか知る由もありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: "来訪者が次々 現れます\nでも 銃があります"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: "半裸の来訪者が\n警備隊を全滅させました"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: "Vigilante: ここで何が起きてる？\n誰に目を光らせればいい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: "Vigilante: 貴様の質問はすんだ\n今度は俺の番だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: 待て'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: "いつまで「掃除」を\n続けるつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: それで 何故ここに？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: "Vigilante: 印象深い奴なら…\n別のを取るかもな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: "Vigilante: いつも来訪者の歯を一本 抜くんだ\n一番 手軽だからな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: "Vigilante: これは証だ\nどれだけの家を どれだけの町を\n浄化したのかのな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: "Vigilante: ふん いい呼び名だな\n使わせてもらう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: "Vigilante: 来訪者よけ？\nああ この首飾りか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: "いつまで「掃除」を\n続けるつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: それで 何故ここに？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: "Vigilante: 来訪者を憐れむ奴は誰だろうと…\n来訪者と同じだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: "Vigilante: だが 最も効果的なのは？\n家に閉じ込め 燃やすことだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: "Vigilante: 手でも汚れは落とせるが\nこいつのほうが効率がいい"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: "Vigilante: そう\n箒だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: "Vigilante: ふん\nいい言い方だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: "その装備は？\n来訪者よけですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: "見たところ 持っているのは\n箒ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: "Vigilante: 屋内になど隠れるものかよ\n俺が正義だ\n俺が秩序を もたらしてやる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: 正義はない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: "Vigilante: それで 数日後には家中\n来訪者に皆殺しで逃げられる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: "Vigilante: 来訪者を憐れむ連中もいる\nほざくんだ…治せるだの"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: 冒険ごっこじゃない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: "その装備は？\n来訪者よけですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: "見たところ 箒を\n持っているのでは？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: "Vigilante: 他？\n貴様の知ったことじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: 俺の区域は片付いたからな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: ここの掃除に来た'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: "どうして屋内に\n入らないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: 貴様が来訪者じゃ なければだが'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: "Vigilante: いい判断だ\n生存確率が上がる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: 距離を保ってるのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: "Miner: ただ無視して変えるのか？\n何事もなかったツラして\n元の生活に戻るのか？\nさあ 降りな 解き明かそうぜ 一緒に！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: "Miner: 下に なにか あったら？\nなにもかも変えるような なにかが\nあらゆる疑問の答え\n国の英雄になれる機会が…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: "Miner: 真相を知らないままで いいのか？\n冗談だよな？ただの穴じゃないんだ\nアンタだって 感じてるはずだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: "Miner: ほら？なに 待ってんだ？\nこのために 来たんだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: "Miner: 今 怖じ気づいたら 今後 一生\n「もし あの時…」を抱えて生き続ける\nハメになるんだぞ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: "Miner: さあ 勇気を見せな\nアンタが降りて オレが支える"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: "Miner: アンタだって 知りたいんだろ？\n下に なにがあるのか\nビビり屋じゃないのは わかってる\n三度も ここに来たんだからな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: "Miner: オレなら片手でも引き上げられる\nでも オレが降りたら 誰が？\n単純な理屈だろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: "Miner: オレが降りたら 誰が引き上げるんだ？\nあん？悪いが アンタよりムキムキの\n鼠 見たことあるよ\nだから 降りるのがアンタ 残るのがオレ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: "あの下に なにがあるか\n永遠に わからなかったら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: "なぜ自分で降りて\nいかないんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: "Miner: アンタも感じてるだろ？\n引き寄せられる…穴に呼ばれるように\n聞こえてるだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: "Miner: もう一人？\nいいか 誰かが動かなきゃならない\n永遠に立ち往生してられないんだ\n今やるしかない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: "あの下に なにがあるか\n永遠に わからなかったら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: "なぜ自分で降りて\nいかないんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: "Miner: それより なあ 待ってる暇を潰そう\nこの場所を解き明かしてな\n認めろ 興味あるんだろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: "Miner: おっと そりゃ 無論 生きてるとも！\nほら！まだロープ張ってるだろ\nつまり 下にいて 働いてる ってことだ\nなにか起これば 気付くさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: "もう一人は まだ\n行方不明ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: "友人の方は まだ\n生きてると思います？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: "でも あの穴…ぶっちゃけた話\n何度 入りそうになった？\nなんか引き寄せられるみたいな？\n認めろよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: "それか ここに長く座りすぎて\n妄想が暴走してるだけかもな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: "Miner: おっと アンタか！逃げたものかと\nだが なにか変だ\n光が妙な具合だし ロープが やけに重い"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: "Miner: アンタ 力仕事向きには見えないよ\nでも オレなら苦もなく引き上げられる\nだから アンタが行って…\nオレが見張るってのは どうだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: "Miner: 一つ降りれば わかるかもしれない\n自分で行きたいが…なあ\nロープを保つヤツが必要だろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: "Miner: そこに答えが あるとしたら？\n別に 全部じゃなくてもいい\nだが なぜ連中が現れたのか\nなにを求めてるのか…考えてみろよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: "Miner: 来訪者だと？気が合うな！\nこのトンネルは連中の ものじゃないか\nそれに あの穴…門かもしれん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: "Miner: だから 一緒に いないとな？\nお互い引き上げる準備をしとこう！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: "Miner: ビビってるんじゃないが…\n引き込まれるんだ\nもう一度だけ…\nもう少しだけ 近づけたら…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: "Miner: だがな 穴の近くに立つと…\nなにかに呼ばれてる気がするんだ\n試してみろ ただ…耳を澄ませて"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: "Miner: 近づいたことはある 仲間がいた頃に\nだが あそこは…深淵を覗くようだった\n完全なる虚無だ\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: "Miner: 行きたいのは山々だが ほら…\nロープを引き間違えたら おしまいだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: "Miner: 覗いた かって？\n…まあ ちらっとはな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: "降りた友人の方の身が\n心配じゃないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: 穴を覗いたことは？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: "Miner: 見ろよ？ロープは張ってる\nつまり まだ下で働いてるんだ\n問題があれば わかる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: "Miner: もう一人はロープ番だ\n準備ができるか 面倒が起きたら\n引っ張る手筈になってる\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: "Miner: あん？仲間だって？\nいや 無事だよ\n一人は奥にいったが 戻るはずだ\n出口への嗅覚が ある奴だからな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: "降りた友人の方の身が\n心配じゃないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: 穴を覗いたことは？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: "Miner: アンタも なにか食っときな\nでなきゃ オレみたいに飢えちまうぞ\nランタンだけが相棒だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: "Miner: ここは時間の流れが変だ\n光もなければ 時計もない\n何時間 経過したのか 知る由もない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: "Miner: なんだ？もっと大きな声で頼む！\nここに座って そうだな…\n二日 三日は経ったかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: "友人の方は まだ\n戻ってないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: "どれくらい\nそこにいるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: "Miner: また来たのか？ん？\nアンタの声が小さいのか\nこの唸り声でオレの耳が壊れたのか？\nなあ？大声で言ってくれ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: "Miner: ここまで降りてきたら\n詳しい話 してやるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: "Miner: 穴の近くを掘ろうとしたら\nあたり全体 落ちてきそうになったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: "Miner: なあ ここに降りてくるつもりなら…\nその穴は避けろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: "Miner: 仲間の一人が どこかで噂を聞いてきて\n調べる価値がある って言うんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: "Miner: ただの穴だ\nただ 周りで妙なことが起きてる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: "Miner: いや そう大したもんじゃないよ\nマジで"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: なんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: "Miner: 穴の近くを掘ろうとしたら\nあたり全体 落ちてきそうになったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: "Miner: なあ ここに降りてくるつもりなら…\nその穴は避けろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: "Miner: 仲間の一人が中に入った\nオレは ここに残ってて まあ その\n必要なら手を貸すためにな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: "Miner: そばだと 動物は静まり返り\nコンパスは狂い\n懐中電灯でも闇を照らせない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: "Miner: 穴の近くで なにか起きてる\n静かな唸り声が ずっと止まらないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: 穴だ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: 来訪者でも捕らえました？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: "なんです？\n面白いものですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: "Miner: だが聞いてくれ\nトンネルより もっと妙なものがある\nなにかあるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: "Miner: まだ見かけていないし\n確信は持てないが"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: 来訪者が移動に使ってるんじゃないか'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: "Miner: 誰が なぜ掘ったのかは見当も付かない\nただし 一つ仮説がある"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: "Miner: ほんの少し掘っただけで\nなにを見つけたと思う？\nトンネル網 丸ごと一つだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: "Miner: 避難所だよ クソッタレ！\nクソ暑さから逃れるためのな！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: 来訪者でも捕らえました？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: "なんです？\n面白いものですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: "Miner: だが それは置いておこう\nなにか見つけたからな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: "Miner: トンネルは深い\nとんでもなく深い\n続く先は見当も付かない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: "Miner: 昔は もっと広がってたようだ\n最近 いくつか崩れたが"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: "Miner: そしたら ちょっと掘っただけで…\nほら！地下に広がるトンネル網を\n見つけたんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: "Miner: オレと仲間でな\n暑さ避けにトンネルを\n掘ることにしたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: なにを 探してるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: なぜ ここに？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: "Miner: 耳に土が詰まってて\nアンタの声が枕越しみたいだ\nまったく"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: "Miner: 閉じ込められた？いや\n見つけたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: ん？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: なにを 探してるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: なぜ ここに？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: "Miner: まあ 頭上の家が崩れてこないことを\n祈るよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: ここ アンタの家の下なのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: "Miner: 耳が埃と煤まみれでな\nなにも聞こえやしないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: "Miner: なんだって？\nもっと大きな声で頼む！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: "そこに\n閉じ込められてるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: ウチの下で なにを？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: …多分'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: "Miner: あん？誰だ？\nなんか聞こえたぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: さらばじゃ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: "MushroomEater: 良き一日を 健やかなる時を\n大いなる喜びを あふれる笑顔をな\n坊主！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: "MushroomEater: 無念じゃ\n希望は すべて失われた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: ならば…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: いえ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: ええ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: "MushroomEater: 今一度 問おう 坊主\n共に来てくれるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: "MushroomEater: キノコランドに なにが待っとるのかは\nわからん…\nただ一つ確かなのは…危険じゃ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: "MushroomEater: 歪んだ時代を飛び越えとるぞ 坊主\nキノコランドが崩壊する中 踊りつつの\nワシらも そうなるかもしれん…\nかもしれん…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: "MushroomEater: ワシ一人ではムリでな…\nお主の助けじゃいるんじゃ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: "MushroomEater: おや 坊主…\nこりゃいかん…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: キノコランドへの門が閉じる前に！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: "MushroomEater: おお なんということじゃ！\n手遅れになるぞ！さあ急げ急げ！\nさっさと行くぞい！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: 真夜中じゃと！？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: "MushroomEater: ちょいと待て\n時計を見せてみい！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: 荷物を まとめて…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: "MushroomEater: ホッホ！\nその意気じゃ 坊主"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: いえ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: ええ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: 一緒にキノコランドへ来てくれんか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: "MushroomEater: 人が踏み入るべき場所ではない\n決して決して決して\nだが 祭を止めたくば行かねばならぬ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: "MushroomEater: 今 行動せねば\nすべて失われるかもしれん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: "MushroomEater: あそこでは祭は見えん…\nじゃが…菌糸は…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: "MushroomEater: 光や虹の国ではないぞ\nダメじゃダメじゃダメじゃ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: "MushroomEater: ワシらの言葉では楽しげかもしれん…\nだがキノコ語では全く別の意味を持つ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: 名前に騙されるでないぞ 坊主'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: いえ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: ええ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: 一緒にキノコランドへ来てくれんか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: "MushroomEater: 祭は止めねばならん\nなんとしても！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: "MushroomEater: 本音を言うと…\nそのままにしときたいの\nじゃが 悲しいかな 他に選択肢はない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: "MushroomEater: ホッホ そうとも 坊主！\nあそこは恐ろしい場所じゃ\n誰一人 足を踏み入れとらん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: なんだか怖そうですね
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: キノコランド？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: "MushroomEater: これだけは避けたかったんじゃが…\nキノコランドへ行かねば ならんの"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: "MushroomEater: つまり菌糸が\nクソったれた事態になる！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: "MushroomEater: のう 祭が始まれば\nキノコの成長は制御不能になるんじゃ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: なんだか怖そうですね
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: キノコランド？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: "MushroomEater: これだけは避けたかったんじゃが…\nキノコランドへ行かねば ならんの"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: "MushroomEater: だが昨今は悪意が積もりすぎて\nキノコが際限なく肥大化しとる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: "MushroomEater: キノコは肝臓みたいなものじゃ\n体の毒を浄化しようとするでな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: "MushroomEater: 糸に悪意が溜まりすぎると…\nあちゃ…なんもかんも詰まるんじゃ\nまったく"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: 菌糸の中で なにかがバカになっとる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: なぜ祭が始まるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: なぜ失敗を？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: "MushroomEater: 菌糸内が混乱しすぎとって 儀式は…\nうまく いかんかったようじゃ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: "MushroomEater: どうやら やはり\n祭は近づいとるようじゃの…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: まだ別れじゃないぞ 坊主'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: "MushroomEater: 忘れるでないぞ…\nキノコは見た目どおりとは限らん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: "MushroomEater: キノコを小さく保ち\n祭の開催を止めるのじゃ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: 時が来たら また戻ろうぞ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: "MushroomEater: 思考しとるのは菌糸じゃ\n残念じゃが 聞くことしかできん…\nあやつら ワシらの言葉を解さんからの"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: キノコは菌糸の一部に過ぎんからの'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: "MushroomEater: そりゃ ええ考えだ…\nじゃが キノコと直に話はできん\nムリじゃムリじゃムリじゃ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: まだ別れじゃないぞ 坊主'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: "MushroomEater: 忘れるでないぞ…\nキノコは見た目どおりとは限らん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: "MushroomEater: キノコを小さく保ち\n祭の開催を止めるのじゃ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: 時が来たら また戻ろうぞ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: それこその ワシらが行ったことじゃ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: "MushroomEater: だが スマイルの書が\n教えてくれたんじゃ\n根を鎮め 成長を抑える手筈を"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: "MushroomEater: キノコと直に話はできん\nムリじゃムリじゃムリじゃ！\nワシらは菌糸の一部では ないからの！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: ワシらが行ったのは古い儀式じゃ 坊主'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: "あなたがキノコに祭を\n止めるよう頼んでは？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: "私たちの行動が どう祭を\n止めることに繋がるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: "MushroomEater: 今は ただ堪え 願うしかないのう\nキノコの成長が止まることを"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: "MushroomEater: のう 坊主…そう単純ならの\nワシらのしたことに 効果があるのか\nまだわからんでな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: "あなたがキノコに祭を\n止めるよう頼んでは？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: "私たちの行動が どう祭を\n止めることに繋がるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: キノコの育ちが あまりに早いんじゃ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: "MushroomEater: あやつら 実に多くを知っておる\nだが今や 危機に瀕しとってな…\nワシら同様に"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: 菌糸が知らせてくれての'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: 納得してなさそうですね
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: どうして わかるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: "MushroomEater: これで祭を止められておれば\nよいがのう…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: "MushroomEater: また会えたのう 坊主！\nスマイルの書のとおり\nすべて成し遂げたようで 嬉しいぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: "MushroomEater: ふん…近頃の若いモンは…\nひょっとすると ワシは\n坊主の貴重な時間を\n浪費しとるだけかもしれんな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: "MushroomEater: なぜじゃ？\n書の ほんの一部に過ぎんのに…\nワシは暗記しとるんじゃぞ…\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: "MushroomEater: 良き一日を 健やかなる時を\n大いなる喜びを あふれる笑顔を\nさらばじゃ 坊主！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: "MushroomEater: ページのとおり すべて成し遂げたら\nまた 戻ってこよう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: "MushroomEater: それじゃの…\nワシは行かねば"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: "MushroomEater: 良い子じゃの\n暇があれば 読んでみるといい"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: 自分で持っててください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: "ええ スマイルの書のページを\n受け取りましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: "MushroomEater: スマイルの書から\n数ページ 破り取ってきた\nほれ 持っていくがよい\nすべきことは記されとる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: "MushroomEater: こりゃ おおごとじゃ！\n許してはならんぞ\n止めねばな…一緒に 坊主"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: "MushroomEater: だが そのキノコは一本ではない\n祭なのじゃから そういうものよな！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: "MushroomEater: 影は広がり 太陽を呑み込み…\nどこもかしこも歓喜に包まれる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: "MushroomEater: 一つの大キノコが そびえ立ち…\n遠く広く 胞子を撒き散らすじゃろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: その話は スマイルの書を紐解かんとな！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: ホッホ 坊主…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: 自分で持っててください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: "ええ スマイルの書のページを\n受け取りましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: "MushroomEater: そこで大事なページを破っといた\nほれ…持っていくがよい"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: "MushroomEater: だが 無念じゃ\nワシには読み通す時間が残されとらん\n厚い本じゃし…なにより時間がない！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: "MushroomEater: 特別な本じゃぞい\n世界一 特別じゃ\nすべきことが記されとる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: キノコ祭？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: スマイルの書？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: "MushroomEater: さあ これを見てみい…助けになるぞ\nスマイルの書じゃ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: "MushroomEater: フハハッ！\nまあ いずれ わかるじゃろう\nおっと 忘れるでないぞ\n祭は止めねばならん…なんとしてでも"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: キノコ祭？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: スマイルの書？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: "MushroomEater: キノコ祭が近づいとると 言っとった…\nのう 坊主 こいつはマズいぞ！\nダメじゃダメじゃダメじゃ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: "MushroomEater: ワシはスマイルの書を研究し\n聞き方を学んだんじゃ\nだが あやつらが最後に告げたのは…\nまあ 良くない知らせよの"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: 菌糸とは キノコ同士が話す手段じゃ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: "MushroomEater: そうとも\n凡人には理解しがたい ことよな\nあやつら 独特の方法で話すからの"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: ついていけません
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: 菌糸ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: "MushroomEater: よいか 坊主\nやることは山積みなのに\n時間は そう残されとらん！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: "MushroomEater: あやつらの言葉は ややこしいが\nワシは信号の解読を学んだんじゃ\nそうとも"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: "MushroomEater: 無論 お主のことは知っとるぞ！\n菌糸が教えてくれてな！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: ついていけません
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: 菌糸ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: "MushroomEater: だから 頼むぞい\n耳を澄ませて\nワシの言葉をよく聞くんじゃ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: "MushroomEater: キノコ祭が近づいとる！\nなあ 坊主\n時が指から零れ落ちとるぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: "MushroomEater: だが今は ワシのことなど どうでもよい\n菌糸が一大事を教えてくれたんじゃ\nそうとも…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: "MushroomEater: ホッホッホ！\nただの年寄りじゃよ\nちょっとキノコに詳しいだけのな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: 私を知ってるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: おやおや 坊主'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: 為すべきは為された'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: "CultistPriest: 感謝を込めて去らん\n如何な結果であれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: "CultistPriest: 或いは とどのつまり 汝は安寧など\n求めていなかった のかもしれぬ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: 同胞は かくも煩わしかったか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: "CultistPriest: 同胞を伴い去らん\n感謝を込めて 如何な結果であれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: "CultistPriest: 重畳…\n汝は存分に為した"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: ここは託児所じゃない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: 放っといてください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: ただ 彼女を呼び続けるより 他になし'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: "CultistPriest: だが 大いなる死 その御身は…\n最も恐ろしき運命 即ち 虚無より\n我らを救い給うかもしれぬ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: "CultistPriest: 輪廻など 小休止を挟みし\n永久の苦悶に過ぎぬ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: "CultistPriest: 「来世」など 偽りの宗教が約束せし\n空虚な夢想に過ぎぬ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: されど 永遠の虚無を思わば 恐怖する'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: "CultistPriest: 肝要なるは\n皆 疲れ果てている ということ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: 召喚するものを知り尽くさずとも良い'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: "CultistPriest: 彼女が来たり給う日は近い…\n感じるぞ 然り…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: ここは託児所じゃない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: 放っといてください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: 何故？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: "「大いなる死」とは\n一体なんなんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: "イカれた仲間を\n連れて出ていけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: 良き眠りを'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: "CultistPriest: 承知しているだろう…\n大いなる死が 汝を選び給うたならば\n彼女へ導く務めを喜んで果たさん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: されば故か…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: 同胞は現世を去ったのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: "「大いなる死」とは\n一体なんなんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: "イカれた仲間を\n連れて出ていけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: "CultistPriest: 長居はせぬ\nもう行こう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: "CultistPriest: 然り…万事は然るべき姿のまま\n彼女の眼差しは\n未だ我らに注がれている"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: "失せろ\n忙しいんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: 信徒のみなさんは無事です
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: "CultistPriest: 嗚呼\nされど汝は 満悦と見えるな？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: "CultistPriest: かくして世は終わるのだ\n轟音にあらず…微かな呻きと共に"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: "CultistPriest: 大いなる死は 最早\n我に語り給わぬ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: さらばだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: 汝は…我ら唯一の機会を奪った'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: 揃ってないと？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: 待て…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: "CultistPriest: 何を意味するのか\n我にも未だ定かならず…\nされど なんと蠱惑的な響きか？\n然り…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: "CultistPriest: 彼女は 汝に隠遁の地を\n与え給うかもしれぬ\n万事から…終焉そのものから すらも"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: "CultistPriest: つい先ほど 大いなる死が語り給うた\n時が来たれば 汝に会わん と"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: "CultistPriest: 汝も疲弊していよう\nこの騒音 末世 混迷に…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: 尽力 感謝する'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: "知ったことか\n俺には俺の問題がある"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: ええ まだ生きてます
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: "CultistPriest: 時を浪費すべからず\n我が信徒の様子は如何に？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: …我も程なく戻らん'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: "CultistPriest: 長き時は要すまいが\nされど 見守ってくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: 感謝する'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: そう多く 時を要さぬはず'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: "CultistPriest: 故に…同胞を泊めるが良い\n然り…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: いずこへ逃げる？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: "CultistPriest: たとえ業火を生き延びようとも\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: "CultistPriest: 否 やがて他の者も来たらん\n汝が眠る間に 壁へガソリンを撒き\n火を放つであろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: 信仰の担い手が 我ら少数のみだと？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: "脅されるのは嫌ですが\n構いません 手を貸しましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: ならば全員 撃ちますよ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: "CultistPriest: 嗚呼…\n他に道はあらぬ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: "CultistPriest: 不運にも 我が宿命 ここで潰えるならば\n汝の壁は炎に贖われよう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: "CultistPriest: されど それ以上ともなれば…\n使命は手の届かぬ ものとなろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: "CultistPriest: 我が同胞を見守れ\n忘れるな 一人でも死すれば…\n汝の家は無に帰すだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: "CultistPriest: 汝も安寧を望まぬか？\n誰もが他の重荷とならぬ世を"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: "CultistPriest: 実に重き試練だ\n高みへ至る道のりが\n易き旅路であった ためしはない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: "脅されるのは嫌ですが\n構いません 手を貸しましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: ならば全員 撃ちますよ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: "CultistPriest: 赦せ\n神聖なる使命を果たす 唯一の道なのだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: さすれば 汝の壁を焼き尽くさん'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: "CultistPriest: それ以上ともなれば\n万事は無に帰す"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: "CultistPriest: 我が同胞を見守れ\n忘れるな 一人でも死すれば…\n汝の家は無に帰すだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: やがて汝も 焼き尽くされるやもしれぬ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: 過ぎた注文に聞こえます
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: あまり興奮しない展望ですね
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: "CultistPriest: 同胞は逝きし者のため\n儀式を執り行わん\nただ 護れば良い"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: "CultistPriest: だが同胞は僧庵を要する\n大いなる死は この地に惹かれ給う"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: "CultistPriest: 我が入るには当たらぬ\nこの身の使命は\n神聖なる真理を広めるのみ\n永久なる安寧を もたらす真理を\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: 過ぎた注文に聞こえます
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: あまり興奮しない展望ですね
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: 務めを果たすまで 生き永らえねば'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: "CultistPriest: いずれにせよ\n我が同胞を汝に預け 護ってもらいたい"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: 一体 何事が起こっている？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: ここは大いなる死の影が強く宿らん'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: "CultistPriest: 汝の家は誠に理想だ\n然り…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: "CultistPriest: 埋葬の儀を行わねばならぬ\n新しき様式にて"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: 中に入りたいんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: それで なにが望みなんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: "CultistPriest: 彼女は すでに近く在り給う\n我らは 敷居を越え給うを助けるのみ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: "CultistPriest: 救世など信じぬ\n大いなる死 御自らの恩寵に非ずば"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: "CultistPriest: これぞ 我が死衣\nいずれ死せる時 必ずや要さん\nかくすれば 屍を包む布を\n求める手間もなし"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: "CultistPriest: 或いは然り\n悪しき行いか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: 中に入りたいんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: それで なにが望みなんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: "CultistPriest: それこそが唯一 救世の道なり…\n最早 退くは叶わぬ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: 我らは 彼女の 導き手に過ぎぬ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: "CultistPriest: 大いなる死は すでに来たり給う\n彼女は 人類を慰めんと望み給い…\n混沌と苦渋と狂乱より\n解き放たんとし給う"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: "CultistPriest: 我ら 新しき信仰の先触れ\n神聖なる教義の託宣者"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: "カルトの変人みたいに\n見えますよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: "何者ですか？\nなぜ そんな格好を？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: "CultistPriest: 大いなる死は 汝を愛し給う\n然り…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: "CultistPriest: 焼かれし者もあれば\n引きずり出され処刑されし者もあろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: 大いなる死は遍く在り給う'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: 然り'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: "カルトの狂人みたいに\n見えますよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: "何者ですか？\nなぜ そんな格好を？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: "CultistPriest: 如何ほど死に絶えたか 知れぬものの…\n彼女の存在が強く漂い給う"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: "CultistPriest: 大いなる死は汝の家を愛し給う\n彼女は ことのほか 好み給う"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: …大いなる死を'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: ええ 私の家です
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: なにを感じるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: 感じるぞ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: "CultistPriest: 然り然り\n汝の家は完璧だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: "Courier: ほら\n{0} だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: "Courier: 単なる配達員だぞ\n危険視するなんて どうかしてるだろ？\nなんで殺すんだ？一体 なんのために？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: みんな クソ イカれちまってる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: "Courier: 注文を届けに行った だけなのに\n家のヤツだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: 友達が殺された'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: どうしたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: 配達だ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: 良い夜を…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: "Courier: オレの目が寝不足で赤くなったら？\nあのクソ隔離区域に\n放り込まれるのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: "Courier: それで オシマイ 連行されちまった\nアイツが どうなったのか わからない\n解放されるのかも"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: "Courier: 朝の検査でな いつもどおりの\n目を見つかっちまって 赤かったんだ\nクソッタレ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: 同僚がFEMAに連れて行かれて…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: "少し落ち込んで\nそうですね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: どうも…宅配だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: 良い夜を'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: "Courier: 仕事してれば せめて気は紛れる\nこのクソ茶番を考えずにすむ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: "Courier: まあ 他に やることもないだろ？\n大抵の連中みたく 家で腐ってもな？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: "Courier: って いや\nこの仕事に行き着いた流れか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: "Courier: 審査を通過して\nあらゆる徴候を調べられ\nやっと人間だと判断されるんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: "どういう経緯で\n配達員に？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: "Courier: よう\nFor Rest宅配の お届けだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: "Courier: 悪い\nまだ慣れてなくてな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: "Courier: 良き一日を…\nって いや もう夜か"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: まだ配達が続いてるとは
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: "Courier: よう\nFor Rest宅配の お届けだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: "Intruder: 夢なしでは辛い\n誰にとっても"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: そうだといいんだが'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: "Intruder: 人は再び 夢を見るように\nなるだろうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: "Intruder: だが この家の誰かが夢を見るなら\nそれも悪くない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: "Intruder: ありがとう ここで眠ってみよう\nもっとも 安らぎは逃げるだろうが"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: 眠れたら 夢が訪れるのかもしれないな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: 六日間 眠ってない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: どうだろうな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: "Intruder: 神聖な場所を失ったからだろう\n休む時間 振り返る時間を"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: "Intruder: だが 今じゃ…\n崩れ落ち 形を失っている"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: "Intruder: 夢は場所だ\n答えを探し 慰めを見つけ…\nただ安らぎを求められる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: 夢は…繊細で 不思議だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: "あなたこそ\n夢を見るんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: なぜ気にするんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: "Intruder: それは…太陽のせい なのか？\nそれとも別の理由か？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: "Intruder: お前も他の連中と同じだ\n熱に うなされても…なにも見ない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: そうだろうな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: "あなたこそ\n夢を見るんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: なぜ気にするんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: 何故だと思う？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: 人はもう ほとんど夢を見てない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: なあ 気付いたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: "Intruder: 夢のことだよ 夢ぐらい知ってるだろ\n眠っているとき…なにか見るか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: 別に
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: えっ？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: 夢を見るか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: じゃあな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: オレだって なんで まだ着てんだか'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: この防護服 恐ろしいもんな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: "FormerFema: …いや 言い間違えた\nうん わかってる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: "FormerFema: えっ？\nああ ありがとう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: "FormerFema: 本当に入れてくれるとは\n思ってもみなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: どこか座れる場所あるか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: "FormerFema: えっ？\nああ ありがとう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: "FormerFema: つまり プログラミングを\nコード書き ってヤツ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: 結局 約束と違うことを やらされた'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: それから 待ってたのは失望だった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: "FormerFema: 仕事はあった\nうまくいくと思ってた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: "FormerFema: いい質問だな\n今は ただ…途方に暮れてる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: 燃え尽きて 辞めたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: "FormerFema: 人が減りすぎたんだ\n回らなくなって\n仕事は積み上がるばかりで"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: それで…もう働いてない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: 冷蔵庫を作ったり 直したり'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: 単なる工場勤めの男だよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: なにを企んでるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: では 何者なんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: なにが起きてるのか 誰もわからない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: そして 二度と戻ってこない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: "FormerFema: まぁ…連中が なにやってるにせよ\n人を連れて行くんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: "FormerFema: みんなFEMAを嫌ってるよな\n見たところ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: "FormerFema: あっ！違う違う\nオレはFEMAじゃない\n制服のせいで そう思ったのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: よく わからない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: えっ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: なにを企んでるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: では 何者なんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: "FormerFema: もしかしたら 夜も太陽からの\n放射線が残っているとか？\nいや 知りたくもないな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: "FormerFema: その方が安全かと思ってな\n連中が着るからには\n理由があるんだろうしな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: いや 死体から剥ぎ取っただけだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: "FormerFema: ああ…オレをFEMA職員だと？\nこの防護服のせいで？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: 連行？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: "今度は私を連れて行く\nつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: "まず連行した人を\n返してください"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: 開けて…くれるか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: "FormerFema: 足音がした…\nってことは ドアまで来たんだな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: "FormerFema: こんばんは？\n誰か いるのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: "GraveDigger: 俺は深い穴を掘って\nそこから出たくねえ\n二度と 絶対に"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: "GraveDigger: 聞いた話だよ…\nちょっと外に出て 戻ってきたら\nドカン！幕引きだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: "GraveDigger: そしたら来訪者がドアを叩く…\nいや それどころか…もう中にいる\n待っている"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: 帰ったところで 家は空っぽ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: "GraveDigger: 腰を壊してまで穴を掘る\n終日 毎日 クソ一生\nそれで なんになる？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: ふううぅぅ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: "GraveDigger: とっととドア 開けてくんねえか？\n来訪者が すぐ後ろにいそうで\nビビってんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: あっ ありがとよ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: "GraveDigger: とにかく…もう辞めだ\nクソ食らえ\n俺は降りる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: "GraveDigger: 厄介事が俺らを あやしてくれんなら\n俺らも厄介事を あやしてんだろうな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: "GraveDigger: どうせ太陽が火葬して くれるしな\nそれに夜は…短すぎんだ\n死者を相手してる暇もねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: "GraveDigger: もう誰も遺体 運んでこねえしな\nマトモに弔おうなんざ\n誰も考えなく なっちまったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: あんな仕事 クソの価値もねえ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: "GraveDigger: 必死で逃げた 振り返りもせず\n家に帰るなんて とてもできねえ\n人混みに紛れるほうが 安全だと思った"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: "GraveDigger: 来訪者だった\n地面から這い出てきたんだ！\nなのに あの男…笑ってやがった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: "GraveDigger: 岩かと思ったら違った\n土の中から手が伸びて きやがった！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: "GraveDigger: ひたすら掘って掘って…ガンッ！\nなにかがシャベルに当たってよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: "GraveDigger: あの男 立ったまま\n掘るとこを見てた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: "GraveDigger: ああ 見たよ クソッタレ\n墓を掘ってたんだ\nあの男が注文した墓をな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: "仕事を放り出して\n歩き回ってるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: "外で なにか\n見たんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: "GraveDigger: みんな 倒れたまま 放っとかれる\n太陽が勝手に 火葬してくれるしな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: "GraveDigger: 近頃 人が蠅みてえに死んでくが\n埋める奴なんて いやしねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: "GraveDigger: 信じらんねえもんを\n最後の穴掘りで見ちまったんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: "GraveDigger: 悪かったよ\nガンガン うるさくして\nでもよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: "仕事を放り出して\n歩き回ってるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: "外で なにか\n見たんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: "GraveDigger: 墓なんて もう なんの意味もねえ\nみんな ブッ倒れたまま 腐るだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: "GraveDigger: 前は墓掘り やってたんだ\n今じゃ あんま意味ねえけどな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: こっちも一睡も できなくてよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: "GraveDigger: おいおい 悪気はねえんだ\n起こすつもりじゃなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: 自分の頭でも叩いてろ！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: "ドアを叩かないで\nください"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: 入れちゃくんねえか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: "GraveDigger: もしもおおぉぉし？\n誰か生きてっか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: そっか なら俺も行くとするか'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: あれ…もう行っちまったのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: "Marauder: 通りすがるだけだ 長居はしねえ\n約束する"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: なあ…このあたりに空き家ねえか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: 気にすんな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: "Marauder: 退屈させねえからよ\n約束するぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: "Marauder: いつでも話しかけてくれよ\nなに 話のネタなら 山ほどあるぜ\n一つや二つじゃねえぞ マジな話"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: "Marauder: うおおっ！\nマトモな人間らしく\n頭を横にできるなんて 久しぶりだぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: "Marauder: とにかくよ…ここに住んでんなら\n今夜くれえ 泊めてくれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: "Marauder: まあ…\n一度だけ しょうがなかったときもある\n長え話だ そのうち聞かせるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: "Marauder: 確かに 聖人とは言わねえよ\nけどよ 超えちゃいけねえ一線はある\n仲間に手出ししたり しねえよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: なんだよ 俺がチンピラか なんかだと？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: "Marauder: 話すネタなら いくらでもある\n外で 色んなモン見てきたからな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: "Marauder: 悪気はねえんだ\nけど ここに住んでんなら…\n少し 泊めてくれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: "Marauder: でもよ…実を言うと\nアンタんとこも そうだと思ってな\n空き家かと"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: "Marauder: 一度は やめようかと思ったんだ…\nほぼ やめかけた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: "Marauder: 取れるモン拾って\n売り払ったり 残しといたり"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: "Marauder: ふん 隠したって しょうがねえ\n廃屋だとか空き部屋だとか\n漁ってんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: 人から盗みを？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: "どうやって 一人で\n生き延びたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: "Marauder: だんだん 参ってきた\n気が狂っちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: "Marauder: けどよ 本音ぶっちゃけるとよ？\nもう ウンザリなんだ\n影に話しかけんのは こりごりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: "Marauder: はじめは そのほうが\n安全だと思っててな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: "Marauder: あの来訪者が どこからともなく\n這い出してきて以来…ずっと一人だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: ああ まあな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: 人から盗みを？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: "どうやって 一人で\n生き延びたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: "Marauder: なに…昔から ツルむのが苦手でな…\nそれで今こうして 一人くすぶってんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: "Marauder: てのもよ 人間がどこまで堕ちられるか\nこの目で見てきたんだ\n俺なんざ まだまだ甘ちゃんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: "Marauder: でもよ 他の連中よか\nヒデえ ってワケじゃねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: "Marauder: 俺みてえなのと ツルもうって奴\nいねえだろ？\nみんな俺を 社会のクズ扱いだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: "本当に それが\nいい考えだと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: なぜ一人なんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: "Marauder: なあ その ちょっと頼むんだが…\nここで休ませて もらえねえか？\n久方ぶりでよ その…人といるのは"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: けどよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: "Marauder: ワリいな 空き家かと思ってな\n出てくわ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: "Marauder: おっと…\nここ 人が住んでたのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: では ごきげんよう…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: "Provocateur: …ちなみに それは\n憲法 第119条に抵触します\nご自身にとって好ましい結果には\n決してならないでしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: "Provocateur: 口調を改めたほうが よろしいかと\n私の命に対する脅迫と解釈できる\n余地があります"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: "Provocateur: 不躾ながら 今「帰って」と？\nそれは脅迫ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: "Provocateur: 賃貸条件の詳細については\n後ほど協議いたしましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: ありがとうございます 家主様'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: "Provocateur: 支払うか さもなくば\n一歩も足を踏み入れません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: "Provocateur: 不適切ですし なにより\n違法ですから…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: "Provocateur: 申し訳ありませんが 正当な家賃を\n支払わず屋根の下に住まうなど\n良心が許しません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: "Provocateur: 結構です\n正式な法的契約に基づき\n後ほど改めて清算しましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: "Provocateur: 信じがたいですね…立派な賃貸業者が\n正当な金銭を拒むとは"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: "Provocateur: 不躾ながら 私が施しを\n必要としているように見えますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: カネは不要です
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: "払いたければ\n好きに払ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: "Provocateur: 申し訳ありませんが 正当な対価を\n支払わず貴重な床面積を占有するなど\n私には到底できません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: "Provocateur: 不躾ながら 「ただ 人を入れてる」と\n今 言いましたか？\nボランティアか なにか ですか？\n浮浪者の収容施設でも運営を？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: カネは不要です
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: "払いたければ\n好きに払ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: "Provocateur: ただし…正式な契約が ないとしても\n一泊いくら 取るつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: "Provocateur: まあ いいでしょう\n契約書の締結は後日でも構いません\n日付は無論 遡及処理しますが"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: "Provocateur: ふむ…\nずいぶん曖昧な答えですね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: "ただ 人を入れてる\nだけです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: そんなとこです
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: "Provocateur: ごきげんよう 家主様\nこちらでは 部屋を\n貸しているのですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: "TaxiDriver: アンタもFEMAのバカどもと一緒だな\nくたばっちまえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: クソッ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: "TaxiDriver: ああ パニクってるとも 確かにな\nでも それだけで追い出すのかよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: "TaxiDriver: おい 頼む\nそんな仕打ち カンベンしてくれ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: "TaxiDriver: 一瞬でも目を離せば\nさらわれちまうぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: "TaxiDriver: 覚えといてくれ\n黄色いクソ野郎を信用するな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: "TaxiDriver: ふう…\nありがとよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: "TaxiDriver: それで逃げたんだ もう家にも帰れねえ\nあのバカども どうせ\nオレの帰りを待ち伏せてやがる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: 連中 オレまで引っ張ろうとしやがった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: "TaxiDriver: 考える間もなく\nFEMAに連れてった\nそれが大失敗だった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: "TaxiDriver: バックミラー越しに チラッと見えた\n広告みたいに真っ白な歯が"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: アイツ 来訪者だった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: "TaxiDriver: トチ狂ってるなんて思わないでくれ\nだが…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: "TaxiDriver: そこで コートに隠してた瓶で\n一人ブン殴って 逃げ出したんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: "TaxiDriver: 秒で後悔するハメになった\n車から引っ張り出された瞬間 気付いた\nあのバカ オレまで連行しようとしてた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: "TaxiDriver: はじめは賞賛を浴びたよ\n「よくぞ 来訪者を連れてきました」\nなんてな でも…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: "TaxiDriver: それで こっそりFEMAに運んだんだ\n連れてって閉じ込めた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: "TaxiDriver: 乗せてた客 やけに歯が白くてよ\nまっさら すぎた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: "TaxiDriver: あのクソFEMAのクズどもに\n車 パクられちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: 乗客は どうなったんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: 車は どうなったんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: "TaxiDriver: バカやらかしたワケじゃねえんだ\nただ 変なヤツを信じちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: テメェのマヌケで なくしちまった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: "TaxiDriver: 車は持ってたよ ああ…\nでも もうねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: 乗客は どうなったんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: 車は どうなったんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: "TaxiDriver: 結局 その男も…\nオレの車も なくしちまったんだ\nなあ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: その男 話してたのと別人だったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: "TaxiDriver: ある客を乗せてたんだ\nそしたらよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: "TaxiDriver: どこから話したもんか…\nオレ タクシー転がしててよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: どう力になれば？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: なにが あったんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: "TaxiDriver: 聞いてくれ\n今とんでもねえ状況でよ\nここで少し身を隠させてくれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: よう'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: "Edgar: どこか木陰を見つけます\nですが どうか…\n私の体を捨て去らないでください\nその時が来ても"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: "Edgar: 死が優しく抱擁するまで\n僕は待ちましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: 近くに留まっても 構いませんか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: "Edgar: 僕の体は残しておいて ください\nその時が来たら"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: "Edgar: 貴方が僕と同じように\n美を見ているのか まだ わかりません\nですが 教えてください…遺体は\n大いなる夜へ 捨て去るのですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: "Edgar: ここは本当に 静かです\n僕が過ごした どの場所よりも"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: "Edgar: ここで僕は 最期の 不可知の世界へ\n移ろい 溶けていくのでしょう\nそして 静かに旅立つのです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: 故に 来たのです'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: "Edgar: いえ そのような親切は結構です\n不思議と ここでは…避けられぬものを\n素直に受けて入れている気がします"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: それで敗血症が和らぐと？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: "Edgar: そして今 貴方の前に立っているのです\n一人きりで"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: "Edgar: やがて 他の人たちが やってきて\nそして ええ…\n後は お察しのとおりです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: "Edgar: 少女は変わりました…毎日 少しづつ\nそして ああ\n美しい変化でした"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: "Edgar: かつて 思慕する少女と\n共に暮らしていました"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: "Edgar: もっともな問いです\n今は…こう言って おきましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: "腕を切り落とす\nべきでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: どうして壊疽に？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: "Edgar: あの混乱に 僕は属せないのです\n命が流れに逆らい\n懸命に もがく地には"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: "Edgar: 僕の話なんて 一気に飲み干すに\n越したことは ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: "Edgar: 毎朝 目を覚ますたび\n横になって 考え込むんです\n次の日まで 生きられるのかと"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: "Edgar: どのみち震えていたことでしょう\nええ…\nこのとおり 朽ちゆく身ですから"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: "Edgar: 熱狂に閉じ込められ\n通りは冷めることを知りません\n夜が落ちても"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: "Edgar: 狂乱たる街の熱気に包まれていても\n僕は震えてしまうのです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: "Edgar: 静寂…空虚…\nなんて平穏なのでしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: "腕を切り落とす\nべきでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: どうして壊疽に？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: "Edgar: ここで死にたいのです\nゆっくりと 静かに 最期の瞬間を\n心ゆくまで味わいたいのです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: "Edgar: 生き延びるべく必死に足掻く人々\nですが 貴方は…和解しているのですね\n来たるべきものと"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: "Edgar: 街の喧噪は 汗のように\nまとわりつきます\n狂乱に 狂騒"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: "Edgar: 僕の話なんて 一気に飲み干すに\n越したことは ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: "Edgar: 毎朝 目を覚ますたび\n横になって 考え込むんです\n次の日まで 生きられるのかと"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: "Edgar: 本当に体調が悪いのです\n壊疽のことだけでは ありません\nええ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: "ここのなにが そんなに\n美しいんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: なぜ家にいないんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: 少し ご厄介に預かれないでしょうか'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: "Edgar: ここは ずっと静かです\n街では あらゆるものが叫んでいました"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: "Edgar: こんばんは\n美しい お家ですね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: "Foreigner: （一瞬の沈黙の後\n背を向け歩き去る）"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: （怒鳴り声に 男は驚く）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: 'Foreigner: もう行ってくれ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: "Foreigner: （そこに立ったまま\nつぶやき続けている）"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: （男は頷き 中に入る）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: "Foreigner: （判然としないが\n頬が涙に濡れている）"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: "Foreigner: （男は立ち尽くし\n覗き穴を見つめている）"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: "Foreigner: （判然としないが\n頬が涙に濡れている）"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: "Foreigner: （何事か つぶやきながら\n腕を振っている）"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: どうすればいいですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: 口を縫われたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: "Foreigner: （また つぶやいているが\nなにも理解できない）"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: （眉が苦悩に歪む）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: どうすればいいですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: 口を縫われたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: （答えられないようだ）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: "Foreigner: （男は こちらを一瞥し\n眉を上げる）"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: なんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: どうしました？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: んんんんんんん！？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: んん'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: "Doctor: 運が良ければ 近くにおるだろう\n助けが必要なら\n遠慮せず声を かけとくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: "Doctor: わかっとるよ\n誰を信じるのも難しい時代よな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: "Doctor: ありがとう\n誰かの助けになれるといいが"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: "Doctor: 中に入れてもらえるなら\n病院に なにが起きたか話そう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: 長い話になる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: "Doctor: 下町には病院があった\nだがの…"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: "Doctor: 中に入れてもらえるなら\n病院に なにが起きたか話そう"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: "Doctor: そしたら今や…\n病院そのものが なくなるとはの\nそれで放浪しながら\n助けられる者を助けとる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: "Doctor: 病院は いつも資金不足でな\n職務以上の仕事を こなしとった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: "Doctor: 昔は人を手術しとってな\n外科医だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: どこから来たんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: "Doctor: それで ちょっと覗いてみようかとの\nだが ドアが施錠されとって\nだから破る前にノックをな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: "Doctor: こんなにも静かなら 実を言うと\n誰も住んでないのかとな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: "Doctor: 安全…\nそれと 暇を潰せる なにかをの"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: "Doctor: ああ 探しとるよ\nだがの 皆と同じものだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: なんで そんなことを？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: どこから来たんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: あるいは 耐えきれん悲しみに泣く声が'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: あるいは 苦痛に満ちた悲鳴が'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: "Doctor: おおよそ 酔っ払いの叫び声が\n聞こえるもんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: "Doctor: 人で いっぱいの家なら\n夜に静まり返っとらんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: "Doctor: なんの話だね？\nハハ 無論 違っとるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: なにか探し物でも？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: ウチを見張ってたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: "Doctor: 夜分遅くに すまんね！\n入れてくれんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: 実に静かな夜だの'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: "Doctor: おっと\n誰もおらんものかと"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: また会うことになるぞ 若造'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: "Wolfhound: ほう…\nそういうことか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: "Wolfhound: 今は力が すべてだ 若造\n転がすか 転がされるか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: いい子だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: 要は 波風立てに来たわけじゃない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: "Wolfhound: 知らずにいたほうが 身のためだ\nお前が どう生き延びてきたか\n俺も鼻を突っ込んでないだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: おっと 大した威勢だな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: "Wolfhound: だが お前は まだ秩序を保ってる\n大した奴だな 若造\nどう維持しているのか興味がある"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: "Wolfhound: どこに行っても映る景色は同じだ\n恐怖に目が眩み\n大局を見失ってる連中ばかりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: どの家にも長居しなかった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: "どうやって そんなに\n長く生き延びたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: "何軒の家を\n渡り歩いたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: 逆らう奴は 朝までに犬死にだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: "Wolfhound: これが新しい秩序だ\n力こそ正義"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: "Wolfhound: 否定してたら 生きたまま食われる\n骨すら残らずな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: 俺たちは みんな獣だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: "どうやって そんなに\n長く生き延びたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: "何軒の家を\n渡り歩いたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: "Wolfhound: 今は単純だ\n喉笛を噛みちぎった奴が勝ちだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: "Wolfhound: 規則も道徳も燃え尽きた\n最早 なんの意味もない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: "Wolfhound: 他の家を回ったか？\n通りは歩いたか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: あなたも「獣」なんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: なんの話です？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: ようやく…抑え込まずにすむ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: "Wolfhound: もう社会なんて存在しない\n獣どもが好き放題 暴れ回ってる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: 世の中 全部 御破算だな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: おい'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: なのに どうして 抗う？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: もうすぐ すべてが終わる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: なにに しがみついてる？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: どうして？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: "SuperFake: 逃げて逃げて 逃げてばかり\n人から 真実から"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: だから 僕がいる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: でも 君の手じゃ どうしようもない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: そうだよねえええ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: 怖い？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: さあ いまわの際だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: 何人か追い出した
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: "余計なのは全員\n追い出した"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: 正しい人だけを入れた
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: 人以外が大勢いる
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: 誰も入れてない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: 人なら大勢いる
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: 中に僕らはいる？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: でも 気になるのは別のこと'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: なにか感じる？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: "SuperFake: ただ…消える？\n永遠に？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: "SuperFake: 君は死ぬ\nその後は？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: "SuperFake: どうやら君は\n先のことを考えてるみたいだね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: "SuperFake: 何故まだ生きてるか\nよく考える？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: 未知が怖い？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: 何人か追い出した
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: "余計なのは全員\n追い出した"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: 正しい人だけを入れた
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: 人以外が大勢いる
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: 誰も入れてない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: 人なら大勢いる
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: 家に一人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: 僕らを入れた？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: でも 今は…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: 明日じゃなければ明後日'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: 今日じゃなければ明日'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: 君は死ぬ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: でも 結末は同じ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: 変化を もたらすため？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: 僕が送られたのは理由がある…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: "SuperFake: 選ばれたと考えたら どう？\nハハハ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: 今さら そんなこと？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: どうしてドアを破らない？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: なんで来るんだ？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: "SuperFake: 安心して\n助けてあげるから"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: "SuperFake: おかしいな\n君がなにも 感じてないなんて"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: 言えないね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: どうしてドアを破らない？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: なんで来るんだ？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: もう首筋に 息吹きかけてるよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: "SuperFake: でも 感じない？\n死が どんどん 迫ってるのを？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: それだけ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: 言われたこと 伝えてるだけ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: 終わりとは？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: どういう意味だ？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: "SuperFake: 僕らじゃない\n君たち自身が終わりを もたらすんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: すべてが終わりに向かってる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: "SuperFake: 言われたんだ\nこれが君との最後の会話だって"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: また会える？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: それじゃあ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: 僕は命令に従ってるだけ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: もっと強大な力があるんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: まさか 僕がここを仕切ってるとでも？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: 変化よりも悪いことが 君には待ってる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: "SuperFake: もう僕らも あまり見ないね\nましてや君みたいに\n家に閉じこもってるのも"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: おやおや'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: おいで'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: "SuperFake: ほうら\nルールどおりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: ほほう…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: 一人じゃない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: 一人だ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: 家に一人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: "SuperFake: でも 行く前に\n新しいルールを試そう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: "SuperFake: 残念…\nもう行くよ…ひとまずは"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: 一人じゃない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: 一人だ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: 家に一人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: でも まずは…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: やってみよう'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: 単純だよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: 後にしてもらえるか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: 意味不明だ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: 君は 僕にドアを開く'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: 僕らが二人以上 家にいたら…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: そこから正そうか'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: もう気にもならない？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: つれないね？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: 後にしてもらえるか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: 意味不明だ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: 今や 犬が死体に宿っているから'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: 君は 僕にドアを開く'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: 僕らが二人以上 家にいたら…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: 新しいルールを試そうか'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: 助けが必要そうだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: 大変だね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: 気にもならない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: なにも感じない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: 君の周りでは 奇妙なことが起きるね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: 誰のことか わかるだろう？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: "SuperFake: 言葉一つ\nただの一つの言葉で…\nけれど なんて言葉だろう！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: "SuperFake: それに 君の仲間が一人\n不死身になった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: …僕にもだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: 変化が 君に迫っている'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: 感じるかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: "SuperFake: 次に会うときは…\nもっと面白くなるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: 君はリズムを外れつつある'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: 暮らしは変わったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: "SuperFake: わかってるんだろう？\nもう元には戻らない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: "SuperFake: もう世界は犬のものなのに\n最後に残るのは犬だけだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: どうして？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: "SuperFake: まだ 人生を繋ぎ止めようと\nしてるんだね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: "SuperFake: じゃあ ドアを開けて\nちょっとしたものを\n置いていってあげる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: 誰とも うまくいかなかった？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: 結局 一人ぼっちに なったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: 一人じゃない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: 一人だ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: 家に一人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: 聞かせてよおおお…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: "SuperFake: 君が止められるのは\n鼓動だけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: "SuperFake: 洪水を 火災を 腐敗を\n止められる？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: 死を止められる？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: それで なにができるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: 一人じゃない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: 一人だ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: 家に一人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: 聞かせてよおおお…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: 死に？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: 宇宙規模の大災厄に？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: "SuperFake: でも どう抗うんだい\n自然災害に？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: よく わかるよ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: やれるだけやってる
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: 俺には どうしようもない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: "SuperFake: それとも 自分で\nなんとかしたい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: ありがたいことだね？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: "SuperFake: なにもかも\n僕らのために定められてるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: 考えるだけ無駄だよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: やれるだけやってる
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: 俺には どうしようもない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: "SuperFake: あるいは\n自ら手を下すべきかもしれないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: あいつらが秩序を もたらすかもね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: "SuperFake: 次から次へ\nだろう？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: 近頃 大変だよね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: どうだかな
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: 仕事をこなしてる
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: "SuperFake: あれを どう思う？\n防護服の奴"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: まだ ここに立てこもってたんだ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: "Greatmother: 子供らも 連れてくっからよ\nおっかぁが面倒 見てやっから\nぼんず 一人じゃ死なせんて\nハハハハハ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: ハハハハハ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: "Greatmother: いんや いっそ\n誰にも開けんほうが ええ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: "Greatmother: ようがす\nけんど黄色い連中が来ても\n開けちゃなんねぇよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: "Greatmother: 開けちゃ最後 みぃんな 知らんとこさ\nさらわれちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: "Greatmother: おうさ ありがとよ\nけんど黄色い連中が来ても\n開けちゃなんねぇよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: "Greatmother: おっかぁは もう 生きるだけで\n精一杯だねぇ ぼんず"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: "Greatmother: 何人かは そんまま 連れてかれた\nほんに 気の毒にさぁ\n残りは あんま追われんかったねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: "Greatmother: 居座ろうとしたもんも おったけんども\n黄色い連中 無理くり 引っ張りよった\n目に付く先から かっさらうみてぇに"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: 建屋 まるごと やられちまったよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: "Greatmother: 残ったもんにゃ 失せろだの\nなぁんもなかった みてぇに"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: "Greatmother: 黄色い連中が飛び込んできてさ\nみぃんな 尻 突き飛ばされちまった\nついでに 何人か連れ去られてよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: "Greatmother: うちん建屋が 太陽に かまされただの\nわけんわからんこと 言いよってからに"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: 大勢 暮らしてたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: なぜ追い出されたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: "Greatmother: ずぅっと 駆け回りっぱなしよ\n腰 落ち着けっとこ 探してさぁ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: "Greatmother: 近所ん連中 みぃんな\n追い出されちまって\nどこ行ったか 誰ちゃ知らん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: "Greatmother: 誰ぞ探しとるわけじゃねぇよ\nおっかぁは 頭 横にできっところが\n欲しいだけさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: 大勢 暮らしてたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: なぜ追い出されたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: "Greatmother: みぃんな 散り散りに逃げてさ\nあたしゃ 生き延びったくて\nここまで来たんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: "Greatmother: 避難所もなけりゃ 寄る辺もなし\nどこさ 行けってんだか\nどうしろってんだかねぇ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: "Greatmother: 黄色い連中に 建屋から\n追い出されちまって それっきりさ\n行き先なんざぁ 誰も用意せんでな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: "Greatmother: あたしゃ 子供らと\nこっから数ブロック先に\n住んどったんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: 誰か探してるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: 誰ぞ おるか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: おらあ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: "Cold: そうか 弾を無駄にしたくないよな\nさよなら"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: 撃ってくれないか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: 君の手 火薬の臭いが染みついてる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: それじゃ さよなら'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: わかった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: "Cold: 天井が少し低いかな\nまあ 構わない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: "Cold: 出ていくよ\n願ったりしない\n邪魔だって もうしない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: 中に入れなくてもいい'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: 無理だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: "Cold: もっと酷くなったら？\n死すら許されず 苦しみが続いたら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: 服を脱ぐのが怖いんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: "Cold: 他の人は太陽に焼かれてるのに\n僕ときたら幾重にも着込んで\nその癖まだ凍えてる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: ずっと寒いんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: 上着を脱いでください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: "暑さがなんとも\nないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: つまり…ずっと探してる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: "Cold: 一度だって 安らぎなんて\n見つけられてない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: 上着を脱いでください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: "暑さがなんとも\nないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: "Cold: 後で お願いするよ\nまだ 君を信じていいか わからない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: "Cold: 違う\nただ 一つ頼みがある"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: "Cold: もう どうだっていいだろう\n僕が来訪者か気にしてるのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: "どれぐらい探して\nきたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: 君の家で 安らぎをもらえないか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: "Cold: 暑さは なんともない\n静かに休める場所を探してるだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: どうも'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: "Hunter: 誓ってやる\n害獣は一匹たりとも生かしはしない\n見ていろ 小僧"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: "Hunter: …夜明けまでに\n俺の喉を かっさばくことだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: "Hunter: ふん それが最善かもしれんな\nお前も奴らの仲間かもしれんからな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: "Hunter: 二人で皆殺しだ\nあたり一帯 害獣一匹\n踏み入れさせん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: "Hunter: やはり腰抜けじゃない\n背骨に芯が通っているな 小僧"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: "Hunter: 人間らしいのは 着込んでる皮膚だけだ\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: "Hunter: 一目散に逃げ出したら\n案の定 撃ってきた\n害獣の戯れにな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: "Hunter: 気を抜く隙を待ち構えられていて\n寝込みを かっぱらわれた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: "Hunter: ライフルを持っていた\nそれで 命を落としかけた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: "Hunter: 更生の機会など 与えるものか\n小賢しい害獣どもめ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: "Hunter: 一度 逃せば また戻ってきて\n喉笛を噛み切られる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: "Hunter: お前は木偶の坊じゃないな 小僧\nだが 俺は見逃す気はない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: お前と同じだろ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: では 武器はどこに？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: 来訪者を狩ると？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: "Hunter: 言っとくがな 小僧\n奴らは なにか企んでいる\n叩き潰すしかない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: "Hunter: 忌々しい太陽の騒動が始まって以来\n巣穴から ぞろぞろ這い出してくる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: "Hunter: この街でか？\n骨休めする場所が欲しかっただけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: では 武器はどこに？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: 来訪者を狩ると？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: "Hunter: 害獣は根こそぎ駆除するしかない\n一匹 残らずな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: "Hunter: 俺たちに化けて…家に忍び込み\n修羅場を始めるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: "Hunter: 家という家で 死人が出ている\n引き裂かれた奴までな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: あの来訪者どもの仕業 見たか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: なにを探してるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: どうして旅を？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: "Hunter: だが もう昔みたいに歩き回れん\n歳を取る ってのは そういうもんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: "Hunter: ここいらの人間じゃない\n一つ所に長居できる\n性分じゃなくてな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: "Hunter: おい 小僧\nここらの縄張りの調子はどうだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: さらばだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: "Prophet: すまない\n私は行かねば"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: もう 読む力が残っていない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: "Prophet: 「吠えたける 我らが若さ 火の如く\n火勢さながら ルーアンのよう」"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: さらばだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: "Prophet: 感謝する\nだが 助けにはならなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: なんと無念な'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: "Prophet: 「二つ世の 狭間に歌う 声一つ\n火炎に焔 共に来たれよ」"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: "Prophet: 今は行こう\nさらばだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: "Prophet: 一つ思い出した\n感謝する"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: "Prophet: ああ\nそういうことか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: "Prophet: 「走らざる 我らが列車  いずこへも\n車輪の下に 轟く道よ」"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: 十ページ目では？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: 二百ページの真ん中を
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: 終わりのほうを
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: "Prophet: 恐ろしいのだ\nお前なら 助けとなるかもしれん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: "Prophet: 本で占ったときを覚えているか？\nもう一度 頼めるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: お前に向けられた言葉なのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: "Prophet: それから 一つの言葉を覚えている\n跳べ と\nなにを意味しているのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: "Prophet: だが 以前は わかっていた\nそれは覚えている"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: "Prophet: 妙な質問だ\nもう なにも理解できん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: 十ページ目では？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: 二百ページの真ん中を
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: 終わりのほうを
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: 助けになるかもしれん'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: 今一度 占ってくれないか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: 己を見失っている'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: "Prophet: わからない\n私に向けられたものか…\nあるいは お前への言づてか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: "Prophet: 一つの思考が脳裏を巡る\n跳べ と"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: 最早…思い出すことすらできない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: 死にかけてるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: 誰のことですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: ならば なぜ始めたのだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: "Prophet: そして今は？\nすべて取り上げるつもりか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: あの女が支えてくれていた'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: 死にかけてるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: 誰のことですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: "Prophet: 私と遊びに興じるな\n置いていけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: "Prophet: 今になって気付いた…\nとうに終わっていたのだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: 思考が…静まってしまった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: 願うのが遅すぎたな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: "見た目が…\n酷いですよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: "玄関先で\n死なないでください"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: "Prophet: あの女\n私を捨てたのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: "Prophet: 視界が薄れていく\nもう ほとんど見えない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: お前の顔を忘れてしまった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: 一人で考えさせてくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: "Prophet: 下で見つけても…跳びこむな\n今は助けにならない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: そして お前は…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: やらねばならなかった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: "Prophet: …思い出した…\nあれは正しき行いだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: 休まねば'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: "Prophet: 見つけても…跳びこむな\nまだだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: だが…一つ思い出した'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: "Prophet: すまない\n思考が明瞭じゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: 本当ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: なぜ必要なんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: お前が見つけるべきものが'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: "Prophet: 掘るんだ\nなにかが埋まっている"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: "Prophet: 次に来るものを思い出した\n地下室"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: "Prophet: 今は…靄がかっている\nお前が見える\n暗き森に迷い 獣に囲まれている"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: "Prophet: だが 理由があるのだ\n明瞭に覚えていた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: "Prophet: すまない\n奇妙に響くのは承知の上だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: 本当ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: なぜ必要なんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: 土の下までは見えないが'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: "Prophet: 掘ってみるがいい\nなにかがある"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: "Prophet: 地下室\n持っているだろう？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: "Prophet: お前に会うまでは\nすべてが明瞭に感じられた\n今は…霧がかっている"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: "Prophet: ああ\n怖がらせたなら すまない\n独り言だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: "あなたを信じたこと\n後悔しはじめてます"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: まるで意味不明です
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: "Prophet: だが今は…\nなにかが間違っている\nあのキノコ男のせいかもしれん…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: "Prophet: 正しく頼みさえすれば\n助けに来よう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: "Prophet: だが恐れなくともよい\nただ知らぬまでのこと"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: "Prophet: ああ\n我らより強大な存在がある"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: "Prophet: いや\nそんなはずはない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: "あなたを信じたこと\n後悔しはじめてます"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: まるで意味不明です
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: "Prophet: 灰から新たに芽が伸び\n空を目指すだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: "Prophet: 極初期にも起きたことだ\nなんら問題ない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: "Prophet: 恐らく お前が要因ではない\nあの女でも…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: "Prophet: 力が弱まっている\n以前ほど 遠くまで見通せない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: "Prophet: すでに助けてもらっている\nただ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: 独り言ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: "あの\n助けがいります？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: あの破壊のためか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: "Prophet: 具合が悪い\n奇妙な感覚だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: "Prophet: そこにいるのか？\n扉の前に？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: 数日後 また会えることを願っている'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: "Prophet: 今は その感覚が薄れている\n正しき道を歩んでいるのだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: "Prophet: 初めて来たとき\n感じたのだ…妙な気配を"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: "Prophet: 誰も検査しないのが一番だ\n今後 二日間はな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: "Prophet: 要望と受け取ってくれて構わない\nだが…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: "Prophet: ここまでだ\nすでに語りすぎた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: 数日後 また会えることを願っている'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: "Prophet: 安寧ならば与えられよう\nせめて前途の助けとなろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: "Prophet: 誓うならば\n導き続けよう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: 一人もだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: "Prophet: だが…\n二日間は検査を控えたほうがいい"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: "Prophet: なにも\n口が過ぎた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: なにが起きるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: "それで…\nどうすれば？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: "Prophet: ラジオは言及するだろうか\nお前の耳に入るだろうか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: お前では止められない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: "Prophet: とはいえ 見透かせるものもある\n凶事が近づいている"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: "Prophet: その存在の恩寵により\n私は誰よりも遠くを見通せる\nだが すべてを知るわけではない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: "Prophet: お前は より近づくことになる…\n極めて強大な存在に"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: なにが起きるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: "それで…\nどうすれば？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: "Prophet: ラジオは言及するだろうか\nお前の耳に入るだろうか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: "Prophet: お前が原因ではない\nだが お前の身にも手が及ぶ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: そして  やがて来たる凶事も'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: "Prophet: 万事を知悉しているわけではない\nだが お前のことならば…\n選んだ道の たどり着く先を知っている"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: "Prophet: 私は誰よりも先を見通せる\n天与の賜だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: "なぜ猫を連れた人を\n入れろと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: どうして猫のことを？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: "Prophet: 連れてきた者を どうするかは\nお前 次第だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: "Prophet: 完璧だ\n猫を連れているな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: それで さらばだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: "Gasmask: 今すぐ\n二人\n連れていく"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: お前は残って死ね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: 全員 連れていく'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: ドアを破る'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: 壁と話してるみたいだな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: "Gasmask: 了解した\n気をつけるんだな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: 同感だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: もう誰も差し出さない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: 二度と会いたくないな
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: お前も処理することになる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: "Gasmask: 抵抗した奴は過去にもいた\n全員 処理した"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: "Gasmask: 今すぐ二人 差し出すか\nこちらからドアを蹴破り\n全員 連行するかだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: 議論するつもりはない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: 問答無用だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: もう誰も差し出さない
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: 二度と会いたくないな
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: "Gasmask: それで来訪者と戦う方法を見いだせる\nそうならなくても\nもう顔を合わせずすむ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: "Gasmask: 全員じゃない\n二人だけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: あと二人だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: "無用の長物なら\nなんのためにいるんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: "どうすれば\n片付くんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: "Gasmask: 生き延びる術を考え出さないと\n別の誰かが決定権を持つ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: "Gasmask: 降りてくる計画は\n不可能なものばかりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: "Gasmask: 当局は街全体を吹き飛ばす準備中だ\n押さえ込めなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: クソ災厄だよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: "無用の長物なら\nなんのためにいるんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: "どうすれば\n片付くんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: "Gasmask: 茶番を続けるなら\nこの家にいる全員を連行するぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: 世界は崩壊寸前なんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: ふざけるのはよせ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: 大惨事とは？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: 俺の仲間はどこだ？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: さもなくば 大惨事の恐れがあります'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: さらなる人員を必要としています'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: "Gasmask: 対象は速やかに返還します\n感謝します"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: "Gasmask: 速やかに\n人員を\n渡すように"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: 我々は この街を保護しています'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: 抵抗すれば さらなる大爆発が起きます'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: "Gasmask: 頑迷固陋にも\n我々の行動を妨げた人の末路です"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: 背後の景色を鑑賞していますか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: いいでしょう'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: …クソ面倒だな'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: 来訪者の処理も実施します'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: "Gasmask: 一旦 二名を連行しますが\nいずれ返還します"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: 理解に感謝します'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: "Gasmask: 無論\n役立ちます"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: "お断りです\nもうたくさんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: "わかりました\n役立つなら…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: 事態は速やかに安定します'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: "Gasmask: 誰でも構いません\n同居人の方を差し出してください\nただちに"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: 今回は二名を連行します'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: その通りです'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: "お断りです\nもうたくさんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: "わかりました\n役立つなら…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: "Gasmask: そうすれば進行が加速し\n最善の結果へ繋がります"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: 二名を求めます'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: 人員が必要です'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: "また誰か\n差し出せと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: 今度は なんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: 事態は統制下にあります'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: 職務を遂行しなければなりません'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: "Gasmask: それほど単純ならば\nFEMAは必要ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: "また誰か\n差し出せと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: 今度は なんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: "Gasmask: 一層の協力により\n終結が早まる可能性があります"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: "Gasmask: 恐縮ながら\n事態の統制に さらなる人員を要します"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: "Gasmask: 依然として研究中です\n懸念には及びません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: "いつ来訪者を\n駆除できるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: "こんなこと\nいつまで続くんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: そこは…私の故郷でした'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: "Gasmask: その結果は承知でしょう\n来訪者の拠点を\n一掃せざるを得ませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: "Gasmask: あなたに その権限はありません\n我々の行動を妨げる人は大勢います"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: 要求は認められません'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: "いつ来訪者を\n駆除できるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: "こんなこと\nいつまで続くんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: その結果 暴力の激化に繋がります'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: 来訪者を匿えば増殖を招きます'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: "Gasmask: 拒めば さらなる感染爆発の\n恐れがあります"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: 余波です'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: "連行した人を\n返してください！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: "街でなにが\n起きてるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: 早急な対応が望ましいです'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: さらなる人員を必要としています'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: こんばんは'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: "Gasmask: 所定の手続きに従い 進行します\n速やかに協力するほど 早く終わります"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: 選択肢はありません'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: 誤解です'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: "Gasmask: 検査の完了後\n次の手順を伝えます"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: "Gasmask: 心配には及びません\n処置は厳格ですが\n休憩時間も設けています"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: "そんな検査\n興味ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: "わかりました\nそうするしかないのなら"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: "Gasmask: 太陽の影響を徹底的に研究すべく\n同居人から もう一名が必要です"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: 結果は定かではありません'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: "そんな検査\n興味ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: "わかりました\nそうするしかないのなら"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: その後 隔離区域から返還されます'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: "Gasmask: 検疫後は 隔離が義務づけられています\n対象は しばらく我々のもとで\n滞在することになります"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: "Gasmask: なるほど\nもう我々の班が来ていましたか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: 返す？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: "前回の調査は\nどうでした？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: "いつ同居人を\n返してもらえるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: "Gasmask: 心配には及びません\n長くは取らせません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: "Gasmask: FEMAの者です\n近隣の定期調査です"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: こんばんは'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: 気をつけなよ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: "Luka: その先に待ってるのは…真っ暗闇だ\nあっという間にな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: "Luka: あんまり 死ぬこと考えすぎると\n徐々に蝕まれちまうぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: 悲しみに埋もれないでくれよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: "Luka: そうすれば…\n死ぬことばかり考えずに\nすむかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: "Luka: アンタが喜びを感じてた頃を\nどうか思い出してくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: "Luka: 言ってること 付いてこられてるか？\n近頃 人生がホロ苦すぎる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: "Luka: あの頃 ただ生きることだけが\n目標じゃなかっただろ\n作ろうとしてたんだ…美しいものを"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: "Luka: でも たまにはな\n良かった頃を思い出させてやれば…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: "Luka: なんで 騙す なんて言うんだ？\n今 みんな痛みに どっぷり浸かってる\nその理由だって理解できる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: "Luka: 絶望に浸ってる場合じゃないだろ\n今なんかは特に"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: "Luka: 思い出してみなよ\nなにが喜び だったのか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: "Luka: こんなことに なる前\nなにを するのが好きだった？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: "Luka: 原因なんて いくらでもある\nでも なにがアンタを 幸せにするか\nオレには判断できない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: "つまり 人々を\n騙したいと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: "なにがそんなに\n幸せなんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: "Luka: 世界に残された 微かな良いことさえ\n絶望が見えなくしてる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: "Luka: 恐怖が人から奪っちまったんだ\n喜び ってのが どういうもんだか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: "Luka: そうだな…オレも久しく\n笑顔なんて見てなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: おっと 笑ってる理由か？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: "Luka: なにか マズいか？\nオレとっちゃ 普通だけど"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: "つまり 人々を\n騙したいと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: "なにがそんなに\n幸せなんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: "Luka: 大丈夫 って言い続けてたら よう\nもしかしたら 多少は楽になるかもだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: "Luka: 次の世代のため 芸術のため\nただ…生きる喜びのため"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: "Luka: そう 厳しい時代だ\nだが 戦う価値は わんさかある"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: 外は すっかり 怒りまみれだろ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: 表情 どうかしました？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: "なぜ そんなに\n楽しそうなんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: 今夜 オレを休ませる ってのはダメ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: "Luka: ようよう！\nドア向こうのアンタ！\n足音 聞こえてんぜ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: 安全そうには 見えないね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: "BigLebowski: つうか\nアンタのノリ 最悪"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: "BigLebowski: いいよ\nクソ食らえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: "BigLebowski: まっ…\nどうだっていいけどさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: "BigLebowski: あっ カーペットまで あるじゃん\nいいね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: "BigLebowski: マジで！\nうわぁ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: "BigLebowski: アンタ マジでガキンチョを\n外に放っぽり出すつもり？\nカンカン照りの太陽の下に？\n来訪者がウロウロしてんのに？"
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: "BigLebowski: どうだっていいだろ\nアタシは ここにいんだから？\nそれに 屋根のあるトコが いるんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: "BigLebowski: オフクロは日光浴 好きだったしさ\nだから まぁ…\nそれも楽しい可能性なんじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: "BigLebowski: それか もう来訪者になってるかもね\nお似合いだよ ハッ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: "BigLebowski: さぁね どうせ家だろ\n他に どこがあるっての"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: "BigLebowski: もしアンタも クズなら言っとくけど\nアタシは 許さないから！\n手出ししたら ブッ飛ばすよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: "BigLebowski: でも たまにさ\nマジ最悪なクソ野郎に出くわすんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: "BigLebowski: でも カラッケツでさ\nそれで 誰かと交渉するか\n地下室に忍び込むか ってトコ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: "BigLebowski: それが人生ってヤツ 強いられるんだ\nアタシにとっちゃ…旅って感じかな\n世界を見たいし いろんなトコをね\nどこか 新しい家も見つかるかもだし"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: 親御さんは どちらに？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: "地下室に隠れて\nなにを？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: "BigLebowski: もうクタクタでさ\n地下室も 他のマトモな隠れ場所も\n見つからなかったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: "BigLebowski: ちょっと図々しいけどさ…\n入れてくんない？\n次の日まででも いいから"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: 親御さんは どちらに？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: "地下室に隠れて\nなにを？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: "BigLebowski: 地下室に隠れんのウンザリでさ\nこれじゃ話し方だって\n忘れちゃうよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: "BigLebowski: いや ちょっと…\n休ませてもらいたくてさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: ええ ウチです
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: 誰か探してるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: "BigLebowski: ここって ほら アンタんトコ？\nていうか…アンタんチ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: "BigLebowski: こんばんは\nいや どうも…かな\nそっちのがマシ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: "Couple: ほら とっとと足を動かせ\n俺だって 疲れてるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: また探し回らないとね ハニー？'
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582080
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582081
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776384
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776385
    m_Localized: （注文を受け取る）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: "Couple: なにを突っ立ってるんだい？\nほら ハニー\n旦那さんが 招いてくれたんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: ああ ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: "Couple: わかったよ\n迷惑かけて すまないね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: "Couple: ちょっと人見知りしてるだけだ\n大丈夫だよ ハニー\n休めば すぐ元気になれるからね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: "Couple: おっと すみません\n差し出がましい質問だった\n私の出る幕じゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: "Couple: でも 奥さんには頭が上がらないんだ\n奥さんなしじゃ\nここまで やってこれなかった\n貴方は なにに支えられてるんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: 全部が重なって…辛いものだね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: "Couple: まあ この頃は疲れるばかりだろう？\n来訪者に 暑さに クビに…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: "Couple: ああ 許してほしい\nこんな風に 奥さんを急かしちゃ\nいけなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: だよね ハニー'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: "Couple: でも また別の日に\nみんなで話せば いいんじゃないかな\nもちろん また会えるとして"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: "Couple: 本当に疲れてるんだ\nすみません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: "Couple: もちろん 話せるとも！\nハニー なにか言って？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: "どうして そんなに\n疲れてるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: "奥さんは自分で\n話さないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: "Couple: そう大したお願いでも\nないんじゃないかな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: "Couple: でも 奥さんが もうクタクタで\n少し休ませて やりたいんだ\n少しだけでも 泊めてもらえないかな？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: "Couple: まあ…他の避難先を\n探すことも できるだろうけれど"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: "どうして そんなに\n疲れてるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: "奥さんは自分で\n話さないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: "Couple: 大きな家で 道から少し外れてて\nお節介な ご近所さんも いない…\nおかしな奴だって 来なさそうだろう？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: "Couple: どう説明したものか 難しいけど\nハハ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: "Couple: 正直 言って あなたの家が 一番\n安全そうに見えるんですよ\nねえ ハニー？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: "あなたこそ 迷惑\nそのものだったら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: ウチが安全に見えます？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: "Couple: しばらく 泊めて もらえないかな？\nもちろん 迷惑でなければ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: "Couple: やあ こんばんは！\n最愛の奥さんと二人で 嵐をしのげる\n安全な場所を 探してるんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: …よし 良さそうだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: ささやかな贈り物 アタシからの'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: 家の下で 猫ちゃんを見つけて'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: "Ballerina: おいで 猫ちゃん\n走って遊ぼう！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: ここで くつろぐ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: とっとと地獄に行け
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: "…いいでしょう\n入ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: 考え直して'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: 猫ちゃん 見て'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: "Ballerina: 猫ちゃんを いじめないで\n猫ちゃんは寒いの嫌いなの"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: "Ballerina: かわいそうな踊り子\n寒さに凍えて…すごく悲しい…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: 開けるの？開けないの？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: 合格？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: 足りない？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: 腕ふたつ 脚ふたつ 頭ひとつ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: "Ballerina: で？どうする？\nなにする？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: アタシ ボールアリーナ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: 多分 踊る'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: 踊り見たい？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: それで？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: 人間だと証明しろ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: お前 人間じゃないな
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: おかしなこと言うね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: "Ballerina: じゃあ どうするの？\nもっと話す？それとも？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: アタシ？うん'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: 人間だと証明しろ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: お前 人間じゃないな
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: ふふ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: "Ballerina: 違うんじゃないかな\nなんで？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: "似ているような…\n誰かに"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: 誰かに送られたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: ここは暑くない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: ここ見えたから 歩いて来た'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: 街 見える？あそこ住んでた'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: "似ているような…\n誰かに"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: 誰かに送られたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: バレエ わかるよね？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: 踊ってる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: "どうやって ウチを\n見つけたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: "Ballerina: 呼ばれた\nだから来た"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: "Ballerina: 開けるの？\nはい？いいえ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: "Ballerina: 箱一杯のビール 引き出し 生ハム原木\nわかんないや なんでもちょうだい"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: "どうやって ウチを\n見つけたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: どうすれば 力になれるかな？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: "Ballerina: 質問 多過ぎ\nうん 知ってるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: なにが ほしいんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: "知り合いですか…\nあの坊主頭の男と？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: "Ballerina: 開けるの？\n開けないの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: やっ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: "Teacher: もし助けを求める子供に出会ったら…\nどうか 世話してあげて ください\nさようなら"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: "Teacher: 責めはしません\nですが お願いします…\n行く前に 一つだけ 約束してください"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: "Teacher: ですが ありがとうございます…\n話を聞いてくれて\nそして 入れてくれて"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: "Teacher: もう 子供たちを取り戻す術は\nなにも ありません…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: "Teacher: なにもかも 焼き払われました\nそして 私は見せつけられました"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: "Teacher: 一体 子供たちが\nなにをしたと いうんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: "Teacher: 私たちは なにになって\nしまったんでしょう？\n無力な子供たちに裁きを下す\n心なき群衆に？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: "Teacher: 来訪者の徴候が出ている\n子供たちを匿っているのを\n見つかってしまったんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: ええ…街の人たちです'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: "Teacher: 今でも 子供たちの怯えた瞳が\n見つめてくるのを感じます…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: "Teacher: 私…無理やり見せつけられました\nドアに鍵をかけ 窓を釘で打ちつけ…\n建物に火を放つ様を…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: "Teacher: やったのは街の人たちです\n子供たちが来訪者かもと怯えて"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: みんな死んだんです…炎に包まれて'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: みんな…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: どうして火事が？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: "子供たちに なにが\nあったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: "Teacher: でも今では…\nみんな逝ってしまいました\n火事で一人も生き残れませんでした…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: "Teacher: ある子は ほんの少しでも\n来訪者の徴候を見せただけで\n親に捨てられていました"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: "Teacher: ある子は親をFEMAに連れて行かれ\nある子は親を殺され\nある子は…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: "Teacher: みんな親を失っていました\nそれぞれの理由で"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: "Teacher: 世界が崩壊を始めてから\n見捨てられた子供たちを\n連れていました"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: "Teacher: 教師だったんです…\n幼稚園で教えていました"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: どうして火事が？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: "子供たちに なにが\nあったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: "Teacher: でも 足りなかったんです…\n救えなかったんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: "Teacher: 子供たちは ただ\n世話する相手が必要でした\n愛してくれる誰かが\n私は精一杯やりました…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: "Teacher: 古い幼稚園の建物で\n一緒に暮らしていました"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: "Teacher: 「不浄」と呼ばれた子供たちを\n引き取っていたんです\n来訪者かもと恐れられた子供たちを"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: "Teacher: 私…見捨てられた子供たちに\nほんの少しでも\n希望を与えたかったんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: どなたですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: どうしたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: "Teacher: 胸が苦しくて\n話を聞いて もらえませんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: "Teacher: すみません お邪魔して…\n少し お時間もらえますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: "Dude: 自分を大事にな…\nそれと お前ぇのダチも"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: "Dude: 構わねぇさ 兄弟\nわかってっから 気にすんな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: 兄弟よぉ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: そのうち 映画化されっかもな！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: "Dude: おいおい\nマジ 人生最高の出来事じゃねえか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: "Dude: いよっしゃぁ！\nあんがとな 兄弟！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: いつか映画の中に入りたかったんだ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: 本よか全然おもれぇだろ 兄弟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: "Dude: 映画には なんだって あんだ\nドラマも裏切りも陰謀も！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: でもよ 映画だぜ おい…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: "Dude: まぁ ニュースが あんなだろ？\nそりゃノリも悪くなるわな 兄弟"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: "Dude: どいつもこいつも ディスりあってよ\nこの世の終わりみてぇな ネタばっかで\n冷めんぜ マジで"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: "Dude: まっ そうだな\n外はメチャクチャだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: "Dude: わぁったよ 頭 冷やすっての…\nでも頼むぜ 入れてくれよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: "Dude: マジ パねぇだろ 兄弟！\nダチが そういう同人誌 読んでたぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: "Dude: 想像してみろよ\n宇宙に行って エイリアンに手紙\n送りつけたら って…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: "Dude: なんつぅか まだ存在しねぇ技術を\n頭ん中で先に描いちまうんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: なぁ SF作家って未来予知してんだろ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: "Dude: 兄弟よぅ！\nオレぁマジで言ってんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: "本当に外が どうなってるのか\nなにも 知らないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: なに言ってんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: "Dude: それと食料だな ああ\n食料が わんさかいる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: "Dude: あと ショットガンとか\n手榴弾みたいのは あるか？\n火力なしじゃ どうにもなんねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: "Dude: 信じろって 兄弟\n答え次第で 作戦はガラッと変わんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: "Dude: それと ウイルス由来か？\nただのアンデッドか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: "Dude: どうなんだ？\n古典的な遅いゾンビか？\nそれとも速くてヤベェのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: "Dude: こんなの映画で山ほど見てきたぜ 兄弟\nサバイバルの達人 ってとこだな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: "Dude: 兄弟 なぁに 次どうなっか\nオレに任せときな って"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: "Dude: ゾンビか！？兄弟！\nやっぱな！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: "本当に外が どうなってるのか\nなにも 知らないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: なに言ってんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: "Dude: よしよし チームは四人な\nだってよ ほら それが生き残るための\n黄金律ってヤツだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: "Dude: ドッカーン！ロケット打ち上げ\n世界を救うミッション開始だ！\nヤベえな 兄弟！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: "Dude: 要は タフな宇宙飛行士チームを\n太陽に送り込みゃ いいんだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: "Dude: 兄弟 それ映画で見たぞ！\nハゲたオッサンが出てくるヤツ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: マジかよ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: "人間の姿をした怪物が\n地面から這い出てきてます"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: "太陽が燃え上がり\n日中 人を焼き殺してます"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: "Dude: マジ教えてくれって 兄弟\nなに見逃しちまったんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: "Dude: 兄弟 外のヤバさ見たか？\n一体全体 なにが どうした ってんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: よっ！調子どうだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: さもなくば アレに見つかる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: "Blind: 神に誓って頼む\n暗くなったら黒焦げ死体に近づくな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: "Blind: 承知した 出ていくよ\nだが 警告させてくれ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: "Blind: ああっ…目を閉じられないのに\n眠れるのだろうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: "Blind: 感謝する…これでやっと\n少しは休めるかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: "Blind: 本来 存在すべきではないのだ…\nアレは存在してはならない！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: "Blind: より大きく…より強く…\nアレは名付けようもない\n焼きた肉の臭いを追って現れ\n我々が蒔いた種を刈り取っていく"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: "Blind: 違う…ああ 違うんだ\nもっと おぞましい存在が いる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: "Blind: 蒼白の男 一人 見たぐらいで\n眼窩から目を引きちぎる とでも？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: "Blind: 神よ…たとえ最悪の敵が相手だろうと\nアレは誰にも見せたくはない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: "Blind: 炭のような黒焦げ死体を\nゆっくりと喰らっていた…\n私の目の前で！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: "Blind: アレは…はじめ 気付きもしなかった\n焼け焦げた肉を貪るのに夢中で…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: "Blind: 唯一の過ちは 間違った場所に\n間違った時間に迷いこんだこと…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: "Blind: アレにとって 我々の悲しみは饗宴だ！\n悲嘆のビュッフェ！\n貪り食らう恐怖と苦痛…精神すらも！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: "Blind: 信じてくれ\n知らずにいるべきだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: 蒼白の男のことですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: なにを見たんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: "Blind: 怪物の姿を消し去ろうと 目を えぐった\nだが 今や見えるのは 果てなき虚無のみ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: "Blind: 目を犠牲にしないと\n正気を保てなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: これは…自分で やったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: 蒼白の男のことですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: なにを見たんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: "Blind: 信じてくれ…アレを見たら\n君も同じことをしたはずだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: "Blind: 古き恐怖に魂を引き裂かれ\n言葉にならない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: "Blind: アレは ずっと目の前にある\n闇に焼き付いて 消えない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: "Blind: 名状しがたいものを見た\n説明は すまい…\n壊れた心の産物に 誰が思い悩む？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: 誰に やられたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: 目を どうしたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: "Blind: やっと…\n避難できそうだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: "Fatman: どこへ行けってんだ？\n終わっちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: "Fatman: なあ…見れば わかんだろ\n具合が悪いんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: "Fatman: 借りなら返す\nこの騒動が落ち着いたらな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: 後悔は させねえとも…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: "Fatman: 今すぐ入れろ\n騒ぎが終わった頃には…\nカネの海で泳がしてやる たんまりな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: "Fatman: 大物を追い返すもんじゃねえぞ\n俺は辺りを仕切ってたんだ\n議員としてな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: "Fatman: ここまで来るのに\nずいぶん時間が かかったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: "Fatman: なあ…入れてくれ\nもう耐えられねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: "Fatman: 本気だぞ 気分が悪い\n冷てえ水がいるんだ 今すぐ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: "Fatman: そうしねえと倒れちまう\n日が昇ったら丸焼けだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: "Fatman: なあ ドアを開けろ\n風呂に入りてえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: "Fatman: …アイスが頭に浮かんじまった\nったく"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: "Fatman: 完璧だ！\nいいじゃねえか\n外で溶けちまうところだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: なぜウチの風呂を？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: ええ ありますよ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: "Fatman: 冷てえシャワー浴びてえだけだ\n使わせてもらえねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: "Fatman: 過去に泊まった\nどの五ツ星リゾートより暑い"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: 皮膚が燃えてるみてえだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: "Fatman: 大丈夫なわけねえだろ\n見てみろよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: なぜウチの風呂を？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: ええ ありますよ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: "Fatman: 息苦しい…\nなあ…風呂あるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: "Fatman: まあ 多少は涼しいが…\n空気が やたら重い"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: "Fatman: 関係ねえよ\nオーブンの中みてえだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: 大丈夫ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: 真夜中ですよ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: "Fatman: おう…ったく…\n外は茹だっちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: "Buddy: わかったよ\n迷惑は かけねえさ\nじゃあな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: クソッ 相棒…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: 一人きりに ならずにすんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: 恩に着るぜ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: "Buddy: さて 冗談は置いといて\nマジで入れてくれんのか 相棒？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: "Buddy: それに ちょいと飲んで\n悲しみに溺れたって いいだろ？\nこんな状況 シラフで直視するなんざ\n土台 ムリってもんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: "Buddy: ヘヘ 落ち着けっての\nまた からかっただけ だよ\nそう カッカすんな\n今どき 笑いぐらいしか ねえだろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: "Buddy: うめえし 健康的だし\nうまくすりゃ ダイエットにもなんだ\n見ろよ この肉体！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: "Buddy: 今朝は王様の朝食ってヤツだった\n相棒直伝の食事法に従ってな\n朝はビール 夜はワインだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: "Buddy: でよ…\n入れてくれんのか 相棒？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: "Buddy: 面目ねえな\n俺の冗談で気い悪くした ってんなら\nただ なんとか気を保ちたくてよ\nわかんだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: "Buddy: 笑いってヤツは正気を\n繋ぎ止めてくれんだぜ 相棒\nなにもかも地獄の中だってな\nでなきゃ とっくにイカれちまってる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: "Buddy: そういう意味の「一発」じゃねえって\nでもよ 世界が崩壊してる最中に\nちょっと笑わせんのも 悪くねえだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: "少し酔ってませんか\n飲んでます？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: "あなた 芸人か\nなにかですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: やめとく'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: "Buddy: 誰も傷つけたりしねえよ\n歯だの目だの テレビが\n言ってるような理由で 俺は そんな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: "Buddy: ちょっと変わってるからって\nだから来訪者とは ならねえだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: "Buddy: おいおい 冗談だっての！\nそうカリカリすんなよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: "Buddy: まぁ ブン殴ったことはあるが\n歯並び完璧だとか 目がキレイだとか\nそういう連中を\n…ただの嫉妬だけどな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: "Buddy: 信じろっての\n俺のハートは誰よりデケえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: "少し酔ってませんか\n飲んでます？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: "あなた 芸人か\nなにかですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: "Buddy: だから酒場 行くのも自由だ\n一杯やりたくなったら 付き合うぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: "Buddy: 姑なんていねえよ\n結婚だって してねえし！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: "Buddy: へへ ひっかかったろ？\n冗談だよ 相棒"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: "Buddy: 姑に追い出されちまってよ\nFEMAの野郎を家から叩き出したら\n連中が来るんじゃ ってビビっちまって"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: おっと 大したことじゃねえんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: "どうすれば あなたが\n「一発かます」男だと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: どうしました？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: "Buddy: よう 相棒\n一発かます男を 入れてみねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: じゃあね 知らないオジサン'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: "Bestson: そうだ…すぐに帰ってくるんだ\nきっと そのはず だといいな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: "Bestson: 家に帰るよ\n父さんと母さんが帰ってくるかも\nしれないから…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: "Bestson: そうだね\nそのほうが 安全かもね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: "Bestson: でも…オジサンが正しいのかも\n今は ここに いたほうがいいのかも"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: "Bestson: もし父さんと母さんが帰ってきて\nボクがいなかったら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: これで いいのか よくわかんない'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: ボクは どうしたらいいの？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: こんなの悪夢だよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: "Bestson: そんな…\nもし…父さんと母さんが\n太陽に焼かれてたら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: ボクは どうしたらいいの？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: "Bestson: もう なにを信じていいのか わかんない\nオジサンも ボクを信じてない かもだし"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: "Bestson: もう なんで出ていったの？\nなんで ボクを置き去りに？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: "Bestson: そんな…\nその「来訪者」とかいう生物に\n父さんと母さんが殺されてたら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: "太陽が爆発し 人々を\n焼き殺しています"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: "地中から来訪者が這い出て\n誰も信用できない状況です"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: "Bestson: 誰かに訊けば なにが起きてるのか\n教えてもらえるかな って\nだから 教えてくれる？お願いだから"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: "Bestson: 放送から数時間後 二人とも\n慌てて出ていって…帰ってこない\nそれで テレビが余計に怖くなって"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: "Bestson: ボクはテレビを消しっぱなし にしてた\nストレスに なるから\nでも 二人とも帰ってこなくって\nなにが起きてるのか まだ わかんない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: "Bestson: ある日 すごく酷いことが起きたって\n聞いて…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: でも 父さんと母さん いつも見てた'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: "Bestson: どこかで読んだこと あるよ\nニュースを避ける人のほうが\n長生きするんだ って"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: "Bestson: ニュースって いいこと 言わないよね\nどんどん 悲しく 怖く なっちゃうから\n見るの  やめたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: "太陽が爆発し 人々を\n焼き殺しています"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: "地中から来訪者が這い出て\n誰も信用できない状況です"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: "Bestson: 本当のこと 知りたいんだ\n父さんと母さんは どこ行ったの？\nお願い…どうなってるのか 教えてよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: "Bestson: 一週間も前なのに…まだ帰ってこない\nずっと待ってるのに\n二人とも…いないんだ\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: "Bestson: ある朝 起きたら二人とも 大慌てで\nすぐ出ていかなきゃ って"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: "Bestson: うん 全然\nニュースって 怖くなっちゃう\nだから…見ないように してるんだ\nでも 父さんと母さんは見てる…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: テレビを見てないんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: "えっと 本当に なにも\n知らないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: "Bestson: 撃ち合ったり ケンカし合ったり…\nワケわかんないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: "Bestson: すごく暑いし 息もできないし\nそれに みんな…おかしな ことばっかり"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: どうなってるのか 教えてくんない？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: "Fugitive: せいぜい夜を楽しみな\nクソ野郎"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: 穴に隠れて 他人を閉め出しやがる'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: "Fugitive: いいとも やっぱりな\nアンタも他の連中と変わらねぇ\n臆病な鼠だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: クソッ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: アンタが隣の連中と違って助かった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: "Fugitive: ありがとよ マジで\n借りができちまったな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: "Fugitive: オレはもう目撃者だ…\n知りすぎちまってる\n連中に追われてる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: "Fugitive: それで逃げたんだ\nクソフェンスよじ登って\n弾丸 喰らおうともな"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: "Fugitive: そのクソを一目見て\n脱走しねぇと って わかったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: "Fugitive: 連中 人間になにかしてやがる\nそれで誰一人\nあそこから帰ってこねぇんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: "Fugitive: もごもご悲鳴がして…\nそれから連中 黒い袋を引きずってた\nアイツは二度と戻って来なかった\nわかんだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: "Fugitive: この目で見ちまった\nテントに連れてかれた哀れなヤツを"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: ありゃ嘘じゃねぇんだ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: "Fugitive: FEMAが来訪者を見分ける\n検査してんの聞いたことあっか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: ああ 信じてくれて構わねぇ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: "Fugitive: フェンスから水たまりに真っ逆さま\nそのまま逃げた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: "Fugitive: 一つツキがなかった\n豚どもの一匹に見つかっちまって\nブッ放されちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: "Fugitive: 連中 忙しなくてな\nほら…なんか準備しててよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: "Fugitive: 計画するまでもねぇ\nただタイミング見計らって\nフェンスを越えるだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: 警備はザルだがよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: それがFEMAの隔離区域だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: "Fugitive: クソデケぇ輸送コンテナがあって\n毎朝 家畜みてぇに人を押し込む"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: "Fugitive: 空き地を想像してみな\nフェンスが張り巡らされてて\nテントがいくつか散ってんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: "つまりFEMAに\n追われていると？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: "FEMAの隔離区域について\n教えてください"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: "Fugitive: ふざけんな っつったら\n犯罪者みてぇに ワッパかけられて\nだが 逃げ切った"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: "Fugitive: お次は 用紙に\nなんか書き込んで\n連行するだの言いだしてよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: "Fugitive: ドアを開けると\nもう検査を始めやがって"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: "Fugitive: 隔離区域から脱走したんだ\n連中の掃討中にドア叩かれて\nそのまま捕まっちまってよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: "つまりFEMAに\n追われていると？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: "FEMAの隔離区域について\n教えてください"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: "Fugitive: 内臓が飛び出してねぇだけ マシだが…\nもう血が 大して残っちゃいねぇ…\nああ…グッ クソ痛ぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: "Fugitive: 貫通したのは 感謝しねぇとな\nだがクソ 血が流れっぱなしで\n豚の解体みてぇだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: "Fugitive: 腕は悪かったがな あのクソども\nだが一発…一発は当てやがった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: "Fugitive: クソFEMAの豚どもだ…\nフェンスを よじ登って\n逃げようとしたら…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: なにが あったんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: 誰に やられたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: "Fugitive: 撃たれちまって\nもう長くねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: 助けてくれ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: "Nun: 主は このことを お忘れにならない\nすべてを見ておられるのです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: "Nun: 私の死は 貴方の魂に\n重くのしかかるでしょう\n覚えておきなさい"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: 哀れな老女を追い払うとは'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: "Nun: そうですか\nそういうつもりですか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: まあ 感謝します'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: "Nun: まあ 赦します\nそのような下卑な言葉\nこの家から清めてあげましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: "Nun: 家について簡単に尋ねたまでのこと\nそれぐらいで 罵倒するのですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: "Nun: 神への畏れもないとは！？\nなんて恥知らずなのでしょう！？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: "Nun: 無礼者！\n神を知らぬ野蛮人！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: それが大それた願いだと？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: "Nun: ただ この家が住みうる場所か\n確かめたいだけです\n穢れには耐えられません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: "Nun: あら 教示ありがとうございますこと！\nそう言ってもらわないと\n気付く由もありませんでした！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: 頭 イカれてるのか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: ここはホテルじゃない！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: "Nun: 辛抱なりません\n肌が真っ赤に爛れてしまいます"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: "Nun: 二つ目は…\n南京虫や鼠は いますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: "Nun: もし そういう人がいるなら\n正直に告白なさい"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: "Nun: まず一つ目\n酒や薬に溺れる者は我慢なりません"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: "Nun: 民草を受け入れているのでしょう？\nただ いくつか 確認を"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: 部屋が必要なのです'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: 頭 イカれてるのか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: ここはホテルじゃない！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: "Nun: 聖画像はありますか？\nそれから…完全なる静けさも\n祈りと黙想のための"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: "Nun: 話のついでに…\n尋ねさせてもらいますが"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: "Nun: 泊まりに来たのです 迷える方\n泊まりに"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: "Nun: 主よ憐れみを\nはっきり言っているはずです"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: なにを求めてるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: なにに ふさわしいと？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: "Nun: ここならば\n私にも ふさわしいでしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: あなたの小屋は一番端にあるのね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: "すまない 時間を無駄にさせた\nただ…いつか僕も 殺しを学びたい\nそうすれば 自分の足で立っていられる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: "誓う 違うんだ\nただ…ずっと神経が尖っていて"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: "Raskolnikov: 異常者みたいに聞こえたか\nそれか もっと悪いように"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: 入れてくれないのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: "Raskolnikov: 君の手腕を教えてくれないか？\n来訪者の殺し方を\n恐怖を この目に見据えたいんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: "Raskolnikov: それと…もしよければ…\n検査の後で構わない…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: ありがとう 友よ'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: "Raskolnikov: 教えてくれないか…\n殺しを"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: "Raskolnikov: でも できれば…\nまあ 君がいいなら…\nその…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: "Raskolnikov: だから探しているんだ…\n誰か 守ってくれる人を"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: "Raskolnikov: 僕？\nただの臆病者だよ\n自分を守る力すらない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: "Raskolnikov: 今どきは うっかり見ただけで\n引き金を弾かれる時代だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: "Raskolnikov: 守りたいのは 来訪者からだ\nそれと 来訪者を狩る連中からも"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: "Raskolnikov: いや 違うんだ\n僕が言っていたのは\nライフル持ちの異常者じゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: "Raskolnikov: だからこそ この世界の仕組みに\n精通している人が必要なんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: "Raskolnikov: なにが起こるか怖いんだ\n戦えない ままならば"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: "Raskolnikov: 前は普通で 蠅の一匹も殺せなかった\nでも今は…\n僕みたいに甘い人間は生き残れない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: "Raskolnikov: 狂人みたいだったなら 違うんだ\nただ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: "Raskolnikov: えっ？\nその…まさか…\n変に聞こえた？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: 誰から身を守ろうと？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: "なぜ そんなに\n殺しにこだわりを？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: "Raskolnikov: そうしたら…\n怯えて生きるのは僕じゃない\n奴らのほうだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: "Raskolnikov: いいさ\nいつの日か 僕も殺せるようになる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: "Raskolnikov: 運よく見つからずにすんだ\n見つかっていたら その場で\n首を折られていたかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: "Raskolnikov: ただ…\n少し前 武装した異常者に遭遇したんだ\n人を詰問して…来訪者か尋ね続けてた"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: "Raskolnikov: 誤解しないでほしい\n誰かに敵意を向けたいワケじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: "Raskolnikov: 完璧だ！\nそれなら 来訪者が現れても\n倒せるということだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: 誰から身を守ろうと？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: "なぜ そんなに\n殺しにこだわりを？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: "Raskolnikov: きっと素手でも殺せるはずだ\nそのときが来たなら"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: "Raskolnikov: でも 君の声には鋭さがある\n気性も負けてない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: "Raskolnikov: 終末に人を裁くぐらいさ…\nレース場でスピード違反の切符を\n切るようなものだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: "Raskolnikov: ただ…危険な時代だろ？\n自分で身を守れる人か知りたくてね\n脅威を排除できるか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: "Raskolnikov: おっと…すまない\n無礼を働くつもりじゃなかったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: ええ 銃を持ってます
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: なぜ そんなことを？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: 武器は持ってる？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: やあ こんばんは'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: "Wifefema: もういい くたばっちまいな\n近所の連中に話してやるから\nじゃあね ド低脳"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: "Wifefema: 一体 なにが問題なんだい？\nアタシは本気で話してんのに\nアンタは踏みにじるだけ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: "Wifefema: 本気かい？\nダンナはFEMAで働いてんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: アタシを来訪者とでも！？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: "Wifefema: ちょっと…\nなにさ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: "Wifefema: 来訪者を殺しちまえば\nマトモな暮らしに戻れるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: そうこないとね！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: "Wifefema: 「FEMAは女を受け入れない」\nなんてバカげた戯言なんだか"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: "Wifefema: 国境で働いてたんだよ\nうさんくさい連中を\n嗅ぎ分けてたんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: "Wifefema: 不公平じゃないか？\nなに アタシがダンナより劣ってると？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: "Wifefema: 関係ないだろ？\n今はFEMAなんだから ダンナは\nそれに アタシだって入りたいよ\n女を受け入れてくれるなら"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: "Wifefema: ふん\nアンタに話すワケないだろ\nなんで知りたいんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: "Wifefema: ろくでもないこと しでかしたクズども\n山ほど捕まえてやったんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: "Wifefema: 前は税関で働いててね\n国境の出入りを検問してたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: "Wifefema: 本当に残念\nダンナと一緒に来訪者を嗅ぎ分けるの\n大得意だったのに"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: "Wifefema: ふん それなら良かったんだけどね\nでも 女は受け入れないの\nまったく"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: 旦那さん 以前はなにを？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: あなたもFEMAですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: クソ運転手に ぼったくられたけどね'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: "Wifefema: だから驚かせようと思って\nわざわざタクシーに乗ったの"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: "Wifefema: FEMAに連行されたと聞いたときは\nおかしくなりそうだった！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: "Wifefema: あら\nぜひ言わせてちょうだい！\nダンナはFEMAで働いてるの！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: 旦那さん 以前はなにを？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: あなたもFEMAですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: "Wifefema: FEMAのダンナが捕まえたら…\n真珠のような歯を喉の奥まで\n叩き込んでやるだろうね ふん"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: "Wifefema: でもね 神に誓って\n運転手の歯が 磁器みたく真っ白でさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: "Wifefema: 大枚はたいてね\n近頃 吊り上げがヒドいんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: "Wifefema: どうやって？\nタクシーに決まってる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: 旦那さんは なにを？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: どうやって ここまで？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: "Wifefema: ところが\nダンナの職場には泊まる場所がなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: "Wifefema: 急に訪ねて\n驚かせようと思ったんだけど"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: "Wifefema: ダンナに会いに来たの\n仕事で配置が変わったと聞いてね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: "Wifefema: どうも\nちょっと居候してもいい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: "Theorist: さよならだ\n私は信用したのに…\n君は人類への信頼を踏みにじったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: 人々には真実を知る権利があるんだ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: 君は過ちを犯している！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: "Theorist: 信じてほしい\n私は本当の真実を見たんだ！\n古い嘘は すべて忘れてくれ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: やはり信用して よかった'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: "Theorist: だから 胸を張って去ることにした\n貴重なアーカイブを携えてね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: "Theorist: ただ耳栓をするだけで…\n寄生虫の侵入を防ぎ\n何千にも救えたはずなのに"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: "Theorist: だが あの愚か者ども\n私の成果を認めようとしなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: "Theorist: 真の脅威は来訪者じゃない\n脳に潜む寄生虫だ\nそう主張したんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: "Theorist: 前は研究所で働いていたんだ\nだが とある発見でクビになってね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: "Theorist: でも 誓ってくれ\nここだけの秘密だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: "Theorist: よし\n信じると決めたからには打ち明けよう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: 帰ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: 入ってください
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: "Theorist: …ジャガイモ味のポテトチップス\n科学的な破綻であり\n味覚的な災厄でもある\nその理由"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: "Theorist: マインドコントロールだってある\nファストフードを介したね\nああ 本当なんだ\nそれから最後に…"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: "Theorist: 選挙の不正\n月面着陸が捏造された証拠"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: "Theorist: ああ 友よ\n覚悟するんだね\n君の目を開かせてあげよう"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: どこで そんなものを？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: なんの話です？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: "Theorist: それなら…\n君には重要事項を打ち明けられる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: "Theorist: つまり否定したということは\n本当のことを言っている証拠だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: "Theorist: いいかい 規定上\nFEMA職員は問われると\n身分を明かさなければならない"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: "Theorist: おっと いいね\nならば信用できる"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: どこで そんなものを？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: どんな情報です？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: "Theorist: キロトン単位のデータだ\n全部公開するつもりだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: "Theorist: 極めて機密性の高い書類を\n持ち歩いていてね"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: "Theorist: 安全な場所が必要なんだ\n研究を続けられるところが"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: "Theorist: 無論\n重要情報だとも！"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: いえ FEMAとは無縁です
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: なにを信用しろと？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: "Theorist: まさか…\nFEMAの人間じゃ ないだろうね？"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: "Theorist: やあ\n教えてくれ…\n君を信用して大丈夫か？"
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: "Firefighter: ほら もう いらないからさ\n捨てるなり使うなり\nどうぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: "Firefighter: FEMAの隔離区域に行けってね\nでも みんな死ぬような所に\n誰が行くんだか…"
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: "Firefighter: 消火に行く前\nこの紙を職場で渡されたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: "Firefighter: 少なくとも\n湿った地面で死なずにすむよ"
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: "Firefighter: あまり長く迷惑かけないから\nゴホッ"
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: ありがとう ゴホッ'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
