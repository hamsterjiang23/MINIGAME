%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_pt-PT
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-PT
  m_SharedData: {fileID: 11400000, guid: 1bdb57fba89c5124a83ad717d0443512, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: Está um calor dos diabos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: Como te sentes?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: Quero fazer-te um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: Parece que está ainda pior do que eu pensava. *cof* Raios.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: Duvido que aguente mais do que uma semana.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: Embora me tenha sentido um pouco melhor quando decidiste deixar-me entrar. Obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: Mas... Estou aqui sentado enquanto os outros estão a morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: Podia ter ficado com eles. Já não tenho nada a perder. Afinal, vou morrer e vou...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: Está um calor dos diabos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: Porque é que não foste para casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: Quero fazer-te um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: Tenho filhos em casa. E eu... *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: Não quero que tenham medo de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: E não quero *cof* que se lembrem de mim assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Eles que pensem que morri na floresta, enquanto... *cof cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: Enquanto apagava incêndios.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: *cof* Eles que se lembrem de mim pelo meu esforço e pela minha dedicação ao trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: Está um calor dos diabos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: Onde está o teu uniforme?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: Quero fazer-te um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: Os chefes tiraram-mo. *cof* Agora nem equipamento suficiente temos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: Muita gente *cof* está a morrer durante o desempenho das suas funções.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: Nem sequer temos tempo de tirar os nossos colegas dos incêndios. O fogo *cof* acaba por mutilar os corpos todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: E os chefes... Estão mais preocupados com *cof* a merda de um uniforme...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: Criam decretos a torto e a direito. E nenhum deles é a pensar nas pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: Está um calor dos diabos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: De onde vieram os incêndios florestais?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: Quero fazer-te um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: A floresta tem estado muito seca ultimamente. Por isso, *cof* é fácil ocorrer um incêndio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: Os incêndios são apenas *cof* mais uma das desgraças que nos caíram em cima, como os Visitantes do subsolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: Mas o destino ainda tem mais planos para nós...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: Talvez uma morte tranquila agora seja o melhor fim para esta causa perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: Sabes... *cof* Pensei em levar uma prenda para casa. Mas vou dá-la a ti, em vez disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: Este colar, seco e sem graça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: É feito com abelhas mortas que transformaram o mel em sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: Está um calor dos diabos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: Estás com um ar terrível
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: Quero fazer-te um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: Acho... acho que chegou a minha hora... *cof cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: Porque é que não fiquei lá? Talvez tivesse conseguido salvar uns quantos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: Podia ter ficado... e trabalhado até cair para o lado. Assim, não tinham de mandar os mais novos para a morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: PUTA QUE PARIU OS CHEFES! *COF COF*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: É tudo tão... triste.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: Podes dar-me lume uma última vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: 'Estende-lhe um cigarro (dá-lhe um cigarro) '
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: Por acaso não tens aí um cigarro, pois não?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: Não, lamento (não lhe dês um cigarro)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: Aquele último prego no caixão, como se costuma dizer. *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (O homem tira um isqueiro do bolso, acende o cigarro e começa a fumar.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (Dá uma longa passa e encosta-se à parede. Após uma breve pausa, continua.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: Quem me dera poder estar com a malta outra vez. Fumar, falar sobre...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *COF COF*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: Não fumas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: Eu sei, um bombeiro a fumar é péssimo. *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: Mas agora já não importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: Só queria *cof* relaxar um pouco antes de morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (O homem encosta-se à parede, a olhar para o teto enquanto fala.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: Como é que fui parar a bombeiro...? A minha mãe dizia para eu ir trabalhar para uma fábrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: É estranho que um bombeiro acabe a vida a fum... '
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *COF COF*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: Vaguear em liberdade é do que tenho vontade...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: De quem é que estás à procura?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: O meu amigo. Conhecemo-nos desde pequenos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: Teve um acidente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: Foi trabalhar para uma mina nas montanhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: Nem eu percebo bem. E também não quero saber.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: MAS DEPOIS DEU CABO DAS COSTAS.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: Trabalhou tanto nas montanhas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: Que as gaivotas confundiram o... as costas dele... uh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: Pronto, está bem, era o rabo. Confundiram o rabo com um ninho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: Desculpa, são só as vozes na minha cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: Contaram a piada mesmo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: Vaguear em liberdade é do que tenho vontade...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Uh... está tudo bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: Sim. Só estou à espera que as pernas voltem a crescer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: Olha, a direita já começou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: Por isso, vou ficar aqui mais um bocadinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: Estava a falar das vozes na tua cabeça
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: Bem... está bem
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: Não percebeste? Era uma piada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: Pensei que a tivesses apanhado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: Suponho que não teve piada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: Acabaste de perguntar como estou?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: Obrigado, que simpático!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: Nunca ninguém me pergunta como me sinto ou como foi o meu dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: Tudo porque em vez de pernas, tenho as rodas de um grande CARRO DE CORRIDA?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: Ninguém responde com sinceridade. E é esse o problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: Começam logo com desculpas, a dizer que só estavam a ver as minhas pernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: No entanto, também é chato quando só ficam a olhar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: Mas fingir que a minha deficiência não existe é estúpido. Isto é, é obvio que existe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: Basicamente, tem de haver um equilíbrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: Mas também não há equilíbrio nenhum na merda da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: Já alguma vez tentaste imaginar como andarias se estivesses sobre rodas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: Foda-se, não era isso que eu queria dizer...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: Se não tivesses pernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: EXATO. Nem conseguirias sair de casa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: Como é que usarias as escadas? Ou atravessavas a estrada?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: Estes passeios estão todos tortos como o caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: A tua casa não tem escadas nem soleiras, por isso, até consigo deslocar-me bem nela.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: Mas sabes, só queria uma coisa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: Que a tua casa estivesse numa inclinação.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: Seria hilariante poder andar por ela numa cadeira de rodas. E espetar-me contra uma parede, claro, mas sem problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: Pá, adoro corridas. Mas aqui não tens forma de fazer isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: Ah, espera, perguntaste-me como é que estou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: Nada mal. Obrigado por perguntares.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: Vaguear livremente, gostava de poder ser...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: Tens uma insolação?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: O que é que isso tem que ver com o que quer que seja?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: O meu cabelo não ardeu nem caiu. Portanto, está tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: Não posso competir numa cadeira de rodas sem pernas. Entendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: Se não tiver pernas, como é que abrandava a alta velocidade? Ou fazia curvas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: Tu não tens uma cadeira de rodas, como é que poderias perceber?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: Acreditas mesmo nisso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: Porque é que achas que as tuas pernas vão voltar a crescer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: Claro!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: Sabes o que se costuma dizer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: A perna direita dá sempre passos mais largos. É por isso que andamos sempre em círculos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: Olha, a minha perna é a prova disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: Vai dar tudo ao mesmo, e não há como sair do ciclo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: Um dia acaba hoje, outro começa amanhã. Mas será que vai mesmo haver outro dia?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: Que se foda. Vai dar tudo ao mesmo. Vivo apenas fazendo parte do ciclo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: Então, pensando bem, és assim tão diferente de mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: Também não andas às voltas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: Olha à tua volta, vivemos num mundo repleto de maravilhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: Só das terríveis, até agora. MAS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: As maravilhas terríveis vão acabar, e depois surgem as boas, as felizes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: Deus já perdoou montes de fiéis. Pode ser que algo de bom nos aconteça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: Vaguear em liberdade é do que tenho vontade...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: Como perdeste as pernas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: Lembras-te do meu amigo das montanhas, de quem falei?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: Bem... Ele decidiu cavar uma trincheira no quintal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: Teve a ideia de que havia um túnel cheio de carne por baixo de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: Encomendou uma broca manual ou lá o que era.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: E começou a escavar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: Raios...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: Se calhar foi a última vez que o vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: Vaguear em liberdade é do que tenho vontade...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: E as tuas pernas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: Que se fodam as pernas. Quero é saber se ele escavou até onde queria.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: Está bem, esquece lá isso
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: Sim, é isso. Depois, fui beber uma cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: Caí e um carrinho cortou-me as pernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: Ou espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: Não, não foi isso que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: Porque é que não dizes nada? Não estás curioso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: Pronto, não digo mais nada. Para quê incomodar-te?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: Está abafado aqui dentro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: Não tinhas um filho contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: Hã? Ele ainda está comigo. Deve ter ido dar uma volta por aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: Preciso de saber para onde foram os outros e se estão bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: Tens telefone? Podia ligar ao pai deles, assim não precisava de olhar mais para aquelas trombas horrendas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: Está abafado aqui dentro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: Então? Ligaste ao teu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: Para quê? Só ia resmungar, sem se importar. Nunca mexeu uma palha. Ficou tudo em cima de mim: miúdos, casa e dinheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: Às vezes acho que apenas nos tolerávamos mutuamente. Mas ele não me deixou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: Se calhar porque lhe dava jeito. Ou então tem medo que um dia eu lhe acerte as contas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: Meu Deus, estou tão cansada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: Está abafado aqui dentro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: Foste ver o teu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: O quê? Mal consigo sair da cama. Dói-me tudo e estou exausta. Às vezes acho que só continuo viva por teimosia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Ficou tudo em cima de mim: os filhos, o marido, e a casa. Mas, às vezes, ele fazia coisas que tornavam tudo melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: Falamos mais tarde. Preciso de descansar, estou sem forças.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: Está abafado aqui dentro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: O que é que ele fazia?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: Vou contar-te uma história...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: Ele andava de carro com uma mulher. Eu sabia o que se passava. Ao início tolerei, mas depois chateei-o todos os dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: Acusei-o de trair-me. Acabou por mudar de emprego para não a ver mais. Se calhar amava-me, não era...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: Ou então fui eu que imaginei tudo. Seja como for, preciso de descansar. Falamos depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: Está abafado aqui dentro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: Não estás preocupada com os teus filhos?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Sim... Mas talvez não tanto como devia. O primeiro... não fazia ideia do que estava a fazer. Fiz tudo mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: Pensei ter corrigido os meus erros com o segundo. Mas foi tudo igual. Depois veio o terceiro, o quarto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: Os médicos disseram-me que não podia ter filhos, mas quando o segundo nasceu... chamei-lhe a Oitava Maravilha do Mundo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: Mas depois... ficou... foi horrível...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: Eu... eu preciso de descansar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: Está abafado aqui dentro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: O que foi horrível?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: É-me difícil falar sobre isso... Eu amo-os, mas... Às vezes, perdia a cabeça. Gritava, até lhes levantava a mão.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: Eu sei que é horrível. Arrependo-me tanto... Mas, sabes, pela primeira vez, tudo parece fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: Eles não estão aqui, e eu posso simplesmente respirar... Odeio dizê-lo, mas finalmente me sinto bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Merda do caralho...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: Então? Já te acalmaste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Sim, acalmo-me depressa. Mas logo que me lembro de algo que me irrita, perco logo a cabeça outra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: Eu antes era mais tranquilo. Era difícil ofender-me ou fazer-me explodir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Agora basta uma faísca para lançar o caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: E por que raio haveria eu de manter a calma? Talvez seja a raiva que ainda me dá algum juízo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: Pelo menos não ando a adorar o sol como alguns estúpidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: Como é que conseguem pensar que o sol nos vai salvar? Está é a matar-nos, caralho!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: O resultado de tudo isto é acabarmos no além.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: E estes burros percebem isso? Não. Bem, já passou, estou mais calmo. Já parei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Obrigado por me ouvires.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Merda do caralho...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: De onde vem tanta raiva?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Nem eu sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Tudo o que está a acontecer deixa-me fora de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: E os cultistas, aqueles cabrões mentirosos... Querem enganar mais gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: E as pessoas vão acreditar neles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: São capazes de tirar os últimos restos de comida dos próprios filhos para os dar ao culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: Para agradar o seu merdoso salvador do submundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Marados de merda. Até fazem lavagem cerebral a gente normal com as suas maluquices... como a minha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: Seja como for, já estou mais calmo. Sinto-me melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Merda do caralho...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: Os cultistas tiraram-te alguém?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: Não, o problema está mesmo aí. Ela foi por vontade própria.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: A minha mulher...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Antes desta merda toda, era muito religiosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: Mas eu amava-a e aceitei isso. Foi algo que nunca interferiu na nossa relação.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: Quando tudo isto deu para o torto, encontrou uma nova fé num novo salvador.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: A puta da retórica dos cultistas fazia sentido para ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: Ficava mais tresloucada a cada dia que passava, a acreditar em coisas que eu não conseguia compreender.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: Quando percebi o que tinha feito, ela já tinha fugido, amedrontada. Já era tarde demais para mudar o que fosse...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Merda do caralho...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: O que aconteceu entre ti e a tua mulher?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: Um dia, a minha mulher disse-me que se ia juntar ao culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: Eu... não consegui acreditar. A mulher que eu amava... Tinha-se tornado numa pessoa completamente diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: O nosso amor já não significava nada para ela. Fiquei furioso, como nunca antes fiquei em toda a minha vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: Comecei a pensar que ela nunca me havia amado, que só queria uma desculpa para fugir para longe. Senti-me péssimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: Fechei os punhos sem pensar e fiz algo que nunca me vou perdoar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: Bati-lhe...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: Agora, não há volta a dar. Ela está com o culto e eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: Nunca vou conseguir aceitar o que aconteceu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: CARALHO, EU ODEIO-ME!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: Mais vale descarregar a dor em mim do que em quem me rodeia. É o que mereço.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Vai-te embora. Preciso de ficar sozinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: Queres uma leitura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: Como é que sabes tanto sobre mim?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: Ha! És engraçado... Não sou eu que sei. As estrelas é que falam através de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: A lua está em Vénus na tua Sexta Casa. Está-te escrito na cara, percebes? Mesmo que não digas uma palavra que seja...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: Conheci alguém como tu uma vez. Ouvia sempre, mas nunca falava.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: Sabes o que se costuma dizer: se Júpiter está na tua Oitava Casa, é melhor ficares calado. É sinal de portas fechadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: Queres uma leitura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: O que aconteceu a essa pessoa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: Disse-lhe: "Não importa o que fazes. Importa o que a tua aura faz enquanto o fazes." Mas ele não acreditou em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: E a vida passou-lhe ao lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: Mas um dia, fechei os olhos e imaginei um sonho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: Dei toda a minha energia àquela imagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: Se não abres o coração à energia, que motivos tens para viver neste corpo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: Também podes fazer o mesmo. Fecha os olhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: Imagina que já alcançaste o teu objetivo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Olha bem para ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: Sabes qual é a razão do teu sofrimento? Porque ainda não percebeste que o sofrimento é a maior forma de felicidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: Então... Estás pronto a dar esse passo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: Queres uma leitura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: O que significa "estar pronto"?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: Significa priorizares-te. Estás a cheirar isto? É o cheiro de desejos por cumprir. Está na hora de lhes dares atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: Quando eu estava no fundo do poço, sem luz nem sentido, a minha mentora disse-me: "Não estás a dar ouvidos ao teu mar."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: Ao início, ri-me. "Mar"?! Mas lá fechei os olhos... e ouvi-o. Como se lá tivesse estado sempre. Tu também o podes fazer!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: Mas o mais importante é perguntares-te: estás pronto para seres um só com aquilo que realmente és?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: Queres uma leitura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: Quem era a tua mentora?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: Uma grande mulher. Era como um farol em noite de tempestade. Ensinou-me a ver a essência das coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: Nunca me vou esquecer das suas palavras: "As pessoas só morrem porque não aprendem a respirar a sua luz interior."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: Fez-me perceber que podia ajudar outros a encontrarem o seu caminho único.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: Mas, enfim, ela tinha medo de ir mais além.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: Não se via no centro de tudo. E é importante estar no centro, sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: Se não és o centro do teu universo, quem és tu? Tu percebes, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: Queres uma leitura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: Como é que te ajudaste a ti própria?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: Todos os teus erros são códigos no teu universo que ainda não conseguiste decifrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: Percorri um longo caminho. Olha à volta e depois olha em retrospetiva. Vês como está esta casa agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Luminosa, ampla, em harmonia com a minha energia. Não há que lutar contra a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: Ela já absorveu o teu medo. Aceita-o, ou as paredes vão começar a chorar as tuas próprias lágrimas. Percebes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: Queres uma leitura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: O que queres de mim?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Oh, meu querido, achas que quero alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: O problema é que, se visses a tua própria dança das sombras, perceberias onde é que o teu caminho está escondido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: Só tens de recitar afirmações de felicidade. Consegues sentir que está tudo a mudar, não é? É mais fácil de respirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: É a minha energia a ligar-se ao teu espaço. Esquece o significado. Isso é uma ilusão para quem teme aceitar o caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: Estou a pedir-te que faças parte deste espaço. Diz: "Não sou apenas um convidado aqui; sou o seu criador."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: Queres uma leitura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: E se eu não quiser ser um criador?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: As tuas paredes há muito que te querem abraçar, mas tu fazes questão de prendê-las às correntes do teu controlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: O silêncio dentro de ti é a voz do mundo que sufocas com o teu medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: A tua energia fica rígida como mel no inverno. Tens de a descongelar com a tua respiração. E os espelhos não mentem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: Se só te vês a ti próprio, não vês nada. Tudo o que tens de fazer é deslocar a tua energia três graus para a direita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: E serás finalmente feliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: Estou a ouvir, humano. Fala!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: És membro de algum tipo de fé?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: SIM, HUMANO! Mas a minha fé não é como as religiões que conheces.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: Eu venero O PRÓPRIO SOL SAGRADO! POIS ELE PROTEGE-NOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: Mas os estúpidos só veem coisas más nisso. Acham que vamos acabar todos incinerados...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: TRETAS! A sua raiva é dirigida às sementes do mal e aos hereges! Pois eles são pecadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: E que aqueles que discordam nunca se encontrem sob o seu braço ardente da justiça!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: Procuram problemas e depois admiram-se de se queimarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: Sementes do mal?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: Hereges?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: Ainda perguntas? Não sabes QUEM SÃO OS ALIENÍGENAS?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Muito bem, humano. Vou contar-te a MAIS PURA DAS VERDADES.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: OS VISITANTES SÃO SEMENTES DO MAL!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: SÃO DESCENDENTES DE ALIENÍGENAS que aterraram na Terra quando o sol era mais jovem e a relva mais verde!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: MALDITOS VASSALOS que fizeram as suas casas na Terra e que se reproduziram durante SÉCULOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: E agora, subiram à superfície e querem ficar com AS NOSSAS TERRAS COMO SE FOSSEM DELES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: Mas o SOL decidiu proteger-nos, pois ESTA É NOSSA TERRA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: Pois o sol NÃO TEM PIEDADE dos Visitantes! Caso contrário, por que estariam eles escondidos no subsolo todo este tempo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Raios... Porque é que ficaste tão bêbado naquela noite...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: Não precisavas de beber até ao esquecimento. A justa ira do Sol Sagrado, é...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: SOL SAGRADO, acalma a sua alma e perdoa-lhe os seus pecados.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Leva-o até aos teus doces braços. E talvez a alma da figueira, que ele já não poderá regar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Ámen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: Ouviste bem, humano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: A AGEF é uma maldita HEREGE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: Eles interferem em processos que estão além do NOSSO controlo – o controlo das PESSOAS COMUNS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: Metem o nariz onde não são chamados.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: Que o sol amaldiçoe aqueles cabrões que atiraram a minha mãe para uma poça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: Estou a ouvir, humano. Fala!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: Bem, o sol queimou muita gente de alguma forma
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: Tens razão. Tudo sementes do mal, humano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: O sol decidiu castigá-los TODOS pelos pecados que as pessoas cometeram ao longo de MIL ANOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: E OS VISITANTES, AQUELES IDIOTAS DE MERDA, começaram a tentar alcançar o SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: Mas o SOL não é para eles, os subterrâneos, é para nós, para os HUMANOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: É NOSSO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: É UMA BÊNÇÃO PARA A HUMANIDADE, CARALHO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: E quantas mais pessoas precisam de arder para acalmar o sol?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: Estás a dizer que o fim do mundo é a justiça do sol?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Muitas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: E acredita em mim, meu amigo, isto está LONGE DE ACABAR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: SÓ ESTÁ A COMEÇAR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: A BALANÇA ainda não está cheia o suficiente para equilibrar as FORÇAS DO UNIVERSO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: HÁ MAIS GENTE QUE TEM DE ARDER nas justas chamas do SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: Mas para que saibas, meu amigo, estas vítimas não morrerão em vão!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Algum dia, todos haveremos de compreender o verdadeiro plano do sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Às vezes, durante a noite, fico tão triste por a minha mulher me ter deixado...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: Era uma mulher santa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: Mas também uma vaca.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: O fim para quem?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: Para nós?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: Não me façam rir. O SOL ESTÁ DO NOSSO LADO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: Está a ajudar-nos, não consegues ver?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: Está a tentar levar os Visitantes de volta ao interior da terra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: Está a castigar pessoas terríveis pelos pecados da humanidade...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: Revela hereges em farrapos manchados de mijo, escondidos vergonhosamente atrás de máscaras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: Devemos agradecer ao sol por não ter dado sinais sobre o fim do mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: É O FIM PARA TODOS OS INIMIGOS DO SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: MORTE AOS SUBTERRÂNEOS! MORTE AOS HEREGES MANCHADOS DE MERDA! MORTE ÀS SEMENTES DO MAL!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: Raios, o que eu não dava para comer umas belas de umas batatas fritas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: Estou a ouvir, humano. Fala!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: Achas que o que está a acontecer tem algum significado sagrado?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Humano, porque é que te expliquei tudo isto e te dei tudo de mão beijada?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: Só para me fazeres A MESMA PERGUNTA?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: Parece que me enganei em relação a ti, humano. Não entendes as verdadeiras razões do que está a acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Caralho, gostava de ter bebido uma cerveja fresquinha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: Achas que podias fazer-me a vontade uma última vez, humano?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: 'Claro, toma lá (dá-lhe uma cerveja) '
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: Não tens cerveja? Estás maluco, humano?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: Eu vi-a com os MEUS PRÓPRIOS OLHOS!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: Vá lá, humano. Não podes beber tanta cerveja e nem sequer PARTILHAR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: Não (não lhe dês uma cerveja)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ahh, maravilha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Mmm, que bom. É escura, a minha preferida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Lembra-me de sair para o bar com os meus amigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: Boas conversas, canecas geladas, aperitivo de pão e molhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: E a tromba soturna daquele magricela que estava sempre a olhar para nós em jeito de desaprovação...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Bem, não há motivos para ficar chateado. Podes ser burro, humano, mas pelo menos és gentil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Deixa-me dar-te um pequeno presente de agradecimento. Toma.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: Que o Sol Sagrado salve a tua alma!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: Seu MISERÁVEL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: VAI PARA O INFERNO, SEU FILHO DA PUTA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: A ingratidão! Expliquei-lhe os significados sagrados, o sentido, e ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: És um HUMANO MALVADO E ESTÚPIDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Vai para o caralho. Fica aí escondido na tua espelunca sangrenta! Vou para um sítio melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: Vais ver, eles vão deixar-me voltar para o bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Boa estadia, palhaço.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: Heh h-heh. Espero que isto acabe em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: Como perdeste a tua casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Ahh... Lembro-me bem desse dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: Fui despedida e só queria ir para casa, deitar-me e chorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: Quando cheguei, vi uma data de botas no corredor. Pensei que a minha colega de casa tinha amigos ou familiares por lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: Fui ao quarto dela para ver o que se passava. Quando cheguei à porta, ouvi um som estranho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: Fiquei desconfortável. Decidi espreitar em silêncio para ver o que estava a acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: Só tive tempo de ver a minha colega deitada na cama sem se mexer quando, de repente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Um tipo desgrenhado agarrou-me por trás e disse: "Não podes entrar aí. Ela está... mal."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: É melhor irmos para a cozinha. Depois puxou-me pelo braço e sentou-se à mesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: Queria sair dali, mas o medo paralisava-me... E então...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: Eu... Ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: Preciso de descansar. O meu estômago está às voltas de ansiedade. Uff...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: Heh h-heh. Espero que isto acabe em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: Então, o que aconteceu em tua casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Uff...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: Depois de aquele homem me sentar à mesa da cozinha, um tipo enorme apareceu da esquina e bloqueou a saída.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: Começou a falar alto com o que me tinha agarrado pelo braço.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: Era... Era como se eu nem estivesse ali. E depois... começaram a tocar-me!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: Nos meus braços, nos ombros...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: E de fundo, ouvi palmas e uma gargalhada vinda do meu quarto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: Parecia que havia uma multidão de homens lá dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: Comecei a ter dificuldades em respirar. O coração parecia que me ia saltar do peito...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: Queria gritar e pedir ajuda, mas a minha voz... O medo não me deixava fazer qualquer som.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: Fiquei ali sentada, inútil... como um ursinho de peluche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: Mas quando o grandalhão foi ao frigorífico buscar algo, percebi que era a minha oportunidade...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: Corri para a saída. Parecia que o medo me dava forças. E corri, sem olhar para trás.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: Até perder o fôlego e cair no chão...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: Porque é que o sol não te queimou?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: O que aconteceu depois?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: Não me lembro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: Devo ter passado ali a noite inteira e depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: É estranho... Pensava que me lembrava de tudo o que me aconteceu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Espera, não achas que eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: Posso ser uma Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: Não, não pode ser verdade. Lembro-me da minha vida. Da infância, da minha mãe e do meu pai. Não!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: Eu não sou uma Visitante, pois não? Diz-me que não sou uma Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: Não sei
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: Não és uma Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: Pareces uma Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: Estava deitada no chão, e depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: Tinha mesmo a certeza de que me lembrava do que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Espera, não achas que eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: Será que sou uma Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: Não, não pode ser verdade. Lembro-me da minha vida. Da infância, da minha mãe e do meu pai. Não!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: Eu não sou uma Visitante, pois não? Diz-me que não sou uma Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: Não sei
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: Não és uma Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: Pareces uma Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: POR QUE RAZÃO DIRIAS ISSO?! Oh meu Deus, estou com medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: Preciso de descansar. O meu estômago está outra vez às voltas. Uff...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Obrigada, isso fez-me sentir melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Uff, preciso de descansar. O meu estômago está outra vez às voltas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: POR QUE RAZÃO DIRIAS ISSO?! Agora estou ainda mais assustada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: EU NÃO QUERO MORRER! NÃO QUERO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: Vamos todos morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: Heh h-heh. Espero que isto acabe em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: Estás bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: NÃO TE APROXIMES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Desculpa, eu... Pensei que me ias matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: O que te fez pensar isso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: Se eu te quisesse matar, já estarias morta há muito tempo
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: Não faço ideia de quem é Visitante e quem não é... E se...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: E se TU fores um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: Vais matar-me? Esfolar-me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: POR FAVOR, NÃO! MATA-ME RÁPIDO E SEM DOR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: EU NÃO QUERO MORRER EM AGONIA. POR FAVOR!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Relaxa, não sou um Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: Não te vou matar
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: Desculpa, estou mesmo muito nervosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: Não faço ideia em quem posso confiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: E se...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: E se tu fores um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: Vais matar-me? Esfolar-me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: POR FAVOR, NÃO! MATA-ME RÁPIDO E SEM DOR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: EU NÃO QUERO MORRER EM AGONIA. POR FAVOR!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Relaxa, não sou um Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: Não te vou matar
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: COMO É QUE POSSO SABER DISSO?! Não verifiquei os teus dentes nem os teus olhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: Vamos todos morrer. Quer seja por causa dos Visitantes ou do sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: Já não há esperança. A morte está a chegar, aconteça o que acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: Deixa-me em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: COMO É QUE POSSO SABER DISSO?! Não verifiquei os teus dentes nem os teus olhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: Vamos todos morrer. Quer seja por causa dos Visitantes ou do sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: Já não há esperança. A morte está a chegar, aconteça o que acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: Deixa-me em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: Heh h-heh. Espero que isto acabe em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: O que se passa contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: OS VISITANTES! ELES VÊM AÍ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: Não ouves? A MORTE ESTÁ A CHAMAR-NOS.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: VISITANTE, HUMANO... QUAL É A DIFERENÇA?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: SOMOS TODOS IGUAIS PERANTE A MORTE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: Então, para quê ficarmos nesta tortura? ELES QUE VENHAM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: ELES QUEREM O MELHOR PARA NÓS! OS VISITANTES QUE VENHAM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: Não me pareces muito bem
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: Ficaste maluca?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: NÃO, EU VI A LUZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: EU SOU UMA VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: NÓS E OS HUMANOS SOMOS UM. SOMOS TÃO PARECIDOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: SOMOS COMO IMAGENS REFLETIDAS NUM ESPELHO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: ACEITA A MORTE CONNOSCO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: Acho que não percebes o que estás a dizer
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: Não me estás a deixar escolha
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: NÃO ESTOU LOUCA – EU VI A LUZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: EU SOU UMA VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: NÓS E OS HUMANOS SOMOS UM. SOMOS TÃO PARECIDOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: SOMOS COMO IMAGENS REFLETIDAS NUM ESPELHO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: ACEITA A MORTE CONNOSCO! ESTÁ PARA BREVE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: Acho que não percebes o que estás a dizer
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: Não me estás a deixar escolha
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: Não, tu é que não percebes nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: A morte está a chegar! O SOL ANUNCIA A SUA APROXIMAÇÃO.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: Vamos encontrá-la em breve. Muito em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: Dispara, então! Do que estás à espera?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: VAIS MATAR SEM UM PINGO DE REMORSOS?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: Não quero saber. FAZ O QUE TENS DE FAZER, HUMANO.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: Sim? Querias alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Então, por que razão te expulsaram do bar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: Porque a série de catástrofes deixou toda a gente louca.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: O sol a explodir, os Visitantes, a crise económica e por aí fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: Deu cabo de todos. Alguns com stress, outros com álcool.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: Bem... Perdi a cabeça de tanta raiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: Subi a uma mesa no bar e gritei: "Parem de culpar tudo à vossa volta. Vamos manter a nossa humanidade."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: As lágrimas não são um incómodo no meio da espuma da cerveja – o malte e o lúpulo até sabem melhor com sal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: Quem é que precisa disto, afinal?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: Sim? Querias alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: Isto aqui é diferente?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: Já não chateio ninguém. Não vale a pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: Mas quando ouves a televisão ou apanhas uma conversa, tudo se volta a acender dentro ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: E perguntas-te: será que preciso mesmo disto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: Não, bom homem, os meus nervos já estão um caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: A vida já era uma miséria sem tudo isto e agora...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: Um dia, vou chegar aos céus e pairar sobre este mundo batizado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: Sim? Querias alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: Está tudo bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: Hm? Porquê?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: Consigo cheirar qualquer coisa em ti
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: Tens febre?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: Bem... Bebi um pouco da tua cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: Senti-me mal. Decidi beber um pouco. Não há nada de mal nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: Tudo isto é uma confusão do caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Toda a gente diz que está a resolver problemas, mas só dizem merda – nunca acontece nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: Sabes, acho que todos vamos morrer em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: Se o sol não nos matar, os Visitantes tratam disso. Se vencermos os Visitantes, enterramo-nos vivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: Se não houver problemas, havemos de os criar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Como se não conseguíssemos viver sem fazer merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Foda-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Vai-te embora. Não me estou a sentir bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: Não sou eu que estou com febre. É a merda do planeta inteiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Para onde quer que olhes, há alguém a morrer. Ou os há glaciares a derreter... ou as florestas estão a arder. O mundo inteiro está com febre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: A Terra está a tentar livrar-se de nós como uma praga.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: E um dia, vai conseguir. É de esperar que apareçam mais problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: Urghhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Desampara-me a puta da loja. Por favor. Não estou bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: Sim? Querias alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: Sentes-te melhor?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: Meu bom homem...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: Todos nós vamos morrer um dia. É inevitável.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: Já te perguntaste o que nos acontece quando morremos?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: Será o que tiver de ser, suponho
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: Nada
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: Não sei, talvez acabemos no espaço
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: Há alguma verdade no meio disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: Mas isso não me faz sentir melhor, nem um pouco. Sabes porquê?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: Quando eu estiver a morrer, o meu cérebro vai perceber. Vai começar a mostrar-me algo a que seria bom voltar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: E quando me faltarem forças para continuar esse sonho, o que acontece?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: Não. Não me sinto melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: Estava mesmo à espera que dissesses outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: Talvez tenhas razão, claro. Mas é horrível.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: Não haver nada de nada... Só... escuridão?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: Não me apetece falar agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: Se pensares bem...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: Não há nada no espaço, além de nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: Não há mais vida. Só espaço frio e vazio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: Se houvesse, já deveríamos ter encontrado algum sinal ou qualquer coisa. Não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: O espaço vazio da infinita escuridão. Se lá formos parar depois da morte, é o mesmo que desaparecer...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: Eu... quero ficar sozinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: Sim? Querias alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: Estás... Estás bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: Pelo menos, o bar tinha tetos altos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: Era possível alguém enforcar-se lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: Isto aqui é demasiado apertado para mim. O planeta inteiro é demasiado apertado para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: Meu bom homem, só quero que tudo isto acabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: Tudo isto é uma confusão do caralho. Tudo me deixa borrado de medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: Simplesmente, não consigo aguentar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: Porque é que vim para aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: Preciso de descansar um pouco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: Precisas de alguma coisa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: Que ele esteja vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: É tudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: É tudo o que preciso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: Posso trazer-te um pouco de água?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: Queres comer alguma coisa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: Vou só...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: Sentar-me aqui junto à torneira.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: Se precisar, bebo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: Então, deixo-te em paz
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: Posso sentar-me contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: Não tenho fome.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: Vou só...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: Só quero sentar-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: Então, deixo-te em paz
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: Posso sentar-me contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: Por que razão é que tinhas de morrer?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: Prometeste-me que tudo ia melhorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: Disseste que tudo ia melhorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: E depois morreste.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: Agora sou a única que resta para sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: Por que fizeste isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: Quero estar com ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: Não me consegues trazer ninguém de volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: Nem sequer consigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: Enterrar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: Nem sequer o consigo enterrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: O que é que eu faço agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: Preciso de descansar um pouco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: Como é que ele morreu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: Não consigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: É demais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: Já não consigo derramar mais lágrimas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: Já não me restam lágrimas para chorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: Não está certo... está tudo errado...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: Simplesmente não consigo parar de chorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: Ele tem de ser enterrado
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: A única coisa que resta dele é o seu corpo. Tens de aceitar isso
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: Não...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: Não, não, não!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: Não estou preparada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: Acabaram de mo devolver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: E agora temos de nos separar outra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: Não consigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: Não vou entregá-lo à terra fria e sem coração.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: Não.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: Não, isso não é verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: Ele ainda me consegue ouvir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: Eu quero mesmo acreditar nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: Preciso de descansar um pouco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: Que lembranças tens dele?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: Um dia, fomos a casa de uns amigos nossos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: Éramos bem mais novos naquela altura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: Estávamos a conviver, a beber. Ele era sempre muito calado e não falava muito em encontros daquele género.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: Bem, tínhamos bebido bastante naquele dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: Como sempre, ele manteve-se calado, e de repente disse:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: Deem-me uma guitarra. Vou cantar agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: E ele tocou tão bem... Adorei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Os nossos amigos começaram a pedir várias músicas, e ele ficou ali sentado por um momento, antes de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: Antes de dizer que tinha de ir. Derrubou um copo, tentou apanhá-lo e deixou cair a guitarra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: Mais tarde, descobri que ele aprendeu uma única música só para me impressionar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: Ainda tenho uma foto daquela noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: Está um pouco maltratada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: Agora já não podes tocar para mim. Cantaste-me a tua última música.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: Preciso de descansar um pouco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: Então, o que lhe aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: Morreu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: Compreendo. Desculpa incomodar-te
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: Não fui eu que o matei
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: Desculpa, não consigo simplesmente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: Não há uma noite em que não me caiam as lágrimas. Não as consigo conter.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: Mas mais do que tudo, quero que os culpados por... tudo o que aconteceu... queimem ao sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: Então... O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: Posso parar de te perguntar sobre isto
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: Sim. Eu sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: Isso foi rude. Mas custa-me muito falar sobre ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: Espero que aqueles cabrões tenham o que merecem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: E que alguém os mate.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: Então... O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: Posso parar de te perguntar sobre isto
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: O meu marido não se estava a sentir bem. Foi ao hospital, mas mandaram-no para aqueles cabrões.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: Fomos ao centro da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: Puseram-no apenas em quarentena. Ficaram com o telemóvel dele. Disseram que o libertariam dentro de três semanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: Fui mais cedo, só para ver como é que ele estava.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: Eles simplesmente, da forma mais fria...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Dá-me um minuto. Desculpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: Disseram: "Morreu".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: Apenas isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: Não me deixaram ver o corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: Não me deixaram levá-lo para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: Mas com aqueles imbecis é tudo uma confusão de merda. Por isso, bastou-me vestir uma bata e ir até à morgue.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: E ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: Ele estava mesmo lá...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: Mataram-no — o sangue dele está nas mãos deles. Tudo o que posso fazer agora é gritar que já não me importo com ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: Gostava de ficar sozinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Sim. Obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: Viver sem ele é tão difícil...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: Preciso de descansar um pouco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: Está tudo bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: Vou-me embora esta noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: Eu disse-te que não fazia intenções de ficar por muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: Só precisava de descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: E agora?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: Vais para a tua família?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: Não quero pensar nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: Vou voltar para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: Pegar na guitarra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: E depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: Podes ficar
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Boa sorte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: Não resta ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: Vamos voltar para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: Já não há mais nada que eu queira.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: Podes ficar
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Boa sorte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Porquê?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: Isso não me vai facilitar as coisas em nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: Não querendo ser mal-educada, sou-te indiferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: Quero mesmo ir para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: Não quero fazer nada até voltar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: Obrigada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: Não falas muito, mas... acabaste por ser um bom companheiro de conversa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: Espero que encontres o que procuras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: Hehe. Então?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: O que fazias antes do Cataclismo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: Oooh, ainda bem que perguntaste.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: Já ouviste falar de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: ...apostas desportivas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: És o quê, um burlão?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: Ei, então, pá? Eu sou analista desportivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: Se soubesses quanto dinheiro já passou pelas minhas mãos, até te espumavas, mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: Sou profissional no que faço, otário.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: As pessoas traziam-me o dinheiro e recebiam cinco... não, DEZ vezes mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: Então, e quanto é que ganhaste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: Chamas a isso trabalho?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: Era assim que ganhava a vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Manipular apostas era só uma merda para fazer, mano. A sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: Há maneiras de enganar os apostadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: Apostas numa certa equipa e esperas que a massa venha direitinha para ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: E se não tiveres dinheiro, não faz mal. Pedes emprestado a alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: Então, e quanto é que ganhaste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: Chamas a isso trabalho?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: Como hei de dizer isto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: Fiz trinta... milhões...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: ...em dívidas, sim, mas as dívidas não me incomodam nem um bocadinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: E agora, então, é que me estou mesmo a cagar para elas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: Eu encaro o perigo de frente, mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: Estás a gozar comigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: Claro que é trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: Até tinha um lugar próprio para isso. Bem, aquilo é que era luxo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Um sofá a luzir e um caderno com nomes de apostadores, valores em dívida e lucro líquido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: Hehe. Então?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: Os cobradores das dívidas ainda não apareceram à tua procura?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: Cobradores de dívidas? De que caralho é que estás para aí a falar... cobradores de dívidas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: Pffff. Caga nisso. Olha, já não tenho mais dívidas. O sol encarregou-se disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: Os bancos já não estão propriamente capazes de lidar com nada. Talvez nunca mais voltem a ser capazes disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: O que significa que estou livre como o caralho. E que posso arranjar outro esquema.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Apostar é uma cena do século passado. Tenho de pensar noutra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: O sol foi uma sorte para ti
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: E então? Queres voltar a fazer "esquemas"?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: Meeeeu, vá lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: Eu recuperava simplesmente as perdas mais tarde e pagava as minhas dívidas. Tranquilo como o esquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: Mas agora, posso começar do zero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: Aliás, tenho um novo esquema. Queres saber qual é?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: Qual é o plano?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: Nem por isso
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: Há não muito tempo, arranjei uma forma de ganhar dinheiro. Posso partilhá-la contigo, se quiseres.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: Qual é o plano?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: Nem por isso
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: Basicamente, a AGEF é que manda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: Temos de... tipo... ficar bem vistos, estás a ver?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: E acho que se entregarmos pessoas com frequência, talvez até nos levem para um bunker.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: Estás a perceber?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: Queres entregar pessoas à AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: Achas que a AGEF te vai salvar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Bem, sim. Por que caralho é que não haveria de salvar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: Acho que vamos sobreviver assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: Tempos diferentes, esquemas diferentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: Ir para o meio da multidão nas zonas de quarentena não é propriamente uma boa ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: Portanto, temos de cair nas boas graças da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: Não lhes falamos mal, entregamos pessoal...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Talvez até falemos sobre testes numa linha direta para que saibam que eu não sou um... como é...? Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: Eles são porreiros. Devem saber o que fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: Talvez tenhas razão
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: Soa-me a treta
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: Se queres tanto ir ter com eles, então põe-te no caralho
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Foda-se, mano. Não sentes mesmo os ventos da mudança.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Temos de ver quem é que está no controlo da situação e colarmo-nos a eles. É uma estratégia vencedora. A sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: Portanto, temos de cair nas boas graças da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: Não lhes falamos mal, entregamos pessoal...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Talvez até falemos sobre testes numa linha direta para que saibam com certeza que não sou um daqueles Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: Eles são porreiros. Devem saber o que fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: Talvez tenhas razão
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: Soa-me a treta
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: Se queres tanto ir ter com eles, então põe-te no caralho
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: Claro que tenho razão.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: Tenho um sexto sentido para esquemas lucrativos, mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Confia em mim, comigo não há como perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: Meeeeu, vá lá. Saíste-me cá um merdas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: As pessoas pagavam-me por conselhos de investimento. Estou a dar-te isto de mão beijada, como um presente, e tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Foda-se. Vai para o inferno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: Vais expulsar-me ou algo do género?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: Bem, pensei que fosses um gajo porreiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: Até te ofereci um esquema. Mas tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: Podes ir para o inferno, que eu vou para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: Merda, aquele esquema que inventei era mesmo muito bem. Enfim, como queiras...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Se mudares de ideias, avisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: Hehe. Então?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: O que queres?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Ouve esta, tive uma ideia para um novo esquema. Vai funcionar. A sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: Então, basicamente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: O sol está a torrar que nem uma sauna, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: Acho que a camada de ozono está toda lixada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: Mas lembro-me de que o oxigénio vem da luz do sol a passar pela camada de ozono.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: Portanto, sabes em que é que pensei?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: VENDER AR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: Isto SIM é um esquema, acredita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Que plano tão incrível como o caralho
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: Nunca ouvi nada mais estúpido na minha vida
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: A sério? Achas mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Sim, claro. Devias era ser cientista
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Raios, bem...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Obrigado. Pelo menos, alguém reconhece que sou inteligente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: Vou ganhar um Prémio Darwin em menos de nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: Tu... sabes o que é um Prémio Darwin, certo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Ah, tu vais mesmo ganhar um
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Bem... É para, tipo, contribuições para a ciência ou algo do género.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: Porquê?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: Por nada
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: Os Prémios Darwin são para pessoas que morrem de formas estúpidas
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: Haha! Já consigo sentir o cheiro do reconhecimento científico.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Montes de massa, estatuto, miúdas... Que sonho...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: Pronto, quando isto tudo acabar, vou patentear a tecnologia para vender ar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: Bem, está bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Espera aí, estás a gozar comigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: Vai-te foder. Estou aqui a pensar em planos a sério, e tu estás para aí a gozar comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: Vai-te foder. Estou aqui a pensar em esquemas a sério, e tu estás para aí a gozar comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: Vou ganhar o Prémio Darwin e vou ser um magnata.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: E, depois, vais ajoelhar-te aos meus pés e implorar por perdão...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: Sabes que mais? Vai-te foder com as tuas ideias de merda
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: Foda-se, mano...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: É assim muito difícil ouvires-me ou quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: Enfim, vai-te foder. Vou lucrar mais sem ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: Foda-se, mano...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: Vai-te foder. Estou aqui a pensar em esquemas a sério, e tu estás para aí a gozar comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: Vou ganhar o Prémio Darwin e vou ser um magnata.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: E, depois, vais ajoelhar-te aos meus pés e implorar por perdão...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: Raios... Então era mesmo verdade...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: Nesse caso, tudo o que eu disse faz sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: Não saias durante o dia. E tens de deixar entrar outras pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: Por que motivo é que haveria de deixar entrar estranhos em minha casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: Deixar entrar outras pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: Eu sei que preferes manter a distância em relação às pessoas, mas tens de o fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: A minha prima não sabe bem porque é que não podemos estar sozinhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: Mas ela disse que, se alguém perguntar se estás sozinho, diz que não e que está alguém em casa contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: As pessoas chateiam-me
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: Para que servem mais pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: Sim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: Sei que não gostas de companhia. Mas tens de as deixar entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: A minha prima não sabe bem porque é que não podemos estar sozinhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: Mas ela disse que, se alguém perguntar se estás sozinho, diz que não e que está alguém em casa contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: As pessoas chateiam-me
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: Para que servem mais pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: Estou ciente disso. Sei que não vai ser fácil para ti, mas tens de o fazer. Caso contrário, não vamos sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: Podem trazer-te alguma coisa ou ter informações importantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: E não te esqueças de as testar para ver se são Visitantes. Não vais ter muita energia durante o dia com este calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: Por isso, tens de escolher bem a quem é que vais fazer testes. Os testes são muito exigentes, portanto, presta atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: No entanto, FALAR não gasta qualquer energia. Por isso, fala o que quiseres.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: E não te esqueças de olhar para fora das janelas. A TV é um bom recurso, mas não te diz tudo o que se passa à tua volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: E depois?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: O que é que temos de fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: Podem trazer-te alguma coisa ou ter informações importantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: E não te esqueças de as testar para ver se são Visitantes. Não vais ter muita energia durante o dia com este calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: Por isso, tens de escolher bem a quem é que vais fazer testes. Os testes são muito exigentes, portanto, presta atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: No entanto, FALAR não gasta qualquer energia. Por isso, fala o que quiseres.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: E não te esqueças de olhar para fora das janelas. A TV é um bom recurso, mas não te diz tudo o que se passa à tua volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: E depois?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: O que é que temos de fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: Receio que tudo o que possamos fazer seja tentar sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: E esperar que este pesadelo acabe depressa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: Acho que o governo vai ajudar-nos de alguma forma. Talvez levem todos para um abrigo ou algo assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: Se o fizerem, fica com a minha família.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: Ah, quase que me esquecia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: Vou voltar para casa amanhã à noite. Fica com o meu número para me poderes telefonar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: Instalámos a linha há pouco tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: Vamos mantendo o contacto por telefone.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: Pronto, agora é mesmo tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: Já agora, trouxe-te uma embalagem de cerveja. O meu cunhado trabalha numa cervejaria.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: Bebe uma e vai dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: Estas cervejas dão muito sono. Se não quiseres falar com mais ninguém, bebe uma cerveja e relaxa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: Eu... Eu q-quero a minha m-mamã.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: Conta-me o que se passou
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: Não seeeeei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: Eles entraram e começaram a falar, e o pai disse que estavam errados, e eles disseram... disseram...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: PAPÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: PAAAAPÁÁÁÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: Descansa por agora
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: Amanhã volto a falar contigo, está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (A menina chama pelo pai sem parar, em histeria.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (A menina nem sequer te ouve. Está sozinha, na sua própria dor.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: Eu... Eu q-quero a minha m-mamã.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: Como estás? Gostas de estar aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: Não estou mal aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: Gostava de estar em casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: Quando é que posso ir para casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: Mais tarde... Está a ser renovada
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: Tão cedo não vai ser possível. A tua casa ardeu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: Está bem. Então, vêm buscar-me em breve?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: E vão levar-me para uma casa nova?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: Ou para a mesma?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: Estão a fazer um quarto novo para mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: Então, o pai ainda vem buscar-me, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: Tu sabes o que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: Por enquanto, deves ficar por aqui
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: Mas está tudo bem com o Papá?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: E o meu quarto? Também ardeu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: A mamã não me vem buscar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: Há mais alguém que tenha sobrevivido?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: Tu sabes o que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: Por enquanto, deves ficar por aqui
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: Não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: Não tenho a certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: Eles bateram no Papá, mas depois ele levantou-se. Eu vi-o.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: O que significa... Que ele podia apagar o fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: Ou vir à minha procura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: Ele vem em breve?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: Eu não vou a lado nenhum sem o meu Papá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: Ele vem buscar-me, não vem?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: Eu vi-o a levantar-se e sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: Eu estava a correr, mas vi-o.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: Eu... Eu q-quero a minha m-mamã.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: Tens de aceitar o que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: O que queres dizer com isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: Vi uma TV no teu quarto. Posso ver os desenhos animados lá?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: Não sei o que viste. Mas acho que o teu pai morreu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: O teu pai pode não vir buscar-te. Não sei o que lhe aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: Tu não viste nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: Eu estava lá! Ele estava a mexer-se quando fugi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: O que significa que ele está quase a chegar!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: Porque é que ainda não veio buscar-te?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: Como é que ele estava da última vez que o viste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: Ele não vem? Por que razão é que dirias isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: Porque é que ainda não veio buscar-te?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: Como é que ele estava da última vez que o viste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: Talvez tivesse algo para fazer primeiro?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: Foi bater naqueles tipos maus.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: Ele... ele deve estar a chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: Lamento pelo teu pai. Era um bom homem. Mas demasiado gentil
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: Ok, sim, claro, o teu pai deve estar a chegar em breve
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: Ele era uma boa pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: Bateram-lhe... então...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: Não me lembro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: Lamento pelo teu pai. Era um bom homem. Mas demasiado gentil
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: Ok, sim, claro, o teu pai deve estar a chegar em breve
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (A menina parece estar a perceber tudo. Tens medo de te mexer. Então, ficas à espera de que algo aconteça.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (Depois de algum tempo, ela começa a chorar. Não parece haver nada que possas fazer.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (Seria pior deixá-la acreditar numa mentira. Tem de aceitar a situação o quanto antes.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: Era o que eu pensava.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (Percebes que a menina se perdeu nos pensamentos. Está claramente a pensar em algo.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (Mas vale a pena destruir-lhe a infância? Será que consegue aguentar o choque?)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (Decides que ela já tem problemas suficientes. Não há razão para preocupar a criança.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: Oh, meu querido, estou a ficar velha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: De onde vens?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: Bem, sim. Qual é o problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: As pessoas aproveitam-se das minhas histórias e depois odeiam-me por elas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: Consegues imaginar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: Tenho uma casa. Uma cabana.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: Gosto de lá, mas sem companhia vou definhar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: E quem irá à minha cabana?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: Por isso, ando por aí. Já não tenho nada a perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: Oh, meu querido, estou a ficar velha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: Por que razão não tens familiares?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: As mais comuns. Coleciono histórias onde moro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: Então, conta-as.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: Já sou uma velhota. Não me lembro bem destas histórias. Conto-as, depois, à minha maneira.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: Podem odiar-me por isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: Sabes o que se costuma dizer: "A tristeza em si não custa tanto como a ideia de que ela virá."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: Mas não sou a única a embelezar histórias, percebes? Hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: Toda a gente vem ter comigo. Mais cedo ou mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: Toda a gente precisa de histórias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: Oh, meu querido, estou a ficar velha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: Por que andas sem o teu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: O que gostarias que eu te contasse?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: O homem é uma criatura medrosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: Conheci um homem que se isolou de toda a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: Vivia num prédio alto, trancado no seu apartamento, e mal saía.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: Tinha medo dos Visitantes ou da própria morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: Ninguém lá ia. Mesmo que lá fosse alguém, ele não abria a porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: Bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: Ouvi um barulho. PUUUM.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: Ao início, não percebi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: Olhei pela janela e... ele tinha saltado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: Não aguentou mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: Gostaste da história?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: É só isso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: Se calhar, é por isso que ninguém gosta de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: Mas não faz mal. Um dia conto a tua história da forma que me lembrar dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: Sim. O homem espatifou-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: Ou tinha medo de morrer em agonia com a explosão do sol, ou era outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: Acho que o coração dele não aguentou sozinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: Mas que se há de fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: Oh, meu querido, estou a ficar velha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: Então, que tal foi sentares-te no banco?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: Está bem, aqui vai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: Quando eu vivia na aldeia, havia lá um homem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: Ele adorava passear pela floresta. Não sei porquê.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: Mas adorava. Estava de novo a passear na floresta quando percebeu que estava perdido. Não encontrava o caminho de volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: Parou para pensar e decidiu que, se andasse em linha reta, acabaria por chegar a algum lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: Ele andou e andou, mas não conseguia encontrar uma saída.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: Foi então que percebeu que estava a andar em círculos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: E depois?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: Isso é estúpido
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: Encontraram-no morto. Nunca conseguiu sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: Seguimos os seus passos e percebemos que ele ficou simplesmente a andar em círculos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: Sabes o que se costuma dizer: há sempre uma perna que dá passos mais largos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: Foi isso que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: Porquê? Não gostas da história?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: Bem, eu embelezei-a um pouco, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: Mas aconteceu de verdade. E está a acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: As pessoas andam e perdem-se, mas como é que saem do sítio de onde estão?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: Só preciso de recuperar as forças. Se pelo menos houvesse alguém que me desse algumas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: Como está a tua irmã?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: Tenho de a ajudar. Com muitas coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: Consegui dar-lhe um banho ontem. Ela não conseguia sequer entrar na banheira lá de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: Nada de novo. Mas obrigada por perguntares.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: Pessoas com depressão são mesmo muito... complicadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: Receio que tenhamos de fugir a qualquer momento e que ela não seja capaz de encontrar a força necessária para isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: Ou que ela não seja capaz de comer só porque não tem energia para isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: Estou muito cansada também. Acho que vou descansar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: Só preciso de recuperar as forças. Se pelo menos houvesse alguém que me desse algumas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: O que vão fazer a seguir?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: Boa pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: O meu marido deve estar a caminho daqui para nos vir buscar em breve. Espero que ele possa encontrar um lugar seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: Um lugar em que nos possamos abrigar e esperar que os ataques dos Visitantes e o calor do sol passem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: Ele disse que lugares como este existem. Ele também disse que o sol não vai explodir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: Se isso acontecesse, morreríamos todos em 10 minutos ou menos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: Acho que tem ele razão.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: Só preciso de recuperar as forças. Se pelo menos houvesse alguém que me desse algumas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: Tens novidades do teu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: Por alguma razão, ainda não me contactou. Não telefonou nem nos veio buscar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: Será que lhe aconteceu alguma coisa? Talvez se tenha deparado com alguns problemas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: O que posso dizer, com toda a certeza, é que ele não nos abandonou. Isso é impossível.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: Mesmo quando ele estava completamente farto da minha irmã, nunca deixou de me ajudar com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: Ele... Ele provavelmente está a caminho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: E a minha irmã parece estar um pouco melhor... Por isso... Ele está a caminho. E vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: Só preciso de recuperar as forças. Se pelo menos houvesse alguém que me desse algumas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: Pareces melancólica
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: Ah. Provavelmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: Tenho muito em que pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: Se o sol não vai explodir, por que razão é que o calor não parou? E por que raio anda tudo só a pensar no fim do mundo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: Eu vi as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: Eles não o disseram diretamente, mas parece que o dia está a ficar cada vez mais quente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: O tempo está a mudar. Ou seja, os animais estão a morrer porque não se adaptam às novas... condições climatéricas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: O que nos vai acontecer?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: Só preciso de recuperar as forças. Se pelo menos houvesse alguém que me desse algumas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: Ei. Como estás?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: Fui lá fora ontem à noite. Queria encontrar o meu marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: Andei por alguns sítios onde o poderia encontrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: Encontrei-o num deles. Tomou um comprimido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: Fomos... fomos nós que comprámos aqueles comprimidos... para o caso de as coisas darem para o torto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: Ele tomou um, devia estar com medo... E não me levou com ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: Ele tomou-o... o comprimido. E nem uma palavra sobre o sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: É o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: Ei. Como estás?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: Sinto-me...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: Como se houvesse sobre mim um manto pesado. Mesmo muito pesado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: A colocar pressão sobre o meu corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: Eu... não quero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: É o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: Pareces um pouco mais alegre hoje
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: Sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: Tu sabias? Que o sol está a explodir?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: Só descobri esta noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: Então, isto é o fim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: Não vai restar nem o mais pequeno vestígio da nossa existência?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: É interessante pensar nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: É o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: Como está a tua irmã?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: Ela tem medo de perder tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: Acho que não temos nada a perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: Neste universo em constante expansão, somos apenas partículas de poeira.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: Ninguém precisa de nós, porque não há mais ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: Se o planeta desaparecer, ninguém vai sofrer por nós. Nem é preciso que alguém sofra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: Mas minha irmã tem pavor disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: É o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: A tua irmã está doente?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: Sim. Decidiu ir à procura do marido para não pensar em coisas más.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: Tenho a sensação de que é uma péssima ideia. Mas ela não pode simplesmente ficar sentada à espera que algo aconteça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: Se ela ainda quiser ir à procura dele, tenho de ir também.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: Não a quero perder antes de morrermos todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: É o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: Então, foram lá fora?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: Sim. Ela encontrou o corpo do marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: Ele disse-lhe que ia ficar tudo bem e, depois, suicidou-se, com medo do fim derradeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: Acho que não lhe restam mais forças.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: Agora, vou ter de cuidar dela até morrermos todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: E aí sim, todas as preocupações, medos ou sentimentos de vergonha deixarão de existir.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: Raios *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: Ei, amigo, se não for pedir muito... podes chamá-los? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: Não lhes vou pedir para me virem buscar... nem estou à procura de despedidas... Diz-lhes só...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: Diz-lhes que o pai deles não fugiu. Que... ele ficou onde foi mais preciso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: *cof cof* É tudo o que importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: Força, vai em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: O que são esses papéis?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: Não acreditarias no que contêm estes ficheiros. Algumas coisas são até... fascinantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: Esta, por exemplo. Uma teoria particularmente curiosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: Segundo ela, os Visitantes não existem. É tudo parte de um plano do governo para lidar com o excesso de população.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: É uma leitura interessante... e esquisita. Faz sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: O excesso de população continua a ser um problema, quer queiramos quer não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: Talvez tenha sido esta a forma que encontraram de "lidar" com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: Força, vai em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: Ainda andas com a cabeça enterrada nos papéis?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: Precisamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: Tenho muito mais para partilhar, se tiveres interesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: Olha, vê esta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: Ouve só: a AGEF é composta por Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: Os fatos que usam dão cobertura total. Não há forma de os testar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: Fascinante. Gosto particularmente das ideias sobre o significado de AGEF: Assembleia Geral de Extermínio do Futuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: Ou era algo diferente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: Força, vai em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: Então, o que descobriste agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: Visitantes: os deambulantes em pele humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: Parece algo saído de um romance de ficção científica, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: Mas há uma certa verdade no meio disto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: Um relatório faz menção a um homem pálido visto a andar pelas ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: No entanto, tenho de o dizer: o autor cometeu um erro relativamente óbvio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: Diz que havia DUAS perturbadoras figuras pálidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: Uma vista através das janelas e outra que aparecia junto à porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: Vá lá. Não é evidente que se trata da mesma entidade?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: "Theorist: Diria que a janela causou perturbações na visibilidade. Fez com que a cara parecesse diferente.\nUm erro de perceção."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: Ainda assim, são considerações interessantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: Força, vai em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: E se for verdade?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: E o que é a verdade, afinal? É um conceito fluido moldado pela perspetiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: A verdade de uma pessoa é o delírio de outra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: O que uma considera ser bom, outra pode ver a mesma coisa como algo mau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: A humanidade tem-se debatido sobre isto desde sempre. E, atualmente, não há respostas certas em termos de moralidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: Se as tuas crenças forem fortes, como é a minha, tornam-se na tua verdade'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: Hmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: Artigo intrigante. Bem, onde é que íamos? Ah, certo. A verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: Lembra-te disto. Só há uma verdade: os Visitantes são parasitas cerebrais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: Mantém uns tampões nos ouvidos. Sempre. E tudo vai ficar bem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: Seja como for, tenho de continuar a ler. Não me distraias. Preciso de me concentrar'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: Disseste que trabalhaste na alfândega?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: Sim, é verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: Por falar nisso, verificas a malta quanto a sinais de Visitantes, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: Não é que isto seja novidade nenhuma mas... mais vale prevenir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: E quem raio é que se lembrou de chamar Visitantes àquelas aberrações?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: Deviam ter-lhes dado um nome mais adequado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: Por que motivo odeias os Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: Que raio de pergunta idiota é essa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: É por causa deles que deu tudo para o torto! Não vês as notícias?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: O sol está a rebentar, há malta a morrer nas ruas... e tudo por causa deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: Juro-te, matava cada um deles se pudesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: Dá-me só algum tempo. Vou apanhá-los como se estivesse de volta à fronteira, vais ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: Quem me dera que o pessoal da AGEF me levasse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: Por que razão queres tanto trabalhar para a AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: Porque me preocupo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: Eu sei que é possível parar os tais Visitantes. Devem ser parados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: Até denunciei o nosso vizinho. Fiz o que estava certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: E o que foi que fizeram? Contrataram o meu marido em vez de mim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: Não me interpretes mal, orgulho-me de ter lá o meu marido, mas vá lá...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: Francamente? Foi uma chapada de luva branca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: Por que razão denunciaste o teu vizinho?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: Já te disse: era um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: E ele dava-me arrepios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: Verdade seja dita, soube-me mesmo bem denunciá-lo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: Lembrou-me dos bons velhos tempos na alfândega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: Foi aí que percebi que devia mesmo juntar-me à AGEF!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: Não é pelo teu marido que cá estás. É por causa da AGEF, não é?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: Sim. E então?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: Sim, vim até aqui para espalhar o caos até alguém lá em cima me prestar atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: Quero recorrer da decisão de me rejeitarem para o cargo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: É uma treta! Apanho o Visitante, cumpro o meu dever cívico e é a ELE que lhe dão o cargo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: Céus, não dá para perceber. É só estúpido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: Odeio aquele homem. Odeio-o com todas as minhas forças.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: Ei, tenho um pequeno favor a pedir-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: Podes telefonar-lhes? Usa o número especial interno deles: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: Diz-lhes que conheceste alguém que não falha, com experiência e vontade de trabalhar, e que até lhes deu um funcionário.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: Explica-lhes tudo como deve ser e talvez me possam deixar finalmente fazer alguma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: A alfândega era melhor, então? Pelo menos lá tinhas algum poder.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: Deixa de ser condescendente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: Não te pedi a opinião, portanto não penses que és melhor do que eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: Queres ter o controlo de tudo, não é? Esta é a tua casa e a malta vem cá toda parar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: És tu que mandas aqui e decides quem é ou não um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: Mas esse não é o raio do teu trabalho. Isso é com a AGEF. Andas só a brincar ao "Juiz Decide".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: Pelo menos a AGEF tem autoridade para tomar decisões. Achas-te mesmo melhor do que eles?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: Bem me parecia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: Só... só espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: Ainda me queres ver a matar Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: A verdade é que... mudei de ideias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: Sim, assustei-me. Eu sei. D-desculpa. Mas percebi que ainda não tinha o que era preciso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: Ainda me dá vómitos quando vejo cadáveres. E vai demorar algum tempo até ultrapassar isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: É só que... os Visitantes... diz-se que os seus corpos continuam a mexer-se. Depois da morte. Como aquele homem no beco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: Raios, não posso pensar nisso agora. Não consigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: Só... só espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: Conta-me o que se passou no beco.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: É... difícil falar nisso. Mas vou tentar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: Pensei que os becos fossem mais seguros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: Mas no momento em que virei a esquina, senti que entrei num cemitério.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: Dezenas de corpos só ali deitados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: Alguns deles ainda se mexiam. Como se não estivessem realmente mortos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: E, ao fundo do beco, havia um homem com uma arma e...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: Não... Chega. Não me quero lembrar disto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: Só... só espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: Quem era o homem ao fundo do beco?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: Era...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: Um homem com um manto, cheio de fios com dedos e dentes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: Havia um rapaz perto dele. Indefeso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: O homem no manto gritou-lhe, apontando-lhe uma arma'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: Exigiu-lhe que mostrasse os dentes e o miúdo implorou por misericórdia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: Escondi-me atrás de um contentor... E depois, não sei porquê, mas vi-me no lugar do miúdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: Ele estava a chorar descontroladamente e a implorar pela sua vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: E a seguir... bam! O seu corpo caiu, como todos os outros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: Foi aí que percebi... agora, existem dois tipos de pessoas. Presas e predadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: Só... só espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: A sobrevivência não requer que nos tornemos assassinos sanguinários.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: Como assim? Não é verdade!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: Estás vivo por causa das garras que não hesitas mostrar. És um predador! É por isso que ninguém se atreve a tocar-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: Se as pessoas te temem, estás em segurança.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: Não quero ser uma presa. Não quero morrer a chorar como um cobarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: É por isso que tenho de aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: Pai Nosso, que estais no Céu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: Então, que te parece a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: Ugh... Deplorável.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: Paredes tortas e a disposição não faz sentido nenhum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: E, já agora, puseste-me de propósito no compartimento mais miserável que encontraste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: A mobília é velha, a cair de podre, devorada por vermes e provavelmente cheia de traças.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: Nem podias pendurar uma cruz num quarto, pois não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: Oh, esquece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: Pai Nosso, que estais no Céu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: Se odeias tanto isto, não te vais embora porquê?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: Preciso de te fazer um teste.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: Achas que escolhi vir a esta espelunca? Se o mosteiro se tivesse safado, nunca teria deixado as suas paredes sagradas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: Achas que quero saber desta pilha de lixo e podridão?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: Se tivesse mais opções, não teria vindo para aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: Deus me livre, este lugar cheira a morte e a chacina. E aposto que adoras chafurdar no meio disso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: Matas toda a gente que consideras ser um demónio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: Talvez sejas um! Com cornos e tudo o resto, à espera de saírem cá para fora!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: Mas não tenho medo de nada. O Divino Pai olha pelo seu rebanho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: Pai Nosso, que estais no Céu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: Não ficaste no mosteiro porquê?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: Primeiro, o mosteiro não é meu. É a casa do Nosso Senhor Todo-Poderoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: Segundo, não fiquei por causa daqueles obscenos blasfemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: Corromperam o Seu lugar sagrado. Que o fogo divino caia sobre eles!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: Entraram por ali dentro e expulsaram-me a mim e ao meu rebanho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: Agiram como se fossem donos daquele lugar. Bárbaros, todos eles!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: Vivíamos bem e em paz. Rezávamos, jejuávamos e fazíamos o trabalho do Senhor. E aqueles animais?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: Bebiam água benta como se fosse vinho de pacote. Que se engasguem nela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: Que apodreçam no inferno!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: Pai Nosso, que estais no Céu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: O que queriam os "blasfemos"?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: Apareceram em grupo, sujos e barulhentos – a guinchar como demónios e a praguejar como os brutamontes ímpios que são!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: E porquê? Porque eu não os deixava entrar! Disse-lhes que jamais entraria ali alguém sem o sacramento do batismo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: Ficaram furiosos, oh, sim... Bateram nas portas, tentaram arrombá-las e arrancá-las.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: Depois, conseguiram entrar por ali dentro e expulsaram-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: Recusaste ajudar quem precisava?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: Também te teria tirado dali
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: Um lugar sagrado não é abrigo para os ímpios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: E o que me interessa que tentassem abrigar-se do sol ou que procurassem um refúgio contra os tais Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: Nem que chovesse fogo dos céus, a casa de Deus não é lugar para aberrações.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: O Senhor só é misericordioso para os fiéis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: Se tivessem ardido no meio da rua, era o que teria de ser. Seria o julgamento deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: És desprezível, mas não me cabe a mim julgar-te
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: É melhor ires-te embora... antes que te dê um tiro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: Seu miserável insolente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: Perdeste a cabeça?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: Sou uma serva de Deus! Expulsa do Seu templo por vermes ímpios... E tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: Atreves-te a fazer pouco de mim? A dizer que foi merecido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: Não és um homem; és uma cobra!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: BLASFEMO! NÃO PASSAS DE MAIS UM BLASFEMO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: Tinha esperança de que compreendesses, mas não és melhor do que o resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: Somos apenas servos! SERVOS DO SENHOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: Nada podemos fazer a não ser aceitar a Sua vontade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: Ele trabalha por vias inalcançáveis à nossa mente. Jamais compreenderemos o Seu poderoso plano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: És desprezível, mas não me cabe a mim julgar-te.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: É melhor ires-te embora... antes que te dê um tiro.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: Ah, então agora és um herói?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: Quero lá saber da tua barraca. Não vou passar nem mais um minuto aqui dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: Adeus. Que a raiva de Deus se abata sobre ti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: Nunca fiz planos de cá ficar, diga-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: Senti logo que não havia Deus dentro desta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: Talvez seja a forma de Ele me dizer para me ir embora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: Adeus. Que a raiva de Deus se abata sobre ti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: Maldita ferida...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: Por que razão é que a AGEF te veio buscar, afinal?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: Não tenho bem a certeza. Mas tenho um palpite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: Pensei que fosse apenas uma ronda de rotina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: Mas apostaria qualquer coisa em como aquela estúpida da porta ao lado foi a responsável por me denunciar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: Não nos suportávamos. Ela viu uma oportunidade de me tramar e aproveitou-a. Disse que eu era um "Visitante".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: Provavelmente, está muito orgulhosa do que fez, aquela puta de merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: Maldita ferida...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: Como está a ferida?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: Estou bem, a sério. Está a ficar melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: Eu disse-te, a bala entrou e saiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: As pessoas não deviam andar a atirar-se umas às outras. E este gajo? Ele só dispara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: A continuar assim, acabamos enterrados. Se não dá para dormir sobre a terra, mais vale irmos para debaixo dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: Mas não... andamos a viver de forma miserável e arrastar outros connosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: Devias ter visto aquele lunático com a arma. Otário assustador.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: Um lunático? Pensei que tinha sido o pessoal da AGEF a disparar sobre ti...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: De que lunático estás tu a falar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: Sim, eu... sim, foi a AGEF, ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: Diz-me a verdade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: Chega. Mentes muito mal
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: Estou a falar de um gajo da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: Tinha um ar muito ameaçador quando o vi... cara a cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: Isto é, quando ele disparou sobre mim... nas costas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: Diz-me a verdade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: Chega. Mentes muito mal
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: Está bem, está bem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: A verdade é que, sim, fugi da zona de quarentena. Mas não houve qualquer tiroteio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: Um médico ajudou-me. Falsificou os documentos e deixou-me sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: Não posso voltar para casa. Ela ainda lá está. A vizinha que me denunciou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: Por isso, procurei um lugar onde pudesse ficar escondido. E foi então que me deparei com o tal tipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: Só lhe queria perguntar onde é que podia passar a noite. E depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: Consegui ver uma caçadeira nas costas dele e o colar de dentes e unhas. Com um beco cheio de corpos atrás dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: Nessa altura, soube logo que ele era um verdadeiro maníaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: Ouve, estou a ficar com dores outra vez. Importas-te que me deite por um bocado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: Raios...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: Ouve, eu explico-te tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: A verdade é que, sim, fugi da zona de quarentena. Mas não houve qualquer tiroteio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: Um médico ajudou-me. Falsificou os documentos e deixou-me sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: Não posso voltar para casa. Ela ainda lá está. A vizinha que me denunciou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: Por isso, procurei um lugar onde pudesse ficar escondido. E foi então que me deparei com o tal tipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: Só lhe queria perguntar onde é que podia passar a noite. E depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: Eu vi-o… Espingarda às costas, colar feito de dedos e dentes, beco repleto de corpos atrás dele…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: Nessa altura, soube logo: era um verdadeiro maníaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: Ouve, estou a ficar com dores outra vez. Importas-te que me deite por um bocado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: Raio de ferida...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: Fala-me sobre aquele lunático da espingarda
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: Sim, aquela aberração, cheia de dentes e dedos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: Ele viu uma sombra de dúvida na minha cara e apontou-me a arma. Consegui agarrá-la e enfrentámo-nos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: Ambos lutámos pela arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: Ele disparou e, logo a seguir, espetei a cabeça dele no chão e fi-lo perder os sentidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: Corri. O máximo que pude. E, depois, senti dor na barriga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: Olhei para baixo e tinha sangue em todo o lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: Não te disse que ele disparou sobre mim, porque achei que não me fosses deixar entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: Em tempos como estes, toda a gente se está a tentar proteger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: Sê honesto: se soubesses que um psicopata armado me estivesse a perseguir, permitias que entrasse em tua casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: Precisava de abrigo. Não quero morrer como aqueles pobres coitados naquele beco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: Por isso, sim, menti. Espero que me possas perdoar. Não fiques rancoroso por causa disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: Tudo bem. Podes ficar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: Agora não consigo confiar em ti. Vai-te embora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: Obrigado. A tua compreensão significa muito para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: Esperemos que aquela aberração não apareça. Ainda bem que também estás armado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: Talvez alguém já tenha tratado dele. Olha, se calhar até o tal Visitante pálido e magricelas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: Bem, acho que tinha razão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: Vês? Menti por um bom motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: Até mais ver, seu otário!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: Oh não... Para onde é que foram...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: Como estás?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: Não sei... Só quero ter os meus pais de volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: Cuidaram de mim a vida toda e, agora... não sei o que lhes aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: Espero que estejam bem. Não me consigo imaginar sem eles...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: Oh não... Para onde é que foram...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: Tens mais família por aí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: Quase ninguém. Se bem que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: Encontrei recentemente uma irmã mais velha... do primeiro casamento do meu pai. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: Caraças, a minha avó!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: Oh céus, acho que já sei para onde é que os meus pais podem ter ido...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: E se a avó se tiver transformado num Visitante e acabou por matá-los? E se a AGEF os levou?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: Porquê? Não ficaram porquê? Por que raio é que não me levaram com eles? PORQUÊ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: NÃO VOU CONSEGUIR SOBREVIVER SOZINHO. POR QUE ME DEIXARAM PARA TRÁS?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: Oh não... Para onde é que foram?...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: Estás mais calmo? E a tal irmã de que me falavas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: Bem, eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: Pouco antes de terem saído, recebemos uma carta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: O meu pai deu-ma, porque nunca vejo a caixa de correio. Disse-me para a ler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: Era da "irmã".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: Dizia que me queria conhecer. Mas... eu não sabia o que pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: Francamente, ao início pensei que fosse alguma partida. Mas foi o meu pai que ma deu, por isso, não poderia ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: Ele disse-me que eu não era o seu primeiro filho. Que durante todo este tempo eu tive uma irmã...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: Ou meia-irmã. Apenas do lado do meu pai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: Foi estranho ouvir aquilo. Não soube como lidar com aquela informação.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: Quero dizer, ela é supostamente minha "irmã", mas é uma verdadeira estranha... que esquisito...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: Eu... acho que gostaria de falar com ela. Mas tenho demasiado medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: Talvez possas telefonar para ela por mim? Aqui está o número: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: Diz-lhe só que... existo. Que não sei o que fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: Oh não... Para onde é que foram?...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: Por que razão não queres ir para casa da tua irmã?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: Mal a conheço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: Quando os meus pais me contaram a verdade, senti que me tinham estado a mentir desde sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: Fiquei mesmo chateado e fui para o meu quarto. Só queria que me deixassem em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: E, depois, no dia seguinte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: Aconteceu o que te contei. A TV, o pânico e depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: Deixaram-me mesmo para trás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: Céus, juro que daria tudo para ver os meus pais mais uma vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: Meu Deus, porquê...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: Vai para casa da tua irmã. Ela não te vai mandar embora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: Tens a certeza de que os teus pais morreram?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: A sério? Achas mesmo isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: Mas eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: Nunca fui para tão longe sem os meus pais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: Ela vive muito longe daqui. Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: Tenho medo. Acho que não consigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: Usa um táxi. Ainda estão em atividade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: Tens de fazer alguma coisa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: Bem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: Não voltaram para me vir buscar, por isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: Não sei...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: Tenta encontrar a tua avó
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: Tenta procurar nas zonas de quarentena
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: Ei, essa... até que não é uma má ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: Embora tenha ouvido dizer que os táxis são agora muito caros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: Mas trouxe o dinheiro dos meus pais comigo. Talvez seja o suficiente para pagar uma viagem até casa da minha irmã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: Obrigado por me meteres juízo na cabeça. Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: Talvez tenhas razão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: Talvez tenha estado dependente dos meus pais durante muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: Obrigado por me meteres juízo na cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: Vou tentar arranjar um táxi. Felizmente, trouxe o dinheiro dos meus pais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: Espero conseguir fazer isto. Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: Talvez... tenhas razão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: Talvez o carro deles tenha avariado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: Sim, o pai andava a dizer que precisava de ser reparado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: Mas a avó recusa-se a ter um telefone. Talvez tenha sido por isso que não me telefonaram?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: Talvez... talvez os encontre mesmo lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: Obrigado por me meteres juízo na cabeça. Devia ir andando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: Bem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: Talvez estejam mesmo lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: Acho que tenho de tentar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: Obrigado por me meteres juízo na cabeça. Devia ir andando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: Fala à vontade, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: Como te sentes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: Impecável, amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: Dei uma espreitadela ao teu frigorífico... bem, se soubesse que tinhas assim TANTA cerveja...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: Onde a arranjaste? Tens algum tio a trabalhar numa cervejaria ou assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: Ah, quero lá saber! Fica lá com os teus segredos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: Porra, se não fosse por esta porcaria toda, podíamos estar a relaxar, a beber umas jolas fresquinhas e a ver a bola. Até te apresentava a...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: Estás bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: Desligaste a ficha ou quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: Hã? O quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: Não interessa. Esquece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: Não, eu só...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: Hmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: Estava só a pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: Fala à vontade, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: Pareces em baixo, hoje
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: Não quero abordar isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: Abordar o quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: Do que é que estás a falar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: Não importa. Não ias perceber.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: Tenho de saber
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: Tudo bem, não vou insistir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: Ouve, não quero mesmo falar sobre isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: Tenho de saber
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: Tudo bem, não vou insistir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: Não insistas! Mal consigo aguentar tudo isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: Só... deixa-me em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: Obrigado. Não me estou a sentir muito bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: Fala à vontade, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: O que se passa contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: Não é da tua conta, amigo! Baza!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: Diz-me só o que se está a passar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: Vais ter de falar. Ou será pior se não o fizeres
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: Não consigo... Vais começar a olhar para mim de maneira diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: Mas ao mesmo tempo... não consigo guardar isto dentro de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: Eu tive uma cadela. Morreu há uns anos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: E então?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: E?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: Estás a planear dar cabo de mim, amigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: Está bem. Queres que te conte a verdade?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: Eu tive uma cadela. Morreu há uns anos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: E então?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: E?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: E é isso. Ela estava velha, doente... mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: Ela simplesmente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: Matei-a.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: O que foi que fizeste?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: Seu cabrão doentio!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: Matei-a.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: O que foi que fizeste?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: Seu cabrão doentio!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: Eu sei o que parece. Mas deixa-me falar, amigo. Ela... ela estava a sofrer. Simplesmente, não conseguia mais ver aquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: Dia após dia, via a dor nos olhos dela. Ouvia-a a gemer e a choramingar à noite devido à dor nas pernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: POR CAUSA DO CARALHO DAQUELE CARRO! Se aquele taxista não andasse a conduzir que nem um louco, ela ainda estaria viva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: Raios, daria tudo para poder torcer o pescoço do gajo. Mas ele fugiu e não consegui ver a matrícula...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: Não fazes ideia da dor que é perder um animal de estimação.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: Sabes o que se diz: para nós, são só um capítulo. Mas para eles, somos a sua vida toda. E dão-nos tantas lições...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: Tudo bem, podes ficar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: Sim, eu sei... Sou um cabrão. Ainda não me consigo perdoar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: Ela... ela estava a sofrer. Não conseguia ver mais aquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: A cada dia, ela ia ficando pior. As noites eram mais dolorosas... chorava, gemia... e as lágrimas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: Já alguma vez viste um cão a chorar? Os olhos dela imploravam-me que acabasse com o sofrimento dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: Eu não queria! Juro que não! Eu nunca devia...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: FILHO DA PUTA DO TÁXI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: O cabrão passou a minha cadela a ferro! E, depois, seguiu como se nada tivesse acontecido!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: Como se ela fosse uma pedra qualquer no meio da estrada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: Raios, daria tudo para poder torcer o pescoço do gajo. Mas ele fugiu e não consegui ver a matrícula...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: Não fazes ideia da dor que é perder um animal de estimação.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: Sabes o que se diz: para nós, são só um capítulo. Mas para eles, somos a sua vida toda. E dão-nos tantas lições...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: Tudo bem, podes ficar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: Obrigado, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: Fico feliz que compreendas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: Tens razão, amigo. Talvez seja o melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: Penso nisto todos os santos dias... se fiz a coisa certa ao acabar com o sofrimento dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: Acho que nunca vou chegar a saber...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: Tanta escuridão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: Então, conta-me, o que foi que viste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: Não vais querer saber. Acredita. É mesmo pelo melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: Pensei que se deixasse de ver, nunca mais voltaria a deparar-me com a imagem daquela... coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: Mas é algo que me ficou gravado na memória.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: Continuo a sonhar. É algo sempre presente. E que me inunda a mente constantemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: Tanta escuridão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: Então, achas que estás melhor sem veres coisa alguma?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: Não sei bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: Sei que nunca mais vou voltar a ver. Mesmo que algo me mate, não vou saber o que me matou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: Por outro lado... é estranho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: Não sei como é a tua casa. E é difícil percorrê-la. Teria muitas dores nas órbitas se não fosse pelos medicamentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: Eu cá me arranjo. Pelo menos, não terei de voltar a ver aquele horror.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: Mesmo assim, tendo visto tudo aquilo... é algo que não se esquece e que permanece até ao fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: Tanta escuridão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: Pareces estar em mau estado
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: Faz-me falta um pente, é? Huh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: Tive um sonho na noite passada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: Estava a andar junto aos carris do elétrico, a caminho de casa. Casas em todo o lado. Árvores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: Ouvi o elétrico a chegar e afastei-me para o lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: Virei-me... e vi algo a puxar um homem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: Moveu-se tão rápido que não consegui ver sequer o que era. Mas eu sabia. Eu sabia o que era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: Fui atrás do elétrico, mas em vão. Nunca o vou alcançar. Nunca tentes chegar à verdade que se esconde no fim da linha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: Depois, acordei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: Tanta escuridão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: Estás bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: Outro sonho. Voltou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: Estava a andar por uma rua. Era de noite. A iluminação da rua estremeceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: Virei-me e vi-o a correr na minha direção. Lentamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: Desta vez, vi como se movia. De forma nítida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: Tentei fugir, mas estava a ganhar-me terreno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: Cheguei à minha casa, mas não consegui abrir o portão. Trepei a cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: Emaranhadas nos meus bolsos, as chaves escorregavam-me pelos dedos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: Então, corri à volta da casa. Outra cerca. Voltei a trepar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: Parei. Não se ouvia qualquer som.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: Olhei para cima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: E ali estava. A abater-se sobre mim por cima da cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: Talvez seja só efeito dos analgésicos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: Tanta escuridão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: Tiveste mais sonhos na noite passada?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: Sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: Não quero falar sobre isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: Agora compreendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: Vamos morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: Vai destruir-nos. Quer estejamos acordados ou a dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: O sol vai queimar-nos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: Nada mais importa. Acabou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: Eu... deixa-me em paz. Por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: Yo, bacano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: O que fazias antes do cataclismo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: Preciso de te fazer um teste.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: Relaxava, pá. Via umas séries, passava tempo com os meus compinchas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: Agora, esquece lá isso tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: A TV não para de cuspir a mesma porcaria e os mesmos anúncios marados. O meu pessoal nem sequer atende o telefone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: Ouvi um manda-chuva qualquer a dizer "Agora não é altura de nos divertirmos, estamos no meio de uma crise..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: Meu, ele que se lixe. Eu é que sei quando é altura de me divertir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: Yo, bacano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: Qual era o teu trabalho?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: Trabalho? Pfffft.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: Bacano, trabalho é para os parvos. Eu vivia a vida, pá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: Vi uma vez um filme. Sabes como era a personagem principal? Igualzinha a mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: Diz-me lá isto, a malta que trabalha em fábricas parece-te feliz? Claro que não!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: Eu dava festas, conhecia gente nova... aquilo é que era viver a vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: Está bem, está bem... cheguei a ser gerente de um armazém. Posto de entregas. Graças aos meus velhotes, sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: Então, andas a viver à conta dos teus pais?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: Então, és só um vadio preguiçoso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: Para que me vou esforçar, bacano? Tenho tudo controlado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: Não ia usar o que tenho ao meu dispor? Isso seria só parvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: Tipo, tu tens uma arma. Vais pendurá-la na parede ou vais usá-la?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: Lá está. Não sou burro. Tiro partido das minhas vantagens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: Yo, calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: Se tens inveja, é só dizeres, bacano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: Eu entendo, nem toda a gente ganha o jackpot. É a vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: Yo, bacano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: Passa-se alguma coisa de errado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: Bacano, onde estão os teus filmes? Tens, tipo, zero cassetes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: Vias alguma coisa sequer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: Estou a morrer de aborrecimento aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: Não estamos em altura para filmes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: Não tenho nenhum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: Meu, pensei que esta casa fosse grande cena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: Mas a malta que aqui tens? É um bocado fatela. E não tens nada que se veja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: Nada de revistas, nada de séries... só livros...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: Quem é que lê, meu? Isso é uma cena da idade da pedra! Só palavreado e descrições intermináveis. Que bela seca...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: Isto não é nenhum cinema
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: Estás aqui para a farra ou para sobreviver?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: Espera, o quê?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: Bacano, não pode... estás mesmo a falar a sério?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: Tens uma TV no teu próprio quarto e nem um único filme?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: Mano, isto aqui é uma seca de morte. Pensei que fosses fixe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: Isto não é nenhum cinema
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: Estás aqui para a farra ou para sobreviver?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: Meu, vá lá...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: És o maior corta-mocas que já conheci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: Se queres sobreviver, acalma-te.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: Se não gostas de estar aqui, podes ir-te embora.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: Meu, vá lá...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: A TV de minha casa avariou, pá. Estava à espera de que me salvasses do aborrecimento, mas nããão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: És o maior corta-mocas que já conheci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: Acalma-te, se quiseres sobreviver
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: Se não gostas de estar aqui, podes ir-te embora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: Tudo bem, como queiras, bacano. Isto aqui é uma treta, mas sempre é melhor do que a rua.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: Só... deixa-me ver um bocado de TV, pá. Só um bocadinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: Eu sabia! Saíste-me cá um corta-mocas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: Vou mas é bazar daqui para fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: Pobres pequenotes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: Estás bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: Suponho que sim... não sei bem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: Eu... eu não consigo compreender como é que gente crescida e racional se deixa levar pelas emoções e faz algo assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: Têm assim tanto medo ao ponto de matarem uma criança?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: Há coisas piores a acontecer hoje em dia
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: No meio do caos, a razão é a primeira coisa a desaparecer
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: O que poderia ser pior do que matar uma criança?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: Não era só uma pessoa... era uma multidão, um monte de gente, numa caça às bruxas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: Talvez os tempos difíceis nos mostrem quem somos. Se calhar, nós é que somos monstros e não os que vieram do subsolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: Mas as pessoas não percebem que matar crianças é... Nem consigo encontrar palavras...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: Talvez os tempos difíceis nos mostrem quem somos. Se calhar, nós é que somos monstros e não os que vieram do subsolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: Pobres pequenotes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: Há quanto tempo és professora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: Fui professora durante cerca de três meses antes do cataclismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: Mas... não era um exemplo de professora. Não gostava daquele trabalho, e os miúdos eram barulhentos e cansavam-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: O cataclismo mudou tudo. Abriu-me os olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: Sabes, qualquer uma daquelas crianças poderia ter sido uma estrela de rock, um político ou um pai ou uma mãe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: Mas agora, nunca mais poderão tocar numa guitarra, ir à escola ou só... crescer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: Serão um... exército de sonhadores. Para sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: Lembro-me de uma das crianças a entrar na sala a correr. A chorar. A dizer que os pais tinham medo dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: Pensaram que ele era um Visitante e... expulsaram-no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: Ele não sabia mais para onde ir, portanto veio ter comigo... ao jardim de infância.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (A mulher, sem conseguir conter as lágrimas, chora)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: Perdão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: Pobres pequenotes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: Queria pedir-te desculpa por ontem, não te quis perturbar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: Está tudo bem. Eu... estou bem agora. Já me sinto melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: Em relação àquele menino... Depois dele, percebi como as crianças são indefesas. Principalmente quando tudo corre mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: Comecei a acolher cada alma solitária e abandonada que conseguisse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: Fiquei a conhecer as suas histórias... Foi insuportável ouvir como alguns pais os descartaram sem pensar duas vezes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: Como se o cataclismo fosse uma desculpa para desistirem de uma criança.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: Talvez... nunca tenham querido ter filhos, na verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: Pobres pequenotes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: Tens filhos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: Não, eu... A minha mãe costumava dizer-me para assentar e ter um filho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: Mas não estava preparada. Queria que isso fosse uma escolha consciente, quando sentisse que era a altura certa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: Depois de ouvir todas aquelas histórias das crianças abandonadas... Não pude deixar de o imaginar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: Se tivesse dado ouvidos à minha mãe, é possível que eu viesse a ser como os pais daquelas crianças.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: É por isso que escolhi ajudar cada criança abandonada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: Sabes qual é a pior parte? Um dos incendiários era um dos pais de uma das crianças que acolhi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (Mais uma vez, a mulher não consegue conter as lágrimas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: Perdão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: Eu... eu tentei mesmo dar-lhes uma boa vida. Gostava muito deles. As coisas não deviam ter acabado desta forma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: Lamento...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: A morte deles não é culpa tua
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: Lamento muito pela tua perda
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: Talvez tenhas razão. Mas... sinto-me tão vazia cá dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: Sabes o que é que não consigo deixar de pensar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: Será que os pais deles alguma vez chegaram a sentir algo por aqueles miúdos? E se nunca os amaram?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: Só... só espero que tenham sentido um pouco de amor por minha causa. Nem que seja por um bocadinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: Obrigada... mas ainda me sinto devastada. Acho que nunca vou conseguir ultrapassar isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: Sabes o que é que não consigo deixar de pensar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: Será que os pais deles alguma vez chegaram a sentir algo por aqueles miúdos? E se nunca os amaram?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: Só... só espero que tenham sentido um pouco de amor por minha causa. Nem que seja por um bocadinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: Gatinho estar aqui. Que mais precisas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: Por que estás aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: Que pergunta parva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: Tu abriste porta. Pergunta-te para quê. Para que sirvo eu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: É tudo igual para mim, lugar é lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: Disseram "vai para aqui" e fui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: Não quero nada de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: O que importa é manteres este lugar confortável para gato. O resto? Não querer saber.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: Gatinho estar aqui. Que mais precisas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: És humana, sequer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: E tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: Sobra alguma coisa dentro de ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: O que me torna pior do que tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: Gatinho estar aqui. Que mais precisas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: Quem te disse para vires para aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: Já fizeste o que tinhas a fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: Por que te preocupar com o resto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: Alguém que... ambos conhecemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: Mas não disse o que fazer a seguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: Gatinho estar aqui. Que mais precisas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: Por quanto tempo planeias ficar aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: Até que me venham buscar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: O que mais é suposto fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: Não sei. Foi-me dita coisa. Agora, espero até dizerem mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: E quem te diz o que tens de fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: De quem estás à espera?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: Gatinho estar aqui. Que mais precisas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: Por que razão ainda não me mataste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: És bocado burro, sabias?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: Todos os dias a mesma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: Já te disse: não me disseram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: Eu espero. Por que estás à espera?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: Está abafado aqui dentro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: Estás bem? Como está o bebé?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: Sim, sim... Ele... ele está cansado, tal como eu. E ele é tímido com gente nova, portanto, mantém-se mais perto de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: As crianças têm mais problemas a lidar com coisas como estas. Mesmo quando não se queixam, dá para ver como ficam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: Por vezes, sinto que sou culpada por arrastá-los para isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: Mas, agora, é demasiado tarde para mudar o que seja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: O que se passa, amor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: Por que estavam na rua?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: Oh, íamos visitar a mãe da minha querida esposa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: Percebemos a tempo que não íamos conseguir sem ajuda e, bem, encontrámos a tua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: Obrigado por nos deixares cá ficar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: O que se passa, amor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: A que distância fica esse lugar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: A minha princesa não é a melhor com as direções por aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: Sem a ajuda de mais ninguém, diria que fica a uns dois dias daqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: Isto é, tendo em conta o tempo que demoramos a descobrir o percurso certo e as vezes que nos perdemos pelo caminho. Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: Mas se alguém nos desse boleia, seria perfeito. Diria que a viagem demoraria um par de horas, no máximo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: Mas porquê, já agora? Por que iam visitar a mãe dela de repente?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: O momento não podia ser menos oportuno para isso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: Pode ter-lhe acontecido alguma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: O telefone da mãe dela tem estado desligado. Não conseguimos falar com ela há alguns dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: Temos de garantir que está tudo bem com ela. Pode estar a precisar de ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: E as noites são mais curtas agora. É um bocado assustador andar por aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: Mas está tudo bem, vamos ver a tua mãe em breve, sim, querida?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: Não me lembro do caminho e a minha mulher confunde sempre as direções.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: Mas não há problema. Tudo o que importa é seguirmos em frente, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: Talvez lá cheguemos dentro de uma semana! Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: O que se passa, amor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: Pensei que se fossem embora esta noite
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: Tipo, a minha querida esposa demorou umas boas três horas a arranjar-se. Já era demasiado tarde para sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: Portanto, vamos depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: Da próxima vez, seremos mais rápidos. Desculpa o incómodo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: Vou garantir que esta lesminha não nos volta a atrasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: Não estamos a dar muito trabalho, pois não? Desculpa, mais uma vez!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: O que se passa, amor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: Está tudo bem, menina?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: Ela está bem. Estás a fazer-lhe perguntas porquê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: Eu é que falo contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: Está um bocadinho agitada, é só isso. Não há motivos para preocupações.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: A pergunta é para ela
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: Como estás?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: Ela está cansada. Não insistas mais com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: Francamente, acho que deixou de se preocupar com a mãe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: Mas está tudo bem. Esta lesminha vai acabar por voltar a mexer-se e vamos visitar a mãe dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: Se ela ainda estiver viva, haha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: Vá lá, querida, despacha-te lá. Merda! Quanto mais tempo vou ter de ficar à espera?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: Oh, no geral está tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: Parece que a minha fofinha se está a marimbar para a sua própria mãe, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: Talvez lhe deva dar um empurrãozinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: Lamento que tenhas de ouvir isto. Ela está a dar-me cabo do juízo com toda aquela lentidão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: Senta-te e prepara-te. Estou farto da puta desta espera! Merda!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: O que se passa, amor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: A tua esposa não quer sair daqui. O que se passa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: Está a foder-me a cabeça toda, percebes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: Sempre a queixar-se, sempre a culpar-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: Tipo, cala-te de uma vez e faz o que te digo. Em vez disso, é sempre a complicar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: Desculpa a estadia prolongada, a sério. Este é o último dia. Vamos embora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: Ouviste? Faz o raio da mala. Se ainda cá estivermos à noite, juro que te atiro pela janela fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: Está mesmo tudo bem, menina?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: O que se passa aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: Não te metas, por favor. Já te disse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: Para de te intrometer. Isto não é da tua conta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: Nós tratamos disto. Não me enerves.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: Preciso de saber a verdade. Estou farto das tuas merdas (Saca da tua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: Não quero saber. Vão sair ou não?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: Ouve, oh senhorio, já te disse que está tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: A minha mulher está só aborrecida, portanto está a fazer uma cena. Irrita-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: O que queres de mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: Preciso de saber a verdade. Estou farto das tuas merdas (Saca da tua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: Não quero saber. Vão sair ou não?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: Calminha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: Tenho uma arma na mão. Se tentares fazer alguma coisa, mato esta estúpida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: Não tenho nada a perder, pois não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: Vais morrer de qualquer forma
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: Ainda te podes afastar disto. Tens uma oportunidade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: Sim, sim, não vamos ficar aqui mais tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: Vamos embora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: Ouviste? É a nossa última noite aqui. Vê se te preparas e se deixas de me fazer perder tempo, caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: O que tenho a perder? Matas-me, e então?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: Pelo menos o sofrimento acaba. E esta estúpida morre comigo. Morro satisfeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: Vou disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: Acalma-te. Larga a tua arma e eu baixo a minha
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: Porquê? Tenho de sair daqui com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: Não me vou embora sem ela. Portanto, baixa a tua arma. Saímos esta noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: Não é preciso ninguém magoar-se. Basta que deixes isto passar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: Vou disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: Acalma-te. Larga a tua arma e eu baixo a minha
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: Vais mesmo disparar sobre uma mulher? Não tens coração?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: Se disparares sobre mim, eu disparo sobre ela também. O sangue dela vai ficar nas tuas mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: A... a culpa não é minha! Tu é que és o assassino!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: Dispara
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: Avisa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: Tenho de sair daqui. Ou ambos morremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: Não há outra forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: Se aquela estúpida tivesse deixado de tremer que nem uma vara verde e tivesse simplesmente vindo comigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: Isto é tudo culpa dela. Ouviste? Arruinaste tudo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: Dispara
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: Avisa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: Estás... estás a baixar a arma?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: Espera, ainda estás a planear disparar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: ESPERA – NÃO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: Pronto! Está bem. Nós vamos embora. Sem criar mais problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: Ai sim? Vais mesmo embora esta noite, é? Sua estúpida de merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (De repente, a mulher solta-se. O homem dispara sobre ela)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (Reages instantaneamente e dás um tiro na cabeça do homem)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: (Parece que ambos morreram. Pelo menos, acabou tudo)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: (Que casal mais doido)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: Tudo bem, nós vamos embora. Agora. Vamos só buscar algo para nos cobrirmos e depois vamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: Nunca mais nos vais voltar a ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: Espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: O QUE ESTÁS A FAZER?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (Disparas contra o homem e acabas por acertar também na mulher)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (Ambos caem, a sangrar)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (A mulher gorgoleja por um momento, mas não a podes ajudar)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (Ambos morreram)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: Não percebes? Esta é a única maneira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: Acabou, vamos embora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: Ei! Vai buscar o cobertor. Já! Toca a andar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (Vês os dois a cobrirem-se e a irem para fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: Dão alguns passos. Mas, de repente, caem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: Surge fumo a partir do cobertor. Afastas-te)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: Ainda continuas com esperança?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: Não exatamente... mas também não me sinto um caco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: Ainda somos humanos. A aguentar as pontas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: Não tornamos as coisas piores do que já estão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: E quando o fim chegar... acho que nos vamos conseguir perdoar pelas coisas que fizemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: Enquanto existir compaixão, a humanidade perdura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: Percebes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: Foste sempre assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: Na verdade... não. Nem sempre. Tinha muita raiva dentro de mim. Contra as pessoas, contra o mundo... contra mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: Passava-me por tudo e por nada, virava mesas, rebentava portas. Mas acabei por perceber que a raiva só nos consome.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: A um nível interior em primeiro. E, depois, a nível geral... consome tudo à tua volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: Uma vez virei-me a uma pessoa que só me queria ajudar. E agora... ele... ela... já cá não está.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: Esse momento destruiu algo dentro de mim. Soube que tinha de mudar ou iria destruir tudo ao meu redor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: Por isso, aprendi a soltar-me das coisas. A respirar. A fazer as pazes. Foi assim que cheguei até aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: O que foi que perdeste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: A minha família.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: A nossa casa ardeu depois de eu sair por um momento para ir buscar água. Quando voltei, só encontrei fumo e cinzas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: Demorei muito a aceitar. Continuei a debater-me sobre os motivos para sair naquele momento e não os conseguir salvar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: Talvez não seja essa a questão. Se calhar, não se trata de salvar o passado. Talvez tudo se resuma a avançar com ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: Eles ainda continuam comigo, de certa forma. A memória deles dá-me força. É por isso que tento ajudar as pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: Sei o que é a perda. E sei o que significa encontrar um propósito depois de tudo ficar em ruínas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: E conseguiste viver com isso? Com a perda deles?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: Sim, consegui ultrapassar tudo. Mas não foi fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: Culpei-me por muito tempo. No entanto, se tivesse voltado uns minutos antes, talvez as coisas tivessem sido diferentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: Mas o luto alimenta-se da culpa. E a vida precisa de perdão. Se não me soltasse disto, também acabaria por me perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: Perdão... é o que me salvou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: Perdoei-me por não conseguir mudar o passado. Até perdoei o destino, mesmo tendo sido tão cruel. A raiva só me consumia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: Então o que te motiva agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: Acredito que as pessoas podem ser melhores. Até mesmo na confusão em que estamos metidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: Não acredito em milagres ou divindades. Acredito nas pessoas. Na forma como nos ajudamos uns aos outros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: Alguém que levanta quem cai, que sorri num dia mau, que partilha o seu último bocado de pão. A vida é isso mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: Sempre que alguém torna o mundo um pouco melhor, sei que nada disto foi em vão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: Gostavas de ter tudo de volta? A tua casa, a tua família...?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: Se os pudesse ver outra vez... falar com eles, abraçá-los... é claro que o faria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: Mas ter tudo de volta? Não sei. A perda faz parte da vida. É terrível, magoa, mas molda-nos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: Claro que dava quase tudo para poder ter mais um dia com eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: Mas se isso significasse abdicar de tudo o que aprendi... como perdoar, como continuar em frente... Não. Não o quereria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: "Luka: O tempo é limitado. É melhor agarrarmo-nos ao que temos agora do que sermos consumidos pelo que perdemos.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: Mantém-te alerta. Qualquer um de nós pode ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: És um caçador, não és?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: Sou mais uma espécie de guarda florestal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: A minha casa era o ambiente. Sem TV. Só tinha rádio. Foi assim que soube o que estava a acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: Decidi que não deixaria ninguém entrar na minha propriedade. O meu lar é a minha fortaleza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: E se entrasse algum Visitante? Ludibriava-me e depois cortava-me a garganta durante o sono.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: Então, por que estás aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: Não é seguro ficarmos sozinhos
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: Raios me partam se deixo aquele otário pálido me pôr as mãos em cima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: É por causa dele que deixei a minha cabana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: Vejo-o nos teus olhos. Também o viste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: Como sobreviveste lá fora sozinho?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: Também viste o Visitante pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: Achaste que ainda não tinha percebido, oh génio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: De outra forma, estaria agora a ser comido pelos vermes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: Costumava pensar que era estúpido deixar entrar estranhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: Achava que estava mais seguro sozinho. E, depois, aparece-me aquela aberração.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: Nunca vi tamanha besta como aquela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: Como sobreviveste lá fora sozinho?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: Também viste o Visitante pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: Oh miúdo, essa é uma longa história. Não estou com disposição para falar hoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: Traz-me uma cerveja amanhã. Conto-te tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: Então, não sou o único.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: Sim... estou a ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: Oh, miúdo... Se soubesses o que passei...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: Eu conto-te. Mas não hoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: Traz-me uma cerveja amanhã e eu conto-te tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: Mantém-te alerta. Qualquer um de nós pode ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: Então, conta-me lá a tua história.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: Trouxeste cerveja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: 'Sim (dá-lhe a cerveja) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: O quê? Não tens cerveja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: Hunter:…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: Não (não lhe dês a cerveja)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: Esta serve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: Como te disse, estava abrigado na minha cabana, sem chamar atenções.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: Foi então que apareceu um gajo. A arfar, desesperado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: Começou a bater à porta, a implorar-me para o deixar entrar. Mas houve algo de estranho no meio daquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: Era pálido, estava agitado, parecia que tinha visto a morte. Não faço ideia como conseguiu avançar tanto pelo bosque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: Não tinha ar de quem andava ali numa caminhada. Portanto, disse-lhe para se pôr a andar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: Tentou partir a janela, mas gritei-lhe que tinha uma espingarda comigo. Isso fez com que saísse dali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: Pensei que nunca mais o voltaria a ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: Se calhar, devias ter ajudado o homem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: Devias tê-lo deixado entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: O que queres dizer com "pensei"?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: E trazer aquilo que o perseguia até à minha porta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: Não, obrigado. Já tenho problemas que cheguem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: Está bem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: Não és propriamente o melhor conversador
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: Não disseste grande coisa, na verdade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: Deixa-me adivinhar. Só te abres se tiveres cerveja?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: Não te aches um herói, miúdo. Aposto que também recusaste ajuda a várias pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: Caso contrário, não terias chegado até aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: Mas essa é uma história para amanhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: Está bem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: Não és propriamente o melhor conversador
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: Não disseste grande coisa, na verdade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: Deixa-me adivinhar. Só te abres se tiveres cerveja?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: Tinha a certeza de que nunca mais o voltaria a ver. Mas algum tempo depois... ele encontrou-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: Mas vou deixar isto para outra altura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: Está bem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: Não és propriamente o melhor conversador
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: Não disseste grande coisa, na verdade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: Deixa-me adivinhar. Só te abres se tiveres cerveja?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: Traz-me cerveja amanhã e eu acabo a história.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: Não fui feito para falar muito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: Portanto, dá-te por sortudo por até estar a falar contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: Traz-me cerveja amanhã e eu conto-te o resto. Combinado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: Tem paciência, miúdo. Vi merdas mesmo muito maradas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: Não é o tipo de coisa de que me goste de lembrar estando sóbrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: Traz-me a cerveja e eu falo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: És astuto. Gosto disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: Não falo a não ser que valha a pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: Portanto, traz-me cerveja amanhã e eu conto-te o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: Desculpa, mas não falo enquanto estiver sóbrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: Traz-me a cerveja e depois falamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: Mantém-te alerta. Qualquer um de nós pode ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: Então, como acaba a história?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: Eu conto-te. Mas, primeiro, venha de lá a cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: 'Sim (dá-lhe a cerveja) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: O quê? Não tens cerveja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: Hunter:…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: Não (não lhe dês a cerveja)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: Hunter:Assim, já falas a minha língua.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: Hunter:…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: Então, o gajo fugiu e eu fiquei na cabana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: Mas, depois, fiquei sem lenha. Tive de ir buscar mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: Apanhei alguma e voltei... mas a espingarda tinha desaparecido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: Aquilo abalou-me. Revirei a cabana toda à procura dela, mas tinha simplesmente desaparecido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: Então... vi-o. Através da janela. O mesmo gajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: Tinha a minha espingarda com ele... mas ele estava diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: Mais alto. Com peles caídas e não usava mais nada além de umas calças.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: Agarrou na arma e... partiu-a ao meio como se fosse um ramo de uma árvore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: Depois, ficou só ali especado. A olhar. Como se estivesse à espera que eu me distraísse para me poder partir o pescoço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: Mas não o fez. Continuou só ali à espera. Como se fosse uma versão perversa do jogo da Cara Séria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: Quando chegou a luz do dia, a aberração simplesmente desapareceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: Foi quando percebi que ficar sozinho sem estar armado era suicídio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: Portanto, corri até à cidade. Fugi antes que o sol atingisse as temperaturas máximas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: Foi assim que cheguei até aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: Reza para teres a oportunidade de premir o gatilho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: Quem sabe, talvez as balas funcionem contra ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: Por que razão é que ele não te matou?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: Achas que é possível matá-lo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: Ele dizimou um esquadrão inteiro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: Não sei. Ele partiu ao meio uma espingarda bem sólida como se não fosse nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: Podia ter-me feito o mesmo num piscar de olhos... mas não o fez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: Talvez goste de brincar connosco. Como os gatos fazem com os ratos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: Sabes, não tenho medo de muita coisa. Mas aquele otário pálido...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: Ele assusta-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: Quero acreditar que sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: Sabes o que se diz: tudo o que sangra, morre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: Se um esquadrão inteiro não o conseguiu deitar abaixo, não temos qualquer hipótese.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: Se ele quiser, pode arrasar com este sítio como se fosse feito de papel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: Sabes, não tenho medo de muita coisa. Mas aquele otário pálido...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: Ele assusta-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: Não há cerveja, não há história para ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: Não vou falar estando sóbrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: Por isso, se quiseres saber o resto... traz-me uma cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: Só um pouco de quentinho...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: Vais manter o casaco vestido?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: Sim. Há uma ideia que me está a incomodar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: O que acontece se o tirar? Não me consigo aquecer, até mesmo com calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: Se tirar o casaco, vou morrer de frio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: Ou pior: será que continuo a viver e a sentir ainda mais frio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: Não estás a suar com ele vestido?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: Então, não tomas banho?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: Não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: O corpo sua e tenta arrefecer a sua própria temperatura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: Acho que não consigo ter mais frio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: Vou ignorar isso. Desculpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: Só um pouco de quentinho...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: Tens alguma coisa em mente para o problema da tua temperatura?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: Acho que não consigo mudar isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: A água quente queima-me. Não ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: Sabes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: Pensei numa metáfora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: Imagina o espaço. Vasto e totalmente congelado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: Existem galáxias e estrelas a entrar em colapso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: E eu simplesmente observo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: Nunca vou sentir o calor do sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: Ou o calor de um abraço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: Acho que nem o espaço nem a sociedade precisam de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: Só um pouco de quentinho...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: Disseste ter algo para revelar quando nos conhecemos. O que era?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: Hmm. Não sei se quero falar sobre isso agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: Há algo em que tenho estado a pensar. Há muito tempo até. Pode ser a razão para eu me sentir com tanto... frio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: Nem sequer pensaria em falar nisto, mas toda esta ânsia está a dar cabo de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: Conto-te amanhã. Penso que amanhã vou conseguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: Só um pouco de quentinho...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: Então, o que estás a esconder?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: Sim. Quero partilhar um segredo contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: Acho que estou pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: Normalmente, isto não tem forma de acabar bem. Pode que agora seja diferente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: Por baixo das roupas está, acho eu, o motivo para me sentir com tanto frio e solidão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: Olha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: Não... Outra vez não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: O que foi que fizeste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: Estás feito
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: Foi sem querer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: Pensei que desta vez tudo fosse ser diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: Nunca é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: Não queria isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: Juro que não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: Dispara
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: Expulsa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: Já aconteceu antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: Por que raio achei eu que esta vez fosse ser diferente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: Não te precipites.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: Não fiz isto por maldade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: Não era a minha intenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: Dispara
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: Expulsa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: Talvez seja melhor assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: Acaba-se o frio. E acaba-se a solidão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: Eu só...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: Acho que não planeei nada disto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: Agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: Uma bala seria um ato de bondade. Mas ainda consigo sentir dor, infelizmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: O sol ia demorar mais tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: Posso ficar até ao anoitecer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: Sai imediatamente
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: Só não tentes fazer nada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: Entendido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: Desculpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: Talvez o sol me aqueça. Uma última vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: Obrigada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: Sei que me odeias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: Ainda assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: Lamento. Não era isto que queria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: Olha... hum... podes convidar a minha amiga para ficar cá?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: Quando os adultos a convidam, deixam-na ir... mas se for eu a fazê-lo, ralham sempre comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: Acho que este é o número de telefone dela: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: Oh, querido... Por favor, não deixes entrar qualquer pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: Por que razão é que a AGEF te expulsou em vez de te levar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: Vá-se lá saber, querido. Aquela gente metida dentro dos fatos... não dá para perceber.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: Sempre a andar por aí e a dar ordens...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: Quem é que eles acham que são?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: Aposto que não sabem ponta de um corno e só se estão a armar aos cágados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: Também te vieram bater à porta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: Um deles continua a aparecer por aqui
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: Malditos! Quem me dera arrancar-lhes os fatos e poder espetar-lhes uns estalos até irem parar às zonas de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: Para que vejam o que é estar entre pessoas de verdade, em carne e osso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: Também andam a assumir o controlo dos edifícios agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: Juro por Deus que são uns selvagens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: Uma vez ainda passa. Mas estão sempre a voltar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: Não têm vergonha nenhuma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: Oh, querido... Por favor, não deixes entrar qualquer pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: Levaram alguém da tua família?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: Preciso de te fazer um teste.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: Ohh. Há muito tempo que ninguém me pergunta pela minha família, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: Arranjei uma bela e grande família. Tive uma carrada de filhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: Tantos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: Mal cabem em casa agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: Por trás destas portas trancadas, há uma pobre alma que se esconde daqueles malditos esquisitoides.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: Não me respondeste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: Chegaram a levar alguém da tua família?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: Deixei-me levar, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: Sim, os malditos com os fatos levaram toda a gente da minha família. Não sobrou ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: Mas não vão escapar impunes, não, senhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: E da tua? Levaram alguém da tua família?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: Não tenho família
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: Deixei-me levar, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: Sim, os malditos com os fatos levaram toda a gente da minha família. Não sobrou ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: E da tua? Levaram alguém da tua família?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: Não tenho família
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: Não? Então como é que tens uma casa tão grande?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: Era uma casa partilhada ou algo do género?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: Uma casa grande é sinónimo de uma família grande, não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: Está bem, não vou insistir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: Só queria que a minha família voltasse daquelas zonas de quarentena...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: Não te tocaram, hein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: Então, onde está o pessoal da tua família?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: Uma casa grande como esta não foi erguida para uma única pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: Está bem, não me quero intrometer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: Só quero que a minha família saia daquela maldita zona de quarentena...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: Oh, querido... Por favor, não deixes entrar qualquer pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: Como planeias recuperar a tua família?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: Não os vou ajudar, querido. Eles saem sozinhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: Como assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: Saem sozinhos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: Vão escavar pela terra fora. Hão de sair a partir do chão, mas do lado de fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: Não vão ser umas estúpidas cercas e uns cabos que os vão impedir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: E se não conseguirem sair a partir do chão, vão dar cabo daquilo tudo. Não vão deixar ninguém para trás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: Estão a chegar. Consigo ouvi-los.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: De que raio é que estás a falar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: Estás bem da cabeça?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: Como assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (Mata-a)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: Quando a altura chegar, não há parede que resista.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: Haverá morte... muita morte. E ele chegará, faminto de morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: E depois aquela gente nos fatos vai deixar de querer saber dos meus. Vão ter problemas maiores em mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: Estão a chegar. Consigo ouvi-los.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: De que raio é que estás a falar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: Estás bem da cabeça?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: Como assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (Mata-a)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: Vamos arrasar todas as zonas que andaram para aí a construir...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: As paredes abrir-se-ão e as ruas ficarão pintadas de sangue, repletas de corpos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: Ouço-os a escavar. Estão quase a chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: O que queres dizer com isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: Quem és tu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: És um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (Mata-a)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: A carne queimada tem um cheiro tão bom...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: Os fatos cozinham-na bem. Um pouco crocante demais, talvez. Só um bocadinho a mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: Corpos não te faltam, querido. Há muito por onde escolher e para um belo banquete. Os meus vão adorar e vão comer bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: Ouço-os a escavar. Estão quase a chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: O que queres dizer com isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: Quem és tu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: És um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (Mata-a)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: Esta casa é um bom lugar. É especial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: Casa grande, quase ninguém a viver nela. Espaço para todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: Ouço-os a escavar. Estão quase a chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: O que queres dizer com isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: Quem és tu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: És um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (Mata-a)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: Seu merdas imprestável...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: Eles vêm buscar-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: Meninos, encontrámos um novo ninho. É finalmente hora de descansarmos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: Escavem até aqui, ele já não precisa mais desta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: A mamã quer ver os seus bebés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: Vamos lá, esta casa é boa para nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: Escavem, meninos. Estou aqui. Encontrei uma nova casa para nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: Tão grande... Tão bela... Tão espaçosa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (MATA-A)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: Não. Dá-nos esta casa. Ainda por cima a odeias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: Queres queimá-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: DÁ-NOS ESTA CASA!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: Porquê resistir? Eu sei bem o que queres...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: Morte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: Tens algo a dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: Por que olhas para as pessoas como animais?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: Deixa-me só fazer-te uma pergunta: o que somos nós, na verdade?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: Matamos, comemos o que matamos e não perdemos o sono por causa disso. É natureza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: Mas a sociedade controla-nos com uma trela. Felizmente, esses dias já vão longe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: Como assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: Estás feliz por as coisas terem mudado para a situação atual?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: É simples. As regras parvas da sociedade deixaram de existir. Agora, é tudo mais claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: Há matilhas e há líderes. Quem quer que seja uma ameaça à sobrevivência da matilha, morre. É um código que respeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: Mas o pior são os lobos disfarçados em pele de ovelha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: Achas que uma matilha é melhor do que a sociedade?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: Ovelhas em pele de lobo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: Estou só feliz por as pessoas terem deixado cair as máscaras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: Mas as tais ovelhas dão cabo de tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: Usam umas peles de lobo e fazem de conta. Fingem os instintos do homem real.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: Cobardes, a esburacarem a terra toda. Preferia partir para uma luta frente a frente do que este jogo do gato e do rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: Mas se construíste uma matilha, então já sabes como identificar os falsos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: Achas que uma matilha é melhor do que a sociedade?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: Ovelhas em pele de lobo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: Tens dúvidas disso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: Antigamente, na sociedade, nunca era preciso identificar as tais ovelhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: Havia muita conversa, demasiadas regras... Ficávamos emaranhados em intermináveis debates em vez de agirmos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: É por isso que um líder é fundamental. Nada de perguntas, nada de votações. A sua palavra é a lei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: Um líder TEM de mostrar força. Essa é a única forma de uma matilha sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: Sim, estou a falar daquela escumalha cobarde a que chamam de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: Escondem-se no subsolo como ratazanas, à espera de mostrarmos um sinal de fraqueza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: Agora, servem-se da moralidade humana. Brincam com o nosso sentido de misericórdia para serem mais difíceis de matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: É por isso que temos de mostrar as garras. Temos de lembrar-lhes que somos animais. Caso contrário, acabam connosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: Tens algo a dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: Por que estás a olhar para a minha arma?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: Vejo um líder em ti. Manténs toda a gente na linha. Mostraste quem é que manda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: Tens aqui uma bela moradia. Com gente sempre a chegar. Casa grande. Mas os teus hóspedes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: O que têm?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: Achas que alguns deles são Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: Deixaste entrar gente fraca. Mole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: Diz-me: para que servem os velhos, as crianças e os doentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: Uma matilha tem de ser composta pelos mais fortes. É assim que se sobrevive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: Então, o que queres que faça?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: Queres que os expulse?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: Isto não se trata de ovelhas em pele de lobo. São os lobos fracos que me preocupam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: A tua matilha não tem um núcleo solidificado. Há sempre gente a entrar e a sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: Escolhe os mais fortes. E fica com eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: Então, o que queres que faça?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: Queres que os expulse?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: Precisas de mandar embora os mais fracos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: Mata-os. Em público. Faz disso uma mensagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: É assim que demonstras controlo e liderança.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: E, aqueles que não se encolhem perante a morte dos mais fracos, são os teus verdadeiros lobos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: Esses são os que ficam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: Não sou um assassino
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: Só mato os Visitantes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: Deixa-os em paz e a tua autoridade esvai-se. Vão dizer que és mole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: A misericórdia é apenas uma fraqueza disfarçada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: Tens de ser implacável. Visitantes? Mata-os. Fracos, doentes, velhos? Mata-os também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: É assim que te passam a temer. É assim que lideras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: Não sou um assassino
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: Só mato os Visitantes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: A quem é que estás a tentar enganar? Vejo-o nos teus olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: Já mataste. Por isso, não faças de conta que tens as mãos limpas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: Costumava mandar nas ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: As pessoas temiam-me. Respeitavam-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: Já te perguntaste qual é o tempo que demoras a manchar a alma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: Eu demorei algum. Deixei a podridão alastrar-se, estás a perceber?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: Um dia, houve um táxi que se recusou a levar-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: Se tivesse deixado isso passar, o meu nome não teria tido qualquer valor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: Então, parti-lhe todos os ossos que tinha no corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: Mas o filho lembrou-se desta lição. E todos continuaram a respeitar-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: Farias melhor se deixasses de apaparicar os mais fracos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: Costumava mandar nas ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: As pessoas temiam-me. Respeitavam-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: Já te perguntaste qual é o tempo que demoras a manchar a alma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: Eu demorei algum. Deixei a podridão alastrar-se, estás a perceber?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: Um dia, houve um táxi que se recusou a levar-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: Se tivesse deixado isso passar, o meu nome não teria tido qualquer valor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: Então, parti-lhe todos os ossos que tinha no corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: Mas o filho dele deu-me uma lição. E as pessoas continuaram a respeitar-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: Tens algo a dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: Continuas a falar de matilhas. Por que não tens a tua?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: Por que arranjaste a tua?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: Porque não quero morrer às mãos daquele Visitante pálido.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: Estou a tentar ajudar pessoas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: Apenas gosto de ter pessoas à minha volta
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: Porque estas pessoas precisam de um líder
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: Perguntei primeiro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: Então, deste-lhes abrigo para poderes salvar a tua própria pele?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: Não soas a um líder de verdade. Soas mais um pequeno rafeiro amedrontado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: Esta matilha precisa de alguém forte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: Parece que vou ter de ficar com o teu lugar. Não és capaz de liderar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: Um objetivo nobre... ainda que algo estúpido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: Não vais salvar toda a gente. Mais cedo ou mais tarde, vais ter de virar as costas a alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: Mas soas-me a um líder de verdade. Não vou desafiar a tua autoridade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: Só isso? Tens só medo de estar sozinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: Não são palavras que um líder de verdade diria. Isso é conversa de cobarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: Aí está algo que um homem de verdade diria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: Portanto, não vou questionar a tua autoridade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: Não vou responder a isso. Quanto menos souberes, melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: Já te disse mais do que devia. Agora, é a tua vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: Se não és capaz de liderar, eu fico com o teu lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: Tens muita lata.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: O que faz com que sejas melhor do que eu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (Saca da tua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: Tudo bem. Força.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: CALA-TE, RAFEIRO. Já não vales nada para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: Se não sabes quais são os teus motivos para liderares, porque é que assumiste o cargo de líder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: Devias ir-te embora. Antes que te abata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: Eu sei o que é uma matilha. Eu vivo de acordo com as regras de uma matilha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: Se és assim tão mole, não és nenhum líder a sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: Devias ir-te embora. Antes que te abata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: Então, é assim que são as coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: Não sei se percebeste, mas tenho uma arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: Baixa a tua e vamos terminar isto de forma limpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (Dispara sobre ele)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (Baixa a arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: Morre, seu filho da...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: Cabrão... disparaste mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: Lindo menino'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: Mas devias ter acabado o que começaste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: (Ele arrisca e saca da sua arma)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: (Ele imobilizou-te. Não consegues sacar da tua arma)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: (Parece que é o fim)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: Então, já consegues abrir a boca?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: Tnj rfrjq-nj rjivfh!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: VYT PFIBKB HJN! Ghjcnj gjnjve xnj vtyz yt gjyvf.n.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: Não te consigo compreender
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: Tu percebes o que estou a dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: Qf ntz yt gjybvfl. Xnj vjpyj cltkfnm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: Rfrjq-nj jlobq zpsr ghblevfnm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: Como é suposto comunicarmos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: Qf vjue gjdnjhznm ndjb ckjdf, ns vjptim htfubhjdfnm yf ybp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: Yfdthyj, nfr qf ijnz gs gjqve xnj qf ujdjhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: Como?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: Como o quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: Estás a tentar perguntar alguma coisa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: Yt gjybvfe dct hfdyj. Yj ns xnj-nj cghjcbk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: Vjptn, tnj djghjcbntkmyjt ckjdj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: Yj ns xnj-nj cghjcbk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: Vjptn, tnj djghjcbntkmyjt ckjdj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: Ei, como estás?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (Tocas-lhe no ombro e apontas para as feridas junto à sua boca)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: Estás bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: Dói?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: Qf gjghjge gjdnjhbnm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: Bhhh-oomt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: Bhhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: Bhooomt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: Ckjpyjdfnj, rjytxyj, yj vjptn tnj vyt gjvjptn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: Bynthtcyj, e vtyz ljvf ghjbcjlbn nj pt cfvjt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: Rfrjq epfc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: Como vais voltar a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (Juntas as mãos sobre a tua cabeça, a imitar a forma de um telhado)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: Ljv? Ns cghfibdftim ghj ljv?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: Qf ghbtpfk r lheue d ujcnb, f nen nfrjt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: Byfxt rfr gbpltw cbnefwb. yt jgbcfnm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: Como é que te mando de volta a casa? De avião?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: Viste os bilhetes de barco?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (Oscilas a tua mão num movimento para a frente)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: Cfvjktn? Levftnt, jyb tot ktnfen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: Yflj ls epyfnm ult-ybgenm byae.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: Dlheu htfkmyj tot vjpyj ektntnm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (Moves a tua mão a imitar um barco nas ondas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: Nbgj, yf rjhfgkt gjgksnm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: Hfpdt jyb tot gkfdfen? Yflj geltn gjbcrfnm byae, cgfcbgj!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: Por que estás tão empolgado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (Sorris e apontas o dedo para o sorriso e, depois, para ele)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: F ns ghj tnj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: Vyt cvjukb jgmzcybnm, xnj gjtplf tot pjlzn! Ghtlcnfdkztnt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (Ele move uma mão ao longo do seu outro braço)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: Há alguém que te possa levar a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: Qf yt gjybvfe, lheu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: Pfdnhf qf jnghfdkecm ljvjq! Gj rhfqytq vtht cpjie yf djrpfk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: Ctujlyz yjxme qf ecjie. Gjrf!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: Aahdeush!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: Estás a falar do comboio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: Vais a algum lado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: Ybxtuj yt gjyzk, bpdbyb.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: Yj pfdnhf z gele yf djrpfkt b dct epyfe cfv!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: Vjitn, qf jrfiecm ljvf, cgecnz cnjkmrj dhtvytb…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: Bhhooatsortkke!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: Que silêncio tão tranquilo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: Como está a tua mão?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: Já não sinto nada nela há algum tempo, embora a dor e os arrepios continuem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: Mas é expectável. Quero adiar o momento mais requintado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: Havia uma rapariga que adorava.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: Amei o tempo que passámos juntos. Sentávamo-nos em silêncio e percebia-a sem palavras. Foi quando compreendi tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: Estava a enganar-me. Nunca a conheci de verdade. Talvez quisesse apenas acreditar nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: E, ainda assim, espero um dia vir a compreendê-la. Mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: Que silêncio tão tranquilo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: Fala-me sobre a tal rapariga
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: Nos olhos dela, vi sempre o frio brilho da lua.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: Ela era a antítese do cataclismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: Ao lado dela, eu era perseguido por uma inabalável sensação de mistério.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: E anseio por descobrir os seus segredos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: Agora, ela é o meu monumento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: O farol que me guiará quando eu partir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: Que silêncio tão tranquilo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: Como a conheceste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: Houve um momento em que soube que ela me esperava. A sépsis levar-me-ia em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: O pensamento aterrorizou-me. Percebi que ia desaparecer. Não algures mais tarde, mas dentro de alguns meros meses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: E, depois, quando os Visitantes começaram a escavar até à superfície... encontrei-a numa das casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: Uma rapariga coberta de linho branco, com uma face de assombrosa beleza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: Neste mundo cruel, onde cada um se preocupa só consigo, ninguém quis saber de algo tão adorável. Mas eu quis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: Conheces o ditado "Não há bela sem senão"?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: No meio de tudo, peguei no seu corpo frágil e levei-a para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: Quando o fim chegar, direi que tudo o que fiz, fi-lo por amor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: Que silêncio tão tranquilo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: Onde está a tal rapariga agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: Passei tanto tempo a contemplar a sua beleza... O poder do seu silêncio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: Mas depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: Homens sem rosto e vestidos de amarelo entraram pelo quarto dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: Apanharam-na e levaram-na. Suponho que ambos saibamos porquê.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: É pena... nunca cheguei a compreendê-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: Portanto, cá estou eu sozinho outra vez...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: Há quem diga que consegue salvar o mundo, mas ninguém chega a um consenso sobre como o fazer. A resposta é simples.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: E essa resposta reside no silêncio. Na beleza. Se alguém a pudesse... compreender.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: Ela tentou ensinar-me, mas tudo o que aprendi foi a conhecer a tranquilidade... a graciosidade no meio do assombro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: Pelo menos agora... estou pronto para a seguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: Que mundo este em que vivemos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: O que foi agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: Parece que ainda temos de concluir o contrato de arrendamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: E como hei de fazer isso, já agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: É isso que te está a preocupar neste momento?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: Não me diga que nem sequer tem a papelada à mão?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: Então... sugiro que vá procurar um notário e que obtenha a papelada toda. A sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: Estás a gozar comigo? Onde é suposto encontrar agora um notário?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: Porque é que não vais tu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: Com o devido respeito, agradeço que me trate como deve ser. "Senhor" serve perfeitamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: Francamente, que maneiras...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: Enfim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: Não queres ir para o caralho de uma vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: Sabe como usar um mapa, não sabe? Não é assim tão complicado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: E, mais uma vez, insisto que me trate com respeito. Por "senhor", ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: Enfim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: Não queres ir para o caralho de uma vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: E por que motivo, exatamente, é que deveria ser eu a fazer os seus recados? E, já agora, use "senhor" ao falar comigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: Sou um cidadão de respeito, não sou nenhum moço de recados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: Enfim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: Não queres ir para o caralho de uma vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: Está a fazer isto de propósito, não está? Podia, pelo menos, fazer de conta que quer ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: Atenção a esse tom. O Art. 21.º da Constituição protege a minha dignidade humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: Portanto, sugiro que comece a mostrar-me algum respeito, antes que isto se torne... desagradável.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: Que mundo este em que vivemos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: Podes parar de uma vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: Ainda estou à espera da conclusão do contrato de arrendamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: Não tenho nada com que o concluir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: Deves estar a gozar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: Hmmm. Lamentável.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: Receio que isto constitua uma infração ao Art. 131.º.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: Estás a irritar-me profundamente
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: Não te cansas de citar leis o tempo todo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: Para sua informação, ao abrigo do Art. 131.º, o contrato é obrigatório. Sou um cidadão de respeito e cumpridor da lei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: Estás a irritar-me profundamente
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: Não te cansas de citar leis o tempo todo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: Ah, aí estão eles... os insultos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: A propósito, esta situação é abrangida pelo Código Administrativo 5.61.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: Por favor, continue. Isto só cai mal para o seu lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: E não, não me canso de mencionar a lei e a Constituição.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: Conheço os meus direitos! Só porque é ignorante, não significa que as outras pessoas não se sirvam dos seus direitos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: E, uma vez mais: já lhe disse para me tratar com respeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: Tss tss, não há maneira de aprender, pois não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: Que mundo este em que vivemos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: O que foi agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: Acontece que reparei na existência de uma arma de fogo. Posso ver a sua licença de porte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: Não é da tua conta.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: Qual é o teu problema comigo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: Ah, estou a ver. A ausência de uma licença, significa que essa licença não existe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: Acha que ter uma arma faz de si a lei em pessoa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: Que pode interrogar toda a gente e nunca ser questionado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: Está totalmente enganado!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: Sabe o que se costuma dizer: há sempre um peixe maior por aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: Chega! Já tenho muita coisa com que lidar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: Podes parar com as tuas tretas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: Só estou a tentar perceber a pessoa que é realmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: Pois, na defensiva... Parece que meti o dedo na ferida. Não tem licença.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: Acha que as normas não se aplicam a si.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: Acha que pode inspecionar tudo aquilo que considera ser uma ameaça, mas ninguém o pode escrutinar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: Está bem enganado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: Sabe o que se costuma dizer: há sempre um peixe maior por aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: Chega! Já tenho muita coisa com que lidar.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: Podes parar com as tuas tretas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: Ah, é difícil para si, é? Claro. Pobrezinho. Ninguém ousa perguntar ou verificar se é um Visitante. Que chato...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: E quem é que lhe deu o direito de decidir quem vive ou morre? Quem lhe deu tamanha autoridade?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: Os que restam cingem-se a rezar para não serem os próximos a levar um tiro. E vem-me pedir empatia? Poupe-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: Desculpe lá a linguagem. Como se não fosse a pessoa cheia de tretas com os seus testes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: A inspecionar aqui e ali, a tratar cada pessoa como se fosse uma possível assassina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: Mas claro, nada de apontar o dedo ao verdadeiro assassino. Porque talvez, só talvez, não existam quaisquer Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: Sabe o que isso faz de si? Um maníaco, a abusar da sua posição, a explorar o caos para satisfazer a sua sede de sangue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: E as pessoas? Ouvem o pânico na rádio e apressam-se a bater à sua porta, como moscas à volta da merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: Diga-me, quantos foram aqueles que apareceram ao início e que ainda estão vivos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: Foi o que pensei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: Que mundo este em que vivemos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: Senhor? Ainda aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: Extraordinário... tratou-me com respeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: É pena é ser tarde demais. Vou comunicar tudo o que vi em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: Comunicar o quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: A quem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: Não me engana mais. Sei exatamente quem é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: Esta não é a sua casa, matou o proprietário e está a fazer-se passar por ele. E vou contar tudo à AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: Isso mesmo, eles vêm à sua procura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: Tretas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: Está na altura de calares a boca de vez
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: A Agência de Gestão de Emergências Federal. AGEF de forma abreviada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: Ao início, não prestei muita atenção ao facto de nem sequer conseguir concluir um simples contrato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: Mas quanto mais falava consigo, mais claro tudo se tornava.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: Agora, tudo bate certo. Esta não é a sua casa. É um impostor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: É um VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: Portanto, faça as malas. Hoje à noite, eles vêm até aqui para o levar daqui para fora!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: Tretas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: Está na altura de calares a boca de vez
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: Oh, vou comunicar isto. Eles não tardam em vir até aqui. Espere só.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: Enfim. Sai daqui
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: Estás morto (saca da arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: Achas que me podes calar? Boa sorte com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: Espere, o quê?! Perdeu a cabeça?! Isto é crime!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: Não, não, não. Não se vai safar desta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: Não vou sair daqui até que a AGEF chegue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: Vou contar-lhes tudo o que tens feito e vão saber o perigo que representa para todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: Espere, o quê?! Perdeu a cabeça?! Isto é crime!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: Não se atreveria!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: É melhor saíres daqui antes que te dê um tiro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: Se não saíres, disparo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: Não me deixas outra escolha
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (Dispara sobre ele)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: Não vou permitir que fuja à AGEF! Só por cima do meu cadáver!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: No fim de contas, vão apanhá-lo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: Nem o senhor a mim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: É UM VISITANTE! UM ASSASSINO! NÃO É HUMANO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: NÃO! É CONTRA A LEI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: AAAAARGH!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: Pá... saquear alguma coisa de jeito é que era bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: Como vai a tua carreira de saqueador?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: Ouve, ok, pensei que este sítio estava às moscas. Portanto, pensei em esgueirar-me por aqui... mas há gente cá a viver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: Não roubo aos vivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: Tipo, pensa um pouco, para que serve um casaco num morto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: Se morreu, as coisas só vão apodrecer. E eu cá ainda respiro. São coisas que me podem salvar ou a alguém próximo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: Diz-me: não serias capaz de tirar algo de um cadáver só para salvares alguém de que gostas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: Talvez seja altura de deixarmos de tratar os mortos como um altar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: Pá... saquear alguma coisa de jeito é que era bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: Por que decidiste tornar-te num saqueador?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: O que era suposto fazer? Não queria magoar pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: Portanto, optei pelo caminho mais tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: Os mortos não dão luta e as coisas deles são apenas... sobras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: Não estou aqui para magoar ninguém. Só me quero manter vivo. Talvez ajudar outras pessoas ao longo do caminho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: Pá... saquear alguma coisa de jeito é que era bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: O que foi que encontraste ao saquear?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: Pá, vi demasiadas coisas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: Deixa cá ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: Uma vez, encontrei uma biblioteca abandonada. Livros com pó ainda nas prateleiras, como se alguém ainda os fosse buscar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: Entrei numa exposição de arte amadora, com quadros ainda lá pendurados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: E, depois, vi um pôr do sol. Mas não um qualquer... parecia pintado no céu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: Hoje em dia, ninguém arrisca ficar parado a olhar para o céu. Mas naquela altura...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: Gostava dos tempos passados. Levantava-me bem cedo. As ruas estavam em silêncio, com nevoeiro baixo e relva molhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: E o sol... bem, brilhava tanto ao nascer... como se estivesse a prometer um dia decente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: E, agora, olha só para nós. O sol é o verdadeiro inimigo. Como é que isto foi acontecer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: Quem me dera que alguém tivesse respostas para tudo isto. Poderia fazer com que fosse mais fácil respirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: Pá... saquear alguma coisa de jeito é que era bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: Já deixaste de saquear?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: Ainda estou no ativo. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: Uma vez... sim, houve uma vez em que fiquei perturbado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: Encontrei uma casa. Vazia. Um corpo no chão, ou seja, algo normal. Nada de ameaçador.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: O gajo estava cheio de buracos nas costas. Deitado sobre algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: Pensei que talvez se estivesse a tentar esconder de alguma coisa. Aproximei-me, virei-o ao contrário e...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: Olha, depois conto-te, está bem? Não estou totalmente preparado para reviver este episódio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: Pá... saquear alguma coisa de jeito é que era bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: O que havia por baixo do tal corpo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: Pronto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: Virei-o ao contrário... e ali estava ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: Uma menina pequenina. Morta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: Com adultos, já é de esperar. Mas uma criança? É algo que nos abala de forma diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: Vejo crianças mortas e parece que há um nó que se forma na minha garganta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: Ela estava a agarrar um pequeno gato de peluche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: Coberto de sangue. Na totalidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: O rosto da menina estava preso num olhar... como se ela soubesse que a morte estava a chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: Por um segundo, juro que ela parecia ter medo que eu fosse levar o seu brinquedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: Como se, até depois da morte, a crueldade das pessoas não a deixasse estar em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: Aquilo afetou-me muito mais do que gosto de admitir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: Naquele dia, quis parar, quis deixar os mortos em paz. Mas é demasiado tarde para isso agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: Tudo o que posso fazer é continuar em frente. Continuar a saquear. É a única forma que tenho de sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: Diz-se que não podemos fugir do destino. Suponho que seja verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: Quem me dera que os Visitantes voltassem só ao subsolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: Por que te tornaste num coveiro?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: Preciso de te fazer um teste.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: Huh? Oh, isso? Sei lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: O cemitério é como... uma biblioteca, sabes? Mas os "livros" do cemitério não são para ler. Ficam só ali. Em silêncio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: Eu conhecia todas as sepulturas. Onde é que estava cada pessoa, a forma como estavam as mãos, o que vestiam, os nomes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: Então, um dia estou a escavar um novo buraco, não é? Tudo normal. Parece ser suficientemente fundo e... BAM! Vazio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: Vazio, juro! Só que o jornal dizia que havia alguém lá em baixo. Um corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: Um gajo, com certeza morto. Tinha um bigode. Lembro-me bem. Mas puff... desapareceu. Como o orvalho matinal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: Portanto... se um morto desaparece... é como morrer outra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: Quem me dera que os Visitantes voltassem só ao subsolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: O que foi que fizeste quando encontraste a sepultura vazia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: Sentei-me na beira. Olhei para lá, e nada. Mas depois olhei para cima e, ao longe, vi alguém. A olhar. Como num funeral.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: Sem olhos. Mas dentes muito brancos. A brilhar. A sorrir. Só ali a olhar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: Quase que me borrei todo, para falar a verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: Corri. Rápido. Essa é a parte em que sou bom. Mas ele não me perseguiu. Simplesmente... desapareceu. Como fumo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: Que merda mais marada... Foi quando toda esta confusão dos Visitantes começou...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: Quem me dera que os Visitantes voltassem só ao subsolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: Qual é o objetivo de escavar quando ninguém enterra os mortos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: Deixei de escavar. Só... mantenho-me atento. Mas antigamente, depois daquela confusão, fui vasculhar umas sepulturas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: Fui muito cuidadoso. Sem coisas tresloucadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: Pensei que alguma aberração pudesse ter sido enterrada por engano. A minha pá era a minha espada: pronta a atacar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: Mas não... Ossos todos onde deviam estar. Cadáveres quietinhos. Nada a sair das sepulturas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: Pensei: talvez não sejam os enterrados a sair. Talvez os Visitantes sejam malta que devia ter sido enterrada e não foi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: Quem me dera que os Visitantes voltassem só ao subsolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: Não tens andado a escavar novas sepulturas, pois não?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: Preciso de te fazer um teste.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: Eu?! Nem pensar! Não sou estúpido. Ouve, tenho estado junto dos mortos toda a minha vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: Ou costumava estar! A morte não me incomoda. Morres, enterram-te e acabou. Agora? Quem é que resta para te enterrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: E mesmo que alguém o faça. Como sabes que lá vais ficar? Eu vi uma sepultura que SEI que tapei... e estava vazia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: Fui eu próprio que o enterrei!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: Agora fico a pensar que talvez a minha sepultura vá ficar também vazia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: Se calhar... se calhar já sou um Visitante...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: Eh... esquece, pá. Estou só a falar coisas sem sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: Quem me dera que os Visitantes voltassem só ao subsolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: De onde achas que vêm estes Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: Já alguma vez reparaste que... têm um aspeto familiar como a merda? Como se não fosse só uma cara... mas uma memória.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: Tenho uma teoria. Queres ouvi-la? Está bem, cá vai...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: Talvez os Visitantes... não sejam os mortos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: Talvez sejam pensamentos. Aqueles que não enterraste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: Medos, remorsos, gente que esqueceste, sentimentos dos quais não te soltas. Acumulados. E quando tudo está calmo, saem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: Não vêm à procura de carne... mas sim de atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: E quanto mais medo tivermos, mais se aproximam. Porque nos lembramos deles. E tudo o que é lembrado, quer ter vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: Pergunto-me, será que os Visitantes sonham?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: Conseguiste dormir?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: Hm? Nah. Nem sequer tentei ir dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: Só espero que ainda haja aqui alguém que sonhe. Só isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: Mas... ainda ninguém partilhou qualquer sonho comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: Talvez eu não tenha um aspeto que transmita confiança.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: Talvez se abram comigo mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: Pergunto-me, será que os Visitantes sonham?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: Porquê toda essa obsessão com sonhos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: Quem disse que é obsessão?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: Que conclusão mais estranha...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: Não tens um mínimo de curiosidade sobre o que o teu subconsciente te está a tentar dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: Sobre o que escondes nessa tua cabeça? Todos escondemos algo de nós próprios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: Tu, por exemplo, a evitar pessoas porque algo te afetou...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: É o que faz com que seja interessante para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: Sabes que mais? Eu conto-te o último sonho que tive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: Havia um grande comboio negro a vir na minha direção.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: As minhas pernas estavam presas ao chão. Gritei e acordei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: Estava preso aos carris. E estava também a conduzir o comboio. A avançar exatamente na minha direção, incapaz de parar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: Pergunto-me, será que os Visitantes sonham?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: E tu? O que escondes nos teus sonhos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: E eu o quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: Não durmo há dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: Mas tudo bem, vou contar-te uma coisa. Seja como for, ninguém vai acreditar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: Eu consigo VER os sonhos de outras pessoas. É... fascinante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: Não faço ideia como isto funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: Mas desde que tudo isto começou, os sonhos... pararam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: Como se toda a gente estivesse a suster a respiração.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: E, ainda por cima, deixei de conseguir dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: Pronto, vá lá, tenta perceber se estou a dizer a verdade ou se estou só a confundir-te a cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: Quem são vocês?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: Almas perdidas. Como todas as outras pessoas nesta maldita terra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: Ansiamos por paz e tranquilidade. E sabemos como as podemos alcançar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: Morte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: Por que é tão temida? É o desconhecido que tememos? Ou é a punição que as religiões nos forçaram a acreditar que existe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: Durante milénios, procurámos o significado da vida. E a resposta era tão, mas tão simples...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: A Morte é o nosso propósito. E nós somos os seus seguidores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: Por que adoram a morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: Porque a Morte é a encarnação da misericórdia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: Todos a tememos, mas será que os nossos medos são justificados?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: Pensa um pouco. O nosso mundo é apenas um purgatório que nos atormenta. Mas porquê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: Tanto medo, tanta dor e tanto sofrimento. Será que não merecemos paz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: A Morte é um paraíso incompreendido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: As religiões tentam simplificar a imagem do Paraíso, por ser mais fácil para as pessoas. Mas a vida nunca foi simples.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: O mesmo se aplica à Morte. Não a compreendes até tocares nela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: Por que razão escolheram a minha casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: Mais do que qualquer outra, a tua casa está ligada à Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: Ao início, não percebi por que motivo o nosso mentor escolheu este sítio. Mas, agora, é evidente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: Estas paredes carregam vestígios da Morte. São invisíveis, mas palpáveis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: O cimento nu tresanda a sangue derramado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: Não te pedimos que mates de forma deliberada, como podes pensar. Já ceifas vidas sem que seja necessário pedirmos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: Penso que a tua ligação à Morte é mais forte do que qualquer ligação que nós tenhamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: O que são aquelas fogueiras que estão a fazer lá fora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: Chegou o momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: Os anjos do subsolo surgirão para receber a oferta das nossas cinzas e nos conceder passagem para o domínio da Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: É assim que ganhamos o apreço da Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: Pareces assustado. Tens medo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: És um bom observador, proprietário.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: Ao contrário dos meus fiéis irmãos, eu debato-me com o medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: A dúvida atormenta-me. O que há para além da vida? Qual é a sensação?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: O nosso mentor ensina-nos que o Paraíso e o Inferno não existem. Que é algo mais. Mas não me convenço...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: Se nem ele compreende totalmente a Morte, será que vamos nós algum dia conseguir compreendê-la?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: E se o toque na Morte não for suficiente? E se for algo que está muito para além da nossa compreensão?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: Mas não me atrevo a questionar a vontade do nosso mentor. Aos seus olhos, eu vejo a certeza e o conhecimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: Ele pede-nos que abracemos a fé e a determinação... que estejamos preparados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: Só assim poderemos atravessar os oceanos dos mortos e as montanhas feitas de ossos. E alcançá-la...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: A Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: Por que adoram a morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: Por favor, caro proprietário, fala da Morte com respeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: Ela despreza os blasfemos que a apelidam de injusta e castiga-os da forma mais severa possível.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: A sua natureza aterroriza-me, mas o nosso mentor diz que a Morte pode ser a mais gentil de todos os deuses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: Não traz fome, peste, nem guerra. Apenas... descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: E precisamos de a encontrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: Por que anseiam tanto encontrar a morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: Esta viagem não é uma escolha nossa. É a vontade da própria Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: Ela chama-nos. Quer-nos no seu domínio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: O nosso mentor diz que é por isso que agora o sol queima de forma tão forte... está a tentar eliminar-nos da superfície.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: A Morte oferece-nos silêncio, paz e união. As suas terras são onde nos reunimos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: Choramos os mortos em vão, esquecendo-nos que os voltaremos a encontrar um dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: O que planeiam fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: Chegou o momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: Tenho medo... O meu corpo não para de tremer... Mas tenho de abraçar a fé e a determinação.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: O nosso mentor acredita em mim. Não posso desiludir ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: Mas o medo... o medo invade toda a minha mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: Solta-nos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: Solta-nos. Solta-nos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: Por quanto tempo vão cá ficar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: Não te preocupes, proprietário. Não te vamos causar problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: Agradecemos a tua hospitalidade e não te queremos irritar. Já fizeste muito por nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: Ficaremos neste quarto e faremos as nossas orações de forma silenciosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: Precisamos de algum descanso. A nossa viagem será longa e árdua.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: Para onde se dirigem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: Para a terra dos forasteiros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: A vida humana não é eterna. Somos apenas visitantes nesta terra. Para ela viemos e dela sairemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: Os forasteiros têm de assumir o controlo da terra e nela ficar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: A chegada deles não é um acaso. Vieram para aqui devido ao mesmo chamamento que nos leva daqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: A Morte invocou-os...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: O que te leva a pensar que a Morte invocou os Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: Porque a Morte não faz distinção entre humanos, animais, forasteiros, etc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: A Morte é para todos e todos são iguais aos seus olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: Esperou pelo momento certo e, agora, esse momento está quase a chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: E temos de nos preparar para o ritual...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: Que tipo de ritual estão a planear fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: Chegou o momento de mudarmos de casa: é hora de fazermos a nossa travessia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: Temos de ir ter com a Morte, para o reino da paz e tranquilidade eternas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: É altura de seguirmos em frente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: Sim, querido? Tens algo em mente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: O que te parece este sítio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: É acolhedor. Mais do que estava à espera... tendo em conta o estado atual das coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: Obrigada por me deixares entrar... embora ainda venha a acabar na rua antes do nascer do sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: E tu? Como te sentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: Ansioso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: Nunca pior. Temos de sobreviver
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: Entendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: Nestes dias... fazer planos para mais do que os próximos quatro meses parece inútil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: Nunca se sabe o que nos vai apanhar primeiro: se vai ser o sol, algum lunático ou os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: Mas a humanidade, sem falar da Terra, já sobreviveu antes a catástrofes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: Acho que vamos deixar algo para trás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: Alguém encontrará vestígios nossos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: Gosto dessa atitude. Fica-te bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: Mas vê se não exageras. As emoções têm o mau hábito de se descontrolarem com facilidade...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: ...precisamente nos piores momentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: Não tenhas vergonha de falar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: Se não for comigo, então que seja com outra pessoa. Qualquer pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: Promete-me só isso, está bem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: Sim, querido? Tens algo em mente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: Vi algo estranho na noite passada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: Hmmm? Do que estás a falar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: A tua barriga. Cresceu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: Apenas pensei ter visto uma coisa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: Como assim? Como se estivesse grávida?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: Está tudo bem. Estou contente que tenhas deitado os teus sentimentos cá para fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: Acho que te sentes assim, porque neste momento tens medo de ser responsável pelas outras pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: Entendo. Sempre que o sol nasce, pode ser a tua última vez... se já é difícil cuidares de ti, pior é com outras pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: Nem sequer sabes se vais viver para ver um novo dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: Sim... Isso assusta-me.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: Não, não acho que seja isso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: Mas há algo que te está a perturbar, não há?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: Está tudo bem. O medo afeta toda a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: Eu vi-te. A levantares-te à noite. A fazeres rondas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: Isso não é uma coisa qualquer. Para alguém que se protege tanto, preocupas-te muito com as pessoas que deixas entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: É... interessante. És uma contradição ambulante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: Ou talvez seja apenas as insónias. O medo é um terrível companheiro de cama.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: Sim... tenho medo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: Não, não acho que seja isso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: É preciso fibra para o admitir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: Mas o que podemos verdadeiramente fazer com o medo, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: Aceitas a ideia de que... isto vai acabar? Que vamos todos morrer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: O que importa é: onde encontras a tua salvação? Será que isso ainda existe sequer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: Muito bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: Seja como for... preocupo-me contigo. Não ignores os teus pensamentos, ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: Quero que te sintas em segurança. Afinal, vivemos ambos debaixo do mesmo teto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: "FatalDame: Mas se perderes um parafuso, vamos todos abaixo...\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: ...Perdoa-me o trocadilho *riso*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: Gostaste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: Sim, querido? Tens algo em mente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: Eu sei que te vi grávida na noite passada. Explica-te
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: Estás a começar de me assustar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: Tens MESMO a certeza de que viste algo na noite passada?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: Por que não me acordaste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: Isso é o medo a falar outra vez? A morte... ou o peso que carregas por gostares de alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: É por minha causa? Ou há mais alguém a assombrar-te os pensamentos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: Não me confundas as putas das ideias
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: Eu... eu sei que vi algo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: No outro dia, falaste do teu pai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: Nunca mais falámos sobre ele. Não sei grande coisa, na verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: Mas agora... sinto que és como ele. És uma cópia de uma ponta à outra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: Isso assusta-te?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: Que não te consigas soltar da sombra dele?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: Ele para ti morreu. Por isso, porquê continuar a desenterrar fantasmas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: Não o vais ver quando passares para o outro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: Acho que não vais para o mesmo sítio que ele. Não te preocupes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: Deixa de perseguir todas as respostas ao mesmo tempo. As estradas foram construídas uma pedra de cada vez. Percebes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: E, por favor... não voltes a falar assim comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: É doloroso ver o que te está a acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: Mas não devias temer a morte. Nem a responsabilidade. Nem a proximidade. Nem qualquer outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: Faz tudo parte da vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: Deixa de perseguir todas as respostas ao mesmo tempo. As estradas foram construídas uma pedra de cada vez. Percebes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: E talvez ajude pensares que... não vamos desaparecer totalmente quando tudo acabar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: Costumava acreditar no Paraíso e no Inferno. Agora? Não tenho tanta certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: Talvez seja algo completamente diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: O que achas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: Sim, querido? Tens algo em mente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: Estás grávida. Vou encontrar alguém em breve, tenho a certeza.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: Oh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: O desespero tomou conta de ti, não foi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: Todas as tuas crenças estão a desmoronar-se... e és incapaz de aceitar isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: É porque te recusas a ir para onde quer que estejamos a ir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: Ou é porque... já não pertences a este mundo? Ou a qualquer mundo, seja ele qual for?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: Não é disso que estou a falar. Tu estás grávida
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: Não tens medo também?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: Querido... Eu não poderia engravidar assim tão rápido. Nem sequer tenho uma barriguinha de bebé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: Posso perguntar-te uma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: Se esta criança for real...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: E se, como dizes, vai chegar em breve...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: O que vais fazer? Vais tentar encontrá-la?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: Ela não deveria existir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: Ainda não decidi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: Hm. Boa pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: Claro que morrer é aterrador.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: Principalmente porque não sei dizer o que virá a seguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: Se é o Paraíso, se é a reencarnação, ou se é algo completamente diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: Nunca houve alguém que regressasse dos mortos para contar a história.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: Mas relativamente ao que tu viste...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: Se esta criança for real...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: E se, como dizes, vai chegar em breve...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: O que vais fazer? Vais tentar encontrá-la?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: Ela não deveria existir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: Ainda não decidi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: Por vezes, o instinto quer preservar o que nos é familiar... mesmo que já não tenha utilidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: Talvez...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: Talvez seja altura de abrires os olhos a algo novo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: Ou o desconhecido assusta-te assim tanto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: Eu vou encontrar essa criança
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: Ela está a chegar. Eu sei que sim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: Não devias ter medo de te soltares das coisas. Principalmente quando deixam de ter utilidade para ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: Por vezes, agarramo-nos a algo só porque nos é familiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: E sim, quebrar hábitos é doloroso... mas quem sabe o que pode vir dessa quebra de hábitos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: Eu vou encontrar essa criança
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: Ela está a chegar. Eu sei que sim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: Se tu o dizes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: Diz-me o que encontraste... quando chegar a altura.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: Cresci na cidade, querido. Tinha o meu próprio pequeno apartamento e tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: Sem casa de campo, sem familiares, sem netos... oh, meu querido...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: Então, sentava-me no banco junto à entrada na maioria dos dias. Sentia lá alguma vida e ouvia-se de tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: Mas quando os problemas surgiram, até isso deixou de ser uma alegria para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: Como podemos sentir a força da vida, quando a morte está em toda a parte? Só gente a cair que nem tordos...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: Não é preciso muito para encontrar sempre alguém a mentir por lá, envolto em tecido branco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: Chiça, é o suficiente para te fazer pensar em desistir de tudo, em vez de teres de assistir a tamanha tristeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: Portanto, parti em busca de um lugar onde ainda existam pessoas, com histórias para ouvir e vida para sentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: E olha só... o destino trouxe-me diretamente à tua porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: Não sou nenhuma beata de igreja, mas nestes tempos... bem, parece que foi Nosso Senhor que guiou os meus passos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: Toda a gente me esqueceu, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: Se ainda houver alguém vivo, ninguém virá à minha procura.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: E, verdade seja dita, não sou a única. Há muita gente que se esquece dos seus familiares...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: Só pensam neles próprios. Não há vivalma que telefone a perguntar como estou.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: Uma vez, a minha vizinha, enquanto estávamos sentadas naquele banco, fartou-se de gabar o neto dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: Disse: "O meu netinho é um bom menino! Lembra-se dos seus familiares mais idosos e visita-me. Não é como os outros."'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: E era, de facto, um bom menino. Cumprimentava-me sempre e perguntava-me como estava.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: Até senti uma ponta de inveja...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: E, depois, a morte veio buscá-la...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: E o rapaz... bem, tornou-se frio e rude.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: Acontece que a bondade dele era apenas porque queria o apartamento...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: Por que achas que as pessoas mentem na cara umas das outras, principalmente à família?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: Casam, têm filhos, e depois... não te amam. De todo! Dá para acreditar?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: Bem, sorte a minha que já não tenho marido. Aquele velho pateta perverso... Ugh.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: Oh, mas já morreu também, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: Arruinou a minha vida, aquele mono.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: Só me casei com ele porque os meus pais me obrigaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: "Casa-te com ele, filha", disseram eles. E foi o que fiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: Ao início, ele gostava mesmo de mim. Mas logo que acabou o alvoroço do casamento, a podridão da sua natureza revelou-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: Primeiro, os meus cozinhados nunca estavam bem. Depois era: "Não me chateies, não vês que estou a comer?"'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: E, anos mais tarde, desaparecia durante horas para andar a beber com os amigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: Voltava para casa bêbado a falar tretas sobre jogar dominó na garagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: E, se lhe perguntasse se ele tinha estado a beber, era insultada a torto e a direito por aquele miserável pateta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: Depois, a morte veio buscá-lo também.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: Ao início, senti-me mais leve. Mas, pouco depois, o vazio começou a apoderar-se de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: A TV ajudou durante uns tempos, mas agora é só baboseiras. É só mentiras. Umas atrás das outras.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: Portanto, fui para a beira da estrada e lá fiquei, sentada no banco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: Oh, meu anjo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: Ao início, comecei a sentir-me melhor ao ver o mundo. As crianças a rir, casais de mão dada, cãezinhos a correr...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: E, depois, eis que surgiram estes problemas...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: Uma a uma, todas as portas se fecharam. Acabou-se a ideia de me sentar lá fora à noite a ver a vida a passar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: Olhar a partir da janela também não era boa ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: Sacos de cadáveres onde outrora havia crianças, cães selvagens a percorrer as ruas e vizinhos a agir como estranhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: A vida, meu querido, pareceu ter ficado paralisada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: E agora nem sequer é possível distinguir a verdade da mentira...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: Só queria que as pessoas deixassem de mentir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: Já falámos. Estou cansado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: Fazemos isto amanhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: Ugh, que foi agora? Achas que te vou roubar ou algo do género? Poupa-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: Estás a gozar? O que é isto? Um interrogatório? Para lá, a sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: Tenta fazer alguma coisa e juro que arranho, mordo e faço o que for preciso. Não vou ficar parada.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: O meu pai pode ser um verdadeiro idiota, mas pelo menos ensinou-me a lutar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: Chega. Não me toques.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: Se é assim que vai ser – na boa. Simplesmente... ugh, enfim. Faz lá os teus testes marados, só não fales comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: Mas tipo, treinar com ele era uma coisa – que eu odiava, já agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: Outra coisa era quando ele perdia a cabeça e me espancava. E a minha mãe? Estava-se a cagar. Nem olhava.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: Ugh, não quero acabar como eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: Para que me tiveram se me iam tratar daquela forma? Ainda não percebi. É assim que é verdadeiramente a vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: E agora temos de lidar com o sol e os Visitantes? Que bom. Mais formas de sofrimento. Espetacular.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: Será que vai acontecer algo de bom por uma vez que seja?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: Porra, sei lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: Desculpa, mas não me sinto preparado para continuar a falar mais por hoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: Então, decidi deixar a organização.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: Mas porquê? Estás a tentar descobrir o motivo pelo qual não confio na AGEF?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: Comecemos por isto...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: Acreditas que os Visitantes são alguma espécie de vírus?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: Não acredito que existam
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: Não, mas não sei o que são
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: Sim, acredito nisso
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: Se é nisso que acreditas, não vejo por que te haverias de dar ao trabalho de fazer todos estes testes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: Não devias tentar enganar-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: Portanto...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: Compreendo. Infelizmente, também não sei o que são os Visitantes, na verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: Mas posso dizer-te uma coisa, com toda a certeza: não são um vírus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: Bem, receio ter de te desapontar. Muito provavelmente não é o caso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: Já viste alguém que estava bem a mudar repentinamente? A transformar-se num Visitante mesmo debaixo do teu nariz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: Pois. Nunca houve um único caso assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: Tens de compreender: a AGEF não está a controlar esta situação. Só faz de conta que sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: Hospitais retirados de serviço, gente enviada para zonas de quarentena... e para quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: Estão a ajudar as pessoas? Já houve alguém que fosse curado?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: A AGEF apenas juntou um monte de pessoas, trancou-as, e agora pode fazer o que quiser à vontade.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: Então, por que trabalhaste para a AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: Já chega deste disparate. Sai daqui
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: Não podia ficar sentado a ver pessoas a morrer, uma a uma.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: Foi por isso que me juntei à AGEF, para ajudar aquelas almas infelizes a fugir das zonas de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: Examinei aquelas pessoas e fiz-lhes diagnósticos. E falsifiquei documentos para que pudessem sair em liberdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: Por tua causa, há Visitantes que podem ter escapado.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: Qual incidente?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: Só é pena que tenhas de fugir daqui também
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: É uma pena que nem sequer me tentes ouvir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: Não vou andar a ocupar espaço em tua casa, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: E preferias o quê? Que deixasse lá aquela gente a morrer?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: Fiz o Juramento de Hipócrates. Farei tudo o que puder para proteger a vida e a saúde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: Mas, no fim... eu próprio tive de fugir de uma zona de quarentena depois de um incidente. Infelizmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: Aconteceu na zona em que estava destacado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: O quê?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: Achas que não os devia ter ajudado? E agora estás a expulsar-me daqui por causa disso?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: Nunca pensei dizer isto, mas é bem possível que sejas pior do que a AGEF que, pelo menos, finge querer ajudar. Já tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: Já não há aqui lugar para mim. Tremo só de pensar no que vai acontecer às pessoas que estão aqui contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: E se ele era humano?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: Não tiveste escolha
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: Oh... ei, não digas isso, pá.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: Já me sinto mal que chegue pelo que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: Bem, tens razão, sabes? Não havia mesmo outra forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: Que saudades dos tempos em que me podia sentar ao volante e não pensar em mais nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: Agora, com estes Visitantes... sabe-se lá. O passageiro seguinte pode muito bem optar por nos meter uma bala na testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: Eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: Não quero acabar na berma da estrada, sem que ninguém queira saber... como o meu velhote.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: Só espero que a minha sorte ainda não tenha acabado...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: Que tipo de carro conduzias?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: Por que era tão especial o teu carro?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: Pá, era o carro clássico mais lindo de sempre...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: Carroçaria em amarelo brilhante, jantes cromadas cintilantes, curvas delicadas...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: Mas já deixou de existir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: Raio da AGEF... Aquele carro era tudo para mim! Cabrões.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: Aquele carro pertenceu ao meu pai. Ele também conduziu um táxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: Em criança, gostava de andar com ele à noite. Adormecia sempre no banco de trás e ele levava-me. Mas depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: Pode-se dizer que a sua sorte acabou...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: Não falo muito sobre isto, mas acho que posso confiar em ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: Um dia, a minha mãe teve de sair em trabalho. Por isso, o meu pai levou-me com ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: Foi quando nos deparámos com um passageiro, nunca me esqueço.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: Fato janota, careca, sorriso de uma besta...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: Toda a gente na zona sabia quem ele era. Até eu, que era uma criança. Dizer não a um homem daqueles não era opção.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: Mas o meu pai era um homem de honra. E, aquela escolha... acabou por se virar contra nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: O homem de fato foi à procura da sua vingança.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: Perdemos a casa. Não conseguimos ficar num único sítio por muito tempo depois disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: E, uma vez que não tínhamos muito dinheiro, o meu pai manteve o táxi que andava a conduzir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: Já com uma idade avançada, com cada vez mais dívidas, começou a desejar nunca o ter mantido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: Dizia que estava amaldiçoado e que nos trouxe má sorte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: Mas ele nunca percebeu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: Não foi o carro. Foi o orgulho dele. Foi isso que nos arruinou.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: Mesmo assim, embora as escolhas dele me tenham obrigado a trabalhar mais cedo para sustentar a minha família...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: Mesmo assim, não deixei de o adorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: Tenho saudades do meu velhote...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: Não peço muito, mas se não te importares, achas que... podias telefonar-lhe?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: É este o número dele: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: Diz-lhe só que estou bem. Eu tratava disto, mas... neste momento não quero desviar atenções para mim'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: Por que te escondeste se estavas com a AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: E para que é a charada?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: Não percebes mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: A sério que me estás a fazer essa pergunta?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: Se as pessoas descobrem que trabalhei para a AGEF...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: Ouve, já não estou com a AGEF. Pensa nisso como se me tivesse... demitido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: Ouve, já não estou com a AGEF. Pensa nisso como se me tivesse... demitido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: Sim, tive de fazer certas coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: Levar pessoas, enviá-las para zonas de quarentena...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: Mas estava só a fazer o meu trabalho, ok? Estava só a seguir ordens.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: Não vale a pena perguntares-me sobre aqueles que levámos. Isso deve ser respondido pelos meus superiores e não por mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: E chamar-me de assassino, ou qualquer outra coisa... é só ridículo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: O que se chama a um assassino que mata outro assassino?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: Uma vez, apanhei um gajo que apresentava sinais de ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: Resumindo a história, ele acabou por piorar na zona de quarentena e morreu. Acontece.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: Depois veio a mulher dele. Queria saber quando o deixaríamos sair. Dissemos-lhe que já não havia nada para sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: Dava para ver que ela ficou em choque. Começou a gritar, a chamar-nos assassinos e a exigir o corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: Dissemos-lhe que o protocolo não permitia a devolução do corpo. Mas isso não a fez desistir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: Acampou no recinto mesmo em frente aos portões.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: Demos-lhe o corpo. E, depois, despediram todos aqueles que quebraram o protocolo. Eu incluído.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: Ela tinha mesmo de recuperar a porcaria daquele corpo, não era? Aquela psicopata fez-me perder o meu trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: E, agora, não tenho para onde ir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: E, em vez de o enterrar, anda só a arrastar o corpo por aí com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: Valeu mesmo a pena fazer com que fôssemos despedidos, não foi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: Mas haverá alguém na AGEF que não seja um otário?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: É tramado.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: Desculpa?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: Portanto, faço o meu trabalho, cumpro o meu dever e sou despedido por causa de uma louca...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: E tu ousas chamar-nos de otários?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: Sabes que mais? Vai-te lixar. Vou sair daqui para fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: Céus, será que toda a gente perdeu o juízo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: Não, não, foi exatamente isso que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: Desde que o sol anda a dar as últimas e as infeções começaram, toda a gente ficou louca.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: Será que valia assim tanto a pena perder o trabalho por causa daquele corpo? O que achas?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: Foi bom ela voltar a reunir-se com o marido
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: Não lhe deviam ter devolvido o corpo
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: Estás a dizer que foi bom termos sido despedidos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: Civis... não percebem ponta de um corno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: Devia era matá-la simplesmente, como aconteceu com o marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: O que foi que acabaste de dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (Saca da tua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: Qual é o espanto?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: Segundo o protocolo, se um civil contaminado estiver em mau estado...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: Lidamos com o problema no momento, para que não existam Visitantes na quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: Deixa-o viver
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (Saca da tua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: Obrigado por compreenderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: Não sou um assassino, estava só a seguir ordens.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: Ei, o que raio estás a fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: Calma, ele era um Visitante! E em mau estado! Não podíamos simplesmente deixá-lo sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: Não me mates, estava só a seguir ordens!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: Também acho. Devíamos ter seguido o protocolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: Tudo bem, não te incomodo com mais nada. Obrigado por me deixares entrar, mesmo sabendo que estive com a AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: Se algum dia vier a recuperar o meu trabalho, vou garantir que a tua cooperação não passa despercebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: Bem, é tudo da minha parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: Ah, sim, quase me esquecia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: Amanhã à noite vou voltar para casa. Aponta o meu número, acabaram de estabelecer uma linha telefónica por lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour:  {0}. Vamos mantendo o contacto por telefone.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: Ok, agora sim, é tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: Bebe uma cerveja e vai dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: Faz festinhas ao gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: Pega no gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: Alimenta o gato com um pouco de comida enlatada (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (Estendes a mão e fazes festinhas ao gato)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (Não consegues perceber se gosta ou não)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: Faz festinhas ao gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: Pega no gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: Alimenta o gato com um pouco de comida enlatada (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (Decides fazer festinhas ao gato)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (Na verdade, parece estar a gostar)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (Não é tão carrancudo como parecia à primeira vista)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (Parece que está a começar a habituar-se à tua presença)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: Faz festinhas ao gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: Pega no gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: Alimenta o gato com um pouco de comida enlatada (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (O gato gosta mesmo de festinhas com frequência)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (Ficas com a sensação de que está a pedir o teu toque)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (E como poderias dizer que não a uma gracinha destas?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: Miau! MIAU! Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (A sua carinha é difícil de ler, mas tens a certeza de que está feliz)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (Ficas com a estranha sensação de que esta noite podes dormir tranquilamente)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (Como se o teu amigo felpudo tivesse partilhado uma das suas vidas contigo em sinal de agradecimento)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (Quem sabe... talvez a morte não preste atenção à tua casa por hoje)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: Pobres pequenotes...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: Passa-se algo de errado?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: Hã?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: Eu... eu estava só a perguntar-me...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: Se isto não é uma exterminação em massa. Se sobrevivermos... o que será que nos espera?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: Que tipo de futuro haverá para todos aqueles que restarem?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: Tens medo de não conseguires encontrar um lugar para ti no novo mundo?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: Um coração gentil não dura muito nos dias que correm. É melhor encontrares alguém com quem possas ficar
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: Um coração gentil...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: Não consigo viver com violência.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: Não sei qual é o lugar a que pertenço neste... como disseste? Neste "novo mundo".'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: Portanto, suponho que o plano seja só cair para o lado e morrer?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: E o que sugeres?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: Tempos negros não são algo de novo... já enfrentámos problemas antes.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: Não quero nada disto. Mesmo que alguém me proteja...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: A matança não vai parar. A violência não vai desaparecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: Portanto, suponho que o plano seja só cair para o lado e morrer?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: E o que sugeres?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: Tempos negros não são algo de novo... já enfrentámos problemas antes.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: Sinto-me tão perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: Vamos mesmo ter de viver rodeados de assassinos?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: E as crianças? Vão ser ensinadas por gente sem escrúpulos?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: Não há tempo para lamentações
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: RECOMPÕE-TE!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: Não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: Não tenho nada para oferecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: Eu... só quero que isto acabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: Eu... eu não aguento mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: Sim, é verdade. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: Como vamos viver, agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: As pessoas cederam à loucura e matam tudo o que pareça ser... diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: Não importa quem se atravesse no caminho.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: Não há tempo para lamentações
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: RECOMPÕE-TE!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: Porque não?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: Talvez a indiferença te ajude. Mas não consigo ser assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: Se tivesses visto aquilo que vi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: É algo que... fica marcado na tua mente para sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: O fogo. Os gritos. As caras de raiva e de medo. Os lares destruídos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: Não consigo ser como tu. Não sou assim tão forte.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: Para mim... só há uma forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (A mulher estremece e olha para ti com medo)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (A sua confusão ajudou-a a esquecer os pesadelos, mas apenas por breves momentos)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (Ela cobre a cara com as mãos e chora)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (Não sabes o que fazer. Ninguém te preparou para isto)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (Colocas delicadamente uma mão sobre o seu ombro e ficas ao lado dela por algum tempo)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (Provavelmente, é melhor deixá-la sozinha)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: Ei, sabes que mais, talvez lhe possas telefonar? {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: Podias dizer-lhe umas verdades.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: Afinal, também são filhos dele. Ele devia ajudar-me a procurá-los.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: Se houver um sinal, telefonas, pode ser? {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: Diz-lhe apenas que me lembro de tudo... e que ainda quero arrancar as minhas próprias goelas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: Ou grita-lhe só. Não sei... talvez isso torne tudo um pouco mais fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: E alguns... bem, alguns precisam de ajuda do além.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: Existem pessoas... especialistas... que sabem como eliminar a escuridão.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: Se quiseres, posso dar-te um contacto. Pode dar jeito...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: Vou deixar-te o número apontado: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: Certifica-te de que lhe dizes que fui eu que te pedi para telefonares... Não te esqueças!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: Podias telefonar-lhe, se não for pedir muito? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (Ele entrega-te um pedaço de papel com um número de telefone: {0})'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (Pode ser o número de uma embaixada estrangeira)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: Porra, estou a morrer por uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: O que estavas a querer dizer acerca da imortalidade?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: Quero fazer-te um teste
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: Bem... podes dar um tiro na tua própria cabeça e verificar...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: Mas, se fosse a ti, não fazia isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: Não, claro que não somos imortais da forma que estás a pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: Depois da morte, reencarnamos e continuarmos a viver as nossas vidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: Sei o que isto parece, mas se tivesses visto aquilo que vi, compreenderias.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: Talvez os Visitantes tenham sido outrora humanos, e agora... reencarnaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: Não o posso afirmar com certezas. Não sei como é que funciona esta merda...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: Mas tenho a certeza de que a natureza esconde imensos segredos de nós...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: E vou encontrar a minha filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: Não sei em que vida... mas vou.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: Porque nunca morremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: Porra, estou a morrer por uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: Por que razão é que a AGEF anda à tua procura?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: Quero fazer-te um teste
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: Eu estive no epicentro de toda esta merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: Nas terras de onde saíram aquelas coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: Lembras-te daqueles mitos urbanos estúpidos sobre demónios nos subúrbios?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: Bem, ninguém se lembra deles agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: Mas acontece que não eram mitos. A AGEF sempre soube disto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: Diziam não haver nada de místico.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: E agora o sol anda a queimar toda a gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: Enquanto os monstros do subsolo dão cabo daqueles que sobrevivem!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: Basicamente, a AGEF percebeu que fez asneira da grossa...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: E, agora, anda a encobrir a sua incompetência...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: Simplesmente eu estava no lugar errado, no momento errado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: Porra, estou a morrer por uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: Como sobreviveste?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: Quero fazer-te um teste
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: Sou imortal, ou já te esqueceste?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: Não sei...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: Também gostava de saber.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: Talvez por sorte. Ou talvez haja algum poder superior a proteger-me...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: Deus... ou seja lá o que for em que acredites.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: Ou talvez até já esteja morto e esta seja a minha nova vida. Não faço ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: Boa pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: Só lamento não ter uma arma. Far-te-ia a mesma pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: E é pena que tudo o que tenhas é cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: Se tivesse um alambique, destilava aqui um lote do caraças.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: Porra, estou a morrer por uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: E que mais é que sabes?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: Quero fazer-te um teste
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: Conheço toda a estrutura da AGEF:'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: Subordinados, superiores, funções, rivalidades...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: E aqueles cabrões sabiam tudo acerca dos Visitantes. Sabiam o perigo que representavam...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: E, mesmo assim, deixaram-nos entrar na cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: Porque todos se estavam a cagar para a segurança.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: Só queriam lavar dinheiro do governo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: Qualquer pessoa que tenha testemunhado a porcaria que fizeram tornou-se uma vítima.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: A organização não queria que mais ninguém soubesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: E isto foi antes das zonas de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: Mal consegui escapar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: Queres uma informação confidencial? Cá vai...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: É tudo culpa da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: Tudo o que andam a dizer na TV? É treta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: Se há algo que é pior do que os Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: É a AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: Porra, estou a morrer por uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: De onde surgiram os Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: Quero fazer-te um teste
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: Dos subúrbios.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: Sim, eu sei que as zonas de quarentena estão longe dos subúrbios...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: Mas tenho a certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: Não sou supersticioso, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: Eles são os mesmos demónios dos quais se falava há dois anos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: Não sei como conseguiram entrar na cidade...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: Mas sei bem quem foi que os deixou entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: A AGEF...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: Os Visitantes não são extraterrestres, como a maioria pensa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: São criaturas, como tu e eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: Nasceram aqui!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: Não posso ficar aqui mais tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: Preciso de encontrar a minha filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: Obrigado... imortal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: Ahh... água fria. Assim é que é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: Sentes-te melhor?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: Sim, sim, estou melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: Embora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: Sabes, tenho alguma fome. Tens alguma coisa que se coma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: Posso dar-te alguma cerveja (Dá-lha uma lata de cerveja)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: O quê? Não tens cerveja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: Não me mintas, vi o teu frigorífico cheio. Como é que bebeste tudo tão rápido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: Ooh, isso é que é!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: Mmm, excelente. É a minha favorita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: Toma, fica com algum dinheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (Recebes um punhado de notas amarrotadas, inúteis nos dias que correm)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: Bom... obrigado
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: Estou-me a cagar para o teu dinheiro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: Assim é que é!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: Dás-me o que te peço e, em troca, és pago que nem um dono de uma fábrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: Não faço questão de contar os tostões com as pessoas que me ajudam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: Oh, já agora – olha, toma isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (Recebes um frasco de kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: Não sei quem raio é que bebe esta porcaria, mas fica com isso. Pode vir a dar-te jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: Como assim estás-te a cagar? Achas que és especial ou algo do género?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: Toda a gente precisa de dinheiro! Todo o mundo funciona com dinheiro. Essa agora, não precisas de dinheiro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: Olha, toma!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (Recebes um frasco de kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: Não sei quem raio é que bebe esta porcaria, mas fica com isso. Pode vir a dar-te jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: Como assim, não? Achas que não podes ser comprado? Tudo tem um preço! O amor, as coisas, as pessoas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: O dinheiro é que domina o mundo, miúdo! E eu cheguei ao topo dele! Sou dos que manda: um vereador.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: Está bem, esquece. Se não queres ajudar, então vai-te lixar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: Ahh... água fria. Assim é que é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: Do que precisas agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: Oh, ainda bem que perguntas! Dava-me jeito um cigarro. Tens um a mais?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: 'Sim, toma (Dá-lhe cigarros) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: O quê? Não tens cigarros?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: Está bem, esquece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: Ah, assim estás a falar a minha língua!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: Preferia fumar charutos, claro... mas boa sorte a tentar encontrar um agora. Quando fazia parte da câmara municipal...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: Sim... as coisas eram diferentes. Agora, é só morte e caos. Um verdadeiro pesadelo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: Quando é que a AGEF se vai chegar à frente e tratar desta porcaria? Não foi criada para nada, pois não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: Nada deste tipo de porcaria aconteceu quando eu estava no Parlamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: Mas talvez só precisem de tempo. Tudo vai acabar por ficar bem. Só temos de esperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: Estiveste no Parlamento?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: Fizeste parte da fundação da AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: Bem, sim, foi o que acabei de te dizer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: Ah, certo, eis a tua recompensa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (Recebes um punhado de inúteis notas amarrotadas e um estranho postal com o carimbo da AGEF)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: Onde foste buscar essa ideia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: Ah, certo, eis a tua recompensa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (Recebes um punhado de inúteis notas amarrotadas e um estranho postal com o carimbo da AGEF)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: Como assim, não?! Fazes ideia de quem sou?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: Fui um vereador! O governo é uma máquina complicada e são precisas pessoas como eu para que funcione!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: Sou a voz do povo! Sem mim, pessoas como tu nem seriam ouvidas. Eu torno a vida melhor para toda a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: Se os tempos fossem normais, nem te atreverias a responder-me! Serias preso num piscar de olhos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: O mundo está a desabar... Já ninguém quer saber do estatuto de vereador. Toda a gente acha que não fazemos nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: Heh. Vamos ver como vais falar quando o verdadeiro inferno chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: Ahh... água fria. Assim é que é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: Precisas de algo outra vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: És esperto, miúdo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: Quero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: Quero uma bebida energética! Há muito que não bebo algo de fresco e enérgico!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: Está bem, toma (Dá-lhe a bebida energética)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: Não tens EnerJeka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: Está bem, esquece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: Lamento
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: Oooh, sim, sim, sim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: Fala-me sobre o pessoal da AGEF. Quem são aquelas pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: Quais são os planos da AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: O quê? Isto não tem açúcar? Que porcaria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: Devias ter-me trazido um refrigerante em vez deste lix–... Espera, o que foi que perguntaste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: Estás bem da cabeça? Não te vou contar nada de nada! Isso são informações confidenciais!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: Assinei documentos que proíbem a divulgação de algo, percebes? E tu não estás autorizado a saber de nada, sem ofensa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: Olha, toma um pouco de café e vê se paras de fazer essas perguntas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (Recebes uma lata de café)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: Ainda por cima é EnerJeka também. Sabe-se lá que tipo de porcaria é que lá metem... Espera, o que foi que perguntaste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: Estás bem da cabeça? Não te vou contar nada de nada! Isso são informações confidenciais!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: Assinei documentos que proíbem a divulgação de algo, percebes? E tu não estás autorizado a saber de nada, sem ofensa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: Olha, toma um pouco de café e vê se paras de fazer essas perguntas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (Recebes uma lata de café)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: Como assim, caralho? Como é suposto conseguir trabalhar de estômago vazio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: Estou aqui a tentar fazer com que a vida seja melhor! Eu sou um defensor do povo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: Mas só sabem é criticar... Toda a gente se acha inteligente. Então, por que raio não estão no governo, hein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: Exato. É muita parra e pouca uva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: Ahh... água fria. Assim é que é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: O que foi? Precisas de algo outra vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: Isso mesmo, miúdo. Quero a tua caçadeira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: O quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: Perdeste a merda do juízo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: Sim, preciso dela. Para proteção.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: Não te preocupes, eu costumava caçar. Sei como a usar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: Não deves estar a perceber
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: Vai para o inferno
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: Cuidado com o que dizes, miúdo. Já te esqueceste de com quem é que estás a falar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: Se quiser, meto-te na choldra em menos de nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: Não deves estar a perceber
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: Vai para o inferno
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: O que foi que acabaste de dizer? Será que ouvi bem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: Chega. Estás metido em sarilhos, agora!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: Começa a fazer as malas, porque é como se já estivesses preso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: Para mim, não passas de mais um Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: Quero lá saber se és vereador. Para mim, és um Zé Ninguém.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: Estás a falar assim para a voz do povo? Perdeste o juízo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: Estás feito, amigo. Prepara-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: Irritar-me é um erro enorme! Se não sabes, ficas a saber que os vereadores são pessoas poderosas!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: Não te preocupes... Vais acabar por entrar na linha muito em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: Para mim, não passas de mais um Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: Quero lá saber se és vereador. Para mim, és um Zé Ninguém.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: O que raio é que estás a dizer?! É... é melhor teres cuidado com essa linguagem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: Não estou aqui a brincar... estou a falar a sério. Vais mesmo acabar atrás das grades. Vais ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: O que raio é que estás a dizer?! É... é melhor teres cuidado com essa linguagem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: Não estou aqui a brincar... estou a falar a sério. Vais mesmo acabar atrás das grades. Vais ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: Ahh... água fria. Assim é que é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: Então, por que motivo ainda não estou atrás das grades?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: Estás a gozar comigo, é? Eu... eu não estou a brincar! Vais mesmo lá parar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: Talvez antigamente o estatuto tivesse valor. Neste momento, não és nada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: O dinheiro não vale de nada. Não percebes isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: Isso... isso não é verdade! Ainda estou no Parlamento!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: Simplesmente, puseram-me... de licença...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: Quem é que estou a tentar enganar? A vida não vai voltar ao que era...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: Quando eu estava a trabalhar, todo o país se vergava à nossa vontade, à vontade dos vereadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: As pessoas temiam-me, respeitavam-me. Os carros desviavam-se e todos me queriam agradar e conquistar. E agora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: Fantástico. Agora, tenho o estômago às voltas por causa do stress.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: Estás contente? Vai-te só embora. Já chega para mim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: I-isso não é verdade! Ainda tenho muito dinheiro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: Podes não querer saber dele, mas... mas todas as outras pessoas querem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: Quem é que estou a tentar enganar? A vida não vai voltar ao que era...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: Lá se foi o luxo, lá se foram as limusines, lá se foram as gajas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: Com dinheiro, tudo era muito mais fácil. Se tivesses dinheiro, eras alguém de importância!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: Se não fosse pelo colapso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: Fantástico. Agora, tenho o estômago às voltas por causa do stress.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: Estás contente? Vai-te só embora. Já chega para mim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: Céus, estou farta de tudo isto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: Por que estás para aqui sozinha?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: Bem... a minha casa estava à pinha. E não havia sossego. Zero conforto. Quis vir-me embora. Queria ver o mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: Portanto, sim, agarrei numa mochila, nuns refrigerantes, nuns petiscos e nesta pulseira da amizade que fiz na escola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: E vim-me embora. Os meus pais provavelmente nem repararam. Não é que me importe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: Desde então que tenho andado a vaguear por aí e a dormir onde conseguir. E, francamente? Até agora, tem corrido bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: Pelo menos, não há ninguém que me chateie e a dar-me ordens o tempo todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: Céus, estou farta de tudo isto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: E como conseguiste sobreviver?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: Desenrasquei-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: Esgueirava-me para debaixo de escadarias e barracas. Dormia junto às árvores. Escondia-me do calor sob qualquer telhado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: Comia o que conseguia apanhar. Alguns legumes ou alguma barra de chocolate que conseguia roubar de uma loja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: Que olhar é esse? Sim, roubei. Grande coisa. Como é suposto sobreviver? Com esta idade não trabalho. Tenho de me safar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: Céus, estou farta de tudo isto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: Por quanto tempo planeias viver dessa forma?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: E a ti que te importa? Eu desenrasco-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: Porquê? Custa-te muito que eu cá esteja? Roubei-te? Entupi-te a sanita? Estás a chatear-me para quê, mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: Já percebi... Talvez sejas um daqueles pervertidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: Houve um gajo que me acolheu, uma vez. Cheio de falinhas mansas, deixou-me ficar num sítio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: Passámos horas a falar de anime, filmes e tudo isso. Pensei que tinha finalmente encontrado uma pessoa decente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: E depois... ele tentou tocar-me. Pervertido do caraças.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: Céus, estou farta de tudo isto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: E o que aconteceu ao tal homem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: Para que queres saber? Estás à procura de formas de me apanhar se te enfrentar? Já percebeste que não estou com ele?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: E não penses que não percebi. Não estás a perguntar só por gentileza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: Só não queres problemas em tua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: Mas não trago problemas. Não vou roubar, nem te vou partir janelas. Portanto, deixa de agir como se o fosse fazer!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: E, seja como for...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: Só cá estou porque precisas de me ter por cá, certo? Para que o Visitante de tronco nu não te mate. Sim, também vejo TV.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: Céus, estou farta de tudo isto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: Por que motivo é que o teu pai te ensinou a lutar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: Para vos partir a boca toda, pervertidos. Ou só para descarregar em cima de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: Treinou-me desde os três anos. Lutas, socos e mais não sei o quê. O problema? O saco de pancada era a minha cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: Sou todo ouvidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: O que aconteceu aos hospitais?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: Ohhh... foi um pesadelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: Assim que tudo começou, as pessoas correram para os hospitais. Todos queriam saber se eram Visitantes ou não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: Tentámos explicar que não sabíamos quais deveriam ser os testes a fazer para isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: Mas as pessoas não ouviam. Empurravam e eram rudes... e, assim, foi impossível tratar quem estava mesmo doente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: No final, os agentes da AGEF apareceram. Decidiram que as multidões eram uma ameaça à situação do surto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: Portanto, foram todos enviados para zonas de quarentena e os hospitais... foram simplesmente encerrados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: Então, a AGEF deixou-te sem trabalho?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: A AGEF agiu mal?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: Para te dizer a verdade, após o encerramento dos hospitais, fui trabalhar para as zonas de quarentena da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: Para que foste para lá?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: Então, és apenas mais um otário da AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: E achas que agiram bem ao juntar toda a gente daquela maneira?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: Não achas estes tais "sinais" absurdos? Não passam de características humanas normais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: É um disparate! Dentes brancos significam que a pessoa é um Visitante? Poupem-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: Estou a falar a sério, há algo que não nos estão a dizer...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: Para te dizer a verdade, após o encerramento dos hospitais, fui trabalhar para as zonas de quarentena da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: Tinha esperança de ficar a saber de algo sobre os Visitantes e os seus sinais. Mas... nunca aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: Para que foste para lá?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: Então, és apenas mais um otário da AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: Eu... eu queria ajudar as pessoas. É a minha vocação. Não podia simplesmente virar as costas a esta causa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: Talvez... Não. Perdão, ainda não estou preparado para falar sobre isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: Estás errado em chamar-me de otário. Não sabes da missa a metade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: Talvez... Não. Perdão, ainda não estou preparado para falar sobre isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: Sou todo ouvidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: Então, o que era que me querias dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: Se me permites, o que achas da AGEF?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: Penso que a AGEF está a fazer um bom trabalho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: Não confio na AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: Bem, sinto exatamente o contrário.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: Trabalhei para a agência por algum tempo, mas não vi motivos para confiar nela. Principalmente depois do que vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: Pela minha própria experiência, os médicos naquela organização estão totalmente às aranhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: Consegues mesmo confiar numa organização que nem consegue explicar de onde surgiram estes sinais ou o que significam?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: Depois de tudo isto, como podes ainda confiar na AGEF?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: Tenho de admitir que te tinha em melhor conta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: Ótimo. Nem eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: Francamente, eu mesmo não compreendo os motivos da AGEF na totalidade. Mesmo depois de trabalhar com eles por um tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: Mas seja qual for a motivação deles, a minha escolha é ajudar as pessoas à minha maneira, contra as regras deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: O problema era a transparência. Não havia nenhuma. Nada de nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: Nunca nos disseram de onde surgiram estes "sinais" ou o que é suposto significarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: Simplesmente entregaram-nos uma lista de diretrizes sobre quem é Visitante e quem devemos deixar passar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: Depois disso, deixei de me sentir um médico. Sentia-me mais um guarda da fronteira a carimbar papéis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: Portanto, comecei a falsificar relatórios. A ajudar pessoas a fugir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: Estou certo de que tens mais perguntas. Mas, se não te importas, deixemos o resto para amanhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: Sou todo ouvidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: Como é que não estás numa zona de quarentena?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: Foi devido a... um incidente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: O sol estava prestes a nascer. Estava a ir para casa, quando um dos agentes da AGEF me chamou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: Naquele momento, a minha cabeça começou a latejar e os meus joelhos quase cederam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: Ele gritou-me e disse-me para voltar. Eu estava preparado para morrer naquele momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: Ele apontou a espingarda às minhas pernas e disse-me para não me mexer. Ele continuou a olhar, até que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: Mandou-me pôr a língua de fora, porque queria verificar se eu era um Visitante. Para não levar um tiro, foi o que fiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: E a seguir, ele riu-se. Disse que eu devia ser um mau médico se não sabia que a língua não é um sinal de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: Nunca temi tanto pela minha vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: Naquele momento, não pensei em salvar a vida de alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: Simplesmente, fugi. Como um cobarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: A vergonha... é insuportável. A vergonha perante aqueles que lá ficaram. Perante a minha pessoa. Perante toda a gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: Não te julgo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: Mas ainda podes ajudar as pessoas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: És um cobarde patético. Sai da minha casa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: Obrigado por compreenderes. Isso... isso torna tudo um pouco melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: Não consigo deixar de pensar nas vidas que poderia ter conseguido salvar, se lá tivesse ficado até ao fim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: Receio que isso não seja possível...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: Todos os meus instrumentos ficaram para trás na zona de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: Portanto... sou totalmente inútil, agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: Sei que esperavas obter tratamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: Mas o que pode fazer um velho como eu, sem nada além das suas próprias mãos? Muito pouco...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: Lamento se te desiludi. Receio não ser uma mais-valia contra a ameaça dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: Não te preocupes, podes ficar na mesma
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: Então vai e não voltes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: Suponho que tenhas razão. É melhor ir-me embora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: Obrigado por compreenderes. Isso... isso torna tudo um pouco melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: Imagino que, mais cedo ou mais tarde, a AGEF acabe por descobrir os relatórios falsos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: Mesmo assim, não consigo deixar de pensar que poderia ter deixado a minha vida em segundo plano e ajudado mais pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: Sinto que esse fardo me vai perseguir até ao fim dos meus dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: Suponho que tenhas razão. Isto não é lugar para um velho como eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: Não tenhas vergonha, pá. Vá, diz lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: Ainda achas que a AGEF virá à tua procura?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: Espero bem que não, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: Sim, fiz asneira ao ir para a AGEF daquela maneira. Já devia saber que me tentariam aprisionar também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: Achei que podia simplesmente levar o passageiro e que me fossem deixar em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: Em vez disso, tiraram-me o carro e quase me matam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: Mas que mais era suposto, pá? Pensa lá. O gajo era um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: Não tenhas vergonha, pá. Vá, diz lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: Há quanto tempo conduzes um táxi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: Já o faço há algum tempo. Atualmente, não trabalho para nenhuma empresa. Sou o meu próprio chefe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: A AGEF não permite que os cidadãos se desloquem propriamente à vontade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: Mas esta confusão toda vai acabar um dia. Não vai? E o dinheiro... é sempre bom ter dinheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: O pessoal paga muito bem por viagens no limiar do risco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: E as noites a conduzir trazem-me memórias de quando era criança.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: Sabes, tornei-me taxista por causa do meu pai. Queria seguir as suas pisadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: Não tenhas vergonha, pá. Vá, diz lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: Pareces-me muito em baixo, hoje
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: Sim, é só que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: Não consigo aceitar o facto de que fiquei sem o meu carro, sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: Não tenhas vergonha, pá. Vá, diz lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: O que aconteceu ao teu pai?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: Espero não ter apanhado muito sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: Tens a certeza de que não estás com a AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: Não, não estou. Já te disse que costumava reparar frigoríficos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: Encontrei o uniforme num carro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: Mas antes disseste que o tiraste de um cadáver
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: Não me estás a mentir, pois não?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: Bem... sim, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: Encontrei-o num cadáver que estava dentro de um carro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: E achei que o uniforme me fosse proteger dos Visitantes. Afinal, os gajos da AGEF usam-no por algum motivo, não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: Não estou a mentir. Só fico confuso com o stress, o que há de tão estranho nisso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: Acredita, se tivesses visto aquilo que vi... compreenderias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: A caminho daqui, quase morri de medo, com os corpos que não paravam de se mexer no chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: Espero não ter apanhado muito sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: Não achas que usar um fato da AGEF é má ideia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: O quê? Não propriamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: Sim, eu sei que algumas pessoas não gostam da AGEF, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: Ohh, estás a dizer que posso vir a ter problemas com a AGEF, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: Bem, ouve, eu... eu acho que vão acreditar em mim, se lhes explicar tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: Não é preciso fazer deles a raiz de todos os males. Não é que sejam alguma sociedade secreta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: Espero não ter apanhado muito sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: Mostra-me o que tens nos bolsos
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: Ei, para que me queres revistar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: Estou à procura do teu crachá da AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: O que foi? Tens alguma coisa a esconder?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: O quê? Que crachá?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: Juro que não tenho nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: Esvazia os bolsos. Vamos fazer isto da maneira mais fácil
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (Saca da tua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: Quem? Eu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: Não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: Esvazia os bolsos. Vamos fazer isto da maneira mais fácil
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (Saca da tua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: Está bem, está bem. Não é preciso exaltares-te...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: Toma. Satisfeito?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: Está bem, apanhaste-me. Estou mesmo com a AGEF...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: Mas, por favor, não contes isto aos outros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: Oh, raios...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: Toma. Só não me mates.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: Sim... estou mesmo com a AGEF...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: Mas é melhor que mais ninguém saiba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: Espero não ter apanhado muito sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: Por que te escondeste se estavas com a AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: Preciso de te fazer um teste
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: (Parece que a conversa terminou aqui)'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071808
    m_Localized: Entrega um aviso da AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071809
    m_Localized: Entrega um aviso da AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071810
    m_Localized: Entrega um aviso da AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071811
    m_Localized: Entrega um aviso da AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071812
    m_Localized: Entrega um aviso da AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071813
    m_Localized: Entrega um aviso da AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071814
    m_Localized: Entrega um aviso da AGEF
    m_Metadata:
      m_Items: []
