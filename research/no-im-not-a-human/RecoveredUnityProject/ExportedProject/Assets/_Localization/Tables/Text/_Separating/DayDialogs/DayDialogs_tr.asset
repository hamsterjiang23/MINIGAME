%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_tr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 1bdb57fba89c5124a83ad717d0443512, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: Yanıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: Nasılsın?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: Seni test etmek istiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: Sandığımdan da betermiş. (öksürür) Hay...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: Böyle giderse bir hafta anca dayanırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: Sen beni içeri alınca biraz da olsa içim rahatladı en azından. Sağ olasın.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: Gerçi şimdi ben burada boş boş oturuyorum, ekip arkadaşlarım orada geberiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: Onları bırakmamam gerekirdi. Kaybedecek bir şeyim mi vardı sanki? Zaten öldüm öleceğim şurada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: Yanıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: Niye eve gitmedin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: Seni test etmek istiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: Evde çoluğum çocuğum var ama... (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: Benden korksunlar istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: Beni... (öksürür) böyle hatırlasınlar istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Ormanda can verdiğimi sansınlar... (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: Yangınları söndürürken öldüğümü düşünsünler...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: (öksürür) Beni bitmez sabrım ve özverili çalışmalarımla ansınlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: Yanıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: Üniforman nerede?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: Seni test etmek istiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: Patronlar aldı. (öksürür) Hepimize yetecek teçhizat kalmadı artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: Millet (öksürür) iş başındayken geberip gidiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: Artık cansız bedenleri alevlerden kurtaracak vaktimiz bile yok. Yangınlar (öksürür) ne varsa alıp götürüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: Tabii, patronların tek derdi... (öksürür) bu siktiğimin üniformaları...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: Adamlar dakika başı resmî emir çıkarıyor. Hiçbiri halka yaramıyor ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: Yanıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: Bu orman yangınları nasıl başladı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: Seni test etmek istiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: Son zamanlarda orman iyice kurudu. (öksürür) Bu yüzden ağaçlar hemen tutuşuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: Bu yangınlar da başımıza gelen talihsizliklerden biri işte. (öksürür) Şu yerden çıkan Ziyaretçiler gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: Daha kim bilir neler göreceğiz?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: Herhâlde öyle bir noktaya geldik ki artık tek ümidimiz, huzur içinde ölebilmek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: Aslında... (öksürür) Bunu eve götürecektim, çocuklar sevinsin diye. Neyse, sana vereyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: Kolye. Pek bir şeye benzemediğinin farkındayım ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: Baldan güneş yapan ölü arılardan bir kolye işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: Yanıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: Rezil duruyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: Seni test etmek istiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: Sanırım yolun sonuna geldim... (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: Kaçmaz olaydım... Bir iki kişiyi daha kurtarabilirdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: Dişimi sıkardım... Yorgunluktan yığılana kadar çalışırdım. Ekibimin geri kalanı da katledilmezdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: BU PATRONLARIN DA VAR YA! (ÖKSÜRÜR)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: Şu hâlimize bak ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: Bana son bir dal versene.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: Bir dal sigara uzat (bir sigara ver)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: Hiç sigaran var mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: Yok maalesef (sigara verme)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: Son darbeyi de sen vur. (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (Adam cebinden çakmak çıkarır, sigarayı yakar ve içmeye başlar.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (Uzunca bir fırt çekip duvara yaslanır. Biraz bekledikten sonra ikinci fırtını çeker.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: Çok özledim bizim çocukları. Böyle sigara içer, sohbet ederdik...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: (ÖKSÜRÜR)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: Sen kullanmıyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: Hiç bakma bana öyle. İçinden "İtfaiyeci sigara mı içer ya?" dediğini biliyorum. (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: Artık bir önemi yok zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: Gebermeden önce (öksürür) biraz içim rahatlasın istedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (Adam duvara yaslanır ve tavanı seyrederek konuşmaya devam eder.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: Ne ettim de itfaiyeci oldum ben? Annem bana "Git, fabrikada işçi ol," derdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: İtfaiyeci dediğine yanıp kül olmak yakışmaz...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: (ÖKSÜRÜR)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: Hür gezebilsem... Keşke..'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: Kimi arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: Benim bir dostum vardı, biliyor musun? Çocukluktan beri arkadaşız.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: Bir kaza geçirdi de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: Bir işe almışlardı onu, dağın tepesinde bir şey kazıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: Ne halt çeviriyordu hiç bilmiyorum. Açıkçası pek sikimde de değildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: Sonra gitti, sırtını incitti salak! Kaç gün hareket edemedi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: Kendini çok zorladı tabii...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: Hatta öyle ki, martılar sırtını şey sanmış...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: Yani, sırtını dediğim... Götü işte. GÖTÜNE YUVA YAPMIŞ MARTILAR, YUVA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: Kusura bakma, kafamdaki seslerden biri işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: Çok komik bir şaka patlattı da...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: Hür gezebilsem... Keşke..'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Şey... Sen iyi misin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: Hee. Bacaklarım geri uzasın diye bekliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: Baksana, sağdaki biraz uzadı bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: Biraz daha burada kalacağım yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: Kafandaki o sesleri soruyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: Peki...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: İnsan bir güler ya! Şaka yapmaya çalışıyoruz şurada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: Sen hemen çakarsın sanmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: Jeton düşmedi herhâlde...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: Bir saniye, sen bana nasıl olduğumu mu sordun?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: Sağ olasın ya, çok naziksin!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: Bana nasıl olduğumu kimse sormaz. "Günün nasıl geçti?" diyenim bile yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: Tabii benim onlar gibi sıradan bacaklarım yok, yarış arabası tekerlerim var. KISKANÇLIKTAN çatlıyorlar mı yoksa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: Bu soruya kimse dürüst cevap vermiyor, sıkıntı orada zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: Mazeret uyduruyorlar hemen. Öylece bakıyordum, falan diyorlar. Pardon, gözüm dalmış falan filan. Amaaan.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: Hiçbir şey söylemeden bön bön bakınca da insan kötü hissediyor yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: Tabii, engelli olduğumu görmezden gelmek de saçma olur. Bariz engelliyim yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: Dengeyi sağlamamız lazım işte, onu demeye çalışıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: Tabii, dünyanın dengesi kaymışken benim için mi denge bulacak millet? PEH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: Sakat olsaydın nasıl yürürdün, hiç hayal ettin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: Gerçi öyle sorunca da hoş olmadı...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: Bacağın olmasaydı yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: AYNEN öyle. Evinden bile çıkamazdın ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: Merdivenlerden nasıl çıkacaksın? Karşıdan karşıya nasıl geçeceksin?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: Adamlar öyle bir kaldırım yapmış ki, hoplaya hoplaya geziyorum ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: Senin evde merdiven, basamak falan olmadığı için pek zorlanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: Fakat tek bir dileğim olsaydı...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: ... burada bir TEPE olsun isterdim!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: Düşünsene bi''! Bayır aşağı tekerlekli sandalyeyle yarış yapardık. Duvara kafa atardık falan. HAH! Aman, neyse...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: İnsan biraz düşünceli olur ya. Evimde engelli insan var, ona özel bir yarış pisti kurayım falan der yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: Pardon, sen bana iyi olup olmadığımı sormuştun.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: Fena değilim, sağ olasın.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: Hür gezebilsem... Keşke..'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: Senin başına güneş mi geçti?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: Ne alakası var şimdi bunun?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: Saçlarım daha dökülmediğine göre bence gayet iyiyim!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: Bacağım olmadan tekerli sandalye yarışı yapamam ki. Baksana!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: Hızlı giderken nasıl fren yapacağım mesela? Nasıl viraj alacağım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: Sen tekerlekli sandalyede olmadığın için anlayamazsın tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: Buna inanıyor musun gerçekten?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: Bacaklarının geri uzayacağına inanıyor musun yani?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: Ee, tabii!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: Ne derler bilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: Sağ ayak, daha uzun adım atar. Bu yüzden yerimizde sayıyoruz zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: Bak, benim bacaklarım bunu kanıtlıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: Ne olursan ol, sonun belli. Kaçış yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: Bugün bitecek, yarın yeni bir gün başlayacak. Peki güneş doğduğunda herhangi bir şey değişmiş olacak mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: Olmayacak tabii. Boktan bir döngü başa saracak işte!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: Yani düşündüğün zaman aramızda pek bir fark yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: İkimiz de yerimizde sayıyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: Dünya harikalarla dolu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: Şu ana dek rezillikten başka bir şey görmemiş olabiliriz AMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: Bu rezillikler eninde sonunda bitecek. Ardından güzellikler gelecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: Tanrının affettiği bir sürü günahkâr var. Belki bize de bir kıyak geçer, değil mi ama?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: Hür gezebilsem... Keşke..'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: Bacaklarını nasıl kaybettin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: Sana dağda dostum var demiştim ya, götüne yuva yaptıkları hani? HAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: Neyse... Bahçesinde bir çukur kazmıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: Evinin altından bir boru geçtiğini sanıyordu. Boru da etle doluymuş, inanırsan.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: Sonra adam gitti, kafam kadar bir matkap aldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: Sonra da kazmaya başladı...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: Vay be...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: Onu bir daha da görmedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: Hür gezebilsem... Keşke..'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: Ee, bacakların?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: Sikmişim bacaklarımı! Benim asıl merak ettiğim, o boruyu buldu mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: İyi, unut gitsin.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: Hım... Evet, doğru! Onu unuttum gitti. Sonra bira almaya çıktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: Yolda raylara ayağım takıldı, tren bacaklarımı kesti!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: Yok, dur...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: Yok yok, öyle olmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: Ee, n''oldu? Dilini kedi mi yuttu? Bacaklarıma ne olduğunu merak etmiyor muydun?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: İyi o zaman, ben de söylemiyorum. Hem şimdi anlatsam sıkılırsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: İçerisi çok havasız...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: Senin yanında çocuk yok muydu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: Ne? Var hâlâ. Bir yerlerde oynamaya gitmiştir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: Diğer evlatlarım nerede, onu öğrenmem lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: Telefonun var mı? Babalarını arayıp sorabilirim. Hem o herifin pis suratını görmek zorunda kalmamış olurum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: İçerisi çok havasız...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: Aradın mı kocanı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: Ne arayacakmışım be? Mazeret uydurur şimdi o. Herif vasıfsızın tekiydi. Çocuklar, ev, faturalar... Hepsi bana kaldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: Bazen birbirimize sadece tahammül ettiğimizi düşünüyorum ama beni hiç bırakıp gitmedi niyeyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: İşine geliyordum herhâlde. Beni bırakmayı denerse karnını deşeceğimden de korkmuş olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: Aman, çok yoruldum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: İçerisi çok havasız...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: Kocanı görmeye gittin mi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: Yataktan bile zor çıkıyorum ki! Her yerim ağrıyor, hem çok yorgunum. Sırf sinirimden hayattayım galiba.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Evde her şey bana düşmüştü. Çocuklar, kocam, ev işleri... Gerçi ara sıra ona katlanmayı kolaylaştıran bir şeyler yaptığı oluyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: Sonra konuşsak olur mu? Dinlenmem lazım, bayılacak gibiyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: İçerisi çok havasız...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: Ne gibi şeyler yapıyordu mesela?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: Mesela bir keresinde...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: Bir kadının şoförlüğünü yapıyordu. Ben olan biteni hemen anladım, tabii. Başta bir şey demedim ama sonra gına geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: Başının etini yiyip durdum... O da sırf o kadını görmemek için mesleğini değiştirdi. Beni gerçekten seviyor muydu ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: Uyduruyor da olabilirim... Neyse, dinlenmem lazım. Sonra konuşuruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: İçerisi çok havasız...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: Çocuklarını merak etmiyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Yani, gerektiği kadar etmiyorum herhâlde. İlk çocuğum doğduğunda... Anne olmayı beceremedim. Elime yüzüme bulaştırdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: İkincisi doğduğunda bu sefer hakkını vereceğimi sanmıştım ama o da ilki gibi oldu. Sonra üç, dört derken...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: Doktorlar bana hamile kalamayacağımı söylemişti. İkincisi doğunca Dünyanın Sekizinci Harikası dedim ona!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: Sonra işler boka sardı işte. Çok kötüydü...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: Benim biraz gözlerimi dinlendirmem lazım...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: İçerisi çok havasız...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: Çok kötü olan neydi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: Bunu anlatmaktan çekiniyorum. Onları çok severim ama... Bazen ipin ucunu kaçırıyordum. Bağırıyordum, el kaldırıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: Biliyorum, bu çok kötü bir şey. Gerçekten pişmanım ama işte... İlk defa kendimi rahat hissediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: Onlar yokken nefes alabiliyor gibiyim. Bunu söylemekten hiç hoşlanmıyorum ama nihayet... mutlu gibiyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Hay anasını...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: Ee? Sakinleşebildin mi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Evet. Benimki saman alevi gibidir ama aklıma sinir bozucu bir şey geldi mi hemen küplere binerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: Eskiden daha rahattım var ya. Beni sinir etmek çok zordu yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Şimdi bir tepemin tası attı mı, etrafımdakilerin vay hâline.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: Zaten sakin kalmak ne boka yarıyor ki? Belki sinirli olduğum için kafayı sıyırmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: Şu mal oğlu mallar gibi güneşe tapmıyorum en azından.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: Neymiş efendim, güneş bizi kurtaracakmış. Ha siktir lan oradan. Bizi ÖLDÜREN güneş lan zaten!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: Bana sorarsan hepimiz ölmenin eşiğindeyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: Bu geri zekâlılar bunu kavrayamıyor ama işte. Hepsinin ta... Neyse, tamam. Sakinim. Sıkıntı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Sağ ol dinlediğin için.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Hay anasını...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: Niye bu kadar sinirlisin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Ben bile bilmiyorum ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Her şey sinirimi bozuyor yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: Özellikle şu kültistler var ya... Alayı kolpacı lan bunların. Milleti kandırmaya çalışıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: Millet de koyun gibi, ne deseler inanıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: Bağış yapacağım diye çocuğunun elindeki harçlığı alan gördüm lan ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: Sırf ismi cismi belirsiz bir "mesihi" tatmin etmek için.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Bunlar kafayı yemiş. Böyle saçma sapan laflarıyla milletin beynini yıkıyorlar. Mesela benim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: Neyse, sakinim. Daha iyiyim şimdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Hay anasını...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: Kültistler tanıdığın birini mi yanlarına aldı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: Hayır, onlar almadı. Sıkıntı da bu zaten, kendi gidip onlara katıldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: Karım yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Bu olaylar başlamadan önce de zaten dindar biriydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: Onu çok sevdiğim için bunu kabullendim. Aramızda hiç sorun çıkarmadı yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: Sonra işler boka sarınca gitti, yeni mesihe inanmaya başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: Kültistlerin zırvalıkları ona mantıklı geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: Her geçen gün iyice onlara inandı, en son tamamen kafayı yedi. Bu saçmalıklarına inanmaya başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: Ben ne halt yediğimi fark ettiğimde o çoktan gitmişti. Benden korkup kaçtı. Artık çok geçti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Hay anasını...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: Karınla aranızda ne yaşandı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: Karım bir gün gelip bu külte katılacağını söyledi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: Buna inanamadım... Sevdiğim kadın... tamamen farklı bir insana dönüşmüştü.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: Yaşadığımız onca şeyin onun için hiçbir önemi yok gibiydi. Hayatımda ilk defa bu kadar öfkelenmiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: Beni aslında hiç sevmediğini düşünmeye başladım. Siktir olup gitmenin yolunu arıyor sandım. Midem bulandı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: Ellerim kendi kendilerine hareket ediyor gibiydi. Birden yumruk oldular, sonra kendimi asla affetmeyeceğim bir şey yaptım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: Ona vurdum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: Artık geri dönüş yok. O külte katıldı, ben de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: Olanları asla kabul edemeyeceğim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: AKLIMI SİKEYİM YA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: Sevdiklerime zarar vereceğime kendime veririm daha iyi. Bunu hak ediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Git başımdan. Yalnız kalmam gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: Efendim? Falına mı bakayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: Beni nasıl bu kadar iyi tanıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: Hah! Ne kadar saçma bir soru... Seni tanıyan ben değilim. Ben sadece bir elçiyim. Yıldızların mesajını iletiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: Ay ve Venüs, Altıncı Ev''de kavuşmuş. Alnında yazıyor. Hiçbir şey söylemesen de olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: Zamanında aynı senin gibi birini tanımıştım. Sadece dinlerdi, hiç konuşmazdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: Ne derler bilirsin. Jüpiter Sekizinci Ev''deyse susmak gerekir. Bu, kapalı kapıların sembolüdür.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: Efendim? Falına mı bakayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: O bahsettiğin adama ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: Dedim ki: "Ne yaptığın önemli değil. Önemli olan, bu işi yaparken auranın ne renkte olduğu." Ancak bana inanmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: Sonra hayat onu es geçip gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: Bir gün gözlerimi kapadım ve hayallerimin gerçekleştiğini hayal ettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: Tüm kozmik enerjimi bu görseli gözümün önüne getirmeye harcadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: Yüreğini evrenin enerjilerine kapatacaksan neden bu bedende yaşayasın ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: Sen de benim gibi yap. Gözlerini kapat...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: En büyük hayallerinin gerçekleştiğini hayal et...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Bu görsele odaklan...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: Neden acı çektiğini biliyor musun? Acı çekmenin aslında neşenin en saf hâli olduğunu anlayamıyorsun çünkü.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: Söyle bakalım. Sıradaki adımı atmaya hazır mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: Efendim? Falına mı bakayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: '"Sıradaki adım" neymiş?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: Kendini seçmek. Bu kokuyu duyuyor musun? Yıllar önce suya düşen hayallerinin kokusu. Onları diriltmenin vakti geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: En kötü anımda, hayatta bir ışık veya anlam bulamıyorken ustam bana dedi ki: "Okyanusuna kulak vermiyorsun."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: Başta gülüp geçiştirdim ama sonra gözlerimi kapattım ve onu duydum. Sanki hep oradaymış gibi. Sen de duyabilirsin!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: Fakat önce cevaplanması gereken bir soru var. Kendinle bir olmaya hazır mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: Efendim? Falına mı bakayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: Ustan kimdi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: Harika bir kadındı. Çetin denizin ortasındaki fener gibiydi. Gerçeğin özünü görebilmemi sağladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: Hiç unutmam, bir keresinde "İnsanlar, iç ışıklarını solumayı öğrenemedikleri için ölüyorlar." demişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: Sayesinde gözlerimi açtım. İnsanlara kendi yollarında rehber olabileceğimi gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: Fakat maalesef o daha ileri gitmekten korkuyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: Kendini asla merkezde göremedi. Ki aslında olunabilecek en önemli yer orasıdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: İnsanın kendi evreninin merkezinde kendisi değil de kim olacak? Sen beni anlıyorsun, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: Efendim? Falına mı bakayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: Kendini nasıl kurtardın?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: Yaptığımız her bir hata, aslında iç evrenimizin henüz deşifre olmamış bir mesajıdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: Uzun ve zorlu bir yoldan geçtim. Etrafı izledim, yeri geldi arkama baktım. Bu ev beni nasıl ağırladı, bir baksana.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Aydınlık, ferah, enerjime uyum sağlıyor. Kendi yuvana karşı gelmenin bir manası yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: Korkunu zaten soğurmuş, anlamıyor musun? Bunu kabul etmezsen duvarlar ağlar. Fakat dökülenler senin gözyaşın olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: Efendim? Falına mı bakayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: Benden ne istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Ay, benim senden bir şey istediğimi mi sanıyorsun sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: Kendi gölgenin dansını görebilsen gideceğin yolun nerede saklandığını anlardın.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: Yapman gereken tek şey, kendini olumlamak. Her şeyin değiştiğini hissetmiyor musun? Artık daha kolay soluyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: Enerjim, senin evine tepki veriyor çünkü. Daha derin bir anlam arama. İllüzyonları görmezden gel ve kaosu kucakla.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: Senden tek istediğim bana katılman. Bu ev, sen ol. De ki: "Ben burada misafir değilim. Ben bu sığınağın sahibiyim."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: Efendim? Falına mı bakayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: Ya hiçbir şeyin sahibi olmak istemiyorsam?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: Bu duvarlar sana sarılmak istiyorlar ama sen kendi otoritenin zincirleriyle onları hapsediyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: İçindeki sessizlik, kendi korkunla boğduğun dış dünyanın sesi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: Enerjin, kışın dışarıda kalan bal gibi donmuş. Nefesinle onu çözdürmen gerek. Aynalar asla yalan söylemez.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: Karşında gördüğün tek şey kendinse hiçbir şey görmüyorsundur. Tek yapman gereken, enerjini üç derece sağa kaydırmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: Böylelikle nihayet neşe bulacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: Evini nasıl kaybettin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Aah ah... Daha dün gibi gözümün önünde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: İşten yeni kovulmuştum. Tek istediğim eve gidip yatağa girmek ve hüngür hüngür ağlamaktı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: Eve gelince kapının önünde bir sürü ayakkabı gördüm. Dedim herhâlde oda arkadaşım arkadaşlarını çağırdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: Ben de odasına, ne yaptığına bakmaya gittim. Fakat yaklaştıkça garip bir ses duymaya başladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: Başta bir korktum ama sonra neyse, bir göz atayım dedim. Sessiz sessiz içeri baktım, ne oluyor diye merak etmiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: Aslında kaçmak istedim ama korkumdan felç olmuş gibiydim. Sonra o...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: Beni... O...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: Biraz uzanmam lazım. Benim... Şey... Midem çok kötü oldu da... Off...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: Sonra ne oldu? Evinde yani?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Off...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: Sonra ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: Hatırlamıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: Tüm gece yere yığılmış vaziyetteydim, sonra da...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Bir saniye, yoksa ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: Ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: Sence ben Ziyaretçi miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: Hayır... Bu gerçek olamaz! Yaşadığım her şeyi hatırlıyorum. Çocukluğumu, annemi, babamı... Hayır!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: Ben Ziyaretçi değilim, değil mi? Değil mi? Bana "Ziyaretçi değilsin," de!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: Bilmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: Ziyaretçi değilsin
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: Ziyaretçi gibisin
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: Yerde yatıyordum, sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Bir saniye, yoksa ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: Ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: Sence ben Ziyaretçi miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: Hayır... Bu gerçek olamaz! Yaşadığım her şeyi hatırlıyorum. Çocukluğumu, annemi, babamı... Hayır!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: Ben Ziyaretçi değilim, değil mi? Değil mi? Bana "Ziyaretçi değilsin," de!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: Bilmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: Ziyaretçi değilsin
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: Ziyaretçi gibisin
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: BUNU NASIL SÖYLEYEBİLİRSİN YA? Haha! Of, of, of, ooooffff!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: Benim... Biraz uzanmam lazım. Yine midem kötü oldu... Off...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Sağ ol, biraz da olsa içim rahatladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Off, biraz uzanmam lazım. Yine midem kötü oldu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: BUNU NASIL SÖYLEYEBİLİRSİN YA? Haha! Artık daha da korkuyorum!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: ÖLMEK İSTEMİYORUM! İSTEMİYORUM, İSTEMİYORUM, İSTEMİYORUM, İSTEMİYORUM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: Gerçi hepimiz öleceğiz zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: İyi misin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: YAKLAŞMA BANA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Pardon ya... Beni öldüreceksin sanmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: Niye öyle sandın ki?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: Seni öldürmek isteseydim şimdiye çoktan öldürürdüm
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: Ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: Kim Ziyaretçi, kim değil hiç bilmiyorum... Peki ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: Ya SEN Ziyaretçi''ysen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Sakin ol, ben Ziyaretçi değilim
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: Seni öldürmeyeceğim
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: Kusura bakma ya... Çok gerginim de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: Kime güveneceğimi bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: Peki ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: Peki ya sen Ziyaretçi''ysen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Sakin ol, ben Ziyaretçi değilim
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: Seni öldürmeyeceğim
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: SANA NASIL GÜVENEBİLİRİM Kİ? Dişine, gözüne bakmadım ki... Hahah!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: Hepimiz öleceğiz... Ya Ziyaretçiler bizi öldürecek ya da güneş...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: Yalnız kalmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: SANA NASIL GÜVENEBİLİRİM Kİ? Dişine, gözüne bakmadım ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: Hepimiz öleceğiz... Ya Ziyaretçiler bizi öldürecek ya da güneş...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: Yalnız kalmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: Kafayı mı yedin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: HA ZİYARETÇİ, HA İNSAN... NE FARK EDER?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: ÖLDÜKTEN SONRA NE FARK EDER?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: Sen kafayı mı yedin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: Bunu sen istedin
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: Bunu sen istedin
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: Hayır, hiçbir şey anlamıyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: Vur hadi! VURSANA! Neyi bekliyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: HİÇ VİCDAN AZABI ÇEKMEDEN BENİ ÖLDÜRECEK MİSİN?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: Umurumda değil ki! Hahaha! NE YAPACAKSAN YAP İNSAN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: Efendim? Bir şey mi istedin?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Seni neden bardan kovdular?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: Hım... Millete kafayı yedirten bu felaketleri suçluyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: Güneş patladı patlayacak, Ziyaretçiler evlerimize akın ediyor, ekonomi çöküyor falan filan.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: Hepimizin beyni eridi. Bazıları bu stresi kaldıramadı. Bazıları çözümü alkolde buldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: Ancak beni deli eden, öfkemdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: Tepem attı. Tezgâhın üzerine çıkıp "Zaten siz hariç herkes suçlu amına koyayım! Sizin hiç kabahatiniz yok!" diye bağırdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: Bırak hüngür hüngür ağlasınlar. Birama iki damla gözyaşı döküldü diye tadı bozulmaz. Hatta arpaya tuz yakışır.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: Kimse bunların değerini bilmiyor, bizim de uğraşmamıza gerek yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: Efendim? Bir şey mi istedin?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: Burası daha mı iyi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: Artık kimseyi rahatsız etmiyorum. Buna değmez zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: Gerçi bazen televizyondakileri duyuyorum, milletin konuşmalarına kulak misafiri oluyorum... ve yine tepem atıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: Sonra kendimi tutuyorum. Boşuna yorulacağım, karşılığını da almayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: Yok, benden geçti artık. Kendimi daha fazla yoramam hiç.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: Zaten tüm bunlar yaşanmadan önce de hayat bok gibiydi. Şimdi de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: Bir gün tüm dünya vaftiz edilecek, ben de kendimi tavandan asacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: Efendim? Bir şey mi istedin?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: Bir sıkıntı var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: Ne oldu? Niye sordun?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: Üzerinde bir koku var da
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: Ateşin mi var?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: Yani... Dolaptaki birandan biraz içtim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: Biraz kötü gibiydim, dedim soğuk bir bira iyi gelir. Gayet normal bir şey bence.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: İşler iyice sarpa sardı zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Herkes olan biteni anladığını iddia ediyor, bir çözüm getireceğini söylüyor ama hepsi kolpa. Bir bokun değişeceği yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: Yani bana sorarsan hepimiz yakında öleceğiz güzel kardeşim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: Güneş öldürmezse Ziyaretçiler öldürür. Ziyaretçileri de alt edersek birbirimizi mezara gömeriz kesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: Bir sorun çözüldü mü, onun yerine bir boşluk oluşur. Ne yapar ne eder, biz o boşluğu doldururuz yine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Niyeyse hepimiz bir dert çıkarmaya bağımlıyız anasını satayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Hay sikeyim ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Beni rahat bırak. Zaten iyi hissetmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: Ateşi olan ben değilim. Tüm gezegen hastalanmış anasını satayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Nereye baksan ya biri geberiyor, ya buzullar eriyor, ya ormanlar yanıyor. Dünya ölüm döşeğinde bildiğin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: Gezegen bizi virüs gibi öldürmeye çalışıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: Eninde sonunda bunu başaracak da. Acısız bir ölüm olacağını da hiç sanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: Off be...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Hadi siktir ol git buradan. Rica ediyorum bak. Zaten iyi değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: Efendim? Bir şey mi istedin?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: Daha iyi misin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: Bak güzel kardeşim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: Zaten hepimiz bir gün öleceğiz. Bu reddedilemez bir gerçek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: Sence öldükten sonra ne olacak bize?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: İnancımız bizi güzel bir yere götürecek
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: Hiçbir şey olmayacak
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: Bilmiyorum, herhâlde uzayda boş boş süzülürüz
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: Bu değerli bir düşünce...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: ...ama bana kendimi daha iyi hissettirmiyor. Neden, biliyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: Beynim, ben ölürken bu düşüncelere tutunacak. Gözümün önüne bir cennet getirecek. Buradan daha güzel bir yer gösterecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: Bu kırılgan hayale tutunacak takatim kalmadığında ne olacak peki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: Yok. Bu bana kendimi daha iyi hissettirmedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: Başka bir şey söyleyeceğini umuyordum açıkçası.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: Tabii, haklı olman muhtemel ama bu da kulağa çok iç karartıcı geliyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: Bütün bunlardan sonra yolun sonunun koca bir hiçliğe çıkması...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: Tüm konuşma isteğim gitti şu an.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: Aslında düşündüğün zaman...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: Evrende tamamen yalnız olmamız lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: Belli ki başka bir canlı yok. Bomboş, soğuk bir boşluk var...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: Başka bir canlı olsaydı şimdiye bir sinyal, bir işaret bulurduk herhâlde. Değil mi? Bilmiyorum ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: Sonsuz bir karanlık, boş bir hiçlik... Bu boşluğa düşmenin tamamen yok olmaktan bir farkı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: Ben... yalnız kalmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: Efendim? Bir şey mi istedin?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: Sen... iyi misin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: En azından barın tavanı yüksekti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: Kendimi tavandan çok rahat asabilirdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: Burası çok dar. Bütün bu gezegen benim için çok dar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: Tüm bunlar artık bitsin istiyorum güzel kardeşim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: İşler iyice boka sardı. Altıma sıçıyorum korkudan.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: Dayanamıyorum artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: Ne ettim de buraya geldim ki ben?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: Biraz dinlenebilsem keşke...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: Onun hayatta olmasına ihtiyacım vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: Bu kadar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: Başka bir ihtiyacım yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: Yok, ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: Bu lavabonun yanında otursam yeter.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: Gerekirse buradan içerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: Yok, değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: Tek istediğim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: Burada oturmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: Ölmeyiversen ne olurdu ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: Bana her şey iyi olacak, diye söz vermiştin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: "Her şey düzelecek" demiştin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: Sonra gittin öldün.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: Şimdi yalnız başıma kaldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: Neden bıraktın ki beni?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: Tek isteğim, onunla olmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: ...gömemiyorum bile...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: Biraz dinlenebilsem keşke...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: Hayır...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: Olmaz, olmaz, OLMAZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: Buna hazır değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: Onu daha yeni bana verdiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: Yine ayrılmamızı mı istiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: Olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: Onu şefkatsiz toprağa teslim edemem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: Hayır.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: Haksızsın, bu doğru değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: O beni hâlâ duyabiliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: Ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: Beni duyabildiğine inanmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: Biraz dinlenebilsem keşke...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: Biraz dinlenebilsem keşke...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: Biraz dinlenebilsem keşke...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: Vay be... Gerçekten de söyledikleri kadar varmış...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: Öyleyse anlattığım her şey mantıklıymış.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: Gündüz vakti dışarı çıkma. Bir de unutma, insanları evine alman gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: Tanımadığım insanları niye evimde ağırlayayım ki?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: İnsanları evime mi alayım?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: Biliyorum, mesafeni korumak istiyorsun ama başka seçeneğin yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: Kuzenimin dediğine göre neden yalnız başımıza kalamayacağımız belli değilmiş...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: ...ama söylediğine göre biri gelip "Yalnız mısın?" diye sorarsa "Hayır, evde başkaları var," demen gerekiyormuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: Milletle uğraşmaktan nefret ediyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: Niye insanları yanıma almam gerekiyormuş ki?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: Yani, seni de anlıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: Yanına birini almak için yanıp tutuşmuyorsun ama öyle ya da böyle alman lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: Kuzenimin dediğine göre neden yalnız başımıza kalamayacağımız belli değilmiş...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: ...ama söylediğine göre biri gelip "Yalnız mısın?" diye sorarsa "Hayır, evde başkaları var," demen gerekiyormuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: Milletle uğraşmaktan nefret ediyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: Niye insanları yanıma almam gerekiyormuş ki?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: Farkındayım. Senin için zor olacak ama başka seçeneğin yok. Başka türlü hayatta kalman imkânsız olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: Hem bilemezsin, belki işine yarayacak bir şey verirler veya bir bilgi paylaşırlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: Gelenler Ziyaretçi mi değil mi, kontrol etmen gerek. Gündüz vakti çok sıcak olduğu için çok enerjin olmaz muhtemelen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: Kimleri test edeceğini dikkatli seç. Epey yakından bakman lazım. Çok gayretli bir iş maalesef.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: İnsanlarla sohbet etmekten çekinme ama. Konuşmak enerji HARCAMAZ, istediğin kadar konuşabilirsin yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: Pencereden dışarı bakmayı da unutma. Televizyon, haberler falan iyi hoş da en iyi bilgi kaynağı, kendi gözlerin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: Ee, sonra?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: Ne yapmamız lazım?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: Evinde ağırladığın insanlar sana belki işine yarayacak bir şey verebilir veya bir bilgi paylaşabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: Gelenler Ziyaretçi mi değil mi, kontrol et yeter. Gündüz vakti çok sıcak olduğu için çok enerjin olmaz muhtemelen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: Kimleri test edeceğini dikkatli seç. Epey yakından bakman lazım. Çok gayretli bir iş maalesef.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: İnsanlarla sohbet etmekten çekinme ama. Konuşmak enerji HARCAMAZ, istediğin kadar konuşabilirsin yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: Pencereden dışarı bakmayı da unutma. Televizyon, haberler falan iyi hoş da en iyi bilgi kaynağı, kendi gözlerin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: Ee, sonra?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: Ne yapmamız lazım?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: Maalesef ki şu an elimizden gelen tek şey, hayatta kalmaya çalışmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: Bir de bu kâbusun yakında bitmesini ümit etmek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: Devlet bir şekilde bize yardımcı olur eminim. Belki insanları sığınağa falan götürürler.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: Öyle bir durum olursa ailemle birlikte yanımızda gelirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: Ha, unutmadan.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: Yarın gece eve döneceğim. Numaramı yazabilirsin. İstediğin zaman ara beni.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: Telefon hattını geçen gün taktırdık.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: Arayı açmayalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: Pekâlâ, benden bu kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: Ha bu arada, sana bir kasa bira getirdim. Kayınbiraderim birahanede çalışıyor da.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: Yatmadan bir tane içersin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: Epey bir uykunu getirir. İleride baktın o gün daha fazla sohbet edesin yok, bir bira dik ve rahatla.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: B-ben... Annemi i-istiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: Anlat bakalım, ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: Bilmiyorum kiiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: İçeri girip konuşmaya başladılar, babam haksız olduklarını söyledi. Onlar da dedi ki... Dediler ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: BABACIĞIM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: BABACIĞIIIM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: Peki... Sen şimdilik yat uyu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: Yarın yine konuşuruz, olur mu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (Küçük kız durmadan babasını istiyor. Belli ki sakinleşeceği yok.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (Kız seni duymuyor bile. Üzüntüsünden sağır olmuş âdeta.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: B-ben... Annemi i-istiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: Nasılsın? Burayı beğendin mi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: Yani... Burası kötü değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: Keşke evde olsaydım ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: Eve ne zaman döneceğim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: Sonra dönersin... Sizin evi yeniliyorlar şimdi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: Dönemeyeceksin. Sizin ev yandı
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: Peki... Beni almaya gelecekler mi yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: Sonra beni yeni eve mi götürecekler?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: Yoksa aynı eve mi götürecekler?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: Benim için yeni bir oda yapıyorlar mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: Babacığım yine de beni almaya gelecek, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: Ne olduğunu gördün, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: Sen şimdilik burada kal
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: Babam iyi ama, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: Peki benim odam? O da yandı mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: Annem gelmeyecek mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: Başka kimse kaldı mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: Ne olduğunu gördün, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: Sen şimdilik burada kal
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: Şey... Bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: Yani, emin değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: Babama vurdular, sonra ayağa kalktı. Orasını gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: Demek ki... Demek ki o, yangını söndürmüş olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: Beni almaya da gelebilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: Yakında gelecek mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: Babam olmadan hiçbir yere gitmem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: Beni almaya gelecek, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: Kalkıp gittiğini gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: Ben kaçıyordum ama onu da gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: B-ben... Annemi i-istiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: Olanları kabullenmen lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: Nası'' yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: Odanda bir televizyon gördüm. Çizgi film açabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: Ne gördün bilmiyorum ama sanırım senin baban öldü
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: Baban seni almaya gelmeyebilir. Ona ne oldu bilmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: Sen hiçbir şey görmedin!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: Ben oradaydım! Ben kaçarken o hareket ediyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: Beni almaya gelecek yani!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: Öyleyse niye gelmedi hâlâ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: Onu en son gördüğünde nasıl görünüyordu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: Gelmeyecek mi yani? Ama... Neden böyle dedin ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: Öyleyse niye gelmedi hâlâ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: Onu en son gördüğünde nasıl görünüyordu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: Şey... Belki bir işi çıkmıştır?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: Bence o kötü adamları dövmeye gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: Bence... Yakında burada olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: Baban için çok üzüldüm. İyi biriydi. Bu dünya için fazla iyi kalpliydi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: Tabii, tabii. Baban yoldadır şimdi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: İyiydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: Ona vurdular... O da...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: Hatırlamıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: Baban için çok üzüldüm. İyi biriydi. Bu dünya için fazla iyi kalpliydi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: Tabii, tabii. Baban yoldadır şimdi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (Kız sana bakıyor ama sanki seni görmüyor. Hareket etmeye korktuğun için durup bir şey olmasını bekliyorsun.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (Bir yalana inanmasına izin vermek daha kötü olurdu. Bir an önce gerçeği kabul etmesi gerek.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: Ben de öyle düşünmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (Kız uzaklara dalıyor. Belli ki başka bir şey düşünüyor.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (Peki hayatını mahvetmeye değer mi bu? Bu kadar ağır bir gerçeği kaldırabilir mi?)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (Zaten yeterince derdi olduğuna karar veriyorsun. Onu iyice üzmenin manası yok.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: Ay, aman... İyice bunadım ben de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: Sen nerelisin teyze?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: E, tabii evladım... Ne olmuş yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: Bu gençler de bana soru sorup duruyor, sonra cevap verince bana kızıyorlar. Peh!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: Bunun nasıl bir şey olduğunu anlayabiliyor musun, hı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: Bir evim var benim. Minik bir kulübem var.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: O evi çok severim. Severim de, kimse ziyaretime gelmezse çok üzülürüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: Küçük, eskimiş bir kulübeyi de kimse ziyarete gelmiyor işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: Ben de bu yüzden geziniyorum evladım. Kaybedecek bir şeyim yok sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: Ben şehirde doğup büyüdüm evladım. Gökdelende kulübem vardı benim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: Öyle köy evim yoktu. İhtiyar bir kocam, torunum falan da yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: Ben de banka otururdum işte. Biraz da olsa yaşam dolu olurdu oralar. Neler duyardım neler...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: Sonra bu safsatalar başlayınca orası hoşuma gitmemeye başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: Peh! Millet patır patır ölüyor, yaşam maşam kalmamış artık!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: Merdivenleri bir tırmanıyorum, zavallının teki orada yatıyor. Üstü beyaz bir örtüyle kaplı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: Of of... İnsanın buralardan kaçıp gidesi geliyor. Bu acı çekenleri izleyeceğine...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: ...Ben de kaçıp gittim işte! Şöyle konuşacak insanların olduğu, canlı bir yer aradım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: Kader de beni buraya attı güzel evladım!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: Ben pek dindar değilimdir ama... sanki beni buraya Tanrı göndermiş gibi hissetmeden edemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: Ay, aman... İyice bunadım ben de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: Hiç akraban yok mu teyze?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: Var tabii, herkesinki gibi sıradan. Yıllar içinde tanıdıklarımın hikâyelerini anlatıp dururum işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: Beni dinleyen herkese anlatırım...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: ...ama artık yaşlandım küçüğüm. Hafızam pek iyi değil. Bazen... bazı ayrıntıları karıştırıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: Zaten bu yüzden kimse beni sevmiyor artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: Bak, teyzenin lafını iyi dinle evladım... Alın dediğin kabir azabından çatlar, korkunç hülyaların kafesine bizi mahpus eder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: Tabii, görülenden daha korkunç şeyler düşleyen yalnız ben değilim. Öyle değil mi? Hehehehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: Öyle ya da böyle, herkes bana gelir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: Herkes bir hikâye dinlemek ister.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: Herkes beni unuttu gitti evladım...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: Yaşayan kaldıysa da zavallı ninelerini görmeye gelmiyorlar işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: Günümüz gençliği böyle artık. İşlerine güçlerine çok odaklanıyorlar, büyüklerini unutuyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: Hepsinin bir derdi var ama arayıp hâl hatır soran yok. Peh!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: Bir keresinde o bankta oturuyordum, komşum torununu nasıl anlatıyordu nasıl...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: "Benim oğlan ne iyidir! Ninesini hiç unutmaz, hiç!"'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: Yalan da söylemiyordu evladım! Bana da hep selam verirdi. Çok kibar bir delikanlıydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: Kıskanmadım desem yalan söylemiş olurum...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: ...Sonra komşumu kaybettik.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: O pek kibar oğlan da iyice bozdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: Tek istediği o zavallı ninesinin eviymiş. Bu yüzden ona iyi davranıyormuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: Sence insanlar neden birbirinin yüzüne yalan söylüyor? Sevdiklerimizin bile gözlerinden yalan akıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: Yok evlen, yok çocuk yap... Sonra ne oluyor? Seni hiç umursamıyorlar bile!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: Neyse ki kocam öldü de gömdük onu. Huysuz adamın tekiydi, peh!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: Ay, aman... İyice bunadım ben de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: Kocana ne oldu teyze?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: Sana ne anlatayım istersin evladım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: İnsan dediğin ürkektir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: Bir zamanlar dünyayla bağını koparan bir adam vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: Gökdelende yaşardı bir de... Evinden hiç çıkmazdı neredeyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: Ziyaretçilerden korkuyordu herhâlde. Belki de bizzat ölümden korkuyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: Kimse onu ziyaret etmezdi. Zaten geleni de içeri almazdı...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: Sonra bir gün...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: Garip bir ses duydum. Rahatsız edici, reçel kavanozuna düşen cam kırığı gibi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: "Aman," dedim, "O neydi kız!"'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: Pencereden dışarı baktım. O yükseklerde oturan adamı ilk defa aşağılarda gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: Meğerse camdan atlamış.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: Bu hikâyeyi beğendin mi evladım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: Hiç beğenmedim teyze
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: Bitti mi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: Peh! İşte bu yüzden kimse beni sevmiyor herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: Bir gün seni de başkasına böyle, hatırladığım gibi anlatacağım. Bu da kulağına küpe olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: Evet evladım. Adam düştü, reçel oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: Herhâlde güneşin öfkesinden, getireceği acıdan korktu. Bilemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: Ben mi? Peh! Yalnız kalmayı kaldıramamıştır, bana sorarsan.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: İşte... Yapacak bir şey yok, değil mi evladım?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: Adam öleli epey oldu evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: Hayatımı mahvetti gitti, pis herif!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: Anamlar başımın etini yemeyeydi hiç evlenmezdim zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: "Sen evlen onunla güzelim, iyi biridir," dediler bana. Evleniverdim ben de.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: Başta iyi biriydi gerçekten! Çok iyiydi hem de! Tabii, gerçek yüzünü göstermesi uzun sürmedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: Herife saatlerce yemek hazırlardım... Karşılığında da ne mi derdi? "Sus be karı, yemek yiyo''z şurada!"'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: Sonra evden giderdi, saatlerce dönmezdi. Köpek gibi içerdi! Peh!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: Eve sarhoş sarhoş gelirdi, garajda domino oynadım diye bir şeyler anlatırdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: Tabii, ne demek istediğini sorduğum gibi hemen sinirlenip giderdi. Sefil herif...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: ...Sonra öldü işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: İlk başta ne kadar rahatlamıştım, anlatamam evladım! Ama sonra, içime bir boşluk düştü.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: Bu televizyon dedikleri biraz iyi gelmişti ama sonra o da zırvalamaya başladı!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: Ben de o dediğim bankta oturmaya başladım işte. İnsanları seyrettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: Ay, aman... İyice bunadım ben de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: O bankta oturmayı seviyor muydun teyze?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: Pekâlâ evladım... Sana bir hikâye anlatayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: Eskiden bizim köyde bir adam vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: Ormanda uzun uzun yürümeyi severdi. Nedenini kimse bilmezdi ama o yürüyüp dururdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: Bir gün ormanda yürürken kaybolduğunu fark etti. Geri dönüş yolunu bulamadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: Bir anlığına duraksayıp kendini toparladı ve yürümeye devam etmeye karar verdi. Eninde sonunda bir yere ulaşacaktı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: Yürüdü de yürüdü... ama ne kadar yürürse yürüsün, ormandan bir türlü çıkamadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: O an fark etti ki aslında aynı yerde dönüp duruyormuş!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: Ee, sonra?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: Ne saçma bir hikâye bu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: ...Sonra ölüsünü buldular.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: Ormandan hiç çıkamadı. İzlerini bulduk, ölene kadar olduğu yerde dönüp durmuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: Ne derler bilirsin evladım, bir ayak daha uzun adım atar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: Şimdi orada çürüyor işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: Peh! Beğenmedin mi hikâyemi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: Yani, bazı yerlerini biraz abartmış olabilirim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: ...ama gerçekten oldu bu. Hepimizin başına gelebilir!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: İnsanlar her gün yürüyüşe çıkıp kayboluyorlar. Nasıl dönecekler evlerine?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: Of evladım...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: İyi geliyordu, öyle etrafı seyrediyordum. Kahkaha atan çocuklar, çifte kumrular, pıtı pıtı yürüyen köpekler...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: Sonra bu olaylar patlak verdi işte. Peh!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: Millet tek tek evlerine kapandı. Bankta oturan ninenin seyredeceği bir yaşam kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: Pencereden de bir hayır gelmiyordu zaten...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: Ne bir kahkaha, ne bir neşeli selam... Anca vahşi itler ve birbirine yabancı gibi bakan komşular vardı dışarıda.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: Hayat bildiğin durmuştu evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: Şimdi de... Peh! Kim yalan söylüyor, kim doğru söylüyor belli değil!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: Keşke insanlar yalan söylemeyi bıraksa evladım...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: Gücümü toplamam gerek. Keşke bir yardım eden olsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: Kardeşin nasıl?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: Benim yardımıma muhtaç. Birçok konuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: Geçen gün onu küvette yıkayabildim. Evdeyken küvete bile sokamıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: Daha bir değişiklik yok ama sorduğun için sağ ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: Bunalım bazı şeyleri... çok zorlaştırıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: Bir şey olur da kaçmamız gerekirse... ayağa bile kalkamayacak diye korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: Belki yemekleri çiğneyip yutacak hâli bile kalmayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: Ben de yorulmuşum. Biraz dinleneyim bari...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: Gücümü toplamam gerek. Keşke bir yardım eden olsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: Gücümü toplamam gerek. Keşke bir yardım eden olsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: Gücümü toplamam gerek. Keşke bir yardım eden olsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: Gücümü toplamam gerek. Keşke bir yardım eden olsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: Konuşmak istediğin bir şey mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: O kâğıtlar ne öyle?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: Bu belgelerde yazanlara hayatta inanmazsın. Cidden bak, çok ilginç şeyler var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: Şuna bak mesela. Çok enteresan bir teori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: Ziyaretçilerin aslında gerçek olmadığını, hükûmetin gizlice nüfusu azaltmaya çalıştığını öne sürüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: Gerçekten ilginç! Aslında düşündüğün zaman mantıksız da değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: Yani şöyle düşün, aşırı nüfus gerçek bir sorun. Günümüz toplumunda görüyoruz bunu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: Diyelim ki hükûmet bu sorunu böyle "halletmeye" karar verdi. Olamaz mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: Konuşmak istediğin bir şey mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: Hâlâ o kâğıtları mı inceliyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: Aynen öyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: Senin de ilgini çektiyse elimde bir sürü belge var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: Şuna bak mesela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: Asıl Ziyaretçilerin FEMA olduğunu iddia ediyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: Giydikleri kıyafetler onları tepeden tırnağa örttüğü için test edemiyoruz da. Mantıksız değil bence!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: Çok ilginç... Özellikle FEMA''nın asıl açılımını söylediği kısım: Fazlalığı Etkisizleştirme ve Mahvetme Ajansı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: Yoksa başka bir şey mi yazıyordu ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: Konuşmak istediğin bir şey mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: Ee, neler öğrendin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: Ziyaretçi, Deri Değiştiren...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: Bilim kurgu romanından fırlamış gibi değil mi hepsi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: Olay da bu zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: Dinle bak. Bir raporda sokaklarda gezen soluk tenli bir adamdan bahsediyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: Ancak şunu belirtmem gerekiyor ki... yazar bariz bir hata yapmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: Dışarıda İKİ tane soluk ve korkunç tipin gezdiğini söylüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: Birisi pencereden görünüyormuş, diğeri de kapının önünde duruyormuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: Yok artık! İkisinin aynı varlık olduğu bariz değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: 'Theorist: Sanırım pencereden bakınca yazarın aklı karışmış. Yani bir algı hatası.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: Yine de çok ilginç, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: Konuşmak istediğin bir şey mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: Ya dediği doğruysa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: "Doğru" dediğin nedir ki? Doğru dediğin değişkendir, bakış açısına bağlıdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: Birine doğru gelen, başkasına zırvalık gibi görünebilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: Birinin iyi dediğini başkası haklı olarak kötü görebilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: İnsanoğlu, ezelden beridir iyiyi ve kötüyü tartışıyor. Şu günlerde ahlak ve erdem anlayışımız iyice şaştı zaten!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: Benim gibi sen de inançlarına bağlıysan hepsi doğru gelmeye başlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: Hım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: Enteresan bir makale... Ne diyorduk biz? Ha, doğru. Doğrulardan bahsediyorduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: Söylediklerimden tek bir ders çıkaracaksan o da şu olsun: Ziyaretçiler... aslında beyin paraziti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: Kulak tıkacı takman lazım. ASLA ÇIKARMA! Sakın onlara fırsat verme!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: Neyse, okumam gereken belgeler var... Beni biraz rahat bırakır mısın? Odaklanmam gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: Ay, of... Umarım adam öldürmeyi öğrenebilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: Hâlâ bir Ziyaretçi'yi öldürdüğümü görmek istiyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: Şey ya... Yok. Fikrimi değiştirdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: Korktum yani. Off, biliyorum... Kusura bakma! Daha henüz... hazır olmadığımı fark ettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: Ceset görünce hâlâ içim bir garip oluyor. Buna... alışmam biraz sürer herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: Ama bu Ziyaretçiler var ya... Cesetleri hareket etmeye devam ediyormuş. Öldükten sonra yani. Mesela ara sokakta biri vardı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: Ayyy, düşününce bile içim bir tuhaf oldu. Hâlâ hazır değilim ya. Kusura bakma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: Ay, of... Umarım adam öldürmeyi öğrenebilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: O ara sokakta ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: Ay, of... Anlatması zor ama... deneyeyim bari.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: Ya aslında ben ara sokaklar daha güvenli olur sanmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: Köşeyi bir döndüm, ortalık mezar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: Sağım solum, her yer ceset. Hepsi ölmüş yani!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: Bazıları hâlâ hareket ediyordu! Hani... daha tam ölmemiş gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: Sokağın sonunda da bir adam vardı. Elinde silah vardı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: Neyse ya, yeter. Hatırlamak istemiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: Ay, of... Umarım adam öldürmeyi öğrenebilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: Bana o sokaktaki adamı anlat
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: Adam...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: Üzerinde uzunca bir mont vardı. Her yeri parmak ve dişle kaplıydı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: Yanında da çok çaresiz duran bir çocuk vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: Montlu adam silahını çocuğa doğrultmuş bağırıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: "Dişlerini göster bana!" diye bağırdı durdu. Çocuk da merhamet etsin diye yalvardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: Ben o sırada çöp kutusunun arkasında saklanıyordum... Kendimi çocuğun yerine koydum da, of ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: Çocuk hüngür hüngür ağlıyordu. Onu öldürmemesi için yalvarıyordu falan...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: Sonra BAM diye bir ses geldi! Çocuk, diğer cesetlerin yanına yere yığıldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: İşte orada anladım. Bu dünyada iki tür insan var artık: Av ve avcı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: Ay, of... Umarım adam öldürmeyi öğrenebilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: Hayatta kalmak için kana susamış bir katile dönüşmek zorunda değilsin
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: Sen deli misin ya? Zorundayım tabii!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: Sen bir yırtıcı gibi diş gösterdiğin için hâlâ ayaktasın! Bu yüzden kimse sana dokunmuyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: İnsanlar senden korktuğu sürece güvendesin yani!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: Ben av olmak istemiyorum. Korkak gibi ağlaya ağlaya ölmek istemiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: Bu yüzden adam öldürmeyi öğrenmem gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: Göklerdeki Babamız...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: Ee, evi beğendin mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: Burası rezil bir yer evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: Duvarları yamuk, odalar bir garip.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: Söyle bakalım, beni bilerek mi en dar, en kötü odana yerleştirdin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: Mobilyalar eski püskü... Burada benimle birlikte kalan güvelerin yemi olmuş hepsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: Şöyle duvara bir haç asayım da oda bir şeye benzesin, diye hiç geçirmedin mi aklından?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: Tanrım, beni neden böyle imtihana sokuyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: Göklerdeki Babamız...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: Madem buradan nefret ediyorsun gitsene
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: Buraya gelmeyi ben mi istedim sence? Manastır ayakta olsaydı o kutsal kapısından asla dışarı çıkmazdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: Bu moloz yığının arasında kalmazdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: Bir seçeneğim olsaydı buraya adım bile atmazdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: Burası ölüm kokuyor, ölüm. Tanrı bilir, sen bu pis kokudan hoşlanıyorsundur!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: İblis sandığın herkesi katletmeyi biliyorsun, tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: Belki sen de iblissin, ne biliyorsun? Yakında boynuzun bile çıkar belki!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: Ne olursa olsun, ben bu zorlukları aşacağım. Göklerdeki Babamız, daima evlatlarını korur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: Göklerdeki Babamız...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: Manastırında niye kalmadın ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: Öncelikle orası "benim manastırım" falan değil. Yüce Tanrı''nın evi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: Bu pis günahkârlar yüzünden orayı terk etmek zorunda kaldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: Tanrı''nın kutsal topraklarını lekelediler. Göklerdeki Babamız''ın Cenneti''nin ateşleri, günahlarını yakıp temizlesin!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: Kapımızı kararttılar, kardeşlerimizi sürdüler, beni de onlarla birlikte kovdular.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: İstedikleri her şeyi aldılar. Sanki hak ediyorlarmış gibi. Hepsi barbar bunların, hepsi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: Bizim düzenli, iman dolu bir hayatımız vardı. İbadetimiz, orucumuz yerindeydi. Ama bu yaratıklar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: Şimdi kutsal suyu, köpek öldüren gibi kafaya dikiyorlardır! Tövbe tövbe...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: Boğazlarında kalsın da boğulsunlar. Amin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: Göklerdeki Babamız...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: Bu "günahkârlar" ne istiyordu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: Pis bir kalabalık, yaygara çıkara çıkara manastıra geldi. Bağıra bağıra küfrediyorlardı imansızlar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: Niye mi? İçeri girmelerine izin vermedim diye! Ben onlara gerçeği söyledim: Vaftiz edilmemişler, Tanrı''nın evine giremez!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: Nasıl öfkelendiler, görecektin. Tabii... Kapılara vurup durdular, manastırı başıma yıkmakla tehdit ettiler!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: Nihayet içeri girdiklerinde de beni kovdular.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: Yardıma muhtaç insanları geri mi çevirdin yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: Ben de seni kovabilirdim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: Tanrı''nın nurunu küçümseyenleri kutsal topraklarda sığındıracak hâlimiz yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: İster güneşten kaçsınlar ister o sözde Ziyaretçilerden, fark etmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: Göklerden ateş yağsa bile bu pislikler Tanrı''nın evinde sığınamaz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: Tanrı, yalnızca inananlara merhamet eder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: Kendilerini sokakta buldularsa da Tanrı onların yanmasını buyurmuştur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: İğrenç bir insansın ama seni yargılayacak hâlim yok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: Derhâl git buradan, yoksa seni bizzat cehenneme gönderirim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: Seni terbiyesiz, sefil herif!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: Kafayı mı yedin sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: Ben Tanrı''nın bir kuluyum! İmansız köpekler beni Tanrı''nın evinden kovdu. Şimdi gelmişsin, burada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: Sen ne cüretle benimle alay edersin? Ne cüretle bunu hak ettiğimi söylersin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: Sen insan falan değilsin. Yılansın sen, yılan!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: KÂFİRSİN SEN! SEN DE ONLAR GİBİ KÂFİRSİN!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: Beni anlayacağını ummuştum ama diğerlerinden hiçbir farkın yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: Bizler yalnızca kuluz! TANRI''NIN KULUYUZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: Elimizden gelen tek şey, O''nun buyruklarına boyun eğmek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: Tanrı''nın işine akıl sır ermez! Bizi ne bekliyor, asla bilemeyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: İğrenç bir insansın ama seni yargılayacak hâlim yok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: Derhâl git buradan, yoksa seni bizzat cehenneme gönderirim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: Ne oldu, şimdi mesih sen mi oldun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: Senin pis evine kalmadık. Bu ahırda bir saniye daha geçirmek istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: Yolun açık olsun evlat. Tanrı''nın gazabı seni bulsun, amin!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: Zaten burada kalmak istemiyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: Bunu içeri girdiğim an hissetmiştim. Bu evde bir parça bile iman yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: Belki de Tanrı şu anda benimle konuşuyor, buradan gitmemi istiyordur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: Yolun açık olsun evlat. Tanrı''nın gazabı seni bulsun, amin!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: Of yaram, of...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: FEMA niye senin peşine düştü ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: Emin değilim ama bir tahminim var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: Rutin kontrol yapıyorlar diye düşünmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: Kesin o kahpe komşum beni satmıştır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: Birbirimizi hiç sevmezdik zaten. Fırsatı bulunca hemen ötmüştür tabii. Benim de "Ziyaretçi" olduğumu iddia etmiştir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: Nasıl da keyfi yerindedir şimdi orospunun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: Of yaram, of...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: Nasıl hissediyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: Fena değilim ya. Daha iyiyim şimdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: Dedim ya, mermi direkt içimden geçti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: Millet niye böyle birbirini öldürmeye çalışıyor, anlamıyorum. Eli tetikte gezen tek manyak da bana denk geldi işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: Belli ki birbirimizi yaşatmayacağız. Herkes başkasını toprağa gömme derdinde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: Bana çok saçma geliyor. Bence herkesin hayatına kimse karışamaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: O silahlı manyağı görecektin, var ya. Piç kurusu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: Ne manyağı? FEMA'dan birinin seni vurduğunu söylememiş miydin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: Hangi manyaktan bahsediyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: Tamam işte ya... O FEMA itlerinden biri vurdu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: Bana yalan söyleme
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: Yeter. Yalan söylemeyi hiç beceremiyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: Yani, şey... O FEMA itini diyorum işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: Çok korkunç duruyordu... Yüz yüze geldiğimizde yani..'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: Daha doğrusu, şey... Beni sırtımdan vurduğunda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: Bana yalan söyleme
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: Yeter. Yalan söylemeyi hiç beceremiyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: Tamam, tamam...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: Karantina bölgesinden kaçtım derken yalan söylememiştim ama... beni oradakiler vurmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: Bir doktor bana yardım etti. Sahte evrak hazırlayıp beni oradan kurtardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: Ama eve dönecek hâlim yoktu. O komşum denen orospu beni hemen satardı yine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: Ben de saklanabileceğim bir yer aramaya başladım. Sonra o manyakla karşılaştık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: O gece kalabileceğim bir yer olup olmadığını soracaktım ama sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: Sırtındaki pompalıyı gördüm. Boynunda da dişlerden ve parmaklardan bir kolye vardı, arkasındaki sokak cesetle doluydu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: İşte orada adamın deli olduğunu anladım. Of...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: Mermi yaram yine ağrımaya başladı da... Biraz uzansam sorun olur mu sana?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: Hay...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: Bak, her şeyi anlatacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: Karantina bölgesinden kaçtım derken yalan söylememiştim ama... beni oradakiler vurmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: Bir doktor bana yardım etti. Sahte evrak hazırlayıp beni oradan kurtardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: Ama eve dönecek hâlim yoktu. O komşum denen orospu beni hemen satardı yine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: Ben de saklanabileceğim bir yer aramaya başladım. Sonra o manyakla karşılaştık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: O gece kalabileceğim bir yer olup olmadığını soracaktım ama sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: Sırtındaki tüfeği gördüm. Boynunda da dişlerden ve parmaklardan bir kolye vardı, arkasındaki sokak cesetle doluydu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: İşte orada adamın deli olduğunu anladım. Of...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: Yaram yine ağrımaya başladı da... Uzansam sorun olur mu sana?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: Of yaram, of...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: O silahlı manyağı anlat bana
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: Üstü başı diş ve parmakla kaplı olan o sapığı mı diyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: Şüphe duyduğumu anlayınca hemen silahını çekti ama ucundan tuttum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: Bir iki dakika güreştik, silahını almaya çalıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: Sonra ateş etti. Ben de ona sağlam bir kafa attım. Herif yere serildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: Tabanları yağlayıp kaçtım. Koşabildiğim kadar koştum. Sonra karnımdaki o acı başladı. Of...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: Aşağı bir baktım, üstüm başım kan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: Beni onun vurduğunu söylemek istemedim. Belki beni içeri almazsın diye.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: Artık herkes tek başına sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: Dürüst ol bak. Peşimde silahlı bir manyağın olduğunu bilseydin beni içeri alır mıydın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: Başımı sokacak bir yer arıyordum. O ara sokaktaki zavallılar gibi gebermek istemedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: Yani evet, yalan söyledim. Umarım beni suçlamazsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: İyi bari, kal burada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: Sana hayatta güvenemem artık. Git buradan
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: Sağ olasın. Çok makbule geçti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: Neyse ki silahın da var. Yine de dua edelim, o manyak buraya uğramasın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: Belki başkası onun icabına bakmıştır. Hatta o soluk Ziyaretçi bile onu öldürmüş olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: Demek ki haklıymışım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: Niye yalan söylediğimi anladın mı şimdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: Yolun açık olsun şerefsiz herif!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: Off, nereye gittiler ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: Nasılsın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: Bilmiyorum... Annemle babam dönsün istiyorum sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: Bugüne kadar bana hep onlar baktı... Şu an neredeler hiçbir fikrim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: Umarım iyilerdir. Onlar olmadan ne yaparım bilmiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: Off, nereye gittiler ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: Başka akraban yok mu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: Pek yok. Gerçi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: Geçenlerde bir ablam olduğunu öğrendim. Babamın ilk karısından ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: Doğru ya, anneannem vardı!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: Galiba annemle babamın nereye gittiğini çözdüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: Ya anneannem Ziyaretçi olup onları öldürdüyse? Ya FEMA onları alıp götürdüyse?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: Niye ya? Niye yanımda durmadılar ki? Niye beni de götürmediler ki? NEDEN?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: YALNIZ BAŞIMA ÖLÜRÜM BEN! NİYE BENİ BIRAKIP GİTTİLER?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: Off, nereye gittiler ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: Sakinleştiysen bana o ablanı bir anlat
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: Yani şöyle...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: Annemler gitmeden önce bize bir zarf geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: Babam gelip verdi bana, hiç posta kutusuna bakmıyorum diye. "Oku," dedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: Altında "Ablandan." yazıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: Benimle buluşmak istediğini söylemişti ama... ne diyeceğimi bilemedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: Başta eşek şakası falan sandım ama babam verdiği için inanmak zorunda kaldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: Bana aslında ilk çocuğu olmadığımı söyledi. Bunca zamandır bir ablam olduğunu anlattı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: Annemiz farklı tabii. Babamız aynı sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: Bilemiyorum... Bir garip hissettim. Ne yapacağımı bilemedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: Yani sözde "öz kardeşim" ama bana tamamen yabancı gibi geliyor. Çok garip...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: Sanırım onunla buluşmak istiyorum ama çok korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: Onu benim yerime sen arar mısın? Numarası {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: Ona... benim yaşadığımı söyle. Ne yapacağımı bilmediğimi söyle...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: Off, nereye gittiler ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: Niye kardeşinle görüşmek istemiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: Onu tanımıyorum ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: Beni bırakıp gittiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: Sana yemin ediyorum, annemle babamı tekrar görmek için her şeyi yaparım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: Niye ya, niye?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: Git ablanla görüş. Seni geri çevirmez
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: Annenle babanın öldüğüne emin misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: Cidden mi? Emin misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: Ama ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: Annemler olmadan hiç uzaklara gitmedim ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: Ablamın evi buraya epey uzak da. Yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: Korkuyorum. Elime yüzüme bulaştırırım kesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: Taksiyle git o zaman. Hâlâ iş yapıyorlar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: Öyle boş boş duramazsın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: Yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: Madem benim için geri dönmediler...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: Bilemedim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: Anneanneni bulmaya çalış
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: Karantina bölgelerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: Yani, aslında... Kötü bir fikir değil gibi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: Duyduğuma göre taksiler artık çok pahalıymış ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: ...annemlerin zulasını yanıma almıştım. Belki ablamın evine gitmeme yetecek kadar para vardır?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: Haklı olabilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: Çok uzun süredir annemlere bel bağlıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: Akıl verdiğin iyi oldu. Teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: Bir taksi bulmaya çalışayım. Annemlerin zulasını yanıma almıştım, yeterince para vardır herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: Aynen aynen, öyle olmuştur muhtemelen. Babam zaten "Sanayiye götürmem lazım," deyip duruyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: Anneannem de telefon almayı reddediyor zaten. Belki o yüzden bana ulaşamamışlardır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: Gerçekten orada olabilirler ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: Akıl verdiğin iyi oldu. Teşekkür ederim. Ben kalkayım artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: Yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: Belki de gerçekten oradalardır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: Denemekten zarar gelmez herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: Akıl verdiğin iyi oldu. Teşekkür ederim. Ben kalkayım artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: N''aber kanka? Aklını kurcalayan ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: Nasılsın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: Gayet iyiyim kanka!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: Senin buzdolabına bir uğradım bu arada. O KADAR biran olduğunu bilseydim, ohoo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: Nereden buldun ki bunları? Amcan birahanede falan mı çalışıyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: Aman neyse, söyleme. Sende kalsın!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: Şu işe bak be. Başka bir evrende seninle iki soğuk bira açıp maç izliyor olabilirdik. Hatta belki şeyle tanıştırırdım seni...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: İyi misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: Ne oldu, dilini kedi mi yedi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: Ha? Ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: Unut gitsin. Sıkıntı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: Sadece şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: Hım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: Uzaklara dalmışım işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: N''aber kanka? Aklını kurcalayan ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: Bugün üzgün gibisin
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: O...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: O konuyu açasım yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: Hangi konuyu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: Anlamadım?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: Önemli değil. Anlatsam da anlamazsın zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: Bilmem gerekiyor gibi hissediyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: Peki o zaman, üstüne gitmeyeceğim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: Bak, cidden bu konuyu açmak istemiyorum. Tamam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: Bilmem gerekiyor gibi hissediyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: Peki o zaman, üstüne gitmeyeceğim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: Üstüme gelme diyorum bak! Zaten kendimi zor tutuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: Sen... beni rahat bırak, yeter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: Sağ olasın kanka. Pek iyi hissetmiyorum da, ondan yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: N''aber kanka? Aklını kurcalayan ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: Derdin ne senin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: Seni hiç alakadar etmez kanka. Geri bas!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: Ya söyle gitsin işte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: Yerinde olsam konuşmaya başlardım. Yoksa kötü olur
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: Söylemem... Bana bir daha güvenmezsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: Gerçi içimde tutmak da bir işe yaramıyor belli ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: Eskiden bir köpeğim vardı. Birkaç gün önce... Birkaç gün önce öldü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: Ee, n'olmuş?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: Ee?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: N''oldu kanka, icabıma mı bakacaksın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: İyi o zaman. Gerçeği mi duymak istiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: Eskiden bir köpeğim vardı. Birkaç gün önce... Birkaç gün önce öldü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: Ee, n'olmuş?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: Ee?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: O kadar basit değil işte. Yaşlıydı, hastaydı ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: O kadar da...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: Onu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: Onu ben öldürdüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: Ne yaptın, ne?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: Hastasın sen!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: Onu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: Onu ben öldürdüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: Ne yaptın, ne?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: Hastasın sen!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: Kulağa hiç hoş gelmiyor, farkındayım ama bırak anlatayım. Köpeğim... acı çekiyordu. Onu bu hâlde görmeye dayanamıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: Her geçen gün gözlerindeki o acıyı görebiliyordum. Geceleri sızlanıyordu, bacaklarının ağrısından ağlıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: HEPSİ O SİKTİĞİMİN TAKSİSİ YÜZÜNDEN! Şoför magandalık yapmasaydı köpeğim hâlâ yaşıyor olabilirdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: Ümüğünü sıkmak için nelerimi vermezdim ama herif kaçtı işte. Plakasını bile alamadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: Evcil hayvanını kaybetmek nasıl bir şey, bilemezsin. Yanımızda uzun süre kalmasalar da çok şey öğretiyorlar bize.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: Ne derler bilirsin. Onlar bizim için kitabın sadece bir bölümü ama onlar için biz kitabın ta kendisiyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: Peki o zaman, burada kalabilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: Evet, farkındayım... Şerefsizin tekiyim. Kendimi affedemiyorum asla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: Çok acı çekiyordu... Artık onu bu hâlde görmeye dayanamıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: Her geçen gün daha da kötü hâle geliyordu. Özellikle geceleri çok zordu. Sızlanıp duruyordu, ağlıyordu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: Sen hiç ağlayan köpek gördün mü? Bana "Acımı dindir," diye yalvarıyordu âdeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: Bunu isteyerek yapmadım! Sana yemin ederim! Elim gitmedi bile...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: O TAKSİCİYİ VAR YA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: Şerefsiz herif, güzel kızımı ezdi geçti. Hiç arkasına bile bakmadan sürdü gitti bir de!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: Sanırsın tümsekten geçti şerefsiz. Yaşayan bir canlıyı ezmemiş gibi gitti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: Hay... Ümüğünü sıkmak için nelerimi vermezdim ama herif kaçtı işte. Plakasını bile alamadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: Evcil hayvanını kaybetmek nasıl bir şey, bilemezsin. Yanımızda uzun süre kalmasalar da çok şey öğretiyorlar bize.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: Ne derler bilirsin. Onlar bizim için kitabın sadece bir bölümü ama onlar için biz kitabın ta kendisiyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: Peki o zaman, burada kalabilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: Sağ olasın kanka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: Anlayış göstermene sevindim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: Haklısın kanka. En iyisi bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: Her gün aklıma geliyor... Acısını dindirerek doğru şeyi mi yaptım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: Sanırım asla öğrenemeyeceğim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: Ohh... Soğuk su iyi geldi. Buz gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: Daha iyi misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: Tabii, tabii, tabii. Çok daha iyiyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: Gerçi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: Ağzım hafiften kurumaya başladı da, öhöm... Şöyle boğazımı ıslatacak bir şey var mı evde?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: İyi, al (Bir kutu bira ver)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: Bira yok mu? Bak sen...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: Buzdolabın bira dolup taşıyordu, kendim gördüm! Hepsini kendin mi içtin yoksa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: Hayır
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: İşte bu ya! Soğuk soğuk, iyi gider!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: Aaaahhh... En sevdiğim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: Al bakalım, kendine güzel bir şey alırsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (Eline nakit para uzatıyor ama bu sıralar para pek bir işe yaramıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: Yani... Sağ ol
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: N'apayım ben senin paranı?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: Ha şöyle ya! Heh!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: Al gülüm, ver gülüm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: Merak etme sen, benim ceplerim dolu... Tabii, sadece dostlarım için.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: Ha, şunu da verecektim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (Bir kavanoz kombuça veriyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: Medeni bir insan bunu ağzına bile sürmez ama, öhöm... Senin gibi birinin işine yarar belki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: Cık cık! Çok kabasın! Sistemi aşağılamak ne demek ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: Herkesin paraya ihtiyacı var! Dünya parayla dönüyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: İyi bari, bunu al o zaman!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (Bir kavanoz kombuça veriyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: Medeni bir insan bunu ağzına bile sürmez ama, öhöm... Senin gibi birinin işine yarar belki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: Ne demek hayır? Peh! Parayla satın alınamayacağını mı sanıyorsun? Herkesin bir ücreti vardır! Aşk, emtia, insanlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: Dünya parayla döner delikanlı! Ben de bakanım zaten, anlatabildim mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: İyi o zaman! Öyle olsun! Pişman olacaksın bak, demedi deme!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: Ohh... Soğuk su iyi geldi. Buz gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: Şimdi ne istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: Ho ho, iyi ki sordun! Bir dal sigara iyi gelirdi. Bana oradan bir sigara uzat bakayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: ...İyi, peki (Sigara ver)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: Ne yani, sigaran yok mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: İyi, peki! Acı çekmemi mi istiyorsun yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: Yoo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: Ha şöyle ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: Ben normalde puro içerdim tabii ama... şu saatten sonra zor bulursun onu. Hah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: Ben konseydeyken, öhöm... İşler çok farklıydı. Artık her yer ölüm, kargaşa... Kâbus gibi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: FEMA ne zaman halledecekse bu işi... Aylaklık yapmak için mi topladılar bunları?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: Cık cık! Ben yönetimdeyken böyle şeyler hiç olmazdı bak!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: Belki de zamana ihtiyaçları vardır. Tabii, tabii, tabii... Eninde sonunda her şey düzelir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: Sen meclis üyesi miydin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: FEMA'nın kurulmasına yardımcı olmuş muydun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: Evet, az önce dedim ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: Ha, tabii... Al bakalım. Bu da sana "teşvik" olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (Eline işe yaramaz birkaç banknot ve FEMA mühürlü bir kartpostal sıkıştırıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: Onu nereden çıkardın şimdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: Ha, tabii... Al bakalım. Bu da sana "teşvik" olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (Eline işe yaramaz birkaç banknot ve FEMA mühürlü bir kartpostal sıkıştırıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: Ne demek hayır? Sen benim kim olduğumu biliyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: Bakandım ben, bakan! Hükûmet dediğin karmaşık bir makinedir. O makine başında ben olmadan asla çalışmaz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: Ben halkın sesiyim! Ben olmasam senin gibi önemsiz vatandaşları kimse duymaz. Yok efendim! Sayemde hayatınız düzeliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: Normal şartlar altında bana cevap vermeye bilet cüret edemezdin delikanlı! Adamlarım seni alır götürürdü!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: Cık cık! Artık bakanlara bile saygı yok. Tüm gün ofiste boş boş oturduğumuzu sanıyorsun, öyle mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: Çarşı pazara karışınca kapıma dayanırsın sonra. Bakalım o zaman son gülen kim olacak! Hah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: Ohh... Soğuk su iyi geldi. Buz gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: Yine mi bir şey istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: Çok zekisin delikanlı!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: Ne istiyorum, biliyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: Buldum! Enerji içeceği istiyorum! Şöyle, öhöm, güzel bir takviye olur!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: İyi, al (Enerji içeceği ver)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: Cık cık! Evde hiç EnerJeka yok mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: İyi, peki! Acı çekmemi mi istiyorsun yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: Şansına küs
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: Ho ho! Tabii, tabii, tabii!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: Peh! Şekersiz mi? Ağzıma bile sürmem bunu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: Bunu içeceğime kezzap içerim! Tadı daha güzeldir... Bir saniye, ne dedin sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: Kafayı mı yedin sen? Bu gizli bilgi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: Sözleşme imzaladım ben, anladın mı? Gizlilik sözleşmesi. Yok, yok, yok! Hayatta anlatmam!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: Şu kahveyi al ve böyle sorular sormayı bırak. Uslu ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (Sana bir kutu kahve veriyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: EnerJeka mı bir de? Hah! Bunların içine ne koyuyorlar, kim bilir... Bir saniye, ne dedin sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: Kafayı mı yedin sen? Hiçbir şey söylemem sana. Bu gizli bilgi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: Sözleşme imzaladım ben, anladın mı? Gizlilik sözleşmesi. Yanlış anlama ama hayatta anlatmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: Şu kahveyi al ve böyle sorular sormayı bırak. Uslu ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (Sana bir kutu kahve veriyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: Pardon da, öhöm, boş mideyle nasıl çalışacağım ben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: Ben burada insanların hayatını iyileştirmeye uğraşıyorum! Halkımız için çalışıyorum!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: Siz de anca eleştiriyorsunuz beni. Kendinizi çok mu zeki sanıyorsunuz? Madem öyle gelin devlette çalışın!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: Ben de öyle düşünmüştüm. Anca laf, sıfır icraat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: Ohh... Soğuk su iyi geldi. Buz gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: Ne? Yine mi bir şey istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: Senden de hiçbir şey kaçmıyor delikanlı. Pompalı tüfeğini istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: Ne?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: Sen iyice kafayı yemişsin
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: Tabii, tabii, tabii. Ver hadi. Kendimi korumam lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: Eskiden ava çıkardım. Nasıl kullanıldığını biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: Hayatta olmaz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: Yürü git lan!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: Düzgün konuş delikanlı. Karşında kim var, unuttun mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: Canım isteseydi seni derhâl hapse tıktırabilirdim! Hah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: Hayatta olmaz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: Ne... Ne dedin sen? Seni küçük... BAKANIM ulan ben!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: Yeter! BURAMA kadar geldi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: Sen eşyalarını toplamaya başla. Yarın hapiste uyanacaksın! HAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: Benim için bir Ziyaretçi'den farkın yok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: Bakansan bakansın, bana ne. Bunun benim için hiçbir önemi yok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: Laflarına dikkat et delikanlı! Halkın sesiyim ben, bana karşı böyle konuşamazsın!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: İşin bitti senin, duydun mu beni? BİTTİ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: Ho ho! Beni sinirlendirerek büyük hata ettin! Sen bakanların ne kadar güçlü olduğunu bilmiyorsun herhâlde!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: Merak etme, seni de yakında hizaya getireceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: Benim için bir Ziyaretçi'den farkın yok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: Bakansan bakansın, bana ne. Bunun benim için hiçbir önemi yok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: Seni... sefil... it!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: Hapse tıkacağım seni! Göreceksin! Bekle sen, bekle! Hah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: Seni... sefil... it!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: Ohh... Soğuk su iyi geldi. Buz gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: Ee, neden hâlâ hapiste değilim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: Ha bir de dalga geçiyorsun benimle, öyle mi? Son gülen ben olacağım, sen hiç merak etme!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: Eskiden ünvanların bir ağırlığı vardı ama artık bunun hiçbir önemi yok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: Paranın hiçbir önemi yok artık. Bunu idrak edemiyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: Arsız velet! Ben... hâlâ bir devlet adamıyım!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: Sadece... öhöm... izne çıktım, o kadar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: Ah ah... Kimi kandırıyorum ben? O günler geride kaldı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: Ben bakanken herkes önümüzde diz çökerdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: İnsanlar benden korkardı, bana hürmet ederdi. Arabalar yol verirdi, millet bana yağ çekmek için ne yapacağını şaşırırdı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: Şahane. Al işte, stresten midem allak bullak oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: Mutlu musun? Git başımdan. Yeter bu kadar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: Hayır, öyle bir şey yok! Benim hâlâ bir sürü param var!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: Senin umurunda olmayabilir ama... diğer herkesin umurunda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: O rahat günlerim geride kaldı. Limuzinler, kızlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: Eskiden her şey çok kolaydı. Parası olan düdüğü çalardı!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: Kıyamet kopmasaydı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: Yoruldum ben. Beni rahat bırak.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: Bunları yarın konuşuruz. Hadi, kaybol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: N''aber moruk?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: N''aber moruk?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: N''aber moruk?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: Hadi o zaman, ben kaçar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: Kedi burada. Sen daha ne istiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: Burada ne işin var?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: Saçma soru.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: Kapıyı sen açtı. Kendine sor. Ne işim var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: Bana her yer aynı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: Bana buraya git dediler, ben de buraya gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: Ben hiçbir şey istemiyor. Seni de istemiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: Sen kediyi rahat et yeter. Sonrasını umursamıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: Kedi burada. Sen daha ne istiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: Sen insan mısın ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: Sen nesin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: Sende ne var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: Ben neden senden kötü oluyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: Kedi burada. Sen daha ne istiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: Seni kim yolladı buraya?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: Sen gerekliyi yaptı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: Gerisini niye umursuyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: İyi, tamam. Beni... biri yolladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: Sonra ne yapacağımı demedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: Kedi burada. Sen daha ne istiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: Ne kadar süre burada kalacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: Onlar beni almaya gelene kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: Ben daha ne yapsın? Ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: Bilmiyorum. Bana bir şey dediler, ben de devamını bekliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: Sana kim diyor ne yapacaksın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: Sen kimi bekliyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: Kedi burada. Sen daha ne istiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: Neden beni öldürmedin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: Sen biraz salak. Sen bunu biliyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: Her gün aynı soru.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: Ben sana dedi. Bana demediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: Ben bekliyor. Sen neyi bekliyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: İçerisi çok havasız...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: Hı? Ha, çocuk... Yorgun, benim gibi. Biraz da utangaç olduğu için yakamı bırakmıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: Çocuklar böyle durumlarda çok sıkıntı çekiyorlar. Şikâyet etmeseler de yüzlerinden okunuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: Bazen onları bu kargaşaya sürüklediğim için kendimi suçluyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: ...ama bu saatten sonra yapacak bir şey yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: Hadi ama güzelim, asma suratını.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: Siz niye sokaktaydınız?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: Ha, canım kaynanamı ziyarete gidiyorduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: Neyse ki yalnız başımıza oraya yetişemeyeceğimizi tam zamanında fark ettik ve senin eve rastladık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: Kalmamıza izin verdiğin için çok teşekkürler bu arada!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: Hadi ama güzelim, asma suratını.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: Daha ne kadar yolunuz var?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: Sevgili eşimin yön duygusu pek güçlü değildir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: Bize yardımcı olacak birini bulamazsak muhtemelen iki günlük yolumuz var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: Ki yolda birkaç kere yolumuzu şaşırıp kaybolduk, ona rağmen yani! Hah! Öyle değil mi tatlım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: Bizi arabayla bırakacak biri olsa çok makbule geçerdi. Arabayla en fazla iki saatlik yol falan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: Niye kaynananı ziyaret etmeye bu kadar isteklisin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: İki gün mü, iki saat mi? Bir dediğin diğerini tutmuyor
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: Ortalık iyice karıştı, kim bilir ne hâldedir şimdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: Telefonu da kapalı. Günlerdir ona ulaşamıyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: Ya başı dertteyse? Gidip birinin onu kontrol etmesi lazım!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: Artık geceler çok kısaldı. Dışarıda yürümek çok korkutucu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: Sorun değil ama. Anneni yakında göreceğiz güzelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: Yolu hatırlamıyorum işte, tek sıkıntı o. Karım da yol tarifi konusunda çok şapşaldır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: Hadi ama güzelim, asma suratını.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: Bu gece gidiyorsunuz sanmıştım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: Planımız oydu ama şapşik karıcığımın hazırlanması üç saat sürdüğü için saat çok geç oldu, artık çıkamayız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: Başka zaman gitmemiz gerekecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: Kusura bakma. Merak etme, bir dahakine daha hızlı oluruz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: Bu ağırkanlı hanımefendiyi acele ettiririm. Ha ha ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: Senin için zahmet olmuyor, değil mi? Olursa söyle lütfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: Hadi ama güzelim, asma suratını.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: Hanımefendi, siz iyi misiniz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: İyi gayet. Niye sordun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: Benim söylediklerime ekleyeceği hiçbir şey yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: Biraz yorgun bir de, o kadar. Endişelenme yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: Sana sormadım, ona sordum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: Evet, ben de yorgun dedim. Rica ederim üzerine gitme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: Hadi bir tanem, acele et. Daha ne kadar bekleteceksin beni? Hay!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: Fena değilim diyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: Hadi ama güzelim, asma suratını.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: Karın gitmek istemiyor. Hayırdır?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: Beni deli ediyor da ondan!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: Ha bire sızlanıyor, beni suçlayıp duruyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: Yani çenesini kapatıp ben ne dersem onu yapacak, bu ne kadar zor olabilir ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: Kusura bakma, bu kadar kalmayı planlamıyorduk. Bugün son, sonra gideceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: Duydun mu beni? O ıvır zıvırlarını topla. Gece vakti o kapıdan çıkmış olmazsak seni pencereden dışarı fırlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: Hanımefendi, iyi olduğunuzdan emin misiniz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: Sen burnunu sokma. Bir kere uyardım zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: Seni hiç alakadar etmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: Biz kendimiz hallederiz. Geri bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: Bıktım bu yalanlarından. Derhâl bana doğruyu söyle
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: Bana ne. Gidiyor musunuz, gitmiyor musunuz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: Sakin ol kardeşim. Bir sıkıntı yok dedik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: Karımın... canı sıkıldı, o yüzden böyle davranıyor. Sinirimi bozuyor arada, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: Ne istiyorsun benden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: Bıktım bu yalanlarından. Derhâl bana doğruyu söyle
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: Bana ne. Gidiyor musunuz, gitmiyor musunuz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: Hop dedik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: Benim de silahım var. Elini kaldırırsan bu orospuyu vururum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: Benim kaybedecek hiçbir şeyim yok. Senin var mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: Her türlü öleceksin
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: Tabii, tabii. Sen hiç merak etme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: Gidiyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: Duydun mu? Burada bir gece daha geçirmeyeceğiz. Oyalanmayı bırak da hazırlan artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: Kaybedecek neyim var ki? Beni öldürsen kaç yazar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: Hem acımı dindirmiş olursun hem de bu kahpe ölmüş olur. İki taraf için de kârlı bir durum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: Tetiği çekerim bak
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: Yavaş ol. Sen silahı bırak, ben de bırakırım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: Niye ki? Onunla birlikte gitmem gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: O gelmezse ben de gitmem. Silahını bırak, zaten bu gece gidiyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: Kimsenin canını yakmaya gerek yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: Gitmem lazım. Yoksa ikimiz de ölürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: Başka yolu yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: Şu kahpe tir tir titremeyi kesip benimle gelseydi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: Hepsi senin suçun. Duydun mu lan beni mal karı? Tüm planımın içine sıçtın!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: Uyar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: Silahı indiriyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: Bir saniye, vuracak mısın beni?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: BEKLE! DUR!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (Kadın birden adamdan kaçıyor, adam da onu vuruyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (Sen de anında tepki verip adamın kafasına sıkıyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: (İkisi de öldü... En azından kurtuldun)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: (Bunlar kafayı yemiş...)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: Her şey çok güzel olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: Hâlâ neşeli misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: Neşeli değilim ama... hâlâ ayaktayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: Hâlâ insanız. Hâlâ pes etmedik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: Anlatabildim mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: Her şey çok güzel olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: Aslında... hayır. Hep değildim. Eskiden çok öfkeliydim. İnsanlara karşı, dünyaya karşı, kendime karşı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: Yok yere sinirlenirdim, kapıları öyle bir çarpardım ki kasası çatlardı. Sonra öfkenin yalnızca yok etmeye yaradığını fark ettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: Önce içini yiyor, sonra etrafındakilere zarar veriyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: Bir keresinde... tek istediği bana yardım etmek olan birine sinirlendim. Artık... aramızda değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: O an içime bir kurt düştü. Değişmem gerektiğini anlamıştım. Yoksa dokunduğum her şeyi yok edecektim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: Bu yüzden affetmeyi öğrendim. Nefes almayı, boş vermeyi. Bu yüzden böyleyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: Her şey çok güzel olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: Neyini kaybettin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: Ailemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: Ben dışarıdayken evimizde yangın çıktı. Su almaya çıkmıştım sadece. Döndüğümde evin yerine yalnızca kül ve duman vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: Bunu kabullenmem uzun sürdü. Kendime "Niye o an evden çıktın ki?" diye sorup durdum. "Neden onları kurtaramadın?"'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: Belki de önemli olan bu değildir. Önemli olan geçmişi kurtarmak değil, geçmişi unutmamaktır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: Hâlâ benim yanımdalar aslında. Onları anmak, bana güç veriyor. Bu yüzden insanlara yardım etmeye çalışıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: İnsanın her şeyini kaybetmesi nasıl bir şey, iyi bilirim. Dünya başına yıkıldıktan sonra ayağa kalkıp devam edebilmek...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: Her şey çok güzel olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: Peki böyle yaşayabiliyor musun? Aileni kaybetmene rağmen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: Evet, bir şekilde üstesinden geldim ama kolay olmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: Uzun süre kendimi suçladım. Bir iki dakika daha erken dönseydim onları kurtarabilirdim, diye düşündüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: Suçluluk duygusu, insanın kederinden beslenir. Yaşamak için affetmek gerekir. Bu olayları geçmişte bırakmazsam olmayacaktı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: İşte böyle kurtuldum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: Geçmişimi değiştiremediğim için kendimi affettim. Zalim feleği bile affettim çünkü öfkem beni aşağı çekiyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: Her şey çok güzel olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: Peki şimdi gücünü nereden alıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: İnsanların iyileşebileceğine inanıyorum. Ne kadar vahim bir durumda olsak da bundan kurtulabiliriz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: Mucizelere veya kadere falan inanmam ben. İnsanlara inanırım. Birbirimize güç verdiğimize inanırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: Onları tekrar görme, onlarla konuşma, onlara sarılma fırsatım olsaydı... tabii ki de isterdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: Keşke biraz ısınabilsem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: Montunu çıkarmayacak mısın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: Y-yok... Düşüncesi bile korkunç.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: Ç-çıkarırsam ne olacak? Hava sıcakken b-bile ısınamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: Montu çıkarırsam s-soğuktan ölür müyüm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: Yoksa hayatta kalıp d-daha da mı üşürüm? O daha da beter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: Seni terletmiyor mu hiç?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: Duş almıyor musun yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: Y-yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: Vücut, s-serinlemek için terler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: Ben d-daha fazla serinleyebileceğimi sanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: Kusura bakma, b-bu soruya cevap veremem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: Keşke biraz ısınabilsem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: Bu üşüme konusunda ne yapmayı düşünüyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: Hım... Bunu ç-çözebileceğimi sanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: Sıcak suyla yıkanınca sadece tenimi yakıyor. Beni ı-ısıtmıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: Aslında...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: Aklıma bir b-benzetme geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: Uzayın derinliklerini düşün. E-engin ve d-donuk...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: Galaksiler doğuyor. Yıldızlar kendi içlerine ç-çöküyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: Ben de sadece g-gözlemliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: Güneşin ısısını asla h-hissedemeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: Birine sarılmanın sıcaklığını da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: Ne uzayın bana i-ihtiyacı var ne de insanların.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: Keşke biraz ısınabilsem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: Tanıştığımızda bana bir şey göstereceğini söylemiştin. Neydi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: Hım... Şu an bundan bahsedesim p-pek yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: Epey uzun süredir aklımda olan b-bir konu var. Sanırım... üşümemin s-sebebi bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: Bu konuyu açmaktan n-nefret ediyorum ama açmasam içim içimi yer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: Şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: ...sana yarın a-anlatırım. O zamana h-hazır olurum sanırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: Keşke biraz ısınabilsem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: Ee, ne saklıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: Evet... Sırrımı p-paylaşmak istemiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: Galiba hazırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: Ne zaman p-paylaşsam sonu kötü bitiyor a-ama belki bu sefer farklı olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: Ü-üşümemin ve y-yalnızlığımın sebebinin... bu kıyafetlerin altında olduğuna i-inanıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: Bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: Hayır... Yine m-mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: Ne yaptın sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: Sen hapı yutmuşsun
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: Ö-özür dilerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: Burası farklı olur s-sanmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: Hep aynısı o-oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: Böyle olsun i-istememiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: Yemin ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: Kov
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: Geçen sefer de b-böyle olmuştu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: Niye bu sefer farklı olacağını s-sandım ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: T-telaşlanma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: Niyetim k-kötü değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: Amacım b-bu değildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: Kov
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: Herhâlde... En iyisi b-bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: Artık ü-üşümeyeceğim. Yalnız k-kalmayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: Tek istediğim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: Bunu bilerek yaptığımı d-düşünme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: Şimdi mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: Kafama s-sıksan daha iyi. Ne yazık ki hâlâ acı h-hissedebiliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: En azından geceye k-kadar kalabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: Derhâl git buradan
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: Peki ama eline ayağına hâkim ol
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: Anlaşıldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: Ö-özür dilerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: Belki güneş içimi ısıtır. S-son bir defa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: T-teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: Biliyorum, benden n-nefret ediyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: Yine de...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: Ö-özür dilerim. Böyle olsun istememiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: Ha, şey... Arkadaşımı da buraya davet edebilir misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: Büyükler davet ederse gelmesine izin veriyorlar... Ben çağırınca azarlıyorlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: Galiba numarası {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: Evet, dinliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: Hastanelere ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: Çok kötüydü çok...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: İşler sarpa sarınca millet hastanelere akın etti. Herkes Ziyaretçi olup olmadığına baktırmak için yanıp tutuşuyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: Nasıl test edeceğimizi bilmediğimizi onlara anlatmaya çalıştık...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: ...ama kimse bizi dinlemedi. Üstümüze gelip durdular, asıl hastalara bakmamıza engel oldular.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: Nihayetinde FEMA kapımıza geldi ve... kalabalıkların salgın denetimini zorlaştıracağına karar verdiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: Tüm hastaları karantina bölgelerine götürdüler ve... hastaneleri de kapattılar işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: Niye ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: Sen de FEMA'nın köpeklerinden birisin yani
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: Milleti toplayıp götürmek doğru olandı yani, öyle mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: Sana da bu sözde "belirtiler" saçma gelmiyor mu? Normal insan özelliklerinden farkı yok hiçbirinin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: Hepsi boş laf! Neymiş efendim, dişi beyaz olan Ziyaretçi''ymiş. Kanıtı bile yok ki bunun!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: Bizden bir şey saklıyorlar kesin, demedi deme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: Dürüst olmak gerekirse... Hastaneler kapandıktan sonra karantina bölgelerinden birinde triyajda görev aldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: Ziyaretçiler ve belirtileri hakkında bir iki şey öğrenirim diye düşünmüştüm ama maalesef bir şey çıkmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: Niye ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: Sen de FEMA'nın köpeklerinden birisin yani
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: Evet, dinliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: Merak ediyorum da FEMA hakkında ne düşünüyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: Onlara hiç güvenmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: Evet, dinliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: Кабус гoрyйор гибийим!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: АГЗЫМЫ ДİКТİЛЕР! Сырф бени анламадыклары ичин.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: Nasıl?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: Seni dinliyorum insan. Konuş!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: Sen bir inanca falan mı mensupsun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: EVET İNSAN! Ancak benim inanışım, senin bildiğin o alçak dinlere benzemez.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: Ben KUTSAL GÜNEŞ''e tapıyorum! ZİRA O BİZİ KORUR, O BİZİ SEVER!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: Bu embesil koyunlar onu bir tehdit sanıyor. Neymiş efendim, "bizi yakacak"mış...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: HADİ LAN ORADAN! O, meşru öfkesini yalnızca KÖTÜLERİN ve KÂFİRLERİN tohumlarına yöneltir! Zira onlar, asıl günahkârlardır.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: Muhalifler, kendilerini O''nun selamet ışınlarının altında bulacaktır elbet!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: Zira onlar, alevin peşine düşer ancak yanınca neye uğradıklarını şaşırırlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: Kötülerin tohumları mı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: Kâfirler mi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: Bilmiyorum deme! Daha UZAYLILARLA hiç karşılaşmadın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Pekâlâ nursuz insan. Sana HAKİKATİ öğreteceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: ZİYARETÇİLER, KÖTÜLÜĞÜN TOHUMUDUR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: Güneş daha yaşken, çimler daha yeşilken Dünya''ya inen UZAYLILARIN TORUNLARIDIR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: Dünya''yı yuva yapıp YÜZYILLARCA kardeşleriyle çiftleşen PİS KÖLELER hepsi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: Şimdi derinliklerden yüzeye dönüp TOPRAKLARIMIZI ELE GEÇİRMEK istiyorlar!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: Ancak GÜNEŞ bizi korumaya karar verdi, zira BURASI BİZİM KUTSAL TOPRAĞIMIZDIR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: Güneş, kâfirlere MERHAMET ETMEZ! Yoksa bunlar niye yerin altında saklansın ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Of ya... Niye o gece o kadar içtin ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: Zil zurna sarhoş olmana gerek yoktu. Kutsal Güneş''in meşru öfkesi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: EY KUTSAL GÜNEŞ! Onun günahlarını affet, ne yaptığının farkında değildi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Ona sevgiyle sarıl. Onu ebediyen susuz kalacak incir ağacının ruhuna kat...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Amin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: Doğru duydun insan!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: Bu FEMA denilen illet, hepsi KÂFİR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: Bizim kontrolümüzde, NORMAL İNSANLARIN kontrolünde olmayan işlere burunlarını sokuyorlar!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: Onları alakadar etmeyen işlere maydanoz oluyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: Annemi o gölete atan piç kurularını Güneş yaksın kül etsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: Seni dinliyorum insan. Konuş!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: Güneş bir sürü insanı yakmış nasıl oluyorsa
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: Aynen öyle. Hepsi kötülüğün tohumlarıydı insan!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: Kutsal Güneş, BİN YILLIK günahlar için HEPSİNİ cezalandırmaya karar verdi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: BU ZİYARETÇİLER DE, BU GÖLGE ÂŞIĞI KÂFİRLER de GÜNEŞ''ten medet ummaya başladı!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: Ancak GÜNEŞ onlara bakmaz! Hayır efendim! Yerin altında yaşayan pis hortlaklara değil... bize, İNSANLARA bakar!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: GÜNEŞ, BİZİMDİR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: İNSANOĞLUNA BAHŞEDİLEN BİR ARMAĞANDIR! HAMDOLSUN ULAN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: Bu güneşin tatmin olması için daha kaç kişinin yanması lazım?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: Sence dünyanın sonu, aslında güneşin adaleti yerine getirmesi mi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Daha yanacak çok kişi var.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: Sen bana güven kardeşim, daha yolumuz ÇOK uzun.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: DAHA YENİ BAŞLIYORUZ, YENİ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: Küllerimiz GÜNAH TARTISINI daha doldurmadı. EVRENİN GÜÇLERİ hâlâ bize ağır basıyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: GÜNEŞ''in meşru alevleri DAHA ÇOK KİŞİYİ YAKMALI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: Fakat şunu bilesin kardeşim. Şehitlerin kanı yerde kalmaz!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Bir gün hepimiz Güneş''in asıl planını idrak edeceğiz...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Hay... Bazen geceleri karımın beni bırakıp gittiği gün aklıma geliyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: Çok naif bir kadındı...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: ...ama tam da bir yellozdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: Kimin sonu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: Bizim sonumuz mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: HAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: Güldürme beni. GÜNEŞ BİZİM TARAFIMIZDA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: O bizim kurtarıcımız, bunu idrak edemiyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: Ziyaretçileri yeniden yerin altına kovmaya çalışıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: İnsanoğlunun yüzyıllardır biriktirdiği günahlar için pis kâfirleri cezalandırıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: Aldatıcı çehrelerin ardında saklanan, üstü başı sidik kokan kâfirleri gün yüzüne çıkarıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: Bizim Güneş''e şükretmemiz lazım. "Dünyanın sonu geldi," diye bebe gibi ağlamamız değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: SONU GELENLER, YALNIZCA ULU GÜNEŞ''İN DÜŞMANLARIDIR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: TOPRAKTAN ÇIKANLARA ÖLÜM! BOK KOKAN KÂFİRLERE ÖLÜM! KÖTÜLÜĞÜN TOHUMLARINA ÖLÜM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: Var ya, şu an bir tabak patates kızartması için nelerimi vermezdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: Seni dinliyorum insan. Konuş!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: Sence bu olup bitenlerin kutsal bir anlamı mı var?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Söyle bana insan... Madem ben sana her şeyi anlattım, tüm ayrıntıları tek tek açıkladım...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: NEDEN BANA AYNI SORUYU SORUP DURUYORSUN AMINA KOYAYIM?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: Ben seni yanlış anlamışım. Sen gerçekten nursuzsun... Bu yaşadıklarımızın özünü kafan kavramıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Şöyle soğuk bir bira için adam öldürürdüm şu an, var ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: Bana bir arpa suyu bahşeder miydin insan?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: Olur, al (bir bira ver)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: Elinde mi kalmadı? Sen beni mal mı zannettin insan?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: Buzdolabının içini KENDİ GÖZLERİMLE GÖRDÜM ulan!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: Hadi ama insan. Biranın hepsini kendin mi içeceksin? Kardeşine vermeyecek misin hiç?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: Hayır (bira verme)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ohh, Güneş''e şükürler olsun...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Ha şöyle ya. Koyu lager gibisi yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Ağalarla barda takıldığım günleri hatırlattı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: Güzel sohbet dönerdi, buz gibi bira içerdik, yanına çerez alırdık...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: O cılız eleman bize bön bön bakıp dururdu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Neyse, sinirlenmenin manası yok. Salak olabilirsin ama naziksin de insan.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Ben de sana teşekkür olarak bunu vereceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: Kutsal Güneş ruhunu şad etsin!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: Seni SEFİL KÖPEK!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: CEHENNEM ATEŞLERİNDE YANASIN, SENİ ŞEREFSİZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: Bu ne küstahlıktır! Ben sana kutsal hükümleri açıklıyorum, olup bitenlerin önemini anlatıyorum ama sen...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: Seni bir MALIN tekisin insan! Hem de KÖTÜ NİYETLİ bir malsın!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Siktir git lan. İstersen çürü bu bok çukurunda, sikimde bile değil. Ben daha güzel bir yere gidiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: Göreceksin bak. Bu saatten sonra beni bara bile geri alırlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Hayatının geri kalanında başarılar diliyorum. Siktiğimin salağı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: Heh heh heh... Umarım her şey yakında düzelir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: Oda arkadaşımı yatağında hareketsiz yatarken gördüm bir anlığına, sonra birden...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Pis bir adam beni arkamdan tuttu ve "İçeri giremezsin. Arkadaşın... pek iyi değil." dedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: "Gel, mutfakta bir otur," dedi. Sonra beni çekti ve masaya oturttu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: Heh heh heh... Umarım her şey yakında düzelir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: Adam beni masaya oturttuktan sonra cüsseli bir adam mutfağa girdi ve çıkışı kapattı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: Beni tutup çeken herifle bağıra bağıra konuşmaya başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: Sanki ben... orada değilmişim gibi davranıyorlardı. Sonra beni... ellemeye başladılar!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: Önce koluma, sonra omzuma dokundular...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: Arkadan kahkaha sesleri geliyordu. Odamda birileri var gibiydi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: Gelen seslere bakılırsa içerisi epey kalabalık gibiydi. Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: O an... nefes alamadım. Kalbim küt küt atıyordu, bayılacak gibiydim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: Bağırmak istedim, yardım çağırmak istedim ama... korkudan sesim çıkmadı. Gıkımı bile çıkaramadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: Öylece donup kaldım orada. Hiç hareket edemedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: Sonra o cüsseli adam, dolaptan bir şey almaya uzandı. Ben de bunu fırsat bilince! He heh!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: Çıkışa doğru koştum. Korkum bana güç vermiş gibiydi. Hiç arkama bakmadan koştum durdum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: En sonunda bacaklarım pes etti ve yere yığıldım...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: Güneş seni niye yakmadı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: İlginç... O gün yaşadığım her şeyi hatırladığımdan adım gibi emindim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: O gün yaşanan her şeyi hatırladığımdan adım gibi emindim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: Heh heh heh... Umarım her şey yakında düzelir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: Beni öldürecek misin? Derimi yüzecek misin? Canlı canlı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: HAYIR, LÜTFEN! LÜTFEN BENİ HIZLI ÖLDÜR! ACI ÇEKMEYEYİM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: ACI ÇEKEREK ÖLMEK İSTEMİYORUM! LÜTFEN! HAHAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: Beni öldürecek misin? Derimi yüzecek misin? Canlı canlı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: HAYIR, LÜTFEN! LÜTFEN BENİ HIZLI ÖLDÜR! ACI ÇEKMEYEYİM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: ACI ÇEKEREK ÖLMEK İSTEMİYORUM! LÜTFEN! HAHAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: Hiçbir ümit kalmadı. Ne yaparsak yapalım ölümü tadacağız...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: Hiçbir ümit kalmadı. Ne yaparsak yapalım ölümü tadacağız...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: Heh heh heh... Umarım her şey yakında düzelir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: ZİYARETÇİLER! BİZİ ÖLDÜRECEKLER!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: Duymuyor musun? ÖLÜM BİZİ ÇAĞIRIYOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: Niye bekleyip kendimize işkence ediyoruz ki? BIRAKALIM GELSİNLER! HAHAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: BİZİM İÇİN EN İYİSİNİ İSTİYORLAR! ZİYARETÇİLERİN HEPSİ GELSİN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: İyi görünmüyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: HAYIR! IŞIĞI GÖRDÜM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: BEN BİR ZİYARETÇİ''YİM! HAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: BİZ İNSANLARLA BİRİZ. BİZLER BİRER YANSIMAYIZ! AYNAYIZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: HEPİMİZ BİRİZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: HEP BİRLİKTE ÖLÜMÜ KUCAKLAYACAĞIZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: Sen delirmişsin. Ağzından çıkanı kulağın duyuyor mu senin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: BEN DELİ DEĞİLİM, SADECE IŞIĞI GÖRDÜM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: BEN BİR ZİYARETÇİ''YİM! HAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: BİZ İNSANLARLA BİRİZ. BİZLER BİRER YANSIMAYIZ! AYNAYIZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: HEPİMİZ BİRİZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: HEP BİRLİKTE ÖLÜMÜ KUCAKLAYACAĞIZ! HEPİMİZİ ENİNDE SONUNDA BULACAK!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: Sen delirmişsin. Ağzından çıkanı kulağın duyuyor mu senin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: Sonumuz geliyor! GÜNEŞ, SON ZİYARETİN ELÇİSİDİR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: Yakında buluşacağız. Hem de çok yakında...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: Bir ihtiyacın var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: Bir bardak su ister misin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: Karnın aç mı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: O zaman seni rahat bırakayım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: Yanına oturabilir miyim?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: O zaman seni rahat bırakayım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: Yanına oturabilir miyim?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: Ama sen onu geri getiremezsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: Onu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: Onu gömemiyorum bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: Elimden ne gelecek ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: Nasıl öldü?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: O... Ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: Bu acıyı kaldıramıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: Dökecek gözyaşım kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: Gözlerim kurudu artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: Ama böyle de olmaz ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: Ağlamayı bırakamam öyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: Onu defnetmemiz gerek
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: Kocan öldü artık. Bunu kabullenmen gerek
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: Onu nasıl hatırlıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: Bir gün bir arkadaşımızın evindeydik.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: O zamanlar çok daha gençtik.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: Öyle takılıyorduk, içiyorduk. Normalde epey huysuz biriydi. Böyle insanlarla bir araya geldiğimiz zaman pek konuşmazdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: O gün bayağı bir içmiştik.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: Başta normal davranıyordu, yine sessizdi ama sonra birden dedi ki:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: "Bana bir gitar verin. Şarkı söyleyesim geldi."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: Sonra öyle güzel bir şarkı söyledi ki... Bayılmıştım gerçekten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Arkadaşlarımız istek parça söylemeye falan başladı. Bir anlığına orada durdu, sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: Birden ayaklandı ve "Gitmem gerek," dedi. Eli bir bardağa çarptı, düşerken yakalamaya çalıştı, o sırada gitarı düşürdü...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: Sonra öğrendim ki aslında beni etkilemek için sadece tek bir şarkı öğrenmiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: O geceden kalan bir fotoğrafımız var hâlâ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: Biraz eskidi tabii. Tıpkı bizim gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: Artık bana serenat yapamıyorsun. Bana son şarkını söyledin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: Ee, ne oldu ona?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: Geberdi lan işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: Doğru, pardon. Kusura bakma, konuyu açmak istememiştim
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: Onu ben öldürmedim ya
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: Kusura bakma, ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: Her gece ağlıyorum. Gözyaşlarıma hâkim olamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: Bütün bu yaşananlar... Sorumlu olan herkesin güneşin altında cayır cayır yanmasını istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: Ee... Ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: Artık sormayacağım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: Haklısın. Kusura bakma.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: Kabalık ettim. Onun konusu açılınca kendime hâkim olamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: Umarım o piç kuruları hak ettiklerini bulur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: Umarım birileri onları paramparça eder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: Ee... Ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: Artık sormayacağım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: Kocam hasta gibiydi. Hastaneye gitti ama onu geri çevirdiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: "Yeni açılan FEMA merkezine gidin," dediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: Tek yaptıkları onu karantinaya koymaktı. Telefonunu da aldılar, üç haftaya bırakacaklarını söylediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: Ben biraz erkenden gideyim dedim. Ne hâlde acaba diye merak etmiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: Şerefsizler...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Bir saniye. Kusura bakma.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: Bana dediler ki: "Öldü."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: Bu kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: Onu görmeme izin vermediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: Onu eve götürmeme izin vermediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: Tabii, hepsi geri zekâlı olduğu için tek yapmam gereken laboratuvar önlüğü giyip morgun kapısından girmekti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: O...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: Gerçekten oradaydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: Onu onlar öldürdü. Kanı onların elinde. Artık elimden gelen tek şey bağırmak, kimseye karşı şefkatim kalmadığını duyurmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: Yalnız kalmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Evet. Lütfen...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: Onsuz yapabileceğimi sanmıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: Bir sorun mu var?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: Bu gece gidiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: Burada uzun süre kalmayacağımı zaten söylemiştim sana.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: Biraz istirahat edecek bir yer arıyordum sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: Bundan sonra ne yapacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: Ailenin yanına mı gideceksin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: Bunu düşünesim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: Sanırım... eve gideceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: O eski gitarı bulacağım...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: Sonra da...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: Burada kalabilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Yolun açık olsun
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: Ailemiz yok ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: Eve gideceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: Başka hiçbir şeyimiz kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: Burada kalabilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Yolun açık olsun
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Niye ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: Burada kalmak bir işe yaramıyor sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: Yanlış anlama ama umurumda değilsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: Tek istediğim eve gitmek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: Ait olduğum yere.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: ... Sağ olasın.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: Çok konuşmuyorsun ama... iyi bir dinleyicisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: Umarım aradığın neyse bulursun.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: Hehe. N''aber?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: Felaket'ten önce ne işle uğraşıyordun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: Oooo, sorduğun iyi oldu kanka!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: Sen hiç...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: ...spor bahsi nedir bilir misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: Nesin sen, dolandırıcı mı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: Duydum tabii
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: Niye öyle dedin ki şimdi? Ben analizciyim moruk!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: Kazandığım paraları görseydin ağzın sulanırdı kanka.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: Bu işin ehliyim ben. Bahis işi benden sorulur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: Millet bana parasını getirir, beş katını kazanırdı. Hatta ne beşi, ON katını.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: Ee, ne kadar kazandın?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: Böyle iş mi olur?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: Ekmeğimi buradan kazandım aga!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Öyle düzgün bahis oynamak enayilerin işidir. Valla bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: Bu bahisçileri aldatmanın bir sürü yolu var.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: Şikeli bahis oynayacaksın, sonra arkana yaslanıp rahatlayacaksın!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: Paran yoksa da dert değil. Malın tekinden borç al gitsin!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: Ee, ne kadar kazandın?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: Böyle iş mi olur?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: Nasıl desem...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: Otuz milyon yaptım baba.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: Otuzu da borç tabii ama sikimde bile değil!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: Şu saatten sonra zaten ne yazar ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: Ben tehlikeden kaçmam aga.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: Sen ne diyorsun ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: İş dediğin böyle olur asıl!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: Ofisim bile vardı diyorum oğlum sana! Krallar gibiydim lan, kral!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Deri koltuğum bile vardı be. Bir tane de defterim vardı. Bahisçilerin adları, borç miktarı, net gelir... Ne ararsan oradaydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: Hehe. N''aber?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: Tahsildarların peşine düşmeyeceğinden emin misin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: Tahsildar mı? Ne tahsildarı amına koyayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: Borç morç kalmadı ki aga. Güneş hepsini yaktı gitti!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: Bankalar bu saatten sonra bir bok yapamaz artık!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: Artık hür bir kuşum babuş. Tabii, daha işim bitmedi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Bahis işleri yattı, tabii. Daha iyi, daha yeni bir şey bulmam lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: Bu güneş mevzusu senin işine gelmiş belli ki
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: Ciddi misin sen? Yeni bir iş mi bulacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: Ayıp oluyor ama moruk!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: Ben her şeyi çözmüştüm! Ya hep ya hiç tarzı yani! Hepsi alın teri!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: Şimdi temiz bir sayfa açma fırsatım oldu. Harbisi yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: Yeni işimi buldum bu arada. Anlatayım ister misin, he?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: Anlat bakalım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: İstemem
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: Geçenlerde aklıma MANYAK bir iş fikri geldi. Anlatayım mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: Anlat bakalım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: Pek değil
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: Şimdi, artık tüm kararları FEMA veriyor. Doğru mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: Biraz götlerine paspas çekmemiz lazım tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: Ben de dedim ki, biz bunlara enayileri teslim edersek belki bizi o sağlam sığınaklarına alırlar!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: Kaptın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: İnsanları FEMA'ya satalım mı istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: FEMA'nın seni kurtaracağını mı sanıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Hee. N''olmuş ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: Korkak mısın oğlum sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: Denize düşen yılana sarılır aga.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: Bu karantina bölgelerinde anca koyunlar yaşar. Bir sik olduğu yok oralarda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: FEMA''yla iyi anlaşmamız lazım. Biraz yağ çekmekten zarar gelmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: Harbiden götlerini yalayacak hâlimiz yok. Bir iki adam veririz yeter. İstedikleri de bu zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Bu numaralarından ararız, Ziyaretçi belirtilerini falan sorarız. Bizim şüpheli olmadığımızı anlarlar işte!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: Onlar iyi adam oğlum. Gerçekten bak!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: Haklı olabilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: Siktir lan oradan
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: Madem FEMA'ya bu kadar âşıksın siktir git evimden
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Amma abarttın be moruk. İnsan biraz uyumlu olur ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Neyse, bizim başta kimin olduğunu çözüp ona yağ çekmemiz lazım. Biz bu maçı anca böyle alırız, anladın?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: FEMA''yla iyi anlaşmamız lazım. Biraz yağ çekmekten zarar gelmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: Harbiden götlerini yalayacak hâlimiz yok. Bir iki adam veririz yeter. İstedikleri de bu zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Bu numaralarından ararız, Ziyaretçi belirtilerini falan sorarız. Bizim şüpheli olmadığımızı anlarlar işte!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: Onlar iyi adam oğlum. Gerçekten bak!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: Haklı olabilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: Siktir lan oradan
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: Madem FEMA'ya bu kadar âşıksın o zaman siktir git evimden
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: Haklıyım tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: Ben işlerden anlarım moruk.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Sen bana ayak uydur, hiç pişman olmazsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: Asıl sen siktir lan.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: Millet bana yatırım tavsiyesi için para verirdi. Ben sana BELEŞE veriyorum lan. Hediye ediyorum bildiğin...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Siktir git lan, amına koyduğumun ödleği. Seninle mi uğraşacağım lan ben?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: Ne yapacaksın lan? Evinden mi kovacaksın beni?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: Ben de adam sandım lan seni...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: İş birliği bile teklif ettim. Sen gittin, ne yaptın?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: Canın cehenneme aga. Ben kaçar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: Ciddi misin lan sen? Mis gibi plan yapmıştım bir de. Paşa gönlün bilir...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Fikrini değiştirirsen haber edersin, okey mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: Hehe. N''aber?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: Ne istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Dinle bak, yeni bir iş buldum. Bu sefer harbi güzel oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: Bak şimdi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: Şimdi bu güneş, bizi cayır cayır yakıyor. Doğru mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: Demek ki ozon tabakası boku yemiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: Şimdi iyi dinle. Oksijen, güneş ışınlarının ozon tabakasından geçmesiyle oluşuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: Mantığı anladın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: HAVA SATACAĞIZ moruk, hava!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: Ticaret BUDUR amına koyayım!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Gerçekten inanılmaz bir planmış amına koyayım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: Galiba hayatımda daha boktan bir plan duymamıştım
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: Offfff, değil mi ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Tabii oğlum, sen ne diyorsun? Senden bilim adamı bile olur
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: Değil
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Hay...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Sağ olasın moruk! Senin zeki olduğunu anlamıştım zaten! Taşaklarımdan zekâ fışkırdığını görebiliyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: Bu gidişle Darwin Ödülü bile alırım lan ben!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: Darwin Ödülü kimlere veriliyor, farkında mısın sen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Tabii canım, kesin alırsın
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Bu bilimden anlayan ineklere falan vermiyorlar mı oğlum işte?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: Niye ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: Hiç, öylesine
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: Mal mal ölen insanlara veriyorlar Darwin Ödülü'nü
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: Haha! Şimdiden şan şöhreti gözümün önüne geldi! Bilimin kralı olacağım! Diz çökün ulan!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Para geldi mi, gerisi de gelir... İşte bu be, işte bu!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: Tamam o zaman, anlaştık. Bu işler bittikten sonra hava satma teknolojisinin patentini alıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: Senin beni anlayacağını biliyordum moruk!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Ha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Bir saniye lan, sen benimle dalga mı geçiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: Yürü git lan. Ben burada MANYAK planlar yapıyorum, sen benimle taşak geçiyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: Yürü git lan. Ben burada MİLYONLUK planlar yapıyorum, sen benimle taşak geçiyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: O Darwin Ödülü''nü de alacağım, milyoner de olacağım yarağım!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: Sonra gelip önümde diz çökeceksin, "Beni affet!" diye yalvaracaksın!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: Bu boktan planlarını da al, siktir ol git
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: Oha be moruk...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: Bana kulak vermek bu kadar zor mu gerçekten? Ne oldu, seni sinir mi ettim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: Aman, çok da sikimde. Yalnız başıma da kâr ederim ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: Oha be moruk...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: Yürü git lan. Ben burada MANYAK planlar yapıyorum, sen benimle taşak geçiyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: O Darwin Ödülü''nü de alacağım, milyoner de olacağım yarağım!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: Sonra gelip önümde diz çökeceksin, "Beni affet!" diye yalvaracaksın!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (Bir süre sonra yine hüngür hüngür ağlamaya başlıyor. Belli ki senin elinden bir şey gelmeyecek.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: Bundan sonra ne yapacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: İyi sordun.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: Kocam bizi almaya gelir yakında. Umarım kalabileceğimiz güvenli bir yer bulmuştur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: Ziyaretçilerin gitmesini ve güneşin dinmesini bekleyebileceğimiz bir yer...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: Böyle yerlerin olduğunu söyledi. Güneşin patlamadığını da ekledi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: Patlasaydı 10 dakikadan kısa sürede hepimiz ölürmüşüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: Sanırım haklı.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: Kocandan haber var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: Hiç ses soluk yok... Niyeyse bizi aramadı, almaya da gelmedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: Ona bir şey mi oldu acaba? Belki başını belaya sokmuştur...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: Bizi bırakıp gitmediğinden eminim. İmkânı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: Kardeşimden bıkmasına rağmen ona bakmama yardımcı oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: Muhtemelen yoldadır ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: Kardeşim de biraz daha iyi gibi... Kesin yoldadır yani. O geldikten sonra her şey düzelecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: Üzgün duruyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: Öyle mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: Gerçi pek şaşırtıcı değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: Aklım çok dolu da.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: Madem güneş patlamıyor neden havalar hâlâ sıcak? Neden herkes dünyanın sonu geldi deyip duruyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: Haberlerde öyle duydum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: Doğrudan söylemediler ama her geçen gün hava daha da ısınıyor sanki.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: İklim değişiyor. Dolayısıyla hayvanlar da ölüyor... çünkü yeni "hava koşullarına" uyum sağlayamıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: Ne olacak bu hâlimiz?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: Nasılsın?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: Geçen gece kocamı aramaya çıktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: Onu bulabileceğimi düşündüğüm bir iki yere baktım...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: ...ve buldum. Bir hap içmiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: Bu hapları... birlikte içmek için almıştık. İşler kötüye giderse diye, hani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: Hapı içmiş. Çok korkmuş. Beni hiç beklememiş bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: İçmiş hapı. Yalnız başına yutuvermiş. Güneş onu yutmadan önce...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: Sonumuz geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: Nasılsın?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: Sanki...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: Üzerimde bir ton zincir taşıyor gibiyim. O kadar ağır geliyor ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: Bu yükü kaldıramıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: Hepsinden kurtulmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: Sonumuz geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: Yine çok mutlusun bakıyorum
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: Tabii, tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: Güneş patlayacakmış, duydun mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: Ben de bu gece öğrendim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: Gerçekten sonumuz mu geliyor yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: Bizden geriye hiçbir iz kalmayacak mı yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: Bence ilginç bir soru bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: Sonumuz geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: Kardeşin nasıl?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: Her şeyi kaybetmekten korkuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: Bana sorarsan kaybedecek bir şeyimiz yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: Durmadan genişleyen bir evrenin içindeki toz parçalarıyız sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: Kimsenin bize ihtiyacı yok. Zaten başka KİMSE yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: Gezegenimiz yok olup gitse kimse yasımızı tutmaz. Yas tutacak hiç kimse veya hiçbir şey kalmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: Kardeşim bundan çok korkuyor niyeyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: Sonumuz geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: Kardeşin hasta mı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: Evet. Aklındaki korkunç düşünceleri unutmak için dışarı çıkıp kocasını aramak istiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: Bana sorarsan bu iyi bir fikir değil ama "Boş boş duramam," diyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: Kocasını aramaya çıkacaksa benim de onunla gitmem gerekecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: Yolun sonuna gelmeden onu kaybetmek istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: Sonumuz geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: Çıktınız mı dışarı?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: Çıktık. Kocasının cesedini buldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: Kocası ona her şeyin düzeleceğini söylemişti ama sonra gidip kolay yolu seçmiş. Hikâyenin sonunu görmek istememiş herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: Kardeşimin bu saatten sonra devam edecek gücü var mı bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: Sonumuz gelene kadar ona bakmam gerekecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: Sonumuz geldiğinde zaten kaygılanacak, korkacak, çekinecek veya utanacak bir şeyimiz kalmayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: Hay... (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: Baksana birader... Zahmet olmazsa ailemi arayabilir misin? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: Gelip beni alsınlar demiyorum... Vedalaşasım da yok zaten... (öksürür) Sen de ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: De ki "Babanız korkaklık etmedi. Ona ihtiyacı olan insanların yanında kaldı."'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: (öksürür) Bunu desen yeter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: Ne var be?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: Sen gümrükte çalıştığını mı söylemiştin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: Aynen öyle dedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: Gümrük demişken... Gelen gideni Ziyaretçi mi, değil mi diye kontrol ediyorsundur umarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: Saçma bir soru, farkındayım ama... insan bilemiyor işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: Bunlara "Ziyaretçi" demek hangi dangalağın aklına geldi ki acaba?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: "Ucube" desek yeterdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: Ne var be?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: Ziyaretçilerden neden nefret ediyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: Bu ne saçma bir soru be?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: Onlar yüzünden her şey boka sardı! Haberlere hiç bakmıyor musun sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: Güneş patladı patlayacak. Millet sokakta ölüyor. Hepsi onların suçu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: Bak sana yemin ediyorum, elimde olsa hepsini tek tek vururdum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: Bana biraz vakit verseler yeter. Sınır kapısında yaptığım gibi hepsini bulurdum. Gör bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: FEMA beni işe almayarak büyük hata etti ama neyse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: Ne var be?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: Niye FEMA'da çalışmak için can atıyorsun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: Olan biteni umursuyorum da ondan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: Bu Ziyaretçilerin durdurulabileceğini biliyorum. Durdurulmalılar da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: Ben zaten üzerime düşeni yapıyorum. Daha geçenlerde komşumu onlara teslim ettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: Peki onlar ne yapsa beğenirsin? Gittiler kocamı işe aldılar ya! İnanılır gibi değil!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: Hani yanlış anlama beni, kocamla gurur duyuyorum ama oha yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: Tokat yemiş gibi hissediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: Ne var be?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: Komşunu niye FEMA'ya teslim ettin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: Kulağın duymuyor mu senin? Dedim ya zaten. Herif Ziyaretçi''ydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: Bir de beni rahatsız ediyordu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: Onu teslim etmek ne iyi geldi, var ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: Bana sınır kapısında ülkemi koruduğum günleri hatırlattı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: Zaten orada anladım... Benim FEMA''da çalışıyor olmam lazım!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: Ne var be?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: Sen buraya kocan için gelmedin. FEMA için geldin. Haksız mıyım?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: Ee, n''olmuş?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: Birileri fark edene kadar ses çıkarmaya geldim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: İş başvurumun reddine de itiraz edeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: Ziyaretçi''yi ben yakaladım. Vatandaşlık görevimi ben yerine getirdim. Gittiler işi ONA verdiler! Tamamen saçmalık!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: Yani, hiç mantıklı değil gerçekten. Salak mı ne bunlar ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: Nefret ediyorum o heriften. Tiksiniyorum ondan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: Şey, senden bir iyilik isteyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: Onları bir arar mısın? Dâhilî numaradan ara. Özel bir numaraları var: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: Sağlam biriyle tanıştığını söyle. Deneyimli ve cengâver bir kadın. İstersen kocamın adını da verebilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: Ne dersen de, iyice göklere çıkart beni. Belki beni o zaman işe alırlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: Ne var be?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: Gümrükte çalışmayı seviyordun herhâlde? En azından orada bir nüfuzun vardı
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: Boş övgülere karnım tok bayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: Hem fikrini sormadık. Benden üstün olduğunu falan sanma sakın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: Patronluk taslamak hoşuna gidiyor, değil mi? İnsanlar kapına geliyor, evinde kalıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: Kim Ziyaretçi kim değil sen karar veriyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: Ama bu senin işin değil, FEMA''nın işi. Sen ancak kendi kendine tanrıcılık oynarsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: FEMA''nın en azından bu kararları verecek otoritesi var. Kendini onlardan üstün mü görüyorsun gerçekten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: Ben de öyle düşünmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: Babamlar gerçeği söyleyince kendimi kandırılmış hissettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: Çok sinirlenip bir hışımla odama gittim. Beni yalnız bırakmalarını istiyordum sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: Sonraki gün...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: Sana o anlattığım olaylar oldu. Televizyon, kargaşa falan derken...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: Akıl verdiğin iyi oldu. Teşekkür ederim. Belki bir gün tekrar görüşürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: Hadi bakalım... Belki bir gün tekrar görüşürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: Haklı olabilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: Belki arabaları arızalanmıştır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: Bana FEMA'yı anlat. Kim bunlar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: FEMA'nın planı ne?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: Yürü git lan!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: Hapse tıkacağım seni! Göreceksin! Bekle sen, bekle! Hah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: Ah ah... Kimi kandırıyorum ben? O günler geride kaldı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: Şahane. Al işte, stresten midem allak bullak oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: Mutlu musun? Git başımdan. Yeter bu kadar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: Çok karanlık...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: Ee, söyle bakalım. Ne gördün?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: Bu sorunun cevabını duymak istemezsin. Güven bana. Söylemeyerek sana merhamet ediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: Gözlerimden kurtulursam... o şeyden de kurtulurum diye düşünmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: Maalesef işe yaramadı. O, artık benim bir parçam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: Hâlâ rüya görüyorum. Karşıma hep O ŞEY çıkıyor. Beni sık sık ziyaret ediyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: Çok karanlık...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: Gözünün olmaması daha mı iyi yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: Bilemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: O yaratığı bir daha asla görmeyeceğimi biliyorum en azından. Bir şey beni öldürürse bile ne olduğunu göremeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: Garip bir his.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: Evin neye benziyor, hiçbir fikrim yok. Bazen duvarlara çarpıyorum. İlaç almasaydım göz çukurlarım çok kötü ağrırdı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: ...ama en azından o mahluğu bir daha asla görmeyeceğim. Alışırım yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: Tabii, o gördüğüm şey... varlığıma kazındı artık. Ölene dek beni bırakmayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: Çok karanlık...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: Pek iyi görünmüyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: Saçlarımı tarasam? Ha ha...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: Dün gece bir rüya gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: Tramvay yolunun oradan eve yürüyordum. Evler, ağaçlar vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: Arkamdan tramvay geldiğini duyunca kenara çekildim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: Sonra arkamı döndüm ve... bir yaratığın sokaktaki adamı alıp götürdüğünü gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: O kadar hızlı hareket ediyordu ki ne olduğunu göremedim ama... hemen anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: Tramvayın arkasından koştum ama bir türlü yaklaşamadım. Ona asla ulaşamayacağım. Hattın sonundaki gerçeği öğrenemeyeceğim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: Sonra da uyandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: Çok karanlık...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: İyi misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: Yine rüya gördüm. Rüyamda O ŞEYİ gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: Yoldan aşağı yürüyordum. Gece vaktiydi. Sokak lambaları bir yanıp bir sönüyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: Sonra arkamı döndüm ve O ŞEYİN bana doğru geldiğini gördüm. Usul usul yaklaşıyordu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: Bu sefer O ŞEYİN nasıl hareket ettiğini gayet net görebiliyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: Kaçmaya çalıştım ama bana yetişiyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: Evime ulaştım ama ön kapıyı bir türlü açamadım. Çitin üzerinden atladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: Elimi cebime attım ama anahtarlarım elimden kayıp duruyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: Evin arka tarafına koştum. Bir çit daha karşıma çıktı, onun da üzerinden atladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: Sonra durdum. Sessizlik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: Yukarı baktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: Oradaydı. Çitin üzerinden bana doğru uzanıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: Acaba ağrı kesiciler mi bu rüyalara sebep oluyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: Çok karanlık...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: Dün gece rüya gördün mü?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: Evet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: Ama anlatmak istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: Anladım artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: Hepimiz öleceğiz..'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: O ŞEY bizi paramparça edecek. Ya uyurken ya da uyanıkken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: Hepimiz yanacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: Hiçbir şeyin önemi kalmadı artık. Sonumuz geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: Lütfen... beni yalnız bırak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: Felaket'ten önce ne yapıyordun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: Öylesine takılıyordum kanka ya. Dizi falan izliyordum. Agalarla akıyorduk falan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: Artık film falan kalmadı ya. Takılacak adam da yok. Kötü oldu yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: Televizyonda hep aynı şey var. Yok panik olan adamlar, yok reklamlar... Hep aynı terane. Agalarımı arıyorum, onlar da açmıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: Geçenlerde kodaman bir abi gördüm, "Eğlenmenin vakti değil bu. Bir kriz var..." falan diyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: Bana çok saçma geldi kanka ya. Eğlenmenin vakti değil ne demek yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: Peki nerede çalışıyordun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: Ne çalışması ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: İşe giren enayidir kanka. Ben çalışmıyordum, YAŞIYORDUM. Anladın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: Mesela bir filme gitmiştim. Ana karakter bildiğin bendi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: Sen hiç yüzü gülen amele gördün mü? Hiç sanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: Ben partilere akıyordum kanka. Çok kıyak adamlarla tanışıyordum. Yaşamak budur zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: Yani... Bir ara depo müdürüydüm. Mal kabulü falan. Annemler bulmuştu işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: Baba parasıyla mı yaşıyorsun yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: Tembelin tekisin yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: Zaten her şeyi çözmüşüm moruk. Niye çalışayım ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: Elinde olanı kullanmıyorsan malsındır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: Mesela senin şu kocaman tüfeğin var ya? Onu duvara asacak hâlin yok sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: Ben de senin gibi kendimi akışa bırakıyorum yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: Hop be moruk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: Çekemiyorsan anten tak yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: Seni de anlıyorum, herkesin hayatı benim gibi rahat değil ama hayat böyle bir şey işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: Bir sorun mu var?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: Sen filmleri nereye sakladın be kanka? Hiç film bulamadım burada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: Hiç film izlemiyorum deme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: Sıkıntıdan patlayacağız şurada ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: Film izlemenin sırası değil
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: Hiç filmim yok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: Kötüymüş ya. Ben burayı kıyak bir yer sanmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: Ev ahalisi çok sıkıcı ama ya. İzleyecek de hiçbir şey yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: Dergi yok, film yok... Anca kitap var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: Kitap okuyan mı kaldı ya? Mağarada mı yaşıyorsunuz siz? Ne o öyle, saçma sapan kelimeler falan. Anlatırken uykum geldi yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: Sen burayı sinema sandın herhâlde
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: Sen buraya hayatta kalmak için mi geldin, partilemek için mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: Yok artık... Ciddi olamazsın!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: Bir saniye ya. Sen CİDDİSİN!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: Odanda televizyon var ama niye hiç filmin yok yani aga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: Bu ne biçim parti ya? Ben seni kafa biri sanmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: Sen burayı sinema sandın herhâlde
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: Sen buraya hayatta kalmak için mi geldin, partilemek için mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: Of be moruk...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: Enerjin çok düşük kanka ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: Hayatta kalmak istiyorsan sakinleşmeni öneririm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: Madem beğenmiyorsun kapı orada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: Hadi ama ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: Benim evdeki televizyon pert oldu. Beni sıkıntıdan patlamaktan kurtarırsın diye düşünmüştüm ama işte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: Enerjin çok düşük kanka ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: Hayatta kalmak istiyorsan sakinleşmeni öneririm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: Madem beğenmiyorsun kapı orada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: Biraz sakin ol kanka ya. Burası bok gibi bir yer ama yine sokakta yatmaktan iyidir yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: En azından bırak da biraz televizyon izleyeyim kanka ya. Hadi, hadi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: Biliyordum böyle olacağını. Çok sıkıcısın kanka!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: Zavallı çocuklar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: İyi misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: Yani, evet. Sanırım. Bilmiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: Yani nasıl olur da bir grup aklı başında yetişkin insan duygularına yenik düşüp böyle bir şey yapabilir ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: Gerçekten bir çocuğu öldürecek kadar korkmuş olabilirler mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: İnsanlar şu sıralar daha beterini bile yapıyor
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: Kargaşa çıktı mı, akıl mantık kalmıyor kimsede
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: Savunmasız bir çocuğu öldürmekten daha beter ne olabilir ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: Tek bir kişi de değildi, kalabalıklardı. Linç etmeye gelmişler gibi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: Zorluk, insanın asıl yüzünü ortaya çıkarır. Belki de asıl canavarlar biziz, yerden çıkan yaratıklar değil...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: Yine de insanlar çocuk öldürmenin... Yani, kelimeler kifayetsiz kalıyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: Zorluk, insanın asıl yüzünü ortaya çıkarır. Belki de asıl canavarlar biziz, yerden çıkan yaratıklar değil...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: Zavallı çocuklar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: Ne kadar zamandır öğretmenlik yapıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: Yaklaşık üç aydır. Felaket''ten önce başladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: Kusursuz bir öğretmen değildim ama. Yaptığım işi sevmiyordum. O zamanlar çocuklar sadece gürültülü ve yorucu geliyordu bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: Felaket''ten sonra gözlerim açıldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: O çocukların her biri bir rock yıldızı, bir siyasetçi, bir ebeveyn olabilirdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: Artık ne bir gitar tutabilecekler ne okula gidecekler ne de büyüyecekler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: Hepsi... hayallerini de alıp gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: Bir gün çocuklardan biri ağlayarak sınıfa gelmişti, hiç unutmam. Annesi babasının ondan korktuğunu söylemişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: Çocuğu Ziyaretçi sanmışlar, evden kovmuşlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: Nereye gideceğini şaşırmış, bu yüzden bana gelmiş. Anaokuluna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (Kadın gözyaşlarını tutamayıp ağlamaya başlıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: Kusuruma bakma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: Zavallı çocuklar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: Dün o konuyu açtığım için özür dilerim. Seni üzmek istemedim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: Sorun değil... Geçti. Şimdi daha iyiyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: Neyse, o çocuğu anlatıyordum. Bana geldiğinde çocukların ne kadar savunmasız olduğunu anladım. Özellikle Felaket''ten sonra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: Ne kadar terk edilmiş çocuk varsa içeri almaya başladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: Anlattıklarını dinledim. Bazı ebeveynlerin çocuklarını hiç düşünmeden dışarı attığını duymak beni çok üzmüştü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: Felaket''i mazeret edip çocuklarını terk etmek bu kadar kolay olmamalıydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: Belki de çocuk istemiyorlardı, işlerine geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: Zavallı çocuklar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: Senin çocuğun var mı peki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: Yok... Annem hep evlenip aile kurmam için başımın etini yerdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: Kendimi hiç hazır hissetmedim. Doğru vakit geldiğinde bu kararı vereceğimi düşünmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: Terk edilen çocukların anlattıklarını dinlediğimde... bir düşünmeden edemedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: Acaba annemi dinleseydim ben de bu çocukların ebeveynleri gibi mi olacaktım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: Bu yüzden terk edilen her çocuğa yardım eli uzatma kararı aldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: En kötüsü ne, biliyor musun? Kundakçılardan biri, içeri aldığım çocuklardan birinin babasıydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (Kadın yine gözyaşlarına hâkim olamıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: Kusuruma bakma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: Onlara fırsat vermeye çalıştım, onlara baktım. Sonu böyle olmamalıydı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: Çok özür dilerim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: Ölmeleri senin suçun değil
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: Başın sağ olsun
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: Haklı olabilirsin ama... yine de içimde bir boşluk var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: Aklıma bir soru geldi de... Durmadan onu düşünüyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: Ya ebeveynleri bu çocuklara karşı hiçbir şey hissetmediyse? Ya onları hiç sevmedilerse?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: Umarım... Umarım onlara az da olsa sevgi gösterebilmişimdir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: Teşekkür ederim... ama yine de kendimi darmadağın hissediyorum. Sanırım asla kendime gelemeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: Aklıma bir soru geldi de... Durmadan onu düşünüyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: Ya ebeveynleri bu çocuklara karşı hiçbir şey hissetmediyse? Ya onları hiç sevmedilerse?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: Umarım... Umarım onlara az da olsa sevgi gösterebilmişimdir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: İyi misin? Çocuğun nasıl?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: Sorun değil ama. Önemli olan, ilerliyor olmamız. Değil mi tatlım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: Kim bilir, belki bir haftaya orada oluruz! Ha ha ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: Peki sen nasılsın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: Biraz dinlensin de kendine gelir, merak etme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: Bu saatten sonra annesini pek umursamıyordur ama... öyle ya da böyle oraya varacağız!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: Hâlâ hayattaysa tabii! Hah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: Karım artık annesini pek umursamıyor gibi gelmeye başladı ama neyse. Haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: Herhâlde annesinin ne kadar tehlikede olabileceğini hatırlatmam gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: Kusura bakma ya, senin önünde böyle ayıp oldu . Çok uyuz hareket ettiği için sinir oluyorum da ondan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: Otur da hazırlan artık kadın! Daha ne kadar bekleteceksin beni? Hay!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: Ne oluyor burada?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: Hâlâ buradan gitme şansın var
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: Tetiği çekerim bak
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: Yavaş ol. Sen silahı bırak, ben de bırakırım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: Masum bir kadını öldürecek misin gerçekten? Bu kadar mı gamsızsın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: Sen bana ateş edersen ben de ona sıkarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: Benim suçum olmaz yani! Kanı senin elinde olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: Uyar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: Tamam be, gidiyoruz! Sakin olalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: Gidiyoruz, değil mi? Bu sefer geliyorsun, değil mi kahpe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: Tamam, tamam. Gidiyoruz. Üstümüze örtecek bir şey alıp yola çıkacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: Yüzümüzü bir daha görmeyeceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: Bir saniye...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: N''APIYORSUN LAN SEN?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (Adamı vuruyorsun, kadın da nasibini alıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (İkisi de kanlar içinde yere yığılıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (Kadın bir anlığına can çekişiyor ama artık çok geç)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (İkisi de öldü)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: Kafan basmıyor mu? Başka yolu yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: Gidiyoruz işte. Bu kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: Lan karı! Kendine bir battaniye al da gidelim hadi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (Çiftin battaniyeyi üstlerine örtüp dışarı çıkmasını izliyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: (Bir süre yürüyüp aniden yere yığılıyorlar)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: (Battaniyeden dumanlar yükselmeye başlıyor. Arkanı dönüyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: Uff, bıktım ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: Yalnız başına ne arıyorsun burada?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: Evim çok kalabalıktı. Çok gürültü vardı. Hiç rahat değildi. Kaçmak istedim. Dünyayı görmek istedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: Çantamı sırtıma geçirdim, yanıma bir iki gazoz ve atıştırmalık aldım, bir de okulda yaptığım bu dostluk bilekliğini taktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: Sonra da yola koyuldum. Annemler fark etmemiştir bile. Umurumda da değil zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: O günden beridir geziniyorum, milletin evinde kalıyorum. Açıkçası gayet de iyi gidiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: En azından kimse kafamı ütülemiyor, patron benim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: Uff, bıktım ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: Peki nasıl hayatta kalabildin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: Bir şekilde kaldım işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: Merdiven altında kaldım, terk edilmiş kulübelerde yattım, ağaçların altında uyudum. Nerede sıcaktan saklanabildiysem oraya gittim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: Ne bulduysam onu yedim. Yeri geldi meyve topladım, yeri geldi bakkaldan gofret çaldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: Ne bön bön bakıyorsun? Evet, hırsızlık yaptım. N''olmuş? Nasıl hayatta kalacaktım? Beni kimse işe almaz ki zaten. Neyse ne işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: Uff, ne var ya? Seni de mi soyacağımı sanıyorsun? Yok artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: Sorguya mı çekiyorsun beni? Yürü git başımdan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: Uff, bıktım ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: Daha ne kadar böyle yaşamayı düşünüyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: Uff, sana ne ya? Çözeceğim işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: N''oldu yani, burada kalmam çok mu battı sana? Evini mi soyduk, tuvaletini mi tıkadık? Ne yani? Niye hesap sorup duruyorsun bana?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: Ha, anladım... Sapıksın sen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: Senin gibi birini daha tanımıştım. Ağzı laf yapıyordu, bana kalacak bir yer ayarlamıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: Birlikte anime, film falan izlemiştik. Sonunda düzgün bir adam buldum sanmıştım ama yoooook...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: Sonra beni ellemeye kalkıştı. Sapık piç...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: Bana yaklaşmaya çalışırsan o elini koparırım. Kimse bana zarar veremez.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: Babam şerefsizin tekidir ama bana kendimi nasıl savunacağımı öğretti.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: Duydun beni. Geri bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: Uff, bıktım ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: O bahsettiğin adama ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: Sana ne ihtiyar? Sana karşı koyarsam diye bilgi toplamaya mı çalışıyorsun? Ha, söylesene? Neyse ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: Salak yerine koyma beni. Merakından sormadığının farkındayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: Evinde belalı biri olsun istemiyorsun, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: Ben belalı falan değilim. Seni soymam, pencerelerini kırmam. Düş yakamdan!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: Neyse…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: Bana ihtiyacın olduğu için beni içeri aldın, değil mi? O yarı çıplak herif seni kapmasın diye? Duydum, duydum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: Madem öyle... Uff, neyse ya! Neyi test edeceksen et, benimle konuşma yeter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: Uff, bıktım ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: Baban sana kendini savunmayı neden öğretti?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: Sapıkları dövebileyim diye. Öfkesini benden çıkarmak için de olabilir...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: Yumruk atar, yumruk attırırdı. Tek sıkıntı, kum torbası olarak beni kullanırdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: Bazen eğitim amacıyla döverdi ama ondan da nefret ederdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: Bazen de kendini kaybedip ağzımı yüzümü dağıtırdı. Annem hiç oralı olmazdı. Bakmazdı bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: Uff, umarım büyüdüğümde onlara benzemem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: Madem böyle davranacaktınız niye çocuk yaptınız ki? Çok saçma. Hayat bundan mı ibaret sahiden?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: Şimdi HEM güneşle HEM de Ziyaretçilerle uğraşıyoruz. Yeterince derdimiz yokmuş gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: İyi bir şey olmuyor mu hiç hayatta?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: Sanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: Zaten hâlimiz kötü, daha beter etmeye gerek yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: Her şey bittikten sonra... bence yaptıklarımız için birbirimizi affedebileceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: Şefkatimizi kaybetmediğimiz sürece insanlığımızı da kaybetmeyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: Sen hep böyle iyimser miydin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: Yere düşeni başkası kaldırır. Kötü gününde biri gülümser. Elindeki son ekmek dilimini paylaşır. Hayat budur işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: Önemli olan küçük şeyler. Birileri dünyayı daha iyi hâle getirmek için uğraştığı sürece tüm bunların bir anlamı olacaktır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: Her şey çok güzel olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: Hepsi geri dönsün ister miydin? Evin, ailen...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: Fakat her şeyin geri gelmesi... Emin değilim. Yas, hayatın bir parçası. Korkunç da olsa, canımızı da yaksa bizi güçlendirir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: Yanlış anlama, onlarla bir gün daha geçirmek için her şeyimi verirdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: Ama bunun bedeli öğrendiğim her şeyi, affedip devam edebilmeyi unutmaksa... Hayır, istemezdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: Vaktimiz sınırlı. Kaybettiklerimizin bizi yiyip bitirmesine izin vereceğimize elimizdekinin değerini bilmemiz gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: Gözünü dört aç. Herkes Ziyaretçi olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: Sen avcısın, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: Kolcu desek daha doğru olur evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: Ormanın ortasında yaşardım. Televizyon yoktu, sadece radyo vardı. Olan biteni oradan öğrendim zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: Kimseyi kapıdan içeri sokmadım. Orası benim hisarımdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: Ya bir Ziyaretçi gelseydi? Tatlı dille içeri girip ben uyurken boğazımı kesseydi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: Öyleyse burada ne işin var?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: Yalnız kalmak tehlikeli
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: O uzun boylu piç kurusunun bana dokunmasına hayatta izin vermem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: Onun yüzünden kulübemi bırakıp geldim zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: Sen de onu gördün, değil mi delikanlı? Bakışlarından belli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: Yalnız başına nasıl hayatta kalabildin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: Sen de o uzun, soluk tenli Ziyaretçi'yi gördün mü yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: Bir şekilde kaldım işte!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: Kalamasaydım şimdiye onlara yem olurdum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: Eskiden evine misafir almanın salaklık olduğunu düşünürdüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: Yalnız başıma daha güvende olacağımı sanırdım... Sonra o hergele çıkageldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: Hayatımda böyle bir yaratık görmedim ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: Yalnız başına nasıl hayatta kalabildin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: Sen de o uzun, soluk tenli Ziyaretçi'yi gördün mü yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: O çok uzun hikâye evlat. Bugün pek anlatasım yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: Sen yarın bana bira getir de anlatayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: Tek gören ben değilmişim demek ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: Evet, gördüm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: Yaşadıklarımı bir bilseydin delikanlı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: Anlatırım ama bu gece olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: Yarın bana bira getir, her şeyi anlatacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: Gözünü dört aç. Herkes Ziyaretçi olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: Ee, anlat bakalım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: Bira getirdin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: Evet (birayı ver)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: Ee, bira yok mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: Yok (birayı verme)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: Bu iş görür evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: Dediğim gibi, kulübede yalnız başıma oturuyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: Sonra bir gün bir adam çıkageldi. Çaresizdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: Bam güm kapıya vurmaya başladı, "Beni içeri al!" diye yalvarıyordu. Tabii, biz kaçın kurasıyız?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: Soluk tenli ve sarsılmış birisiydi. Bizzat ölümü görmüş gibiydi. Ormanın ortasında ne arıyordu, hiç bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: Önceden gördüğüm orman yürüyüşçülerine benzemiyordu, ben de ikilemesini söyledim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: Pencereyi kırmaya çalıştı ama silahım var deyince hemen kaçtı gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: Onu bir daha görmeyeceğimi düşünmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: Belki de ona yardımcı olmalıydın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: Onu içeri almalıydın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: Sonra ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: Sonra da onun peşinden gelen neyse kapıma mı dayansaydı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: Hayatta olmaz. Yeterince sorunum var zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: Peki
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: Sen pek konuşkan biri değilsin galiba?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: Pek bir şey anlatmadın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: Dur, tahmin edeyim. Bira verirsem devamını anlatacaksın, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: Bana hiç ahlak bekçiliği taslama evlat. Sen de insanları geri çevirmişsindir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: Çevirmesen bunca süre hayatta kalamazdın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: Evet ama orasını yarın anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: Peki
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: Sen pek konuşkan biri değilsin galiba?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: Pek bir şey anlatmadın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: Dur, tahmin edeyim. Bira verirsem devamını anlatacaksın, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: Yüzünü bir daha görmem diye düşünmüştüm ama... sonra beni buldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: Neyse, orasını başka zaman anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: Peki
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: Sen pek konuşkan biri değilsin galiba?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: Pek bir şey anlatmadın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: Dur, tahmin edeyim. Bira verirsem devamını anlatacaksın, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: Yarın bana bira getirirsen devamını anlatırım evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: Öyle çene çalmayı sevmem ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: Sen ağzımı açtığıma dua et, normalde hiç konuşmazdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: Sen yarın bana bira getir, ben devamını anlatırım. Anlaştık mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: Sabırlı ol evlat. Bu gözler neler gördü, bir bilsen...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: O anıları ayık kafayla hatırlayasım yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: Sen birayı getir, benim ağzım zaten açılır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: Senden de hiçbir şey kaçmıyor evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: Ben önemli bir şey anlatmadığım sürece konuşmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: Sen yarın o birayı getir, hikâyenin sonunu anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: Kusura bakma evlat... Ayık kafayla konuşmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: Sen birayı getir, o zaman anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: Gözünü dört aç. Herkes Ziyaretçi olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: Ee, hikâyenin sonu nasıl bitiyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: Anlatırım ama önce bana bira ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: Peki (birayı ver)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: Ee, bira yok mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: Yok (birayı verme)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: Sağ olasın delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: O eleman kaçtı işte, ben de kulübede kaldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: Yakacak odunum bitmişti, ben de mecburen dışarı çıktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: Bir kucak odun toplayıp kulübeye geri döndüm ama... tüfeğim yoktu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: Korkuya kapıldım. Ortalığı altüst ettim ama tüfeği bir türlü bulamadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: Sonra onu pencereden gördüm. Yine aynı eleman.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: Tüfeğim elindeydi ama... adam bir farklı görünüyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: Boyu daha uzundu, derisi sarkıyordu. Anadan üryandı, altında sadece pantolonu duruyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: Tüfeği iki eliyle tutup çat diye ortadan ikiye kırdı. Ağaç dalı kırar gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: Sonra orada durdu. Dik dik bana baktı. Sanki gözümü kırpmamı bekliyordu... Kırptığım gibi boynumu kıracaktı sanki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: Ama kırmadı. Öyle bakıp durdu. Kim en uzun süre gözünü kırpmadan duracak diye iddiaya girmiş gibiydik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: Sonra... şafak söktü ve şerefsiz herif bir anda kayboldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: İşte o an anladım. Burada silahsız, yalnız başına kalmak belanı aramak demekmiş delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: Hemen kalkıp gittim. Daha güneş doğmadan yola çıktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: En son kendimi burada buldum işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: Umarım tetiği çekme fırsatın olur evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: Kim bilir, belki mermiyle öldürülebiliyordur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: Seni neden öldürmedi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: Sence o şey ölümsüz mü?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: Koskoca bir FEMA birliğini katletti
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: Bilmiyorum evlat. Tüfeğimi oyuncakmış gibi kırıverdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: İstese aynısını bana da yapardı ama yapmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: Herhâlde bizimle alay etmekten zevk alıyor. Kedinin fareyle oynadığı gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: Bak, ben cesur biriyimdir ama o soluk şerefsiz...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: Beni tir tir titretiyor evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: Umarım öyle değildir evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: Ne derler bilirsin. "Kanı akan her şey ölür".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: Koskoca birlik onu öldüremediyse... biz hapı yutmuşuz zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: İstese burayı yerle bir eder, hiç de zorlanmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: Bak, ben cesur biriyimdir ama o soluk şerefsiz...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: Beni tir tir titretiyor evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: Bira yoksa anlatmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: Ayık kafayla konuşmayı sevmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: Yani evlat, hikâyenin devamını merak ediyorsan... bana bira getir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: Güneşin beni öldürmesi u-uzun sürer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: Kimseyi içeri alma, oldu mu annesinin gülü?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: FEMA seni neden kovdu? Neden seninle konuşmadılar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: Biliyorsam ne olayım annesinin gülü. O tulumlu adamları hiç anlayamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: Sağda solda millete emir veriyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: Bunlar kendilerini ne sanıyor ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: Bir bok bilmiyorlardır kesin. Burunları havada dolaşıyorlar sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: Senin kapını da çaldılar mı bakayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: Bir tanesi buralarda dolaşıp duruyor
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: Geberesiceler! Bunları tulumlarından çıkarıp doğru hapse tıkacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: Hâlimizden anlarlar o zaman.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: Binalara da mı musallat oluyorlar şimdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: Çocuklarınıza adam olmayı öğretmezseniz olacağı bu işte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: Bir kere yapsalar, hadi neyse. Gelip duruyorlar bir de.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: Hiç utanma yok bunlarda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: Kimseyi içeri alma, oldu mu annesinin gülü?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: Ailenden birini aldılar mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: Ohoo... Epeydir bana kimse ailemi sormamıştı annesinin gülü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: Bana Koca Ana derler. Bir sürü çocuğum var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: Hepsine kurban olurum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: Eve sığmıyor keratalar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: Kıyamam, kilitli kapıların ardında bu acibelerden saklanıyor zavallılarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: Soruma cevap vermedin
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: Aileni götürdüler mi yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: Ha...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: Kusura bakma annesinin gülü. Dalıp gitmişim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: O tulumlu alçaklar, bebelerimin hepsini alıp götürdü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: Yanlarına bırakmayacağım ama bak buraya yazıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: Senin ailenden kimseyi aldılar mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: Benim ailem yok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: Hayır
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: Ha...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: Kusura bakma annesinin gülü. Dalıp gitmişim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: O tulumlu alçaklar, bebelerimin hepsini alıp götürdü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: Senin ailenden kimseyi aldılar mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: Benim ailem yok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: Hayır
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: Öyle mi? O zaman evin niye bu kadar büyük?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: Bir de yalnız başınasın... Böyle olmaz ki annesinin gülü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: Evin büyükse ailen de büyük olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: Neyse, üstüne gelmeyeyim bari.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: Keşke bebeklerimi o karantina bölgelerinden alıp getirebilsem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: Demek size el sürmediler?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: Senin bebeler nerede o zaman?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: Kocaman evin var, yalnız yaşıyorum deme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: Neyse, üstüne gelmeyeyim bari.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: Tek istediğim, evlatlarımı o karantina bölgelerinden kurtarmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: Kimseyi içeri alma, oldu mu annesinin gülü?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: Çocuklarını nasıl kurtaracaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: Ben kurtarmayacağım ki! Onlar kendi başının çaresine bakar annesinin gülü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: Nasıl yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: Kendi başlarına mı kaçacaklar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: Toprağı moprağı kazar, bir şekilde kurtulurlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: Benim evlatlarımı öyle iki tel örgüyle hapsedemezsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: Topraktan çıkmazlarsa da oranın altını üstüne çevirirler. Kurban olurum onlara...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: Az kaldı, gelecekler. Koca Anaları onları bekliyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: Ne anlatıyorsun sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: Kafayı mı yedin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: Nasıl yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (Öldür)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: Vakit geldiğinde sizin duvarlarınız da çökecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: Kan gövdeyi götürecek güzelim. Sonra da o gelecek... Karnı çok aç olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: O tulumlu adamlar benim evlatlarımı dert etmeyecek artık. Daha büyük dertleri olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: Az kaldı, gelecekler. Koca Anaları onları bekliyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: Ne anlatıyorsun sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: Kafayı mı yedin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: Nasıl yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (Öldür)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: Yuvalarınızı yerle bir edeceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: Duvarlar yıkılacak, sokaklar kırmızıya boyanacak... Cesetlerinizi dağ gibi yığacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: Sürüne sürüne geliyorlar, seslerini duyuyorum. Az kaldı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: Bu ne demek şimdi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: Ziyaretçi misin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (Öldür)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: Yanık etin kokusu ne tatlıdır...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: Tulumlular da güzel pişiyor. Biraz kıtır oluyorlar ama tatları fena değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: Burada da bir sürü insan toplamışsın annesinin gülü. Çocuklarım güzelce karınlarını doyurur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: Sürüne sürüne geliyorlar, seslerini duyuyorum. Az kaldı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: Bu ne demek şimdi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: Ziyaretçi misin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (Öldür)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: Harika bir yer bulmuşum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: Kocaman bir ev, içi de bomboş. Herkese yetecek kadar yer var...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: Sürüne sürüne geliyorlar, seslerini duyuyorum. Az kaldı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: Bu ne demek şimdi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: Ziyaretçi misin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (Öldür)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: Hay, ben senin... İt herif!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: Hepinizi yakalayacaklar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: Gelin evlatlarım, anneniz size yeni bir yuva buldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: Sürünün gelin. Bu herifin bu eve ihtiyacı yok artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: Koca Ana bebeklerini görmek istiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: Gelin bana evlatlarım, bu ev bizim işimizi görür.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: Sürünün bebeklerim. Anneniz burada! Size yeni bir ev buldum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: Kocaman, sapasağlam, bomboş...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (ÖLDÜR)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: HAY BEN SENİN! Ver işte bana! Zaten sevmiyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: Yansın gitsin istiyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: HADİ, VER ANNENE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: Sana kurban olurum. Senin ne istediğini biliyorum ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: Ölüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: Ne baktın kardeş?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: Sen niye insanları hayvan gibi görüyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: Bak ben sana bir şey soracam. Sen bizi ne sanıyon?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: Hayvanları öldürüyoz, etlerini yiyoz. Hiç de vicdan azabı çekmiyoz. Gayet doğal geliyo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: Bu toplum var ya bu toplum, bize tasma takıyo. Neyse ki o günler geride kaldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: Nasıl yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: Bu durumumuzdan memnun musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: Böyle çok iyi oldu. Toplum yolunu şaşırdıydı, şimdi her şey net.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: Sürü var, başında da lider var. Sürüyü tehdit eden ölür. Bana uyar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: En kötüsü de ne biliyon mu? Kurt kılığında dolaşan kuzular.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: Medeniyet hayvan sürülerine indirgensin mi istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: Kuzu kılığında kurt değil miydi onun doğrusu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: Yok yok. Millet artık maske takmıyo, orası iyi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: Ama bu kuzular var ya. Her şeyi bozuyolar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: Kurt postu giyip rol yapıyolar. Adama benzemeye çalışıyolar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: Toprağın altında saklanıyolar bi de. Adamsanız teke tek gelin lan!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: Ama işte sürü topluyorsan aradaki kuzuları ayıklamayı öğreneceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: Medeniyet hayvan sürülerine indirgensin mi istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: Kuzu kılığında kurt değil miydi onun doğrusu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: Sen istemiyon mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: Bu "normal" toplumda kuzuları ayırt edemezdin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: Millet laga luga yapıyodu, her şeyin bi'' kuralı vardı. Gerekeni yapacağına boş boş tartışmalara giriyodun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: Bu yüzden bi'' lider lazım bize. Soru sormak yok, oy vermek yok. Yap dedi mi yapacan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: Lider dediğin zafiyet göstermeyecek. Anca öyle sürü hayatta kalır. Bu kadar basit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: Yok yok, sizin o Ziyaretçi dediğiniz dangalakları diyom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: Fare gibi yerin altına saklanmışlar, bizi gafil avlayacaklar tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: Sonra yerden çıkıp insanın vicdanına oynuyorlar. Merhametimizi kullanıp hayatta kalıyolar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: Biz de o yüzden diş gösteriyoz ya. "Asıl canavar biziz" diyoz ki bizi öldürmesinler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: Ne baktın kardeş?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: Niye silahıma bakıp duruyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: Senden lider olur ağabey. Sen adamı hizaya getirmeyi biliyon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: Evin de fena değil ha. Ferah, millet gelip duruyo ama bu topladığın insanlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: Ne olmuş onlara?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: Aramızda Ziyaretçi mi var diyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: Ne kadar zargana varsa toplamışın ağabey. Hepsi vasıfsız bunların.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: Bu moruklar, bebeler, hastalar ne işine yarayacak?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: Sürü dediğin güçlü olur. Böyle hayatta kalır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: Ee, n'apabilirim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: Kovayım mı onları?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: Ben kurtluk taslayan kuzuları demiyom ağabey. Cılız kurtları diyom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: Sürün omurgasız ha. Millet elini kolunu sallaya sallaya girip çıkıyo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: Güçlüleri seçecen, güçsüzlerle hiç uğraşmayacan diyom yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: Ee, n'apabilirim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: Kovayım mı onları?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: Bu vasıfsızlardan kurtul artık başkan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: Öldür hepsini. Herkesin gözü önünde. İyice anlasınlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: Anca böyle lafını geçirirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: Karşısında adam ölünce irkilmeyenleri de alacan, sürüne katacan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: Onlar yanında kalacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: Ben katil değilim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: Ben sadece Ziyaretçileri öldürürüm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: Bunlara müsamaha edersen bi'' daha laf geçiremezsin ağabey. Sana saygı duymazlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: Ha merhamet ha zafiyet, aynı şey.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: Acımasız olacan. Ziyaretçi mi? Vuracan. Cılız mı? Vuracan. Moruk mu? Vuracan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: Anca böyle senden korkarlar. Anca böyle sana hürmet ederler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: Ben katil değilim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: Ben sadece Ziyaretçileri öldürürüm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: Sen kimi kandırıyon başkan? Bakışlarından belli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: Katilsin sen, katil. Soğukkanlısın. Elinde kan yokmuş gibi yapma ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: Bu sokakların sahibi bendim eskiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: Millet benden korkardı. Bana saygı duyardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: Sen ruhun çürümesi ne kadar sürer, bilin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: Benimki çürüyeli çok oldu. İrin akıyor resmen, irin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: Bi'' kere taksicinin teki beni arabaya almadıydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: Ona bi'' şey demeyeydim adım çıkardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: Ben de ağzını yüzünü dağıttım herifin. Kırılmadık kemik bırakmadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: Oğlu dersini aldı ama. Millet de bana saygı duymaya devam etti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: Bak ne diyecem. Bu vasıfsızlara bakıcılık yapmayı bırak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: Sokaklar eskiden benden sorulurdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: Millet benden korkardı. Bana saygı duyardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: Sen ruhun çürümesi ne kadar sürer, bilin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: Benimki çürüyeli çok oldu. İrin akıyor resmen, irin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: Bi'' kere taksicinin teki beni arabaya almadıydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: Ona bi'' şey demeyeydim adım çıkardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: Ben de ağzını yüzünü dağıttım herifin. Kırılmadık kemik bırakmadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: Oğlu dersini aldı ama. Millet de bana saygı duymaya devam etti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: Ne baktın kardeş?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: Sürü, sürü deyip duruyorsun. Senin sürün nerede o zaman?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: Sen niye sürü topluyon ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: O uzun boylu, soluk Ziyaretçi beni öldürmesin diye
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: İnsanlara yardımcı olmak için
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: Evde yalnız kalmayı sevmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: Bu insanların bir lidere ihtiyacı var da ondan
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: İlk ben sordum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: Kendini kurtaracan diye mi topladın milleti buraya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: Senden lider mider olmaz. Senden anca ödlek olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: Bu sürüye sağlam bir lider lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: Yerini ben alacam o zaman. Senden bir bok olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: Çok iyi kalplisin ha. Bir o kadar da malsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: Herkesi kurtaramazsın. Öyle ya da böyle birini reddedecen, kaçarı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: Yine de senden lider olur. Sağlam adamsın. Benden sana zarar gelmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: Bu kadar mı? Yalnız kalmaya götün yemiyo diye mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: Böyle lider mı olur lan? Senin de kuzulardan farkın yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: Lider dediğin böyle konuşur işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: Benden sana zarar gelmez ağabey. Bu saatten sonra götüm yemez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: Yok sana cevap mevap. Bilmesen daha iyi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: Zaten diyeceğimi dedim. Sıra sende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: Sürünün başına sen geçmeyeceksen ben geçerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: Siktir lan!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: Sen kendini ne sanıyorsun lan?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (Silahını çek)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: Kaybol yoksa sıkarım topuğuna
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: KES LAN İT. Bittin oğlum sen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: Madem liderlik yapamıyon ne diye başa geçiyon?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: Bak, yürü git yoksa indiririm seni ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: Ben sürü nedir bilirim. Kurallarını bilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: Böyle yumuşak lider mı olur lan?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: Bak, yürü git yoksa indiririm seni ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: Öyle mi lan?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: Tek emanet sende mi var sanıyon? Gerzek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: O eli bi indir, kimsenin canı yanmasın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (Ateş et)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (Silahını indir)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: Geber lan şere...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: Vay it oğlu it... Harbi vurdun lan beni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: Helal lan sana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: Adam gibi vuramadın ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: (Fırsattan faydalanıp silahını çekiyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: (Seni nişan alıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: (Neyse ki pompalıyı çekip ateş edebiliyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: Yani FEMA yüzünden mi işsiz kaldın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: Bana sorarsan FEMA doğru olanı yapmış
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: Dürüst olmak gerekirse... Hastaneler kapandıktan sonra karantina bölgelerinden birinde triyajda görev aldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: İnsanlara yardım etmek istemiştim. Benim işim bu. Öyle pat diye bırakamazdım ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: Belki de... Yok. Kusura bakma, bu konuyu açmaya hazır değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: Bilip bilmeden konuşuyorsun, sözlerin çok kırıcı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: Belki de... Yok. Kusura bakma, bu konuyu açmaya hazır değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: Ee, bana söylemek istediğin neydi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: Bana sorarsan FEMA iyi iş çıkarıyor
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: Tüh. Ben tam tersini düşünüyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: Onlarla bir süre çalıştım ama onlara güvenmek için hiçbir sebebim yok. Özellikle de gördüklerimden sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: Gördüğüm kadarıyla orada çalışan doktorlara hiçbir şey anlatmıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: Gerçekten bu "belirtileri" veya ne anlama geldiklerini açıklayamayan bir kuruma mı güveniyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: Tüm bu yaşadıklarımızdan sonra... FEMA''ya nasıl güvenebilirsin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: Açıkçası senden bunu beklemezdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: Güzel. Ben de güvenmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: FEMA''nın amacı ne, ben de anlamıyorum açıkçası. Onlarla bir süre çalıştım bir de, ona rağmen yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: Neyi amaçladıkları beni ilgilendirmiyor. Ben insanlara kendi bildiğim gibi yardım etmeyi seçtim. Kuralları batsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: Asıl sıkıntı dürüstlüktü. Ne iş çevirdikleri hiç belli değildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: Bu "belirtilerin" nereden çıktığını, ne anlama geldiğini bize hiç anlatmadılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: Elimize bir kılavuz verip bıraktılar. Kime Ziyaretçi etiketi yapıştıracağımızı, kimi geçireceğimizi söylediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: Artık doktor gibi hissetmiyordum. Damga basan gümrük memurlarından farkım kalmamıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: Bu yüzden sahte rapor çıkarmaya başladım. İnsanların kaçmasına yardım ettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: Muhtemelen sormak istediğin sorular vardır ama mahsuru yoksa yarına bırakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: Kusura bakma, bugün daha fazla konuşasım yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: Sonra orayı terk etmeye karar verdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: Neden karantina bölgesini terk ettin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: Bir... olay oldu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: Güneş yeni doğuyordu. Tam eve gidecekken FEMA memurlarından biri beni çağırdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: O an kalbim küt küt atmaya başladı. Dizlerim boşaldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: Bana "Buraya bak!" diye emir verdi. O saatten sonra zaten kaderimi kabullenmiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: Tüfeğini bacaklarıma doğrulttu ve "Sakın kımıldama!" dedi. Bana bakmaya devam etti ve...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: Dilimi çıkarmamı söyledi. Ziyaretçi miyim, değil miyim ona bakacaktı. Beni vurur diye ödüm kopmuştu, ben de çıkardım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: Sonra da... yüzüme güldü. "Dilden anlaşılmadığını bilmiyorsan ne işin var burada?" diye dalga geçti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: Hayatımda ilk defa bu kadar korkmuştum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: O an insanları kurtarmak aklımdan çıktı gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: Kaçtım. Korkak gibi kaçtım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: Çok utanıyorum çok... O zavallı insanları terk edip gittim. Aynada kendime bakamıyorum bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: Seni yargılamıyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: Hâlâ insanlara yardım edebilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: Rezil herif. Çık git evimden
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: Anlayış gösterdiğin için teşekkür ederim. Biraz da olsa içim rahatladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: Sonuna kadar dayanabilseydim daha birçok kişiyi kurtarabilirdim, bunu aklımdan bir türlü çıkaramıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: Maalesef ki edemem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: Tüm araç gereçlerimi karantina bölgesinde bıraktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: Artık hiçbir işe yaramam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: Benden bir tedavi bekliyordun, farkındayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: Ama benim gibi bir ihtiyar sadece ellerini kullanarak ne yapabilir ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: Kusura bakma evlat, seni hayal kırıklığına uğrattım. Ziyaretçilere karşı tamamen acizim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: Merak etme, yine de kalabilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: O zaman buyur, kapı orada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: Galiba... haklısın. Ben yavaştan kalkayım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: Anlayış gösterdiğin için teşekkür ederim. Biraz da olsa içim rahatladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: Zaten FEMA eninde sonunda sahte raporları fark ederdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: Yine de biraz daha cesur olsaydım daha fazla insanı kurtarabilirdim ve bu içimi kemiriyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: Ölene kadar bu vicdan azabından kurtulabileceğimi sanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: Sanırım haklısın. Benim gibi bir ihtiyarın burada işi yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: Niye sordun ki? Neden FEMA''ya güvenmediğimi mi merak ediyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: Şöyle bir hipotezle başlayalım...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: Ziyaretçilerin bir tür virüs olduğuna inanıyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: Ben var olduklarına inanmıyorum
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: Hayır ama ne olduklarını bilmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: Evet, inanıyorum
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: Madem böyle düşünüyorsun o zaman niye bu kontrollerle uğraşıyorsun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: Beni kandırmaya çalışma.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: Peki…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: Anlıyorum. Ne yazık ki ben de tam olarak ne olduklarını bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: Bildiğim tek şey, onların kesinlikle bir virüs olmadığı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: Maalesef seni hayal kırıklığına uğratacağım. Muhtemelen değiller.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: Gayet normal olan bir insanın birden değiştiğini gördün mü hiç? Gözlerinin önünde Ziyaretçi''ye dönüştüğünü?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: Görmedin tabii. Böyle bir şey asla görülmedi çünkü.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: Şunu anlaman gerek: FEMA ne yaptığını bilmiyor. Biliyormuş gibi davranıyorlar sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: Hastaneleri kapattılar, herkesi karantina bölgelerine yolladılar... ama neden?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: İnsanlara yardım ettikleri mi var? Kimseyi tedavi ettiler mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: FEMA milleti toplayıp kafese tıktı, o kadar. Şimdi ne isterlerse onu yapıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: Öyleyse neden FEMA için çalıştın?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: Bıktım bu saçmalıklardan. Çık dışarı
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: Öyle oturup insanların teker teker öldürülmesini seyredemezdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: Bu yüzden FEMA''ya katıldım. O zavallıları karantina bölgelerinden kurtarmak için.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: İnsanları muayene ettim, teşhis koydum. Sonra özgür kalmaları için sahte rapor hazırladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: Senin yüzünden Ziyaretçiler de kaçmış olabilir
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: Ne olayı?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: Maalesef buradan da kaçman gerekecek
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: Keşke hikâyeyi bir de benden dinleseydin...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: Madem öyle evinde yer işgal etmeyeyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: Ne yapmamı isterdin? Onları ölüme terk etmemi mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: Benim Hipokrat Yemini''m var. İnsanları korumak için elimden geleni yaparım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: Nihayetinde benim de karantina bölgesinden kaçmam gerekti. Ne yazık...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: Çalıştığım bölgede bir olay oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: Ne dedin sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: Yardım etmese miydim? Sırf yardım ettim diye beni kovacak mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: Bunu söyleyeceğimi hiç düşünmezdim ama sen FEMA''dan da betersin. En azından onlar insanlara yardım eder gibi davranıyor. Sen...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: Burada daha fazla kalamam artık. Eline bakan insanların sonu ne olacak, düşünmek bile istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: Ağzındaki dikişleri kendin mi söktün?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: Ne dediğini anlamıyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: Sen beni anlıyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: Сени анламыйорум. Не йападжагыз биз?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: Ортак дил ми уйдурсак?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: Biz seninle nasıl iletişim kuracağız?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: Бен сенин дедиклерини текрар едейим, сен де бана тепки вер.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: Ен азындан бен не дедигими анламыш олурум.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: Ne nasıl?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: Bir şey mi sormaya çalışıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: Хала анламыйорум ама галиба сен бир шей сордун.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: Сору му ки аджаба?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: Хала анламыйорум ама галиба сен бир шей сордун.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: Сору му ки аджаба?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: Selam, nasılsın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (Omzunu sıvazlayıp ağzındaki yaraları işaret ediyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: İyi misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: Canın yanıyor mu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: Буну текрар едебилир мисин?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: Eeğğğii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: İğğğğ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: İğyyii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: Агıз? Белки ише йарар.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: Аджаба yлкемде де бензер бир дурум му вар?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: Там бир кабус.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: Eve nasıl döneceksin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (Ellerini kafanın üzerinde buluşturup evin çatısını taklit ediyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: Ев ми? Ев ми дедин?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: Аркадашымы зийарете гелмиштим ама сонра бoйле олду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: Табири джаизсе сıчтıк биз.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: Seni eve nasıl göndereyim? Uçakla mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: Gemi biletlerine baktın mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (Kollarını iyice açıp kanat çırpar gibi yapıyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: Учак мı? Хала учак вар мı ки?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: Öгренсем ийи олур аслында.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: Белки гери дoнменин бир йолу вардıр.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (Elinle dalgaların üzerinde ilerleyen bir gemiyi taklit ediyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: Не бу? Геми ми?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: Хала геми вар мı ки? Бир бакайым, саг ол!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: Neden bu kadar heyecanlı duruyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (Gülümseyip ağzını gösteriyorsun, sonra onun ağzına işaret ediyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: Ха, буну дийорсун.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: Бана тренлерин хала фаал олдугуну сoйледилер, инанабилийор мусун?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (Bir elini diğer kolunun üzerinde gezdiriyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: Biri gelip seni arabayla alabilir mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: Сени анламыйорум кардешим.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: Йарıн еве гидийорум! Йани ен азындан истасйона.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: Бу гедже йола чıкаджагым. Гoрyшyрyз!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: Bağy bahy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: Tren mi demeye çalışıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: Bir yere mi gidiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: Кусура бакма, анламадым.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: Йарын истасйона гидип кендим гoреджегим!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: Белки де герчектен еве дoнебилирим...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: BILŞINSS!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: Sükûnet sonesi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: Elin nasıl?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: Hâlâ atıyor olsa da beher hissiyattan mahrum. Tüm ısısını yitirmiş; geriye kalan yalnızca hazin bir acı, hayalî bir soğuk...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: Ancak bu, melhuz olandır zira benim tek arzum, o muhteşem günü tecil etmektir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: Bir zamanlar bir hanıma âşıktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: Birlikte geçirdiğimiz vakit çok kıymetliydi. Sükûnet içinde otururduk fakat onu tamamen anlardım. Sonra idrak ettim ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: Kendimi kandırıyordum. Onu aslında hiç tanımıyordum. Belki de kendimi kandırıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: Ancak yine de bir gün sevdalı değil, kara sevdalı olacağımızı ümit ediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: Sükûnet sonesi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: Bana o kızı anlat
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: Gözlerinde daima o soğuk, soluk ay ışığı yanardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: Felaket''in bizzat karşısavıydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: Ama hiçbir enfes güzellik yoktur ki içinde bir parça tuhaflık ihtiva etmesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: Gizlerini gün yüzüne çıkarmanın hasretini çekerdim o kızın...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: Artık o, benim anıtımdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: Yola düştüğümde bana yol gösterecek ışığımdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: Sükûnet sonesi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: Bu kızla nasıl tanıştınız?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: İntizar eden, o vakit izhar etti; acımasız ve donuk bir septisemi beni fethedecekti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: Donuk bir perva bedenimi kuşattı. Yok olup gidecektim; ırak bir günde değil, aylar içerisinde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: Peşi sıra Ziyaretçiler pençeleriyle topraktan yükseldi. Onu orada buldum, terk edilmiş duvarların ardında...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: Soluk ketene sarılı bir kız, karşımda akıl almaz bir cemal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: Beniâdemin yalnızca kendini müdafaa ettiği bu acımasız cihanda bu güzelliğin değerini bilen... bir ben vardım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: "Pek garip ki yaşasın, pek nadir ki ölsün" deyimini duymuş muydun hiç?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: Kulağa ne kadar doğru gelse de... Narin bedenini kollarıma alıp onu eve götürdüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: Mahşer günü geldiğinde ne yaptıysam sevgimden yaptım, diyebileceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: Sükûnet sonesi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: Kız şimdi nerede?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: Kendimi onun güzelliğini yakalamaya; sükûnetinin pür, korkutucu kuvvetini hissetmeye adadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: Ta ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: Sarıya bürünmüş meçhul şahıslar huzurumuzu bozana dek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: Onu zorla ellerimden aldılar, uzaklara götürdüler. Sanırım sebebini ikimiz de biliyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: Ne yazık... Onu büsbütün idrak etme fırsatım olamadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: Onu anmak, hatırat şarabından yudum almak gibi geliyor artık...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: İnsanlar "dünyayı kurtaracağız," diye yaygara koparıyor ama bir türlü hemfikir olamıyor. Aslında cevap çok basit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: Çözüm, sükûnette. Güzellikte. Keşke şunu algılayabilsek...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: O kız beni eğitmeye çalıştı ama öğrendiğim tek şey durgunluk oldu. Melanetin arasındaki zarafet...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: En azından artık... onun peşinden gitmeye hazırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: Çekinme birader, sor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: FEMA hâlâ peşinde midir sence?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: Umarım değildir, ne diyeyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: Öyle FEMA''nın ayağına giderek mallık ettim, doğruya doğru. Beni de yakalamaya çalışacakları belliydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: Yolcumu alıp beni salarlar sandıydım işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: Adamlar gitti arabamı aldı, beni de vuracaklardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: Ama ne yapaydım birader? Herif Ziyaretçi''ydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: Yolcun ya insandıysa?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: Yapabileceğin bir şey yoktu
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: Öyle deme birader.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: Zaten vicdan azabı çekiyorum burada. Sen de yaramı deşme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: Sen de doğru dedin. Elim kolum bağlıydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: Eskiden ne güzel direksiyonun başına geçiyorduk, işimize bakıyorduk. Hiç kafamızı yormuyorduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: Şimdi bu Ziyaretçiler çıktı ya... Aldığın yolcu kafana mı sıkacak bilemiyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: Amaan...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: Çekinme birader, sor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: Ne kadar zamandır taksi şoförüsün?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: Epeydir bu işteyiz. Artık durağa çalışmıyorum, patron benim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: FEMA, sivillerin istediği gibi dolaşmasını istemiyor tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: Ama bu kargaşa eninde sonunda bitecek sonuçta. Her türlü para lazım olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: Millet iyi para veriyor artık. Risk de yüksek tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: Gece araba kullanmak da iyi geliyor. Çocukluğum gözümün önüne geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: Benim peder de taksiciydi. Ben de onun yolundan gitmek istedim işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: Pederi it gibi yolun kenarında bıraktılar, hiç umursamadılar... Bizim sonumuz da öyle olmasın da.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: Şansımız yaver gidecek hayırlısıyla...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: Çekinme birader, sor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: Bugün bezgin görünüyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: Amaan, bir şey yok...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: Arabamı aldılar ya, o kafama takıldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: Nasıl bir araban vardı?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: Arabanı niye bu kadar seviyordun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: Cillop gibi bir makineydi. Klasik arabaydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: Rengi sapsarıydı, jantlar krom, şasisi kıvrımlı...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: Alıp götürdüler işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: Bu FEMA''yı var ya bu FEMA''yı... O araba her şeyimdi lan benim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: Pederden kalmıştı. O da taksiciydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: Çocukken geceleri arabayla gezinirdik, çok severdim. Arka koltukta uyuyakalırdım, o da beni gezdirirdi. Sonra bir gün...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: Şansı yaver gitmedi diyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: Çekinme birader, sor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: Babana ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: Bu konuyu açmayı sevmiyorum ama... sen güvenilir bir abiye benziyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: Bir gün annem iş gezisine gittiydi, babam da beni taksiyle gezmeye çıkardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: Sonra bir yolcu aldık, hiç unutmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: Jilet gibi bir abiydi. Başı keldi, şeytan gibi bir gülümsemesi vardı...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: Mahalledeki herkes tanırdı adamı. Çocuk hâlimle ben bile tanırdım, o kadar. Öyle bir adamdı ki kimse hayır diyemezdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: Ama benim peder şerefli adamdı. O gün bir karar aldı... O aldığı karar da hepimizi yaktı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: Şeytan herif hepimize bedelini ödetti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: Yuvamızı kaybettik. Durmadan taşınmak zorunda kaldık.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: Elimizde çok para olmadığı için peder o kullandığı taksiyi elden çıkarmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: Sonra borçlar birikti durdu. Keşke satsaydım demeye başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: "Araba lanetli," dedi. Bize kötü şans getirdiğini söyledi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: Asıl olayı anlayamadı işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: Başımıza gelenlerin suçlusu o araba değildi, babamın gururuydu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: Verdiği karar yüzünden eve ekmek getirmek için küçük yaşta çalışmak zorunda kaldım. Ama var ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: Yine de seviyorum onu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: Özledim seni baba.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: Çok zahmet olmazsa... Onu bir arayabilir misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: Numarası {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: Ona iyi olduğumu söyle, yeter. Normalde ben hallederdim ama... yerimi öğrenmesinler şimdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: Şu hâlimize bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: Şimdi ne var?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: Bariz değil mi? Hâlâ kira sözleşmesi imzalamadık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: Onu nasıl yapacağız peki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: Şimdi ne önemi var ki bunun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: Nasıl yani, gerekli evraklar hazırda yok mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: O zaman en kısa sürede bir notere gidip almanı öneririm. Şu hâle bak ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: Dalga mı geçiyorsun sen? Noteri nereden bulacağım ben şimdi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: Sen git o zaman
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: Benimle düzgün ve saygılı bir şekilde konuşursan da sevinirim. "Evet efendim," desen yeterli olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: Millette hiç saygı, nezaket kalmamış...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: Peki, sen ne dersen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: Belanı mı arıyorsun sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: Harita kullanmayı da biliyorsundur herhâlde. Zor bir iş değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: Bir de bak, rica ediyorum, bana "efendim" de ve saygıdan ödün verme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: Peki, sen ne dersen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: Belanı mı arıyorsun sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: Neden ayak işlerini ben yapıyormuşum? Bir de benimle konuşurken "efendim" diyeceksin!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: Ben saygıdeğer bir vatandaşım, tamirci çırağı değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: Peki, sen ne dersen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: Belanı mı arıyorsun sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: Bilerek yapıyorsun, değil mi? İnsan en azından rol yapar be.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: Öncelikle anayasanın 21. maddesi bir insan olarak haysiyetimi koruyor, dolayısıyla sözlerine dikkat et.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: İkinci olarak da bana biraz saygı göstermeni öneriyorum. Yoksa... elimden bir kaza çıkabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: Şu hâlimize bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: Uzatmasan mı artık?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: Hayatta olmaz. Yasal olarak kira sözleşmesini imzalaman gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: İmzalayacak kalemim bile yok ki
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: Dalga geçiyorsun herhâlde
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: Hım... Yazık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: Korkarım ki 131. maddeyi ihlal ediyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: Sinirimi bozmaya başladın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: Kanun saymaktan sıkılmadın mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: 131. madde bu sözleşmeyi zorunlu kılıyor bu arada, haberin olsun. Ben sadece vatandaşlık sorumluluğumu yerine getiriyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: Beni harbiden sinir etmeye başladın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: Kanun saymaktan sıkılmadın mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: Hah, hakaretler de tam vaktinde başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: Bu da 5.61 sayılı idari yasanın altına giriyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: Sen devam et, benim için hiç sorun değil. Gün gelir devran döner.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: Hayır, bu arada. Ne yasalardan NE DE anayasadan asla sıkılmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: Ben haklarımı biliyorum kardeşim! SEN cahil olmayı seçiyorsun diye ben haklarımı bilmeyeceğim diye bir şey yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: Bir de sana hatırlatmış olayım, artık benimle düzgün konuşacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: Cık cık cık... Hiç ders almaz mı insan?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: Şu hâlimize bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: Yine ne var?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: Evinde bir ateşli silah olduğunu fark ettim. Ruhsatını göster bakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: Seni hiç alakadar etmez
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: Senin derdin ne?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: Ruhsatın yok demek? Tepkinden böyle anlaşılıyor en azından.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: Elinde silah var diye kendini kanunlardan üstün mü sanıyorsun yani, bu mudur?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: Herkesi sorguya çekebileceğini ve asla sorgulanmayacağını mı düşünüyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: Çok yanılıyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: Aman, neyse ne. El elden üstündür...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: Yeter artık. Zaten işim başımdan aşkın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: Şu zırvalıkları bırak artık
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: Tek amacım, karşımdakinin kim olduğunu anlamak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: Hemen savunmaya geçtiğine göre canını sıkmışım. Bu da demek ki ruhsatın yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: Kendini yasalardan üstün görüyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: İnsanları istediğin gibi tehdit edebileceğini, kimsenin seni eleştiremeyeceğini sanıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: Ancak yanılıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: Aman, neyse ne. El elden üstündür...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: Yeter artık. Zaten işim başımdan aşkın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: Şu zırvalıkları bırak artık
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: Ah, seni zavallı... Kimse seni sorguya çekmiyor, kimse Ziyaretçi misin diye kontrol etmiyor. Senin de işin zor tabii...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: Peki kimin yaşayıp kimin öleceğine karar verme hakkını sana kim verdi? Ha? Kim verdi sana bu yetkiyi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: Biz burada bir sonraki kurbanın olmayalım diye dua ederken sen benden EMPATİ mi bekliyorsun? Yok daha neler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: Şimdi ağzımı bozmak istemiyorum ama senin anlayacağın dilden konuşursak bu testler "boktan" değil mi zaten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: Sağda solda gezip millete katil muamelesi ediyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: Kimse asıl katil kim bilmiyor sanki. Belki de... Ziyaretçiler gerçek değildir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: Bu durumda sen ne oluyorsun peki? Manyağın teki oluyorsun. Kargaşadan faydalanarak kana susamışlığını gideriyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: Tabii, millet de radyodaki paniği duyup boka üşüşen sinekler gibi kapına koşuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: Söyle bakalım, bu olayların en başında evine sığınan kaç kişi hâlâ hayatta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: Ben de öyle düşünmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: Şu hâlimize bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: Hâlâ burada mısınız efendim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: İnanılmaz... Bana saygı göstermeyi başardın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: Maalesef ki çok geç oldu. Burada gördüğüm her şeyi ihbar edeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: Neyi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: Kime?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: Artık beni kandıramazsın. Ben senin kim olduğunu biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: Burası senin evin değil. Tabii, tabii. Kesin ev sahibini öldürdün ve kimliğini çaldın. FEMA''yla iletişime geçeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: Doğru duydun, senin peşine düşecekler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: Siktir lan oradan
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: Seni bir güzel susturacağım ben, dur sen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: Federal Emniyet ve Müdahale Ajansı''na. Kısacası FEMA''ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: İlk başta basit bir sözleşmeyi bile imzalamak istememeni görmezden geldim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: Ancak seninle konuştukça olayı iyice anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: Şimdi tüm taşlar yerine oturdu. Burası senin evin değil. Sahtekârsın sen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: Hatta ZİYARETÇİ''sin sen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: Bavullarını topla. Bu gece seni almaya gelecekler!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: Siktir lan oradan
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: Seni bir güzel susturacağım ben, dur sen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: Seni ihbar edeceğim, seni almaya gelecekler. Bekle sen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: Tabii tabii. Defol buradan
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: Bittin oğlum sen (silahı çek)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: Beni susturabileceğini mi sanıyorsun? Kolay gelsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: Bir saniye... Nasıl ya? Kafayı mı yedin sen? Bu yaptığın suç!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: Hayır, hayır... Bunu kesinlikle yanına bırakamam!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: FEMA gelene kadar kılımı bile kıpırdatmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: Yaptığın her şeyi anlatacağım. Ne kadar tehlikeli biri olduğunu söyleyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: Bir saniye... Nasıl ya? Kafayı mı yedin sen? Bu yaptığın suç!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: Buna cüret edemezsin!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: Git yoksa vururum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: Gitmezsen kafana sıkacağım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: Bana başka seçenek bırakmadın
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (Ateş et)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: FEMA''dan kaçmana asla izin vermem. Cesedimi çiğnemen gerek!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: Seni eninde sonunda yakalarlar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: Sen de bana bırakmadın!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: ZİYARETÇİ''SİN SEN! KATİLSİN! İNSAN DEĞİLSİN!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: HAYIR! BU YASALARA AYKIRI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: AAAAHHHHH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: Bana sağlam bir ganimet lazım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: Mal toplama işi nasıl gidiyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: Ben burayı boş sandım, ondan gizlice girmeye çalıştım. İçeride insan yaşadığını ne bileyim ben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: Ben yaşayanlardan çalmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: Mantıklı değil mi? Düşünsene, ölü herif sırtındaki montu n''apsın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: Gebermiş gitmiş zaten. Eşyaları öylece duruyor. Ben yaşıyorum hâlâ. Bari benim veya bir sevdiğimin hayatını kurtarmış olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: Sevdiğin birini kurtarmak için sen de ceset soyardın. Aksini söyleyebilir misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: Ölüler çok kutsalmış gibi davranmayı bıraksak yavaştan hiç fena olmaz bence.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: Bana sağlam bir ganimet lazım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: Neden toplayıcı oldun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: Ya ne yapsaydım? Milletin canını mı yaksaydım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: Ben daha sakin bir çözüm buldum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: Ölüler karşılık vermiyor sonuçta. Mallarını bırakıp gidiyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: Benim amacım insanlara zarar vermek değil. Tek istediğim hayatta kalmak. Belki de ara sıra insanlara yardımcı olmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: Bana sağlam bir ganimet lazım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: Mal toplarken nelere denk geldin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: Çok şey gördüm, şimdi saysam bitmez...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: Bir düşüneyim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: Bir keresinde terk edilmiş bir kütüphane bulmuştum. Tozlu kitaplar raflarda duruyordu. Sanki millet geri gelecekmiş gibi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: Bir keresinde de acemi bir sanat galerisi bulmuştum. Tablolar hâlâ asılıydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: Bir kere de... bir gün batımı gördüm. Sıradan bir gün batımı değildi ama. Gökyüzüne resmedilmiş gibiydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: Artık millet durup gökyüzünü seyretmekten korkuyor ama eskiden öyle miydi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: O normal günlerimizi çok özledim be. Erkenden uyanırdım. Sokaklar boş olurdu. Yavaştan sis inerdi, çimler daha kurumamış olurdu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: Bir de güneş vardı... İlk doğduğunda öyle bir parlak olurdu ki günün güzel geçeceğini vadederdi âdeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: Şimdi şu hâlimize bir bak. Güneşe düşman olduk. Ne oldu da bu hâle geldik biz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: Keşke birisi bir açıklama getirebilse. Bir içimiz rahatlardı en azından.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: Bana sağlam bir ganimet lazım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: Mal toplamıyor musun artık?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: Yok, hâlâ topluyorum ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: Bilemiyorum. Bir keresinde kötü bir olay yaşadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: Bir ev bulduydum. Boştu. Yerde bir ceset vardı, her zamanki gibi. Bir tehlike yoktu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: Herifin sırtı delik deşikti, bir şeyin üzerinde yatıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: "Herhâlde o şeyi saklamaya çalışmış," diye düşündüm. Ben de yaklaşıp adamı çevirdim ve...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: Neyse, sonra anlatırım. Şimdi hatırlamak istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: Bana sağlam bir ganimet lazım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: Cesedin altında ne vardı?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: Peki...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: Herifi çevirdim ve onu gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: Minik bir kız. Ölü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: Yetişkinler çok rahatsız etmiyor da çocuk... Farklıydı yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: Ölü çocuk gördüm mü boğazım düğümlenir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: Elinde de pelüş bir kedi vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: Her yer kan revan içindeydi var ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: Kızın suratında öyle bir ifade vardı ki... Sanki öleceğini biliyormuş gibiydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: Bir anlığına oyuncağını alacağım için korktuğunu sandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: Öldükten sonra bile insanların zulmü yakasını bırakmayacakmış gibi bakıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: Bu bana çok ağır geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: O gün durmak istedim. Ölüleri rahat bırakmak istedim ama... artık çok geç.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: Elimden bir şey gelmiyor, toplamaya devam etmem lazım. Başka türlü hayatta kalamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: İnsanlar "Kaderinden kaçamazsın," diyorlar. Galiba haklılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: Keşke bu Ziyaretçiler yerin dibine geri dönse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: Neden mezarcı oldun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: Ne? İşimi mi soruyorsun? Yani açıkçası ben de bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: Mezarlık da aslında kütüphane gibi bir yer. Oradaki kitaplar okunmuyor ama. Yatıyorlar öyle. Sessiz sessiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: Eskiden tüm mezarları tanırdım. Kim nerede yatıyor, kolları nasıl duruyor, üzerlerinde ne var, isimleri ne...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: Bir gün mezar kazıyorum. Gayet normal bir gün, hiçbir yaramazlık yok. Tam yeterince derine ulaştım derken... Bi'' baktım, boş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: Bomboş! Evraklarda birinin burada yattığı yazıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: Adamın biriydi, ölü olduğundan emindim. Bıyığı vardı. Birdenbire yok olup gitmiş herif!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: Ölü bir adam yok olursa tekrar mı ölmüş sayılır?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: Keşke bu Ziyaretçiler yerin dibine geri dönse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: Boş mezarı bulunca ne yaptın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: Çukurun kenarında oturdum öyle. İçine baktım... Bomboş. Sonra kafamı kaldırdım ve ufukta... birini gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: Orada duruyor, beni izliyordu. Cenazede gibi. Gözü yoktu ama dişleri bembeyazdı. Parlıyordu neredeyse. Durup gülümsüyordu öyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: Korkudan altıma sıçacaktım neredeyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: Tabanları yağlayıp kaçtım. İyi de koşarım. Arkamdan gelmedi ama. Birden yok oldu. Puf diye...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: İnanılmaz bir şeydi. Bu Ziyaretçi mevzusu da o zaman başladı zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: Keşke bu Ziyaretçiler yerin dibine geri dönse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: İnsanlar artık ölüleri gömmüyorsa niye kazıyorsun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: Artık kazmıyorum pek. Daha çok bekçilik yapıyordum. Bu olaylar başladıktan sonra yeni gömülenleri kontrol etmeye başladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: Temkinli davrandım, bir yanlışım olmadı yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: Belki bu yaratıklardan birini yanlışlıkla gömmüşlerdir diye düşündüm. Küreğimi kılıç gibi tutuyordum, kendimi savunmaya hazırdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: Ama bir şey bulamadım... Tüm cesetler yerli yerindeydi. Hiçbiri yüzeye çıkmıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: Ben de düşünmeye başladım... "Herhâlde ölüler geri gelmeyecek," dedim. Belki de Ziyaretçiler gömülmesi gerekirken gömülmeyenlerdir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: Keşke bu Ziyaretçiler yerin dibine geri dönse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: Yeni mezar kazmadın hiç, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: Ben mi? Hayır, tabii ki de! Manyak değilim ben. Ben hayatım boyunca cesetlerle uğraştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: Eskiden beni korkutmazlardı. Ölürdün, gömülürdün. Bu kadar. Şimdi seni gömecek adam kalmadı ki!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: Biri seni gömse de mezarından çıkmayacağın ne malum? Adamı BİZZAT gömdüm diyorum ama mezar bomboştu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: Kendi ellerimle gömdüm adamı!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: Şimdi düşünüyorum da... belki benim mezarım da boş olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: Belki de... Belki de Ziyaretçi olmuşumdur bile...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: Sen beni merak etme. Biraz korkuyorum, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: Keşke bu Ziyaretçiler yerin dibine geri dönse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: Sence bu Ziyaretçiler nereden geldi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: Çok tanıdık göründüklerini fark ettin mi hiç? Sanki insan değiller de bir insanın anısı gibiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: Bir teorim var, anlatayım mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: Belki de Ziyaretçiler... ölü değillerdir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: Belki de sadece düşüncelerdir. Gömemediğimiz düşünceler...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: Korkular, pişmanlıklar, unutamadığımız duygular. Bunlar birikiyor, birikiyor... Sonra ortalık sakinleşince toprağı deşip çıkıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: Aradıkları insan eti değil, ilgi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: Ne kadar korkarsan o kadar yaklaşıyorlar sana. Onları hatırlıyorsun çünkü. Hatırlanan her şey... yaşamak da ister.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: Umarım güneşe çok maruz kalmamışımdır...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: FEMA'da çalışmadığına emin misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: Hayır, gerçekten onlar için çalışmıyorum. Dedim ya sana, buzdolabı tamircisiydim ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: Bu kıyafeti bir arabada buldum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: Cesetten aldım demiştin
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: Yalan söylemiyorsun, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: Yani... Evet, aynen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: Arabadaki cesetten aldım işte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: Kıyafet beni Ziyaretçilerden korur diye düşündüm. O FEMA elemanları boşuna giymiyordur herhâlde, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: Yalan söylemiyorum, stresli olduğum için karıştırmışım sadece. Ne olmuş yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: Benim gördüklerimi sen de görseydin... O zaman anlardın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: Buraya gelirken bile neler gördüm neler... Yerdeki cesetlerin seğirdiğini biliyor muydun? Korkudan ölüyordum neredeyse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: Umarım güneşe çok maruz kalmamışımdır...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: FEMA kıyafeti giymek biraz sakat bir iş gibi, sence de öyle değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: Ne? Yani... Yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: Yani millet FEMA''yı sevmiyor falan da...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: Haa, onları taklit ettiğim için başım belaya girecek diye mi diyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: Yani... Bence... Her şeyi açıklarsam bana dokunmazlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: FEMA çalışanları iblismiş gibi davranmanın lüzumu yok. Öyle gizli bir kuruluş falan değiller sonuçta...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: Umarım güneşe çok maruz kalmamışımdır...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: Ceplerinde ne olduğuna bakayım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: Nası''? Niye beni aramak istiyorsun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: FEMA kimlik kartını arıyorum da ondan
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: N'olmuş ki? Bir şey mi saklıyorsun yoksa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: Ne? Ne kimlik kartı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: Yemin ederim üzerimde bir şey yok...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: İyi o zaman, zor yoldan yapalım. Boşalt ceplerini
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (Silahını çek)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: Kim? Ben mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: Hayır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: İyi o zaman, zor yoldan yapalım. Boşalt ceplerini
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (Silahını çek)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: Peki, tamam. Üzerime gelmene gerek yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: Buyur. Mutlu musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: Tebrik ederim. Beni yakaladın. FEMA çalışanıyım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: Lütfen diğerlerine söyleme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: Hay ben böyle işin...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: Al, tamam. Beni vurma ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: Evet, FEMA çalışanıyım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: Bu, aramızda kalırsa daha iyi olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: Neden FEMA çalışanı olduğunu sakladın?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: Niye yalan söyledin?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: Gerçekten anlamadın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: Gerçekten sordun mu bunu?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: İnsanlar FEMA çalışanı olduğumu öğrenirlerse...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: Bak, artık FEMA için çalışmıyorum zaten. İstifa ettim diyebiliriz...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: Bak, artık FEMA için çalışmıyorum zaten. İstifa ettim diyebiliriz...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: Evet, pek güzel olmayan şeyler yapmam gerekti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: İnsanları topladım, karantina bölgelerine gönderdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: İşim buydu ama! Emir kuluydum, ne yapayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: Bana alıp götürdüğümüz insanları hiç sorma, onlarla üsttekiler ilgileniyor. O iş beni aşar yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: Bana katil falan demek de hiç adil değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: Katilleri bu bölgelere yollayarak insanları kurtarıyordum desem bana ne derdin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: Umarım güneşe çok maruz kalmamışımdır...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: Neden FEMA çalışanı olduğunu sakladın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: Seni kontrol etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: Ziyaretçi belirtisi gösteren bir adamı yakaladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: Uzun lafın kısası, karantina bölgesinde durumu kötüleşti ve öldü. Sıra dışı bir durum değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: Sonra karısı geldi. Onu ne zaman çıkaracağımızı sordu. Artık çıkaracak biri olmadığını söyledik.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: Şok olduğu belliydi. Bağırmaya başladı, bize katil dedi, cesedi vermemizi istedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: Protokol yüzünden bir şey yapamayacağımızı söyledik. Ama bana mısın demedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: Bölgenin dışında, hemen kapının önünde kamp kurdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: Sonunda dayanamadık ve cesedi verdik. Sonra protokolü bozan herkesi kovdular. Ben dâhil.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: İlle de o cesedi alacaktı. Manyak karı yüzünden işimi kaybettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: Şimdi gidecek bir yerim de yok...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: En kötüsü ne biliyor musun? Cesedi gömmek yerine yanında taşıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: Hepimizin kovulmasına değdi yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: FEMA çalışanları olarak hepiniz şerefsiniz
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: Şansına küs
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: Ne dedin sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: Ben burada işimi yapıyorum, vazifemi yerine getiriyorum, delinin teki yüzünden kovuluyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: Sen de bize "şerefsiz" mi diyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: Bıktım ulan. Gidiyorum buradan.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: Millet kafayı yemiş ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: Cidden, herkes delirdi yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: Güneş çığırından çıkalı ve enfeksiyonlar başlayalı herkes kafayı sıyırdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: Bir ceset hepimizin kovulmasına değdi mi gerçekten?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: Neyse ki kocasına kavuşmuş
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: Keşke cesedi vermeseydin
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: Kovulmamızın iyi olduğunu mu düşünüyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: Siviller bir bok anlamıyor bu işlerden.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: Keşke kocası gibi onu da vursaydım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: Ne dedin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (Silahını çek)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: Ne bakıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: Protokole göre enfekte bir sivilin durumu kötüyse...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: Durumla hemen ilgileniyoruz ki Ziyaretçi''nin teki karantina bölgesinde serbest kalmasın.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: (Gitmesine izin ver)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (Silahını çek)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: Anlayış gösterdiğin için teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: Ben katil değilim, sadece bir emir kuluyum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: Ne yapıyorsun lan sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: Sakin ol, adam Ziyaretçi''ydi diyorum sana! Durumu da kötüydü! Serbest bırakamazdık.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: Vurma beni! Sadece emir kuluyum ben!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: Bence de. Keşke protokolden sapmasaydık.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: Neyse, seni devamıyla sıkmayayım. FEMA çalışanı olduğumu öğrenmene rağmen beni içeri aldığın için sağ ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: İşime dönebilirsem bizimle iş birliği yaptığını üstlerime ileteceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: Ziyaretçiler rüya görür mü?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: Sen hiç uyumuyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: Ne? Uyumaya çalışmıyorum ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: Burada rüya gören biri olmasını umuyorum, o kadar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: ...ama henüz kimse benimle rüyasını paylaşmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: Güvenilir biri gibi durmuyorum herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: Belki sonradan açılırlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: Ziyaretçiler rüya görür mü?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: Niye rüyalara bu kadar kafayı taktın?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: Kim demiş kafayı taktığımı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: Garip bir çıkarım yapmışsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: Bilinçaltımız bize ne anlatmaya çalışıyor, hiç merak etmiyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: Kafalarımızda ne sakladığımızı? Hepimiz kendimizden bir şey saklarız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: Sen mesela. Biri canını yaktığı için mi insanlardan uzak duruyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: Bu yüzden bana ilginç geliyor işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: Bak ne diyeceğim, sana gördüğüm son rüyayı anlatayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: Peşimde kocaman, kapkara bir tren vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: Bacaklarım yere bağlıydı. Çığlık atıp uyandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: Ama bir yandan treni de ben kullanıyordum. Kendime doğru sürüyordum ama duramıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: Ziyaretçiler rüya görür mü?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: Peki ya sen? Sen rüyalarında neler saklıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: Peki ya ben mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: Günlerdir uyumuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: Peki, sana küçük bir sır vereceğim. Zaten söylesen de kimse inanmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: Başka insanların rüyalarını İZLEYEBİLİYORUM. Gerçekten... inanılmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: Nasıl oluyor, hiçbir fikrim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: Ancak bu olaylar başlayalı... rüyalar sustu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: Herkes nefesini tutuyor sanki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: Artık uyuyamıyorum bir de.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: Peki... Şu an sana gerçeği mi söylüyorum? Yoksa seni kandırıyor muyum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: Zayi ruhlarız. Bu lanetli dünyada yaşayan sayısız insan gibi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: Emelimiz barıştır... Ebedî bir huzurdur. O''na giden bir yol bulduk...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: Ölüm''e giden bir yol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: Neden O''nun önünde korkudan titriyorlar ki? Korktukları gerçekten bilinmezlik mi? Yoksa ruhlarına işlenen dogmanın cezaları mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: Milenyumlardır perdeyi kaldırmaya çalışıyor, hayatın anlamını arıyoruz. Tabii, aslında cevap o kadar basit ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: Hayatın anlamı, Ölüm''dür. Bizler de onun müritleriyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: Neden ölüme tapıyorsunuz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: Zira Ölüm, merhametin tecessümüdür.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: Hepimiz O''ndan korkuyoruz ama korkularımız meşru mudur?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: İyice düşün... Bu dünya bir cennet değil, bize işkence eden bir araf. Herkesin aklında tek bir soru: "Neden?"'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: Bunca korku, bunca acı, bunca keder... Huzuru hak etmiyor muyuz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: Ölüm, bizim idrak edemeyeceğimiz bir cennettir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: Din, halkın acılarını dindirmek için Cennet''in tasvirini yumuşatır ama hayat sahiden bu kadar basit midir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: Ölüm için de aynısı geçerlidir. O sana dokunana dek O''nu idrak edemezsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: Neden benim evimi seçtiniz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: Senin evin ve Ölüm arasında sıra dışı bir bağ var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: Başta üstadımız neden burayı seçti diye düşünmüştüm ama şimdi anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: Bu duvarların içinde Ölüm var. Soyut ama bir o kadar da ruhu boğuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: Ham beton, dökülen kanın kokusunu taşıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: Bu bir cinayet teklifi değildir, yanlış anlama. Sen biz teşvik etmeden de kan döküyorsun zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: Senin Ölüm''le arandaki bağ, hepimizden daha güçlü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: Dışarıda inşa ettiğiniz o kamp ateşleri ne için?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: Vakit geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: Aşağıdan gelen melekler küllerimizi adak olarak alacak ve Ölüm''ün topraklarına ayak basmamıza izin verecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: Böylelikle O''nun takdirini kazanacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: Korkmuş gibisin. Neden korkuyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: Çok dikkatlisin ev sahibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: Diğer din kardeşlerimin aksine... ben hâlâ korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: Şüphem, bana işkence ediyor. Yaşamdan sonra ne var? Nasıl bir his beni bekliyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: Üstadımızın öğretilerine göre ne Cennet varmış ne Cehennem. Başka bir şey varmış ama bir türlü anlamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: O bile Ölüm''ü tam idrak edemiyorsa biz nasıl edeceğiz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: Ya O''na ulaşmak yetersiz kalırsa? Ya O''nu idrak etmek gerçekten imkânsızsa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: Ancak üstadımızın iradesini asla sorgulamam. Zira gözlerinde öz güven ve anlayış ışığını görüyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: Bizden inancımıza sarılmamızı ve kararlı olmamızı istiyor. Hazır olmamızı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: Ancak o vakit ceset nehirlerini ve kemik dağlarını aşıp O''na ulaşabiliriz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: Ölüm''e.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: Neden ölüme tapıyorsunuz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: Lütfen merhametli ev sahibi, lütfen Ölüm''ü kötüleme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: Ölüm, O''nu adaletsiz gören kâfirlerden nefret eder ve onları cezalandırır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: Tabiatı beni dehşete düşürse de üstadımız Ölüm''ün en nazik tanrı olabileceğini söylüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: Ne açlık getiriyor ne veba ne de savaş. Yalnızca insanları huzura erdiriyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: O''nunla bir araya gelmemiz gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: Neden ölümü bulmak için can atıyorsunuz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: Bu yolculuk, bizim kararımızla başlamadı. Ölüm''ün iradesiyle başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: Bizi O çağırdı. Bizi topraklarında görmek istiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: Üstadımız, güneşin ısınmasının sebebinin bu olduğunu söylüyor. Bizi yüzeyden uzaklaştırmaya çalışıyormuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: Ölüm sükûnet, barış ve birlik getirir. O''nun topraklarında bir araya geleceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: Ölülerin arkasından yas tutuyoruz ama nafile; bir gün onlara katılacağımızı unutuyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: Planınız ne?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: Vakit geldi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: Korkuyorum, tir tir titriyorum... ama inancıma sarılmalı ve kararlı olmalıyım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: Üstadımız bana inanıyor. Onu hayal kırıklığına uğratamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: Ancak korku... hâlâ aklımı işgal ediyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: Bizi serbest bırak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: Bizi serbest bırak. BİZİ SERBEST BIRAK!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: Ne kadar kalacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: Merak etme ev sahibi. Sana rahatsızlık vermeyeceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: Misafirperverliğinden ötürü minnettarız ve seni öfkelendirmek istemeyiz. Zaten bizim için çok iyilik yaptın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: Bu odada kalacağız ve sessizce dua edeceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: Dinlenmemiz gerekiyor. Önümüzdeki yol uzun ve zorlu olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: İstikamet neresi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: Yabancıların diyarına gidiyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: İnsan ömrü, ebedî değildir. Bizler bu dünyada yalnızca misafiriz. Geldiğimiz gibi gideceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: Yabancıların bir sonraki amacı bu toprakları ele geçirmek. Buraya yerleşecekler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: Gelişleri sebepsiz değil. Bizi buradan uzaklaştıran onları da buraya çağırıyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: Onları buraya Ölüm çağırdı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: Neden Ziyaretçilerin ölüm tarafından çağrıldığını düşünüyorsunuz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: Çünkü Ölüm insan, yaratık, yabancı ayırt etmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: Ölüm herkes ve her şey için aynıdır, herkes O''nun önünde eşittir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: Belirli bir anı bekliyordu ve o vakit neredeyse geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: Ayin için hazırlık yapmamız gerek...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: Nasıl bir ayin yapacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: Diğer tarafa geçme vakti geldi. Evimize dönme vakti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: Ölüm''e varmalıyız, ebedî huzur ve sükûnet diyarına varmalıyız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: Yolumuza devam etmeliyiz...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: Ne oldu bebeğim? Aklına takılan bir şey mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: Buraya alışabildin mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: Evet, rahat bir yer. Beklediğimden daha iyi. Şartları göz önünde bulundurursak yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: Beni içeri aldığın için teşekkür ederim. Şafak sökmeden sokakta kalırım diye korkuyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: Peki ya sen? Sen nasılsın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: Kaygılıyım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: İyiyim. Önemli olan hayatta kalmak
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: Seni anlıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: Şu sıralar... uzun vadeli plan yapmak saçma geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: İlk hangisi seni öldürecek bilemiyorsun. Güneş mi, deliler mi, Ziyaretçiler mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: Gerçi insanlık bir sürü felaketten sağ çıktı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: Gittiğimiz zaman arkamızda büyük bir miras bırakacağımıza inanıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: Biri bizim izimizi bulacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: Her şey güzel olacak bebeğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: Bu tavrın hoşuma gitti. Yakışıyor sana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: Duygularını içine atmak yok ama, tamam mı? Yoksa patlarsın, hiç hoş olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: Tam da patlamasını istemediğin bir zaman hem de.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: Utanma, ara sıra gel benimle konuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: Ben değilsem de başkasıyla. Herhangi biriyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: Söz mü?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: Ne oldu bebeğim? Aklına takılan bir şey mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: Geçen gece garip bir şey gördüm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: Öyle mi? Ne gördün?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: Karnın... şişmişti
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: Önemli bir şey değildi... Gözlerim beni yanıltmış olabilir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: Nasıl yani? Hamile gibi mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: Ha, sorun değil bebeğim. Dürüst olduğun için teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: Belki çok stres yapıyorsundur. Bir sürü insanın sorumluluğunu üstlendin sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: Seni anlıyorum bebeğim. Her gün ölüm tehlikesiyle karşılaşıyoruz. Kendi sorumluluğunu almak bile zor, başkasını geçtim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: Yarını görecek misin, onu bile bilemiyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: Evet, bu beni korkutuyor
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: Yok, ondan değil
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: Aklına takılan bir şey mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: Sorun değil bebeğim. Korku hepimizi yıpratır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: Gece geç saatte kalktığını fark ettim. Evde dolaşıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: Çok içine kapalı birisin ama eve aldığın insanları çok önemsiyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: Enteresan... Yürüyen bir çelişkisin âdeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: Uykusuzluktan da olabilir. Korku, uyumana engel oluyordur belki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: Evet, bu beni korkutuyor
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: Yok, ondan değil
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: Bunu söylemek de cesaret ister bebeğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: Peki korku ne işimize yarayacak, hı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: Yaşamın... bir sonu olduğu düşüncesini kabullenebiliyor musun? Bir gün öleceğimizi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: Önemli olan, kurtuluşu nerede bulduğun. Artık böyle bir imkân varsa tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: Peki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: Yine de senin için endişeleniyorum bebeğim. Kendini ihmal etme, tamam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: Kendini güvende hissetmeni istiyorum. Aynı çatının altında yaşıyoruz sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: Senin tahtalar eksik kalırsa biz de tahtalıköyü boylarız...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: Pardon, şakanın sırası değildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: Yine de komikti ama, değil mi bebeğim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: Ne oldu bebeğim? Aklına takılan bir şey mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: Dün gece seni hamile gördüm, eminim. Bana bir açıklama borçlusun
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: Beni korkutmaya başlıyorsun...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: Dün gece bir şey gördüğünden emin misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: Niye beni uyandırmadın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: Yine mi ölüm korkusu bastı? Yoksa başkalarına bakmanın yükü mü?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: Yoksa benim yüzümden mi? Başkaları mı aklına girdi ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: Kafamı karıştırmaya çalışma
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: Ama... Bir şey gördüğümden eminim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: Geçen gün babanın lafını etmiştin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: Bir daha da konusunu açmadın. Pek bir şey bilmiyorum yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: Fakat şu an... içimden bir his aynı ona benzediğini söylüyor. Kopyasısın hatta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: Bu seni korkutuyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: Onun gölgesinde kalmak?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: Onu geçmişte bırakmamış mıydın? Niye eski defterleri açıyorsun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: Karşı tarafta onunla buluşmayacaksın sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: Aynı yere gitmeyeceksiniz çünkü. Hiç endişelenme sen bebeğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: Tek seferde tüm cevapları bulmaya çalışma. Yol dediğin, adım adım inşa edilir. Anlatabildim mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: Bir de bebeğim... Bir daha asla benimle öyle konuşma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: Sana olanları görmek beni üzüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: Ölümden korkmamalısın. Sorumluluk almaktan da, biriyle yakın olmaktan da...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: Bunlar hayatın bir parçası bebeğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: Tek seferde tüm cevapları bulmaya çalışma. Yol dediğin, adım adım inşa edilir. Anlatabildim mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: Öldükten sonra tamamen yok olmayacağımızı düşün, belki iyi gelir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: Eskiden cennetle cehenneme inanırdım ama artık emin değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: Belki başka bir şey vardır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: Sen ne düşünüyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: Ne oldu bebeğim? Aklına takılan bir şey mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: Hamilesin, değil mi? Çocuk yakında geliyor
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: Ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: Çaresizliğine yenik düştün, öyle değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: İnandığın her şey başına yıkılıyor... ve gücün bunu kabullenmeye yetmiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: İlerlediğimiz bu yoldan gitmek sana zor mu geliyor yoksa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: Yoksa bu dünyaya ait olmadığından mı? Herhangi bir dünyaya ait olmadığından, daha doğrusu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: Konuyu çarpıtma. Hamilesin sen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: Korkmuyor musun hiç?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: Bebeğim... Bu nasıl mümkün olabilir? Baksana, karnım dümdüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: Bir şey sorabilir miyim sana?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: Diyelim ki bu çocuk gerçek...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: Ve diyelim çocuk geliyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: Ne yapardın bebeğim? Onu arar mıydın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: O çocuk var olmamalı
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: Henüz karar vermedim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: Hım... Güzel soru.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: Ölmekten korkuyorum, evet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: Çoğunlukla sonrasında ne olduğunu bilmediğim için.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: Cennet, reenkarnasyon, belki de bambaşka bir şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: Ölüp de geri gelen yok ki bize anlatsın...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: Ancak senin bu görün...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: Diyelim ki bu çocuk gerçek...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: Ve diyelim çocuk geliyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: Ne yapardın bebeğim? Onu arar mıydın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: O çocuk var olmamalı
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: Henüz karar vermedim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: Bazen iç güdülerin, seni tanıdık olanı korumaya yöneltir. Artık hiçbir işine yaramasa bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: Belki de...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: Gözlerini yeni bir şeye açmanın vakti gelmiştir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: Yoksa bilinmezlik seni bu kadar mı korkutuyor gerçekten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: O çocuğu bulacağım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: O çocuk geliyor. Geldiğinden eminim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: Geçmişi geçmişte bırakmaktan korkmamalısın. Özellikle artık işine yaramıyorsa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: Bazen sırf tanıdık olduğu için bir şeyleri koruma ihtiyacı duyar insan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: Evet, alışkanlıkları bozmak zor olabilir... ama belki de en iyisi budur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: O çocuğu bulacağım
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: O çocuk geliyor. Geldiğinden eminim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: Öyle diyorsan öyledir bebeğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: Vakit geldiğinde ne bulduğunu bana söylersin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: Neyse, benden bu kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: Ha, unutmadan söyleyeyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: Yarın gece eve döneceğim. Numaramı bir kenara yaz, hattı daha yeni bağladılar zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour: {0}. Ara sıra telefonlaşırız.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: Tamam, söyleyeceğim başka bir şey kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: Kendine bir bira aç, biraz dinlenmeye çalış.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: Miyav!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: Kediyi sev
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: Kediyi havaya kaldır
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: Kediye mama ver
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (Elini uzatıp kediyi seviyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (Hoşuna gitti mi, gitmedi mi belli değil)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: Miyav!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: Kediyi sev
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: Kediyi havaya kaldır
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: Kediye mama ver
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (Kediyi sevmeye karar veriyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (Hoşuna gitti galiba)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (Beklediğin kadar huysuz değil)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (Sana alışmaya başlamış gibi)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: Miyav!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: Kediyi sev
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: Kediyi havaya kaldır
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: Kediye mama ver
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (Sık sık sevilmek kedinin hoşuna gidiyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (Hatta sanki onu sev diye sana yaklaşıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (Aşırı tatlış olduğu için sen de hayır diyemiyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: Miyav! MİYAV! Miyav!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (Suratından pek bir şey anlaşılmıyor ama hâlinden memnun olduğu belli)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (Aniden bu gece deliksiz uyuyacağını hissediyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (Tüylü dostun, sana teşekkür etmek için bir canını hediye etmiş gibi sanki)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (Kim bilir, belki bu gece ölüm kapına uğramaz...)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: Zavallı çocuklar...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: Bir sorun mu var?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: Ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: Aklıma bir şey takıldı da...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: Ya neslimiz tükenmezse, ya bir şekilde hayatta kalmayı başarırsak? Ortalık durulduğunda ne olacak?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: Bizi nasıl bir gelecek bekliyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: Bu "yeni dünyada" sana yer olmayacağından mı korkuyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: Yufka yüreklilere pek merhamet yok şu sıralar. Güvenecek birini bulman gerek
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: Yufka yürekli demek...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: Şiddet uygulamayı geçtim, şiddete katlanamıyorum bile. Mizacımda yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: Bu... "yeni dünya" dediğin dünyaya nasıl ayak uyduracağım, bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: Oturup ölmeyi mi bekleyeceksin yani?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: Başka bir seçeneğin var mı ki?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: İnsanoğlu geçmişte de zorluk çekti. Biz bunlara alışığız
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: Öyle bir şey istemem. Beni koruyacak biri olsa bile...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: Katliam devam eder zaten. Şiddetin yok olup gideceği yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: Oturup ölmeyi mi bekleyeceksin yani?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: Başka bir seçeneğin var mı ki?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: İnsanoğlu geçmişte de zorluk çekti. Biz bunlara alışığız
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: Kafam çok karışık.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: Artık sağımız, solumuz katil mi olacak? Böyle mi yaşayacağız?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: Çocuklarımız, yaşamayı bu "yeni dünyanın" katillerinden ve eşkıyalarından mı öğrenecek?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: Buna üzülme lüksümüz yok
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: KENDİNE GEL!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: Yani... Bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: Sunacak hiçbir şeyim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: Tüm bunlar... bitsin istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: Artık... dayanamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: Evet, haklısın ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: Bu saatten sonra nasıl yaşayacağız?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: Millet iyice kafayı sıyırdı. Birazcık bile farklı gördükleri herkesi öldürüyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: Karşılarına kim çıkarsa çıksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: Buna üzülme lüksümüz yok
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: KENDİNE GEL!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: Niye ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: Soğukkanlı davranmak senin işine yarıyor olabilir ama bana hiç yaramıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: Benim gördüklerimi sen de görseydin...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: Her bir saniyesi beynime kazındı.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: Alevler, çığlıklar... Dehşet içindeki minik suratları... Harap olmuş aileler, yuvalar...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: Ben senin gibi olamıyorum. O kadar güçlü değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: Benim gibilerin... tek bir kaçış yolu var.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (Kadın birden irkilip korku içinde sana bakıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (Şaşkınlık, bir anlığına da olsa gördüklerini unutmasını sağlıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (Ellerini yüzüne götürüp sessiz sessiz ağlıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (Ne yapacağını şaşırıyorsun. Bu gibi durumlarda ne yapacağını kimse sana söylemedi)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (Bir elini dikkatlice omzuna götürüp sessiz sessiz yanında duruyorsun)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (İyisi mi sen onu yalnız bırak)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: Bak ne diyeceğim. Sen o herifi bir arasana. Numarası {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: Ağzının payını ver ona.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: Sonuçta bunlar onun da evlatları. Onları bulmama yardım etsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: Fırsat olursa onu arar mısın? Numarası {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: De ki... Çok üzgünüm. Hâlâ kendi boğazımı kesesim var.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: İstersen bağır çağır, fark etmez. Belki işin kolaylaşır, ne bileyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: Bazıları öbür taraftan nasihat ister...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: Bu karanlığı arındırabilecek insanlar var. Uzmanlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: İstersen sizi konuşturayım. Onlara ihtiyacın olacak gibi hissediyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: {0}. Bu numarayı ara.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: Numarayı benden aldığını da mutlaka söyle!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: Zahmet olmazsa onu arayabilir misin? Numarası {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (Üzerinde {0} yazan bir kâğıt parçası uzatıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (Herhâlde elçiliğin numarası)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: Bir kadeh içki için nelerimi vermezdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: Bize "ölümsüz" derken neyi kastettin?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: Seni test etmek istiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: İstersen kafana sıkıp kendin gör.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: Yerinde olsam öyle yapmazdım ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: Sandığın şekilde ölümsüz değiliz tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: Ölümden sonra tekrar doğar, tekrar yaşarız. Sonra tekrar ölürüz ve yeniden doğma döngüsü böyle devam eder.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: Kulağa saçma geldiğinin farkındayım ama benim gördüklerimi sen de görseydin... beni anlardın.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: Belki de bu Ziyaretçiler yeniden doğan insanlardır.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: Emin değilim. Ne olup bitiyor, hiçbir fikrim yok...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: Doğa bizden bir sürü sır saklıyor, ondan eminim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: Ama bir gün kızımı bulacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: Bu hayatta mı, sonraki hayatımda mı bilmiyorum... ama bulacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: Zira biz, asla gerçek anlamda ölmeyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: Bir kadeh içki için nelerimi vermezdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: FEMA niye seni arıyor?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: Seni test etmek istiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: İşler boka sardığında tüm gözler üzerimdeydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: O yaratıkların çıktığı bölgedeydim çünkü.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: Şehrin eteklerinde iblislerin yaşadığını anlatan saçma şehir efsanelerini duydun mu hiç?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: Neyse, boş ver. Kimse onları hatırlamıyor artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: Meğerse bunlar sadece şehir efsanesi değilmiş. FEMA baştan beri bunun farkındaymış.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: Doğaüstü bir şey olmadığını iddia ettiler...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: Sonra güneş milleti kavurmaya başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: Hayatta kalanları da yerin altından çıkan yaratıklar öldürüyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: Kısacası FEMA, sıçıp batırdığını anladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: Şimdi de hatalarını örtbas etmeye çalışıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: Ben de yanlış zamanda yanlış yerdeydim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: Bir kadeh içki için nelerimi vermezdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: Nasıl hayatta kaldın?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: Seni test etmek istiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: Unuttun mu? Ölümsüzüm ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: Emin değilim...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: Bazen ben de bunu düşünüyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: Şans olabilir. Belki de ulu bir güç beni koruyordur...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: Tanrı manrı, sen neye inanıyorsan artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: Belki de çoktan ölmüşümdür, bu bedende tekrar doğmuşumdur. Emin değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: İyi sordun.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: Keşke silahım olsaydı ben de sana aynı soruyu sorardım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: Keşke evde sadece bira olmasaydı bir de.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: Şöyle bir varilimiz olsaydı güzel bir içki hazırlardım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: Bir kadeh içki için nelerimi vermezdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: Başka ne biliyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: Seni test etmek istiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: FEMA''nın teşkilat yapısını en ince detayına kadar biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: Kim kimin patronu, kim ne iş yapıyor, kim kimin arkasından iş çeviriyor... Hepsini.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: Şerefsizler, Ziyaretçilerin gayet farkındalardı. Ne kadar tehlikeli olduklarını biliyorlardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: Buna rağmen şehre girmelerine izin verdiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: Hiçbiri bizim güvenliğimizi siklemiyordu çünkü.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: Devletin parasını aklamakla meşgullerdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: Hatalarını fark eden herkes kurban oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: Bunu kimsenin bilmesini istemiyorlardı çünkü.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: Bunlar daha karantina bölgeleri kurulmadan yaşandı bu arada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: Ben de ucuz kurtuldum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: Çok gizli bir bilgi söyleyeyim mi sana?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: Hepsi FEMA''nın suçu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: Bu televizyonda anlattıkları her şey yalan.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: Bu Ziyaretçilerden beter bir şey varsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: O da FEMA''dır.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: Bir kadeh içki için nelerimi vermezdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: Bu Ziyaretçiler nereden geldi?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: Seni test etmek istiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: Şehrin eteklerinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: Karantina bölgeleri oralara uzak, farkındayım...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: ...ama eminim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: Batıl inançlı biri değilimdir ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: İnsanların iki sene önce anlattığı iblisler bunlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: Şehre nasıl girdiler bilmiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: ...ama onları kim içeri aldı, biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: FEMA aldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: Ziyaretçiler, milletin zannettiği gibi uzaylı değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: Yaşayan canlılar hepsi. Bizim gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: Onlar da bu gezegenin yerlisi!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: Daha fazla burada duramam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: Kızımı bulmam lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: Teşekkür ederim ölümsüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: (Belli ki konuşacak bir şey kalmamış)'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071808
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
