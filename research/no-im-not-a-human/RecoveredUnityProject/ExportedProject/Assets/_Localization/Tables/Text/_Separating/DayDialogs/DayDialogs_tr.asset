    m_Localized: 'Player: O da ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792076
    m_Localized: 'Player: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792077
    m_Localized: 'Player: İyi, alayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792078
    m_Localized: 'Player: Ne? Geri mi veriyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792079
    m_Localized: 'Player: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792080
    m_Localized: 'Player: Şimdi benim peşime düşecekler...'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539790462976
    m_Localized: Güzel soru
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434496
    m_Localized: Beklediğim bir şey yok
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434497
    m_Localized: 'Ballerina: Benim soru? Sen beğendi? Niye?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434498
    m_Localized: 'Ballerina: Cevap ver. Sen hiç soru cevap vermiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434499
    m_Localized: 'Ballerina: O gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434500
    m_Localized: Beklediğim bir şey yok dedim
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434501
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434502
    m_Localized: 'Ballerina: Tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434503
    m_Localized: 'Ballerina: Sen ne yapıyor? Duvarlar arasında oturuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434504
    m_Localized: 'Ballerina: Bekliyor, bekliyor duruyor. Kimi bekliyor? Bir cevap mı bekliyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434505
    m_Localized: Beklediğim bir şey yok dedim
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434506
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434507
    m_Localized: 'Ballerina: Sen ne diyorsa. Ben de öyle bu arada.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434508
    m_Localized: 'Ballerina: Ben dedi zaten. Ben bekliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434509
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434510
    m_Localized: 'Ballerina: Neyse. O gelecek. Ben bunu biliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434511
    m_Localized: 'Ballerina: AHAHAHAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434512
    m_Localized: 'Ballerina: BEN DANSI ÇOK SEVİYOR. Ben sana göster? Ateş et de gör!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434513
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434514
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434515
    m_Localized: 'Ballerina: Ta da!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434516
    m_Localized: 'Ballerina: Sen bir daha vur!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434517
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434518
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434519
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434520
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434521
    m_Localized: 'Ballerina: La la la!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434522
    m_Localized: 'Ballerina: Ben dibinde duruyor ama sen vuramıyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434523
    m_Localized: 'Ballerina: Sen kör mü? Yoksa sen aptal mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434524
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434525
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434526
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434527
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434528
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434529
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434530
    m_Localized: 'Ballerina: Tra la la la la!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434531
    m_Localized: 'Ballerina: Ben yoruldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434532
    m_Localized: 'Ballerina: Ben çürüyüp gidecek. Daha hızlı olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683264
    m_Localized: 'Foreigner: Бу да не?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683265
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683266
    m_Localized: 'Foreigner: Пеки, алайым...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683267
    m_Localized: 'Unstable: Buraya kadarmış. Benzin bitti...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683268
    m_Localized: Ee, bir hikâyeden bahsediyordun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683269
    m_Localized: 'Unstable: Ha, evet. İstersen karşılıklı yapalım. Önce sen bir şey anlatmak ister misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683270
    m_Localized: Sana değil
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683271
    m_Localized: Sadede gel
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683272
    m_Localized: 'Unstable: Peki, tamam. Zorla değil sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683273
    m_Localized: 'Unstable: Şimdi... Geçenlerde bir bardayım, tamam mı? Gerçi bar değildi galiba. Başka bir yer de olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683274
    m_Localized: 'Unstable: Ne diyorduk onlara ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683275
    m_Localized: Ee?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683276
    m_Localized: 'Unstable: Ha, evet.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683277
    m_Localized: 'Unstable: Neyse işte. Kendi hâlimde takılıyordum, güzelim EnerJeka''mdan içiyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683278
    m_Localized: 'Unstable: Çok iyi cidden ya. İnanamazsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683279
    m_Localized: 'Unstable: Aklın hayalin durur.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683280
    m_Localized: 'Unstable: İçtikten sonra tadı damağında kalıyor. Keşke her yerde satılsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683281
    m_Localized: Ee?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683282
    m_Localized: 'Unstable: Ha, doğru. Ne diyordum?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683283
    m_Localized: 'Unstable: Neyse işte, oturuyordum orada. Mekânın yarısı boş zaten. Müzik bangır bangır.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683284
    m_Localized: 'Unstable: Sonra biri birden bağırmaya başladı. Kulaklık takmama rağmen duydum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683285
    m_Localized: 'Unstable: Şarkının da en güzel yerindeydi tam. Müzik dinlerken dikkatimin dağılması da hiç hoşuma gitmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683286
    m_Localized: 'Unstable: İnsan kendini müziğe bırakınca dış dünyayı unutur ya hani...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683287
    m_Localized: Ne anlatıyorsun lan sen?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683288
    m_Localized: 'Unstable: Tamam, tamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683289
    m_Localized: 'Unstable: Ben de işte kulaklıklarımı çıkardım ve sırık gibi bir adamın zavallının birine bağırdığını gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683290
    m_Localized: 'Unstable: Ne tartışıyorlardı bilmiyorum ama adam zar zor konuşuyordu. Zil zurna sarhoştu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683291
    m_Localized: 'Unstable: Zürafa herif bağırdı, sonra şak diye karşısındakine tokadı bastı. Herif iki seksen oldu tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683292
    m_Localized: 'Unstable: Sonra sırık ne yaptı biliyor musun? Bar tezgâhına tırmandı, hâlâ zor ayakta duruyordu. Kafası tavana değecekti neredeyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683293
    m_Localized: 'Unstable: Sonra "Hepiniz pisliksiniz!" diye bağırdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683294
    m_Localized: 'Unstable: Ortalığın boka saracağı belliydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683295
    m_Localized: 'Unstable: Bana da bulaşsın istemedim, direkt kaçtım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683296
    m_Localized: Ee, sonra?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683297
    m_Localized: 'Unstable: O kadar işte. Bir gariplik var yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683298
    m_Localized: 'Unstable: Nereye gidersem gideyim, birileri yaygara çıkarıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683299
    m_Localized: 'Unstable: İki günden fazla aynı yerde kalırsam kıyamet kopuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683300
    m_Localized: 'Unstable: Yok kavga edenler, yok ölenler, yok mezara gömülenler... Genelde bu sırayla.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683301
    m_Localized: 'Unstable: Umarım burası farklıdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683302
    m_Localized: 'Unstable: Buraya kadarmış. Benzin bitti...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683303
    m_Localized: Ee, sonuç? Burası güvenli mi sence?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683304
    m_Localized: 'Unstable: Emin olamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683305
    m_Localized: 'Unstable: Sanki burası daha... sakin, sıcak gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683306
    m_Localized: 'Unstable: Herhâlde ev olduğundan, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683307
    m_Localized: 'Unstable: Güvenli bir sığınak oluşturmaya çalışmışsın gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683308
    m_Localized: 'Unstable: Herkesi içeri almıyorsun falan.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683309
    m_Localized: 'Unstable: Sen de hissediyorsun ama, değil mi? Bir terslik var.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683310
    m_Localized: 'Unstable: Tabii, bütün dünyada bir terslik var ama burada da...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683311
    m_Localized: 'Unstable: Ne bileyim, ne anlatmaya çalıştığımı ben bile bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683312
    m_Localized: 'Unstable: Neyse ya. Bir EnerJeka dik kafana, unut gitsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683313
    m_Localized: 'Unstable: Sorun değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683314
    m_Localized: Ee, ne zaman gideceksin?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683315
    m_Localized: Hâlâ bir şeylerden mi kaçıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683316
    m_Localized: 'Unstable: Yakında muhtemelen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683317
    m_Localized: 'Unstable: Tek bir yerde uzun süre kalmayı sevmiyorum. Fark etmişsindir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683318
    m_Localized: 'Unstable: Etmediysen de... zaten kaç kere söyledim, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683319
    m_Localized: 'Unstable: Senin evin keyifli olabilir diye düşündüm...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683320
    m_Localized: 'Unstable: ...ama burada bir ölüm kokusu var sanki. Tam anlayamadım ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683321
    m_Localized: 'Unstable: Neyse, bana bu kadar yeter.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683322
    m_Localized: 'Unstable: Kaçtığım yok, bir şeyleri geride bırakıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683323
    m_Localized: 'Unstable: Bu kadar dert bana yeter.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683324
    m_Localized: 'Unstable: Bir yerde uzun süre kalınca ya yumruğu yiyorsun ya bir yere tıkılıyorsun ya da kafana sıkılıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683325
    m_Localized: 'Unstable: O yolun sonu hiç belli değil...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683326
    m_Localized: 'Unstable: Yani evet, ne kadar gezersem manyağın tekine rastlama ihtimalim o kadar yüksek.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683327
    m_Localized: 'Unstable: Ama birine güvenip sırtımdan bıçaklanmaktan iyidir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683328
    m_Localized: 'Unstable: Buraya kadarmış. Benzin bitti...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683329
    m_Localized: Ee, tamam mısın?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683330
    m_Localized: 'Unstable: Ne? Ha, evet evet. Bu gece gidiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683331
    m_Localized: 'Unstable: Görüşürüz yani!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683332
    m_Localized: Korktuğun her şeyden kaçamazsın
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683333
    m_Localized: Yolun açık olsun. Umarım manyaklardan kaçabilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683334
    m_Localized: 'Unstable: Evet, farkındayım ama belki kaçabilirim de.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683335
    m_Localized: 'Unstable: Tek bir yerde uzun süre kalmak farklı mı sence?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683336
    m_Localized: Peki... bol şans
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683337
    m_Localized: Tekrar gelmene izin vermem ama bak
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683338
    m_Localized: 'Unstable: Dalga geçmiyorsun, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683339
    m_Localized: 'Unstable: Yine de sağ ol. Burada iyice dinlendim. Birkaç gün rahat kaçarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683340
    m_Localized: 'Unstable: EnerJeka bu konuda çok işe yarıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683341
    m_Localized: 'Unstable: Şaka mı yapıyorsun bilmiyorum ama... herhangi bir şey yapmak, boş boş oturmaktan daha iyidir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683342
    m_Localized: 'Unstable: Zaten kaybedeceğim hiçbir şey yok. Hepsini geride bıraktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683343
    m_Localized: 'Unstable: En azından farklı bir şey arayayım. Pes edip beklemekten iyidir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683344
    m_Localized: 'Unstable: Böyle bir şey istemem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683345
    m_Localized: Peki... bol şans
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683346
    m_Localized: Tekrar gelmene izin vermem ama bak
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683347
    m_Localized: 'Unstable: Sağ ol, sana da.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683348
    m_Localized: 'Unstable: Belki bir gün yine yolumuz kesişir. Hatta anlatacak bir iki hikâyem olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683349
    m_Localized: 'Unstable: Hatta belki anlatasım bile gelebilir ama bilmiyorum. Baksana şu suratına.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683350
    m_Localized: 'Unstable: Neyse, önemli değil. Zaten döneceğim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683351
    m_Localized: 'Unstable: Gereksiz çünkü. Döndüğünde geride hiçbir şey bulamazsın. Anca acı, keder.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683352
    m_Localized: 'Unstable: Yanlış anlama, gördüklerimden konuşuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683353
    m_Localized: 'Unstable: Hepsini geride bırakmak daha kolay. Yani... iyisi mi biz bir daha görüşmeyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683354
    m_Localized: 'Unstable: Buraya kadarmış. Benzin bitti...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683355
    m_Localized: Sen gitmiyor muydun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683356
    m_Localized: 'Unstable: Evet ama önce seni uyarmak istedim!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683357
    m_Localized: 'Unstable: Dün gece dışarıda bir şeylerin gezindiğini hissettim. Seni uyandıracaktım aslında ama neyse, uyu dedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683358
    m_Localized: 'Unstable: Dikkatli ol, tamam mı? Ölüm peşinde belli ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683359
    m_Localized: 'Unstable: Nasıl anlatacağımı bile bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683360
    m_Localized: 'Unstable: Garip bir titreme geldi. Muhtemelen kafeinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683361
    m_Localized: 'Unstable: Neyse, olay o değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683362
    m_Localized: 'Unstable: Seni uyarmam gerektiğini düşündüm işte. Ne olur ne olmaz diye.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683363
    m_Localized: 'Unstable: Belki sen de bu evi terk etsen iyi olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683364
    m_Localized: 'Unstable: Bakma bana öyle. Saçmalıyorum, farkındayım. Neyse...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683365
    m_Localized: 'Unstable: Demedi deme. Bu sefer gerçekten vedalaşıyoruz. Umarım sen de diğerleri gibi yanıp kül olmazsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683366
    m_Localized: 'Rocker: Gitarımı özledim be...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683367
    m_Localized: N'oldu, dalmışsın?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460480
    m_Localized: 'Rocker: Ha? Bizim eski gruptan kimler kaldı diye düşünüyordum da.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460481
    m_Localized: 'Rocker: O zamanlar her cenazeden sonra toplaşıp şarkı çalardık. Yataktan çıkamamaktan veya içip sıçmaktan iyidir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460482
    m_Localized: 'Rocker: Bir keresinde üç gece art arda aynı riff''i çalmıştım. Parmaklarım kanayana kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460483
    m_Localized: 'Rocker: Gitarım ve ben, baş başa. Geberip giden puştun suratının gözümün önüne gelmesine izin bile vermedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460484
    m_Localized: 'Rocker: Şimdi her gün aynı bok. Yok Ziyaretçiler, yok güneş... Cehennemden bir farkı yok. Dik kafana gitsin!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460485
    m_Localized: 'Rocker: Gitarımı özledim be...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460486
    m_Localized: Gitarsız olmak zor mu?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460487
    m_Localized: 'Rocker: Hem de nasıl...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460488
    m_Localized: 'Rocker: Mutfakta çaldığımız günler aklıma geliyor. Amfiyi taburenin üzerine koyardık, komşular jandarmayı aramasın diye sesi iyice kısardık.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460489
    m_Localized: 'Rocker: Her şarkıdan sonra puştun teki, "Bu şarkı bilmem neye gelsin. Ruhu şad olsun," derdi. Bu kadar. Ne ağlardık ne yakınırdık.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460490
    m_Localized: 'Rocker: Zır zır ağlayacağına gitarını ağlatmak her zaman daha iyidir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460491
    m_Localized: 'Rocker: O zamanlar evdeki provalarımızın bir gün gerçek bir konsere dönüşeceğini sanırdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460492
    m_Localized: 'Rocker: Fakat biz iyice pişene kadar şehir hayatı bizi paramparça etti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460493
    m_Localized: 'Rocker: Ya şerefsizin teki uyuşturucudan geberiyordu ya arabasıyla kaza yapıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460494
    m_Localized: 'Rocker: Bok gibi bir hayat.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460495
    m_Localized: 'Rocker: Yarın gece dışarı çıkacağım. Gitmem gereken bir yer var.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460496
    m_Localized: 'Rocker: Gitarımı özledim be...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460497
    m_Localized: Ee? Dün gece nereye gittin?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460498
    m_Localized: 'Rocker: Eski prova mekânımıza gittim. Duvarlar komple küf, kablolar kopmuş, ortalık darmadağın.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460499
    m_Localized: 'Rocker: Metronomu açıp biraz dinledim ama... tık yok. Bomboş.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460500
    m_Localized: 'Rocker: Hayal kurmanın ne anlamı kaldı ki artık?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460501
    m_Localized: 'Rocker: "Rock ''n roll ölmez"miş, hadi lan oradan!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460502
    m_Localized: 'Rocker: Var ya, güneş hepimizi kavurmasaydı bile biz yine bir şekilde gebermeyi becerirdik.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460503
    m_Localized: 'Rocker: Çocukken rezilliklerin sona erdiğini sanırdım. Bu saatten sonra her şey güzel sanırdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460504
    m_Localized: 'Rocker: Ekonomik buhran bitmişti, savaş bitmişti... Artık yaşamaya başlayacağız, demiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460505
    m_Localized: 'Rocker: Ne haksızmışım be...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460506
    m_Localized: 'Rocker: Gitarımı özledim be...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460507
    m_Localized: Ne düşünüyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460508
    m_Localized: 'Rocker: Bugün fark ettim de anlattığım tüm hikâyelerde ya ön gruptuk ya da yedek. Hiç spot ışığında olamadım. Hiç de olamayacağım muhtemelen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460509
    m_Localized: 'Rocker: Sana niye yalan söyledim bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460510
    m_Localized: 'Rocker: Herhâlde bir saniyeliğine bile olsa bir şeyler başardığıma inanmak istedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460511
    m_Localized: 'Rocker: "Cehennemin dibini gördüm ve bu beni güçlendirdi," dedim ama palavra. Korkak veledin teki gibi saklandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460512
    m_Localized: 'Rocker: Sen o silahı bana doğrulttuğunda eski benliğim öldü ve başka birine dönüştüm... Ödleğin tekine.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460513
    m_Localized: 'Rocker: Böyle devam ederse benim de diğerlerimden bir farkım kalmayacak. Ya aşırı dozdan gebereceğim ya da küvete oturup kollarımı keseceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460514
    m_Localized: 'Rocker: Ben Ziyaretçi falan değilim. Kafayı sıyırmak üzere olan bitkin bir herifin tekiyim sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460515
    m_Localized: 'Rocker: Vuracaksan...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460516
    m_Localized: 'Rocker: Sikerler.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460517
    m_Localized: 'Rocker: Artık gram umurumda değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460518
    m_Localized: 'Experienced: Mevzu mu var cürüm?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460519
    m_Localized: Madem içerde yattın, niye hiç dövmen yok?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460520
    m_Localized: 'Experienced: Her içeri girenin dövmesi olacak diye bir şey yok abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460521
    m_Localized: 'Experienced: Görünüşe aldanmayacaksın, bu kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460522
    m_Localized: 'Experienced: Tamam, ben de sütten çıkmış ak kaşık değilim ama... hiç adam öldürmedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460523
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460524
    m_Localized: 'Experienced: Bunu yanlış anlama da abicim, sen burada kararları nasıl veriyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460525
    m_Localized: Nasıl yani?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460526
    m_Localized: Benim kararlarıma burnunu sokma
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460527
    m_Localized: 'Experienced: Yol geçen hanı olmuş burası. Ne kadar evsiz, patavatsız varsa içeri almışsın...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460528
    m_Localized: 'Experienced: Bu iş böyle olmaz. Ben bu tipleri iyi tanırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460529
    m_Localized: 'Experienced: Başına bela olur bunlar abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460530
    m_Localized: 'Experienced: Diyelim ki ihtiyarın tekini evine aldın, sonra gitti senin koltuğunda yatarken geberiverdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460531
    m_Localized: 'Experienced: Ee, sonra? Suçlusu sen olacaksın, senden soracaklar. Anladın?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460532
    m_Localized: 'Experienced: Ya da mesela içeri bir kadın aldığını düşün. Lavuğun teki karıyı hamile bırakmış. Ee?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460533
    m_Localized: 'Experienced: Velede sen mi bakacaksın? Bununla uğraşacak mısın cidden?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460534
    m_Localized: 'Experienced: Sadede gelelim abicim, buraya sadece adam gibi adamları alman lazım. Senin ve benim gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460535
    m_Localized: Yaşlıları, kadınları ve çocukları kapımdan çevireyim mi istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460536
    m_Localized: Sabıkalı herifin tekinden nasihat alacak hâlim yok
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460537
    m_Localized: 'Experienced: Anlaşıldı abicim. Sana karışmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460538
    m_Localized: 'Experienced: Seni sıkmak istemedim. Senin mekânın, senin kuralların.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460539
    m_Localized: 'Experienced: Kafama tek takılan şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460540
    m_Localized: 'Experienced: Niye kimse çıplak değil?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460541
    m_Localized: 'Experienced: Sen zekisin abicim. Bunlara ihtiyacın yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460542
    m_Localized: Sen ne yüzsüz bir herifsin lan!
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460543
    m_Localized: Sen ne ara bu konuda uzman oldun? Hapisten çıktığın gün mü?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460544
    m_Localized: 'Experienced: Bak abicim. Ben herkesi içeri alma diyorum, o kadar. Pişman olursun sonra.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460545
    m_Localized: Sen ne yüzsüz bir herifsin lan!
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460546
    m_Localized: Sen ne ara bu konuda uzman oldun? Hapisten çıktığın gün mü?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460547
    m_Localized: 'Experienced: Kendini komik mi sanıyorsun ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460548
    m_Localized: 'Experienced: Anlaşıldı abicim. Sana karışmıyorum. Bir kere söylemen yeter.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460549
    m_Localized: 'Experienced: Kafama tek takılan şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460550
    m_Localized: 'Experienced: Bu sıcakta niye kimse çıplak değil?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460551
    m_Localized: 'Experienced: Mevzu mu var cürüm?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460552
    m_Localized: Böyle üşümüyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460553
    m_Localized: 'Experienced: Nasıl?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460554
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460555
    m_Localized: 'Experienced: Dalga geçmeye mi çalışıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460556
    m_Localized: 'Experienced: Güneş, milleti sucuk gibi pişiriyor. Serpme kahvaltı oldu sokaklar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460557
    m_Localized: 'Experienced: Sen de burada kazakla duruyorsun. Asıl dalga geçilecek olan sensin abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460558
    m_Localized: Bu kıyafetler benim bir parçam gibidir
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460559
    m_Localized: Ben böyle iyiyim
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460560
    m_Localized: 'Experienced: Parçan demek...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460561
    m_Localized: 'Experienced: Peki, öyle olsun abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460562
    m_Localized: 'Experienced: Sokaklar cehennem ateşi gibi kavruluyor, siz burada gururlu gururlu geziniyorsunuz.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460563
    m_Localized: 'Experienced: Malsınız hepiniz. Götünüzün terlemesi sıkıntı değil ama milletin götünüzü görmesi sıkıntı!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460564
    m_Localized: 'Experienced: Bu kadar kıyafet giyip terlemiyorsanız da zaten o ayrı bir mevzu...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460565
    m_Localized: Sen bana Ziyaretçi mi demeye çalışıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460566
    m_Localized: Sen ne demeye çalışıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460567
    m_Localized: 'Experienced: Dalga mı geçiyorsun abicim? Ben burada dal taşak yanıyorum, sen kazakla rahat rahat oturuyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460568
    m_Localized: 'Experienced: Anlamıyorum. Götünüzün terlemesi sıkıntı değil ama milletin götünüzü görmesi sıkıntı!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460569
    m_Localized: 'Experienced: Şimdi sahilde olsak herkes mayolu, herkes bikinili ve hiçbir sıkıntı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460570
    m_Localized: 'Experienced: Sıcaklık aynı ama kimse sorun etmiyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460571
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460572
    m_Localized: 'Experienced: Bu kadar kıyafet giyip terlemiyorsanız da zaten o ayrı bir mevzu...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460573
    m_Localized: Sen bana Ziyaretçi mi demeye çalışıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460574
    m_Localized: Sen ne demeye çalışıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460575
    m_Localized: 'Experienced: Sakin ol abicim. Seni suçladığım yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460576
    m_Localized: 'Experienced: Sağlam adama benziyorsun. Terlemek istiyorsan karar senin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460577
    m_Localized: 'Experienced: Ben bu diğer malları diyorum. Sahile montla gider gibi...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460578
    m_Localized: Ne yapayım, soyunayım mı?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460579
    m_Localized: İnanılmaz bir teoriymiş. Nerenden uydurdun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460580
    m_Localized: 'Experienced: Bak abicim, bana sorarsan şu saatten sonra insan iki sebepten ötürü kıyafet giyebilir. Ya malın tekidir ya da insan değildir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460581
    m_Localized: 'Experienced: Bu yaratıklar topraktan oluşuyor, bu yüzden sıcaklığı hissetmiyorlar! Anladın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460582
    m_Localized: Ne yapayım, soyunayım mı?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460583
    m_Localized: İnanılmaz bir teoriymiş. Nerenden uydurdun?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460584
    m_Localized: 'Experienced: Bak abicim, benim istediğim bu değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460585
    m_Localized: 'Experienced: Terlemek istiyorsan karar senin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460586
    m_Localized: 'Experienced: Garip geliyor, diyorum sadece. Ya malın tekisin ya da...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460587
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460588
    m_Localized: 'Experienced: Dalga geçmiyorum abicim! Şu saatten sonra kat kat giyinmek için deli olman lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460589
    m_Localized: 'Experienced: Şu sıcaklıkta kim yapabilir ki bunu? Onu diyorum işte. Ya malın tekisin ya da...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460590
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460591
    m_Localized: 'Experienced: Aman, neyse. Benden bu kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460592
    m_Localized: 'Experienced: Mevzu mu var cürüm?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460593
    m_Localized: Geçen sefer ne diyecektin?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460594
    m_Localized: 'Experienced: Bak abicim. Ben sana adam gibi açıklarım ama sen beni adam gibi dinleyecek misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460595
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460596
    m_Localized: Hayır
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460597
    m_Localized: 'Experienced: Peki abicim. Anlatıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460598
    m_Localized: 'Experienced: Uzun lafın kısası, buradaki herkes sıkıntılı.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460599
    m_Localized: Niye öyle dedin?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460600
    m_Localized: Sen hep böyle ön yargılı mısın?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460601
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460602
    m_Localized: 'Experienced: Ee, amına koyayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460603
    m_Localized: 'Experienced: Niye soruyorsun ki o zaman?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460604
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460605
    m_Localized: 'Experienced: Millet kafayı yemiş ha. Bir tek içeride kalanlar normal kalmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460606
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460607
    m_Localized: 'Experienced: Ben de kafayı sıyırmadan susacağım artık abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460608
    m_Localized: 'Experienced: Götüm yanmasaydı sence böyle dal taşak gezer miydim abicim?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460609
    m_Localized: 'Experienced: Milletin hiç yanmıyormuş gibi kat kat giyinmesi kafamı kurcalıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460610
    m_Localized: 'Experienced: Sen benden daha uzun süredir dışarıdasın ama sığınakta yaşıyor gibi davranıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460611
    m_Localized: 'Experienced: Sen bu yaratıkları nasıl tespit edeceğini biliyor musun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460612
    m_Localized: Evet, belirtileri biliyorum. Televizyonda gördüm
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460613
    m_Localized: Kimse bilmiyor
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460614
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460615
    m_Localized: 'Experienced: Dalga mı geçiyorsun abicim?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460616
    m_Localized: 'Experienced: Bak, söylüyorum sana! Kıyafet giyenler Ziyaretçi!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460617
    m_Localized: 'Experienced: Sen bu yaratıkları nasıl tespit edeceğini biliyor musun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460618
    m_Localized: Evet, belirtileri biliyorum. Televizyonda gördüm
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460619
    m_Localized: Kimse bilmiyor
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460620
    m_Localized: 'Experienced: Umarım biliyorsundur abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460621
    m_Localized: 'Experienced: Bu belirtilerin yalan olduğu ortaya çıkarsa sıçarız. Seni de içeri tıkarlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460622
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460623
    m_Localized: 'Experienced: Ee, rastgele mi seçeceğiz o zaman?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460624
    m_Localized: 'Experienced: Başka yolu yoksa yapacak bir şey de yok. Hayat böyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460625
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460626
    m_Localized: 'Experienced: Bak abicim, bu saatten sonra... insanlara insan olarak bakmamak lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460627
    m_Localized: 'Experienced: İçerideyken daha güvende hissediyordum yeminle...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460628
    m_Localized: 'Experienced: Mevzu mu var cürüm?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460629
    m_Localized: Madem hapis daha güvenliydi, niye orada kalmadın?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460630
    m_Localized: 'Experienced: Söyledim ya abicim. Cezamı çektim. Üç kere girdim zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460631
    m_Localized: 'Experienced: İlk girdiğimde daha velettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460632
    m_Localized: 'Experienced: Çıktığımda bir daha asla suç işlemem sandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460633
    m_Localized: 'Experienced: İşlemedim de. Evlendim, çocuk yaptım. Eski hayatımı geride bıraktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460634
    m_Localized: 'Experienced: Sonra bu ekonomik buhran başladı işte. Ailemin karnını doyurmak için hırsızlık yapmak zorunda kaldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460635
    m_Localized: 'Experienced: Göz açıp kapayıncaya kadar eski hayatıma dönmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460636
    m_Localized: 'Experienced: Tekrar içeri girmem an meselesiydi zaten. Üçüncü kez girmeyi ben bizzat istedim. Dışarıda benlik bir şey kalmamıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460637
    m_Localized: 'Experienced: Karım beni boşadı gitti, çocuğum benden korkuyordu, kimse de sabıkalı işçi istemiyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460638
    m_Localized: 'Experienced: Hayatımın yarısı çöpe gitti anlayacağın.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460639
    m_Localized: Ee, geri dönmene engel olan şey ne?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460640
    m_Localized: Duyduğuma üzüldüm
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460641
    m_Localized: 'Experienced: Hiçbir şey abicim. Mantıklı bir sebep bulamadım henüz, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460642
    m_Localized: 'Experienced: Her şeyin bir yeri, vakti var...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460643
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460644
    m_Localized: 'Experienced: Bana üzülmene ihtiyacım yok abicim. Hepsi benim suçum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460645
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460646
    m_Localized: 'Experienced: Ben içerideyken dünya çok değişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460647
    m_Localized: 'Experienced: Yaşlandım artık. Ayak uyduramıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460648
    m_Localized: 'Experienced: Hücremdeki o ranza gibiyim. İlk girdiğimde de sertti, hâlâ da sert.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460649
    m_Localized: 'Experienced: Benim ne olduğum belli artık abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460650
    m_Localized: 'Experienced: Şu sıralar dikkat çekmemek de zor. Kimsenin kimseye güveni yok. Birine yan bakıyorsun, seni deşiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460651
    m_Localized: 'Experienced: Ben dürüst olmaya alışığım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460652
    m_Localized: 'Experienced: İster inan ister inanma, içeride herkes dürüsttür. Herkesin kim olduğu bellidir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460653
    m_Localized: 'Experienced: Fakat burada kimin gerçek kimin ucube olduğu bile belli değil. Her şey allak bullak.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460654
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460655
    m_Localized: 'Experienced: Ben filozof falan değilim tabii ama... İnsan olmak bu kadar zor mu cidden be? İçeridekiler bunu bir şekilde beceriyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460656
    m_Localized: 'Experienced: Demek dışarısı sandığımdan da çürükmüş.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460657
    m_Localized: 'Jacket: Şu hâlimize bir bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460658
    m_Localized: Sen eskiden yurtta kalıyordun, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460659
    m_Localized: 'Jacket: Evet. Bunu sana söylememiştim ama ben buralı değilim. Okumaya geldim, sonra da ortalık karıştı...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460660
    m_Localized: 'Jacket: Başta bizi yurtlara hapsettiler, virüsün yayılacağını sandılar. Sonra da... sarı tulumlular geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460661
    m_Localized: 'Jacket: Zaten endişelenmiştim ama enfekte olanları karantina bölgelerine götürdüklerini duyunca...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460662
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460663
    m_Localized: 'Jacket: Boş boş oturup beni götürmelerini bekleyemezdim. Ben de pencereden atlayıp kaçtım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460664
    m_Localized: 'Jacket: Ceketimi de alıp çıktım ama gidecek bir yerim yoktu. Bu yüzden kendimi kapında buldum işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460665
    m_Localized: Sadece ceketini mi aldın?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460666
    m_Localized: Yanına başka ne aldın?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460667
    m_Localized: 'Jacket: Evet, en sevdiğim ceket.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460668
    m_Localized: 'Jacket: Kimliğimi falan da aldım ama açıkçası en önemlisi ceketti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460669
    m_Localized: 'Jacket: Yanlış anlama, olay markası veya fiyatı değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460670
    m_Localized: 'Jacket: Kardeşimden geriye kalan sayılı şeylerden biri.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460671
    m_Localized: 'Jacket: Şu hâlimize bir bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460672
    m_Localized: Kardeşine ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460673
    m_Localized: 'Jacket: Uzun lafın kısası: Onu FEMA alıp götürdü, bir daha da görmedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460674
    m_Localized: 'Jacket: Eskiden denizciydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460675
    m_Localized: 'Jacket: Bu ceketi de... yurt dışından hediye olarak getirmişti. Bir yolculuğundan sonra.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460676
    m_Localized: 'Jacket: Küçük bir şey getirecek sanmıştım aslında. Ya o ahşap kalemlerden ya da magnet falan getirir, diye düşündüm...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460677
    m_Localized: 'Jacket: Fakat gitmiş, bu cekete para vermiş! Çok sevinmiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460678
    m_Localized: 'Jacket: Onu çok sık göremiyordum açıkçası. Beni düşünmesi çok sevindirmişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460679
    m_Localized: 'Jacket: İtiraf etmem gerekirse bu ceket yüzünden burada başım çok belaya girdi. Buralarda pek bulunmuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460680
    m_Localized: 'Jacket: Millet görüp çalmaya çalışıyor falan...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460681
    m_Localized: 'Jacket: Fakat ne olursa olsun vermem. Bir ceketten fazlası bu; kardeşimden geriye kalan bir hatıra...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460682
    m_Localized: 'Jacket: Umarım iyidir...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460683
    m_Localized: 'Jacket: Şu hâlimize bir bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460684
    m_Localized: Kardeşini belki karantina bölgesinde bulabilirsin, hiç düşündün mü?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460685
    m_Localized: 'Jacket: O kadar basit değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460686
    m_Localized: 'Jacket: Kardeşimi karantina bölgesine götürmediler. FEMA''ya aldılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460687
    m_Localized: Yoksa o?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460688
    m_Localized: Hay...
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460689
    m_Localized: 'Jacket: Evet. Onlardan biri artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460690
    m_Localized: 'Jacket: Ona bir seçenek bile vermediler. Kapısına üşüşüp "Sen iş görürsün," dediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460691
    m_Localized: 'Jacket: Bile isteye onlara katılmazdı. İmkânı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460692
    m_Localized: 'Jacket: Bu yüzden beni yakalamalarına izin veremem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460693
    m_Localized: 'Jacket: Olay Ziyaretçilerden korkmam değil. Herkes korkuyor zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460694
    m_Localized: 'Jacket: Fakat insanların korkma sebebi, karşılarındaki kişinin bir yaratık olup olmadığını bilmemek. Benim derdim başka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460695
    m_Localized: 'Jacket: Ya beni alıp götüren yetkili, kardeşim çıkarsa?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460696
    m_Localized: 'Jacket: Ne yapacak o zaman? Kuralları çiğneyip beni salacak mı? Ya öyle yaparsa?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460697
    m_Localized: 'Jacket: Peki ya emirlerine uyup beni diğerleriyle birlikte karantina bölgesine götürürse?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460698
    m_Localized: 'Jacket: Ona beni vurmasını emrederlerse?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460699
    m_Localized: 'Jacket: Tetiği çekenin kardeşim olduğunu bilmek beni rahatlatır mı yoksa bu daha mı beter olur?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460700
    m_Localized: 'Jacket: Çok saçma bir durum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460701
    m_Localized: 'Jacket: Kafamda deli sorular... ve en korkuncu da...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460702
    m_Localized: 'Jacket: Bir gün beni alıp götürürlerse... maskenin arkasında kendi kardeşim olup olmadığını bilemeyebilirim bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725184
    m_Localized: 'Tough: Her şey çok zor. Her şey.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725185
    m_Localized: Hayat sana pek acımamış sanırım
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725186
    m_Localized: 'Tough: Acıdığı herkes şimdiye ölmüştür muhtemelen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725187
    m_Localized: 'Tough: Para sayesinde itibar satın almak imkânsız hâle gelince eli temizler bunu kaldıramadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725188
    m_Localized: 'Tough: İnsan omurgasız olunca başkasının kurbanı olması da kolay oluyor. Tecavüzcüymüş, fırsatçıymış, manyağın tekiymiş fark etmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725189
    m_Localized: 'Tough: Sen de farkındasın, değil mi? İnsanlar hayvana dönüşüyor ama biz değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725190
    m_Localized: 'Tough: Biz onların seviyesine inmiyoruz. Biz karşı koyabiliyoruz, başkalarının hayatta kalmasına izin verebiliyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725191
    m_Localized: 'Tough: Biz, yaşamak isteyenleriz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725192
    m_Localized: 'Tough: Pis insanlar, korkak insanlar, pes eden insanlar... Hepsi süzgeçten geçirilecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725193
    m_Localized: 'Tough: Evet, kulağa radikal bir düşünce gibi gelebilir ama gerçek bu. Bunu düzeltemeyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725194
    m_Localized: 'Tough: Elimizden gelen tek şey, geriye kalan insanlığımıza tutunmak. Umarım burası, buna yardımcı olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725195
    m_Localized: 'Tough: Her şey çok zor. Her şey.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725196
    m_Localized: Sana katılıyor muyum, emin değilim
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725197
    m_Localized: 'Tough: "Her şey güzel olacak," deyip geçiştiremeyiz. Yani, istesek geçiştiririz ama hiçbir şeye yaramaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725198
    m_Localized: 'Tough: Bu yavan sözlerin bir manası yok. Ya cehenneme hazırsın ya da değilsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725199
    m_Localized: İnsanları niye ben teselli edeyim ki?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725200
    m_Localized: Bir kere bile olsa bunu duymak istemez miydin?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725201
    m_Localized: 'Tough: Ben de onu söylüyorum zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725202
    m_Localized: 'Tough: Bazı insanların elinden tutmak, götlerini temizlemek, her işlerini halletmek lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725203
    m_Localized: 'Tough: Vakit icraata gelince tıkanıp kalır onlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725204
    m_Localized: 'Tough: Domino gibi hem yıkılırlar hem başkalarını da yıkarlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725205
    m_Localized: 'Tough: "Her şey çok güzel olacak," demek bunu düzeltemez.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725206
    m_Localized: 'Tough: Bir daha bu acıyı çekmek istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725207
    m_Localized: 'Tough: Burada zafiyete yer yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725208
    m_Localized: 'Tough: Galiba biraz sert davranıyorum. Acısı hâlâ taze.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725209
    m_Localized: 'Tough: Sonra konuşalım, olur mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725210
    m_Localized: 'Tough: Ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725211
    m_Localized: 'Tough: Ne anlamı var ki bunun?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725212
    m_Localized: 'Tough: Kelimeler hiçbir şeyi değiştiremez. Ölüleri geri getiremezler, tecavüzcüleri hadım edemezler.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725213
    m_Localized: 'Tough: Ben gerçekleri söylerim, gerçeğin acısını dindiremem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725214
    m_Localized: 'Tough: Ya bu yeni dünyaya adapte olacağız ya da öleceğiz. Başka hiçbir şeyin manası yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725215
    m_Localized: 'Tough: Amacım sana atar yapmak değildi ama bir daha bana böyle salak salak sorular sorma.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725216
    m_Localized: 'Tough: Her şey çok zor. Her şey.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725217
    m_Localized: Ee... Bir şey mi diyecektin?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725218
    m_Localized: 'Tough: Seninle dürüst konuşacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725219
    m_Localized: 'Tough: Kilerdeki kutuyu nasıl izlediğini gördüm. Yatak odasındaki pencerenin yanında da nasıl durduğunu...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725220
    m_Localized: 'Tough: Dün gece baktım. Sen bu evde hapsolmuşsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725221
    m_Localized: 'Tough: Hayatta kalmak için mücadele etmiyorsun. Ölmekten korkuyorsun sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725222
    m_Localized: 'Tough: Haksız mıyım?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725223
    m_Localized: Haksızsın
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725224
    m_Localized: Siktir git
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725225
    m_Localized: 'Tough: Hadi lan oradan.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725226
    m_Localized: 'Tough: Baksana şu hâline, nasıl da kaskatı kesildin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725227
    m_Localized: 'Tough: Kafana sıkmamanın tek sebebi, korkun.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725228
    m_Localized: 'Tough: Başta hayatın zor geçti sandım, yaşadıkların yüzünden sert birine dönüştüğünü düşündüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725229
    m_Localized: 'Tough: Fakat fark ettim ki sen de aslında zorluktan kaçmayı başaran korkağın tekisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725230
    m_Localized: 'Tough: Hayal kırıklığına uğradım.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725231
    m_Localized: 'Tough: Artık seninle konuşmak istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725232
    m_Localized: 'Tough: Okulda zorbaların köşeye sıkıştırdığı masum bir velet gibisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725233
    m_Localized: 'Tough: Dediğimi kanıtladın. Elinde silah var diye kendini bir bok sanan ödleğin tekisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725234
    m_Localized: 'Tough: Benden bu kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725235
    m_Localized: 'Tough: Başta hayatın zor geçti sandım, yaşadıkların yüzünden sert birine dönüştüğünü düşündüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725236
    m_Localized: 'Tough: Fakat fark ettim ki sen de aslında zorluktan kaçmayı başaran korkağın tekisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725237
    m_Localized: 'Tough: Hayal kırıklığına uğradım.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725238
    m_Localized: 'Tough: Artık seninle konuşmak istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725239
    m_Localized: 'Tough: Her şey çok zor. Her şey.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725240
    m_Localized: Başka nerelere gizlice baktın?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725241
    m_Localized: 'Tough: Hayatta kalmak için elimden gelen her şeyi yaparım, bu yüzden baktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725242
    m_Localized: 'Tough: Karşımdaki insanı tanımam gerekiyordu. Nelere dikkat etmem gerektiğini de bilmem...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725243
    m_Localized: 'Tough: Burası anılarla dolu bir yer. Ölü akrabalarla...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725244
    m_Localized: 'Tough: Ben de anladım ki... sen geçmişi geçmişte bırakamıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725245
    m_Localized: 'Tough: Fakat bu beni ilgilendirmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725246
    m_Localized: 'Tough: Tek söyleyeceğim...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725247
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725248
    m_Localized: 'Tough: Eskiden daha saf biriydim. Gençtim. Bir çocukla tanışmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725249
    m_Localized: 'Tough: Evine uğramamız gerektiğini söyledi, annesine bir şey bırakacakmış. Ben içeri girmek istemedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725250
    m_Localized: 'Tough: Dışarıda beklemeye karar verdim ama pencereden beni içeri çağırdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725251
    m_Localized: 'Tough: Ben de içeri girdim. İçeride annesi falan yoktu. Sadece o şerefsiz ve arkadaşı vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725252
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725253
    m_Localized: 'Tough: Dünya böyle boka sarınca ikisini de buldum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725254
    m_Localized: 'Tough: Kendimi daha iyi hissetmedim ama açıkçası.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725255
    m_Localized: 'Tough: Uzun süre kendimi "lekeli" sanmıştım. Bir daha asla temiz olmayacağımı... Sonra dünya sona erdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725256
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725257
    m_Localized: 'Tough: Böyle piçler merhameti hak etmiyor. Zayıflar da aynı şekilde. Böyle şeylerin yaşanmasına izin veriyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725258
    m_Localized: 'Tough: Bir daha eşyalarını karıştırmayacağım ama sanırım beni anladın artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725259
    m_Localized: 'Bald: 1, 2, 3, 4... Evini yak, üstünü ört... Şaka, şaka.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725260
    m_Localized: Dostlarına ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725261
    m_Localized: 'Bald: Hah! Tiyatro okulunda tanışmıştık.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725262
    m_Localized: 'Bald: Hatta ben tiyatro yönetmenliği okudum ve şimdiden söyleyeyim arkadaşım, hiç kimseye önermem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725263
    m_Localized: 'Bald: Hatta genel olarak tiyatroyu önermem. Dışarıdan şık görünüyor olabilir ama artık kimse sahnenin değerini bilmiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725264
    m_Localized: 'Bald: Bunu sadece "sanat için" yapacaksan ve ölene dek fakir kalmaya tamamsan buyur.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725265
    m_Localized: 'Bald: Meşhur sahnelere çıkan bir iki tane büyük tiyatro topluluğu var ama onlar da tek tük.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725266
    m_Localized: 'Bald: Geri kalan herkesin bütçesi düşük. İnsanlar artık filmlere gitmeyi tercih ediyor. Hem daha ucuz hem daha aksiyonlu hem de daha basit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725267
    m_Localized: 'Bald: Öyle yani... Büyük bir hayal kırıklığı işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725268
    m_Localized: 'Bald: 1, 2, 3, 4... Evini yak, üstünü ört... Şaka, şaka.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725269
    m_Localized: Tamam, tiyatronun kötü olduğunu anladım da peki ya arkadaşların?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725270
    m_Localized: 'Bald: Ha, doğru. Pardon. O hikâyeyi bitiremedim bir türlü. Kusura bakma, dikkatim biraz dağınıktır. Tek bir konuya odaklanamıyorum. Neyse...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725271
    m_Localized: 'Bald: Arkadaşlarımın hepsi ya oyuncuydu, ya prodüktördü, ya sesle uğraşıyordu ya da ışıkla. Öyle bir ekip düşün.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725272
    m_Localized: 'Bald: Tanıştığımız günden itibaren birlikte içmeye başladık. Hatta doğum günlerimde sahne tutardım, yüz kişi gelirdi!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725273
    m_Localized: 'Bald: Harika olurdu! Düşünsene, yüz kişi seni kutlamaya geliyor! Ne güzel günlerdi...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725274
    m_Localized: 'Bald: Fakat tiyatro dünyası çok sıkıntılıdır. Herkes birbirini baltalamaya çalışır. Para az olunca stres çok oluyor tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725275
    m_Localized: 'Bald: Zaman içinde bu partiler azaldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725276
    m_Localized: 'Bald: Doğum günüme gelenlerin gerçek arkadaşlarım olmadığını... öylesine geldiklerini fark ettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725277
    m_Localized: 'Bald: İşlerine gelince beni kullanıyorlardı veya arkamdan konuşuyorlardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725278
    m_Localized: 'Bald: Beni yanlış anlama ama ha! Oturdum, liste hazırladım, kimlerle ilişkimi keseceğime karar verdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725279
    m_Localized: 'Bald: 1, 2, 3, 4... Evini yak, üstünü ört... Şaka, şaka.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725280
    m_Localized: Peki listendeki arkadaşların nerede?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725281
    m_Localized: 'Bald: Tahsildar mevzusu kopunca yardım aramaya başladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725282
    m_Localized: 'Bald: Tabii, tam o sırada da güneş milleti kavurmaya başladı ve bu Ziyaretçiler ortaya çıktı. İşler zaten kötüydü, İYİCE kötü oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725283
    m_Localized: 'Bald: Ben de tüm arkadaşlarıma tek tek uğradım.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725284
    m_Localized: 'Bald: Biri canlı canlı yanmış. Sarhoş olup bir parkta sızmış. Güneş doğana kadar uyanamamış.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725285
    m_Localized: 'Bald: Birini de öldürmüşler. İnanabiliyor musun? Ziyaretçi sanmışlar adamı!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725286
    m_Localized: 'Bald: Millet kafayı yemiş! Bu sözde "belirtiler" tamamen palavra! Boş yere arkadaşımın ölümüne sebep oldular.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725287
    m_Localized: 'Bald: Çok sinir ediyor beni... ve bu duyguyu nasıl kullanacağımı bile bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725288
    m_Localized: 'Bald: Öfke ve çaresizlik bir araya gelince... insan donup kalıyor. Etrafındaki herkesten nefret etmeye başlıyor. Kendinden de.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725289
    m_Localized: 'Bald: Siktiklerim...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725290
    m_Localized: 'Bald: 1, 2, 3, 4... Evini yak, üstünü ört... Şaka, şaka.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725291
    m_Localized: Bu tahsildar mevzusu ne tam olarak?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725292
    m_Localized: 'Bald: Annem ve anneannemle yaşıyordum ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725293
    m_Localized: 'Bald: Babam bizi terk etmişti; hem annemi aldatmıştı hem de ayyaşın tekiydi. Standart bir tiyatro oyuncusuydu yani. Annem de kostüm departmanında çalışıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725294
    m_Localized: 'Bald: Hayatı boyunca beni korumaya çalıştı. Büyüdüğüm zaman ne kadar sıkıntı çektiğimizi anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725295
    m_Localized: 'Bald: Annem her zaman iş bulamıyordu. Büyük tiyatrolar zaten imkânsız, küçüklerde ise ya düşük ücrete çalışıyorsun ya da çalışamıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725296
    m_Localized: 'Bald: Borç almak zorunda kaldı. Tanıdığı birinden de değil, rastgele bir bankadan kredi çekti. Sırf aç kalmayalım diye.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725297
    m_Localized: 'Bald: Tabii, borcunu ödeyemedi. Tahsildarlar kapımıza dayandı.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725298
    m_Localized: 'Bald: Evde çok sıkı bir kuralımız vardı, hâlâ aklımdan çıkmaz: Birini beklemiyorsan asla kapıyı açma.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725299
    m_Localized: 'Bald: Eve vardığında kapıda tanımadığın insanlar görürsen de bir iki saat yürüyüşe çık, öyle gel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725300
    m_Localized: 'Bald: Rezaletti.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725301
    m_Localized: 'Bald: Ortalık iyice karışınca... insanlar da vahşileşti. Tahsildarlar daha da agresifleşti.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725302
    m_Localized: 'Bald: Bir gün eve geldim, kapı ağzına kadar açık. Ortalık darmadağın. Annem ve anneannem... Sikeyim... Parmakları, bacakları kırılmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725303
    m_Localized: 'Bald: Kâbus gibiydi amına koyayım...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725304
    m_Localized: 'Bald: Sonra iki iri yarı adam geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725305
    m_Localized: 'Bald: Ben de kaçtım. Kaçtım tabii...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725306
    m_Localized: 'Bald: Korkmuştum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725307
    m_Localized: 'Bald: Ama sikeyim... hâlâ korkup kaçtığım için, onları korumadığım için, geri dönemediğim için kendimden nefret ediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725308
    m_Localized: 'Bald: Ödleğin tekiyim işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725309
    m_Localized: 'Bald: Hem ödlek hem de bencil.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725310
    m_Localized: 'Bald: Bunun ne kadar boktan bir şey olduğunu... anlatmama kelimeler yetmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725311
    m_Localized: 'Nervous: Oraya dönmek istemiyorum, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725312
    m_Localized: Sen... bir garipsin
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725313
    m_Localized: 'Nervous: Öyle mi? Peki sana ne bundan? Ha? Ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725314
    m_Localized: 'Nervous: Yoksa sen de beni mi gözetliyorsun? Ha? Ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725315
    m_Localized: 'Nervous: Haberin olsun, ben bundan hiç hoşlanmam. Tımarhaneden beri en azından...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725316
    m_Localized: 'Nervous: Annemler beni deliler hastanesine tıktılar. İnanılır gibi değil! Hihi...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725317
    m_Localized: 'Nervous: Neymiş, birini ta... kip etmişim. Ne var bunda?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725318
    m_Localized: 'Nervous: Yanlış bir şey yapmadım ki, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725319
    m_Localized: 'Nervous: Ama annemler beni delinin teki sandılarrrrrrr... Hâlâ da sanıyor olabilirler.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725320
    m_Localized: 'Nervous: On sene beni o deliler hastanesinde tuttular sonuçta. Sanırsın manyağım, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725321
    m_Localized: 'Nervous: Hepsi tek bir olay yüzünden...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725322
    m_Localized: 'Nervous: Neyse, boş ver. Oteli aramam lazım. Dırıring, dırıring!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725323
    m_Localized: 'Nervous: Oraya dönmek istemiyorum, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725324
    m_Localized: Sen öncesinde ne anlatıyordun?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725325
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725326
    m_Localized: 'Nervous: Okulda zorbalığa uğradım. Diğer çocuklar beni yalnız bırakmadı, her gün beni rahatsız edip durdular.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725327
    m_Localized: 'Nervous: Ben de dayanamadım. Bana hacıyatmaz gibi davranamazlar. Beni ağlatana kadar dövemezler...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725328
    m_Localized: 'Nervous: Ben de savaştım. Yere düştüler... ve bir daha kalkmadılar. Galiba has... tanedeymiş. Ölmüş.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725329
    m_Localized: 'Nervous: Onu öldürmek istememiştim ama işte... Annemler bir şekilde hallettiler. Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725330
    m_Localized: 'Nervous: Hâlâ bana fısıldıyorlar ama. Sen de duyuyor musun? Şşş...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725331
    m_Localized: 'Nervous: Sonra beni deliler hastanesine götürdüler işte. Böyle başa sardık!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725332
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725333
    m_Localized: 'Nervous: O kavga... Güzel hissettirdi... Güç... İn... tikam...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725334
    m_Localized: 'Nervous: Parmaklarım acıdı ama çok hoşuma gitti. Dudağım, dilim kıpkırmızıydı, lezizdi... Mmmhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725335
    m_Localized: 'Nervous: Beni okuldan attılar ama ben sadece kendimi savunuyordum, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725336
    m_Localized: 'Nervous: Oraya dönmek istemiyorum, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725337
    m_Localized: Tımarhane sana pek yaramamış
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725338
    m_Localized: 'Nervous: Hem de hiç, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725339
    m_Localized: 'Nervous: Haplar seni sebzeye dönüştürünce... kendi kendine haşlanmaya başlıyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725340
    m_Localized: 'Nervous: Hiç iyileşmedim. Hiçbir şey kolaylaşmadı. On senem orada geçti ve en son burada buldum kendimi. Ta dam!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725341
    m_Localized: 'Nervous: Hepsi tek bir minicik hata yüzünden...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725342
    m_Localized: 'Nervous: Hihihihihi...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725343
    m_Localized: 'Nervous: Sanki kimse hata yapmıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725344
    m_Localized: 'Nervous: Baksana, nasıl da yargılayıcı bakıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725345
    m_Localized: 'Nervous: Vuracak mısın? Vur hadi!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725346
    m_Localized: 'Nervous: Ağzımı yüzümü dağıt, parmaklarımı kır! EVET! Bana o heyecanı yaşat, istediğimi ver bana! Evvvveeetttt!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725347
    m_Localized: 'Nervous: Ne? Bana vurmayacak mısın? İçinden gelmiyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725348
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725349
    m_Localized: 'Nervous: Hihi... Fikrin değişene kadar burada beklerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725350
    m_Localized: 'Nervous: Burası... otelden daha sakin aslında.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725351
    m_Localized: 'Nervous: Beni içeri aldığın için sağ ol. Hihi...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725352
    m_Localized: 'Nervous: En azından burada herkes deli...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725353
    m_Localized: 'Leper: Efendim? Ne var?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725354
    m_Localized: Böyle görünmek zor mu?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725355
    m_Localized: 'Leper: Pek değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725356
    m_Localized: 'Leper: Okulda "cüzzamlı" diyorlardı bana, bir o var. Kimse benimle oynamazdı. Bir şey kapacaklarını sanırlardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725357
    m_Localized: 'Leper: Büyüdüğümde durur sanmıştım ki durdu da... Yani, genel olarak. Evet, insanların hâlâ benden korktuğu oluyor ama bu hiçbir şey.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725358
    m_Localized: 'Leper: Kıyamet koptuktan sonra o eski ön yargıların hepsi geri döndü.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725359
    m_Localized: 'Leper: Fakat artık durum daha kötü çünkü bu bir hayatta kalma meselesi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725360
    m_Localized: 'Leper: Cildim yüzünden Ziyaretçi gibi görünüyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725361
    m_Localized: 'Leper: Yapacak bir şey yok. Kötü zamanlar, insanları kötülüğe sürükler.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725362
    m_Localized: 'Leper: Efendim? Ne var?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725363
    m_Localized: Sırf cilt hastalığın yüzünden seni Ziyaretçi mi sanıyorlar?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725364
    m_Localized: 'Leper: E tabii, ne sandın?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725365
    m_Localized: 'Leper: Millet bildiğin birbirini linç etmeye çalışıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725366
    m_Localized: 'Leper: "Normal" görünmeyen herkesi öldürmek mübah. FEMA''nın astığı astık, kestiği kestik.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725367
    m_Localized: 'Leper: Düşünüyorum da acaba tüm bunların arkasında onlar mı var?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725368
    m_Localized: 'Leper: Ya Ziyaretçileri onlar uydurduysa? Sen ne düşünüyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725369
    m_Localized: Haklı olabilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725370
    m_Localized: Bence Ziyaretçiler gerçek
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725371
    m_Localized: 'Leper: Hemfikir olmamıza sevindim. Ziyaretçi miyaretçi, hepsi palavra.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725372
    m_Localized: 'Leper: Film senaryosu gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725373
    m_Localized: 'Leper: Belki de bu şekilde darbe yapacaklardır. Güç elde etmenin en kolay yolu korku sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725374
    m_Localized: 'Leper: Muhtemelen bu yüzden kendileriyle hemfikir olmayan herkesi "karantina bölgesine" tıkıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725375
    m_Localized: 'Leper: Tabii, böylece Ziyaretçilerle savaşıyorlar gibi görünüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725376
    m_Localized: 'Leper: Ziyaretçiler gerçek değilse bile FEMA''nın peşime düşmesini istemezdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725377
    m_Localized: 'Leper: Bana korkunç bir şey yapacaklarını düşünmeden edemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725378
    m_Localized: 'Leper: Sence gerçekler mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725379
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725380
    m_Localized: 'Leper: Gerçeklerse bile sence de FEMA bir garip davranmıyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725381
    m_Localized: 'Leper: Ziyaretçilerin bir virüs olduğunu söylüyorlar ama nasıl yayıldığını hiç anlatmıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725382
    m_Localized: 'Leper: Bir virüsü durdurmak istiyorsan ilk yapacağın şey nasıl yayıldığını anlatmak olmaz mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919488
    m_Localized: 'Leper: Bilemiyorum, belki de bir tür "tedavinin" peşindelerdir.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919489
    m_Localized: 'Leper: Fakat içimde bir his var... Eğer karantina bölgelerinden birine düşersem bana korkunç bir şey yapacaklar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919490
    m_Localized: 'Leper: Efendim? Ne var?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919491
    m_Localized: Neden FEMA'nın kötü bir şey yapacağını düşünüyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919492
    m_Localized: 'Leper: Çünkü tek gördükleri şey, benim cilt hastalığım olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919493
    m_Localized: 'Leper: Sırtımda hedef tahtası var bildiğin. Kalabalığın arasından beni "denek" olarak seçme ihtimalleri daha yüksek.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919494
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919495
    m_Localized: 'Leper: Hepsi bu siktiğimin hastalığı yüzünden.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919496
    m_Localized: Endişelenmene gerek yok, şu an buradasın
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919497
    m_Localized: Çok kafana takıyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919498
    m_Localized: 'Leper: Öyle mi? Demek senin kapına uğramadılar daha.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919499
    m_Localized: 'Leper: Sence benim bu hâlimi görürlerse peşimi bırakırlar mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919500
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919501
    m_Localized: 'Leper: Demek öyle? Sen hiç o anaokulu yangınını duydun mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919502
    m_Localized: 'Leper: Ebeveynlerin çocuklarını canlı canlı yaktıkları hani?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919503
    m_Localized: 'Leper: Anlamıyorsun beni. Yüz yıl geriye gittik. Millet her geçen gün iyice kafayı yiyor, FEMA da bundan faydalanıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919504
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919505
    m_Localized: 'Leper: Keşke insanlar birbirlerini dış görünüşe göre yargılamayı bıraksa...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919506
    m_Localized: 'Leper: İnsanoğlu ne kadar uzun süre yaşarsa yaşasın birbirine etiket yapıştırmayı bırakmayacak belli ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919507
    m_Localized: 'Leper: Toplumda kime yer olup olmadığına karar vermeyi kolaylaştırıyor çünkü.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919508
    m_Localized: 'Leper: Bu küçük zihinli zalimler yüzünden benim gibi insanlar acı çekiyor hep.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919509
    m_Localized: 'Leper: Gerçekten çok üzücü.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891008
    m_Localized: 'Fairytaller: Yardımcı olabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891009
    m_Localized: Düşünceli görünüyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891010
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891011
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891012
    m_Localized: 'Fairytaller: Çocukluğumdan bir masalı düşünüyordum da. Bir varmış, bir yokmuş, büyülü bir ormanda şakrak kuşları yaşarmış...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891013
    m_Localized: 'Fairytaller: Sonra bir ejderha gelmiş ve her şeyi yakmış. Yuvaları, kuşları...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891014
    m_Localized: 'Fairytaller: Aslında eşitlermiş. İki tarafın da kanatları varmış, göklerde süzülürlermiş. Huzur içinde yaşar, ormanın ganimetlerini paylaşırlarmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891015
    m_Localized: 'Fairytaller: Fakat ejderhanın gücü, zihnini bulandırmış. Bir zamanlar sevdiği şeyleri bile yakmış kül etmiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891016
    m_Localized: 'Fairytaller: Babam, her birimizin içinde bir ejderhanın uyuduğunu savunurdu hep.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891017
    m_Localized: 'Fairytaller: Kardeşim ve ben, buna hiç inanmadık. Ona kahkaha atar, "Ejderhalar çok büyük, insanlar çok küçük," derdik.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891018
    m_Localized: 'Fairytaller: Sonra büyüdüm ve demek istediğini anladım. Keşke bunu da ona söyleyebilsem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891019
    m_Localized: 'Fairytaller: Arada bir aklıma takılıyor. Kendi ejderhamı kesebilecek miyim yoksa şeytana mı uyacağım?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891020
    m_Localized: 'Fairytaller: Yardımcı olabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891021
    m_Localized: Yine masal mı düşünüyordun?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891022
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891023
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891024
    m_Localized: 'Fairytaller: Evet. Bugün aklıma başka bir masal geldi. Bir varmış, bir yokmuş, uzun duvarlarla ve donuk kulelerle sarılı bir Donmuş Şehir varmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891025
    m_Localized: 'Fairytaller: Bu şehrin vatandaşları yüzyıllar boyunca birbirlerine güvenmeden yaşamış. Hep böyle olacağını düşünmüşler.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891026
    m_Localized: 'Fairytaller: Sonra seyyah bir camcı şehre uğramış ve zaman içinde her şey değişmiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891027
    m_Localized: 'Fairytaller: Sokakları cam fenerleriyle kaplamış ve hemşehrilerine günaydın demeyi hiç ihmal etmemiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891028
    m_Localized: 'Fairytaller: Başta ona gülmüşler fakat sonra yavaş yavaş donuk yürekleri çözülmeye başlamış.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891029
    m_Localized: 'Fairytaller: Bir gecede her şeyi değiştirmek imkânsızdır. Asıl değişim, insanın içinde başlamalıdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891030
    m_Localized: 'Fairytaller: Dünya ne kadar karanlık olsa dahi kendi fenerini yakman gerekir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891031
    m_Localized: 'Fairytaller: Annem, ruhu şad olsun, "Bu masalın ana fikri basit," deyip gülerdi hep. Değişimi bekleyip durursan anca beklersin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891032
    m_Localized: 'Fairytaller: Nihayetinde bu dünyayı canlı tutan bizleriz. Elimizden geleni yapmazsak kaybetmiş oluruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891033
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891034
    m_Localized: 'Fairytaller: Ben nezakete, insanlığa tutunmaya çalışırım. Ne kadar canımı yaksa da. Böylece başkalarına yol gösterebileceğimi umarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891035
    m_Localized: 'Fairytaller: Yardımcı olabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891036
    m_Localized: Bugün bana nasıl bir masal anlatacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891037
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891038
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891039
    m_Localized: 'Fairytaller: Anlatacağım daha çok masal var... Yaşayan ölüleri ve geride bırakılanları anlatan bir masal...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891040
    m_Localized: 'Fairytaller: Gün doğumuna dek insan kılığına girip başkalarının kapısını çalan ve soru soran bir iblisi anlatan bir masal...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891041
    m_Localized: 'Fairytaller: İnsanoğlunun kızıl güneşin öfkesini hissettiğini, mahsullerinin lanetlendiğini ve nehirlerinin zehirlendiğini anlatan bir masal...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891042
    m_Localized: 'Fairytaller: Fakat tüm bu masallarda cesur bir kahraman, bir grup yiğit veya hatta koca bir ulus, dünyayı kurtarıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891043
    m_Localized: 'Fairytaller: İyilik hep kazanıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891044
    m_Localized: 'Fairytaller: Ben bizim hikâyemizin de bir kahramanı olacağına inanmak istiyorum. Bir gün gelecek, her şey sona erecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891045
    m_Localized: 'Fairytaller: Ebeveynlerimiz yaşıyor olacak. Herkes sevdiğini yapabilecek ve...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891046
    m_Localized: 'Fairytaller: Kusura bakma, kendimi kaptırdım. Sanırım bir süre yalnız kalmam gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891047
    m_Localized: 'FunnyGuy: Hepimiz o kadar kalender olabilirdik ki!..'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891048
    m_Localized: Borçlarını unutacaklarından nasıl bu kadar emin olabiliyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891049
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891050
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891051
    m_Localized: 'FunnyGuy: Dalga mı geçiyorsun sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891052
    m_Localized: 'FunnyGuy: Dünyanın sonu geldi be! Ne bankası, ne ekonomisi?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891053
    m_Localized: 'FunnyGuy: Artık kimsenin umurunda bile değil. Bunu bizzat gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891054
    m_Localized: 'FunnyGuy: Normalde bir ödemeyi geciktirirsem bir sürü uyarı, mektup, tehdit falan gelir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891055
    m_Localized: 'FunnyGuy: Bu sefer tamamen sessizler ama. Harika bir his!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891056
    m_Localized: 'FunnyGuy: Yalnızca güneş battıktan sonra bulabilecekleri bir grup borçluya ne yapabilirler ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891057
    m_Localized: 'FunnyGuy: E tabii, yeni kredi veren de kalmadı. İnan bana, denedim!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891058
    m_Localized: 'FunnyGuy: Neyse, borç batağından kurtulmak benim için yeterli!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891059
    m_Localized: Yerinde olsam hemen rahatlamazdım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891060
    m_Localized: Ee, bunu kutluyor muyuz peki?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891061
    m_Localized: 'FunnyGuy: Hadi ama ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891062
    m_Localized: 'FunnyGuy: Niye kendimi gereyim ki? Beni kimsenin umursadığı yok artık. Muhtemelen sığınak falan kazmakla meşgullerdir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891063
    m_Localized: 'FunnyGuy: Niye hödüğün tekinin peşine düşsünler?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891064
    m_Localized: Madem öyle, kendi evine gitsene?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891065
    m_Localized: Buraya böbürlenmeye mi geldin yani?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891066
    m_Localized: 'FunnyGuy: E tabii!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891067
    m_Localized: 'FunnyGuy: Mükemmel bir moddayım şu an, sohbet edesim var!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891068
    m_Localized: Madem öyle, kendi evine gitsene?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891069
    m_Localized: Buraya böbürlenmeye mi geldin yani?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891070
    m_Localized: 'FunnyGuy: Yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891071
    m_Localized: 'FunnyGuy: Evimi kiraya vermiştim. Hâlâ kirada sayılır ama bu aralar para pek bir işe yaramıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891072
    m_Localized: 'FunnyGuy: Etrafta dolaşıyorsun, pencere görünce kırıyorsun, içeriden ihtiyacın olanı alıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862528
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862529
    m_Localized: 'FunnyGuy: Ne? Ne diye yargılıyorsun beni?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862530
    m_Localized: Soruya cevap versene
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862531
    m_Localized: Hiç umurumda olmadığını fark ettim şu an
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862532
    m_Localized: 'FunnyGuy: Hadi ama ya. Böyle davranmaya gerek yok. Kötü bir şey demedim ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862533
    m_Localized: 'FunnyGuy: Şaka yapacaksan da bu kadar kaba olmana gerek yok yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862534
    m_Localized: 'FunnyGuy: Baksana, modumu düşürdün hemen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862535
    m_Localized: Soruya cevap versene
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862536
    m_Localized: Hiç umurumda olmadığını fark ettim şu an
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862537
    m_Localized: 'FunnyGuy: Tabii, tabii...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862538
    m_Localized: 'FunnyGuy: Bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862539
    m_Localized: 'FunnyGuy: Sorudan kaçtığım yok... Korkuyorum sadece, tamam mı? Geri dönmekten korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862540
    m_Localized: 'FunnyGuy: Evimi bir aileye kiralamıştım. Kredi ödemelerimde bana yardımcı oluyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862541
    m_Localized: 'FunnyGuy: Fakat hâlâ... insanlar mı, emin değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862542
    m_Localized: 'FunnyGuy: Komşularım birkaç kere aradı. Bağırma çağırma, giren çıkan olduğunu söylediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862543
    m_Localized: 'FunnyGuy: Gerçi bu komşularım osuruktan nem kapıyordu zaten. Kafayı yiyecektim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862544
    m_Localized: 'FunnyGuy: Ama ya haklılarsa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862545
    m_Localized: 'FunnyGuy: Dur, lafımı bitireyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862546
    m_Localized: 'FunnyGuy: Bunun içimde kalmasını istemiyorum. Ne kadar rahatsız olduğumu göremiyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862547
    m_Localized: 'FunnyGuy: Kendime bir ev almıştım ama içinde yaşamaktan korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862548
    m_Localized: 'FunnyGuy: Bir aileye kiraladım, aldığım parayı krediyi ödemek için kullanıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862549
    m_Localized: 'FunnyGuy: Fakat şimdi... Sikeyim... Kapıyı çalmaktan korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862550
    m_Localized: 'FunnyGuy: Komşularım garip şeyler yaşandığını söylediler. Evden hiç çıkmıyorlar zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862551
    m_Localized: 'FunnyGuy: Evet, artık kredi ödememe gerek yok ama onları evden çıkarmaya da kalkışamam herhâlde!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862552
    m_Localized: 'FunnyGuy: Hepimiz o kadar kalender olabilirdik ki!..'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862553
    m_Localized: Senin bu kiracılardan haber var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862554
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862555
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862556
    m_Localized: 'FunnyGuy: Ne? Ha, onlar mı? Başka bir sıkıntı çıktı.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862557
    m_Localized: 'FunnyGuy: Bu gece komşuları aradım, umarım sıkıntı değildir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862558
    m_Localized: 'FunnyGuy: Bankadan elemanlar gelmiş. Ödemelerimi sormuşlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862559
    m_Localized: 'FunnyGuy: İyi ki orada kalmıyorum ama yine de...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862560
    m_Localized: 'FunnyGuy: Güneş patlasa bile peşime mi düşecekler bunlar?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862561
    m_Localized: 'FunnyGuy: İnanılır gibi değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862562
    m_Localized: 'FunnyGuy: Ellerinde olsa borçluları diriltirler.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862563
    m_Localized: 'FunnyGuy: Bunların işi gücü yok mu yahu? Niye bizi kovalıyorlar ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862564
    m_Localized: 'FunnyGuy: Şerefsizler.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862565
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862566
    m_Localized: 'FunnyGuy: Neyse, bir süre burada kalacağım. Belki sonra yine akrabalarıma geçerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862567
    m_Localized: 'FunnyGuy: Kalabalığı seviyorsan çok iyi ortam.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862568
    m_Localized: 'FunnyGuy: Gerçekten manyak bunlar ya. Dünyanın sonu geldi amına koyayım, daha ne uğraşıyorsunuz?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862569
    m_Localized: 'FunnyGuy: Öbür tarafta borçlarını öderler.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862570
    m_Localized: 'FunnyGuy: Hepimiz o kadar kalender olabilirdik ki!..'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862571
    m_Localized: Evine mi dönüyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862572
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862573
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862574
    m_Localized: 'FunnyGuy: Ortalık iyice karıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862575
    m_Localized: 'FunnyGuy: Yine telefonunu kullandım, umarım sorun değildir. Bu sefer bankayla konuştum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862576
    m_Localized: 'FunnyGuy: Hesaplarımı dondurmuşlar. Bir de para biriktiriyordum sözde!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862577
    m_Localized: 'FunnyGuy: Şimdi bir kuruşuna bile dokunamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862578
    m_Localized: 'FunnyGuy: Borçtan dediler ama bence palavra. İsteseler aylık olarak ödeme alabilirler.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862579
    m_Localized: 'FunnyGuy: Tüm hesabı dondurmak tamamen saçmalık.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862580
    m_Localized: 'FunnyGuy: Bana sorarsan FEMA projelerini fonlamak için böyle yapıyorlar. Personel, deneyler falan filan.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862581
    m_Localized: 'FunnyGuy: Ne bok yiyorlarsa yesinler. Bir kuruş bile ödemem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862582
    m_Localized: 'FunnyGuy: Sorun değilse bir süre burada kalacağım. Şu hâlde ailemin yanına dönemem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862583
    m_Localized: 'FunnyGuy: Muhtemelen satın aldığım daire de ya Ziyaretçi yuvası ya da FEMA laboratuvarı olmuştur.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862584
    m_Localized: 'Alt: Her geçen gün hayat zorlaşıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862585
    m_Localized: Kapıda epey bir konuştun
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862586
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862587
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862588
    m_Localized: 'Alt: Ha, fark ettin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862589
    m_Localized: 'Alt: Mesleki deformasyon diyelim. Çok konuşmak yani. Özellikle de gerginken.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862590
    m_Localized: 'Alt: Hep bir şeyleri düzeltmek, doğru yola koymak zorunda hissediyorum. Alışması kolay olsun diye.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862591
    m_Localized: 'Alt: Eskiden radyo sunucusuydum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862592
    m_Localized: Vay be
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862593
    m_Localized: Asla tahmin etmezdim
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862594
    m_Localized: 'Alt: Ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862595
    m_Localized: 'Alt: İster inan ister inanma, umurumda değil. Orada kalmak imkânsız hâle gelmişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862596
    m_Localized: 'Alt: İyice sirke dönüştü. Yoldan geçen her dolandırıcıyı bir şey satsın diye programa alıyorlar. İnsanlara pahalı bir huzur satıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862597
    m_Localized: 'Alt: "İşte tüm dertlerine derman olacak bir krem!" "Radyonun yanına bir bardak su koyun yeter, tüm dalgaları soğurur!"'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862598
    m_Localized: 'Alt: Giderek kötüleşti bir de.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862599
    m_Localized: 'Alt: Bunun parçası olmak istemiyordum artık. Burama kadar gelmişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862600
    m_Localized: 'Alt: Haberlere hiç girmiyorum bile. Öyle boş boş oturup nasıl hâlâ hayatta olduğumuzu düşünüyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862601
    m_Localized: 'Alt: Radyo sunucusu neye benzer sanıyordun? Gözlüklü, takım elbiseli bir çokbilmişin tekine mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862602
    m_Localized: 'Alt: Klişeler yüzünden böyle düşünüyorsun, anlıyorum ama bu senin sorunun.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862603
    m_Localized: 'Alt: Hep ilgi çekici ziyaretçilerle sohbet edeceğimi sanırdım... Stüdyoya gelen misafirlerden bahsediyorum tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862604
    m_Localized: 'Alt: Ama tam tersine her gün iç karartıcı bir haber anlatıyordum. Her şeye son verme dürtüsüne karşı koymak giderek zorlaştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862605
    m_Localized: 'Alt: Bir de milleti dolandırmaya çalışan inatçı salaklar vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862606
    m_Localized: 'Alt: Radyo iyice sirke döndü. Palyaço arabasının direksiyonunda da ben vardım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862607
    m_Localized: 'Alt: Her geçen gün hayat zorlaşıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862608
    m_Localized: Gına gelince işi bıraktın, öyle mi?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862609
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862610
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862611
    m_Localized: 'Alt: Yani... Özetleyecek olursak evet.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862612
    m_Localized: 'Alt: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862613
    m_Localized: 'Alt: Kırılma noktası neydi, biliyor musun? Yine bir delinin tekiyle yayın yapıyorduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862614
    m_Localized: 'Alt: "Uzmanın" teki canlı yayında Ziyaretçiler hakkında bilgi verecekti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862615
    m_Localized: 'Alt: Onlarla savaşmanın bir yolunu bulduğuna yemin etmişti... Ne dediğini bile hatırlamıyorum. Yine pahalı ve sahte bir mal işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862616
    m_Localized: 'Alt: Hatta programa çıkmak için parayı önceden vermişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862617
    m_Localized: 'Alt: Bir hafta boyunca onu araştırdım. Yaptığı ne kadar şüpheli iş varsa hepsini topladım, canlı yayında herifi parçalamaya hazırlandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862618
    m_Localized: 'Alt: Şahane bir program olacaktı...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862619
    m_Localized: 'Alt: ...ama olmadı. Niye, biliyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862620
    m_Localized: 'Alt: Birisi belgelerini çaldı diye iptal etti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862621
    m_Localized: 'Alt: Kilotonlarca veri, puf oldu gitti!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862622
    m_Localized: 'Alt: Hangi salak bunu yapmış olabilir ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862623
    m_Localized: 'Alt: Tüm planım suya düştü. Araştırmalar tamamen boşa gitti. Bir daha da heriften haber alamadık.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862624
    m_Localized: 'Alt: Şerefsiz...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862625
    m_Localized: 'Alt: Her geçen gün hayat zorlaşıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862626
    m_Localized: Haberciliği tamamen bıraktın mı yani?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862627
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862628
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862629
    m_Localized: 'Alt: Artık tek planım, hayatta kalmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862630
    m_Localized: 'Alt: Özellikle bu güneş patlamaları başlayınca farklı departmanlara sızmaya çalışmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862631
    m_Localized: 'Alt: Fakat bu işin nereye gideceği belli.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862632
    m_Localized: 'Alt: Polis eskiden şehrin dört bir yanından bize günlük rapor verirdi. Çoğu haberi de öyle hazırlardık.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862633
    m_Localized: 'Alt: Sonra raporlar gecikmeye başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862634
    m_Localized: 'Alt: Bir de farklı yazıldıklarını fark ettim. Her gün aynı şeyi okuyunca insan anlıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862635
    m_Localized: 'Alt: Bir gariplik vardı yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862636
    m_Localized: 'Alt: O anda şehirlerden uzak kalmam gerektiğini anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862637
    m_Localized: 'Alt: Kenarda kuytuda olmak en iyisi. Hatta ormana taşınmayı bile düşündüm ama şu sıralar pek mantıklı bir fikir değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862638
    m_Localized: 'Alt: Hayat zor artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862639
    m_Localized: 'Tourist: Keşke buradan kurtulabilsem...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862640
    m_Localized: Nereye gitmeyi planlıyordun?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862641
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862642
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862643
    m_Localized: 'Tourist: Ne önemi kaldı ki? Artık evime dönemeyeceğim...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862644
    m_Localized: 'Tourist: Bu güneşin de Ziyaretçi istilasının da...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862645
    m_Localized: 'Tourist: Sadece burası mı böyle yoksa her yerde aynı mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862646
    m_Localized: 'Tourist: Çok uzun süredir bu tatili planlıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862647
    m_Localized: 'Tourist: Para biriktirdim, izin almak için yalvardım...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862648
    m_Localized: 'Tourist: Sonuç ne oldu? Tatil daha başlamadan bitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862649
    m_Localized: 'Tourist: Keşke buradan kurtulabilsem...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862650
    m_Localized: Neden daha erken yola koyulmadın?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862651
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862652
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862653
    m_Localized: 'Tourist: Dedim ya, ha bire önüme bir engel çıktı.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862654
    m_Localized: 'Tourist: Hem bu ayların tatil için ideal olduğunu sanmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862655
    m_Localized: 'Tourist: Nihayet biraz güneşlenirim diye düşünmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862656
    m_Localized: 'Tourist: Böyle olacağını bilseydim daha erken giderdim. Fırsat varken dünyayı görürdüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862657
    m_Localized: 'Tourist: Şimdi anca fotoğraflara bakarım. O ülkelerin hepsi kül oldu gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862658
    m_Localized: 'Tourist: Keşke buradan kurtulabilsem...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862659
    m_Localized: Belki de şanslısındır. En azından canlı canlı yanmayacaksın
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862660
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862661
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862662
    m_Localized: 'Tourist: Şanslı mı? Dalga mı geçiyorsun sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862663
    m_Localized: 'Tourist: Hayatım boyunca dünyayı görme hayali kurdum ama artık hiçbir şey göremeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862664
    m_Localized: 'Tourist: Sen buna şanslı mı diyorsun? Nesi şanslıymış bunun?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862665
    m_Localized: Yaşıyorsun amına koyayım, daha ne istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862666
    m_Localized: Abartma ya, alt tarafı bir tatil
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862667
    m_Localized: 'Tourist: Evet, yaşıyorum ama şimdilik.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862668
    m_Localized: 'Tourist: Güneş patlayınca o da gidecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862669
    m_Localized: 'Tourist: Dünyayı görmeden öleceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862670
    m_Localized: Bu yüzden mi bu kadar suratın asık? Derdine yanmayı bırak artık
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862671
    m_Localized: Senin bu yakınmaların sinirimi bozmaya başladı
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862672
    m_Localized: 'Tourist: Alt tarafı bir tatil falan değil. Bu, benim hayalimdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862673
    m_Localized: 'Tourist: Hayatım boyunca dünyayı görme hayali kurdum. Ee, şimdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862674
    m_Localized: 'Tourist: Suya düştü. Asla göremeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862675
    m_Localized: 'Tourist: Bu olaylardan önce gitmem gerekirdi. Şimdi hepimiz ölmeyi bekliyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862676
    m_Localized: Bu yüzden mi bu kadar suratın asık? Derdine yanmayı bırak artık
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862677
    m_Localized: Senin bu yakınmaların sinirimi bozmaya başladı
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862678
    m_Localized: 'Tourist: Ama ben... Ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862679
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862680
    m_Localized: 'Tourist: Bir şeylerden pişman olmayı bırakamam, üzgünüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862681
    m_Localized: 'Tourist: Önceden gitmeme engel olan aslında hiçbir şey yoktu, bunu fark ettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862682
    m_Localized: 'Tourist: Erteleyip durdum, sonra vakit bulurum diye düşündüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862683
    m_Localized: 'Tourist: Artık çok geç.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862684
    m_Localized: 'Tourist: Dünyanın sonu geldi gelecek ama benim görmek istediğim, yapmak istediğim çok şey var.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862685
    m_Localized: 'Tourist: Bir şekilde bununla yaşamayı öğreneceğim artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862686
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862687
    m_Localized: 'Tourist: Siktir lan!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862688
    m_Localized: 'Tourist: Kaybettiğim şeyin yasını tutamaz mıyım?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862689
    m_Localized: 'Tourist: Sen de bunun farkındasın, artık hiçbir şey normale dönmeyecek. Dünyanın sonu geldi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862690
    m_Localized: 'Tourist: Bunu kabullendiğini gözlerinden anlayabiliyorum ama ben şahsen ölmek istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862691
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862692
    m_Localized: 'Tourist: Kime anlatıyorum ki ben? Sen muhtemelen hiç evinden çıkmamışsındır. Senin için hava hoş tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862693
    m_Localized: Beni sinir etmeye başladın
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862694
    m_Localized: Seni dışarı atarım, gözlerin cayır cayır yanar, görürsün
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862695
    m_Localized: 'Tourist: Ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862696
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862697
    m_Localized: 'Tourist: Ben en iyisi gideyim. Sen beni korkutmaya başladın.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862698
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862699
    m_Localized: 'Tourist: Şunu demeye çalışıyorum: Evet, sen geleceğimizi kabullenmiş olabilirsin ama herkes için durum aynı değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862700
    m_Localized: 'Tourist: Ben şahsen bizi nelerin beklediğini düşünmeden edemiyorum. Bana çok zor geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862701
    m_Localized: 'Tourist: Kaçırdığım fırsatları düşünüp duruyorum, anı yaşamaktan korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862702
    m_Localized: İyi zamanları hatırlamaya çalış, belki işini kolaylaştırır
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862703
    m_Localized: Pişmanlığında boğulmayı bırakman lazım
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862704
    m_Localized: 'Tourist: Haklı olabilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862705
    m_Localized: 'Tourist: Sıkıntı şu ki... İnsan tüm ihtimalleri düşünmeden edemiyor işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862706
    m_Localized: 'Tourist: Yine de haklısın. Zamanı geri alma hayalleri kurmanın bir manası yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862707
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862708
    m_Localized: 'Tourist: Sağ ol dinlediğin için.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862709
    m_Localized: 'Tourist: Bu {0} işine yarar mı bilmiyorum ama al, senin olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602560
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602561
    m_Localized: 'Dude: Aa, moruk... Cebimde şeker vardı, bak o aklıma geldi şimdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602562
    m_Localized: 'Dude: Off, MANYAK bir şey bu ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602563
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602564
    m_Localized: 'Dude: Kusura bakma moruk ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602565
    m_Localized: 'Dude: Döndürürdük aslında da unutmuşum.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602566
    m_Localized: 'Dude: Neyse, takma kafana. Sen de bunu al.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602567
    m_Localized: 'Dude: Ben biraz takılacağım ya şöyle. Ohhh, iyi geldi...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602568
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602569
    m_Localized: 'Wheelchair: Biraz esnemem lazım ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602570
    m_Localized: 'Wheelchair: Bekle.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602571
    m_Localized: 'Wheelchair: Hah, böyle daha iyi oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602572
    m_Localized: Ne oluyor lan?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602573
    m_Localized: 'Wheelchair: Sakin ol kanka, altı üstü ölü bir bacak. Ne abarttın sen de!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602574
    m_Localized: Bu rollere ne gerek vardı o zaman?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602575
    m_Localized: Bu tekerlekli sandalyeye ne gerek vardı o zaman?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602576
    m_Localized: 'Wheelchair: Ben böyle değilim demedim ki... Bacaklarımı sıcak tutuyorum böyle, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602577
    m_Localized: 'Wheelchair: Sağa sola yuvarlanmak hoşuma gidiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602578
    m_Localized: Sen çıldırmışsın
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602579
    m_Localized: DERHÂL terk et burayı
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602580
    m_Localized: 'Wheelchair: Bununla çok iyi yanlarsın bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602581
    m_Localized: 'Wheelchair: Hiç denemedim deme.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602582
    m_Localized: Sen çıldırmışsın
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602583
    m_Localized: DERHÂL terk et burayı
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602584
    m_Localized: 'Wheelchair: Neyse ne.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602585
    m_Localized: 'Wheelchair: Eğleniyorum en azından!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602586
    m_Localized: 'Wheelchair: Ne oluyor lan?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602587
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602588
    m_Localized: 'Wheelchair: İyi, ben kaçar. Sandalyeyi yanımda götürüyorum ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602589
    m_Localized: '>>'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602590
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602591
    m_Localized: 'Esenin: Etrafta birkaç şiir kitabı buldum.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602592
    m_Localized: 'Esenin: Bir şiir okusam sorun olur mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602593
    m_Localized: Oku bakalım
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602594
    m_Localized: Yok, sağ olasın
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602595
    m_Localized: 'Esenin: İşte, bu kadar. Nasıldı sence?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602596
    m_Localized: Harikaydı
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602597
    m_Localized: Anlamsız kelimeler işte
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602598
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602599
    m_Localized: 'Esenin: Var ya, bu bana iyi geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602600
    m_Localized: 'Esenin: Dinlediğin için teşekkür ederim güzel kardeşim.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602601
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602602
    m_Localized: 'Esenin: Peki, öyle olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602603
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602604
    m_Localized: 'FortuneTeller: Enerjini nasıl düzeltebileceğimizi biliyorum sanırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602605
    m_Localized: 'FortuneTeller: Tek yapman gereken...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602606
    m_Localized: 'FortuneTeller: OĞLAK DALGALANMALARINI GERÇEKLEŞTİRMEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602607
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602608
    m_Localized: 'FortuneTeller: Ee, işe yaradı mı? Çakraların neşeyle doldu mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602609
    m_Localized: Dolması mı lazımdı?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602610
    m_Localized: Ne oluyor lan?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602611
    m_Localized: 'FortuneTeller: Ne yani, işe yaramadı mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602612
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602613
    m_Localized: 'FortuneTeller: Garip. Yaraması lazımdı...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602614
    m_Localized: 'FortuneTeller: Neyse, çok takma kafana. Her gün olumlama yap, işine yarar.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602615
    m_Localized: 'FortuneTeller: Hatta bir deneyelim istersen.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602616
    m_Localized: 'FortuneTeller: Dediğimi tekrar et: Ben, mutlu birisiyim!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602617
    m_Localized: Ben, mutlu birisiyim!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602618
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602619
    m_Localized: Bu tamamen palavra
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602620
    m_Localized: 'FortuneTeller: Harika! Devam et.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602621
    m_Localized: Ben, mutlu birisiyim!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602622
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602623
    m_Localized: Bu tamamen palavra
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602624
    m_Localized: 'FortuneTeller: Ama kendini vermiyorsun ki!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602625
    m_Localized: 'FortuneTeller: Bir saniye... Ben bunu nasıl fark etmemiş olabilirim?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602626
    m_Localized: 'FortuneTeller: Auranda görebiliyorum... Sen neşe istemiyorsun. Senin için tamamen boş.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602627
    m_Localized: 'FortuneTeller: Arzu olmazsa netice de olmaz. Evren buna izin vermez.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602628
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602629
    m_Localized: 'FortuneTeller: Korkarım ki sana yardım edemeyeceğim. Kusura bakma. Olumlamalar bile işe yaramadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602630
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602631
    m_Localized: Ne yapıyorsun sen?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602632
    m_Localized: 'Intruder: Rüyalarını arıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602633
    m_Localized: 'Intruder: Biraz huzur istiyorum sadece. Bir tutamcık.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602634
    m_Localized: 'Intruder: Nerede saklıyorsun onları? Söyle bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602635
    m_Localized: Geri bas yoksa yere yığarım seni
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602636
    m_Localized: Rüya görmüyorum ben
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602637
    m_Localized: Yürü git lan
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602638
    m_Localized: 'Intruder: Bak, beni anlaman gerek. Bana rüya LAZIM diyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602639
    m_Localized: 'Intruder: Gerçi gözlerinden belli, sen rüya görmüyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602640
    m_Localized: 'Intruder: Artık rahatlayabilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602641
    m_Localized: 'Intruder: Peki... Şu an sana gerçeği mi söylüyorum? Yoksa gardını indirmeni mi bekliyorum?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602642
    m_Localized: 'Intruder: Huzursuz bir kâbus buldum ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796864
    m_Localized: 'Intruder: Koridorda sürünüyorsun. Pis bir böceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796865
    m_Localized: 'Intruder: Dünyayı kimin gözlerinden gördüğünü bilmiyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796866
    m_Localized: 'Intruder: Şu kadarını söyleyeyim: Ceset arayan bir bakışın var. Ölüm kokan yerlere çekiliyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796867
    m_Localized: 'Intruder: Belki bir gün görürsün bu rüyayı.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796868
    m_Localized: 'Intruder: Garip bir kâbus buldum ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796869
    m_Localized: 'Intruder: Mantarların yetiştiği bir tünelde sürünüyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796870
    m_Localized: 'Intruder: Çok fazla mantar var, korkunç bir hızla yetişiyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796871
    m_Localized: 'Intruder: Enteresan. Niye böyle bir şey göresin ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821952
    m_Localized: 'Esenin: Akşam gökyüzüne baştan başa yayılınca'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821953
    m_Localized: 'Esenin: Bir masa üstünde eterlenmiş hasta gibi;'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821954
    m_Localized: 'Esenin: Gidelim, belirli yarı terkedilmiş sokaklardan'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821955
    m_Localized: 'Esenin: Mırıltılı yalnızlıklarına'
    m_Metadata:
      m_Items: []
  - m_Id: 92376539113529344
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823488
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823489
    m_Localized: ' Bir FEMA ihbarı ver'
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823490
    m_Localized: Seni test etmem lazım
    m_Metadata:
      m_Items: []
