%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_pl
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 1290f85681bd44940af0abf2b1b05504, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: Pewnie, kolego. *kaszle* Nie mam nic do ukrycia. Wszystko, co miałem, poszło z dymem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Spójrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: Nie bądź *kaszle* zbyt surowy. Wdychanie dymu nijak się ma do wizyt u dentysty.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Proszę, spójrz… *kaszle*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: Niczym dwa zwęglone konary i poczerniałe gałązki. Ale paznokcie czyste. Co za ironia, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: Nie ma problemu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: Widzisz? *kaszle* Czerwone niczym gorące węgle. To od dymu, kolego.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: Jesteś pewien? Możesz tego żałować…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: Skórę mam popękaną jak kora na drzewie. Jeśli nie muszę, to nie podnoszę rąk. Boli jak cholera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: Pewnie, co mi tam. Ale wyjdzie na nim tylko moje przypalone ciało. Zawsze tak jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: I jak wyszedłem? *kaszle*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: Za dużo w nich nie sprawdzisz. Spalone są do samej chrząstki.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: Niedługo pewnie stracę słuch. Może to i lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Pewnie, strzelaj, jeśli chcesz, kolego. Tylko nie celuj mi w zęby, i tak niedługo wszystkie stracę.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Wisi mi to. Niczego się już nie boję. Zastrzel mnie, jeśli tak będzie ci łatwiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: Dobry pomysł. W moim stanie to może nawet akt łaski…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: Wiesz, jak się musiałem napracować tymi rękami?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: Jeśli to zdjęcie jest moim wyrokiem śmierci, *kaszle* nie ociągajmy się. I tak nie mam po co żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Kiedyś wszystko obraca się w pył. Widocznie nadeszła moja kolej…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: Wiesz, *kaszle* nigdy nie potrafiłem namówić moich dzieci do mycia zębów. A teraz… już nikt im o tym nie przypomni.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: Uratowałem *kaszle* wielu ludzi tymi rękami. Teraz nie utrzymam nawet kubka.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: Czyli do tego doprowadziło mnie życie…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: Zdaje się, że czas umierać…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: Gdy płonie las… *kaszle* Drzewa spalają się jak zapałki. Zdajesz sobie wtedy sprawę, że jesteś bezsilny.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: Teraz czasem budzę się nocami, bo pęka mi skóra. Nic nie uśmierza bólu. *kaszle* Ogień zabrał wszystko.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Zostały mi tylko wspomnienia. Teraz to tylko kwestia czasu, gdy sami też spłoniemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: Gdy płomienie szaleją wokół, wspominasz wtedy chwile błogiej ciszy – nie zwykłej ciszy, lecz tej w duszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: Jasne, sprawdź mnie jak najdokładniej. Niczego nie znajdziesz!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Proszę, patrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: Widziałeś kiedyś taki zgryz? Normalnie gęba pełna skarbów!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: I to nie są zwykłe zęby, ale złote! Oczywiście nie wszystkie, ale z czasem pewnie dodam więcej.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: Wiesz jak łatwo jest jedynkami otwierać browce?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: Na pohybel otwieraczom!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: Hej, jestem wdzięczny za to, że wciąż je mam!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: Inaczej nie mógłbym się ścigać!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Czekaj no.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: Odpadły mi palce!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: Wczoraj brakowało tylko jednego. Gdzie się podziała reszta?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: No nic, odrosną. Tylko muszę trochę poczekać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: Odpadł mi palec…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: Nie jest to koniec świata, ale byłem do niego przywiązany.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: ALE ZOBACZ, PAZNOKIEĆ TROCHĘ ODRASTA, WIDZISZ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: A to znaczy, że kiedyś odrosną mi także nogi! Muszę tylko poczekać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: Gdzie mam się patrzeć? Prosto na ciebie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: Nie przejmuj się tikami. Już tak mam.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Nawet w czasach, gdy mogłem jeszcze wkręcać na obroty prawdziwe silniki, nie mogłem skupić wzroku… na niczym.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: Chyba nie jestem jeszcze gotowy odpuścić sobie szybkości, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: Hę?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: No pewnie, chyba… Ha, ha, ha, ha, okej, niezła jazda!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: Brawo, stałeś się mistrzem komedii, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: Teraz wszyscy będziemy lampili się innym pod pachy. Normalnie szajba.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: Piekło ogarnęło cały świat, jakby wszechświat starał się nas wszystkich pozbyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: I jakby tego było mało, Przybysze chcą nas wszystkich ukatrupić.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: A ty mówisz jedynie „Pokazuj pan pachy!”'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: HA, HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: Chcesz mi zrobić fotkę?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: Nie lubię, gdy robi mi się zdjęcia, ale trudno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: Kurde, mrugnąłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: HA, HA, HA, HA! No pewnie, szefie!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: Więc też o tym słyszałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Nieźle pojechali, no nie? Hm…? Słucham?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: Czekaj… nie słyszałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: Ale… przegięcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: Okej, okej, przestanę opijać cię z piwska. Nie bierz tego tak na serio!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: Wiesz, co się dzieje z ludźmi, którzy są tak sztywni, jak ty?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: Sztywne rzeczy pękają, a ludzie kończą na wózkach, podobnie do mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: Jeśli masz się tak wkurzać, to wskakuj i przejedźmy się. Zobaczysz, jak to jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: Dlaczego?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: To mi nie pomoże.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: I tobie pewnie też nie. O co więc chodzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: Gołym okiem pewnie nie zobaczę pocisku, ale mogę spróbować zrobić unik.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: Nigdy nie rozumiałem, po co ludzie się tu golą. Włosy to naturalna bariera ochronna organizmu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: Widzisz tę jasnoczerwoną wysypkę? Hoduję tam zapasowe palce.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: Ach, prawdziwy ubaw dopiero nadchodzi. Dopiero się rozgrzewam!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: Gdzie popełniliśmy błąd?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: Kogo obchodzą jakieś durne zdjęcia? Życie jest na to za krótkie, amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: To znaczy, chciałem powiedzieć…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Słuchaj, daj mi odejść, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: Zdaje się, że wszyscy w końcu musimy wypić nawarzone sobie piwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Prędzej czy później Bóg się o nas upomni.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: Ale ja nie odejdę bez walki! NIGDY! AAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: Mamy to wgrane w nasze biologiczne oprogramowanie, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: W jednej chwili mamy ubaw po pachy, a w drugiej strzelamy do siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: Muszę się przygotować do ostatniej podróży…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: Ręce są moim jedynym napędem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: I nie mam nawet sprzęgła!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: Prawdę mówiąc, przeraża mnie myśl, że mogę je kiedyś stracić. Co bym wtedy zrobił?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: Nie chciałbym być pozbawiony możliwości poruszania się. Utknąć na zawsze…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Nawet śmierci aż tak się nie boję.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: Nadchodzi taki dzień, że nie ważne jak na to spojrzysz, już zwyczajnie nie nadążasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: Zauważyłeś, że z wiekiem czas przyspiesza? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: Jako dziecko zdawało się, że życie jest wieczne. Wszystko było prostsze – bez odpowiedzialności, bez trudnych wyborów.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: Teraz jednak bez znaczenia, jak się spieszymy, wciąż wydaje się, że zostajemy w tyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: Wiesz co, nagle odeszła mnie chęć do śmiechu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: Twoje świrnięte testy, ogarnianie trudnych sytuacji…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Wszyscy chcą zbawić świat, ale nie mogą się dogadać, jak to zrobić.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: I czy to ma jakiś sens? Może wszyscy musimy wyluzować i nie zawracać sobie tym głowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Słuchaj…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: Czy nie uważasz, że nasze kręcenie bączków na tej planecie dobiega końca?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: Dojeżdżamy do mety. Niedługo wszyscy wysiadamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: Dzyń, dzyń! Ostatni przystanek, proszę wysiadać oknem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: Jesteś na to gotowy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: Ostatnio tak sobie myślałem… Obiecaj, że się nie obrazisz, dobrze?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: Jeśli nie możesz polegać na tym objawie… to jak ja mam niby to zrobić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: Kto wie? Może wszystkie są atrybutami Przybyszy, a może żaden!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: W końcu błądzić jest rzeczą ludzką.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: Błędy mogą jednak pociągać za sobą okropne konsekwencje.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: Jeśli polegasz teraz na tym objawie… jak mogę wciąż ufać pozostałym?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Może inne to też bujda na resorach.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: W końcu jesteśmy ludźmi. Popełniamy błędy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: Ale te błędy mogą skutkować strasznymi konsekwencjami.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Weźmy na przykład ciebie… Wystarczy jeden fałszywy ruch i BUM, ktoś pada trupem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: Jeżeli jesteś pewien swoich wyborów, wtedy… zazdroszczę takiego zdecydowania.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: No dobra. Dalej, proszę mnie sprawdzić. Niczego nie ukrywam.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Proszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: Wie pan, nigdy o nie szczególnie nie dbałam. Nie miałam czasu. Teraz jednak… żałuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Proszę spojrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: Dłonie pianistki to to nie są. Ale czego się nie robi dla dzieci.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: Dobrze, niech pan patrzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: Widzi pan, jakie są podkrążone? To właśnie robi z człowiekiem ciągłe niewyspanie…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: Dobrze, niech pan patrzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: Dezodorant skończył mi się już dawno. Proszę nie mieć mi tego za złe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: Mogę usiąść? Nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: Hm. Jak zawsze niezadbana i zrzędliwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: Od dawna ich nie myłam. Mogą być zatkane.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: Od wrzasków dzieci i tak jestem już półgłucha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: Od zeszłego tygodnia krwawią mi dziąsła od szczotkowania.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: I niech pan patrzy, wciąż są żółte. Jak mam przestać palić z takimi dziećmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: Dostałam wysypki od środków czyszczących. Nie miałam czasu iść z tym do lekarza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: Mogłabym tymi rękoma przygotować tobie zupę, gdybyś pozwolił! A twoje jednak wnet chwytają za broń…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Ha. Mógłby pan mnie wysadzić granatem, a moje rozczłonkowane ciało wciąż by się nie wyspało.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: Co, zastrzeli mnie pan, bo śmierdzę? Kiepski żart.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: Och, niech pan daruje. Doprawdy aż tak źle wyszłam?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: Naprawdę jest pan szurnięty, jeśli chce mnie pan zastrzelić z powodu moich uszu. Nie podobają się? Założę czapkę!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: W końcu cisza i spokój… nikt już nie będzie mi zawracał głowy…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: Smutne to…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: Wie pan, że jedno z moich dzieci ma idealne zęby? A nigdy się nie uśmiecha. Może tu wcale nie chodzi o zęby?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Ręce… przytulam nimi dzieci, ogarniam dom i obejmuję męża. I wie pan co? Nikt tego nigdy nie docenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: Kiedy choruje dziecko, nie śpi się nocami. Wtedy się przyzwyczajasz i żyjesz w stanie zawieszenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: Pewnego razu byłam tak padnięta, że nie kąpałam się przez tydzień. Dzieci w ogóle nie zauważyły.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: Raz znalazłam zdjęcie, na którym wszystkie moje dzieci były uśmiechnięte. Patrzyłam na nie nocami, aż zapadałam w sen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: Czasami wolałabym być głucha. Jednak kiedy dzieci śpią, panuje taka piękna cisza… Dla takich chwil warto żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: Pan na poważnie? Kurwa… no dobra, ale szybko!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: Gówno mnie to obchodzi. Patrz pan.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: Żółte? No i chuj.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: Białe? Nic dziwnego. Wystarczy higiena, kutafonie!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: Pomyślałem, że skoro zęby i tak mi się psują, to powinienem mieć jeden złoty. Jak twardziele z filmów.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: Pewnie, wisi mi to.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Patrz pan i podziwiaj!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: Ha. Babcia zawsze mówiła, że z takimi łapami jak imadła powinienem rąbać drewno, a nie… cokolwiek wtedy robiłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: Nie widzę tu jednak żadnych pniaków, a muszę się jakoś wyżyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: Nie obchodzi mnie to. Patrz pan w nie, skoro chcesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: Podoba się panu ten błękit, co? Do zarywania lachonów nie ma lepszych! Ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: Mam to szczerze i głęboko w dupie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Tak, golę się tam.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: Nie cierpię moich włochali pod pachą. Jakby wyrastał tam jakiś pieprzony busz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: I co jeszcze, dupo wołowa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: Na chuj się pan tak na mnie gapisz? Co tam widać?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Ja pierdolę…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: Po co się pan tak na mnie lampisz? Czegoś mi brakuje?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: Cyce cię drą, kapuściany łbie? Panie, przecież pokazałem zęby!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: Myślisz pan, że nie dorwałbym się łapami do pańskiego gardła szybciej, niż pan wystrzelisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: Ja pierdolę, na łeb pan upadłeś? Jest pan zazdrosny czy co?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: Wciąż mnie tam swędzi, jakby specjalnie chciało mnie wkurwić.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: Przechodzi, jak rozdrapię do krwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: Nie będę tego, kurwa, słuchał! Ochujałeś pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: Kropniesz mnie pan z powodu jakiegoś debilnego zdjęcia?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: Uważaj, gdzie pan wymachujesz giwerą.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Bo kto wie… Jeszcze mnie przypadkiem pan zastrzelisz z powodu moich uszu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: Czy pan się z chujem na głowy pozamieniał? Dobra, dawaj, bydlaku!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: Pan jest drań. Kompletnie bezduszny, kurwa, drań.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Idź pan w chuj.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: Moja babcia miała złoty ząb. Ja też od zawsze taki chciałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: Mienił się tak, jakby miała w gębie słońce.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: Mówiła, że wprawili jej go, kiedy jej spróchniał stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: Pomyślałem wtedy „Świetnie! Też tak zrobię, gdy nadejdzie czas”.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: I czas nadszedł. Tylko że mnie nikt nic nie dał.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: I teraz w mojej gębie nic się nie mieni. Tylko z niej cuchnie i bije żółć jak siki.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: Widzi pan te ręce? Brudne, zakrwawione i chuj wie, co jeszcze. Ale są moje.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: Czasem swędzą tak bardzo, że obdarłbym je ze skóry albo uderzył w ścianę. Albo i to i to.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: Nie chcę nikogo skrzywdzić, ale muszę też się wyżyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: Widzi pan te paznokcie? Brudne, zakrwawione i chuj wie, co jeszcze. Ale są moje.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: Czasem ręce swędzą mnie tak bardzo, że obdarłbym je ze skóry albo uderzył w ścianę. Albo i to i to.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: Pewnie gdybym był kimś innym, martwiłbym się, że się kaleczę. Gówno mnie to jednak obchodzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: Babcia mawiała na mnie „aniołeczek” z powodu moich oczu. „Aniołeczek”, czaisz pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: A teraz gapię się w te brudne, nieczułe zwierciadła duszy i zachodzę w głowę nad tym, gdzie kryje się ten anioł?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: Wiem, jakim obdarowałaby mnie spojrzeniem. Pełnym zawodu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: Wie pan, żyletki są wystarczająco ostre do… czegoś. Gdyby tylko to było takie proste…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: Tylko pociąłem sobie rękę. Teraz, gdy się golę, mam odczucie jakby ostrze nie ścinało włosów, ale część mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: Ale mimo tego wciąż się golę. Panie, to dlatego, że nie cierpię tam tego małpiego buszu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: Nie mam nawet zdjęcia swojej babci. Nie przepadała za nimi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: Twierdziła, że jeśli ktoś zrobi komuś zdjęcie, opłaca to częścią swojej zaklętej w nim duszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: Pękałem ze śmiechu. Mówiłem jej „Przestań, babciu, to nonsens”.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: A ona na to „Jak legnę w grobie, spojrzysz na moje zdjęcie i będziesz się zastanawiać, czy poszłam nieba”.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: Jebać to wszystko. Nie mam ani zdjęć, ani babci.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: Czasem chwytam się za nie nieświadomie, ale tylko wtedy, gdy już mnie pieką jak diabli.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: Myślałem, że to jakiś tik nerwowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: Potem zorientowałem się, że chcę je urwać, jakby mi jakoś przeszkadzało…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: Ale nie jestem chyba na tyle szurnięty, żeby się samookaleczać, co nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: CO NIE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Och, drogi panie, wiedziałam, że pańska energia będzie stawiać opór. Dobrze, zróbmy testy. I tak przejrzę pana na wylot.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Cóż, niech pan patrzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: Nasz wewnętrzny kosmos odbija się nie w zębach, ale w oczach. Czy szuka pan w nich przeznaczenia?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: Nasz wewnętrzny kosmos odbija się nie w zębach, ale w oczach. Co chce pan tam znaleźć?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: Proszę, niech pan spojrzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: Ale niech pan będzie delikatny, mam kilka drzazg od robienia łapaczy snów.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: Och, moje oczy? Są brązowe, rzecz jasna.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Pomijając przekrwienia. To wina księżyca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Ochhh, co mi każe znosić wszechświat… No dobrze, niech pan patrzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: Nie jest łatwo o siebie zadbać w tych warunkach, wie pan…?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: Proszę uważać! Moja aura może oślepiać!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: No i? Co pan myśli?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Proszę spojrzeć, ale niech pan uważa, bo moje uszy słyszą wszystko – nawet pana myśli.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: I jak? Znalazł pan tam jakieś odpowiedzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: Zastrzeli mnie pan z powodu zębów? Nie wyczuwa pan, że to nie ja? Nie, to scysja Marsa i Wenus!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: Czy pan na poważnie? Zastrzeli mnie pan z powodu drzazg? I to od moich ukochanych łapaczy snów!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: Oszalał pan?! To tylko fortel księżyca, wie pan? Niełatwo jest śledzić jego ruchy!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: Oszalał pan?! To tylko fortel księżyca, wie pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: To nie astrologia, ale paranoja! Proszę odłożyć broń, a zdradzę panu więcej tajemnic! Gratis!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: Hola, hola, drogi panie! To nie moja wina, że nie był pan na to gotowy!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: Czy może pan to odłożyć? Co w ogóle można wywnioskować z oględzin uszu? Potrzebne są do słuchania mądrzejszych!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: Jeśli mnie pan zastrzeli, rzucę na pana klątwę…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: …wiecznej sraczki!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: Wie pan, raz przyszedł do mnie mężczyzna o idealnych zębach.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: Rzekłam mu „Wszystko w porządku, ale duszę ma pan zbutwiałą!”. Proszę pomyśleć, co jest ważniejsze. Rozumie pan, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: Pewnego razu całą noc wyciągałam drzazgi po rytuale. Bolało, ale każda była lekcją od wszechświata.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: Oczy to bramy innego świata. Spotkałam raz mężczyznę z oczami jak gorące węgielki. Mówił, że to miłość, ale był Marsem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: Wie pan, kiedyś przez trzy tygodnie żyłam jak asceta. Myślałam wyłącznie o moich snach.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: Myśli to manifestacje i w ten sposób spełniają się sny. Muszę jedynie wypowiedzieć właściwe życzenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: To dziwne, że przypomniałam sobie o tym właśnie teraz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: Jakiś czas temu zrobiono mi zdjęcie i pomyślałam wtedy „To znak od gwiazd!”, a to była jedynie lampa błyskowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: Raz usłyszałam taki dźwięk… jakby przemawiał do mnie wszechświat. Uważam jednak, że było to coś znamienitszego.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: Raz usłyszałam taki dźwięk… jakby przemawiał do mnie wszechświat. To był jednak tylko przeciąg. Niemniej, było to miłe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: Co chcesz sprawdzić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: Chcesz, żebym ci pokazał zęby?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: MOJE ZĘBY SĄ OSTOJĄ PRAWDY!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: …i zginęły męczeńską śmiercią.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: Sam widzisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: Płuczę zęby takim piwnym roztworem. Chroni szkliwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: Bez niego już dawno bym wszystkie stracił.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: Tak, to zrozumiałe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: Tyle się dzieje, a jednak wciąż żyjemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: Wciąż trwamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: Co?! Czyżbyś zbyt długo siedział w cieniu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: Czas spocząć, przyjacielu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: Jak sobie życzysz, przyjacielu!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: Ogarniaj wzrokiem te święte paznokcie wedle woli.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: Nauczyłem się czerpać nimi korzyści ze Słońca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: I otwierać butelki z piwem, oczywiście!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: Chciałeś tylko sprawdzić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: PATRZ W MOJE OCZY!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: Aż płoną furią i gniewem!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: PATRZ W MOJE CIEMNE OCZY!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: Czerpię nimi wszystkie korzyści ze sprawiedliwych promieni, przemieniając je w energię.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: Całą potrzebną mi energię wchłaniam przez oczy!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: CZYŚ UJRZAŁ SPRAWIEDLIWĄ POTĘGĘ SŁOŃCA W MOICH OCZACH?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: Jeśli nie, jesteś ślepy. Spróbuj tak jak ja, spojrzeć dłużej w Słońce.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: Chcesz mi zrobić zdjęcie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: Hm… Hm, hm, hm…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: Słyszałeś może, że spotkałem Słonecznego Przywódcę we własnej osobie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: Tak, pokazałem mu, jak patrzeć w oblicze Przenajświętszego Słońca, ale o tym później.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: W porządku. UWIECZNIJ MÓJ ŚWIĘTY WIZERUNEK!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (Robisz zdjęcie zaniedbanemu mężczyźnie).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (Zdjęcie jest wiernym odbiciem jego brudu i braku higieny).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (Nie zauważasz żadnych zniekształceń).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: CHWAŁA MU! JAK ŚWIETNIE WSZYSTKO WYSZŁO!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: Wpadnij do mnie później, opowiem ci historię swojego życia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: Za drobną opłatą, ma się rozumieć…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: KTÓRĄ SPOŻYTKUJĘ NA POCHŁONIĘCIE ENERGII SŁOŃCA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: Dawaj, strzelaj! Chroni mnie pancerz prawdy!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: Czy odłożysz broń?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: Baaardzo mi ciężko bez piwa w ręku.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: Baaardzo ciężko.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: Ależ człowiecze, dlaczego musimy to sobie robić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: ZUPEŁNIE OCIENIAŁEŚ, NIEOŚWIECONY!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: Mówią, że oko za oko, ale wtedy i tak cię zastrzelą jak za kilka sztuk…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: Ejże, ejże, ejże. Trochę się zagalopowałeś!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: Uważaj, gdzie tym wymachujesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: Zaraz, nie podobają ci się moje uświęcone dłonie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: CZEMU?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: Jesteś głupcem, ignorantem, a ja chcę piwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: Mówią, żeby nie pchać oka w nie swoje sprawy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: Więc co mam niby robić? Zawsze odwracać wzrok?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: Ach, czekaj…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: Czy chodziło może o nos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: Chwilunia, momencik…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: Mam to w dupie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: Właśnie tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: Słońca nie zastrzelisz!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: O mnie się nie martw. Nie przejmuję się takimi głupimi zagrywkami.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: Dopóki masz spory zapas zimnego, życiodajnego płynu!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: Ach, jesteś kawalarzem, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: Niuchnij sobie, jeśli to cię kręci.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: Oto rezultat dbania o siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: Ach, jesteś kawalarzem, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: Niuchnij sobie, jeśli to cię kręci.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: To wynik ożywczych promieni Słońca!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: Jego święte promienie wywołują żywotną wilgoć!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: Co chcesz sprawdzić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: Z‑zaraz, czy podejmiesz decyzję na podstawie stanu moich zębów? O‑okej…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: Dopiero co miałam je naprawione.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Ale jeśli mam być szczera…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: Nie pamiętam wizyty u dentysty. Czy w ogóle tam byłam?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: Jezu, jestem taka nerwowa, nawet nie pamiętam, czy wczoraj jadłam.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: Więc… uhm, czy pasuję do opisu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: Jestem Przybyszką? Jak to? JAK TO? Nie może być!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: Och, mój Boże, wypędzili mnie z domu, zwolnili z pracy, a teraz wygonią mnie z własnej głowy…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: Ch‑chcesz spojrzeć na moje paznokcie? To dosyć dziwne…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: Ale w porządku… patrz…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: Co tam pod nimi jest? Ziemia? Niemożliwe…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: Nie pamiętam… żebym kopała w ziemi…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: Skąd wziął się ten brud pod paznokciami?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: Przecież nie mogłam tak długo chodzić z tym brudem, nieprawdaż?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: Ale… dziwne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: Wyobrażasz sobie? Nie wiem, skąd ta ziemia. Siedziałam przecież tylko u pana.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: Czy… czy ktoś celowo wybrudził mi paznokcie? Kto mógłby to zrobić?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: Chcesz sprawdzić mi oczy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: Chyba wiem, co w nich zobaczysz…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: A co jeśli mam jeden z objawów?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: No cóż. Nikogo to chyba nie zaskoczyło.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: Czy naprawdę jestem Przybyszką? Jak uważasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: I dlaczego nic o tym nie wiem? Cz‑czy to w ten sposób ludzie się w nich zmieniają?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: Może wystarczy myśleć, że różnisz się od pozostałych… że społeczeństwo cię nienawidzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: Boję się śmierci…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: Ch‑chwilkę, czy możesz zakryć mi oczy? Masz może jakiś bandaż?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: Albo… albo… daj mi jeszcze chwilkę…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: Jeśli naprawdę jestem Przybyszką, czy zacznę zabijać ludzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: Czy będę niebezpieczna? Czy może zawsze taka byłam…?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: A może już kogoś zabiłam?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (Robisz jej zdjęcie).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (Po wywołaniu zdjęcia ukazuje się rozmazana postać i ostre tło).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (Jak gdyby poruszyła się podczas robienia zdjęcia).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: Ha, ha, ha, ale ambaras. Musiałam drgnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: Uhm… Więc co teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: Pozwolisz mi żyć? Czy może lepiej jest mnie zabić? Co zrobisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: Dlaczego?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: Czy nie łatwiej byłoby mnie zastrzelić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: Chciałabym odejść, ale tak bardzo się boję.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: Może…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: Sama nie wiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: Jeśli mnie zastrzelisz, czy zmienię się w coś jeszcze gorszego?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: Może powinnam uciec…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: Nawet nie wiem… czy jestem jeszcze człowiekiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: Co mam począć?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: Zupełnie jak ci Przybysze u mnie w domu…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: Przepraszam, to było okropne doświadczenie. Już pokazuję…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: Czy jestem człowiekiem? Jestem? Powiedz mi, że jestem człowiekiem, proszę! Błagam!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: Ha, ha, ha! To po co się pytałeś, skoro i tak zaraz wyciągnąłeś broń?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: Lubisz upokarzać ludzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: Ale koszmar… nigdzie nie można czuć się bezpieczną…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: Jednego dnia mogą ci się wbić do domu Przybysze, a następnego może cię zastrzelić szaleniec z powodu twoich pach…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: DLACZEGO NIKT NIE POWIE, ŻE WSZYSTKO SIĘ UŁOŻY?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: I to wszystko? Tylko tyle trzeba, żeby zostać uznanym za Przybysza?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: Wspaniale. Ciało znów sprawia mi zawód…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: Wiem… Nie wygląda to najlepiej. To dlatego w pracy wszyscy się mnie bali.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: W zeszłym tygodniu poszłam do szpitala z powodu kręgosłupa… tak myślę.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: Czy… czy wtedy byłam też u dentysty?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: Ile kosztowała mnie wizyta…?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: Co chcesz sprawdzić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: Chcesz, żebym ci pokazał zęby?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: Okej, patrz. Napawaj się smrodem rozpaczy i papierosów.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Bardzo żółte, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: Więc spieprzaj z tymi testami.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: Nie jestem Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: Skąd się oni w ogóle wzięli?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: Paznokcie brudne od ziemi są objawem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: Mogliby umyć ręce!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: Więc mówisz, że ogrodnik automatycznie jest Przybyszem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: To nie ma najmniejszego sensu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Sprawdź moje paznokcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: No? Jestem Przybyszem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: Nie wydaje mi się.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: Każdy kolejny dzień jest bardziej absurdalny od poprzedniego.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: A co, jeśli zarwałem noc? Albo płakałem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: Sam już nie wiem, jak to wszystko ma funkcjonować.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: I co zrobisz, gdy potwierdzisz jeden objaw? Lub kilka?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: Dziś zrobię się na Przybysza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: Specjalnie się popłaczę, wspominając lepsze czasy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: Wszystkie te testy na objawy, faceci w żółtych strojach…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: To wszystko…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: …jest równo popieprzone.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: Czy kiedykolwiek zdaje ci się, że wszystko stacza się do jakiegoś okropnego piekła?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Niby wszystko jest pod kontrolą, a jednak wokół panuje absolutny chaos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: Dobra, rób swoje cholerne zdjęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (Robisz mu zdjęcie).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (Siedzi spokojnie, nie mieszcząc się całkowicie w kadrze, ale nie widzisz nic podejrzanego).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: Przeraża mnie myśl, co nastąpi dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: Ja pierdolę, poważnie? Głupi jakiś jesteś?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: Czy FEMA nasrała ci do głowy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: Czy może jesteś naprany? Myślałem, że twardego towaru już dawno nie ma…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: Ale skoro prosisz, to ci pokażę!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: Zadowolony?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: Powęszyłeś dobrze?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: Dzięki, że mi w dupie nie zacząłeś grzebać!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: No dobrze, ale szybko.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: Słucham?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Uhm… Okej.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: Skończyłeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: Czy zostawisz mnie teraz w ciszy i spokoju?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: Ręce…? Momencik.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: Są zniszczone dźwiganiem męża, którego odmówili ratować.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: Słuchaj, czy możesz przestać prosić mnie o te bzdety?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: Jeśli tak bardzo cię ręce świerzbią, żeby mnie zastrzelić, zrób to.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: Jestem wykończona…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: Czego szukasz? Zaczerwienienia?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: Jeśli musisz…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: Więc jeśli okażę jakieś emocje, znaczy to, że jestem Przybyszką?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: Czy możemy być ze sobą szczerzy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: Nie będziesz szczęśliwy, ponieważ nie umiesz płakać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: Nie można też bez przerwy gadać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: Co wtedy pozostaje? Siedzenie z twarzą w dłoniach?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: Czy koniec naprawdę nastanie tak łatwo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: Nie będzie już cierpienia?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: Ale nie uratowałam cię… mój…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: Poważnie? Nie wydaje ci się to upokarzające?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: Nikt nie pomógł mi uratować męża, a teraz…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: CHCESZ UWIECZNIĆ JEGO ŚMIERĆ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: Brak mi słów.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: Rób, co musisz i zostaw mnie w spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (Robisz jej zdjęcie).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (Nie zauważasz niczego podejrzanego).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (Nieboszczyk załapał się w kadr, co zmusza cię do zastanowienia się nad życiem).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: Zadowolony?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: Mąż zawsze lubił moje zęby.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: Ale ja zawsze chciałam założyć aparat.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Jasne. Bo czemu i by mnie nie zastrzelić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: Po co ludzie w ogóle płaczą w tej nowej rzeczywistości? Bo z pewnością ze śmiechu nie pękają.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: Ocipiałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: Powiedz mi, czy naprawdę straciłeś rozum?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: Jeśli te diabły kazałby ci skoczyć z mostu, czy skoczyłbyś?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: Ty… Ja pierdolę… nie mam słów.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: No i? Pewnie, wyciągaj spluwę.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Kurde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Dalej, pociągnij za spust. Przez FEMA nie mam po co żyć. Wykończ mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: Już nawet nie myślę o aparacie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: Dopóki nie spytałeś o moje zęby, zapomniałam o tych przeszłych zachciankach.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: Och, Boże… Jestem wykończona.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: Jestem przez to dla wszystkich wredna, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: To niczyja wina. Oprócz kilku sukinsynów.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: Nie rozumiem tego i nie chcę zrozumieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: Ośmieszać kogoś, kto dopiero co utracił…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: Chwileczkę…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: Och. No i wyjąłeś swoją wielką giwerę.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: I nie miałeś nawet tyle miłosierdzia, by mnie zastrzelić.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: Po co było to wszystko? Masz kompleksy? Nie musisz ich tak okazywać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: Co chcesz sprawdzić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: Zęby? Jasne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: Ziomal był dentystą.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: I wiesz co? Powybijali mu wszystkie zęby! Ha, ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: Och, chcesz je obejrzeć. W porząsiu…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: Wszystko gites, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: O kurde, ziom! To była przecież zwykła historyjka!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: Staaary… Nie kumam jednak, żeby zaraz rozwalać mi łeb z powodu zębów.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: Proszę?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: Porąbało cię?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: Ssij mi fiu…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: O kurwa, ziom. Jestem tylko zwykłym kolesiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: Widzisz, stary? Nie grzebię w niczym pazurami.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: Nie zrozum mnie źle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: Czyszczę je, tak. Słuchaj, widziałem na ziemi monetę i ją podniosłem, kumasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: Są czyste. Umyję dziś ręce, stary. Bez spiny.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: Myję je, ziom, ale dziś nie miałem na to czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: Są czyste… w miarę.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: Sprzątniesz mnie z powodu brudnych paznokci?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: Kuuurde. Nie sądziłem, że zginę z tak debilnego powodu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: Szczerze mówiąc, trochę dziwna metoda na identyfikację tych dziwadeł, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: Palantów i frajerów zaraz poznać po rękach, ale nie Przybyszy, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: Trzeba by było wstawać o 9 rano i pracować jakieś cztery godziny. To nie dla mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: Oczy ostatnio swędzą mnie niemal tak samo jak jajca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: Uważasz, że to od słońca? Trochę podejrzane, co nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: Kurna, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: To jakaś różyczka z dupy czy inne świństwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: Słuchaj, mam plan.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: Będziemy grozić ludziom, że im strzelimy w łeb… i zgarniać kasę, żeby tego nie robić!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: Co? No dalej, stary, to proste jak świński ogon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: Dobra, nie lubisz kręcić wałków, w porządku. Ale moim oczom nic nie odjebało, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: Gdybyś tylko miał jakieś krople do oczu…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: I tak bym ich nie odkupił. Mam swoje powody.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: Chcesz zdjęcie? Wporzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: Uprzedzam, że jestem wrażliwy na światło. Mogę drgnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (Robisz mu zdjęcie).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (Zdjęcie wygląda normalnie, ale jego twarz…).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (Jest bardzo rozmazana).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: Mówiłem, brachu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: Chcesz zrobić kolejne?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: Nie naciągaj mnie tu, ziom. Ten szmelc musi się najpierw rozgrzać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: Trzymaj ich krótko.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: Inaczej zapanuje luz, zapomną, w czyjej chacie siedzą, i nie zapłacą.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: Czekaj!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: Jebać ciebie i twoją chatę. Spieprzam stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: Stanę prosto w słońcu. Oby ci to leżało na sumieniu, psi zwisie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: Kuuurwa…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: Ten twój dzisiejszy wałek trąci fetyszem, wieprzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: Ale to ty tu rządzisz…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: No i jaki mamy werdykt? Wszystko cacy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: Hola, czekaj! Okej, kurde, raz spróbowałem się tam ogolić i przy tym zostałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: Tylko gęba na kłódkę, pało. Nie jesteś kablem, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: Joooł…! To nie teges, ziom! Co, mam ci dać zdjęcie fiuta?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: Kumasz, że taki cywilizowany dżentelmen jak ja nie może mieć buszu pod pachą, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: Wiedziałem, żeś porządny facet. Nie rozwaliłbyś zwykłego gościa, nie? Heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: Przykręćmy może śrubę tym ciemięgom, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: Nie? Wporzo. Może później.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: Rozumiem, że stresu masz niemało z powodu Przybyszy i całego tego gówna.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: I że robisz to wszystko dla nas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: Nie mam ci nic za złe. Serio, serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: Co chce pan sprawdzić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: Moje zęby? Mam panu pokazać moje zęby?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: Dlaczego? Wciąż mam trochę mleczaków. Tata mówił…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: Nie będę już płakać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: Proszę, oto one.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: Co to oznacza?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: Czy wszystko w porządku?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: Już sama potrafię obcinać sobie paznokcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: Nie idzie mi to jeszcze najlepiej…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Proszę popatrzeć!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: Całkiem ładne, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: Sama wszystkie przycięłam. Tak, ja sama.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: Pójdę sobie, chcę być sama.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: Zajrzy mi pan w oczy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: Czy będzie pan widział, o czym myślę?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: W takim razie będę bardzo ostrożnie myślała, proszę się nie martwić.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: Dlaczego pan tak patrzy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: Czy w‑w‑widział pan…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: Pan… *płacze*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: Chcę się cz‑czegoś n‑napić.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: Uhm… Jak mam to zrobić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (Patrzysz na nią i uznajesz, że przesadzasz).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: Chce pan tylko wiedzieć, jak się czuję?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: Jestem bardzo zmęczona. Czy mogę już iść się sama pobawić?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: Zdjęcie?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: Rzadko miałam robione zdjęcia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: Pokaże mi je pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (Robisz jej zdjęcie).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (Zdjęcie wyszło odrobinę zamazane).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (Podbiegła do ciebie prędko, zanim zdjęcie było zrobione do końca).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Hmmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: Dziękuję…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: Nie podoba mi się. Nie chcę więcej zdjęć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: Pewnież to, sprawdzajcie, kochaniutki. Nie ujrzycie nic, czegoście przedtem nie widzieli.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: Moje zęby?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: Aaaaaa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: Wiesz, te stare zęby… pfuj, nie cierpiałam ich. Chciałam je wszyściuteńkie powyrywać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Oglądajcież je. Ani rachować, ani układać, ani odmierzać nie zdołają.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: Dają jeno tyle, żeby złączyć koniec z końcem, by się ledwie wyżywić.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Och, kochaniutki… Czy zaprawdę tego pragniesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: Oczy są jak okna. W domach po światło, a w człowieku po prawdę.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: Moje jednak kurz zasłania… Szkła spękane… A mole dawno zjadły zasłony…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: Nie patrzaj, kochaniutki. Tam jeno pusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: Pfuj! Starą babinę do podnoszenia rąk przymuszać… Wstydu nie masz w sercu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Lecz cóż począć mogę? Tyś tu panem i gospodarzem tego dworu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: I co, kochaniutki?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: Po co marnować kliszę na starą babinę? Zapewne towar deficytowy… Nalegasz? No więc dobrze, niechaj będzie…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: I co myślisz, kochaniutki?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: Pfuj! Cóż za pomysł, słodziutki.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: Nic w nich niezwykłego. Słuch wciąż dobry, ale czasem się zdaje… jakoby mnie coraz mniej było.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: Jakby mnie dostrzec można było jedynie przez okienko na strychu, a i to nie zawsze.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: O jejku, jejku… Po cóż to kierujesz we mnie ten staroć, kochaniutki?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: Samiuteńka już puszczam w szwach, a ty jeszcze zęby mi powybijać zamierzasz? Pfuj!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: Miarkujesz, żem przestraszona, kochaniutki? Że obawiam się utracić te stare ręce?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Och, tyleż razy pochwytałam jeno powietrze, że paluchy już same wiedzą, że niczego się nie chwycą.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: A więc do tego mnie żywot przyprowadził…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: Nie wierzysz? Chcesz się przekonać? Patrzajże więc…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: Też się ludziskom w ślepia gapiłam. Przypomina mi to dawne czasy…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: No cóż, kochaniutki, starość nie radość. Każdy sędziwy szczęśliwiec takie coś w darze otrzymuje. Nie wiedzieliście?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: Grzyb bólu nie zna, jeść nie woła. Zwyczajnie jest. Żyje, by żyć. Jako ja, he, he, he.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: Och, cóżże znowu? Z tego powodu też krew cię zalewa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: Słucham, kochaniutki? Wnioskujesz coś z łypnięcia w me uszy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: Pfuj… To nie wadzi. Jakie to znaczenie dla mnie, kochaniutki? Już od dawien dawna chciałam z kostuchą się przywitać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: Tylko że…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: Opłaciłam dentystę, żeby mi je wszyściusieńkie powyrywał, ale za jednym zamachem się nie dało.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: Przychodziłam, wyrywał jeden albo dwa… wszystek nie zdołał. Lekarzom czasu na coś takiego brak.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: I tak oto jestem z tymi upierdliwymi, sterczącymi resztkami w gębie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: Ręce są dla tych, co je w objęciu mają. Ja takiej pociechy od dawna nie doznaję.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: Wyciągnąć ręce? Pfuj! Sam nie możesz sięgnąć?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: Do chatki nieprawdy sześciopalczastej… Wejdźże, przejdź się po tej wąskiej klatce…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: Uważasz, że losowi się wymkniesz? Tylko jeśli przedwcześnie skonacie. Tylko mi się tym tu nie sugeruj!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: Taka śliczna buzia! Nie godzi się, by się zmarnotrawiła!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: Za moich lat tylko burżuje takie zbytkowności mieli. Dziś zaś każdy prostak takowe trzyma!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: Lecz koniec już mojej gadki! Wszystkie te głupoty i zawracanie głowy ludziom bez powodu… Pfuj!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: Proszę tylko nie męczyć mojej siostry.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: W rodzinie zawsze mieliśmy mocne zęby.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: Kiedy byłam nastolatką, próbowałam nawet otwierać nimi butelki z piwem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: Nie skończyło się to dobrze, ale dostałam nauczkę, że trzeba dbać o to, co nie odrasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: Ostatnio mam ręce pełne roboty, bo moja siostra nie jest w stanie o siebie zadbać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: Jak niby mają wyglądać ręce spracowane opieką nad dwoma osobami?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: Tak, siostra dużo płacze, ale oczy wciąż mamy bardzo podobne. Jej są odrobinkę spokojniejsze.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: Co mnie martwi…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: Tak, siostra dużo płacze, ale oczy wciąż mamy bardzo podobne. Znaczy się, że nie są przekrwione.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: Może wypłakała już wszystkie łzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: Dobrze, pokażę panu. Proszę tylko zostawić moją siostrę w spokoju, okej? Ona nie ma na to siły.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: Zazwyczaj się tam golę. Staram się dbać o siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: Nawet w tych obłąkanych okolicznościach.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: Zazwyczaj dbam o siebie, ale nie wzięłam maszynki do golenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: Teraz i tak nie mam na to czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: Razem z siostrą przeszłyśmy już wystarczająco wiele. Proszę, żeby pan to odłożył.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: Ostatnio zaczęłam palić. To przez takich ludzi, jak pan…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: Myśli pan, że tylko panu jest ciężko?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: Uważa pan, że może celować bronią do każdego?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: Co się stało? Czy moje spojrzenie było zbyt prędkie lub puste jak na pana gust?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: Co się stało? Czy moje spojrzenie było zbyt puste jak na pana gust?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: Myśli pan, że pańskie spojrzenie jest inne?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: Proszę się uspokoić i nie być porywczym. Zawsze to powtarzam swojej siostrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: Szkoda, że panu także muszę o tym przypominać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: Chwila. Czy w wiadomościach naprawdę mówili, że Przybysze mają takie pachy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: Proszę się bardziej zastanowić, żeby nie zrobił pan czegoś głupiego.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: A więc to tak kończy się pieśń mojego życia?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: Słodko‑gorzka historia, ale bez słodyczy…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: Życie nieustannie nas testuje. Wszystko zawsze było takie ciężkie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: Moja siostra nie podołała. Poddała się.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: Rozumiem. Znalazł się pan w trudnej sytuacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: Ale jeśli ulegnie pan panice, niczym się pan nie będzie różnił od Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: Jak pan myśli, co by się stało, gdyby się pan odizolował od wszystkich?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: Ech, mam tego dość.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: Chciałabym nie żyć w ciągłym strachu i zaznać chwili spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: Ale dzień za dniem jest to samo i końca nie widać.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: Prawdę mówiąc, jestem przerażona.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: Co będzie dalej? Czy Przybysze znikną? Czy może już zawsze będą obok nas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: Dalej, zrób to.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: Popatrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: Powybija mi je pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: Siostra mi pomaga.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: Ale to bez sensu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: Powinna…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: Powinna dać mi wtedy umrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: Z siostrą mamy podobne oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: Ale jej nie są takie puste…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: Siostra mnie tam goli. Dba o mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: Najwyraźniej nie na próżno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: O, jeszcze lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: Niech pan bierze moją duszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: Nie ma potrzeby.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: Śmierć już puka do mych drzwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: Zostaw to mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: Daj mi strzelbę.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: Sama to zrobię.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: Pustka nie opuści mnie, gdy zamknę oczy…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: Przeskoczy na pana…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: Czy tego pan chce?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: No, złociutki?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: Pociągniesz za spust?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: Nie ma pan odwagi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: I tak pan zginie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: Szkoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: Może innym razem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: Szkoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: Nie mam objawów.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: Może innym razem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: A co, jeśli tylko czekamy, aż pochłonie nas czarna dziura?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: Pożre nas i rozciągnie wzdłuż horyzontu zdarzeń.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: Nie doświadczymy własnego końca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: Tylko wieczną agonię i oczekiwanie śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: To bez znaczenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: Poczekam na swoją kolej.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: Moja pieśń…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: Tobie była przeznaczona!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: Kończyła się szczęśliwie!'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733824
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
