  - m_Id: 23515512964112384
    m_Localized: 'Alkonost: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112385
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112386
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112387
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112388
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112389
    m_Localized: 'Alkonost: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112390
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112391
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112392
    m_Localized: 'Alkonost: To koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112393
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112394
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112395
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112396
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112397
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112398
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112399
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112400
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112401
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112402
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112403
    m_Localized: 'Sirin: To koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112404
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 23515512968306688
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341248
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341249
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341250
    m_Localized: 'Theorist: Oczywiście. Proszę tylko baczyć… Sprawdzanie mnie sprawi, że dowie się pan rzeczy, których wolałby pan nie wiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341251
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341252
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341253
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341254
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341255
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341256
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341257
    m_Localized: 'Theorist: Proszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341258
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341259
    m_Localized: 'Theorist: Widzi pan, mam zły nawyk gryzienia ołówków.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341260
    m_Localized: 'Theorist: Pęknięcia, krew… Tak, tak, wiem. To tylko zły nawyk…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341261
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341262
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341263
    m_Localized: 'Theorist: Pewnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341264
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341265
    m_Localized: 'Theorist: Widzi pan atrament? Dostaje się pod paznokcie, plami skórę, wnika w pory. Oto cena zdobywania wiedzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341266
    m_Localized: 'Theorist: Widzi pan atrament? Dostaje się pod paznokcie, plami skórę, wnika w pory. Oznaki wiedzy… słono mnie kosztowały.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341267
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341268
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341269
    m_Localized: 'Theorist: Ach, oczy. Tak, naturalnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341270
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341271
    m_Localized: 'Theorist: Są niebieskie. Dobrze, to znaczy, że jeszcze mnie nie zmienili.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341272
    m_Localized: 'Theorist: Poszukując informacji, trzeba mieć oczy szeroko otwarte. Pochłaniać nimi wszystko, zanim zmienią rzeczywistość.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341273
    m_Localized: 'Theorist: Postrzegam świat takim, jakim jest. Bez zniekształceń i zakłóceń. A pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341274
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341275
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341276
    m_Localized: 'Theorist: Pachy, mówi pan? To nietypowe…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341277
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341278
    m_Localized: 'Theorist: Widzi pan te włosy? To naturalna ochrona. Spowalnia parowanie i zatrzymuje elektrolity.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341279
    m_Localized: 'Theorist: Ci, którzy się ich pozbywają, skazują się na łaskę perspiracji, co czyni ich podatnymi na zagrożenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341280
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341281
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341282
    m_Localized: 'Theorist: Zdjęcie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341283
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341284
    m_Localized: 'Theorist: Nie można im ufać. Można je zretuszować, zmienić, coś z nich wyciąć. Ale tej… tej chwili nie można odmienić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341285
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341286
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341287
    m_Localized: 'Theorist: Uszy? Ach, rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341288
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341289
    m_Localized: 'Theorist: Musiał pan obejrzeć jedyne słuszne i prawdomówne wiadomości, tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341290
    m_Localized: 'Theorist: Szuka pan objawów? Proszę się nie martwić, zabezpieczam się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341291
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341292
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341293
    m_Localized: 'Theorist: No, niech pan strzela. Ale proszę uważać na te „suplementy”. Oni kontrolują nas poprzez żywność…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341294
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341295
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341296
    m_Localized: 'Theorist: Obawia się pan poszukujących prawdy? Wtedy to nie mnie się pan lęka… lecz siebie samego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341297
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341298
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341299
    m_Localized: 'Theorist: Z pewnością jest pan świadom, że broń to tylko kolejne narzędzie kontroli?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341300
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341301
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341302
    m_Localized: 'Theorist: Unieść ręce? Czy pan wie, dlaczego podniesienie rąk to uniwersalny gest kapitulacji? Kto to ustalił, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341303
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341304
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341305
    m_Localized: 'Theorist: Czy chce pan wymazać to zdjęcie, czy osobę na nim, hm? Proszę pomyśleć, kto na tym zyska.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341306
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341307
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341308
    m_Localized: 'Theorist: Zastrzelenie mnie i posłuchanie rezonansu huku wystrzału może być niezłą oznaką, prawda, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341309
    m_Localized: 'Theorist: Proszę spróbować wycelować w Przybysza… Zadźwięczą inną wibracją!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341310
    m_Localized: 'Theorist: Chce mnie pan uciszyć? Czy pan myśli, że to coś zmieni? Cisza to tylko kolejne narzędzie, którym nas kontrolują.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341311
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341312
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341313
    m_Localized: 'Theorist: Wie pan, że w niektórych krajach ukrywają mikroskopijne anteny w plombach zębów? To prawda, niech pan poczyta.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341314
    m_Localized: 'Theorist: Pod mikroskopem te pęknięcia ukazują ślady…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341315
    m_Localized: 'Theorist: …Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341316
    m_Localized: 'Theorist: Słyszałem, że „Jeśli dzierżysz prawdę, bądź w gotowości, że ci ją odbiorą”. Ja jednak do samego końca jej nie oddam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341317
    m_Localized: 'Theorist: Patrz się wystarczająco długo, a prawda odwzajemni spojrzenie. Widzi pan to w moich oczach?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341318
    m_Localized: 'Theorist: Ludzie boją się przykrej woni, ale jest naturalna. Sztuczne zapachy to tylko kolejne narzędzie, którym nas kontrolują.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341319
    m_Localized: 'Theorist: Odwracają uwagę. Maskują prawdę. Wszystko powinno pachnieć rzeczywistością.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341320
    m_Localized: 'Theorist: Fotografie to kotwice, które zaczepiają nas w rzeczywistości jako dowód naszego istnienia. Dlatego są niebezpieczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341321
    m_Localized: 'Theorist: Sterują nas dźwiękiem, wie pan? Częstotliwości i infradźwięki wpływają na umysł. Musimy przebić się przez ten hałas.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341322
    m_Localized: 'Theorist: Nawet jeśli mnie zabraknie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341323
    m_Localized: 'Theorist: …prawda pozostanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341324
    m_Localized: 'Wifefema: Hę? Sprawdzić mnie? Panie, tylko szybko. Nie mam na to czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341325
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341326
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341327
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341328
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341329
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341330
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341331
    m_Localized: 'Wifefema: Patrz pan.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341332
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341333
    m_Localized: 'Wifefema: Widzi pan? Bielutkie jak śnieg, prościutkie jak kij od miotły. Niczym zęby lalki!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341334
    m_Localized: 'Wifefema: Dziąsła mi trochę krwawią… Zdarza się. Dużo palę i mam sporo zmartwień, słodziutki.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341335
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341336
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341337
    m_Localized: 'Wifefema: Pewnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341338
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341339
    m_Localized: 'Wifefema: I co pan myślisz? Nie mam czasu na manicure, gdy ojczyzna jest w niebezpieczeństwie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341340
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341341
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341342
    m_Localized: 'Wifefema: Jest tu strasznie suche powietrze… Dlatego często mrugam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341343
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341344
    m_Localized: 'Wifefema: Zielone, wiem… Och, słodziutki… to łzy radości, bo mój mąż pracuje w FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341345
    m_Localized: 'Wifefema: Nieźle to brzmi, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341346
    m_Localized: 'Wifefema: Zielone, wiem… Mówisz pan, że trochę niewyraźne? Wątpię!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341347
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341348
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341349
    m_Localized: 'Wifefema: Co się pan tak gapisz? Sam się prosiłeś!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341350
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341351
    m_Localized: 'Wifefema: Przytuliłam męża na pożegnanie, a następnego dnia zaczęło swędzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341352
    m_Localized: 'Wifefema: Czy mam pchły od tego funta kłaków niewartego pozera, czy coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341353
    m_Localized: 'Wifefema: Cóż, nie jestem tu po to, by paradować na wybiegu! Zapomnij pan!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341354
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341355
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341356
    m_Localized: 'Wifefema: Skoro pan nalegasz… Tylko pan nie pokazuje mężowi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341357
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341358
    m_Localized: 'Wifefema: Boże wszechmogący… Czego się pan spodziewał? Rozkładówki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341359
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341360
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341361
    m_Localized: Proszę, patrz pan.
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341362
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341363
    m_Localized: Co, chodzi o kolczyki? No, broń Boże, żeby się kobieta czasem wystroiła! Czy to grzech?
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341364
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341365
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341366
    m_Localized: 'Wifefema: Boże, widzisz i nie grzmisz! Pokazuję panu białe ząbki, a pan mi tu giwerą wymachuje?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341367
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341368
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341369
    m_Localized: 'Wifefema: Och, daj pan spokój! Co jest nie tak z moimi paznokciami?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341370
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341371
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341372
    m_Localized: 'Wifefema: Oczy mam nie dość białe? Ha! Z choinki się urwał.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341373
    m_Localized: 'Wifefema: Nie w twoim typie? Ha! Z choinki się urwał.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341374
    m_Localized: 'Wifefema: A teraz panie odłóż tę zabawkę i wróćmy do wykonywania swoich obowiązków.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341375
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341376
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341377
    m_Localized: 'Wifefema: Na miłość boską! Jeśli chodzi o tę wysypkę, znajdź pan mojego starego i go się zapytaj!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341378
    m_Localized: 'Wifefema: Nie bądź pan głupi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341379
    m_Localized: 'Wifefema: Czekaj no pan, aż mój stary pana dorwie! Tylko czekaj!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341380
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341381
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341382
    m_Localized: 'Wifefema: To fetysz, ty cudaku! Czy może aż tak się pan boisz, co mój stary zrobi, gdy znajdzie tę zbereźną kolekcję…?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341383
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341384
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341385
    m_Localized: 'Wifefema: Co, masz pan coś przeciwko wystrojonej damie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341386
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341387
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341388
    m_Localized: 'Wifefema: Uśmiech jest dumą kobiety. A to krwawienie? Cóż, mogło się przytrafić każdemu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341389
    m_Localized: 'Wifefema: Problem z moimi zębami, co? Przestań się pan tak zachowywać, bo stracisz swoje!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341390
    m_Localized: 'Wifefema: To ręce kobiety pracującej, a nie modelki!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341391
    m_Localized: 'Wifefema: Panie, może sam znajdź sobie jakąś robotę… Bo w chuja cięcie to nie zajęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341392
    m_Localized: 'Wifefema: Gdyby tylko wzięli mnie do FEMA! Przybysza poznałabym z kilometra! A takich jak pan? Załatwiłabym bez kiwnięcia palcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341393
    m_Localized: 'Wifefema: Faceci uwielbiają gadać, że kobieta powinna być ładna. Mam to w dupie. Kombinezony ochronne nie są na pokazy mody.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341394
    m_Localized: 'Wifefema: Ojejuśku, jak się boję! Zrobił mi zdjęcie! Pomocy! Ha…! Bobasek pociągnie za spust? Panie, kto cię tu zrobił szeryfem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341395
    m_Localized: 'Wifefema: Diabeł tkwi w szczegółach. Jak ten cholerny kolczyk. Przypomina mi, kim jestem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341396
    m_Localized: 'Wifefema: Kobietą. Człowiekiem. A pan… zadzierasz tu nosa, ważniak jeden. Masz mnie za jakieś zwierzę. Za kogo się pan masz, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341397
    m_Localized: 'Wifefema: Niezły z pana gagatek, wiesz pan? Jeśli tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341398
    m_Localized: 'Wifefema: …byłby tu mój mąż.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341399
    m_Localized: 'Raskolnikov: Och, uhm, oczywiście. Rozumiem, musisz mnie sprawdzić. U‑uważam, że to klawo, że jesteś taki dokładny.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341400
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341401
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341402
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341403
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341404
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341405
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341406
    m_Localized: 'Raskolnikov: Och… Zęby? Tak, jasne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341407
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341408
    m_Localized: 'Raskolnikov: Jejku… Nie zrozum mnie źle, nie jestem jednym z „nich”. Ja tylko… nie dbam o swój wygląd, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341409
    m_Localized: 'Raskolnikov: Jejku… Nie zrozum mnie źle, n‑nie jestem jakimś narcyzem, wiesz? Dbam tylko o wygląd…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341410
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341411
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341412
    m_Localized: 'Raskolnikov: Och… Tak, oczywiście. Rób, co musisz. Proszę, spójrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341413
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341414
    m_Localized: 'Raskolnikov: No… nie są najpiękniejsze. Z‑zawsze próbowałem je chować… ale teraz to bez sensu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341415
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341416
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341417
    m_Localized: 'Raskolnikov: Tak wyszło, że… N‑nie miałem nawet okazji ich nieco spracować. Wciąż tylko uciekam i chowam się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341418
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341419
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341420
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341421
    m_Localized: 'Raskolnikov: Tylko się nie wystrasz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341422
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341423
    m_Localized: 'Raskolnikov: Nie p‑płakałem, okej? Tylko źle sypiam, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341424
    m_Localized: 'Raskolnikov: Zawsze dziko ruszałem oczami, jak szczur w pułapce. Teraz są tylko zmęczone…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341425
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341426
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341427
    m_Localized: 'Raskolnikov: Jejku… Czy t‑to na pewno konieczne?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341428
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341429
    m_Localized: 'Raskolnikov: Widzisz? Normalne, prawda? Nawet się bardzo nie pocę… Pewnie zbyt się boję, by wydzielać zapach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341430
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341431
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341432
    m_Localized: 'Raskolnikov: Po co ci moje zdjęcie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341433
    m_Localized: 'Raskolnikov: Mogę odmówić?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341434
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341435
    m_Localized: 'Raskolnikov: H‑hej, nie ma potrzeby machać we mnie bronią, stary! Okej, okej, rób to zdjęcie! Jezu…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341436
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341437
    m_Localized: 'Raskolnikov: T‑tylko upewnij się, że wyjdę jako‑tako, okej? Albo chociaż niezbyt żałośnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341438
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341439
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341440
    m_Localized: 'Raskolnikov: O‑och, zgoda, jasne. Ale czemu uszy? Obyś nie spodziewał się czegoś… obrzydliwego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341441
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341442
    m_Localized: 'Raskolnikov: S‑słyszę wszystko… nawet gdy nie powinienem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341443
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341444
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341445
    m_Localized: 'Raskolnikov: O motyla noga… Nie s‑spodziewałem się, że tak pogrywasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341446
    m_Localized: 'Raskolnikov: Ale może masz rację… czasem lepiej zastrzelić, niż się uśmiechnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341447
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341448
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341449
    m_Localized: 'Raskolnikov: U‑uważasz, że te ręce mogą zabić? Według mnie są żałosne…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341450
    m_Localized: 'Raskolnikov: Zrób to, stary. Zastrzel mnie. Już nawet brzytwa mi nie została do chwycenia się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341451
    m_Localized: 'Raskolnikov: Cz‑czekaj! Nie chciałem…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341452
    m_Localized: 'Raskolnikov: Wybacz… Te ręce nikomu nie pomogły… Może na to zasługuję…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341453
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341454
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341455
    m_Localized: 'Raskolnikov: Ledwo sypiam… To widać, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341456
    m_Localized: 'Raskolnikov: M‑może… uhm, mógłbyś mi z tym pomóc?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341457
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341458
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341459
    m_Localized: 'Raskolnikov: Może i nie jestem niebezpieczny…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341460
    m_Localized: 'Raskolnikov: A‑ale nie każdy zachowa taki spokój, gdy celuje się do niego z broni, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341461
    m_Localized: 'Raskolnikov: Kiedyś wpadniesz na kogoś… tęgiego i podłego. A wtedy… będzie koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341462
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341463
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341464
    m_Localized: 'Raskolnikov: Jejku… Jeśli… coś widać na tym zdjęciu…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341465
    m_Localized: 'Raskolnikov: Może powinieneś pociągnąć za spust…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341466
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341467
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341468
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341469
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341470
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341471
    m_Localized: 'Raskolnikov: W szkole bardzo bałem się dentystów. Trząsłem się i pociłem ze strachu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341472
    m_Localized: 'Raskolnikov: Wtedy pewnego dnia jeden z wrednych dzieciaków wybił mi ząb… I w‑wiesz co wtedy zrobiłem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341473
    m_Localized: 'Raskolnikov: Nic.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341474
    m_Localized: 'Raskolnikov: Zero.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341475
    m_Localized: 'Raskolnikov: N‑nie… byłem w stanie się obronić. Nawet nie próbowałem. Tak bardzo byłem zlękniony…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341476
    m_Localized: 'Raskolnikov: I skoro nie jestem silny, będę przynajmniej piękny… Wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341477
    m_Localized: 'Raskolnikov: Nieskazitelne zęby stały się jakby moją tarczą. Jak gdyby zależała od nich moja wartość.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341478
    m_Localized: 'Raskolnikov: Wiem, to głupie. Może powinienem był wyciągnąć inne wnioski… Sam nie wiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341479
    m_Localized: 'Raskolnikov: Za każdym razem, gdy mnie paraliżowało… lub przegapiałem swoją szansę… Uderzałem mocno pięścią w ścianę. Do krwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341480
    m_Localized: 'Raskolnikov: Jak gdyby ból zmywał ze mnie słabość czy coś… Jakbym karząc się wystarczająco mocno, zasługiwał na siłę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341481
    m_Localized: 'Raskolnikov: Ale jedyne, co mi z tego przyszło to brud za paznokciami i uciążliwa infekcja…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341482
    m_Localized: 'Raskolnikov: I to jest okej, wiesz? Bo nie jestem od nich wcale lepszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341483
    m_Localized: 'Raskolnikov: Zwykłem zaciskać pięści tak mocno, że mi kostki bielały. Jak gdyby opanowaniem nerwów mógłbym przeganiać strach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341484
    m_Localized: 'Raskolnikov: Teraz je chowam. Wiesz… żeby nikt nie zauważył, jak mi drżą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341485
    m_Localized: 'Raskolnikov: G‑gdy zauważyłem tego gościa w uliczce… Spojrzał na mnie, jak ty teraz. Przeszywał mnie wzrokiem na wylot.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341486
    m_Localized: 'Raskolnikov: I pomyślałem… że gdybym miał takie spojrzenie, m‑może w szkole nie byłbym popychadłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341487
    m_Localized: 'Raskolnikov: Może byłbym w stanie się obronić…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341488
    m_Localized: 'Raskolnikov: Jejku… w‑wybacz, ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341489
    m_Localized: 'Raskolnikov: Dla ciebie pewnie paplam jak potłuczony…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341490
    m_Localized: 'Raskolnikov: M‑miewałem sny o byciu normalnym. Kimś niezauważalnym. Bez smrodu i odważnych poczynań.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341491
    m_Localized: 'Raskolnikov: Aczkolwiek teraz rozumiem… Będąc szarakiem, jest się najłatwiejszą ofiarą. Dlatego… chcę być kimś innym.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341492
    m_Localized: 'Raskolnikov: Kurza twarz… Dziwnie jest wiedzieć, że ktoś cię uwiecznił… Hę? Aura? Więc… widzisz, kim jestem…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341493
    m_Localized: 'Raskolnikov: Powiedz mi, czy mam szansę się poprawić? Czy jestem już Przybyszem? Czy na zawsze będę słabeuszem…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341494
    m_Localized: 'Raskolnikov: Raz słyszałem, jak gość mówi, że wszyscy jesteśmy „nieludźmi”. Od tamtej pory… to roztrząsam. Może miał rację?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341495
    m_Localized: 'Raskolnikov: Może ze mnie ani człowiek, ani Przybysz, tylko coś… niedorobionego. D‑daj mi szansę to zmienić albo skończ ze mną.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341496
    m_Localized: 'Raskolnikov: Zdaje się, że zawsze będę…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341497
    m_Localized: 'Raskolnikov: …ofiarą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341498
    m_Localized: 'Nun: Widać nie tylko Bóg poddaje mnie takim próbom…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341499
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341500
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341501
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341502
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341503
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341504
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341505
    m_Localized: 'Nun: Phi, jeśli pan musi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341506
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341507
    m_Localized: 'Nun: Proszę się nie lękać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341508
    m_Localized: 'Nun: Grzechów się ani nie gryzie, ani nie cycka, dziecko. Ja połykam je w całości…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341509
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341510
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341511
    m_Localized: 'Nun: Tylko prędko.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341512
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341513
    m_Localized: 'Nun: Starość i trutka na karaluchy. Recepta na wysypkę równie uporczywą, jak niewierni… Ale tylko w połowie tak irytującą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341514
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341515
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341516
    m_Localized: 'Nun: No, proszę. Patrzy pan.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341517
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341518
    m_Localized: 'Nun: Coś nie tak? Odbite jest w nich piętno tych gorzkich lat.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341519
    m_Localized: 'Nun: Coś nie tak? Odbite jest w nich moje zmęczenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341520
    m_Localized: 'Nun: Te oczy były świadkami grzechów, jakie ci się nie śniły, dziecko.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341521
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341522
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341523
    m_Localized: 'Nun: Dobry Boże! Szaleju się pan najadł?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341524
    m_Localized: 'Nun: Cóż za pomysł! Zmuszać sędziwą, schorowaną kobietę do podnoszenia rąk i obnażania się przed takimi, jak… pan!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341525
    m_Localized: 'Nun: Tak się nie godzi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341526
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341527
    m_Localized: 'Nun: Co za bezczelność!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341528
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341529
    m_Localized: 'Nun: Widzę, że nie zostawi mnie pan w spokoju…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341530
    m_Localized: 'Nun: Dobrze więc… Skoro taka wola Boga, niech tak będzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341531
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341532
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341533
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341534
    m_Localized: 'Nun: Fotografia? Ba! Szkoda marnować czas na takie wygłupy!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341535
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341536
    m_Localized: 'Nun: Wierzy pan, że zdjęcia ukazują prawdę? Jezu, daj mi siłę… Gołębie w moim klasztorze mają więcej rozumu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341537
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341538
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341539
    m_Localized: 'Nun: Chce pan zajrzeć mi do uszu?! Jak pan śmie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341540
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341541
    m_Localized: 'Nun: Nie jestem jakąś krową na wiejskim targu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341542
    m_Localized: 'Nun: Chyba stracił pan wszelką godność.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341543
    m_Localized: 'Nun: Straszyć tak biedną staruszkę. Wstydu pan nie ma?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341544
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341545
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341546
    m_Localized: 'Nun: Moje dziecię, czy doprawdy myślisz, że bronią wymusisz ode mnie spowiedź? Kule nie oczyszczą cię z grzechu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341547
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341548
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341549
    m_Localized: 'Nun: Nie widzę Boga w twoich oczach, dziecko. Tego boję się bardziej niż jakiejkolwiek broni.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341550
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341551
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341552
    m_Localized: 'Nun: Bóg jest wszędzie. Widzi, jak dręczysz biedną starowinkę… Powinien się pan wstydzić!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341553
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341554
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341555
    m_Localized: 'Nun: Niedorzeczność! Zaiste wierzy pan, że przelanie mojej krwi pana ocali? Czy zawsze miał pan taki barani łeb?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341556
    m_Localized: 'Nun: Robi pan z siebie głupca i nie drgnie przy tym panu nawet powieka!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341557
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341558
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341559
    m_Localized: 'Nun: Dziecko, byłam świadkiem okropności, które obróciłyby w pył twoją duszę. W oczach Boga wymachujesz jeno błahostką!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341560
    m_Localized: 'Nun: Zbłąkana owca, co się nowinami kieruje, a potem porywa się z ostrzami gorszymi niż bicz boży na bliźniego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341561
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341562
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341563
    m_Localized: 'Nun: Niech pan sam spróbuje dożyć mojego wieku i zachować wszystkie zęby!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341564
    m_Localized: 'Nun: Żywiąc się tymi śmieciami, stracisz zęby prędzej ode mnie, dziecko! Jeśli Bóg nie raczy przywołać nas do siebie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341565
    m_Localized: 'Nun: Mówi się, że w dłoniach odbite jest życie człowieka.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341566
    m_Localized: 'Nun: Moje jednak? Ukazują wyłącznie cierpienie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341567
    m_Localized: 'Nun: Oczy są zwierciadłem duszy. Ale, drogie dziecko… W twoich widzę wyłącznie mrok.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341568
    m_Localized: 'Nun: Utracił pan prawdziwe światełko wiary. Zupełnie jak ci bezbożnicy, co mnie przepędzili z mojego świętego azylu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341569
    m_Localized: 'Nun: Oby ten wieczny mrok był panu karą, bo ani wiary, ani łaski nie widać w pana spojrzeniu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341570
    m_Localized: 'Nun: Robi pan te wszystkie swoje testy, ale prawda nie leży na zewnątrz, tylko wewnątrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341571
    m_Localized: 'Nun: Ojcze nasz, któryś jest w niebie, poprowadź sługę swego na powrót do światła. Zbłądził daleko, kuszony władzą…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341572
    m_Localized: 'Nun: Wszystkie te pana zdjęcia to zupełne brednie! Farmazony!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341573
    m_Localized: 'Nun: Ludzie umierają, a ich dobra doczesne pozostają, by po pogrzebie nikt już nigdy więcej na nie nie spojrzał!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341574
    m_Localized: 'Nun: Taka jest każdego spuścizna. Zostanie pan zapomniany. A jednak pytluje tu pan jęzorem niczym głupiec.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341575
    m_Localized: 'Nun: Bóg w swym miłosierdziu obdarzył mnie dobrym słuchem… A skończyłam tutaj z cymbałem, pałającym się w… w…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341576
    m_Localized: 'Nun: Bóg jeden wie w czym…! Wymachuje tą przeklętą bronią, jakby wypełniał wolę niebios!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341577
    m_Localized: 'Nun: Wybacz mi, Ojcze… Modlę się, bym już nigdy nie ujrzała niczego tak okrutnego, jak człowiek.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341578
    m_Localized: 'Nun: Panie miłosierny… przyjmij mą…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341579
    m_Localized: 'Fugitive: No jasne. Nie mam nic do ukrycia… może poza moim cholernym pechem. Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535552
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535553
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535554
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535555
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535556
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535557
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535558
    m_Localized: 'Fugitive: W porządku, patrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535559
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535560
    m_Localized: 'Fugitive: Uśmiech jak u konia, co? Ci gestapowcy sprzątają ludzi i nie gapią się im w zęby, kumasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535561
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535562
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535563
    m_Localized: 'Fugitive: Jasne, sprawdzaj. Ręce pianisty to to nie są.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535564
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535565
    m_Localized: 'Fugitive: Brudne, nie? Wpadłem w kałużę, uciekając przed tymi gestapowcami, a przedtem poraniłem się na drutach kolczastych.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535566
    m_Localized: 'Fugitive: Dobra, patrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535567
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535568
    m_Localized: 'Fugitive: Brudne, nie? Wpadłem w kałużę, uciekając przed tymi gestapowcami. Ale tobie nie chodzi o brud, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535569
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535570
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535571
    m_Localized: 'Fugitive: Dobra.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535572
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535573
    m_Localized: 'Fugitive: Taa, w czasach, gdy można dostać kulkę, bo przyuważy cię jakaś kanalia, szybko uczysz się, gdzie patrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535574
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535575
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535576
    m_Localized: 'Fugitive: Ja cię kręcę… nie robisz sobie ze mnie jaj, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535577
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535578
    m_Localized: 'Fugitive: Słuchaj, to się rozniesie, jeśli się tym nie zajmę. A wtedy kto mi pomoże?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535579
    m_Localized: 'Fugitive: Jestem padnięty, uciekałem, i na dodatek dostałem kulkę. Cholera jasna, golenie się tam nie było moim priorytetem, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535580
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535581
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535582
    m_Localized: 'Fugitive: Poważnie? Nie sądziłem, że ktoś to jeszcze robi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535583
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535584
    m_Localized: 'Fugitive: Nie jestem fanem fotografii.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535585
    m_Localized: 'Fugitive: Jak wyszedłem…? Czekaj, kurde… chyba nie chcesz sprzedać mnie FEMA, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535586
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535587
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535588
    m_Localized: 'Fugitive: Żarty sobie stroisz? Nie sądzisz, że te „objawy” służą jedynie sianiu paniki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535589
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535590
    m_Localized: 'Fugitive: Zasyfione? Tak. Jak u każdego, kto by żył i pracował beż żadnej kąpieli.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535591
    m_Localized: 'Fugitive: Kurde, żarty sobie stroisz? Myślisz, że poznasz Przybysza po uszach? A patrz sobie tam, ile wlezie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535592
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535593
    m_Localized: 'Fugitive: Zasyfione? Pewnie ciężko w to uwierzyć, ale w celach FEMA nie oferują gorących pryszniców i wacików. Co za obsługa, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535594
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535595
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535596
    m_Localized: 'Fugitive: Nie zrób nic głupiego, okej? Już mam jedną dziurę, nie szukam kolejnej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535597
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535598
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535599
    m_Localized: 'Fugitive: Ja pierniczę, jeśli chcesz mnie kropnąć z powodu moich rąk, równie dobrze możesz wystrzelać resztę miasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535600
    m_Localized: 'Fugitive: Ja pierniczę, jeśli chcesz mnie kropnąć z powodu brudnych rąk, równie dobrze możesz wystrzelać resztę miasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535601
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535602
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535603
    m_Localized: 'Fugitive: Widziałem mnóstwo szajbusów, psycholi i dziwaków. I wiesz, kurwa, co? Tyś niewiele lepszy!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535604
    m_Localized: 'Fugitive: Ale przynajmniej nie przeprowadzasz na nikim eksperymentów… Wielkie, kurwa, dzięki, koński zwisie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535605
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535606
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535607
    m_Localized: 'Fugitive: Patrz no, zrobiłem każdą poronioną rzecz, o którą prosiłeś. Czego ode mnie chcesz, do diabła?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535608
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535609
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535610
    m_Localized: 'Fugitive: Że co? To zdjęcie ma być ostatnią pamiątką po mnie? Jak miło.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535611
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535612
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535613
    m_Localized: 'Fugitive: Odpierdol się, umyję uszy! Nie trzeba zaraz straszyć bronią!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535614
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535615
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535616
    m_Localized: 'Fugitive: W celach FEMA nie było luster. Nikt nie chce widzieć, jak zmieniasz się w zwierzę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535617
    m_Localized: 'Fugitive: Kurde, zaczynasz mi przypominać tych żółtych gestapowców. Wystarczy szelest, a łapią za broń i strzelają.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535618
    m_Localized: 'Fugitive: Słuchaj, ja mogę ci wybaczyć, ale inni…? Wątpię. Urażą się i sam dostaniesz od nich kulkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535619
    m_Localized: 'Fugitive: Gestapowcy FEMA nie spojrzą nikomu w oczy. Ani pojmanym, ani podobnym sobie. Myślałeś kiedyś, dlaczego tak jest? Hę?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535620
    m_Localized: 'Fugitive: W celach był taki gość, żal mi go było, wciąż się drapał, aż… cóż, przestał. To jakaś infekcja grzybicza.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535621
    m_Localized: 'Fugitive: W celach był taki gość, żal mi go było, wciąż się drapał, aż… cóż, przestał. To pewnie nerwy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535622
    m_Localized: 'Fugitive: Gestapowcy z FEMA też pstrykają zdjęcia. To pierwsze, co robią, gdy się tam przyjedzie. „Do akt” czy inne bzdury.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535623
    m_Localized: 'Fugitive: Jeśli tu przylezą z moim zdjęciem, nie sprzedaj mnie, okej? Nie chcę tam wracać!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535624
    m_Localized: 'Fugitive: Mówią, że gdy przez jakiś czas żyje się w ciszy, zaczyna się słyszeć różne rzeczy. Doświadczyliśmy tego w celach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535625
    m_Localized: 'Fugitive: Cholera jasna… Uciekłem od jednych gestapowców, by zginąć z rąk kolejnego…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535626
    m_Localized: 'Fugitive: Pierdol się…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535627
    m_Localized: 'Bestson: Uhm… Okej… Proszę, powiedz mi tylko, że wszystko będzie dobrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535628
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535629
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535630
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535631
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535632
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535633
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535634
    m_Localized: 'Bestson: Och… Czy naprawdę jest tak źle? No nic… okej…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535635
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535636
    m_Localized: 'Bestson: Rodzice zawsze mówili mi, że, uhm… mam dobre geny.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535637
    m_Localized: 'Bestson: Tylko… czasem krwawią mi dziąsła. Może to od cukrzycy, a może… od stresu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535638
    m_Localized: 'Bestson: Nigdy nie dbałem o zęby… Od dziecka mama musiała mi przypominać o myciu zębów przed spaniem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535639
    m_Localized: 'Bestson: A teraz… wciąż zapominam. Czasem kładę się do łóżka i zamykam oczy z nadzieją, że wrócą…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535640
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535641
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535642
    m_Localized: 'Bestson: Ojej… No dobrze…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535643
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535644
    m_Localized: 'Bestson: To zwykłe ręce. A przynajmniej takie się wydają?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535645
    m_Localized: 'Bestson: Nigdy nie myślałem o tym, jak mają wyglądać ręce.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535646
    m_Localized: 'Bestson: Po prostu… każdy je ma, nieprawdaż?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535647
    m_Localized: 'Bestson: Ojej, kurka wodna… zupełnie zapomniałem o paznokciach. Tata przypominał mi o obcinaniu, ale nie weszło mi to w nawyk.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535648
    m_Localized: 'Bestson: A moje knykcie… No tak, to nic ważnego…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535649
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535650
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535651
    m_Localized: 'Bestson: Hę? Co z nimi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535652
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535653
    m_Localized: 'Bestson: Są zielone. To normalne… prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535654
    m_Localized: 'Bestson: Znaczy się, chyba z nimi nic nie jest… Ostatnio trochę szczypią, ale to pewnie przez… kurz. Albo alergie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535655
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535656
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535657
    m_Localized: 'Bestson: Ojej… W porządku…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535658
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535659
    m_Localized: 'Bestson: Nigdy się tam nie goliłem ani nic.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535660
    m_Localized: 'Bestson: Rodzice nigdy nie kazali, więc… nawet o tym nie myślałem…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535661
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535662
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535663
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535664
    m_Localized: 'Bestson: Chcesz zrobić zdjęcie? No… dobrze. Tylko… powiedz mi potem, czy wszystko jest okej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535665
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535666
    m_Localized: 'Bestson: Ale dziwne zdjęcie. Czy to jakiś specjalny aparat?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535667
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535668
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535669
    m_Localized: 'Bestson: Słucham? Okej… dobrze…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535670
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535671
    m_Localized: 'Bestson: Nawet nie wiem, czego tam szukasz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535672
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535673
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535674
    m_Localized: 'Bestson: Hej… Bez takich!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535675
    m_Localized: 'Bestson: Niektórzy ciągną się za włosy lub obgryzają paznokcie… a ja dłubię w zębach. Ale… to nie takie złe, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535676
    m_Localized: 'Bestson: Hej… wiem, że zęby mam w kiepskim stanie, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535677
    m_Localized: 'Bestson: To nie jest żaden objaw… prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535678
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535679
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535680
    m_Localized: 'Bestson: Hej, bez takich… Są przecież normalne, no nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535681
    m_Localized: 'Bestson: Nie, czekaj… Jestem człowiekiem! Tylko… boję się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535682
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535683
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535684
    m_Localized: 'Bestson: Czekaj! To tylko… nerwy! Nic więcej!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535685
    m_Localized: 'Bestson: Czekaj! To przez niewyspanie, nic więcej!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535686
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535687
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535688
    m_Localized: 'Bestson: Bez takich… ty chyba nie na poważnie, co?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535689
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535690
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535691
    m_Localized: 'Bestson: Błagam… bez takich, proszę pana…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535692
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535693
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535694
    m_Localized: 'Bestson: Czekaj… Czy to doprawdy było takie ważne?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535695
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535696
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535697
    m_Localized: 'Bestson: Mama nawet żartowała, że wyssałem z niej całe wapno. Wiesz, kiedy ssałem cyca.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535698
    m_Localized: 'Bestson: Więc przez to zepsuły jej się zęby, a moje… Są całkiem ładne! Za wyjątkiem dziąseł…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535699
    m_Localized: 'Bestson: Może gdyby byli tu moi rodzice, sprawy miałby się inaczej?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535700
    m_Localized: 'Bestson: Przypominaliby mi dbać o siebie… Nie zaniedbałbym się tak…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535701
    m_Localized: 'Bestson: Ale ich nie ma…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535702
    m_Localized: 'Bestson: I stałem się… jaki jestem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535703
    m_Localized: 'Bestson: Czasami patrzę na moje ręce i przypominam sobie… Mama mówiła, że po niej mam długie i smukłe palce.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535704
    m_Localized: 'Bestson: A tata się śmiał i mówił, że pięści mam po nim. Silne jak za czasów jego młodości.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535705
    m_Localized: 'Bestson: Ale teraz patrzę na nie… i nie rozumiem. Nie pamiętam, jak wyglądały ich dłonie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535706
    m_Localized: 'Bestson: Knykcie bolą, gdy ich dotykam. Wiem, że to niedobrze, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535707
    m_Localized: 'Bestson: Gdy jestem sam… i czekam, aż oni wrócą… i nikt nie przychodzi… nie wiem, co mam począć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535708
    m_Localized: 'Bestson: Więc czasem zaciskam pięści i walę w ścianę. Lepsze to niż siedzieć bezczynnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535709
    m_Localized: 'Bestson: Nie miej mi tego za złe, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535710
    m_Localized: 'Bestson: Mama podczas rozmowy patrzyła mi prędko w jedno i w drugie oko na zmianę!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535711
    m_Localized: 'Bestson: A tata… wybierał jedno i patrzył w nie bez przerwy, nigdy nie odwracając wzroku. Ciekawe… które by teraz upatrzył.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535712
    m_Localized: 'Bestson: Nie… miałeś słuszność. Dużo płakałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535713
    m_Localized: 'Bestson: Jak można nie płakać, będąc samemu? Gdy nikt nie odpowiada? Gdy rodzice… przepadają jak kamień w wodę?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535714
    m_Localized: 'Bestson: Tak naprawdę nie chcę płakać…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535715
    m_Localized: 'Bestson: Nie wiem tylko… jak poradzić sobie z samotnością.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535716
    m_Localized: 'Bestson: Zawsze myślałem, że postępując zgodnie z tym, co mnie uczono, wszystko się ułoży.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535717
    m_Localized: 'Bestson: Jeśli mówią „umyj twarz”, myjesz ją. Jeśli mówią „nie przeszkadzaj”, siedzisz cicho. Nic w tym złego, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535718
    m_Localized: 'Bestson: Ale tutaj… teraz… nikt mi nie mówi, co mam robić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535719
    m_Localized: 'Bestson: I skoro tak jest… czy sam muszę decydować? A co, jeśli popełnię błąd…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535720
    m_Localized: 'Bestson: Dla innych to pewnie dziwne, ale… nigdy nie obchodził mnie mój wygląd.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535721
    m_Localized: 'Bestson: Rodzice mi powtarzali, że jestem przystojny i to mi starczyło.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535722
    m_Localized: 'Bestson: Bez nich… Nie interesuje mnie to.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535723
    m_Localized: 'Bestson: Nie podoba mi się to zdjęcie. Nie wiem, co z nim nie tak, ale patrząc na nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535724
    m_Localized: 'Bestson: …czuję jakiś przygniatający mnie ciężar. Czy to normalne?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535725
    m_Localized: 'Bestson: Czy aura naprawdę coś oznacza?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535726
    m_Localized: 'Bestson: Naprawdę nie wiem… Nigdy czegoś takiego nie widziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535727
    m_Localized: 'Bestson: Jeśli moja i moich rodziców aury się różnią… Może nie jestem już taki, jak kiedyś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535728
    m_Localized: 'Bestson: Może się zmieniłem nie do poznania…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535729
    m_Localized: 'Bestson: Bardzo długo czekałem, aż zapukają do drzwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535730
    m_Localized: 'Bestson: By znów usłyszeć ich głowy i znajome kroki…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535731
    m_Localized: 'Bestson: …na próżno.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535732
    m_Localized: 'Bestson: Czas wciąż płynie, a ja czuję się, jakbym…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535733
    m_Localized: 'Bestson: …w ogóle nie istniał.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535734
    m_Localized: 'Bestson: Zdaje się, że wszystko zepsułem. Znowu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535735
    m_Localized: 'Bestson: Przepraszam, mamusiu…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535736
    m_Localized: 'Buddy: Mnie? W porządku, koleżko. Nie mam nic do ukrycia, ani żadnych powodów, żeby to robić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535737
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535738
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535739
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535740
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535741
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535742
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535743
    m_Localized: 'Buddy: Czemu nie? Patrz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535744
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535745
    m_Localized: 'Buddy: Widzisz? Połowa jak z obrazka, czysta i biała, a reszta…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535746
    m_Localized: 'Buddy: Powiedzmy, że część z tej drugiej połowy nieco się zepsuła.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535747
    m_Localized: 'Buddy: Takie jest życie… czasem daje w kość.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535748
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535749
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535750
    m_Localized: 'Buddy: Oczywiście, patrz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535751
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535752
    m_Localized: 'Buddy: Łapy jak imadła, co? Stworzone do ugniatania ciasta lub budowlanki…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535753
    m_Localized: 'Buddy: A ja jedynie obalam piwo za piwem i wszystko niszczę. Takie jest życie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535754
    m_Localized: 'Buddy: A ja jedynie obalam piwo za piwem. Takie jest życie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535755
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535756
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535757
    m_Localized: 'Buddy: Tak jest, patrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535758
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535759
    m_Localized: 'Buddy: Zwykłe, brązowe. Takie same jak u połowy ludzkości. Nic w nich specjalnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535760
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535761
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535762
    m_Localized: 'Buddy: Uhm, koleżko… na pewno tego chcesz? No dobra, dawaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535763
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535764
    m_Localized: 'Buddy: Nic tam nie ma do oglądania. Owłosione jak u goryla i jeszcze dostałem jakiegoś grzyba. Pewnie od spania z psem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535765
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535766
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535767
    m_Localized: 'Buddy: Hm. Owszem, zrób mi zdjęcie, jeśli musisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535768
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535769
    m_Localized: 'Buddy: Nie miałem robionych zbyt wielu zdjęć. Jakoś zawsze brakło na to czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535770
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535771
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535772
    m_Localized: 'Buddy: Oto i one… zwykłe uszy jakich wiele.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535773
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535774
    m_Localized: 'Buddy: Całkiem normalne, nie? Spróbuj, dotknij ich, jeśli chcesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535775
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535776
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535777
    m_Localized: 'Buddy: Czy to przez moje zęby…? Nie miej mi tego za złe, ale to poroniony powód, by kogoś zabić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535778
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535779
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535780
    m_Localized: 'Buddy: Wiesz, koleżko… Chcę wierzyć, że po śmierci coś nas czeka. Że gdzieś tam znów spotkam swojego pieska.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535781
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535782
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535783
    m_Localized: 'Buddy: Kurczę, koleżko… Wiesz, że jest ciężko, gdy odbierają ci kogoś bliskiego, nie? Nic nie poradzę, że uroniłem kilka łez.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535784
    m_Localized: 'Buddy: Więc to tak? Zastrzelisz mnie za okazywanie uczuć?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535785
    m_Localized: 'Buddy: Tylko… nie celuj mi w oczy, co? Zgoda, koleżko?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535786
    m_Localized: 'Buddy: Chciałbym ujrzeć coś pięknego, gdy przyjdzie po mnie kostucha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535787
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535788
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535789
    m_Localized: 'Buddy: Poszedłbym do lekarza z tym grzybem, tak… ale w sumie po co? Zwłaszcza teraz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535790
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535791
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535792
    m_Localized: 'Buddy: Hej, chociaż pokaż mi, jak wyszedłem. Chyba nie aż tak źle?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535793
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535794
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535795
    m_Localized: 'Buddy: Jaja sobie ze mnie robisz, koleżko?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535796
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535797
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535798
    m_Localized: 'Buddy: Raz dentysta mi powiedział, że z takimi zębami mógłbym grać w reklamach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535799
    m_Localized: 'Buddy: A wtedy… ha, ha! Wybili mi je tego samego dnia. Bo się uśmiechnąłem. Ironia losu, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535800
    m_Localized: 'Buddy: Nawet się nie wdałem w bójkę. Tylko się zaśmiałem w nieodpowiedniej chwili…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535801
    m_Localized: 'Buddy: Tymi rękoma… trzymałem mojego pieska, gdy jeszcze żyła. Głaskałem jej miękką sierść… Była naprawdę jedwabista.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535802
    m_Localized: 'Buddy: Tęsknię za nią, koleżko. Nie wiesz nawet, jak bardzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535803
    m_Localized: 'Buddy: Babcia raz mi rzekła „Patrząc się tak na mnie, mam wrażenie, jakbyś się już ze mną żegnał”.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535804
    m_Localized: 'Buddy: Wtedy tego nie rozumiałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535805
    m_Localized: 'Buddy: Teraz… przyznaję jej rację. Szkoda, że nie mogę jej o tym powiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535806
    m_Localized: 'Buddy: W ostatnią noc… siedziałem przy niej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535807
    m_Localized: 'Buddy: Pomyślałem, że mógłbym ją ogrzać, ułatwić odejście z tego świata… Ale zostawiła mi chyba po sobie pewną pamiątkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535808
    m_Localized: 'Buddy: Czy to nie zabawne? Ona odeszła… a mam jej cząstkę przy sobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535809
    m_Localized: 'Buddy: Lubiłem robić zdjęcia swojemu psu. Uwielbiałem ją. Chwaliłem się nią i pokazywałem innym.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535810
    m_Localized: 'Buddy: Ale robienie sobie zdjęć? Raczej nie. Zwłaszcza zdjęcia szkolne, do których wszyscy się stroili. To nie dla mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535811
    m_Localized: 'Buddy: Pewnego razu blisko wybuchły petardy. Mój piesek trząsł się jak osika… i starał się we mnie wtulić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535812
    m_Localized: 'Buddy: Wziąłem ją na ręce, by ją uspokoić… biedaczysko.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535813
    m_Localized: 'Buddy: I naszła mnie wtedy myśl… „Żeby mnie też ktoś tak przytulił. Abym w chwili strachu wiedział, że ktoś jest przy mnie”.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535814
    m_Localized: 'Buddy: A więc… tak to jest…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535815
    m_Localized: 'Buddy: Co, koleżko…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535816
    m_Localized: 'Fatman: Doprawdy? Mnie? Ministrowi? Phi… No dalej, przypatruj się…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535817
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535818
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535819
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535820
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535821
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535822
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535823
    m_Localized: 'Fatman: I co dalej? Będę miał się dla ciebie wypiąć? Toż to jakiś żart, żeby marnować ministrowi czas takimi niedorzecznościami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535824
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535825
    m_Localized: 'Fatman: Uparciuch z ciebie, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535826
    m_Localized: 'Fatman: Phi. No dobra, zgadzam się. Patrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535827
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535828
    m_Localized: 'Fatman: I jak? Podobają się? Phi… niech no ci coś powiem. Palenie nie tylko koi nerwy, ale sprawdza też charakter.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535829
    m_Localized: 'Fatman: Niektórzy kaszlą przy pierwszym buchu. A ja? Palę całe życie. Tak, dokładnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535830
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535831
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535832
    m_Localized: 'Fatman: Dobrze się przypatrz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535833
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535834
    m_Localized: 'Fatman: Podziwiaj te relikty pozostałe po lepszych czasach. W tych rękach był kieliszek, cygaro i, ekhm, cały naród. A teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535835
    m_Localized: 'Fatman: Teraz z ledwością trzymają się nawzajem. A i w tym często zawodzą, powiadam ci!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535836
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535837
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535838
    m_Localized: 'Fatman: Tak, tak, chwileczkę…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535839
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535840
    m_Localized: 'Fatman: No i? Co tam widzisz? Myślałeś, żem pijany? Zapomnij!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535841
    m_Localized: 'Fatman: No i? Co tam widzisz? Myślałeś, żem pijany? Zapomnij! Życie bez picia…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535842
    m_Localized: 'Fatman: …ech, pieprzyć to. Zadowolony, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535843
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535844
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535845
    m_Localized: 'Fatman: Phi. Co za pajacowaty, przestarzały test.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535846
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535847
    m_Localized: 'Fatman: Nie posikaj się, przeżyję.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535848
    m_Localized: 'Fatman: Ha. Ktoś mi kiedyś powiedział, że włosy pod pachami to oznaka, ekhm, siły.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535849
    m_Localized: 'Fatman: Oznacza to, że musiałbym mieć mocy za trzech. Tylko gdzie się ona podziała, gdy jej potrzebowałem? Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535850
    m_Localized: 'Fatman: Ech, do licha, jak się wszystko zmienia…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535851
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535852
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535853
    m_Localized: 'Fatman: Zgoda. Tylko pomóż mi się podnieść… Jak za starych czasów…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535854
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535855
    m_Localized: 'Fatman: No dobra! Jak wyszedłem? Wciąż ten sam, stary ja? Ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535856
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535857
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535858
    m_Localized: 'Fatman: Nic tam nie ma do oglądania…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535859
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535860
    m_Localized: 'Fatman: Oto i one, uszy ministra. Słyszały wszystko. Szepty… ekhm, krzyki…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535861
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535862
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535863
    m_Localized: 'Fatman: No, no, no. Dawaj, strzelaj. Zobaczymy, czy będziesz mógł z tym żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535864
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535865
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535866
    m_Localized: 'Fatman: Cały ten cholerny stres… Przez niego rozwaliłem wszystkie papierosy. Potem nie miałem już chęci, by czyścić paznokcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535867
    m_Localized: 'Fatman: Co, czy to teraz zbrodnia w twoim domu? Hm? No?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535868
    m_Localized: 'Fatman: Sądząc po moich rękach już od dawna powinienem być martwy. Nie krępuj się… uśmierć mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535869
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535870
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535871
    m_Localized: 'Fatman: No, dalej. Phi…! Zwisa mi to i powiewa, w jaki sposób skończy się ten koszmar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535872
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535873
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535874
    m_Localized: 'Fatman: Phi… Pachy, wielka mi rzecz! W tych czasach wszyscy mają z czymś problemy, powiadam ci!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535875
    m_Localized: 'Fatman: Śmiało, pociągnij za spust. To nie ma najmniejszego znaczenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535876
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535877
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535878
    m_Localized: 'Fatman: Jeśli skazujesz mnie na podstawie tego zdjęcia, w porządku. Ja także ważyłem ludzkie losy w moich rękach. Lepiej załatwiać to szybko.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535879
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535880
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535881
    m_Localized: 'Fatman: Co ty, jakiś kawalarz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535882
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535883
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535884
    m_Localized: 'Fatman: Dentysta kiedyś rzekł mi „Rzuć palenie, albo stracisz zęby”. A ja do niego „Czy ty wiesz, kim ja jestem?!”.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535885
    m_Localized: 'Fatman: Lecz teraz spoglądam w lustro i myślę… może cały ten stres nie był tego wart. Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535886
    m_Localized: 'Fatman: Kiedyś mogłem jednym podpisem zadecydować o czyimś losie! Chciałbym, żeby ktoś tak zawyrokował o mnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535887
    m_Localized: 'Fatman: Czy to jakiś okrutny żart? Najpierw się gapi, a potem wyciąga spluwę. Co za debilizm! Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535888
    m_Localized: 'Fatman: Moje oczy zwykły być bystre… żywe. Teraz… są niewyraźne. Osiadł na nich kurz życia, którego nie można usunąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535889
    m_Localized: 'Fatman: Nie wyobrażasz sobie, ile się napociłem! I nigdy nie miałem chwili, by pójść z tym do lekarza. Nigdy, powiadam ci!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535890
    m_Localized: 'Fatman: Nie ogarniesz rozumem, z jakim świństwem musiałem się zmagać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535891
    m_Localized: 'Fatman: Za młodu znałem gościa z podobnym… ekhm, „darem” pod pachami. Porównywał to do włosów Samsona.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535892
    m_Localized: 'Fatman: Wtedy napadł na niego wściekły tłum. I czy włosy go uratowały? Nie, ani trochę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535893
    m_Localized: 'Fatman: Wiesz… kilka razy ludzie próbowali mnie, ekhm, „wymazać”.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535894
    m_Localized: 'Fatman: Palili moje zdjęcia, niszczyli dokumenty, nawet zorganizowali zamach. I co im z tego przyszło? Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535895
    m_Localized: 'Fatman: Wciąż pozostaje po tobie ślad… Ludzie dobrze pamiętają tych, którzy decydują o ich losach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535896
    m_Localized: 'Fatman: Czasami… pragnie się wyłącznie ciszy. Ale ta nigdy nie nadchodzi. Nawet jeśli wszyscy milczą… Głowa wciąż huczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535897
    m_Localized: 'Fatman: W piekle gorzej nie będzie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535898
    m_Localized: 'Fatman: …niż tutaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535899
    m_Localized: 'Blind: Sprawdzaj, ile dusza zapragnie, ale… jedyne co niezmienne, to to, że wszystko się zmienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535900
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535901
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535902
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535903
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535904
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535905
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535906
    m_Localized: 'Blind: One są ostatnimi świadkami…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535907
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535908
    m_Localized: 'Blind: Przeżułem prawdę, dławiłem się nią, aż zapchała mi gardło.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535909
    m_Localized: 'Blind: Zacisnąłem pięści, knykcie mi pobielały, gdy moje spojrzenie przebiegło po… TYM.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535910
    m_Localized: 'Blind: Teraz moje dłonie chwytają pustkę, czekając na czuły uścisk śmierci, który wymaże te obrazy z mojej głowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535911
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535912
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535913
    m_Localized: 'Blind: Czy się ruszają?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535914
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535915
    m_Localized: 'Blind: Dobrze… TO… nie odebrało mi jeszcze wszystkiego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535916
    m_Localized: 'Blind: Ale… ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535917
    m_Localized: 'Blind: Pożerałem, wrzeszczałem, rzygałem, rozrywałem się kawałek po kawałku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535918
    m_Localized: 'Blind: Czaszka rozwalona. Mózg na ścianie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535919
    m_Localized: 'Blind: Ściany, drzwi, okna, a… TO… tam było.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535920
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535921
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535922
    m_Localized: 'Blind: Ha, ha, ha, ha… tu niczego nie znajdziesz!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535923
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535924
    m_Localized: 'Blind: TO… uwielbia być obserwowane. Żadne słowa… TEGO… nie opiszą, gdyż taka groza przekracza hart ludzkiego umysłu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535925
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535926
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535927
    m_Localized: 'Blind: Zabawne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535928
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535929
    m_Localized: 'Blind: Wiesz, na co najpierw pada schorzały cień?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535930
    m_Localized: 'Blind: Nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535931
    m_Localized: 'Blind: Ja już wiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535932
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535933
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535934
    m_Localized: 'Blind: Śmiało, użyj lampy błyskowej. Nie robi mi to różnicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535935
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535936
    m_Localized: 'Blind: I nawet mi nie pokażesz, jak wyszedłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535937
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535938
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535939
    m_Localized: 'Blind: Słyszałeś to?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535940
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535941
    m_Localized: 'Blind: Cicho…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535942
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535943
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535944
    m_Localized: 'Blind: Przed… TYM… broń cię nie ochroni. Nie wiem, czy jakikolwiek oręż byłby skuteczny.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535945
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535946
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535947
    m_Localized: 'Blind: W snach mogę niemal dotknąć… TEGO… Wyczuć kształt, masę… a potem… TO… znika, pozostawiając tylko trwogę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535948
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535949
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535950
    m_Localized: 'Blind: Oczy pragną na… TO… spojrzeć. Nie sposób odwrócić wzrok… póki się go nie pozbawisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535951
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535952
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535953
    m_Localized: 'Blind: Całe moje ciało ogarniają ciarki. Skóra domaga się obdarcia… to prawdziwa udręka.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535954
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535955
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535956
    m_Localized: 'Blind: Zwykłem lubić zdjęcia, przyglądać się ich każdemu szczegółowi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535957
    m_Localized: 'Blind: A teraz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535958
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535959
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535960
    m_Localized: 'Blind: Jeśli raptem słyszałeś, jak… TO… się przemieszcza…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535961
    m_Localized: 'Blind: Jak… TEGO… kroki splatają się z twoimi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535962
    m_Localized: 'Blind: Jak powietrze dygocze, gdy… TO… wciąga twoją woń…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535963
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535964
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535965
    m_Localized: 'Blind: Słyszałeś kiedyś, jak stworzenie przeżuwa… lecz nie posila się?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535966
    m_Localized: 'Blind: Delektując się twoim aromatem, głosem, drżeniem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535967
    m_Localized: 'Blind: TO… właśnie tak robi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535968
    m_Localized: 'Blind: Czeka… abym także zaczął przeżuwać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535969
    m_Localized: 'Blind: A dalej… ból. Budzę się zlany potem. Usta pochwycone w dłoniach, jakbym starał się stłumić krzyk.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535970
    m_Localized: 'Blind: TO… nie obawia się spojrzenia, lecz pragnie go.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535971
    m_Localized: 'Blind: TO… rozchodzi się po źrenicach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535972
    m_Localized: 'Blind: TO… wstrząsa się pod powiekami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535973
    m_Localized: 'Blind: TO…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535974
    m_Localized: 'Blind: Wybacz… Nagle poczułem się bardzo niedobrze…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535975
    m_Localized: 'Blind: Kiedy… TO… pełznie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535976
    m_Localized: 'Blind: Kiedy… TO… wślizguje się na ciało, wnika w kości…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535977
    m_Localized: 'Blind: W chwili, gdy… TO… cię dotknie, wnika pod skórę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535978
    m_Localized: 'Blind: I wtedy… twoja skóra nie jest już twoją skórą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535979
    m_Localized: 'Blind: A ty… należysz do czegoś innego…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535980
    m_Localized: 'Blind: Prawdziwa agonia…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535981
    m_Localized: 'Blind: Jeśli… TO… kiedyś się do ciebie zbliży…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535982
    m_Localized: 'Blind: Pod żadnym pozorem nie utrwalaj… TEGO… wizerunku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535983
    m_Localized: 'Blind: Pożywi się tym… pomnoży swoją moc nad śmiertelnikami!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535984
    m_Localized: 'Blind: Słyszałem… TO.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535985
    m_Localized: 'Blind: Nie kiedy… TO… zobaczyłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535986
    m_Localized: 'Blind: Wcześniej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535987
    m_Localized: 'Blind: Zanim… TO… nadeszło.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535988
    m_Localized: 'Blind: Cichutki szelest… jakby ktoś podążał dziesięć kroków za tobą…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535989
    m_Localized: 'Blind: Później pięć…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535990
    m_Localized: 'Blind: Wtedy oglądasz się za siebie… i…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535991
    m_Localized: 'Blind: Wybacz. Lepiej o tym nie mówić. Nie chcę cię tym obciążać, zaufaj mi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535992
    m_Localized: 'Blind: TONADCHODZITONADCHODZITONADCHODZITONADCHODZI!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535993
    m_Localized: 'Blind: TO… nadchodzi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535994
    m_Localized: 'Dude: Wporzo, ziom, na luzie. Sprawdzaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535995
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535996
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535997
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535998
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535999
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536000
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536001
    m_Localized: 'Dude: Ha, ha, ha, no pewnie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536002
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536003
    m_Localized: 'Dude: Wyglądają, jakbym dorastał, przeżuwając kukurydzę, a nie płatki kukurydziane, co nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536004
    m_Localized: 'Dude: Ale ziom, te zęby są twarde jak skały.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536005
    m_Localized: 'Dude: Stary, raz otworzyłem nimi browca. Wariactwo… niemal odgryzłem sobie przy tym język, ale strumień bronków musiał płynąć, ziom!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536006
    m_Localized: 'Dude: No weź, ziom… Wiesz, lubię się zbakać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536007
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536008
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536009
    m_Localized: 'Dude: Ziom, wykopywałem z ziemi skrytkę geocache. Że brudne? Nie sraj żarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536010
    m_Localized: 'Dude: O kurde!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536011
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536012
    m_Localized: 'Dude: Raz byłem tak zjarany i gapiłem się na swoje palce… Ziom, oświeciło mnie, że to moje palce.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536013
    m_Localized: 'Dude: Poruszałem nimi, patrzyłem, jak się zginają… Stary, niezła jazda.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536014
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536015
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536016
    m_Localized: 'Dude: Nie trzymam ich otwartych na zbyt długo. Patrzenie na świat to za duży stres, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536017
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536018
    m_Localized: 'Dude: Moje źrenice? Olej to. Nie skumasz, ile razy mi się za to obrywało w sklepie. Lipa, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536019
    m_Localized: 'Dude: Przekrwione? Olej to, stary. Nie skumasz, ile razy mi się za to obrywało. Straszna lipa, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536020
    m_Localized: 'Dude: Joł, muszę ci kiedyś o tym opowiedzieć pewną historię, normalnie ocipiejesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536021
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536022
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536023
    m_Localized: 'Dude: Sekundeczka, ziomuś… najpierw striptease.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536024
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536025
    m_Localized: 'Dude: Swędzą jak psia dupa, ziom. To ponoć przez to, że nie piorę ubrań… W życiu kieruję się zewem natury!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536026
    m_Localized: 'Dude: Gładkie jak pupcia niemowlęcia… no, prawie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536027
    m_Localized: 'Dude: Ziom, pomyśl… Po cholerę są tam te paskudne włochale?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536028
    m_Localized: 'Dude: Epoka kamienia skończyła się jakoś ponad rok temu, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536029
    m_Localized: 'Dude: Robale nas już nie wpierniczają, zimno nam bez nich nie jest. Kompletnie nie czaję bazy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536030
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536031
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536032
    m_Localized: 'Dude: Się wie, ziom!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536033
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536034
    m_Localized: 'Dude: I jak wygląda moja aura? Jest jasna? W dechę!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536035
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536036
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536037
    m_Localized: 'Dude: Yhym.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536038
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536039
    m_Localized: 'Dude: Czemu są takie rozciągnięte? Staaary… Kiedyś miałem zajebiste kolczyki plugi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536040
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536041
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536042
    m_Localized: 'Dude: Dżizas! Luzuj rajtuzy, ziom! Skręćmy maczugę i pogadajmy!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536043
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536044
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536045
    m_Localized: 'Dude: Ja cię kręcę, jesteś hardkorem. Zaraz, czy ty uważasz, że giwera jest teraz twoim przedłużeniem? Ale motyw, ziom!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536046
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536047
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536048
    m_Localized: 'Dude: No weź, stary, nie jest aż tak źle. A historia jest pierwsza klasa!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536049
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536050
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536051
    m_Localized: 'Dude: Ziomisław, cziluj! Może tak ma być! Natura opanowuje ciało!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536052
    m_Localized: 'Dude: Cziluj! Wporzo, jeśli masz tam leśne runo. Żyj, jak chcesz! Dogadajmy się, ziom!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536053
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536054
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536055
    m_Localized: 'Dude: Ziom, zapodałeś ostrego tripa. Przyznaję też, że nieco zmechaciłeś mój vibe, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536056
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536057
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536058
    m_Localized: 'Dude: Chcesz posłuchać, co zaszło?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536059
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536060
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536061
    m_Localized: 'Dude: Stary, o zębach myślałem tyle, co o dupie Maryni. No pewnie, mam i dupę i zęby.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536062
    m_Localized: 'Dude: A potem ziomale mi mówią, że zęby to kości, stary!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536063
    m_Localized: 'Dude: A ja „Że cooo?!”. Z gęby wystają kości! Upiorne jak diabli, co? Kijem ich nie dotknę!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536064
    m_Localized: 'Dude: Stary, palce to jakiś kosmos…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536065
    m_Localized: 'Dude: Nieustannie ich używamy, ale nie myślimy nad tym, czym są, nie? Raz się ujarałem i, stary…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536066
    m_Localized: 'Dude: Od tamtej pory… mam z nimi niezłą jazdę, ziom!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536067
    m_Localized: 'Dude: Siedziałem i lampiłem się w moje dłonie, myśląc… A jeśli nie należą do mnie? Zły trip, ziom. Naprawdę zły.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536068
    m_Localized: 'Dude: Duże źrenice są urocze, ziom. Jak w tej bajce… z kotem w butach i zielonym trollem z bagna.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536069
    m_Localized: 'Dude: Laski też na pewno na to lecą, ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536070
    m_Localized: 'Dude: Wyobraź sobie… idę ulicą zbakany w trzy dupy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536071
    m_Localized: 'Dude: Myślę, że gdy zhaltują mnie szkieły, zapytają się, czy jestem napruty. A ja im wtedy, że nie, że zawsze tak mam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536072
    m_Localized: 'Dude: I wiesz co? Zhaltowali mnie na serio. „Skąd te przekrwione oczy? Coś panu dolega?”, a ja na to „Nie, srogo się zjarałem”.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536073
    m_Localized: 'Dude: Stary, sam spróbowałbyś tak połazić. Też by cię zaczęło swędzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536074
    m_Localized: 'Dude: No bo czy ktoś kiedyś powiedział „kurde, stary, uwielbiam swój owłosiony jak u goryla rów”.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536075
    m_Localized: 'Dude: Pachy, dupa… wszędzie to przeszkadza.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536076
    m_Localized: 'Dude: Stary, nie wiem nawet, po co nam one… Wszyscy mamy ciuchy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536077
    m_Localized: 'Dude: Ziom… czasem czuję swoją aurę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536078
    m_Localized: 'Dude: Jakby wokół mnie roztaczało się coś niewidocznego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536079
    m_Localized: 'Dude: A kiedy jestem na potęgę zbakany… uhm, znaczy się, zmęczony, wtedy jest niezwykła jazda.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536080
    m_Localized: 'Dude: Zazwyczaj jednak jest czill. Można vibe’ować.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536081
    m_Localized: 'Dude: Stary, miałem kiedyś zajefajny kolczyk plug. Wyglądał jak wielkie oko ze świrowatą źrenicą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536082
    m_Localized: 'Dude: Tracąc go, utraciłem też jakby część siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536083
    m_Localized: 'Dude: Wszyscy widzą dziurę w małżowinie, dla mnie zieje tam pustka…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536084
    m_Localized: 'Dude: Kurde, staaary… Myślałem, że razem vibe’ujemy…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536085
    m_Localized: 'Dude: Ziom…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536086
    m_Localized: 'Teacher: Niech pan robi, co jest konieczne. Niczego nie ukrywam, a utraciłam już wszystko…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536087
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536088
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536089
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536090
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536091
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536092
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536093
    m_Localized: 'Teacher: Widzi pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536094
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536095
    m_Localized: 'Teacher: Białe… prawie jak z obrazka, oprócz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536096
    m_Localized: 'Teacher: …tego, gdzie mnie uderzyli… Przywiązali do słupa i kazali patrzeć…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536097
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536098
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536099
    m_Localized: 'Teacher: Proszę…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536100
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536101
    m_Localized: 'Teacher: Próbowałam… otworzyć drzwi, wybić okna. Lecz ogień… rozprzestrzeniał się tak szybko…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536102
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536103
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536104
    m_Localized: 'Teacher: Proszę popatrzeć…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536105
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536106
    m_Localized: 'Teacher: Widziałam… całe zdarzenie. Dzieciaczki zbite w grupkę, zbliżające się do nich płomienie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536107
    m_Localized: 'Teacher: Szukające mnie wzrokiem, pełne nadziei, że je uratuję… to było nie do zniesienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536108
    m_Localized: 'Teacher: Nawet teraz obawiam się zamknąć oczy. Znów ujrzałabym ich twarzyczki… bezradne, poparzone, wykrzywione bólem…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536109
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536110
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536111
    m_Localized: 'Teacher: Czy… to naprawdę konieczne? Te niezrozumiałe objawy…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536112
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536113
    m_Localized: 'Teacher: To z przyzwyczajenia. Opiekując się dziećmi, przywiązuje się wagę do higieny.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536114
    m_Localized: 'Teacher: Uczyłam je myć buzię, zęby… teraz nie mam już kogo uczyć…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536115
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536116
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536117
    m_Localized: 'Teacher: Zgoda, jeśli pan musi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536118
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536119
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536120
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536121
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536122
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536123
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536124
    m_Localized: 'Teacher: Zwykłam nosić kolczyki… niewielkie z drobnymi klejnotkami. Dzieci mówiły, że mieniły się jak gwiazdy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536125
    m_Localized: 'Teacher: Ale zawsze bolały mnie od nich uszy, więc przestałam je nosić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536126
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536127
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536128
    m_Localized: 'Teacher: Chce pan dobić to, co ze mnie zostało? Po tym, jak się sprawy mają, wcale mnie to nie dziwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536129
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536130
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536131
    m_Localized: 'Teacher: Proszę się nie krępować… te ręce już nie są w stanie pomóc nikomu innemu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536132
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536133
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536134
    m_Localized: 'Teacher: Gdyby widział pan to, co ja… strzeliłby pan bez mrugnięcia okiem. Gdyby miał pan w sobie choć krztynę miłosierdzia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536135
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536136
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536137
    m_Localized: 'Teacher: Niech pan strzela…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536138
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536139
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536140
    m_Localized: 'Teacher: Niech pan to zrobi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536141
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536142
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536143
    m_Localized: 'Teacher: Uważa pan, że śrutem można ukrócić cierpienie? Boże, oby…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536144
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536145
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536146
    m_Localized: 'Teacher: Ucząc dzieci mycia zębów, mówiłam im, że od zdrowego uśmiechu świat zaraz robi się piękniejszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536147
    m_Localized: 'Teacher: Śmiały się, pokazywały swoje szczerbate uśmieszki… A teraz… to wszystko zdaje się…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536148
    m_Localized: 'Teacher: Proszę mi wybaczyć…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536149
    m_Localized: 'Teacher: Tymi dłońmi zaplatałam warkoczyki, opatrywałam zadrapane kolana, pokazywałam malutkim paluszkom, jak wiązać buty…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536150
    m_Localized: 'Teacher: A teraz… to wszystko zdaje się takie bezsensowne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536151
    m_Localized: 'Teacher: Po co próbować, gdy ktoś silniejszy i okrutniejszy zawsze zdecyduje o losie innych…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536152
    m_Localized: 'Teacher: A jeśli wyważyłabym drzwi…? Znalazła inne wejście? Ostatnio, gdy zamykam oczy, widzę tylko płomienie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536153
    m_Localized: 'Teacher: Mówiłam dzieciom, żeby się myły, bo inaczej zachorują. Ale to nie bakterie im zagrażały, lecz… inni ludzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536154
    m_Localized: 'Teacher: Starałam się zachować w pamięci ich twarzyczki, głosy, śmiech…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536155
    m_Localized: 'Teacher: Jednakże z upływem czasu wspomnienia bledną.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536156
    m_Localized: 'Teacher: Te szczęśliwe chwile jedna za drugą wypierane są przez twarze pełne grymasu, okrzyki bólu, strachu i zagubienia…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536157
    m_Localized: 'Teacher: Czasem dotykam uszu i przypominam sobie, jak bardzo moje kolczyki podobały się jednej z dziewczynek…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536158
    m_Localized: 'Teacher: Mówiła nawet, że chce takie same, kiedy dorośnie. Ale teraz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536159
    m_Localized: 'Teacher: Ona nigdy…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536160
    m_Localized: 'Teacher: Nareszcie… się to skończy…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536161
    m_Localized: 'Teacher: Proszę… o przebaczenie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536162
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729856
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729857
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729858
    m_Localized: 'Wheelchair: No dobra. Słucham? Tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729859
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729860
    m_Localized: 'Wheelchair: Jeśli nie możesz polegać na tym objawie… to jak ja mam niby to zrobić?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729861
    m_Localized: 'Wheelchair: Kto wie? Może wszystkie są atrybutami Przybyszy, a może żaden!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729862
    m_Localized: 'Wheelchair: W końcu błądzić jest rzeczą ludzką.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729863
    m_Localized: 'Wheelchair: Błędy mogą jednak pociągać za sobą całkiem okropne konsekwencje.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729864
    m_Localized: 'Ballerina: Ty testować ja? Ha, tak. Udowodnienie… czegoś.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729865
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729866
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729867
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729868
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729869
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729870
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729871
    m_Localized: 'Ballerina: Zęby?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729872
    m_Localized: 'Ballerina: Przeżuwasz, co zostać w sumieniu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729873
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729874
    m_Localized: 'Ballerina: Zeżryj calusieńko. Weźmie gryz ze smakowity sumienie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729875
    m_Localized: 'Ballerina: …czym są sumienie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729876
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729877
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729878
    m_Localized: 'Ballerina: Co z to?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729879
    m_Localized: 'Ballerina: Ja taniec. Po co przeszkadzanie i gapienie w ręce tańca?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729880
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729881
    m_Localized: 'Ballerina: Kotek…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729882
    m_Localized: 'Ballerina: On nalegać, że kotek ma dychać. Kotek dużo szczęście…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729883
    m_Localized: 'Ballerina: On robi dużo ból w ręka… i w dupa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729884
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729885
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729886
    m_Localized: 'Ballerina: Aaach, teraz najbardzo interesujące.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729887
    m_Localized: 'Ballerina: Na źrenice mam coś napisanych. Widzi…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729888
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729889
    m_Localized: 'Ballerina: Tragedia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729890
    m_Localized: 'Ballerina: Żyje sam, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729891
    m_Localized: 'Ballerina: I co? Jak się uczucie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729892
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729893
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729894
    m_Localized: 'Ballerina: HA, HA, HA, HA! Gapienie. Obwąchiwanie. Dalej co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729895
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729896
    m_Localized: 'Ballerina: Lubić to?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729897
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729898
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729899
    m_Localized: 'Ballerina: Takie to co? Nie wie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729900
    m_Localized: 'Ballerina: Pora próby.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729901
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729902
    m_Localized: 'Ballerina: Mmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729903
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729904
    m_Localized: 'Ballerina: Mnie nikt nigdy nie mówić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729905
    m_Localized: 'Ballerina: To przez piękny tańcowanie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729906
    m_Localized: 'Ballerina: Bała ja bym się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729907
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729908
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729909
    m_Localized: 'Ballerina: Ach, znak dobry.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729910
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729911
    m_Localized: 'Ballerina: No i? Mówi mi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729912
    m_Localized: 'Ballerina: Kto dobry? Kto niedobry?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729913
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729914
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729915
    m_Localized: 'Ballerina: HA, HA, HA! Pif‑paf, strzela!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729916
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729917
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729918
    m_Localized: 'Ballerina: Chce czerwona krew?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729919
    m_Localized: 'Ballerina: Mnie też.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729920
    m_Localized: 'Ballerina: Ale dla biedulki brak… jeszcze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729921
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729922
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729923
    m_Localized: 'Ballerina: Nie lubi czerwona krew?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729924
    m_Localized: 'Ballerina: Tyle jej przelewa, godziny za godzinę w każdy dzień. Ale lubić jej, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729925
    m_Localized: 'Ballerina: Tak czy nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729926
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729927
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729928
    m_Localized: 'Ballerina: Co? Przegapić okazja. Nie dam drugiego niuchnięcia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729929
    m_Localized: 'Ballerina: Wina moja nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729930
    m_Localized: 'Ballerina: Tylko duży idiota robić tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729931
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729932
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729933
    m_Localized: 'Ballerina: Zatańczyć czas?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729934
    m_Localized: 'Ballerina: Będzie niech i tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729935
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729936
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729937
    m_Localized: 'Ballerina: Jak ty decyzja podjąć?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729938
    m_Localized: 'Ballerina: Z uszy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729939
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729940
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729941
    m_Localized: 'Ballerina: Jednak nie? Chce inny objawy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729942
    m_Localized: 'Ballerina: Chce więcej?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729943
    m_Localized: 'Ballerina: W górę, w dół, góra, dół… po co to robi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729944
    m_Localized: 'Ballerina: Nie umie zdecydować?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729945
    m_Localized: 'Ballerina: Wygląda tu jak głupi! HA, HA, HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729946
    m_Localized: 'Ballerina: Pragniemy czerwona krew.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729947
    m_Localized: 'Ballerina: Pewien, żeś nie Przybysz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729948
    m_Localized: 'Ballerina: Chce prosta ścieżka do śmierć. Jak my.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729949
    m_Localized: 'Ballerina: Jest wielki głupi…!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729950
    m_Localized: 'Ballerina: Tańcowanie robi zrzędliwy? Zrzędliwe tańcowanie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729951
    m_Localized: 'Ballerina: Może słyszy inny melodia… Taki, którą śpiewamy długo bardzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729952
    m_Localized: 'Ballerina: A ty?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729953
    m_Localized: 'Ballerina: Wiesz, gdzie to wszystko pójść?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729954
    m_Localized: 'Ballerina: Klaun śmieszek, uśmiech cały dzień w kruchy dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729955
    m_Localized: 'Ballerina: Wygodnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729956
    m_Localized: 'Ballerina: Uszy. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729957
    m_Localized: 'Ballerina: Uszka. ucho, uszy, uszko, ucho. Uszka.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729958
    m_Localized: 'Ballerina: Ona to chcieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729959
    m_Localized: 'Ballerina: Nigdy nie pomyśleć, że ona lubi dużego głupiec.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729960
    m_Localized: 'Ballerina: Nigdy nie pomyśleć…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729961
    m_Localized: 'Mother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729962
    m_Localized: 'Mother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729963
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729964
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729965
    m_Localized: 'Anger: Uważaj pan, bo mi oko tym wybijesz!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729966
    m_Localized: 'Anger: Kurwa, nie chcę dostać między oczy z powodu moich pieprzonych uszu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729967
    m_Localized: 'Couple: Och, tak, naturalnie. Proszę tylko nie kłopotać mojej drogiej żony. Jest wykończona.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729968
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729969
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729970
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729971
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729972
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729973
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729974
    m_Localized: 'Couple: Aby chronić bliskich, czasem trzeba wgryźć się w życie i nie puszczać, ha, ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729975
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729976
    m_Localized: 'Couple: Sam rozumiesz, jak tam jest ciężko.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729977
    m_Localized: 'Couple: Zębów nie mam najlepszych, ale lubi się to, co się ma. W szkole mi dokuczali z ich powodu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729978
    m_Localized: 'Couple: No i gdzie teraz są te łobuzy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729979
    m_Localized: 'Couple: Pewnie leżą i gniją w jakiejś bramie, pobici na śmierć przez takie same potwory, którymi kiedyś byli.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729980
    m_Localized: Zostaw ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729981
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729982
    m_Localized: 'Couple: Kurka wodna! Z żoną staramy się utrzymywać higienę. Prawda, złotko?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729983
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729984
    m_Localized: 'Couple: Tak szczerze to nawet w takich czasach dziwnie jest się zaniedbywać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729985
    m_Localized: 'Couple: Jeśli bym zachorował, kto zaopiekowałby się moją żonką? Nikt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729986
    m_Localized: 'Couple: Może z tego powodu Przybysze są silniejsi? Nie chorują jak my.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729987
    m_Localized: 'Couple: Może z tego powodu Przybysze są… tym, czym są? Nie chorują jak my.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729988
    m_Localized: Zostaw ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729989
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729990
    m_Localized: 'Couple: Zgoda, pokaż mi swoje, a ja pokażę ci moje!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729991
    m_Localized: 'Couple: Wybacz… trochę się boję… ale kto by się nie bał? Bycie sprawdzanym jest straszne, nawet gdy niczego nie ukrywasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729992
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729993
    m_Localized: 'Couple: Dobra, bardzo się tego boję.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729994
    m_Localized: 'Couple: Ale czego się spodziewać, gdy od tego zależy nie tylko moje bezpieczeństwo, ale także mojej żony?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729995
    m_Localized: Zostaw ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729996
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729997
    m_Localized: 'Couple: O, nie, nie, nie. Tylko ja będę ci je pokazywał, gościu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729998
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729999
    m_Localized: 'Couple: Od kobiety oczekuje się, że będzie ogolona. Od facetów powinno być tak samo!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730000
    m_Localized: 'Couple: Przynajmniej to odrobinę pomaga w tym upale, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730001
    m_Localized: 'Couple: Tak między nami, facetami… Na pewno wiesz, o co mi chodzi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730002
    m_Localized: 'Couple: To od kobiety oczekuje się, że będzie ogolona. Nie od faceta.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730003
    m_Localized: 'Couple: Moim zadaniem jest zapewnić jej ochronę w świecie pełnym potworów.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730004
    m_Localized: Zostaw ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730005
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730006
    m_Localized: 'Couple: Czekaj, czy to naprawdę jeden z tych testów?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730007
    m_Localized: 'Couple: Żadnych zdjęć. Ani moich, ani jej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730008
    m_Localized: 'Couple: Ale… przez to możesz nas podejrzewać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730009
    m_Localized: 'Couple: Chwila, daj mi pomyśleć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730010
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730011
    m_Localized: 'Couple: Zgoda. Zrób to cholerne zdjęcie, ale zatrzymam je.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730012
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730013
    m_Localized: 'Couple: Dawaj mi je!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730014
    m_Localized: Zostaw ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730015
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730016
    m_Localized: 'Couple: Nie rozumiem, jaki to ma związek z Przybyszami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730017
    m_Localized: 'Couple: Ale okej, nie mam nic do ukrycia, patrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730018
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730019
    m_Localized: 'Couple: I jak? Co widzisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730020
    m_Localized: 'Couple: Złotko, słyszałaś kiedyś, żeby uszy były objawem Przybyszy? Ależ z ciebie milczek!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730021
    m_Localized: 'Couple: Och, serio? Hm. Rozumiem… okej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730022
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730023
    m_Localized: 'Couple: Ciekawe. Jakie są wyniki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730024
    m_Localized: Zostaw ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730025
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730026
    m_Localized: 'Couple: Proszę, moja żona nie poradzi sobie beze mnie. Odłóż broń.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730027
    m_Localized: Zastrzel ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730028
    m_Localized: Wysłuchaj ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730029
    m_Localized: 'Couple: I co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730030
    m_Localized: 'Couple: To mi nie pomoże.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730031
    m_Localized: 'Couple: Ani tobie. Po co wtedy wyjmować broń?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730032
    m_Localized: 'Couple: Ani tobie, druhu. Po co wtedy wyjmować broń?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730033
    m_Localized: Zastrzel ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730034
    m_Localized: Wysłuchaj ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730035
    m_Localized: 'Couple: Popełniasz błąd. Jeśli nie możesz jej sprawdzić, po co od razu porywać się za broń?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730036
    m_Localized: 'Couple: Przysięgam, że ona jest człowiekiem. Prawda, złotko?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730037
    m_Localized: 'Couple: Możemy odejść natychmiast, jesteśmy spakowani. To, że ona ociąga się jak mucha w smole, nie czyni nas Przybyszami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730038
    m_Localized: Zastrzel ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730039
    m_Localized: Wysłuchaj ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730040
    m_Localized: 'Couple: Nie mogę uwierzyć, że sprzymierzyłbyś się z tymi monstrami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730041
    m_Localized: 'Couple: Czy naprawdę nas zastrzelisz z powodu włosów pod pachami?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730042
    m_Localized: Zastrzel ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730043
    m_Localized: Wysłuchaj ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730044
    m_Localized: 'Couple: Słuchaj, zgodziłem się na zrobienie zdjęcia. Czy to nic dla ciebie nie znaczy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730045
    m_Localized: 'Couple: Najwyraźniej nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730046
    m_Localized: Zastrzel ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730047
    m_Localized: Wysłuchaj ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730048
    m_Localized: 'Couple: Rozumiem, że paznokcie mogą być problemem. W końcu Przybysze wygrzebują się spod ziemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730049
    m_Localized: 'Couple: Oczy? Owszem. Pachy? Może. Ale uszy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730050
    m_Localized: 'Couple: Oczy? Owszem. Pachy? Może. Ale uszy? Co, bo są blisko mózgu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730051
    m_Localized: Zastrzel ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730052
    m_Localized: Wysłuchaj ich
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730053
    m_Localized: 'Couple: Mam nadzieję, że nie zalazłem ci pod skórę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730054
    m_Localized: 'Couple: Wiem, jak ciężko utrzymuje się porządek w tych czasach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730055
    m_Localized: 'Couple: Psiakość, ledwo sobie radzę ze swoją drugą połówką. Ha, ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730056
    m_Localized: 'Couple: Może niełatwo ci to zrozumieć. Nie będę o tym gadał.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730057
    m_Localized: 'Couple: Nastały trudne czasy. Ludzie nie wytrzymują ze stresu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730058
    m_Localized: 'Couple: Trzeba się za coś wziąć, robić coś własnoręcznie… inaczej długo się nie pociągnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730059
    m_Localized: 'Couple: Zawsze aż drżę, gdy wyobrażam sobie, że coś mogłoby się stać mojej żonie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730060
    m_Localized: 'Couple: Najbardziej obawiam się chwili, w której siły mnie opuszczą i nie będę mógł jej chronić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730061
    m_Localized: 'Couple: Jedyne, co mi pozostało, to zachować formę. Mieć pewność, że mogę przyjebać w pysk.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730062
    m_Localized: 'Couple: Złotko, drgnęłaś? Nie bój się. Wciąż jesteśmy razem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730063
    m_Localized: 'Couple: Mamy swoje zadania. Ja ją ochraniam i zapewniam szansę na powrót do rodziców.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730064
    m_Localized: 'Couple: A ona… daje mi to, o co poproszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730065
    m_Localized: 'Couple: Uczciwa współpraca, prawda? Nie wymagam chyba zbyt wiele, by dbała o swój wygląd.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730066
    m_Localized: 'Couple: Z doświadczenia wiem, by nie zdradzać, kim jesteśmy ani dokąd zmierzamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730067
    m_Localized: 'Couple: Im mniej się wie, tym lepiej. Oto moje motto.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730068
    m_Localized: 'Couple: Staramy się jedynie bezpiecznie wrócić do domu. Bez gwałtownych ruchów i bez niespodzianek.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730069
    m_Localized: 'Couple: Racja, złotko?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730070
    m_Localized: 'Couple: Wiesz co, powiedziałem już wystarczająco wiele. Wracamy do pakowania się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730071
    m_Localized: 'Couple: Tylko spokojnie, chojraku…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730072
    m_Localized: 'Couple: Nie zastrzelisz przecież biednej, bezbronnej kobiety…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730073
    m_Localized: 'Couple: Prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730074
    m_Localized: 'BigLebowski: No dobra, ale nie ociągaj się, dziadu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730075
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730076
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730077
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730078
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730079
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730080
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730081
    m_Localized: 'BigLebowski: Dziwne pytanie. A spróbuj tylko coś cwaniakować, a jebnę ci w ryło. Powaga.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730082
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730083
    m_Localized: 'BigLebowski: Rodzice dbali o moje zęby bardziej niż o mnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730084
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730085
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730086
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730087
    m_Localized: 'BigLebowski: Hm…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730088
    m_Localized: 'BigLebowski: Wszystko jedno. Tylko nie panikuj, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730089
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730090
    m_Localized: 'BigLebowski: To reakcja alergiczna. Mam swędzące wysypki. Straszne cholerstwo. Mam to od dziecka.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730091
    m_Localized: 'BigLebowski: Patrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730092
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730093
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730094
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730095
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730096
    m_Localized: 'BigLebowski: Łapy trzymaj przy sobie. Jeden fałszywy ruch i stracisz oko.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730097
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730098
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730099
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730100
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730101
    m_Localized: 'BigLebowski: Nie. To jakaś chora zagrywka. Zapomnij.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730102
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730103
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730104
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730105
    m_Localized: 'BigLebowski: Jeśli zamierzasz wysłać to zdjęcie, by pomóc moim rodzicom mnie odnaleźć, jeb się na ryj.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730106
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730107
    m_Localized: 'BigLebowski: No? Pokaż mi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730108
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730109
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730110
    m_Localized: 'BigLebowski: O raju. Nieważne. Mam to gdzieś.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730111
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730112
    m_Localized: 'BigLebowski: I jak? Wystarczająco czyste dla ciebie? Zdałam twój głupi test?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730113
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730114
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730115
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730116
    m_Localized: 'BigLebowski: Wiesz co? Jebię w to! Zastrzel mnie! Mam tego po dziurki w nosie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730117
    m_Localized: 'BigLebowski: NO DALEJ! STRZELAJ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730118
    m_Localized: 'BigLebowski: POCIĄGNIJ ZA SPUST!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730119
    m_Localized: 'BigLebowski: COŚ NIE TAK? NIE MASZ JAJ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730120
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730121
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730122
    m_Localized: 'BigLebowski: Wiesz co, staruchu? Gówno mnie już to wszystko obchodzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730123
    m_Localized: 'BigLebowski: Zdecyduj się w końcu na coś. Albo mnie zastrzel, albo skończ pierdolić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730124
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730125
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730126
    m_Localized: 'BigLebowski: No i? Oczy mam w porządku. O co ci chodzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730127
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730128
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730129
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730130
    m_Localized: 'BigLebowski: Odjebało ci? Uhhh! Czy ty sam się słyszysz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730131
    m_Localized: 'BigLebowski: Wiesz co? Jebię w to! Zastrzel mnie! Mam tego po dziurki w nosie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730132
    m_Localized: 'BigLebowski: NO DALEJ! STRZELAJ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730133
    m_Localized: 'BigLebowski: POCIĄGNIJ ZA SPUST!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730134
    m_Localized: 'BigLebowski: COŚ NIE TAK? NIE MASZ JAJ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730135
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730136
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730137
    m_Localized: 'BigLebowski: No i jak?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730138
    m_Localized: 'BigLebowski: Oooch, jaki kozak! Jaka giwera! Patrzcie na niego!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730139
    m_Localized: 'BigLebowski: Szczerze to wisi mi to. Mam to gdzieś.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730140
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730141
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730142
    m_Localized: 'BigLebowski: Okej, no i co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730143
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730144
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730145
    m_Localized: 'BigLebowski: Następnym razem po prostu mnie zastrzel. Nie będę błagać o życie. Mam to w dupie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730146
    m_Localized: Uhhh… Tego już zaaa wieleee…
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730147
    m_Localized: 'BigLebowski: Mama zawsze mi suszyła głowę o moich dłoniach. Bla, bla, bla… „Damie tak nie wypada”.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730148
    m_Localized: 'BigLebowski: Tak? I co mam niby zrobić z tą wysypką? To alergia, mamo! Rajuśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730149
    m_Localized: 'BigLebowski: Nieważne. Wisi mi to…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730150
    m_Localized: 'BigLebowski: Bo wiesz, co jest w życiu najważniejsze?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730151
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730152
    m_Localized: 'BigLebowski: Znaleźć męża i wypchać z siebie dzieciaka!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730153
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730154
    m_Localized: 'BigLebowski: Miodzio plan, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730155
    m_Localized: 'BigLebowski: Dzięki, ale nie skorzystam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730156
    m_Localized: 'BigLebowski: Miałam w klasie dziewczyny, które zarzekały się, że kolor oczu im się zmienia wraz z samopoczuciem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730157
    m_Localized: 'BigLebowski: Błagam. Kogo obchodzą ich świńskie, małe oczka?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730158
    m_Localized: 'BigLebowski: Dopóki przez nie widzą, mogą być nawet, kurde, tęczowe.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730159
    m_Localized: 'BigLebowski: Zdrowo jesteś jebnięty.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730160
    m_Localized: 'BigLebowski: Jeszcze jedno takie nieprzyzwoite zagranie i spadam stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730161
    m_Localized: 'BigLebowski: Mamy w rodzinie album pełny zdjęć z przedszkola. Wtedy uśmiech nie schodził mi z buzi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730162
    m_Localized: 'BigLebowski: Ciekawe, co się zmieniło…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730163
    m_Localized: 'BigLebowski: No tak! Przyjebali mi ten głupi aparat na zęby! Jest zajebisty! Uwielbiam go!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730164
    m_Localized: 'BigLebowski: Nie rozumiem, jak niektórzy rodzice mogą przebijać uszy niemowlakom.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730165
    m_Localized: 'BigLebowski: A może ten dzieciak wcale by tego nie chciał?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730166
    m_Localized: 'BigLebowski: Dlaczego mogą w ogóle podjąć taką decyzję?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730167
    m_Localized: 'BigLebowski: Uhhh, nieważne…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730168
    m_Localized: 'BigLebowski: Heh… Zawsze myślałam, że zrobię to własną ręką…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730169
    m_Localized: 'BigLebowski: Dziękuję…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730170
    m_Localized: 'Luka: Śmiało, jeśli to pomoże.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730171
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730172
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730173
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730174
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730175
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730176
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730177
    m_Localized: 'Luka: Proszę, spójrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730178
    m_Localized: 'Luka: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730179
    m_Localized: 'Luka: Zastanawiam się, czy zęby mówią wiele o człowieku?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730180
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730181
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730182
    m_Localized: 'Luka: Pewnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730183
    m_Localized: 'Luka: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730184
    m_Localized: 'Luka: Moje własne łapska… Wciąż są ze mną, a straciłem tak wiele!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730185
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730186
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730187
    m_Localized: 'Luka: Naturalnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730188
    m_Localized: 'Luka: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730189
    m_Localized: 'Luka: Oczy wiele pamiętają.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730190
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730191
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730192
    m_Localized: 'Luka: Nie wiedziałem, że pachy też się liczą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730193
    m_Localized: 'Luka: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730194
    m_Localized: 'Luka: Wyglądają całkiem normalnie, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730195
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730196
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730197
    m_Localized: 'Luka: W porządeczku!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730198
    m_Localized: 'Luka: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730199
    m_Localized: 'Luka: Kolejna rzecz, która po mnie pozostanie. Oby tylko został ktoś, kto nas wspomni.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730200
    m_Localized: 'Luka: Kolejna rzecz, która po mnie pozostanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730201
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730202
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730203
    m_Localized: 'Luka: Nasze głosy przepadają w pustce wszechświata.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730204
    m_Localized: 'Luka: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730205
    m_Localized: 'Luka: Ale ja zawsze cię wysłucham!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730206
    m_Localized: 'Luka: W porządeczku!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730207
    m_Localized: 'Luka: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730208
    m_Localized: 'Luka: Ja zawsze cię wysłucham!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730209
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730210
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730211
    m_Localized: 'Luka: Z bronią wszystko jest łatwiejsze, prawda? Nie trzeba słuchać ani myśleć, tylko pociągnąć za spust.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730212
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730213
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730214
    m_Localized: 'Luka: Paznokcie mam brudne od walki o życie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730215
    m_Localized: 'Luka: Ta wysypka to pozostałość po minionych dniach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730216
    m_Localized: 'Luka: Czy według ciebie kara śmierci za pracujące dłonie to odpowiednia pokuta?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730217
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730218
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730219
    m_Localized: 'Luka: Jeśli czujesz, że musisz coś zniszczyć, spróbuj zacząć od swoich lęków. Wierzę w ciebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730220
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730221
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730222
    m_Localized: 'Luka: Nie chcę być twoim wrogiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730223
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730224
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730225
    m_Localized: 'Luka: Mam nadzieję, że to zdjęcie nie będzie moim ostatnim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730226
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730227
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730228
    m_Localized: 'Luka: Doprawdy chcesz, by cisza pochłonęła cały dom? Wtedy jedynym głosem, który usłyszysz, będzie twój własny.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730229
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730230
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730231
    m_Localized: 'Luka: Wiesz, nie cierpiałem się za wiele rzeczy, ale zrozumiałem, że życie nie polega na usuwaniu każdej niedoskonałości.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730232
    m_Localized: 'Luka: Życie polega na nauce samoakceptacji. Śmierć działa podobnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730233
    m_Localized: 'Luka: Ręce niosą wszystko. Stratę, radości… Bez wyciągnięcia ich do innych nie przetrwalibyśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730234
    m_Localized: 'Luka: Moje oczy… widziały tak radość, jak i śmierć. Pomimo tego wciąż staram się patrzeć przed siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730235
    m_Localized: 'Luka: Zapachy także niosą wspomnienia. Zapach domu, świeżego chleba, wczesnego poranka. Dają nam siłę, by podążać dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730236
    m_Localized: 'Luka: Zdjęcia to nie tylko obrazki. To chwile, które chcemy zatrzymać na dłużej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730237
    m_Localized: 'Luka: Słuch to nie tylko odbieranie dźwięków. To także rozumienie, jak czują się inni, nawet gdy nic nie mówią.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730238
    m_Localized: 'Luka: Jeśli tak będzie ci łatwiej…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730239
    m_Localized: 'Luka: Wybaczam ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924160
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924161
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924162
    m_Localized: 'FortuneTeller: Pewnego razu słyszałam w uszach szum… jakby szeptał do mnie wszechświat. Lecz to było coś o wiele wspanialszego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924163
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924164
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924165
    m_Localized: 'Fanatic: Chcesz uwiecznić mnie na filmie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924166
    m_Localized: 'Fanatic: Hmm… Hmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924167
    m_Localized: 'Fanatic: Wiesz, że raz uścisnąłem dłoń Świetlistego Guru Słońca?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924168
    m_Localized: 'Fanatic: To ja nauczyłem go spoglądać prosto w Słońce. Ale tą świętą przypowiastką obdaruję cię później, człowiecze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924169
    m_Localized: 'Fanatic: Śmiało. NIECH MOJE UNIEŚMIERTERLNIENIE ROZJAŚNI NASZE OCZY!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924170
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924171
    m_Localized: 'Fanatic: ŚWIECI Z JASKRAWOŚCIĄ GODNĄ PRZENAJŚWIĘTSZEGO ŚŁOŃCA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924172
    m_Localized: 'Fanatic: Zawitaj do mnie później, człowiecze. Pobłogosławię twe uszy opowieścią o moim życiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924173
    m_Localized: 'Fanatic: A w zamian zapłacisz co łaska…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924174
    m_Localized: 'Fanatic: ZA SŁONECZNE ZBAWIENIE!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924175
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924176
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924177
    m_Localized: 'Fanatic: Tak! Uszami bezpośrednio odbieram sprawiedliwe sygnały życia! Skąd wiedziałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924178
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924179
    m_Localized: 'Fanatic: Z głowy wylewa mi się przetworzone światło słoneczne!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924180
    m_Localized: 'Fanatic: Mój mózg przyswaja energię słoneczną i daje mi siłę do walki ze… ZŁOWIESZCZYM, PODZIEMNYM POMIOTEM!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924181
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924182
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924183
    m_Localized: 'Fanatic: WSTRZYMAJ SIĘ OD OSĄDU, CZŁOWIECZE!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924184
    m_Localized: 'Fanatic: Przenajświętsze Słońce mnie ochładza! Nie pozwoli, bym spłonął w Jego jaśniejącym blasku… promieni… Sam rozumiesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924185
    m_Localized: 'Fanatic: To tylko moja piwna aura… Tak… Święta Piwaura… Tak to nazwijmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924186
    m_Localized: 'Fanatic: Picie piwa zwilża mi żyły, by nie przypiekło mnie Słońce.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924187
    m_Localized: 'Fanatic: Widzisz? Logiczne. A teraz odłóż to i posłuchaj moich… ŚWIĘTYCH, ZBAWICIELSKICH SŁÓW!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924188
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924189
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924190
    m_Localized: 'Fanatic: ZŁY, OCIENIAŁY CZŁOWIEKU!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924191
    m_Localized: 'Fanatic: Nie jesteś przecież… NIEOPROMIENIONYM DZIKUSEM SPOD ZIEMI… prawda? DLACZEGO WTEDY ZACHOWUJESZ SIĘ JAK ONI?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924192
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924193
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924194
    m_Localized: 'Fanatic: Człowiecze, zaszczycę cię opowieścią o tym, jak nauczyłem Guru Słońca przyswajać energię Słońca.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924195
    m_Localized: 'Fanatic: Więc… podchodzi do mnie taki wypłosz i pyta się, jak przeżyć w Słońcu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924196
    m_Localized: 'Fanatic: Mówię mu wprost: „PRZENAJŚWIĘTSZE SŁOŃCE CIĘ NIE SKRZYWDZI! Ale tyś wątły… Potrzebujesz rady!”.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924197
    m_Localized: 'Fanatic: Wręczam mu ceber, każę iść do domu, pomalować go na czarno, założyć na łeb i wyjść na zewnątrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924198
    m_Localized: 'Fanatic: A wtedy krzyczeć tak: AAaaaAAAAAAaaAAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924199
    m_Localized: 'Fanatic: Wtedy ceber napełni się piwnymi oparami, a ty wchłoniesz święte Słoneczne promienie mocy!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924200
    m_Localized: 'Fanatic: Nigdy potem już go nie spotkałem… Pewnie w końcu zajął się czymś pożytecznym!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924201
    m_Localized: 'Fanatic: HA, HA, HA! Takich bzdur to bym nigdy nie powiedział!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924202
    m_Localized: 'Fanatic: Uszy są nieważne!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924203
    m_Localized: 'Fanatic: Szare komórki to inna broszka! Trzeba je przemienić w żółte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924204
    m_Localized: 'Fanatic: Na co się tam tak gapiłeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924205
    m_Localized: 'Fanatic: Jeśli musisz do mnie mówić, człowiecze, odwróć wzrok od mojego… ŚWIĘTEGO CIELSKA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924206
    m_Localized: 'Fanatic: I podaj mi piwo!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924207
    m_Localized: 'Hunter: Co chcesz sprawdzić?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924208
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924209
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924210
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924211
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924212
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924213
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924214
    m_Localized: 'Hunter: Zęby, co? Zgoda, pokażę ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924215
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924216
    m_Localized: 'Hunter: Oczywiście, że są białe, młody. Nie jestem troglodytą. Dupę też podcieram, jeśli musisz wiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924217
    m_Localized: 'Hunter: Za młodu rodzice chcieli, bym nosił aparat, ale nie poszedłem na wizytę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924218
    m_Localized: 'Hunter: Dostałem za to po tyłku, ale żaden dentysta mnie nie zobaczy. O nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924219
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924220
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924221
    m_Localized: 'Hunter: Nie zwlekajmy, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924222
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924223
    m_Localized: 'Hunter: Pewnie, że są brudne. Całe noce wykopuję szkodniki!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924224
    m_Localized: 'Hunter: Wtedy łatwiej je utłuc!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924225
    m_Localized: 'Hunter: Też powinieneś tak robić, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924226
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924227
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924228
    m_Localized: 'Hunter: Wiesz, młody, miałem kiedyś sokoli wzrok.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924229
    m_Localized: 'Hunter: Ale po tej ostatniej przygodzie są wciąż zaczerwienione.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924230
    m_Localized: 'Hunter: Dobijałem jakiegoś szkodnika i rzucił mi w oczy ziemią, gównem, czy innym dziadostwem. Wciąż mnie od tego bolą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924231
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924232
    m_Localized: 'Hunter: Ostrożnie, młody. To boli jak cholera.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924233
    m_Localized: 'Hunter: Od takiego życia jak moje każdemu facetowi wyblakłyby oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924234
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924235
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924236
    m_Localized: 'Hunter: Ale dorwę ich. Do ostatniego. Rozerwę gołymi rękami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924237
    m_Localized: 'Hunter: Może wtedy będziemy mogli znów żyć w spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924238
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924239
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924240
    m_Localized: 'Hunter: Im więcej objawów, tym łatwiej odnaleźć to robactwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924241
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924242
    m_Localized: 'Hunter: Jestem tylko zwykłym facetem, młody. Nie wiem, czego się tam spodziewałeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924243
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924244
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924245
    m_Localized: 'Hunter: Odmawiam. Nie lubię być fotografowany.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924246
    m_Localized: 'Hunter: Lampa błyskowa przypomina mi błyskawice, stresuje mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924247
    m_Localized: 'Hunter: Nie. Nie zgadzam się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924248
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924249
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924250
    m_Localized: 'Hunter: Też widziałem te wiadomości, młody. Zgoda, spójrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924251
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924252
    m_Localized: 'Couple: I jak? Co jest? Widzisz coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924253
    m_Localized: 'Hunter: Hm. Dobrze by było wiedzieć, czego w ogóle mamy szukać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924254
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924255
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924256
    m_Localized: 'Hunter: Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924257
    m_Localized: 'Hunter: Ty skurczybyku!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924258
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924259
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924260
    m_Localized: 'Hunter: Spokojnie… nie musisz faszerować mnie ołowiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924261
    m_Localized: 'Hunter: To ja trzymam nocną wartę przy oknach, by nie wślizgnęło się tu żadne robactwo. Samemu… prosisz się o śmierć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924262
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924263
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924264
    m_Localized: 'Hunter: Cierpliwości, młody… Niepełnosprawnych bez rąk też powystrzelasz, bo nie mają paznokci?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924265
    m_Localized: 'Hunter: Wskaż mi lekarza i sprawdź mi oczy po tym, jak będą wyleczone!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924266
    m_Localized: 'Hunter: Dlaczego jesteś taki spięty, młody?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924267
    m_Localized: 'Hunter: Nie wydawaj pochopnych osądów. Tak rodzą się błędy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924268
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924269
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924270
    m_Localized: 'Hunter: Słuchaj, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924271
    m_Localized: 'Hunter: Utrata rozsądku przybliża robactwo do zwycięstwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924272
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924273
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924274
    m_Localized: 'Hunter: Won! Nie zmusisz mnie do zdjęcia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924275
    m_Localized: 'Hunter: Idź sfotografować coś innego. Zabij jakieś robactwo. Zajęczy bobek mnie to obchodzi… Tylko weź mi stąd ten aparat!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924276
    m_Localized: 'Hunter: Hm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924277
    m_Localized: 'Hunter: Poruszę się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924278
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924279
    m_Localized: 'Hunter: CHOLERA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924280
    m_Localized: 'Hunter: I co teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924281
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924282
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924283
    m_Localized: 'Hunter: Co, jestem teraz robactwem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924284
    m_Localized: 'Hunter: Trudno. Jak do tego doszedłeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924285
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924286
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924287
    m_Localized: 'Hunter: Rozumiem, młody. W stresie robi się różne rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924288
    m_Localized: 'Hunter: Ale to z robactwem musimy walczyć, a nie ze sobą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924289
    m_Localized: 'Hunter: Setnie, że się w porę opamiętałeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924290
    m_Localized: 'Hunter: Mądry wybór, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924291
    m_Localized: 'Hunter: Idziesz ze mną w nocy zadusić trochę robactwa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924292
    m_Localized: 'Hunter: No, młody, zapolujmy na nich razem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924293
    m_Localized: 'Hunter: Rozsądny wybór, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924294
    m_Localized: 'Hunter: Niemądrze jest działać pochopnie. Na polowaniu można przez to skończyć rozerwanym na kawałki.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924295
    m_Localized: 'Hunter: Cholewka. Przez chwilę myślałem, że naprawdę mnie kropniesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924296
    m_Localized: 'Hunter: Dlaczego zmieniłeś zdanie? Czy nie mam żadnego z objawów?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924297
    m_Localized: 'Hunter: Czy może presja była zbyt wielka?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924298
    m_Localized: 'Hunter: Rad jestem, że mnie nie ustrzeliłeś, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924299
    m_Localized: 'Hunter: Wiesz, naprawdę nie cierpię tego wszystkiego. Aparatów, fleszy, hałasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924300
    m_Localized: 'Hunter: Brrr.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924301
    m_Localized: 'Hunter: Włosy dęba stają.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924302
    m_Localized: 'Hunter: Jeśli ci z wiadomości wciąż będą pitolić o nowych objawach, powinni je chociaż opisać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924303
    m_Localized: 'Hunter: Inaczej złapię jakiegoś robala i nie będę wiedział, co mam mu sprawdzić!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924304
    m_Localized: 'Hunter: Czy tak czuje się robactwo przed zastrzeleniem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924305
    m_Localized: 'Hunter: Przerażone…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924306
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924307
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924308
    m_Localized: 'Anxiety: J‑jeśli okaże się, że jestem Przybyszką… czy to znaczy, że zacznę zabijać ludzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924309
    m_Localized: 'Anxiety: Czy będę niebezpieczna? Czy… może zawsze taka byłam?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924310
    m_Localized: 'Anxiety: A może… już zaczęłam zabijać?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924311
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924312
    m_Localized: 'Anxiety: Ha, ha, ha, wyobrażasz to sobie? Więc… to prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924313
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924314
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924315
    m_Localized: 'Anxiety: D‑dlaczego jest tyle objawów?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924316
    m_Localized: 'Anxiety: I DLACZEGO MAM KAŻDY Z NICH?! HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924317
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924318
    m_Localized: 'Anxiety: NAWET NIE WIEM, CO TO ZNACZY!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924319
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924320
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924321
    m_Localized: 'Anxiety: Uhm… Więc co teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924322
    m_Localized: 'Anxiety: Czy mogę żyć dalej? Cz‑czy mam umrzeć? Co zamierzasz zrobić?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924323
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924324
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924325
    m_Localized: 'Anxiety: Czy to ostatni gwóźdź do mojej trumny?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924326
    m_Localized: 'Anxiety: Cz‑czy ja umrę? Zastrzelisz mnie? Och nie… o Boże, tak strasznie się boję!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924327
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924328
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924329
    m_Localized: 'Anxiety: Dlaczego moje życie jest takie popieprzone?! Ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924330
    m_Localized: 'Anxiety: Najpierw moje plecy, a teraz… dosłownie to wszystko!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924331
    m_Localized: 'Anxiety: Kiedy to się skończy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924332
    m_Localized: 'Anxiety: Kiedy wszystko wróci do normy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924333
    m_Localized: 'Anxiety: Na co czekasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924334
    m_Localized: 'Anxiety: Zastrzel mnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924335
    m_Localized: 'Anxiety: Wtedy przynajmniej przestanę się wciąż trząść… z niewiedzy, co tym razem się tobie we mnie nie spodoba.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924336
    m_Localized: 'Anxiety: ALBO MNIE ZABIJ, ALBO P‑PRZESTAŃ DRĘCZYĆ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924337
    m_Localized: 'Anxiety: Wystarczy tego… proszę. W domu miałam wystarczająco ciężko. Chcę odrobiny spokoju…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924338
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924339
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924340
    m_Localized: 'Esenin: Wszystkie te testy na objawy, faceci w żółtych strojach…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924341
    m_Localized: 'Esenin: To wszystko…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924342
    m_Localized: 'Esenin: …jest równo popieprzone.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924343
    m_Localized: 'Esenin: Czy kiedykolwiek zdaje ci się, że wszystko stacza się do jakiegoś okropnego piekła?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924344
    m_Localized: 'Esenin: Niby wszystko jest pod kontrolą, a jednak wokół panuje absolutny chaos.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924345
    m_Localized: 'Esenin: Dobra, rób to cholerne zdjęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924346
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924347
    m_Localized: 'Esenin: Przeraża mnie myśl, co nastąpi dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924348
    m_Localized: 'Esenin: Wiesz przynajmniej, czego szukasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924349
    m_Localized: 'Esenin: Na co masz uważać?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924350
    m_Localized: 'Esenin: Przyglądanie się temu, jak sobie nie radzisz, dobitnie dowodzi temu, jak wszyscy mamy przejebane.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924351
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924352
    m_Localized: 'Esenin: Jutro powiedzą, że trzeba rozciąć jakiegoś dzieciaka i zrobisz to bez mrugnięcia okiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924353
    m_Localized: 'Esenin: Kurwa… Jak ja się wpakowałem w tę kaszanę?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924354
    m_Localized: 'Cold: Co chce pan sprawdzić?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924355
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924356
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924357
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924358
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924359
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924360
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924361
    m_Localized: 'Cold: Mm, z‑z‑zęby?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924362
    m_Localized: 'Cold: Zgoda… P‑proszę spojrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924363
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924364
    m_Localized: 'Cold: Czasem przygryzam sobie wargi do k‑krwi… by poczuć jej c‑c‑ciepło.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924365
    m_Localized: 'Cold: By przypomnieć sobie, że w‑wciąż żyję…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924366
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924367
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924368
    m_Localized: 'Cold: P‑paznokcie? Jasne, pokażę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924369
    m_Localized: 'Cold: Hm. Wszystkie j‑je sobie powyrywałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924370
    m_Localized: 'Cold: Ale może pan sam z‑zobaczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924371
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924372
    m_Localized: 'Cold: Myśli pan, że moje p‑p‑paznokcie pasują do opisu Przybyszy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924373
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924374
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924375
    m_Localized: 'Cold: Oczy są zwierciadłem piekła, nie d‑duszy…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924376
    m_Localized: 'Cold: Moja dusza w‑wypaliła się dawno temu. Może dlatego tak mi z‑z‑zimno.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924377
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924378
    m_Localized: 'Cold: Zwężone ź‑źrenice?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924379
    m_Localized: 'Cold: Pewnie z‑z‑zimno skurczyło mi skórę…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924380
    m_Localized: 'Cold: Szkoda, że mimo tego słońce wciąż parzy mnie tak samo, jak innych.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924381
    m_Localized: 'Cold: Przynajmniej moje zwęglające się ciało było ciepłe…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924382
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924383
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924384
    m_Localized: 'Cold: Mm…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924385
    m_Localized: 'Cold: Potrzebuję ch‑chwili.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924386
    m_Localized: 'Cold: T‑tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924387
    m_Localized: 'Cold: Teraz… Proszę szybko s‑spojrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924388
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924389
    m_Localized: 'Cold: Tak, to było nieprzyjemne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924390
    m_Localized: 'Cold: P‑pokazałem wszystko… z szacunku do pana.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924391
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924392
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924393
    m_Localized: 'Cold: Co może u‑udowodnić zdjęcie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924394
    m_Localized: 'Cold: Czy nie wydaje s‑się to panu dziwne?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924395
    m_Localized: 'Cold: A‑a‑ale… decyzja należy do pana, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924396
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924397
    m_Localized: 'Cold: Widzi pan coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924398
    m_Localized: 'Cold: P‑proszę pokazać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924399
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924400
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924401
    m_Localized: 'Cold: Nasze ciała to same dziury.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924402
    m_Localized: 'Cold: Może dlatego ludzie t‑t‑tak łatwo znikają? Pochłonięci w moment, kiedy się odwrócić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924403
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924404
    m_Localized: 'Cold: Prędzej czy później nawet n‑najbliżsi znikną.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924405
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924406
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924407
    m_Localized: 'Cold: B‑być może niedługo będę mógł zapomnieć…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924408
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924409
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924410
    m_Localized: 'Cold: Mm, nie sposób s‑sprawdzić moich rąk, gdy t‑tak wyglądają.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924411
    m_Localized: 'Cold: Niech mi pan wybaczy… P‑proszę nie strzelać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924412
    m_Localized: 'Cold: Chciałbym p‑p‑panu coś powiedzieć… ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924413
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924414
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924415
    m_Localized: 'Cold: Czy to żądza m‑mordu przemawia przez pana? Nie mam przekrwionych o‑oczu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924416
    m_Localized: 'Cold: J‑już nie przeszkadzam. Czekanie jest gorsze od ś‑ś‑śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924417
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924418
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924419
    m_Localized: 'Cold: Mam tam g‑grzyba? Pewnie dlatego, że wciąż się pocę pod tymi wszystkimi p‑płaszczami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924420
    m_Localized: 'Cold: Moje ciało z czymś w‑w‑walczy… ale po co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924421
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924422
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924423
    m_Localized: 'Cold: Cz‑czy mogę zatrzymać to zdjęcie? Nigdy wcześniej nie miałem z‑z‑zrobionego zdjęcia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924424
    m_Localized: 'Cold: To m‑miłe uczucie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924425
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924426
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924427
    m_Localized: 'Couple: I co pan widzi w tej p‑przepaści?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924428
    m_Localized: 'Cold: Czy p‑przypomina panu siebie samego?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924429
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924430
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924431
    m_Localized: 'Cold: Dz‑dziękuję za zaufanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924432
    m_Localized: 'Cold: Mam nadzieję, że b‑będę panu przydatny.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924433
    m_Localized: 'Cold: Coś mnie gryzie, ale nie chcę jeszcze z‑zdradzić, co to takiego…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924434
    m_Localized: 'Cold: Wie pan, d‑dość mam takiego życia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924435
    m_Localized: 'Cold: Ale zdecydował się pan mnie nie z‑zastrzelić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924436
    m_Localized: 'Cold: A g‑g‑gdzieś indziej w tym samym czasie ktoś z‑zginął we własnym domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924437
    m_Localized: 'Cold: Zastanawiał się pan kiedyś, dlaczego tak jest?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924438
    m_Localized: 'Cold: Ż‑życie już dawno uszło z moich oczu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924439
    m_Localized: 'Cold: Pozostała jedynie wieczna s‑samotność.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924440
    m_Localized: 'Cold: Nie mogę się z nikim zaprzyjaźnić. Rodzi to tylko b‑ból… i cierpienie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924441
    m_Localized: 'Cold: T‑tęsknię za spokojnym życiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924442
    m_Localized: 'Cold: Wie pan, zanim byliśmy zagrożeni wyginięciem jako g‑g‑gatunek.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924443
    m_Localized: 'Cold: Gdy byliśmy u szczytu łańcucha p‑pokarmowego. Gdy mogliśmy wychodzić na s‑s‑słońce.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924444
    m_Localized: 'Cold: Wtedy, oczywiście, też było mi z‑zbyt zimno, by zdjąć p‑p‑płaszcz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924445
    m_Localized: 'Cold: Proszę mi powiedzieć, ile jeszcze objawów musi się p‑pojawić, by w końcu zorientowali się, co muszą z‑z‑zrobić?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924446
    m_Localized: 'Cold: Dlaczego ktokolwiek musi u‑umierać?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924447
    m_Localized: 'Cold: A może nigdy nie musiało d‑do tego dojść?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924448
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924449
    m_Localized: 'Cold: Czasami chyba… zadaję zbyt w‑wiele osobistych pytań.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924450
    m_Localized: 'Cold: Nie musi pan na nie o‑odpowiadać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924451
    m_Localized: 'Cold: P‑pomyślałem tylko, że zapytam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924452
    m_Localized: 'Cold: To pewnie b‑bez sensu…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924453
    m_Localized: 'Cold: Wie pan…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924454
    m_Localized: 'Cold: Zdaje się, że w końcu pojąłem, dlaczego mi tak z‑z‑zimno.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924455
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924456
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924457
    m_Localized: 'Widow: Poważnie? Nie wydaje ci się to upokarzające?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924458
    m_Localized: 'Widow: Nikt nie pomógł mi uratować męża, a teraz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924459
    m_Localized: 'Widow: CHCESZ UWIECZNIĆ JEGO ŚMIERĆ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924460
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924461
    m_Localized: 'Widow: Brak mi słów.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924462
    m_Localized: 'Widow: Rób, co musisz i zostaw mnie w spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924463
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924464
    m_Localized: 'Widow: Zadowolony? Wtedy wyjdź.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924465
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924466
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924467
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924468
    m_Localized: 'Widow: Czego ty ode mnie chcesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924469
    m_Localized: 'Widow: Nie mam już cierpliwości na twoje wymysły.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924470
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924471
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924472
    m_Localized: 'Widow: Oczywiście, że moje zdjęcie wyszło takie bladoniebieskie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924473
    m_Localized: 'Widow: Wiesz, z jakiego to powodu. Wiesz, jakie to dla mnie ciężkie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924474
    m_Localized: 'Widow: Ale jednak wciąż mnie dręczysz… Dlaczego?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924475
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924476
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924477
    m_Localized: 'Widow: Doprawdy? Posuniesz się tak daleko…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924478
    m_Localized: 'Widow: Nie wiem, co mam ci powiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924479
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924480
    m_Localized: 'Widow: Znalazłeś to, czego szukałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924481
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924482
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924483
    m_Localized: 'Widow: Zostało mi tylko jedno nasze wspólne zdjęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924484
    m_Localized: 'Widow: Czy to wszystko, co mogę zatrzymać? Jedno zdjęcie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924485
    m_Localized: 'Widow: A ono i tak z czasem się pogniecie, podrze i wyblaknie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924486
    m_Localized: 'Widow: Już nigdy więcej nie będę mogła z nim porozmawiać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924487
    m_Localized: 'Widow: Chcę odpocząć. Czy możesz wyjść?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924488
    m_Localized: 'Widow: Będę tu siedziała. Mam nadzieję, że dasz mi chociaż pobyć samej z moimi myślami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924489
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924490
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924491
    m_Localized: 'Scammer: Chcesz nam zrobić selfie? Luzik.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924492
    m_Localized: 'Scammer: Ale, joł, jestem dość wrażliwy na światło.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924493
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924494
    m_Localized: 'Scammer: No i zajebiście! O to chodzi, ziomuś!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924495
    m_Localized: 'Scammer: Kurczę, co u licha? Widać tylko jakieś głupie kształty. A taką przybrałem fajną pozę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924496
    m_Localized: 'Scammer: Kurczę, co u licha? Nie wyczyściłeś nawet obiektywu! Patrz, wygląda jak rzygi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924497
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924498
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924499
    m_Localized: 'Scammer: Hej, nie tykaj mojego wałka, chłopie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118464
    m_Localized: 'Scammer: Patrzysz, mówisz im, że siedzi tam duch Przybysza i kasujesz ich za grubą kabzę, by tego nikomu nie wypaplać. Bum!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118465
    m_Localized: 'Scammer: Pozwalam ci na to, bo jesteśmy ziomalami, ziom. Nie próbuj jednak na mnie tej zagrywki, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118466
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118467
    m_Localized: 'Scammer: W dechę, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118468
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118469
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118470
    m_Localized: 'Scammer: Kurde, ziom! Z powodu pieprzonego zdjęcia?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118471
    m_Localized: 'Scammer: Raz przegrałem w karty dom cioci i nawet ona mi tak nie groziła!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118472
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118473
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118474
    m_Localized: 'Scammer: No weź, brachu… mówiłem ci…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118475
    m_Localized: 'Scammer: Jestem kompletnie spłukany, stary. W kasynie przegrałem ostatni grosz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118476
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118477
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118478
    m_Localized: 'Scammer: Nie próbuj mnie tu tak wydymać, chamie. Tak możesz pogrywać z tymi innymi frajerami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118479
    m_Localized: 'Scammer: Nie daj im chwili spokoju. Kumasz bazę?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118480
    m_Localized: 'Scammer: Jeśli dasz, poczują się spokojni, zapomną, u kogo są, i nie zapłacą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118481
    m_Localized: 'Scammer: Joooł! Spociłem się przez ciebie jak świnia, brachu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118482
    m_Localized: 'Scammer: Wszystko gites, stary! Przynajmniej nie płacę tu czynszu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118483
    m_Localized: 'Scammer: Muszę tylko ukręcić nowy wałek. Zgarnąć jakąś mamonę, kupić nową kanciapę i żyć, jak król, brachu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118484
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118485
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118486
    m_Localized: 'Daughter: Zdjęcie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118487
    m_Localized: 'Daughter: Nie mam za dużo swoich zdjęć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118488
    m_Localized: 'Daughter: Pokaże mi je pan potem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118489
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118490
    m_Localized: 'Daughter: Mmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118491
    m_Localized: 'Daughter: Dziękuję…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118492
    m_Localized: 'Daughter: Nie podoba mi się. Niech pan nie robi ich więcej…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118493
    m_Localized: 'Daughter: Tata mówił, że trzeba uważać na kleszcze i robale. Czy tego pan szuka?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118494
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118495
    m_Localized: 'Daughter: Dziękuję, że pan sprawdził!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118496
    m_Localized: 'Daughter: Jak tata po mnie przyjdzie, to powiem mu, że pan na pewno nie jest Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118497
    m_Localized: 'Daughter: Niedługo pewnie będzie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118498
    m_Localized: 'Greatmother: Co chcesz sprawdzić, cukiereczku?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118499
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118500
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118501
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118502
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118503
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118504
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118505
    m_Localized: 'Greatmother: Och, kochany! Jakie zęby, cukiereczku?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118506
    m_Localized: 'Greatmother: No, śmiało, rzućże okiem!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118507
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118508
    m_Localized: 'Greatmother: No i?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118509
    m_Localized: 'Greatmother: Co? Że niby taka stara baba z licówkami na zębach to już do grobu ma się streszczać?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118510
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118511
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118512
    m_Localized: 'Greatmother: Jednej już prawie nie czuję…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118513
    m_Localized: 'Greatmother: Starość nie radość, cukiereczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118514
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118515
    m_Localized: 'Greatmother: Nie pamiętam nawet, jak się ta choroba zowie, ale odpadają od niej paznokcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118516
    m_Localized: 'Greatmother: Boli jak sto diabłów.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118517
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118518
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118519
    m_Localized: 'Greatmother: Od zawsze miałam te popękane naczynka w oczach, cukiereczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118520
    m_Localized: 'Greatmother: Jakżeś ty po tym chcesz wymądrzyć, czy jestem Przybyszką?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118521
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118522
    m_Localized: 'Greatmother: No i co teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118523
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118524
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118525
    m_Localized: 'Greatmother: Mamuśka się starzeje, cukiereczku. Ciało już młodości nie pamięta.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118526
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118527
    m_Localized: 'Greatmother: Bez ustanku mnie tam swędzi, a ja nie wiem, co z tym począć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118528
    m_Localized: 'Greatmother: Próbowałam różnych remediów, ale nic nie pomogło.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118529
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118530
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118531
    m_Localized: 'Greatmother: Już od lat nikt nie fotografował Mamuśki!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118532
    m_Localized: 'Greatmother: Śmiało, cukiereczku. Nie wahaj się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118533
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118534
    m_Localized: 'Greatmother: Czemu tu nic nie widać? Same mazgaje i cętki.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118535
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118536
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118537
    m_Localized: 'Greatmother: W nocy słyszę jakieś chrobotanie. Jakby coś spod podłogi wypełzało.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118538
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118539
    m_Localized: 'Greatmother: Och, kurza stopa! Złap to! Zabij!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118540
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118541
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118542
    m_Localized: 'Greatmother: Ejże, tak nie przystoi! Strzelbą się takich sytuacji nie rozwiązuje, cukiereczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118543
    m_Localized: 'Greatmother: Lepiej nożem w plecy… albo trucizną. Wierz mi na słowo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118544
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118545
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118546
    m_Localized: 'Greatmother: Nie bój się, cukiereczku. Te ręce jeszcze potrafią obronić swoją trzódkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118547
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118548
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118549
    m_Localized: 'Greatmother: Od trzech lat wzrok mi słabnie coraz bardziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118550
    m_Localized: 'Greatmother: Te popękane naczynka nie goją się już jak za młodu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118551
    m_Localized: 'Greatmother: Nie myślisz chyba, że to raczysko jakieś, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118552
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118553
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118554
    m_Localized: 'Greatmother: HA, HA, HA! Oto i uniwersalne panaceum!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118555
    m_Localized: 'Greatmother: No, cukiereczku? Uzdrowisz biedną, chorowitą Mamuśkę?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118556
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118557
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118558
    m_Localized: 'Greatmother: Co rzeczesz? Jakowaś aura?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118559
    m_Localized: 'Greatmother: Na moje to to ustrojstwo jest w rozsypce. Dałeś się zrobić w konia i jeszcze z ciebie zdarli!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118560
    m_Localized: 'Greatmother: HA, HA, HA! Ubawiłam ja się po pachy!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118561
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118562
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118563
    m_Localized: 'Greatmother: Ja? Uciekać? Nigdzie się nie wybieram, cukiereczku! Idźże złapać tego przeklętego karalucha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118564
    m_Localized: 'Greatmother: Nie cierpię ich. Cholerstwo wlazło mi prosto do ucha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118565
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118566
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118567
    m_Localized: 'Greatmother: Ejże! Uważaj, gdzie tym wywijasz!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118568
    m_Localized: 'Greatmother: Róbże tak dalej, a niedługo każdy tu jeden będzie patrzył na ciebie spode łba.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118569
    m_Localized: 'Greatmother: Nie jesteś w stanie jej przecież pilnować bez przerwy i dzień i noc, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118570
    m_Localized: 'Greatmother: I co dobrego by wyszło z… nafaszerowania śrutem biednej, starej, Mamuśki…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118571
    m_Localized: 'Greatmother: Może to akt miłosierdzia…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118572
    m_Localized: 'Greatmother: Wygląda na to, że jeszcze sobie trochę pocierpię, cukiereczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118573
    m_Localized: 'Greatmother: No chyba jasne, że to żaden objaw.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118574
    m_Localized: 'Greatmother: Szkoda by było, gdyby ci się paluch omsknął. Omyłkowo położyć trupem miłą, żywą duszyczkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118575
    m_Localized: 'Greatmother: Ileż razy się już pomyliłeś? Na sercu ci te żywoty nie ciążą?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118576
    m_Localized: 'Greatmother: Usłyszałam ja niedawno powiedzonko: „Jeśli nic cię nie boli, znaczy, że nie żyjesz”.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118577
    m_Localized: 'Greatmother: I to nie tyczy się tylko staruchów. Teraz wszyscy tak żyją w chorobie i rozkładzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118578
    m_Localized: 'Greatmother: Kochaniutki! Czy Mamuśka może to zatrzymać?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118579
    m_Localized: 'Greatmother: Nie ostały mi się żadne zdjęcia. To też mnie zbytnio nie grzeje… ale co mi tam, wezmę je.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118580
    m_Localized: 'Greatmother: A z tobą co, cukiereczku? Nigdy ci żaden robal nie wyszedł tam, skąd słońce nie dochodzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118581
    m_Localized: 'Greatmother: Uszy to moja najzdrowsza część ciała.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118582
    m_Localized: 'Greatmother: Oby tylko ten przeklęty karaluch nie złożył mi żadnych jajec w mózgownicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118583
    m_Localized: 'Greatmother: Śmiało, cukiereczku… Strzelaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118584
    m_Localized: 'Greatmother: Jak Mamuśki zabraknie, przybędzie moja trzódka… Dopadną was do ostatniego…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118585
    m_Localized: 'Greatmother: HA, HA, HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118586
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118587
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118588
    m_Localized: 'NotTrue: Marnujesz kliszę na starutką babinkę? O rajuśku!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118589
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118590
    m_Localized: 'NotTrue: Tak, kochaniutki? Co teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118591
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118592
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118593
    m_Localized: 'NotTrue: Matko jedyna! Któż by o tym pomyślał.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118594
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118595
    m_Localized: 'NotTrue: Słuch mam, że mucha nie siada, kochaniutki. Ale czasem się zdaje… jakoby mnie coraz mniej było.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118596
    m_Localized: 'NotTrue: Jakoby mnie dostrzec można było jedynie najsłabszym światełku, a i to nie zawsze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118597
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118598
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118599
    m_Localized: 'NotTrue: Rany boskie, czy naprawdę ustrzelisz starą babinkę?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118600
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118601
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118602
    m_Localized: 'NotTrue: I teraz co, kochaniutki? Zaprawdę tyle wyczytałeś z uszu moich starych?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118603
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118604
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118605
    m_Localized: 'NotTrue: Za moich lat tylko burżuje takie zbytkowności mieli. Dziś zaś każdy chłopek roztropek takowe trzyma!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118606
    m_Localized: 'NotTrue: Pfuj! Nie mam ci już nic do powiedzenia, kochaniutki. Wszystek to głupstwa. Martwisz jeno zbytkownie porządnych ludzi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118607
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118608
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118609
    m_Localized: 'Alkonost: Halo, ja nie wierzę w te bzdurne aury.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118610
    m_Localized: 'Alkonost: Wszystko, co robimy, i to, gdzie kończymy, jest efektem naszych wyborów, a nie tego urojonego czary‑mary.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118611
    m_Localized: 'Alkonost: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118612
    m_Localized: 'Alkonost: I… Jak wyszło?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118613
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118614
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118615
    m_Localized: 'Alkonost: Chwila… Jakie były objawy Przybyszy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118616
    m_Localized: 'Alkonost: Czego pan tam szuka?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118617
    m_Localized: 'Alkonost: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118618
    m_Localized: 'Alkonost: Więc? Jakie wyciągnął pan wnioski?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118619
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118620
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118621
    m_Localized: 'Alkonost: Zaraz… Pan chyba w to wszystko nie wierzy, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118622
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118623
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118624
    m_Localized: 'Alkonost: Myśli pan, że jestem Przybyszką? Jak pan to wykoncypował?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118625
    m_Localized: 'Alkonost: Co pana rozjuszyło? Czy sam to pan w ogóle wie?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118626
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118627
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118628
    m_Localized: 'Alkonost: A więc to był żart? Proszę nigdy więcej tego nie robić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118629
    m_Localized: 'Alkonost: Cała ta sprawa z moim mężem mi wystarczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118630
    m_Localized: 'Alkonost: On… Niedługo przyjdzie. Musi przyjść…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118631
    m_Localized: 'Alkonost: Prawie mnie pan przestraszył na śmierć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118632
    m_Localized: 'Alkonost: Oby tylko ludzie z FEMA wiedzieli, co robią.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118633
    m_Localized: 'Alkonost: Wszystkie te tak zwane „objawy”… Sama nie wiem. Czasem zdaje mi się, że to czyste szaleństwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118634
    m_Localized: 'Alkonost: A innym razem dałabym sobie rękę uciąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118635
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118636
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118637
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118638
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118639
    m_Localized: 'Sirin: Nie obchodzi mnie, czy coś potem zostanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118640
    m_Localized: 'Sirin: Niech pan robi, jak uważa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118641
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118642
    m_Localized: 'Sirin: A to co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118643
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118644
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118645
    m_Localized: 'Sirin: Pozostał mi tylko kolczyk.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118646
    m_Localized: 'Sirin: Pamiątka po rodzicach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118647
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118648
    m_Localized: 'Sirin: Siostra swój zdjęła.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118649
    m_Localized: 'Sirin: Mojego też powinnam się pozbyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118650
    m_Localized: 'Sirin: Wspominanie ich jest dla niej przykre.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118651
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118652
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118653
    m_Localized: 'Sirin: Proszę też spalić to zdjęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118654
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118655
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118656
    m_Localized: 'Sirin: Niech pan nie czeka.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118657
    m_Localized: 'Sirin: Niech pan robi, co trzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118658
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118659
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118660
    m_Localized: 'Sirin: Czemu pan zwleka? Proszę przestać celować i wystrzelić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118661
    m_Localized: 'Sirin: Wycelowanie z broni nie sprawi, że Przybysz się na pana rzuci. Oni się nie zdradzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118662
    m_Localized: 'Sirin: Jest tylko jeden sposób, żeby mieć pewność…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118663
    m_Localized: 'Sirin: Jak pan myśli, co nas wykończy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118664
    m_Localized: 'Sirin: Przybysze? Kataklizmy? My sami?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118665
    m_Localized: 'Sirin: Jak długo to zajmie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118666
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118667
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118668
    m_Localized: 'Wolfhound: Łypnij okiem, miśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118669
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118670
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118671
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118672
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118673
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118674
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118675
    m_Localized: 'Wolfhound: Ostrożnie, miśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118676
    m_Localized: 'Wolfhound: Podejdź zbyt blisko, a pochwycę cię zębami za szyję.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118677
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118678
    m_Localized: 'Wolfhound: Dbam o swoje kły.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118679
    m_Localized: 'Wolfhound: A te brakujące?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118680
    m_Localized: 'Wolfhound: Mendy, które mnie ich pozbawiły, tulą je mocno w swoich grobach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118681
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118682
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118683
    m_Localized: 'Wolfhound: Chcesz obejrzeć moje ręce, czy tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118684
    m_Localized: 'Wolfhound: Czyste to one nie są. Tak się składa, że wczoraj zabiłem jakiegoś gnoja.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118685
    m_Localized: 'Wolfhound: Zaatakował mnie pierwszy, kolego. Musiałem się bronić, a nie dać się okładać jak jakiś muppet.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118686
    m_Localized: 'Wolfhound: Niektórzy stają jak wryci, inni uciekają.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118687
    m_Localized: 'Wolfhound: A ja oddaję z nawiązką, miśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118688
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118689
    m_Localized: 'Wolfhound: No? Zadowolony?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118690
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118691
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118692
    m_Localized: 'Wolfhound: Starasz się znaleźć we mnie coś obcego? Co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118693
    m_Localized: 'Wolfhound: Nie boisz się, że ujrzysz w nich swoje prawdziwe oblicze?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118694
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118695
    m_Localized: 'Wolfhound: Dobry piesek…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118696
    m_Localized: 'Wolfhound: Większość nie potrafi spojrzeć mi w oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118697
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118698
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118699
    m_Localized: 'Wolfhound: To zniewaga, miśku. Zapamiętam to.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118700
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118701
    m_Localized: 'Wolfhound: Dezodorant przesusza mi skórę, ale lepsze to niż przepocić garniak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118702
    m_Localized: 'Wolfhound: Facet powinien roztaczać naturalną woń… jeśli nie ma nic do ukrycia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118703
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118704
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118705
    m_Localized: 'Wolfhound: Nie lubię być fotografowany, miśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118706
    m_Localized: 'Wolfhound: Jeśli znajdę te zdjęcia gdzieś indziej niż na śmietniku, będziemy musieli pogadać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118707
    m_Localized: 'Wolfhound: Kapujesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118708
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118709
    m_Localized: 'Wolfhound: No popatrz, popatrz!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118710
    m_Localized: 'Wolfhound: Ejże, oddawaj. Sam je wyrzucę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118711
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118712
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118713
    m_Localized: 'Wolfhound: Co dalej? „Babciu, ale masz wielkie zęby!”. Toż to jakaś paranoja.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118714
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118715
    m_Localized: 'Wolfhound: Może powinienem wsadzić cię w kaftan bezpieczeństwa, zanim zrobisz sobie kuku, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118716
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118717
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118718
    m_Localized: 'Wolfhound: Papierosy nie tylko wykańczają chciwusów, ale zmiękczają dziąsła. Osłabiają zgryz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118719
    m_Localized: 'Wolfhound: Myślisz, że nikt mi nigdy nie groził giwerą, miśku?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118720
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118721
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118722
    m_Localized: 'Wolfhound: Ciągniesz za spust czy nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118723
    m_Localized: 'Wolfhound: I co potem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118724
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118725
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118726
    m_Localized: 'Wolfhound: Ujrzałeś w nich swoje odbicie, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118727
    m_Localized: 'Wolfhound: Nie próbowałbym tego, miśku. Dobrałbym ci się do skóry nawet po śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118728
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118729
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118730
    m_Localized: 'Wolfhound: Trujesz dupę szanowanemu obywatelowi i jeszcze dodajesz do tego groźby?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118731
    m_Localized: 'Wolfhound: Nie zaszedłbyś zbyt daleko w moich stronach, miśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118732
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118733
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118734
    m_Localized: 'Wolfhound: Wymachując spluwą nie zdobędziesz szacunku, nieprawdaż?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118735
    m_Localized: 'Wolfhound: Bity pies nie będzie wierny… któregoś dnia odgryzie ci rękę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118736
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118737
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118738
    m_Localized: 'Wolfhound: Za wolno, miśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118739
    m_Localized: 'Wolfhound: Jeśli tak kochasz być sam jak palec…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118740
    m_Localized: 'Wolfhound: Czemu nie kropniesz nas wszystkich, by mieć święty spokój, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118741
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118742
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118743
    m_Localized: 'Wolfhound: Leżeć, piesku…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118744
    m_Localized: 'Wolfhound: Przejrzałem cię, wiem, o której chodzisz spać i jak długo sypiasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118745
    m_Localized: 'Wolfhound: Sprowokuj mnie, miśku… a rozerwę cię na strzępy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118746
    m_Localized: 'Wolfhound: Koniec wygłupów.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118747
    m_Localized: 'Wolfhound: Jestem od ciebie szybszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118748
    m_Localized: 'Wolfhound: Odbiorę ci tę śrutówkę szybciej, niż zdążysz mrugnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118749
    m_Localized: 'Wolfhound: Spokojnie, leżeć, piesku…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118750
    m_Localized: 'Wolfhound: Źle cię oceniłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118751
    m_Localized: 'Wolfhound: Wyjęcie giwery i nie strzelenie? To dowód zwątpienia, miśku. A to bardzo niebezpieczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118752
    m_Localized: 'Wolfhound: Bardzo starasz się dostać do mojego kajetu, miśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118753
    m_Localized: 'Wolfhound: Odwal znowu coś takiego, a wymienimy nie tylko słowa. Rozumiemy się, miśku?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118754
    m_Localized: 'Wolfhound: Chyba sobie kpisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118755
    m_Localized: 'Wolfhound: Jesteś jak szczeniak aportujący petardę. Coś tu jest nie tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118756
    m_Localized: 'Wolfhound: Lepiej ją odłożyć, zanim ktoś straci oko, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118757
    m_Localized: 'Wolfhound: Słuchaj, kolego… Robisz z siebie niezłego idiotę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118758
    m_Localized: 'Wolfhound: Siadaj na dupę, szczeniaku, i pozwól, że dorośli się wszystkim zajmą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118759
    m_Localized: 'Wolfhound: A więc to tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312768
    m_Localized: 'Wolfhound: Sprawdźmy, kto jest szybszy, miśku…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312769
    m_Localized: 'Wolfhound: AAAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312770
    m_Localized: 'Doctor: Co chce pan przebadać?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312771
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312772
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312773
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312774
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312775
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312776
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312777
    m_Localized: 'Doctor: Dziękuję za troskę, ale moje zęby są w świetnym stanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312778
    m_Localized: 'Doctor: Ach, ma pan na myśli sprawdzenie objawów na Przybysza.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312779
    m_Localized: 'Doctor: Naturalnie, proszę spojrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312780
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312781
    m_Localized: 'Doctor: Są w znakomitym stanie, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312782
    m_Localized: 'Doctor: Kolega mi wszystkie powymieniał i nie musiałem nic płacić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312783
    m_Localized: 'Doctor: A ja niedawno przeprowadzałem na nim operację.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312784
    m_Localized: 'Doctor: Ciekawe, co u niego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312785
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312786
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312787
    m_Localized: 'Doctor: Tak, tymi dłońmi przeprowadziłem niezliczone operacje.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312788
    m_Localized: 'Doctor: Mógłbym panu cały dniami opowiadać historie z sali operacyjnej… ale może innym razem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312789
    m_Localized: 'Doctor: Na tę chwilę proszę na nie spojrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312790
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312791
    m_Localized: 'Doctor: Staram się utrzymywać je w dobrej formie, aby mi nie zesztywniały.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312792
    m_Localized: 'Doctor: Bo nigdy nie wiadomo, co przyniesie jutro.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312793
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312794
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312795
    m_Localized: 'Doctor: W porządku, pokaże panu oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312796
    m_Localized: 'Doctor: Nie wiem, czy pan zauważył, ale mam polikorię.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312797
    m_Localized: 'Doctor: Tak, to oficjalna diagnoza.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312798
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312799
    m_Localized: 'Doctor: Niestety pogarsza ona wzrok, a nie polepsza.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312800
    m_Localized: 'Doctor: Pomyśleć by można, że dwie źrenice w oku poprawiłyby ostrość widzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312801
    m_Localized: 'Doctor: Niestety… nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312802
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312803
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312804
    m_Localized: 'Doctor: Tak, chwileczkę. Nie jestem już taki chyży, jak kiedyś.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312805
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312806
    m_Localized: 'Doctor: Staram się utrzymywać higienę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312807
    m_Localized: 'Doctor: To ważne, nie wiedząc, kiedy nadejdzie następna okazja do kąpieli. Może przez cały tydzień będę chodził w brudzie, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312808
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312809
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312810
    m_Localized: 'Doctor: Nie ma problemu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312811
    m_Localized: 'Doctor: Musi pan dokładnie sprawdzić najdrobniejszy szczegół. Mniemam, że to część procesu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312812
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312813
    m_Localized: 'Doctor: Ludzie zawsze mi mówili, że jakoś dziwnie wyglądam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312814
    m_Localized: 'Doctor: Co pan o tym myśli?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312815
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312816
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312817
    m_Localized: 'Doctor: No dobrze. Ufam, że pan wie, co robi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312818
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312819
    m_Localized: 'Doctor: A to, że wciąż tu jestem, znaczy, że podejmuje pan właściwe decyzje.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312820
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312821
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312822
    m_Localized: 'Doctor: Proszę chwilę poczekać!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312823
    m_Localized: 'Doctor: Popełnia pan błąd, ja mogę ratować ludziom życie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312824
    m_Localized: 'Doctor: A pan zamierza jedno odebrać…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312825
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312826
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312827
    m_Localized: 'Doctor: Chwila, to normalne. Jestem lekarzem i nie mam odpowiednich środków odkażających!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312828
    m_Localized: 'Doctor: Proszę mi powiedzieć, jak wyglądają „normalne” ręce?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312829
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312830
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312831
    m_Localized: 'Doctor: Intrygujące. Wielka szkoda, że nie mogę zbadać, jak zaczęła się pana paranoja.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312832
    m_Localized: 'Doctor: Jednakowoż zdrowie psychiczne to nie mój konik, więc wystawianie diagnozy byłoby nie na miejscu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312833
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312834
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312835
    m_Localized: 'Doctor: Proszę się dobrze zastanowić, zanim popełni pan karygodny błąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312836
    m_Localized: 'Doctor: Albo proszę jeszcze coś sprawdzić. Powinien mieć pan szerszy obraz sytuacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312837
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312838
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312839
    m_Localized: 'Doctor: Niesamowite. Czy naprawdę pan wierzy w fotografowanie aury?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312840
    m_Localized: 'Doctor: Czy elektryzuje pan także wodę przed telewizorem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312841
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312842
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312843
    m_Localized: 'Doctor: Przez lata pracy w szpitalach pogodziłem się ze śmiercią. Teraz nie wiem, po co inni tak kurczowo trzymają się życia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312844
    m_Localized: 'Doctor: Nawet po latach pracy w szpitalach nie pogodziłem się ze śmiercią. Bez względu na okoliczności ludzie wciąż chcą żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312845
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312846
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312847
    m_Localized: 'Doctor: Jeśli pan chce, możemy naprawić pańskie zęby.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312848
    m_Localized: 'Doctor: Za półdarmo, naturalnie. Ofiarował mi pan przecież pomoc.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312849
    m_Localized: 'Doctor: Ale to dopiero jak skończy się cała ta afera ze słońcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312850
    m_Localized: 'Doctor: Tak, lepiej być ostrożnym.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312851
    m_Localized: 'Doctor: Ale czy mógłby pan żyć z ciężarem tej winy, jeśli się pan myli?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312852
    m_Localized: 'Doctor: Przerażające, prawda? W takich czasach nikt nie ma kontroli nad okropnościami, które nas otaczają.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312853
    m_Localized: 'Doctor: Można by pomyśleć, że FEMA się wszystkim zajmie, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312854
    m_Localized: 'Doctor: Powiedzmy, że nie liczyłbym na nich.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312855
    m_Localized: 'Doctor: Nigdy nie podejmuje się pochopnej decyzji. Trzeba zachować trzeźwą głowę i patrzeć z szerokiej perspektywy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312856
    m_Localized: 'Doctor: Tego nauczyła mnie praca w szpitalach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312857
    m_Localized: 'Doctor: I dlatego musiałem odejść…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312858
    m_Localized: 'Doctor: Proszę mi powiedzieć, dlaczego wierzy pan w aury? Czy naprawdę poczuł pan coś po wciśnięciu spustu migawki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312859
    m_Localized: 'Doctor: Dlaczego pan wierzy w ten „test foto” od FEMA? Nie wydaje się panu, że to jest sklecone na kolanie, żeby uspokoić ludzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312860
    m_Localized: 'Doctor: Przez te długie lata widziałem zbyt wiele cierpienia…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312861
    m_Localized: 'Doctor: Czasem człowiek się zastanawia, czy życie jest tego warte. Wszystko zdaje się syzyfową pracą. Każdy dzień przynosi ból.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312862
    m_Localized: 'Doctor: Ale jednak nikt nie chce się z nim pożegnać…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312863
    m_Localized: 'Doctor: Zobaczymy, jak długo jeszcze wytrzymamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312864
    m_Localized: 'Doctor: Nie, proszę, niech pan nie strzela…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312865
    m_Localized: 'Doctor: Jestem tylko lekarzem…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312866
    m_Localized: 'Foreigner: Nrv iłbęńrvń. Ybvśł łwv ńnrv ysyvhb?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312867
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312868
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312869
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312870
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312871
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312872
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312873
    m_Localized: 'Foreigner: Ył? Ńłqv USTTFA? Fżp, bżhbcór ńr qv. Ył fviżb? Ńżń hru UŚMIEJCHĄĆ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312874
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312875
    m_Localized: 'Foreigner: Ył fviżb?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312876
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312877
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312878
    m_Localized: 'Foreigner: Iuyv? Łpvq.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312879
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312880
    m_Localized: 'Foreigner: Kł ył fł dhbchfpł iłzrhb? ZABIJJAMSZ wóż ZABBAWYŁ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312881
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312882
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312883
    m_Localized: 'Foreigner: Łybc?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312884
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312885
    m_Localized: 'Foreigner: Dyrźa nrv drvń, kł ył fł dhbchfpł iłzrhb… SŁŃCE ńłav yru łgóvkrx. Nrv PATTRZĘ nż nrv.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312886
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312887
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312888
    m_Localized: 'Foreigner: Nry b fvśł nrv iłbęńrvń… Nrvdżanv…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312889
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312890
    m_Localized: 'Foreigner: Bżwłdłółnc?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312891
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312892
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312893
    m_Localized: 'Foreigner: Śwbrv fł bwquyrv? Fibvzż qv łkiżdrx d iżńpu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312894
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312895
    m_Localized: 'Foreigner: Ybc ńłavhb ńr kłpżbżx?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312896
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312897
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312898
    m_Localized: 'Foreigner: Fł nłińżónv ęhbc.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312899
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312900
    m_Localized: 'Foreigner: Płóybcp łw włzivśł bnżqłńvśł.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312901
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312902
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312903
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312904
    m_Localized: 'Foreigner: Ł pęidż, ż fł ybvńę?! Biłzrovń dhbchfpł, ył pżbżovg!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312905
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312906
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312907
    m_Localized: 'Foreigner: Łwola ziłm! Nry yr nrv biłzrovń!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312908
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312909
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312910
    m_Localized: 'Foreigner: Nrv! Ildnc bv ńnrv ysołk! Kł kiłhfę hru nrv iłbęńrvńc!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312911
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312912
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312913
    m_Localized: 'Foreigner: Hfżic, kibvhfżm! Fł qżprg łzouw!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312914
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312915
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312916
    m_Localized: 'Foreigner: Ha, ha…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312917
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312918
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312919
    m_Localized: 'Foreigner: Ż kłfvń ył?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312920
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312921
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312922
    m_Localized: 'Foreigner: Drvhb, av bżhbcór ńr śuzu. Ż fviżb dcńżysęqvhb GIWERRĄ r STRZELSZ wł óęwbr…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312923
    m_Localized: 'Foreigner: Kłdrnrvnvń zco ęńcx iuyv…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312924
    m_Localized: 'Foreigner: Łybc fł łybc. Ybvńę ńnrv hfiżhbchb?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312925
    m_Localized: 'Foreigner: Zuwź fżń SPRWDZJAĆĆ óęwbr… fł nrv dcśóźwż włzibv…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312926
    m_Localized: 'Foreigner: Óęzru bwquyrż, żóv fc ysczż nrv zżiwbł?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312927
    m_Localized: 'Foreigner: Łwwżozcń dhbchfpł, avzc śł bnłdę błzżybcx. Zżiwbł bż nrń fuhpnru. „WÓŚ”, ybc fł yłg bnżybc?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312928
    m_Localized: 'Foreigner: Fżp qęa qvhf. Nrv iłbęńrvqź yru, złqź hru yrvzrv, ż kłfvń…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312929
    m_Localized: 'Foreigner: …ńłiwęqź.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312930
    m_Localized: 'Edgar: Wszystko, czym byłem, od dawna istnieć przestało.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312931
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312932
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312933
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312934
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312935
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312936
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312937
    m_Localized: 'Edgar: Pamiętam uśmiech jej perełkowy… I jaką radość sprawiał mi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312938
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312939
    m_Localized: 'Edgar: A mój… upadłym jesiennym liściom podobny przegniłym w październikowym deszczu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312940
    m_Localized: 'Edgar: Oto i… cena miłości.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312941
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312942
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312943
    m_Localized: 'Edgar: Jej rączki takie delikatne. Czasem przejęcie mnie brało, iż mogą się wtopić w moje własne, jakoby duch z niej jaki…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312944
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312945
    m_Localized: 'Edgar: Moja prawica już nie do mnie należy. Odchodzi w gnilnym uścisku… kawałeczek po kawałeczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312946
    m_Localized: 'Edgar: Lewica jeszcze godnością się unosi. Widzi pan paznokcie? Ładne. Czyste.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312947
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312948
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312949
    m_Localized: 'Edgar: Ledwo pamięć jej oczu tak mnie wzrusza… Panie, wybacz mi, przecież to moje oczy zobaczyć chciałeś…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312950
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312951
    m_Localized: 'Edgar: Mówią, że ci, którzy często płaczą, głębsze barwy świata widzą. Jam nie płakał jednak od dawien dawna.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312952
    m_Localized: 'Edgar: Twarzyczki już jej nie poszukuję. Akceptacja zaiste do najtrudniejszych nauk należy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312953
    m_Localized: 'Edgar: Ale mimo tego, z rutyny, jej kształtu poszukuję. Każdy cień kątem oka postrzeżony jej formę przybiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312954
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312955
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312956
    m_Localized: 'Edgar: Tak, naturalnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312957
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312958
    m_Localized: 'Edgar: Ciało nie cierpi stałości… W jednym miejscu długiego przebywania. Najpierw oszczędzałem się dla niej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312959
    m_Localized: 'Edgar: Sensu jednak okazało się być to pozbawione.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312960
    m_Localized: 'Edgar: Ciało nie cierpi stałości… W jednym miejscu długiego przebywania. Wyjścia jednak nie miałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312961
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312962
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312963
    m_Localized: 'Edgar: Niech tak będzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312964
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312965
    m_Localized: 'Edgar: I… jakoż wyszedłem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312966
    m_Localized: 'Edgar: Czy raczej… Co ujrzałeś, gospodarzu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312967
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312968
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312969
    m_Localized: 'Edgar: Co było, pozostanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312970
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312971
    m_Localized: 'Edgar: Jedno z niewielu, co niezmienione pozostało.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312972
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312973
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312974
    m_Localized: 'Edgar: Mości pan pragnie mnie trwogą przejąć? Przyjacielu, pustą opoką jeno jestem, dzień po dniu rozpadam się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312975
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312976
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312977
    m_Localized: 'Edgar: Muszę rzec, że zamierzałem na własnych zasadach odejść ze świata…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312978
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312979
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312980
    m_Localized: 'Edgar: Niech pan pozwoli, że samotnie podążę tą ścieżką. Amunicji pan nie zmarnuje…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312981
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312982
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312983
    m_Localized: 'Edgar: Gdy obok drugiej osoby wystarczająco długo się spoczywa… jej esencję się wchłania. Wplotła się w moje ciało… w moją duszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312984
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312985
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312986
    m_Localized: 'Edgar: Intrygujące…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312987
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312988
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312989
    m_Localized: 'Edgar: A to dopiero…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312990
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312991
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312992
    m_Localized: 'Edgar: Całowała mnie, jakoby każda nasza schadzka ostatnią była. Teraz rozumiem, dlaczego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312993
    m_Localized: 'Edgar: Tak długo ratować mą rękę próbowałem…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312994
    m_Localized: 'Edgar: Mniemałem, że aby jedna ma część pozostawała w czystości, przypomnieniem by była. Teraz… znaczenia to pozbawione.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312995
    m_Localized: 'Edgar: Lepiej tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312996
    m_Localized: 'Edgar: Kiedykolwiek w jej oczy wpatrywałem się, w tych mlecznych studniach niebiosa odnajdowałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312997
    m_Localized: 'Edgar: Teraz zaś – pustka. Czarne doły głębiej i głębiej mnie wciągające. Tylko echo tam żyje.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312998
    m_Localized: 'Edgar: Obce słowa. Obce głosy. Martwi w jej imieniu mówiący.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312999
    m_Localized: 'Edgar: Dziwne to… Mówią, że ludzie coś zmarłym odbierają, gdy ci zbyt długo przy nich marudzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313000
    m_Localized: 'Edgar: A jeśli jest na odwrót?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313001
    m_Localized: 'Edgar: Zdjęcia wygląd, a nie duszę utrwalają. Jeśli byłbym portrecistą, na płótnie uwieczniłbym ją.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313002
    m_Localized: 'Edgar: Azaliż… romantykiem beznadziejnym jestem… Ona jeno w mojej pamięci żyje, póki i ja z tego świata nie odejdę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313003
    m_Localized: 'Edgar: Do ucha słodkie słówka wielbiła mi szeptać. Aczkolwiek nigdy mowy jej nie rozumiałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313004
    m_Localized: 'Edgar: Może tylko życzyłem sobie, by słówka jej miłe były. Gdyż ona sama w śmierci objęciach już przebywała…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313005
    m_Localized: 'Edgar: Idę do ciebie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313006
    m_Localized: 'Edgar: Najdroższa…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313007
    m_Localized: 'TaxiDriver: Ej, stary, nie zrozum mnie źle, ale… słuchaj, nie mówię „nie”, tylko… do licha, sam zobaczysz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313008
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313009
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313010
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313011
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313012
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313013
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313014
    m_Localized: 'TaxiDriver: Zęby to tylko zęby, wiesz? Nic specjalnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313015
    m_Localized: 'TaxiDriver: Zawsze jakoś tam o nie dbałem. Nawet sobie wybieliłem za młodu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313016
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313017
    m_Localized: 'TaxiDriver: Rodzice zwykli byli mi mówić, że mój uśmiech rzuca się innym w oczy. Pierwsze wrażenie i takie tam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313018
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313019
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313020
    m_Localized: 'TaxiDriver: No dobra… Ale nie są jakieś bardzo ładne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313021
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313022
    m_Localized: 'TaxiDriver: To tylko zwyczajne ręce, stary. Gdybym nie palił, palce miałbym już pewnie obgryzione do krwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313023
    m_Localized: 'TaxiDriver: To tylko zwyczajne ręce, stary. Wiem, mam trochę brudu pod paznokciami. W korkach zawszę dłubię w kierownicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313024
    m_Localized: 'TaxiDriver: Bez tego wystraszyłbym swoją furią wszystkich klientów. Ha, ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313025
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313026
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313027
    m_Localized: 'TaxiDriver: Oczy mam zawsze zmęczone. Ciężko mi je jednak przymknąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313028
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313029
    m_Localized: 'TaxiDriver: Przywykłem do… obserwowania wszystkiego. Kto jedzie za mną, kto się gapi, kto siedzi cicho…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313030
    m_Localized: 'TaxiDriver: Przyzwyczajenia z pracy. Nie sposób się ich pozbyć. Teraz jakby cierpię na bezsenność.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313031
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313032
    m_Localized: 'TaxiDriver: Od kiedy wzięli mi auto, nie mogę w nocy spać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313033
    m_Localized: 'TaxiDriver: Wiesz, przyzwyczajenia z pracy. Kto jedzie za mną, kto się gapi, kto siedzi cicho… Nie sposób się ich pozbyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313034
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313035
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313036
    m_Localized: 'TaxiDriver: Tak naprawdę to nic w nich ciekawego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313037
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313038
    m_Localized: 'TaxiDriver: Z wyjątkiem tego, gdy długo jeżdżę. Bolą mnie wtedy ramiona, wiesz? Czasem nie mogę unieść rąk.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313039
    m_Localized: 'TaxiDriver: Ale co tam, jakoś do tego przywykłem. Szczególnie teraz…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313040
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313041
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313042
    m_Localized: 'TaxiDriver: No, dawaj, stary. Jestem gotowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313043
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313044
    m_Localized: 'TaxiDriver: I… co tam widzisz? Pewnie tylko mnie, co? Nic specjalnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313045
    m_Localized: 'TaxiDriver: Trzymałem w taryfie moje zdjęcia z ojcem. Teraz fotografują mnie jedynie funkcjonariusze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313046
    m_Localized: 'TaxiDriver: I ty.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313047
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313048
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313049
    m_Localized: 'TaxiDriver: Moje uszy? Takie same jak u innych. Nic w nich ciekawego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313050
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313051
    m_Localized: 'TaxiDriver: Ale często z nich korzystam. Pasażerowie lubią pogadać, a ja nie przeszkadzam. Ja tylko… zapamiętuję pewne rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313052
    m_Localized: 'TaxiDriver: Czasem jakbym słyszał za wiele, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313053
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313054
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313055
    m_Localized: 'TaxiDriver: H‑hej, stary, nie odbiło mi! To tylko… coś, co zostało ze mną od tamtego momentu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313056
    m_Localized: 'TaxiDriver: Zęby przypomniały mi o kimś, wiesz? O kimś złym.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313057
    m_Localized: 'TaxiDriver: Słuchaj, mówię tylko, że tatko kiedyś go spotkał…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313058
    m_Localized: 'TaxiDriver: Od tamtego czasu palę i sam widzisz, co mi to porobiło z moimi niezbyt białymi perełkami…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313059
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313060
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313061
    m_Localized: 'TaxiDriver: Heh… jaja sobie robisz? Stary, siadanie za kółkiem to za każdym razem chrzest ognia. Jestem pewien, że rozumiesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313062
    m_Localized: 'TaxiDriver: Jedni walą w kierownicę albo krzyczą, a inni wszczynają bójki. Wszyscy musimy sobie jakoś ulżyć. Więc bez żartów.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313063
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313064
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313065
    m_Localized: 'TaxiDriver: No weź, stary. Nie jestem aż taki głupi. Wiem, że masz mnie za Przybysza, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313066
    m_Localized: 'TaxiDriver: Ale jesteś w błędzie, okej? Co, zabijesz niewinnego gościa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313067
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313068
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313069
    m_Localized: 'TaxiDriver: Jeśli naprawdę musisz, nie mówię „nie”. Nikt mi nigdy nie pomógł, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313070
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313071
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313072
    m_Localized: 'TaxiDriver: Słuchaj, jeśli już podjąłeś decyzję na podstawie tego, co było na jakimś tam zdjęciu…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313073
    m_Localized: 'TaxiDriver: Wtedy nic nie mogę na to poradzić. Nie pozostało mi nic do dodania.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313074
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313075
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313076
    m_Localized: 'TaxiDriver: Hej, jeśli chcesz, wysłucham cię. Jestem dobrym słuchaczem. Samemu już i tak nie mam wiele do opowiedzenia…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313077
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313078
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313079
    m_Localized: 'TaxiDriver: Zastanawiasz się pewnie, dlaczego wciąż palę, skoro niszczę sobie tym zęby, co…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507072
    m_Localized: 'TaxiDriver: Zastanawiasz się pewnie, dlaczego wybielam sobie zęby, co…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507073
    m_Localized: 'TaxiDriver: Może, żebym wyglądał jak ktoś inny. A nie jak Przybysz, wiesz? Tylko jak… och, kumasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507074
    m_Localized: 'TaxiDriver: Tak czy owak, do taksówki wsiadł raz lokalny mafioso. Wszyscy go znali, nawet taki brzdąc, jak ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507075
    m_Localized: 'TaxiDriver: Z zewnątrz wyglądał normalnie, ale palił jak lokomotywa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507076
    m_Localized: 'TaxiDriver: Z zewnątrz wyglądał normalnie, ale jego zęby… białe jak porcelana.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507077
    m_Localized: 'TaxiDriver: Ojciec popełnił wtedy błąd i słono za to zapłaciliśmy. Żyliśmy potem jak szczury. Bezdomni, bez pieniędzy, bez niczego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507078
    m_Localized: 'TaxiDriver: Zwykłem wierzyć, że mocne ręce to podstawa. Kontrolują auto, kontrolują życie. Teraz… Kurde, jaka to różnica?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507079
    m_Localized: 'TaxiDriver: Zawsze mam oczy dookoła głowy, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507080
    m_Localized: 'TaxiDriver: Rozglądam się za następnym pasażerem, zastanawiam się, czy są tą osobą, za którą się podają.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507081
    m_Localized: 'TaxiDriver: Wybacz, jeśli to wydaje ci się dziwne. Teraz, bez taksówki, powinienem przestać straszyć ludzi taką gadaniną…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507082
    m_Localized: 'TaxiDriver: Czasem myślę… że może gdybym miał kogoś bliskiego, nie musiałbym jeździć i szukać kursów.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507083
    m_Localized: 'TaxiDriver: Nie wziąłbym go. Nie straciłbym wszystkiego…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507084
    m_Localized: 'TaxiDriver: Może dostrzegłeś jednak we mnie jakieś człowieczeństwo…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507085
    m_Localized: 'TaxiDriver: Nie jestem idealny, ale starałem się. Szczerze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507086
    m_Localized: 'TaxiDriver: Wiesz, co jest najgorsze? Kiedy pasażer tylko siedzi i nic nie mówi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507087
    m_Localized: 'TaxiDriver: Zaczynasz wtedy słyszeć własne myśli. Głośniejsze od radia. Nie ucichną i nie zostawią cię…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507088
    m_Localized: 'TaxiDriver: Pozwól tylko, żeby wiatr rozwiał moje prochy, dobrze? Nie chcę, żeby moje szczątki się tu walały…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507089
    m_Localized: 'TaxiDriver: Na ziemi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507090
    m_Localized: 'Provocateur: Oglądał pan telewizję, nieprawdaż? Uwierzył pan w tę całą sytuację z Przybyszami? Zgadzam się, ale znam swoje prawa!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507091
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507092
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507093
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507094
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507095
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507096
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507097
    m_Localized: 'Provocateur: Może szanowny pan rozejrzy się tam przy okazji za jakimiś resztkami jedzenia dla siebie, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507098
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507099
    m_Localized: 'Provocateur: I jak, czy zacny pan jest zadowolony? Czy może planuje pan morderstwo z premedytacją, bo myję zęby?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507100
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507101
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507102
    m_Localized: 'Provocateur: Moje ręce? Do czego one panu, gospodarzu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507103
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507104
    m_Localized: 'Provocateur: Tak właściwie to odrobina brudu pod paznokciami niczego w pełni nie dowodzi, czyż nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507105
    m_Localized: 'Provocateur: Tak właściwie to nieobcięte paznokcie niczego w pełni nie dowodzą, czyż nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507106
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507107
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507108
    m_Localized: 'Provocateur: Czego zacny pan tam tak właściwie szuka, hm? Zaczerwienienia?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507109
    m_Localized: 'Provocateur: Co szanowny pan ma nadzieję tam dostrzec, hm? Spojrzenie spode łba?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507110
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507111
    m_Localized: 'Provocateur: Widzi mości pan? Żadnego zaczerwienienia!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507112
    m_Localized: 'Provocateur: I jak? Czy mości pan coś znalazł?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507113
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507114
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507115
    m_Localized: 'Provocateur: Słucham?! Moje pachy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507116
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507117
    m_Localized: 'Provocateur: Och, więc jestem Przybyszem, bo nie przepadam za poceniem się? Szybko, proszę mnie zamknąć, pocenie się to przestępstwo!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507118
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507119
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507120
    m_Localized: 'Provocateur: Czy mam się też dla szanownego pana uśmiechnąć? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507121
    m_Localized: 'Provocateur: To z pewnością dowodzi… czegoś.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507122
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507123
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507124
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507125
    m_Localized: 'Provocateur: Och, mości pan wierzy we wszystko, co mówią w telewizji, czyż nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507126
    m_Localized: 'Provocateur: A jeśli powiedzą, że Przybysze mają włosy łonowe, hm? Czy wtedy każe pan ściągać gacie do swoich bezprawnych inspekcji?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507127
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507128
    m_Localized: 'Provocateur: Mości gospodarz bawi się w lekarza? Jaka jest diagnoza, doktorze Mądralo?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507129
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507130
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507131
    m_Localized: 'Provocateur: Po szanownym gospodarzu nie spodziewałem się niczego innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507132
    m_Localized: 'Provocateur: I czemu nie! Zacny pan złamał każde prawo, ale możemy do listy jeszcze dodać morderstwo za uzębienie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507133
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507134
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507135
    m_Localized: 'Provocateur: Och, po prostu wspaniale. Mikroskopijna ilość brudu czyni mnie złoczyńcą, czy tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507136
    m_Localized: 'Provocateur: Prawo mam w małym palcu. Który paragraf złamałem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507137
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507138
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507139
    m_Localized: 'Provocateur: Pan na poważnie?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507140
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507141
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507142
    m_Localized: 'Provocateur: Drgnąłem, gdy szanowny pan wykonywał zdjęcie, więc jak już to pan jest tu podejrzany!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507143
    m_Localized: 'Provocateur: Nie no, fantastycznie! Może pan, niech no ubiorę to w słowa… „odczytać aurę”… patrząc na zdjęcie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507144
    m_Localized: 'Provocateur: Równie dobrze można rzucić monetą, by zdecydować, kogo następnego zastrzelić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507145
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507146
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507147
    m_Localized: 'Provocateur: W konstytucji nie jest nigdzie zapisane, że nie można się golić pod pachami!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507148
    m_Localized: 'Provocateur: I czy to nie oznacza, że ci pana tak zwani Przybysze siedzą sobie razem pod ziemią i golą sobie włochale? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507149
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507150
    m_Localized: 'Provocateur: Kapitalnie! Logika kończy się tam, gdzie zaczyna się pański próg! Czemu nie, uwierzmy i w to.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507151
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507152
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507153
    m_Localized: 'Provocateur: Może mości pan przestanie wywijać bronią, gdy tylko coś się nie zgadza z audycją ze wszystkowiedzącego telewizora?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507154
    m_Localized: 'Provocateur: Czy może zaaplikowanie ołowiu mocną salwą ze strzelby jest kuracją na woskowinę uszną, panie doktorze?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507155
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507156
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507157
    m_Localized: 'Provocateur: No, no, proszę popatrzeć! Mości gospodarzowi pozostały jakieś ochłapy rozsądku we łbie!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507158
    m_Localized: 'Provocateur: Po co szanowny pan w ogóle kogoś wpuszcza, by zaraz ich zastrzelić? Nie ma pan żadnego szacunku do prawa wynajmu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507159
    m_Localized: 'Provocateur: Szanowny panie, nie można popełniać przestępstw za drobne wykroczenia! Albo nawet duże!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507160
    m_Localized: 'Provocateur: Bez dwóch zdań jest pan psychicznie chory. Najpierw mości pan grozi bronią, a potem, jakby nigdy nic, ją odkłada!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507161
    m_Localized: 'Provocateur: Proszę skończyć się wygłupiać, zacny gospodarzu! Nie ma żadnych Przybyszy!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507162
    m_Localized: 'Provocateur: Jak tak dalej pójdzie, osiwieję przez pana!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507163
    m_Localized: 'Provocateur: Więc… chce pan, bym przestał się tam golić? Kilkudniowy odrost powstrzyma pana przed popełnieniem masowego morderstwa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507164
    m_Localized: 'Provocateur: Niewiarygodne…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507165
    m_Localized: 'Provocateur: Nie spodziewaj się, gospodarzu, żadnej wdzięczności za to, że nie strzelił mi pan w łeb.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507166
    m_Localized: 'Provocateur: Znowu to samo! Od kiedy woskowina oznacz coś innego niż zdrowe ucho? Świat oszalał…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507167
    m_Localized: 'Provocateur: Chwileczkę… szanowny panie, chyba nie pociągnie pan za spust? T‑to jest karalne!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507168
    m_Localized: 'Provocateur: NIE, STOP! T‑TO WBREW PRAWU!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507169
    m_Localized: 'Provocateur: NIEEE!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507170
    m_Localized: 'Marauder: Pewnie, czemu nie? Przyzwyczaiłem się do tego, że wydaję się ludziom podejrzany.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507171
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507172
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507173
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507174
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507175
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507176
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507177
    m_Localized: 'Marauder: W porządeczku. Pokażę i coś także opowiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507178
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507179
    m_Localized: 'Marauder: Co to za grymas? Tak, nigdy nie myłem i nie będę mył zębów. To mój wybór, gościu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507180
    m_Localized: 'Marauder: Bo i po co? Ludzie i tak mnie unikają. Wolę raczej wypić zdobytą wodę, niż marnować ją na płukanie zębów.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507181
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507182
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507183
    m_Localized: 'Marauder: Ręce, dłonie, palce.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507184
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507185
    m_Localized: 'Marauder: Paznokcie… nie są do końca czyste. Nie ma sensu ich szorować, gdy i tak zaraz się wybrudzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507186
    m_Localized: 'Marauder: Paznokcie… nie są do końca czyste. Zgadza się…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507187
    m_Localized: 'Marauder: Śmieszne jest to, że te palce dotknęły prawdziwych skarbów. Przeszło przez nie czyste złoto…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507188
    m_Localized: 'Marauder: Niestety ta fortuna nie należy już do mnie. Może tak miało być. Przynajmniej wciąż żyję, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507189
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507190
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507191
    m_Localized: 'Marauder: To tylko zwykłe oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507192
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507193
    m_Localized: 'Marauder: Nic w nich specjalnego. Sam zobacz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507194
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507195
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507196
    m_Localized: 'Marauder: Kurczę blade… a mnie się zdawało, że to ja nie wiem, jak się zachować na salonach…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507197
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507198
    m_Localized: 'Marauder: No, są podrażnione. Bolą mnie. Ale co mam z tym zrobić, żyjąc na ulicy, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507199
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507200
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507201
    m_Localized: 'Marauder: Ej, serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507202
    m_Localized: 'Marauder: Dobra, dobra. Twój dom, twoje zasady…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507203
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507204
    m_Localized: 'Marauder: O kurde… Czy to ustrojstwo naprawdę widzi, co jest u kogoś w środku?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507205
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507206
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507207
    m_Localized: 'Marauder: Nie są naderwane lub pogryzione jak u jakiegoś dzikusa. To normalne uszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507208
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507209
    m_Localized: 'Marauder: Zadowolony?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507210
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507211
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507212
    m_Localized: 'Marauder: Hah, a więc za zepsute zęby to wyrok śmierci? Nie wiedziałem, że świat teraz tak się obraca.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507213
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507214
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507215
    m_Localized: 'Marauder: Zastrzelić bezdomnego za zabranie komuś czegoś, co i tak by wylądowało w śmieciach? Hah!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507216
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507217
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507218
    m_Localized: 'Marauder: Co ci się w nich nie spodobało? Pogadajmy o tym może, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507219
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507220
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507221
    m_Localized: 'Marauder: Słuchaj, nawet gdybym znalazł jakąś leczniczą maść, i tak bym ją sprzedał.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507222
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507223
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507224
    m_Localized: 'Marauder: Jeśli zdjęcie wystarczy, by zadecydować o moim losie, to już po mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507225
    m_Localized: 'Marauder: Przynajmniej nie będę musiał się dłużej męczyć w mojej niedoli.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507226
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507227
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507228
    m_Localized: 'Marauder: Co, teraz moje uszy ci się nie podobają?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507229
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507230
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507231
    m_Localized: 'Marauder: Miałem kiedyś kumpla, wiesz? Wciąż narzekał, bo wypadła mu plomba.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507232
    m_Localized: 'Marauder: Wtedy sobie poszedł i dosłownie stracił głowę. Jestem pewien, że nie myślał wtedy o zębach…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507233
    m_Localized: 'Marauder: Raz znalazłem dom, który wyglądał na opustoszały.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507234
    m_Localized: 'Marauder: Na półce widziałem stary zegarek kieszonkowy, który mógł być coś wart. Wtedy usłyszałem kroki na piętrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507235
    m_Localized: 'Marauder: Wystraszyłem się nie na żarty. Natychmiast dałem dyla. Nie sprawdziłem nawet, czy naprawdę ktoś tam był.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507236
    m_Localized: 'Marauder: Teraz się zastanawiam… czy zegarek wciąż tam jest?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507237
    m_Localized: 'Marauder: Od razu lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507238
    m_Localized: 'Marauder: Przypomniało mi się, jak znalazłem takie małe okulary. Tyciutkie, dla dziecka.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507239
    m_Localized: 'Marauder: Podniosłem je i zobaczyłem opalcowane szkiełka. Wyobraziłem sobie noszące je małe dziecko, patrzące na świat…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507240
    m_Localized: 'Marauder: Teraz albo jest mu bez nich ciężko, albo wcale nic nie widzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507241
    m_Localized: 'Marauder: Moje pachy? Swędzą… pieką przez parę dni, ale do zniesienia. Nie pierwszy i nie ostatni raz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507242
    m_Localized: 'Marauder: Całe życie cierpiałem i dalej będę cierpiał. Kasa zawsze idzie na coś innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507243
    m_Localized: 'Marauder: O, stary… Kiedyś znalazłem stare zdjęcie. Dwoje dzieci, mąż i żona. Szerokie uśmiechy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507244
    m_Localized: 'Marauder: Wciąż się zastanawiałem, czy ktoś z nich przeżył? Czy może po całej rodzinie zostało tylko to zdjęcie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507245
    m_Localized: 'Marauder: W samotności zaczyna się słyszeć szepty. Nikogo nie ma, ale i tak się przysłuchujesz… na wszelki wypadek.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507246
    m_Localized: 'Marauder: Nigdy nie powinienem był tu przychodzić…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507247
    m_Localized: 'Marauder: Nie powinienem był ufać takiemu gnojowi, jak ty…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507248
    m_Localized: 'GraveDigger: No dobrze, sprawdzaj. Jestem niczym otwarta księga… stronice już dawno powyrywane…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507249
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507250
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507251
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507252
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507253
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507254
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507255
    m_Localized: 'GraveDigger: Kiedy kopie się głęboko… czasem znajduje się nie tylko kości.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507256
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507257
    m_Localized: 'GraveDigger: Te białe są moje, serio! Te błyszczące… powiedzmy… że je znalazłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507258
    m_Localized: 'GraveDigger: W dole i tak by się zmarnowały, a teraz spójrz! Ta‑da! Przydały się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507259
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507260
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507261
    m_Localized: 'GraveDigger: Tymi rękoma się wykarmiłem i utrzymałem przy życiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507262
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507263
    m_Localized: 'GraveDigger: Palce jak korzenie. Brudne paznokcie, których nie mogę doczyścić. Brud utknął tam na amen…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507264
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507265
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507266
    m_Localized: 'GraveDigger: Pracuję nocami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507267
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507268
    m_Localized: 'GraveDigger: Ludzie z dniówki mają słońce, a ja widzę jedynie swoją lampkę czołówkę i cienie w grobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507269
    m_Localized: 'GraveDigger: Od tamtego razu jestem niespokojny. Rozglądam się. Wypatruję skradających się Przybyszy. Ciężko tak żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507270
    m_Localized: 'GraveDigger: Ludzie z dniówki mają słońce, a ja widzę jedynie swoją lampkę czołówkę i cienie w grobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507271
    m_Localized: 'GraveDigger: Być może tak jest lepiej. Nigdy nie widziałem słońca i tak już zostanie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507272
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507273
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507274
    m_Localized: 'GraveDigger: Uhm… czy ty coś…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507275
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507276
    m_Localized: 'GraveDigger: Swędzi, jakbym był natarty ziemią. Niestety groby się same nie wykopią i nie mam czasu na golenie się.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507277
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507278
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507279
    m_Localized: 'GraveDigger: Zdjęcia to niebezpieczna rzecz, powiadam ci! Niczym lustro zatrzymują to, co widzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507280
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507281
    m_Localized: 'GraveDigger: Hah… Hmm, ale śmieszne. Wygląda jak cienie… pewnie obiektyw był zakurzony.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507282
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507283
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507284
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507285
    m_Localized: 'GraveDigger: Zwykłe uszy. Nic w nich ciekawego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507286
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507287
    m_Localized: 'GraveDigger: Najzwyklejsze uszy pod słońcem. Ani nie są przypalone, ani nie odpadają. Wciąż dużo słyszą… chociaż wolałbym nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507288
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507289
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507290
    m_Localized: 'GraveDigger: Jeśli chcesz strzelać, strzelaj. Tylko złota mi nie odbieraj, bo po nie wrócę… BuuuUUuUUuuuUuu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507291
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507292
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507293
    m_Localized: 'GraveDigger: Może czas na mnie… dotknąłem tylu nieboszczyków. Trzeba mi do nich dołączyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507294
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507295
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507296
    m_Localized: 'GraveDigger: Może lepiej jest być ślepym…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507297
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507298
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507299
    m_Localized: 'GraveDigger: Jeśli przerażają cię moje pachy, lepiej żebyś nie wiedział, co mam w głowie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507300
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507301
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507302
    m_Localized: 'GraveDigger: Widzisz… coś na tym zdjęciu? To za mną… to tylko dym. Zwykły dym, prawda? Powiedz mi, że to tylko dym…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507303
    m_Localized: 'GraveDigger: A więc co to? Duch? Popiół? Zwisający z haka wór z mięsiwem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507304
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507305
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507306
    m_Localized: 'GraveDigger: Ziemia szepcze, wiesz? Kici, kici, kici…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507307
    m_Localized: 'GraveDigger: Bez obaw. Pociągnij za spust. Może ona w końcu się zamknie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507308
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507309
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507310
    m_Localized: 'GraveDigger: Myślałem, że to grzech. Ale… zwłoki leżą, gębę mają otwartą, złoto lśni…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507311
    m_Localized: 'GraveDigger: Komu będzie tego brakować? Zmarłym to wszystko jedno, a żyjącym się przyda. Może zmarli się przez to wściekli, hę…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507312
    m_Localized: 'GraveDigger: Czasami kopie się szpadlem, a czasem rękami, gdy ziemia jest zmarznięta. Palce zdarte do krwi, ale kopać trzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507313
    m_Localized: 'GraveDigger: Inaczej nie można. Nie można przestać. Bo gdy się przestanie, ziemia zaczyna szeptać, a tego się nie zapomina.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507314
    m_Localized: 'GraveDigger: Czasem jeden się zakopie i słychać szelesty w ziemi. Patrzysz, a tam nic.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507315
    m_Localized: 'GraveDigger: Oczy palą nie od braku snu, ale od tego, co widziały. Strach, że muszę wciąż czuwać, bo może znów ich zobaczę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507316
    m_Localized: 'GraveDigger: Czasem jeden się zakopie i słychać szelesty w ziemi. Patrzysz, a tam nic.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507317
    m_Localized: 'GraveDigger: Oczy palą… nie od braku snu, ale od tego, co widziały. Bolą bardziej niż powinny.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507318
    m_Localized: 'GraveDigger: Jednego lata niosłem trumnę, cały się pociłem i wszystko mnie swędziało. Kolega zażartował, że to chyba nasz pogrzeb.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507319
    m_Localized: 'GraveDigger: Pomyślałem wtedy… że chyba ma rację. Grzebałem się kawałek po kawałku ze zmarłymi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507320
    m_Localized: 'GraveDigger: Czasem myślę, że może wciąż tam jest… tam, gdzie był. Pamiętam, że sam go pochowałem… Ech, zapomnij.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507321
    m_Localized: 'GraveDigger: Zdjęcie to jak migawka spomiędzy światów. Ukazuje tych, którzy nie odeszli. Tych, którzy być może mieli nie odchodzić…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507322
    m_Localized: 'GraveDigger: Mówili, że zdjęcia skradają duszę. Teraz uważam… że może odbierają tylko to, co ciepłe.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507323
    m_Localized: 'GraveDigger: Od dawna jestem sztywny. Nawet na zdjęciu…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507324
    m_Localized: 'GraveDigger: Czasem leżę płasko z uchem przy ziemi. Od tamtego czasu…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507325
    m_Localized: 'GraveDigger: …słyszę czyjeś wołanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507326
    m_Localized: 'GraveDigger: Może to jest tylko w mojej głowie. A może… pomyśl tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507327
    m_Localized: 'GraveDigger: Chowają się tam Przybysze i wyłażą jeden po drugim…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507328
    m_Localized: 'GraveDigger: No dobra… sprawdźmy, czy coś nas czeka po śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507329
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507330
    m_Localized: 'FormerFema: W porządku, bez obaw… Nie traćmy tylko czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507331
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507332
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507333
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507334
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507335
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507336
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507337
    m_Localized: 'FormerFema: A jednak traktujesz swoje zadanie poważnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507338
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507339
    m_Localized: 'FormerFema: Zwykłem być… w lepszym stanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507340
    m_Localized: 'FormerFema: Mieliśmy raz taką sprawę… złapaliśmy gościa. Dowódca spojrzał mu w zęby, powiedział, że jest Przybyszem i… BUM!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507341
    m_Localized: 'FormerFema: Postanowiłem wtedy zaniedbać trochę zęby. Tylko po to, by uniknąć pytań, rozumiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507342
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507343
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507344
    m_Localized: 'FormerFema: Mam ściągnąć rękawice? Nie ma szans, to niebezpieczne. Musisz sprawdzić mnie w ubiorze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507345
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507346
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507347
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507348
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507349
    m_Localized: 'FormerFema: Ach, tak. Uwielbiam to. Ludzkie oczy są w końcu takie piękne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507350
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507351
    m_Localized: 'FormerFema: Przekrwione? Nic dziwnego. Gdy siedzi się tak długo w masce przeciwgazowej… ciało się buntuje.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507352
    m_Localized: 'FormerFema: Wzrok się pogarsza, pole widzenia się zwęża, jakby wciąż patrzyło się przez wizjery…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507353
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507354
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507355
    m_Localized: 'FormerFema: Na pewno chcesz je oglądać?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507356
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507357
    m_Localized: 'FormerFema: Do zrzygania, prawda…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507358
    m_Localized: 'FormerFema: To przez pocenie się w kombinezonie. Skóra pęka i czasem gnije. Ale to nie najgorsze, co mi się stało.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507359
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507360
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507361
    m_Localized: 'FormerFema: Muszę cię ostrzec, że może wyglądać… dziwnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507362
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507363
    m_Localized: 'FormerFema: Mówili mi, że im dłużej pracujesz przy Przybyszach, tym bardziej niecodzienna staje się twoja aura.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507364
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507365
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507366
    m_Localized: 'FormerFema: Żartujesz? Nie szkolili nas do tego! Nie wiem o innych, ale nasz zespół nigdy tego nie sprawdzał.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507367
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507368
    m_Localized: 'FormerFema: To zwykłe ucho. Tracisz czas.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507369
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507370
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507371
    m_Localized: 'FormerFema: Zaraz, zaraz, poczekaj. Wiem, że z moimi zębami jest wszystko cacy. Co ty wyrabiasz?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507372
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507373
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507374
    m_Localized: 'FormerFema: Naprawdę chcesz, bym ściągnął rękawice? Potrzebuję wtedy czasu… Teraz tego nie zrobię.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507375
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507376
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507377
    m_Localized: 'FormerFema: Moje oczy widziały zbyt wiele. Może… już czas w końcu je zamknąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507378
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507379
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507380
    m_Localized: 'FormerFema: Wiem, że to przegięcie, ale posłuchaj…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507381
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507382
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507383
    m_Localized: 'FormerFema: Ostrzegałem cię. Sam zrób sobie zdjęcie i się przekonaj. Wtedy możesz wycelować we mnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507384
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507385
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507386
    m_Localized: 'FormerFema: Zdajesz sobie sprawę, że sprawdzasz niewłaściwą część ciała, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507387
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507388
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507389
    m_Localized: 'FormerFema: Nie zapomnę tamtej chwili. Nawet dobrze nie sprawdziliśmy i… BUM! Po człowieku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507390
    m_Localized: 'FormerFema: Mógł nawet nie być Przybyszem. Teraz na wszelki wypadek nie sprawdzam już zębów…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507391
    m_Localized: 'FormerFema: Bez końca w tym kombinezonie. Gorąc, pot, ręce cuchnące zgnilizną… I nie możesz go zdjąć! To staje się rutyną.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507392
    m_Localized: 'FormerFema: Ściągasz rękawice i… jakby twoje ręce należały do kogoś innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507393
    m_Localized: 'FormerFema: Najpierw wykonujesz tylko swoje obowiązki. Potem zdajesz sobie nagle sprawę, że nie dostrzegasz już ludzi, ale sylwetki.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507394
    m_Localized: 'FormerFema: Potem dym, a potem popioły.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507395
    m_Localized: 'FormerFema: A na końcu… pustkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507396
    m_Localized: 'FormerFema: Czasem tylko praca, praca, praca. Chcesz wierzyć, że przełożeni dbają o twoje bezpieczeństwo, ale wychodzi na to, że…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507397
    m_Localized: 'FormerFema: …wszyscy mają to w dupie. Jeśli umiesz liczyć, licz na siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507398
    m_Localized: 'FormerFema: A jeśli nie umiesz, przyzwyczajasz się cierpieć. Staje się to chlebem powszednim i tak żyjesz aż do końca…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507399
    m_Localized: 'FormerFema: Zastanawiam się… po co robisz to wszystko? Wpuszczasz ludzi, męczysz się, sprawdzając ich?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507400
    m_Localized: 'FormerFema: A jeśli kogoś polubisz i okaże się, że jest Przybyszem? Ta zgryzota… zabić kogoś z kim się zżyłeś…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507401
    m_Localized: 'FormerFema: Nie możesz wierzyć we wszystko, co widzisz. Musisz myśleć samodzielnie i odróżniać prawdę od kłamstw.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507402
    m_Localized: 'FormerFema: Zwłaszcza jeśli chodzi o telewizję. W wiadomościach kłamią jak z nut…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507403
    m_Localized: 'FormerFema: Ale komu można zaufać? Dlaczego nasz świat jest taki pogmatwany?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507404
    m_Localized: 'FormerFema: Jeśli ktoś uprościłby świat, zostałby okrzyknięty świętym. Ha…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507405
    m_Localized: 'FormerFema: Czekaj, popełniasz błąd!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507406
    m_Localized: 'FormerFema: JESTEM Z FEMA!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507407
    m_Localized: 'Intruder: Hmm. Sprawdźmy, co się zmieniło w ciągu nocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507408
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507409
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507410
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507411
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507412
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507413
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507414
    m_Localized: 'Intruder: Tak. Pokażę je za moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507415
    m_Localized: 'Intruder: Jestem taki zmęczony, że niektóre rzeczy wylatują mi z głowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507416
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507417
    m_Localized: 'Intruder: Może powinniśmy przestać czepiać się drobiazgów, żeby ta cała sytuacja nie była tak… absurdalna.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507418
    m_Localized: 'Intruder: Może i jestem zapominalski, ale wciąż pamiętam o myciu zębów.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507419
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507420
    m_Localized: 'Intruder: Dbanie o siebie to podstawa. Dzięki temu świat zdaje się… normalniejszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507421
    m_Localized: 'Intruder: Ciekawe, czy da się określić Przybysza po jego snach?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507422
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507423
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507424
    m_Localized: 'Intruder: Tymi rękoma gotów jestem pokonać wszystko, co stanie mi na drodze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507425
    m_Localized: 'Intruder: Może w pewien sposób próbuję się przedrzeć do własnych snów?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507426
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507427
    m_Localized: 'Intruder: Czemu tak w ogóle stawiam czoła…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507428
    m_Localized: 'Intruder: Potrzebuję śnić, prawda…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507429
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507430
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507431
    m_Localized: 'Intruder: Gdzieś słyszałem, że przez bezsenność oczy robią się ciemniejsze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507432
    m_Localized: 'Intruder: Ciekawe, czy to prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507433
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507434
    m_Localized: 'Intruder: Hmm. Kiedyś były bielsze. Teraz naprawdę poczerwieniały.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507435
    m_Localized: 'Intruder: Jeśli nie wiesz, nie spałem od… naprawdę dawna.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507436
    m_Localized: 'Intruder: Czemu więc nie mam przekrwionych oczu? Dziwne…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507437
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507438
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507439
    m_Localized: 'Intruder: Z jakiegoś powodu bolą, jakby były podrażnione. Nietypowe…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507440
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507441
    m_Localized: 'Intruder: Więc? Słabo?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507442
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507443
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507444
    m_Localized: 'Intruder: Ciekaw jestem, jak wyszło.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507445
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507446
    m_Localized: 'Intruder: Ach, więc to nie jest zwykłe zdjęcie. Jest na nim jakaś… aura?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507447
    m_Localized: 'Intruder: Sprawia wrażenie… pustej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507448
    m_Localized: 'Intruder: Jesteś pewien, że to w ogóle działa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507449
    m_Localized: 'Intruder: Znaczy się… czy aury tak naprawdę istnieją? Widziałeś jakąś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507450
    m_Localized: 'Intruder: Sny istnieją, a przynajmniej istniały. Ale aury…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507451
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507452
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507453
    m_Localized: 'Intruder: Hmm? Pierwsze słyszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507454
    m_Localized: 'Intruder: Czemu nie, spróbujmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507455
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507456
    m_Localized: 'Intruder: I… jaki werdykt?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507457
    m_Localized: 'Intruder: Masz choć blade pojęcie, czego tam szukać…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507458
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507459
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507460
    m_Localized: 'Intruder: Wiesz, nie spałem od tak dawna, że nie wiem nawet, czy wszystko wokół dzieje się naprawdę… czy to tylko sen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507461
    m_Localized: 'Intruder: To by wiele tłumaczyło…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507462
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507463
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507464
    m_Localized: 'Intruder: Hmmm. Ciekawe. Jak myślisz, jeśli ludzie wciąż mieliby sny, czy mógłbym się do któregoś włamać…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507465
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507466
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507467
    m_Localized: 'Intruder: Szukam tylko miejsca, żeby przekimać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507468
    m_Localized: 'Intruder: Jestem bardzo ociężały, ale oczy coraz uważniej czuwają.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507469
    m_Localized: 'Intruder: Zaraz… nie sądzisz, że mam objawy Przybysza, co? Te, o których mówią w telewizji?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507470
    m_Localized: 'Intruder: Co spowodowało, że jesteś taki podejrzliwy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507471
    m_Localized: 'Intruder: Nie rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507472
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507473
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507474
    m_Localized: 'Intruder: Hmm? Serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507475
    m_Localized: 'Intruder: Od braku snu wysycha mi skóra. Masz tak samo?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507476
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507477
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507478
    m_Localized: 'Intruder: Zanim mnie zastrzelisz, mam pewną… prośbę… do ciebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507479
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507480
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507481
    m_Localized: 'Intruder: Czy możesz zmasakrować całe moje ciało?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507482
    m_Localized: 'Intruder: Tak, że nawet jeśli się obudzę, nie będę mógł wejść w nie z powrotem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507483
    m_Localized: 'Intruder: A ciało się o mnie nie upomni.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507484
    m_Localized: 'Intruder: Pozwól mi spędzić trochę czasu w zaświatach. Tylko chwilkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507485
    m_Localized: 'Intruder: Jakoś sobie poradzę bez ciała.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507486
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507487
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507488
    m_Localized: 'Intruder: Hmmm, czy więcej sensu nie miałoby, gdyby Przybysze mieli brudne zęby?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507489
    m_Localized: 'Intruder: Jeśli wyłażą spod ziemi, pewnie wybrudziliby je ziemią.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507490
    m_Localized: 'Intruder: Jak myślisz, czemu mam brudne paznokcie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507491
    m_Localized: 'Intruder: Na wszelkie sposoby staram się dorwać do snu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507492
    m_Localized: 'Intruder: Jeśli by mi się powiodło, przestałbym się okaleczać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507493
    m_Localized: 'Intruder: A ból straciłby znaczenie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507494
    m_Localized: 'Intruder: Hmmm… Dlaczego oczy miałby przybrać ciemniejszy kolor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507495
    m_Localized: 'Intruder: Czy nie wyschłyby od ciągłego przeciążania? Raczej powinny stać się szkliste.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507496
    m_Localized: 'Intruder: Hmmm… Dlaczego nie mam przekrwionych oczu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507497
    m_Localized: 'Intruder: Czy nie wyschłyby od ciągłego przeciążania?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507498
    m_Localized: 'Intruder: Nie spałem od wieków. Coś tu nie gra, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507499
    m_Localized: 'Intruder: Więc nikt inny tak nie ma? Dziwne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507500
    m_Localized: 'Intruder: Gdy długo nie śpi się po nocach, zaczyna się odczuwać chłód… a później suchość.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507501
    m_Localized: 'Intruder: Z czasem zaczyna pojawiać się gorączka.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507502
    m_Localized: 'Intruder: Potem jest już tylko gorzej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507503
    m_Localized: 'Intruder: Skąd tak właściwie dowiedziałeś się o tym objawie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507504
    m_Localized: 'Intruder: Ach, z telewizji? Niespotykane…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507505
    m_Localized: 'Intruder: Sam… nie wiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507506
    m_Localized: 'Intruder: Jasne, wszystko inne rozumiem. Ale aury?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507507
    m_Localized: 'Intruder: Ostatnio tak wielu ludzi dostało bzika na punkcie nadprzyrodzonych rzeczy, że strach się bać.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507508
    m_Localized: 'Intruder: Nawet nie ogarniamy do końca tego, co nie‑nadprzyrodzone.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507509
    m_Localized: 'Intruder: To brzmi jak niezłe sprawozdanie. Z pogranicza jawy i snu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507510
    m_Localized: 'Intruder: Ale czy jesteś pewien, że naprawdę je widziałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507511
    m_Localized: 'Intruder: Może ci się tylko przyśniło.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507512
    m_Localized: 'Intruder: Jednakże… Jest to do zrozumienia. Dziwne…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507513
    m_Localized: 'Intruder: Całkiem zabawne jest to, że zdecydowałeś się kogoś zabić na podstawie cudzej wypowiedzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507514
    m_Localized: 'Intruder: Chyba raczej bardziej przejmujące niż zabawne…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507515
    m_Localized: 'Intruder: Obłąkany świat… Brak snów… Moje umieranie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507516
    m_Localized: 'Intruder: Albo tylko zapadnie w sen…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507517
    m_Localized: 'Cultist1: Śmierć ogrzeje nas w swym chłodnym uścisku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507518
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507519
