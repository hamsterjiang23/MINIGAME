  - m_Id: 41582931045507549
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507550
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507551
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507552
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507553
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507554
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507555
    m_Localized: 'Cultist1: Jeszcze nie czas.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507556
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507557
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507558
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507559
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507560
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507561
    m_Localized: 'Cultist1: Uważaj, czego sobie życzysz, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507562
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507563
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507564
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507565
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507566
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507567
    m_Localized: 'Cultist1: To bezwartościowe.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507568
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507569
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507570
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507571
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507572
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507573
    m_Localized: 'Cultist1: Powiedz mi, gospodarzu… Dlaczegoż kłopoczesz się tymi testami?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507574
    m_Localized: 'Cultist1: Gospodarzu, przygotuj się jeno na odejście, gdy nadejdzie czas.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507575
    m_Localized: 'Cultist1: Nie wiem, na co czekasz, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507576
    m_Localized: 'Cultist1: Nie rzeknę nic więcej.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507577
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507578
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507579
    m_Localized: 'Cultist1: Od dawien dawna nie uwieczniono mojego wizerunku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507580
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507581
    m_Localized: 'Cultist1: Gospodarzu, odpowiesz za swe czyny.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507582
    m_Localized: 'Cultist1: Popełniasz karygodny błąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507583
    m_Localized: 'Cultist2: Nie ma powodów do obaw, gospodarzu. Odejdziemy do lepszej krainy. Zostaniemy zbawieni.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507584
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507585
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507586
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507587
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507588
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507589
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507590
    m_Localized: 'Cultist2: Oczywiście, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507591
    m_Localized: 'Cultist2: Powykręcane niczym dusza… i pewnie trochę przerośnięte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507592
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507593
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507594
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507595
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507596
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507597
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507598
    m_Localized: 'Cultist2: Wszyscy cierpimy z powodu swoich problemów…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507599
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507600
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507601
    m_Localized: 'Cultist2: Sen spoczywa poza naszym zasięgiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507602
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507603
    m_Localized: 'Cultist2: Mówią, że to ponagla Jej nieuchronne nadejście.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507604
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507605
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507606
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507607
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507608
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507609
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507610
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507611
    m_Localized: 'Cultist2: Zdjęcie…? A to nowość.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507612
    m_Localized: 'Cultist2: Czuję się… nieswojo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507613
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507614
    m_Localized: 'Cultist2: Jakże… fascynujące.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507615
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507616
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507617
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507618
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507619
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507620
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507621
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507622
    m_Localized: 'Cultist2: To bardziej… niepokojące… niż się spodziewałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507623
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507624
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507625
    m_Localized: 'Cultist2: Jest… za wcześnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507626
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507627
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507628
    m_Localized: 'Cultist2: Nie jestem jeszcze… gotów odejść.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507629
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507630
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507631
    m_Localized: 'Cultist2: Och…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507632
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507633
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507634
    m_Localized: 'Cultist2: Ach, uroki wypróbowania czegoś nowego.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507635
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507636
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507637
    m_Localized: 'Cultist2: Jeszcze nie czas…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507638
    m_Localized: 'Cultist2: Proszę, gospodarzu, nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507639
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507640
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507641
    m_Localized: 'Cultist2: Dziękuję, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507642
    m_Localized: 'Cultist2: Mówią nam, że po Jej przyjściu nastąpi koniec cierpienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507643
    m_Localized: 'Cultist2: Oby tak było… Dość wycierpiałem. Czas odpocząć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507644
    m_Localized: 'Cultist2: Uczą nas, że poza tym światem trwa wieczny spokój.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507645
    m_Localized: 'Cultist2: Gospodarzu, czy pojąłeś grozę Śmierci? Czy wiesz, że zbliża się koniec?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507646
    m_Localized: 'Cultist2: To takie… niegodne. Pachy to tylko dołki pod ramionami.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507647
    m_Localized: 'Cultist2: Ale i tak to słowo dziwne sprawia wrażenie na języku.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507648
    m_Localized: 'Cultist2: Ach, widzę, że to nie jest zwykłe zdjęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507649
    m_Localized: 'Cultist2: Nie wiem, na co patrzę, ale wygląda… pięknie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507650
    m_Localized: 'Cultist2: Dziękuję, bracie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507651
    m_Localized: 'Cultist2: Tyle sposobów na zidentyfikowanie obcych…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507652
    m_Localized: 'Cultist2: …a wciąż szaleją jak dzicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507653
    m_Localized: 'Cultist2: Wszystko dobrze… jestem pod opieką. Odchodzę teraz… do lepszego życia… W‑wszystko dobrze… nie lękam się…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507654
    m_Localized: 'Cultist2: Kurwa…! N‑nie chcę umierać…!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507655
    m_Localized: 'Cultist3: Rób, jak sobie życzysz, gospodarzu. Nie stawaj nam tylko na drodze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507656
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507657
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507658
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507659
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507660
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507661
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507662
    m_Localized: 'Cultist3: To ciekawe, jak dolna i górna szczęka są tak bardzo różne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507663
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507664
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507665
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507666
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507667
    m_Localized: 'Cultist3: Przypominamy przez nie obcych.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507668
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507669
    m_Localized: 'Cultist3: Przywołamy nimi Śmierć. Ona nas ocali.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507670
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507671
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507672
    m_Localized: 'Cultist3: Oczy me ledwo już widzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507673
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507674
    m_Localized: 'Cultist3: Zanosi się, że odejdę przed moimi braćmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507675
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507676
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507677
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507678
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507679
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701376
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701377
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701378
    m_Localized: 'Cultist3: Spróbuję unieść swoją szatę. Racz być cierpliwy, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701379
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701380
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701381
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701382
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701383
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701384
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701385
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701386
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701387
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701388
    m_Localized: 'Cultist3: Proszę ponownie, gospodarzu. Nie stawaj nam na drodze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701389
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701390
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701391
    m_Localized: 'Cultist3: Gospodarzu, ogarnia cię skonfundowanie. Odłóż broń, bracie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701392
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701393
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701394
    m_Localized: 'Cultist3: Gospodarzu, nie waż się interweniować.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701395
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701396
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701397
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701398
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701399
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701400
    m_Localized: 'Cultist3: Gospodarzu, czy uważasz, że mój koniec powinien nastąpić prędzej, niż zaplanowano?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701401
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701402
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701403
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701404
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701405
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701406
    m_Localized: 'Cultist3: Zobaczyłeś już wszystko, gospodarzu. Teraz muszę się przygotować.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701407
    m_Localized: 'Cultist3: Każdy ma swoją rolę.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701408
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701409
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701410
    m_Localized: 'Cultist3: Zachowywanie zdjęć jest niedorzeczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701411
    m_Localized: 'Cultist3: Wszystko, co istotne, przetrwa w pamięci.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701412
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701413
    m_Localized: 'Cultist3: Postępujesz niemądrze, bracie. Bardzo niemądrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701414
    m_Localized: 'Cultist3: Spopielą twoje zwłoki, a Śmierć odwróci swe spojrzenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701415
    m_Localized: 'FatalDame: Odczuwasz ją czasem, mój miły? Obawę, że mogę nie być człowiekiem?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701416
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701417
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701418
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701419
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701420
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701421
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701422
    m_Localized: 'FatalDame: Podobają ci się?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701423
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701424
    m_Localized: 'FatalDame: Co to za grymas, mój miły? Widziałeś już takie ząbki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701425
    m_Localized: 'FatalDame: Czy… może przypominam ci kogoś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701426
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701427
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701428
    m_Localized: 'FatalDame: Mówią, że nic nie równa się trzymaniu dłoni ukochanej osoby…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701429
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701430
    m_Localized: 'FatalDame: I odczuciu w nich… bijącego mocno serca.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701431
    m_Localized: 'FatalDame: Czego dowodzą potliwe dłonie? Jesteś spięty? Targają tobą emocje?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701432
    m_Localized: 'FatalDame: Czy może zaślepia cię gniew?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701433
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701434
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701435
    m_Localized: 'FatalDame: Z oczu można wyczytać wiele o myślach drugiej osoby.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701436
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701437
    m_Localized: 'FatalDame: Powiedz mi, mój miły… O czym teraz myślisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701438
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701439
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701440
    m_Localized: 'FatalDame: Oczywiście, mój miły. Nie potrafię ci odmówić…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701441
    m_Localized: 'FatalDame: Ciało nagradza troskę, pamięta czułość.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701442
    m_Localized: 'FatalDame: Cieszę się, że oboje to rozumiemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701443
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701444
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701445
    m_Localized: 'FatalDame: Wybacz, mój miły… Dość mam pozowania…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701446
    m_Localized: 'FatalDame: Przejdźmy do bardziej… cielesnych… testów, dobrze?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701447
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701448
    m_Localized: 'FatalDame: A może masz jakieś plany co do tego zdjęcia?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701449
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701450
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701451
    m_Localized: 'FatalDame: Mm, czy to twoje zboczenie, mój miły?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701452
    m_Localized: 'FatalDame: Przyznaj się… Nie mam nic przeciwko.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701453
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701454
    m_Localized: 'FatalDame: Co ci się w nich tak podoba? Może pójdziemy dalej tym tropem…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701455
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701456
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701457
    m_Localized: 'FatalDame: Przypominam ci kogoś, kto cię skrzywdził, mój miły?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701458
    m_Localized: 'FatalDame: Ale dlaczego wtedy mścisz się na mnie? Dopiero co się poznaliśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701459
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701460
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701461
    m_Localized: 'FatalDame: A więc miałam rację. Jesteś rozdrażniony.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701462
    m_Localized: 'FatalDame: Kogo we mnie widzisz, mój miły? Szukasz zemsty?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701463
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701464
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701465
    m_Localized: 'FatalDame: Najbardziej boję się tego, że twoje oczy nie pokazują ani krztyny zwątpienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701466
    m_Localized: 'FatalDame: Trzymasz się kurczowo sztywnego schematu. Lecz ludzie… wątpią, wahają się, poszukują.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701467
    m_Localized: 'FatalDame: Trzymasz się kurczowo sztywnego schematu. Sam go stworzyłeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701468
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701469
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701470
    m_Localized: 'FatalDame: Obawiasz się pokusy? Wydaje się fałszywa? Czy chodzi o coś innego?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701471
    m_Localized: 'FatalDame: Twoim zdaniem róże mają kolce? Jaką to krzywdę mogłabym ci wyrządzić, mój miły?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701472
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701473
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701474
    m_Localized: 'FatalDame: Czy odnajdujesz przyjemność w takim… sadyzmie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701475
    m_Localized: 'FatalDame: Na przykład zatrzymywanie zdjęć ofiary? Takie to romantyczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701476
    m_Localized: 'FatalDame: Aż się zastanawiam, czy nie jestem pierwsza.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701477
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701478
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701479
    m_Localized: 'FatalDame: Przykro mi, mój miły… nie wiem, czego oczekujesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701480
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701481
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701482
    m_Localized: 'FatalDame: Lepiej jest pogodzić się ze wspomnieniami, które cię ranią, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701483
    m_Localized: 'FatalDame: Niepotrzebnie tak bardzo się krzywdzisz, gdy rozdrapują się stare rany.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701484
    m_Localized: 'FatalDame: Zrób to, co ja. Minie trochę czasu… ale w końcu poczujesz się lżej. Obiecuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701485
    m_Localized: 'FatalDame: Wiem, że tylko się bronisz. Strzeżesz swojego muru.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701486
    m_Localized: 'FatalDame: Proszę tylko, byś także uszanował mój.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701487
    m_Localized: 'FatalDame: Nie patrz więc na mnie przez pryzmat swojej przeszłości.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701488
    m_Localized: 'FatalDame: To zabawne. Zdaje się, że wszyscy ostatnio unikają swoich spojrzeń.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701489
    m_Localized: 'FatalDame: Niektórzy odwracają wzrok, niektórzy gonią za odpowiedziami, a inni szukają objawów Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701490
    m_Localized: 'FatalDame: Niektórzy odwracają wzrok, a inni szukają objawów Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701491
    m_Localized: 'FatalDame: Ale ty… wpatrujesz się tak mocno.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701492
    m_Localized: 'FatalDame: To takie… fascynujące.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701493
    m_Localized: 'FatalDame: Rozumiem, że się boisz, mój miły.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701494
    m_Localized: 'FatalDame: Przeraża mnie myśl, że byłbyś w stanie odebrać komuś życie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701495
    m_Localized: 'FatalDame: Ale to normalne czuć urazę, gdy ktoś celuje do ciebie z broni.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701496
    m_Localized: 'FatalDame: Masz chyba charakterystyczną… cechę. Może jest na to lepsze słowo…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701497
    m_Localized: 'FatalDame: Bardziej kochasz wspomnienia po ludziach niż ich samych.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701498
    m_Localized: 'FatalDame: Trzymasz się od wszystkich na dystans… Ale założę się, że masz mnóstwo zdjęć.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701499
    m_Localized: 'FatalDame: Nie, nieważne. Nie przejmuj się mną, mój miły.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701500
    m_Localized: 'FatalDame: Tak, trudno jest ostatnio odróżnić prawdę od kłamstwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701501
    m_Localized: 'FatalDame: Samemu trzeba decydować, co jest prawdziwe.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701502
    m_Localized: 'FatalDame: Tak bardzo przeraża cię jakakolwiek zmiana, że wszystkich od siebie odpychasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701503
    m_Localized: 'FatalDame: Nieznajomych. Rodzinę. Kochanki…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701504
    m_Localized: 'FatalDame: Co z tobą będzie…?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313600
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313601
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313602
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313603
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313604
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313605
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313606
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313607
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090816
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090817
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090818
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090819
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090820
    m_Localized: 'Esenin: Kurdemol, popatrz no, jak wywijasz giwerką!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090821
    m_Localized: 'Esenin: Strzelaj, jeśli chcesz, ty popierdoleńcu. Wiedz tylko, że to jakaś bzdura!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090822
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090823
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090824
    m_Localized: 'Esenin: Oż no kurwa mać…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090825
    m_Localized: 'Esenin: Niech zgadnę. Paznokcie czyste jak łza, więc przeraził cię mój wzrost? Racja?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090826
    m_Localized: 'Esenin: Masz jakieś kompleksy? Chcesz wszystkich zrównać do twojego poziomu?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090827
    m_Localized: 'Esenin: Weź spierdalaj z tym gównem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090828
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090829
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090830
    m_Localized: 'Esenin: I jak do tego doszedłeś, geniuszu?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090831
    m_Localized: 'Esenin: Zęby były w porządku, ręce też. Teraz oczy mi sprawdzasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090832
    m_Localized: 'Esenin: Ja pierdolę, jeśli masz mnie dość, przyznaj to. Odejdę bez łaski.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090833
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090834
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090835
    m_Localized: 'Esenin: Co teraz? Poślady mam rozewrzeć czy coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090836
    m_Localized: 'Esenin: Według ciebie mam się na to wszystko godzić?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090837
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090838
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090839
    m_Localized: 'Esenin: Poważnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090840
    m_Localized: 'Esenin: Nie widzisz, co tu już się odwala w tym domu?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090841
    m_Localized: 'Esenin: Ubzdurałeś sobie jakieś bezsensowny imbecylizm.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090842
    m_Localized: 'Esenin: A potem łazisz i zabijasz ludzi jak muchy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090843
    m_Localized: 'Esenin: Przestań i pomyśl nad tym przez chwilę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090844
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090845
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090846
    m_Localized: 'Esenin: Kurwa, wszystkie te wiadomości…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090847
    m_Localized: 'Esenin: I ten jebany rząd…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090848
    m_Localized: 'Esenin: Więc tak to o nas „dbają”, czy nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090849
    m_Localized: 'Esenin: Normalnie para‑kurwa‑noja…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090850
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090851
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090852
    m_Localized: 'Esenin: Wiesz co? Spierdalaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090853
    m_Localized: 'Esenin: Mam serdecznie dość, że wciąż się na mnie gapisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090854
    m_Localized: 'Esenin: Myślisz, że uwielbiam być taki wysoki?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090855
    m_Localized: 'Esenin: Zawsze w coś jebnę głową… Nie wspomnę nawet o autobusach!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090856
    m_Localized: 'Esenin: Ale… są i tego dobre strony.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090857
    m_Localized: 'Esenin: Widziałem raz, jak gościu został potrącony przez ciężarówkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090858
    m_Localized: 'Esenin: Sęk w tym, że nawet nie jechała szybko.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090859
    m_Localized: 'Esenin: Stała w korku, a on przechodził zaraz przed nią'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090860
    m_Localized: 'Esenin: Biedak był w samym środku martwego pola kierowcy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090861
    m_Localized: 'Esenin: Wtedy ciężarówka ruszyła, a z tamtego… powoli robił się naleśnik.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090862
    m_Localized: 'Esenin: Straszne to było zdarzenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090863
    m_Localized: 'Esenin: Przynajmniej nie zginę w taki idiotyczny sposób.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090864
    m_Localized: 'Esenin: Cholera jasna…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090865
    m_Localized: 'Esenin: Byłeś kiedyś w barze?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090866
    m_Localized: 'Esenin: Zanim wszystko pierdolnęło, masę było ludzi z tymi „objawami”. Czerwone oczy, brudne ręce, a nawet idealne zęby.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090867
    m_Localized: 'Esenin: I wiesz co?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090868
    m_Localized: 'Esenin: Niektórzy z nich zginęli, psiakrew…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090869
    m_Localized: 'Esenin: Ale nie w tym sęk. Chodzi o to, że jeśli odwaliłbyś tam coś takiego, dostałbyś kopa w dupę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090870
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090871
    m_Localized: 'Esenin: Nie rozumiem, jak w ogóle możesz grozić ludziom bronią.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090872
    m_Localized: 'Esenin: To kompletnie pojebane.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090873
    m_Localized: 'Esenin: Musiałeś zupełnie ocipieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090874
    m_Localized: 'Esenin: A teraz spierdalaj, dobra?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090875
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090876
    m_Localized: 'Esenin: Dzięki?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090877
    m_Localized: 'Esenin: Co mam niby powiedzieć?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090878
    m_Localized: 'Esenin: Gdziekolwiek się nie udać, tam albo mazgaje, albo absolutne psychole.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090879
    m_Localized: 'Esenin: Jak ktokolwiek może przyjąć na trzeźwo ten burdel na kółkach…?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090880
    m_Localized: 'Esenin: O…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090881
    m_Localized: 'Esenin: Kurwa…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285120
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285121
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285122
    m_Localized: 'Daughter: Już wystarczy, poddaję się! Ha, ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285123
    m_Localized: 'Daughter: Wygrywa pan!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285124
    m_Localized: 'Daughter: A ja nawet nie wiem, co to za zabawa!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285125
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285126
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285127
    m_Localized: 'Daughter: Ach tak! Tatuś mi mówił o takiej zabawie!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285128
    m_Localized: 'Daughter: Trzeba podzielić się na dwie grupy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285129
    m_Localized: 'Daughter: Jedna z nich chowa skarb i rysuje więzienie, do którego wrzucają innych!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285130
    m_Localized: 'Daughter: A wtedy druga grupa musi uciekać i znaleźć skarb, ale nie mogą dać się złapać!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285131
    m_Localized: 'Daughter: Aha, i wszyscy mają broń!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285132
    m_Localized: 'Daughter: Tata mówił, że to były kije.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285133
    m_Localized: 'Daughter: Och…! Pamiętam! To była zabawa w policjantów i złodziei!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285134
    m_Localized: 'Daughter: Czy pan też się w nią bawił, jak był mały? Pobawimy się?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285135
    m_Localized: 'Daughter: Och…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285136
    m_Localized: 'Daughter: Ale nie schowałam jeszcze skarbu!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285137
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285138
    m_Localized: 'Daughter: Nie mam nawet niczego fajnego do ukrycia…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285139
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285140
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285141
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285142
    m_Localized: 'Daughter: Nie podoba mi się ta zabawa…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285143
    m_Localized: 'Daughter: Jest straszna… czy pobawimy się w coś innego?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285144
    m_Localized: 'Daughter: Proooszę…! Pokazałam panu paznokcie i w ogóle!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285145
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285146
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285147
    m_Localized: 'Daughter: Bardzo mi się podobały paznokcie mojej mamusi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285148
    m_Localized: 'Daughter: Uhm, zapomniałam teraz, jak wyglądały.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285149
    m_Localized: 'Daughter: Ale pamiętam, że były baaardzo ładne.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285150
    m_Localized: 'Daughter: I miała też piękną sukienkę!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285151
    m_Localized: 'Daughter: Taką, jak moja!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285152
    m_Localized: 'Daughter: Tatuś mówi, że jestem śliczna jak mamusia!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285153
    m_Localized: 'Daughter: Tatuś…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285154
    m_Localized: 'Daughter: W p‑porządku. Nie… płaczę. Jestem dużą dziewczynką…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285155
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285156
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285157
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285158
    m_Localized: 'Daughter: Nie chcę!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285159
    m_Localized: 'Daughter: Ja… ja… umręęę!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285160
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285161
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285162
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285163
    m_Localized: 'Daughter: Raz poszliśmy bardzo daleko na plac zabaw!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285164
    m_Localized: 'Daughter: I była tam taka wielka zjeżdżalnia!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285165
    m_Localized: 'Daughter: Była ogrooomna!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285166
    m_Localized: 'Daughter: I wcale się nie bałam. W ogóle! Było super!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285167
    m_Localized: 'Daughter: Zjechałam tyle razy, że aż bardzo mi się zachciało pić! Wypiłabym całe jezioro! Nie, całe morze!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285168
    m_Localized: 'Daughter: A wtedy tatuś się gdzieś zapodział.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285169
    m_Localized: 'Daughter: I się przestraszyłam…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285170
    m_Localized: 'Daughter: Nie wiedziałam, którędy do domu, bo to było tak daleko!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285171
    m_Localized: 'Daughter: Ale wtedy tatuś wrócił…!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285172
    m_Localized: 'Daughter: Mam nadzieję, że niedługo po mnie przyjdzie. Może znów się zgubił?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285173
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285174
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285175
    m_Localized: 'Daughter: Och, widziałam to raz w bajce!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285176
    m_Localized: 'Daughter: Był tam pies z bronią i kiedy strzelał, robił zdjęcia!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285177
    m_Localized: 'Daughter: Czy pana broń robi tak samo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285178
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479424
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479425
    m_Localized: 'Daughter: Chyba nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479426
    m_Localized: 'Daughter: O, pamiętam coś jeszcze!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479427
    m_Localized: 'Daughter: Kiedyś poszłam z tatusiem na targ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479428
    m_Localized: 'Daughter: I ktoś groził nam bronią.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479429
    m_Localized: 'Daughter: Miał długie włosy i płaszcz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479430
    m_Localized: 'Daughter: Tatuś się wystraszył, a potem się przytulili.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479431
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479432
    m_Localized: 'Daughter: A może to był sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479433
    m_Localized: 'Daughter: Nie… pamiętam…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479434
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479435
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479436
    m_Localized: 'Daughter: Och…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479437
    m_Localized: 'Daughter: A będę mogła zobaczyć też pana uszy?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479438
    m_Localized: 'Daughter: Czy chce mi pan mi dokuczyć?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479439
    m_Localized: 'Daughter: Jest pan czasem jak moja najlepsza koleżanka…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479440
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479441
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479442
    m_Localized: 'Daughter: Bawię się z nią… la, la, la!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479443
    m_Localized: 'Daughter: A potem… łups! Robi coś niegrzecznego!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479444
    m_Localized: 'Daughter: Ale tak naprawdę jest bardzo miła, wiem o tym.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479445
    m_Localized: 'Daughter: Nie lubi swojego domu. Ma baaardzo surową mamę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479446
    m_Localized: 'Daughter: Która nie pozwala jej na wiele rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479447
    m_Localized: 'Daughter: Może jej mama jest Przybyszką?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479448
    m_Localized: 'Daughter: Mój tatuś też jest czasem surowy, ale nie zawsze!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479449
    m_Localized: 'Daughter: Pójdę do niej, jak wróci po mnie tatuś…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479450
    m_Localized: 'Daughter: Tatusiu…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479451
    m_Localized: 'Daughter: Mamusiu…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062336
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062337
    m_Localized: Muszę się sobie przyjrzeć.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062338
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062339
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062340
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062341
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450944
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450945
    m_Localized: Wyczyść
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450946
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450947
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450948
    m_Localized: Do diabła, białe…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450949
    m_Localized: Palacze o takich marzą
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450950
    m_Localized: Żółte…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450951
    m_Localized: I dobrze. Przynajmniej nikt mnie nie weźmie za Przybysza
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450952
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450953
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450954
    m_Localized: Brudne paznokcie…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450955
    m_Localized: To przez to cholerne grzebanie w ziemi
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450956
    m_Localized: Czyste ręce…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450957
    m_Localized: Ślady po prochu strzelniczym. Nic wielkiego
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450958
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450959
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450960
    m_Localized: Kurwa… przekrwione
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450961
    m_Localized: Mogłem nie pić tego gówna z kofeiną
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450962
    m_Localized: Oczy wyglądają w porządku
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450963
    m_Localized: Nie są czerwone, niczego nie dowodzą.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450964
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450965
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450966
    m_Localized: Włochate
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450967
    m_Localized: Co nie jest zaskoczeniem
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450968
    m_Localized: Ja pierdolę! A to co?!
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450969
    m_Localized: Jakaś wysypka… albo gorzej, grzybica
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450970
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450971
    m_Localized: Muszę się umyć, może to pomoże
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450972
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450973
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450974
    m_Localized: Uszy wyglądają… okej
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450975
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450976
    m_Localized: Co to w ogóle były za wiadomości?
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450977
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 48219577463595008
    m_Localized: 'Anger: Czasem zaciskam szczękę tak mocno, że aż słyszę, jak mi pęka.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577476177920
    m_Localized: 'Anger: Zwariować można… I za każdym razem rozluźniam ją za późno.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343744
    m_Localized: 'Alkonost: Moja siostra… Dlaczego?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343745
    m_Localized: 'Alkonost: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343746
    m_Localized: 'Alkonost: Teraz wszystko straciło sens… Po co się starać…?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343747
    m_Localized: 'Alkonost: Niech mnie pan zastrzeli.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577505538048
    m_Localized: 'Sirin: Śmierć upomniała się o moją siostrę…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577505538049
    m_Localized: 'Sirin: Jak…? Jak mam bez niej żyć…?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577505538050
    m_Localized: 'Sirin: Jestem gotowa…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315264
    m_Localized: 'Jacob: Wiedziałem, że pan to powie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315265
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315266
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315267
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315268
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315269
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315270
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315271
    m_Localized: 'Jacob: No dobra…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315272
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315273
    m_Localized: 'Jacob: Przez kilka ostatnich tygodni nie miałem wiele okazji, by je umyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315274
    m_Localized: 'Jacob: Szczęściarz ze mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315275
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315276
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315277
    m_Localized: 'Jacob: Moje ręce? Doprawdy?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315278
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315279
    m_Localized: 'Jacob: Panie, daruj, ostatnio musiałem przekopywać się przez góry syfu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315280
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315281
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315282
    m_Localized: 'Jacob: Nie spałem od wielu dni…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315283
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315284
    m_Localized: 'Jacob: Ciężko przymknąć oczy, gdy zaginęła ci córka.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315285
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315286
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315287
    m_Localized: 'Jacob: Czy mam pokazać panu coś jeszcze?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315288
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315289
    m_Localized: 'Jacob: Proszę spojrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315290
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315291
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315292
    m_Localized: 'Jacob: Tylko broń Boże, by pokazał to pan komuś z FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315293
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315294
    m_Localized: 'Jacob: Słyszał pan kiedyś o wampirach?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315295
    m_Localized: 'Jacob: Nie ukazują się na zdjęciach, chodzą wyłącznie nocami, i…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315296
    m_Localized: 'Jacob: …są nieśmiertelne.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315297
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315298
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315299
    m_Localized: 'Jacob: Nie uważa pan, że te testy są durnowate?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315300
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315301
    m_Localized: 'Jacob: Zdradzę panu sekret: woskowina w uszach to zupełnie naturalne zjawisko.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315302
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315303
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315304
    m_Localized: 'Jacob: Mniejszej wykałaczki pan nie miał, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315305
    m_Localized: 'Jacob: Chce pan strzelać? Proszę bardzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315306
    m_Localized: 'Jacob: Ale zdawało mi się, że potrafi pan słuchać.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315307
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315308
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315309
    m_Localized: 'Jacob: Proszę uważać, co pan z tym robi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315310
    m_Localized: 'Jacob: Jestem nieśmiertelny, ale jeśli pociągnie pan za spust…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315311
    m_Localized: 'Jacob: Nie odezwę się już ani słowem.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315312
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315313
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315314
    m_Localized: 'Jacob: Myśli pan, że jestem Przybyszem, ale to wielki błąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315315
    m_Localized: 'Jacob: Jestem nieśmiertelny, nie może mnie pan zabić.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315316
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315317
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315318
    m_Localized: 'Jacob: Upadł pan na głowę?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315319
    m_Localized: 'Jacob: Jeśli pociągnie pan za spust, nie dowie się pan nic więcej o Przybyszach.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315320
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315321
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315322
    m_Localized: 'Jacob: Oby nabił to pan srebrnym śrutem.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315323
    m_Localized: 'Jacob: Inaczej straci pan tylko amunicję…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315324
    m_Localized: 'Jacob: A ja swoją cierpliwość.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315325
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315326
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315327
    m_Localized: 'Jacob: No, niech pan strzela, jeśli wierzy pan temu zakłamanemu pudłu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315328
    m_Localized: 'Jacob: Ale ja tego nie zapomnę.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315329
    m_Localized: 'Jacob: Proszę zapamiętać moje słowa – wrócę tu i przetrącę panu kark.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315330
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315331
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315332
    m_Localized: 'Jacob: Jeśli moje zęby tak bardzo pana drażnią…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315333
    m_Localized: 'Jacob: Następnym razem je umyję.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315334
    m_Localized: 'Jacob: Palcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315335
    m_Localized: 'Jacob: Wiem, jak to musi wyglądać.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315336
    m_Localized: 'Jacob: Być tutaj, przekopywać się przez całe to dziadostwo…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315337
    m_Localized: 'Jacob: Każdy by wybrudził sobie ręce.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315338
    m_Localized: 'Jacob: Proszę ściszyć ten cholerny telewizor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315339
    m_Localized: 'Jacob: Ostatnio niełatwo jest utrzymać higienę.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315340
    m_Localized: 'Jacob: Spojrzałbym panu w oczy, gdyby nie miał pan takich problemów ze snem noc po nocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315341
    m_Localized: 'Jacob: Przemierzając pół miasta…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315342
    m_Localized: 'Jacob: Za dnia chowając się przed słońcem, a nocami unikając FEMA i Przybyszy…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315343
    m_Localized: 'Jacob: Miałem zaledwie chwilkę, żeby się kimnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315344
    m_Localized: 'Jacob: Pachy, hę? To dużo mówi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315345
    m_Localized: 'Jacob: Ludzi z FEMA całkowicie porąbało.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315346
    m_Localized: 'Jacob: Co będzie dalej? Oblizywanie Przybyszom jąder w poszukiwaniu kolejnych oznak?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315347
    m_Localized: 'Jacob: Niech przyjdą. Z przyjemnością dam im posiorbać.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315348
    m_Localized: 'Jacob: Drugi raz radzę we mnie tym nie celować.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315349
    m_Localized: 'Jacob: Bo skończy się to dla pana o wiele gorzej.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315350
    m_Localized: 'Jacob: Ale jeśli okaże pan szacunek…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315351
    m_Localized: 'Jacob: Włos z głowy panu nie spadnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315352
    m_Localized: 'Jacob: Oby był pan też taki twardy wobec bandziorów z FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315353
    m_Localized: 'Jacob: W przeciwieństwie do Przybyszy oni nawet nie udają ludzi…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315354
    m_Localized: 'Jacob: To straszne bydlaki.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315355
    m_Localized: 'Jacob: Niech pan nie marnuje amunicji.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315356
    m_Localized: 'Jacob: Zapewniam pana, że więcej jej pan zużyje na tych gnojów niż na Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315357
    m_Localized: 'Jacob: Miałem wrażenie, że jest pan bystrzejszy…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315358
    m_Localized: 'Jacob: Jebać to…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315359
    m_Localized: 'Jacob: Zawsze wiedziałem, że czyjaś głupota będzie mi zgubą.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315360
    m_Localized: Jebać to…
    m_Metadata:
      m_Items: []
  - m_Id: 58333830346432512
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 58333830346432513
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 58333830400958464
    m_Localized: Umyj
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535808
    m_Localized: 'Unstable: Zrozumiano. Daj mi tylko dokończyć tę EnerJekę…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535809
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535810
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535811
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535812
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535813
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535814
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535815
    m_Localized: 'Unstable: Wspominałem, że czuję smak EnerJeki, nawet gdy jej nie piję?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535816
    m_Localized: 'Unstable: Zdaje się, że robią ją z nie lada chemii.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535817
    m_Localized: 'Unstable: Ale kto by się tym przejmował, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535818
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535819
    m_Localized: 'Unstable: O kurczę, przebarwił mi się język.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535820
    m_Localized: 'Unstable: O kurczę, moje zęby są w opłakanym stanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535821
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535822
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535823
    m_Localized: 'Unstable: Okej, ręce. Jasne.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535824
    m_Localized: 'Unstable: Często mnie swędzą, jakby biegały mi po nich mrówki… ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535825
    m_Localized: 'Unstable: Nie sądzę, żebym coś skubał, więc ręce powinny być w porządku.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535826
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535827
    m_Localized: 'Unstable: Hmm, jakoś mi się powykrzywiały.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535828
    m_Localized: 'Unstable: Heh, za dużo kofeiny, aż mnie telepie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535829
    m_Localized: 'Unstable: Daj mi pooddychać z dziesięć minut, powinno przejść.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535830
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535831
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535832
    m_Localized: 'Unstable: Widziałem wiadomości. Oczy powinny być jakieś takie mętne i ciemnozielone.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535833
    m_Localized: 'Unstable: Tylko się nie pomyl. Ostatnio w świecie jest wiele odcieni zielonego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535834
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535835
    m_Localized: 'Unstable: Chwila, co jest nie tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535836
    m_Localized: 'Unstable: PRZEKRWIONE? MIAŁY BYĆ PRZEKRWIONE?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535837
    m_Localized: 'Unstable: Dlaczego wtedy w telewizji pokazywali zielone? Jak w ogóle wyglądają moje?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535838
    m_Localized: 'Unstable: Dlaczego wtedy w telewizji pokazywali zielone?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535839
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535840
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535841
    m_Localized: 'Unstable: No tak, jedyny objaw, który ma jakiś sens.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535842
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535843
    m_Localized: 'Unstable: Nie mają żadnego określonego koloru, żadnego syfu i innych takich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535844
    m_Localized: 'Unstable: To tylko zwykłe pachy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535845
    m_Localized: 'Unstable: Nieźle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535846
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535847
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535848
    m_Localized: 'Unstable: Zdjęcia robiono mi wyłącznie na imprezach.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535849
    m_Localized: 'Unstable: Ale nikt już nie urządza prywatek. Albo może nikt mnie nie zaprasza. Ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535850
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535851
    m_Localized: 'Unstable: No, serce wali mi jak szalone.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535852
    m_Localized: 'Unstable: Na całym świecie nie ma tyle EnerJeki, żeby mi wystarczyło.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535853
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535854
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535855
    m_Localized: 'Unstable: Jasne, czemu nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535856
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535857
    m_Localized: 'Unstable: Czy powinienem je najpierw umyć?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535858
    m_Localized: 'Unstable: Albo coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535859
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535860
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535861
    m_Localized: 'Unstable: O rety.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535862
    m_Localized: 'Unstable: Myślałem, że nie należysz do tych typów, którzy strzelają do wszystkiego, co się rusza. Jest ich już wystarczająco wielu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535863
    m_Localized: 'Unstable: Żywiłem nadzieję, że tu odsapnę od przemocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535864
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535865
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535866
    m_Localized: 'Unstable: Niezłą wybrałeś chwilę, hę?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535867
    m_Localized: 'Unstable: Chyba mnie nie zastrzelisz, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535868
    m_Localized: 'Unstable: Skurcze, jak się zdaje, nie są nowym objawem?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535869
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535870
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535871
    m_Localized: 'Unstable: Tak nie można.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535872
    m_Localized: 'Unstable: Sam wspomniałeś o zaczerwienieniu. A może faktycznie moje oczy są… przekrwione?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535873
    m_Localized: 'Unstable: Proszę, oświeć mnie, pogubiłem się.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535874
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535875
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535876
    m_Localized: 'Unstable: Hej, tak się nie robi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535877
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535878
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535879
    m_Localized: 'Unstable: Poczekaj, nie mam żadnej wady serca.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535880
    m_Localized: 'Unstable: Tylko mocno mi bije, rozumiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535881
    m_Localized: 'Unstable: Czekaj, chwileczkę, brakuje mi tchu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535882
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535883
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535884
    m_Localized: 'Unstable: Przynajmniej zdradź mi, czym się kierujesz!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535885
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535886
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535887
    m_Localized: 'Unstable: Kumam, że trzeba być ostrożnym i w ogóle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535888
    m_Localized: 'Unstable: Ale w ten sposób można prędko oszaleć, wiesz? Zastrzelisz wszystkich, bo ktoś wyda ci się podejrzany.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535889
    m_Localized: 'Unstable: Może byłoby ci łatwiej, gdybyś też odszedł i zaznał odrobiny spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535890
    m_Localized: 'Unstable: Gdzieś daleko stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535891
    m_Localized: 'Unstable: Wiesz, czego się obawiam? Kiedy nie możesz podnieść rąk, nie zasłonisz się nawet przed strzałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535892
    m_Localized: 'Unstable: To głupie, pewnie, ale któż by chociaż nie spróbował ochronić się przed kulą?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535893
    m_Localized: 'Unstable: Czekaj… czyli nic nie jest w odcieniach zieleni?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535894
    m_Localized: 'Unstable: To wtedy… w jakim kolorze jest wszystko?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535895
    m_Localized: 'Unstable: Nawet nie zauważyłem, kiedy wszędzie zapanowała zieleń…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535896
    m_Localized: 'Unstable: O rety, ale szok.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535897
    m_Localized: 'Unstable: Strasząc ludzi bronią, nie spowodujesz, że poczują się bezpieczniej, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535898
    m_Localized: 'Unstable: Przybysze nie przestaną nagle zabijać, bo komuś pogroziłeś strzelbą.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535899
    m_Localized: 'Unstable: Skończy się tak, że to ciebie inni zaczną się bać.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535900
    m_Localized: 'Unstable: Czy tego chcesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535901
    m_Localized: 'Unstable: Wygrażanie innym jest bez sensu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535902
    m_Localized: 'Unstable: Sprawisz jedynie, że… Haa… wszyscy obrócą się przeciwko tobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535903
    m_Localized: 'Unstable: Jezu, daj mi sekundę… Nggg… Cholerne serce.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535904
    m_Localized: 'Unstable: Wracając do sedna… Przestań wszystkim… grozić bronią. Nic… tym nie osiągniesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535905
    m_Localized: 'Unstable: Pójdę sobie i… Haa… Haa… nie będę cię więcej drażnił, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535906
    m_Localized: 'Unstable: Więc?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535907
    m_Localized: 'Unstable: To koniec?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535908
    m_Localized: 'Rocker: No to jazda. Może nie jest jeszcze za późno, by zagrać rocka!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535909
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535910
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535911
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535912
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535913
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535914
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535915
    m_Localized: 'Rocker: Nooo… Za bardzo je uwędziłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535916
    m_Localized: 'Rocker: Śmieszne, co…?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535917
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535918
    m_Localized: 'Rocker: Tylko to mi zostało po moim starym zespole. Wspomnienia i przeplamienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535919
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535920
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535921
    m_Localized: 'Rocker: Mam jeden tatuaż.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535922
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535923
    m_Localized: 'Rocker: To była żywiołowa noc. Tatuażysta się strzaskał, a ja byłem na tyle pijany, że się na to odważyłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535924
    m_Localized: 'Rocker: Zaraz…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535925
    m_Localized: 'Rocker: Może to nie był tatuaż.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535926
    m_Localized: 'Rocker: Już nawet nie pamiętam…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535927
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535928
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535929
    m_Localized: 'Rocker: Raz wpadliśmy na pomysł wstrzyknąć sobie tusz w gałki oczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535930
    m_Localized: 'Unstable: To była jazda po bandzie, wciąż mam po tym powidy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535931
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535932
    m_Localized: 'Rocker: Nie, nie w moje oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535933
    m_Localized: 'Rocker: Ale inny gość zupełnie od tego oślepł. Stary, powinieneś był zobaczyć jego oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535934
    m_Localized: 'Rocker: Wiele bym dał za takie ślepia…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535935
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535936
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535937
    m_Localized: 'Rocker: Proszę bardzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535938
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535939
    m_Localized: 'Rocker: Znalazłeś coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535940
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535941
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535942
    m_Localized: 'Rocker: Zróbmy sobie razem fotkę! Może nawet dam ci autograf!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535943
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535944
    m_Localized: 'Rocker: O kurczę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535945
    m_Localized: 'Rocker: Może najpierw trzeba było zdjąć dekielek z obiektywu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535946
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535947
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535948
    m_Localized: 'Rocker: Kiedyś rozciągałem sobie uszy… ale znudziło mi się to.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535949
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924416
    m_Localized: 'Rocker: Teraz są rozdarte.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924417
    m_Localized: 'Rocker: Ale nadal mi się podobają.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924418
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924419
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924420
    m_Localized: 'Rocker: Szczerze? Mam to gdzieś.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924421
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924422
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924423
    m_Localized: 'Rocker: Już niemal niczego się nie boję.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924424
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924425
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924426
    m_Localized: 'Rocker: Wyluzuj, stary. Nie ma potrzeby tym wymachiwać.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924427
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924428
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924429
    m_Localized: 'Rocker: Staram się nie śmierdzieć. Czy to powód, by mnie zastrzelić?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924430
    m_Localized: 'Rocker: Zaimponowałem ci, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924431
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924432
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924433
    m_Localized: 'Rocker: Ach, to taki model bez dekielka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924434
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924435
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924436
    m_Localized: 'Rocker: Widać nie przypasował ci mój styl.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924437
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924438
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924439
    m_Localized: 'Rocker: Może ten zajebisty riff jak marzenie wciąż gdzieś na mnie czeka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924440
    m_Localized: 'Rocker: Ale brak mi na niego pomysłu. W którymś kościele mi dzwoni, ale nie wiem, w którym.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924441
    m_Localized: 'Rocker: Ale tak na serio, gdybyś pociągnął za spust, co by to zmieniło?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924442
    m_Localized: 'Rocker: I tak nigdy bym się nie dostał na scenę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924443
    m_Localized: 'Rocker: Zabiłbym, by móc zagrać teraz na jakimś festiwalu. Mam wenę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924444
    m_Localized: 'Rocker: Szkoda tylko, że nie masz nic mocniejszego od piwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924445
    m_Localized: 'Rocker: Aż mnie świerzbi, by zalać się w trupa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924446
    m_Localized: 'Rocker: Nawet nie wiem, co mam powiedzieć, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924447
    m_Localized: 'Rocker: Dzięki za sprawdzenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924448
    m_Localized: 'Rocker: Czemu zdjęcie wyszło takie ciemne?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924449
    m_Localized: 'Rocker: Nawet nasza stara miejscówka do prób wyglądała jaśniej, a tu jest przecież światło.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924450
    m_Localized: 'Rocker: Wiesz, nigdy nie myślałem o dodaniu dźwięku dzwonów kościelnych do naszych utworów.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924451
    m_Localized: 'Rocker: Wiesz, jakoś chcę dodać dźwięk dzwonów kościelnych do naszych utworów.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924452
    m_Localized: 'Rocker: Mówię „nasze utwory”… jak gdybym wciąż miał z kim je zagrać.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924453
    m_Localized: 'Rocker: Wiesz…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924454
    m_Localized: 'Rocker: To będzie mój najlepszy występ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924455
    m_Localized: 'Rocker: Może chłopaki już tam na mnie czekają.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924456
    m_Localized: 'Rocker: ROCK AND ROLL DO ŚMIERCI, KURWA!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924457
    m_Localized: 'Experienced: Jasne, herbatniku. Powiedz słowo, a pokażę, co chcesz zobaczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924458
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924459
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924460
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924461
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924462
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924463
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924464
    m_Localized: 'Experienced: Zęby, co? Żółte i spróchniałe, czy coś w tym stylu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924465
    m_Localized: 'Experienced: Klawisze nie wydają najlepszej jakości szczoteczek do zębów. Nie zważaj na krwawiące dziąsła.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924466
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924467
    m_Localized: 'Experienced: To nie jest żaden objaw, co, waflu?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924468
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924469
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924470
    m_Localized: 'Experienced: Nie ma problemu, kolesiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924471
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924472
    m_Localized: 'Experienced: Widzisz? Normalne. Za wyjątkiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924473
    m_Localized: 'Experienced: Wyszło mi coś na nich. Nie przejmuj się, to tylko wysypka od gorąca.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924474
    m_Localized: 'Experienced: Ciężko kiedyś pracowałem tymi rękoma… ale odsiedziałem już swoje za to.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924475
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924476
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924477
    m_Localized: 'Experienced: Chcesz w nich ujrzeć, czy mam jakieś sumienie?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924478
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924479
    m_Localized: 'Experienced: Jasne, patrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924480
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924481
    m_Localized: 'Experienced: Pomyślałem, że ciemne okulary pomogą ze słońcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924482
    m_Localized: 'Experienced: Okazało się jednak, że pogorszyły sprawę. Są bezużyteczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924483
    m_Localized: 'Experienced: Ale są bezużyteczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924484
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924485
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924486
    m_Localized: 'Experienced: Kolesiu, słuchaj… pokażę, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924487
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924488
    m_Localized: 'Experienced: Kiedyś po pijaku się tam poparzyłem. Nie przestrasz się.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924489
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924490
    m_Localized: 'Experienced: Widzisz? I jak? Nie jestem jednym z tych dziwadeł, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924491
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924492
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924493
    m_Localized: 'Experienced: Co ty, chcesz mnie udupić? Portret do kartoteki mi robisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924494
    m_Localized: 'Experienced: Czy może to jakiś test…?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924495
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924496
    m_Localized: 'Experienced: Czuje się, jakby mnie znowu wprowadzali do systemu. Zdjęcie do teczki i wszystko inne.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924497
    m_Localized: 'Experienced: Dobra, rób, jeśli musisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924498
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924499
    m_Localized: 'Experienced: Skończyłeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924500
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924501
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924502
    m_Localized: 'Experienced: Ja pierdolę. Teraz uszy?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924503
    m_Localized: 'Experienced: Chyba ci w dyńce coś przestaje stykać, kolesiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924504
    m_Localized: 'Experienced: Serio? Musisz je zobaczyć?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924505
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924506
    m_Localized: 'Experienced: Dobra, chuj.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924507
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924508
    m_Localized: 'Experienced: I co, znalazłeś tam jakieś brakujące klepki?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924509
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924510
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924511
    m_Localized: 'Experienced: Na pewno wszystko okej z twoim deklem?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924512
    m_Localized: 'Experienced: Mam żółte zęby, więc po co wyciągasz giwerę?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924513
    m_Localized: 'Experienced: Czy może czepiasz się krwawiących dziąseł i za to mnie kropniesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924514
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924515
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924516
    m_Localized: 'Experienced: Waflu, po cholerę sięgnąłeś po spluwę? Odłóż ją.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924517
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924518
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924519
    m_Localized: 'Experienced: Myślisz, że ci ściemniam?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924520
    m_Localized: 'Experienced: Mówię ci, ciemne okulary nie pomagają ze słońcem. Sam spróbuj.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924521
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924522
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924523
    m_Localized: 'Experienced: Kumam, nie jest to piękny widok…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924524
    m_Localized: 'Experienced: Ale po co to wszystko? Dobrze nam się gadało.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924525
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924526
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924527
    m_Localized: 'Experienced: Herbatniku, czy ty może mnie nie pomyliłeś z jakimś innym łobuzem?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924528
    m_Localized: 'Experienced: Capnęli mnie, odsiedziałem swoje i dopiero niedawno wyszedłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924529
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924530
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924531
    m_Localized: 'Experienced: Ty na poważnie? Grubo przesadzasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924532
    m_Localized: 'Experienced: Rozumiem zęby i brudne paznokcie, ale uszy? Nigdy o nich nie wspominali.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924533
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924534
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924535
    m_Localized: 'Experienced: Dobrze. Nie wyciągaj strzelby przy byle gównie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924536
    m_Localized: 'Experienced: Wystarczy drgnięcie palca na spuście i po ptakach. Koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924537
    m_Localized: 'Experienced: Wiedziałem, że nie dasz sobie w kaszę dmuchać, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924538
    m_Localized: 'Experienced: Nie celuj do człowieka za byle pierdołę, kumasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924539
    m_Localized: 'Experienced: Wierz mi, miałem dość tej zabawy z klawiszami.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924540
    m_Localized: 'Experienced: To twoja melina, więc nie będę się wtrącał, ale nie bądź takim zamordystą.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924541
    m_Localized: 'Experienced: Nie jesteś przecież największym twardzielem na dzielni, który kroi wszystkich do czysta, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924542
    m_Localized: 'Experienced: Radzę oszczędzać pestki. To znaczy naboje.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924543
    m_Localized: 'Experienced: Wierz mi na słowo, nie jestem dziwadłem. Krzyżyk na sercu!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924544
    m_Localized: 'Experienced: To jedyna rzecz, którą posiadam, a nie ukradłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924545
    m_Localized: 'Experienced: Postradałeś zmysły, kolesiu? Chciałeś mnie zabić z powodu głupiego zdjęcia?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924546
    m_Localized: 'Experienced: Stary, nawet pieprzone klawisze tak się nie znęcały…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924547
    m_Localized: 'Experienced: Popatrz, popatrz, wróciłeś po rozum do głowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924548
    m_Localized: 'Experienced: Przez moment myślałem, że kropniesz mnie z powodu jakiejś głupoty, której nawet nie podali w telewizji.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924549
    m_Localized: 'Experienced: O w mordę, ty kapuściany łbie. Myślałem, żeś równy chłop, a tyś kawał gnoja!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924550
    m_Localized: 'Experienced: Oby cię szlag jasny trafił!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924551
    m_Localized: 'Jacket: Kurde, gościu… Jeśli jestem Przybyszem, nic mi nie mów, tylko strzelaj, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924552
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924553
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924554
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924555
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924556
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924557
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924558
    m_Localized: 'Jacket: Jasne, patrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924559
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924560
    m_Localized: 'Jacket: Mam zły zgryz, czasem gryzę się w policzki.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924561
    m_Localized: 'Jacket: A potem wyłażą wrzody… Przechlapane z nimi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924562
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924563
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924564
    m_Localized: 'Jacket: Nie ma problemu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924565
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924566
    m_Localized: 'Jacket: Kurtka zrobiona jest z jakiegoś taniego dziadostwa. Dostaję od niej wysypki.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924567
    m_Localized: 'Jacket: Widzisz? Nic niezwykłego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924568
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924569
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924570
    m_Localized: 'Jacket: Pokażę ci oczy, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924571
    m_Localized: 'Jacket: …jestem trochę roztrzęsiony. Nie oceniaj mnie zbyt surowo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924572
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924573
    m_Localized: 'Jacket: I jak? Wszystko git?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924574
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924575
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924576
    m_Localized: 'Jacket: Och, jeśli chodzi o moje pachy…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924577
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924578
    m_Localized: 'Jacket: Wiem, że podrażnienie jest objawem Przybysza.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924579
    m_Localized: 'Jacket: Ale to od kurtki. Pocę się w niej, a ostatnio trudno się gdzieś wykąpać.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924580
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924581
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924582
    m_Localized: 'Jacket: Chętnie dam zrobić sobie zdjęcie, ale ten aparat jest jakiś niecodzienny.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924583
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924584
    m_Localized: 'Jacket: O rany, czy to ten film z telewizji czuły na aurę?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924585
    m_Localized: 'Jacket: Prawdę mówiąc, nie wyglądasz na kogoś, kto by wierzył w takie rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924586
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924587
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924588
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924589
    m_Localized: 'Jacket: Uszu nie było na liście objawów, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924590
    m_Localized: 'Jacket: Ale przyznaję, że nie jestem do końca obeznany w temacie. Może nie znam tego objawu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924591
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924592
    m_Localized: 'Jacket: Jak tam? Wszystko okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924593
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924594
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924595
    m_Localized: 'Jacket: Jestem Przybyszem?! Ale mam krzywe zęby!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924596
    m_Localized: 'Jacket: PROSZĘ, NIE STRZELAJ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924597
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924598
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924599
    m_Localized: 'Jacket: Nie, czekaj, wysypka jest od kurtki!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924600
    m_Localized: 'Jacket: Czekaj, przecież nie mam nic na rękach!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924601
    m_Localized: 'Jacket: NIE JESTEM PRZYBYSZEM! PROSZĘ, NIE STRZELAJ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924602
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924603
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924604
    m_Localized: 'Jacket: Co?! Jestem Przybyszem?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924605
    m_Localized: 'Jacket: Ale nie mam nawet czerwonych oczu!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924606
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924607
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924608
    m_Localized: 'Jacket: Ja cię kręcę… Naprawdę jestem Przybyszem?!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924609
    m_Localized: 'Jacket: O JA PIERDOLĘ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924610
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924611
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924612
    m_Localized: 'Jacket: Czekaj, moment! Co jest nie tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924613
    m_Localized: 'Jacket: Wyczytałeś coś z mojej aury?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924614
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924615
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924616
    m_Localized: 'Jacket: Czekaj, co jest nie tak z moimi uszami?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924617
    m_Localized: 'Jacket: W czym jest problem?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924618
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924619
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924620
    m_Localized: 'Jacket: Dzięki… że mnie nie zastrzeliłeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924621
    m_Localized: 'Jacket: Całe życie przeleciało mi przed oczami.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924622
    m_Localized: 'Jacket: Zrobiłeś to celowo, prawda?!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924623
    m_Localized: 'Jacket: Serce podskoczyło mi do gardła. Dlaczego to zrobiłeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924624
    m_Localized: 'Jacket: Co było objawem?! Dlaczego w ogóle…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924625
    m_Localized: 'Jacket: Moment…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924626
    m_Localized: 'Jacket: Drgające źrenice to objaw Przybysza?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924627
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924628
    m_Localized: 'Jacket: Nawet nie wiedziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924629
    m_Localized: 'Jacket: Jednak mnie nie zabijesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924630
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924631
    m_Localized: 'Jacket: Dzięki, że nie pociągnąłeś za spust, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924632
    m_Localized: 'Jacket: Jeśli nie masz pewności, kim jestem, może następnym razem nie wyciągaj strzelby i nie strasz mnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924633
    m_Localized: 'Jacket: Wziąłeś wzór na kurtce za objaw Przybysza?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924634
    m_Localized: 'Jacket: Uff… martwiłem się, że będzie tam mnóstwo ciemnych plam.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924635
    m_Localized: 'Jacket: Dziwna rzecz, ten aparat na aury…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924636
    m_Localized: 'Jacket: Więc nie jestem Przybyszem?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924637
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924638
    m_Localized: 'Jacket: To po co wyciągnąłeś strzelbę? PO CO, DO DIABŁA?!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924639
    m_Localized: 'Jacket: Mamo, tato… przykro mi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924640
    m_Localized: 'Jacket: Tak bardzo mi przykro…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414656
    m_Localized: 'Tough: Nie dam sobą pomiatać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414657
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414658
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414659
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414660
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414661
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414662
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414663
    m_Localized: 'Tough: Od dzieciństwa wystają mi kły.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414664
    m_Localized: 'Tough: Dokuczano mi z tego powodu. Do czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414665
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414666
    m_Localized: 'Tough: Mogłabym im wszystkie zęby powyrywać z tych szczerzących się gęb.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414667
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414668
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414669
    m_Localized: 'Tough: Lubię czuć się ładną.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414670
    m_Localized: 'Tough: Nikt nie prawi mi takich komplementów, ale robię to dla siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414671
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414672
    m_Localized: 'Tough: Noż kurwa mać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414673
    m_Localized: 'Tough: Połamały mi się? Kurde, jak to się stało?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414674
    m_Localized: 'Tough: Nieważne… mniejsza z tym.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414675
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414676
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414677
    m_Localized: 'Tough: Widziałam w życiu niejedno.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414678
    m_Localized: 'Tough: Z pewnością to zobaczysz, jeśli spojrzysz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414679
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414680
    m_Localized: 'Tough: Tak myślałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414681
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414682
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414683
    m_Localized: 'Tough: Nie. Do tego nie dojdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414684
    m_Localized: 'Tough: Jesteś jednym z tych świrów mających obsesję na punkcie tego objawu?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414685
    m_Localized: 'Tough: Nie chcę nikogo znowu zabijać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414686
    m_Localized: 'Tough: Nie chcę znowu doznać rozczarowania.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414687
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414688
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414689
    m_Localized: 'Tough: Rzadko robię sobie zdjęcia. Ale spoko, zobaczymy, jak wyjdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414690
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414691
    m_Localized: 'Tough: Nie wierzę w te bujdy o aurach, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414692
    m_Localized: 'Tough: Jednak to ma jakiś sens.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414693
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414694
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414695
    m_Localized: 'Tough: Niedawno je sobie przekłułam.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414696
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414697
    m_Localized: 'Tough: Podobają mi się teraz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414698
    m_Localized: 'Tough: Nosiłam niewielkie kolczyki, ale nigdy nie mogłam znaleźć odpowiednich.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414699
    m_Localized: 'Tough: Ale te teraz… Pasują do mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414700
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414701
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414702
    m_Localized: 'Tough: Obrałeś sobie zły cel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414703
    m_Localized: 'Tough: Potworem w tym domu z całą pewnością nie jestem ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414704
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414705
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414706
    m_Localized: 'Tough: Co, chcesz, żebym zdjęła akryle? Zapomnij.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414707
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414708
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414709
    m_Localized: 'Tough: Muszę mieć wszystko na oku.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414710
    m_Localized: 'Tough: Każdy szczegół.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414711
    m_Localized: 'Tough: Nic na to nie poradzę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414712
    m_Localized: 'Tough: Chciałabym móc zapomnieć połowę tego, co widziałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414713
    m_Localized: 'Tough: Albo lepiej wszystko.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414714
    m_Localized: 'Tough: Ale co się zobaczyło, to się nie odzobaczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414715
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414716
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414717
    m_Localized: 'Tough: O ja pierdolę…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414718
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414719
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414720
    m_Localized: 'Tough: Ale dla ciebie, jak widać, nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414721
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414722
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414723
    m_Localized: 'Tough: Co ty tam, u licha, widziałeś? Woskowinę?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414724
    m_Localized: 'Tough: Po kiego chuja wymachujesz mi tu bronią?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414725
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414726
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414727
    m_Localized: 'Tough: Czy to jakiś test? I jak? Zdałam? Nawet nie drgnęłam, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414728
    m_Localized: 'Tough: Ale nie jest fajnie, gdy ktoś ci celuje w łeb.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414729
    m_Localized: 'Tough: Pewnie, wygląd niewiele dziś znaczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414730
    m_Localized: 'Tough: Ale dbanie o siebie… wciąż sprawia mi przyjemność. Móc spojrzeć w lustro i nie przestraszyć się.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414731
    m_Localized: 'Tough: Nie znoszę patrzeć na to, co się tam wyrabia.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414732
    m_Localized: 'Tough: Ale sprawy szybko się nie zmienią.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414733
    m_Localized: 'Tough: Jedyne, co nam pozostaje, to nie dać się.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414734
    m_Localized: 'Tough: Powiedz mi, czy to naprawdę jest tego warte? Zastrzeliłbyś mnie, gdybyś miał taką ochotę?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414735
    m_Localized: 'Tough: A gdy sprawa by się dokonała, czy spojrzałbyś chociaż na moje zwłoki?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414736
    m_Localized: 'Tough: Ten świat jest przeklęty jak sam skurwysyn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414737
    m_Localized: 'Tough: Powiedz, wierzysz w aury? Duszę? Coś z tych rzeczy?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414738
    m_Localized: 'Tough: Czy myślisz, że łotr nawet po śmierci pozostaje łotrem?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414739
    m_Localized: 'Tough: Ciągle się zastanawiam… Kiedy to się skończy, co się stanie ze wszystkimi popychadłami?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414740
    m_Localized: 'Tough: Jak będzie wyglądało ich życie?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414741
    m_Localized: 'Tough: Naprawdę pociągniesz za spust?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414742
    m_Localized: 'Tough: I tyle z tego będzie… z całej mojej walki…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414743
    m_Localized: 'Tough: Skończy się w chałupie jakiegoś samotnego postrzeleńca.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414744
    m_Localized: 'Bald: Tak, chętnie, przyjacielu. Co chcesz zobaczyć?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414745
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414746
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414747
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414748
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414749
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414750
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414751
    m_Localized: 'Bald: Ee… jasne. Palę czasem papierosy. Oby mi nie capiło z gęby za mocno.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414752
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414753
    m_Localized: 'Bald: I jak? W porządeczku?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414754
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414755
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414756
    m_Localized: 'Bald: Mam, ekhm… wypryski. Dlatego nakleiłem sobie plastry.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414757
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414758
    m_Localized: 'Bald: Gdzieś słyszałem, że przykrycie tego pomaga.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414759
    m_Localized: 'Bald: Już prawie mi zeszły. Wciąż jednak chciałbym zmienić opatrunek, tak na wszelki wypadek. Nie masz może jakiegoś?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414760
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414761
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414762
    m_Localized: 'Bald: Pewnie zauważyłeś, że mam jakiś syf na oku.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414763
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414764
    m_Localized: 'Bald: Czort wie, kiedy mi to wyszło. Nieźle się wtedy przestraszyłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414765
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414766
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414767
    m_Localized: 'Bald: Ale nie przeraź się, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414768
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414769
    m_Localized: 'Bald: Kolejny problem dermatologiczny. Widzisz? Wyłysiałem i wszędzie mam takie zmiany skórne.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414770
    m_Localized: 'Bald: O kurczę, nie kąpałem się od tygodni. Wybacz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414771
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414772
    m_Localized: 'Bald: Pachy to tylko… pachy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414773
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414774
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414775
    m_Localized: 'Bald: O, wspaniały pomysł. Światła, kamera, akcja!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414776
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414777
    m_Localized: 'Bald: I jak? Poka, poka!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414778
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414779
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414780
    m_Localized: 'Bald: Zrozumiano.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414781
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414782
    m_Localized: 'Bald: Nie lubię ich sobie czyścić. Sięgnę za głęboko i boli jak cholera.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414783
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414784
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414785
    m_Localized: 'Bald: Hej, no weź, nie trzeba od razu tak. Dobrze nam się rozmawiało…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414786
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414787
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414788
    m_Localized: 'Bald: O‑okej, okej! Nie celuj tym we mnie!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414789
    m_Localized: 'Bald: Zapomnij o plastrach! Nic mi nie jest!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414790
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414791
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414792
    m_Localized: 'Bald: Nie bądź taki! Nic mi nie jest! Przecież nie umieram na to.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414793
    m_Localized: 'Bald: Iść do lekarza też nie ma sensu. Wiesz, jacy oni są. „Nie ma na to lekarstwa” albo „Samo przejdzie”.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414794
    m_Localized: 'Bald: No i mi to samo przejdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414795
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414796
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414797
    m_Localized: 'Bald: Ej, opamiętaj się, dobrze? Wszystko jest okej! Nie celuj we mnie!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414798
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414799
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414800
    m_Localized: 'Bald: Jasny gwint! Możemy zrobić nowe, jeśli tamto było aż takie złe!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414801
    m_Localized: 'Bald: Czy może masz zepsuty aparat, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414802
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414803
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414804
    m_Localized: 'Bald: Ale ja nic nie zrobiłem!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414805
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414806
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414807
    m_Localized: 'Bald: Nie było mnie stać na dentystę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414808
    m_Localized: 'Bald: Prawdę mówiąc… kasy było na niewiele więcej niż jedzenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414809
    m_Localized: 'Bald: Mama od czasu do czasu szyła mi ciuchy z resztek materiału.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414810
    m_Localized: 'Bald: Pewnego razu zapiliśmy w trupa ze znajomymi z teatru.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414811
    m_Localized: 'Bald: Ostro daliśmy w palnik.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414812
    m_Localized: 'Bald: Nie rozpoznawałem własnych rąk. Czułem, jakbym oglądał film z perspektywy pierwszej osoby.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414813
    m_Localized: 'Bald: To cud, że nie wywinąłem niczego głupiego. Do domu doszedłem jakoś w butach nie od pary.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414814
    m_Localized: 'Bald: Przeraziła mnie ta popijawa. Rzuciłem po niej picie. Gdyby nie to, pewnie zapiłbym się na śmierć.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414815
    m_Localized: 'Bald: Pomimo tego na początku aż dygotałem ze strachu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414816
    m_Localized: 'Bald: Wkręciłem sobie, że tracę wzrok czy coś.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414817
    m_Localized: 'Bald: Ale nie, nigdy nie widziałem zbyt dobrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414818
    m_Localized: 'Bald: A leczenie tego? Ceny są z kosmosu, nie stać mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414819
    m_Localized: 'Bald: Co ja na to mogę powiedzieć?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414820
    m_Localized: 'Bald: Jesteś groźny, przyjacielu. Decydujesz o tym, kto żyje, a kto umrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414821
    m_Localized: 'Bald: To zdrowo jebnięte.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414822
    m_Localized: 'Bald: Jak zawsze znowu wszyscy piliśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414823
    m_Localized: 'Bald: A po paru dniach dowiedzieliśmy się, że jedna dziewczyna nigdy nie dotarła do domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414824
    m_Localized: 'Bald: Wydrukowaliśmy plakaty z jej zdjęciem i informacją, że zaginęła.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414825
    m_Localized: 'Bald: I wiesz, co się okazało?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414826
    m_Localized: 'Bald: Poślizgnęła się, wpadła do rzeki i utonęła.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414827
    m_Localized: 'Bald: Co za koszmar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414828
    m_Localized: 'Bald: Była sympatyczna. I ładna.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414829
    m_Localized: 'Bald: Uwielbiałem, gdy mama czyściła mi uszy. Robiła to tak delikatnie, że nigdy nie bolało.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414830
    m_Localized: 'Bald: Ale już nigdy więcej tego nie zrobi… nie z tymi palcami…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414831
    m_Localized: 'Bald: Szlag by to…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414832
    m_Localized: 'Bald: Ty chuju!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414833
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414834
    m_Localized: 'Nervous: Przypomina mi to szpital. Hi, hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414835
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414836
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414837
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414838
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414839
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414840
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414841
    m_Localized: 'Nervous: Przez leki moje zęby stały się bardziej ostrusieńkie…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414842
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414843
    m_Localized: 'Nervous: Są jak igły i świetne do zdzierania skóry z policzków w drobniutkich kawałeczkach. Warstewka po warstewce.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414844
    m_Localized: 'Nervous: Aż do krwi. I do bólu. Och, ten ból…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414845
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414846
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414847
    m_Localized: 'Nervous: Oduczyłem się grzebania przy paznokciach.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414848
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414849
    m_Localized: 'Nervous: Ale kiedy odstaje mi skórka, mam ochotę ją zerwać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414850
    m_Localized: 'Nervous: Powoli odrywać, aby czuć narastające pieczenie. Hi, hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414851
    m_Localized: 'Nervous: Boli przez jakiś czas. Wtedy kopię w ziemi, póki rana jest świeża… Mmm… Ciężko, ostro, mocno…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414852
    m_Localized: 'Nervous: Boli przez jakiś czas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414853
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414854
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414855
    m_Localized: 'Nervous: Masz ładne oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414856
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414857
    m_Localized: 'Nervous: Podglądam cię, jak śpisz i gdy przechadzasz się nocami…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414858
    m_Localized: 'Nervous: Nie ufasz komuś? Hi, hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414859
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414860
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414861
    m_Localized: 'Nervous: Nigdy mnie nie nauczono, jak o siebie dbać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414862
    m_Localized: 'Nervous: Ale w szpitalu widziałem jak robią kąpu‑kąpu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414863
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414864
    m_Localized: 'Nervous: Nigdy mi to nie wychodzi. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414865
    m_Localized: 'Nervous: I teraz też już umiem. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414866
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414867
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414868
    m_Localized: 'Nervous: Nie podoba mi się to.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414869
    m_Localized: 'Nervous: Hm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414870
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414871
    m_Localized: 'Nervous: Kiedyś się ze mnie śmiali… ale zgadnij, kto teraz śmieje się ostatni.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414872
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414873
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414874
    m_Localized: 'Nervous: Mało mnie obchodzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414875
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414876
    m_Localized: 'Nervous: Bez sensu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414877
    m_Localized: 'Nervous: Nie ma przyjemności, nie ma bólu. Nie ma znaczenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414878
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414879
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414880
    m_Localized: 'Nervous: Szorstkie włosie drapiące dziąsła… O Boże, tak…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414881
    m_Localized: 'Nervous: Ale to… lekka przesada…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414882
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414883
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414884
    m_Localized: 'Nervous: DLACZEGO?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414885
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414886
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414887
    m_Localized: 'Nervous: JA?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414888
    m_Localized: 'Nervous: Nie zabiłem cię we śnie… jeszcze!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414889
    m_Localized: 'Nervous: Jak możesz? W starego, małego mnie…? Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414890
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414891
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414892
    m_Localized: 'Nervous: Och?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414893
    m_Localized: 'Nervous: Moje gładkie pachy czynią mnie złoczyńcą?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414894
    m_Localized: 'Nervous: Lecz wciąż… Hi, hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414895
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414896
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414897
    m_Localized: 'Nervous: Ale… miło… z twojej strony. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414898
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414899
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414900
    m_Localized: 'Nervous: Dlaczego chcesz mnie pif‑pafnąć?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414901
    m_Localized: 'Nervous: Ulżyło ci? Czujesz się czystszy?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414902
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414903
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414904
    m_Localized: 'Nervous: W szpitalu usmażyli mi elektrowstrząsami mózg. Bzt, bzt, bzt!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414905
    m_Localized: 'Nervous: Ale jedyną osobą, która mogła mi pomóc… byłem ja. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414906
    m_Localized: 'Nervous: Przestałem skubać paznokcie, gdy zacząłem gryźć się w policzki!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414907
    m_Localized: 'Nervous: Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414908
    m_Localized: 'Nervous: Grozisz pif‑pafkiem komuś, kto wie, gdzie i kiedy spisz…? Hi, hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414909
    m_Localized: 'Nervous: Czy Przybysze w ogóle czymś się różnią od osób niepasujących do otoczenia?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414910
    m_Localized: 'Nervous: Ludzie nie znoszą i jednych, i drugich…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414911
    m_Localized: 'Nervous: Skąd można wiedzieć? Czy ty wiesz? Wiesz? Hi, hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414912
    m_Localized: 'Nervous: Wisi nade mną cień… Hi, hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414913
    m_Localized: 'Nervous: Cóż to może być? Czy ktoś tam jest? Czy to może jakieś przywidzenie?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414914
    m_Localized: 'Nervous: Co to za kleksy‑sreksy?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414915
    m_Localized: 'Nervous: Czy to… IGŁY?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414916
    m_Localized: 'Nervous: Czy jakieś prześwietlenie?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414917
    m_Localized: 'Nervous: Dlaczego groziłeś mi bronią?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414918
    m_Localized: 'Nervous: Czy ktoś kazał ci to zrobić?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414919
    m_Localized: 'Nervous: No? Kazał? Kazał?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414920
    m_Localized: 'Nervous: Nie? A tak myślałem…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414921
    m_Localized: 'Nervous: Hi, hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414922
    m_Localized: 'Nervous: Może nie powinienem był…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414923
    m_Localized: 'Nervous: …tu przychodzić…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414924
    m_Localized: 'Leper: Zgoda, jeśli dzięki temu poczujesz się lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414925
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414926
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414927
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414928
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414929
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414930
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414931
    m_Localized: 'Leper: Widzisz? Normalne.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414932
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414933
    m_Localized: 'Leper: I proste. Może i mam problemy ze skórą, ale z zębami żadnych.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414934
    m_Localized: 'Leper: Nie zabijesz mnie przez tę jedną rzecz, którą mogę się pochwalić, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414935
    m_Localized: 'Leper: Krzywe jak świński ogon. Na pewno nie dowodzą, że jestem Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414936
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414937
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414938
    m_Localized: 'Leper: Tak, tu nie jest lepiej z moją skórą.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414939
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414940
    m_Localized: 'Leper: Nie nazwiesz tego objawem Przybysza, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414941
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414942
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414943
    m_Localized: 'Leper: Pewnie, spójrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414944
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414945
    m_Localized: 'Leper: Wiem, że czerwone oczy to objaw. Ale to? To jest ten sam problem skórny jak wszędzie indziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414946
    m_Localized: 'Leper: Zapomniałem wspomnieć, że w oku czasem mam tiki. To wszystko od tego genetycznego schorzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414947
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414948
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414949
    m_Localized: 'Leper: Słucham? A po co?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414950
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414951
    m_Localized: 'Leper: Dobra, jak tam chcesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414952
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414953
    m_Localized: 'Leper: Widzisz? Nic nie odbiega od normy. Dziwne tylko, że nie mam tam problemów ze skórą.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414954
    m_Localized: 'Leper: No, syf jak w innych miejscach.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414955
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414956
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414957
    m_Localized: 'Leper: Zdjęcie? To objaw?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414958
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414959
    m_Localized: 'Leper: Zgoda, rób zdjęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414960
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414961
    m_Localized: 'Leper: Zdaje się, że mrugnąłem. I co ma być tym objawem, hę?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414962
    m_Localized: 'Leper: Co ma być tym objawem, hę?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414963
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414964
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414965
    m_Localized: 'Leper: Słucham? Do licha, co masz na myśli, mówiąc „uszy”?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414966
    m_Localized: 'Leper: Bez urazy, ale znam objawy Przybysza i to nie jest jeden z nich.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414967
    m_Localized: 'Leper: Ale jeśli tak bardzo pragniesz zobaczyć moje uszy, droga wolna.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414968
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414969
    m_Localized: 'Leper: I jak? Jest tam coś dziwnego?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414970
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414971
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414972
    m_Localized: 'Leper: Kurde, pogięło cię?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414973
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414974
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414975
    m_Localized: 'Leper: Mówiłem przecież, że to moja skóra.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414976
    m_Localized: 'Leper: Nic dodać, nic ująć, to problem skórny.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414977
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414978
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414979
    m_Localized: 'Leper: Mówiłem już, że to przez tę chorobę!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414980
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414981
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414982
    m_Localized: 'Leper: W kulki sobie lecisz?! Za co?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414983
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414984
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414985
    m_Localized: 'Leper: Hola, hola. To nawet nie jest normalny aparat.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414986
    m_Localized: 'Leper: Czy to… zdjęcie aury? Zabijesz mnie z powodu wyssanych z palca bzdur do wróżb?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414987
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414988
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414989
    m_Localized: 'Leper: Ty na poważnie?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414990
    m_Localized: 'Leper: Uszy nie są objawem Przybysza! Nigdy nie mówili o tym w telewizji!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414991
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414992
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414993
    m_Localized: 'Leper: O kurwa…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414994
    m_Localized: 'Leper: Po jaką cholerę mi groziłeś?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414995
    m_Localized: 'Leper: Dzięki.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414996
    m_Localized: 'Leper: Przeszło mi przez myśl, że naprawdę mnie zastrzelisz z powodu wyglądu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414997
    m_Localized: 'Leper: Ja pierdolę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414998
    m_Localized: 'Leper: Czy wyciągasz tę giwerę za każdym razem, gdy uważasz, że zauważyłeś objaw?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414999
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415000
    m_Localized: 'Leper: Jesteś taki sam, jak ci, którzy mają mnie za rozsiewacza choroby.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415001
    m_Localized: 'Leper: Upadłeś na głowę?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415002
    m_Localized: 'Leper: Od kiedy jakimś badziewnym aparacikiem sprawdzisz, kto jest Przybyszem?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415003
    m_Localized: 'Leper: Jasna cholera…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415004
    m_Localized: 'Leper: Przyprawisz mnie o zawał serca. Skąd w ogóle wiesz o tych uszach?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415005
    m_Localized: 'Leper: FEMA nigdy nie podała do wiadomości, że to jest objaw!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415006
    m_Localized: 'Leper: Niech to diabli, nie chcę…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415007
    m_Localized: 'Leper: …umierać…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621056
    m_Localized: 'Fairytaller: Z chęcią! Co dokładnie chce pan sprawdzić, gospodarzu?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621057
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621058
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621059
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621060
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621061
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621062
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621063
    m_Localized: 'Fairytaller: Proszę uprzejmie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621064
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621065
    m_Localized: 'Fairytaller: Nigdy nie miałem ładnych zębów, a od czasu ukończenia studiów nie miałem czasu na dentystę. Lato miałem… pracowite.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621066
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621067
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621068
    m_Localized: 'Fairytaller: Proszę uprzejmie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621069
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621070
    m_Localized: 'Fairytaller: Mam je od dziecka. Łaziłem po opuszczonych domach i na podłodze leżała metalowa siatka…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621071
    m_Localized: 'Fairytaller: Kolega spadł z szafki, która upadła mi na ręce. Wzór zostanie ze mną… pewnie do końca życia.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621072
    m_Localized: 'Fairytaller: Zadrapania są świeże. To z… nerwów.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621073
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621074
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621075
    m_Localized: 'Fairytaller: Proszę uprzejmie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621076
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621077
    m_Localized: 'Fairytaller: Oczy robią mi się czerwone od gorąca. Pomagają mi zimne okłady, ale teraz trudno je zdobyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621078
    m_Localized: 'Fairytaller: Ludzie często komentują kolor moich oczu. Niektórym się podoba, a innym… niezbyt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621079
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621080
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621081
    m_Localized: 'Fairytaller: Uhm… jeśli pan nalega, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621082
    m_Localized: 'Fairytaller: Proszę uprzejmie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621083
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621084
    m_Localized: 'Fairytaller: Tak, wiem. Proszę wybaczyć smrodek.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621085
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621086
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621087
    m_Localized: 'Fairytaller: Brzmi ciekawie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621088
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621089
    m_Localized: 'Fairytaller: Hm. Ciekawy efekt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621090
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621091
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621092
    m_Localized: 'Fairytaller: Proszę uprzejmie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621093
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621094
    m_Localized: 'Fairytaller: Tak, wiem. Trochę brudne. Ostatnio nie miałem wiele czasu o siebie zadbać.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621095
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621096
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621097
    m_Localized: 'Fairytaller: Wypłuczę usta! Najmocniej przepraszam! N‑nie mam szczoteczki. Proszę nie strzelać!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621098
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621099
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621100
    m_Localized: 'Fairytaller: Paznokcie?! To z wczoraj! W ciemnościach zahaczyłem o jakiś złom!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621101
    m_Localized: 'Fairytaller: To tylko blizna z dzieciństwa! Oprócz tego moje ręce są okej! Obiecuję!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621102
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621103
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621104
    m_Localized: 'Fairytaller: Czy mogę wziąć coś zimnego z lodówki? Mam tak od urodzenia, u‑udowodnię to!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621105
    m_Localized: 'Fairytaller: Okej, okej! Koniec żartów! Proszę, niech mnie pan nie zabija, gospodarzu! Błagam!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621106
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621107
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621108
    m_Localized: 'Fairytaller: Najmocniej przepraszam. Nie mam ze sobą przyborów toaletowych, a maniery nie pozwoliły mi skorzystać z pańskich.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621109
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621110
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621111
    m_Localized: 'Fairytaller: Mam nadzieję, że zacny pan nie osądzi mnie na podstawie czegoś tak błahego? To nic poważnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621112
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009664
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009665
    m_Localized: 'Fairytaller: U‑umyję je! Proszę, niech pan nie strzela!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009666
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009667
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009668
    m_Localized: 'Fairytaller: Dziękuję panu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009669
    m_Localized: 'Fairytaller: Obiecuję bardziej dbać o zęby.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009670
    m_Localized: 'Fairytaller: Uff… przez chwilę myślałem, że mnie pan zastrzeli z powodu tej blizny, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009671
    m_Localized: 'Fairytaller: Niełatwo jest ostatnimi czasy dbać o paznokcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009672
    m_Localized: 'Fairytaller: Ale tak na wszelki wypadek obiecuję czyścić je częściej.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009673
    m_Localized: 'Fairytaller: Dziękuję panu za wyrozumiałość, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009674
    m_Localized: 'Fairytaller: Też się z tego powodu zbytnio nie cieszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009675
    m_Localized: 'Fairytaller: A tak przy okazji… ma pan piękny kolor oczu, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009676
    m_Localized: 'Fairytaller: Dziękuję panu uprzejmie za nie zastrzelenie mnie, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009677
    m_Localized: 'Fairytaller: Obiecuję znaleźć czas na porządną kąpiel.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009678
    m_Localized: 'Fairytaller: Tak sobie myślałem, że zabicie kogoś na podstawie zdjęcia to małe faux pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009679
    m_Localized: 'Fairytaller: Było to ciekawe przeżycie, ale… wolałbym z tego powodu nie umierać.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009680
    m_Localized: 'Fairytaller: Kłaniam się nisko za oszczędzenie mojego życia. Niezwłocznie umyję uszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009681
    m_Localized: 'Fairytaller: Postaram się znaleźć jakieś patyczki higieniczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009682
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009683
    m_Localized: 'Fairytaller: Mamusiu…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009684
    m_Localized: 'FunnyGuy: Jasne, dawaj. I tak nie mam nic lepszego do roboty!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009685
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009686
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009687
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009688
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009689
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009690
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009691
    m_Localized: 'FunnyGuy: No ej, gdy szczotkujesz ze zbytnią werwą, ściera się szkliwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009692
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009693
    m_Localized: 'FunnyGuy: Ha, ha, zapomniałem, że jestem szczerbaty. Kryje się za tym ciekawa historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009694
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009695
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009696
    m_Localized: 'FunnyGuy: Zwykłe, spracowane ręce.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009697
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009698
    m_Localized: 'FunnyGuy: Czternaście lat pracy w fabryce.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009699
    m_Localized: 'FunnyGuy: I co z tego mam, hm? Popatrz, co z tego wyszło.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009700
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009701
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009702
    m_Localized: 'FunnyGuy: Mam czarną plamkę na tęczówce.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009703
    m_Localized: 'FunnyGuy: Spójrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009704
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009705
    m_Localized: 'FunnyGuy: W polu widzenia mam przez nią smugę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009706
    m_Localized: 'FunnyGuy: Ale można się po czasie przyzwyczaić.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009707
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009708
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009709
    m_Localized: 'FunnyGuy: Pozew sądowy przeciwko naszej fabryce to tylko kwestia czasu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009710
    m_Localized: 'FunnyGuy: Niedawno miałem przejść na emeryturę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009711
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009712
    m_Localized: 'FunnyGuy: A teraz nabawiłem się tego od wilgoci, widzisz? Maści nic nie dają! I pomimo tego wciąż każą nam się golić!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009713
    m_Localized: 'FunnyGuy: A teraz nabawiłem się tego od wilgoci, widzisz? Maści nic nie dają!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009714
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009715
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009716
    m_Localized: 'FunnyGuy: Powinienem wtedy zapiąć koszulę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009717
    m_Localized: 'FunnyGuy: E, mniejsza z tym. To tylko jedno zdjęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009718
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009719
    m_Localized: 'FunnyGuy: Nawet mi nie pokazuj. Do diabła z tym, nie chcę go oglądać.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009720
    m_Localized: 'FunnyGuy: No dobra, pokaż, jak wyszedłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009721
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009722
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009723
    m_Localized: 'FunnyGuy: Zgoda, czemu nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009724
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009725
    m_Localized: 'FunnyGuy: W fabryce nie było niczego, co mogłoby uszkodzić uszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009726
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009727
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009728
    m_Localized: 'FunnyGuy: Ej, spokojnie. Wiem, że masz temperament, ale nie daj ponieść się emocjom.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009729
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009730
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009731
    m_Localized: 'FunnyGuy: Po co się spinasz? Daj se siana.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009732
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009733
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009734
    m_Localized: 'FunnyGuy: A, pierdolę to.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009735
    m_Localized: 'FunnyGuy: Jak chcesz strzelać, to strzelaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009736
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009737
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009738
    m_Localized: 'FunnyGuy: Ha! To na pewno wszystko załatwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009739
    m_Localized: 'FunnyGuy: Istne panaceum!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009740
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009741
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009742
    m_Localized: 'FunnyGuy: Aha, najważniejszy objaw! Wielka spluwa!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009743
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009744
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009745
    m_Localized: 'FunnyGuy: Ręce ci nie cierpną od wymachiwania tym?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009746
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009747
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009748
    m_Localized: 'FunnyGuy: Jestem wdzięczny, że mnie nie zastrzeliłeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009749
    m_Localized: 'FunnyGuy: Historia o moich zębach? Nie, stary. Naprawdę myślisz, że możesz wyciągnąć giwerę, a potem uciąć sobie pogaduszkę?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009750
    m_Localized: 'FunnyGuy: Wyobrażasz sobie pójść do pracy, a oni cię zwyczajnie zwalniają?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009751
    m_Localized: 'FunnyGuy: Byłem prawdziwym przodownikiem pracy. I po co?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009752
    m_Localized: 'FunnyGuy: Zamykali całą fabrykę przez narastające straty.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009753
    m_Localized: 'FunnyGuy: Nawet umrzeć nie można w spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009754
    m_Localized: 'FunnyGuy: Co jeszcze chcesz usłyszeć, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009755
    m_Localized: 'FunnyGuy: Widzę cię wyraźnie, jak również tę broń, z której we mnie celowałeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009756
    m_Localized: 'FunnyGuy: Bóg cię osądzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009757
    m_Localized: 'FunnyGuy: Zdaje się, że emerytura sama mnie znalazła.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009758
    m_Localized: 'FunnyGuy: Bez pracy, banki zakosiły mi forsę, a całą resztę przypala słońce.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009759
    m_Localized: 'FunnyGuy: Żyć, nie umierać, co? Jak w bajce! HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009760
    m_Localized: 'FunnyGuy: Z jakiegoś powodu moja rodzina zawsze… bardzo źle znosiła pozowanie do zdjęć.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009761
    m_Localized: 'FunnyGuy: Zawsze tylko „Po co brałeś aparat? Idź porób zdjęcia jakimś żabom albo czemuś”.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009762
    m_Localized: 'FunnyGuy: Chyba mam to po nich.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009763
    m_Localized: 'FunnyGuy: Ale to wciąż nie fair, że wzięli całą moją kasę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009764
    m_Localized: 'FunnyGuy: I nie fair, w jaki sposób nas potraktowali w fabryce.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009765
    m_Localized: 'FunnyGuy: O, prawdziwy z ciebie śmieszek, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009766
    m_Localized: 'FunnyGuy: Dla mnie to przynajmniej będzie koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009767
    m_Localized: 'FunnyGuy: Ostateczna emerytura.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009768
    m_Localized: 'Alt: Skoro z ledwością sklecili te reportaże, nie wyobrażam sobie, jak niechlujne musiały być ich kontrole.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009769
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009770
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009771
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009772
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009773
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009774
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009775
    m_Localized: 'Alt: Ostrzegam cię, jestem prawdziwym rekinem biznesu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009776
    m_Localized: 'Alt: Ha, ha, ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009777
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009778
    m_Localized: 'Alt: Jak mogłabym nie dbać o te perełki?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009779
    m_Localized: 'Alt: Dopiero niedawno dałam je sobie spiłować i dziąsła wciąż bolą. Dzięki nim wyglądam jak szajbuska!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009780
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009781
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009782
    m_Localized: 'Alt: Jeśli chodzi o paznokcie, to przegrałam loterię genów.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009783
    m_Localized: 'Alt: Aby dotrzeć na przedmieścia w spokoju, wezwałam taksówkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009784
    m_Localized: 'Alt: Ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009785
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009786
    m_Localized: 'Alt: Jakiś arogancki dupek też wbił się do taksówki i przesunął mnie na miejsce obok.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009787
    m_Localized: 'Alt: Hm, jego śnieżnobiałe zęby pamiętam, jakby to było wczoraj.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009788
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009789
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009790
    m_Localized: 'Alt: Moje oczy? Uwielbiam je prawie tak samo, jak moje dziary.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009791
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009792
    m_Localized: 'Alt: I co myślisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009793
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009794
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009795
    m_Localized: 'Alt: Chętnie pokaże ci moje pachy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009796
    m_Localized: 'Alt: Tylko że nie jest to przyjemny widok.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009797
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009798
    m_Localized: 'Alt: Mówiłam.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009799
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009800
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009801
    m_Localized: 'Alt: O raju, też masz aparat.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009802
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009803
    m_Localized: 'Alt: Zobaczmy więc…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009804
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009805
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009806
    m_Localized: 'Alt: Hm. No dobra.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009807
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009808
    m_Localized: 'Alt: Musiałam wyjąć tunele. Zbyt wielu pijaków mi dokuczało.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009809
    m_Localized: Zostaw ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009810
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009811
    m_Localized: 'Alt: Moment. Nie przeszkadza ci, jak mało precyzyjne są te „objawy”?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009812
    m_Localized: 'Alt: Mogą je mieć także normalni ludzie. Czy ten trend nie wydaje ci się… podejrzanie szeroki?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009813
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009814
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009815
    m_Localized: 'Alt: Czy patrzysz na mnie przez pryzmat historii, którą ci opowiedziałam?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009816
    m_Localized: 'Alt: Co ci się niby zdaje, że zrobiłam? To był przypadek, że się przewróciłam i urwałam paznokieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009817
    m_Localized: 'Alt: Co ci się niby zdaje, że zrobiłam?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009818
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009819
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009820
    m_Localized: 'Alt: Że co? Dlaczego?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009821
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009822
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009823
    m_Localized: 'Alt: Nie obawiaj się tego. Usuwałam tatuaż i upał coś pokomplikował.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009824
    m_Localized: 'Alt: Spróbuj usunąć tatuaż i przekonaj się sam.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009825
    m_Localized: 'Alt: Boli jak cholera i bez przerwy wszędzie się pocisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009826
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009827
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009828
    m_Localized: 'Alt: Wiem, to dziwne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009829
    m_Localized: 'Alt: Chciałam wyglądać powalająco.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009830
    m_Localized: 'Alt: Zdecydowanie nie planowałam robić sobie zdjęcia do nekrologu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009831
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009832
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009833
    m_Localized: 'Alt: Teraz żałuję, że je wyjęłam.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009834
    m_Localized: 'Alt: Wtedy przynajmniej byłoby jasne, za co kipnę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009835
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009836
    m_Localized: Wysłuchaj jej
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009837
    m_Localized: 'Alt: Odpocznę sobie od tych wszystkich atrakcji, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009838
    m_Localized: 'Alt: Grożenie śmiercią nieźle szarga nerwy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009839
    m_Localized: 'Alt: Nie ma mowy, żebym wróciła do miasta z powodu paznokci.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009840
    m_Localized: 'Alt: Kto wie, co się wydarzy w chwili, gdy wrócę do tego bajzlu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009841
    m_Localized: 'Alt: Większość dziar zrobiłam sobie po śmierci bliskiej osoby.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009842
    m_Localized: 'Alt: Trochę jak wspomnienia utrwalone tuszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009843
    m_Localized: 'Alt: Jak widzisz, moje życie to nie bajka.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009844
    m_Localized: 'Alt: Ale gdy straciłam swoją drugą połówkę… wtedy wytatuowałam sobie oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009845
    m_Localized: 'Alt: Żebym go widziała, gdy patrzę w lustro.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009846
    m_Localized: 'Alt: Lepiej nie tatuować się w nieodpowiednich miejscach.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009847
    m_Localized: 'Alt: Szkoda, że nikt po mnie nie zapłacze. Nikt nie utrwali pamięci o mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009848
    m_Localized: 'Alt: Żyjemy w przedziwnych czasach…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009849
    m_Localized: 'Alt: Opuściłam pieprzony cyrk tylko po to, by polazły za mną klauny.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009850
    m_Localized: 'Alt: To straszne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009851
    m_Localized: 'Tourist: Czy myśli pan, że jestem zainfekowany, gospodarzu?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009852
    m_Localized: Zęby
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009853
    m_Localized: Ręce
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009854
    m_Localized: Oczy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009855
    m_Localized: Pachy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009856
    m_Localized: Zdjęcie
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009857
    m_Localized: Uszy
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009858
    m_Localized: 'Tourist: Szanowny panie… czy zęby mogą być świadectwem zarażenia wirusem?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009859
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009860
    m_Localized: 'Tourist: Jeśli to ma pomóc…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009861
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009862
    m_Localized: 'Tourist: Proste, prawda? Dentyści w moich stronach nie każą płacić wiele.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009863
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009864
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009865
    m_Localized: 'Tourist: Moje ręce? Czy zacny pan szuka jakiejś wysypki?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009866
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009867
    m_Localized: 'Tourist: Proszę się nie obawiać, skóra mnie swędzi po opalaniu. Pewnie się podrapałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009868
    m_Localized: 'Tourist: Trochę je poparzyłem. To nie infekcja.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009869
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009870
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009871
    m_Localized: 'Tourist: Oczy? Żaden problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009872
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009873
    m_Localized: 'Tourist: Niestety okulary przeciwsłoneczne niewiele pomagają.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009874
    m_Localized: 'Tourist: Dobrze, że wziąłem okulary przeciwsłoneczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009875
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009876
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009877
    m_Localized: 'Tourist: Słucham?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009878
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009879
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009880
    m_Localized: 'Tourist: To przez upał. Pocę się obficie i dostałem wysypki.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009881
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009882
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009883
    m_Localized: 'Tourist: Czy to jakieś urządzenie rządowe do wykrywania infekcji?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009884
    m_Localized: 'Tourist: Jeśli tak, to chętnie spróbuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009885
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009886
    m_Localized: 'Tourist: Hm… użyty film… jest niecodzienny.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009887
    m_Localized: 'Tourist: I te kropki… też są dziwne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009888
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009889
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009890
    m_Localized: 'Tourist: To ma sens. Co, jeśli wirus rozprzestrzenia się kanałem usznym?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009891
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009892
    m_Localized: 'Tourist: Chyba wszystko jest tam w porządku.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009893
    m_Localized: Zostaw go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009894
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009895
    m_Localized: 'Tourist: O co chodzi, gospodarzu? Czy coś jest nie tak?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009896
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009897
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009898
    m_Localized: 'Tourist: Na miłość Boską, wyjaśniłem to panu, gospodarzu! Podrapałem się, to jest podrażnienie!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009899
    m_Localized: 'Tourist: Od kiedy opalenizna jest objawem?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009900
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009901
    m_Localized: 'Tourist: Szanowny panie, dlaczego pan we mnie celuje? Z powodu moich przekrwionych oczu?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009902
    m_Localized: 'Tourist: Gospodarzu, dlaczego pan we mnie celuje?!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009903
    m_Localized: 'Tourist: Nic nie mam z oczami!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009904
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009905
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009906
    m_Localized: 'Tourist: Szanowny pan twierdzi, że wysypki są objawem?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009907
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009908
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009909
    m_Localized: 'Tourist: A to za co, gospodarzu? Mówiłem, że to jakiś dziwny film! Nigdy takiego nie widziałem!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009910
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009911
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009912
    m_Localized: 'Tourist: Gospodarzu, moment, w czym problem? Nawet nie mam woskowiny!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009913
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009914
    m_Localized: Wysłuchaj go
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009915
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009916
    m_Localized: 'Tourist: Szanowny panie, dlaczego mi pan groził bronią?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009917
    m_Localized: 'Tourist: Gospodarzu, czy może pan już odłożyć broń?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009918
    m_Localized: 'Tourist: Rozumiem, ale przesadził pan, szanowny panie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009919
    m_Localized: 'Tourist: Mój Boże, to tylko opalenizna!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009920
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009921
    m_Localized: 'Tourist: Proszę pana, czy wszystkich pan u siebie tak traktuje?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009922
    m_Localized: 'Tourist: I jak? Nie strzeli pan, zacny panie?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009923
    m_Localized: 'Tourist: Co, u licha?! Pachy? Czy są teraz objawem?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009924
    m_Localized: 'Tourist: Gospodarzu, proszę się uspokoić!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009925
    m_Localized: 'Tourist: Zacny panie, dlaczego za każdym razem łapie pan za broń?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009926
    m_Localized: 'Tourist: To przecież pan chciał zrobić to zdjęcie!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009927
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009928
    m_Localized: 'Tourist: Gospodarzu, czy pan oszalał? To nie zabawka.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009929
    m_Localized: 'Tourist: Proszę przestać wymachiwać bronią, albo wszyscy uciekną ze strachu!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009930
    m_Localized: 'Tourist: Cholera… nigdy…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009931
    m_Localized: 'Tourist: …nie zwiedziłem świata…'
    m_Metadata:
      m_Items: []
  - m_Id: 94177391876841472
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
