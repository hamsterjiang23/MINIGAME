%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NotCharacterDialogs_pt-PT
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-PT
  m_SharedData: {fileID: 11400000, guid: e5ff4525f54b4b14096a51f9eb9cf8ce, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21953783779328
    m_Localized: 'TV: Notícia de última hora!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556544
    m_Localized: 'TV: Hoje, às 6h28, houve uma poderosa emissão de energia a partir do sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556545
    m_Localized: 'TV: Esta explosão foi maior do que os cientistas previram.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556546
    m_Localized: 'TV: A temperatura no exterior atingiu níveis críticos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556547
    m_Localized: 'TV: O governo declarou estado de emergência.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556548
    m_Localized: 'TV: Pedimos a todas as pessoas que evitem sair durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556549
    m_Localized: 'TV: E agora, com...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556550
    m_Localized: 'TV: Só um momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556551
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556552
    m_Localized: 'TV: Acabou de chegar ao nosso estúdio uma mensagem urgente sobre o contacto com Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556553
    m_Localized: 'TV: Testemunhas oculares descrevem-nos como criaturas capazes de imitar a aparência externa e o comportamento do ser humano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556554
    m_Localized: 'TV: Evite qualquer contacto com Visitantes. Num dos casos, foi possível identificar um sinal revelador destas criaturas...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556555
    m_Localized: 'TV: Dentes totalmente brancos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556556
    m_Localized: 'TV: Uma testemunha ocular confirmou esta informação.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556557
    m_Localized: 'TV: Encontrou uma pessoa sem-abrigo com dentes totalmente brancos, que acabou por ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556558
    m_Localized: 'TV: É tudo por agora. Mantenha a calma e não saia durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556559
    m_Localized: 'TV: Segue-se um programa de entretenimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556560
    m_Localized: 'TV: Boa tarde. Eis a previsão do tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556561
    m_Localized: 'TV: Uma frente quente aproxima-se da nossa região, trazendo um calor que bate o recorde anterior.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556562
    m_Localized: 'TV: Os meteorologistas indicam que as temperaturas podem subir ainda mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556563
    m_Localized: 'TV: Com a maior atividade solar, espera-se também um aumento da radiação UV.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556564
    m_Localized: 'TV: Para sua segurança, evite apanhar sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556565
    m_Localized: 'TV: As temperaturas elevadas podem causar insolações.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556566
    m_Localized: 'TV: Não se sabe ao certo se a exposição solar tem efeitos negativos sobre a nossa saúde...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556567
    m_Localized: 'TV: Mas para evitar queimaduras de terceiro grau, não saia de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556568
    m_Localized: 'TV: Infelizmente, o protetor solar não tem qualquer efeito neste caso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556569
    m_Localized: 'TV: É tudo por agora. Segue-se um programa de entretenimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556570
    m_Localized: 'TV: Vês bailarinas a dançarem graciosamente, cruzando o palco em saltos fortes mas delicados.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556571
    m_Localized: 'TV: Apesar da elegância, a dança evoca pensamentos de ansiedade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556572
    m_Localized: 'TV: Sentes que estão a tentar distrair-te dos acontecimentos atuais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556573
    m_Localized: 'TV: Se pelo menos alguém pudesse explicar o que está a acontecer...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556574
    m_Localized: 'TV: Boa tarde. Aqui estão as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556575
    m_Localized: 'TV: A atividade solar não está a diminuir e houve um ligeiro aumento dos níveis de criminalidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556576
    m_Localized: 'TV: Segundo os dados mais recentes, o número de homicídios nas últimas noites ultrapassou a média geral.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556577
    m_Localized: 'TV: Os especialistas suspeitam que isto está relacionado com os Visitantes e com a ansiedade crescente na sociedade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556578
    m_Localized: 'TV: E, agora, novas informações. Testemunhas oculares comunicaram a existência de um novo sinal da presença de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556579
    m_Localized: 'TV: Terra por baixo das unhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556580
    m_Localized: 'TV: De acordo com especialistas, este sinal ajuda a identificar Visitantes que rastejaram a partir do subsolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556581
    m_Localized: 'TV: É tudo por agora. Mantenha a calma e não saia durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556582
    m_Localized: 'TV: Segue-se um comunicado sobre um maníaco de tonalidade pálida. Mas antes, paramos para um intervalo publicitário.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556583
    m_Localized: 'TV: Comprar mantimentos implicava geralmente uma viagem até à loja.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556584
    m_Localized: 'TV: No entanto, agora, pode simplesmente comprá-los pegando no telefone e efetuando o seu pedido.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556585
    m_Localized: 'TV: Use o serviço de entregas EuroCêntrica. Ligue XXX-XXX-XXXX. As suas compras estarão à sua porta em 24 horas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556586
    m_Localized: 'TV: EuroCêntrica: um relaxamento delicioso no conforto da sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556587
    m_Localized: 'TV: Um maníaco de tonalidade pálida apareceu nas ruas da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556588
    m_Localized: 'TV: Segundo testemunhas oculares, todas as suas vítimas tinham algo em comum: estavam sozinhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556589
    m_Localized: 'TV: Além disso, o maníaco conversa com as vítimas antes de as matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556590
    m_Localized: 'TV: Com base em relatos, a polícia elaborou um retrato-robô do suspeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556591
    m_Localized: 'TV: É um homem de meia-idade, muito pálido, de cabelo preto, com uma constituição magra e que usa apenas umas calças.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556592
    m_Localized: 'TV: Várias pessoas relatam que ele usa a pele de outra pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556593
    m_Localized: 'TV: Esta informação ainda não foi confirmada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556594
    m_Localized: 'TV: Se vir este homem, não abra a porta e diga que há mais pessoas em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556595
    m_Localized: 'TV: É tudo por agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556596
    m_Localized: 'TV: Boa tarde. Aqui estão as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556597
    m_Localized: 'TV: O incomum calor continua a aumentar e a invasão dos Visitantes ainda não terminou.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750848
    m_Localized: 'TV: O governo criou um serviço especial para lidar com a crise emergente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750849
    m_Localized: 'TV: A Agência de Gestão de Emergências Federal, ou AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750850
    m_Localized: 'TV: Os funcionários da AGEF usam máscaras de gás e fatos de proteção amarelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750851
    m_Localized: 'TV: Apesar de terem entrado em funcionamento há pouco tempo, já identificaram um novo sinal da presença de Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750852
    m_Localized: 'TV: Olhos vermelhos raiados de sangue.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750853
    m_Localized: 'TV: Segundo os nossos dados, a AGEF observou este sinal em Visitantes detidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750854
    m_Localized: 'TV: As criaturas apresentam uma fotossensibilidade elevada, o que causa inflamação e vermelhidão nos olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750855
    m_Localized: 'TV: É tudo por agora. Mantenha a calma e não saia durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750856
    m_Localized: 'TV: Segue-se um relatório sobre a AGEF. Mas antes, paramos para um pequeno intervalo publicitário.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750857
    m_Localized: 'TV: Caos, terror e sofrimento. E tudo por causa dos Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750858
    m_Localized: 'TV: No entanto, na hora do desespero, quando as lágrimas já correm como um rio...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750859
    m_Localized: 'TV: EIS QUE OS FUNCIONÁRIOS DA AGEF CHEGAM PARA NOS SALVAR!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750860
    m_Localized: 'TV: Estes heróis da Agência de Gestão de Emergências Federal estão a proteger-nos da invasão dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750861
    m_Localized: 'TV: Até agora, a agência identificou 27 000 criaturas perigosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750862
    m_Localized: 'TV: Lembre-se: pode ajudar a agência, dando informações sobre qualquer atividade suspeita à sua volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750863
    m_Localized: 'TV: Para isso, use o convite para visitar a AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750864
    m_Localized: 'TV: Em caso de dúvida sobre se alguém é ou não um Visitante, ligue para a linha direta: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750865
    m_Localized: 'TV: Ao ajudar a AGEF, está a apoiar a luta contra os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750866
    m_Localized: 'TV: AGEF: o que é? E por que motivo foi criada?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750867
    m_Localized: 'TV: A Agência de Gestão de Emergências Federal é um serviço governamental criado para enfrentar a crise emergente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750868
    m_Localized: 'TV: Esta agência ajuda a resolver os problemas causados pela invasão dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750869
    m_Localized: 'TV: Não se sabe exatamente em que é que a agência está a trabalhar...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750870
    m_Localized: 'TV: Mas estamos confiantes de que o nosso destino está em boas mãos...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750871
    m_Localized: 'TV: A AGEF é composta por especialistas de várias áreas, incluindo cientistas de renome.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750872
    m_Localized: 'TV: Se um funcionário da AGEF aparecer à sua porta, recomendamos que coopere e siga as suas instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750873
    m_Localized: 'TV: Lembre-se: ao ajudar a AGEF, está a apoiar a luta contra os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750874
    m_Localized: 'TV: Boa tarde. Aqui estão as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750875
    m_Localized: 'TV: A AGEF implementou novas medidas para lidar com os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750876
    m_Localized: 'TV: Foram criadas zonas de quarentena para pessoas potencialmente perigosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750877
    m_Localized: 'TV: A AGEF identificou ainda um novo sinal para a presença de Visitantes após a realização de experiências com Visitantes detidos...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750878
    m_Localized: 'TV: Axilas sem pelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750879
    m_Localized: 'TV: A agência relata que este sinal está associado ao facto de os Visitantes não terem pelos nesta área.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750880
    m_Localized: 'TV: Pede-se aos cidadãos que tenham paciência com os testes e as escoltas até às zonas de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750881
    m_Localized: 'TV: É tudo por agora. Mantenha a calma e não saia durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750882
    m_Localized: 'TV: Já a seguir: um comunicado sobre as medidas que deve tomar no caso de descobrir um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750883
    m_Localized: 'TV: A AGEF sugere que o fenómeno dos Visitantes pode ser infeccioso ou representar uma ameaça biológica.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750884
    m_Localized: 'TV: Por isso, é fundamental comunicar a presença de qualquer pessoa suspeita e isolá-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750885
    m_Localized: 'TV: Se não puder levar um Visitante às zonas de quarentena, conceda ao Visitante um pedido especial para comparecer na AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750886
    m_Localized: 'TV: Durante a próxima ronda, um funcionário levará todos os portadores deste documento para análise.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750887
    m_Localized: 'TV: É tudo por agora. Segue-se um intervalo publicitário.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750888
    m_Localized: 'TV: Nem o calor te pode parar, sente a energia!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750889
    m_Localized: 'TV: Com EnerJeka, há mais vida em ti!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750890
    m_Localized: 'TV: Uma bebida energética revigorante que mata a sede mais rápido e melhor do que a água.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750891
    m_Localized: 'TV: Já disponível para entrega EuroCêntrica. Encomenda já através do número: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750892
    m_Localized: 'Window: A casa do teu vizinho jaz sobre o campo de feno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750893
    m_Localized: 'Window: Não há luz nas janelas. Parece que a família dele está a dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750894
    m_Localized: 'Window: Há um cão magro parado no trilho que atravessa o campo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750895
    m_Localized: 'Window: Está a olhar em volta com tristeza e desespero, a tentar encontrar algo para comer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750896
    m_Localized: 'Window: Alguns bêbados jazem estendidos na rua.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750897
    m_Localized: 'Window: Apesar de estarem deitados no chão frio, parecem dormir profundamente. Para eles, agora está tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750898
    m_Localized: 'Window: Ao longe, vê-se a casa do teu vizinho, que neste momento te está a visitar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750899
    m_Localized: 'Window: A luz irradia pela janela, e parece que a família dele está à espera que ele volte para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750900
    m_Localized: 'Window: Vês alguns adolescentes no quintal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750901
    m_Localized: 'Window: Estão sentados, descontraídos, a conversar sobre qualquer coisa, e sem se importarem contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750902
    m_Localized: 'Window: Há um silêncio de morte que paira lá fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750903
    m_Localized: 'Window: Não está ali ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750904
    m_Localized: 'Window: Até os bêbados decidiram não sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750905
    m_Localized: 'Window: Estarão com medo de alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750906
    m_Localized: 'Window: Vês o teu vizinho e a filha através da janela.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750907
    m_Localized: 'Window: Brincam felizes, tentando esquecer o horror que se vive...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750908
    m_Localized: 'Window: Nem que seja só por um instante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750909
    m_Localized: 'Window: Os corpos dos adolescentes jazem no chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750910
    m_Localized: 'Window: Alguém os matou.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750911
    m_Localized: 'Window: O incidente parece ter ocorrido há pouco tempo. O sangue ainda não secou.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750912
    m_Localized: 'Window: Há um homem, pálido como a morte, parado no trilho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750913
    m_Localized: 'Window: A sua pele apresenta umas pregas estranhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750914
    m_Localized: 'Window: É como se a pele não fosse do tamanho certo para o corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750915
    m_Localized: 'Window: Não consegues ver-lhe os olhos, mas sentes o olhar dele cravado em ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750916
    m_Localized: 'Window: Sentes medo e rezas a Deus para que o aterrador Visitante ignore a tua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750917
    m_Localized: 'Window: Há um pequeno grupo de funcionários da AGEF junto à casa do teu vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750918
    m_Localized: 'Window: Perguntas-te o que estarão a conversar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750919
    m_Localized: 'Window: Talvez estejam a recolher amostras do solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750920
    m_Localized: 'Window: Ou à procura de um local para montar uma base?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750921
    m_Localized: 'Window: As carcaças carbonizadas dos corpos dos adolescentes jazem no chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750922
    m_Localized: 'Window: Parece que estiveram ali o dia todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750923
    m_Localized: 'Window: Há dois funcionários da AGEF junto aos corpos e a tirar apontamentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750924
    m_Localized: 'Window: Ainda bem que vieram recolher os corpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750925
    m_Localized: 'Window: Nem é bom pensar no tipo de infeções que poderia surgir se os cadáveres fossem ali deixados a apodrecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750926
    m_Localized: 'Window: Vês um grupo de soldados armados através da janela.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750927
    m_Localized: 'Window: Aparentemente, é um pequeno esquadrão enviado a partir da cidade para proteger os funcionários da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750928
    m_Localized: 'Window: Consegues ouvir fragmentos de informações sobre um homem pálido de tronco nu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750929
    m_Localized: 'Window: Talvez estejam a tentar encontrar aquele Visitante assustador?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750930
    m_Localized: 'Window: A casa do teu vizinho, que ele tinha acabado de pintar de branco, ardeu até ficar mais negra do que a própria noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750931
    m_Localized: 'Window: Parece que o fogo só se apagou há pouco tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750932
    m_Localized: 'Window: Terá sido fogo posto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750933
    m_Localized: 'Window: O que terá acontecido à família do vizinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750934
    m_Localized: 'Window: Ainda estará alguém vivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750935
    m_Localized: 'Window: Passam-te pensamentos inquietantes pela cabeça, e és invadido por uma forte sensação de incompreensão e impotência.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750936
    m_Localized: 'Window: O homem pálido e sinistro está parado na rua, a sorrir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750937
    m_Localized: 'Window: Está a segurar a cabeça decapitada de alguém, ainda com um capacete.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750938
    m_Localized: 'Window: É a cabeça de um soldado, com o rosto congelado numa expressão de terror.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750939
    m_Localized: 'Window: Não tens a certeza do que o terá assustado mais: o Visitante pálido ou a sua morte iminente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750940
    m_Localized: 'Window: Todo o esquadrão de soldados que ali esteve ontem está morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750941
    m_Localized: 'Window: Parece que houve um massacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750942
    m_Localized: 'Window: Os corpos estão espalhados pela rua, e um deles não tem cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750943
    m_Localized: 'Window: Será que foi aquele estranho e arrepiante homem pálido que os matou?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750944
    m_Localized: Serviços de emergência, bom dia. Em que posso ajudar? "As pessoas... estão a arder."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750945
    m_Localized: Pode descrever o que está a ver? Há um incêndio? "Não, é o sol. Estão... estão a arder ao sol."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750946
    m_Localized: Não saia de casa até ao anoitecer. "Não, aquele tipo anda por aí à noite. O magricelas pálido... Ele não é humano."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750947
    m_Localized: 'E agora, segue-se o nosso novo programa: "Sim, sou Humano."'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750948
    m_Localized: 'É simples: envie-nos as suas fotografias e nós verificamos a sua verdadeira identidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750949
    m_Localized: Basta que nos envie as suas fotos por e-mail para yesiamhuman@gmail.com, e nós tratamos do resto.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750950
    m_Localized: No entanto, pedimos-lhe que envie apenas imagens dos olhos, dentes e unhas. Não serão aceites outras fotos.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750951
    m_Localized: Os seus olhos ficaram vermelhos? Os seus dentes estão demasiado brancos? Há terra por baixo das suas unhas?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750952
    m_Localized: Um espírito maligno entrou em si. É um Visitante!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750953
    m_Localized: 'Não deixe que o seu corpo seja dominado por esta praga! Ligue já para os nossos especialistas: 777-460.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750954
    m_Localized: Deixe que os especialistas eliminem o espírito maligno, purifiquem o seu corpo da aura do mal e lhe deem maior proteção.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750955
    m_Localized: Damos-lhe as boas-vindas. Vamos ao programa "Quero Acreditar", onde desvendamos mistérios e conspirações governamentais.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750956
    m_Localized: Hoje, abordamos a verdade sobre os Visitantes com um convidado especial, doutorado em Ciências e funcionário de renome—
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750957
    m_Localized: Esperem, o quê?! Ele não vem?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750958
    m_Localized: Como é que lhe roubaram todos os documentos?! Havia ali MILHENTAS INFORMAÇÕES!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750959
    m_Localized: Merda. Eu sabia que não nos deixariam revelar a verdade. Puta que pariu...
    m_Metadata:
      m_Items: []
  - m_Id: 17738415503822848
    m_Localized: 'TV: Era uma vez dois irmãos que viviam perto de uma barragem.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182976
    m_Localized: 'TV: Os salpicos de água evocavam imagens de bebidas geladas e repletas de espuma...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182977
    m_Localized: 'TV: Quando os dois irmãos cresceram, fundaram juntos a Cervejaria Bober.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182978
    m_Localized: 'TV: A cerveja Bober Černý tornou-se numa das bebidas alcoólicas mais procuradas nas lojas e nos bares.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182979
    m_Localized: 'TV: Cerveja Bober Černý: bebe o que é bom e em boas quantidades.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182980
    m_Localized: 'Window: Vês as ruínas da casa do teu vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182981
    m_Localized: 'Window: Não resta nada para além de uma carcaça fantasmagórica, apesar de até há pouco tempo ter ali vivido uma família feliz...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182982
    m_Localized: 'Window: Uma estranha sensação apodera-se de ti, como se soubesses que isto viria a acontecer...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182983
    m_Localized: 'Window: É como se... sentisses que a morte iria chegar a esta casa muito em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182984
    m_Localized: 'Window: Vês uma estaca com um crânio com um capacete.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182985
    m_Localized: 'Window: O crânio tem um pouco de pele preta e queimada, e parece que alguém lhe arrancou os dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182986
    m_Localized: 'Window: A cabeça esteve ali o dia todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182987
    m_Localized: 'Window: Toda esta exposição macabra parece ser uma ameaça. Provavelmente foi deixada por aquele arrepiante Visitante pálido.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182988
    m_Localized: 'Window: Os funcionários da AGEF estão a inspecionar o local do recente massacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182989
    m_Localized: 'Window: Estão a levar todo o equipamento e as armas dos soldados mortos para os manter longe das mãos de possíveis saqueadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182990
    m_Localized: 'Window: Provavelmente esperavam que o Visitante pálido não sobrevivesse ao encontro com o esquadrão de pessoas armadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182991
    m_Localized: 'Window: Agora, há mais alguns sacos de cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576140324864
    m_Localized: 'TV: Boa tarde. Segue-se o boletim meteorológico.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102080
    m_Localized: 'TV: Chegou uma vaga de calor à nossa região que quebrou os anteriores recordes de temperaturas médias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102081
    m_Localized: 'TV: De acordo com os especialistas em matéria de meteorologia, prevê-se que as temperaturas continuem a aumentar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102082
    m_Localized: 'TV: Além disso, o aumento da atividade solar será acompanhado de perigosos níveis altos de radiação UV durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102083
    m_Localized: 'TV: Para sua segurança, é altamente recomendado que evite banhos de sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102084
    m_Localized: 'TV: A exposição prolongada ao sol pode resultar em insolações.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102085
    m_Localized: 'TV: Ainda não é possível confirmar como é que a luz direta do sol pode afetar o corpo humano...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102086
    m_Localized: 'TV: No entanto, para evitar queimaduras de terceiro grau, pedimos-lhe que permaneça no interior de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102087
    m_Localized: 'TV: O uso de protetor solar, infelizmente, provou ser ineficaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102088
    m_Localized: 'TV: A seguir: mais atualizações sobre o estado meteorológico. Mas, primeiro, eis uma mensagem dos nossos patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102089
    m_Localized: 'TV: Vês bailarinas a saltar pelo palco em graciosos movimentos – é uma imagem poderosa e simultaneamente elegante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102090
    m_Localized: 'TV: A dança é linda. Contudo, apesar da sua elegância, evoca uma sensação inquietante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102091
    m_Localized: 'TV: É como se estivesse a tentar desviar-te as atenções da realidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102092
    m_Localized: 'TV: Se, pelo menos, alguém pudesse explicar o que está a acontecer...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102093
    m_Localized: 'TV: De momento, fazer as suas compras assemelha-se a algo assim: andar, resmungar, suspirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102094
    m_Localized: 'TV: A partir de agora, será mais assim: "Olá, gostaria de efetuar uma encomenda."'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102095
    m_Localized: 'TV: Use o serviço de entregas EuroCêntrica. Ligue {0}. As suas compras estarão à sua porta em 24 horas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102096
    m_Localized: 'TV: EuroCêntrica: uma pausa deliciosa, na sua própria casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102097
    m_Localized: 'TV: Segundo consta, um pálido indivíduo foi visto a deambular pelas ruas da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102098
    m_Localized: 'TV: Com base em testemunhas oculares, todas as vítimas tinham algo em comum: viviam sozinhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102099
    m_Localized: 'TV: Antes de cada ataque, diz-se que o suspeito fala com a vítima, atacando em seguida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102100
    m_Localized: 'TV: Foi elaborado um retrato robô, que já se encontra em divulgação.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102101
    m_Localized: 'TV: O suspeito é um homem alto, pálido, de meia-idade, com cabelo preto. Anda de tronco nu e aparenta ser magro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102102
    m_Localized: 'TV: Alguns testemunhos afirmam que este indivíduo está a usar a pele de outra pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102103
    m_Localized: 'TV: Tais testemunhos, no entanto, carecem de confirmação.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102104
    m_Localized: 'TV: Se vir este homem, não abra a porta. Diga-lhe que há mais pessoas dentro de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102105
    m_Localized: 'TV: É tudo por agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102106
    m_Localized: 'TV: Pânico. Angústia. Medo. E por trás de tudo... os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102107
    m_Localized: 'TV: Mas no nosso pior momento, quando o desespero ameaça consumir-nos...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102108
    m_Localized: 'TV: EIS QUE SURGE UMA LUZ AO FUNDO DO TÚNEL: A AGEF!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102109
    m_Localized: 'TV: Os corajosos agentes da AGEF são o escudo que nos defende contra a invasão dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102110
    m_Localized: 'TV: Só hoje, a Agência identificou mais de 27 000 entidades hostis.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102111
    m_Localized: 'TV: Lembre-se de que pode ajudar ao comunicar qualquer comportamento suspeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102112
    m_Localized: 'TV: Use o seu Convite da AGEF para efetuar uma denúncia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102113
    m_Localized: 'TV: E, em caso de dúvida sobre se é ou não um Visitante, ligue para a nossa linha direta: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102114
    m_Localized: 'TV: Ao ajudar a AGEF, está a ajudar o mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102115
    m_Localized: 'TV: O que é a AGEF? E por que motivo foi criada?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102116
    m_Localized: 'TV: A Agência de Gestão de Emergências Federal é uma força recentemente criada para abordar a crise emergente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102117
    m_Localized: 'TV: A sua missão consiste em travar a ameaça dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102118
    m_Localized: 'TV: Os detalhes do plano ainda não foram divulgados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102119
    m_Localized: 'TV: Mas podemos afirmar com confiança: o nosso destino está nas melhores mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102120
    m_Localized: 'TV: A AGEF reúne os melhores profissionais do país, incluindo os melhores cientistas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102121
    m_Localized: 'TV: Se um agente da AGEF bater à sua porta, recomendamos vivamente que coopere na totalidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102122
    m_Localized: 'TV: Lembre-se de que ao ajudar a AGEF, está a ajudar o mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102123
    m_Localized: 'TV: A AGEF suspeita de que o fenómeno dos Visitantes seja algo infecioso ou que seja outra forma de ameaça biológica.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102124
    m_Localized: 'TV: É por isso que é fundamental que comunique e isole qualquer pessoa que apresente um comportamento suspeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102125
    m_Localized: 'TV: Se for incapaz de levar um possível Visitante a uma zona de quarentena, emita uma Ficha de Comparecimento Obrigatório.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102126
    m_Localized: 'TV: Um agente da AGEF irá recolher o indivíduo durante a próxima inspeção.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102127
    m_Localized: 'TV: É tudo por agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102128
    m_Localized: 'TV: Quando o calor aperta...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102129
    m_Localized: 'TV: A EnerJeka mantém-te alerta!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102130
    m_Localized: 'TV: Uma refrescante bebida energética que mata a sede mais rápido e melhor do que a água.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102131
    m_Localized: 'TV: Já disponível para entrega EuroCêntrica. Encomenda já através do número: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102132
    m_Localized: 'TV: Boa tarde. Seguem-se as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102133
    m_Localized: 'TV: Devido a um grande aumento de indivíduos com sinais de serem Visitantes, a AGEF introduziu novas medidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102134
    m_Localized: 'TV: Com efeito imediato, será declarada quarentena total em todas as grandes cidades.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102135
    m_Localized: 'TV: A realização de viagens para fora da sua cidade ou para povoações nas proximidades está estritamente proibida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102136
    m_Localized: 'TV: Pedimos que se mantenha dentro da sua área designada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102137
    m_Localized: 'TV: Além disso, a AGEF anunciou um novo sinal de identificação:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102138
    m_Localized: 'TV: Fotografia com indícios de uma aura.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102139
    m_Localized: 'TV: Manchas negras em torno da imagem de um indivíduo são um forte indicador de que este possa ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102140
    m_Localized: 'TV: É tudo por agora. Mantenha a calma e permaneça dentro de casa durante as horas do dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102141
    m_Localized: 'TV: Segue-se uma mensagem dos nossos patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102142
    m_Localized: 'TV: O que são os Visitantes? Fantasmas? Criaturas do subsolo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102143
    m_Localized: 'TV: Não, isto não é um romance de ficção científica nem uma manchete barata.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102144
    m_Localized: 'TV: É a nossa nova realidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102145
    m_Localized: 'TV: Há rumores que continuam a surgir acerca da verdadeira origem dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102146
    m_Localized: 'TV: Extraterrestres? Mortos-vivos? Uma experiência laboratorial infeliz?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102147
    m_Localized: 'TV: De acordo com a AGEF, estas são apenas teorias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102148
    m_Localized: 'TV: Segundo a AGEF, um Visitante é um humano que tenha entrado em contacto com um vírus ou outro agente biológico.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102149
    m_Localized: 'TV: Ainda se desconhece o método de transmissão, mas pede-se que todos se mantenham alerta quanto a sinais de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102150
    m_Localized: 'TV: Se pensa ter sido alvo de exposição ou não tiver a certeza de ser um Visitante, contacte a linha direta da AGEF:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102151
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102152
    m_Localized: 'TV: É tudo por agora. Continue connosco depois do intervalo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102153
    m_Localized: 'TV: Identificar um Visitante é cada vez mais difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102154
    m_Localized: 'TV: Os sinais podem ajudar, mas... e se pudesse aceder a uma forma infalível de os detetar?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102155
    m_Localized: 'TV: Apresentamos a nossa revolucionária película fotográfica!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102156
    m_Localized: 'TV: Esta expõe a energia da alma, permitindo-lhe distinguir um ser humano de um Visitante hostil.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102157
    m_Localized: 'TV: Tire uma fotografia e, se verificar a existência de manchas negras, encontrou um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102158
    m_Localized: 'TV: Ligue já para obter o seu kit inicial grátis: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102159
    m_Localized: 'TV: Atualização urgente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102160
    m_Localized: 'TV: O sol volta a atacar: há incêndios a devastar regiões florestais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102161
    m_Localized: 'TV: Os especialistas acreditam que a incomum e elevada atividade solar está por trás destes incêndios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102162
    m_Localized: 'TV: Embora não se conheça a verdadeira escala do desastre, foram destacadas equipas de bombeiros das cidades próximas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296384
    m_Localized: 'TV: É tudo por agora. Mantenha a calma e permaneça dentro de casa durante as horas do dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296385
    m_Localized: 'TV: Mantenha a calma e permaneça dentro de casa durante as horas do dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296386
    m_Localized: 'TV: Segue-se uma mensagem dos nossos patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296387
    m_Localized: 'TV: Era uma vez dois irmãos que viviam perto de uma barragem.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296388
    m_Localized: 'TV: Os salpicos de água evocavam imagens de bebidas geladas e repletas de espuma...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296389
    m_Localized: 'TV: Quando os dois irmãos cresceram, fundaram juntos a Cervejaria Bober.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296390
    m_Localized: 'TV: A cerveja Bober Černý tornou-se numa das bebidas alcoólicas mais procuradas nas lojas e nos bares.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296391
    m_Localized: 'TV: Cerveja Bober Černý: bebe o que é bom e em boas quantidades.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296392
    m_Localized: 'TV: Interrompemos a programação com notícias de última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296393
    m_Localized: 'TV: Surgem relatos de desagrado da população numa cidade vizinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296394
    m_Localized: 'TV: Devido a situações ainda por resolver, as forças da AGEF isolaram a área.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296395
    m_Localized: 'TV: Pedimos aos telespetadores que permaneçam dentro de casa. Serão emitidas mais instruções em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296396
    m_Localized: 'TV: Ao cooperar com a AGEF, está a ajudar o mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296397
    m_Localized: 'TV: É tudo por agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296398
    m_Localized: 'TV: Mantenha-se no local atual e aguarde por mais instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296399
    m_Localized: 'TV: Até mesmo os trabalhadores mais dedicados precisam de uma pausa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296400
    m_Localized: 'TV: Com os cigarros Margoro, pode inspirar o verdadeiro fumo do relaxamento e descontrair ao máximo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296401
    m_Localized: 'TV: Margoro. Cigarros para homens de barba rija.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296402
    m_Localized: 'TV: (Isenção de responsabilidade: a empresa não se responsabiliza por quaisquer danos à vida ou à saúde dos consumidores)'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296403
    m_Localized: 'TV: Boa tarde. Seguem-se as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296404
    m_Localized: 'TV: Atualização importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296405
    m_Localized: 'TV: Surgiram novos detalhes relativamente aos recentes incidentes na cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296406
    m_Localized: 'TV: Uma das zonas de quarentena foi alvo de ataque por parte de um indivíduo armado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296407
    m_Localized: 'TV: Neste momento, o motivo ainda está por esclarecer e não se sabe se o culpado estava acompanhado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296408
    m_Localized: 'TV: Escaparam vários indivíduos cujo estado carece de verificação'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296409
    m_Localized: 'TV: O silêncio é um sinal de morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296410
    m_Localized: 'TV: O silêncio que esgota a alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296411
    m_Localized: 'TV: Mas pior do que o vazio… é o badalar dos sinos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296412
    m_Localized: 'TV: Dos sinos funerários.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296413
    m_Localized: 'TV: Há algo que cresce nos ouvidos quando os sinos ecoam.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296414
    m_Localized: 'TV: Tudo o que resta é cera. Pensamentos contaminados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296415
    m_Localized: 'TV: É disso que se alimentam os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296416
    m_Localized: 'TV: Os Visitantes emaranham-se nas teias do pensamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296417
    m_Localized: 'TV: Para eles, os sinos ecoam ainda mais alto. E mais cera surge.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296418
    m_Localized: 'TV: O incidente de hoje deu origem a inúmeras teorias. Existem variados relatos de testemunhas oculares.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296419
    m_Localized: 'TV: Algumas descrevem a existência de um único atirador, ao passo que outras mencionam um grupo armado e encapuzado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296420
    m_Localized: 'TV: No entanto, o maior desafio ainda poderá está por vir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296421
    m_Localized: 'TV: Devido ao isolamento da cidade, a eliminação de corpos nas áreas circundantes foi temporariamente suspensa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296422
    m_Localized: 'TV: No entanto, as inspeções residenciais continuarão conforme previsto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296423
    m_Localized: 'TV: Caso tenha a possibilidade de cremar quaisquer restos mortais, faça-o imediatamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296424
    m_Localized: 'TV: Caso contrário, aguarde até que a situação esteja sob controlo antes de ceder quaisquer corpos guardados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296425
    m_Localized: 'TV: É tudo por agora. Continue connosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296426
    m_Localized: 'TV: Boa tarde. Seguem-se as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296427
    m_Localized: 'TV: A AGEF está a assistir as vítimas do ataque à zona de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296428
    m_Localized: 'TV: Devido à sobrelotação nas instalações existentes, a Agência tomou a seguinte decisão:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296429
    m_Localized: 'TV: Os residentes evacuados ficarão temporariamente alojados em edifícios nos arredores da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296430
    m_Localized: 'TV: Felizmente, os proprietários de edifícios locais cooperaram com a AGEF e disponibilizaram abrigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296431
    m_Localized: 'TV: No entanto, foi localizada apenas uma parte dos indivíduos fugitivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296432
    m_Localized: 'TV: Foi também anunciado um novo sinal de identificação da presença de Visitantes:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296433
    m_Localized: 'TV: Gengivas com hemorragia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296434
    m_Localized: 'TV: Caso um indivíduo que apresente esta condição bata à sua porta, evite qualquer interação.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296435
    m_Localized: 'TV: Aguarde pela patrulha prevista e denuncie o indivíduo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296436
    m_Localized: 'TV: É tudo por agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296437
    m_Localized: 'TV: Mantenha-se no local atual e aguarde por mais instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296438
    m_Localized: 'TV: Segue-se um comunicado especial acerca de um novo culto perigoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296439
    m_Localized: 'TV: Os Visitantes não se escondem apenas entre nós; podem também estar a infiltrar-se nos nossos próprios pensamentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296440
    m_Localized: 'TV: Várias cidades identificaram surtos de uma organizada atividade de culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296441
    m_Localized: 'TV: As acusações contra estes indivíduos incluem:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296442
    m_Localized: 'TV: Sacrifício para rituais, adoração de uma entidade desconhecida, e possíveis afiliações aos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296443
    m_Localized: 'TV: Segundo as últimas informações, este grupo assumiu, publicamente, uma posição contra a AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296444
    m_Localized: 'TV: O que começou como meras palavras e propaganda passou a ações diretas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296445
    m_Localized: 'TV: Este culto pode ser responsável pelos recentes eventos na cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296446
    m_Localized: 'TV: Pede-se aos nossos telespetadores que evitem o contacto com estes tais "novos crentes".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296447
    m_Localized: 'TV: A ajuda ou a conivência com os atos deste grupo pode resultar em detenções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296448
    m_Localized: 'TV: É tudo por agora. Continue connosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296449
    m_Localized: 'TV: Boa tarde. Seguem-se as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296450
    m_Localized: 'TV: A situação na cidade está a estabilizar gradualmente. No entanto, os fugitivos continuam a monte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296451
    m_Localized: 'TV: Entretanto, as operações de eliminação de corpos retomaram, embora tenham surgido novos desafios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296452
    m_Localized: 'TV: De acordo com as últimas informações, várias matilhas de cães vadios percorrem agora as ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296453
    m_Localized: 'TV: A AGEF destacou uma equipa para lidar com esta ameaça.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296454
    m_Localized: 'TV: A Agência anunciou também um novo sinal de identificação de potenciais indivíduos perigosos:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296455
    m_Localized: 'TV: Irritação cutânea.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296456
    m_Localized: 'TV: A investigação relativamente ao ataque na cidade continua.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296457
    m_Localized: 'TV: Ainda não se sabe se o autor do ataque agiu sozinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296458
    m_Localized: 'TV: No entanto, não há dúvidas de que a AGEF conseguirá solucionar este problema, bem como a ameaça dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296459
    m_Localized: 'TV: Em caso de dúvidas sobre como reconhecer sinais para a presença de Visitantes, contacte a linha direta da AGEF:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296460
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296461
    m_Localized: 'TV: É tudo por agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296462
    m_Localized: 'TV: Mantenha-se no local atual e aguarde por mais instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296463
    m_Localized: 'TV: Segue-se um comunicado sobre a situação nos países do cinturão equatorial.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296464
    m_Localized: 'TV: Temos hoje notícias perturbadoras provenientes das regiões equatoriais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296465
    m_Localized: 'TV: Incêndios deflagrados, calor extremo e secas estão a devastar várias nações.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296466
    m_Localized: 'TV: Recentes informações indicam temperaturas tão altas que até o contacto com o solo provoca queimaduras de terceiro grau.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296467
    m_Localized: 'TV: O número de vítimas mortais carece de confirmação e a evacuação é, de momento, impossível.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296468
    m_Localized: 'TV: O nosso governo, até agora, tem sido incapaz de estabelecer comunicação com as autoridades nas zonas afetadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296469
    m_Localized: 'TV: No entanto, assim que as condições o permitirem, os agentes da AGEF serão destacados para ajudar nestes desastres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296470
    m_Localized: 'TV: É tudo por agora. Continue connosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296471
    m_Localized: 'TV: Boa tarde. Seguem-se as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296472
    m_Localized: 'TV: A situação na cidade permanece instável e o isolamento continua em vigor.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296473
    m_Localized: 'TV: Contudo, surgiu uma nova ameaça. Membros de um culto outrora banido foram avistados nos arredores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296474
    m_Localized: 'TV: De acordo com recentes informações, poderão estar a preparar-se para rituais que envolvam chamas ativas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296475
    m_Localized: 'TV: A AGEF acredita que este grupo pode estar diretamente envolvido nos ataques às zonas de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296476
    m_Localized: 'TV: Infelizmente, dada a situação atual na cidade, nem a AGEF nem o exército podem destacar qualquer equipa neste momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296477
    m_Localized: 'TV: Se os membros do culto baterem à porta de sua casa, contacte a linha direta da AGEF imediatamente: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296478
    m_Localized: 'TV: A Agência anunciou ainda um novo sinal de identificação para a presença de Visitantes:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296479
    m_Localized: 'TV: Crescimento fúngico na área das axilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296480
    m_Localized: 'TV: É tudo por agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296481
    m_Localized: 'TV: Mantenha-se no local atual e aguarde por mais instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296482
    m_Localized: 'TV: Segue-se uma atualização sobre as condições nos polos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296483
    m_Localized: 'TV: O sol volta a atacar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296484
    m_Localized: 'TV: Os cientistas divulgaram novas e perturbadoras projeções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296485
    m_Localized: 'TV: Se a vaga de calor não abrandar, as placas de gelo polar poderão derreter, o que resultará numa inundação catastrófica.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296486
    m_Localized: 'TV: Os especialistas continuam a investigar a causa da anomalia climática atual, mas sem respostas até ao momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296487
    m_Localized: 'TV: É tudo por agora. Continue connosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296488
    m_Localized: 'TV: Notícias de última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296489
    m_Localized: 'TV: As condições na cidade não mostram sinais de estabilização. O desastre continua a piorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296490
    m_Localized: 'TV: Com glaciares a derreter, os níveis do mar estão a subir rapidamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296491
    m_Localized: 'TV: Isto poderá levar à ameaça de inundação em áreas costeiras, incluindo grandes cidades.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296492
    m_Localized: 'TV: Vários lagos contaminados, conhecidos por terem radiações, começaram já a evaporar-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296493
    m_Localized: 'TV: Os cientistas já emitiram um alerta, afirmando que tal poderá resultar numa chuva ácida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296494
    m_Localized: 'TV: Em caso de trovoada, procure abrigo imediatamente para se proteger da exposição a esta chuva.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296495
    m_Localized: 'TV: Infelizmente, a cidade permanece em isolamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296496
    m_Localized: 'TV: A AGEF ainda não capturou todos os fugitivos e anunciou agora um novo sinal de identificação de Visitantes:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296497
    m_Localized: 'TV: Rápido movimento de pupilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296498
    m_Localized: 'TV: É tudo por agora...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296499
    m_Localized: 'TV: Temos de interromper a presente comunicação devido ao risco de um ataque no nosso próprio estúdio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296500
    m_Localized: 'TV: Em caso de dúvidas acerca de identificação de Visitantes, contacte a linha direta: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296501
    m_Localized: 'TV: Fim da transmissão.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296502
    m_Localized: 'TV: Atualização de última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296503
    m_Localized: 'TV: A AGEF acabou de realizar a detenção dos principais oficiais do governo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296504
    m_Localized: 'TV: A agência indica que alguns destes oficiais foram identificados como Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296505
    m_Localized: 'TV: Com o Parlamento mergulhado no caos, a AGEF assume agora a função de governo interino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296506
    m_Localized: 'TV: Além disso...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296507
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296508
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296509
    m_Localized: 'TV: Só um momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296510
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296511
    m_Localized: 'TV: Informações acabadas de chegar por parte da AGEF:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296512
    m_Localized: 'TV: Os autores dos ataques às zonas de quarentena quebraram o isolamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296513
    m_Localized: 'TV: Repetimos, os autores dos ataques quebraram o isolamento e estão atualmente a monte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296514
    m_Localized: 'TV: Bloqueie as suas janelas com tábuas e tranque as suas portas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296515
    m_Localized: 'TV: Aguarde mais instruções e permaneça dentro de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296516
    m_Localized: 'TV: Fim da transmissão.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296517
    m_Localized: 'Window: A casa do teu vizinho destaca-se no meio do campo aberto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296518
    m_Localized: 'Window: Não há luz nas janelas e parece que a família dele está a dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296519
    m_Localized: 'Window: Um par de bêbados fora de si jaz deitado no chão frio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296520
    m_Localized: 'Window: O frio não os incomoda. Parece que estão inconscientes. Pelo menos, por agora, parecem estar em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296521
    m_Localized: 'Window: Ao longe, vês a casa do teu vizinho que vai ficar contigo esta noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296522
    m_Localized: 'Window: As luzes estão ligadas, com a família dele à sua espera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296523
    m_Localized: 'Window: No exterior, há um silêncio pesado que paira no ar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296524
    m_Localized: 'Window: Não há ninguém à vista.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296525
    m_Localized: 'Window: Até os bêbados ficaram em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296526
    m_Localized: 'Window: Estarão com medo de alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296527
    m_Localized: 'Window: Lá fora, o teu vizinho está a brincar com a filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296528
    m_Localized: 'Window: Riem-se, perdidos na brincadeira, a tentarem esquecer o terror atual.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296529
    m_Localized: 'Window: Nem que seja só por um mero instante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296530
    m_Localized: 'Window: Um homem pálido permanece parado no trilho, branco como a própria morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296531
    m_Localized: 'Window: A sua pele está dobrada em pregas estranhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296532
    m_Localized: 'Window: Como se não fosse adequada ao seu tamanho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296533
    m_Localized: 'Window: Não consegues ver os olhos dele, mas o seu olhar atravessa-te de forma assustadora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296534
    m_Localized: 'Window: O medo percorre-te pelo corpo. Silenciosamente, rezas para que Deus proteja a tua casa deste arrepiante Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296535
    m_Localized: 'Window: Um pequeno grupo de agentes da AGEF deambula junto à casa do teu vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296536
    m_Localized: 'Window: Perguntas-te o que estarão a fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296537
    m_Localized: 'Window: Estarão a recolher amostras do solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296538
    m_Localized: 'Window: Ou à procura de um local para montar uma base?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296539
    m_Localized: 'Window: No exterior da janela, vês um grupo de soldados armados a rondar a área.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296540
    m_Localized: 'Window: Um pequeno esquadrão da cidade, a proteger a equipa da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296541
    m_Localized: 'Window: Consegues ouvir fragmentos da conversa – algo sobre um homem pálido de tronco nu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296542
    m_Localized: 'Window: Talvez estejam em perseguição daquele Visitante assustador?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296543
    m_Localized: 'Window: A casa do teu vizinho, recém-pintada de branco, jaz agora enegrecida e queimada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296544
    m_Localized: 'Window: Provavelmente, o fogo do incêndio apagou-se há pouco tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296545
    m_Localized: 'Window: Terá sido fogo posto?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296546
    m_Localized: 'Window: O que terá acontecido ao teu vizinho e à sua família?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296547
    m_Localized: 'Window: Terá sobrevivido alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296548
    m_Localized: 'Window: Pensamentos inquietantes inundam-te a mente. És envolvido por sensações de confusão e desespero.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296549
    m_Localized: 'Window: Todo o esquadrão de soldados que ali esteve ontem está morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296550
    m_Localized: 'Window: Um massacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296551
    m_Localized: 'Window: Corpos espalhados na rua, um deles sem cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296552
    m_Localized: 'Window: Terá sido isto obra daquele pálido estranho?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296553
    m_Localized: 'Window: Olhas para a silhueta fantasmagórica do local onde outrora existia a casa do teu vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296554
    m_Localized: 'Window: Há não muito tempo, uma família relativamente feliz vivia ali.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296555
    m_Localized: 'Window: Uma sensação estranha atravessa-te o corpo, como se de alguma forma soubesses que isto viria a acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296556
    m_Localized: 'Window: Como se pressentisses que a morte viria a visitar esta casa em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296557
    m_Localized: 'Window: Vês uma estaca com um crânio num capacete lá espetado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296558
    m_Localized: 'Window: Há uma pele enegrecida agarrada ao osso. Os dentes parecem ter sido arrancados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296559
    m_Localized: 'Window: A cabeça esteve ali o dia todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296560
    m_Localized: 'Window: Esta sinistra visão parece ser um aviso. Provavelmente deixada por aquele horripilante Visitante pálido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296561
    m_Localized: 'Window: Os agentes da AGEF vasculham a cena do massacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296562
    m_Localized: 'Window: Estão a recolher os equipamentos e as armas dos soldados mortos – a garantir que não caem nas mãos de estranhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296563
    m_Localized: 'Window: Talvez esperassem que o Visitante pálido não sobrevivesse a um encontro com o esquadrão armado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296564
    m_Localized: 'Window: Agora, há mais alguns sacos de cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296565
    m_Localized: 'Window: Vês uma mulher a chorar sobre o seu marido ferido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296566
    m_Localized: 'Window: Não consegues perceber se está vivo ou morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296567
    m_Localized: 'Window: Lavada em lágrimas, ela arrasta o seu corpo pesado para longe do tiroteio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296568
    m_Localized: 'Window: Há um pensamento que insiste em manter-se na tua mente: as coisas só vão piorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296569
    m_Localized: 'Window: O caminho junto ao campo está repleto dos corpos daqueles que tentaram fugir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296570
    m_Localized: 'Window: Nas proximidades, encontra-se o homem responsável, um agente da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296571
    m_Localized: 'Window: Ele está a segurar numa espingarda, com o cano ainda a fumegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296572
    m_Localized: 'Window: As pessoas em pânico apressam-se a fugir em direção às casas mais próximas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296573
    m_Localized: 'Window: Batem às portas, desesperadas, à procura de abrigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296574
    m_Localized: 'Window: Mas parece que não há ninguém que as ouse ajudar, com medo dos possíveis problemas que isso traria.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296575
    m_Localized: 'Window: Um grupo de pessoas expulsas ronda a casa arruinada do teu vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296576
    m_Localized: 'Window: Estão chocadas, a murmurar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296577
    m_Localized: 'Window: Provavelmente, estão à procura de abrigo por lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296578
    m_Localized: 'Window: Mas será que existe algum lugar no mundo onde seja possível alguém esconder-se e ficar em segurança?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296579
    m_Localized: 'Window: No meio do caminho, há um homem armado com uma espingarda de assalto. Parece totalmente tresloucado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296580
    m_Localized: 'Window: O seu casaco está coberto por olhos, dentes arrancados, e sabe-se lá mais o quê. É difícil perceber daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296581
    m_Localized: 'Window: E se ele matar não com o objetivo de se defender, mas por desporto e por troféus?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296582
    m_Localized: 'Window: Seja qual for o caso, esperas que ele não te considere um inimigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296583
    m_Localized: 'Window: Num poste, há um homem pendurado com uma placa com o seguinte lá escrito: "Tiraram-me tudo".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296584
    m_Localized: 'Window: Terá sido roubado? Ou terá a AGEF levado a sua família?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296585
    m_Localized: 'Window: A tua mente fica em alvoroço, mas sem quaisquer respostas... apenas suposições.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296586
    m_Localized: 'Window: Um grupo expulso pela AGEF estabeleceu-se nas ruínas da casa do teu vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296587
    m_Localized: 'Window: Embora não reste muito da casa de outrora, a cave parece ter sobrevivido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296588
    m_Localized: 'Window: Uma pequena réstia de segurança.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296589
    m_Localized: 'Window: Por quanto tempo conseguirão manter-se escondidos?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296590
    m_Localized: 'Window: Cães selvagens percorrem a rua.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296591
    m_Localized: 'Window: Os seus corpos apresentam leves queimaduras e estão magros devido à fome.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296592
    m_Localized: 'Window: A partir do interior da tua casa, não te metem medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296593
    m_Localized: 'Window: Mas agora não consegues esquecer a ideia de que é melhor não saíres lá para fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296594
    m_Localized: 'Window: Pequenos grupos com os seus pertences reúnem-se junto às casas. Sussurram para não serem ouvidos pelos agentes da AGEF.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296595
    m_Localized: 'Window: Parece que vieram de zonas de quarentena para ficar nas casas de antigos residentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296596
    m_Localized: 'Window: Agora, o homem suspenso assemelha-se a um sinistro sinal de boas-vindas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296597
    m_Localized: 'Window: Um caçador de Visitantes aponta uma arma a vários sobreviventes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296598
    m_Localized: 'Window: Provavelmente, encontrou-os ao acaso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296599
    m_Localized: 'Window: Ouves gritos, uma voz tresloucada a gritar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296600
    m_Localized: 'Window: Quem conseguirá sobreviver a este novo mundo? Não serão certamente estas pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296601
    m_Localized: 'Window: Há agentes da AGEF junto aos cães mortos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296602
    m_Localized: 'Window: Um deles está a tirar notas de algo num tablet.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296603
    m_Localized: 'Window: Mas conseguirão algumas pessoas travar um monte de animais esfomeados? É pouco provável.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296604
    m_Localized: 'Window: Há dois agentes da AGEF junto a um poste de iluminação, a olhar para o homem suspenso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296605
    m_Localized: 'Window: Parece que encontraram finalmente a principal atração da área.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296606
    m_Localized: 'Window: Assemelham-se a detetives em busca de pistas, a perguntarem-se como terá ele lá chegado sem uma escada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296607
    m_Localized: 'Window: Todo o grupo está morto. Cães esfomeados despedaçam o que resta dos corpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296608
    m_Localized: 'Window: Vês cartuchos vazios junto aos corpos. Parece que um caçador os matou e levou provavelmente alguns troféus.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296609
    m_Localized: 'Window: A loucura deste mundo foi longe demais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296610
    m_Localized: 'Window: Os membros do culto empilham a madeira num grande monte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296611
    m_Localized: 'Window: Estarão a planear queimar alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296612
    m_Localized: 'Window: Em breve, o plano de toda esta loucura será revelado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296613
    m_Localized: 'Window: Mas quantos inocentes terão de perder a vida por esta causa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296614
    m_Localized: 'Window: Na rua, há um atirador tresloucado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296615
    m_Localized: 'Window: Está a segurar numa botija de gás e num cocktail Molotov.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296616
    m_Localized: 'Window: Estará ele a planear queimar toda a vila?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296617
    m_Localized: 'Window: Será que alguém lhe disse que aquelas pessoas vieram de zonas de quarentena?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296618
    m_Localized: 'Window: Os corpos daqueles que se escondiam nas ruínas da casa do teu vizinho jazem queimados sob o sol do meio-dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296619
    m_Localized: 'Window: Os cães que neles se alimentavam, fugiram... como se tivessem medo de algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296620
    m_Localized: 'Window: E se tiverem fugido de algo pior do que a AGEF?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296621
    m_Localized: 'Window: No local da fogueira, os membros do culto estão amarrados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296622
    m_Localized: 'Window: Decidiram sacrificar-se?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296623
    m_Localized: 'Window: O pensamento invade-te a mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296624
    m_Localized: 'Window: O medo da morte toldou a razão e as pessoas estão dispostas a fazer as coisas mais inenarráveis.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296625
    m_Localized: 'Window: É aterrador imaginar o que virá a seguir quando este tipo de loucura está a acontecer após apenas algumas semanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296626
    m_Localized: 'Window: Há casas em chamas a arder em força, com gritos a ecoar ao longe...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296627
    m_Localized: 'Window: Sabes quem é responsável por todo este caos: o louco que está a tentar eliminar os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490688
    m_Localized: 'Window: Será a tua casa a próxima? E quando? Amanhã? Na próxima semana?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490689
    m_Localized: 'Window: É provável que venhas a enfrentar aquele lunático. É apenas uma questão de tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490690
    m_Localized: 'Window: Não resta nada dos corpos queimados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490691
    m_Localized: 'Window: Apenas uma estranha massa disforme. Como um bocado de lama.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490692
    m_Localized: 'Window: Perguntas-te se algo derreteu a carne e os ossos antes de engolir os restos mortais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490693
    m_Localized: 'Window: Rezas para que esta criatura se mantenha nas sombras. Temes que a tua mente não sobreviva à visão deste monstro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490694
    m_Localized: 'Window: Os agentes da AGEF rodeiam os corpos queimados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490695
    m_Localized: 'Window: Estão a documentar as mortes dos membros do culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490696
    m_Localized: 'Window: Os seus rostos jazem congelados em terror e agonia, como se tivessem visto algo horrível antes de morrerem.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490697
    m_Localized: 'Window: Todas as casas nas proximidades estão em ruínas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490698
    m_Localized: 'Window: A tua casa é a única ainda de pé.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490699
    m_Localized: 'Window: Não há mais ninguém que se oponha ao homem e à sua loucura.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490700
    m_Localized: 'Window: Seja lá o que for acontecer a seguir, é a ti que vai acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490701
    m_Localized: Daqui é a Central. Verifiquem o estado da zona de quarentena. Código 51. Há relatos de explosões às 3:00.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490702
    m_Localized: 'Daqui é a Unidade 32-8. Código 60: há imensos civis mortos e agentes abatidos...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490703
    m_Localized: Daqui 28-8. Código 451. Solicita-se o apoio da equipa incendiária para a eliminação de corpos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490704
    m_Localized: Confirmado. A iniciar Código 984. A cidade está a ser alvo de isolamento com investigação pendente. Aguardem reforços.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490705
    m_Localized: Se ouvirem isto... mantenham-se longe dos arredores.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490706
    m_Localized: Os agentes da AGEF estão a abater toda a gente que tentar sair.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490707
    m_Localized: NÃO SEI O QUE ESTÁ A ACONTECER. SÓ QUERO SAIR DAQUI.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490708
    m_Localized: ALGUÉM, POR FAV...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490709
    m_Localized: Não foram aqueles que atacaram a zona de quarentena.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490710
    m_Localized: Eu vi-o. Vi o que ali estava.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490711
    m_Localized: Aquilo... não era humano...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490712
    m_Localized: Daqui falam os residentes expulsos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490713
    m_Localized: Se a AGEF vos expulsou de casa como fizeram connosco, estamos abrigados na cave de uma casa queimada.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490714
    m_Localized: Fica perto da casa do eremita.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490715
    m_Localized: Não nos resta muita comida e vamos começar a passar fome em breve.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490716
    m_Localized: Se alguém puder dispensar comida, ajudem-nos, por favor. Estamos mesmo a precisar.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490717
    m_Localized: A todos os que nos estiverem a ouvir...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490718
    m_Localized: A AGEF está a tentar interferir com todos os sinais na cidade para manter tudo abafado.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490719
    m_Localized: Querem esconder tudo o que está a acontecer na cidade.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490720
    m_Localized: Estão a tentar meter as culpas naquele psicopata que matou toda a gente na zona de quarentena.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490721
    m_Localized: Se ainda estiverem na cidade – s...aiam daí. N...ão é seguro.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490722
    m_Localized: E...vitem as patrulhas da AGEF. V... m...atar-vos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490723
    m_Localized: C...ORRAM E...QUANTO A...NDA PO–
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490724
    m_Localized: Não de...iam ter qu...mado os co...pos. Aquilo... aquilo atr...i...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490725
    m_Localized: Se tivess... se tivessem ... estos... não teria–
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490726
    m_Localized: C...tral para... todas as unidades da... EF...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490727
    m_Localized: 'Nova di...triz: o Código 451 foi subs...tu...do pelo Código 955.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490728
    m_Localized: Não quei...em os corpos. Apliquem antes...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490729
    m_Localized: Repi...o, Código 451 é... Queimar r...os ... ... para cont...r a amea...a do sujei–
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490730
    m_Localized: D...i Unidade 18-8. N...o cons...guimos a cont...ão.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490731
    m_Localized: O suj...to abandonou o perím...tro da cidade... Solic...-se apoio imedi...to.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490732
    m_Localized: 'Rep...o: solic...-se apoio já. Não cons...mos conter o ...jeito sem apoio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490843
    m_Localized: 'Phone: Olá. Aguarde enquanto estabelecemos ligação a um Especialista de Remoção de Visitantes disponível.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490844
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490845
    m_Localized: 'Phone: Estou? Quem fala?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490846
    m_Localized: Como assim?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490847
    m_Localized: Por que precisa de saber quem sou?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490848
    m_Localized: 'Phone: Muito bem, estou a ver. Não lhe foi possível dizer logo que era humano. O Espírito Visitante já se enraizou em si.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490849
    m_Localized: 'Phone: Preste atenção, não tem muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490850
    m_Localized: 'Phone: Diga-me, costuma deixar alguma fatia de pão de fora na cozinha?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490851
    m_Localized: Não? Por que haveria de o fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490852
    m_Localized: Uma fatia de pão?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490853
    m_Localized: 'Phone: Para me ajudar a expulsar o Espírito Visitante dentro de si.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490854
    m_Localized: 'Phone: Bem, esqueça. Preste atenção, não tem muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490855
    m_Localized: 'Phone: Diga-me, costuma deixar alguma fatia de pão de fora na cozinha?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490856
    m_Localized: Não? Por que haveria de o fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490857
    m_Localized: Uma fatia de pão?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490858
    m_Localized: 'Phone: Oh... Isso explica muita coisa. Não mantém boas relações com o Espírito de Casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490859
    m_Localized: 'Phone: É por isso que o Espírito Visitante entrou em si. Mas não se preocupe. Havemos de arranjar solução para isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490860
    m_Localized: 'Phone: Tem um computador em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490861
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490862
    m_Localized: Um compu-quê?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490863
    m_Localized: 'Phone: Não deixa oferendas ao Espírito de Casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490864
    m_Localized: 'Phone: Não é de admirar que o Espírito Visitante tenha sido atraído até si.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490865
    m_Localized: 'Phone: Tem um computador em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490866
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490867
    m_Localized: Um compu-quê?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490868
    m_Localized: 'Phone: Muito bem, portanto, Alt+F4 está fora de questão...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490869
    m_Localized: 'Phone: Muito bem, diga-me: consome cogumelos?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490870
    m_Localized: Apenas kombucha. Ocasionalmente.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490871
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490872
    m_Localized: 'Phone: A sério que não sabe o que é um computador?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490873
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490874
    m_Localized: 'Phone: Ok, esqueça. Continuando...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490875
    m_Localized: Apenas kombucha. Ocasionalmente.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490876
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490877
    m_Localized: 'Phone: Oh não...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490878
    m_Localized: 'Phone: Tem de parar de a beber imediatamente. A kombucha é um mal antigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490879
    m_Localized: 'Phone: Ela permite que o Mycelium cresça dentro de si. É por isso que o espírito o pode controlar como um fantoche.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490880
    m_Localized: 'Phone: Não imagina o que este espírito fará se conseguir aceder às suas memórias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490881
    m_Localized: 'Phone: Pode eliminá-las ou... lê-las uma e outra vez, podendo até mudar as decisões tomadas por si.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490882
    m_Localized: 'Phone: A pior parte é que nem vai conseguir perceber que está a ser controlado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490883
    m_Localized: 'Phone: Muito bem, então, uma última pergunta: já foi derramado algum sangue dentro de sua casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490884
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490885
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490886
    m_Localized: 'Phone: Ótimo. Então não a beba. Caso contrário, é mais fácil para o Grande Visitante voltar ao seu corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490887
    m_Localized: 'Phone: Se a tivesse bebido, o Mycelium poderia ter começado a crescer dentro de si... e a controlá-lo como um fantoche.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490888
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490889
    m_Localized: 'Phone: Ui, não é fácil... não é mesmo nada fácil...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490890
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490891
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490892
    m_Localized: 'Phone: Ah, está explicado...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490893
    m_Localized: 'Phone: Não é um Espírito Visitante. É um Espírito Espetral. A alma de uma pessoa morta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490894
    m_Localized: 'Phone: Receio que a remoção espiritual não seja propriamente a minha área.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490895
    m_Localized: 'Phone: Para tal, precisará de um exorcista. Com certeza que um o poderá ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490896
    m_Localized: 'Phone: Suponho que não haja mais nada com que o possa ajudar. Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490897
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490898
    m_Localized: 'Phone: A sua sessão de Remoção de Visitantes foi agora concluída. Agradecemos a utilização dos nossos serviços.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490899
    m_Localized: 'Phone: Brevemente, ser-lhe-á cobrada uma taxa de consulta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490900
    m_Localized: Uma taxa?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490901
    m_Localized: Pensei que esta chamada era gratuita
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490903
    m_Localized: 'Phone: Ah, que pena. Receio, então, não conseguir identificar este espírito. E, sem isso, não tenho como o ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490904
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490905
    m_Localized: 'Phone: Infelizmente, tenho de terminar aqui a nossa sessão.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490906
    m_Localized: 'Phone: Mantenha-se firme... Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490907
    m_Localized: 'Phone: A sua sessão de Remoção de Visitantes foi agora concluída. Agradecemos a utilização dos nossos serviços.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: Brevemente, ser-lhe-á cobrada uma taxa de consulta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: Uma taxa?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: Pensei que esta chamada era gratuita
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: Correto. Os nossos Especialistas em Remoção de Visitantes precisam de ser pagos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: Como avalia a sua experiência de hoje?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: Positiva
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: Inútil
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: Vão para o caralho, seus vigaristas de merda
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: Se prestou atenção ao anúncio, foi indicado em letras pequenas que a chamada não era gratuita.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: Como avalia a sua experiência de hoje?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: Positiva
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: Inútil
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: Vão para o caralho, seus vigaristas de merda
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: Obrigado. O seu feedback é extremamente importante para nós. Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: É tudo por agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: Agora disponível via entrega EuroCêntrica. Ligue já para {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: Boa tarde. Seguem-se as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: 'TV: Apesar dos incêndios, os Visitantes continuam a aterrorizar o país.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: A AGEF anunciou ainda um novo sinal de identificação para a presença de Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: Segue-se um comunicado especial relativamente à natureza dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: Hã? Estou? Olá?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: A tua esposa deu-me este número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: A tua esposa precisa de ajuda
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: Aham. E?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: Ela perdeu os filhos de vista
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: Os miúdos estão contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: É sempre a mesma história. Sou sempre eu a ter de arranjar forma de tratar das confusões criadas por ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: Ela só fica para aí a dizer coisas do género "Ai, estou cansada".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: Nada de novo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: Ela perdeu os filhos de vista
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: Estão contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: Aaaah, pois. Mais uma vez, ela não quer saber dos próprios filhos para nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: E, agora, tenho de ser eu a tratar das confusões dela...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: Já tentaste ver em casa da mãe dela?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: Talvez possas passar por cá a buscá-la?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: Não. Não estão com ela?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: Não me surpreende.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: Já tentaste ver em casa da mãe dela?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: Talvez possas passar por cá a buscá-la?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: Aham.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: Bem, talvez estejam por lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: Não vou sair daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: Ela que vá. Pergunta-lhe que raio de mãe é que se dá ao trabalho de ignorar os próprios filhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: Encontrem uma solução entre os dois
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: Seja como for, vou dizer-lhe que estás vivo e à espera
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: Ela que se desenrasque e venha. Não é nenhuma princesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: Ela tem duas perninhas em bom estado, não tem? Então, qual é o problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: Encontrem uma solução entre os dois
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: Seja como for, vou dizer-lhe que estás vivo e à espera
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: Então para que foi que ligaste? Para salvar algum tipo de donzela em sarilhos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: Façam o que quiserem para aí. Essa vaca não quer saber de nada e não.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: Deixem-me só em paz, porra!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: 'Phone: Não vale a pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: Não te incomodes. Para quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: Não queremos saber um do outro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: Nem faço ideia para que te estás a envolver.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: Enfim... sejam felizes. Que tenham uma vida maravilhosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: Acreditas na morte?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: O teu marido pediu-me para te telefonar
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: Vamos passar à frente do sermão. Isto está relacionado com o teu marido
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: O quê? O meu marido?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: Depois de tudo o que fez... não quero ouvir uma palavra que seja acerca dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: Ele pediu-me para te dizer que lamenta o que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: Ele pediu-me para te mandar para o inferno
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: O meu marido?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: Depois de tudo o que fez... não quero ouvir uma palavra que seja acerca dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: Ele pediu-me para te dizer que lamenta o que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: Ele pediu-me para te mandar para o inferno
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: Hah. Como é?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: A sério? Outra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: Suponho que não saibas que já houve mais gente a pedir desculpa por ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: Queres saber por que razão é que não consegue ser ele a telefonar-me?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: Porque não tem tomates para enfrentar aquilo que fez. Para o aceitar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: Continua a acreditar que pode resolver tudo, voltar ao passado. Mas a vida não funciona assim. Não podemos voltar atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: Estou melhor agora. Estou com pessoas que me compreendem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: Achas que um monte de fanáticos te consegue compreender?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: Por que motivo te juntaste a um culto?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: Se tu o dizes
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: Chama-lhes o que quiseres. Agora são a minha família.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: Partilhamos a mesma crença. Sabemos que, muito em breve, a Morte vai chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: E que não trará dor, mas sim paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: Cuida-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: Acreditamos todos no mesmo sobre aquilo que virá a seguir: a chegada da Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: Isto pode parecer-te estranho, mas a Morte não traz tristeza; traz antes felicidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: Felicidade sob a forma de paz e do fim do sofrimento. Tenho a certeza de que também passaste por muitas dificuldades.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: Talvez um dia compreendas e acabes por ver as coisas da mesma forma que nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: Cuida-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: Obrigada por compreenderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: Cuida-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: Estou? Quem fala?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: Olá. O teu irmão deu-me este número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: Podes ajudar o teu irmão?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: Qual irmão? Nem sequer...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: Ah, estás a falar do filho do meu pai, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: Mas, espera, quem és tu? E por que motivo está ele contigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: Os pais dele desapareceram
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: Ele veio até aqui à procura de abrigo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: Desapareceram? Como?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: Não estás a querer dizer que eles...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: Raios... Isto não pode ser verdade... Estão mortos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: Não sei
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: É provável
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: À procura de abrigo? Mas ele vive com os pais, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: Será que eles...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: Raios... Isto não pode ser verdade... Estão mortos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: Não sei
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: É provável
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: Meu Deus... Como é que isso aconteceu...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: Diz-lhe que posso ficar com ele. Ele sabe onde vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: E... obrigado por o ajudares.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: Estou? Quem fala?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: E a tua esposa e a irmã dela estão aqui em minha casa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: A tua esposa deu-me este número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: Pela tua maneira de falar até parece que foram raptadas e que vais pedir um resgate.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: Receio não ter mais nada para dar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: E, em breve, não haverá também mais ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: Como assim? O que se passa contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: A tua mulher está bem
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: Diz-me que ela está bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: Ela é forte e vai conseguir ultrapassar qualquer coisa. Até tenta ajudar todos aqueles que puder pelo caminho!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: Mas... acho que já não há qualquer ajuda possível para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: Não vou durar muito mais tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: Como assim? O que se passa contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: A tua mulher está bem
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: Eu... já não aguento mais. O sol, os Visitantes, os grupos tresloucados... É tudo tão assustador... Sinto-me paralisado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: Só... só quero que tudo acabe. Só me resta uma saída... estás a perceber o que quero dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: Diz-lhe que a amo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: Na verdade... não lhe digas nada. Assegura-te só de que ela não vem à minha procura.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: Não quero que saiba que não a levei comigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: Obrigado por me telefonares. E por me ouvires.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: Adeus...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: Provavelmente, está abraçada à irmã. Ela nunca a soube largar...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: É tão infeliz, sempre rodeada de gente fraca. Foi por isso que escolhi deixá-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: Admissões AGEF, bom dia. Em que lhe posso ser útil?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: Está aqui a mulher de um agente da AGEF
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: Há aqui uma altruísta que se quer juntar às vossas fileiras
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: Ok, e qual é a sua pergunta? Ainda não percebi em que lhe posso ser útil.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: Assumindo que isto não é uma ameaça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: ... É mesmo uma ameaça
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: Ela está à procura de um cargo na AGEF. Já trabalhou na fronteira
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: (Ouves um suspiro bem audível do outro lado)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: É um daqueles ativistas que andam por aí, não é? Sempre a queixarem-se de alguma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: Não nos faça perder tempo! Pode haver mesmo alguém a precisar de ajuda e que nos esteja a tentar contactar agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: Os Visitantes podem estar a entrar nalgum lado. Ou pior. E, agora, talvez haja pessoas a morrer por sua causa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: Hm. Ela deveria saber que este trabalho não é... fácil. Está mesmo preparada para isto?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: Se estiver, diga-lhe para preencher o Formulário 31-G em triplicado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: Em seguida, terá de obter aprovação médica. Depois disso, preencha...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: (Desligas o telefone. Para que te deste sequer ao trabalho de telefonar acerca desta mulher?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: A que posição se está ela a candidatar? Espero que não seja para administradora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: Já seria a terceira, hoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: Administradora
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: Identificadora. Ou alguma espécie de cargo de deteção
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: Já chega da merda destas chamadas de brincadeira.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: Enquanto ocupa a linha, há gente que não nos pode contactar. Talvez haja alguém a morrer agora às mãos dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: Assuma a responsabilidade pela sua piada parva e inapropriada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: (Desligaram. A sério?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: Não abrimos vagas sem mais nem menos. Estamos a precisar é de especialistas em epidemias e cientistas qualificados.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: A sua amiga não nos parece ser adequada para trabalhar connosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: Sabe que mais? As coisas estão sempre a mudar. Volte a ligar para a semana.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: Tenho a certeza de que haverá alguma vaga para... o que foi que lhe chamou? Uma altruísta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: Estrutura de uma maçã: a sobremaçã, a terra dos cogumelos e papel.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: Teme a... dos cog...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: Embora seja tão... encanta...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: Lá... encontra...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: Apenas lágrimas e um fim iminente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: Verifica a sua respiração.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: Por que não respondes? Quero morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: (O telefone é desligado. Isto não foi... bem aquilo que esperavas)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: Tenha em conta que, neste momento, não é possível chegar até ao nosso país por via férrea ou aérea.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: Em que lhe posso ser útil?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: Preciso de mandar um turista de volta a casa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: Por que razão não pode ir de comboio?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: O melhor é aguardar que os voos sejam novamente permitidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: Os ferries mantêm-se em atividade, mas não são seguros. O risco de tufões é demasiado elevado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: Além disso, a água reflete o sol para as embarcações e a tripulação não consegue permanecer no exterior por muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: Então, como é suposto fazer com que este pobre coitado chegue a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: De momento, ele está a viver comigo. Talvez o possam acolher por aí?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: Os carris expandiram-se devido ao calor. É demasiado perigoso viajar de comboio durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: Os comboios funcionam apenas à noite, portanto não poderá viajar para muito longe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: Terá de efetuar várias trocas de veículo. É melhor aguardar até que as viagens aéreas retomem o seu funcionamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: Então, como é suposto fazer com que este pobre coitado chegue a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: De momento, ele está a viver comigo. Talvez o possam acolher por aí?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: A única coisa a fazer é aguardar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: Não há mais nada que possamos fazer, de momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: Ele nem sequer fala o nosso idioma
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: Então, se não podem fazer nada, qual é a porcaria da vossa utilidade?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: Não temos hotéis.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: Não há nada que possamos fazer. Estamos a tentar solucionar o problema. Ele não é caso único nessa situação.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: Ele nem sequer fala o nosso idioma
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: Então, se não podem fazer nada, qual é a porcaria da vossa utilidade?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: A nossa equipa está muito ocupada. Se calhar já ouviu falar que os orçamentos da embaixada sofreram grandes cortes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: Estamos a fazer tudo o que está ao nosso alcance.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: Uau, são cá uns heróis...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: Tenho ódio a gente preguiçosa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: Não é preciso falar dessa forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: Não o podemos carregar às costas até casa. Se quer ajudar, é o senhor que o terá de fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: Os orçamentos sofreram cortes tão grandes que estamos praticamente aqui a trabalhar à base do entusiasmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: Uau, são cá uns heróis...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: Tenho ódio a gente preguiçosa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: Não gosta da forma como estamos a lidar com as coisas? Faça melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: Boa sorte a atravessar a fronteira com as verificações de Visitantes e o calor do meio-dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: Tudo bem, obrigadinho
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: Vão para o caralho
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: Então, por que está em casa e não a trabalhar?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: Ou talvez possa vir até aqui e mostrar-nos como faria melhor?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: Seria um prazer ter a ajuda de alguém que sabe mais do que toda a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: Tudo bem, obrigadinho
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: Vão para o caralho
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: Desculpe ter perdido a cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: Mas não é o primeiro a... telefonar para aqui tão chateado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: Tenha um bom dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: Boa viagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: Espero mesmo que volte a ter vontade de viajar um dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: Nessa altura, terei todo o gosto em o ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: Janela para outro quarto. As pessoas faziam-nas para poupar eletricidade e para a luz passar de um quarto para o outro.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: Depois, taparam-na... mas apenas daquele lado.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: Não, já não olho naquela direção. Nunca mais.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: Odeio dormir junto à mesa de cabeceira. Demasiadas más memórias...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: Não percebo por que não está ao canto. Pensei que fosse uma regra.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: De qualquer forma, o Pai nunca quis saber de regras para nada.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: Toto. Praticamente o único brinquedo que tive enquanto criança.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: Bem... exceto pelos tacos que usávamos na relva.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: Heh. A Avó enchia os armários todos de pratos até não dar mais.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: Só tirava o serviço de mesa todo janota nos feriados. Agora... quem é que precisa dele?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: Francamente, fico melhor estando sozinho em casa.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: Até posso falar comigo próprio.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: Uma das revistas em que é necessário encontrar uma certa pessoa no meio da multidão...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: Qual é o objetivo? Quem me dera que me deixassem simplesmente em paz de uma vez...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: Um dia disse "Quando já cá não estiver, decides se queres abrir aquela caixa ou não".
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: Há quinze anos que não me decido. Ainda não consegui perceber.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: Está a sentir o peso da solidão?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: Sem alguém com quem falar? Com ansiedade?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: Então, a Roleta Telefónica é exatamente aquilo de que precisa.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: Ligue já para 891-533 e encontraremos a pessoa ideal com quem poderá conversar.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: A tua filha está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: Quem foi que os matou?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: Tem cuidado (Termina a chamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: A tua filha está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: Quem foi que os matou?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: Tem cuidado (Termina a chamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: Para onde levaram o teu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: Foi bom não terem levado a tua filha
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: O que é a AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: Cuida-te (Termina a chamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: Para onde levaram o teu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: Foi bom não terem levado a tua filha
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: O que é a AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: Cuida-te (Termina a chamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: Para onde levaram o teu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: Foi bom não terem levado a tua filha
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: O que é a AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: Cuida-te (Termina a chamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: Olá, ligou para a linha direta da AGEF. De que forma o podemos ajudar?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: O quê? AGEF? O que é isso?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: Do que é que estás a falar?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: (Antes que ela possa terminar, ouves um homem barulhento a gritar perto dela)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: ÉS IDIOTA OU QUÊ?! DESLIGA JÁ O TELEFONE!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: O que é suposto fazer com as axilas?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: O que é suposto fazer com os ouvidos?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: Para garantir que os testes na zona inferior do braço são exatos, tem de evitar qualquer contacto com a água.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: Evite tomar banho e lavar as mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: Ouvidos? Espere...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: Vamos consultar os nossos superiores e dar-lhe-emos a resposta mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: Muito bem, então diz-me: consomes fungos?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: Certo. Uma última pergunta: foi derramado algum sangue dentro de tua casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: Olá, esta é a Roleta Telefónica. Em breve, vamos estabelecer ligação à pessoa ideal com a qual pode conversar. Aguarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: Estou? Olá.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: Olá
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: Estou?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: Olá
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: Parece que não está ninguém do outro lado...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: Eu... eu preciso de falar com alguém. Há tanta coisa a acontecer ultimamente...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: Tentei contactar os meus amigos e conhecidos, mas ninguém atende o telefone...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: Foi então que soube da Roleta Telefónica.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: Talvez não seja o melhor sítio para desabafar, mas é melhor do que nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: Sei que não é correto estar a sobrecarregar um estranho com os meus problemas, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: Não fazes ideia da ajuda que seria poder apenas falar com alguém. Ficaria a sentir-me... muito melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: Posso pedir-te que me ouças?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: Não estou preparado para uma conversa demorada
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: Está bem, desculpa se te incomodei.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: Muito obrigada. De verdade!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: Penso que seja mais fácil se te contar um pouco sobre mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: O que gostarias de saber?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: Onde vives?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: Por que razão decidiste telefonar para aqui, em vez de tentares telefonar para os teus amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: Longe de casa, infelizmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: Ao tentar fugir do calor, procurei o sítio mais fresco possível.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: Estou no meio do nada. O frio aqui é tanto que chega aos ossos e não nasce nada aqui, nem relva.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: É um sítio relativamente seguro, a milhas de qualquer outro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: Mas se houver alguma zona fria no nono círculo do inferno... talvez até não seja mau de todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: É engraçado. Eu odiava o frio, mas agora... parece uma bênção.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: Quero acreditar que o sol vai deixar de arder em força e que tudo isto vai acabar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: Mas começo a perder a fé num final feliz. O que acontece quando o sol deixar de arder?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: Os Visitantes podem nunca vir a desaparecer. Poderiam substituir amigos e entes queridos e nem sequer saberíamos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: Por que te foste embora sozinha?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: Tens saudades da tua terra natal?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: Queria telefonar-lhes, mas... não sei como...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: O problema é que, quando o cataclismo começou, decidi abandonar a minha terra natal e afastar-me ao máximo do calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: Prometi a todos que iria telefonar com regularidade e que me iria manter em contacto...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: Mas quando cheguei, não consegui contactar ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: Mais tarde, descobri porquê – as linhas telefónicas foram cortadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: Toda a cidade ficou isolada do resto do mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: Agora, estou aqui, em segurança. Mas todos os meus amigos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: A ideia de nunca mais ver as pessoas de que gosto é aterradora.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: Tenho saudades dos dias tranquilos, de quando a vida era simples e o futuro era algo para o qual olhávamos com esperança.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: Por que te foste embora sozinha?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: Tens saudades da tua terra natal?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: Não era o que queria. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: Na verdade, o meu melhor amigo quis vir comigo, mas não foi possível...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: Ele não tinha os documentos necessários para viajar comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: E, quando o cataclismo ocorreu, tornou-se impossível obtê-los.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: Ele ficou tão devastado... por não os ter obtido mais cedo. Queria ajudá-lo, mas não sabia como.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: Tenho algumas saudades. Mas tenho mais saudades das pessoas que ficaram e não tanto da cidade...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: Tenho saudades, principalmente, do meu melhor amigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: Ele quis vir comigo, mas não foi possível. Prometi-lhe que iria manter o contacto com ele. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: Acho que ele estava apaixonado por mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: Ele preocupava-se tanto comigo. Apoiava-me sempre e estava sempre pronto para me ouvir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: E, depois, percebi que gostávamos um do outro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: Queria que ele confessasse os seus sentimentos primeiro, mas não conseguiu. Não encontrou o momento certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: E depois... o cataclismo começou e deixou de haver tempo para isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: Arrependo-me de não lhe ter falado sobre os meus sentimentos primeiro...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: Bem, agora já sabes um pouco sobre mim. É a tua vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: Não estou habituado a falar sobre mim..
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: Nem sei...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: Não tenhas vergonha. Estou aqui para te ouvir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: Bem... Não tenho ninguém que me seja chegado
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: Sou... uma pessoa solitária
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: Não te preocupes. Não há nada de mal em falares de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: Bem... Não tenho ninguém que me seja chegado
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: Sou... uma pessoa solitária
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: Eu... tive uma relação complicada com o meu pai
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: O meu pai... eu odiava-o
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: Já não faço parte da família
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: E, um dia, deixei de ser filho dele
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: E tudo o que tenho é esta maldita casa.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: Agora, tudo o que resta da minha família é esta casa.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: Lamento muito... Não pareces muito entusiasmado pelo facto de teres ficado com a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: É verdade
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: Teria sido melhor se ela tivesse ardido até se transformar em cinzas
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: Não consigo... não consigo imaginar o que passaste.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: Não consigo imaginar o ódio que deves sentir pelo teu pai se prefererias ver a casa a arder.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: 'Phone: Mais uma vez, obrigada por falares comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: 'Phone: Adeus. E muita força!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: Estou?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: Olha, posso falar com a tua filha?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: Olha, há problema se a tua filha vier até aqui para brincar com a amiga dela?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: O quê? Para que queres falar com ela?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: A amiga dela perguntou se ela pode vir até aqui
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: Está cá uma miúda... o pai dela morreu
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: Ele... ele era... um Visitante também?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: Como assim "também"?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: Não, uns esquisitoides queimaram-no vivo sem motivo algum.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: Ninguém queima outra pessoa sem motivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: Portanto, ele era um Visitante... tal como aconteceu com a nossa menina.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: Também a queimaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: Aqui mesmo, no jardim de infância onde ela andava.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: Ao início, chorei. Queria matar-me. Não conseguia viver sem ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: Mas o meu marido ajudou-me a ultrapassar tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: E também tu vais ultrapassar isto... e o mesmo se aplica a essa menina.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: Tu entendes...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: Tudo acontece por um motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: Se queimaram o pai dela... é porque tinha de acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: E chorar não vai ajudar em nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: Diz-lhe isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: A nossa menina... ela...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: Morreu...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: 'Phone: Tivemos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: Tivemos de a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: O quê?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: (Desliga)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: 'Phone: Matámo-la. Acredita, teve de ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: Tinha todos os sinais... e o meu marido insistiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: Decidiste... matar a tua própria filha?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: 'Phone: Não me julgues!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: Era um Visitante! Todos os sinais apontavam para isso, sem qualquer dúvida!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: Caralho...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: Eu entendo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: Era um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: Tinha todos os sinais de o ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: Eu conhecia-a como a palma da minha mão.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: É por isso que reparei nos sinais imediatamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: Não falhou um único sinal.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: Assim que contei ao meu marido, ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: Tratou logo do Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: Ao início, queria matá-lo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: Mas depois percebi... percebi que aquela não era a nossa filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: O meu marido ajudou-me a compreender isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: Agora, só me arrependo de nunca ter perguntado à invasora o que fez à nossa pequenina...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: Desculpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: Nunca mais telefones para aqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: Por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: Por que raio é que te estou a dar satisfações?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972625
    m_Localized: 'Phone: Vai para o inferno!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972626
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972627
    m_Localized: 'Phone: Ainda tenho saudades dela...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972628
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490733
    m_Localized: 'Phone: Olá, vizinho. Que bom ouvir-te!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490734
    m_Localized: 'Phone: Então... Já deixaste entrar algumas pessoas?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490735
    m_Localized: 'Phone: Se não, não devias esperar muito.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490736
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490737
    m_Localized: 'Phone: Tens alguma dúvida?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490738
    m_Localized: Também estás a acolher pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490739
    m_Localized: Quantos sinais é necessário identificar para ficarmos a saber se alguém é um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490740
    m_Localized: Como resolveste a questão da comida?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490741
    m_Localized: Adeus (Desliga)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490742
    m_Localized: 'Phone: Sim, tem de ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490743
    m_Localized: 'Phone: A minha filha não gosta nada, mas o que se há de fazer? Não há outra forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490744
    m_Localized: 'Phone: Ela continua a pedir-me para a levar lá fora, só para se poder afastar de todos os estranhos dentro da casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490745
    m_Localized: 'Phone: Mas não podemos sair à luz do dia. Portanto, vamos à noite. Eu sei que é perigoso, mas ela não para de implorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490746
    m_Localized: 'Phone: Quem me dera saber...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490747
    m_Localized: 'Phone: Ninguém sabe na verdade quantos sinais é necessário identificar para podermos ter a certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490748
    m_Localized: 'Phone: Diria para não tirares conclusões precipitadas quando identificares um dos sinais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490749
    m_Localized: 'Phone: Pode não ser nada. Pode ser que a pessoa tenha ido ao dentista antes de tudo isto dar para o torto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490750
    m_Localized: 'Phone: Tive sorte. Preparei-me com antecedência. E, se a memória não me falha, tu também.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490751
    m_Localized: 'Phone: Mas se quiseres algo em particular, podes recorrer ao serviço de entrega de comida, a EuroCêntrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490752
    m_Localized: 'Phone: Não decorei o número, mas podes encontrá-lo na TV ou nos anúncios de rádio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490753
    m_Localized: 'Phone: Cuida-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490754
    m_Localized: 'Phone: Olá, vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490755
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490756
    m_Localized: 'Phone: Viste o que aconteceu lá fora? Mataram aqueles jovens...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490757
    m_Localized: 'Phone: Pensei que as ruas não fossem assim tão perigosas. Parece que me enganei.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490758
    m_Localized: 'Phone: A minha filha convenceu-me a ir brincar com ela. Estava a correr tudo bem... até que vi os corpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490759
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490760
    m_Localized: 'Phone: Acho que foi a última vez que arrisquei a vida dela daquela forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490761
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490762
    m_Localized: 'Phone: Céus, jamais me vou perdoar se algo lhe acontecer. Ela é o meu mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490763
    m_Localized: A tua filha está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490764
    m_Localized: Quem foi que os matou?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490765
    m_Localized: Tem cuidado (Desliga)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490766
    m_Localized: 'Phone: Quem foi que os matou?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490767
    m_Localized: 'Phone: Com toda aquela relva alta, não era suposto ela ter reparado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490768
    m_Localized: 'Phone: Mas, quando estávamos em casa, ela disse-me que viu uma cara no meio da relva...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490769
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490770
    m_Localized: 'Phone: Estou a tentar convencê-la de que foi apenas a sua imaginação. Mas... ela acha que não.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490771
    m_Localized: 'Phone: Foi aquela coisa pálida e alta. Pensei que só matasse pessoas dentro de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490772
    m_Localized: 'Phone: Pensei que tinha tudo sob controlo. Achei que se alguma vez visse aquela silhueta, conseguiria ir diretamente para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490773
    m_Localized: 'Phone: Mas não pensei nos corpos que ela poderia ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490774
    m_Localized: 'Phone: Obrigado, cuida-te tu também.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490775
    m_Localized: 'Phone: Olá, vizinho. Obrigado por ligares.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490776
    m_Localized: 'Phone: Francamente, ainda estou abalado com tudo isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490777
    m_Localized: 'Phone: Os assassinatos, os soldados, a AGEF...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490778
    m_Localized: 'Phone: Até apareceram à minha porta na noite passada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490779
    m_Localized: 'Phone: Fizeram perguntas sobre as pessoas que cá estão, tomaram notas num tablet e, depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490780
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490781
    m_Localized: 'Phone: Um deles levou alguém daqui de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490782
    m_Localized: Para onde foi que levaram essa pessoa?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490783
    m_Localized: Foi bom não terem levado a tua filha
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490784
    m_Localized: Mas, afinal, quem é a AGEF?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490785
    m_Localized: Cuida-te (Desliga)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490786
    m_Localized: 'Phone: Sei lá. Disseram que era para uma "verificação".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490787
    m_Localized: 'Phone: Pensei que os soldados e a Agência de Gestão de Emergências fossem tornar as coisas melhores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490788
    m_Localized: 'Phone: Já devia saber que é melhor não contar muito com a ajuda deles. Ou contar que nos levem para um sítio seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490789
    m_Localized: 'Phone: Não vou deixar isso acontecer, nem pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490790
    m_Localized: 'Phone: Só por cima do meu cadáver.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490791
    m_Localized: 'Phone: Se aqueles otários lhe tocam com um dedo que seja, parto-os todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490792
    m_Localized: 'Phone: Não sei. Ninguém sabe grande coisa sobre eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490793
    m_Localized: 'Phone: Surgiram do nada e começaram a agir como se tivessem tudo sob controlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490794
    m_Localized: 'Phone: Mas como é que identificam os sinais? E porque é que estes sinais se baseiam em coisas humanas perfeitamente normais?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490795
    m_Localized: 'Phone: Dá a sensação de que não nos estão a dizer tudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490796
    m_Localized: 'Phone: Obrigado'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490797
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490798
    m_Localized: 'Phone: Nunca pensei que acabaríamos por viver mergulhados nos caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490799
    m_Localized: 'Phone: O sol, os Visitantes, agora a AGEF...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490800
    m_Localized: 'Phone: Tantas perguntas e zero respostas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490801
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490802
    m_Localized: 'Phone: Vizinho, preciso de te pedir uma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490803
    m_Localized: 'Phone: Se algo me acontecer, promete-me que cuidas da minha filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490804
    m_Localized: Prometo.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490805
    m_Localized: Não posso prometer nada
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490806
    m_Localized: 'Phone: Obrigado, vizinho. Sabia que podia contar contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490807
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490808
    m_Localized: 'Phone: Bem, tenho de ir. Mantém-te firme.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490809
    m_Localized: 'Phone: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490810
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490811
    m_Localized: 'Phone: Não vais mesmo ajudá-la? É apenas uma menina. Não a quero deixar só e abandonada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490812
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490813
    m_Localized: 'Phone: Raios, tenho de me despachar...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490814
    m_Localized: 'Phone: Adeus, vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490815
    m_Localized: 'Phone: Olá, daqui é da entrega de comida EuroCêntrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490816
    m_Localized: 'Phone: O que gostaria de pedir?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490817
    m_Localized: Duas latas de EnerJeka
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490818
    m_Localized: Uma lata de café
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490819
    m_Localized: Mudei de ideias, não quero efetuar qualquer pedido
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490820
    m_Localized: 'Phone: Lamentamos, mas não podemos aceitar o seu pedido, uma vez que já efetuou um há pouco tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490821
    m_Localized: 'Phone: Devido à grande procura, apenas podemos aceitar pedidos de forma pausada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490822
    m_Localized: 'Phone: Caso ainda pretenda efetuar um pedido, tente ligar novamente noutra altura.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490823
    m_Localized: 'Phone: Obrigado. Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490824
    m_Localized: 'Phone: Muito bem. O seu pedido foi efetuado. A entrega está planeada para amanhã à noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490825
    m_Localized: 'Phone: Muito bem. O seu pedido foi efetuado. A entrega está planeada para amanhã à noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490826
    m_Localized: 'Phone: Olá, daqui é do departamento médico da Agência de Gestão de Emergências Federal.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490827
    m_Localized: 'Phone: Estamos preparados para lhe fornecer informações relativamente aos procedimentos de rastreio para Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490829
    m_Localized: 'Phone: Tem alguma dúvida?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490830
    m_Localized: O que devo fazer relativamente aos dentes?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490831
    m_Localized: O que devo fazer relativamente às unhas?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490832
    m_Localized: O que devo fazer relativamente aos olhos?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490833
    m_Localized: Obrigado, é suficiente
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490834
    m_Localized: 'Phone: Para uma realização de testes mais exata, recomendamos que evite produtos tabágicos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490835
    m_Localized: 'Phone: Fumar pode afetar o estado dos dentes, o que pode originar resultados pouco fiáveis.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490836
    m_Localized: 'Phone: Para garantir uma leitura adequada do seu estado, evite lavar as mãos antes de qualquer exame.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490837
    m_Localized: 'Phone: A água pode remover resíduos superficiais, o que pode originar erros e resultados incorretos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490838
    m_Localized: 'Phone: Para um rastreio exato, evite café ou bebidas que contenham café.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490839
    m_Localized: 'Phone: A cafeína pode provocar insónias, nervosismo e vermelhidão nos olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490840
    m_Localized: 'Phone: Obrigado por colaborar com a Agência de Gestão de Emergências Federal.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490841
    m_Localized: 'Phone: O seu contributo será tido em consideração na resolução da situação atual.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490842
    m_Localized: 'Phone: Ao assegurar a exatidão de qualquer exame, está-se a ajudar e a ajudar toda a humanidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096192
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096193
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096194
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096195
    m_Localized: 'TV: Segue-se um comunicado sobre a suspensão temporária de eliminação de corpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 58690054376120320
    m_Localized: 'TV: Agora disponível via entrega EuroCêntrica. Ligue já para {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 58231803335401472
    m_Localized: Duas latas de comida de gato
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790080
    m_Localized: Um maço de cigarros
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790081
    m_Localized: Um frasco de kombucha
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
