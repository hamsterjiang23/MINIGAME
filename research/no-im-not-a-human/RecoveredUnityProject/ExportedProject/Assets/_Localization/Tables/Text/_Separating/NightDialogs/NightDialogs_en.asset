%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_en
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 2e47acfd0901bcf4eba15f47b223778b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Hey. *cough cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: Can you let me in, pal?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: What happened to you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: I''m *cough* a fireman.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: I got caught out in the sun while we were fightin'' forest fires today.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: The thick smoke helped prevent us from getting completely burned alive, but *cough* it was still horrible.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: The trees... *cough cough* They went up like matchsticks.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: I''ve never seen anything like it.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: Smoldering animal carcasses covered the forest floor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: Why aren't you at a hospital?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: What are you going to do?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: I got caught in the midday sun *cough cough* while putting out forest fires.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: I''m the only one left from my squad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: The rest, they... *cough* The boss just wouldn''t let them leave.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Now they''re on shift eternally.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: Why aren't you at a hospital?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: What are you going to do?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: A hospital? There are no more hospitals, pal.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: When the Visitors came, the whole point of hospitals went up in smoke.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: Hard to get treatment if you can''t trust who''s treatin'' ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: There''s *cough* no helping me now.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: I''d have been better off putting out those fires and dying out there with my buddies.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: I don''t have much time left, anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: I wanted to keep putting out those fires. I wish could''ve died back there instead of the guys.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: But they made it pretty clear *cough cough* I''d done enough.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Now I can''t get home. Public transport ain''t runnin'' no more.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: The only thing I can do now is rely on human kindness.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Thanks, pal. *cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: I don''t think I''ll be in your hair for too long. *cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: At least I won''t have to die alone in the dirt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Shit, man. *cough*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: I don''t want to die alone in the dirt...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: I hope *cough cough* the fires don''t spread to the cities.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: Heeey, what''s up!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: Long time no see. How''s life?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: ...Do I know you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Come on... You really don''t remember me?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: We were...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Hang on, your voice sounds different than I remember...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: How long ago did you start living here?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: This house has always been in my family
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: I think you've got the wrong address...
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Oh, you''re not...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: You''re not my buddy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: How long have you lived here?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: This house has always been in my family
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: I think you've got the wrong address..
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: Nah, no way.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: I''ve never made a mistake in my life! My memory is a steel trap, elephant-style even.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: My buddy definitely lives...well, lived...here.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: C''mon, I wheeled long-ass way to get here. Won''tcha let me in, please?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: No way, I couldn''t have...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: No...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: Damn it...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: I guess I did get it wrong.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: C''mon, I wheeled a long-ass way to get here. Won''tcha let me in, please?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: Oho! That''s what I''m talking about!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Looks pretty spacious, mate. Wanna race? 3... 2... 1... GO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: Leave? What the fuck do you mean?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: You expect me to just fucking...go?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Oh-hohhh, I''m rollin'' the fuck outta here. Lunatic asshole!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: Enough! Stop fidgeting and stand still.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Hello. Could you please help us?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: What happened?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: What do you want from me?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: I''m exhausted. I just want a place to sleep.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: I had five kids. Now this is the only one left.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: My husband disappeared, too. I don''t know if he''s dead or if he abandoned us, but...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Now I just want to lie down and pass out for a few days.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: Where did your other kids go?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: Are your kids dead?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: I want you to let me in so I can get some sleep. I''m dead on my feet...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: I used to have five kids. This here is the last one.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: I don''t know where to even start looking for them. I just want to get some decent shut-eye.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: Where did your other kids go?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: Are your kids dead?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: I don''t know. Maybe their father took them. I want to go to his house, but I just don''t have the strength anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Sure, we fought a lot, but it''s hard not to when you live with someone who acts like a complete asshole.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Forget him. Look, the most important thing to me now is finding my kids.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: Don''t say that.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: It''s hard to look after a whole pack of these rascals, but...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: Nothing''s happened to them. They probably found their way to my mom''s place.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: They always run off over there when they get sick of me.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: Or when their father comes by to ask for money...again.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: So will you let me in? I just want to rest up and go find my kids.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Finally. A moment of rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Come on, get a move on. Pick your spot.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: We''ll be out of here by tomorrow, I promise.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: Fine, then. I''ll just try to get to my mom''s house.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: I might not make it...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: No, I have to. I have to...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Hello, resident.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: I''m in a bad fuckin'' mood, so I apologize in advance.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: There are so many jackasses out here. I hope you''re not one of them.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: Who are you talking about?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: You're not one of those...things, are you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: Everyone, really.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: All them fuckers who were only kept in check by faith or whatever other bullshit stopped ''em from killin'' each other.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: After their gods died, there was nothing human left.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Now they''re just fucking animals.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: As if all this shit with the Visitors wasn''t enough... Now we have to deal with them, too. Fuck!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: What's got you so wound up?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: How are you any different from them?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Good question.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: You must have noticed that there are two...camps...of people now, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: One camp are all fuckin'' sadists. Worse than any Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: They do whatever the fuck they want. They''d put a gun to your head just to watch your corpse hit the dirt!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: The other camp are all dumb cattle. You can walk all over ''em and they''ll thank you for showing ''em mercy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: ...And both of ''em piss me the hell off.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: What's got you so wound up?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: How are you any different from them?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: Don''t take it personally. It''s just...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: All this shit with the sun and now the fuckin'' Visitors, it feels like humanity''s right there in the casket next to god.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: And I''m angry... I just wanted to do lead a normal fuckin'' life, y''know?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: I wrote music. No one has any use for that shit anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Now I''m just trying not to become part of either camp.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: I want to believe I''m different.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: You know, it scares me shitless to think about turning into one of those maniacs.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: Or a spineless victim. Both sides can go fuck themselves.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Though to be honest...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: I think the victims are worse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: They just sit around, countin'' the seconds till their teeth get kicked in, or whatever.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: You''d understand my anger if you''d seen everything I have.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: Don''t worry, I won''t be a bother.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: And no, I won''t beat anyone up.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: I turn my anger on myself so no one else has to suffer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Shit, you''re just as fucked up as the rest of those pissbaby cowards.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: You''ll just sit there and take it when they bash your face in.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: God-fucking-damnit!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: I sense the energy here is stagnant.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: Something very bad is developing within.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: The Sun and Leo are in the Fifth House. I see it all so clearly.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: You''re a pretty assertive person, aren''t you?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: Huh?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: I don't need anything from you
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: I can see you prefer to take action rather than talk.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Typical Leo, am I right?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: You''ve accumulated a large amount of dark energy here. Yes... Very unpleasant...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: I don''t yet understand the how or why...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Everything just feels so neglected, I suppose I should start with affirmations.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Thanks for dumping all that on my already troubled mind
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: Okay, and...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: I''m not trying to overstep here, darling.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: I can just help you understand the cause-and-effect relationship behind the suffering in these walls.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: A karmic sixty-nine, like two circling schools of fish.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Scratch my back and I''ll scratch yours. Understand?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Thanks for dumping all that on my already troubled mind
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: Okay, and...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: I understand that this is stressful for you since you''re a Capricorn rising.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: You''re juggling several constellations within yourself. You''re a complex person.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: We can use affirmations to reach the depths of your inner cosmos. You understand, don''t you?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Then everything will fall into place.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: There are prison guards in your prior incarnations.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Give them space. You''re just repeating the experiences of your past lives.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: You need to forgive them and accept their histories within yourself.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Only then will you be able to break the chains of the endless cycle.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: Do you understand?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Ah, delightful. You''re in quite an excellent location here, to be honest.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: There''s a powerful current of positive energy flowing through your house.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: So you''re not interested in working on yourself, is what you''re saying?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: No interest in becoming a better you?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: What a tragedy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: I shall make sure to manifest you a terribly explosive bout of diarrhea.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Good evening.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: I''m from FEMA. We''re making house calls around your neighborhood, checking in with the residents.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: Are you alone?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: Why should I trust you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: No, of course not.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: My squad split up into a few smaller groups so we could cover more ground.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: This shouldn''t take much of your time.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: Why are you in protective gear? Should we be wearing that too?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: How are you going to help us?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: I can show you my credentials, if it will put you at ease.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: Anyway, Visitors rarely move in groups. Maybe even never.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: Why are you in protective gear? Should we be wearing that too?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: How are you going to help us?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: No. But you could buy some if it would help make you feel safer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: We''re still in the process of studying the sun''s effect on the environment.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: It''s important for us to be careful since we''re spending so much time outside.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: So what happens next?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: Does FEMA have a plan of action?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: Our first order of business is collecting more data to send to FEMA HQ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Once we do, they''ll be able to develop a suitable response procedure.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: Right now, you just need to stay calm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: So what happens next?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: Does FEMA have a plan of action?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: I''ll take one person.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: We''ll run tests to make sure they''re okay and determine if it''s safe for them to continue living in the area.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: And we''ll verify that they''re human, too, of course.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: Do I need to pack?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: So should I just wait here for something to happen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Of course. But we can''t action our plans without proof.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: So, we''ll take one of the people staying here back to our laboratory.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: We''ll have them complete a few tests so we can make sure everything''s above board, then we''ll send them back.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: Do I need to pack?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: So should I just wait here for something to happen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: Is this your house?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: Then no. Stay with the other residents. If you need to evacuate, we''ll let you know.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: We''ll just take one person and be on our way.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: Have a good night.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Yes. Once we have more information, we''ll provide instructions to all citizens.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: You have no reason to worry at the moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: We''ll just take one person and try to get them back to you as soon as possible.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Take care.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: So, we meet again.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: I remember things were a bit different last time we crossed paths. Yet we remain alive...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Hm... It''s a strange thing—I don''t know how to explain it.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: I''d like to start our conversation...with a divination.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: Tell my fortune by choosing a page in this book. Where should I open to?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Somewhere towards the beginning
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Just open it right in the middle
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Open at the end
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: "The dead soon shall speak, but none will heed their words."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Goodness me...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: How shockingly relevant.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Though I suppose it''s not much of a surprise to hear that now.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: What does it mean?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: Do you really believe that?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: Who are you?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: "Me? I am I. You? You were home."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Hm. Yes. A tragic story, indeed.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: Is this what awaits us?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: It''s quite possible.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: What does it mean?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: Do you really believe that?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: "It was so long ago. Perhaps it was a dream. Maybe you, I, and the fish...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ...only exist in the memory of a person who is long gone.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Maybe no one really exists, and it''s only raining outside."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Hm... It feels like things might truly fade away so very, very soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: What do you think? Do we inhabit the dream of another? Or are we the one who dreams?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: It''s an interesting line.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: What does it mean?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: Do you really believe that?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: I need to think it through carefully. Do you have any insights to offer?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: Anyway, I only came here to tell you something.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Events will soon begin to unfold...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: You need to be ready.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: It may sound strange...but the cat must enter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: I cannot yet explain how, yet I am certain it will help you.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: You can choose what you do with this information, of course.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: As for me, I think I''ll go have a ponder on the deeper meaning of your divination.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: Not entirely.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: I''d read it more as a form of advice. Lest you forget a deed undone, or perhaps a call to attention.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: While I was considering its deeper meaning, a message flashed into my mind.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: When the cat''s eyes meet yours, be sure to show them inside.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: I can''t say why just yet. But that should make things easier for you.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: For now, I''m going to have a nice, long ponder about the selection you chose from the book.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Hello there, human.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: How lucky we are to witness the humanity''s final judgement with our own eyes!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: The Earth is being cleansed of SIN. The Sun is doing its holy work.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: We are on the path to a pure, new world!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: BEHOLD THE FUCKING BEAMS OF BLESSING!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: What?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: You're scaring me, man
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: Are you still confused, HUMAN?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Here—I''ll break it down for you in simple terms.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: The sun does not burn and BROIL US ALIVE without purpose! It is cleansing us of our sins!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: Our lust and greed has polluted this world, and it has ANGERED THE SUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: THIS IS OUR RECKONING!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: And it is a blessing. All sin will end, and we shall live as righteous fucking ashes under its gaze!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: So... We have to die?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: What'll happen to you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: You''re SCARED? Have you gone shadow mad?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Here—I''ll break it down for you in simple terms.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: The sun does not burn and BROIL US ALIVE without purpose! It is cleansing us of our sins!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: Our lust and greed has polluted this world, and it has ANGERED THE SUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: THIS IS OUR RECKONING!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: And it is a blessing. All sin will end, and we shall live as righteous fucking ashes under its gaze!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: So... We have to die?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: What'll happen to you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: Quite the contrary!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Our sins will be purged. The Sun itself may even cease to be. BUT WE SHALL LIVE.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: There will be no more death, no theft, no greedy FUCKS who refuse to sell me what I want for a fair price.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: Can you imagine it? Do you see now why all of this is happening?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: What does this have to do with me?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: We shall all LIVE DELICIOUSLY as soon as the Sun completes its salvation!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: Its holy rays will help us escape this torment, don''t you see?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: You definitely see—that''s why you''re still alive!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: VERY GOOD, HUMAN! We can keep discussing this in-depth!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Oh, I before I forget to ask—you got any beer?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: Were you just feigning ignorance about the Sun?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: Well, then fuck you! I''LL GO SAVE SOMEONE ELSE!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: See ya, shithead! GOOD-FUCKIN''-BYE!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: H-Hello!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Sorry to bother you so late... It was just so hot out today, and the TV said we shouldn''t go out in the sun, so...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Could you maybe... Um, find some space for me?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: How'd you end up here?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Umm, I lived out near the city.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: The asphalt over there''s heating up pretty bad, as you can imagine, heh. Heh heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: I actually worked the register at a local store. At one point, I mean. I don''t anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: They, um...fired me. I''ve always had bad luck with work...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: What will you do now?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: What do you think will happen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: It''s not like I wanted to come out here. The asphalt may be melting into goo under our feet, but it could be worse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: It''s just...well, you''re gonna laugh, heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: Visitors came to my house. Heh... Can you believe it?! They chased me out of my own home!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: So now I''m just trying to find a place to hide from the sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: What will you do now?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: What do you think will happen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Ummm... Try to survive somehow? It''s freaky out here, with these Visitors everywhere and the sun roasting everything.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: But I''d really like to live. Heh heh. Ughhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: Aren''t you scared?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Tell me it''ll all be over soon, please...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: I... I don''t know.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: Will I survive? Who will help me? How much time do I have to look for help?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: I have no idea what''s gonna happen. Like, I couldn''t even guess.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: Doesn''t all of this scare you? I-It terrifies me.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Thank you. Haha! Thanks so much—seriously!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Now I get to live a little longer, thank god.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Haha, ummm... okay, I get it...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Thanks for hearing me out anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: Um, okay...clearly I should go, then.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: Bye? Yeah, um, bye.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: Can I come in?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: I was taking shelter at a bar down the road, but...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: They kicked me out. Just like that.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: Why? Hmph. I guess not everyone there found my personality particularly...palatable.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: But I don''t mean anyone any harm, don''t worry. I just... Life is shitty sometimes, you know?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: So what do you say, my good man? Can I come in?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: You're not a Visitor, are you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: You sure you won't make any trouble?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: Do I look like one of those monsters?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: No, I''m not a Visitor. And you''re never going to get a straight fucking answer asking that directly anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: I guess things here won''t be any different from the bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: Why did they kick you out of your previous shelter?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: Why do you think it'll be any different here?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: What do you consider trouble?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: Murder and violence disgust me to my core. But I won''t suffer the trespasses of others either.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: I like good food and drink. I enjoy a chat when I''m in the mood. Does that sound like "trouble" to you?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: Why did they kick you out of your previous shelter?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: Why do you think it'll be any different here?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: I considered saying something rude just now, but thought better of it.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: I told you already: someone there didn''t like me. God knows who it was.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Now that I think about it, maybe it''s a good thing they tossed me out.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: They could have eaten me alive back there and no one would have fucking noticed.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: What else would I do otherwise? Just stand outside and wait for the sun to take my skin?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: No, I think I''d prefer to avoid that.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: As long as I''m alive, I''ll look for someone to talk to. If that isn''t here, maybe I''ll get lucky somewhere else.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: And if I have an ounce of luck left in this life, it might just be someone who''s not a complete asshole.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Thank you. Trust in people doesn''t amount to a hill of beans these days.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: But I appreciate your trust in me. Perhaps I even— Well, no, I shouldn''t promise anything.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Hm. Understood.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: I understand your reasoning, but it still pisses me off. You''re just as cowardly as everyone else in this town.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Sleep well, my good man. And fuck you.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: Can I come in and rest a minute?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: Where did you come from?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: Where will you go after?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: I don''t remember. It doesn''t really matter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: I''m so very tired. If I don''t get some rest, I might just pass out under your window there.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: Is your friend sick?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: Does your friend need help?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: I... I''ll probably just collapse somewhere and never get back up again.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: I don''t care where I end up.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: Is your friend sick?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: Does your friend need help?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: He''s my husband.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: He''s dead.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: I can''t give him a proper burial. There''s no point in letting him go now.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Not anymore. When he did need it, no one did anything.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: Now he''s dead.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: He might have lived if...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: If anybody gave a shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: I won''t be staying long.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: I just need to rest a bit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: You...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: Yoooooo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: You been seein'' all the shit goin'' on? Fuckin'' crazy!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: You holdin'' up okay in there, bro?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: What do you want?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: What's been going on, exactly?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Nothin'' really. I''m just curious, y''know.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: But hey—I''ve got a dope-ass way for you to rake in some easy cash. Wanna hear it?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Since everyone else''s busy bein'' pussies about the sun, you can make fat stacks without liftin'' a finger.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: All these chumps are shittin'' their pants when they should be honin'' their grindset!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: Why are you here?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: Let's hear it
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: I''m here to offer you new possibilities, bro. Respect the vision!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Everyone''s runnin'' around like chicken-ass bitches instead of doin'' what comes pure and natural.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: They all just need to be happy, is what I''m sayin''. F''real!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: Why are you here?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: Let's hear it
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: Right down to business! I like that! I like that!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Everyone thinks you''re up to somethin'' in here, bringin'' in all these people. Stirrin'' some shit up.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: So I say let''s roll with that—and host the party to end all parties! End of the fucking worldapalooza, bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: Dying ain''t part of the plan, bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: You gotta hustle while you have the opportunity. Fuck the sun!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: Time to rise and grind! You feel me?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: Fuck yeah, my dude! That''s what I''m talkin'' about!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Finally, someone with half a brain.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: Oh, I see—you''re a fucking moron. I didn''t realize that at first, my bad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: I''ll just go see if your neighbor''s more receptive to my genius.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: See you in hell, shrimpdick.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Hey, neighbor. Long time no see. How''s life?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: Same as it ever was
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Fine
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: So let me level with you: I came over for a reason. I''ve been getting a little worried about you.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Something real bad seems to be headed our way.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: I just got off the phone with my cousin. She told me the news is saying something weird is going on with the sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: And that there''re people coming up from underground. They''re calling them "Visitors" for whatever reason.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: Creepy stuff, huh? I sure hope it''s not true...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: What's happening with the sun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: So let me level with you: I came over for a reason. I''ve been getting a little worried about you.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Something real bad seems to be headed our way.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: I just got off the phone with my cousin. She told me the news is saying something weird is going on with the sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: It also said there''re people coming up from underground. They''re calling them "Visitors" for whatever reason.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: Creepy stuff, huh? I sure hope it''s not true.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: What's happening with the sun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Either it''s gonna explode or something''s gonna explode on it... Not totally sure.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: All I know is something''s wrong with it.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: I''m sure you noticed this summer''s been the hottest one ever, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: I think we need to prepare ourselves for the worst.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: My cousin told me that being home alone is dangerous.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: So I came over to make sure you don''t end up hurt—or worse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: Okay
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: I can look after myself
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: How are your wife and daughter holding up?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Yeah. That''s what they''re calling the people from underground.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: God knows why they''re calling them that.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: I guess it''s because they''re visitors to Earth? Or the surface, at least.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: Or maybe it''s because they''re going around trying to get into people''s houses.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: My cousin told me that being home alone is dangerous.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: So I came over to make sure you don''t end up hurt—or worse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: Okay
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: I can look after myself
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: How are your wife and daughter holding up?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: Great. Let''s continue this conversation in the morning, then.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: I''ll see you in the kitchen when you wake up.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: See you in the morning.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: I''m sure you can. But I''m not sure you understand just how dangerous it is to be alone right now.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: How about I stay with you for just one night, just in case? It''d really help put my mind at ease.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: Don''t worry about my family. A good friend of mine is staying with us right now. He''s looking after them while I''m here.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: Great. Let''s continue this conversation in the morning, then.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: I''ll see you in the kitchen when you wake up.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: See you in the morning.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: Don''t worry about my family. A good friend of mine is staying with us right now. He''s looking after them while I''m here.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: Great. Let''s continue this conversation in the morning, then.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: I''ll see you in the kitchen when you wake up.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: See you in the morning.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: Hi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: Is my daddy here? Can you get him for me?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: I was okay before, but I''m really scared now. There are lots of strange people out here tonight...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: What's your dad's name?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Tell me something about your dad
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: You forgot his name? Oh, wait—you''re just testing to see if I''m a Visitor or not.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: You''re smart! I''ll start asking questions to test people, too.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: How did you get here in one piece?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: Are you afraid of Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Hm, I know a lot about him. He''s my daddy, after all.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: I know that he likes to drink a little beer before he goes out, hehe!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: When he does go out, he always leaves me yummy lunch and dinner. And juice!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: But today I tried some of that beer stuff. Blech! It was so gross!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: Why would anyone drink that when they could just have juice?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: O-Oh, please don''t tell him I did that!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: How did you get here in one piece?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: Are you afraid of Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: I don''t know, everything feels like it''s opposite day now.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: People stay at home and sleep during the day, then go out and do stuff at night.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: I''m still scared of the dark, but maybe there''s nothing to be afraid of.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: ...Or is there?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: I'll get your dad for you. Good luck!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: Have a good day!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: I... I don''t know.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: Everyone''s afraid of them, so maybe I should be too. I''ve never seen one before.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: Are they scary? Do they hit you hard?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: If so, maybe my friend from school is a Visitor. He punches me all the time.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Daddy told me to be careful, so I was suuuper careful!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: I tiptoed over here reeeal quiet. No one saw me.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: I'll get your dad for you. Good luck!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: Have a good day!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: Thanks, you too!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: I wanna go home... It''s scary out here...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: We''re gonna play a new game Daddy made up for me. You have to roll dice!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: And then you move stuff around like the armchair or the couch.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: You have to build a big pile near the door to win. I''ll show you how to play another time.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: Bye!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: H-Hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: L-L-Let me in.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: Are you freaking out?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: What happened?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: I d-don''t know w-what to d-d-do.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: P-P-People...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: U-Um...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: K-K-Killed m-my da...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: M-M-My... m-my...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: D-Daddy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: Who did it?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: Why did they do that?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: U-Um...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: M-M-My d-da...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: Th-They k-k-k...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: Killed m-my d-daddy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: Who did it?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: Why did they do that?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: V-V-Visitors came t-to the house. They were s-sitting w-with us...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Daddy was t-talking to them about s-something. And th-then they...k-killed him.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: He... *hic* Our... *sobs*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: Now our h-house is on f-f-fiiiiiire...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: I d-don''t know.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: They were j-just si-sitting with Daddy in the k-kitchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: And then they d-di... d-did something, and th-then they set the house on f-fire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: When I r-ran away, I could h-hear them l-laughing...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: You''ll h-help m-me?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: I''m s-scared.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: B-But... where w-will I g-go?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: I''m... I''m... s-so s-s-scared!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: Waaaaaaaaah!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: WAAAAAAAAAAAAAAAAAAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: Howdy!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: What do you want?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: I'm not letting you in
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: Spacious house you got yourself here.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: I like it.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: I don't need anything from you
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: I've got a gun
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: Is your door nice and sturdy?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: Never know what might happen to it.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: You understand.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: I don't need anything from you
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: I've got a gun
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: No, you don''t.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Soooooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: You alone?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: No, I'm not alone
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Yes, I'm alone
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: Delicious!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: Despair gives courage to the coward, yes?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Soooooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: You alone?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: No, I'm not alone
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Yes, I'm alone
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: It''s your lucky day.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: I can hear someone whispering inside.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: But who knows where they''ll be in a few days?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: Hahahahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: I know you''re alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: I just wanted to see if you''d lie or not.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: I''ll let myself in.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: Hello there, deary! Walking all the way here really took it out of me let me tell you!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: Might I pop in and rest a minute?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: What? You choose to walk all the way over here specifically?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: How long were you walking?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: No, no, no... I didn''t plan to come here, don''t be silly.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: Yet fate has a habit of bringing us together. No meeting is a mistake, deary.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Since I''m here, that means my feet brought me here for a reason. My eyes landed on your house...with purpose.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: As it was always meant to be...I assume.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: I don't follow. Do you need something?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: You could have just kept walking. Why did you stop here?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: Feh! What really constitutes a "long" walk anyway?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: Take yourself! You''re at home, yet how many steps have you taken here?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: Have YOU been walking for a long time? You must have been, surely.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: But I''ve marched through more decades than you''ve had hot dinners.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: That''s the difference between you and I, deary.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: I don't follow. Do you need something?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: You could have just kept walking. Why did you stop here?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: Feh! What does anyone need, deary.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: A roof over my head, to share a story or two.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: To lie down and close my eyes peacefully.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: And air to breathe, I suppose.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: I don''t need for much. It''s just really boring living all by one''s lonesome, is all.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: Feh! Have you got wigs in those ears, deary?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: I''m tired of walking.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: Here, I''d have a chance to catch my breath and maybe have a nice natter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: That''s enough for an old lady like me.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: You tell me something, and I''ll spin you a yarn in return. Share and share alike.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: Then maybe these old bones can rest a while.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: Thank you, deary!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: I can tell you''ll be a very entertaining host. And maybe I''ll finally find out what''s been going on around here.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: Feh! I''m turned away everywhere I go.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: For my wings are clipped, yet I open my throat to sing.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: But they all turn to me eventually... Even if they say they never will.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Well, I don''t hold grudges. I help everyone who comes to me.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: Even you will find yourself in need some day, deary. Who will you turn to then?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Hello. Oh, here, lean on me for a bit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: Do you...maybe have room for us?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: Is your friend sick?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: Are you both sick? Or just one of you?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: She''s my sister. She''s depressed.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: She can''t walk or bathe on her own. Sometimes, even getting out of bed is a challenge for her.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: But it''s okay. She''ll get better someday. Right, sister?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: She''s not really in the mood to talk right now, but she finds the strength to speak up sometimes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: What are you going to do next?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: Aren't you tired of carrying her around?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: We all suffer from depression to some degree.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: We knew where things were headed even before all this trouble with the sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: Have you been following the news? It''s all been leading up to this. But I don''t think the sun''s gonna actually explode.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: What are you going to do next?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: Aren't you tired of carrying her around?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: I have to find somewhere my sister can feel a little more comfortable.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: Then we''ll create a new life for ourselves.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: They say our lives are over...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: But I disagree. If anything, things should get easier from here on out.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Please mind what you say.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: Yes, it can be draining. But I could never abandon her, if that''s what you mean.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: We both left our parents'' house together. All we have is each other now.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: Thank you! Help me bring her in.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: I think our parents'' deaths worsened her condition, but she''s been like this for a long time now.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Maybe she''ll be able to snap out of it a little while we''re here.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Ouch. Well, sister, I guess we''ll have to try our luck somewhere else.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: Come on, let''s go. Help me out a little here, sis.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: My god, when will this end...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: They gave us this slip of paper at work before we went to put the fires out.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: It''s a mandate telling us to report to a FEMA quarantine zone. But why go if everyone who does ends up dead?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: Here, I don''t need it anyway. You can throw it away or use it for something else.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: I have a *cough* slip of paper with me. It''s some kind of important document.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: I''ll give it to you if you''ll let me in. Let me live my final days in peace...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: Ok, come in
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Nah, you keep it
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: What the hell''s the matter with you? Huh?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: Look, I can see you''re a decent guy. Maybe an EnerJeka might change your mind? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: Pushing myself all the way here tuckered me the fuck out! Now THAT was a workout!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: Ok, come in
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: You''ve earned yourself an EnerJeka! Thanks for letting me in, amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: Fuck... Fucking fuuuuuuck...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: Fine. Look, I''ll fucking...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: How about I give you an EnerJeka. Will you let me in then?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: I get to live and you get a cold refreshing beverage. Everyone''s fucking happy.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: Ok, come in
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: Beat it
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: Don''t worry about me... I''m just... Fuck... Anyway take it...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: Take the EnerJeka.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: I''d be better off calming the fuck down, not drinkin'' this shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: I see that {0} is here. It''s obvious: everyone''s talking in whispers and bending over backwards to spare their feelings.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: But I can''t stand the thought of even being around them. It''s either them or me. One of us has to go.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: I fucking hate living with people who bottle every little thing up inside.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: I'll handle it. Come on in
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: Better leave then
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: You''ve got the patience of a fucking saint.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: I''ll count on you to speak up if things get out of hand.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: I''ll try to... Well, you know. I''ll be cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Great, well isn''t that abso-fucking-lutely fan-fucking-tastic.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: Guess it feels safer to cozy up with fuckers you''ve already got around your fireplace, huh?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: I don''t give a fuck about you, asslicker. YOU CAN ROT IN HELL!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: Here''s a generous reward from the Holy Sun HERSELF: your very own EnerJeka! You deserve it, HUMAN!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: Are you a complete imbecile?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: You''re shooing away a RIGHTEOUS and JUST MAN!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: If you allow me in, you shall receive a generous reward from the HOLY SUN Herself. Reconsider, and be blessed!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: Ok, come in
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: Beat it
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: No one knows what happened after that last Visitor arrived.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: The house was left vacant for quite some time.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: After your terrifying disappearance, the house was left abandoned and avoided like the plague.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Hello there, deary... Who''s that you''ve got inside? Is it that {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: One moment there''s a big kerfuffle, the next a whisper in the shadows. That kind of place frightens an old lady.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: I wander alone for a reason, you see. Rooms filled with shouting or overflowing with faces are no place for me.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Let them stay, if they''re dear to you. I''ll stay put until these winds of change die down. I''m not one for storms, deary.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: These old bones couldn''t take it... I''d crumble into dust.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: I can handle them. Come on in
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: Better leave then
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: If you''re sure... But if I smell a storm coming or the mirror lies again, I''m leaving. I''m too old for such nonsense.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: Feh! I don''t feel like I belong here anyway... I''ll just pack up my tales and move right along.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Keep your ears open, though, deary... The most deadly of truths is often whispered the most quietly.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: Please...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Please let us in, even if only for a day. We have something you might want...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: Yes, we''ll make it up to you...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: Ok, come in
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: Beat it
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: Thank you so much!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Here, take this EnerJeka. It''s all we have.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: Now could you help me bring my sister in?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: Probably not the best idea, seeing as how that {0} is here.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: The air feels heavier than it should be with them around. It''s like their thoughts are louder than my own.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: My sister couldn''t handle that. She''ll just...shrink into herself. It''ll be like she doesn''t even exist.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: I... I also have a hard time dealing with that kind of thing. It gets hard to breathe.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Sorry, but I think we''ll wait until things...calm down in there. Maybe they''ll just go away.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: I can handle them. Come on in
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: Better leave then
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Thank you. Careful, make sure you support her with a hand on her back... Like this.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: I think the death of our parents...broke something in her. Even so, she''s holding up as best she can.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: We''ve been wandering out here for a while. I was hoping she might feel a little better in here at least.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: ...I hear you.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Hold on just a little longer, sis. We''ll find a place for you to rest soon, I promise. Here—lean on me. I''ve got you.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: Sometimes things can feel...overwhelming. Even a simple closed door. But we have to keep moving. C''mon, I''ve got you...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: Well…that''s a shame.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: Thank you very much.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: That {0} is here. I''m not sure we''ll get along.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: Excuse me, sir, but I''m afraid I can''t come in just yet.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: Do we have a deal now?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: Okay. Will this {0} do?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: I''m used to it. And I see where you''re going with this.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: Too bad assholes get all the luck.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: There''s still time. I''ll find another option.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: Well.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: Thanks. Didn''t expect it, but was really hoping for it.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: But you won''t see us in the same room together.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: It''s a long story, and I''m not about to dump it on you. '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: Oh, look, that {0}''s here.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: Would that help settle things?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: Oh, look what I found — it''s {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: Here, let me give you…what do I have here?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: Fine. Last time I fall for this.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: Man, you remind me of those same damn banks. Shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: Alright, I''ll head out then. Still got time till sunrise.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: Welp… Got it.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: Let''s toast to the death of debt, huh? Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: That''s more like it!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: I''ve had enough rotten luck in my life already. Can we at least keep this place clean?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: See that guy over there? The {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: No way. You got someone here who''s gonna ruin the fun.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: I see. I understand. Take care.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: But I really appreciate your trust!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: What?! Thank you! You didn''t have to...I could''ve found another place if I needed to.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: But I''m afraid I won''t feel comfortable sharing space with that {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: I know I''ve already taken up a lot of your time.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: And honestly, I don''t think this one''s on me.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: Thank you so much! But…it seems there''s someone here I had a problem with back at the coffee shop.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: Fine, what if I give you something? Say, this {0}. Will you let me in then?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: Either way, it''s your call. I''ll go then.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: Do you really think people who mock others for their looks deserve a place in your home?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: Thanks. I really don''t want to have to put up with that again.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: That {0} is here. That''s who used to bully me for my looks.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: Sorry, but I don''t think I can come in.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: If you surround yourself with assholes, chances are you''re full of shit. Teehee!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: Maybe it''s for the best I don''t end up with you. Yes...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: Seriously?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: Shouldn''t get mixed up in crrrazy shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: Sounds iffy. But...oh well! Teehee!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: Very good...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: I would know...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: He''s a real crrrrrrazy one.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: I know what went down a month ago. I do indeed.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: Oh...  You''ve got that {0} here.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: Take care out there, yeah? Hope you make it through this shitshow.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: Alright, friend. I get it. No hard feelings.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: Damn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: Awkward, I know…having to boot someone out like that. But that''s life. Sometimes you gotta stop being the nice guy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: Yeah I mean that {0} there. Maybe we should…show them the door?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: Man, I can get along with just about anyone, seriously. But this one''s gonna be tough. Red flags all the way down.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: That''s…disappointing.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: Don''t tell me you don''t have it in you.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: What the hell? I figured you''d respect a bit of backbone.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: Guess they didn''t have much fight in them. Since you tossed ''em out that easily.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: Hm. Didn''t think you''d actually do it.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: Either get rid of them, or I''ll take myself somewhere else.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: Who''s that you''ve got there, that {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: Alright, I''d better get going.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: Damn it… FEMA''s gonna find me.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: I wish I had never come here...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: Damn…where am I supposed to go? I''ve already tried every other house.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: I appreciate it.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: Please, let me stay with you.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: So now I''ve got nowhere else to go.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: I stayed at a hotel for a while, but the money ran out.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: No…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: But I''m here now, and I can''t afford a hotel. Please, let me stay with you.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: Yeah, I got that. Believe me, if I''d known what would happen with the sun, I''d never have come.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: You really have nowhere left to go?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: You picked a hell of a time for sightseeing
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: I''m just passing through, really.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: But then they closed the borders...and now I''m stuck here.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: I was heading to the capital, planning a trip…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: You really have nowhere left to go?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: You picked a hell of a time for sightseeing
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: Airport''s shut down, trains too.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: There''s been a mistake. I can''t get out of the city.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: How'd you even end up here?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: What's the problem?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: Hey. Can you help me? I''m not from around here.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: Alright. I should get moving.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: There are still a few houses around. Maybe someone will look past my face and act like a decent human for once.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: It''s been one brutal week.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: Then let''s talk tomorrow. I''m wiped out for today.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: Perfect.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: The worst part is hearing another report and realizing you''ve got to multiply all the horror by five…maybe even ten. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: TV doesn''t make anything easier anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: Not sure if you''ve got power, but if not — all the better.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: The air cools off at night here. And no one''s glued to the news 24/7.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: I''m gonna skip the formalities and get straight to the point.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: Sure.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: And I''d rather not be in the front row when it starts.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: I think we''re headed for one hell of a shitshow.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: The longer this goes on, the worse it gets. No air, more crime, paranoia''s boiling in those apartment blocks.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: Plus, I''ve got a feeling the cities won''t be safe for long.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: I''m just not a fan of formalities. Makes it easier to get to the point.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: What makes you think I''m running from anything?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: You think it's going to be any better here?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: What are you running from?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: The way I look doesn''t mean anything. I don''t wish anyone harm. And I''d hope you''re not the kind to judge.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: I haven''t done anything wrong. And you can drop the judgmental look, if that''s what''s going on here.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: Hey, why so rude?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: You think it's going to be any better here?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: What are you running from?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: As if the maniacs and Visitors weren''t enough, now the sun''s trying to fuck us over too.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: And not just in our city.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: It''s just... I heard some real bad shit''s going down on the outskirts.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: Nah, I didn''t mean your place looks abandoned.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: You're a bold one
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: Does it look empty?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: Oh, so there is someone here. Mind if I come in?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: Er, I''ll think of something. Still got time till sunrise.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: Fuck.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: No chance at all?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: You have no idea what a big day this is for me!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: That''s what I like to hear! Let''s crack a can or two and celebrate!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: So, you gonna let me in or what?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: If I had a house like that, I''d be living the dream, that''s for sure.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: Whatever. Not your loan to pay, is it? You''ve got a nice place here, after all.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: What can I say? You''re clearly not happy for me. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: Not much of a talker, I see
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: I''m not a fan of that, to be honest.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: Okay, that sounded super sarcastic.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: Not much of a talker, I see
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: No offense.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: To be honest, I''d rather not talk about this out in the open.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: Damn, that''s a good question.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: So, what will you do with all those bucks you've saved?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: And…what are you doing out here?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: Feels amazing!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: With all this chaos going on, no one gives a crap about banks or loans anymore!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: Now I don''t owe a damn thing!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: BUT NOW!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: Everything was going downhill, you know?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: Well, I was neck-deep in debt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: So, what will you do with all those bucks you've saved?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: And…what are you doing out here?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: It''s like I can finally breathe. You''ve got no idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: Buddy… No...Brother! My mortgage ain''t my problem anymore!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: Aw, don''t be like that! You just don''t get it yet.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: Why so cheerful?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: You fucking nuts or what?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: What a night, huh? You feel it? Pure magic!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: Hey hey hey, what''s up!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: Well. I understand. Take care.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: It''s good to know that kind people still exist — and not just in stories.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: Thank you so much! I won''t forget this!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: I never thought adulthood would start out this rough… and I don''t have anywhere else to go...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: I''ll pay you back someday. And I can help right now, in any way I can.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: I know I don''t have much to offer…but please, think it over one more time.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: I see...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: I don't need freeloaders here. Off you trot
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: I doubt I can be our savior. But in every story, good always wins in the end.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: If only a hero would appear to defeat our real evils, so everything could go back to how it was.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: People get scared, hide away, stop trusting one another…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: It all feels a bit like the fairy tales we grew up with. The ones where evil spreads all over the world.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: But I think I''m still the same person I''ve always been. At least I don''t feel any urge to hurt anyone.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: Maybe I fit some of the signs. I don''t know. Everything''s been so strange lately.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: To be honest, I''m still not sure who exactly those Visitors are, or what makes them different from us.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: I don't need freeloaders here. Off you trot
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: I''ll try to be useful till I''m back on my feet. And I promise that someday I''ll return the favor. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: I hate being a burden on anyone. But when things get rough, you do what you can to survive.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: Moved his half-siblings in shortly after. I can''t say I really blame him. But I hope you can see my side, too.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: So after all this started, he kicked me out — said it was due to my lack of employment. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: My landlord didn''t want to rent to a fresh graduate with no steady income in the first place.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: ...Just like when we were children.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: When times get tough, people simply wish to tune it all out for a while…to be carefree for a moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: Guess those who landed gigs at nightclubs got lucky. Seems things actually turned out better for them. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: But after everything that''s happened, people just stopped showing up, and they made us all redundant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: I just finished college, but finding a job in my field''s been tough, so I took some shifts at a little coffee shop. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: How do I know you're not a Visitor?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: What brought you here?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: Good evening. Any chance you''ve got room for one more? I don''t really need much.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: Alright then. Have it your way. I’m off.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: Thanks...for letting me in. And, well, not making a big deal about how I look.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: So, are you gonna let me in or not?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: Because I know what I am. And I''m not one of them.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: So, are you gonna let me in or not?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: Whatever you say.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: What makes you so sure?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: We’ll see about that
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: I’m telling you, I’m not a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: What do you mean, “what did I expect”? Get a grip. You think I chose to look this way?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: What makes you so sure?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: We’ll see about that
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: I get it, but I’m not a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: What did you expect?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: Everyone’s paranoid these days
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: It’s congenital. I can’t do anything about it. But for some reason, people think I’m a Visitor. It’s insane.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: That’s exactly what I mean.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: What did you expect?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: Everyone’s paranoid these days
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: They keep treating me like I''m contagious...or worse, a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: I was just born with bad skin. That’s all.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper:  No! That’s the thing. There''s nothing wrong with me.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: What happened to your skin?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: Should I be worried?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: Hey. Err, hope I don’t look too messed up to get let in.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: Teehee.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: See where that gets you... Mark my words...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: You’re no better than those tortur...s in lab coats.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: A little fucked-up fucky-wuck? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: So…you think I’m crrrrrazy too?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: Somewhere I can wait out this whole mess...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: Finally!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: Besides, I heard shots nearby. But you take safety more seriously. Yesss...?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: Now I try and...click with new people!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: One of them got what he...deserv...d, but I’m more careful now. Teehee!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: Everyone''s got it out for me. Every, single, jerk...ever since school.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: What friends?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: I’d rather go back to the hotel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: Sooooo... I don’t really fancy going back for round two! Teehee!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: They helped me once, but they don''t give a shit!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: I was kind of an accid...nt. Oops-doops and here I am!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: Don't you have any friends?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: Why don't you go to your relatives?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: I’ll tell you all about that...later. Teehee.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: Hotel rooms are teeny-weeny. R...minds me of...bad times.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: Your house is big enough for all shapes and sizes.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: Okay there. Better here. Teehee.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: Don't you have any friends?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: Why don't you go to your relatives?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: FEMA came, and then they went…gone.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: I can’t prove it, no no no... But I think she’s a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: She scares me, teehee.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: There’s a girl in a yellow raincoat there.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: I don''t like it. Rather find anoth...r place.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: You think it'll be better here?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: Why? Can't you just go back?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: I’m scar...d to go back, can I stay here?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: Is this a test?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: Let''s talk sometime.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: You know, I’m honored. To be here, now, when our lives are falling apart.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: Great!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: Life’s about going against the odds. Nothing comes easy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: We only survive when we fight.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: I just think that if we sit and let things happen, humanity’s done for.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: Oh. Sorry if I gave you the wrong impression.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: Mankind has survived worse before. Why should we give up now?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: But I’m definitely not desperate.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: Oh, you want to know why I came here? Hah. Who knows. Maybe I''m crazy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: What?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: You sound like a psycho
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: Are you desperate too?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: We will survive, no matter what it takes.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: I couldn''t just pass by a place like that. I think we see eye to eye, you and me.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: That you don’t let the Visitors take the one thing that’s rightfully yours. ...Life.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: That surviving here is no easy feat.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: You sound like a psycho
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: Are you desperate too?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: But you’re not one of them. You won''t go down without a fight.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: Braver ones put gun to their head. The others just rot, one day at a time.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: Most folks have given up. Too weak to keep living.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: No, really.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: Err...What DO they say about my place?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: Thanks?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: But you have my respect.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: Those who come here are either desperate…or stupid.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: Most people stay the hell away from your place.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: I’ve heard about you.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: Here, I have this {0}. It’s not much, but I hope it helps.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: Thank you so much.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: Oh…sorry, but you have that {0} here. I don’t really trust people like them…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: If you want, I have this {0}. Would that help change your mind?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: I don’t want to run into a patrol. Or worse, the Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: No, please... Let me in.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: Here, I’ve got this {0}. It’s not much, but I hope it helps.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: Thank you so much.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: I don’t want to end up there.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: But I heard they were taking the infected to quarantine zones…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: They turned up one day and said they had to inspect everyone.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: I really don’t want to end up in a quarantine zone.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: They started rounding people up… And I…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: What happened to your dorm?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: I used to live in the collage dorm, but I had to leave…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: Yes. Please… Just let me in, if that’s alright.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: What happened to your dorm?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: The dorm isn’t an option anymore…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: Yeah, somewhere to stay. I’ve got nowhere else to go.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: Looking for shelter?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: Do you need something?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: Hello. Can you let me in, please?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: Smart choice, mate.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: That {0}, yeah? I''ve seen their type.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: Look mate. You got a right nasty bastard in there.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: Adios, sucker.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: Well, you’re a fun one, ain’t ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: Smart choice, mate.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: Anyway, enough jawin’. You gonna let me crash here or what?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: No cash, old lady hitched up with some other clown, and I ain’t got a roof to crawl under.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: Clock hit zero, you get out the gate.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: I’d have stayed, sure. But you think anybody asked me?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: Anyway, enough jawin’. You gonna let me crash here, mate?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: Out in the sticks with no punks snoopin’ around. Solid place.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: Then I peep this spot — clean, quiet, off the map.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: No cash, old lady hitched up with some other clown, and I ain’t got a roof to crawl under.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: Ain’t got nowhere to go, mate.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: Why didn't you stay in jail?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: And what the hell are you doing at my place?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: Guess I''m back on the streets.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: And now? Whole damn world’s gone nuts. Sun’s beatin’ down like it wants my nuts deep fried.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: Would’ve stayed longer, but they booted me out.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: Did a couple stretches inside, mate.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: Why didn't you stay in jail?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: And what the hell are you doing at my place?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: Me, I been around. First thing I did walkin’ out that gate is peel all that junk off. Now I’m breathin’ easy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: Walkin’ ‘round like it’s snowin’ or somethin’. Bunch of clowns.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: Ain’t it obvious? Hotter’n the devil’s asshole out here. No clue why the rest ain’t figured that out.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: Where the hell did you come from?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: Why are you walking around in just underwear?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: Fancy lettin’ me in, mate?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: If not you, someone else will let me in.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: Fuck it.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: Without a guitar, though…it just ain’t the same.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: Alright, rock on!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: Yeah, that {0} — that''s who I mean. Get rid of them, yeah?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: Nah, I wouldn’t go anywhere near that kind of shitbag.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: I’ll try crashing at one of my friends’ places. Hope the few left haven’t kicked the bucket…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: Got you, brother. No hard feelings.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: ...Or not! It''s your call, man!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: Thanks, man. I’ll be cranking some tunes now and then, hope that’s cool. If I can snag a guitar, I’ll play you something.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: And honestly, if I were a Visitor I''d be kicking the door in or crawling through a window. Instead I''m just...here. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: They even busted my guitar, those motherfuckers. All this bullshit''s turning people into animals, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: Played a set till dawn, then some wackos rolled up on our spot and started stealing shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: Because I haven''t.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: Heard they found a Visitor nearby. So now they’re checking everyone. Cool by me, as long as nobody freaks out.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: Nothing sketchy. Just a mini amp and a couple bottles of water. I’ll let you run the amp if you can actually shred. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: Why do you look like you haven't slept in a week?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: What do you have on you?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: Shit''s a total mess right now — like hosting a A-lister in a dive bar with no crowd control!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: Ah, freeloader.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: Let me crash here a couple nights. I won''t hang around forever. I''m not some... Uh... What was the word? '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: Hey, man, open up. The sun’s beating down like a spotlight. I’m gonna go blind at this rate.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: I might try to join. Sounds interesting.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: And then he throws ''em on a fire!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: Heard stories about some freak gathering folks up, brainwashing them.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: Fine, I’ll check out what’s going on somewhere else.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: Boring. Always the same...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: Alright, see you.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: Kinda wonder how much he made off that bullshit.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: Heard there’s a guy selling air. What a riot!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: No problem, I’ll swing by some other places.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: Oh well, I’ll tell you all sorts of stuff instead!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: Sorry, I thought it''d be mad funny.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: Hahaha, I don’t even know who that was.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: Make a whole mess. Nah, let’s skip that.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: I don’t like to talk around people like that. They twist every story into something else'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: Whoa, you’ve got that {0} in here.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: Here, it''s {0}. Want it?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: Or…hang on.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: Want an Enerjeka? Though I’ve got more than just that!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: Bummer. Wait, I’ve got all kinds of stuff with me.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: I’ll chip in, I''ve got stories of my own. We’ll chat.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: So, you''re gonna tell me what''s going on around here, deal?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: Oh, sweet!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: Anyway, I’m getting tired of standing on your doorstep. If you let me in, I’ll tell you what I''ve seen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: Not the smartest of strategies, honestly.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: People panic, they either don’t open up or shoot at everything that moves.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: Seen a few interesting spots, but mostly it’s just the same thing over and over.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: I already told you. I’m just observing the way people survive.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: You’re not listening.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: Will you let me in?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: But your place seems interesting, I think.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: I’ll keep running until I find what I''m looking for...whatever that is.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: Then I run.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: Are you running from someone?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: And then what?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: We should trade survival hacks, heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: But hey, I’m not dead either! Looks like we both figured something out.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: Well, yeah, you’re alive. Talking to me...true.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: And you’re stuck at here. You think that''s what’s keeping you safe?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: Are you running from something?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: And then what?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: Screw that.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: Alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: I’d just die.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: If I’d stayed in my apartment, I’d never have found out.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: Who knows, maybe you’ve got humanity’s last hope stashed somewhere in your house?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: The further I go, the more chance I have of finding a solution. You don’t get it, huh?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: What do you mean?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: You can't outrun trouble
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: Not going to try to get to safety?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: I move at night. So yeah, I’ll be inside before the sun cooks me.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: Got enough to last, like, a LOT. Don’t even ask where I stash it.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: I’ve got my trusty Enerjeka with me.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: You can't outrun trouble
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: Not going to try to get to safety?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: I’ll keep moving until I fry. Or till the Visitors gobble me up. Whichever comes first.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: A storm is coming. And I''m kinda curious to see how people''ll face it.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: Somewhere far away. Can’t stay in one place.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: I don't have any chargers here
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: Where are you headed, charged up like that?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: I’m so wired, right now. But Enerjeka just ain’t hitting like it used to. Could use a recharge.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: Oh, hey! Somebody’s here. Nice!'
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (Accept the delivery)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (Accept the delivery)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (Accept the delivery)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (Accept the delivery)
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Skip intro
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: If you are unable to immediately transfer a suspected Visitor to a quarantine zone, issue them a Mandatory Appearance Slip.'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Seems like the Festival''s still coming after all...'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: Oh, my dear boy... This is not good...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: Alright then. Goodbye.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Must be hard. For you. For us. How do we check a district when there''s nobody living in it?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: So you''re alone?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: Kids these days...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Feh... I''m just wasting precious time with you young''uns...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Greetings, my boy. Did you forget about me, hm? Didn''t notice the hints tucked away in the Book of Smiles?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: Behold... {0}. Let me in, and I shall bestow upon you this generous reward straight from the HOLY SUN itself!'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: Here''s a generous reward from the HOLY SUN itself! You''ve earned it, HUMAN!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: And you and I...we''ll meet again.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: But I won''t die. Never.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: Leaving people on death''s doorstep isn''t right.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: Then here''s one thing you need to learn:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Because you and I...we''re immortal.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: People like you are the ones who''ll make it through this nightmare.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: There aren''t many people left today who actually hear folks out.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: ...Thanks.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: I know exactly where the Visitors came from.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: Hell, I''ll even tell you everything.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: I swear, as soon as FEMA leaves the area, I''ll move on and keep looking for my daughter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: Certain things the government wouldn''t want anyone else finding out.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: FEMA is looking for me because I know things...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: I need shelter for a few days.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: Wait, hold up!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: I know exactly where the Visitors came from.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: Hell, I''ll even tell you everything.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: Then I''ll move on and keep looking for my daughter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: Just let me crash here for a couple days until FEMA leaves the area.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: If they did, they won''t touch her. It''s me they want.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: Maybe those bastards took my daughter, maybe not.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: See, they''re kind of looking for me because I know too much about them.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: Far away from here, basically.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: Somewhere FEMA can''t reach us.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: She's not here. Bye
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: Where do you want to go?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: The second I find her, we''re leaving this place.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: I have no clue where she is.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: I''ve been searching for her since this whole mess began.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: Better not talk like that about my daughter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: She's not here. Bye
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: Where do you want to go?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: No note, no trace. My daughter had just vanished.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: When I woke up, no one was home.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Then that abnormal heatwave hit, I passed out and...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: We were supposed to leave this place...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: I haven''t been able to find her since all this shit started.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: ...She''s my daughter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: If you're looking for the brothel, that's up the street
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: We don't have anyone like that in here
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: Has a girl in a poncho with purple hair been by here?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Hey.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: This house is wrong.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Sorry.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: Wrong smell. Wrong voice.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: This house is wrong.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Sorry.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: Wrong smell. Wrong voice.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: Need help finding your home?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: What are you looking for?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Are they something we need?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: Don''t have any. Never did.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: Parents?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: Need help finding your home?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: What are you looking for?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: I heard the floorboards creaking from outside. That means someone''s waiting.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: I needed the kitchen light, but...there''s a different echo resounding here.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: The doors all look the same in the dark.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: Where are your parents?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: Are you lost?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: He should be...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: He''s not asleep?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Watch over my people. And remember, if one of them dies... your house will be reduced to nothing.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: See you later. I’ll come to check on them.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: Do you think you have a choice?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: See you later. I’ll come to check on them.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: They shalt not need much time. But still, watch over them.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Thank you.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: They obstruct our purpose and that cannot be.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: As it should be. Yet I must ask you to rid yourself of some...inhabitants...you shelter here:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: Have a good night...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: Here you go: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Accept the delivery)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: Alright, take your order, I''m gone.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: I''m sick of all this shit. I just want it to be over...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: This whole mess...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: Plus those endless morning checkups with FEMA staff pointing guns at us...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: I keep seeing tired, grim, bitter faces...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: Remember when I said being a delivery guy helps me take my mind off stuff? Feels like that''s not working anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: Sigh...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Accept the delivery)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Just take your order and let me get out of here before you shoot me too.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: Ah, I see... You''re saying it''s good my friend got killed?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: I'm sorry
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: No other way around it
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: Here you go: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Accept the delivery)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: You know what, just take your damn delivery. I''m out of here.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Well, thanks a lot for the pep talk. You''re a regular fuckin'' fountain of life advice.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Accept the delivery)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Alright, I gotta get a move on. Take your order, and I''ll be on my way.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: Next thing you know, they''ll say pubic hair''s a sign of being a Visitor, and the world''ll go even MORE batshit.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: I thought it couldn''t get worse. But every day, it just gets crazier.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: All these Visitors, the signs, and the damn sun...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: Fine? What''s "fine" even mean in the middle of a cataclysm?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: Just suck it up and you'll survive. Stop whining like a loser
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: Don't stress it. You'll be fine
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: Here you go: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Accept the delivery)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: Alright, I''ve got an order here to deliver to you. Ready to take it?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: Besides, what''s the point of studying if no one''s gonna hire me anyway?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Whatever. Being a delivery guy isn''t that bad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: Yeah, sure. You''re surrounded by other people in your house, so that''s easy for you to say.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: That's too bad
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Being alone isn't that bad
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: Besides, my family''s far away. I''m not from around here, I only came to study at the local university. I''m on my own...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: Here you go: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Accept the delivery)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: Anyway, sorry, I got sidetracked. Ready to accept this delivery?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: Now people order 20 liters of water at a time. I wish we got hazard pay or tips for lugging that heavy stuff around...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: But this damn sun... They moved us to night shifts because of it.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: Deliveries might pay pretty well right now. But the risk is huge, no matter how you slice it.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Apocalypse or not, guess folks still gotta eat lunch!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: Y''know, I didn''t expect people to skip stocking up before the end of the world.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: {0}? How''s that?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: What''ll it take to get me in?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: Oh for cryin'' out loud! Maybe I can give you something?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: Ah! Here we go! {0}. Take it, fella. Just lemme crash here till mornin''.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Alright, a knife, gonna need that... Bandages, sure... Hmm, an old flask—empty, mind. Ain''t much help...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Hey, don''t kick me out, man... Lemme see what I got here in my bag first.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: Power''s the name of the game now, sunshine. You can either roll with it, or let it roll over you.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: Smart choice.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: I'll handle it. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: Send ''em packing if you want to keep this place proper, sunshine.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: Got that {0} stinking up the gaff, ''ave ya? I can tell their type a mile off. Wolf in sheep''s clothing.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: {0}. Here, take it. It might come in handy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: My younger sister...she''s just having a really hard time. But...we''ve got a...what was it called again?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Hmm... I get it, you don''t know us. You might think we''ll just cause trouble. But I promise we won''t.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: They remind me a lot of our...parents... And that isn''t the best environment for her, given her condition.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: That''s worrying... My sister will only suffer while they''re here.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: I see you already have both that {0} and {1} in your house.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: I don't think we'll get along.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: You know, before I met my husband, I... Well, let's just say they remind me a lot of someone I use to know.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: It's going to be hard for me, living under the same roof as them...
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: You've got that {0} here...
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: That''s the last thing she needs right now. She needs peace, not judgement.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: I can already tell how their...way of speaking...is going to affect my sister.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: I''m afraid you''ve already got that {0} inside.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Bless your heart! Would''ve been nothin'' but a heap o'' trouble otherwise.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: Throw ''em out, honey. I''ll go plop myself right over where they''re sat!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Nah, that no-good bonehead won''t help y''all out with nothin''.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: Well, well...lookee who we done got here. That that {0}? Fancy that!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Thanks, I won''t stay long... I just need a moment to catch my breath...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: I'll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: I won''t stay in the same house as someone like him.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: No.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: ...Is that {0} in there?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Thank you for helping. Unlike...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: Does that interest you?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: I''ve got {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: It''s fine! But, maybe there''s something I can offer you. Is there something you want?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: So, what do you say? Will you help us?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: How about {0}? I''m willing to give you everything I have left if it means my darling can get a moment''s rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: We''ve got something, it''s not my shirt but...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: Speaking of that...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: I love her dearly. I''d give you the shirt off my back if it could buy her safety.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: My wife is very weak these days. She tires quickly. And I... I''d do anything for her, you understand?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Please, friend... Forgive my insistence, but try to put yourself in my shoes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: My legs are all the proof you need! See! Nothing there, right? Hah!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: It''ll work for sure!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: Not letting me in? We''ll fix that! Grab this {0}, swing it at the door, and—bam! You''re invisible.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: Check it: {0}! Bam! It''s like in the games, dude. Gotta build up, like, pal points, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: Aight, so check this. I got a lil somethin'' somethin'' here you might want.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: C''mon, bro...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: I think it''s {0}. You can take it. I need at least a day to catch my breath. But... I''m not sure it''ll ever happen...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: I... I had something on me. Wait, please...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: What do you think? Ha! Does that sweeten the pot?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Here''s a little, ahem, something... from me. {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: Ah, yes... I know what''ll do the trick, yes I do.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: I also have some...gum? I only have a few pieces left, but they''re yours if you want ''em.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: Maybe you want something from me? How about {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: I... I don''t even know what to do...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: Please... I''m gonna die out here!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: C''mon, man... I''m ready to give you everything I''ve got. Here, how about {0}? I''ve got nothing else on me.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Right now, damn it, I''m either bleeding out on your doorstep... Or you let me in and help patch me up.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: You know what? Fuck you. I''ll get one of your neighbors to let me in. Later, shithead.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: Hell''s your problem, mister? I''m bearing my soul here, and you''re just gonna shit all over it?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: Do you have a death wish? My hubby works in FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: I don't take bribes
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: Fine, come in
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: Quarantine slips, dogs... And they''ll be back every day. Now does it really sound so bad to let me in?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: Not interested? One word to my hubby, and the boys in yellow will be here come morning for an unscheduled sweep.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: Let''s keep it simple: I give you {0} upfront, and you let me in. Deal?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Listen, my nose is sharp as hell. I can sniff out shady folks and Visitors like nobody''s business.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: I just hope I can finally get some sleep...
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: I’ll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: I’ve saw them once in my dreams, and trust me, that was enough.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: There's no room for both of us.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: I would but... looks like someone’s already taken my spot. Look, that {0} over there.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Bye.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: I don’t even know why I’m still wearing it.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Guess this suit’s kinda scary.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: Alright, I get it.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: Didn’t think you’d actually let me in.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: Really?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: I’ll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: If you could move them out, I swear I''ll sit nice and quiet. I won''t bother anyone.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Look. I’ve been stuck in this damn suit all day… just wanna take it off, wash off all the grime and… blood.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: O-Oh… I see there’s already that {0} in the bathroom.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: I mean, wait a minute.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: What? Ah, thanks.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: Ah, thanks!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: I’ll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: I would come in, really... But, well, you get it...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Ah, you already got that {0} in there.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: Eh… was worth a shot, I guess.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: Damn, figured I could take a breather for once.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: Heh. Now we’re talkin’.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: You should leave
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: I’ll kick them out. Come in
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
