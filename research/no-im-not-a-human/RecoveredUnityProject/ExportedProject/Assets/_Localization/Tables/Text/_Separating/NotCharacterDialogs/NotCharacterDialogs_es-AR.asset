%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NotCharacterDialogs_es-AR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: es-AR
  m_SharedData: {fileID: 11400000, guid: e5ff4525f54b4b14096a51f9eb9cf8ce, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21953783779328
    m_Localized: 'TV: ¡Noticia de última hora!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556544
    m_Localized: 'TV: A las 6:28 de la mañana del día de hoy, se registró una intensa emisión de energía proveniente del sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556545
    m_Localized: 'TV: Esta explosión fue mucho más grande de lo que los científicos habían previsto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556546
    m_Localized: 'TV: Como resultado, la temperatura exterior alcanzó niveles críticos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556547
    m_Localized: 'TV: Debido a esto el gobierno declaró estado de emergencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556548
    m_Localized: 'TV: Pedimos a toda la población que se abstenga de salir de sus casas durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556549
    m_Localized: 'TV: Y ahora, vamos a—'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556550
    m_Localized: 'TV: Un momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556551
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556552
    m_Localized: 'TV: Nuestro estudio acaba de recibir una transmisión urgente relacionada al fenómeno de las criaturas que hemos denominado "Visitantes".'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556553
    m_Localized: 'TV: Los testigos los describen como criaturas que pueden imitar la apariencia física y el comportamiento humano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556554
    m_Localized: 'TV: Por favor, eviten el contacto con estas criaturas a toda costa. Recientemente, se descubrió un rasgo para identificar a estos Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556555
    m_Localized: 'TV: Dientes blancos perfectos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556556
    m_Localized: 'TV: Esto se puede corroborar gracias a reportes anteriores.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556557
    m_Localized: 'TV: Nuestras fuentes afirman que, tras encontrarse con un indigente con dientes blancos y perfectos, el sujeto resultó ser un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556558
    m_Localized: 'TV: Eso es todo por ahora. Mantengan la calma y no salgan de casa durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556559
    m_Localized: 'TV: A continuación: un programa de entretenimiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556560
    m_Localized: 'TV: Buenas tardes. Este es el pronóstico del tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556561
    m_Localized: 'TV: Un frente cálido se aproxima y traerá un calor que excederá la temperatura máxima registrada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556562
    m_Localized: 'TV: Los meteorólogos nos dicen que podemos esperar temperaturas aún más altas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556563
    m_Localized: 'TV: Con la creciente actividad solar, también podemos esperar rayos UV más fuertes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556564
    m_Localized: 'TV: Por su seguridad, por favor, eviten tomar el sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556565
    m_Localized: 'TV: Las altas temperaturas podrían provocar insolación.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556566
    m_Localized: 'TV: No se sabe con certeza si exponerse al sol puede afectar negativamente nuestra salud...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556567
    m_Localized: 'TV: Pero para prevenir quemaduras de tercer grado, eviten salir de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556568
    m_Localized: 'TV: Lamentablemente, el bloqueador solar no servirá para protegerlos en esta situación.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556569
    m_Localized: 'TV: Eso es todo por ahora. A continuación, Bailando con los Cisnes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556570
    m_Localized: 'TV: Ves bailarinas danzando con gracia. Cruzan el escenario con saltos poderosos, pero delicados.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556571
    m_Localized: 'TV: A pesar de la elegancia del baile, solo te vienen a la mente pensamientos inquietantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556572
    m_Localized: 'TV: Sientes como si intentaran distraerte de los acontecimientos actuales.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556573
    m_Localized: 'TV: Si tan solo alguien pudiera explicar qué está pasando allá afuera...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556574
    m_Localized: 'TV: Buenas tardes. Estas son las noticias del día de hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556575
    m_Localized: 'TV: Mientras la actividad solar no disminuye, el nivel del crimen continúa aumentando.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556576
    m_Localized: 'TV: Según informes recientes, el número de asesinatos durante las últimas noches ha superado las cifras habituales.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556577
    m_Localized: 'TV: Expertos sospechan que esto se relaciona con la ansiedad provocada por el temor a los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556578
    m_Localized: 'TV: Por suerte, también hemos recibido nuevas indicaciones sobre como identificar a estos doppelgangers...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556579
    m_Localized: 'TV: Tierra debajo de las uñas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556580
    m_Localized: 'TV: Según los especialistas, esta señal ayuda a identificar a Visitantes que salieron arrastrándose de debajo de la tierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556581
    m_Localized: 'TV: Eso es todo por ahora. Mantengan la calma y no salgan de casa durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556582
    m_Localized: 'TV: A continuación, un informe sobre un maniático pálido. Pero primero, vamos a un corte comercial.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556583
    m_Localized: 'TV: Comprar víveres solía significar tener que caminar hasta la tienda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556584
    m_Localized: 'TV: Pero con For Rest, puedes recibirlos con solo levantar el teléfono y hacer un pedido.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556585
    m_Localized: 'TV: Llama al XXX-XXX-XXXX y tus compras llegarán a tu puerta en un día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556586
    m_Localized: 'TV: For Rest: Para que disfrutes y te relajes en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556587
    m_Localized: 'TV: Reportes señalan que un maníaco pálido ha aparecido en las calles de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556588
    m_Localized: 'TV: Gracias a varios testimonios la policía determinó que todas las víctimas tenían algo en común: estaban solas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556589
    m_Localized: 'TV: Además, el maniático habla con la víctima antes de asesinarlas violentamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556590
    m_Localized: 'TV: La policía logró crear un retrato del asesino gracias a descripciones de testigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556591
    m_Localized: 'TV: El sospechoso es un hombre de mediana edad muy pálido con pelo negro. Es de complexión delgada y solo lleva pantalones.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556592
    m_Localized: 'TV: Resportes posteriores añadieron que lleva la piel de otra persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556593
    m_Localized: 'TV: Esta información no ha sido confirmada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556594
    m_Localized: 'TV: Si ven a este hombre, no abras la puerta y díganle que no están solos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556595
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556596
    m_Localized: 'TV: Buenas tardes. Estas son las noticias del día de hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556597
    m_Localized: 'TV: El calor anómalo sigue aumentando y la invasión de los Visitantes no da señales de disminuir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750848
    m_Localized: 'TV: Debido a esto el gobierno ha implementado un servicio especial para encarar la situación emergente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750849
    m_Localized: 'TV: La Agencia Federal de Administración de Emergencias, abreviada como AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750850
    m_Localized: 'TV: Los trabajadores de la AFAE pueden identificarse por sus trajes amarillos de materiales peligrosos y máscaras de gas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750851
    m_Localized: 'TV: Aunque comenzaron su trabajo recientemente, la agencia ya descubrió una nueva señal que delata a los Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750852
    m_Localized: 'TV: Ojos rojo sangre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750853
    m_Localized: 'TV: De acuerdo a nuestros datos, la AFAE informó de esta señal tras observar a los Visitantes detenidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750854
    m_Localized: 'TV: Las criaturas tienen fotosensibilidad aumentada, lo que provoca que sus ojos estén rojos e inflamados.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750855
    m_Localized: 'TV: Eso es todo por ahora. Mantengan la calma y no salgan de casa durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750856
    m_Localized: 'TV: A continuación, un reportaje sobre la AFAE. Pero primero, una breve pausa comercial.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750857
    m_Localized: 'TV: Caos, terror y sufrimiento. Y todo por culpa de los Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750858
    m_Localized: 'TV: Pero en estas horas oscuras, cuando nuestras plegarias parecían ignoradas...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750859
    m_Localized: 'TV: ¡LOS TRABAJADORES DE LA AFAE LLEGARON PARA AYUDARNOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750860
    m_Localized: 'TV: Estos valientes héroes de la AFAE nos protegen de la invasión de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750861
    m_Localized: 'TV: Hasta ahora, la agencia ha identificado 27.000 criaturas peligrosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750862
    m_Localized: 'TV: Recuerda: Puedes ayudar a la agencia informando sobre cualquier actividad sospechosa a tu alrededor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750863
    m_Localized: 'TV: Para hacerlo, usen la invitación para visitar la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750864
    m_Localized: 'TV: Y si llega a sospechar que podría ser un Visitante no deseado, llama a nuestra línea directa: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750865
    m_Localized: 'TV: Ayúdanos a ayudarte. Apoya a la AFAE y únete a la lucha contra los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750866
    m_Localized: 'TV: AFAE: ¿Qué es? ¿Y por qué se formó?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750867
    m_Localized: 'TV: La Agencia Federal de Administración de Emergencias es un servicio gubernamental especial creado para aliviar la crisis.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750868
    m_Localized: 'TV: Están ayudando a abordar los problemas causados por la invasión de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750869
    m_Localized: 'TV: No se sabe con certeza en qué está trabajando exactamente la agencia...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750870
    m_Localized: 'TV: Pero podemos decir con confianza que nuestro destino está en manos confiables...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750871
    m_Localized: 'TV: La agencia está compuesta por expertos en varios campos, incluyendo a científicos distinguidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750872
    m_Localized: 'TV: Si un trabajador de la AFAE aparece en tu puerta, te aconsejamos que cooperes con él y sigas sus instrucciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750873
    m_Localized: 'TV: Recuerda: Ayúdanos a ayudarte. Apoya a la AFAE y únete a la lucha contra los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750874
    m_Localized: 'TV: Buenas tardes. Estas son las noticias del día de hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750875
    m_Localized: 'TV: La AFAE ha tomado nuevas medidas para abordar la situación con los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750876
    m_Localized: 'TV: Han organizado zonas de cuarentena para contener a potenciales sospechosos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750877
    m_Localized: 'TV: Después de experimentar con los detenidos, la AFAE encontró una nueva forma de identificar Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750878
    m_Localized: 'TV: Axilas sin vello.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750879
    m_Localized: 'TV: La AFAE ha reportado que los Visitantes no tienen vello visible en las axilas, característica útil para identificarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750880
    m_Localized: 'TV: La agencia pide a los ciudadanos que tengan paciencia con las pruebas y los traslados a las zonas de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750881
    m_Localized: 'TV: Eso es todo por ahora. Mantengan la calma y no salgan de casa durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750882
    m_Localized: 'TV: A continuación, un reportaje sobre qué hacer si te encuentras con un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750883
    m_Localized: 'TV: Según la AFAE, el fenómeno Visitante podría ser contagioso o suponer alguna otra amenaza biológica.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750884
    m_Localized: 'TV: Por esta razón, es importante reportar a cualquier persona sospechosa y aislarla de inmediato.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750885
    m_Localized: 'TV: Si no puedes enviar a un Visitante a una zona de cuarentena de inmediato, dales una petición para presentarse en la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750886
    m_Localized: 'TV: Durante la siguiente ronda, un trabajador llevará a cualquiera que tenga este documento para ser examinado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750887
    m_Localized: 'TV: Eso es todo por ahora. A continuación, una pausa comercial.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750888
    m_Localized: 'TV: ¡Que el calor no te detenga! ¡Siente el impulso!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750889
    m_Localized: 'TV: ¡Con EnerJeka, te sientes vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750890
    m_Localized: 'TV: ¡Increíble! ¿¡Una bebida energizante que calma tu sed de manera más rápida y efectiva que el agua!?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750891
    m_Localized: 'TV: Ya disponible en For Rest delivery. Pídela marcando al: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750892
    m_Localized: 'Window: La casa de tu vecino se alza sola en el campo de heno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750893
    m_Localized: 'Window: No hay luz saliendo de las ventanas. Parece que su familia está dormida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750894
    m_Localized: 'Window: Un perro flaco está parado en el sendero que cruza el campo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750895
    m_Localized: 'Window: Está mirando alrededor con tristeza, tal vez tratando de encontrar algo de comer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750896
    m_Localized: 'Window: Unos cuantos borrachos están tirados en la calle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750897
    m_Localized: 'Window: Aunque están acostados en el suelo frío, parecen estar profundamente dormidos. Se nota que les está yendo bien ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750898
    m_Localized: 'Window: A la distancia se ve la casa de tu vecino, quien te está visitando ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750899
    m_Localized: 'Window: Una luz intensa brilla por la ventana y parece que su familia lo espera para que vuelva a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750900
    m_Localized: 'Window: Ves a unos cuantos adolescentes pasando el rato en el patio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750901
    m_Localized: 'Window: Están sentados despreocupadamente, charlando sobre algo y no te prestan atención.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750902
    m_Localized: 'Window: Hay un silencio de muerte afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750903
    m_Localized: 'Window: No hay nadie ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750904
    m_Localized: 'Window: Incluso los borrachos decidieron no salir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750905
    m_Localized: 'Window: ¿A qué le tendrán todos tanto miedo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750906
    m_Localized: 'Window: Ves a tu vecino y a su hija a través de la ventana.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750907
    m_Localized: 'Window: Están jugando felices, buscando distraerse del horror que los rodea...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750908
    m_Localized: 'Window: Aunque sea por un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750909
    m_Localized: 'Window: Los cadáveres de los adolescentes están tirados en el suelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750910
    m_Localized: 'Window: Alguien los mató.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750911
    m_Localized: 'Window: Parece reciente. La sangre aún no se ha secado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750912
    m_Localized: 'Window: Un hombre tan pálido como la muerte misma está parado afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750913
    m_Localized: 'Window: Tiene extraños pliegues en su piel.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750914
    m_Localized: 'Window: Es como si su piel fuera muy grande para su cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750915
    m_Localized: 'Window: Desde aquí no puedes ver sus ojos, pero sientes su mirada fija en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750916
    m_Localized: 'Window: Sientes miedo y le rezas a Dios para que el aterrador Visitante no fije su atención en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750917
    m_Localized: 'Window: Hay un pequeño grupo de trabajadores de la AFAE junto a la casa de tu vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750918
    m_Localized: 'Window: Te preguntas de qué estarán hablando.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750919
    m_Localized: 'Window: ¿Quizás estén tomando muestras de tierra?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750920
    m_Localized: 'Window: ¿O buscando algún lugar para establecer una base?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750921
    m_Localized: 'Window: En el suelo yacen los restos calcinados de los adolescentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750922
    m_Localized: 'Window: Da la impresión de que llevan todo el día ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750923
    m_Localized: 'Window: Hay dos empleados de la AFAE junto a los cuerpos, anotando algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750924
    m_Localized: 'Window: Menos mal que aparecieron para llevarse los cuerpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750925
    m_Localized: 'Window: Te da asco pensar qué clase de infección podría esparcirse si esos cuerpos en descomposición se dejaran pudrir ahí afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750926
    m_Localized: 'Window: Ves a un grupo de soldados armados a través de la ventana.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750927
    m_Localized: 'Window: Aparentemente, es un pequeño escuadrón enviado desde la ciudad para proteger a los trabajadores de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750928
    m_Localized: 'Window: Escuchas algunos fragmentos de información sobre un hombre pálido con el torso desnudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750929
    m_Localized: 'Window: ¿Quizás quieren rastrear a ese escalofriante Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750930
    m_Localized: 'Window: La casa de tu vecino, recién pintada de blanco, se ha quemado por completo, ahora es más negra que el carbón.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750931
    m_Localized: 'Window: Da la impresión de que el incendio terminó hace apenas un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750932
    m_Localized: 'Window: ¿Será que alguien la incendió a propósito?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750933
    m_Localized: 'Window: ¿Qué le habrá pasado a la familia del vecino?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750934
    m_Localized: 'Window: ¿Quedará alguien vivo todavía?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750935
    m_Localized: 'Window: Las preocupaciones te dan vueltas en la cabeza y te invade una sensación de incomprensión e impotencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750936
    m_Localized: 'Window: El hombre pálido y escalofriante está parado en la calle, sonriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750937
    m_Localized: 'Window: Está sosteniendo la cabeza decapitada de alguien dentro de un casco.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750938
    m_Localized: 'Window: Es la cabeza de un soldado que tiene el rostro congelado en una mueca de terror.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750939
    m_Localized: 'Window: No estás seguro de qué lo asustó más: el Visitante pálido o su muerte inminente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750940
    m_Localized: 'Window: Todo el escuadrón de soldados que estuvo aquí ayer está muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750941
    m_Localized: 'Window: Parece que aquí hubo una masacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750942
    m_Localized: 'Window: Hay cuerpos esparcidos por toda la calle y a uno de ellos le falta la cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750943
    m_Localized: 'Window: ¿Acaso ese extraño pálido y escalofriante los mató a todos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750944
    m_Localized: "\"Hola. Habla con el servicio de emergencias. ¿Cómo puedo ayudarle?\" \n\"Hay gente... quemándose...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750945
    m_Localized: "\"¿Puede describir lo que está viendo? ¿Hay un incendio?\"\n\"N-no. Es el sol. Se... ¡Se están quemando por el sol!\""
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750946
    m_Localized: "\"No salga de casa hasta que oscurezca\".\n\"¡No! ¡No puedo con ese tipo que está por ahí merodeando en las noches! El pálido... N-no es humano\"."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750947
    m_Localized: Y ahora, nuestro nuevo programa, "Sí, Soy Humano".
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750948
    m_Localized: 'Es fácil: Envíe sus fotos y nosotros comprobaremos qué es usted en realidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750949
    m_Localized: 'Envíanos tus fotos a este correo: yesiamhuman@gmail.com, y nosotros nos encargaremos del resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750950
    m_Localized: Pero, por favor, no mande otra cosa que no sean ojos, dientes y uñas. No aceptaremos nada más.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750951
    m_Localized: ¿Sus ojos se han puesto rojos? ¿Sus dientes blancos? ¿Ha aparecido tierra debajo de sus uñas?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750952
    m_Localized: ¡Un espíritu maligno le ha poseído! ¡Usted es un Visitante!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750953
    m_Localized: ¡No deje que esta plaga se apodere de su cuerpo! Llame a nuestros especialistas de inmediato al 777-460.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750954
    m_Localized: Expulsarán el espíritu maligno, limpiarán su cuerpo de esa aura maligna y le proporcionarán una protección reforzada.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750955
    m_Localized: 'Bienvenidos. Es hora de "Quiero Creer": un programa donde revelaremos los misterios y conspiraciones del gobierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750956
    m_Localized: Hoy discutiremos la verdad sobre los Visitantes con un invitado especial, un doctor en ciencias y respetado empleado de...
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750957
    m_Localized: ¡¿Espera, qué?! ¿No vendrá?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750958
    m_Localized: ¿Cómo carajo pudieron robarle todos sus documentos? ¡Tenía DEMASIADA información ahí!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750959
    m_Localized: ¡Maldita sea! Ya sabía yo que no nos iban a dejar revelar la verdad. Hijos de puta...
    m_Metadata:
      m_Items: []
  - m_Id: 17738415503822848
    m_Localized: Había una vez, dos hermanos que vivían cerca de una presa.
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182976
    m_Localized: El chapoteo del agua hacía que la espuma del río les pareciera una soda en un día de verano.
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182977
    m_Localized: Años después, con esa bella imagen en mente, los hermanos ya crecidos, abrieron la cervecería Bober Černý.
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182978
    m_Localized: 'TV: Desde entonces, Bober Černý es una de las bebidas alcohólicas más solicitadas tanto en los bares, como en los hogares de la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182979
    m_Localized: 'Cerveza Bober Černý: Bebe calidad y bebe sin límites.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182980
    m_Localized: 'Window: Contemplas las ruinas de la casa de tu vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182981
    m_Localized: 'Window: Solo queda una cáscara fantasmal, pese a que una familia feliz vivía allí hasta hace poco...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182982
    m_Localized: 'Window: Un sentimiento extraño te invade, como si hubieras sabido que esto iba a suceder...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182983
    m_Localized: 'Window: ...Como si hubieras presentido que la muerte no tardaría en visitar esa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182984
    m_Localized: 'Window: Ves un cráneo humano clavado en una estaca, con un casco aún puesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182985
    m_Localized: 'Window: La calavera tiene la piel quemada, y parece que alguien le arrancó los dientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182986
    m_Localized: 'Window: La cabeza debe llevar ahí todo el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182987
    m_Localized: 'Window: No puedes evitar creer que esta macabra exhibición es una amenaza, probablemente de parte de aquel Visitante pálido.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182988
    m_Localized: 'Window: Los oficiales de la AFAE están inspeccionando el lugar de la reciente masacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182989
    m_Localized: 'Window: Se llevan todo el equipo y las armas de los soldados muertos para que no caigan en manos de los saqueadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182990
    m_Localized: 'Window: Probablemente no esperaban que el Visitante pálido sobreviviera a un encuentro contra soldados armados.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182991
    m_Localized: 'Window: Ahora hay más bolsas para cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576140324864
    m_Localized: 'TV: Buenas tardes. Este es el pronóstico del tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102080
    m_Localized: 'TV: Una ola de calor está asolando a nuestra región, rompiendo records de temperatura nunca antes vistos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102081
    m_Localized: 'TV: Los meteorólogos esperan que la temperatura aumente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102082
    m_Localized: 'TV: Además, el incremento de actividad solar provocará niveles peligrosos de radiación ultravioleta durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102083
    m_Localized: 'TV: Por su seguridad, le recomendamos evitar el sol a toda costa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102084
    m_Localized: 'TV: La exposición prolongada al sol puede provocar insolación.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102085
    m_Localized: 'TV: No se sabe con certeza si estar al sol puede afectar negativamente nuestra salud...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102086
    m_Localized: 'TV: Pero para prevenir quemaduras de tercer grado, eviten salir de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102087
    m_Localized: 'TV: Lamentablemente, el bloqueador solar no sirve en esta situación.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102089
    m_Localized: 'TV: Ves bailarinas danzando con gracia. Cruzan el escenario con saltos poderosos, pero delicados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102090
    m_Localized: 'TV: A pesar de la elegancia, el baile te deja pensamientos inquietantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102091
    m_Localized: 'TV: Sientes como si intentaran distraerte de los acontecimientos actuales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102092
    m_Localized: 'TV: Si tan solo alguien pudiera explicar qué está pasando...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102093
    m_Localized: 'TV: Antes, hacer las compras solía ser complicado y muy tedioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102094
    m_Localized: 'TV: Pero a partir de ahora bastará con que digas: "Hola, me gustaría hacer un pedido".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102095
    m_Localized: 'TV: For Rest, comida a domicilio. Llama al {0} y tu comida llegará la próxima noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102096
    m_Localized: 'TV: For Rest: descansa y disfruta en la comodidad de tu hogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102097
    m_Localized: 'TV: Se reportan avistamientos de un maníaco pálido que ronda las calles de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102098
    m_Localized: 'TV: De acuerdo a reportes de testigos, todas sus víctimas tenían algo en común: estaban solas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102099
    m_Localized: 'TV: Se ha reportado que el sospechoso siempre habla con las víctimas antes de atacar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102100
    m_Localized: 'TV: La policía ha hecho un boceto del sospechoso a partir de los testimonios de los testigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102101
    m_Localized: 'TV: El sospechoso es un hombre de mediana edad, alto, pálido y de pelo negro. Es de complexión muy delgada y solo lleva pantalones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102102
    m_Localized: 'TV: Algunos reportes indican que lleva puesta la piel de otra persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102103
    m_Localized: 'TV: Esta información no ha sido confirmada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102104
    m_Localized: 'TV: Si ven a este hombre, no abran la puerta y díganle que no están solos en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102106
    m_Localized: 'TV: Caos, terror y sufrimiento. Y todo por culpa de los Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102107
    m_Localized: 'TV: Pero en nuestro momento de mayor necesidad, cuando solo había desesperanza...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102108
    m_Localized: 'TV: ¡LA AFAE HA LLEGADO PARA AYUDARNOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102109
    m_Localized: 'TV: Estos valientes héroes de la AFAE nos protegen de la invasión de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102110
    m_Localized: 'TV: Hasta ahora, la agencia ha identificado 27.000 criaturas peligrosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102111
    m_Localized: 'TV: Recuerda: Puedes ayudar a la agencia informando sobre cualquier actividad sospechosa a tu alrededor.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102112
    m_Localized: 'TV: Para hacerlo, usen la invitación de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102113
    m_Localized: 'TV: Si alguna vez sospechas que eres un Visitante, llama al: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102114
    m_Localized: 'TV: Al ayudar a la AFAE ayudas a proteger el planeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102115
    m_Localized: 'TV: AFAE: ¿Qué es? ¿Y por qué se formó?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102116
    m_Localized: 'TV: La Agencia Federal de Administración de Emergencias es un servicio creado recientemente para aliviar la crisis.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102117
    m_Localized: 'TV: Su misión es frenar a los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102118
    m_Localized: 'TV: Los detalles de sus planes son confidenciales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102119
    m_Localized: 'TV: Pero podemos decir con seguridad que nuestro destino está en manos capaces.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102120
    m_Localized: 'TV: La AFAE reune los profesionales más calificados de la nación, incluyendo a científicos de talla mundial.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102121
    m_Localized: 'TV: Si un oficial de la AFAE aparece en su puerta le aconsejamos cooperación total.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102122
    m_Localized: 'TV: Recuerde: apoyando a la AFAE, ayuda a proteger al planera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102123
    m_Localized: 'TV: Según la AFAE, el fenómeno Visitante podría ser contagioso o suponer alguna otra amenaza biológica.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102124
    m_Localized: 'TV: Por esta razón, es importante reportar y aislar a cualquier persona con comportamientos sospechosos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102125
    m_Localized: 'TV: Si no puede trasladar a un posible Visitante a una zona de cuarentena de inmediato, dele una petición para presentarse ante la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102126
    m_Localized: 'TV: Un oficial de la AFAE recogerá al individuo durante la siguiente inspección.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102128
    m_Localized: 'TV: ¡Cuando el calor te estremece...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102129
    m_Localized: 'TV: EnerJeka te fortalece!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102130
    m_Localized: 'TV: Una bebida refrescante que calma tu sed más rápido que el agua.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102131
    m_Localized: 'TV: Ya disponible en For Rest delivery marcando al: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296387
    m_Localized: 'TV: Érase una vez, dos hermanos que vivían cerca de una represa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296388
    m_Localized: 'TV: El chapoteo del agua evocaba imágenes de bebidas frías y espumosas...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296389
    m_Localized: 'TV: Y cuando los dos hermanos crecieron, fundaron Cervecería Bober juntos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296390
    m_Localized: 'TV: La cerveza Bober Černý se ha convertido en una de las cervezas más socilitadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296391
    m_Localized: 'TV: Bober Černý: Bebe en grande. Bebe lo mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296517
    m_Localized: 'Window: La casa de tu vecino se alza en el campo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296518
    m_Localized: 'Window: No hay luz saliendo en ventanas. Parece que su familia está dormida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296519
    m_Localized: 'Window: Unos cuantos borrachos están tirados en la calle.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296520
    m_Localized: 'Window: El frío no les molesta. Al menos por ahora, están en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296521
    m_Localized: 'Window: A la distancia se ve la casa de tu vecino, quien te está visitando ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296522
    m_Localized: 'Window: Las luces están encendidas. Su familia lo espera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296523
    m_Localized: 'Window: Hay un silencio de muerte afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296524
    m_Localized: 'Window: No hay absolutamente nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296525
    m_Localized: 'Window: Incluso los borrachos se quedaron en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296526
    m_Localized: 'Window: ¿A qué le tendrán todos tanto miedo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296527
    m_Localized: 'Window: El vecino y su hija juegan afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296528
    m_Localized: 'Window: Están jugando felices, buscando distraerse del horror que los rodea...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296529
    m_Localized: 'Window: Aunque solo sea por un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296530
    m_Localized: 'Window: Un hombre tan pálido como la muerte misma está parado en la acera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296531
    m_Localized: 'Window: Tiene extraños pliegues en su piel.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296532
    m_Localized: 'Window: Es como si su piel fuera muy grande para su cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296533
    m_Localized: 'Window: Desde aquí no puedes ver sus ojos, pero sientes su mirada fija en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296534
    m_Localized: 'Window: El miedo te recorre por todo el cuerpo. Rezas en silencio para que Dios te cuide de ese Visitante aterrador.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296535
    m_Localized: 'Window: Hay un pequeño grupo de trabajadores de la AFAE junto a la casa de tu vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296536
    m_Localized: 'Window: Te preguntas que estarán haciendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296537
    m_Localized: 'Window: ¿Toman muestras de la tierra?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296538
    m_Localized: 'Window: ¿Buscando algún lugar para establecer una base?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296539
    m_Localized: 'Window: Ves a un grupo de soldados armados a través de la ventana.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296540
    m_Localized: 'Window: Un pequeño escuadrón protege al equipo de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296541
    m_Localized: 'Window: Escuchas fragmentos de su conversacion; algo sobre un hombre pálido sin camisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296542
    m_Localized: 'Window: ¿Será que están cazando al Visitante espeluznante?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296543
    m_Localized: 'Window: La casa de tu vecino, recién pintada de blanco, se ha quemado por completo, ahora está más negra que el carbón.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296544
    m_Localized: 'Window: Parece que el fuego se extinguió hace poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296545
    m_Localized: 'Window: ¿Alguien la incendió a propósito?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296546
    m_Localized: 'Window: ¿Qué le habrá pasado al vecino y a su familia?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296547
    m_Localized: 'Window: ¿Quedará alguien vivo todavía?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296548
    m_Localized: 'Window: Pensamientos inquietantes te vienen a la cabeza. Sientes una mezcla de angustia y confusión.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296549
    m_Localized: 'Window: Todo el escuadrón de soldados que estuvo aquí ayer está muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296550
    m_Localized: 'Window: Una masacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296551
    m_Localized: 'Window: Hay cuerpos regados en la calle. A uno le falta la cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296552
    m_Localized: 'Window: ¿Será que el tipo pálido hizo todo esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296553
    m_Localized: 'Window: Contemplas la silueta espectral de lo que solía ser la casa de tu vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296554
    m_Localized: 'Window: Hace no mucho tiempo, una familia feliz vivió ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296555
    m_Localized: 'Window: Un sentimiento extraño te invade, como si supieras que esto iba a suceder...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296556
    m_Localized: 'Window: Como si hubieses sabido que la muerte iba a visitar esa casa tarde o temprano.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296557
    m_Localized: 'Window: Ves una estaca enterrada en un cráneo. Aún tiene el casco puesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296558
    m_Localized: 'Window: Algo de piel negra cuelga del hueso. Parece que alguien arrancó los dientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296559
    m_Localized: 'Window: La cabeza ha estado ahí todo el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296560
    m_Localized: 'Window: Toda esta macabra exhibición parece una amenaza. Seguramente la dejó ese Visitante siniestro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296561
    m_Localized: 'Window: Los oficiales de la AFAE inspeccionan el lugar de la masacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296562
    m_Localized: 'Window: Recolectan el equipo y las armas de los soldados caídos para evitar que sean llevados por saqueadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296563
    m_Localized: 'Window: Quizás no esperaban que el Visitante sobreviviera a un encuentro con hombres armados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296564
    m_Localized: 'Window: Ahora hay más bolsas para cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296409
    m_Localized: 'TV: El silencio es un presagio de la muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296410
    m_Localized: 'TV: Un silencio que drena el alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296411
    m_Localized: 'TV: Pero si hay algo peor que el vacío... es el pitido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296412
    m_Localized: 'TV: El repicar de las campanas fúnebres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296413
    m_Localized: 'TV: Algo crece en los oídos cuando suenan las campanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296414
    m_Localized: 'TV: Todo lo que queda es cerumen. Pensamientos sucios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296415
    m_Localized: 'TV: De eso se alimentan los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296416
    m_Localized: 'TV: Los Visitantes se enredan en la maraña de pensamientos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296417
    m_Localized: 'TV: Para ellos, las campanas son más ruidosas... por eso, tienen más cerumen.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102088
    m_Localized: 'TV: A continuación: más información del tiempo. Pero antes, un mensaje de nuestros patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102105
    m_Localized: 'TV: Estas fueron las últimas noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102127
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102132
    m_Localized: 'TV: Buenas tardes. Estas son las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102133
    m_Localized: 'TV: Debido a un drástico aumento de personas que muestran señales de ser un Visitante, la AFAE está implementando nuevas medidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102134
    m_Localized: 'TV: A partir de ahora, todas las grandes ciudades serán puestas en cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102135
    m_Localized: 'TV: Se prohíbe de forma estricta cualquier viaje fuera de su ciudad o de las comunidades cercanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102136
    m_Localized: 'TV: Por favor, permanezcan dentro de su área designada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102137
    m_Localized: 'TV: Por otro lado, la AFAE anunció una nueva señal de identificación:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102138
    m_Localized: 'TV: Fotografías de aura.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102139
    m_Localized: 'TV: Si ves manchas oscuras en la imagen, existe una alta posibilidad de que hayas fotografiado a un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102140
    m_Localized: 'TV: Eso es todo por ahora. Mantengan la calma y permanezcan en sus casas durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102141
    m_Localized: 'TV: Y ahora, un mensaje de nuestros patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102142
    m_Localized: 'TV: ¿Qué son los Visitantes? ¿Fantasmas? ¿Criaturas del subsuelo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102143
    m_Localized: 'TV: No, esta no es una novela de ciencia ficción, ni un titular sensacionalista.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102144
    m_Localized: 'TV: Esta es nuestra nueva realidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102145
    m_Localized: 'TV: Los rumores sobre el verdadero origen de los Visitantes no dejan de circular.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102146
    m_Localized: 'TV: ¿Alienígenas? ¿Muertos vivientes? ¿Un experimento de laboratorio que salió mal?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102147
    m_Localized: 'TV: Según las autoridades, estas son solo teorías sin fundamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102148
    m_Localized: 'TV: Estudios muestran que los Visitantes son humanos que se han expuesto a un agente biológico sin identificar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102149
    m_Localized: 'TV: La forma de contagio es desconocida, pero la AFAE pide a todos permanecer atentos a las señales de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102150
    m_Localized: 'TV: Si cree haber estado expuesto, o si sospecha que podría ser un Visitante, comuníquese con la AFAE a través de:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102151
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102152
    m_Localized: 'TV: Eso es todo por ahora. Sigan en sintonía después de estos mensajes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102153
    m_Localized: 'TV: Detectar a un Visitante es cada vez más difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102154
    m_Localized: 'TV: Las señales pueden ser útiles, pero ¿qué tal si quieres un modo completamente seguro?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102155
    m_Localized: 'TV: ¡Este es nuestro nuevo, revolucionario y espectacular rollo de fotos sensible a las auras!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102156
    m_Localized: 'TV: Expone la energía del alma, lo que te permite distinguir a un humano de un Visitante hostil.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102157
    m_Localized: 'TV: Toma una foto y, si aparecen manchas negras, has descubierto a un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102158
    m_Localized: 'TV: Llama ahora para obtener tu kit de principiante gratis: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102159
    m_Localized: 'TV: Última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102160
    m_Localized: 'TV: No se sabe con certeza si estar al sol puede afectar negativamente a nuestra salud...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102161
    m_Localized: 'TV: Los expertos creen que la actividad solar anormalmente alta es la culpable.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102162
    m_Localized: 'TV: Aunque la magnitud total del desastre aún no está clara, se han desplegado brigadas de bomberos para contener los incendios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296384
    m_Localized: 'TV: Eso es todo por ahora. Mantengan la calma y permanezcan en sus casas durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296385
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296386
    m_Localized: 'TV: A continuación: un aviso de nuestros patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296392
    m_Localized: 'TV: Interrumpimos este programa con una alerta de última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296393
    m_Localized: 'TV: Se informa de disturbios civiles en una ciudad vecina.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296394
    m_Localized: 'TV: Debido a situaciones aún no resueltas, las fuerzas de la AFAE han acordonado la zona.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296395
    m_Localized: 'TV: Por favor, permanezcan en sus hogares.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296396
    m_Localized: 'TV: Quédense donde están y esperen indicaciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296397
    m_Localized: 'TV: Y recuerden... apoyen a la AFAE y únanse a la lucha contra los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296398
    m_Localized: 'TV: Eso es todo por los momentos. Ahora algunos anuncios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296399
    m_Localized: 'TV: Incluso los más trabajadores necesitan un descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296400
    m_Localized: 'TV: Con los cigarrillos Margoro, puedes tomar un respiro profundo y relajarte de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296401
    m_Localized: 'TV: Margoro. Cigarrillos para hombres de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296402
    m_Localized: 'TV: (Advertencia: la compañía no se hace responsable por ningún daño a los pulmones y la esperanza de vida. Consuma bajo su propio riesgo)'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296403
    m_Localized: 'TV: Buenas tardes. Estas son las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296404
    m_Localized: 'TV: Un aviso importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296405
    m_Localized: 'TV: Surgieron nuevos detalles sobre el incidente reciente en la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296406
    m_Localized: 'TV: Parece que una de las zonas en cuarentena ha sido atacada por un individuo armado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296407
    m_Localized: 'TV: Todavía no se sabe el motivo y se desconoce si el perpetrador tenía cómplices.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296408
    m_Localized: 'TV: Varias personas con estatus no verificado han escapado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296418
    m_Localized: 'TV: El incidente de hoy ha dado lugar a numerosas teorías.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296419
    m_Localized: 'TV: Algunos reportes describen a un solo atacante, mientras que otros mencionan a un grupo armado vestido con capuchas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296420
    m_Localized: 'TV: Pero el mayor desafío podría estar aún por delante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296421
    m_Localized: 'TV: Debido a la cuarentena, el traslado de cuerpos en las áreas circundantes ha sido temporalmente suspendido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296422
    m_Localized: 'TV: Sin embargo, las inspecciones a las residencias continuarán según lo programado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296423
    m_Localized: 'TV: Si ustedes pueden cremar a los fallecidos, háganlo de inmediato.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296424
    m_Localized: 'TV: De lo contrario, por favor esperen a que la situación se normalice antes de entregar restos mortales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296425
    m_Localized: 'TV: Eso es todo por ahora. Quédense con nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296426
    m_Localized: 'TV: Buenas tardes. Estas son las noticias del día de hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296427
    m_Localized: 'TV: La AFAE está asistiendo a las víctimas del ataque en la zona de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296428
    m_Localized: 'TV: Debido a la falta de espacio en las instalaciones existentes, la agencia ha tomado la siguiente decisión:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296429
    m_Localized: 'TV: Los residentes evacuados serán reubicados temporalmente en edificios a las afueras de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296430
    m_Localized: 'TV: Afortunadamente, los dueños de casas locales han cooperado con la AFAE, ofreciendo refugio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296431
    m_Localized: 'TV: Sin embargo, solo una parte de los individuos que escaparon fueron localizados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296432
    m_Localized: 'TV: Se ha dado a conocer una nueva señal de identificación:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296433
    m_Localized: 'TV: Sangrado de encías.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296434
    m_Localized: 'TV: Si un individuo con este rasgo se presenta en su puerta, evite el contacto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296435
    m_Localized: 'TV: Espere a la patrulla programada de la AFAE y reporte al individuo a las autoridades.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296436
    m_Localized: 'TV: Recuerde permanecer en casa y espere nuevas instrucciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296437
    m_Localized: 'TV: Esto es todo por los momentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296438
    m_Localized: 'TV: A continuación: un reportaje especial sobre un nuevo culto peligroso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296439
    m_Localized: 'TV: Los Visitantes no solo se ocultan entre nosotros. Es posible que estén infiltrándose en nuestros pensamientos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296440
    m_Localized: 'TV: Múltiples ciudades ahora reportan el surgimiento de sectas organizadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296441
    m_Localized: 'TV: Los cargos en su contra incluyen:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296442
    m_Localized: 'TV: Rituales de sacrificio, adoración a una deidad desconocida y posibles vínculos con los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296443
    m_Localized: 'TV: Según los reportes, este grupo ha adoptado una postura pública contra la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296444
    m_Localized: 'TV: Lo que comenzó como una fe inofensiva escaló hasta convertirse en acciones directas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296445
    m_Localized: 'TV: Algunos expertos creen que este nuevo culto podría ser responsable de los sucesos violentos ocurridos recientemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296446
    m_Localized: 'TV: Recomenados evitar el contacto con estos supuestos "nuevos creyentes".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296447
    m_Localized: 'TV: Asistirlos o simpatizar con ellos puede resultar en un arresto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296448
    m_Localized: 'TV: Eso es todo por ahora. Quédense con nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296449
    m_Localized: 'TV: Buenas tardes. Estas son las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296450
    m_Localized: 'TV: La situación en la ciudad se está estabilizando gradualmente, pero algunos fugitivos siguen en libertad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296451
    m_Localized: 'TV: Mientras tanto, se reanudaron las operaciones para el manejo de cuerpos, aunque han surgido nuevos retos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296452
    m_Localized: 'TV: Según los últimos reportes, jaurías de perros violentos están deambulando por las calles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296453
    m_Localized: 'TV: La AFAE ha movilizado a un equipo para enfrentar la amenaza.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296454
    m_Localized: 'TV: La agencia también anunció una nueva señal para identificar a individuos potencialmente peligrosos:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296455
    m_Localized: 'TV: Irritación en la piel.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296456
    m_Localized: 'TV: La investigación sobre el ataque en la ciudad todavía está en curso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296457
    m_Localized: 'TV: Aún no está claro si el atacante actuó por su cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296458
    m_Localized: 'TV: Pero no hay duda de que la AFAE controlará la situación, así como la amenaza de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296459
    m_Localized: 'TV: Si tiene dudas sobre cómo reconocer a los Visitantes, puede llamar a la línea de emergencia de la AFAE marcando al:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296460
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296461
    m_Localized: 'TV: Como siempre, quédese donde está y espere nuevas indicaciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296462
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296463
    m_Localized: 'TV: A continuación: un reportaje sobre la situación en los países en la línea del ecuador.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296464
    m_Localized: 'TV: Esta noche, noticias alarmantes desde las regiones ecuatoriales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296465
    m_Localized: 'TV: Incendios forestales, calor extremo y sequía están devastando numerosas naciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296466
    m_Localized: 'TV: Según reportes recientes, las temperaturas son tan altas que el contacto con el suelo puede causar quemaduras de tercer grado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296467
    m_Localized: 'TV: El número de víctimas sigue siendo desconocido y evacuar es imposible en estos momentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296468
    m_Localized: 'TV: Nuestro gobierno no ha logrado establecer comunicación con las autoridades de las zonas afectadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296469
    m_Localized: 'TV: Sin embargo, en cuanto las condiciones lo permitan, se enviarán agentes de la AFAE para ayudar en las operaciones de socorro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296470
    m_Localized: 'TV: Eso es todo por ahora. Quédense con nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296471
    m_Localized: 'TV: Buenas tardes. Estas son las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296472
    m_Localized: 'TV: La situación en la ciudad sigue siendo inestable y la cuarentena se mantiene.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296473
    m_Localized: 'TV: Sin embargo, una nueva amenaza ha surgido. Los miembros de un culto fueron vistos en las afueras de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296474
    m_Localized: 'TV: Según reportes recientes, podrían estar preparando un ritual que implica el uso de fuego.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296475
    m_Localized: 'TV: La AFAE cree que este grupo pudo haber estado involucrado con los ataques a las zonas en cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296476
    m_Localized: 'TV: Desafortunadamente, debido a la situación actual en la ciudad, ni la AFAE ni el ejército pueden enviar un grupo de operaciones en este momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296477
    m_Localized: 'TV: Si algún miembro del culto se acerca a su domicilio, llame enseguida a la línea emergencia de la AFAE: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296478
    m_Localized: 'TV: La agencia anunció una nueva señal de identificación:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296479
    m_Localized: 'TV: Hongos en la zona de las axilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296480
    m_Localized: 'TV: Como siempre, quédese donde está y espere nuevas indicaciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296481
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296482
    m_Localized: 'TV: A continuación: una actualización sobre las condiciones en los polos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296483
    m_Localized: 'TV: El sol ataca de nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296484
    m_Localized: 'TV: Los científicos publicaron unas nuevas y preocupantes predicciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296485
    m_Localized: 'TV: Si la actual ola de calor no remite, las capas de hielo polares podrían derretirse por completo, lo que provocaría inundaciones catastróficas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296486
    m_Localized: 'TV: Los investigadores siguen estudiando la causa de la anomalía climática en curso, pero hasta ahora, no hay respuestas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296487
    m_Localized: 'TV: Eso es todo por ahora. Quédense con nosotros para más información.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296488
    m_Localized: 'TV: ¡Noticia de última hora!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296489
    m_Localized: 'TV: No hay señales de mejora en la ciudad y la situación sigue empeorando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296490
    m_Localized: 'TV: Con los glaciares derritiéndose, el nivel del mar está subiendo a una velocidad alarmante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296491
    m_Localized: 'TV: Zonas costeras alrededor del mundo, incluyendo varias grandes ciudades, enfrentan un grave riesgo de inundación.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296492
    m_Localized: 'TV: Algunos lagos contaminados con radiación han comenzado a evaporarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296493
    m_Localized: 'TV: Los científicos advierten que esto podría provocar lluvias ácidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296494
    m_Localized: 'TV: Si escucha truenos, busque refugio de inmediato para protegerse de la exposición.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296495
    m_Localized: 'TV: Y, lamentablemente, la ciudad permanece acordonada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296496
    m_Localized: 'TV: La AFAE todavía no ha capturado a todos los fugitivos y ahora anunció una nueva señal para identificar a los Visitantes:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296497
    m_Localized: 'TV: Movimiento rápido de las pupilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296498
    m_Localized: 'TV: TRANSMISIÓN DE EMERGENCIA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296499
    m_Localized: 'TV: Interrumpimos este reporte debido al riesgo de un ataque a nuestro estudio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296500
    m_Localized: 'TV: Si tiene dudas sobre cómo reconocer a los Visitantes, llame a la línea de emergencia: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296501
    m_Localized: 'TV: Fin de la transmisión.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296502
    m_Localized: 'TV: Noticia de última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296503
    m_Localized: 'TV: La AFAE acaba de arrestar a la mayoría de los funcionarios del gobierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296504
    m_Localized: 'TV: La agencia reporta que algunos de ellos fueron identificados como Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296505
    m_Localized: 'TV: Como el Parlamento ya no puede operar, la AFAE asumirá el papel de gobierno interino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296506
    m_Localized: 'TV: Además...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296507
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296508
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296509
    m_Localized: 'TV: Un momento por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296510
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296511
    m_Localized: 'TV: Anuncio de la AFAE:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296512
    m_Localized: 'TV: Los fugitivos han violado el protocolo de aislamiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296513
    m_Localized: 'TV: Repetimos, los atacantes están libres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296514
    m_Localized: 'TV: Pongan barricadas en las ventanas. Aseguren sus puertas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296515
    m_Localized: 'TV: Esperen a más instrucciones y permanezcan en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296516
    m_Localized: 'TV: Fin de la transmisión.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296565
    m_Localized: 'Window: Ves a una mujer llorando por su esposo herido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296566
    m_Localized: 'Window: No logras distinguir si está vivo o muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296567
    m_Localized: 'Window: Con el rostro bañado en lágrimas, lo arrastra, cargando su pesado cuerpo, lejos del tiroteo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296568
    m_Localized: 'Window: Un pensamiento te llega a la mente: todo se pondrá peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296569
    m_Localized: 'Window: El camino está lleno de los cadáveres de quienes trataron de huir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296570
    m_Localized: 'Window: Cerca de ahí está parado el responsable, un oficial de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296571
    m_Localized: 'Window: Sostiene un rifle, aún humeante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296572
    m_Localized: 'Window: Gente aterrada corre hacia las casas de los alrededores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296573
    m_Localized: 'Window: Golpean las puertas, con la esperanza de ser acogidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296574
    m_Localized: 'Window: Pero parece que nadie está dispuesto a dejarlos entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296575
    m_Localized: 'Window: Un grupo de personas desalojadas está en las ruinas que alguna vez fueron el hogar de tu vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296576
    m_Localized: 'Window: Están en estado de shock, murmurando cosas entre ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296577
    m_Localized: 'Window: Seguramente intenten refugiarse ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296578
    m_Localized: 'Window: ¿Pero queda un solo lugar en el mundo para ocultarse de todo esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296579
    m_Localized: 'Window: En el camino hay un hombre con un rifle de asalto. Se ve como un completo demente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296580
    m_Localized: 'Window: Su chaqueta está cubierta de dientes, ojos y quién sabe qué más. Es difícil distinguirlo desde aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296581
    m_Localized: 'Window: ¿Y si mata no para protegerse, sino por deporte y para coleccionar trofeos?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296582
    m_Localized: 'Window: Sea como sea, esperas que no te considere su enemigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296583
    m_Localized: 'Window: Hay un hombre colgado de un poste con un cartel que dice "Me lo quitaron todo."'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296584
    m_Localized: 'Window: ¿Lo habrán robado? ¿O la AFAE se llevó a su familia?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296585
    m_Localized: 'Window: La cabeza te da vueltas, pero no encuentras respuestas, solo suposiciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296586
    m_Localized: 'Window: Un grupo desalojado por la AFAE terminó refugiándose en las ruinas del vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296587
    m_Localized: 'Window: Aunque casi no queda nada, el sótano parece intacto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296588
    m_Localized: 'Window: Un pequeño lugar seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296589
    m_Localized: 'Window: Pero, ¿cuánto tiempo podrán seguir escondiéndose?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296590
    m_Localized: 'Window: Perros salvajes deambulan por la calle.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296591
    m_Localized: 'Window: Sus cuerpos tienen quemaduras leves, el hambre los tiene débiles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296592
    m_Localized: 'Window: No les temes desde el interior de tu hogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296593
    m_Localized: 'Window: Pero tienes la sensación de que es mejor no salir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296594
    m_Localized: 'Window: Pequeños grupos con sus pertenencias se juntan cerca de las casas. Susurran, procurando no ser oídos por los oficiales de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296595
    m_Localized: 'Window: Parece que vienen de zonas en cuarentena y se están mudando a las casas de los antiguos residentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296596
    m_Localized: 'Window: Ahora, el ahorcado en el poste parece un tenebroso letrero de "Bienvenida".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296597
    m_Localized: 'Window: Un cazador de Visitantes apunta a un grupo de sobrevivientes con un arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296598
    m_Localized: 'Window: Probablemente se los encontró por casualidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296599
    m_Localized: 'Window: Se oyen gritos; hay una voz enloquecida que resalta más que las demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296600
    m_Localized: 'Window: ¿Quién sobrevivirá en este nuevo mundo? Definitivamente, ellos no lo harán...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296601
    m_Localized: 'Window: Hay unos oficiales de la AFAE parados sobre los perros muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296602
    m_Localized: 'Window: Uno de ellos anota algo en una tableta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296603
    m_Localized: 'Window: ¿Pueden unas pocas personas parar una horda de animales hambrientos? Es poco creíble.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296604
    m_Localized: 'Window: Dos oficiales de la AFAE están parados junto a un poste de luz, mirando al hombre ahorcado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296605
    m_Localized: 'Window: Parece que por fin decidieron acercarse a la atracción principal del lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296606
    m_Localized: 'Window: Parecen detectives despistados. Seguro se preguntan cómo llegó ahí sin una escalera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296607
    m_Localized: 'Window: Todo el grupo está muerto. Perros hambrientos se alimentan de sus restos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296608
    m_Localized: 'Window: Cerca de los cuerpos hay casquillos de bala. Es probable que el cazador los matara y tomara partes como trofeos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296609
    m_Localized: 'Window: La locura de este mundo ha ido demasiado lejos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296610
    m_Localized: 'Window: Los sectarios están apilando leña para hacer una fogata.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296611
    m_Localized: 'Window: ¿Planean quemar a alguien?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296612
    m_Localized: 'Window: Su disparatado plan se revelará pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296613
    m_Localized: 'Window: ¿Pero cuántas vidas inocentes se perderán por su causa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296614
    m_Localized: 'Window: En el camino hay un loco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296615
    m_Localized: 'Window: Lleva un bidón de gasolina y un coctel molotov.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296616
    m_Localized: 'Window: ¿Será que planea incendiar a todo el pueblo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296617
    m_Localized: 'Window: ¿Acaso no sabe que esta gente viene de las zonas de cuarentena?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296618
    m_Localized: 'Window: Los cuerpos de quienes se escondían en el sótano de tu vecino se quemaron por el sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296619
    m_Localized: 'Window: Los perros que se los comían escaparon. ¿Algo los asustó?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296620
    m_Localized: 'Window: ¿Y si no huyeron de la AFAE, sino de algo peor?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296621
    m_Localized: 'Window: Los sectarios se ataron al lugar donde está la fogata.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296622
    m_Localized: 'Window: ¿Se habrán sacrificado a sí mismos?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296623
    m_Localized: 'Window: El pensamiento te ronda la cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296624
    m_Localized: 'Window: El miedo a la muerte ha nublado la razón. La gente está dispuesta a hacer lo impensable.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296625
    m_Localized: 'Window: Cuando este tipo de locuras pasan después de unas pocas semanas se vuelve aterrador pensar en lo que vendrá después.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296626
    m_Localized: 'Window: Las casas en llamas arden con fuerza. Se oyen gritos a lo lejos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296627
    m_Localized: 'Window: Sabes que el responsable de este caos es el loco que intenta exterminar a los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490688
    m_Localized: 'Window: ¿Será tu casa la siguiente? ¿Lo será mañana? ¿La próxima semana?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490689
    m_Localized: 'Window: Es probable que pronto te encuentres con ese loco cara a cara. Es solo cuestión de tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490690
    m_Localized: 'Window: No queda nada de los cuerpos quemados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490691
    m_Localized: 'Window: Solo una extraña masa sin forma. Parece lodo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490692
    m_Localized: 'Window: Te preguntas si algo fundió la carne y los huesos antes de tragarse los restos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490693
    m_Localized: 'Window: Rezas para que esta criatura permanezca en las sombras. Temes que tu cabeza no resista ver a ese monstruo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490694
    m_Localized: 'Window: Los oficiales de la AFAE rodean los cuerpos quemados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490695
    m_Localized: 'Window: Documentan las muertes de los cultistas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490696
    m_Localized: 'Window: Caras congeladas en terror y agonía, como si hubiesen visto algo horrible antes de morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490697
    m_Localized: 'Window: Todas las casas de alrededor están en ruinas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490698
    m_Localized: 'Window: Tu casa es la última que queda en pie.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490699
    m_Localized: 'Window: Ya no queda nada más que distraiga a ese demente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490700
    m_Localized: 'Window: Lo que sea que haga después, te lo va a hacer a ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490701
    m_Localized: Habla Central. Chequeen el estado de la zona de cuarentena. Código 51. Se reportaron explosiones a las 3 AM.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490702
    m_Localized: 'Unidad 32-8 reportando. Código 60: bajas civiles masivas, oficiales caídos...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490727
    m_Localized: 'New d...r...tive: N...ueva o...rden: El Código 451 es r...eemplaza...o por el Código 955.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490732
    m_Localized: 'Re...ito: nece...tamos ref...erzos a...hora. No p...demos c...ntener al s...jeto solos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490733
    m_Localized: 'Phone: Hola, vecino. Es bueno oír de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490734
    m_Localized: 'Phone: Entonces... ¿Ya dejaste entrar a algunas personas?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490735
    m_Localized: 'Phone: Si no, tampoco debes seguir atrasándolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490736
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490737
    m_Localized: 'Phone: ¿Alguna pregunta?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490742
    m_Localized: 'Phone: Sí, debo hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490743
    m_Localized: 'Phone: A mi hija no le gusta. ¿Pero qué puedo hacer? No hay otra salida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490744
    m_Localized: 'Phone: Sigue pidiéndome que la lleve a afuera, solo para alejarse de todos los extraños en la casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490745
    m_Localized: 'Phone: Pero no puede caminar durante el día, así que lo hacemos por la noche. Es peligroso, ya lo sé... Pero ella no para de rogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490746
    m_Localized: 'Phone: Ojalá lo supiera...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490747
    m_Localized: 'Phone: Nadie sabe cuantas señales toma para estar realmente seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490748
    m_Localized: 'Phone: Yo diría que no saques conclusiones precipitadas si solo ves una.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490749
    m_Localized: 'Phone: Tal vez no sea nada. Posiblemente solo fueron al dentista antes de que todo esto se fuera al demonio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490750
    m_Localized: 'Phone: Tuve suerte. Conseguí provisiones a tiempo. Si la memoria no me falla, tú tambien lo hiciste.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490751
    m_Localized: 'Phone: Pero si quieres algo especial, existe ese servicio a domicilio, For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490752
    m_Localized: 'Phone: No sé su número, pero puedes encontrarlo en los anuncios de la  televisión o la radio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490753
    m_Localized: 'Phone: Cuídate.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490754
    m_Localized: 'Phone: Hola, vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490755
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490756
    m_Localized: 'Phone: ¿Viste lo que pasó? Adolescentes fueron asesinados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490757
    m_Localized: 'Phone: No pensé que las calles fueran tan peligrosas. Supongo que me equivoqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490758
    m_Localized: 'Phone: Mi hija me convenció de salir a jugar. Todo estaba bien... Hasta que vi los cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490759
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490760
    m_Localized: 'Phone: Creo que esa será la última vez que arriesgo la vida de ese modo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490761
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490762
    m_Localized: 'Phone: Dios, jamás me lo perdonaré si algo le pasa. Ella es mi mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490766
    m_Localized: 'Phone: ¿Quién los mató?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490767
    m_Localized: 'Phone: Con el pasto tan alto no debió haberlo notado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490768
    m_Localized: 'Phone: Pero en casa dijo que vio un rostro en la hierba.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490769
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490770
    m_Localized: 'Phone: Trato de convencerla de que fue su imaginación. Pero ella no lo cree.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490771
    m_Localized: 'Phone: Era esa cosa alta y pálida. Pensé que solo mataba a quienes se quedaban adentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490772
    m_Localized: 'Phone: Pensé que lo tenía bajo control. Siempre me dije que si veía esa silueta volveríamos a la casa en un dos por tres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490773
    m_Localized: 'Phone: Pero no pensé que ella acabaría viendo esos cuerpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490774
    m_Localized: 'Phone: Gracias. Cuídate tú también.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490775
    m_Localized: 'Phone: Hola, vecino. Gracias por llamar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490776
    m_Localized: 'Phone: Honestamente, sigo conmocionado por todo esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490777
    m_Localized: 'Phone: Los homicidios, los soldados, la AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490778
    m_Localized: 'Phone: Incluso se aparecieron en mi puerta anoche.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490779
    m_Localized: 'Phone: Preguntaron por la gente que se quedaba aquí, anotaron algo en una tableta y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490780
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490781
    m_Localized: 'Phone: Uno de ellos sacó a alguien de mi casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490786
    m_Localized: 'Phone: Si tan solo lo supiera. Dijeron que solo era un chequeo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490787
    m_Localized: 'Phone: Creí que los soldados y la Agencia de Gestión de Emergencias ayudarían a mejorar las cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490788
    m_Localized: 'Phone: Debí suponer que ayudarnos a llegar a un lugar seguro no sería su prioridad principal.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490789
    m_Localized: 'Phone: No dejaré que nos lleven.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490790
    m_Localized: 'Phone: Sobre mi cadáver.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490791
    m_Localized: 'Phone: Si esos bastardos se atreven a tocarla, los haré pedazos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490792
    m_Localized: 'Phone: No lo sé. Nadie sabe mucho acerca de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490793
    m_Localized: 'Phone: Salieron de la nada actuando como si lo tuvieran todo bajo control.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490794
    m_Localized: 'Phone: ¿Pero identifican las señales? ¿Y por qué parecen cosas normales que cualquier humano podría tener?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490795
    m_Localized: 'Phone: Se siente como si no estuvieran diciéndonos toda la verdad...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490796
    m_Localized: 'Phone: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490797
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490798
    m_Localized: 'Phone: Jamás pensé que acabaríamos viviendo en completo caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490799
    m_Localized: 'Phone: El Sol, los Visitantes, la AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490800
    m_Localized: 'Phone: Tantas preguntas y ni una maldita respuesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490801
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490802
    m_Localized: 'Phone: Vecino, necesito pedirte algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490803
    m_Localized: 'Phone: Si algo me pasa, prométeme que cuidarás a mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490806
    m_Localized: 'Phone: Gracias, vecino. Sabía que podía contar contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490807
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490808
    m_Localized: 'Phone: Bien, debo irme. Mantente fuerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490809
    m_Localized: 'Phone: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490810
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490811
    m_Localized: 'Phone: ¿De verdad no la ayudarías? Es solo una niña. No quiero que se quede sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490812
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490813
    m_Localized: 'Phone: Carajo, debo irme.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490814
    m_Localized: 'Phone: Adiós, vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490815
    m_Localized: 'Phone: Hola, este es el servicio de entregas de For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490816
    m_Localized: 'Phone: ¿Qué le gustaría ordenar?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490820
    m_Localized: 'Phone: Lo siento, no podemos aceptar tu orden, ya que recientemente hiciste una.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490821
    m_Localized: 'Phone: Debido a la alta demanda nos vemos obligados a aceptar pedidos con interrupciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490822
    m_Localized: 'Phone: Si desea hacer un pedido, por favor intente llamar de nuevo otro día.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490823
    m_Localized: 'Phone: Gracias. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490824
    m_Localized: 'Phone: Muy bien. Su orden se está procesando. Por favor, espere su pedido hasta mañana por la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490825
    m_Localized: 'Phone: Muy bien. Su orden se está procesando. Por favor, espere su pedido hasta mañana por la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490826
    m_Localized: 'Phone: Hola, se ha comunicado con la división médica de la Agencia Federal de Administración de Emergencias'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490827
    m_Localized: 'Phone: Estamos preparados para brindarle consultorías sobre procedimientos para la identificación de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490829
    m_Localized: 'Phone: ¿Tiene alguna pregunta?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490834
    m_Localized: 'Phone: Para resultados precisos, recomendamos evitar el tabaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490835
    m_Localized: 'Phone: Fumar podría afectar la condición de los dientes, provocando resultados poco confiables.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490836
    m_Localized: 'Phone: Para asegurar una lectura apropiada de su condición, por favor absténgase de lavarse las manos antes de ser examinado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490837
    m_Localized: 'Phone: El agua podría eliminar residuos del suelo, lo que podría causar errores y resultados falsos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490838
    m_Localized: 'Phone: Para una revisión confiable, por favor evite el café o bebidas con cafeína.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490839
    m_Localized: 'Phone: La cafeína no solo podría causar insomnio y nervios, sino que también puede provocarle ojos rojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490840
    m_Localized: 'Phone: Gracias por cooperar con la Agencia Federal de Administración de Emergencias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490841
    m_Localized: 'Phone: Su cooperación aliviará la carga para todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490842
    m_Localized: 'Phone: Al favorecer la confiabilidad de las inspecciones, no solo se ayuda a sí mismo, sino a toda la humanidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490843
    m_Localized: 'Phone: Hola. Por favor espere mientras lo conectamos con un especialista de exorcismo de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490844
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490845
    m_Localized: 'Phone: ¿Aló? ¿Quién habla?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490848
    m_Localized: 'Phone: Ya veo. Evitaste mi pregunta... El espíritu del Visitante ya empezó a apoderarse en tu interior.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490849
    m_Localized: 'Phone: Ahora escucha con atención, no te queda mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490850
    m_Localized: 'Phone: Dime, ¿sueles dejar una rebanada de pan en la cocina?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490853
    m_Localized: 'Phone: Para ayudarme a desterrar el espíritu del Visitante de tu interior.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490854
    m_Localized: 'Phone: Bueno, olvídalo. Escucha con atención, no te queda mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490855
    m_Localized: 'Phone: Dime, ¿sueles dejar una rebanada de pan en la cocina?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490858
    m_Localized: 'Phone: Ah... Eso lo explica todo. No estás en buenos términos con el espíritu de tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490859
    m_Localized: 'Phone: Por eso vino el espíritu del Visitante. Pero no te preocupes. Podemos solucionarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490860
    m_Localized: 'Phone: ¿Tienes una computadora personal en casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490863
    m_Localized: 'Phone: ¿No dejas ofrendas para el espíritu de la casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490864
    m_Localized: 'Phone: Con razón el espíritu Visitante se interesó en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490865
    m_Localized: 'Phone: ¿Tienes una computadora personal en casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490868
    m_Localized: 'Phone: Así que usar Alt+F4 está descartado...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490869
    m_Localized: 'Phone: Muy bien, pues dime: ¿consumes hongos?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490872
    m_Localized: 'Phone: ¿En serio no sabes qué es una computadora?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490873
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490874
    m_Localized: 'Phone: Bueno, olvídalo. Continuemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490877
    m_Localized: 'Phone: Oh, no...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490878
    m_Localized: 'Phone: Tienes que dejar de tomar eso inmediatamente. El kombucha es un mal ancestral.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490879
    m_Localized: 'Phone: Hace que el micelio crezca en tu interior. Es por eso que el espíritu puede controlarte como a un títere.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490880
    m_Localized: 'Phone: No te imaginas lo que puede hacer si llega a tus recuerdos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490881
    m_Localized: 'Phone: Puede borrarlos por completo... o leerlos una y otra vez, alterando tus decisiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490882
    m_Localized: 'Phone: ¿Y lo peor de todo? Ni siquiera te darás cuenta de que te están controlando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490883
    m_Localized: 'Phone: Bueno, una última pregunta: ¿se ha derramado sangre en tu casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490886
    m_Localized: 'Phone: Bueno. Entonces no lo bebas más. De lo contrario, al espíritu de un Visitante se le hará más fácil poseer tu cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490887
    m_Localized: 'Phone: Cuídate de beber kombucha, el micelio empieza a crecer en tu interior, tomando el control, como si fueras un títere.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490888
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490889
    m_Localized: 'Phone: Fiu... no es fácil, no es nada fácil...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490892
    m_Localized: 'Phone: Ah, eso lo explica...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490893
    m_Localized: 'Phone: No es un Espíritu Visitante, es un Espíritu Espectral. El alma de alguien que murió.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490894
    m_Localized: 'Phone: Me temo que la expulsión de espectros no es realmente mi especialidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490895
    m_Localized: 'Phone: Necesitarás un exorcista para eso. Ellos te ayudarán.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490896
    m_Localized: 'Phone: Me temo que no hay nada más que pueda hacer. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490897
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490898
    m_Localized: 'Phone: Tu sesión de expulsión de Visitantes ha terminado. Gracias por usar nuestros servicios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490899
    m_Localized: 'Phone: Pronto se te cobrará una tarifa de consulta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490903
    m_Localized: 'Phone: Ah, qué lástima. Me temo que no puedo identificar este tipo de espíritu entonces. Y si no sé qué tipo de espíritu es, no hay nada que pueda hacer para ayudarte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490904
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490905
    m_Localized: 'Phone: Lamentablemente, debemos dar por terminada esta sesión.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490906
    m_Localized: 'Phone: Mantente fuerte y... adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490907
    m_Localized: 'Phone: Tu sesión de expulsión de Visitantes ha terminado. Gracias por usar nuestros servicios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: Pronto se te cobrará una tarifa de consulta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: Así es. Nuestros especialistas en extracción de Visitantes también necesitan ganarse la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: ¿Cómo calificarías tu experiencia de hoy?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: Si vio el anuncio con atención se habrá dado cuenta de que la letra chica menciona que la primera llamada incluye una tarifa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: ¿Cómo calificarías tu experiencia de hoy?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: Gracias. Tu opinión es muy importante para nosotros. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: Consigue tu comida a domicilio con For Rest. Llama ya al {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: Buenas tardes. Estas son las noticias del día de hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: 'TV: A pesar de los incendios, los Visitantes continúan aterrorizando al país.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: La AFAE ha anunciado una nueva señal para ayudar a ciudadanos en la lucha contra los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: A continuación: un reporte especial sobre la naturaleza de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: ¿Eh? Sí, ¿hola?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: Ajá. ¿Y?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: Siempre es lo mismo y es a mí al que le toca resolver sus desastres todo el tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: Nada más se sienta y dice, "Ay, qué cansada estoy."'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: Nada nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: Ahhh, claro. Como siempre, no le importan sus propios hijos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: Y ahora es a mí al que le toca resolver su desastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: ¿Viste si estaban en casa de su madre?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: No. ¿No están con ella?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: No me sorprende.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: ¿Viste si estaban en casa de su madre?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: Ajá.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: Pues, quizás estén ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: No voy a ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: Que ella lo resuelva. Pregúntale qué clase de madre pierde a sus propios hijos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: Déjala ir sola. Ella no es ninguna princesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: Tiene dos piernas, ¿no? ¿Entonces, cuál es el problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: Entonces, ¿para qué llamaste? ¿Para ayudar a una pobre damisela en apuros?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: Haz lo que quieras. A esa perra no le importa de todos modos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: Ya, maldita sea, solo déjame en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: 'Phone: Como sea, le diré que estás vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: Ni te molestes. ¿Qué más da?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: No nos importamos un carajo el uno al otro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: No entiendo por qué te metes en esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: Como sea... cuídense, ustedes dos. Espero que tengan una vida maravillosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: ¿Crees en la Muerte?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: ¿Qué? ¿Mi esposo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: Después de todo lo que hizo... no quiero saber nada de él.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: ¿Mi esposo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: Después de todo lo que hizo... no quiero saber nada de él.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: Já. ¡¿Lo lamenta?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: ¿En serio? ¿Otra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: No es la primera vez que le pide a alguien que se disculpe por él.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: ¿Quieres saber por qué no me puede llamar él mismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: Porque no tiene las agallas para enfrentar lo que hizo. Para asumirlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: Sigue queriendo arreglar las cosas, volver a como era antes. Pero así no funciona la vida. Nadie puede retroceder el tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: Estoy mejor ahora. Estoy con gente que me entiende.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: Diles como que quieras. Ahora ellos son mi familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: Compartimos la misma creencia. Sabemos que la Muerte llegará muy pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: Y que traerá paz, no dolor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: Cuídate'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: Compartimos la misma creencia sobre lo que está por venir: la llegada de la Muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: Puede que te parezca extraño, pero la Muerte no trae sufrimiento, sino felicidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: Es la felicidad de la paz y el fin de todo sufrimiento. Seguro tú también has tenido que lidiar con tus propios problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: Quizás algún día lo entiendas y veas las cosas como las vemos nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: Cuídate'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: Gracias por entender.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: Cuídate'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: ¿Hola? ¿Quién habla?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: ¿Cuál hermano? Si yo ni...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: Ah, hablas del hijo de mi papá, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: Pero, espera... ¿Quién eres tú? ¿Y por qué está contigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: ¿Desaparecieron? ¿A qué te refieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: No me digas que ellos...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: Maldición... Esto no puede ser cierto... ¿Están muertos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: ¿Buscando refugio? Pero él vive con sus padres, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: No... No me digas... ¿Acaso ellos...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: Maldición... Esto no puede ser cierto... ¿Están muertos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: Dios... ¿Cómo pudo pasar esto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: Puedo ayudarlo. Dile eso. Él sabe dónde vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: Y... gracias por ayudarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: Hasta luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: ¿Sí? ¿Quién habla?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: Suenas como si estuvieras pidiendo un rescate.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: Me temo que no me queda nada más que ofrecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: Y pronto no quedará nadie tampoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: Por favor, dime que ella está bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: Es fuerte, se las arreglará para superar lo que sea. ¡Incluso ayudará a quien pueda por el camino!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: Pero ya no creo que me puedan ayudar a mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: No estaré aquí por mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: Yo... ya no lo soporto. El sol, los Visitantes, la gente loca. Es aterrador. Me siento paralizado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: Yo solo... solo quiero que todo esto se termine y me queda una sola salida... ¿me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: Por favor, dile que la amo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: La verdad... mejor no le digas nada. Solo asegúrate de que no venga a buscarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: No quiero que sepa que la dejé atrás...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: Gracias por llamar. Y por escuchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: Adiós...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: Apuesto a que se está aferrando a su hermana. Nunca supo cómo desprenderse...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: Qué mala suerte la suya, rodeada solo de gente débil. Por eso decidí dejarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: Se ha comunicado con Admisiones de la AFAE. ¿En qué puedo ayudarle?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: ¿Y cuál es tu pregunta? No sé cómo puedo ayudarte todavía.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: Suponiendo que esto no es una amenaza.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: (Oyes un fuerte suspiro al otro lado de la línea)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: Eres de esos activistas, ¿no? De los que siempre se quejan de algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: No nos hagas perder el tiempo. Alguien que de verdad necesita ayuda puede estar intentando llamarnos en este momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: Los Visitantes podrían estar entrando en alguna parte. O algo peor. Gente podría estar muriendo por tu culpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: Mmm. Debería saber que el trabajo... no es nada fácil. ¿Seguro que está lista para esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: Si lo está, dile que llene el Formulario 31-G en tres copias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: Luego tiene que pasar el examen médico... Después de eso, debe llenar...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: (Cuelgas. ¿Por qué te molestaste en llamar por esta mujer en primer lugar?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: ¿Para qué puesto se está postulando? Y por favor, no me digas que para directora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: Con ella ya serían tres el día de hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: Estoy harto, maldita sea, de estas bromas telefónicas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: Cuando ocupan la línea para estas pendejadas no puedo ayudar a gente que de verdad lo necesita. Los Visitantes podrían estar matando a alguien.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: Asume la responsabilidad por tu estúpido e inapropiado chistecito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: (Colgaron. ¿En serio?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: No tenemos vacantes de ese tipo. Lo que en verdad necesitamos son expertos en epidemias y científicos cualificados.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: Tu amiga no suena como una buena candidata.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: ¿Pero sabes qué? Las cosas están cambiando muy rápido. Llama de nuevo en una semana.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: Estoy seguro de que habrá un puesto para... ¿cómo le dijiste? Una altruista.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: Estructura de una manzana: la supermanzana, la tierra de los hongos y el papel.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: Teme la... tie... de los hon...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: Aunque son tan... encanta la...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: Ahí... encontra...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: Solo lágrimas y la condena del adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: Revisa su respiración.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: ¿Por qué no contestas? Quisiera morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: (Cuelgan. Eso no era... exactamente lo que esperabas)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: Por favor, tenga en cuenta que ahora mismo no se puede viajar a nuestro país en avión o tren.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: ¿En qué puedo ayudarle?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: Lo mejor es esperar a que se permitan los vuelos otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: Los ferris están funcionando, pero no es seguro. El riesgo de tifones nocturnos es muy alto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: Además, el agua refleja el sol en las embarcaciones; una tripulación no puede aguantar mucho tiempo allá afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: Las vías del tren se expandieron por el calor, es muy peligroso que los trenes circulen durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: Los trenes solo viajan de noche, por lo que no puede llegar muy lejos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: Son demasiados transbordos. Es mejor esperar a que los viajes en avión se reanuden.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: Solo tiene que esperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: No hay nada más que podamos hacer por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: No contamos con ningún hotel en el que pueda quedarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: No hay nada que podamos hacer. Estamos tratando de solucionar el problema, pero él no es el único atrapado así.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: Todo nuestro personal está muy ocupado. Quizás ya lo sepa, pero recortaron mucho los fondos de las embajadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: Estamos haciendo todo lo que podemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: No hay necesidad de que hable así.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: No podemos cargarlo hasta su casa. Si en serio quieres ayudar, vas a tener que hacerlo por tu cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: Con los recortes de presupuesto, básicamente estamos trabajando por vocación.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: ¿No te gusta cómo hacemos las cosas? Entonces hazlo tú.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: Buena suerte cruzando la frontera con las inspecciones de Visitantes y el calor del mediodía.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: Entonces, ¿por qué te quedas en casa en vez de ir a trabajar?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: O, mejor aún, ¿por qué no vienes y nos muestras cómo se hace?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: Nos encantaría la ayuda de alguien que lo sabe todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: Disculpa por reaccionar así.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: No eres el primero que... nos habla con este tono.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: Que tengas un buen día.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: Buen viaje.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: La verdad es que espero que en algún momento tengas ganas de viajar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: Me encantaría ayudarte si llega a suceder.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: Hola, se ha comunicado con la línea directa de la AFAE. ¿Cómo puedo ayudarle?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: (Antes de que ella pueda terminar, un grito masculino se escucha en la llamada)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: ¿¡ACASO ERES ESTÚPIDA!? ¡CUELGA LA LLAMADA, AHORA MISMO!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: Para asegurar que la inspección bajo las axilas sea precisa, debe evitar todo contacto con agua.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: Absténgase de ducharse y lavarse las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: ¿Oídos? Espere...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: Le consultaremos a nuestra gerencia y le contactaremos luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: Muy bien, por favor responda: ¿consume hongos?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: Ok, una última pregunta: ¿ha habido sangre derramada en su hogar?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: Buenas, te has comunicado con Phone Roulette. Te conectaremos con tu compañero de conversación ideal en breve. Por favor, espere.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: Hola, hola.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: ¿Hola?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: Supongo que no hay nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: Yo... Yo necesito hablar con alguien. Ha pasado tanto últimamente...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: He tratado de contactar con mis amigos y conocidos, pero nadie contesta...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: Y entonces supe de Phone Roulette.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: Tal vez no sea el mejor lugar para desahogarte, pero es mejor que nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: Sé que no es correcto abrumar a un extraño con mis problemas, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: No sabes lo mucho que me ayudaría hablar con otra persona. Me haría sentir mucho... mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: ¿Te molestaría escucharme?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: Está bien, lamento haberte molestado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: Muchísimas gracias. ¡Gracias!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: Creo que será más fácil si te cuento un poco sobre mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: ¿Qué te gustaría saber?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: Lejos de casa, lamentablemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: Busqué el lugar más frío que pudiera encontrar para escapar del calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: Estoy en medio de la nada. El frío es tal, que se te mete por los huesos y casi nada crece, ni siquiera pasto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: Un lugar relativamente seguro, a kilómetros de la civilización.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: Pero si el noveno círculo del infierno es frío, entonces quizás este lugar no sea tan malo en comparación.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: Es gracioso, antes odiaba el frío, pero ahora... se siente como una bendición.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: Quiero creer que el sol volverá a la normalidad y esto acabará.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: Pero estoy dejando de creer en un final feliz. ¿Qué pasará cuando el sol vuelva a ser como antes?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: Es posible que los Visitantes jamás se vayan. Podrían reemplazar a nuestros seres queridos y nosotros ni siquiera lo sabríamos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: Me encantaría llamarlos, pero... No sé como ponerme en contacto con ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: Cuando todo esto comenzó decidí dejar mi ciudad. Me alejé todo lo que pude del calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: Les prometí a todos que llamaría con frecuencia, que chequearía como están todos, preguntar como están...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: Pero cuando llegué  no pude contactar con nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: Luego supe la razón: sus líneas telefónicas habían sido cortadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: Toda la ciudad fue apartada del resto del mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: Ahora estoy aquí, a salvo, pero mis amigos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: La idea de no volver a ver a quienes amo me aterra.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: Extraño los días tranquilos, cuando la vida era simple y no teníamos que temer que sería del futuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: No quería hacerlo, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: En realidad, mi mejor amigo quería venir conmigo, pero no pudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: No tenía los documentos para viajar conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: y cuando todo este desastre comenzó, conseguirlos se volvió imposible.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: Él estaba devastado... Se arrepintió de no conseguirlos antes. Quise ayudarlo, pero no supe cómo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: Los extraño. Más a la gente que a la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: Sobre todo a mi mejor amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: Él quería venir conmigo, pero no pudo. Y yo prometí que mantendríamos el contacto, que lo llamaría, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: Creo que estaba enamorado de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: Se preocupaba tanto por mí. Siempre apoyándome, y escuchándome.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: Y entonces me di cuenta de que nos gustábamos mutuamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: Esperé que me confesara sus sentimientos. Quería que él lo hiciera primero. Pero no pudo... supongo que nunca encontró el momento indicado para hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: Y entonces, este desastre comenzó y no hubo tiempo para eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: Lamento no decirle primero.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: Bien, ya sabes un poco sobre mí. Ahora es tu turno.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: No seas tímido. Estoy lista para oír.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: No te preocupes. No es malo que hables de tí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: Lo siento... No suenas muy contento con que la casa terminara contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: No... No puedo ni imaginar por lo que has pasado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: No puedo no imaginar cuanto odias a tu padre si quieres que la casa se queme.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: 'Phone: Gracias de nuevo por hablar conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: 'Phone: Adiós. Mucha suerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: ¿Hola?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: ¿Qué? ¿Por qué quieres hablar con ella?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: ¿Él... también era... un Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: Nadie quema gente sin motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: Así que él era un Visitante... Tal y cómo nuestra pequeña.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: Ellos también la quemaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: Ahí, en la guardería.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: Al principio lloré. Quise suicidarme. No podía vivir sin ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: Pero mi esposo me ayudó a superarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: Y tú también vas a superarlo...y también es pequeña.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: Tú entiendes...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: Nada pasa sin una razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: Si quemaron a su padre, tenía que pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: Y llorar no arreglará nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: Por favor... dile eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: Nuestra pequeña... ella...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: Murió...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: 'Phone: Tuvimos que...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: Tuvimos que matarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: 'Phone: La matamos. Créeme, tuvimos que hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: Todas las señales coincidieron... y mi esposo insistió.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: 'Phone: ¡No me juzgues!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: ¡Era una Visitante! ¡Todas las señales coincidían!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: Era una Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: Cada señal apuntaba a eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: Yo la conocía más que nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: Por eso lo noté de inmendiato.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: Todo coincidía.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: Tan pronto como le dije a mis esposo, él...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: Él lidió con el Visitante inmediatamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: Al principio quise matarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: Pero luego comprendí... que no era nuestra hija después de todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: Mi esposo me hizo entederlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: Ahora solo lamento no haberle preguntado al sustituto lo que le hizo a nuestra hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: Lo siento.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: No vuelvas a llamar aquí...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: Por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: ¿Qué hago dándo dándole explicaciones?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972625
    m_Localized: 'Phone: ¡Vete a la verga!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972626
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972627
    m_Localized: 'Phone: Pero... Aún la extraño...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972628
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096192
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096193
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096194
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096195
    m_Localized: 'TV: A continuación: un reportaje sobre la suspesión temporal de los servicios de entierro y cremación.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490703
    m_Localized: Aquí 28-8. Código 451. Se solicita un equipo de cremación para los cuerpos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490704
    m_Localized: Recibido. Iniciando Código 984. El acceso a la ciudad se ha cerrado en espera de una investigación. Esperen refuerzos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490705
    m_Localized: Si están escuchando esto, eviten los límites de la ciudad.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490706
    m_Localized: Los oficiales de la AFAE le están disparando a cualquiera que intente salir.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490707
    m_Localized: ¡NO SÉ QUÉ ESTÁ PASANDO! ¡SOLO QUIERO SALIR DE AQUÍ!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490708
    m_Localized: ALGUIEN, POR FAVOR, AYU—
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490709
    m_Localized: Esos no fueron los que atacaron la zona de cuarentena.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490710
    m_Localized: Yo lo vi. Vi lo que había ahí.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490711
    m_Localized: Eso... Eso no era humano...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490712
    m_Localized: Habla un recién desalojado.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490713
    m_Localized: Si la AFAE los sacó de casa como hizo con nosotros, nos estamos refugiando en el en el sótano de una casa quemada.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490714
    m_Localized: Está cerca de donde vive el ermitaño.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490715
    m_Localized: No nos queda mucha comida. Pronto empezaremos a morir de hambre.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490716
    m_Localized: Si alguien tiene comida de sobra, por favor, ayúdennos. De verdad la necesitamos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490717
    m_Localized: A todos los que me escuchen...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490718
    m_Localized: La AFAE está intentando bloquear todas las señales de la ciudad para que no se sepa nada.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490719
    m_Localized: Quieren ocultar todo lo que está pasando en la ciudad.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490720
    m_Localized: Están intentando culpar de todo a ese psicópata que mató a todos en la zona de cuarentena.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490721
    m_Localized: Si todavía están en la ciudad... s...gan. N...o es seguro.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490722
    m_Localized: E...viten las patrullas de la AFAE. Van a m...tarlos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490723
    m_Localized: H...UYAN MIE...TRAS PUED—
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490724
    m_Localized: No deb...eron que...ar los cu...erpos. E...so a...trae...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490725
    m_Localized: Si hu...bieran... si hu...bieran... r...esistido... no se hu...biera co—
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490726
    m_Localized: Ce...tral a...... todas las u...nidades de la A...AE...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490728
    m_Localized: No quem...n lo... cuerp...s. Es mej...r utili...ar cal.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490729
    m_Localized: 'Re...ito: el Código 451 está canc...do... Quem...r los restos... r...sulta... p...ligroso para c...ntener la am...naza del sujet—'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490730
    m_Localized: H...bla el 18-8. No p...dimos conten...rlo.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490731
    m_Localized: El suj...to ha salido del per...met...o de la ci...udad. Se ne...sitan refu...rzos de in...mediato.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490738
    m_Localized: ¿Tú también estás recibiendo gente?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490739
    m_Localized: ¿Cuantas señas toma para saber si alguien es un Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490740
    m_Localized: ¿Cómo resolverías el problema de la comida?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490741
    m_Localized: Adiós (Cuelga)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490763
    m_Localized: ¿Tu hija está bien?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490764
    m_Localized: ¿Quién los mató?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490765
    m_Localized: Ten cuidado (Cuelga)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490782
    m_Localized: ¿Por qué se lo llevaron?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490783
    m_Localized: Qué bueno que no se llevaron a tu hija
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490784
    m_Localized: ¿Y qué es la AFAE de todos modos?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490785
    m_Localized: Cuídate (Cuelga)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490804
    m_Localized: Lo prometo
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490805
    m_Localized: No te puedo prometer nada
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490817
    m_Localized: Dos latas de EnerJeka, por favor
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490818
    m_Localized: Una lata de café, por favor
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490819
    m_Localized: Cambié de opinión. No ordenaré nada
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490830
    m_Localized: ¿Qué debería hacer respecto a los dientes?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490831
    m_Localized: ¿Qué debería hacer respecto a las uñas?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490832
    m_Localized: ¿Qué debería hacer respecto a los ojos?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490833
    m_Localized: Gracias. Ha sido útil
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490846
    m_Localized: ¿Cómo que quién?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490847
    m_Localized: ¿Por qué necesitas saber quién soy?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490851
    m_Localized: ¿No? ¿Por qué haría eso?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490852
    m_Localized: ¿Una rebanada de pan?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490856
    m_Localized: ¿No? ¿Por qué haría eso?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490857
    m_Localized: ¿Una rebanada de pan?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490861
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490862
    m_Localized: ¿Una qué personal?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490866
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490867
    m_Localized: ¿Una qué personal?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490870
    m_Localized: Solo tomo algo de té de kombucha, a veces.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490871
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490875
    m_Localized: Solo tomo algo de té de kombucha, a veces
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490876
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490884
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490885
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490890
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490891
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490900
    m_Localized: ¿Una tarifa?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490901
    m_Localized: Creí que esta llamada era gratis
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: ¿Una tarifa?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: Creí que esta llamada era gratis
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: ¡Le doy cinco estrelleas!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: Uno de diez
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: Váyanse a la mierda, malditos estafadores
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: ¡Le doy cinco estrelleas!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: Uno de diez
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: Váyanse a la mierda, malditos estafadores
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: Tu esposa me dio este número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: Tu esposa necesita ayuda
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: Perdió a todos los niños
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: ¿Están contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: Perdió a todos los niños
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: ¿Están contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: ¿Puedes venir a buscarla?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: ¿Puedes venir a buscarla?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: Resuélvanlo ustedes dos
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: Como sea, le diré que estás vivo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: Resuélvanlo ustedes dos
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: Como sea, le diré que estás vivo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: Tu esposo me pidió que te llamara
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: Olvidémonos del sermón. Se trata de tu esposo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: Quería que te dijera que lamenta lo que pasó
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: Quería que te dijera que te fueras al diablo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: Quería que te dijera que lamenta lo que pasó
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: Quería que te dijera que te fueras al diablo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: ¿De verdad crees que un grupo de fanáticos locos te entiende?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: ¿Por qué te uniste a un culto?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: Si tú lo dices
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: Hola. Tu hermano me dio tu número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: Llamo de parte de tu hermano
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: Sus padres desaparecieron
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: Vino aquí buscando refugio
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: No sé
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: Es lo más probable
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: No sé
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: Es lo más probable
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: Tu esposa y su hermana están en mi casa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: Tu esposa me dio este número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: ¿Por qué dices eso? ¿Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: Tu esposa está bien
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: ¿Por qué dices eso? ¿Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: Tu esposa está bien
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: Tengo a la esposa de un oficial de la AFAE aquí
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: Una altruista que quiere unirse a sus filas
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: Sí... es una amenaza
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: Quiere un puesto con ustedes. Solía trabajar en la frontera
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: Para directora
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: Rastreadora. O algún tipo de exploradora
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: Quiero mandar a un turista de vuelta a casa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: ¿Por qué no puede irse en tren?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: ¿Cómo se supone que voy mande a este pobre hombre a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: Lo tengo viviendo en mi casa. ¿Quizá podrían recibirlo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: ¿Cómo se supone que voy mande a este pobre hombre a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: Lo tengo viviendo en mi casa. ¿Quizá podrían recibirlo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: Ni siquiera habla mi idioma...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: ¿Para qué diablos sirven si no pueden hacer nada?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: Ni siquiera habla mi idioma...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: ¿Para qué diablos sirven si no pueden hacer nada?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: Oh, vaya, ustedes son unos héroes
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: Incompetentes
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: Oh, vaya, ustedes son unos héroes
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: Incompetentes
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: Ok, gracias
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: Vete a la mierda
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: Ok, gracias
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: Vete a la mierda
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: Una ventana a otra habitación. La gente solía hacer eso para ahorrar electricidad; para que la de un cuarto llegara al otro.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: Luego la sellaron... pero solo de ese lado.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: No, ya no miro hacia ese lado. No después de lo que pasó.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: Odio dormir junto a la mesita de noche. Me trae muy malos recuerdos...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: No entiendo por qué no está en la esquina. Creí que esa era la norma.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: Pero claro... A papá nunca le importaron un carajo las reglas.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: Toto. El único juguete que tuve cuando era niño.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: Bueno... a menos que cuente los palos que usábamos para golpear el césped.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: Je. La abuela tenía abarrotados los gabinetes repletos de platos.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: Solo sacaba la vajilla fina en las fiestas. Ahora... ¿quién carajos la necesita?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: La verdad, estoy mejor solo en casa.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: Hasta puedes hablar en voz alta contigo mismo.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: Es una de esas revistas en las que hay que encontrar a alguien entre la multitud...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: Qué molesto. Desearía que la gente me dejara en paz de una vez...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: 'Él me dijo en su momento: "Cuando ya no esté, decide si quieres abrir esa caja o no."'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: Llevo quince años pensando si hacerlo o no. Todavía no me decido.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: ¿Te sientes solo?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: ¿Estás ansioso? ¿No tienes a nadie con quien hablar?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: Entonces Phone Roulette es justo lo que necesitas.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: Llama ya al 891-533, y te conectaremos con el compañero de conversación perfecto.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: ¿Tu hija está bien?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: ¿Quién los mató?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: Ten cuidado (Cuelga)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: ¿Tu hija está bien?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: ¿Quién los mató?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: Ten cuidado (Cuelga)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: ¿A dónde se llevaron a tu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: Qué bueno que no se llevaron a tu hija
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: ¿Y qué es la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: Cuídate (Termina la llamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: ¿A dónde se llevaron a tu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: Qué bueno que no se llevaron a tu hija
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: ¿Y qué es la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: Cuídate (Termina la llamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: ¿A dónde se llevaron a tu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: Qué bueno que no se llevaron a tu hija
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: ¿Y qué es la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: Cuídate (Termina la llamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: ¿Qué? ¿La AFAE? ¿Qué es eso?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: ¿De qué está hablando?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: ¿Qué se supone que revise en las axilas?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: ¿Qué se supone que revise en los oídos?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: Hola
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: Hola
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: Está bien
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: No estoy listo para una conversación larga
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: ¿Dónde vives?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: ¿Por qué preferiste llamar aquí en lugar de a tus amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: ¿Por qué fuiste sola?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: ¿Extrañas tu hogar?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: ¿Por qué fuiste sola?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: ¿Extrañas tu hogar?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: No estoy acostumbrado a hablar sobre mí
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: Ni sé qué decir...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: Bueno... No tengo a nadie cercano
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: Me siento... solo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: Bueno... No tengo a nadie cercano
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: Me siento... solo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: Tuve... una relación difícil con mi padre
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: Es que... odiaba a mi padre
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: Ya no soy parte de la familia
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: Y un día, dejé de ser su hijo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: Todo lo que tengo es esta maldita casa
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: Ahora todo lo que queda de ellos es esta casa
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: Es cierto
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: Habría sido mejor que se quemara
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: Hola, ¿podría hablar con tu hija?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: Hola, ¿estaría bien si tu hija viene a jugar con su amiga?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: Aquí, su amiga preguntó si podía venir
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: Hay una niña aquí... su padre murió
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: ¿Cómo que "también"?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: No, unos enfermos lo quemaron vivo sin razón
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: (Cuelga)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: ¿Decidieron... matar a su propia hija?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: Carajo...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: Entiendo
    m_Metadata:
      m_Items: []
  - m_Id: 58690054376120320
    m_Localized: 'TV: Consigue tu comida a domicilio con For Rest. Llama ya al {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 58231803335401472
    m_Localized: Dos latas de comida para gatos, por favor.
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790080
    m_Localized: Un paquete de cigarrillos, por favor.
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790081
    m_Localized: Un frasco de kombucha, por favor.
    m_Metadata:
      m_Items: []
