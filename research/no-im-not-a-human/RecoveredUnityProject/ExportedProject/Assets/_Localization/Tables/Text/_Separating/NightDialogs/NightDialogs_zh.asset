%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_zh
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh
  m_SharedData: {fileID: 11400000, guid: 2e47acfd0901bcf4eba15f47b223778b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: 你好。*咳咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: 兄弟，能让我进去不？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: 你怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: 我是*咳*个消防员。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: 今天去林子里灭火，一不小心让太阳照到了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: 幸亏烟很浓，挡了点太阳光，没让我们在太阳底下活活烧死，但*咳*还是很吓人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: 树……*咳咳*都烧成用过的火柴棍了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: 那场面，我活这么久也是头一次见。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: 林子里到处都是冒着烟的动物尸体。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: 你怎么不去医院？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: 你打算怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: 我是下午灭火让太阳*咳咳*给照到的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: 整个队伍就我一个人跑了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: 其他人……*咳*上头不让走。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: 他们永远也下不了班了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: 你怎么不去医院？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: 你打算怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: 哪还有什么医院。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: 伪人一来，医院就成了摆设。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: 连治病的人都信不过，哪还能接受得了治疗。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: 没人会帮我。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: 我就不该跑。留下来救火跟朋友死一块儿算了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: 反正我也活不了多久了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: 进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: 你最好赶紧走。
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: 我就该留下来救火。死的是我不是他们该有多好啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: 可眼下这情况明摆着告诉我*咳咳*我完了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: 公共交通都停了，想回也回不去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: 只能指望着有人发发善心了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: 进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: 你最好赶紧走。
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: 谢了，兄弟。*咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: 我估计也麻烦不了你多久。*咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: 起码不用死在潮湿的地上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: 妈的，兄弟。*咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: 我真不想死在潮湿的地上。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: 希望*咳咳*火不会烧到城里。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: 欸，怎么样了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: 好久不见，日子过得还好吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: 我们认识么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: 真的假的你……不记得我了？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: 以前不是……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: 等会儿，说话声音不一样……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: 屋子原主人什么时候走的？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: 这屋子一直都是我们家的
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: 你搞错地址了吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: 噢……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: 你不是我朋友。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: 你在这儿住多久了？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: 这屋子一直都是我们家的
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: 你搞错地址了吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: 开什么玩笑。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: 怎么可能搞错！我记性好得很！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: 我朋友肯定……就住这儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: 那什么，我大老远来的，你看能让我进去不？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: 不可能，怎么会……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: 不会吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: 我靠……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: 看来我真搞错了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: 那什么，我大老远来的，你看能让我进去不？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: 这才像话嘛！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: 不是说好在你家比赛吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: 什么情况？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: 大老远过来你让我赶紧走？！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: 噢，我这就滚，你个疯子！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: 给我站直咯！不准动！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: 你好，拜托你帮帮我吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: 怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: 你有什么需要？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: 我累坏了，很想睡一觉。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: 本来有五个孩子，最后就只剩下这一个了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: 孩子他爸也不见了，不知道是死了还是扔下我们跑了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: 反正我这会儿就想躺下，睡上个几天。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: 其他几个孩子去哪儿了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: 其他几个孩子都死了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: 我真的累坏了，让我进去睡一觉吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: 本来有五个孩子，现在就剩这一个了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: 不知道其他几个去哪儿了，也不知道该上哪儿找，我就想好好睡上一觉。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: 其他几个孩子去哪儿了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: 其他几个孩子都死了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: 不知道，说不定让孩子他爸带走了。我想去他家看看，可想进也进不去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: 嗐，我们以前三天两头吵架。可是你跟个成天犯浑的人住一起，哪能不吵？你说跟这种人过日子，能过得下去么？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: 想也知道过不下去。眼下要紧的还是找到我那几个孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: 别这么说。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: 小孩子闲也闲不住，就爱乱跑，还不是一个是好几个，叫人怎么看得住？不过……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: 他们没出什么事。说不定都在我妈那儿呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: 跟我待烦了，或者孩子他爸又来找我要钱了，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: 他们就爱往我妈那儿跑。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: 你能让我进去不？我就想歇歇脚，休息好了去找我那几个孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: 总算能歇会儿了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: 快，赶紧进去，小心点儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: 我们明天就走。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: 行，那我就去我妈那儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: 说不定压根到不了……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: 不行，到不了也得到。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: 屋主，你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: 我心情不好，先给你道个歉。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: 这附近的蠢货太多了。希望你脑子不蠢。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: 你说的蠢货是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: 那你也不是两条腿的野兽吧？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: 所有人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: 那帮只有信仰或者别的什么玩意儿束缚的蠢货。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: 上帝为他们死了，他们的人性也就没了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: 都他妈成了畜生。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: 光是伪人就够我们受的了……又冒出来一堆没了人性的玩意儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: 你情绪怎么这么激动？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: 你跟他们有什么区别？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: 问得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: 你肯定也发觉了吧？眼下……有两种人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: 一种人是挨千刀的虐待狂，比什么伪人都要坏。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: 这种人活得随心所欲。拿枪指着人脑袋，扣动扳机，砰一下把人打死，眼睛都不带眨的！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: 另一种就是牲口。他们逆来顺受不说，还会谢谢你没杀他们。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: 这两种人都让我气得够呛。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: 你情绪怎么这么激动？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: 你跟他们有什么区别？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: 你别往心里去。我就是……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: 太阳发了疯，伪人又冒了出来，人性好像也跟着上帝一起死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: 我那个气呀……我就想干点儿平时干的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: 我是个写歌的，眼下都这样了，写了也没人要。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: 我努力不让自己变成那两种人里的任何一种。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: 我也想相信我跟他们不一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: 我一想到自己变成虐待人的疯子，或者任人宰割的羔羊，吓得魂都没了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: 这两种人都是垃圾。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: 不过……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: 还是当羔羊惨一点。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: 他们就待在那儿一动不动，等着挨揍，让人揍掉牙呀什么的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: 你要是见过我见过的，你就知道我气什么了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: 放宽心，我不会打搅别人的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: 也不会打人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: 我怒气都发泄在自己身上，别人就不用受这份苦了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: 妈的，你跟那群怂货一样，烂透了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: 你就坐那儿让人家照着脸抽吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: 他妈的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: 我感觉到这儿的能量凝滞不前。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: 这可太不妙了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: 太阳、狮子座、第五宫……我明白了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: 你是个强势的人，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: 啊？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: 我什么都不需要。
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: 我看出来了，你是个行动派。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: 典型的狮子座。我没说错吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: 你这儿积了一大堆让人不舒服的黑暗能量。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: 暂时还没弄明白为什么。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: 一切都乱了套了，我看还得从正向肯定开始。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: 你他妈干嘛全推我身上？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: 好吧，那你的意思是……？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: 什么意思都没有。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: 这么说吧，我能帮你理解因果关系。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: 业力第六至第九阶段，就像两条鱼绕着彼此打转。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: 所谓一报还一报，帮你就等于帮我自己。听明白了么？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: 你他妈干嘛全推我身上？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: 好吧，那你的意思是……？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: 你是摩羯上升，听了我说的肯定觉得压力很大，我都理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: 你这个人比较复杂，能同时平衡好几个星座带来的影响。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: 可以用正向肯定来帮你抵达自身宇宙深处。这下听明白了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: 这么一来，一切就会井然有序。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: 你家里有人当过狱警，你前世也当过。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: 给它们留点空间吧，你只不过是在重复前世的生命体验。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: 你得原谅，得接受它们。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: 这么一来，你就能打破这无尽循环的枷锁了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: 明白了么？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: 很好。说实话，你所处的位置非常有利。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: 屋里有股能量在流动。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: 这么说来，你对自我成长一点兴趣都没有么？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: 你就不想成为更好的自己么？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: 真是可悲啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: 我要用正向肯定让你拉肚子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: 晚上好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: 我是应急中心的，特地过来帮各位的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: 你一个人来的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: 我凭什么相信你？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: 当然不是。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: 我们是组队来的，但是为了扩大搜索范围，又分成了小队行动。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: 聊几句就走，占用不了你多少时间。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: 你为什么穿着防护服？我们也得穿么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: 你怎么帮我们？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: 我可以给你看证件。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: 而且伪人很少成群结队。说不定他们根本就不会组队行动。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: 你为什么穿着防护服？我们也得穿么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: 你怎么帮我们？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: 不用。但是你觉得有必要的话，也可以买来穿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: 我们在研究太阳活动对环境造成的影响。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: 经常在太阳底下活动，自然是小心为上。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: 你们接下来打算怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: 你们有什么行动计划么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: 我们要做的第一件事，就是收集数据，提交给上级。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: 他们会制定响应程序。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: 你们眼下只要保持冷静就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: 你们接下来打算怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: 你们有什么行动计划么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: 我会从你这儿带一个人回去做检查。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: 主要是确定这个人情况良好，这片区域适合人类居住。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: 当然了，也会确认一下这个人是不是人类。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: 那我也得收拾一下跟你们走么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: 那我等消息就行了么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: 当然了，我们也不是乱来。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: 我们会从你这儿带一个人回实验室做检查。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: 做几个小测试，确定没问题，就会把人送回来。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: 那我也得收拾一下跟你们走么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: 那我等消息就行了么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: 你是屋主么？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: 是的话就不用，安心跟屋子里其他人待着吧。要疏散我们自然会来通知。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: 我们就从你这屋里带一个人走就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: 祝你好梦。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: 对。该掌握的信息都掌握了，就会发出指示。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: 反正眼下没什么好担心的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: 我们只带走一个人就行。没什么事，就会尽快把带走的那位送回来。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: 保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: 又见面了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: 我记得上回的情况不一样，不过我们还活着……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: 唔，有点奇怪，我也不知道该怎么解释。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: 我看这次的对话……就从一个小动作开始吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: 你能帮我用书算个命么？帮我挑一页就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: 开头挑一页
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: 中间挑一页
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: 最后几页里挑一页
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: “死者会复生，与我们讲述，可无人相信死者所述之事。”'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: 噢……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: 这句话还是有意义的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: 不过这也没什么好奇怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: 这句话是什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: 你真信这句话？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: 你是什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: 我？我就是我。你？你在家里。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: 嗯，是个悲剧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: 前方等着我们的就是一出悲剧吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: 很有可能。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: 这句话是什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: 你觉得这句话说的是真的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: “那是很久以前的事了。说不定只是个梦，说不定你、我，还有那条鱼……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ……都只存在于某个早已不在的人的记忆之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: 说不定谁都没有真正存在过，外面只是在下雨而已。”'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: 唔，没准这句话说的很快就会成真。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: 你觉得呢？我们是早就已经成了某个人的梦，还是即将成为某个人的梦？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: 这句话很有意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: 这句话是什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: 你觉得这句话说的是真的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: 我得好好想想。你对此有什么看法？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: 总之，我过来是要告诉你件事。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: 有些事不久之后就会发生……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: 你得做好准备。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: 我知道这话听着有点奇怪，不过有个带着猫的人会过来，你到时候得让那人进去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: 那个人能帮到你。至于怎么帮，我现在还说不好，只知道放人进屋里肯定对你有好处。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: 信息我是传递到了。具体怎么做，还是你自己说了算。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: 我现在得去好好想想，你帮我挑的那一页上的话是什么意思了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: 不完全是。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: 最好是把它当成个建议，这样你就不会忘记要做点什么了，或许还能让你集中注意力。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: 我正琢磨这句话，脑子里忽然冒出来个念头。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: 很快就会有个带着猫的人上你这儿来。你得让那人进去，这件事非常重要。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: 至于为什么，我现在还说不好。不过这样应该会让事情变得简单很多。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: 我现在得去好好想想，你帮我挑的那一页上的话是什么意思了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: 喂，人类。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: 我们真是太走运了！能亲眼见证人类欲望招致的惩罚！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: 太阳将会履行职责，净化大地的一切污秽。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: 我们会迎来洁净的新世界！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: 看哪！这他妈的是天降的恩赐！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: 什么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: 吓我一跳。
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: 没什么好意外的，人类。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: 听好了啊，我给你简单说明一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: 太阳灼烧我们，那不是白烧的！都是为了燃尽罪恶，救赎人类！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: 人类把地球搞得一塌糊涂，太阳震怒了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: 给了我们应得的报偿！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: 这是天降的恩赐。涤荡了罪恶，我们就能过上理想的生活了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: 你是说，我们都得死？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: 那你会怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: 你脑子是不是不正常？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: 听好了啊，我给你简单说明一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: 太阳灼烧我们，那不是白烧的！都是为了燃尽罪恶，救赎人类！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: 人类把地球搞得一塌糊涂，太阳震怒了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: 给了我们应得的报偿！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: 这是天降的恩赐。涤荡了罪恶，我们就能过上理想的生活了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: 你是说，我们都得死？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: 那你会怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: 恰恰相反！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: 罪恶会消失，太阳说不定也会不见，但我们不会死。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: 不会有死亡，不会有人偷东西，也不会再有贪心的混账东西抬高价钱坑我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: 你能想象得到么？你知道这一切意味着什么吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: 跟我有什么关系？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: 只要有太阳相助，我们都会过上幸福的生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: 太阳会助我们逃离地上的困苦，你明白吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: 你肯定明白，不然早死了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: 我晚点给你细说！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: 对了，忘了问，你家有啤酒吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: 我说了这么多，你还是装作对太阳履行职责一事一无所知？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: 滚你妈的蛋！我渡别、别人去！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: 拜，拜！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: 你好！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: 对不起，这么晚还来打扰你……今天实在是太热了，电视里说白天最好别出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: 你这儿有没有什么地方能让我待一待？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: 你怎么到这儿来的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: 呃，我以前住在靠近城市的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: 外面的柏油路烫得要死，嘿嘿，嘿嘿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: 我以前是收银员，后来不是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: 他们，呃，把我开了，我工作一直都不太顺利……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: 那你现在打算怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: 你觉得以后会怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: 我其实也没打算到这儿来。柏油路热得都化了，不过这不是最惨的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: 唉，说出来你都想笑。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: 伪人把我从家里赶出来了。呵……你想想看！那可是我家！他们倒把我赶出来了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: 我眼下只想找个能躲太阳的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: 那你现在打算怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: 你觉得以后会怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: 唔，想办法活下去吧。太阳快把人晒死，到处都是伪人，我都快吓死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: 但是我真的很想活下去，嘿嘿，哎哟，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: 你就不害怕吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: 求你了，快告诉我这一切很快就会结束的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: 不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: 我能活下去吗？谁会来救我？我得找多久才能找到能帮我的人？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: 我不知道以后会怎么样，猜都猜不出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: 你就不害怕吗？我怕得要命。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: 谢谢你！太谢谢你了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: 我又能多撑会儿了，感谢上帝！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: 哈哈，呃，好吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: 总之谢谢你听我说话。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: 呃，好吧，我该走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: 再见？呃，再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: 能不能让我进去？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: 我原本躲在酒吧里，但是……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: 他们把我赶出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: 为什么？唔，不是每个人都受得了我这脾气。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: 别担心，我不会伤害别人，只不过……日子总有过得不顺心的时候，反正就那么回事。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: 怎么样，能让我进去不？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: 你不是伪人吧？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: 你确定不会给我惹麻烦？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: 你以为我也是那种怪物？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: 我当然不是了。不过这种问题能直接问么？你见人就问也太荒唐了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: 好吧，反正我在你这儿肯定不会像在酒吧里一样了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: 酒吧里的人为什么赶你出来？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: 你怎么就觉得在我这儿就不会惹事了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: 惹事？惹什么事？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: 我没胆子跟人动手，更别说杀人了。但有谁想伤害我，那也没门儿……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: 我就喜欢吃吃喝喝，高兴了跟人聊两句，这算惹麻烦么？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: 酒吧里的人为什么赶你出来？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: 你怎么就觉得在我这儿就不会惹事了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: 我脑子里冒出来几句不太好听的话……不过想了想，还是这么跟你说吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: 都说了，酒吧的人不喜欢我。谁知道那都是些什么人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: 这么一想，赶我出来也挺好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: 那帮人真把我生吞活剥了都没人在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: 我现在怎么办，就这么在大太阳底下烧死？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: 告诉你，晒死谁都晒不死我。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: 我只要还有一口气在，就会继续找人，拍门。你不让我进，那我就上别处碰运气去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: 世界这么大，说不准我就走运了，能碰见个没那么混账的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: 谢了，如今这世道，信任一文不值。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: 谢谢你信任我，说不定……唔，我什么也保证不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: 唔，我理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: 我理解，不过我还是很生气。你就跟这儿的其他人一样，也是个胆小鬼。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: 祝你能睡个好觉。妈的，去死吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: 我能在你这儿歇歇脚吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: 你是从哪儿来的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: 你接下来要去哪儿
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: 我记不得了，也不在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: 我累坏了，再不休息，我就得死在你家窗户下面了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: 你同伴病了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: 你朋友需要帮助吗？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: 我……我只想找个地方倒下去，再也不用起来。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: 至于最后会去哪儿，我一点也不在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: 你同伴病了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: 你朋友需要帮助吗？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: 那是我丈夫。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: 他死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: 我这会儿也没法好好埋葬他，可就这么扔下他也不好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: 不需要了。他需要的时候，也没人帮他。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: 结果他死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: 有人真在乎他死活……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: 他说不定就不会死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: 我不会待太久的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: 喘口气就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: 你……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: 哟！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: 外面的情况你看见了么？真他妈吓人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: 你这儿怎么样，还好吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: 你有什么需要么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: 出什么事了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: 没什么，好奇问问。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: 那什么，我有个来钱快的法子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: 太阳这么大，不用费什么力气就能赚到钱。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: 那群胆小鬼怕得要死，其实动手开干就完了，怕个屁啊！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: 你来找我干嘛的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: 你有什么建议？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: 新机遇啊，你这他妈都看不出来？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: 所有人都跟无头苍蝇一样，四处乱跑，但是他们其实只要照着心里想的去做就行了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: 我意思是，他们都该开心点儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: 你来找我干嘛的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: 你有什么建议？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: 动作够快的，直接上正题！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: 大家都觉得你要在这儿搞什么事情，搅混水。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: 我们可以在这儿搞一场这辈子最疯狂的派对！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: 你想活下去对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: 那就得抓紧时间制定计划，让太阳见鬼去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: 得采取点儿行动，懂我意思不？怎么样，要不要一起？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: 好哇兄弟，你上道了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: 总算碰上个有脑子的人了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: 你就是个蠢货。算了，蠢货关我什么事？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: 你不开窍，我就找你邻居去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: 拜了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: 那什么，好久不见，日子过得还好吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: 跟以前一样
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: 还好
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: 我有点担心你，就过来看看。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: 跟你说，要出大事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: 我表姐给我打了个电话，说新闻里说太阳不太对劲。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: 地底下爬出来一堆人，大家都叫这种人“伪人”。也不知道为什么，反正就这么叫。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: 挺渗人。希望不是真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: 太阳怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: 伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: 我有点担心你，就过来看看。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: 跟你说，要出大事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: 我表姐给我打了个电话，说新闻里说太阳不太对劲。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: 地底下爬出来一堆人，大家都叫这种人“伪人”。也不知道为什么，反正就这么叫。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: 挺渗人。希望不是真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: 太阳怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: 伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: 不是太阳自个儿要爆炸了，就是上面有什么东西要爆炸了……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: 反正我只知道太阳出问题了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: 今年夏天比往年都要热，你发觉了没？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: 我觉得我们得做好最坏打算。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: 我表姐说，一个人待在家里很危险。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: 想起你一个人在家，怕出事，就赶紧过来你这儿了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: 我能照顾好自己
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: 那你老婆和女儿呢？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: 对，就地底下爬出来的那堆人。大家都这么叫。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: 天知道为什么要叫“伪人”。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: 我猜是因为他们不是地球人吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: 也有可能是因为他们无视人类社会的规则，老想进人家屋子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: 我表姐说，一个人待在家里很危险。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: 想起你一个人在家，怕出事，就赶紧过来你这儿了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: 我能照顾好自己
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: 那你老婆和女儿呢？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: 行，就先聊到这儿，我们明天早上再继续聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: 我记得你家有个挺大的客厅，不介意的话，今晚我就睡那儿了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: 明早见。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: 我知道。不过眼下一个人待着，比你想的要危险多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: 以防万一，今晚我就在你这儿睡一晚吧？这样我心里也踏实。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: 我老婆和孩子你就不用担心了。我有个朋友前几天刚来我家做客，他会帮我照顾好家里人的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: 行，就先聊到这儿，我们明天早上再继续聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: 我记得你家有个挺大的客厅，不介意的话，今晚我就睡那儿了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: 明早见。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: 不用担心，我有个朋友前几天刚来我家做客，他会帮我照顾好家里人的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: 行，就先聊到这儿，我们明天早上再继续聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: 我记得你家有个挺大的客厅，不介意的话，今晚我就睡那儿了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: 明早见。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: 你好！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: 我爸爸在你这儿吗？能不能麻烦你去叫一下他？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: 白天还不怎么吓人，晚上就吓人了，很多人趁着晚上跑到外面去……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: 你爸爸叫什么名字？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: 跟我说说你爸爸的事。
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: 你忘了他叫什么了？啊，我知道了，你是在试探我，想看看我是不是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: 好聪明啊！我也要试探下身边的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: 你过来的路上没出什么事吧？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: 你怕伪人吗？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: 唔，能说的可多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: 他出门前喜欢喝点儿啤酒，嘿嘿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: 爸爸给我留了午饭和晚饭，还有果汁。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: 我今天还喝了点儿他平时喝的啤酒，哕，难喝死了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: 都有果汁了，为什么还要喝这东西？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: 噢，你可千万别告诉他我偷喝了啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: 你过来的路上没出什么事吧？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: 你怕伪人吗？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: 唉，世界乱了套了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: 大家白天都躲在家里，不是睡觉就是干别的，到晚上才出来活动。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: 我还是不太习惯黑暗，不过好像也没什么好怕的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: ……还是说，我想错了？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: 我去叫你爸爸过来。祝你好运！
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: 祝你今天过得开心！
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: 不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: 大家都怕伪人，我也怕，不过我还没见过伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: 伪人是不是很吓人？他们是不是会对人类下狠手？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: 那我学校里玩得好的同学打了我，是不是说明他也是伪人？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: 爸爸叫我小心点，我去哪儿都特别小心！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: 我轻手轻脚的，谁也没看见我。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: 我去叫你爸爸过来。祝你好运！
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: 祝你今天过得开心！
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: 谢谢，你也是！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: 那我们这就走啦。我很怕晚上一个人在外面。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: 等到了家，我就跟我爸爸一起玩游戏。掷个骰子……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: 然后在椅子或者沙发之类的家具上走来走去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: 再然后，就得开出条路来！反正我回头玩给你看！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: 再见！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: 你、你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: 让我进去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: 你情绪怎么这么激动？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: 怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: 我、我不知道、该、该怎么办。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: 有人，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: 啊，啊，啊，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: 杀，杀，杀了……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: 我，我，我，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: 爸、爸爸。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: 谁干的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: 为什么杀你爸爸？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: 啊，啊，啊，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: 我，我，我爸爸，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: 啊，啊，啊，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: 我爸爸，被人，杀了，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: 谁干的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: 为什么杀你爸爸？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: 伪、伪人，进了我家，坐在屋子里。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: 爸爸跟、跟、跟伪人说了几句，伪人就杀了我爸爸。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: 他……我……*呜呜*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: 我家，着，着火了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: 我不、不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: 伪人跟我爸爸坐、坐、坐在厨房里。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: 他们做、做、做了件什么事，之后就放、放、放火烧了我家。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: 我拼命跑、跑，伪人就在那儿笑。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: 你、你、你能不能、帮帮我？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: 我、我吓坏了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: 我、我、我还能去哪儿？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: 哇，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: 呜哇，'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: 我、我吓坏了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: 你好！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: 你有什么需要么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: 我不会让你进来的
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: 房子挺大。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: 我喜欢。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: 我什么都不需要。
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: 我有枪
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: 你家门够结实不？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: 这世道……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: 你懂的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: 我什么都不需要
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: 我有枪
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: 是是是，知道啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: 所以呐……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: 就你一个人在家？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: 还有别人
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: 对，就我自己
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: 妙极了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: 绝望能让怂包长胆，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: 不过我说……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: 真就你一个人？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: 说了不是一个人
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: 嗯，就我一个
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: 今天算你走运。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: 你屋子里是有嘀咕声。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: 但过几天会怎么样，那谁知道？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: 哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: 我知道你是一个人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: 就想看看你会不会撒谎。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: 我要开门了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: 哟，宝贝！大老远走到你这儿来，我都快累坏了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: 我能在你这儿歇歇脚吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: 你是直奔我这儿来的吗？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: 你走了很久吗？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: 那肯定不是。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: 不过谁也不是谁的过客，能碰见，那就是命中注定要碰见。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: 我到你这儿来了，那就是我这双眼睛和这两条腿自己带我来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: 想来都是命数。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: 没听明白。你需要什么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: 那你可以继续走啊，为什么在这儿停下了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: 说不上来有多久。多久算久？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: 你看看你，在家里不还是转来转去的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: 那你是不是也走了很久？我看肯定是。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: 不过我走过的桥啊，比你吃的盐还多。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: 就是这么回事，宝贝。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: 没听明白。你需要什么？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: 那你可以继续走啊，为什么在这儿停下了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: 人能需要个啥？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: 听几个故事，讲讲有意思的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: 然后舒舒服服躺下闭会儿眼。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: 好好喘口气。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: 这样就够了。一个人活着太没劲了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: 你这孩子，怎么跟没听见我说的话似的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: 我不说了么，走累啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: 想着起码在这儿歇歇脚，说说闲话就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: 对我这老太婆来说，这就够解闷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: 你说点儿啥，我也说点儿啥。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: 然后我就能合会儿眼……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: 谢谢啦，宝贝！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: 我在你这儿估计不会无聊，起码还能看看这附近有什么新鲜事。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: 我上哪儿都吃闭门羹。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: 翅膀折了，可我这嗓子还得唱呀。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: 不过，那帮人拒绝我的时候说得那么斩钉截铁，到最后还是得不情不愿的，回过头来找我。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: 我这人不记仇，谁求都帮。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: 你迟早也要找人帮忙。等到了那时候，你找谁去？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: 你好。来，先在我身上靠会儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: 那什么，我们能进去吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: 你同伴病了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: 你们两个都病了，还是就一个？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: 她是我妹妹。不是病了，是抑郁了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: 她走路喘气都困，有时候连床都起不来。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: 不过没事的，总有一天会好起来的，你说是吧，妹妹？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: 她现在没心情说话，但是偶尔又能打起点儿精神。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: 接下来有什么打算？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: 整天这么背着她，不累吗？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: 谁不抑郁，顶多有个程度深浅之分。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: 早在太阳还没出问题那会儿，我们就知道事情会变成这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: 新闻你没看么？天天看的话就知道，这世界迟早会变成现在这样。不过我倒是不觉得太阳会爆炸。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: 接下来有什么打算？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: 整天这么背着她，不累吗？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: 我得找个地方，让我妹妹缓一缓。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: 然后我们两个再一起开始新生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: 你觉得我们要玩儿完了么？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: 我不觉得。总会好起来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: 说话稍微注意点。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: 累是累，但你想让我就这么扔下她不管么？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: 我们是一起从父母家出来的，现在就剩下彼此了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: 谢谢！来，帮我扶她进去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: 父母这一走，让她变得更虚弱了。其实她这个样子很久了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: 说不定在这儿待着能好些。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: 哎哟，妹妹，我们得换个地方试试，看看能不能找着愿意收留我们的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: 来，帮把手。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: 看在上帝的份上，等这一切结束了就……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: 我们出发去救火之前，上头在工作场合给我们的。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: 他们想让我们去应急中心的隔离区。不过去了的没一个能活着出来，谁还乐意去那地方……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: 喏，反正我也用不上了。扔了还是给人拿去用，随你高兴。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: 我有份，咳咳，重要文件。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: 你愿意让我进屋里安静走完最后一程，那文件就归你了……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: 行，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: 不行。文件你自己留着吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: 搞什么鬼？啊？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: 我看你也是个普通人，给你罐劲能佳，你说不定就能改变主意？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: 把自己弄到这儿来可真是累死我了！这活儿就不是人干的！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: 行，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: 来，说好的劲能佳！谢谢你让我进来！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: 我操……他妈的……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: 我真的……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: 这样，你放我进去，我就给你罐劲能佳，行不行？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: 这样大家都他妈的开心了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: 行，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: 赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: 别担心……我就是……靠……算了……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: 给，劲能佳。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: 我才不需要这破玩意儿。补充什么精力，我缺的不是精神头，是冷静。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: ……屋里的人都弯着腰，静静地呼吸，生怕碰着那个人。我一看这样就知道，{0}在屋里。我受不了这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: 跟那人待在一块儿我都讨厌。要么让那个人滚，要么就我滚，只能两个里面选一个。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: 要我跟一句话不说的人待一块儿，我受不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: 没问题。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: 最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: 好极了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: 谢谢你，关键时刻还敢吭声。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: 我努力一下……嗯，你懂的。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: 行吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: 还是跟有经验的一起混比较保险，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: 我他妈管你去死！下地狱去吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: 这是神圣太阳亲自赐予的慷慨奖赏！凡人，拿好劲能佳！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: 再蠢也得有个限度吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: 你赶走的是一位义人！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: 让我进去，就能得到神圣太阳的恩赐！再考虑考虑吧，朋友！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: 行，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: 赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: 没人知道最后一位伪人到访后发生了什么。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: 反正自那以后，这栋屋子就荒废了很久。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: 你忽然失踪搞得人心惶惶，大家都躲着你住过的那栋屋子走。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: 欸，老朋友……{0}，你住的是什么地方哇？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: 一会儿聊起来，吵吵嚷嚷，一会儿又有人对着影子小声说话……这地方太渗人了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: 你以为我一个人四处游荡是找乐子么？周围生面孔多，又吵，我受不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: 你要更喜欢那个人，那就跟那个人待一块儿吧。我就在门廊这儿待着，等这阵变革的风停了再说。你别生气，瞧这外面暴风雨呼呼的，这种天气我可不会出门。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: 不行，受不了了……我要崩溃了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: 没问题。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: 最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: 那样的话，我试试。不过我要是再闻到暴风雨，或者镜像一样的两个谎话精的味道，我就不在这儿待了。老了，折腾不动了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: 我感觉自己不属于这儿……嗐，收拾下故事，继续流浪吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: 不过你要睁大眼睛。真相往往安静，但也致命。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: 求你了……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: 求求你了，让我们进去吧，哪怕就待一天也行。我们有东西可以给你……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: 反正不会让你白放我们进去的。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: 行，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: 赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: 太谢谢了！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: 这罐劲能佳给你。我们全身上下就剩这个了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: 来，搭把手，扶我妹妹进去……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: 还是算了，{0}在屋里。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: 屋子里的空气异常沉重，好像其他人脑子里的声音比我的还要大。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: 她受不了这个，身子开始……一缩一缩的，好像要从世界上消失了一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: 我……我在这个人旁边，呼吸起来也困难。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: 不好意思，等……等一切平息了再说吧。说不定很快就消失了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: 没问题。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: 最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: 谢谢，小心点，一定要用手扶好她的背……像这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: 父母不在了……她多少受了点打击，心里塌了一块儿，但还是尽最大努力撑了下来。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: 我们在外面游荡了好一阵子了。我是想着，她在这儿待着，起码能舒服些……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: ……好吧，明白了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: 小妹，来，再坚持一下，就快到了。来，靠着我，有我在。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: 有时候觉得一切压得我喘不过气来……就一扇普通的门都能压得我难受。不过我们还是得继续走，来……迈一只脚，再迈一只……走吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: 唉……真遗憾。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: 非常感谢。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: 我不收贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: 那个{0}在这儿。我不确定我们能不能处得来。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: 抱歉，先生，恐怕我还不能进来。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: 好吧，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: Couple:怎么傻站着？快来啊，亲爱的，这位先生都请我们进去了。
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: 现在能让我进了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: 行吧。这个{0}够吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: 我习惯了，你打的什么算盘我也看透了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: 唉，混蛋总是那么走运。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: 还有时间。我去找找别的能待的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: 好吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: 谢谢，我没抱什么希望，但心里还是希望你能把人赶走。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: 但我不会跟这种人待在一个屋檐下的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: 说来话长，我也不打算全倒给你听。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: 噢，{0}在这儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: 我不收贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: 好吧，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: 怎么样，能不能通融一下？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: 看看我找到了什么，是{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: 来，我给你……我这儿有什么来着？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: 算了。最后一次上这种当。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: 老兄，你让我想起那些气人的银行。真操蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: 好吧，那我走了，太阳还没那么快出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: 哎……行吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: 为债务的消亡干一杯，怎么样？哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: 这才对嘛！'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: 我这辈子够倒霉了。咱们至少能让这儿清净点吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: 看见那边那人了吗？就是{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: 没门儿。你这儿有个要搅黄气氛的家伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaler: 好的，我明白了。保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: 不过很感谢你的信任！'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: 什么？！谢谢！其实你没必要这样的……有必要的话，我可以找别的地方落脚。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: 但是我恐怕不能跟{0}待在一块儿，心里会不太舒服。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: 我知道我已经占用了你不少时间。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: 说实话，我觉得自己没错。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaler: 太谢谢你了！但是……我以前在咖啡店兼职，跟人发生过摩擦，那个人就在你屋里。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: 我不收贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: 好吧，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: 好吧。那我要是能给你点儿东西，怎么说？你看，{0}怎么样？好了，能让我进去了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: 算了，这儿你说了算。我走就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: 你真的觉得嘲笑人家外貌的人能留在你屋里？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: 谢谢，我真的再也没法忍受这种事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: 你这儿有{0}在。以前成天因为我长相欺负我的，就是这种人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: 不好意思，我觉得我不能进去。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: 要是你身边围着一群混蛋，那你八成也不是什么好东西！嘻嘻！'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: 也许不跟你待一块儿反倒是好事。没错……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: 真的假的？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: 不该掺和进疯~狂~的破事儿里。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: 听着不太靠谱。不过……好吧！嘻嘻！'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: 很好……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: 我清楚得很……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: 他可是个真真正正的疯~子~。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: 我知道一个月前发生了什么事。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: 哦……你这儿收留了{0}啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: 你自己多保重，行吗？希望你能熬过去。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: 好吧，朋友。我明白。别往心里去。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: 靠。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: 我知道……这样轰人走是挺难堪的。但这就是生活嘛，有时候不能总当老好人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: 对，我指的就是那个{0}。我们是不是该……请这人出去？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: 老兄，说真的我跟谁都能处得来。但这家伙实在够呛，从头到尾全是危险信号。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: 太……太让人失望了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: 没想到你压根没有。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: 搞什么鬼？我还以为你是个有骨气的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: 你一赶就把人赶走了，看来那人也没什么反抗的力气。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: 哼，没想到你真把人赶走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: 要么让这人滚蛋，要么我自己走。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: {0}在你屋里？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: 好吧，我最好赶紧走。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: 完了……应急中心的人会找到我的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: 我真希望从没来过这儿……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: 完了……我还能去哪儿？这儿一带我都挨家挨户问过了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: 多谢。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: 求你，让我在你这儿待一阵吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: 我现在没地方去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: 我在酒店住了一阵子，但钱用光了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: 没……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: 但既然来了，我又住不起酒店。求你，让我在你这里待一阵吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: 对，我明白。相信我，要是早知道太阳会出事，我绝不会来。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: 你真没别的地方可去了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: 你这观光时机可真会挑啊
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: 我真的只是路过。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: 可他们关闭了边境……现在我困在这儿了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: 我本来要去首都，计划旅行来着……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: 你真没别的地方可去了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: 你这观光时机可真会挑啊
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: 机场关了，火车也停了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: 出了点差错。我出不了城了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: 你怎么会到这儿来的？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: 怎么回事？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: 欸，你好，能帮帮我吗？我不是本地人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: 好吧。我得走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: 附近还有别的房子。也许有人能不盯着我的脸看，当回体面人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: 这周真是够呛。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: 那我们明天再聊。今天我可累趴了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: 好极了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: 最糟的是听到报道后，发现你得把恐怖程度乘以五……甚至可能十倍。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: 反正看电视也解决不了问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: 不知道你这儿有没有电，不过如果没有，反而更好。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: 这里晚上空气会凉快些。而且没人24小时盯着新闻看。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: 我就省去客套，直说重点了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: 那当然。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: 我可不想留在最容易被波及的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: 我觉得我们要迎来一场大乱子。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: 拖得越久，情况越糟。空气污浊，犯罪激增，公寓楼里的人都疑神疑鬼，出事是早晚的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: 再说，我感觉城市很快就不安全了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: 我只是不喜欢客套。直接点好办事。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: 你怎么觉得我在躲什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: 你觉得这儿能更好些？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: 你在躲什么？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: 我长什么样不代表什么，也没想要害人。希望你不是那种以貌取人的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: 我可没干什么坏事。你瞥我这一眼如果是为了给我下判断，那可以省省了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: 怎么这么冲？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: 你觉得这儿能更好些？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: 你在躲什么？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: 好像疯子和伪人还不够似的，现在太阳也来整我们了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: 而且不只我们这儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: 只是……我听说城郊出了些乱子，情况很不好。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: 不是，我不是说你这里看着荒废了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: 你胆子不小啊
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: 看起来没人吗？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: 哦，原来有人啊。介意我进来吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: 呃，我再想想办法，太阳还没那么快出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: 操。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: 一点机会都不给？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: 你根本不知道今天对我有多重要！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: 这就对了嘛！咱们开几罐庆祝一下！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: 你到底让不让我进去？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: 我要是有这么个房子，那可就美梦成真了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: 随便吧。反正欠债的又不是你，对吧？毕竟你这地方挺不错的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: 我能说什么呢？你明显没有为我高兴。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: 看来你不怎么爱说话啊
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: 说实话，我不喜欢这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: 得，这话听着真够阴阳怪气的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: 看来你不怎么爱说话啊
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: 别想多，没别的意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: 说实话，我不太想在公开场合谈这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: 啧，问得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: 那你打算用省下的钱做什么？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: 好吧……那你来这儿干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: 感觉爽翻了！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: 现在世界一团乱，谁还管什么银行、贷款啊！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: 我一分钱都不欠了！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: 但是现在！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: 一切都糟透了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: 哦，我欠了一屁股债。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: 那你打算用省下的钱做什么？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: 好吧……那你来这儿干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: 我感觉自己总算能喘口气了，你压根不知道这是种什么样的感觉。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: 朋友……不对，兄弟！我再也不用为房贷操心了！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: 哎哟，别这样嘛！你只是还没明白过来而已！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: 怎么这么兴奋？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: 你是疯了还是怎么着？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: 多美好的夜晚啊，你说是吧？你感觉到了吗，空气中充满了纯粹的魔力！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: 欸欸欸，你好！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: 好吧，我理解。保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: 好人不是只在童话故事里有，现实里也有，能亲身体验到这点真是太好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: 太谢谢你了！我不会忘记你这份恩情的！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: 好吧，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: 我从来没想过成年人的生活会这么难熬……可我没别的地方可以去了……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: 我总有一天会报答你的，而且我现在就能帮你的忙，只要是我能做到的，我都愿意。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: 我知道我没什么能给你的……但是求你了，再想想吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: 我明白了……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: 赶紧走，我这儿不需要吃白食的
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: 好吧，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: 我估计当不了救世主，但是这种故事的结局都是一样的，正义终究会战胜邪恶。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: 要是有英雄挺身而出，击败眼下蔓延的邪恶，一切都会恢复正常。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: 大家吓坏了，找地方躲起来，不再信任任何人……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: 这些事就像我们从小听到大的童话一样，就是邪恶在全世界蔓延开来。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: 但是我觉得我没什么变化，起码没有想伤害别人的冲动。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: 我身上可能有些地方符合伪人的特征，我也说不好，最近不管什么事都变得很诡异。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: 说实话，我到现在也不太确定伪人到底是什么，怎么分辨伪人和正常人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: 赶紧走，我这儿不需要吃白食的
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: 好吧，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: 我在重新站稳脚跟之前，会尽力帮你的忙的。我保证，总有一天会报答你。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: 我不想成为别人的负担，但是日子不好过，想要活下去，再不愿意做的也得做。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: 赶走我以后，他立马让他同父异母的家人搬了进去。我不是说要怪他，但是我希望你能理解一下我的难处。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: 伪人冒出来以后，他把我赶了出去，说因为我没有稳定的工作。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: 我房东一开始就不肯租房给我，因为我是个刚毕业的学生，没有稳定收入。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: ……就像小时候一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: 大环境不好，日子不好过，大家只想暂时把这一切抛在脑后……希望自己能无忧无虑的，哪怕只有一会儿也好。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: 在夜店找到活儿干的人算运气好了。毕竟现在的整体情况对他们更有利。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: 但是大灾难降临之后，大家都不去咖啡馆了，老板把店里的员工都给裁了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaler: 我刚从大学毕业，但是学的专业不好找工作，只能去一家小咖啡馆打打工。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: 我怎么知道你是不是伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: 你怎么到这儿来了？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaler: 晚上好。不知道你这儿能不能再收留一个人？我不会提太多要求的。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: 行，不让就算了，我走就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: 谢谢你让我进去……还有，没因为我这副样子大惊小怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: 那你让不让我进？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: 因为我知道自己到底是什么人。我真的不是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: 那你让不让我进？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: 随便你。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: 你怎么能确定自己不是伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: 到底是不是呢？我们拭目以待
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: 我跟你说了，我不是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: 什么叫“不然呢”？你冷静一下行么，你以为我是自己想变成这样的？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: 你怎么能确定自己不是伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: 到底是不是呢？我们拭目以待
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: 我明白，但我真的不是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: 不然呢？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: 如今这个世道，每个人都疑神疑鬼的
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: 我这是天生的，改不了，但是不知道为什么，其他人觉得我是伪人。真是疯了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: 问题就出在这儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: 不然呢？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: 如今这个世道，每个人都疑神疑鬼的
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: 其他人老觉得我是得了什么传染病，甚至……觉得我是伪人……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: 我天生就这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: 不用！我没什么毛病，你不用担心。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: 你身上怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: 我应该担心么？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: 你好，呃，希望我这副样子没吓到你，能让我进去么？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: 嘻嘻。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: 看看你这样会落得个什么下场……记住我的话……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: 你跟那些穿白大褂的……折磨人的家伙没两样。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: 是个有点不正常的小怪胎？嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: 所以……你也觉得我疯~了~吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: 有个地方能让我在这个乱世躲一躲了……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: 终于！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: 而且，我听到附近有枪声。但是我觉得你应该挺重视安全的。对吧……？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: 现在我试着……跟新认识的人相处！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: 有个针对我的混蛋……活该落得了那样的下场……但我现在更小心了。嘻嘻！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: 所有人都针对我。一个个的混蛋，针对我……从上学那会儿就开始了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: 什么朋友？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: 我宁可回酒店去。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: 所……以……我真的不想再去碰钉子了！嘻嘻！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: 他们帮过我一次，但现在才不在乎我死活！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: 我对他们来说算是个意……外吧。哎呀一下，我一不小心就来到这个世界上了！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: 你没有朋友吗？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: 你为什么不去亲戚家？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: 我晚点……再告诉你。嘻嘻。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: 酒店房间太小了。让……我想起……不太好的回忆。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: 你的房子够大，什么样的人都能容下。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: 这儿挺好。这儿更好。嘻嘻。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: 你没有朋友吗？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: 你为什么不去亲戚家？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: 应急中心来过，然后他们走了……不见了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: 我没证据，没有没有没有……但我觉得她是个伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: 她让我害怕，嘻嘻。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: 那儿有个穿黄色雨衣的女孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: 我不喜欢那儿。宁愿换个……地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: 你觉得我这儿更好？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: 为什么？你就不能直接回去吗？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: 我害怕……不想回去，能在你这儿待待么？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: 我住在希望酒店，但我决定出来走走。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: 抱歉，我有点儿紧……张。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: 嗨。嘻嘻。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: 你自己多保重，好吗？希望你能撑过去。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: 好吧，朋友。我明白了。别往心里去。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: 你回头来找我，好吗？我有一肚子夸张刺激的故事，保证让你大开眼界，哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: 天呐，朋友，你真是救了我一命。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: 总之，我不会成为累赘的。我会把所有事都告诉你，不过……先让我进去吧，朋友。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: 她只是想保护我，什么都没告诉我。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: 是冲我妈来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: 误会了，他们不是冲我来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: 加上这该死的太阳，一切都乱套了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: 但现在……我……唉，谁也联系不上了。人人都有自己的烂摊子要处理。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: 他们人不错，总是愿意帮忙，一起喝一杯，或者只是凑一块儿打发打发时间。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: 都是戏剧圈的人。我们一起喝酒，瞎混，互相照应。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: 这么说，有群气冲冲的人在追你？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: 都是些什么朋友？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: 我以前和妈妈还有外婆住一起，但我们被赶出来了。唉，讨债的上门了……整个就是一团糟……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: 我原以为自己朋友很多，想着我们能一起熬过这关……可现在只剩我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: 能让我在这儿待上几天吗？其他人要么不在家里，让人赶了出去，要么就是……谁知道出什么事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: 欸，朋友！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: ……混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: 真是个……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: 唔，算在我意料之中吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: 真不让进？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: 你这是在试我么？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: 我们找时间好好聊聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: 我们的生活在分崩离析，但是说真的，能来这儿，我还是觉得非常荣幸。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: 太好了！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: 人生就是把不可能变成可能的过程，没什么事是轻轻松松就能做成的。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: 只有拼一把才能活下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: 我就是觉得，我们要是干坐着，任由事态这么发展下去，人类就完了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: 哎呀，给你留下不好的印象了的话，实在不好意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: 人类经历过更可怕的灾难，现在为什么要放弃？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: 不过我绝对不是走投无路。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: 噢，你想知道我为什么上你这儿来？哈，谁知道呢，没准儿我真是个疯子。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: 什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: 听你说话觉得你像个疯子
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: 你也是走投无路了么？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: 不管付出什么代价，我们都一定要活下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: 听说了这么个地方，我怎么可能当不知道？我觉得我们的想法是一样的。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: 还说，你不会让伪人夺走属于你的东西……也就是生命。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: 说要在你这儿活下去不是什么容易事。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: 听你说话觉得你像个疯子
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: 你也是走投无路了么？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: 但你跟那两种人都不一样。你不会坐以待毙。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: 胆大点儿的用枪指着脑袋，砰一声一了百了，胆没那么大的，什么都不做，待那儿等死。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: 绝大部分人早就放弃了。他们太弱了，活不下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: 我是说真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: 呃……他们是怎么说我这儿的？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: 呃，谢谢？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: 不过我挺尊敬你的。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: 来你这儿的，不是走投无路……就是脑子不好使。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: 绝大多数人躲着你这儿走。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: 我听说过你。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: 我这儿有{0}，给。不算什么了不得的东西，但是希望能帮上点忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: 太谢谢你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: 哎呀……抱歉，你这儿收留了{0}。我实在信不过那种人……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: 我不收贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: 好吧，进来
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: 我这儿有{0}，你看，能不能通融通融？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: 我不想撞上巡逻队，更不想碰上伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: 不要，求你了……让我进去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: 给，我这里有{0}。不算什么，但希望能帮上忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: 太感谢了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: 我不想被送进去。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: 但我听说他们要把感染的人送到隔离区……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: 他们有天突然出现，说必须要检查所有人。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: 应急中心的……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: 我真的不想被送进隔离区。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: 他们开始把人聚集起来……我……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: 应急中心的……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: 你宿舍出什么事了？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: 我原本住在大学宿舍，但出了点儿事，在那儿待不下去了……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: 是的。求求你……如果方便的话，就让我进去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: 你宿舍出什么事了？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: 宿舍已经回不去了……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: 对，找个落脚的地方。我没别的地方可去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: 来找庇护所？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: 你有什么需要吗？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: 你好。能让我进去吗，求求你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: 明智，伙计。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: 就是那个{0}。这种人我很了解。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: 那什么，伙计，你屋里头有个顶坏的杂种。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: 再见，蠢货。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: 呵，你这人可真够没劲的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: 聪明，伙计。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: 行了，废话够多了。让不让我在这儿落脚，嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: 身无分文，家里老娘们儿跟别的混球跑了，我连个能遮风挡雨的地方都没有。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: 刑期一到，大门敞开。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: 我当然想待里头，可你觉得有人问过我意见吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: 行了，废话够多了。让不让我在这儿落脚，伙计？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: 荒郊野外的没混混盯梢。好地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: 然后我瞅见这地方——干净，安静，地图上都找不着。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: 身无分文，家里老娘们儿跟别的混球跑了，我连个能遮风挡雨的地方都没有。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: 没地儿可去啊，伙计。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: 为什么不在牢里待着？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: 你来我这儿到底想干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: 看来又得流落街头了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: 现在呢？这鬼世界全疯了。太阳晒得跟要把我蛋烤熟了似的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: 本想多待阵子，可他们把我踹出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: 在里头蹲过几回了，伙计。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: 为什么不在牢里待着？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: 你来我这儿到底想干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: 我嘛，见识多了。走出监狱大门，第一件事就是把这身累赘扒了。现在喘气都舒坦。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: 穿得跟下雪天似的到处走。一群小丑。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: 这还用问么？外头热得跟炼狱似的。搞不懂其他人咋还没明白过来。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: 你他妈打哪儿来的？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: 你怎么只穿条裤衩就在外头晃？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: 能让我进去么，兄弟？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: 你不让我进，自然有人让我进。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: 靠。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: 不过没有吉他……总还是差点儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: 好耶，摇滚起来吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: 我说的就是那个{0}。把这人赶出去，行么？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: 不行，我不想跟这种小人待一块儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: 我去问问，看能不能在朋友家过个夜。希望当初的朋友还有几个活的好好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: 理解。嗐，别放心上。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: ……放不放，弹不弹，都听你的。这地方你说了算！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: 谢了，我时不时会放放歌，希望你不介意。我要是有把吉他，还能给你弹两首曲子听听。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: 说实话，我要是伪人，早踹开门进屋里了，不然就是从窗户爬进来，怎么会站在你家门口……问你让不让我进。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: 这群杂种，连我吉他都给砸了。这世道把人变成了畜生。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: 我弹了一晚上吉他，累得够呛，有群疯子忽然闯了进来，偷我们的东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: 因为我真没合过眼。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: 听说他们在附近发现了个伪人，现在忙着挨家挨户检查。我是没什么所谓，只要别有人吓崩溃，做不理智的事就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: 没什么可疑的东西，就几瓶水，还有一台小音响。你会用吉他弹节奏快的即兴重复段，我就借你用。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: 你怎么跟一个礼拜都没合过眼一样？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: 你身上带了些什么东西？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: 眼下的情况一团糟，就跟在破酒吧里接待一线明星，还没人维持起码的秩序一样！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: 啊，对，吃白食的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: 让我在你这儿待上几个晚上就成，我不会一直赖在这儿不走的，我不是那种……呃……叫什么来着……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: 欸，开个门呗。太阳盯着人照，跟聚光灯似的，再这么下去，我眼睛非晒瞎不可。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: 挺有意思的，有机会我也想加入试试。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: 然后全扔进火里去！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: 听说有个疯子召集了不少人，给他们洗了脑，'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: 我上别处去，看看其他地方的人在干什么。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: 无聊，去哪儿都一样……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: 好吧，回见。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: 有点儿好奇他靠这套把戏捞了多少钱。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: 听说有个人在卖空气，有意思！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: 没事，我上别处转转。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: 行，那我把我知道的跟你好好说说！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: 不好意思，我就是觉得这样怪有意思的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: 哈哈哈，我都不知道那个人是谁。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: 算了，不说这个了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: 有这种人在，我不想开口说话。他们喜欢曲解别人说的话，搞的一团乱。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: 哇，{0}在你这儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: 我不收贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: 好吧，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: 喏，{0}，要不要？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: 不然给你这个……等会儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: 劲能佳要不要？别的也有，我东西多着呐！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: 嘁，倒霉。等会儿，我身上带了不少东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: 你讲我就来。我也有一肚子故事，咱俩好好聊聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: 附近发生的事你会跟我好好讲讲的，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: 太好了！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: 说了这么久，我在你家门口站也站累了，你放我进去，我把一路上看见的都告诉你。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: 说实话，这两种办法都不聪明。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: 大家吓坏了，不是不敢开门，就是端起枪，谁动打谁。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: 我去过很多地方，只有那么几个地方算是有意思，绝大部分地方没什么区别。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: 我不都说了么，世道乱了，我在观察其他人是怎么活下去的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: 你压根没听我说话。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: 让不让我进去待会儿？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: 不过你这地方挺有意思的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: 我会一直跑，一直找。不管找的是什么……我都会跑到我找到为止。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: 然后我就一直跑呗。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: 你是不是在躲谁？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: 然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: 哎，我看咱俩应该交换一下保命的诀窍。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: 不过我不是也没事么！看来咱俩都找到了活下去的办法。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: 唔，你能喘气，还能跟我说话……确实没什么事。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: 你待在你屋里哪儿也不去，是不是以为这样就没事了？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: 你是不是在躲什么东西？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: 然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: 去他的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: 孤零零地咽气。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: 而且等着我只有一个结局。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: 到底有没有呢？我待在公寓里不出来，这辈子也不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: 比方说，没准儿人类最后的希望就藏在你屋里？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: 我走得越远，越有可能找到解决办法，你还不明白吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: 找地方待着？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: 去哪儿都跑不掉，麻烦还是会找上门来
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: 就没想过找个安全的地方待着？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: 我晚上才赶路。白天太阳升起来想把我烤熟？我早找地方躲着了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: 别问我藏哪儿了，反正手里的劲能佳够我挺上好一段时间的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: 我有的是劲能佳，怕什么。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: 去哪儿都跑不掉，麻烦还是会找上门来
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: 就没想过找个安全的地方待着？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: 太阳会把我晒成人干，伪人会把我生吞活剥，管它哪个先来，没出事我就会一直走下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: 暴风雨就要来了，我有点儿好奇，想看看其他人会怎么应对。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: 很远的地方。不能在一个地方待着不走。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: 我这儿没有充电器
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: 你给自己充电是要上哪儿去？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: 我现在很烦躁，但是劲能佳没那么管用了，想在你这儿充个电。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: 哟！屋里有人，太好了！'
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: 跳过简介
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: 我会把你说的人赶出去的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: 如果不能立刻将高度疑似伪人的个体送到隔离区，请给对方一张应急中心收治函，届时会有工作人员上门强行收治。'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: 看来节日还是降临了……'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: 孩子……这可不妙……'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: 还有别人
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: 就我一个人
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: SuperFake:就你一个人在家？
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: SuperFake:好吧……
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: SuperFake:你现在就一个人，没亲没故的，还有什么好留恋的？
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: SuperFake:干嘛还绷这么紧，死死抓着生命不放？
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: SuperFake:……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: Vigilante:剩下的日子没多少了，好好珍惜吧。
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: Vigilante:……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: Vigilante:我这趟过来，该干的都干完了。我们不会再见了。
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: Vigilante:检查完了。
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: Vigilante:耳朵？耳朵算个什么东西？！伪人的特征里就没有耳朵！
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: Vigilante:耳朵？耳朵算个什么东西？！伪人的特征里就没有耳朵！
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: Vigilante:……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: Vigilante:伸出手来看看。
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: Vigilante:……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: CultistPriest:永别了。
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: CultistPriest:……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: 好吧，我们不会强迫你改变自己的选择。死亡会索回它应得的一切——只不过是时间的问题罢了。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: 我早就已经想要获得安宁了……我会跟你一起走的
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: 要是你已经活腻了的话，请自便——不要带我一起去
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: 来参加我们的仪式吧，为自己寻得安宁——如何？一同踏上这趟向往死亡的神圣征程。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: 作为回报，我可以赐予你救赎……'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: 好了，再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: 一定很辛苦吧，不仅是你，还有我们。要是这个街区就连半个人都没有的话，我们到底怎么检查？'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: 就你一个人？'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: 再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: 唉……好吧。也许，我只是在浪费时间而已……'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: 你好，我亲爱的朋友。你是不是……忘了我交代你的事情？难道，你没看到《微笑指南》中的提示吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: {0}——只要能让我进去，你就能获得这份由伟大太阳亲自给予的丰厚奖赏。如何，改变主意了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: 这，是由伟大太阳亲自给予的丰厚奖赏！收下吧——都是你应得的，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: 你我……还会相遇。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: 然而，我是不会死的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: 将人置于死亡边缘？既不公正、也不道德。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: 你得知道：'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: 也许，你我……都是不死之人。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: 像你这样的人，一定可以在这场噩梦之中存活下来。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: 现在，已经没有几个人愿意认真听别人说话了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: 谢谢。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: 我知道伪人究竟是从哪里来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: 而且，我会把一切都告诉你。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: 我向你保证，只要等到应急中心离开了，我就会继续上路，寻找女儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: 政府可不想让大众知道这些事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: 我知道了一些……不该知道的东西，应急中心在追捕我……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: 我需要找个地方住上几天。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: 先等一下！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: 我知道伪人究竟是从哪里来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: 而且，我会把一切都告诉你。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: 然后，我就会继续上路，寻找女儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: 能让我在这里借住几天吗？只要待到应急中心离开了就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: 要真是这样的话，他们应该不会动她一根手指头。毕竟，他们要找的人是我。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: 我的女儿说不定是被那群混蛋抓到了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: 其实……我知道了一些不该知道的事情。因此，正在被追捕。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: 离这里很远。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: 去应急中心找不到我们的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: 她不在这儿，再见
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: 你们要去哪里？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: 一旦找到了她，我们就会立即离开这座城市。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: 我不知道她去了哪里。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: 自从这一系列的烂事开始之后，我就一直在打听她的下落。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: 说话注意点儿，她是我的女儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: 她不在这儿，再见
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: 你们要去哪里？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: 不光没有留下字条，甚至找不到任何一点的痕迹……我的女儿凭空消失了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: 醒来之后，发现家里空无一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: 突然，一股异常的热浪袭来——我昏了过去……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: 我们本正准备离城……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: 自从这一系列得烂事开始之后，她就下落不明了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: 她是我的女儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: 妓院在另一条街上
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: 我们这里没有这样的人
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: 请问……这里有没有一个披着斗篷，紫色头发的女孩？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: 你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: 房子不对。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: 抱歉。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: 味道不对，声音不对。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: 房子不对。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: 抱歉。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: 味道不对，声音不对。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: 需要我帮忙找你的家吗？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: 你在找什么？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: 归根到底，大家……真的需要父母吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: 我根本就没有父母。我从来都没有父母。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: 我的父母？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: 需要我帮忙找你的家吗？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: 你在找什么？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: 我听到了脚步踩在地板上发出的吱呀声。也就是说——有人正在等待。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: 我本来需要厨房的灯光。然而，这里……却有着不同的回响。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: 黑暗之中，每扇门看起来都一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: 你的父母呢？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: 你走丢了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: 他应该睡的……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: 他还没睡吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: StaticBoy:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: CultistPriest:看好我的人。记住，死了一个……屋子就别想要了。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: 回见。我还会回来看看情况的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: CultistPriest:你以为有选择余地？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: CultistPriest:回见。我会回来看看他们的情况的。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: CultistPriest:他们耽搁不了你多少时间，不过请你务必看好我的教徒。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: CultistPriest:多谢。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: 我会赶走你说的人的。进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: CultistPriest:他们会妨碍我们的事业。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: CultistPriest:{0}
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: CultistPriest:{0}
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: CultistPriest:很好。不过，你得先把屋里几个人请走：
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: Courier:祝你有个愉快的夜晚。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: Courier:这是你的订单：{0}。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: Courier:取货吧，我走了。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: Courier:受够了。只希望能早点结束。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: Courier:这鬼日子……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: Courier:应急中心天天早上拿枪指着我们检查。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: Courier:整天看着一张张疲惫阴郁的脸……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: Courier:记得有人说过送快递能分散注意力，可现在好像没用了。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: Courier:唉……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: Courier:取完货我就走，免得你也崩了我。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: Courier:哦，你是说我朋友死得好？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: 我很抱歉
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: 别无选择
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: Courier:这是你的订单：{0}。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: Courier:赶紧取货，我这就走。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: Courier:呵，多谢建议。真他妈有帮助。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: Courier:得走了。取货吧，我该撤了。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: Courier:说不定明天就说阴毛是伪人特征，全世界直接玩儿完。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: Courier:以为够糟了，结果一天比一天荒唐。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: Courier:伪人、特征、该死的太阳……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: Courier:好？大灾变后哪还有"好"？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: 是男人就活下去，别像废物一样哭哭啼啼
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: 别焦虑，会好的
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: Courier:这是你的订单：{0}。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: Courier:好了，你该收货了。要取吗？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: Courier:反正毕业了也没人雇佣，读书有啥意义？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: Courier:算了。送快递也没那么糟。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: Courier:是是是，你屋里一群人当然说得轻松。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: 真不幸
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: 独处也不错
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: Courier:况且家人都不在了。我是自己一个人来这儿上学的。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: Courier:……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: Courier:你订的东西，{0}。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: Courier:抱歉扯远了。收货吗？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: Courier:有人一下单就是20升水。这重活该有危险津贴或小费才对……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: Courier:但这见鬼的太阳，逼得我们全改夜班。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: Courier:现在送快递赚得不少，虽然风险怎么算都大。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: Courier:管他末日不末日，饭总得按时吃。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: Courier:没想到有人末世都不囤货。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: 我不收贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: 好吧，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: GraveDigger:{0}，行不行？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: GraveDigger:想要什么？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: GraveDigger:天啊！不给好处不让进是吧？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: 我不收贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: 好吧，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: Marauder:啊！找到了！{0}。收下吧，房东，让我歇到天亮就成。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: Marauder:刀得留着……绷带也得留着……唔，有个旧酒瓶，可惜是空的，
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: Marauder:哎，别急着赶我……先让我翻翻包。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: Wolfhound:如今强权当道。要么顺从，要么被反噬。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: Wolfhound:明智之选。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: 我来处理。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: Wolfhound:想保住这地方就赶她走。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: Wolfhound:那位是{0}在取暖吗？一眼就看出是披着羊皮的狼。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: 我不收贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: 好吧，进来
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: Twins:{0}。拿去，可能用得上。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: Twins:我们有个，什么东西来着？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: 嗯……我知道了。你并不了解我们，觉得我们可能会把你卷进什么麻烦之中。我可以保证——我们并不是这样的人。我的姊妹……她现在真的很不好过。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: 因为，他们令我想起了我们的……父母。现在的这个环境……对她的病情来说，并不是很好。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: 我很担心……有他们在，我妹妹只会痛苦。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: 看来，你已经收留了{0}、还有{1}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: 我没有自信能跟他好好相处。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: 你知道吗？在遇到我的丈夫之前，我……唉，这么说了——他令我想起了很多我并不愿意去想起的人。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: 我……恐怕实在是没有办法与这种家伙待在同一个屋檐下。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: 你收留了{0}……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: 然而，现在——她最需要的是安宁……以及他人的关怀，绝非这种赤裸裸的恶意。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: 我能感觉得到，我的姊妹正被对方的流言蜚语所困扰、所淹没。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: 哎呀，你收留了{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: 就是这样！早就跟你说过了——像这种家伙，只会带来接连不断的麻烦。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: 快点把他赶出去，将地方让给我吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: 唉，这么说了——这个家伙，只会害你一事无成。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: 哎呀……看看这是谁？真没想到，竟然能在这里碰上{0}！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: 谢谢……我不会待太久的——只要休息一下、稍微喘口气，仅此而已……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: 我没有办法跟他这种人待在同一个屋檐下。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: 不行。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: 你收留了{0}？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: 谢谢你愿意向我伸出援手。不过……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: 我不收受贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: 好吧——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: 如何，感兴趣吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: {0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: 我想帮你。或许，我刚好带着一些你需要的东西也说不定。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: 我不收受贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: 好吧——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: 如何？能否向我们伸出援手呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: {0}——不知，是否合你心意？只要我的爱人能够得到片刻的休憩，我可以心甘情愿地放弃自己的一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: 我们刚好带着一些东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: 说到这个……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: 我非常、非常地爱她。就算全身上下只剩一件衬衫了，我也会毫不犹豫地脱下来给她。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: 我的妻子并不是一个意志十分坚强的人，很容易就会疲惫不堪。而我……则愿意为她做任何事情，你应该能理解吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: 希望你不要介意我像现在这样死缠烂打，只是……试着站在我们的角度想一想，好吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: 我不收受贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: 好吧——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: 瞧瞧，我的双脚就是最好的证明——什么都没有，对吧？哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: 一定管用！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: 哎呀，不愿意让我进去？没关系，很好处理！来，拿着这{0}吧。只要在门前挥一挥，嘭的一下——别人就看不见你啦！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: 我不收受贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: 好吧——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: 瞧瞧——{0}！就像在游戏里面一样，对吧？需要先建立一点联系才行。我懂，老兄——我懂！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: 好吧，这样如何……我刚好带着一些东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: 拜托，老兄……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: 我不收受贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: 好吧——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: 我想，应该是{0}。你拿去吧。我起码需要一天的时间来好好缓缓、休息一下。只是……看起来不太可能了……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: 我……我带着一些东西。稍等一下——'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: 我不收受贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: 好吧——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: 如何，应该还不错吧？我们……能就此达成协议了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: 来，拿好——这{0}送你，聊表本人心意！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: 好吧、好吧……我已经看穿你在玩什么鬼把戏了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: 我不收贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: 好吧，进来
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: Bestson:我，还有口香糖。只剩几片了，都给你……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: Bestson:你是不是想要点儿什么东西？{0}行吗？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: Bestson:我，我真不知道怎么办了，
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: 我不收贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: 好吧，进来
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: Fugitive:求你了，不然我真会死在这儿！
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: Fugitive:兄弟，我身上的东西全给你。{0}怎么样？路上捡的。真没别的了。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: Fugitive:快让我进去。要么我流血死在你门口，要么你让我进去帮我包扎。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: 去你的吧。我找你的邻居去——再也不见，白痴。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: Wifefema:你他妈有什么毛病？我掏心掏肺说这么多，你就这态度？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: Wifefema:开什么玩笑？我老公可是联邦应急管理局的！
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: 我不收受贿赂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: 好吧——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: Wifefema:你自己掂量哪个划算。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: Wifefema:不愿意？我跟我老公打声招呼，明天穿黄制服的就来突击检查——文件、警犬，说不定天天早上都来。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: 我也不跟你说多的，喏，我把{0}给你，你让我进去。怎么样？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: 我鼻子灵得很，谁是伪人，谁是人类，我一闻就知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: 我只希望至少在这儿能睡个安稳觉。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: 我会赶走你说的人的。进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: 我在梦里见过那家伙，说真的，一次就够受了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: 这儿可容不下我们俩。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 谢谢，不过……看来我的位置已经有人了。瞧，{0}在这儿。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: FormerFema:再见。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: FormerFema:唉，我都不知道还留着它干嘛。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: FormerFema:估计是这身制服吓人。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: FormerFema:好吧，我懂了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: FormerFema:没想到你真会让我进来。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: FormerFema:真的？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: 我会赶走你说的人的。进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: FormerFema:你要是能让那人出去，我保证安静待着，谁都不打扰。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: FormerFema:你看，我穿这破制服穿了一天了……只想脱掉洗个澡，冲掉身上的脏东西，还有……别人的血。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: FormerFema:噢、噢……{0}在浴室里。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: FormerFema:等会儿。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: FormerFema:什么？噢，谢了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: GraveDigger:啊，谢了兄弟！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: GraveDigger:我确实想进来，但是……你懂我意思吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: GraveDigger:靠，{0}在你屋里了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: 啧……问了总比没问好吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: 靠，还以为能喘口气呢。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: 呵。这才像话。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: 就那儿，看见没？那个{0}。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: 欸哟，温馨小窝已经有人了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: Provocateur:具体租赁条款我们稍后详谈。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: Provocateur:感谢你，房主。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: Provocateur:宪法第28、48和7.3条对你来说算什么？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: Provocateur:你知道这人明显违法了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: Provocateur:嗯，看来你这儿已经有人了。{0}。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: TaxiDriver:我知道你有难处，不过，你这也太狠了……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: TaxiDriver:欸，有空欢迎来找我聊聊。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: TaxiDriver:呼，谢了，伙计。真是帮了我个大忙！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: 我会赶走你说的人的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: TaxiDriver:反正你得选一个。留谁？留屋里的人还是留我？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: TaxiDriver:呵，那人让我想起折腾我家里人的人……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: TaxiDriver:那什么，你别误会，你屋里有{0}了是吧？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: 一切尘埃落定之后，把我的尸体留下吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: 虽然不太清楚你对美的理解是否与我一致，不过……告诉我吧——你应该不会把尸体弃于门外，对吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: 而我，则是为了聆听末日的寂静之声。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: 虽然，我的确想要进来……不过，你已经收留了{0}。看来，对方依旧沉浸于对未来的憧憬之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: （他点了点头、走进了屋里）'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: Foreigner:（他似乎不喜欢{0}。他指了指那人，又指了指自己，然后再次指向那个男人）
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: 呜呜呜——唔唔唔……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: 要是走运的话，应该可以在附近找到住处……如果有需要，随时来找我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: 我能理解。如今这个世道，疑心难免。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: 谢谢。希望，我能帮上一点忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: 最好还是让他去找真正能帮得上自己的人吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: 我无法给他提供恰当的护理。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: 唔，看来你收留了{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: 我先在这里休息一下，再慢慢赶路。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: 宝贝，能帮我这没用的老太婆拿一张凳子来吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: 天啊！真是帮了我这把老骨头大忙！只是，害得你把对方给赶出去了、实在是令我有些过意不去……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: 既然你已经收留了其他的人，我想……我还是在门口稍微坐坐、喘一口气，然后继续上路好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: 要跟这种家伙打交道，一定很不简单——对吧，宝贝？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: 天啊！看来，{0}已经坐在了椅子上。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: 不要……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: 我、我好害、害怕……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: 我、我根本就不、不认识其、其他人……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: 离、离开？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: 爸爸——！爸爸——！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: 我要爸爸……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: 我……我一定要坐在那里！好不好嘛、好不好嘛、好不好嘛！爸爸经常会坐在那里……他就是这样告诉我的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: {0}已经在那里了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: 我……不、不要——我没有地方可以待了！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: 随便你，我去找别的蠢货去，反正这附近的蠢货多得很。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: 靠，胆小鬼……我打从一开始就知道，跟你这种人处不来！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: 好极了！对了，有空的话就过来一趟吧，我有点儿事跟你说。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: 赶紧轰出去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: 哎哟，你收留了{0}。要知道……这种废物榨不出钱来，也榨不出故事来。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: 没错——前往某处……远离人群……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: 好吧，我这就走。也许……太阳能赐予我些许温暖。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: 我能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: 谢谢。相信我，这样会更加安全。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: 我……我很害怕跟人待在同一个房间里面。总是……会有不太愉快的事情发生——无一例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: 谢谢……哎呀，不好。既然{0}在这里，我是不会进去的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: 妈的。看来，你也是个滴酒不沾的怪胎。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: 好吧。起码，这次事情能如我所愿。来带路吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: 最先被轰出酒吧的，就是这种家伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: 把{0}赶走再说吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: 好吧，哈哈……我这就走。唉，也没差了——不管怎样，太阳都会把我们给通通烧死……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: 谢谢。我会老老实实的。只是——不要把门关上，好吗？哈哈，为了以防万一……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: 又或者是……把人赶出去？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: 你能不能……检查一下？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: 我……我实在没有办法跟这个人待在一起。万一对方是个伪人，该怎么办？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: 你、你收留了……{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: 明智之举。起码，我知道自己在做什么——要是那个……东西出现了的话，我会帮你。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: 我能闻到对方散发出非常浓厚的血腥味。完全搞不懂你为什么会放这种家伙进来……难不成，你喜欢玩命？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: 你收留了{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: 我会去拯救其他人，而你——就烂在这里吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: 将光明……不对，将启明拒之门外是一项非常、非常严重的罪孽！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: 去你的吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: 我会在这里坐一阵子……呜呼！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: 好极、好极！接受伟大太阳的祝福吧——愿它护佑着你！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: 他的阴影……不对，光是这个异端之徒的存在、就会令正义之光熄灭！我们得把他给轰出去！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: 人类！太阳告诫过我——如果{0}躲在里面，就千万不要进去。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: 我能感受到一股纯粹的能量流经这栋房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: 太好了。说实话，你这里有着得天独厚、极其罕见的玄奥资源。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: 我会赶走你说的人的，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: FortuneTeller:必须除掉他，否则星象将汇聚成灾。你明白的吧？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: FortuneTeller:{0}。想到什么了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: FortuneTeller:哦……我能感觉到……如此浓重压抑的气息。一道阴影……它强大到足以毁灭我们所有人，毒害整间房屋！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: Luka:记得照顾好自己。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: Luka:等到那时候……情况很快就会急转直下。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: Luka:老盯着悲伤，会被它吞噬的。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: Luka:别老沉浸在悲伤里。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: Luka:那样的话……你脑子里说不定就不会只有想死这一个念头了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: Luka:希望你还记得开心是什么感觉。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: Luka:谢谢。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: 我会赶走你说的人的。进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: Luka:你要是能帮我腾出点儿空间来，那就太好了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: Luka:我谁都不想赶。唉，谁知道呢，说不定人家比我更需要有个地方喘气。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: Luka:我很想进来，但是你屋里已经有{0}了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: Couple:腿呐，赶紧挪一挪，动起来！你累我也累啊。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: Couple:我们会继续找的，你说是不是，小宝贝儿？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: Couple:明白了。不好意思，打扰你了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: Couple:这么害羞啊。没关系，很快就能好好休息一会儿了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: Couple:怎么傻站着？快走啊，人家都请我们进去了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: Couple:太感谢了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: 我会赶走你说的人的。进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: Couple:我老婆不喜欢小孩子。嗐，没想到这儿还有年纪这么小的。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: Couple:那什么，我不是故意为难人，但我们实在……不能带着孩子和{0}一起住。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: Couple:那个人是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: Couple:……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: Couple:太感谢了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: Anger:真他妈该死。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: Anger:坐在那里忍气吞声直到窒息。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: Anger:操，你和那些懦夫一样可悲。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: Anger:……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: Anger:我只折磨自己。不会伤到任何人。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: Anger:也不会砸东西。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: Anger:别担心，我不会冲别人发火。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: Anger:不了。我不想和那个怪胎待在同一个鬼屋檐下。我会崩溃的。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: Anger:{0}在你这儿？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: Mother:不，应该还来得及。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: Mother:可能已经太晚了……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: Mother:好吧。我现在去看看能不能赶到我丈夫那里。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: Mother:别傻站着。快进来，人家不会永远等着你。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: Mother:啊，完美。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: 我会赶走你说的人的，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: Mother:你说不定可以……呃……让那个人出去？这样孩子终于能睡个安稳觉。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: Mother:嗯……你这里有{0}。我孩子已经够害怕了……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: Ballerina:看见那毛球了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: Ballerina:……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: Ballerina:不是跟你说话。我在跟猫说话。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: Ballerina:来吧小猫咪，现在你要陪我玩了对吧？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: 我会赶走你说的人的，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: Ballerina:嗯，他们告诉我那东西不该在这里。赶紧让他走。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: Ballerina:你这里有{0}？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: Teacher:多谢。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: 我会赶走你说的人的。进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: Teacher:对不起……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: Teacher:……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: Teacher:看到这种人，我就会想起……那些人……还有……我收留的那些孩子……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: Teacher:我不能跟这种人待在一个屋檐下。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: Teacher:不好意思……{0}是不是在你屋里？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: Dude:照顾好自己……和你家人。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: Dude:没关系，伙计。我理解。不怪你。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: Dude:……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: Dude:老天啊……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: Dude:这才像话！牛逼上天了！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: 我会赶走你说的人的。进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: Dude:咱们真得把这人轰出去！这家伙太扫兴了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: Dude:靠，那人在这儿，屋里的气氛好不了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: Dude:等等……那个{0}是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: Dude:喔，伙计，够意思！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: Blind:不然，它会找到你的。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: Blind:看在上帝份上，天黑以后，千万别靠近焦尸。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: Blind:我这就走，但是……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: Blind:多谢。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: 我会赶走你说的人的。进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: Blind:我还是找别的地方待吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: Blind:抱歉，哪儿不对劲说不上来，但我敢肯定绝对有问题。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: Blind:我能感觉到{0}在屋里。那人不对劲。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: Fatman:我他妈能去哪儿？彻底完蛋了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: Fatman:老天……妈的，你知道我状态不好。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: Fatman:等这破世道安稳了……一定补偿你。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: Fatman:兄弟……选对了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: 我会把那人赶走的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: Fatman:给你这个……直接爆头更省事！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: Fatman:操……{0}在里头？快让那杂种滚！老子才不为破浴缸拼命！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: Buddy:谢啦朋友！你救了我一命！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: 我会把那人赶走的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: Buddy:分享也不是不行，但一个狗窝挤不下两条狗吧？朋友，能帮我个忙不？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: Buddy:哟朋友，窝有人占了啊。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: Bestson:不对！得回去看看他们回来没！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: Bestson:但暂时留下或许更安全……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: Bestson:万一父母突然回家我不在……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: Bestson:谢了！可我总心慌……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: 我会把那人赶走的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: Bestson:那种人……在公园里袭击过我的就是这类货色！算了！我另找地方！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: Bestson:等等……你沙发上坐着{0}？天呐……吓死我了……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: Fugitive:晚安好梦，混账东西。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: Fugitive:行！你就缩在铁门后发霉吧！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: Fugitive:怕联邦应急管理局顺藤摸瓜来找你？操！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: Fugitive:玩我是吧？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: Fugitive:希望隔壁邻居不是人渣……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: Fugitive:你救了我一命，兄弟！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: 我会把那人赶走的。进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: Fugitive:那种人转手就能把你卖了啊。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: Fugitive:平时安静守己。等到要保全自己时，眼睛都不眨就能出卖你。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: Fugitive:我实在……听着兄弟，我见过这种人。你屋里就有个，就是那个{0}。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: Nun:主不会忘记的，祂看得一清二楚。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: Nun:……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: Nun:我的死会成为压在你灵魂上的重担，记住我的话吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: Nun:蠢货！救赎的机会摆在眼前，竟被你拒绝。不知羞耻！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: Nun:主啊，请宽恕这愚行吧！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: 我会赶走你说的人的，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: Nun:驱逐邪祟，方得赐福！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: Nun:用尽一生都洗不清他们的罪孽！与恶魔为伍该畏惧天谴！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: Nun:敢问那位{0}是何方神圣？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: Raskolnikov:我只是希望有天能学会杀人，这样就能保护好自己了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: Raskolnikov:那位对你很重要吧。恕我打扰了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: Raskolnikov:抱歉，不是故意为难你。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: Raskolnikov:能不能让我看看你是怎么杀伪人的？我想亲眼看看自己害怕的东西。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: Raskolnikov:那个……不麻烦的话……你检查完我以后……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: Raskolnikov:谢了朋友。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: 我会赶走你说的人的，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: Raskolnikov:我实在，没法跟那种人共处。试过了，真的不行。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: Raskolnikov:抱歉。不是有意冒犯，但{0}已经在里面了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: Wifefema:滚蛋吧你！我找你邻居去。拜了，混账东西。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: Wifefema:……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: Wifefema:你他妈有什么毛病？我掏心掏肺说这么多，你就这态度？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: Wifefema:开玩笑？我老公可是联邦应急管理局的！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: Wifefema:这些该死的寄生虫……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: 我会赶走你说的人的，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: Wifefema:趁还来得及赶紧轰出去！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: Wifefema:我认识这类家伙。根本不该放他进来。那种人永远是祸害。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: Wifefema:那个{0}到底是什么人？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: Wifefema:……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: Theorist:告辞！我看你也活不长！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: Theorist:只有心灵狭隘的人才会这样，说抛弃就抛弃真相！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: Theorist:你，你真是……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: Theorist:“你最好赶紧走”是什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: Theorist:等我们聊完，你看世界的眼光将彻底改变！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: Theorist:很高兴你做了正确选择！相信我，你不会后悔的。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: 我会赶走你说的人的，进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: Theorist:让他走，我马上进你家！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: Theorist:有外人在我一个字都不会说！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: Theorist:是……是……{0}！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: Theorist:真不该跟你浪费时间。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: Theorist:……
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: Theorist:太好了！
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: Theorist:你该走了
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: 真不该在你这儿浪费时间……'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: 啧……随你便吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: 太爽了！'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: 我会把对方给踢出去的——进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: 哎呀，一不小心押韵了。'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: 如果要住下来，自然得按照我的规矩来。'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: 呃……还是算了。凉爽的地方早就被{0}占了。'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: 给我去死……'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: 你跟我爸爸一样，都是烂人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: 好吧……他可不这么认为。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: 难道，你觉得末日降临之后反而还比较轻松？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: 我早就料到了你会这样回答。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: 也许，我们可以将自己的注意力转移开来、不再执着于无穷无尽的偏执和自怜。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: 来一起逃避这些恐怖吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: 也许，我们可以试着建立某种……只属于彼此的特殊联系？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: 我可以帮你解决这一问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: 毕竟，跟他人建立良好的关系本来就不是什么简单的事情。受此所困的并不止你一个。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: 我能理解。真正愿意倾听、而非总是插嘴说自己的遭遇要更加糟糕的人根本就没几个。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: 现在这个世道，人人都需要一些慰藉——一点关怀、一丝……温存。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: 如果你能让我进去，你我就能共同分担这份痛苦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: 还有……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: 我也有着同样的感受。如果你想要一吐为快……我很乐意跟你聊一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: 想要放下愤怒，并不简单。想要宽恕他人，更是难上加难。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: 童年受到了来自父母的欺压？太糟糕了。还好一切都已经过去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: 只要让我进去，你……就能体验到全然不同的感受。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: 然而，即使是最为孤绝的灵魂……也需要一些——特殊的关怀。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: 如今，人人都执着于世界是否将会迈向末日一事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: 不如，这样好了——我可以给你一些……其他人给不了的东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: 嗯……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: 放心，我不会强迫你开口。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: 要是愿意说出来的话，搞不好会比较痛快哦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: 我几乎无法跟他人建立良好的关系……好了，然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: 我曾经希望自己的父亲能早点死去……怎么样，够了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: 我拒绝
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: 告诉我吧。我只不过是个恰巧来到你家门前的陌生人罢了，也许……我们之后根本就不会再有机会遇到彼此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: 难不成，你的童年过得很不容易，现在发生的一切让自己想起了当年的痛苦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: 难不成，你亲近的人被伪人杀了、如今只好封闭自己的心扉？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: 出什么事了吗？难不成，你的妻子最近离你而去了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: 哇哦，真是直截了当呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: 我几乎无法跟他人建立良好的关系——好了，然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: 我曾经希望自己的父亲能早点死去——怎样，行了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: 我拒绝
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: 你好像有点不太爱说话呢。能跟我讲讲自己的事情吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: 最近，大家都说我不太一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: 你喜欢吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: 你注意到了？谢谢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: 你看起来……不太一样
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: 我也真是够笨，何必多此一问。毕竟，你在这里住得好好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: 适应了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: 新的生活，过得怎样？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: Vigilante:真的假的？我没兴趣看你照片。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: Vigilante:看着没什么问题，但是我埋过的人有些后面才变伪人的，有一大半起初看着都没什么问题。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: Vigilante:又来这套？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: Vigilante:滚，没兴趣闻你胳肢窝什么味儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: Vigilante:胳肢窝长了东西，老子也不想看长的什么。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: Vigilante:耍老子？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 暂时……放你一马。我现在没这闲工夫。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: Vigilante:行，不过不代表你没事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: Vigilante:眼睛再睁大，别耍花招。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 现在没那闲工夫。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: Vigilante:哼……干不干净有什么意义，伪人最会装正常人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: Vigilante:磨蹭什么？我一般不发火，但有必要就不好说了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: Vigilante:没空废话，赶紧的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: Vigilante:别得意，有一点儿不对劲，你立马完蛋。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: Vigilante:行，看着挺干净。但说实话，查出问题，你我都省心。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: Vigilante:嘴张大点儿，老子不是你牙医。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: （给他看耳朵）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: （给他看照片）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: （给他看腋下）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: （给他看眼睛）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: （给他看双手）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: （给他看牙齿）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: Vigilante:闲话就说到这儿。让我检查一下，看是不是伪人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: Vigilante:他们笑了，说我应该去他们那儿干活儿。真说得出口。他们只会抓人走，伪人还是一个接一个冒出来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: Vigilante:应急中心来了，说要“清理”一下。我说没事，我早处理完了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: Vigilante:我先杀了他老婆，接着解决了他。他家里几个孩子让邻居带走了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: Vigilante:伪人爬上了屋顶，那蠢货居然开门放她逃跑，我只能替他做了他该做却做不了的事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: Vigilante:可他老婆……慢慢有了伪人的特征。他居然还跟我求情：“她是我老婆，别伤害她！”
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: Vigilante:镇子边上有户人家，门窗封死，当爹的死死守着大门。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: Vigilante:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: Vigilante:但现在？懒得管了。不找了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: Vigilante:找也是白费功夫。要是我兄弟有点骨气，或许还有希望。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: （给他看耳朵）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: （给他看照片）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: （给他看腋下）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: （给他看眼睛）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: （给他看双手）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: （给他看牙齿）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: Vigilante:闲话就说到这儿。让我检查一下，看是不是伪人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: Vigilante:那女孩儿眼神里透着几分狂野，不过人还活着，这才值得尊敬。不像我兄弟。唉，他要是早点儿死，老婆孩子说不定还能活下来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: Vigilante:我还以为他们都死光了。结果过了几天，那家人又来找我了。你知道第一个钻出树丛的是谁么？是他女儿，手里还握着散弹枪。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: Vigilante:他带着家人从后门撤进了树林。那群怪物我都解决了，但他们没有回来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: Vigilante:我前不久见过一户人家，当爹的身强体壮，伪人在窗外嚎叫，他也不会慌了神。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: Vigilante:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: Vigilante:你觉得世界为什么会乱成这样？还不都是因为有他这种怂货。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: Vigilante:怂得像滩烂泥。老婆孩子不是入土，就是不知道去哪儿了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: Vigilante:老样子。早跟我那兄弟说过“是个男人，就保护好家人”。结果他干了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: 想找到她吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: 你那边情况如何？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: Vigilante:我兄弟没那么窝囊，说不定还能保老婆女儿一条命。现在那小鬼不知道跑哪儿去了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: Vigilante:我回来了。都不知道为什么费这么大劲。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: Vigilante:没空陪你玩，有正事，回头再说。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: Vigilante:再拿耳朵给我看，想耍我，老子当场毙了你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: Vigilante:要不是我兄弟……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: Vigilante:耳朵？当老子傻？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: Vigilante:谁在乎你的破照片。有正事要办，暂时饶你一命，改天细查。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: Vigilante:哼……看着干净，但老子埋过太多“干净”的，不吃这套。光这个没法判定你没问题。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: Vigilante:照片？看磁场？行，让我看看有多“干净”。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: Vigilante:不符合，算你走运。腋下挪开。我有正事要办，回头见。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: Vigilante:看着没事，但屁用没有。这些杂种伪装能力一流，我都看不出来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: Vigilante:哼……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: Vigilante:现在没空，有更要紧的事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: Vigilante:这次算你走运。但下次发现异常，哪怕就一点点，我冲着你眼睛就是一枪。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: Vigilante:知道“正常”的伪人一晚上能造成多大伤亡吗？一个不小心，全屋死绝。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: Vigilante:哈……不符合？妙啊，真他妈妙。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: Vigilante:使劲啊，用手扒开，睁大点儿！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: Vigilante:现在没空检查手，下次再仔细查。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: Vigilante:告诉你个诀窍，看着最正常的，往往最先变伪人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: Vigilante:干净？呵……不干净就怪了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: Vigilante:没空跟你在这儿耗，还有事要查。回头再说。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: Vigilante:行……暂时留你一命。但下次发现异常，哪怕就一点点，我冲着你眼睛就是一枪。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: Vigilante:哼……挺干净。真遗憾。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: Vigilante:张大点儿，别怂。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: （给他看耳朵）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: （给他看照片）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: （给他看腋下）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: （给他看眼睛）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: （给他看双手）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: （给他看牙齿）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: Vigilante:有枪？老子不在乎。你开我也开，要死一起死。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: Vigilante:让我检查一下，随便什么地方都行。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: Vigilante:嗯……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: Vigilante:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: 你要找的人死了，他家只剩下女儿一个活口
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: 他家起火烧光了，火灾之后，我再也没见过他了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: Vigilante:他老婆……去他娘的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: Vigilante:他有个女儿，年纪不大。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: Vigilante:我来都来了，那还是问问你吧……认不认识个穿蓝牛仔外套的壮汉？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: Vigilante:伪人专挑心软的人的软肋下手。在自己家被宰的那帮人，都是死在心软上。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: Vigilante:怎么说呢，还是得迅速执行正义裁决，越快越好。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: 你要找的人死了，他家只剩下女儿一个活口
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: 他家起火烧光了，火灾之后，我再也没见过他了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: Vigilante:他老婆……去他娘的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: Vigilante:他有个女儿，年纪不大。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: Vigilante:我来都来了，那还是问问你吧……认不认识个穿蓝牛仔外套的壮汉？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: Vigilante:有一个地方对得上，立马处决，我不会等查到第二个再动手。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: Vigilante:电视和广播不是都说明白了么。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: Vigilante:靠，我敢打赌，我的办法跟你一样。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: 要是只有一两个特征符合呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: 你怎么辨认伪人的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: Vigilante:应急中心放弃这镇子了？还是就这街区？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: Vigilante:但是我去检查了几栋房子。啧，这地方到处都是伪人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: Vigilante:运气不好，想找的那个人没找到。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: Vigilante:我回来了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: Vigilante:你把我兴趣勾起来了……回头找你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: Vigilante:我得去找个人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: Vigilante:你怎么忽然提起他们来了……有点儿可疑。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: Vigilante:他们有特殊办法，能识别伪人的特征。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: Vigilante:那群人知道自己在干嘛。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: Vigilante:你先休息，改天聊。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: Vigilante:我得亲自确认一下。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: Vigilante:但我不相信你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: Vigilante:你也在维持秩序，不错。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: Vigilante:你把我兴趣勾起来了，我还会再来的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: Vigilante:嗯，我信你。听你说话，觉得你不像是会听信谣言的人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: Vigilante:有意思……你真亲眼见过？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: Vigilante:没穿什么盔甲之类的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: Vigilante:就一个？还裸着上半身？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: 应急中心过来抓了人，不知道什么时候把人送回来
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: 伪人一个接一个冒出来，不过我有枪
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: 有个裸着上半身的伪人灭了一整支巡逻队
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: Vigilante:这儿什么情况？该重点盯着谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: Vigilante:你问够了，轮到我问了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: Vigilante:打住。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: 打算“清理”到什么时候？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: 所以你在这儿干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: Vigilante:碰上给我留下特别深刻的印象的……可能就取点别的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: Vigilante:我一般拔伪人一颗牙留着当纪念，毕竟牙齿是最好拔的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: Vigilante:这是纪念品，记录清理过多少间屋子，多少个镇子。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: Vigilante:哈，你这说法有意思，记下了，下回就这么说。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: Vigilante:“防伪人”？噢，你说项链啊。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: 打算“清理”到什么时候？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: 所以你在这儿干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: Vigilante:谁要是同情伪人……说不定跟伪人没两样。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: Vigilante:但要说最有效的办法，那还是锁在屋里，一把火烧光。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: Vigilante:我徒手也能清理垃圾，不过用扫帚效率更高。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: Vigilante:对，就是扫帚。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: Vigilante:呵，你这说法有意思。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: 你脖子上这装备是干嘛的？防伪人用的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: 手里拿的是扫帚？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: Vigilante:我不躲屋里。我就是正义，能给人间带来秩序。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: Vigilante:哪有什么正义可言。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: Vigilante:结果过了几天，伪人就把屋里人全宰了逃跑，换一家继续杀，杀完了再跑。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: Vigilante:有人同情伪人，以为它们，呃……脑子能变清醒点儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: Vigilante:这可不是玩过家家。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: 你脖子上这装备是干嘛的？防伪人用的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: 手里拿的是扫帚？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: Vigilante:其他的事跟你没关系，你没必要知道。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: Vigilante:我负责的区域已清理完了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: Vigilante:我是来清理垃圾的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: 为什么不进屋？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: Vigilante:……除非你是伪人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: Vigilante:很好，这样能提高生存几率。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: Vigilante:别靠太近，懂吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: Miner:假装无事发生？快下去……弄个明白……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: Miner:万一下面有颠覆一切的真相呢？能让你成为英雄……就这么走了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: Miner:永远不知道？别装傻……你知道那不是普通地洞……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: Miner:等啥呢？就为这个来的……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: Miner:你不想余生都在后悔怂了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: Miner:勇敢点，我罩着你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: 最重要的是，你很想知道下面都藏了什么，对吧？我看得出来，你不是懦夫。拜托，这都第三趟下到这里了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: 我只要单手就能轻而易举地把你给提上来。然而，如果我下去了……谁能干这重活？非常符合逻辑，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: 如果我下去了，要找谁把你拉上来呢？无意冒犯，兄弟，你瘦得就跟皮包骨没什么两样。你下去、我把风，不是要更加合理吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: 万一我们永远都不会知道下面究竟藏着什么东西，该怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: 你为什么不亲自下去、看看究竟是什么情况？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: 你也能感觉到的，对吧？这个洞穴正在吸引你前来……就像是在呼唤着你一样。你一定感觉到了，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: 那个家伙？怎么说呢，总得有人行动起来，对吧？总不能在这里坐一辈子。机不可失，时不再来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: 万一我们永远都不会知道下面究竟藏着什么东西，该怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: 你为什么不亲自下去、看看究竟是什么情况？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: 话说回来……既然等着也是等着，不如，来搞清楚这个地方究竟有什么名堂，怎样？难道，你不想知道吗？拜托，你一定非常好奇吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: 他？肯定还活着啦。看到了吗？绳子还是绷得很紧。也就是说，他还在下面孜孜不倦地工作来着。如果有什么不对劲，我们肯定会知道的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: 你这个独自深入内部的朋友，还是没有任何消息吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: 你这个顺着绳子下去的朋友，还活着吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: 'Miner: 只是，这个洞穴……说实话，你有多少次是受到了它的吸引而下到这里来的？感觉它会把你给拉住，对吧？大方承认就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: 'Miner: 也有可能是我在这里坐得实在太久、都开始看见幻觉了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: 哎呀，你来了啊。还以为你要打退堂鼓了。不过，现在的情况有点不太对，不仅光线变得十分诡谲，绳子的分量也和平时不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: 看你这幅弱不禁风的模样，拉你上来应该是小事一桩。不如，这样好了，你到下面去看看情况，我……继续在这里把风。怎样？不妨考虑一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: 只要下去里面一趟，兴许就能搞清楚了。虽然我是很想亲自揭开这些秘密，不过……总得有人确保绳子有固定住，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: 万一，我们能在下面找到寻求已久的答案呢？当然，也许只是其中的一部分而是。不过……它们为什么会出现、它们想要得到什么，想想看吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: 譬如，伪人？我就说嘛！这些隧道应该就是出自它们的手笔。至于这个洞穴……说不定，是某种门扉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: 来吧，跟我一起搞清楚，怎样？你下去，我会在上面做好准备、随时拉人上来！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: 也不是说害怕，只是……它会吸引你过去。要是我能再靠近点、再看一眼的话……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: 不过……站在旁边的时候，偶尔……会有一种奇怪的感觉。就好像是某种东西在呼唤着我。你也可以试试看，只要……集中精神，仔细倾听就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: 之前大家都在的时候试过靠近。然而，下面……就像是一片虚无，真正的虚无。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: 也并非不乐意。只是，瞧瞧，一旦手滑、没有抓好绳子，怕是就得交代在下面了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: 亲自下去探查？怎么说呢，倒是没有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: 你不觉得自己的朋友有可能会在下面遇到什么危险吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: 你有亲自下去探查过这个洞穴吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: 看到了吗？绷得可紧。也就是说，他正在下面埋头苦干来着。如果有什么不对劲，我们肯定能察觉到。你在回去的路上，说不定会先碰上他们两个呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: 还有一人正缠着这根绳子、小心翼翼地进行着探索呢，要是准备好回来了、或者情况出现变故，就会拉一拉、通知我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: 我的朋友？哎呀，完全没有必要担心。其中一人……虽然独自深入了洞穴的内部，不过一定很快就会回来。毕竟，这个家伙寻找出路特别有一套。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: 你不觉得自己的朋友有可能会在下面遇到什么危险吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: 你有亲自下去探查过这个洞穴吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: 建议你先在上面吃点东西再下来，不然就会变得跟我一样，困在一个洞穴旁边、饿得发慌，手边却只有一盏灯笼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: 我对时间的感知已经全乱套了。既没有任何光线、也没有什么钟表，天知道待了多久。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: 蛤？大声一点！噢，我已经在这里坐了大概有……两到三天的样子吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: 你的朋友还没回来？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: 你在这里待多久了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: 哎呀，又回来了？快听听看，现在，洞里的嗡鸣是不是要比之前安静一些了？又或者说，我其实已经聋了？到底怎样？快说说看。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: 要是你真有这个打算的话，我再跟你说说具体是怎么一回事好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: 我们已经试过了，差点就因此引发坍方、把大家给活埋了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: 听着……如果你计划下到这里生活，最好不要去靠近这个洞穴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: 我的一个朋友说自己好像听见里面传来了什么声音，心想也许值得探查一番。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: 只是一个洞穴而已。不过……它的附近经常会发生一些非常奇怪的事情就对了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: 没有、没有，也不是什么特别有趣的事情，真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: 啊？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: 我们已经试过了，差点就引起坍方，把大家给活埋了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: 听着……如果你计划下到这里生活，最好不要去靠近这个洞穴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: 我的一个朋友决定下去一探究竟，我则留在这里，为了在需要的时候给他搭一把手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: 动物靠近之后会立即噤声、罗盘靠近之后会疯狂乱转……即便用上手电筒，也无法照亮内部。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: 附近总是会有一些动静，一直传来某股极轻的嗡鸣、持续不断。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: Miner:有个洞……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: 抓到伪人了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: 什么东西？有趣吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: Miner:但听着，隧道还算不上最邪门的，还有更怪的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: Miner:还没亲眼见过，所以不确定。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: Miner:怀疑是伪人的交通网。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: Miner:天知道谁挖的，为啥挖？不过，我们自己也猜过。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: Miner:我们一铲子下去，猜怎么着？挖到整个隧道系统！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: Miner:躲这鬼天气啊！他妈的热死人了！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: 抓到伪人了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: 什么东西？有趣吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: Miner:但先别说这个，我们发现了别的东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: Miner:这些隧道深得很，深不见底，不知通向哪儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: Miner:本来还有更多……最近塌了不少……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: Miner:刚开工就发现整个地下网络！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: Miner:我和弟兄们本想挖地道躲高温……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: 在找什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: 为什么在那儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: Miner:耳朵里全是土，听你说话像隔了层枕头。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: Miner:卡住？才没。我们发现了好东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: Miner:哈？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: 在找什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: 为什么在那儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: Miner:最好别塌下来砸到脑袋。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: Miner:我们在你房子下面？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: Miner:浑身都是灰……啥也听不清……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: Miner:啥？大点声！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: 卡在下面了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: 你在我房子底下干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: Miner:……大概吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: Miner:嗯？谁在那儿？好像有动静……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: MushroomEater:永别了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: MushroomEater:祝你日日顺遂，身体康健，喜乐满怀，笑口常开，亲爱的孩子……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: MushroomEater:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: 看来，希望已经破灭。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: 好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: 我还没有准备好
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: 我随时都能出发
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: 好了，亲爱的孩子。我再问你一遍，准备我与我一起前往蘑菇大陆了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: 我也不知道到底会在蘑菇大陆遇到什么东西、碰上什么事情……能够断言的是，那里危机四伏！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: 我们将飞越数段扭曲的时间，不断舞动，借此令蘑菇大陆俯首、屈膝。也许，就连我们也不例外……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: 我没办法独自一人阻止节日的发生，我需要你的帮助。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: 哎哟，亲爱的孩子……这可不好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: 否则，通往蘑菇大陆的大门就要关闭了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: 天啊！要赶不上了，快，赶紧动起来！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: 现在已经是午夜了？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: 等等，让我看看你的手表。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: 快点收拾一下自己的行李……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: 非常不错！要的就是这种精神，孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: 我还没有准备好
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: 我随时都能出发
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: 准备好与我一起前往蘑菇大陆了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: 人类永远都不应该踏足此地。然而，想要阻止节日、只好这样做了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: 要是不赶紧行动起来的话，一切都会因此而化为乌有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: 虽然不会在那里看到节日……不过，其他的东西……还有菌丝体……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: 听好，这绝对不是什么沐浴着阳光、悬挂着彩虹的童话国度！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: 虽然以我们的语言说出来的话、也许显得比较欢快，不过……在蘑菇的语言里，就完全不是这么一回事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: 亲爱的孩子，千万不要被这个名字给骗了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: 我还没有准备好
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: 我随时都能出发
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: 准备好与我一起前往蘑菇大陆了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: 不管要付出何种代价，都得阻止节日的发生！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: 虽然，说实话……如果能继续保持"无人问津"的状态，是最好的，不过，我们已经没有其他的选择。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: 大错特错，亲爱的孩子！这是一个毛骨悚然的地方，至今尚未有人能踏足其中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: 听起来……好像也没有很吓人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: 蘑菇大陆？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: 虽然我也不想出此下策，不过……看来，我们得去一趟蘑菇大陆了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: 也就是说，菌丝体已经深陷困境！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: 节日没有丝毫要停下来的趋势，意味着蘑菇已经开始爆殖、失控。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: 听起来……好像也没有很吓人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: 蘑菇大陆？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: 虽然我也不想出此下策，不过……看来，我们得去一趟蘑菇大陆了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: 然而最近……脉络积累的恶意已经远远超出它们所能承受的范围，致使其失去控制、野蛮蔓生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: 通常来说，蘑菇会试着排出这些毒素，就跟我们人体的肝脏一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: 一旦脉络积累过量的恶意，一切的运转就会受到阻碍。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: 菌丝体的内部出了非常严重的问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: 为何节日还会发生？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: 为何没有起到作用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: 菌丝体全都乱成了一团。之前举行的仪式……并没有起到作用……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: 看来，节日还是会如期而至……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: 亲爱的孩子……我们还会再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: 记住，眼见不一定为实。对于蘑菇，更是如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: 我们得确保蘑菇不再长大、节日不会开始。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: 时机成熟之后，我会再到这来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: 真正具备思考能力的是菌丝体。遗憾的是，虽然我能读懂它们的想法……它们却听不懂我们的语言……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: 它们只不过是菌丝体的一部分罢了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: 虽说这应该是最直截了当的方法，然而我没有办法与蘑菇进行对话。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: 亲爱的孩子……我们还会再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: 记住，眼见不一定为实。对于蘑菇，更是如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: 我们得确保蘑菇不再长大、节日不会开始。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: 时机成熟之后，我会再到这来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: 而这，就是我们做的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: 不过，《微笑指南》向我们展示了一种这样的方法……一种能将它们的根茎稳定下来、不再疯长的方法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: 我们并非菌丝体的一部分，因此，没有办法与蘑菇进行直接对话。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: 我们举行了一场古老的仪式，亲爱的孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: 你就不能直接去跟蘑菇沟通、让它们停止筹备这一节日吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: 我们做的这些事情到底要如何阻止这件事情的发生？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: 现在，只能等待……并且祈求蘑菇能就此停下增长的势头。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: 哎呀，亲爱的孩子……我也希望事情可以如此简单。然而，我们并不清楚自己所做的一切是否真的能起作用。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: 就不能直接让蘑菇取消节日吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: 我们具体是怎么阻止节日的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: MushroomEater:蘑菇们生长得太快了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: MushroomEater:它知晓万物……但现在……它也危在旦夕……与我们无异……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: MushroomEater:菌丝体告知的……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: 听起来你自己也不确定
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: 你怎么知道？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: MushroomEater:希望能阻止节日降临……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: MushroomEater:又见面了，孩子。你已完成《微笑指南》里写的了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: MushroomEater:啊……或许我只是在浪费时间……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: MushroomEater:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: MushroomEater:为什么？这只是书的一小部分，整本书我早就倒背如流了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: MushroomEater:祝你日日顺遂……身体康健……喜乐满怀……笑口常开……亲爱的朋友……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: MushroomEater:等你完成了书里说的事，我会再来的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: MushroomEater:现在……我该告辞了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: MushroomEater:好……等你有空时细看吧……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: 你自己留着吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: 好吧，我收下《微笑指南》残页
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: MushroomEater:我从《微笑指南》撕下几页。请收好，它们会指引你方向。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: MushroomEater:绝对不能让节日降临，孩子，我们得一起阻止它。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: MushroomEater:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: MushroomEater:蘑菇不会孤军奋战，因为节日已经快到了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: MushroomEater:蘑菇的阴影会吞噬太阳，全世界没有一个角落能幸免。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: MushroomEater:巨型蘑菇即将崛起，孢子将铺天盖地。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: MushroomEater:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: MushroomEater:我只能转述《微笑指南》关于节日的预言。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: MushroomEater:啊，孩子。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: 你自己留着吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: 好吧，《微笑指南》的残页我就收下了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: MushroomEater:所以我只撕下最关键几页。来……拿着……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: MushroomEater:但恐怕没时间通读了。部头太大……而时间所剩无几……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: MushroomEater:这本书可不一般，是世上最特别的书，你记载着必须完成之事……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: 蘑菇节？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: 《微笑指南》？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: MushroomEater:快看……我带着能帮上忙的好东西，《微笑指南》。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: MushroomEater:啊哈！别急，很快你就会明白了。但记好了，我们必须不择手段……阻止蘑菇节降临。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: 蘑菇节？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: 《微笑指南》？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: MushroomEater:菌丝体说，蘑菇节就要到了……孩子，这绝对不是什么好事！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: MushroomEater:我研读了《微笑指南》，才学会听蘑菇说话。菌丝体最近传递出的讯息……让人觉得很不妙。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: MushroomEater:蘑菇就是用菌丝体沟通交流的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: MushroomEater:是了，是了，普通人确实难以理解。菌丝体交流的方式很是独特。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: 没听懂
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: 菌丝体？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: MushroomEater:听好了。我们有很多事要做，但时间所剩无几了！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: MushroomEater:嗯，菌丝体沟通的方式晦涩难懂，不过我已经学会怎么解读它们发出的信号了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: MushroomEater:当然认识！菌丝体告诉我的！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: 没听懂
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: 菌丝体？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: MushroomEater:亲爱的孩子，请仔细听好，把我的话记在心上。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: MushroomEater:蘑菇节即将到来！而时间正从指缝溜走。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: MushroomEater:不过现在先别管这些。菌丝体跟我说，眼下发生了些麻烦事，嗯……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: MushroomEater:哦吼吼！我只是个懂点儿蘑菇的老呆瓜罢了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: 我们认识？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: MushroomEater:孩子，你好。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: CultistPriest:该做的都做了，我们这就走。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: CultistPriest:不论如何，多谢你了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: CultistPriest:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: CultistPriest:还是说，你其实不想要永恒的安宁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: CultistPriest:他们真的给你添了不少麻烦？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: CultistPriest:我会带他们一起走的。无论如何，感谢你的帮助。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: CultistPriest:很好……你做的够多了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: 这儿又不是托儿所
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: 别来烦我
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: CultistPriest:我们别无选择，只能继续呼唤她。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: CultistPriest:但死亡本身……或许能让我们不至于迎来最可怕的命运，也就是遁入虚无。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: CultistPriest:至于轮回？听起来像短暂喘息间的无尽折磨。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: CultistPriest:“来世”这个概念不过是伪宗教宣传的空虚幻梦。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: CultistPriest:“永远消失”的念头让人害怕。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: CultistPriest:重要的是，我们都已经厌倦了，没有了力气。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: CultistPriest:我们没有完全理解自己召唤的是什么，那也无妨。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: CultistPriest:我想她就快要降临了……我能感觉得到，
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: 这儿又不是托儿所
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: 别来烦我
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: CultistPriest:为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: 所以你所谓的死亡到底是什么来头？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: 带上你那几个疯子打包滚蛋
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: CultistPriest:晚安。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: CultistPriest:死亡要是选择了你，我一定会助她一臂之力，让她能凑近点儿瞧瞧你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: CultistPriest:那么……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: CultistPriest:他们离开了尘世……？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: 所以你所谓的死亡到底是什么来头？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: 带上你那几个疯子打包滚蛋
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: CultistPriest:那我就不打扰你了，先走一步。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: CultistPriest:很好，就该是这样。她仍旧凝视着我们。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: 滚开，正忙呢
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: 你的人好得很
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: CultistPriest:不过你一切都还好，对吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: CultistPriest:原来世界就是这样终结的。不是伴着一声巨响……而是伴着一声呜咽。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: CultistPriest:死亡已不再对我说话。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: CultistPriest:再见了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: CultistPriest:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: CultistPriest:我们就这么一次机会……都让你毁了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: CultistPriest:他们都死了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: CultistPriest:等等……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: CultistPriest:我也不太明白是什么意思……不过你不觉得听着很诱人么，？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: CultistPriest:她或许会为你提供庇护，让你远离一切……甚至能远离终结本身。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: CultistPriest:死亡不久前对我耳语，说她期待在时机成熟时与你相会。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: CultistPriest:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: CultistPriest:世道坎坷，处处都是混乱和恐慌，想必你也早就厌倦了吧……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: CultistPriest:谢谢帮忙。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: 关我屁事，自己的烂摊子都收拾不完
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: 行行行，都活着呢
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: CultistPriest:不浪费时间了，开门见山吧。我的人情况如何？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: CultistPriest:……我没过多久还会再来的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: CultistPriest:他们不会叨扰太久，但还请照顾好他们。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: CultistPriest:多谢。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: CultistPriest:不会占用你多少时间。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: CultistPriest:所以……请收留他们吧，
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: CultistPriest:到时候，你能跑到哪儿去？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: CultistPriest:你就算能活下来，屋子也保不住。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: CultistPriest:到时候会来一大帮人。趁你睡着，泼上汽油就点火。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: CultistPriest:你以为教众就这么几个？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: 威胁我没用，不吃这套。不过，我可以帮你们这个忙
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: 那我就把你们全毙了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: CultistPriest:唉……我们别无选择。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: CultistPriest:很遗憾，计划失败，我们只能烧了你的屋子。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: CultistPriest:但是死了两个三个……目标就无法实现了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: CultistPriest:看好我的人。记住，死了一个……屋子就别想要了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: CultistPriest:难道你不渴望安宁，不渴望一个人人不再互相拖累的世界么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: CultistPriest:没错。崇高的使命，向来不容易达成。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: 威胁我没用，不吃这套。不过，我可以帮你们这个忙
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: 那我就把你们全毙了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: CultistPriest:抱歉，但到了那个地步，想要达成神圣的使命，只能这样了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: CultistPriest:到时候，我们会烧了你的屋子。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: CultistPriest:死了两个三个，我们的努力就付诸东流了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: CultistPriest:看好我的人。记住，死了一个……屋子就别想要了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: CultistPriest:你说不定终究难逃烈日焚身的命运。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: 听起来挺难办的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: 你说的未来，我听了没有半点兴奋的感觉
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: CultistPriest:丧葬仪式由他们主持，你保护好他们就行。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: CultistPriest:但是我的同袍得找个地方躲一躲。你的屋子牢牢吸引着死亡。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: CultistPriest:我不用进去。我的使命是传教，传播给人类带来永恒安宁的神圣信仰。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: 听起来挺难办的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: 你说的未来，我听了没有半点兴奋的感觉
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: CultistPriest:他们必须活下去，活到完成自己的使命。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: CultistPriest:总之，请让我的同袍进屋里去，为他们提供庇护吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: CultistPriest:屋里到底发生过什么事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: CultistPriest:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: CultistPriest:死亡牢牢支配着这儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: CultistPriest:你这屋子正合适，
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: CultistPriest:我们要举行形式新颖的丧葬仪式。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: 你想进屋里还是怎么着？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: 你到底想干什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: CultistPriest:她就快到了，我们只是帮她一把，让她能跨过门槛。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: CultistPriest:我们不相信有救赎，除非救赎来自死亡。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: CultistPriest:我身上这套是裹尸布。提前穿好，免得死了还要另外找。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: CultistPriest:可能是吧。这是什么坏事么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: 你想进屋里还是怎么着？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: 你到底想干什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: CultistPriest:死亡是获得救赎的唯一方式……世界再也变不回原来的样子了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: CultistPriest:我们只是帮她一把，让她靠得再近一点儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: CultistPriest:死亡已至。她只是想安抚人类，让我们摆脱恐慌、痛苦和混乱。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: CultistPriest:我们是新信仰的先驱，四处宣讲神圣的教义。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: 看着像邪教疯子
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: 你到底是什么人？为什么穿成这样？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: CultistPriest:而死亡对你情有独钟，
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: CultistPriest:有人被烧死，有人被拖出去处决。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: CultistPriest:死亡无处不在。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: CultistPriest:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: CultistPriest:没错。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: 看着像邪教疯子
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: 你到底是什么人？为什么穿成这样？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: CultistPriest:不知道这儿到底死过多少人……反正她的存在感很强。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: CultistPriest:死亡很中意你这屋子，中意得不得了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: CultistPriest:……死亡。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: 你没感觉错，屋子是我的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: 你到底感觉到了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: CultistPriest:我能感觉得到。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: CultistPriest:是了，就是这儿，这屋子好得很。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: 来，拿去吧，{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: 你评评理，一个随处可见的配送员到底有什么威胁？妈的，那个混蛋为什么非得要杀了他？到底图个什么东西？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: 现在这个世道，就连一个正常点的人都没有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: 他跟平时一样好好干活儿，给客户送商品，结果被那个房主……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: 我的朋友被杀了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: 你怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: 你订购的商品已经送达……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: 祝你晚安……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: 唉……万一我的眼睛也因为睡眠不足而变成这样，该怎么办？难道，他们也会把我关进隔离区里面去吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: 然后？就没有然后了，一下就让带走了。现在，就没人知道他之后怎么样了。还有就是，还会不会放他回来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: 本来只是一次再普通不过的晨检而已，结果……他们发现这位同事的眼睛有点不太对劲……布满血丝，红肿不堪。妈的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: 我的同事被应急中心的工作人员给带走了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: 你看起来好像有点失落
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: 你好……你订购的商品已经送达。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: 祝你晚安。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: 要是有工作的话，起码还能把自己的注意力给转移开来、不用去整天挂念着现在的这堆烂摊子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: 唉……不然，我又能做什么呢？跟绝大多数的人一样，坐在家里、慢慢腐烂？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: 哎呀，不好意思。你问的是，我为什么会给人送货，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: 通过了筛选呗。他们检查了所有特征之后，他们确定我是个人类。然后……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: 你是怎么当上送货员的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: 你好。我是安憩的送货员。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: 抱歉，还是不太习惯、没能完全改口。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: 祝你度过愉快的一天，哎呀，不对……是一晚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: 真没想到，现在，配送业务竟然还在正常运作
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: 你好。我是安憩速递的配送员。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: 无法做梦的话……也太过难熬了，对谁来说都是这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: 我希望会。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: 你觉得大家会再次开始做梦吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: 不过，如果这里还有人会做梦、也可以说是大事一件了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: 谢谢。我会试着在这里睡上一觉，虽说……应该还是没有办法入眠就对了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: 好吧，进来……吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: 或许，睡着了之后……也能看到什么景象呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: 毕竟，我已经有整整六天没睡过觉了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: 我也说不清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: 好吧，进来……吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: 我想……说不定是因为现在已经没有这种余裕了。失去了休息的时间，失去了自省的机会。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: 现在？碎了一地，无处可寻。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: 大家会在其中释放压力，寻找答案、寻求慰藉……令自己平静下来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: 梦……非常的脆弱。说来也是奇怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: 你自己做梦吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: 为什么关心这个？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: Intruder:我在想……是因为太阳？还是别的什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: Intruder:很多人都这样。就算发高烧……也没有做梦。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: Intruder:看吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: 你自己做梦吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: 为什么关心这个？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: Intruder:你觉得是为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: Intruder:现在的人几乎不做梦了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: Intruder:知道我发现了什么吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: Intruder:我是说梦境。你总知道梦是什么吧？你睡觉的时候……会看见什么吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: 不太做
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: 什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: Intruder:你还会做梦吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: FormerFema:再见。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: FormerFema:唉，我都不知道还留着它干嘛。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: FormerFema:估计是这身制服吓人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: FormerFema:……等等，哪儿搞错了吧。噢，我懂了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: FormerFema:什么？噢，谢了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: FormerFema:没想到你真会让我进来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: FormerFema:有地方让我坐会儿吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: FormerFema:什么？噢，谢了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: FormerFema:当初说的明明是编程。写代码。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: FormerFema:让我干的活儿跟当初说的根本不一样。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: FormerFema:结果大失所望。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: FormerFema:我找到了工作，还以为会顺顺利利。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: FormerFema:问得好。现在我只觉得……迷茫。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: FormerFema:累垮了就不干了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: FormerFema:剩的人太少，根本忙不过来。活儿越堆越多。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: FormerFema:不过后来……就不在那儿干了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: FormerFema:我在厂里干的是做冰箱，修冰箱的活儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: FormerFema:我？就是个普通的工厂工人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: 你有什么打算？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: 那你到底是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: FormerFema:天知道他们在搞什么东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: FormerFema:带走的人就没回来过。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: FormerFema:因为……不管上门是干什么的，反正一上门，就得把人带走。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: FormerFema:据我观察，大家都讨厌应急中心的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: FormerFema:噢！我不是应急中心的人。我身上这套衣服让你误会了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: FormerFema:没明白。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: FormerFema:嗯？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: 你有什么打算？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: 那你到底是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: FormerFema:没准儿是晚上会残留太阳的辐射之类的？我不知道，也根本不想知道。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: FormerFema:我觉得穿他们的衣服比较安全。他们成天穿着这套制服走来走去，总归有些道理吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: FormerFema:我不是应急中心的人。这套衣服是我从尸体上扒下来的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: FormerFema:噢……我穿了这身衣服，你把我当成应急中心的了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: FormerFema:带走？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: 这次是来抓我的吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: 先把你带走的人还回来
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: FormerFema:能……开开门吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: FormerFema:我听见脚步声了……说明你到门边了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: FormerFema:有人吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: GraveDigger:我要挖个深坑把自己埋了，再也不出来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: GraveDigger:我听人说过这种事的……有人出门回来，砰一下，直接完蛋。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: GraveDigger:然后伪人就来敲门了……更糟的是……他们早就在屋里等着你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: GraveDigger:回家只有空荡荡的屋子。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: GraveDigger:没日没夜挖一辈子土，累断腰板图个啥？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: GraveDigger:老天……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: GraveDigger:麻烦快点关门行不？就怕那些伪人追着我过来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: GraveDigger:谢、谢谢！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: GraveDigger:总之，我不干了。都见鬼去吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: GraveDigger:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: GraveDigger:唉，有苦有难，我们会去收拾残局，我们现在过成了这样，那些苦难也能反过来给我们收拾残局就好了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: GraveDigger:反正太阳会火化尸体。再说现在这夜晚……太短了，根本来不及处理死人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: GraveDigger:反正现在也没人送尸体来了。跟你说，早就没人在乎葬礼体不体面了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: GraveDigger:这破工作屁钱不值。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: GraveDigger:我头也不回拼命跑，家都不敢回。想着人多的地方更安全。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: GraveDigger:是个伪人，正从地底下往外爬！那家伙呢？居然哈哈大笑。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: GraveDigger:我以为是石头，结果不是，有只手从土里伸出来了！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: GraveDigger:我挖啊挖啊，突然……哐当！铁锹碰到个东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: GraveDigger:他就站边上盯着我干活。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: GraveDigger:靠，我跟你说啊，有人下单了个墓穴，我那天正在给他挖。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: 那你直接旷工了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: 你在外面看见什么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: GraveDigger:其他人就让尸体放在那儿。反正太阳也会把尸体统统火化。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: GraveDigger:最近人死得那叫一个多，但根本没人埋。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: GraveDigger:我挖最后一个坑看见的东西，说出来你绝对不信……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: GraveDigger:敲这么响真对不住。只是……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: 那你直接旷工了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: 你在外面看见什么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: GraveDigger:坟墓早就没意义了。人都是原地倒下，倒在哪儿就烂在哪儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: GraveDigger:那什么，我以前是掘墓人。虽然现在这活儿也没啥意义了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: GraveDigger:我自己也压根儿没合眼。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: GraveDigger:欸，别生气，不是故意想吵醒你的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: 你怎么不砰砰敲自己脑袋去！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: 别砰砰敲我家的门
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: GraveDigger:能不能让我进去？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: GraveDigger:有人吗？屋里还有活人吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: Marauder:好吧。那我也该走了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: Marauder:你……呃，没在听啊？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: Marauder:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: Marauder:我跟你保证，就路过住一宿，绝对不久留。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: Marauder:对了……你知道附近哪栋房子空着吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: Marauder:没事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: Marauder:个个精彩绝伦，保证不会让你无聊。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: Marauder:想找我聊天，随时都行。嗐哟，我可有一肚子故事。说实话，不止一两个。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: Marauder:哇哦！总算能像个人似的好好躺会儿了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: Marauder:总之……这屋子是你的，你看，今晚能收留我住一会儿吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: Marauder:好吧……也出手过一次，但那确实是没招了。说来话长，回头可以讲给你听。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: Marauder:告诉你，我不是圣人，但也有底线。不会对同类出手。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: Marauder:怎么，你觉得我是土匪？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: Marauder:外面的东西我可见多了，有一肚子故事可以讲。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: Marauder:没有冒犯你的意思。但是，屋子是你的……你看收留我一阵行不？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: Marauder:不过……没错，我正打算搜你这儿。我以为这屋子没人住。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: Marauder:有段时间差点儿彻底不干了……真的就差那么点儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: Marauder:屋里的东西，我能拿就拿。有的卖了，有的自己留着。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: Marauder:哼。也没必要骗你。跟你说实话吧，我专找没人要的屋子，还有空的公寓。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: 你会偷东西吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: 你一个人怎么活下来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: Marauder:孤独快把我逼疯了，真感觉马上就要疯了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: Marauder:不过，伙计，我跟你说句实话，我受够了。成天对着影子自言自语，这日子我过得够够的了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: Marauder:我刚开始觉得一个人比较安全。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: Marauder:那帮伪人不知道从哪儿冒出来以后……我就一直是一个人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: Marauder:那不然呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: 你会偷东西吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: 你一个人怎么活下来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: Marauder:别提了……我哪儿都融不进去，就一个人在这破地方凑合过过，也没几个钱。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: Marauder:关键是，我见识过人性有多黑暗。相较之下，我根本算不上最恶劣的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: Marauder:好像我比其他人更差似的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: Marauder:谁愿意跟我搭伙呢？大家都把我当社会渣滓。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: 你觉得这样合适吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: 你怎么就一个人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: Marauder:我说……介意我蹭住会儿吗？好久没碰到……活人了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: Marauder:不过……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: Marauder:怪我。我还以为这地方没人住。我这就走。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: Marauder:嗐哟……这儿居然有人住？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: Provocateur:祝你有愉快的一天……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: Provocateur:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: Provocateur:……顺便说一句，这违背了宪法第119条。相信我，这对你绝无好处。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: Provocateur:你最好注意说话语气。我可以将其视为对我生命的威胁。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: Provocateur:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: Provocateur:什么意思？你刚才是让我离开？这是在威胁我吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: Provocateur:具体租赁条款我们可以稍后详谈。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: Provocateur:感谢你，房主。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: Provocateur:要么我付钱，要么我不踏进这里半步。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: Provocateur:这不合适。更糟的是，这是违法的……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: Provocateur:恕我直言，我无法心安理得地占用你的空间却不付租金。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: Provocateur:行，之后我们会用完整法律合同彻底解决这事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: Provocateur:难以置信……堂堂租赁行业从业者竟对合理租金嗤之以鼻。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: Provocateur:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: Provocateur:什么意思？我看着像需要施舍的人吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: 我不需要你的钱
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: 非得给钱的话，你看着给吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: Provocateur:抱歉，我绝不能白占宝贵空间而不支付应付的费用。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: Provocateur:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: Provocateur:什么意思？你刚才说“只是收留路过的人”？你是志愿者吗？在给无家可归者提供庇护所？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: 我不需要你的钱
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: 非得给钱的话，你看着给吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: Provocateur:不过……既然没有正式合同，你这儿每晚怎么收费？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: Provocateur:行吧。回头再签正式协议，当然日期会往前补签。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: Provocateur:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: Provocateur:哼……答得可真含糊。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: 我只是收留路过的人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: 算是吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: Provocateur:你好，房主。请问你这儿出租房间吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: TaxiDriver:你和应急中心混蛋没两样。你不得好死。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: TaxiDriver:靠……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: TaxiDriver:对，我是挺慌张的，但你也没必要赶人吧！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: TaxiDriver:喂，别这样对我！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: TaxiDriver:眨个眼就能把你抓走。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: TaxiDriver:记住，别信穿黄衣服的混蛋。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: TaxiDriver:呼，谢了，伙计。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: TaxiDriver:我只能拼命跑。家都不能回，那群阴险混蛋肯定在我家门口蹲我。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: TaxiDriver:他们不仅想把我一起抓了，连车也要扣。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: TaxiDriver:我想都没想就开去了应急中心。结果证明，大错特错。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: TaxiDriver:我从后视镜里看见了，那牙齿白的，跟广告牌上的似的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: TaxiDriver:他真是伪人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: TaxiDriver:你别以为我是自己搁那妄想……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: TaxiDriver:我拿出大衣里藏的瓶子，抡倒一个就跑了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: TaxiDriver:我立马就后悔开到这儿来了。他们把我拖下了车，我很快反应过来，这帮混蛋也要抓我。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: TaxiDriver:他们刚开始还夸我呐，说什么“干得好，抓了个伪人”，然后……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: TaxiDriver:我就偷偷开去了应急中心，一到地方，立马把他锁车里。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: TaxiDriver:我搭了客人上路，开着开着，发觉不对劲，那人牙齿太白净，太完美了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: TaxiDriver:应急中心那帮混蛋抢了我的车。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: 那个客人怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: 你车怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: TaxiDriver:也不是说我脑子多笨，都怪我信错了人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: TaxiDriver:怪我太蠢，弄丢了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: TaxiDriver:以前有……现在了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: 那个客人怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: 你车怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: TaxiDriver:现在么……人没了，车也没了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: TaxiDriver:但那个客人身份有问题。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: TaxiDriver:有天搭了个客人……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: TaxiDriver:从哪儿说起好？我是个开出租的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: 你要我帮你什么忙？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: 怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: TaxiDriver:那什么，我现在倒大霉了。能让我进去躲会儿吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: TaxiDriver:哟。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: 我会寻找其他住处。只是……到时，还请不要将我的尸体抛于街上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: 我会静静等候死亡的到来，待它将我温柔地拥进怀中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: 既然如此……不知，你是否介意我待在附近？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: 一切尘埃落定之后，把我的尸体留下吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: 虽然不太清楚你对美的理解是否与我一致，不过……告诉我吧，你应该不会把尸体弃于门外，对吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: 真的，这里比我待过的其他地方都要更加安静。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: 当世界迎来无可避免的终结时，我希望能与其轻柔地融为一体。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: 因此，我也来到了此处。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: 我不确定。我总感觉……聚集在这里的人们已经做好了面对必然之事的准备。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: 你认为这样能舒缓败血症？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: 现在，我来到了这里、站在了你面前……孑然一身。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: 然而，伪人不请自来……至于，之后发生了什么事情……我想，你应该可以想象得到。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: 每天，她都……不断地蜕变着。而这过程令人屏息。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: 我曾经与自己深爱过的一个女孩共同生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: 你会对此感到疑惑也是无可厚非。不过，现在……这么说吧，'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: 是不是……把这条手臂给切除掉会比较好？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: 你是怎么染上坏疽的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: 我与城市的沸反盈天、张皇失措格格不入，人人都在逆流而行、妄图截天改道。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: 我这样的人生……如果将其比作美酒，最好是能一口气吞下、没有必要去细细品味。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: 每天，我都不知道自己究竟是否还能活着迎来破晓。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: 当然，无论怎样，我还是会抖个不停。毕竟……问题出在这条已经腐烂了的手臂上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: 你知道吗？大街已经不再凉快，就连晚上也不例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: 即便是在炎热的城市之中，我依旧会不由自主地颤抖。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: 如此寂静……万籁俱空。时间仿佛于此凝滞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: 是不是……把这条手臂给切除掉会比较好？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: 你是怎么染上坏疽的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: 我想要在这里走完最后一程。静静地、好好地感受每个瞬间。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: 人人都想抓住一线生机、拚了命地求生。然而，如果是在这里……大家反而可以心平气和地接受自己的命运、迎来自己的终局。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: 城市的喧嚣如同汗水一般黏附于我，无比痴狂、乱作一团。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: 我这样的人生……要是将其比作美酒的话，最好能一口气吞下、没有必要细细品味。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: 每天，我都不知道自己究竟是否还能活着迎来破晓。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: 我感到非常的不舒服，并不仅仅是因为坏疽。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: 这个地方……到底漂亮在哪里？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: 为何不待在自己家里？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: 希望你可以允许我在此处待上几天。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: Edgar:这儿安静得多。城里到处是尖叫。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: Edgar:你好。你的房子很美。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: Foreigner:（静默片刻后他转身离去）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: Foreigner:（你的喊声惊到他）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: Foreigner:快走吧！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: Foreigner:（始终站着发出呜咽）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: Foreigner:（他点头走进来）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: 离开
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: Foreigner:（不确定那是不是泪水浸湿的脸颊）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: Foreigner:（他只是站着，透过猫眼凝视）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: 离开
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: Foreigner:（不确定那是不是泪水浸湿的脸颊）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: Foreigner:（他边比划边发出含糊声响）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: 我该拿你怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: 有人缝住了你的嘴？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: Foreigner:（又发出模糊呜咽，听不清内容）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: Foreigner:（他痛苦地拱起眉毛）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: 我该拿你怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: 有人缝住了你的嘴？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: Foreigner:（他似乎无法回答）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: Foreigner:（男人挑眉看着你）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: 什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: 你怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: Foreigner:嗯嗯嗯？！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: Foreigner:嗯唔……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: Doctor:运气好的话我就在附近，需要帮助随时开口。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: Doctor:理解，这年头很难信任别人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: Doctor:谢谢。希望我能帮上忙。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: Doctor:让我进去的话，可以告诉你医院发生了什么。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: Doctor:说来话长。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: 之前，在市中心的附近有一家医院，只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: 如果你能让我进去，我可以跟你讲讲医院都发生了些什么事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: 然而，现在……根本就没有所谓的医院了。于是，我只好四处漂泊、尽己所能地为有需要的人提供帮助。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: 我们的医院一直以来都经费短缺，因此……我实际负责的工作要远远超出职务说明上规定的事项。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: 我是个外科医师，曾经帮无数的患者动过手术。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: 你是从哪里来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: 心想，要不看看里面是什么情况好了。结果发现，门锁上了。于是，决定在动手把它撬开之前、还是先敲一敲，确定一下有没有人比较妥当。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: 四周一片寂静……说实话，我本以为这栋房子已经荒废了、没人居住。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: 安全……以及，能消除无聊的事物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: 没错，我的确是在找什么东西。只是，跟其他人所追求的也没什么两样就对了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: 哎呀……怎么冷不防地冒出这样一个问题？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: 你是从哪里来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: 甚至乎是，会有人因为无法承受的悲痛而嚎啕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: 又或者是，会有人在痛苦地尖叫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: 一般来说，会有喝得醉醺醺的家伙在大吼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: 只不过是觉得稀奇罢了。毕竟，这么大的一栋房子，到了晚上却如此安静，挺少见。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: 啊？哎呀……没有，当然不是。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: 你是在找什么东西吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: 你……是在监视这栋房子吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: 晚安，请问，能让我进去吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: 夜幕降临之后，这里实在是太过安静了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: Doctor:还以为屋里没人呢。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: Wolfhound:还会再见的，小可爱
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: Wolfhound:啊哈，这么回事是吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: Wolfhound:现在权力才是王道，小可爱。要么跟着玩，要么被碾碎
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: Wolfhound:乖孩子
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: Wolfhound:重点是我不是来砸场子的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: Wolfhound:不知道对你有好处。我可没问你咋活到现在的对吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: Wolfhound:哎哟喂看看这位大爷
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: Wolfhound:你？这儿居然还有秩序。稀罕物啊小可爱。想看看你怎么维持的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: Wolfhound:到哪儿都一个样。恐惧让人看不清大局
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: Wolfhound:从不在同一个地方久留
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: 怎么活到现在的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: 你闯过多少房子？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: Wolfhound:唱反调的活不到天亮
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: Wolfhound:新世界秩序就是弱肉强食
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: Wolfhound:不承认就得被生吞活剥。骨头都不剩
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: Wolfhound:咱们都是野兽，伙计
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: 怎么活到现在的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: 你闯过多少房子？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: Wolfhound:现在多简单。撕开杂碎喉咙就是赢家通吃
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: Wolfhound:你们那套规则道德早烧成灰了，小可爱。屁用没有
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: Wolfhound:去过其他房子吗？逛过街道吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: 你也是野兽么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: 你在说什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: Wolfhound:终于，不用再束手束脚
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: Wolfhound:这早不是文明社会了。野兽们都出笼啦
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: Wolfhound:整个世界都乱套了是吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: Wolfhound:哟。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: SuperFake:还有什么好抵抗的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: SuperFake:一切即将终结。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: SuperFake:事到如今，还在坚持个什么劲儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: SuperFake:何必呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: SuperFake:你总是逃跑，总是逃避我这样的存在，逃避真相。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: SuperFake:所以我才来了嘛。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: SuperFake:这些事还是不能交给你自己去办。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: SuperFake:是，啊，
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: SuperFake:你害怕了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: SuperFake:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: SuperFake:看来你准备好了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: 我清理掉了几个不该待在屋里的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: 不该待在屋里的，我都清理掉了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: 我只放该进来的人进来
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: 屋里有很多……不是人的家伙
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: 我谁也没放进来
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: 屋里有很多人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: SuperFake:你放我们的人进屋了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: SuperFake:但我有件更好奇的事情。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: SuperFake:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: SuperFake:你还会有感觉吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: SuperFake:就这么……没了？永远不存在了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: SuperFake:你死了。然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: SuperFake:看来你更关心终结到来以后的事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: SuperFake:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: SuperFake:你是不是经常想，自己怎么还活着？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: SuperFake:你是不是很害怕未知？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: 我清理掉了几个不该待在屋里的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: 不该待在屋里的，我都清理掉了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: 我只放该进来的人进来
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: 屋里有很多……不是人的家伙
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: 我谁也没放进来
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: 屋里有很多人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: SuperFake:屋里就你一个人么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: SuperFake:你放我们的人进屋了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: SuperFake:不过现在，我得先问一句……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: SuperFake:……你会消失。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: SuperFake:不是今天就是明天。不是明天就是后天，大后天。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: SuperFake:……你会死。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: SuperFake:但不管怎么说，结局都一样。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: SuperFake:我想，是让我来改变什么东西的吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: SuperFake:他们派我来是有原因的……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: SuperFake:你有没有想过……你是被选中的人？哈哈哈。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: SuperFake:现在才想起来问？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: 为什么不直接破门？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: 为什么总来这儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: SuperFake:别担心，我们能帮你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: SuperFake:好笑的是你一点儿感觉都没有。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: SuperFake:不能说。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: 为什么不直接破门？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: 为什么总来这儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: SuperFake:都已经贴在你脖子后面吐气了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: SuperFake:感觉到了吗？死亡逐渐逼近。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: SuperFake:就这样。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: SuperFake:我只是跟你传个话。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: 什么要终结了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: 什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: SuperFake:不是我们动手，就是你们自己动手划下句点。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: SuperFake:一切即将终结。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: SuperFake:他们说这是我最后一次跟你聊天了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: SuperFake:下次再见了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: SuperFake:那……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: SuperFake:我只是听令行事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: SuperFake:外面还有更了不起的存在。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: SuperFake:你不会以为我是头儿吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: SuperFake:对你来说，发生变化还不是最糟的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: SuperFake:我们现在都少见喽。更别说你们这种缩屋子里的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: SuperFake:哎呀呀……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: SuperFake:跟我走吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: SuperFake:这就对了。我赌赢了，开门。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: SuperFake:哼……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: 还有别人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: 就我一个人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: SuperFake:屋里就你一个人么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: SuperFake:不过，走之前跟你赌一把。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: SuperFake:可惜啊……那我……先走了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: 还有别人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: 就我一个人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: SuperFake:屋里就你一个人么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: SuperFake:不过我得先问你一句……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: SuperFake:试试看。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: SuperFake:很简单。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: 能晚点儿再来吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: 我不明白你什么意思
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: SuperFake:你就会给我开门。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: SuperFake:你屋里要是有两个，或者两个以上我这边的人……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: SuperFake:来，我帮你治治。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: SuperFake:什么都不在乎了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: SuperFake:这么超然？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: 能晚点儿再来吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: 我不明白你什么意思
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: SuperFake:因为狗现在就寄宿在他们的身体里。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: SuperFake:你就会给我开门。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: SuperFake:你屋里要是有两个，或者两个以上我这边的人……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: SuperFake:要不要试试新玩法？算是跟你赌一赌吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: SuperFake:看来你需要有人帮你一把。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: SuperFake:肯定很难熬。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: 我不在乎
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: 我没什么感觉
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: SuperFake:你身边尽发生些怪事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: SuperFake:知道我说谁，对吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: SuperFake:全因为一个字，就那么一个字……可是，那个字多妙呀！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: SuperFake:你们人类里出了个死不掉的人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: SuperFake:……我也是。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: SuperFake:变化正萦绕着你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: SuperFake:感觉到了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: SuperFake:下次再见……会很有趣的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: SuperFake:可你没跟上节奏。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: SuperFake:生活发生了翻天覆地的变化。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: SuperFake:明白我意思吧？世界变了，再也回不去了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: SuperFake:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: SuperFake:狗已然统治了世界，到最后，世界上只有狗能活下来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: SuperFake:何必呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: SuperFake:还在新世界里挣扎着活下去？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: SuperFake:那我快，快地溜进你家里吧。给你准备了份小小的临别礼。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: SuperFake:跟谁都处不好？……可惜哟。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: SuperFake:结果还是落单了啊。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: 还有别人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: 就我一个人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: SuperFake:屋里就你一个人么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: SuperFake:那，什么，
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: SuperFake:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: SuperFake:你能停止的只有自己的心跳。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: SuperFake:能拦得住洪水、大火和腐朽吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: SuperFake:你能拦得住吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: SuperFake:你到底能做什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: 还有别人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: 就我一个人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: SuperFake:屋里就你一个人么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: SuperFake:那，什么，
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: SuperFake:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: SuperFake:……如果面对的是死亡呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: SuperFake:……如果面对的是宇宙灾变呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: SuperFake:不过，个人在灾难面前能做什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: SuperFake:是啊，我知道！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: 我在尽力做自己能做到的事
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: 我什么都做不了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: SuperFake:难道说，你想一个人全扛下来？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: SuperFake:这难道不是恩赐么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: SuperFake:冥冥之中早就定好了，我们受着就行。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: SuperFake:为什么要有感觉？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: 我在尽力做自己能做到的事
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: 我什么都做不了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: SuperFake:还是说，这事该我们自己动手？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: SuperFake:穿制服的说不定能恢复秩序。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: SuperFake:坏事一件接着一件，是吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: SuperFake:这世道真够难熬的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: 我不知道该怎么看待他
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: 他只是在干自己该干的活儿
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: SuperFake:觉得那穿制服的怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: SuperFake:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: SuperFake:原来你还缩在这儿啊……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: Greatmother:我把老姐妹都带来。胖大娘保你不孤独死，哈哈哈哈哈！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: Greatmother:哈哈哈哈哈！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: Greatmother:其实，谁敲都别开。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: Greatmother:挺好。只是，别给那些黄衣服开门。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: Greatmother:一开准把咱俩拖到鬼知道的地方。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: Greatmother:哎哟，心肠真好。千万别给敲门的黄衣服开门。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: Greatmother:大娘就图个活命，宝贝儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: Greatmother:好些住户被掳走了，可怜见的。我们剩下的人都跑了，他们倒是没追过来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: Greatmother:有人想赖着不走，黄衣服直接拽人，跟随便拣货似的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: Greatmother:整栋楼都遭殃！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: Greatmother:叫其他人当没事发生。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: Greatmother:黄衣服的冲进来把人们摔出门，还抓走几个。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: Greatmother:说咱们楼遭了太阳轰击还是啥屁话。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: 你们人很多？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: 为什么赶你们走？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: Greatmother:打那起我就东奔西跑，想找个屋子落脚。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: Greatmother:整片街坊都给清空了，谁都不知道去了哪儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: Greatmother:不找谁。大娘就想找个地界歇歇脚，宝贝儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: 你们人很多？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: 为什么赶你们走？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: Greatmother:后来大家各逃各的，我来这儿讨个活路。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: Greatmother:没避难所没援助。能上哪儿？能咋办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: Greatmother:那帮穿黄衣服的把咱们全轰出楼，没给安排去处。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: Greatmother:我和老姐妹们原本住隔壁街。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: 在找人吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: Cold:也是。你肯定不愿浪费子弹。再见
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: 不、不知，是否可以给我来上一枪？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: 我留意到你的手、手上沾满了火、火药的污渍。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: 好吧，再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: 我能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: 虽然天花板有、有点低，不过也没关系。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: 谢、谢谢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: 我会离开，不会乞求。不、不会打扰到你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: 你没有必要让我进去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: 不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: 万一情况变得更加糟、糟糕，该怎么办？万一我还是无法因此而死、获得解脱，该怎么办？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: 我害怕脱、脱下衣服。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: 其他人都热、热得不行，站在太阳底下甚至会被活活烤死。而我将自己层层包裹，却还是会感到非常寒、寒冷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: 我总是感到非常寒、寒冷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: 把夹克给脱下吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: 你不热吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: 也就是说……已经寻找非、非常长的一段时间了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: 我从未拥有安、安宁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: 把夹克给脱下吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: 你不热吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: 还是晚点再说吧。我……不是很确定是否该现、现在提出。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: 我并不、不是。不过，我有一个请求。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: 我是谁其实一点也不重、重要，你怀疑我会不会是个伪人，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: 你寻找多久了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: 不知，我能否在此获得一、一丝安宁？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: 虽然我可以忍、忍受酷热，不过……还是需要寻找一个安静的地方好好休息。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: Cold:你好。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: Hunter:我发誓会杀光所有怪物。等着瞧吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: Hunter:……天亮以前就会割了我喉咙。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: Hunter:呵，这样也好。说不定你也是伪人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: Hunter:我们一起杀伪人，绝不让他们靠近这屋子一公里！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: Hunter:早知道你不怂，是条硬汉子。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: Hunter:也就是披着人皮，压根没有人性。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: Hunter:我拼命跑，他们还在背后开枪，这帮怪物就爱这么逗弄人玩。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: Hunter:伪人等着我睡着，趁机摸走了枪。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: Hunter:本来有把步枪，可这把枪差点要了我的命。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: Hunter:对付这些狡猾杂碎，绝对不能给第二次机会。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: Hunter:放跑一个，转头就回来咬断你喉咙。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: Hunter:你不傻。但我可不会赶走就完事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: Hunter:你不也在做同样的事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: 武器呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: 你想猎杀伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: Hunter:跟你说，他们肯定在搞事情。得彻底消灭
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: Hunter:自从太阳出毛病，这帮杂碎比往常更猖獗
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: Hunter:镇上？就想找个地方歇歇脚小子
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: 武器呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: 你想猎杀伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: Hunter:得清除干净。一个不留
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: Hunter:假装成我们，溜进门就大开杀戒
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: Hunter:挨家挨户的死人，撕得稀碎
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: Hunter:见过那些伪人干的好事吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: 想在这儿找什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: 为什么到处旅行？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: Hunter:但现在没法像以前那样溜达了。年纪大了都这样
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: Hunter:我不是本地人。从来不在一个地方呆太久
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: Hunter:嘿小子。你这片儿情况咋样？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: Prophet:再见。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: Prophet:……我想我该走了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: Prophet:没力气念下去了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: Prophet:“我们的青春如鲁昂的火刑柱般嘶吼……”
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: Prophet:再见。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: Prophet:谢谢。但是没什么用。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: Prophet:真遗憾。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: Prophet:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: Prophet:“一个人在两个世界之间高声唱着：火焰，与我同行。”
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: Prophet:我该走了。再见。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: Prophet:天啊……我忽然想起来什么了。谢谢你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: Prophet:……我明白了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: Prophet:“我们乘着通往虚无的列车已久。但道路仍在车轮下轰。”
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: 第十页？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: 第二百页中间的部分
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: 最后几页里挑一页
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: Prophet:我有点儿害怕，不过这样做说不定有用。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: Prophet:记不记得，我以前让你帮我从这本书里选一段，占卜未来？能不能再帮我选一次？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: Prophet:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: Prophet:是给你的讯息吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: Prophet:我脑子里只记得一个字……跳。这是什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: Prophet:但我以前……应该是能搞懂的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: Prophet:奇怪的问题。我已经完全不懂了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: 第十页？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: 第二百页中间的部分
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: 最后几页里挑一页
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: Prophet:说不定有用。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: Prophet:能不能再帮我算个命？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: Prophet:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: Prophet:我搞不清楚了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: Prophet:不知道是给我的……还是给你的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: Prophet:脑子里只剩下一个字，反复出现：跳。跳。跳。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: Prophet:我……我都记不清了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: 你要死了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: 你说的是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: Prophet:这样有什么意义？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: Prophet:可现在，她却要把一切收回去？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: Prophet:没有她，我撑不到现在。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: 你要死了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: 你说的是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: Prophet:天啊，我得……别管我。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: Prophet:我明白正在发生的是什么……这是早就该发生的事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: Prophet:启示的幻象……都消失了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: Prophet:太迟了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: 你看起来……状态很不好
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: 别死在我家门口
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: Prophet:她抛弃我了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: Prophet:启示的幻象渐渐消散，几乎看不见了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: Prophet:我忘记了你的脸。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: Prophet:我得一个人待会儿，理一理思绪。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: Prophet:记住……跳还帮不了你，起码现在还不行……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: Prophet:而你……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: Prophet:这件事必须完成。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: Prophet:我……我记得……这么做是对的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: Prophet:我该休息了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: Prophet:别跳。还不到时候。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: Prophet:不过……我还在土壤里……看到了一样东西……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: Prophet:天啊……我思绪都混乱了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: 你确定真有东西？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: 我要那东西有什么用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: Prophet:你命中注定会发现那个东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: Prophet:土壤下面埋着什么东西……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: Prophet:我……我看见接下来发生什么了。地下室。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: Prophet:但现在……我能看到的启示幻象蒙上了一层迷雾。我看见你迷失在黑暗的森林里，被野兽包围。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: Prophet:我们的相遇是有原因的，原因我还记得很清楚。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: Prophet:……我知道，这话听起来很奇怪。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: 你确定真有东西？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: 我要那东西有什么用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: Prophet:但我看不清具体是什么……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: Prophet:土壤下面埋着什么东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: Prophet:你家有个地下室对吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: Prophet:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: Prophet:我来找你之前，一切都很清晰。可现在……都模糊了，好像罩上了一层迷雾。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: Prophet:天啊……我不是想吓唬你，只是习惯自言自语。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: 我开始后悔信任你了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: 你说的话我就没听明白过
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: Prophet:但现在……不太对劲。难道是……？蘑菇人么……？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: Prophet:你向它求救，它自会前来为你解围。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: Prophet:但你不用害怕，我们只是还没察觉到而已。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: Prophet:世界上存在比我们更强大的实体。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: Prophet:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: Prophet:不对。绝对不是。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: 我开始后悔信任你了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: 你说的话我就没听明白过
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: Prophet:新芽将破开灰烬，伸向天空。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: Prophet:最开始也发生过这样的事。不过一切都会好起来的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: Prophet:说不定不是你的问题，也不是她的问题……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: Prophet:我越发虚弱，看得没有以前那么远了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: Prophet:得到的帮助够多了，只是……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: 你在自言自语？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: 需要帮忙吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: Prophet:是因为这些破坏吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: Prophet:感觉更糟糕了。奇怪了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: Prophet:你在的吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: Prophet:希望能早日再会。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: Prophet:但现在那种不对劲的感觉稍微缓和了点儿。看来我们走对了，这条路没错。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: Prophet:我刚来到这儿，觉得有什么地方……不太对劲。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: Prophet:往后两天……检查别人有没有伪人的特征，会带来灾祸。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: Prophet:就当是给你的忠告吧……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: Prophet:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: Prophet:不能再说了。我说的够多了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: Prophet:希望能早日再会。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: Prophet:我的指引说不定会给你带来安宁，就算不能，也起码能帮你一把，让你继续前进。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: Prophet:你能做得到的话，我会继续指引你前进。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: Prophet:等到第三个日出，再继续检查屋子里的人吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: Prophet:但是……往后两天……检查别人有没有伪人的特征，会带来灾祸。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: Prophet:无可奉告。我说的够多了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: 会发生什么事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: 告诉我这些有什么用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: Prophet:说不定会有电台聊到这个东西。你要不要听听看电台？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: Prophet:你无法阻止。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: Prophet:但有一点很清楚，那就是邪恶正在逼近。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: Prophet:多亏有她在，我才能看到那么远的未来。即便如此，我也只能看到这么多了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: Prophet:有个强大的存在，正等着猫接近。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: 会发生什么事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: 告诉我这些有什么用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: Prophet:说不定会有电台聊到这个东西。你要不要听听看电台？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: Prophet:起因与你无关，但你还是能感受到它带来的影响。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: Prophet:那是个很可怕的东西。你即将与它相遇。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: Prophet:我也不是什么都能看得到。但要说你的未来么……有个东西正在你道路的前方，静候你的到来。我知道那是什么。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: Prophet:我跟绝大多数人不同，能看到很远的未来。算是种天赋。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: 为什么让我放带猫的人进屋？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: 你怎么知道我放猫进去了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: Prophet:至于带猫的那个人怎么处置……全看你的意思。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: Prophet:很好。你放猫进屋子里了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: 我们就会离开。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: 只要交出两人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: 你就只能一个人留在这里等死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: 将里面的人给全部抓走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: 如果我们把门破开。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: 真是白费口舌。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: 好了，保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: 我也一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: 我再也不会让你们带走任何的住客了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: 希望不会发展成这样的结局
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: 看来，也得给你一点颜色瞧瞧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: 之前也曾经试过有人拒绝配合，而我们已经将他们收拾服贴了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: 要嘛我们直接把门给破开、将里面的人给全部抓走，要嘛你立即交出其中的两名住客，自己选吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: 我也懒得跟你继续争辩下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: 我已经不知道该说些什么好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: 我再也不会让你们带走任何的住客了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: 希望不会发展成这样的结局
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: 然后，要嘛就是我们成功找到对抗伪人的方法、要嘛……就是我们再也没有办法活着见面了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: 我们不会把所有的住客给通通带走，只要两人就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: 只要两人就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: 妈的，如果这也不行、那也不行，要你们来有什么用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: 要怎样才能阻止这场横祸？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: 如果找不到办法挽救这一切，就会被他人主宰我们的命运。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: 我们接受的是根本就不可能完成得了的任务。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: 政府准备要把整座城市都给炸毁，他们已经无法遏止情况恶化下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: 没错。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: 妈的，如果这也不行、那也不行，要你们来有什么用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: 要怎样才能阻止这场横祸？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: 耍花招？好啊，看我们把整栋房子里面的人一个不落地全部带走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: 整个世界都正处于危难关头，已经再也没有时间可以浪费。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: 不要再废话了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: 迎来横祸？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: 我、被、带、走、的、住、客、怎、么、还、没、给、送、回、来？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: 否则，将会迎来横祸。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: 我们还是需要再次从你这里带走数名住客。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: 我们很快会把被带走的住客给送回此处，非常感谢你的配合。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: 快、点、把、人、交、给、我、们。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: 我们非常在乎这座城市。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: 要是反抗的话，将会发生更多的爆炸事件。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: 这妨碍公务的下场。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: 看到我背后的这幅光景了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: 好吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: ……妈的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: 我们一定会把伪人通通给消灭干净。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: 我们一定会把被带走的人给送回来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: 非常感谢你的理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: 一定能帮上忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: 我已经受够了，找其他人去吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: 好吧，要是能帮上忙的话……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: 然后，状况很快就会稳定下来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: 谁都可以。快点把人交给我们，就是现在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: 这次，我们需要带走两人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: 没错。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: 我已经受够了，找其他人去吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: 好吧，要是能帮上忙的话……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: 如此一来，就能加快研究的进度……这已经最好的办法了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: 具体来说，两人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: 我们需要带走数名住客。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: 我还得让你再带走几个住客吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: 好吧。现在，该怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: 事情已经在掌控之中了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: 就让我们专心执行自己的工作吧，好吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: 要是能轻而易举地把它们通通给消灭干净的话，就根本没有成立应急中心的必要了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: 我还得让你再带走几个住客吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: 好吧。现在，该怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: 只要好好配合，兴许，就能早点结束。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: 至于何时，并不好说……我们还需要更多的人手来控制住现在的这一局面。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: 我们还在进行研究。劝你管好自己的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: 你们究竟什么时候才能把伪人给赶出我们的家园？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: 这种情况究竟要持续到什么时候？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: 你知道吗？我的家……就在那里。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: 睁大你的眼睛看看这一切都带来了怎样的后果，我们不得不夷平遭到伪人盘踞其中的整个热区。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: 每个人都想要妨碍我们。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: 轮不到你提要求。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: 你们究竟什么时候才能把伪人给赶出我们的家园？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: 这种情况究竟要持续到什么时候？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: 只会因此引起更多的暴力事件。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: 窝藏伪人没有任何好处，只会令他们不断地增殖。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: 要是拒绝的话，将会发生更多的爆炸事件。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: 恶果。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: 先把之前被你们带走的住客给送回来再说！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: 城里到底出什么事了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: 越快越好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: 我们需要再次从你这里带走数名住客。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: 你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: 无论如何，我们都会进行检查，早点配合、早点完事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: 你没得选。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: 你误会了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: 检查完毕之后，我们将告诉你接下来该怎么做。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: 放心。虽说程序相对比较繁琐，然而也会留出休息时间。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: 我对你们所谓的检查不感兴趣
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: 要是除此以外别无他法的话，好吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: 为了更加深入地研究太阳造成的影响，我们需要再次从你这里带走数名住客。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: 目前尚无任何定论。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: 我对你们所谓的检查不感兴趣
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: 要是除此以外别无他法的话，好吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: 之后，我们就会将他们从隔离区送回此处。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: 被带走的人在经过筛选之后都必须进行强制隔离。因此，你的住客需要暂时与我们待在一起、由我们进行看护。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: 嗯……原来如此，看来，我们的工作人员之前已经拜访过你这里了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: 「给送回来」？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: 之前的检查，结果怎样了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: 你们究竟要到什么时候才会把上次被带走的住客给送回来？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: 放心，不会花费你太长的时间。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: 我们隶属于应急中心，正在对住在这里的市民进行常规检查。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: 晚安。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: 一定要照顾好自己，知道了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: 然后……目之所及的一切事物都将无比迅速地变得异常黑暗。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: 如果过分地纠结其中，它就会将你蚕食殆尽。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: 千万不要把自己困于悲伤之内。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: 也许，到时……盘踞在脑海之中的念头，就不会只有死亡一种了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: 希望你可以回忆起快乐是一种怎样的情绪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: 能理解吗？最近，生活变得越来越苦了，实在是过于苦了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: 令他们想起往昔的日子，当时，我们目标并非生存下去、而是要创造出……美好的事物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: 然而，如果可以三不五时地提醒一下他们过去是如此的开心……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: 怎么能说是撒谎呢？大家都出于各种原因深陷在痛苦之中，我能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: 越是这种时候，越不能让黑暗将我们给整个吞没。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: 试着回忆起它曾为你带来的快乐吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: 好好思考一下吧，灾变开始之前，你最喜欢的东西是什么呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: 可多了。不过……我不会告诉你、你应该去为什么感到开心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: 你要对大家撒谎吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: 现在这种状况，到底还有什么东西是值得我们去感到开心的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: 绝望令我们忽视了尚存于世的美好事物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: 恐惧让大家忘记了快乐究竟是一种怎样的情绪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: 的确……我也已经很久没见到过有人能笑出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: 我知道了，你是想问我为什么这种时候还能笑出来，对吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: 怎么了吗？没问题吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: 你要对大家撒谎吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: 现在这种状况，到底还有什么东西是值得我们去感到开心的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: 如果我们能锲而不舍地对自己说，「一切都会好起来的」，说不定一切就真的会一点、一滴地好起来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: 譬如，我们的下一代、美术，又或者是……生命本身。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: 没错，现在的日子的确是过得非常地艰难，不过，还是有一些东西值得我们为之奋斗。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: 外头四处弥漫的愤怒已经足够多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: 你的脸是怎么回事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: 你为什么这么地有精神？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: 能让我待在这里过夜吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: 我听到了一些动静，你已经来到门后啦，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: 去你妈的吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: 看来，你也是一个恶心至极的混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: 哼……无所谓。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: 只是……唉，没事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: 哎呀，你这里甚至还铺了地毯。酷哦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: 哇哦……太好了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: 你真的忍心把一个孩子丢在这里自生自灭，顶着能把人给活活烧死的太阳、能把人给开肠破肚的伪人？'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: 不管怎样……我都已经来到这里了。我真的需要一个安全的地方待着。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: 我的妈妈特别、特别地喜爱日光浴。因此……是的，也很有可能已经被晒成焦炭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: 或许，都已经变成伪人了也说不定。哼……要真落得了这个下场的话，也挺适合他们的就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: 天知道他们在哪里。家吧，大概。不然，还能在什么地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: 如果你也是这样的变态……事先声明，要是敢对我动手动脚的话，就别怪我一拳把你揍得眼冒金星！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: 虽说，偶尔会遇到一些混蛋就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: 只是，我身无分文。因此……要嘛就是跟人谈好条件、住进房子，要嘛就是偷偷溜进没人占用的地下室里面，过上一晚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: 我在……四处旅行，应该可以这么说吧。想要亲眼看看这个世界，想要抵达不同的地方。或许，还能找到一个新的家也说不定。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: 你的父母呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: 你为什么要躲在地下室里面？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: 附近没有什么诸如地下室之类的，比较合适的藏身之处。于是，我就来敲你这里的门了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: 虽然有点唐突，不过……能不能让我在这里借住？还是说，你要把我一直晾在这里？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: 你父母呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: 为什么躲地下室？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: BigLebowski:受够躲地下室了。再这样下去都快忘记怎么跟人说话了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: BigLebowski:没，就想借住会儿。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: 嗯，是我的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: 你在找人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: BigLebowski:这是你的地盘吗？我是说……是你的房子吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: BigLebowski:你好。呃……还是说“嗨”比较合适？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: Couple:腿呐，赶紧挪一挪，动起来！你累我也累啊。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: Couple:那我们继续找吧，宝贝儿？
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582080
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582081
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776384
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776385
    m_Localized: （收下货物）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: Greatmother:家里有人不？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: Greatmother:哟呵！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: Couple:明白了。不好意思，打扰你了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: Couple:她就是有点儿害羞。没事的，宝贝儿，好好休息，休息好了就能恢复平时的状态了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: Couple:太感谢了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: Couple:不好意思，不该问你这个。我多管闲事了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: Couple:不过幸好我老婆还在。没她我早垮了。话说回来，你这些日子又是靠什么撑下来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: Couple:这些破事全堆在了一起……太难熬了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: Couple:累？最近有什么是不累人的？伪人冒出来了，天气热得要死，还让老板开了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: Couple:噢，对不起，不该逼着你说话的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: Couple:你说是吧，亲爱的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: Couple:哪天还能遇到的话，我再叫上我老婆跟你一块儿聊聊天吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: Couple:不好意思，她累坏了，话都说不出。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: Couple:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: Couple:肯定会啊！亲爱的，来，说句话？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: 你们怎么这么累？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: 你老婆自己不会说话？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: Couple:嗯，前提是不会给你添麻烦。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: Couple:但我老婆真的累坏了，得休息会儿。我们就待一小会儿，你看行吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: Couple:呃……要不我们再去别的地方找找，看看哪儿能躲一躲？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: 你们怎么这么累？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: 你老婆自己不会说话？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: Couple:屋子够大，有点儿偏僻，没有好管闲事的邻居……疯子找上门的几率小点？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: Couple:我也不知道该怎么解释，哈哈。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: Couple:说实话，你这儿比别的地方都安全，对吧，亲爱的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: 万一你们来了给我惹来了麻烦，怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: 你觉得我家像安全地方？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: Couple:不麻烦的话，能不能让我们在这儿借住一会儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: Couple:你好！我和我老婆想找个安全的地方躲一躲！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: Couple:……嗯，好多了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: 就把它当成……我送你的礼物吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: 你会在房子的下面找到这只猫咪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: 来吧，猫咪，你肯定能让我忙上一阵子，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: 不要拘谨。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: 见鬼去好了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: ……进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: 再好好想想吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: 你有看到这只猫咪吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: 对了，千万不要虐待这只猫咪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: 我都已经快要被冻成冰棒了，年轻人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: 到底要不要开门让我进去？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: 我通过检查了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: 难道，这样都还不够吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: 我有两条手臂、两条腿，以及一个脑袋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: 怎样，你决定好了吗？现在，到底要怎么做？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: 毕竟，我是个跳芭蕾舞的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: 说不定真的会哦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: 想要看我跳舞吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: 这又怎么了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: 证实自己是个人类
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: 我认为你并非人类
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: 听起来还真诡异。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: 现在到底是怎样？你记起他了，然后呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: 好吧……怎样都行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: 证实自己是个人类
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: 我认为你并非人类
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: 嘿嘿。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: 不知道，重要吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: 你让我想起了……认识的人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: 谁派你来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: 这儿没那么热。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: 望见了你的房子，于是便走了过来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: 看到那边的城市了吗？我之前就是住在那儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: 你让我想起了……认识的人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: 谁派你来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: Ballerina:以前是跳芭蕾的，看出来了么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: 我会跳舞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: 你是怎么找到我的房子的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: 有人要我来，于是我就来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: 到底要不要开门让我进去？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: 一箱啤酒、一件衣服、一根火腿，谁知道呢，什么都行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: 你是怎么找到我的房子的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: 这又怎么了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: 还真是喜欢提问，没错，我认识他。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: Ballerina:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: 你想要什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: 你认不认识个……秃头的男的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: Ballerina:开不开门？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: Ballerina:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: Ballerina:嗨。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: Teacher:你要是遇到了无依无靠的小孩……能帮就帮吧。再见。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: Teacher:我不怪你。不过……临走之前，我想麻烦你答应我一件事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: Teacher:但是……谢谢你听我说这些事。也谢谢你让我进去。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: Teacher:我知道，我再也没法把他们带回来了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: Teacher:他们把一切烧成了灰烬，还逼我看着是怎么烧的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: Teacher:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: Teacher:他们做错了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: Teacher:我们变成什么了？审判弱小的孩子的冷血暴徒么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: Teacher:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: Teacher:他们发现我收留了很多有伪人特征的小孩子。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: Teacher:是……镇上的人干的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: Teacher:我到现在还能感觉到，他们那一双双惊恐的小眼睛，正盯着我看……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: Teacher:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: Teacher:放火不说，还逼着我看他们是怎么杀人的……先锁门，钉死窗户……然后放火烧楼。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: Teacher:镇上的人放的火。他们怕这些孩子真的是伪人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: Teacher:死了……都死在火海里了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: Teacher:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: Teacher:他们……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: 为什么会起火？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: 那些孩子怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: Teacher:但现在……全没了。起火了，好大的火，他们一个都没活下来……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: Teacher:还有的是觉得孩子有伪人的特征，就不要他们了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: Teacher:有的是被应急中心带走了，有的是被杀了，还有的……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: Teacher:那些孩子都失去了父母，但理由各不相同。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: Teacher:世界文明开始崩溃以后，我收留了那些被人遗弃的小家伙。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: Teacher:我以前是幼儿园老师。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: 为什么会起火？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: 那些孩子怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: Teacher:但还是不够……我没有救下他们。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: Teacher:他们只需要有人爱，有人关心，我能给的都给了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: Teacher:我跟那些孩子一起住在旧幼儿园里。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: Teacher:那些被人怀疑是伪人的孩子，别人口中的“不干净”的孩子……我都收留了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: Teacher:我……我只是想给被抛弃的孩子一点儿希望。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: 怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: Teacher:我心里太难受了，能不能跟你聊聊？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: Teacher:不好意思，打扰你了……能占用你点儿时间么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: Dude:照顾好你自己……还有你朋友。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: Dude:没事儿，懂。不怪你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: Dude:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: Dude:伙，计……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: Dude:是个拍电影的好材料！以后肯定得找机会拍一部！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: Dude:这估计是我这辈子遇到的最牛逼的事了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: Dude:哟，！谢了啊，伙计！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: Dude:我一直在想，哪天能进电影里就好了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: Dude:比书带劲多了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: Dude:什么都有！比方说戏剧冲突、背叛，还有阴谋！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: Dude:但我跟你说，电影啊……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: Dude:新闻播了那堆破事儿以后，我跟你说，伙计，气氛完全不对了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: Dude:大家一个劲儿相互抹黑，你骂我我骂你的，还整天说丧气话，把好心情都给搅了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: Dude:没错，外面乱套了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: Dude:好吧，我冷静点儿……但是，伙计，你就放我进去呗！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: Dude:绝了！我伙计看的个人志就这么写的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: Dude:想象一下，咱们去太空，给外星人发邮件……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: Dude:他们脑子通宇宙的，好多牛逼的科技还没问世，他们就能预言到以后会有，然后写下来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: Dude:你知道科幻作家能预知未来吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: Dude:伙，计！我清楚得很！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: 你真的一点儿都不知道外面发生了什么事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: 你到底在胡扯什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: Dude:还得有吃的，越多越好。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: Dude:另外，你有霰弹枪或者手雷吗？对付僵尸，得搞点儿重火力。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: Dude:真的，伙计，类型不同，作战计划不同。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: Dude:他们是感染病毒变的僵尸，还是不死族啊？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: Dude:欸，给我透露透露，这帮僵尸是经典的那款，动起来很慢的，还是特棘手，跑起来很快的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: Dude:这种剧情我电影里见得多了，我简直就是个生存专家。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: Dude:伙计，跟你说吧，我这人，靠得住，包我身上了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: Dude:僵尸？！伙计！我就知道！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: 你真的一点儿都不知道外面发生了什么事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: 你到底在胡扯什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: Dude:噢，还必须是四人组队，四个，这就是黄金生存人数。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: Dude:砰！火箭发射，拯救世界任务启动！帅炸了！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: Dude:咱们只要派一队牛逼宇航员去太阳就行了对吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: Dude:伙计，我看过那部电影！就秃头主角那个！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: Dude:绝对不可能！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: 长得像人的玩意儿正从地底往外爬。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: 太阳耀斑爆发，白天能把人活活烧死，
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: Dude:跟我说实话，我到底错过了啥？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: Dude:伙计，你看见外面多离谱了吗？这都啥情况啊？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: Dude:哟！最近咋样啊？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: Blind:不然，它会找到你的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: Blind:看在上帝份上，天黑以后，千万别靠近焦尸。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: Blind:好吧，我走。但我得警告你一句……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: Blind:靠……眼睛都没了，还怎么闭上眼睡觉？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: Blind:谢谢你……我说不定总算能休息一下了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: Blind:那东西不该存在……根本就不该存在！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: Blind:那东西更庞大……也更强大……还不可名状。它会循着烧焦的尸体的气味，前来收割我们播种下的一切。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: Blind:怎么可能……这儿有更加恐怖的东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: Blind:你觉得光是那个浑身苍白的男人，就能吓得我挖掉眼睛？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: Blind:老天啊……我再怎么恨一个人，也不愿意对方看见那副景象！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: Blind:就在我眼皮子底下……慢慢吞吃那些黑得像煤炭一样的躯干！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: Blind:它……起初没注意到我，忙着啃食焦黑的尸块……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: Blind:我只做错了一件事，那就是在错误的时间，去了错误的地方……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: Blind:对它而言，我们的痛苦是盛宴，是悲恸的筵席！它贪婪地吞食着我们的恐惧、痛苦……还有心智！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: Blind:信我一句，你还是不知道为好……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: 你说的是那个浑身苍白的人么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: 你看到了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: Blind:我以为挖掉眼睛，就能抹掉那副恐怖的景象，可挖掉以后，能看到的只有无尽的虚空。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: Blind:只能靠牺牲眼睛来保持理智。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: Blind:我……自己弄的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: 你说的是那个浑身苍白的人么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: 你看到了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: Blind:相信我……你要是看见了，也会这么做。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: Blind:有种难以言明的古老恐惧，撕碎了我的灵魂。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: Blind:那副画面一直停留在我眼前，永远烙在了黑暗里。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: Blind:我看见了不可名状之物，甚至都不敢跟人描述……精神崩溃看到的景象，谁愿意去反复琢磨？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: 谁干的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: 你的眼睛怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: Blind:总算……有个能躲的地方了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: Fatman:我能去哪儿？彻底完蛋了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: Fatman:拜托了伙计，你看得出我不对劲。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: Fatman:等这一切结束了，肯定重重谢你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: Fatman:你不会后悔的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: 只要能让我进去，我可以向你保证……等一切都结束之后，我会给你这辈子都花不完的钱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: 拒绝一个有头有脸的人物可不是什么明智之举。要知道，我可是个议员，之前负责掌控这个地方大大小小的各种事务。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: 光是来到这里，就已经费了我很大的工夫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: 拜托，兄弟……我已经受不了了，赶紧让我进去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: 我是认真的。我感觉很不舒服，现在就需要冷水。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: 赶紧离开吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: 不然，我就会昏倒在大街上。然后……想也知道……等太阳升起来之后，就会被烤成一团黑炭。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: 哎，管他呢。快点，快开门，我得洗个澡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: 完蛋……放松下来之后，反而开始想吃冰淇淋了。真是该死。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: 太好了！终于是给我找到了！还以为要被融成一滩肉泥，就这样烂在大街上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: 你要去浴室干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: 嗯。有
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: Fatman:我现在就想泡个冷水。借个浴室用用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: Fatman:比住过的五星度假村还烫。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: Fatman:皮肤像烧起来一样。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: Fatman:好个屁。看看我这德行。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: 你要去浴室干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: 嗯。有
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: Fatman:有……有没有浴室借我用用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: Fatman:是凉快了点，但空气稠得喘不过气。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: Fatman:管他几点。简直像烤炉。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: 你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: 这可是大半夜
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: Fatman:该死，外面快热疯了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: Buddy:行啦，不给你添麻烦。我走就是了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: Buddy:靠……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: Buddy:不然我真没地方可去了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: Buddy:谢了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: Buddy:好了说正经的，让进吗朋友？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: Buddy:苦成这样，找点儿东西消遣消遣怎么了？唉，世界这样了，还得保持清醒，那太难受了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: Buddy:嘿嘿，别紧张，你看你又上当了！别见怪，这年头只剩这点乐子了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: Buddy:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: Buddy:美味又健康，还算得上是节食哦！瞧瞧我这身材！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: Buddy:今早吃了顿皇家早餐！照我伙计食谱来的：啤酒配早餐，葡萄酒配晚餐。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: Buddy:怎么样……让进吗朋友？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: Buddy:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: Buddy:我的玩笑话要是冒犯了你，实在不好意思。我也是想尽力保持冷静，才老开玩笑。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: Buddy:笑一笑还能让人保持理智！不开开玩笑，我早疯了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: Buddy:我这张嘴贫是贫，但离讲脱口秀远着呢。世界都乱成这样了，讲两句俏皮话怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: 听着像醉话。你是不是喝酒了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: 张嘴能把人逗乐？你是讲脱口秀的么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: Buddy:算了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: Buddy:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: Buddy:有一两个地方奇怪又怎么了，说明不了你是伪人。我连，
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: Buddy:新闻里说什么眼睛长啥样，牙齿长啥样就不正常，我才不信，更不会为了这种东西伤害别人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: Buddy:诶唷，别绷着脸嘛，不就跟你开个玩笑！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: Buddy:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: Buddy:我见了牙齿白净，眼睛漂亮的，可能也会一拳打过去……但那纯属嫉妒。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: Buddy:你绝对遇不到第二个像我心肠这么好的。就信我吧朋友。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: 听着像醉话了。你是不是喝酒了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: 张嘴能把人逗乐？你是讲脱口秀的么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: Buddy:所以想去酒吧喝两杯，找我就成，随时奉陪！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: Buddy:我哪来丈母娘，光棍一个！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: Buddy:噗，上当了！开个玩笑，朋友。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: Buddy:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: Buddy:让丈母娘赶出来了。谁叫我把应急中心的踹出去了，她怕人家等下要来敲门讨说法。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: Buddy:嗐，没啥大事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: 我怎么知道你到底是不是好人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: 你怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: Buddy:哟，朋友，能让好人进去坐坐么？我一个人一张嘴，能把大家逗乐。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: Bestson:再见，陌生人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: Bestson:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: Bestson:嗯……他们肯定很快就会回去了，我觉得是这样。唔，希望是吧……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: Bestson:我还是回家吧，万一他们回去了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: Bestson:嗯。这样更安全。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: Bestson:不过……你是对的。说不定暂时跟你待在一起会比较好。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: Bestson:我不在家里待着，万一他们回家了怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: Bestson:我也不知道这样好还是不好。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: Bestson:我该怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: Bestson:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: Bestson:太可怕了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: Bestson:天啊，万一……万一他们让太阳给烧死了怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: Bestson:我该怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: Bestson:我都不知道自己该怎么想了。你说不定也不相信我。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: Bestson:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: Bestson:该死，他们为什么忽然就走了？为什么不带我一起走？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: Bestson:天啊……爸爸妈妈要是让伪人杀了怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: 太阳快要爆炸了，出去的人都会让它烧死
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: 地底下爬出来一堆伪人。想活着，就谁也不能信
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: Bestson:我想着找人聊聊，说不定能知道到底怎么回事。求你了，你能不能告诉我出什么事了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: Bestson:新闻播了几个小时后，他们急急忙忙出去了……再也没回来。我现在更不敢开电视了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: Bestson:我不想焦虑，没开电视。可一走就没回来，我也不知道发生了什么。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: Bestson:有一天，他们从新闻里得知了什么很可怕的消息。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: Bestson:但我爸妈总是守着电视。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: Bestson:据说不看新闻的人活得更长。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: Bestson:新闻没报过什么好事，我越看状态越差，干脆就不看了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: 太阳快爆炸了，能把待在外面的人活活烧死。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: 地底下爬出来一堆伪人。想活着，就谁也不能信
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: Bestson:我得弄清楚到底怎么回事。他们去哪儿了？到底发生什么事了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: Bestson:这一走就是一个礼拜……我等了好久……也没见他们回来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: Bestson:我有天早上起来，发现他们吓坏了，说要赶紧走。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: Bestson:不看，我一看新闻就害怕……干脆不看了。但是我爸妈看……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: 你不看电视？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: 你真不知道怎么回事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: Bestson:开枪杀人，打架斗殴……我不知道是怎么了……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: Bestson:天气变了，热得我都没法呼吸，这儿的人……也变了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: Bestson:你能告诉我发生什么事了么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: Fugitive:晚安好梦，混账东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: Fugitive:就好好躲在洞里，一个人也别放进来吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: Fugitive:我就知道，你跟其他人没两样，都是吓傻了的耗子。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: Fugitive:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: Fugitive:靠。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: Fugitive:你没跟你邻居一样，真是太好了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: Fugitive:太谢谢你了，我欠你条命。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: Fugitive:他们干的事我全看见了……我知道得太多了，他们不会放过我的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: Fugitive:哪怕爬围栏让人一枪打穿了肚子，也得跑。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: Fugitive:我看见以后就知道，得赶紧离开这鬼地方。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: Fugitive:他们对隔离区里的人下了手，进去的才没几个能出来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: Fugitive:里面传来一阵低沉的尖叫声……那个可怜虫再也没出来过，只看见从帐篷里拖了个黑袋子出来。你明白怎么回事了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: Fugitive:我亲眼看见了，他们带了个可怜虫进帐篷。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: Fugitive:这可不是谣言！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: Fugitive:你听没听说过，应急中心的人靠检测来分辨谁是伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: Fugitive:你最好信我。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: Fugitive:我从围栏上摔了下去，直直跌进水坑里，爬起来赶紧跑了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: Fugitive:不过我在关键时刻倒了霉……有个猪猡刚好转过来，看到我在爬围栏，举枪就射。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: Fugitive:他们忙得很，看得出来……在准备什么东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: Fugitive:都不用费心思谋划，找准时机，翻过围栏就成了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: Fugitive:他们说的什么保护措施也是个笑话。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: Fugitive:你口中的应急中心隔离区就是这样。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: Fugitive:有个大得出奇的集装箱，他们每天早上把一堆人往里塞，跟塞牲口一样。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: Fugitive:你想象一下，一片空地，四周有围栏，中间散落着几顶帐篷。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: 这么说，应急中心的人在追你？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: 跟我说说应急中心隔离区的情况
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: Fugitive:我叫他们滚蛋，他们就把我拷上了，跟拷犯人似的。不过我还是跑了出来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: Fugitive:接着在平板上划拉了几笔，就让我跟他们走。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: Fugitive:我一开门，发现他们已经扫描起我来了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: Fugitive:我让他们抓去了隔离区，刚刚才跑出来。那天，应急中心的人上我家来做调查。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: 这么说，应急中心的人在追你？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: 跟我说说应急中心隔离区的情况
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: Fugitive:好在内脏没流出来……不过真要流，肚子里也没剩多少东西就是了……[1]哎哟……啊……疼得要人命了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: Fugitive:算我运气好，子弹穿出去了，没留在里面……[1]不过血哗哗流，跟挨宰的猪似的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: Fugitive:举枪就射，枪法是真烂，不过……还是有颗子弹……打中了我。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: Fugitive:我在那爬围栏，准备跑出去……应急中心那群挨千刀的猪猡……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: 怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: 谁干的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: Fugitive:我中枪了，撑不了多久。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: Fugitive:救救我……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: Nun:主不会忘记的，祂看得一清二楚。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: Nun:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: Nun:我的死会成为压在你灵魂上的重担，记住我的话吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: Nun:可怜的老妇人登门求助，你将人拒之门外。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: Nun:噢，你就这样是吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: Nun:太谢谢你了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: Nun:你尽管放心，我会想尽办法，把这些污言秽语彻底清除干净。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: Nun:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: Nun:我只是问了问你屋里的情况，你就这样咒骂我？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: Nun:你就不敬畏上帝吗？！连羞耻之心都没有吗？！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: Nun:无礼的野蛮人！不知信仰上帝！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: Nun:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: Nun:这样也算过分么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: Nun:我受不了肮脏和堕落，问这两个问题，无非是想看看能不能在你这儿落脚。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: Nun:太谢谢你了！没你我还真搞不清楚呐。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: 你脑子进水了？！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: 我这儿不是酒店！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: Nun:我一碰到，身上就会发红起疹子，可受不了了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: Nun:第二……你屋里有臭虫和老鼠么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: Nun:你屋里要有这两种人，最好跟我直说。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: Nun:第一，我受不了酒鬼和嗑药的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: Nun:你放了些人进屋对吧？那我得先跟你确认几件事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: Nun:要你分个房间给我。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: 你脑子进水了？！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: 我这儿不是酒店！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: Nun:你这儿有圣像吧？还有……我要安静，一点儿声音都不能有，方便我祈祷和冥想。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: Nun:说到这个……请容我问你件事。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: Nun:当个住处正合适，孩子。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: Nun:上主垂怜啊，我说得够明白了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: 你具体需要什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: 什么正合适？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: Nun:对我来说正合适。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: Nun:这么几个屋子，就你这小房子最偏。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: 对不起，浪费你时间了。我……我哪天能学会杀人就好了，这样我就能保护好自己了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: 我真不是疯子，就是……这段时间弦崩得太紧了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: Raskolnikov:估计我说话给人感觉像疯子吧，可能比疯子还吓人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: Raskolnikov:不让我进？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: Raskolnikov:能不能让我看看你是怎么杀伪人的？我想亲眼看看自己害怕的东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: Raskolnikov:那个……不麻烦的话……你检查完我以后……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: Raskolnikov:谢谢你，朋友。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: Raskolnikov:能不能教我……怎么杀人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: Raskolnikov:不过……你要是……愿意的话……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: Raskolnikov:所以我才想找个……能保护我的人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: Raskolnikov:至于我，就是个胆小鬼，连自己都保护不了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: Raskolnikov:如今这世道，看人家一眼，只要人家觉得你表情不对，就能开枪打死你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: Raskolnikov:防的是伪人，还有猎杀伪人的人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: Raskolnikov:搞错了吧，我不是要防那个拿枪的疯子。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: Raskolnikov:所以我得找个知道怎么在如今这世道活下去的人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: Raskolnikov:我怕学不会自卫反击，后果不堪设想。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: Raskolnikov:以前世道还太平，我连只苍蝇都不忍心打死，可如今……我这种性格的人，活不长久。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: Raskolnikov:我也不想让人觉得我像个疯子，可……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: Raskolnikov:什么？呃……你是不是觉得我说话的样子……不太友好？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: 你到底是想防着谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: 你怎么对杀人这么感兴趣？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: Raskolnikov:到那时候，怕的就该是他们，不是我了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: Raskolnikov:算了，反正我总有一天也会学会杀人的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: Raskolnikov:幸好他没看见我，不然当场拧断我脖子都有可能。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: Raskolnikov:就是……我刚碰到个带枪的疯子，亲眼看着他拿枪指着个小伙子，不停问对方是不是伪人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: Raskolnikov:别误会，我没有挑拨你去对付谁的意思。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: Raskolnikov:太好了！伪人真来了，你也能一枪一个。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: 你到底是想防着谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: 你怎么对杀人这么感兴趣？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: Raskolnikov:到了紧要关头，我看你不用武器也能杀人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: Raskolnikov:不过听你话音带着怒气，看来脾气也挺硬。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: Raskolnikov:说人家末日杀人有问题……跟去赛道上开超速罚单有什么区别？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: Raskolnikov:就是……眼下世道不太平，我想知道你能不能自保，有没有消除威胁的能力。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: Raskolnikov:啊……抱歉，没有冒犯你的意思。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: 有把枪
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: 问这个干什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: Raskolnikov:你身上有没有武器？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: Raskolnikov:朋友，你好。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: Wifefema:滚蛋吧你！我找你邻居去。拜了，混账东西。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: Wifefema:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: Wifefema:你这人怎么回事？我实际情况都跟你说了，你还不信任我？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: Wifefema:真的假的？我老公是应急中心的！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: Wifefema:你觉得我是伪人？！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: Wifefema:等会儿……什么情况？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: Wifefema:干掉了伪人，生活就能恢复正常了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: Wifefema:这才对嘛！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: Wifefema:说什么“应急中心的活儿不是女人干的”，就是胡扯。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: Wifefema:我以前是海关的，抓可疑分子是我强项。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: Wifefema:太不公平了。怎么，我不如我老公？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: Wifefema:管他以前是干嘛的。反正现在进了应急中心，这不就行了？他们要是只招女的，我也能进。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: Wifefema:呵，凭什么告诉你。你问这个干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: Wifefema:逮过不少带着各种违禁品的渣滓。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: Wifefema:我以前在海关上班，就是在边境那儿查进进出出的人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: Wifefema:唉，太可惜了。我跟搭档联手，肯定能把伪人全揪出来。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: Wifefema:哎，是就好了。他们不招女人，意料之中吧。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: 你老公以前是干什么的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: 你也是应急中心的么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: Wifefema:哼，混账司机，真会抢钱。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: Wifefema:我想给他个惊喜，特地花了一大笔钱打车来看他。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: Wifefema:听说应急中心招了他，我差点疯了！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: Wifefema:我大大方方告诉你吧！他是应急中心的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: 你老公以前是干什么的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: 你也是应急中心的么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: Wifefema:我老公应急中心的，等他抓到那个司机……指定把那口白得像珍珠的牙打掉，叫他自己咽下去，哼！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: Wifefema:我对天发誓，那司机的牙齿白得跟瓷器一样。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: Wifefema:花了我好大一笔钱。如今这世道，打车可不便宜。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: Wifefema:呃，打车呗。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: 你老公是做什么的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: 你是怎么过来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: Wifefema:没想到他那儿连个让我歇脚的地方都没有。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: Wifefema:我就跑来看他，想给他个惊喜。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: Wifefema:我老公单位把他调到这儿来了，
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: Wifefema:你好，我能不能在你这儿歇歇脚？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: Theorist:我信任过你，可你……让我对人类彻底失望了。再见。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: Theorist:世人有权知道真相！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: Theorist:你不该这样！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: Theorist:……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: Theorist:忘了那堆陈旧的谎言吧！我亲眼看见了世界的真相！千真万确！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: Theorist:我就知道你值得信任。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: Theorist:所以我那天昂首挺胸，只拿了几份有价值的档案就走了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: Theorist:只要戴上耳塞……寄生虫就进不去了，那成千上万的人也就不用死了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: Theorist:但这帮蠢材就是不肯承认我的发现有价值。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: Theorist:我说伪人本身不构成威胁，可怕的是他们身体里的大脑寄生虫。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: Theorist:我以前在研究机构上班，但我因为有了不寻常的研究发现，就让他们给炒了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: Theorist:不过你得跟我保证，绝对不往外说。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: Theorist:唔，我既然信任你，那就告诉你好了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: 你最好赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: 进来吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: Theorist:……土豆味薯片为什么既违背科学常理，又平淡无味，失败中的失败。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: Theorist:精神控制，媒介是快餐，千真万确。还有……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: Theorist:选举操控，证明登月是假的。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: Theorist:朋友，做好准备，我要让你开开眼界了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: 你上哪儿弄来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: 你在说什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: Theorist:那也就是说……我可以跟你说点儿重磅消息。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: Theorist:你上来就说不是，那肯定不是。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: Theorist:按规定，应急中心的被人这么问了，必须得表明自己的身份。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: Theorist:噢，看来我可以信任你。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: 你上哪儿弄来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: 什么信息？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: Theorist:具体来说是海量的数据，我以后打算公之于众。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: Theorist:得找个安全的地方继续研究。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: Theorist:我带着不少文件，内容都特别敏感。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: Theorist:那还用问，肯定是重要的信息！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: 不是
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: 信任？你有什么东西要我保管么？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: 你……不是应急中心的人吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: 你好。请问……我能信任你么？'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: 喏，反正我也用不上了。扔了还是给人拿去用，随你高兴。'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter:  ……'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: 他们想让我们去应急中心的隔离区。不过去了的没一个能活着出来，谁还乐意去那地方……'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: 我们出发去救火之前，上头在工作场合给我们的。'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter:  ……'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: 起码不用死在潮湿的地上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: 我估计也麻烦不了你多久。*咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: 谢了，兄弟。*咳*'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
