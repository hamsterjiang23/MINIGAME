    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507559
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507560
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507561
    m_Localized: 'Cultist1: Vous ne devriez pas faire ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507562
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507563
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507564
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507565
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507566
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507567
    m_Localized: 'Cultist1: Mieux vaut éviter.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507568
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507569
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507570
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507571
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507572
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507573
    m_Localized: 'Cultist1: Pourquoi vous embêtez-vous avec ces tests ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507574
    m_Localized: 'Cultist1: Tenez-vous simplement prêt à partir au moment venu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507575
    m_Localized: 'Cultist1: Je ne sais pas ce que vous attendez.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507576
    m_Localized: 'Cultist1: Je n''ai rien à vous dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507577
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507578
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507579
    m_Localized: 'Cultist1: Cela fait longtemps qu''on ne m''a pas pris en photo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507580
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507581
    m_Localized: 'Cultist1: Vous aurez à répondre de vos actes.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507582
    m_Localized: 'Cultist1: C''était une erreur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507583
    m_Localized: 'Cultist2: Il n''y a aucune raison d''avoir peur. Nous allons tous partir vers une vie meilleure. Nous allons être sauvés.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507584
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507585
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507586
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507587
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507588
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507589
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507590
    m_Localized: 'Cultist2: Oui, bien évidemment.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507591
    m_Localized: 'Cultist2: Mal alignées… et peut-être un peu plus grandes que la normale.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507592
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507593
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507594
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507595
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507596
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507597
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507598
    m_Localized: 'Cultist2: Nous menons une vie difficile, c''est indéniable.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507599
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507600
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507601
    m_Localized: 'Cultist2: Nous ne dormons pas beaucoup.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507602
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507603
    m_Localized: 'Cultist2: Apparemment, cela Lui permettrait de Se rapprocher.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507604
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507605
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507606
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507607
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507608
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507609
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507610
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507611
    m_Localized: 'Cultist2: C''est la première fois que je me fais photographier.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507612
    m_Localized: 'Cultist2: C''est un peu… angoissant.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507613
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507614
    m_Localized: 'Cultist2: Comme c''est… intéressant.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507615
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507616
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507617
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507618
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507619
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507620
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507621
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507622
    m_Localized: 'Cultist2: Oh… Je n''aurais pas cru que ça me ferait aussi peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507623
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507624
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507625
    m_Localized: 'Cultist2: C''est bien trop tôt…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507626
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507627
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507628
    m_Localized: 'Cultist2: Laissez-moi vivre un peu plus longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507629
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507630
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507631
    m_Localized: 'Cultist2: Oh…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507632
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507633
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507634
    m_Localized: 'Cultist2: Moi qui venais tout juste de découvrir quelque chose de nouveau…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507635
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507636
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507637
    m_Localized: 'Cultist2: On ne nous a pas encore prévenus que le moment était venu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507638
    m_Localized: 'Cultist2: Ne faites pas ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507639
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507640
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507641
    m_Localized: 'Cultist2: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507642
    m_Localized: 'Cultist2: On nous a dit que toutes nos souffrances prendront fin avec la venue de la Mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507643
    m_Localized: 'Cultist2: J''espère sincèrement que c''est vrai… J''ai assez souffert, je veux enfin trouver le repos.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507644
    m_Localized: 'Cultist2: Oui, on nous enseigne qu''au-delà de ce monde, une vie paisible attend.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507645
    m_Localized: 'Cultist2: Mais vous ne pouvez pas imaginer à quel point il est angoissant de savoir que l''on va bientôt mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507646
    m_Localized: 'Cultist2: Je ne sais pas pourquoi, mais c''est vraiment embarrassant. Pourtant, je n''ai aucun problème au niveau des aisselles.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507647
    m_Localized: 'Cultist2: Rien que de prononcer ce mot me met mal à l''aise.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507648
    m_Localized: 'Cultist2: Ah, ce n''est pas une simple photographie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507649
    m_Localized: 'Cultist2: Je ne comprends rien à tout ça. Mais c''est magnifique.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507650
    m_Localized: 'Cultist2: Merci de me l''avoir montrée.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507651
    m_Localized: 'Cultist2: Puisqu''il y a tant de façons de détecter un Visiteur…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507652
    m_Localized: 'Cultist2: Pourquoi ne les a-t-on pas tous capturés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507653
    m_Localized: 'Cultist2: Tout va bien… Nous sommes protégés… Je vais vers une vie meilleure… Tout va bien… Il n''y a rien à craindre…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507654
    m_Localized: 'Cultist2: P-putain… J''ai trop p-peur !'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507655
    m_Localized: 'Cultist3: Faites comme bon vous semble. Évitez juste de vous mettre en travers de notre chemin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507656
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507657
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507658
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507659
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507660
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507661
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507662
    m_Localized: 'Cultist3: C''est intéressant de voir à quel point la mâchoire inférieure et la mâchoire supérieure peuvent être différentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507663
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507664
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507665
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507666
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507667
    m_Localized: 'Cultist3: Voilà qui nous fait sentir comme des étrangers.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507668
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507669
    m_Localized: 'Cultist3: Ça devrait attirer la Mort. Sauvez-nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507670
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507671
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507672
    m_Localized: 'Cultist3: Mes yeux ne voient presque plus rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507673
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507674
    m_Localized: 'Cultist3: Il est possible que je quitte ce monde avant mes frères.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507675
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507676
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507677
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507678
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507679
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701376
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701377
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701378
    m_Localized: 'Cultist3: Un petit moment, s''il vous plaît. Ma tunique me gêne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701379
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701380
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701381
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701382
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701383
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701384
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701385
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701386
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701387
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701388
    m_Localized: 'Cultist3: Ne vous mettez pas en travers de notre chemin, je vous prie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701389
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701390
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701391
    m_Localized: 'Cultist3: Vous êtes troublé. Vous feriez mieux de poser votre arme.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701392
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701393
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701394
    m_Localized: 'Cultist3: Ne vous mêlez pas de notre processus.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701395
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701396
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701397
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701398
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701399
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701400
    m_Localized: 'Cultist3: Qu''est-ce qui vous a fait croire qu''il était préférable de me tuer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701401
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701402
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701403
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701404
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701405
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701406
    m_Localized: 'Cultist3: J''ai tout montré. À présent, je vais me préparer.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701407
    m_Localized: 'Cultist3: Que chacun fasse son travail.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701408
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701409
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701410
    m_Localized: 'Cultist3: Les photographies ne servent à rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701411
    m_Localized: 'Cultist3: Tout ce qui est important restera gravé dans ma mémoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701412
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701413
    m_Localized: 'Cultist3: Mieux vaut ne pas faire ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701414
    m_Localized: 'Cultist3: Ils vous brûleront, mais vous n''irez pas à la Mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701415
    m_Localized: 'FatalDame: Toi aussi, tu le ressens parfois ? Cette angoisse que la personne en face de toi ne soit pas humaine ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701416
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701417
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701418
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701419
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701420
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701421
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701422
    m_Localized: 'FatalDame: Tu aimes ce que tu vois ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701423
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701424
    m_Localized: 'FatalDame: Pourquoi tu me regardes comme ça ? T''as déjà vu des dents comme ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701425
    m_Localized: 'FatalDame: Je te rappelle quelqu''un ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701426
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701427
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701428
    m_Localized: 'FatalDame: Il paraît que rien ne vaut le fait de tenir la main d''un être cher.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701429
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701430
    m_Localized: 'FatalDame: Tu sens son pouls.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701431
    m_Localized: 'FatalDame: Alors, qu''est-ce que des mains moites peuvent dire ? T''es nerveux ? Submergé par tes émotions ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701432
    m_Localized: 'FatalDame: Ou c''est juste une rage aveuglante ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701433
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701434
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701435
    m_Localized: 'FatalDame: Les yeux en disent long sur ce qu''on pense.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701436
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701437
    m_Localized: 'FatalDame: À ton avis, à quoi je pense en ce moment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701438
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701439
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701440
    m_Localized: 'FatalDame: Bien sûr. Regarde. Je ne peux rien te refuser.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701441
    m_Localized: 'FatalDame: Le corps est reconnaissant quand on lui donne de l''attention. Il se souvient de l''affection.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701442
    m_Localized: 'FatalDame: Je suis contente qu''on en ait conscience, toi et moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701443
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701444
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701445
    m_Localized: 'FatalDame: Je suis désolée, mais tout ça me fatigue.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701446
    m_Localized: 'FatalDame: Finissons-en vite, que nous puissions passer à autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701447
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701448
    m_Localized: 'FatalDame: Qu''est-ce que tu comptes faire avec cette photo ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701449
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701450
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701451
    m_Localized: 'FatalDame: C''est une sorte de fétichisme pour toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701452
    m_Localized: 'FatalDame: Non, ça me dérange pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701453
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701454
    m_Localized: 'FatalDame: Mais pourquoi est-ce que tu aimes autant les oreilles ? Qu''est-ce qui te plaît au juste ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701455
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701456
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701457
    m_Localized: 'FatalDame: Est-ce que tu retrouves en moi la personne qui t''a fait du mal ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701458
    m_Localized: 'FatalDame: Mais pourquoi est-ce que tu t''en prends à moi, alors que tu viens à peine de me rencontrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701459
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701460
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701461
    m_Localized: 'FatalDame: Alors, c''est de la colère.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701462
    m_Localized: 'FatalDame: De qui vois-tu l''ombre en moi ? De qui veux-tu te venger ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701463
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701464
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701465
    m_Localized: 'FatalDame: Ce qui me fait peur, c''est l''absence de doute dans tes yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701466
    m_Localized: 'FatalDame: Tu t''accroches à une méthode rigide. Mais nous, les humains… on remet en question, on hésite, on cherche.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701467
    m_Localized: 'FatalDame: Tu t''accroches à une méthode rigide. Est-ce que tu l''as inventée dans ton propre intérêt ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701468
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701469
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701470
    m_Localized: 'FatalDame: Est-ce que tu as peur de la beauté ? Elle n''est pas assez fiable pour toi ? Ou s''agit-il d''autre chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701471
    m_Localized: 'FatalDame: Tu t''imagines que les personnes sont aussi belles que dangereuses ? Mais comment pourrais-je te faire du mal ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701472
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701473
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701474
    m_Localized: 'FatalDame: C''est un plaisir sadique que je perçois là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701475
    m_Localized: 'FatalDame: Comme c''est romantique… garder des photos de sa victime.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701476
    m_Localized: 'FatalDame: Je me demande s''il y en a eu d''autre avant moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701477
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701478
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701479
    m_Localized: 'FatalDame: Désolée… mais je ne te suis plus. Qu''est-ce qui se passe ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701480
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701481
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701482
    m_Localized: 'FatalDame: Mieux vaut laisser partir les souvenirs qui te blessent.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701483
    m_Localized: 'FatalDame: Inutile de te torturer chaque fois qu''un déclic se produit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701484
    m_Localized: 'FatalDame: Fais comme moi, tu te sentiras plus léger. Peut-être pas tout de suite… mais avec le temps, ça viendra.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701485
    m_Localized: 'FatalDame: Je sais que tu veux te protéger. Mais établis d''abord tes propres limites.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701486
    m_Localized: 'FatalDame: Moi, je te demande de respecter les miennes également.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701487
    m_Localized: 'FatalDame: Ne projette pas ton passé sur moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701488
    m_Localized: 'FatalDame: C''est marrant comme tout le monde évite de se regarder dans les yeux maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701489
    m_Localized: 'FatalDame: Il y en a qui détournent le regard, certains qui cherchent des réponses, d''autres qui guettent les signes des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701490
    m_Localized: 'FatalDame: Il y en a qui détournent le regard. D''autres qui guettent les signes des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701491
    m_Localized: 'FatalDame: Mais toi… Tu regardes très attentivement.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701492
    m_Localized: 'FatalDame: C''est intéressant.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701493
    m_Localized: 'FatalDame: Je comprends que tu aies peur pour toi-même et pour les autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701494
    m_Localized: 'FatalDame: L''idée que tu puisses faire mourir quelqu''un, c''est terrifiant.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701495
    m_Localized: 'FatalDame: Mais se sentir blessé quand quelqu''un pointe une arme sur toi, c''est tout simplement humain.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701496
    m_Localized: 'FatalDame: Je crois que tu as un caractère bien particulier. Peut-être y a-t-il un mot plus juste…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701497
    m_Localized: 'FatalDame: Tu n''aimes pas les gens de la même manière que tu aimes le souvenir que tu gardes d''eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701498
    m_Localized: 'FatalDame: Je parie que des photos, tu en as plein. Pourtant, tu gardes tes distances avec les gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701499
    m_Localized: 'FatalDame: Hmm. Non, fais comme si je n''avais rien dit. Désolée. Ne fais pas attention à moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701500
    m_Localized: 'FatalDame: Oui… C''est pas évident de distinguer la vérité du mensonge de nos jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701501
    m_Localized: 'FatalDame: Mais… Tu dois choisir par toi-même ce qui est réel.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701502
    m_Localized: 'FatalDame: Tu as tellement peur du changement que tu repousses tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701503
    m_Localized: 'FatalDame: Les étrangers. Ta famille. Tes proches…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701504
    m_Localized: 'FatalDame: … Que vas-tu devenir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313600
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313601
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313602
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313603
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313604
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313605
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313606
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313607
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090816
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090817
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090818
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090819
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090820
    m_Localized: 'Esenin: Putain, regarde-toi agiter ton flingue comme ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090821
    m_Localized: 'Esenin: Si t''as complètement perdu les pédales, alors tire. Mais c''est du grand n''importe quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090822
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090823
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090824
    m_Localized: 'Esenin: Oh, bordel…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090825
    m_Localized: 'Esenin: Laisse-moi deviner. Si c''est pas la crasse sous mes ongles, alors c''est ma taille qui t''a fait peur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090826
    m_Localized: 'Esenin: Selon toi, les grands méritent d''être rabaissés, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090827
    m_Localized: 'Esenin: Va te faire foutre avec ton idéologie à la con.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090828
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090829
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090830
    m_Localized: 'Esenin: Et comment t''en arrivé à cette conclusion, bordel ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090831
    m_Localized: 'Esenin: Mes dents vont bien. Mes mains aussi. Et maintenant, tu vérifies mes yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090832
    m_Localized: 'Esenin: Si tu peux pas me blairer, dis-le, putain. Je me casserais. C''est pas ma fierté qui me retiendra, crois-moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090833
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090834
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090835
    m_Localized: 'Esenin: Et maintenant, tu veux que je me courbe devant toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090836
    m_Localized: 'Esenin: Comment suis-je censé réagir à ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090837
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090838
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090839
    m_Localized: 'Esenin: Sérieusement.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090840
    m_Localized: 'Esenin: Tu vois pas ce qui se trame déjà dans cette maison ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090841
    m_Localized: 'Esenin: Tu te laisses entraîner dans des conneries sans intérêt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090842
    m_Localized: 'Esenin: Et après, tu vas tuer des gens comme si de rien n''était.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090843
    m_Localized: 'Esenin: Arrête-toi et réfléchis à tout ça une seconde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090844
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090845
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090846
    m_Localized: 'Esenin: Merde, toutes ces foutues caisses…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090847
    m_Localized: 'Esenin: Et cette putain de nation…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090848
    m_Localized: 'Esenin: C''est comme ça qu''ils veillent sur nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090849
    m_Localized: 'Esenin: Putain, ce que c''est pathétique…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090850
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090851
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090852
    m_Localized: 'Esenin: Tu sais quoi ? Va te faire foutre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090853
    m_Localized: 'Esenin: J''en ai ma claque que tu me souffles dans le cou avec ton flingue.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090854
    m_Localized: 'Esenin: Comme si ça me plaisait d''être aussi grand.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090855
    m_Localized: 'Esenin: Je me cogne toujours la tête partout. Le pire, c''est les bus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090856
    m_Localized: 'Esenin: Mais bon… Y a aussi des avantages.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090857
    m_Localized: 'Esenin: Un jour, j''ai vu un type se faire renverser par un camion.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090858
    m_Localized: 'Esenin: Et le camion roulait même pas vite, tu sais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090859
    m_Localized: 'Esenin: Il était coincé dans les embouteillages. Le type traversait juste devant lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090860
    m_Localized: 'Esenin: Dans l''angle mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090861
    m_Localized: 'Esenin: Et le camion a avancé et l''a renversé… TRÈS lentement.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090862
    m_Localized: 'Esenin: C''était vraiment terrifiant.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090863
    m_Localized: 'Esenin: Au moins, je mourrai aussi bêtement.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090864
    m_Localized: 'Esenin: Merde…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090865
    m_Localized: 'Esenin: T''es déjà allé dans un bar ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090866
    m_Localized: 'Esenin: Ça manquait pas les types qu''avaient les « signes ». Les yeux rouges, les mains sales, et même des dents parfaites !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090867
    m_Localized: 'Esenin: Et tu sais quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090868
    m_Localized: 'Esenin: Certains d''entre eux sont morts, comme quoi…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090869
    m_Localized: 'Esenin: Ce que je veux dire, c''est que si t''avais tenté de faire un truc pareil dans un bar, tu te serais fait tabasser.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090870
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090871
    m_Localized: 'Esenin: Je comprends pas comment tu peux pointer une arme sur quelqu''un, comme ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090872
    m_Localized: 'Esenin: C''est complètement dingue.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090873
    m_Localized: 'Esenin: T''es complètement cinglé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090874
    m_Localized: 'Esenin: Va te faire foutre, d''accord ?…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090875
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090876
    m_Localized: 'Esenin: Merci ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090877
    m_Localized: 'Esenin: Ou quoi maintenant ?…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090878
    m_Localized: 'Esenin: Il reste plus que des pleurnichards et des psychopathes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090879
    m_Localized: 'Esenin: Comment ne pas boire dans un bordel pareil…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090880
    m_Localized: 'Esenin: Bon, eh bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090881
    m_Localized: 'Esenin: Putain…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285120
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285121
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285122
    m_Localized: 'Daughter: C''est bon, j''arrête ! J''abandonne !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285123
    m_Localized: 'Daughter: Tu as gagné !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285124
    m_Localized: 'Daughter: Franchement, j''y comprends rien du tout à ton jeu !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285125
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285126
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285127
    m_Localized: 'Daughter: Papa m''a déjà parlé d''un jeu comme ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285128
    m_Localized: 'Daughter: Donc, euh, on fait deux équipes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285129
    m_Localized: 'Daughter: Y a une équipe cache un trésor, et qui dessine une prison, où elle emmène l''autre équipe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285130
    m_Localized: 'Daughter: Et les autres doivent soit se sauver en premiers, soit trouver le trésor !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285131
    m_Localized: 'Daughter: Et tout le monde a des armes !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285132
    m_Localized: 'Daughter: Seulement, papa disait qu''ils utilisaient des bâtons.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285133
    m_Localized: 'Daughter: Oh ! Je m''en souviens ! Ça s''appelait « Gendarmes et voleurs » !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285134
    m_Localized: 'Daughter: Toi aussi, tu jouais à ça quand t''étais petit ? Et maintenant, tu veux y jouer avec moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285135
    m_Localized: 'Daughter: Oh…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285136
    m_Localized: 'Daughter: Mais j''ai même pas pu cacher le trésor !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285137
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285138
    m_Localized: 'Daughter: Et j''ai rien de spécial à cacher…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285139
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285140
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285141
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285142
    m_Localized: 'Daughter: J''aime pas ce jeu…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285143
    m_Localized: 'Daughter: Tu veux pas arrêter de me faire peur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285144
    m_Localized: 'Daughter: Allez, arrête ! Je t''ai déjà montré mes ongles !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285145
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285146
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285147
    m_Localized: 'Daughter: Les ongles de maman, ils étaient trop beaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285148
    m_Localized: 'Daughter: Mais je m''en souviens plus très bien maintenant…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285149
    m_Localized: 'Daughter: Je me souviens juste qu''ils étaient jolis.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285150
    m_Localized: 'Daughter: Et aussi, elle avait une très, très jolie robe !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285151
    m_Localized: 'Daughter: Comme la mienne !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285152
    m_Localized: 'Daughter: Papa, il dit que je suis jolie, aussi jolie que maman !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285153
    m_Localized: 'Daughter: Papa…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285154
    m_Localized: 'Daughter: Bon. Ça suffit. Je veux pas pleurer. Je suis une grande fille…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285155
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285156
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285157
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285158
    m_Localized: 'Daughter: Pitié-é-é !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285159
    m_Localized: 'Daughter: J''en peu-eu-eux plu-u-us !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285160
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285161
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285162
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285163
    m_Localized: 'Daughter: Une fois, je suis allée au terrain de jeux, celui qu''est super loin !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285164
    m_Localized: 'Daughter: Et y avait le plus grand toboggan du monde !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285165
    m_Localized: 'Daughter: J''avais jamais vu un toboggan aussi grand !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285166
    m_Localized: 'Daughter: Et j''avais même pas peur. Pas peur du tout ! Et c''était trop cool !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285167
    m_Localized: 'Daughter: J''ai grimpé tellement de fois que j''avais méga soif. J''aurais pu boire toute la mer. Non, tout l''océan !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285168
    m_Localized: 'Daughter: Mais après, papa, il s''est perdu. Il est parti loin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285169
    m_Localized: 'Daughter: Et j''avais tellement peur de mourir sans lui !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285170
    m_Localized: 'Daughter: Je savais même pas comment rentrer à la maison, on était tellement loin !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285171
    m_Localized: 'Daughter: Mais après, papa, il est revenu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285172
    m_Localized: 'Daughter: J''espère qu''il va revenir maintenant aussi. J''espère qu''il s''est juste perdu. Ouais…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285173
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285174
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285175
    m_Localized: 'Daughter: Oh, un jour, j''ai vu un dessin animé !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285176
    m_Localized: 'Daughter: Y avait un chien avec un pistolet, et quand il tirait, ça faisait des images !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285177
    m_Localized: 'Daughter: Il est comme ça ton pistolet, dis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285178
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479424
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479425
    m_Localized: 'Daughter: … On dirait pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479426
    m_Localized: 'Daughter: Oh, je me souviens d''un autre truc !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479427
    m_Localized: 'Daughter: Une fois, papa et moi, on est allés au marché.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479428
    m_Localized: 'Daughter: Et y a un monsieur qui a pointé un pistolet sur nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479429
    m_Localized: 'Daughter: Il avait les cheveux longs et il portait un long manteau.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479430
    m_Localized: 'Daughter: Papa a eu peur, mais après ils se sont fait un câlin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479431
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479432
    m_Localized: 'Daughter: Ou peut-être que c''était un rêve ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479433
    m_Localized: 'Daughter: Je m''en souviens pas bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479434
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479435
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479436
    m_Localized: 'Daughter: Oh…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479437
    m_Localized: 'Daughter: Je vais te dire autre chose !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479438
    m_Localized: 'Daughter: T''essaies d''être méchant avec moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479439
    m_Localized: 'Daughter: Des fois, tu fais tout pareil que ma meilleure copine, dis donc…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479440
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479441
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479442
    m_Localized: 'Daughter: Elle et moi, on adore jouer…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479443
    m_Localized: 'Daughter: Et des fois… boum ! Elle fait quelque chose de méchant !'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479444
    m_Localized: 'Daughter: Mais en vrai, je sais qu''elle est vraiment gentille.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479445
    m_Localized: 'Daughter: C''est pas facile dans sa maison. Sa mère est super stricte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479446
    m_Localized: 'Daughter: Y a plein de choses qu''elle a pas le droit de faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479447
    m_Localized: 'Daughter: Peut-être que sa mère est un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479448
    m_Localized: 'Daughter: Peut-être que sa mère est un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479449
    m_Localized: 'Daughter: J''irai la voir une fois que papa sera venu me chercher…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479450
    m_Localized: 'Daughter: Papa…'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479451
    m_Localized: Maman…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062336
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062337
    m_Localized: Je dois me tester moi-même.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062338
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062339
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062340
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062341
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450944
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450945
    m_Localized: Se laver
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450946
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450947
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450948
    m_Localized: Merde. Blanches…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450949
    m_Localized: Les fumeurs tueraient pour en avoir des pareilles.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450950
    m_Localized: Des dents jaunes…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450951
    m_Localized: C'est mieux comme ça. Personne me prendra pour un Visiteur.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450952
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450953
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450954
    m_Localized: Des ongles sales…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450955
    m_Localized: À cause de ce fichu trou que j'ai creusé.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450956
    m_Localized: Des mains propres…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450957
    m_Localized: Quelques traces de poudre. Rien de bien méchant.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450958
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450959
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450960
    m_Localized: Putain de merde. Ils sont rouges…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450961
    m_Localized: Je n'aurais pas dû boire cette cochonnerie à la caféine.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450962
    m_Localized: Mes yeux ont l'air normaux.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450963
    m_Localized: Ils ne sont pas rouges. On ne peut rien me reprocher.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450964
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450965
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450966
    m_Localized: Des aisselles poilues…
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450967
    m_Localized: Comme ça devrait être le cas.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450968
    m_Localized: Putain, c'est quoi ce truc ?!
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450969
    m_Localized: On dirait une éruption cutanée, ou pire… un champignon.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450970
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450971
    m_Localized: Il faut que je me lave. Ça aidera peut-être.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450972
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450973
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450974
    m_Localized: Mes oreilles ont l'air normales.
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450975
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450976
    m_Localized: De quel genre de rapport s'agissait-il, de toute façon ?
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450977
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 48219577463595008
    m_Localized: 'Anger: Parfois, je serre les mâchoires si fort que je les entends craquer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577476177920
    m_Localized: 'Anger: Ça me stresse comme pas permis… Mais je m''en aperçois toujours trop tard… à chaque fois, putain.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343744
    m_Localized: 'Alkonost: Ma sœur… Pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343745
    m_Localized: 'Alkonost: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343746
    m_Localized: 'Alkonost: À quoi bon continuer… ou même essayer…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343747
    m_Localized: 'Alkonost: Tirez. Allez.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577505538048
    m_Localized: 'Sirin: La mort m''a arraché ma sœur…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577505538049
    m_Localized: 'Sirin: Comment… comment continuer sans elle…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577505538050
    m_Localized: 'Sirin: Je suis prête…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315264
    m_Localized: 'Jacob: Je savais que vous diriez ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315265
    m_Localized: Dents.
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315266
    m_Localized: Mains.
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315267
    m_Localized: Yeux.
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315268
    m_Localized: Aisselles.
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315269
    m_Localized: Photo.
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315270
    m_Localized: Oreilles.
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315271
    m_Localized: 'Jacob: Entendu…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315272
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315273
    m_Localized: 'Jacob: … Honnêtement, ces dernières semaines, j''ai pas vraiment eu l''occasion de me brosser les dents.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315274
    m_Localized: 'Jacob: J''en ai de la chance.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315275
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315276
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315277
    m_Localized: 'Jacob: Les mains ? Vraiment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315278
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315279
    m_Localized: 'Jacob: C''est que… j''ai passé pas mal de temps à fouiller dans des choses pas très recommandables dernièrement.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315280
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315281
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315282
    m_Localized: 'Jacob: Ça fait des jours que j''ai pas fermé l''œil…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315283
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315284
    m_Localized: 'Jacob: Difficile de dormir quand sa fille a disparu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315285
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315286
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315287
    m_Localized: 'Jacob: Vous voulez rien voir d''autre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315288
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315289
    m_Localized: 'Jacob: Allez-y, regardez.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315290
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315291
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315292
    m_Localized: 'Jacob: Surtout n''allez pas montrer ça à quelqu''un de la FEMA'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315293
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315294
    m_Localized: 'Jacob: Vous avez déjà entendu parler des vampires ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315295
    m_Localized: 'Jacob: On ne peut pas les voir sur les photos. Ils se déplacent la nuit, et…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315296
    m_Localized: 'Jacob: Ils sont immortels.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315297
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315298
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315299
    m_Localized: 'Jacob: Vous ne trouvez pas que ces tests sont assez inutiles ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315300
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315301
    m_Localized: 'Jacob: Je vais vous dire un secret : avoir du cérumen dans les oreilles ? C''est tout à fait normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315302
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315303
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315304
    m_Localized: 'Jacob: Vous avez pas plus petit, comme cure-dent ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315305
    m_Localized: 'Jacob: Vous voulez tirer ? Allez-y, je vous en prie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315306
    m_Localized: 'Jacob: Moi qui croyais que vous étiez à l''écoute.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315307
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315308
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315309
    m_Localized: 'Jacob: Attention avec ce truc.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315310
    m_Localized: 'Jacob: Je suis immortel, mais si vous appuyez sur la gâchette…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315311
    m_Localized: 'Jacob: Je ne vous dirai plus un mot.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315312
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315313
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315314
    m_Localized: 'Jacob: Si vous pensez que je suis un Visiteur, vous faites complètement fausse route.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315315
    m_Localized: 'Jacob: Je suis immortel. Vous ne pouvez pas me tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315316
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315317
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315318
    m_Localized: 'Jacob: Vous avez perdu la raison, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315319
    m_Localized: 'Jacob: Si vous appuyez sur la détente, vous n''en saurez pas plus sur les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315320
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315321
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315322
    m_Localized: 'Jacob: J''espère que vos balles sont en argent…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315323
    m_Localized: 'Jacob: Sinon, vous ne faites que gaspiller des munitions…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315324
    m_Localized: 'Jacob: Et le peu de patience que j''ai à vous offrir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315325
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315326
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315327
    m_Localized: 'Jacob: Allez-y, appuyez sur la gâchette si vous croyez à cette boîte de mensonges.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315328
    m_Localized: 'Jacob: Mais moi, je ne vais pas laisser passer ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315329
    m_Localized: 'Jacob: Je reviendrai pour vous briser le cou, vous pouvez me faire confiance.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315330
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315331
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315332
    m_Localized: 'Jacob: Si mes dents vous dérangent à ce point…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315333
    m_Localized: 'Jacob: La prochaine fois, je les laverai…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315334
    m_Localized: 'Jacob: Avec mon doigt !'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315335
    m_Localized: 'Jacob: Je sais de quoi ça a l''air.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315336
    m_Localized: 'Jacob: Fouiller dans des merdes, là, dehors…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315337
    m_Localized: 'Jacob: N''importe qui pourrait se salir les mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315338
    m_Localized: 'Jacob: Baissez le son de cette foutue télé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315339
    m_Localized: 'Jacob: Difficile de rester propre de nos jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315340
    m_Localized: 'Jacob: Je regarderais bien vos yeux si vous n''aviez pas passé autant de nuits blanches.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315341
    m_Localized: 'Jacob: Traverser la moitié de la ville…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315342
    m_Localized: 'Jacob: Se cacher du soleil le jour, de la FEMA et des Visiteurs la nuit…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315343
    m_Localized: 'Jacob: J''ai même pas eu une seconde pour fermer l''œil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315344
    m_Localized: 'Jacob: Les aisselles, hein ? Ça en dit long.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315345
    m_Localized: 'Jacob: La FEMA déraille complètement.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315346
    m_Localized: 'Jacob: Peut-être qu''ils lèchent les boules des Visiteurs pour trouver de nouveaux signes en ce moment même ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315347
    m_Localized: 'Jacob: Qu''ils viennent. Je leur ferai goûter les miennes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315348
    m_Localized: 'Jacob: Évitez de pointer cette arme sur moi à l''avenir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315349
    m_Localized: 'Jacob: Sinon, les conséquences risquent d''être tragiques pour vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315350
    m_Localized: 'Jacob: Cela dit, si vous faites preuve de respect…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315351
    m_Localized: 'Jacob: Je vous promets que je ne vous ferai pas de mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315352
    m_Localized: 'Jacob: J''espère que vous faites preuve de la même fermeté avec les agents de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315353
    m_Localized: 'Jacob: Contrairement aux Visiteurs, ils ne font pas semblant d''être humains…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315354
    m_Localized: 'Jacob: Ce sont des individus peu scrupuleux depuis le début.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315355
    m_Localized: 'Jacob: Économisez vos munitions.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315356
    m_Localized: 'Jacob: Je vous assure que vous en aurez plus besoin contre eux que contre les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315357
    m_Localized: 'Jacob: Putain…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315358
    m_Localized: 'Jacob: Je pensais que vous étiez plus malin que ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315359
    m_Localized: 'Jacob: J''ai toujours su que c''est la débilité d''un autre qui me tuerait.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315360
    m_Localized: Pas besoin de ça…
    m_Metadata:
      m_Items: []
  - m_Id: 58333830346432512
    m_Localized: Laisser tomber
    m_Metadata:
      m_Items: []
  - m_Id: 58333830346432513
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 58333830400958464
    m_Localized: Se laver
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535808
    m_Localized: 'Unstable: OK. Laisse-moi juste finir cet Énerjéka…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535809
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535810
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535811
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535812
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535813
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535814
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535815
    m_Localized: 'Unstable: Tu sais, je sens le goût de l''Énerjéka même quand je n''en bois pas ! Je te l''avais déjà dit ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535816
    m_Localized: 'Unstable: On dirait que c''est plein de produits chimiques bizarres.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535817
    m_Localized: 'Unstable: Mais on s''en fiche, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535818
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535819
    m_Localized: 'Unstable: Oh, zut. Ma langue est toute tachée.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535820
    m_Localized: 'Unstable: Oh, zut. Mes dents sont toutes pourries.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535821
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535822
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535823
    m_Localized: 'Unstable: Hmm, les mains ? D''accord.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535824
    m_Localized: 'Unstable: Tu sais, j''ai souvent des démangeaisons… Un peu comme si des fourmis couraient partout… Ha ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535825
    m_Localized: 'Unstable: Je pense pas m''être beaucoup gratté, donc mes mains devraient être en bon état.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535826
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535827
    m_Localized: 'Unstable: Hmm, j''ai dû les tordre sans m''en rendre compte.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535828
    m_Localized: 'Unstable: Méh… Overdose de caféine ! Regarde, je tremble comme une feuille.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535829
    m_Localized: 'Unstable: Donne-moi juste dix minutes… peut-être que ça va se calmer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535830
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535831
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535832
    m_Localized: 'Unstable: J''ai lu ça quelque part. Les yeux, c''est censé être un vert foncé… genre un peu cracra.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535833
    m_Localized: 'Unstable: Mais bon, faut pas tout confondre, hein. Les yeux verts, c''est pas ça qui manque, hein…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535834
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535835
    m_Localized: 'Unstable: Attends, c''est quoi le problème ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535836
    m_Localized: 'Unstable: ROUGE ? C''EST CENSÉ ÊTRE ROUGE ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535837
    m_Localized: 'Unstable: Alors pourquoi c''était vert à la télé ? Et les miens, ils sont comment, d''ailleurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535838
    m_Localized: 'Unstable: Mais alors, pourquoi ceux de la télé étaient verts ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535839
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535840
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535841
    m_Localized: 'Unstable: Ah, le seul signe qui soit logique !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535842
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535843
    m_Localized: 'Unstable: Pas de couleur bizarre, pas de saleté, rien de tout ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535844
    m_Localized: 'Unstable: Juste des aisselles normales. C''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535845
    m_Localized: 'Unstable: Cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535846
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535847
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535848
    m_Localized: 'Unstable: Je me faisais toujours prendre en photo pendant les fêtes.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535849
    m_Localized: 'Unstable: Mais, les gens organisent plus vraiment de fêtes. Ou peut-être qu''ils m''invitent pas, tout simplement ! Ha ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535850
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535851
    m_Localized: 'Unstable: Ouais, mon cœur bat super vite.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535852
    m_Localized: 'Unstable: Il n''y a pas assez d''Énerjéka dans tout l''univers pour suivre le rythme.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535853
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535854
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535855
    m_Localized: 'Unstable: D''accord, pourquoi pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535856
    m_Localized: 'Unstable: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535857
    m_Localized: 'Unstable: J''aurais peut-être dû les nettoyer avant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535858
    m_Localized: 'Unstable: Ou pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535859
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535860
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535861
    m_Localized: 'Unstable: Oh, ouah.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535862
    m_Localized: 'Unstable: Je pensais pas que t''étais du genre à tirer sur tout ce qui bouge. Y a déjà assez de mecs comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535863
    m_Localized: 'Unstable: Honnêtement, je pensais pouvoir avoir trouvé un petit havre de paix ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535864
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535865
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535866
    m_Localized: 'Unstable: T''as vraiment bien choisi ton moment, hein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535867
    m_Localized: 'Unstable: Tu vas pas tirer, dis-moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535868
    m_Localized: 'Unstable: À moins que les crampes soient un nouveau symptôme ces jours-ci ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535869
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535870
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535871
    m_Localized: 'Unstable: Ça va pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535872
    m_Localized: 'Unstable: C''est toi qui as parlé de rougeur. À moins que… Est-ce que j''ai les yeux rouges ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535873
    m_Localized: 'Unstable: Écoute… Dis-moi franchement… Je comprends pas, là.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535874
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535875
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535876
    m_Localized: 'Unstable: C''est vraiment pas cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535877
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535878
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535879
    m_Localized: 'Unstable: Attends, y a pas genre… un trou dans mon cœur… Si ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535880
    m_Localized: 'Unstable: C''est juste qu''il cogne à fond, tu sais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535881
    m_Localized: 'Unstable: Attends… une seconde… J''ai vraiment du mal à respirer, là.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535882
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535883
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535884
    m_Localized: 'Unstable: Explique-moi au moins ce qui se passe !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535885
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535886
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535887
    m_Localized: 'Unstable: Je comprends, la sécurité, les précautions, tout ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535888
    m_Localized: 'Unstable: Mais là, c''est le meilleur moyen de perdre les pédales. Tu vas finir par tirer sur tous ceux qui ont l''air un peu louches.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535889
    m_Localized: 'Unstable: Peut-être que tout ce serait plus simple… si toi aussi, tu partais. Si tu trouvais un peu de paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535890
    m_Localized: 'Unstable: Tu sais… Loin d''ici… Vraiment loin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535891
    m_Localized: 'Unstable: Tu sais ce qui fout les jetons ? Quand tu peux même plus lever les mains… Quand tu peux même plus te défendre…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535892
    m_Localized: 'Unstable: Ouais… C''est débile… Qui pense pouvoir se protéger d''une balle ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535893
    m_Localized: 'Unstable: Attends… Donc, tout est pas vraiment… vert ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535894
    m_Localized: 'Unstable: Alors… De quelle couleur c''est ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535895
    m_Localized: 'Unstable: J''ai même pas remarqué quand tout est devenu vert…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535896
    m_Localized: 'Unstable: Ouah… Ça me fait vraiment flipper !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535897
    m_Localized: 'Unstable: Tu fais vraiment flipper les gens quand tu pointes ton flingue sur eux… Tu le savais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535898
    m_Localized: 'Unstable: Les Visiteurs vont pas arrêter de massacrer les gens juste parce que tu as menacé une poignée de pauvres types.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535899
    m_Localized: 'Unstable: Tu finiras juste par devenir plus effrayant qu''eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535900
    m_Localized: 'Unstable: Dis-moi… Est-ce que ça en vaut vraiment la peine ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535901
    m_Localized: 'Unstable: Ça sert à rien d''intimider les gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535902
    m_Localized: 'Unstable: Tu vas… Hahh… Tu vas juste te mettre tout le monde à dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535903
    m_Localized: 'Unstable: Attends, bon sang… Attends, juste une seconde… Argh… Mon cœur, bon sang.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535904
    m_Localized: 'Unstable: Bref… Arrête de pointer ton flingue sur… tout le monde. Ça… Ça changera rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535905
    m_Localized: 'Unstable: Je vais juste partir et… Haaah… Gaaah… Arrêter de te faire flipper… D''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535906
    m_Localized: 'Unstable: Alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535907
    m_Localized: 'Unstable: C''est tout ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535908
    m_Localized: 'Rocker: Allez, c''est parti. On peut peut-être encore offrir un bon gros riff à ce monde, si ça se trouve !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535909
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535910
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535911
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535912
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535913
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535914
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535915
    m_Localized: 'Rocker: Ouais… Ces dents… Elles en ont vu défiler, des clopes !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535916
    m_Localized: 'Rocker: Marrant, hein…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535917
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535918
    m_Localized: 'Rocker: C''est tout ce qui me reste de mon groupe. Des souvenirs… et des taches…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535919
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535920
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535921
    m_Localized: 'Rocker: Y a bien eu ce tatouage…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535922
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535923
    m_Localized: 'Rocker: Soirée de fou. Le chanteur était complètement bourré, et moi j''étais tellement défoncé que je me suis fait tatouer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535924
    m_Localized: 'Rocker: Attends…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535925
    m_Localized: 'Rocker: En fait… c''était peut-être pas un tatouage.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535926
    m_Localized: 'Rocker: Tain… Je m''en souviens même plus…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535927
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535928
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535929
    m_Localized: 'Rocker: Un jour, on s''est dit que ce serait trop cool de s''injecter de l''encre directement dans les yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535930
    m_Localized: 'Rocker: Aujourd''hui encore, j''ai des flashbacks de cette expérience de gros malade.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535931
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535932
    m_Localized: 'Rocker: Nan, nan… Pas mes yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535933
    m_Localized: 'Rocker: Je connais un gars qui est devenu complètement aveugle. Mec, t''aurais dû voir ses yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535934
    m_Localized: 'Rocker: Moi, je tuerais pour avoir des yeux comme ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535935
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535936
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535937
    m_Localized: 'Rocker: Vas-y, fais-toi plaisir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535938
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535939
    m_Localized: 'Rocker: Alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535940
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535941
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535942
    m_Localized: 'Rocker: Viens, on se prend en photo ensemble. Peut-être que je la dédicacerai !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535943
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535944
    m_Localized: 'Rocker: Ouah…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535945
    m_Localized: 'Rocker: Peut-être… Je dis bien, peut-être… que tu devrais enlever le cache de ton appareil photo, d''abord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535946
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535947
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535948
    m_Localized: 'Rocker: Avant, je me tirais les oreilles tous les jours. Et un jour… j''ai tiré trop fort.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535949
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924416
    m_Localized: 'Rocker: Maintenant, elles sont juste toutes déchirées.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924417
    m_Localized: 'Rocker: Mais le look me plaît bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924418
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924419
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924420
    m_Localized: 'Rocker: Franchement ? J''en ai strictement rien à faire à ce stade.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924421
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924422
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924423
    m_Localized: 'Rocker: Y a plus grand-chose qui me fait peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924424
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924425
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924426
    m_Localized: 'Rocker: Tranquille, mec. Pas besoin d''agiter ce truc.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924427
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924428
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924429
    m_Localized: 'Rocker: Je veux pas empester. Est-ce que c''est une raison pour me descendre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924430
    m_Localized: 'Rocker: T''es impressionné, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924431
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924432
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924433
    m_Localized: 'Rocker: Ah, c''est celle où t''as enlevé le cache de l''objectif, hein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924434
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924435
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924436
    m_Localized: 'Rocker: On dirait que tu kiffes pas vraiment mon style… Dommage.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924437
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924438
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924439
    m_Localized: 'Rocker: Peut-être que ce riff ultime est encore quelque part, à m''attendre…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924440
    m_Localized: 'Rocker: Je suis pas vraiment inspiré, tu sais. Juste un bourdonnement sourd dans ma tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924441
    m_Localized: 'Rocker: Mais franchement, si tu passais à l''acte… Qu''est-ce que ça changerait au fond ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924442
    m_Localized: 'Rocker: De toute façon, je monterai jamais sur scène.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924443
    m_Localized: 'Rocker: Moi, je serais prêt à tuer pour mettre le feu à un festival en ce moment. J''en crève d''envie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924444
    m_Localized: 'Rocker: Dommage que t''aies rien de plus fort que de la bière.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924445
    m_Localized: 'Rocker: J''ai trop envie de me bourrer la gueule.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924446
    m_Localized: 'Rocker: Je sais même pas quoi te dire, mec.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924447
    m_Localized: 'Rocker: Merci d''avoir demandé… je suppose.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924448
    m_Localized: 'Rocker: Pourquoi elle est si sombre, cette photo ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924449
    m_Localized: 'Rocker: Même notre ancien local de répét était plus lumineux que ça… et pourtant c''est pas la lumière qui manque, ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924450
    m_Localized: 'Rocker: Tu sais, j''avais jamais pensé à ajouter des cloches d''église à nos morceaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924451
    m_Localized: 'Rocker: Tu sais, j''ai toujours eu envie d''ajouter des cloches d''église à nos morceaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924452
    m_Localized: 'Rocker: Nos morceaux, je dis… Comme s''il restait des potos pour jouer avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924453
    m_Localized: 'Rocker: Tu sais…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924454
    m_Localized: 'Rocker: C''est peut-être ma meilleure performance.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924455
    m_Localized: 'Rocker: Peut-être que les potos m''attendent… là-haut.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924456
    m_Localized: 'Rocker: ROCK AND ROLL JUSQU''À LA MORT !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924457
    m_Localized: 'Experienced: D''accord, mec. Dis-moi quand tu es prêt… je te montrerai ce que tu veux voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924458
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924459
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924460
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924461
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924462
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924463
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924464
    m_Localized: 'Experienced: Mes dents, hein ? Elles sont jaunes. Des caries, ou un truc du genre.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924465
    m_Localized: 'Experienced: Les matons nous distribuent pas de brosses à dents à la menthe, hein. T''inquiète pas pour les gencives qui saignent.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924466
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924467
    m_Localized: 'Experienced: Ça veut rien dire, ça… Pas vrai, mon gars ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924468
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924469
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924470
    m_Localized: 'Experienced: Aucun souci, mon vieux. Jette un œil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924471
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924472
    m_Localized: 'Experienced: Tu vois ? Tout est normal. Enfin… sauf que…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924473
    m_Localized: 'Experienced: J''ai un petit problème aux mains. Te fais pas de bile, c''est juste une poussée d''eczéma.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924474
    m_Localized: 'Experienced: Ah, ces mains… Je m''en suis pas mal servi à l''époque… mais j''ai déjà payé pour ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924475
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924476
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924477
    m_Localized: 'Experienced: Tu cherches à voir ma conscience, là-dedans ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924478
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924479
    m_Localized: 'Experienced: Très bien… Vas-y, jette un œil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924480
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924481
    m_Localized: 'Experienced: Moi qui croyais que les lunettes de soleil protégeraient du soleil… tsss…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924482
    m_Localized: 'Experienced: En fait, ça n''a fait qu''empirer les choses. Vraiment inutiles…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924483
    m_Localized: 'Experienced: En fait, elles servent à rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924484
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924485
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924486
    m_Localized: 'Experienced: Écoute, mec… Je vais te montrer, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924487
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924488
    m_Localized: 'Experienced: À l''époque, je me suis brûlé en faisant l''idiot, alors que j''étais bourré comme un coin. Donc… Pas de panique.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924489
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924490
    m_Localized: 'Experienced: Voilà. Alors ? Rassure-moi… T''es pas un de ces tarés, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924491
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924492
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924493
    m_Localized: 'Experienced: Mec, tu essaies de me boucler ou quoi ? C''est quoi ce portrait judiciaire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924494
    m_Localized: 'Experienced: … À moins que… C''est une sorte de test, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924495
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924496
    m_Localized: 'Experienced: J''ai l''impression que je viens de me faire ficher. La photo dans le casier, tout ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924497
    m_Localized: 'Experienced: Pas de souci. Prends-la si tu veux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924498
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924499
    m_Localized: 'Experienced: C''est bon ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924500
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924501
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924502
    m_Localized: 'Experienced: C''est quoi ce délire ? Les oreilles maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924503
    m_Localized: 'Experienced: T''es complètement à côté de la plaque, mon vieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924504
    m_Localized: 'Experienced: T''as vraiment besoin de regarder ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924505
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924506
    m_Localized: 'Experienced: Très bien, punaise…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924507
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924508
    m_Localized: 'Experienced: Alors ? T''as trouvé des vis qui traînent là-dedans ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924509
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924510
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924511
    m_Localized: 'Experienced: T''as pas perdu la tête, ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924512
    m_Localized: 'Experienced: Toi aussi, t''as les dents jaunes… Alors, pourquoi tu sors ton arme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924513
    m_Localized: 'Experienced: Ou tu vas m''accuser d''avoir les gencives qui saignent et m''abattre pour ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924514
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924515
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924516
    m_Localized: 'Experienced: Mais pourquoi tu prends ce truc, mon vieux ? Range-le.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924517
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924518
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924519
    m_Localized: 'Experienced: Tu penses que je te raconte des cracs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924520
    m_Localized: 'Experienced: Je signe et je répète… Les lunettes de soleil, ça bloque pas le soleil. Vas-y, essaie pour voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924521
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924522
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924523
    m_Localized: 'Experienced: Je sais, je sais… J''ai pas les plus belles aisselles du monde…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924524
    m_Localized: 'Experienced: Mais pourquoi tu fais ça ? On parlait bien, avant.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924525
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924526
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924527
    m_Localized: 'Experienced: Mec, tu me prends pour un autre type ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924528
    m_Localized: 'Experienced: J''ai purgé ma peine… Je suis sorti y a pas longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924529
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924530
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924531
    m_Localized: 'Experienced: T''es sérieux, mec ? Là, tu vas trop loin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924532
    m_Localized: 'Experienced: Bon… Les dents, la crasse, je veux bien. Mais les oreilles ? Personne n''a jamais parlé d''oreilles !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924533
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924534
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924535
    m_Localized: 'Experienced: Bien… Pas besoin de sortir ton flingue au moindre petit mouvement.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924536
    m_Localized: 'Experienced: Il suffit que ton index te démange un peu sur la gâchette, et c''est fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924537
    m_Localized: 'Experienced: Je savais que t''étais du genre à pas rigoler, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924538
    m_Localized: 'Experienced: Mais pointe pas ton flingue sur tout et n''importe quoi, OK ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924539
    m_Localized: 'Experienced: J''ai eu ma dose avec les matons, crois-moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924540
    m_Localized: 'Experienced: On est chez toi, donc je vais rien dire. Mais évite de jouer les tyrans.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924541
    m_Localized: 'Experienced: T''es pas le gros bonnet du quartier qui dépouille tout le monde, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924542
    m_Localized: 'Experienced: Tu ferais mieux d''économiser tes balles, mon pote.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924543
    m_Localized: 'Experienced: Fais-moi confiance… Je te raconte pas de crac, je te promets !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924544
    m_Localized: 'Experienced: S''il y a bien une chose que je possède et que j''ai pas volée, c''est ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924545
    m_Localized: 'Experienced: T''as pété un plomb, frérot ? Tu veux me buter pour une photo à la noix ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924546
    m_Localized: 'Experienced: Même les flics m''ont pas aussi mal traité, frérot…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924547
    m_Localized: 'Experienced: Eh ben, ça alors… T''as retrouvé tes esprits.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924548
    m_Localized: 'Experienced: J''ai bien cru que t''allais vraiment me tuer pour une histoire qu''on n''a même pas vue à la télé…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924549
    m_Localized: 'Experienced: Putain, t''es vraiment un connard. Je croyais que t''étais un type bien. Mais t''es pourri…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924550
    m_Localized: 'Experienced: Pourri jusqu''à la moelle !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924551
    m_Localized: 'Jacket: Oh non… Promets-moi une chose… Si je suis vraiment un Visiteur, pas la peine de me le dire. Tire, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924552
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924553
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924554
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924555
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924556
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924557
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924558
    m_Localized: 'Jacket: Ouais… Vas-y, regarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924559
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924560
    m_Localized: 'Jacket: J''ai les dents mal alignées. Alors, je me bouffe les joues sans faire exprès.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924561
    m_Localized: 'Jacket: Après j''ai des aphtes… et c''est vraiment pas drôle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924562
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924563
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924564
    m_Localized: 'Jacket: Pas de problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924565
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924566
    m_Localized: 'Jacket: C''est juste que la veste est faite en tissu bas de gamme. Ça me fout des plaques, rien de plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924567
    m_Localized: 'Jacket: Tu vois ? Rien d''extraordinaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924568
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924569
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924570
    m_Localized: 'Jacket: Je vais te montrer mes yeux, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924571
    m_Localized: 'Jacket: Franchement, je suis un peu tendu. Sois pas trop dur avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924572
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924573
    m_Localized: 'Jacket: Alors ? Tout va bien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924574
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924575
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924576
    m_Localized: 'Jacket: Ah… À propos de mes aisselles…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924577
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924578
    m_Localized: 'Jacket: Je sais, je sais… Les irritations, c''est un signe des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924579
    m_Localized: 'Jacket: Mais ça vient de la veste… Je transpire dedans, et on peut pas prendre de douche ces jours-ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924580
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924581
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924582
    m_Localized: 'Jacket: Ça me va de prendre une photo, mais ton appareil a l''air un peu bizarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924583
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924584
    m_Localized: 'Jacket: Oh ouah ! C''est une de ces pellicules à aura ? Comme dans les pubs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924585
    m_Localized: 'Jacket: Franchement, t''as pas l''air d''être du genre à croire à ce genre de trucs.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924586
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924587
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924588
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924589
    m_Localized: 'Jacket: Les oreilles, ça fait pas partie des signes, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924590
    m_Localized: 'Jacket: Enfin bon, je dois avouer que je connais pas trop les signes. Peut-être que j''ai oublié celui-là.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924591
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924592
    m_Localized: 'Jacket: Alors ? Tout va bien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924593
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924594
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924595
    m_Localized: 'Jacket: Quoi ??? Je suis un Visiteur ?! Mais j''ai les dents de travers !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924596
    m_Localized: 'Jacket: TIRE PAS, PITIÉ !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924597
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924598
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924599
    m_Localized: 'Jacket: Attends, je t''ai dit que les rougeurs, c''est à cause de la veste !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924600
    m_Localized: 'Jacket: Attends, j''ai rien sur les mains !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924601
    m_Localized: 'Jacket: JE NE SUIS PAS UN VISITEUR !!! ME TIRE PAS DESSUS, PITIÉ !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924602
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924603
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924604
    m_Localized: 'Jacket: Quoi ?! Je suis un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924605
    m_Localized: 'Jacket: Mais j''ai même pas les yeux rouges !'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924606
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924607
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924608
    m_Localized: 'Jacket: Oh merde… Je suis vraiment un Visiteur ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924609
    m_Localized: 'Jacket: MERDE, MERDE, MERDE !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924610
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924611
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924612
    m_Localized: 'Jacket: Attends, attends ! Qu''est-ce qui se passe ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924613
    m_Localized: 'Jacket: Le truc de l''aura a fait apparaître quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924614
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924615
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924616
    m_Localized: 'Jacket: Attends, qu''est-ce qui cloche avec mes oreilles ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924617
    m_Localized: 'Jacket: C''est quoi le problème ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924618
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924619
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924620
    m_Localized: 'Jacket: Merci… de pas m''avoir tiré dessus.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924621
    m_Localized: 'Jacket: J''ai vu toute ma vie défiler devant mes yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924622
    m_Localized: 'Jacket: T''as fait ça exprès, non ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924623
    m_Localized: 'Jacket: Mon cœur a failli exploser… Pourquoi t''as fait un truc pareil ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924624
    m_Localized: 'Jacket: C''était quoi, ce signe ?! Pourquoi t''as fait ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924625
    m_Localized: 'Jacket: Attends…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924626
    m_Localized: 'Jacket: Les pupilles qui tremblent, c''est un signe que tu es un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924627
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924628
    m_Localized: 'Jacket: Franchement, j''étais même pas au courant de ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924629
    m_Localized: 'Jacket: T''as changé d''avis ? Tu veux plus me tuer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924630
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924631
    m_Localized: 'Jacket: Merci de ne pas avoir appuyé sur la gâchette, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924632
    m_Localized: 'Jacket: La prochaine fois que tu as des doutes, tu pourrais peut-être éviter de me faire flipper avec ton flingue ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924633
    m_Localized: 'Jacket: T''as cru que le motif sur ma veste était un signe des Visiteurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924634
    m_Localized: 'Jacket: Ouf… J''avais peur qu''il y ait plein de taches sombres.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924635
    m_Localized: 'Jacket: C''est bizarre, cet appareil photo à aura…'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924636
    m_Localized: 'Jacket: Donc… Je suis pas un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924637
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924638
    m_Localized: 'Jacket: Mais alors… Pourquoi t''as sorti ton flingue ? POURQUOI, BON SANG ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924639
    m_Localized: 'Jacket: Maman, papa… Je suis désolé.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924640
    m_Localized: 'Jacket: Je suis vraiment désolé…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414656
    m_Localized: 'Tough: Je me laisserai pas faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414657
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414658
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414659
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414660
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414661
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414662
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414663
    m_Localized: 'Tough: J''ai des grandes canines, c''est comme ça depuis toujours.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414664
    m_Localized: 'Tough: On se moquait beaucoup de moi à cause de ça quand j''étais gosse. Mais plus maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414665
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414666
    m_Localized: 'Tough: J''aurais pu leur faire sauter les dents… Histoire de leur refaire leur sourire narquois.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414667
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414668
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414669
    m_Localized: 'Tough: J''aime bien me sentir belle.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414670
    m_Localized: 'Tough: Personne me le dit jamais, que je suis belle… Mais c''est sympa de se sentir jolie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414671
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414672
    m_Localized: 'Tough: Oh, c''est pas vrai…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414673
    m_Localized: 'Tough: Mes ongles sont cassés ? Comment c''est arrivé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414674
    m_Localized: 'Tough: Peu importe… tant pis.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414675
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414676
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414677
    m_Localized: 'Tough: J''en ai vu, des choses, dans ma vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414678
    m_Localized: 'Tough: Je parie que tout est là… Suffit de prendre la peine de regarder.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414679
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414680
    m_Localized: 'Tough: C''est bien ce que je me disais…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414681
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414682
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414683
    m_Localized: 'Tough: Non. C''est pas ce qu''on va faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414684
    m_Localized: 'Tough: Tu fais partie de ces tarés qui sont obsédés par ce signe -là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414685
    m_Localized: 'Tough: Me pousse pas à tuer une nouvelle fois…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414686
    m_Localized: 'Tough: J''ai pas envie d''être encore déçue.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414687
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414688
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414689
    m_Localized: 'Tough: On me prend pas souvent en photo… Mais bon, on va voir ce que ça donne.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414690
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414691
    m_Localized: 'Tough: Je peux pas dire que je crois à toutes ces conneries sur l''aura, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414692
    m_Localized: 'Tough: D''une certaine manière, ce serait logique…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414693
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414694
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414695
    m_Localized: 'Tough: En fait, je viens de me faire percer les oreilles.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414696
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414697
    m_Localized: 'Tough: J''adore.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414698
    m_Localized: 'Tough: Avant, je portais des petites boucles d''oreilles, mais je trouvais jamais de paire qui me plaisait vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414699
    m_Localized: 'Tough: Mais celles-ci… Celles-ci, je les adore !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414700
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414701
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414702
    m_Localized: 'Tough: Tu te trompes de cible.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414703
    m_Localized: 'Tough: Il y a bien un monstre dans cette maison… Mais c''est pas moi, ça c''est sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414704
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414705
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414706
    m_Localized: 'Tough: Quoi, tu veux que j''enlève mes faux ongles ? Pas question !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414707
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414708
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414709
    m_Localized: 'Tough: Je dois garder un œil sur tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414710
    m_Localized: 'Tough: Et quand je dis tout, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414711
    m_Localized: 'Tough: Y a rien à faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414712
    m_Localized: 'Tough: J''aimerais oublier la moitié de ce que j''ai vu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414713
    m_Localized: 'Tough: Voire même la totalité, en fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414714
    m_Localized: 'Tough: Mais ça marche pas comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414715
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414716
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414717
    m_Localized: 'Tough: Putain de merde…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414718
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414719
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414720
    m_Localized: 'Tough: Mais pas pour toi, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414721
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414722
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414723
    m_Localized: 'Tough: Qu''est-ce que t''as trouvé ? Du cérumen ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414724
    m_Localized: 'Tough: Pourquoi tu me braques avec ton flingue ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414725
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414726
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414727
    m_Localized: 'Tough: C''est censé être un test ? Alors ? J''ai réussi ? J''ai pas flanché, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414728
    m_Localized: 'Tough: Même comme ça, c''est jamais agréable d''avoir un flingue pointé sur ta tronche.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414729
    m_Localized: 'Tough: Ouais… Se faire belle… Ça veut plus dire grand-chose aujourd''hui.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414730
    m_Localized: 'Tough: Mais ça fait quand même du bien de… prendre soin de soi. D''aimer ce que tu vois dans le miroir.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414731
    m_Localized: 'Tough: Je déteste ce qui se passe dehors.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414732
    m_Localized: 'Tough: Et ça va pas changer de sitôt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414733
    m_Localized: 'Tough: Tout ce qu''on peut faire, c''est continuer à se battre.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414734
    m_Localized: 'Tough: Dis-moi… tu crois vraiment que ça vaut le coup ? Tu es prêt à me tirer dessus juste parce que t''en as envie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414735
    m_Localized: 'Tough: Et après ? Tu comptes reluquer mon cadavre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414736
    m_Localized: 'Tough: Ce monde est damné. Vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414737
    m_Localized: 'Tough: Dis-moi, tu crois aux auras ? Aux âmes ? À tout ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414738
    m_Localized: 'Tough: À ton avis, un salaud reste un salaud ? Même après sa mort ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414739
    m_Localized: 'Tough: Je n''arrête pas de me demander… Quand toute cette histoire sera finie, qu''est-ce qui arrivera à tous ces lâches ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414740
    m_Localized: 'Tough: Comment ça va se passer pour eux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414741
    m_Localized: 'Tough: Tu vas vraiment appuyer sur la gâchette ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414742
    m_Localized: 'Tough: Alors, ce sera la fin… Tout mon combat…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414743
    m_Localized: 'Tough: Tout ça s''arrêtera dans la maison d''un monstre solitaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414744
    m_Localized: 'Bald: Ouais, pas de souci, l''ami. Vous voulez voir quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414745
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414746
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414747
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414748
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414749
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414750
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414751
    m_Localized: 'Bald: Euh… D''accord. Je fume de temps en temps. J''espère que je sens pas trop mauvais.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414752
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414753
    m_Localized: 'Bald: Alors ? Tout va bien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414754
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414755
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414756
    m_Localized: 'Bald: J''ai, euh… de l''eczéma. C''est pour ça que j''ai un bandage au bras.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414757
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414758
    m_Localized: 'Bald: Il paraît que couvrir l''irritation peut aider pour la guérison.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414759
    m_Localized: 'Bald: D''ailleurs, c''est presque guéri. Mais je voudrais changer le pansement, au cas où. Vous en auriez pas un, par hasard ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414760
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414761
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414762
    m_Localized: 'Bald: Vous avez sûrement remarqué que j''avais un truc bizarre à l''œil.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414763
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414764
    m_Localized: 'Bald: Je sais même pas quand ça a commencé. Mais ça me rassure pas, je vais pas vous mentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414765
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414766
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414767
    m_Localized: 'Bald: Pas la peine de paniquer, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414768
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414769
    m_Localized: 'Bald: C''est juste un problème de peau. Vous voyez ? Je suis chauve… J''ai des plaques comme ça partout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414770
    m_Localized: 'Bald: Mince… Je ne me suis pas douché depuis une éternité. Désolé.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414771
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414772
    m_Localized: 'Bald: Les aisselles, c''est juste… des aisselles.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414773
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414774
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414775
    m_Localized: 'Bald: Oh, j''adore ! Cheeeese !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414776
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414777
    m_Localized: 'Bald: Alors ? Faites-moi voir !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414778
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414779
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414780
    m_Localized: 'Bald: Ouais, bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414781
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414782
    m_Localized: 'Bald: Franchement, j''ai horreur de les nettoyer. Si on va trop loin, ça fait un mal de chien.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414783
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414784
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414785
    m_Localized: 'Bald: Hé, arrêtez ! C''est quoi votre problème ? Tout allait bien il y a une seconde…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414786
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414787
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414788
    m_Localized: 'Bald: Oh… OK, OK ! Pas besoin de pointer ce truc sur moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414789
    m_Localized: 'Bald: Laissez tomber pour le pansement, ça va. J''en veux plus !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414790
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414791
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414792
    m_Localized: 'Bald: Allez ! C''est pas grave ! C''est pas comme si j''allais en mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414793
    m_Localized: 'Bald: Ça sert à rien d''aller chez le docteur, de toute façon. Les bobos guérissent, les vraies maladies non.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414794
    m_Localized: 'Bald: Et ça ? C''est un petit bobo de rien du tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414795
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414796
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414797
    m_Localized: 'Bald: Oh, détendez-vous un peu, d''accord ? Tout va bien ! Pointez pas votre flingue sur moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414798
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414799
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414800
    m_Localized: 'Bald: Merde ! On peut en refaire une si c''est si mauvais que ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414801
    m_Localized: 'Bald: Ou peut-être que votre appareil est cassé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414802
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414803
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414804
    m_Localized: 'Bald: Mais j''ai rien fait, enfin !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414805
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414806
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414807
    m_Localized: 'Bald: On n''avait pas les moyens d''aller chez le dentiste, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414808
    m_Localized: 'Bald: Mais bon… On n''avait pas les moyens d''acheter grand-chose à part de la bouffe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414809
    m_Localized: 'Bald: Ma mère me cousait des vêtements à partir de chutes de tissu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414810
    m_Localized: 'Bald: Une fois, je me suis pris une cuite phénoménale avec mes copains du théâtre.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414811
    m_Localized: 'Bald: C''était du grand n''importe quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414812
    m_Localized: 'Bald: Je ne reconnaissais même plus mes mains. J''avais l''impression de regarder un film à la première personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414813
    m_Localized: 'Bald: Mais j''ai rien fait de stupide. Je suis rentré chez moi. Avec des chaussures dépareillées, certes, mais vivant.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414814
    m_Localized: 'Bald: Ça m''a foutu une sacrée trouille, quand même. J''ai arrêté de boire après ça. J''aurais pu y rester si j''avais continué.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414815
    m_Localized: 'Bald: Mais je me suis fait peur. J''ai arrêté de boire après ça. J''aurais pu mourir si j''avais continué comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414816
    m_Localized: 'Bald: J''ai quand même eu très peur au début.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414817
    m_Localized: 'Bald: J''ai commencé à paniquer… Je pensais que je devenais aveugle ou quelque chose comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414818
    m_Localized: 'Bald: Mais non. Ça fait des années que c''est comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414819
    m_Localized: 'Bald: Et me faire soigner ? Ça coûterait une fortune, j''ai pas les moyens…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414820
    m_Localized: 'Bald: Enfin, qu''est-ce que vous voulez que je vous dise…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414821
    m_Localized: 'Bald: Vous êtes dangereux, l''ami. Vous décidez qui vit et qui meurt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414822
    m_Localized: 'Bald: C''est complètement dingue.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414823
    m_Localized: 'Bald: On a recommencé à boire, comme d''habitude.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414824
    m_Localized: 'Bald: Quelques jours plus tard, on a appris qu''une de nos amis n''était jamais rentrée chez elle.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414825
    m_Localized: 'Bald: On a imprimé ses photos, on a mis des affiches partout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414826
    m_Localized: 'Bald: En fait, elle a glissé, est tombée dans la rivière et s''est noyée.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414827
    m_Localized: 'Bald: C''était trop triste.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414828
    m_Localized: 'Bald: C''était une fille sympa. Et très jolie aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414829
    m_Localized: 'Bald: J''adorais quand maman me nettoyait les oreilles. Elle était si douce, elle ne m''a jamais fait mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414830
    m_Localized: 'Bald: Mais elle ne le fera plus jamais… plus jamais… Pas avec les doigts dans cet état…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414831
    m_Localized: 'Bald: Merde…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414832
    m_Localized: 'Bald: Espèce d''enfoiré !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414833
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414834
    m_Localized: 'Nervous: Ça me rappelle un peu l''hôpital, hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414835
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414836
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414837
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414838
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414839
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414840
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414841
    m_Localized: 'Nervous: Tous ces médocs… Ça m''a un tout petit peu abîmé les dents…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414842
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414843
    m_Localized: 'Nervous: Ces pinces-là… Elles sont parfaites pour m''arracher l''intérieur des joues… tirer des lamelles de peau, une par une.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414844
    m_Localized: 'Nervous: Jusqu''à sentir le sang. Et la douleur. Ah, la douleur…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414845
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414846
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414847
    m_Localized: 'Nervous: J''ai appris à arrêter de me ronger les ongles.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414848
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414849
    m_Localized: 'Nervous: Mais quand la peau ressort, j''ai juste envie de l''arracher.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414850
    m_Localized: 'Nervous: Je l''arrache tout doucement… pour bien sentir la brûlure. Hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414851
    m_Localized: 'Nervous: Ça pique pendant un moment. Alors je creuse dans le sol pendant que c''est à vif… Mmmm… Dur, tranchant, rugueux…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414852
    m_Localized: 'Nervous: Ça pique pendant un moment…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414853
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414854
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414855
    m_Localized: 'Nervous: J''aime bien tes yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414856
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414857
    m_Localized: 'Nervous: Je te regarde quand tu dors. Quand tu te promènes la nuit…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414858
    m_Localized: 'Nervous: Y a quelqu''un en qui t''as pas confiance ? Hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414859
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414860
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414861
    m_Localized: 'Nervous: On m''a jamais appris à prendre soin de moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414862
    m_Localized: 'Nervous: Mais je les ai vus faire, tu sais… un peu n''importe comment, à l''hôpital.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414863
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414864
    m_Localized: 'Nervous: J''ai jamais fait comme il fallait, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414865
    m_Localized: 'Nervous: Mais, maintenant je sais faire… moi aussi, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414866
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414867
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414868
    m_Localized: 'Nervous: J''aime pas ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414869
    m_Localized: 'Nervous: Hmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414870
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414871
    m_Localized: 'Nervous: Avant, ils se moquaient de moi… Maintenant, ils riront plus jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414872
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414873
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414874
    m_Localized: 'Nervous: Je leur accorde aucune attention.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414875
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414876
    m_Localized: 'Nervous: Ça sert à rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414877
    m_Localized: 'Nervous: Ni plaisir ni douleur. Ça sert à rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414878
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414879
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414880
    m_Localized: 'Nervous: Des poils rêches qui frottent contre les gencives… Oh oui…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414881
    m_Localized: 'Nervous: Mais là… c''est trop…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414882
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414883
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414884
    m_Localized: 'Nervous: POURQUOI ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414885
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414886
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414887
    m_Localized: 'Nervous: MOI ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414888
    m_Localized: 'Nervous: Je t''ai pas fait de mal quand tu dormais… pas pour l''instant !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414889
    m_Localized: 'Nervous: Comment t''as pu faire ça ? Pauvre petit moi… Hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414890
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414891
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414892
    m_Localized: 'Nervous: Oh ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414893
    m_Localized: 'Nervous: Je suis une personne horrible à cause de mes aisselles toutes lisses ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414894
    m_Localized: 'Nervous: Pourtant… Hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414895
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414896
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414897
    m_Localized: 'Nervous: C''est tellement… gentil… de ta part, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414898
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414899
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414900
    m_Localized: 'Nervous: Pourquoi t''es devenu tout pan-pan avec moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414901
    m_Localized: 'Nervous: Tu te crois mieux que moi, toi ? Plus propre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414902
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414903
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414904
    m_Localized: 'Nervous: Ils m''ont grillé le cerveau à l''hôpital. Zap zap zap !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414905
    m_Localized: 'Nervous: Mais le seul qui pouvait m''aider… c''était moi. Hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414906
    m_Localized: 'Nervous: J''ai arrêté de me ronger les ongles quand j''ai commencé à me mordre l''intérieur des joues !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414907
    m_Localized: 'Nervous: Hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414908
    m_Localized: 'Nervous: Pointer un petit flingue de rien du tout sur quelqu''un qui sait quand et où tu dors… ? Hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414909
    m_Localized: 'Nervous: Est-ce que les Visiteurs sont vraiment différents de ceux qui rentrent pas dans le moule ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414910
    m_Localized: 'Nervous: La société déteste les uns autant que les autres…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414911
    m_Localized: 'Nervous: Comment tu peux savoir ? Tu peux savoir ? Tu peux ? Hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414912
    m_Localized: 'Nervous: Une ombre plane au-dessus de moi… Hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414913
    m_Localized: 'Nervous: Qu''est-ce que ça peut être ? Y a quelqu''un ? Ou c''est juste un reflet bizarre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414914
    m_Localized: 'Nervous: C''est quoi ces rayures ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414915
    m_Localized: 'Nervous: C''est… des AIGUILLES ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414916
    m_Localized: 'Nervous: Ou juste un reflet de lumière ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414917
    m_Localized: 'Nervous: Pourquoi t''as pointé un flingue sur moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414918
    m_Localized: 'Nervous: Quelqu''un t''a dit de le faire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414919
    m_Localized: 'Nervous: Alors ? C''est vrai ? C''est eux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414920
    m_Localized: 'Nervous: Non ? … J''ai juste pensé que…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414921
    m_Localized: 'Nervous: Hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414922
    m_Localized: 'Nervous: J''aurais peut-être pas dû…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414923
    m_Localized: 'Nervous: … venir ici… Hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414924
    m_Localized: 'Leper: Vas-y, si ça peut te faire plaisir.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414925
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414926
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414927
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414928
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414929
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414930
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414931
    m_Localized: 'Leper: Tu vois ? Tout est normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414932
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414933
    m_Localized: 'Leper: Et bien droites, aussi. J''ai peut-être une vilaine peau, mais mes dents sont impeccables.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414934
    m_Localized: 'Leper: Tu ne vas pas me tuer pour la seule chose que j''ai de bien, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414935
    m_Localized: 'Leper: Elles sont de travers, c''est vrai. Mais ça ne veut pas dire pour autant que je suis un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414936
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414937
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414938
    m_Localized: 'Leper: Ouais, ma peau est dans un sale état là aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414939
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414940
    m_Localized: 'Leper: Tu vas pas me dire que c''est un signe de Visiteur, rassure-moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414941
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414942
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414943
    m_Localized: 'Leper: Pas de souci, regarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414944
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414945
    m_Localized: 'Leper: Je sais que les yeux rouges sont un signe. Mais ça ? C''est juste cette fichue maladie de peau, comme tout le reste.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414946
    m_Localized: 'Leper: J''ai oublié de te dire, parfois j''ai les yeux qui tremblent. C''est cette maladie que je me coltine depuis toujours.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414947
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414948
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414949
    m_Localized: 'Leper: Quoi ? Pourquoi tu fais ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414950
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414951
    m_Localized: 'Leper: Bon, peu importe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414952
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414953
    m_Localized: 'Leper: Tu vois ? Rien de bizarre. Curieusement, j''ai aucun problème de peau à cet endroit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414954
    m_Localized: 'Leper: Ouais, c''est pas beau ici non plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414955
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414956
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414957
    m_Localized: 'Leper: Une photo ? C''est un signe ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414958
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414959
    m_Localized: 'Leper: Bon, prends la photo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414960
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414961
    m_Localized: 'Leper: J''ai dû cligner des yeux. Alors, c''est quoi ce soi-disant signe, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414962
    m_Localized: 'Leper: Alors, c''est quoi ce soi-disant signe, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414963
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414964
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414965
    m_Localized: 'Leper: Hein ? C''est quoi cette histoire d''oreilles ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414966
    m_Localized: 'Leper: Sans vouloir te vexer, je connais les signes des Visiteurs, et ça, ça en est pas un.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414967
    m_Localized: 'Leper: Si t''insistes pour voir mes oreilles, fais-toi plaisir.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414968
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414969
    m_Localized: 'Leper: Alors ? Tu vois quelque chose de bizarre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414970
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414971
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414972
    m_Localized: 'Leper: Bon sang, mais c''est quoi ton problème ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414973
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414974
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414975
    m_Localized: 'Leper: Je te l''ai déjà dit, c''est juste ma peau.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414976
    m_Localized: 'Leper: C''est tout, c''est cette fichue maladie de peau.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414977
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414978
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414979
    m_Localized: 'Leper: J''ai déjà dit que c''était à cause de la maladie !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414980
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414981
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414982
    m_Localized: 'Leper: Tu rigoles ou quoi ?! Pour quoi tu fais ça ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414983
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414984
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414985
    m_Localized: 'Leper: Attends, attends. C''est même pas un appareil photo normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414986
    m_Localized: 'Leper: C''est… une photo d''aura ? Tu vas m''abattre pour un délire ésotérique ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414987
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414988
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414989
    m_Localized: 'Leper: Tu es sérieux là ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414990
    m_Localized: 'Leper: Les oreilles, c''est pas un signe de Visiteur ! Ils ont jamais dit ça à la télé !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414991
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414992
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414993
    m_Localized: 'Leper: Putain…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414994
    m_Localized: 'Leper: Pourquoi tu pointes ton flingue sur moi ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414995
    m_Localized: 'Leper: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414996
    m_Localized: 'Leper: Pendant un instant, j''ai vraiment cru que tu allais me descendre à cause de mon apparence.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414997
    m_Localized: 'Leper: Putain.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414998
    m_Localized: 'Leper: Tu sors ton flingue dès que tu penses avoir trouvé un signe ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414999
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415000
    m_Localized: 'Leper: Tu vaux pas mieux que ceux qui pensent que je suis contagieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415001
    m_Localized: 'Leper: Ça va pas, la tête ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415002
    m_Localized: 'Leper: Depuis quand un appareil photo bidon peut dire qui est un Visiteur ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415003
    m_Localized: 'Leper: Bon sang…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415004
    m_Localized: 'Leper: Je vais faire une crise cardiaque avec tes idioties. Où as-tu entendu parler de cette histoire d''oreilles ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415005
    m_Localized: 'Leper: La FEMA n''a jamais dit que c''était un signe !'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415006
    m_Localized: 'Leper: Merde, je veux pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415007
    m_Localized: 'Leper: … mourir…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621056
    m_Localized: 'Fairytaller: Pas de problème ! Tu veux vérifier exactement ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621057
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621058
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621059
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621060
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621061
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621062
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621063
    m_Localized: 'Fairytaller: Voilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621064
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621065
    m_Localized: 'Fairytaller: J''ai jamais eu de belles dents, et j''ai pas eu le temps d''aller chez le dentiste depuis que j''ai fini mes études.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621066
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621067
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621068
    m_Localized: 'Fairytaller: Voilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621069
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621070
    m_Localized: 'Fairytaller: C''est quand j''étais gamin que j''ai eu ça. On explorait des endroits abandonnés et il y avait du grillage par terre…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621071
    m_Localized: 'Fairytaller: Un copain a dérapé sur une armoire et elle est tombée sur mes mains. Ça m''a laissé cette marque… pour la vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621072
    m_Localized: 'Fairytaller: Ah, mais les égratignures, elles sont récentes. J''ai juste… eu un moment de panique.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621073
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621074
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621075
    m_Localized: 'Fairytaller: Voilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621076
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621077
    m_Localized: 'Fairytaller: Mes yeux deviennent rouges avec la chaleur. Les compresses froides, ça aide… mais c''est dur à trouver maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621078
    m_Localized: 'Fairytaller: On m''a dit plein de trucs sur la couleur de mes yeux. Parfois c''était sympa, parfois… pas vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621079
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621080
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621081
    m_Localized: 'Fairytaller: Hum… Si tu y tiens…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621082
    m_Localized: 'Fairytaller: Voilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621083
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621084
    m_Localized: 'Fairytaller: Je sais. Désolé pour l''odeur.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621085
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621086
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621087
    m_Localized: 'Fairytaller: Ça a l''air… intéressant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621088
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621089
    m_Localized: 'Fairytaller: Hmm. Surprenant, ce résultat.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621090
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621091
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621092
    m_Localized: 'Fairytaller: Voilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621093
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621094
    m_Localized: 'Fairytaller: Ouais, je sais. C''est un peu cracra. J''ai pas vraiment eu le temps de prendre soin de moi ces derniers temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621095
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621096
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621097
    m_Localized: 'Fairytaller: Je me rincerai la bouche ! Désolé ! J''ai pas pris ma brosse à dents. Mais me tire pas dessus, pitié !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621098
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621099
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621100
    m_Localized: 'Fairytaller: Mes ongles ?! C''est arrivé l''autre jour, je les ai accrochés à un morceau de métal dans le noir !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621101
    m_Localized: 'Fairytaller: C''est juste une cicatrice de quand j''étais petit ! Sinon, mes mains vont bien ! Promis !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621102
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621103
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621104
    m_Localized: 'Fairytaller: Je peux juste prendre un truc frais dans le frigo ? J''ai toujours eu ça, je vais te montrer !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621105
    m_Localized: 'Fairytaller: OK, OK ! Plus de blagues ! S''il te plaît, me tue pas ! Par pitié !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621106
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621107
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621108
    m_Localized: 'Fairytaller: Désolé, j''ai pas pris mes affaires de toilette et c''est pas cool d''utiliser celles de quelqu''un d''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621109
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621110
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621111
    m_Localized: 'Fairytaller: J''espère que tu ne vas pas me juger pour un truc aussi dérisoire ? C''est pas grave.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621112
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009664
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009665
    m_Localized: 'Fairytaller: Je vais les nettoyer ! S''il te plaît, tire pas !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009666
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009667
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009668
    m_Localized: 'Fairytaller: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009669
    m_Localized: 'Fairytaller: Je vais essayer de mieux prendre soin de mes dents.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009670
    m_Localized: 'Fairytaller: Ouf… Pendant un moment, j''ai cru que t''allais me tirer dessus à cause de cette cicatrice.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009671
    m_Localized: 'Fairytaller: C''est dur de bien prendre soin de ses ongles de nos jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009672
    m_Localized: 'Fairytaller: Mais je vais essayer de les nettoyer plus souvent, juste au cas où.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009673
    m_Localized: 'Fairytaller: Merci pour ta compréhension.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009674
    m_Localized: 'Fairytaller: Tu sais, cette situation me plaît pas non plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009675
    m_Localized: 'Fairytaller: … Au fait, la couleur de tes yeux est très belle.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009676
    m_Localized: 'Fairytaller: Merci de pas m''avoir tiré dessus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009677
    m_Localized: 'Fairytaller: Je vais essayer de trouver le temps de me laver correctement.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009678
    m_Localized: 'Fairytaller: Je me disais aussi que ce serait pas très sympa de tuer quelqu''un pour une photo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009679
    m_Localized: 'Fairytaller: C''était une expérience intéressante… mais si je peux éviter de mourir pour ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009680
    m_Localized: 'Fairytaller: Merci de m''avoir épargné. Je vais les nettoyer dès que possible.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009681
    m_Localized: 'Fairytaller: Je vais essayer de trouver un coton-tige.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009682
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009683
    m_Localized: 'Fairytaller: Maman…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009684
    m_Localized: 'FunnyGuy: Vas-y. C''est pas comme si j''avais autre chose à faire !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009685
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009686
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009687
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009688
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009689
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009690
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009691
    m_Localized: 'FunnyGuy: Roh, ça va… De toute façon, faut pas brosser trop fort, sinon ça abîme l''émail.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009692
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009693
    m_Localized: 'FunnyGuy: Ha ha, j''avais oublié qu''il me manquait une dent. C''est une drôle d''histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009694
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009695
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009696
    m_Localized: 'FunnyGuy: Juste des mains normales, usées par le boulot.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009697
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009698
    m_Localized: 'FunnyGuy: Quatorze ans à trimer à l''usine.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009699
    m_Localized: 'FunnyGuy: Et tout ça pour quoi ? Regarde comment ça s''est fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009700
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009701
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009702
    m_Localized: 'FunnyGuy: J''ai une tache sombre sur l''iris.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009703
    m_Localized: 'FunnyGuy: Regarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009704
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009705
    m_Localized: 'FunnyGuy: J''ai toujours une petite tache dans mon champ de vision à cause de ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009706
    m_Localized: 'FunnyGuy: Mais quand on vit avec, on finit par plus faire attention.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009707
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009708
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009709
    m_Localized: 'FunnyGuy: Notre usine, c''est un vrai champ de mines en termes de risques de procès.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009710
    m_Localized: 'FunnyGuy: Normalement, j''étais sur le point de prendre ma retraite.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009711
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009712
    m_Localized: 'FunnyGuy: Maintenant, j''ai ce truc à cause de l''humidité, tu vois ? Les pommades, ça ne sert à rien ! Et en plus, faut se raser !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009713
    m_Localized: 'FunnyGuy: Maintenant, j''ai ce truc à cause de l''humidité, tu vois ? Les pommades, ça ne sert à rien !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009714
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009715
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009716
    m_Localized: 'FunnyGuy: Oh, je ferais mieux de me reboutonner.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009717
    m_Localized: 'FunnyGuy: Eh, tant pis. C''est juste une photo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009718
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009719
    m_Localized: 'FunnyGuy: Pas la peine de me montrer. Rien à faire, je veux pas voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009720
    m_Localized: 'FunnyGuy: OK, montre-moi ce que t''as là.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009721
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009722
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009723
    m_Localized: 'FunnyGuy: Vas-y, pourquoi pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009724
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009725
    m_Localized: 'FunnyGuy: Bon, y avait rien à l''usine qui pouvait nous abîmer les oreilles.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009726
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009727
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009728
    m_Localized: 'FunnyGuy: Ouah, doucement. Pas besoin de laisser ton humeur prendre le dessus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009729
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009730
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009731
    m_Localized: 'FunnyGuy: Pourquoi tu t''énerves comme ça ? Calme-toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009732
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009733
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009734
    m_Localized: 'FunnyGuy: Ah, laisse tomber.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009735
    m_Localized: 'FunnyGuy: Tu veux tirer ? Alors, tire.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009736
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009737
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009738
    m_Localized: 'FunnyGuy: Ha ! Ouais, ça va tout régler, c''est sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009739
    m_Localized: 'FunnyGuy: Ça résout tous les problèmes, instantanément !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009740
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009741
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009742
    m_Localized: 'FunnyGuy: Ah, le signe le plus évident de tous ! Un gros flingue !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009743
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009744
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009745
    m_Localized: 'FunnyGuy: T''en as pas marre de brandir ce truc ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009746
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009747
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009748
    m_Localized: 'FunnyGuy: Merci de pas m''avoir tiré dessus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009749
    m_Localized: 'FunnyGuy: L''histoire des dents ? Je rêve… Tu penses vraiment que tu peux sortir un flingue et discuter comme si de rien n''était ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009750
    m_Localized: 'FunnyGuy: Tu imagines arriver au boulot un jour et te faire virer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009751
    m_Localized: 'FunnyGuy: Je me suis tué à la tâche… Et pour quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009752
    m_Localized: 'FunnyGuy: Ils ont fermé toute l''usine à cause des problèmes de productivité.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009753
    m_Localized: 'FunnyGuy: On ne peut même plus mourir en paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009754
    m_Localized: 'FunnyGuy: Qu''est-ce que tu veux savoir d''autre, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009755
    m_Localized: 'FunnyGuy: Je te vois très bien. Tout comme le flingue que tu pointes sur moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009756
    m_Localized: 'FunnyGuy: Dieu te jugera.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009757
    m_Localized: 'FunnyGuy: Faut croire que je suis à la retraite maintenant, hein.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009758
    m_Localized: 'FunnyGuy: Pas de boulot, les banques m''ont volé mon argent, le soleil brûle tout le reste.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009759
    m_Localized: 'FunnyGuy: Quelle vie, hein ? Un vrai conte de fées ! HAHAHA !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009760
    m_Localized: 'FunnyGuy: Ma famille réagissait toujours bizarrement avec les photos… Je sais pas pourquoi…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009761
    m_Localized: 'FunnyGuy: Ils me disaient : « Pourquoi t''as apporté un appareil photo ici ? Va plutôt prendre des photos de grenouilles ! »'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009762
    m_Localized: 'FunnyGuy: J''imagine que j''ai hérité ça d''eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009763
    m_Localized: 'FunnyGuy: Mais c''est quand même injuste qu''on m''ait pris mon argent.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009764
    m_Localized: 'FunnyGuy: C''est injuste aussi qu''on se soit fait virer de l''usine.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009765
    m_Localized: 'FunnyGuy: Oh, t''es un marrant, toi… pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009766
    m_Localized: 'FunnyGuy: Bon… En tout cas, c''est fini pour moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009767
    m_Localized: 'FunnyGuy: Retraite perpétuelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009768
    m_Localized: 'Alt: Vu comment leurs rapports étaient foireux, leurs tests doivent l''être encore plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009769
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009770
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009771
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009772
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009773
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009774
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009775
    m_Localized: 'Alt: Je te préviens, j''ai les dents longues en affaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009776
    m_Localized: 'Alt: Hahaha.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009777
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009778
    m_Localized: 'Alt: Ne pas prendre soin d''une telle beauté, ce serait criminel !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009779
    m_Localized: 'Alt: Je viens de les faire limer, en fait. J''ai encore mal aux gencives. Mais ça me donne un look de fou !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009780
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009781
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009782
    m_Localized: 'Alt: J''ai pas eu de chance avec les ongles.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009783
    m_Localized: 'Alt: J''ai appelé un taxi pour aller en banlieue tranquillement.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009784
    m_Localized: 'Alt: Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009785
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009786
    m_Localized: 'Alt: Un crétin arrogant m''a bousculée, il a souri et il est monté à ma place.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009787
    m_Localized: 'Alt: Je m''en souviens très clairement. Ses dents blanches, parfaites.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009788
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009789
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009790
    m_Localized: 'Alt: Oh, mes yeux ? Je les aime presque autant que mes tatouages.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009791
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009792
    m_Localized: 'Alt: T''en penses quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009793
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009794
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009795
    m_Localized: 'Alt: Ça ne me dérange pas de montrer mes aisselles.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009796
    m_Localized: 'Alt: C''est juste que… C''est pas très joli à voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009797
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009798
    m_Localized: 'Alt: Je te l''avais dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009799
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009800
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009801
    m_Localized: 'Alt: Oh ouah ! Toi aussi, t''as un appareil photo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009802
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009803
    m_Localized: 'Alt: Voyons voir ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009804
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009805
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009806
    m_Localized: 'Alt: Hmm. OK.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009807
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009808
    m_Localized: 'Alt: J''ai dû retirer mes piercings. Trop de poivrots me prenaient la tête à cause d''eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009809
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009810
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009811
    m_Localized: 'Alt: Attends une seconde. Ça ne te dérange pas que ces « signes » soient si imprécis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009812
    m_Localized: 'Alt: Les gens normaux aussi peuvent les avoir. Avoue que ça ratisse large, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009813
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009814
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009815
    m_Localized: 'Alt: Tu penses que je suis comme dans cette histoire que je t''ai racontée ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009816
    m_Localized: 'Alt: Qu''est-ce que tu crois que j''ai fait au juste ? C''est pas ma faute si je suis tombée et que je me suis cassé un ongle.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009817
    m_Localized: 'Alt: Qu''est-ce que tu crois que j''ai fait au juste ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009818
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009819
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009820
    m_Localized: 'Alt: Quoi ? Pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009821
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009822
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009823
    m_Localized: 'Alt: Pas de panique… J''avais un vieux tatouage que je voulais enlever, et avec la chaleur, ça a fait un truc bizarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009824
    m_Localized: 'Alt: Quelle idée de vouloir enlever de l''encre par cette chaleur…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009825
    m_Localized: 'Alt: Ça fait un mal de chien, et tu transpires à grosses gouttes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009826
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009827
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009828
    m_Localized: 'Alt: Je sais, c''est bizarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009829
    m_Localized: 'Alt: Je voulais juste avoir l''air cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009830
    m_Localized: 'Alt: Je ne pensais vraiment pas prendre ma photo pour mon enterrement.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009831
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009832
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009833
    m_Localized: 'Alt: Maintenant, je regrette presque de les avoir enlevés.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009834
    m_Localized: 'Alt: Au moins, j''aurais compris pourquoi on me tue.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009835
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009836
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009837
    m_Localized: 'Alt: Je vais faire une petite pause, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009838
    m_Localized: 'Alt: C''est un peu stressant de recevoir des menaces de mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009839
    m_Localized: 'Alt: Je vais pas retourner en ville à cause de mes ongles. Pas question.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009840
    m_Localized: 'Alt: Qui sait ce qui va se passer dès que je remettrai les pieds dans cette pagaille.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009841
    m_Localized: 'Alt: La plupart de mes tatouages, je les ai faits après avoir perdu un proche.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009842
    m_Localized: 'Alt: Comme des souvenirs gravés à l''encre dans ma peau.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009843
    m_Localized: 'Alt: La vie n''a pas été facile. Ça se voit, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009844
    m_Localized: 'Alt: Mais c''est quand j''ai perdu mon âme sœur… que je me suis tatoué les yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009845
    m_Localized: 'Alt: Comme ça, je pouvais encore le voir chaque fois que je me regardais dans le miroir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009846
    m_Localized: 'Alt: Mieux vaut bien choisir son tatoueur, c''est sûr…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009847
    m_Localized: 'Alt: Dommage… Personne va me pleurer. Personne va graver mon souvenir dans sa peau quand je ne serai plus là.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009848
    m_Localized: 'Alt: On vit dans une époque bizarre…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009849
    m_Localized: 'Alt: J''ai quitté un putain de cirque pour que les clowns me suivent jusqu''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009850
    m_Localized: 'Alt: C''est flippant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009851
    m_Localized: 'Tourist: Vous pensez que je suis infecté ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009852
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009853
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009854
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009855
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009856
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009857
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009858
    m_Localized: 'Tourist: Vous voulez dire que mes dents peuvent indiquer si j''ai contracté le virus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009859
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009860
    m_Localized: 'Tourist: Eh bien, si ça peut vous aider…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009861
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009862
    m_Localized: 'Tourist: Bien droites, hein ? Dans mon pays, les dentistes ne coûtent pas cher.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009863
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009864
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009865
    m_Localized: 'Tourist: Mes mains ? Vous voulez voir si j''ai des rougeurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009866
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009867
    m_Localized: 'Tourist: Ne vous en faites pas, ma peau me démange après avoir bronzé. Je me suis peut-être un peu gratté.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009868
    m_Localized: 'Tourist: Elles ont un peu pris le soleil, c''est tout. Mais ce n''est pas une infection.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009869
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009870
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009871
    m_Localized: 'Tourist: Mes yeux ? Aucun problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009872
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009873
    m_Localized: 'Tourist: Malheureusement, les lunettes de soleil n''ont pas été d''une grande utilité…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009874
    m_Localized: 'Tourist: Heureusement que j''avais apporté mes lunettes de soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009875
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009876
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009877
    m_Localized: 'Tourist: Qu''est-ce qu''il y a ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009878
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009879
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009880
    m_Localized: 'Tourist: Honnêtement, c''est juste la chaleur. Je transpire beaucoup et ça me donne des rougeurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009881
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009882
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009883
    m_Localized: 'Tourist: Est-ce une technologie gouvernementale qui permet de détecter les infections ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009884
    m_Localized: 'Tourist: Si c''est le cas, je veux bien essayer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009885
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009886
    m_Localized: 'Tourist: Hmm… Cette pellicule est… originale.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009887
    m_Localized: 'Tourist: Et ces points sont… tout aussi originaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009888
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009889
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009890
    m_Localized: 'Tourist: Oh, ça se tient. Et si le virus se propageait par le conduit auditif ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009891
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009892
    m_Localized: 'Tourist: Je pense que tout est normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009893
    m_Localized: Laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009894
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009895
    m_Localized: 'Tourist: Qu''est-ce que c''est ? Qu''y a-t-il ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009896
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009897
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009898
    m_Localized: 'Tourist: Pour l''amour du ciel, je vous l''ai dit, je me suis gratté ! C''est une irritation !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009899
    m_Localized: 'Tourist: Depuis quand le bronzage est-il un symptôme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009900
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009901
    m_Localized: 'Tourist: Pourquoi pointez-vous ce truc sur moi ? Parce que j''ai les yeux rouges ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009902
    m_Localized: 'Tourist: Pourquoi pointez-vous cette arme sur moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009903
    m_Localized: 'Tourist: Mes yeux sont tout à fait normaux !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009904
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009905
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009906
    m_Localized: 'Tourist: Vous voulez dire que les éruptions cutanées sont un symptôme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009907
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009908
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009909
    m_Localized: 'Tourist: Pourquoi vous faites ça ? J''ai juste dit que la pellicule avait l''air bizarre ! C''est la première fois que je vois ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009910
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009911
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009912
    m_Localized: 'Tourist: Attendez, c''est quoi le problème ? Je n''ai même pas de cire dans les oreilles !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009913
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009914
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009915
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009916
    m_Localized: 'Tourist: Pourquoi pointer votre arme sur moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009917
    m_Localized: 'Tourist: Pourriez-vous la ranger, s''il vous plaît ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009918
    m_Localized: 'Tourist: Je comprends, mais ça va trop loin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009919
    m_Localized: 'Tourist: Bon sang, ce n''est que du bronzage !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009920
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009921
    m_Localized: 'Tourist: Est-ce que vous traitez tout le monde ainsi dans cette maison ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009922
    m_Localized: 'Tourist: Alors ? Vous n''allez pas tirer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009923
    m_Localized: 'Tourist: Mais qu''est-ce que c''est que cette histoire ? Les aisselles ? C''est un symptôme maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009924
    m_Localized: 'Tourist: Calmez-vous !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009925
    m_Localized: 'Tourist: Pourquoi sautez-vous sur votre arme dès que l''occasion se présente ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009926
    m_Localized: 'Tourist: C''est vous qui avez voulu prendre cette photo en premier lieu !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009927
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009928
    m_Localized: 'Tourist: Vous avez perdu la tête ? C''est pas un jouet.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009929
    m_Localized: 'Tourist: Arrêtez d''agiter votre arme, vous allez finir par blesser quelqu''un !'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009930
    m_Localized: 'Tourist: Bon sang… Je n''aurai jamais…'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009931
    m_Localized: 'Tourist: … vu le monde…'
    m_Metadata:
      m_Items: []
  - m_Id: 94177391876841472
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
