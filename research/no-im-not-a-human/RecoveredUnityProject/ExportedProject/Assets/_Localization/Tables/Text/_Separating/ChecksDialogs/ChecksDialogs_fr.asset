%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_fr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 1290f85681bd44940af0abf2b1b05504, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: *tousse* Bien sûr, l''ami. J''ai rien à cacher. Tout a cramé il y a déjà bien longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Regardez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: Ne *tousse* soyez pas trop dur. La fumée n''est pas vraiment recommandée par les dentistes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Tenez, regardez… *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: On dirait deux bouts de bois carbonisés. Pourtant, les ongles sont propres. Plutôt ironique, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: Le laisser tranquille.
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: Pas de problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: Vous voyez ? *tousse* Rouges comme ceux d''un lapin malade. C''est à cause de toute cette fumée, mon ami.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: Vraiment ? C''est pas beau à voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: Ma peau est craquelée comme un vieux vernis. Je préfère pas lever les bras si je peux éviter. Ça fait trop mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: Évidemment. Vous finirez avec un autre cadavre calciné en forêt. C''est toujours ainsi que ça finit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: C''est ce que vous aimez, hein ? *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: C''est simple. Ils sont grillés jusqu''aux os du cartilage.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: Je vais pas tarder à devenir sourd. C''est sans doute mieux comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Allez-y, tirez-moi dessus. Mais pas dans les dents. Elles sont déjà au bout de leur vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Eh, plus rien ne me fait peur. Tirez-moi dessus si ça vous simplifie la vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: Peut-être que ce sera encore plus facile comme ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: Est-ce que vous imaginez ce que ces mains ont enduré, au moins ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: Si cette photo est une condamnation, alors finissons-en *tousse* *tousse* tout de suite. Plus rien me retient ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Tout est en train de partir en fumée… Mon heure est venue, j''imagine.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: J''ai jamais pu convaincre mes gosses de se laver les dents tous les jours. Maintenant… *tousse* plus personne leur dira.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter:'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: Alors, c''est comme ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: L''heure fatidique a sonné.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: Le jour où il y aura le feu *tousse*… vous regarderez, impuissant, la forêt se réduire en cendres.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: Je me réveille souvent avec l''impression que ma peau se déchire… Rien n''apaise ça. Le feu a tout dévoré…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Seuls les souvenirs échappent aux flammes. Pour la chair, ce n''est qu''une question de temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: Quand le brasier vous encerclera, vous goûterez au prix du silence. Vos oreilles n''entendront rien… mais votre âme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: D''accord. Eh bien, balance-moi tes tests, alors. Je vais réussir les doigts dans le nez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Tiens, regarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: Ces dents-là ? Une vraie mine d''or.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: Enfin, elles sont pas toutes en or, non… Mais y en a de plus en plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: Dans le temps, j''ouvrais les bières avec mes incisives. La classe, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: Ouaip. Pas besoin d''autre chose !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: J''ai encore mes mains. C''est déjà ça, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: Sans elles, même rouler serait impossible.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Minute…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: Merde. Mes doigts !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: Il m''en manquait juste un hier. Où sont passés les autres ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: Pas grave. Ils finiront bien par repousser. Un jour…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: Un doigt en moins…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: C''est rien, mais ça laisse un vide.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: MAIS MON ONGLE A UN PEU REPOUSSÉ, T''AS VU ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: Ça veut dire que mes jambes repousseront aussi. Tôt ou tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: Où est-ce que je dois regarder ? Vers toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: T''as vu comme je suis crispé ? C''est une question d''habitude.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Depuis l''époque où je faisais vraiment rugir les moteurs, j''ai jamais pu entrevoir quoi que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: J''crois que j''suis pas fait pour ralentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: Ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: Bon, vas-y. HAHAHAHA… OK, d''accord.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: On y est, non ? Le summum de l''humour.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: Tu veux que je montre mes aisselles ? Et je le fais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: L''enfer fait tout cramer dehors et l''univers entier qui veut rayer la planète de la carte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: Les Visiteurs ? Ils veulent tout réduire en cendres.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: Et toi, t''es là : « Fais-moi voir tes aisselles ! »'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: HAHAHAHAHA !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: Une photo ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: Ce n''est pas vraiment mon truc, mais bon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: Mince, j''ai cligné des yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: HAHAHAHA ! Okaaay !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: Toi aussi t''es tombé sur cette émission, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Ouais, ouais. Quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: Attends, t''es sérieux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: Putain… c''est bien tordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: Allez, je touche plus à ta bière, promis. Fais pas la tronche.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: Tu sais comment on punit les grincheux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: On leur roule dessus avec des poussettes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: Alors si t''es en colère, pousse-moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: Pourquoi tu fais ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: Ça va rien changer pour moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: Et sûrement pas pour toi non plus. Alors, pourquoi tu sors ton flingue ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: Je verrai sans doute pas la balle arriver. Mais je peux toujours essayer de l''éviter.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: J''ai jamais compris pourquoi les gens se rasaient. Les poils, c''est la défense naturelle du corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: Tu vois cette rougeur ? Je suis en train d''y faire pousser des doigts. Des doigts de secours.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: Et c''est que le début de la rigolade ! Prépare-toi à souffrir des zygomatiques, ah ah !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: Qu''est-ce qu''on a loupé, dans cette foutue vie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: Pourquoi la photo ? Tu connais l''expression : « Une bouffée d''air ne retarde pas l''ultime souffle. »'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: J''avais… quelque chose à dire…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Est-ce que je peux partir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: On a semé le vent, fallait bien récolter la tempête.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Dieu finit toujours par rattraper chacun d''entre nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: Mais moi, je ne partirai pas sans rien faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: On n''est rien que des sacs de viande ambulants, pigé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: Avant, tout ça nous faisait marrer… et maintenant, on est prêts à s''exploser le crâne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: Je sens que je dois me préparer à crever.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: Mes mains, c''est tout ce qu''il me reste pour avancer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: Mais j''ai plus d''embrayage.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: Et franchement, l''idée de les perdre un jour… ça me glace. Et après ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: Immobilisé à jamais, coincé pour de bon…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Même la mort me fout pas autant la trouille.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: On peut retourner la situation dans tous les sens… le fait est qu''on ne rattrapera plus jamais le temps perdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: T''as remarqué ? Plus on vieillit, plus le temps passe vite.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: Quand on était gosses, on avait tout le temps du monde. C''était simple : pas de responsabilités, pas de choix cruels.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: Aujourd''hui, on court, on s''agite… et pourtant, on est toujours à la ramasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: Et tu sais quoi ? J''ai plus envie de rire, là, d''un coup.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: Tes tests absurdes, les incendies à éteindre…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Ils veulent tous jouer les sauveurs, mais ils sont pas fichus de se mettre d''accord.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: Et si, au fond, il n''y avait rien à sauver ? Et si le mieux à faire, c''était d''arrêter de lutter ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Regarde un peu autour de toi…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: T''as pas l''impression que le voyage touche à sa fin ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: C''est le terminus. On va bientôt tous descendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: On voit la dernière station juste là, par la fenêtre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: T''es prêt ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: Ouais… c''est ce que je me disais. Prends pas la mouche, va !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: Mais dis-moi… si ce signe n''est pas fiable, comment croire les autres ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: Peut-être qu''ils pointent tous dans la direction des visiteurs avec la même exactitude.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: L''erreur est humaine, après tout…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: Mais il y a des erreurs qui peuvent coûter très cher.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: Si… Si toi tu te fies à ce genre de signe, comment faire confiance aux précédents ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Peut-être que les autres aussi, c''est de la merde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: On est tous humains, évidemment. Tout le monde peut faire des erreurs, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: Et ces erreurs peuvent avoir des conséquences terribles.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Toi… Il suffit d''un seul faux pas pour que quelque chose tourne mal, et que tu mettes fin à la vie de quelqu''un.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: Si t''es sûr de ton choix, alors… J''envie ta confiance.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: Allez-y, testez-moi. J''ai rien à cacher.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Je vous en prie…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: Vous savez, je m''en occupais pas tant que ça avant. J''avais pas le temps, tout simplement. Mais maintenant… je regrette.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Là, regardez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: C''est plus des paumes, c''est des pelles. Pratique pour mater les gosses.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: Allez-y, regardez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: Vous voyez ces énormes valises ? C''est le manque de sommeil…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: Allez-y, regardez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: Ça fait un bail que je m''embête plus à mettre du déo, m''en voulez pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: Je peux m''asseoir ? Non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: Débraillée et de mauvais poil, comme toujours.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: Je sais plus quand je les ai nettoyées pour la dernière fois. Si ça se trouve, elles sont toutes bouchées.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: Je suis déjà sourde comme un pot à cause de ces mioches qui braillent tout le temps de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: J''ai les gencives qui saignent quand je me brosse les dents depuis une semaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: Et j''ai les dents encore jaunes. Mais comment ne pas fumer avec des gamins pareils ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: J''ai comme de l''eczéma à cause de tous ces produits d''entretien, mais j''ai jamais eu le temps d''aller voir un toubib.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: Ces mains… Elles auraient pu vous faire des bonnes soupes… Au lieu de ça, vous prenez votre flingue…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Même si vous dégoupillez une grenade, je pourrais pas passer une bonne nuit de sommeil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: Vous voulez me tirer dessus à cause de l''odeur ? Vous êtes une belle pourriture…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: Quoi ? Vous me jugez à cause de la photo ? Vous êtes une belle pourriture…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: Vous êtes un gros malade si vous voulez me buter à cause de mes oreilles… Je vais enfiler un foulard par-dessus !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: C''est pas trop tôt… Dire que plus personne ne va me casser les pieds…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: Quelle horreur…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: Un de mes gosses a des dents parfaites. Il n''a jamais souri une seule fois. Ça a peut-être rien à voir avec les dents.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Mes mains… Elles ont servi à câliner les petits, faire le ménage et caresser mon mari. Et personne n''a jamais rien aimé.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: Quand votre enfant est malade, vous restez des jours sans dormir. Et on finit par s''habituer et vivre dans le cauchemar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: Une fois, j''étais si crevée que je ne me suis pas douchée pendant une semaine. Les gosses ont même pas remarqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: Un jour, j''ai trouvé une photo où tous les mômes souriaient. Je l''ai regardée toute une soirée jusqu''à ce que je dorme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: Parfois, j''aimerais être sourde. Mais quand les enfants dorment, il y a ce silence paisible… C''est pour ça qu''on vit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: Sérieux ? Bordel… Bon, d''accord, mais magne-toi !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: J''en n''ai rien à battre. Tiens !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: Jaunes ? Qu''est-ce que je m''en tape…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: Blanches ? C''est pas comme si j''avais le temps de m''en occuper…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: Avant je me disais que si mes dents devenaient pourries, je devrais en avoir au moins une en or, comme un dur à cuire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: Bien sûr, si ça peut te faire plaisir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Ouah, c''est des sacrées paluches.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: Ha. Ma grand-mère disait toujours qu''avec des mains comme ça, je devrais couper du bois, et pas… faire ce que je fais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: Mais ici, pas un arbre à l''horizon. Faut bien que je cogne quelque chose d''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: Chacun son délire… Moi, ça me regarde pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: Quoi, t''aimes la couleur ? Ils sont bleus. Depuis toujours… Jamais eu besoin d''autre chose pour plaire aux gonzesses.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: Je n''en ai rien à foutre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Hé ouais, j''me rase.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: C''est insupportable, ces poils. Comme si un sale buisson voulait squatter mes aisselles.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: Vas-y.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: Qu''est-ce que tu fous ? Putain, pourquoi tu me regardes comme ça ? Qu''est-ce que tu as vu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Putain…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: Pourquoi tu me fixes comme ça ? Il manque quelque chose ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: T''es malade ou quoi ? Je viens de te montrer mes chicots.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: Tu crois vraiment que j''pourrais pas t''enfoncer le poing dans la gorge plus vite que tu tires ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: Qu''est-ce que t''es en train d''insinuer, bon sang ? Tu es jaloux ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: Ça me gratte à longueur de temps, comme pour me faire volontairement péter les plombs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: Quand je la gratte jusqu''à ce qu''elle saigne, ça va mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: J''y crois pas… T''es complètement barré !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: Tu veux me tuer à cause d''une putain de photo ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: Fais attention avec ce truc.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Tu risquerais de me tirer dessus par accident… à cause de mes oreilles.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: T''as complètement perdu la boule ! Très bien… Alors viens, connard !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: T''es qu''un putain de salaud sans le moindre scrupule.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Va te faire foutre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: Ma grand-mère avait une dent en or. J''étais tout petit quand j''ai réalisé que moi aussi j''en voulais une.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: Elle brillait… comme si le soleil était coincé dans sa bouche.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: Ma grand-mère disait qu''ils la lui avaient mise après que l''ancienne a complètement pourri.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: Ça m''a rendu heureux. Je me suis dit : « Ouah, c''est génial ! On va me faire pareil le jour venu ».'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: Et puis… Eh bien, le moment est arrivé. Mais personne ne m''a rien donné.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: Et maintenant, j''ai pas de soleil dans la bouche, juste des chicots jaune pisseux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: Tu vois ces mains ? Y a tout ce que tu veux dessus : de la crasse, du sang… Mais c''est pas volé. C''est le mien.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: Parfois, elles me démangent tellement que j''ai juste envie d''arracher toute ma peau. Ou d''exploser un mur. Ou les deux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: Je peux pas me retenir. Mais j''veux blesser personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: Tu vois ces ongles ? Pareil. Du sang, de la merde. Mais c''est à moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: Parfois, elles me démangent tellement que j''ai juste envie d''arracher toute ma peau. Ou d''exploser un mur. Ou les deux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: Un autre s''inquiéterait sûrement. Moi ? Je m''en fous royalement.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: Ma grand-mère me disait que j''étais un « chérubin » à cause de mes yeux. Un putain d''ange, ouais…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: Je suis là, à regarder ces fenêtres sur l''âme et je me dis : « Il est où l''ange, au juste ? »'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: Je revois la façon dont elle me regarderait. Déçue.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: Un rasoir, c''est assez aiguisé pour en finir, hein ? Enfin… en théorie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: J''ai juste fini par m''écorcher le bras. Maintenant, quand je me rase, c''est pas les poils que je coupe, c''est moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: Mais je me rase quand même. Parce que je déteste avoir un putain de buisson.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: J''ai même pas de photo de ma grand-mère. Elle supportait pas ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: Elle disait que lorsque tu te fais prendre en photo, un bout de ton âme reste collé à l''image et peut plus sortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: J''ai plaidé et j''ai protesté, je lui ai dit : « Allez, grand-mère, c''est n''importe quoi. »'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: Et elle a dit : « Quand je mourrai, tu regarderas ma photo et tu te demanderas si je suis au paradis. »'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: Eh bien, tant pis pour alors. Je n''ai pas de photo et pas de grand-mère.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: Parfois, je tire sur le lobe de mon oreille sans m''en rendre compte, mais juste quand il me brûle comme pas permis.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: Avant, je pensais que c''était une question de nervosité.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: Puis j''ai réalisé que j''avais juste envie d''arracher cette partie de moi… comme si elle me gênait.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: Mais je ne suis pas assez fou pour me mutiler, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: Pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Oh, mon chou… Je savais que votre énergie résisterait. Mais faisons vos tests. Je verrai quand même à travers vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Très bien, voyez par vous-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: Les yeux sont le reflet de notre cosmos intérieur, pas les dents. Vous voulez voir votre destin dans les miennes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: Les yeux sont le reflet de notre cosmos intérieur, pas les dents. Pourquoi voulez-vous les regarder ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: Allez-y, regardez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: Mais attention, les échardes du dernier attrape-rêve sont toujours là.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: Oh, mes yeux ? Ils sont noisette, bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Enfin, si vous ne comptez pas les taches rouges. C''est la lune qu''il faut blâmer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Oh… Ce que l''univers met sur mon chemin… Très bien, regardez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: Difficile de prendre soin de soi dans de telles conditions, vous savez…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: Soyez prudent. Mon aura peut être aveuglante !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: Alors ? Qu''en dites-vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Allez-y, regardez. Mais méfiez-vous, elles entendent tout, même vos pensées.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: Et alors ? Avez-vous trouvé vos réponses ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: Vous voulez me tuer à cause de mes dents ? Pourtant, je n''y suis pour rien, c''est Mars qui est aigri par Vénus !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: Vraiment ? Vous voulez me tuer à cause des échardes sur mes mains ? Si c''est le prix des attrape-rêves…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: Vous êtes fou ? Mais c''est juste la lune qui fait des siennes ! Ce n''est pas si évident de suivre son mouvement !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: Vous êtes fou ? Vous savez que c''est juste la lune qui joue des tours, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: C''est de la barbarie, pas de l''astrologie ! Baissez votre arme, je vous dirai certains de mes secrets… Gratuitement !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: Je n''y peux rien si vous n''étiez pas prêt, mon petit !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: Posez cette chose… Que sait-on en observant les oreilles ? Vous en avez besoin pour entendre les sages !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: Si vous me tuez, vous risquez…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: … la diarrhée pour l''éternité !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: Un jour, un homme aux dents parfaites est venu me voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: Je lui ai dit : « Tout va bien, mais votre âme est pourrie ! » Demandez-vous ce qui est le plus important, entendu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: J''ai déjà passé la nuit à arracher des échardes après un rituel. Ça fait mal, chaque écharde est une leçon de l''univers.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: Les yeux… ces portes vers un autre monde. Un homme avait des yeux qui brillaient d''amour selon lui. Mais c''était Mars.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: Vous savez, j''ai passé trois semaines à vivre en ascète pour ne penser qu''à mes rêves.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: Les pensées sont matérielles… Je réalise mes rêves grâce à elles. Il suffit de faire le bon souhait.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: Mon état actuel est sans doute comparable à celui de cette période.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: Une fois, on m''a prise en photo et j''ai pensé : « C''est un signe des étoiles ! » Mais c''était juste l''éclairage.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: Une fois, j''ai entendu le son de l''univers qui essayait de me parler. C''était beaucoup trop fort.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: Un jour, j''ai entendu le son de l''univers qui me parlait. En fait, c''était juste un courant d''air. J''ai quand même aimé.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: Qu''est-ce que vous voulez vérifier ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: Vous voulez que je vous montre mes dents ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: MES DENTS ONT DÉFENDU LA VÉRITÉ !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: Et c''est pour ça que j''en ai perdu…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: Et vous pouvez le constater par vous-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: Je prends soin de mes dents à l''aide d''une solution à base de bière qui protège bien l''émail.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: Sans cette solution, il y a longtemps que j''aurais perdu toutes mes dents.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: Bien sûr, c''est compréhensible…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: Il se passe tellement de choses en ce moment, et pourtant il faut vivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: Il faut bien vivre…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: Quoi ? Est-ce que vous êtes resté cloîtré trop longtemps à l''ombre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: Reposez-vous donc un peu, mon ami.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: Je n''y vois aucune restriction, mon ami !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: Regardez mes ongles autant que vous voulez…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: Je me suis entraîné à absorber la lumière du soleil avec eux !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: Et à ouvrir des capsules de bière.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: Vous vouliez juste vérifier ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: REGARDEZ BIEN MES YEUX !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: Ils sont remplis de rage et de colère.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: REGARDEZ DANS LA NOIRCEUR DE MES YEUX !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: C''est par eux que j''absorbe tous les bienfaits de la lumière et que je trrrransforme leur énergie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: Toute mon énergie passe par mes YEUX !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: POUVEZ-VOUS VOIR LA PUISSANCE DU SOLEIL DANS MES YEUX ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: Non ? Vous êtes aveugle. Essayez de regarder le soleil plus longtemps, COMME MOI.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: Une photo ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: Hm… Hm-hm-hm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: Est-ce que vous saviez que j''avais rencontré le GOUROU SOLAIRE en personne ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: Hé oui, c''est moi qui lui ai appris à regarder le soleil, mais on en reparlera plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: Allez-y. PRENEZ-MOI EN PHOTO !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (Vous prenez une photo de l''homme débraillé.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (Il est comme dans la vie… Il apparaît débraillé et sale sur la photo).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (Vous ne remarquez aucune déformation.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: TOUT S''EST MERVEILLEUSEMENT BIEN PASSÉ !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: Passez me voir, je vous raconterai mon histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: Et vous serez même prêt à me payer un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: JE DÉPENSERAIS L''ARGENT POUR ÉCONOMISER L''ÉNERGIE DU SOLEIL !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: Allez-y ! Essayez de tirer ! La vérité me protégera !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: Est-ce que vous pourriez ranger votre arme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: Eh bien, c''est pas évident sans une bière dans les mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: Vraiment pas évident.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: Humain, pourquoi diantre faites-vous ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: VOUS, LES ÊTRES NON ÉCLAIRÉS, ÊTES DEVENUS FOUS !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: Non seulement ils parlent derrière votre dos, ils vous tirent dessus aussi…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: Ah ça… Trop, c''est trop !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: Ça ne risque pas de nous aider à retrouver notre vitalité.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: Vous osez dire que mes mains ne vous plaisent pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: MAIS POURQUOI ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: Vous êtes un avare, un ignorant… et moi, je veux juste une bière.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: Asseyez-vous donc… Regarder ne mène à rien, paraît-il.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: Vous attendez de moi que je détourne le regard pour toujours ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: Une petite minute…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: C''était peut-être « debout », en fait…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: Une seconde, attendez…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: J''en ai rien à secouer. Voilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: Exactement.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: Vous n''oseriez tout de même pas tirer sur le Soleil !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: N''ayez crainte, je n''en fais pas une affaire personnelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: En vous coule une source fraîche, pleine de vie !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: Ah, vous êtes un petit rigolo, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: Allez-y, reniflez-les, si ça vous chante…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: Voilà ce que donne l''attention portée à mon corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: Ah, vous êtes un petit rigolo, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: Allez-y, reniflez-les, si ça vous chante…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: C''est l''œuvre du Soleil, tout simplement.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: L''humidité que nous exhalons, c''est notre souffle vital !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: Qu''est-ce que vous voulez vérifier ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: Vous allez prendre une décision en fonction de ma dentition ? Hé béh…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: Je viens de me faire refaire les dents.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Cependant, pour être honnête…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: … Je ne me rappelle pas vraiment être allée chez le dentiste. Est-ce que j''étais là-bas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: J''ai tellement peur que je ne me souviens même pas si j''ai mangé hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: Alors… Est-ce que je corresponds à la description ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: Moi ? Un Visiteur ? Quoi ?! COMMENT ?! Impossible !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: Arf… J''ai été expulsée de chez moi, virée de mon travail et maintenant je vais devoir m''enfuir de ma propre tête…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: Vous voulez regarder mes ongles ? C''est bizarre comme signe…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: Mais bon, d''accord… Jetez un coup d''œil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: Ce qu''il y a dessus ? Impossible que ce soit de la terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: Je… je me souviens même pas avoir touché quoi que ce soit de sale.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: Comment cette crasse est-elle arrivée là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: Impossible que je me sois promenée dans un état pareil pendant plusieurs jours. Non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: Comme c''est… bizarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: Imaginez un peu ! Je ne me souviens pas d''où vient cette saleté. J''étais simplement assise là, dans votre maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: Est-ce que… Est-ce que quelqu''un a mis la saleté sous mes ongles délibérément ? Qui aurait bien pu faire ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: Vous voulez vérifier mes yeux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: Je peux deviner le résultat.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: Que se passe-t-il si j''ai ce symptôme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: Ouais, eh ben. C''est inévitable.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: Est-ce que je suis vraiment un Visiteur ? Vous en pensez quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: Et pourquoi je n''en serais pas consciente ? Peut-être que c''est comme ça que les gens se transforment en Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: Peut-être qu''il suffit de se dire qu''on est différent des autres et qu''on est une des pires personnes de la société.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: J''ai peur de mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: Est-ce que… je pourrais avoir une sorte de bandage ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: Ou tout du moins… rester debout un peu plus longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: Si je suis vraiment un Visiteur, est-ce que je vais me mettre à tuer les gens ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: Est-ce que je vais devenir dangereuse ? Ou est-ce que je l''ai toujours été ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: Peut-être que je tue déjà des gens ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (Vous prenez une photo d''elle.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (À mesure que la photo se développe, vous voyez un corps flou sur un fond net).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (C''est comme si la personne avait tressailli au moment où la photo a été prise.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: Hahaha, vous y croyez ? Je viens de sursauter.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: Qu''est-ce qui va se passer maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: Est-ce que vous pouvez me laisser vivre ? Ou est-ce qu''il vaudrait mieux me tuer ? Vous allez faire quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: Pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: Est-ce qu''il ne vaudrait pas mieux m''abattre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: Je veux partir, mais j''ai trop peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: Peut-être…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: Je ne sais pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: Si vous me tirez dessus, est-ce que je vais me transformer en quelque chose d''encore plus terrible ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: Peut-être que je devrais m''enfuir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: Mais je ne sais pas si je suis encore humaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: Qu''est-ce que je suis censée faire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: Tout comme ces Visiteurs à la maison…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: Désolée, c''était horrible… Je vais vous montrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: Est-ce que je suis humaine ? Oui ? Dites-moi que je suis humaine, je vous en supplie !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: Pourquoi avez-vous demandé à voir si vous alliez sortir votre arme de toute façon ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: Est-ce que vous prenez du plaisir à humilier les gens ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: Quel cauchemar ! On ne peut plus se sentir en sécurité nulle part.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: Les Visiteurs risquent de faire irruption chez vous. Un fou pourrait vous tuer s''il vous trouve pas nette.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: C''est tellement angoissant ! SI SEULEMENT QUELQU''UN POUVAIT ME DIRE QUE TOUT VA BIEN SE PASSER !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: Comment est-ce que j''ai pu me transformer en Visiteur rien qu''avec ce signe ? Pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: Déjà que je suis pas gâtée par la nature…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: Mon corps est tout noueux. Je comprends pourquoi je les mettais mal à l''aise au travail.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: Je suis allée à l''hôpital la semaine dernière à cause de mon dos… je crois.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: Est-ce que… Est-ce que je suis aussi allée chez le dentiste ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: Combien ai-je dépensé… ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: Qu''est-ce que tu veux vérifier exactement ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: Tu veux que je te montre mes dents ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: D''accord, jette un coup d''œil. Mais ça pue un peu la tristesse et la fumée.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Plutôt jaunes, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: Alors va te faire foutre avec tes tests.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: J''suis pas un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: D''ailleurs, d''où est-ce qu''ils sortent ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: Les ongles sales sont un signe ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: Il leur suffit de se laver les mains !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: Selon toi, les jardiniers sont automatiquement des Visiteurs, alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: C''est du grand n''importe quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Regarde mes ongles.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: Alors ? Je suis un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: C''est bien ce que je me disais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: Chaque jour est plus dérisoire que le précédent.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: Et si j''avais mal dormi ? Ou si j''avais pleuré ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: Je pige plus du tout la logique des choses.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: Et qu''est-ce que tu comptes faire si un signe vient confirmer la chose ? Ou plusieurs signes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: Je vais me transformer en Visiteur ce soir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: Je vais me forcer à chialer en me remémorant les jours paisibles.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: Tous ces tests de signes, ces types en costume jaune…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: Tout ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: Un sacré bordel…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: T''as pas l''impression que tout ça mène à une sorte d''enfer terrifiant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Tout est censé être sous contrôle, mais c''est le chaos total autour de nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: Eh bien, vas-y. Prends ta putain de photo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (Vous prenez une photo de lui.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (Il est calmement assis, pas tout à fait dans le cadre, mais vous ne remarquez rien d''anormal).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: Je suis juste terrifié à l''idée de ce qui va se passer ensuite.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: Putain, sérieusement ? T''es débile ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: C''est la FEMA qui t''a bouffé le cerveau ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: Ou alors, t''es bourré, c''est ça ? Je croyais qu''il y avait plus une goutte d''alcool fort.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: Puisque c''est si gentiment demandé, je vais te montrer !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: T''as eu ce que tu voulais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: T''as reniflé tout ton saoul ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: Merci de pas avoir fouillé mon trou de balle !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: Faites vite.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: Quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Euh… D''accord.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: Vous avez fini ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: Est-ce que je vais enfin avoir un peu de calme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: Les mains… Une seconde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: Mes mains sont fatiguées de porter celui qu''elles ont refusé de sauver.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: Est-ce que vous pourriez arrêter de me demander de faire ce genre de conneries ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: Si vous tenez tant à m''abattre, faites-le.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: Je suis à bout de forces…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: Qu''est-ce que vous cherchez ? Des rougeurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: Allez-y…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: Si je laisse paraître une émotion, est-ce que ça veut dire que je suis un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: Est-ce qu''on peut se parler franchement maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: On n''a pas le droit d''être heureux, on n''a pas le droit de pleurer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: C''est à peine si on peut parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: Qu''est-ce qui nous reste ? S''asseoir là, la tête dans les mains ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: Vraiment ? Ça termine si facilement ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: Plus de souffrance ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: Mais je ne t''ai pas sauvé, toi mon…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: Vous trouvez pas ça humiliant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: Personne m''a aidée à sauver mon mari, et maintenant…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: VOUS VOULEZ COMMÉMORER SA MORT ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: Je suis sans voix.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: Faites comme vous voulez, mais fichez-moi la paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (Vous prenez une photo d''elle.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (Vous ne remarquez rien d''inhabituel.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (Le cadavre est aussi sur la photo, ce qui vous pousse à réfléchir sur la vie.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: Allez-vous-en.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: Il trouvait que j''avais de belles dents.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: Mais j''aurais voulu porter un appareil dentaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Mais, bien sûr ! Pourquoi ne pas me tirer dessus, après tout ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: Peut-on encore pleurer dans ce nouveau monde ? Rire, en tout cas, c''est impossible.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: Ça va pas là-dedans ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: Répondez-moi : est-ce que vous êtes fou ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: Si ces ordures vous demandaient de danser sur une poêle à frire, vous seriez le premier à le faire…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: Vous… Bon sang… J''ai pas de mots.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: Alors ? Allez-y, autant sortir votre arme…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Bon sang…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Il suffit d''appuyer sur la détente. La FEMA a déjà tué mon âme. Vous pouvez aussi bien en finir avec mon corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: Je ne pensais plus aux appareils dentaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: Jusqu''à ce que vous demandiez à voir mes dents, je ne me souvenais même pas que ça existait.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: Oh, la vache… Je suis juste crevée.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: Je m''en prends à tous ceux qui m''entourent. Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: Personne n''y est pour rien. À part certains enfoirés.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: J''ai du mal à comprendre. Et j''en ai pas envie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: Humilier quelqu''un qui vient de perdre…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: Une minute…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: Oula… Vous avez sorti votre arme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: Et vous ne m''avez pas tuée au final.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: Pourquoi ? L''insécurité ? Pas besoin de l''afficher à ce point.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: Qu''est-ce que tu veux voir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: Les dents ? Ouais, c''est possible.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: Mon pote était dentiste.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: Et devine quoi ? Ils lui ont arraché toutes les dents ! HAHAHA !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: Oh, tu veux les voir… OK.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: Pas mal, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: C''est quoi ce bordel, mec ? C''était une anecdote tout à fait normale.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: Mais me tirer dessus en pleine figure à cause de mes dents… je pige pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: S''il te plaît ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: Es-tu fou ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: Mec, va te faire…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: C''est quoi ton délire ? J''suis juste un gars normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: Je fais rien de bizarre avec mes ongles, mec ! Regarde !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: Te fais pas de fausses idées.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: Je les lave. C''est juste que j''ai vu une pièce par terre et que je l''ai ramassée.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: Ils sont propres normalement. Je vais me laver les mains aujourd''hui, mec. Détends-toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: D''habitude, je les lave, mon pote. C''est juste que j''ai pas eu le temps de m''en occuper aujourd''hui.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: J''ai les mains propres. La plupart du temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: Tu vas déglinguer un mec juste pour des ongles sales ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: Hé ben… J''aurais jamais cru mourir d''une manière aussi débile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: Ça me paraît bizarre comme façon d''identifier ces horreurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: Les abrutis et les pigeons, on les reconnaît à leurs mains. Qu''est-ce qu''ils ont à voir là-dedans, les Visiteurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: Faudrait que tu te lèves à 9 heures du mat'' et que tu travailles pendant… au moins 4 heures. Putain.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: Mes yeux me grattent depuis un p''tit moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: Tu crois que c''est à cause du soleil ? Ou autre chose peut-être ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: Merde, mon vieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: C''est une espèce de maladie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: Écoute, j''ai un plan.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: On prend l''argent des autres, histoire de pas avoir à leur tirer dessus.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: Quoi ? Faut que tu réfléchisses ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: Je peux comprendre si t''as pas envie d''écouter mes histoires… Mais j''ai vraiment une maladie des yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: Si seulement t''avais des gouttes pour les yeux…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: Hé ben, je les achèterais pas non plus. J''ai mes raisons.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: Tu veux prendre une photo ? Vas-y.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: Je suis très sensible à la lumière. Je risque de sursauter.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (Vous prenez une photo de lui.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (La photo semble normale, mais son visage…)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (La photo est vraiment floue.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: J''te l''avais dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: Tu veux en prendre une autre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: Me la fais pas à l''envers, frérot. Réveille-les un peu, que ça bosse un peu !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: Faut garder la forme !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: Sinon ils glandent, ils oublient chez qui ils squattent, et ils crachent plus rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: Attends !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: Va te faire foutre, toi et ta baraque. J''me tire d''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: J''vais aller me cramer la tronche en plein soleil. Tu vivras avec ça sur la conscience.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: Bordel de merde…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: T''as pas eu l''idée du siècle là…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: Mais c''est toi qui commandes ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: Alors, verdict ? Tout est en ordre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: Le laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: Attends ! OK, putain… L''autre jour, j''ai essayé de me raser et ça m''a plu, alors j''ai continué…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: Mais t''en parle à personne, hein ! T''es pas du genre commère de toute façon, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: Attends, calme-toi ! C''est comme si tu demandais à voir mon caleçon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: Tu sais qu''un mec civilisé peut pas avoir les aisselles cramées.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: J''savais que tu étais un gars sûr. Pas le genre à s''attaquer aux gens normaux. Héhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: Pourquoi ne pas mettre la pression sur ces crétins ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: Non ? D''accord. À plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: Je sais que tu commences à être à bout à cause des Visiteurs et du reste.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: Et toi, tu fais tout ça pour nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: Bref, sans rancune. Sincèrement.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: Qu''est-ce que tu veux regarder ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: Mes dents ? Tu veux que je te montre mes dents ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: Pourquoi ? Papa, il a dit qu''il me restait encore des dents de lait…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: J''vais arrêter de pleurer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: Eh ben, les voilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: Qu''est-ce que ça veut dire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: Tout va bien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: Je peux déjà me couper les ongles toute seule, tu sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: Mais je suis pas très forte…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Regarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: C''est joli, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: C''est moi qui les ai coupés. Toute seule. Comme une grande !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: Je vais y aller. J''ai envie d''être toute seule.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: Tu veux regarder à l''intérieur de mes yeux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: Pour savoir à quoi je pense ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: Si c''est ça, alors je vais réfléchir très très fort. Tu peux compter sur moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: Pourquoi tu fais cette tête ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: Est-ce que tu as v-v-vu…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: Tu… Oiiiiin !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: J-J-Je veux d-du lait chaud !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: Qu''est-ce que je dois faire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (Vous la regardez et vous réalisez qu''elle joue la comédie.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: Tu veux juste savoir comment je vais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: Je suis super fatiguée… Est-ce que je peux rester toute seule ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: Une photo ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: On m''a vraiment prise en photo souvent, tu sais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: Tu me montreras après ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (Vous prenez une photo d''elle.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (La photo est un peu floue.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (Elle s''est précipitée vers vous sans attendre que vous ayez fini de prendre la photo).'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Hmmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: J''aime pas trop, tu sais. Arrête de me prendre en photo, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: Héhé… Eh bien, vas-y, regarde, mon petiot. Tu verras rien que t''as jamais vu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: Mes dents ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: Aaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: Ces dents-là, j''les ai longtemps maudites. J''me disais qu''il fallait toutes les arracher, comme des mauvaises herbes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Regarde mes doigts… Ils savent plus compter, plus empiler, ni même mesurer comme du monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: Ils t''donnent juste c''qu''il faut. Juste assez pour pas qu''tu crèves, mais jamais assez pour filer loin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Oh la la… T''as vraiment envie d''voir ça, mon poussin ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: Les yeux, c''est comme des fenêtres. Ça laisse passer la lumière dans les maisons, pis la vérité chez les gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: Mais les miens… y sont pleins d''poussière… La vitre fendue… Les mites ont rongé les rideaux depuis longtemps…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: Regarde pas trop, va. Tu trouveras que du vide.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: Fi donc ! Faire lever les bras à une vieille… T''as pas honte ? J''tiens à peine sur mes guibolles !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Mais bon, c''est l''maître de maison qui décide, hein.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: Alors ? Ça t''plaît ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: Gaspiller ta pellicule pour ma bobine ? Ça pousse pas sur les arbres, pourtant… T''insistes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: Tu m''en vois toute chose ! Alors, mon p''tit sucre, j''te plais comme ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: Hah ! T''as de drôles d''idées, toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: Elles marchent comme avant, mes oreilles. Rien d''sorcier. Mais parfois, c''est comme si j''me sentais… ailleurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: J''suis comme un reflet dans une lucarne… J''suis là quand le soleil veut bien… sinon, envolée la mémé.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: Hé, qu''est-ce que tu fais avec ton bidule ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: Y a rien de moins inoffensif qu''une mémé édentée, tu sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: Tu crois que j''ai peur ? Que je m''accroche encore à tout ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Mes doigts, eux, savent depuis longtemps que tout m''glisse entre les mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: Alors c''est comme ça que ça finit…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: Tu m''crois pas ? T''veux en avoir le cœur net ? Ben tiens, regarde…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: Autrefois, j''plantais mon regard dans celui des autres. Maintenant, j''me rappelle juste l''écho qu''ça laissait.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: Eh ben, mon chou, c''est la marque des vieux jours, ça. Tous les vieux reçoivent un p''tit cadeau comme ça, tu sais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: Les champignons, ils connaissent ni douleur ni faim. Ils existent par habitude, c''est tout… Comme moi, héhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: Oh, t''va pas encore t''énerver pour si peu, hein !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: Hein ? Tu penses pouvoir lire l''avenir dans mes esgourdes, maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: Oh, tu sais, ça me dérange pas. J''suis prête, mon p''tit… Ça fait longtemps que j''attends de rencontrer le Bon Dieu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: C''est juste que…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: J''avais payé un docteur pour qu''il me les arrache toutes, mais il pouvait pas tout faire d''un coup.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: Il m''a arraché une dent, et une autre… Mais il a pas pu tout enlever. Les docteurs, ils ont plus le temps pour ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: Du coup, tu vois, j''traîne cette affaire pas finie dans la bouche, comme un caillou dans ma godasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: Les mains, c''est fait pour être tenu. Moi, ça fait belle lurette qu''on m''a pas donné la main…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: Tu veux que j''tende les miennes ? Ben, tends les tiennes d''abord, vas-y.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: « Monte sur le dos du vent, laisse-toi porter… » jusqu''à mon chez-moi, mon lapin. Allez, entre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: Tu penses que t''échapperas à ça ? Faut mourir jeune, mon chéri, y a pas d''autre issue. Fais gaffe à ta pomme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: T''as un si joli minois… Ce serait du gâchis d''abîmer ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: De mon temps, seuls les riches avaient des engins comme ça. Maintenant, n''importe quel bricolo en a un.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: J''ai rien à te dire. Tu racontes n''importe quoi. Tu déranges des gens bien pour que dalle…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: Mais n''embêtez pas ma sœur.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: On a toujours eu de bonnes dents dans la famille.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: Quand j''étais ado, j''ai voulu décapsuler une bière avec mes dents…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: Cela s''est mal terminé. Depuis, je prends soin de mes dents.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: Ma sœur ne peut rien faire par elle-même en ce moment. Je suis la seule à trimer avec mes mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: Et à quoi devraient ressembler des mains humaines qui ont la responsabilité de deux vies à la fois ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: Elle pleure beaucoup, ma frangine. On a presque les mêmes yeux. Mais dans les siens, il y a comme une lassitude…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: Ça m''inquiète, si vous saviez…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: Elle pleure beaucoup, ma frangine. On a presque les mêmes yeux… Ce que je veux dire, c''est qu''ils sont pas rouges…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: Peut-être qu''elle a déjà pleuré toutes les larmes de son corps…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: Je vais vous montrer. Mais laissez ma sœur tranquille, d''accord ? Elle est trop fatiguée pour ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: En général, je me rase. J''essaie de prendre soin de moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: Même dans cette époque de fous.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: J''ai l''habitude de prendre soin de moi, mais je n''ai pas pris de rasoir avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: De toute façon, j''ai pas vraiment le temps de m''occuper de ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: Ma sœur et moi, on a assez souffert comme ça dans notre vie. Rangez cette arme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: Je me suis mise à fumer il y a peu. À cause de gens comme vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: Vous croyez être le seul à avoir la vie dure ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: Vous croyez que vous pouvez pointer une arme sur qui bon vous semble ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: Où voulez-vous en venir ? Mon regard est-il trop rapide, trop vide, pour vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: À quoi ça rime ? Est-ce que mon regard a l''air trop vide ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: Vous vous croyez différent ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: Calmez-vous… Ne prenez pas de décisions sous le coup de l''émotion. C''est ce que je dis tout le temps à ma sœur.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: Dommage que je doive vous le dire, à vous aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: Euh… Est-ce que les médias ont vraiment dit que les aisselles imberbes sont une caractéristique des Visiteurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: Réfléchissez un peu mieux. Arrêtez de faire l''imbécile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: Alors, c''est comme ça que se termine la ballade qu''est ma vie…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: Avec amertume…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: La vie a toujours mis nos forces à l''épreuve. Tout a toujours été tellement dur.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: Ma sœur n''en pouvait plus. Elle a abandonné.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: Maintenant, je comprends. Vous vous retrouvez dans une situation peu enviable.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: Mais si vous cédez à la panique, en quoi serez-vous différent des Visiteurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: Que va-t-il se passer si vous restez isolé des autres ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: Vous savez quoi ? J''en ai ma claque de tout ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: J''ai juste terriblement envie de souffler un peu et d''arrêter d''avoir peur en permanence.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: Mais c''est du pareil au même, et on en voit pas la fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: À vrai dire, je suis moi-même terrifiée.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: Et après, quoi ? Est-ce que les Visiteurs vont disparaître ? Allons-nous partager nos villes avec eux pour toujours ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: Finissez-en…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: Dents
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: Mains
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: Yeux
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: Aisselles
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: Oreilles
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: Allez-y, regardez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: Vous voulez les arracher ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: Ma sœur m''aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: Mais c''est peine perdue.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: Elle aurait dû…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: Elle aurait dû me laisser crever il y a déjà bien longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: Ma sœur et moi, on a les mêmes yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: Mais les siens ne sont pas vides.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: Ma sœur me rase les aisselles. Elle prend soin de moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: On dirait que c''était pas complètement inutile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: Tant mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: Prenez mon âme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: C''est pas la peine.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: La mort est toute proche de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: Laissez-moi m''en charger.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: Donnez-moi votre arme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: Je vais le faire moi-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: Le vide ne disparaîtra pas une fois que j''aurais fermé les yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: Il deviendra le vôtre, tout simplement.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: Vous aimez l''idée ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: Alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: Vous allez appuyer sur la gâchette ou bien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: Écouter
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: Vous n''avez pas les tripes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: Vous allez mourir, de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: Dommage.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: Peut-être la prochaine fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: Dommage.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: J''ai aucun signe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: Peut-être la prochaine fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: Et si on se préparait juste à ce qu''un trou noir nous engloutisse ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: L''horizon des événements va nous submerger pendant un bon moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: Et on ne verra jamais notre propre fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: L''agonie éternelle et l''anticipation de la mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: Peu importe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: J''attendrai mon heure, dans ce cas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: Ma chanson…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: Mais elle vous était destinée !'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: Elle finissait bien !'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733824
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733825
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733826
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733827
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733828
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733829
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733830
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733831
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733832
    m_Localized: 'Mother: …'
    m_Metadata:
