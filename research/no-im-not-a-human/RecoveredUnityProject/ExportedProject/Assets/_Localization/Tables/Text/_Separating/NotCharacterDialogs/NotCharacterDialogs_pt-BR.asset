%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NotCharacterDialogs_pt-BR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: e5ff4525f54b4b14096a51f9eb9cf8ce, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21953783779328
    m_Localized: 'TV: Notícia de última hora!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556544
    m_Localized: 'TV: Hoje, às 6h28 da manhã, houve uma poderosa emissão de energia solar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556545
    m_Localized: 'TV: Essa erupção de energia superou os níveis previstos pelos cientistas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556546
    m_Localized: 'TV: Como resultado, a temperatura externa atingiu níveis alarmantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556547
    m_Localized: 'TV: Desde então, o governo declarou que estamos em estado de emergência.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556548
    m_Localized: 'TV: Apelamos e reforçamos para que vocês, telespectadores, evitem sair de casa durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556549
    m_Localized: 'TV: E agora, com...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556550
    m_Localized: 'TV: Só um instante...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556551
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556552
    m_Localized: 'TV: Acabamos de receber um relato urgente sobre o contato com um fenômeno que estamos chamando de "Visitantes".'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556553
    m_Localized: 'TV: As testemunhas os descrevem como criaturas capazes de imitar a aparência e o comportamento de um ser humano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556554
    m_Localized: 'TV: Evite o contato a qualquer custo. Em uma das ocorrências, um Visitante foi identificado com um sinal evidente...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556555
    m_Localized: 'TV: Dentes brancos e perfeitos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556556
    m_Localized: 'TV: Os relatos anteriores reforçam essa afirmação.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556557
    m_Localized: 'TV: As fontes indicam um encontro com uma pessoa desabrigada de dentes brancos e perfeitos, que mais tarde se revelou ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556558
    m_Localized: 'TV: Por enquanto, isso é tudo. Mantenham a calma e evitem sair de casa durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556559
    m_Localized: 'TV: A seguir, um programa de entretenimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556560
    m_Localized: 'TV: Boa tarde. Confira agora a previsão do tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556561
    m_Localized: 'TV: Uma onda de calor está se aproximando da nossa região, trazendo temperaturas que batem o recorde anterior.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556562
    m_Localized: 'TV: Os meteorologistas alertam para temperaturas ainda mais altas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556563
    m_Localized: 'TV: Com o aumento da atividade solar, também se espera um crescimento na radiação ultravioleta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556564
    m_Localized: 'TV: Para sua segurança, evite tomar sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556565
    m_Localized: 'TV: As altas temperaturas podem causar insolação.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556566
    m_Localized: 'TV: Ainda não se sabe ao certo se a exposição solar traz riscos diretos à saúde...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556567
    m_Localized: 'TV: Mas, para evitar queimaduras de terceiro grau, não saia de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556568
    m_Localized: 'TV: Infelizmente, protetor solar não tem efeito nesse cenário.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556569
    m_Localized: 'TV: Isso é tudo por enquanto. A seguir, um programa de entretenimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556570
    m_Localized: 'TV: Você vê bailarinas dançando com leveza, cruzando o palco com saltos fortes e delicados.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556571
    m_Localized: 'TV: Apesar da elegância, a dança desperta pensamentos inquietantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556572
    m_Localized: 'TV: Parece que tentam distrair você dos acontecimentos reais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556573
    m_Localized: 'TV: Se ao menos alguém pudesse explicar o que está acontecendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556574
    m_Localized: 'TV: Boa tarde. Aqui estão as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556575
    m_Localized: 'TV: A atividade solar não está diminuindo, e os índices de criminalidade subiram ligeiramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556576
    m_Localized: 'TV: De acordo com os dados mais recentes, o número de homicídios nas últimas noites superou a média.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556577
    m_Localized: 'TV: Os especialistas acreditam que isso tem relação com os Visitantes e com a ansiedade crescente na população.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556578
    m_Localized: 'TV: Agora, uma nova informação. Testemunhas relatam mais um sinal revelador de Visitantes:'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556579
    m_Localized: 'TV: Sujeira nas unhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556580
    m_Localized: 'TV: Segundo especialistas, esse sinal está associado a Visitantes que emergiram do subsolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556581
    m_Localized: 'TV: Por enquanto, isso é tudo. Mantenham a calma e evitem sair de casa durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556582
    m_Localized: 'TV: A seguir, um relatório sobre um maníaco pálido. Mas antes, um intervalo comercial.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556583
    m_Localized: 'TV: Comprar mantimentos costumava significar sair de casa e ir à loja.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556584
    m_Localized: 'TV: Mas agora, você pode pedir tudo com apenas uma ligação.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556585
    m_Localized: 'TV: Use o serviço de entregas For Rest. Ligue para XXX-XXX-XXXX e receba suas compras em até um dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556586
    m_Localized: 'TV: For Rest: relaxamento e sabor no conforto do seu lar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556587
    m_Localized: 'TV: Um maníaco pálido foi visto nas ruas da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556588
    m_Localized: 'TV: Segundo testemunhas, todas as vítimas estavam sozinhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556589
    m_Localized: 'TV: Além disso, o maníaco conversa com a vítima antes de matá-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556590
    m_Localized: 'TV: Com base nos relatos, a polícia criou um retrato falado do suspeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556591
    m_Localized: 'TV: Ele é um homem muito pálido, de meia-idade, cabelos pretos, magro, vestindo apenas calças.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556592
    m_Localized: 'TV: Algumas pessoas afirmaram que ele usa a pele de outra pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556593
    m_Localized: 'TV: Essa informação ainda não foi confirmada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556594
    m_Localized: 'TV: Se você vir esse homem, não abra a porta e diga que não está sozinho em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556595
    m_Localized: 'TV: Isso é tudo por enquanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556596
    m_Localized: 'TV: Boa tarde. Aqui estão as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556597
    m_Localized: 'TV: O calor anômalo continua subindo, e a invasão dos Visitantes ainda não cessou.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750848
    m_Localized: 'TV: O governo criou um órgão especial para lidar com essa nova realidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750849
    m_Localized: 'TV: A Agência Federal de Gerenciamento de Emergências, a FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750850
    m_Localized: 'TV: Funcionários da FEMA vestem trajes HAZMAT amarelos e usam máscaras de gás.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750851
    m_Localized: 'TV: Embora tenham começado a operar há pouco tempo, já identificaram mais um sinal de Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750852
    m_Localized: 'TV: Olhos vermelhos como sangue.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750853
    m_Localized: 'TV: Segundo dados oficiais, a FEMA observou esse sinal em Visitantes detidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750854
    m_Localized: 'TV: As criaturas apresentam fotossensibilidade elevada, causando inflamação e vermelhidão nos olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750855
    m_Localized: 'TV: Por enquanto, isso é tudo. Mantenham a calma e evitem sair de casa durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750856
    m_Localized: 'TV: A seguir, um especial sobre a FEMA. Mas antes, um rápido intervalo comercial.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750857
    m_Localized: 'TV: Caos, terror e sofrimento. E tudo por causa dos Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750858
    m_Localized: 'TV: Mas, no momento de maior desespero, quando nossas lágrimas já corriam como rios...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750859
    m_Localized: 'TV: OS AGENTES DA FEMA CHEGARAM PARA NOS SALVAR!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750860
    m_Localized: 'TV: Esses heróis da Agência Federal de Gerenciamento de Emergências estão protegendo nossas casas da invasão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750861
    m_Localized: 'TV: Até agora, a agência identificou mais de 27.000 criaturas perigosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750862
    m_Localized: 'TV: Lembre-se: você também pode ajudar informando qualquer atividade suspeita à FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750863
    m_Localized: 'TV: Para isso, use seu convite de comparecimento à FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750864
    m_Localized: 'TV: Se tiver dúvidas sobre alguém ser ou não um Visitante, ligue para a nossa linha direta: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750865
    m_Localized: 'TV: Ao ajudar a FEMA, você fortalece a luta contra os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750866
    m_Localized: 'TV: FEMA: o que é? E por que foi criada?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750867
    m_Localized: 'TV: A Agência Federal de Gerenciamento de Emergências é um órgão criado para conter a crise atual.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750868
    m_Localized: 'TV: Eles estão ajudando a lidar com os problemas causados pela chegada dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750869
    m_Localized: 'TV: Ainda não se sabe ao certo com o que a agência está lidando...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750870
    m_Localized: 'TV: Mas podemos afirmar com confiança que estamos em boas mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750871
    m_Localized: 'TV: A FEMA conta com especialistas de várias áreas, incluindo cientistas renomados.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750872
    m_Localized: 'TV: Se um agente da FEMA bater à sua porta, recomendamos que coopere e siga as instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750873
    m_Localized: 'TV: Lembre-se: ao ajudar a FEMA, você está ajudando a proteger o país.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750874
    m_Localized: 'TV: Boa tarde. Aqui estão as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750875
    m_Localized: 'TV: A FEMA adotou novas medidas para conter a ameaça dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750876
    m_Localized: 'TV: Foram criadas zonas de quarentena para pessoas potencialmente perigosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750877
    m_Localized: 'TV: A FEMA também identificou mais um sinal revelador após estudos em detentos...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750878
    m_Localized: 'TV: Axilas sem pelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750879
    m_Localized: 'TV: A agência afirma que os Visitantes não possuem pelos nessa região.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750880
    m_Localized: 'TV: A FEMA pede que a população colabore com os testes e com os agentes de escolta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750881
    m_Localized: 'TV: Por enquanto, isso é tudo. Mantenham a calma e evitem sair de casa durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750882
    m_Localized: 'TV: A seguir, uma reportagem sobre o que você pode fazer se encontrar um Visitante'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750883
    m_Localized: 'TV: A FEMA suspeita que o fenômeno dos Visitantes seja uma infecção ou uma ameaça biológica ainda desconhecida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750884
    m_Localized: 'TV: Por conta disso, é de suma importância isolar e relatar qualquer pessoa que possa ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750885
    m_Localized: 'TV: Se não for possível encaminhar um visitante para uma zona de quarentena imediatamente, emita um requerimento especial para que ele se dirija até a FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750886
    m_Localized: 'TV: Durante a próxima rodada de coleta, um funcionário levará todos os que estejam em posse deste documento para análise.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750887
    m_Localized: 'TV: Isso é tudo por enquanto. A seguir, um intervalo comercial.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750888
    m_Localized: 'TV: O calor não vai te parar, sinta a energia!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750889
    m_Localized: 'TV: Com EnerJeka, você está vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750890
    m_Localized: 'TV: Caracoles! Uma bebida revigorante que dá uma moral pra tua sede e é melhor que água mineral?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750891
    m_Localized: 'TV:Já disponível pelo serviço de entrega For Rest. Ligue e faça o seu pedido: XXX-XXX-XXXX'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750892
    m_Localized: 'Window: A casa do vizinho permanece solitária no meio do campo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750893
    m_Localized: 'Window: As luzes não estão acesas. Parece que a família dele está dormindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750894
    m_Localized: 'Window: Um cachorro esquelético está parado no meio da trilha que cruza o campo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750895
    m_Localized: 'Window: O olhar dele é melancólico, talvez esteja procurando por um pouco de comida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750896
    m_Localized: 'Window: Alguns bêbados estão largados pela rua.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750897
    m_Localized: 'Window: Eles estão deitados no chão duro e frio, parecem estar dormindo. Nesse momento, as coisas estão bem para eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750898
    m_Localized: 'Window: Lá ao longe está a casa do vizinho que veio te visitar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750899
    m_Localized: 'Window: A luz atravessa as janelas, e parece que a família dele está esperando ele voltar para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750900
    m_Localized: 'Window: Você vê alguns adolescentes no quintal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750901
    m_Localized: 'Window: Eles estão ali com a menor preocupação do mundo, conversando sobre alguma coisa. Eles não notam a sua presença.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750902
    m_Localized: 'Window: Lá fora, reina um silêncio assustador.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750903
    m_Localized: 'Window: Não tem ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750904
    m_Localized: 'Window: Até os pinguços ficaram em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750905
    m_Localized: 'Window: Será que eles estão com medo de alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750906
    m_Localized: 'Window: Você vê o vizinho e a filha pela janela.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750907
    m_Localized: 'Window: Eles estão alegres, brincando, tentando esquecer os horrores que estão acontecendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750908
    m_Localized: 'Window: Mesmo que seja só por um momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750909
    m_Localized: 'Window: Os corpos dos adolescentes estão jogados no chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750910
    m_Localized: 'Window: Alguém os matou.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750911
    m_Localized: 'Window: Parece ser recente. O sangue ainda não secou.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750912
    m_Localized: 'Window: Um homem pálido como a morte está parado na trilha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750913
    m_Localized: 'Window: Tem umas dobras estranhas na pele dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750914
    m_Localized: 'Window: É como se o tamanho da pele dele não combinasse com o tamanho do próprio corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750915
    m_Localized: 'Window: Você não consegue ver os olhos dele daqui, mas sente o olhar atravessando você.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750916
    m_Localized: 'Window: De repente, uma sensação de medo genuíno percorre seu corpo e você reza para que o Visitante amedrontador não bata na sua porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750917
    m_Localized: 'Window: Um pequeno grupo de agentes da FEMA está parado ao lado da casa do vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750918
    m_Localized: 'Window: Você se pergunta sobre o que estão conversando.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750919
    m_Localized: 'Window: Talvez estejam coletando amostras do solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750920
    m_Localized: 'Window: Ou procurando algum lugar para montar uma base?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750921
    m_Localized: 'Window: As carcaças carbonizadas dos adolescentes ainda estão no chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750922
    m_Localized: 'Window: Parece que estão ali desde cedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750923
    m_Localized: 'Window: Dois agentes da FEMA estão perto dos corpos, anotando alguma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750924
    m_Localized: 'Window: Ainda bem que vieram tirar os corpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750925
    m_Localized: 'Window: Só de pensar nas doenças que poderiam surgir se os cadáveres fossem deixados ali, apodrecendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750926
    m_Localized: 'Window: Você vê um grupo de soldados armados pela janela.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750927
    m_Localized: 'Window: Parece ser uma equipe enviada da cidade pra proteger os funcionários da FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750928
    m_Localized: 'Window: Você escuta alguns pedaços da conversa, sobre um homem pálido que não usa camisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750929
    m_Localized: 'Window: Talvez estejam tentando rastrear aquele Visitante bizarro?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750930
    m_Localized: 'Window: A casa do vizinho, que ele tinha acabado de pintar de branco, queimou por completo e agora está preta feito carvão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750931
    m_Localized: 'Window: Parece que o fogo apagou há pouco tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750932
    m_Localized: 'Window: Será que alguém colocou fogo de propósito?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750933
    m_Localized: 'Window: O que aconteceu com a família do vizinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750934
    m_Localized: 'Window: Será que alguém sobreviveu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750935
    m_Localized: 'Window: Pensamentos confusos tomam conta da sua cabeça e você se sente perdido, impotente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750936
    m_Localized: 'Window: O homem pálido e assustador está parado na rua, sorrindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750937
    m_Localized: 'Window: Ele segura a cabeça decapitada de alguém, ainda de capacete.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750938
    m_Localized: 'Window: É a cabeça de um soldado, com o rosto congelado em uma expressão de puro terror.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750939
    m_Localized: 'Window: Você não sabe dizer o que o apavorou mais... o Visitante pálido ou a morte iminente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750940
    m_Localized: 'Window: Toda a equipe de soldados que estava aqui ontem agora está morta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750941
    m_Localized: 'Window: Parece que houve um massacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750942
    m_Localized: 'Window: Os corpos estão espalhados pela rua, e um deles está com a cabeça decepada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750943
    m_Localized: 'Window: Será que aquele estranho pálido e alto matou eles?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750944
    m_Localized: '"Oi, aqui é do despacho de serviços de emergência. Como posso ajudar você?" "Pessoas... queimando."'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750945
    m_Localized: '"Você consegue descrever o que está vendo? Há fogo no local?" "N-não, é o sol. Eles... eles estão queimando no sol."'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750946
    m_Localized: '"Não saia de casa até o anoitecer." "Não, aquele cara assombra as ruas durante a noite. O pálido... ele... não é humano."'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750947
    m_Localized: 'E agora, para o nosso novo programa: "Sim, Eu Sou Humano."'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750948
    m_Localized: 'É simples: você manda suas fotos, e a gente verifica o que você realmente é.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750949
    m_Localized: 'É só enviar as suas fotos para o nosso email: yesiamhuman@gmail.com e nós tomamos de conta do resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750950
    m_Localized: Mas, por favor, envie só olhos, dentes e unhas. Qualquer outra coisa será descartada.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750951
    m_Localized: Seus olhos ficaram vermelhos? Seus dentes estão brancos demais? Apareceu sujeira debaixo das unhas?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750952
    m_Localized: Um espírito maligno entrou no seu corpo. Você é um Visitante!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750953
    m_Localized: 'Não deixe essa maldição tomar conta do seu corpo! Ligue para os nossos especialistas imediatamente: 777-460.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750954
    m_Localized: Eles limpam espírito ruim, mal olhado, frieira, calo no pé e ainda te dão uma proteção aprimorada.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750955
    m_Localized: Boas vindas. Estamos no ar com o "Linha Direta", programa que investiga mistérios e conspirações ligadas ao governo.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750956
    m_Localized: Hoje estaremos debatendo a verdade sobre os Visitantes com um convidado especial, alguém que possui um doutorado em ciências e colaborador de destaque na...
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750957
    m_Localized: Espera, como é?! Ele não vai conseguir vir?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750958
    m_Localized: Como é que roubaram TODOS os documentos dele? Tinha MUITA informação ali!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750959
    m_Localized: Droga. Eu sabia que não iam deixar a gente contar a verdade. Filhos da pu...
    m_Metadata:
      m_Items: []
  - m_Id: 17738415503822848
    m_Localized: 'TV: Era uma vez dois irmãos que viviam perto de uma represa.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182976
    m_Localized: 'TV: Os respingos diários de água faziam o rio espumar como uma bebida gelada em um dia de verão...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182977
    m_Localized: 'TV: Mais tarde, com a imagem de suas infâncias em mente, os dois irmãos fundaram a Cervejaria Bober.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182978
    m_Localized: 'TV: A cerveja Bober Černý tornou-se uma das bebidas alcoólicas mais procuradas nas lojas e nos bares.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182979
    m_Localized: 'TV: Cerveja Bober Černý: Beba o que é bom. Beba em exagero.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182980
    m_Localized: 'Window: Você está olhando para as ruínas da casa do seu vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182981
    m_Localized: 'Window: Não resta nada além de uma carcaça fantasmagórica. Apesar de que até pouco tempo atrás, uma família feliz vivia ali.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182982
    m_Localized: 'Window: Uma sensação estranha toma conta de você, como se soubesse que isso ia acontecer...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182983
    m_Localized: 'Window: É como se a morte estivesse prestes a pairar naquela residência em um futuro próximo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182984
    m_Localized: 'Window: Você vê uma caveira humana ainda de capacete, servindo de enfeite para uma estaca fincada no chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182985
    m_Localized: 'Window: A pele foi carbonizada até ficar preta e parece que alguém já lucrou com os dentes do cadáver.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182986
    m_Localized: 'Window: A cabeça deve ter ficado aí fora o dia inteiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182987
    m_Localized: 'Window: O pensamento de que esse "show de horrores" é uma ameaça não larga você. Deve ter sido coisa daquele Visitante pálido e bizarro.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182988
    m_Localized: 'Window: Os funcionários da FEMA estão inspecionando o local do massacre recente.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182989
    m_Localized: 'Window: Os equipamentos e as armas dos soldados mortos estão sendo recolhidos para que fiquem longe das mãos dos saqueadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182990
    m_Localized: 'Window: É possível que eles não esperavam que o Visitante pálido fosse sobreviver contra um grupo de soldados armados.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182991
    m_Localized: 'Window: Agora, mais alguns sacos de cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576140324864
    m_Localized: 'TV: Boa tarde. Confira agora a previsão do tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102080
    m_Localized: 'TV: Uma onda de calor está se aproximando da nossa região, trazendo temperaturas que batem o recorde anterior.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102081
    m_Localized: 'TV: Os meteorologistas alertam para temperaturas ainda mais altas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102082
    m_Localized: 'TV: Com o aumento da atividade solar, também se espera um crescimento na radiação ultravioleta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102083
    m_Localized: 'TV: Para sua segurança, evite tomar sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102084
    m_Localized: 'TV: As altas temperaturas podem causar insolação.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102085
    m_Localized: 'TV: Ainda não se sabe ao certo se a exposição solar traz riscos diretos à saúde...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102086
    m_Localized: 'TV: Mas, para evitar queimaduras de terceiro grau, não saia de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102087
    m_Localized: 'TV: Infelizmente, protetor solar não tem efeito nesse cenário.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102089
    m_Localized: 'TV: Você vê bailarinas dançando com leveza, cruzando o palco com saltos fortes e delicados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102090
    m_Localized: 'TV: Apesar da elegância, a dança desperta pensamentos inquietantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102091
    m_Localized: 'TV: Parece que tentam distrair você dos acontecimentos reais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102092
    m_Localized: 'TV: Se ao menos alguém pudesse explicar o que está acontecendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102093
    m_Localized: 'TV: Comprar mantimentos costumava significar sair de casa e ir à loja.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102094
    m_Localized: 'TV: Mas agora, você pode pedir tudo com apenas uma ligação.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102095
    m_Localized: 'TV: Use o serviço de entregas For Rest. Ligue para {0} e sua comida chegará na próxima noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102096
    m_Localized: 'TV: For Rest: relaxamento e sabor no conforto do seu lar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102097
    m_Localized: 'TV: Um maníaco pálido foi visto nas ruas da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102098
    m_Localized: 'TV: Segundo testemunhas, todas as vítimas estavam sozinhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102099
    m_Localized: 'TV: Além disso, o maníaco conversa com a vítima antes de matá-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102100
    m_Localized: 'TV: Com base nos relatos, a polícia criou um retrato falado do suspeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102101
    m_Localized: 'TV: Ele é um homem muito pálido, de meia-idade, cabelos pretos, magro, vestindo apenas calças.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102102
    m_Localized: 'TV: Algumas pessoas afirmaram que ele usa a pele de outra pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102103
    m_Localized: 'TV: Essa informação ainda não foi confirmada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102104
    m_Localized: 'TV: Se você vir esse homem, não abra a porta e diga que não está sozinho em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102106
    m_Localized: 'TV: Caos, terror e sofrimento. E por trás disso tudo... os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102107
    m_Localized: 'TV: Mas, no momento de maior desespero, quando nossas lágrimas já corriam como os rios...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102108
    m_Localized: 'TV: OS AGENTES DA FEMA CHEGARAM PARA NOS SALVAR!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102109
    m_Localized: 'TV: Esses heróis da FEMA estão protegendo nossas casas da invasão.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102110
    m_Localized: 'TV: Até agora, a agência identificou mais de 27.000 criaturas perigosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102111
    m_Localized: 'TV: Lembre-se: você também pode ajudar, informando qualquer atividade suspeita à FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102112
    m_Localized: 'TV: Para isso, use seu convite de comparecimento à FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102113
    m_Localized: 'TV: Se tiver dúvidas sobre alguém ser ou não um Visitante, ligue para a linha direta: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102114
    m_Localized: 'TV: Ao ajudar a FEMA, você ajuda a proteger o mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102115
    m_Localized: 'TV: FEMA: o que é? E por que foi criada?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102116
    m_Localized: 'TV: A Agência Federal de Manejo de Emergências é um órgão criado para conter a crise atual.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102117
    m_Localized: 'TV: Eles ajudam a lidar com os problemas causados pela chegada dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102118
    m_Localized: 'TV: Ainda não se sabe ao certo com o que a agência está lidando...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102119
    m_Localized: 'TV: Mas podemos afirmar com confiança que estamos em boas mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102120
    m_Localized: 'TV: A FEMA conta com especialistas de várias áreas, incluindo cientistas renomados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102121
    m_Localized: 'TV: Se um agente da FEMA bater à sua porta, recomendamos que coopere e siga as instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102122
    m_Localized: 'TV: Lembre-se: ao ajudar a FEMA, você está ajudando a proteger o país.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102123
    m_Localized: 'TV: A FEMA acredita que o fenômeno dos Visitantes é contagioso ou biológico.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102124
    m_Localized: 'TV: Por isso, é fundamental relatar qualquer suspeita e isolar os indivíduos em questão.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102125
    m_Localized: 'TV: Se não puder encaminhar o suspeito diretamente a uma zona de quarentena, entregue um pedido especial de comparecimento à FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102126
    m_Localized: 'TV: Na próxima triagem, o agente levará todos que estiverem com esse papel para análise.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102128
    m_Localized: 'TV: O calor não vai te parar, sinta a energia!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102129
    m_Localized: 'TV: Com EnerJeka, você está vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102130
    m_Localized: 'TV: Uma bebida energética refrescante que mata a sede mais rápido e melhor do que a água.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102131
    m_Localized: 'TV: Agora disponível com na entrega For Rest. Peça já pelo número: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296387
    m_Localized: 'TV: Era uma vez dois irmãos que viviam perto de uma represa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296388
    m_Localized: 'TV: Os respingos da água traziam à mente imagens de bebidas geladas e espumosas...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296389
    m_Localized: 'TV: E quando os dois irmãos cresceram, fundaram juntos a Cervejaria Bober.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296390
    m_Localized: 'TV: A cerveja Bober Černý tornou-se uma das bebidas alcoólicas mais procuradas nas lojas e nos bares.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296391
    m_Localized: 'TV: Cerveja Bober Černý: Beba o que é bom e beba muito.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296517
    m_Localized: 'Window: A casa do seu vizinho fica no campo de feno.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296518
    m_Localized: 'Window: Não há luz nas janelas. Parece que a família dele já foi dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296519
    m_Localized: 'Window: Alguns bêbados estão largados pela rua.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296520
    m_Localized: 'Window: Mesmo deitados no chão gelado, parecem estar dormindo profundamente. Por enquanto, a vida vai bem pra eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296521
    m_Localized: 'Window: Lá no fundo, está a casa do vizinho que veio te visitar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296522
    m_Localized: 'Window: A luz acesa atravessa a janela — parece que a família dele ainda está acordada, esperando ele voltar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296523
    m_Localized: 'Window: Lá fora, reina um silêncio assustador.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296524
    m_Localized: 'Window: Não tem ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296525
    m_Localized: 'Window: Nem mesmo os bêbados quiseram sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296526
    m_Localized: 'Window: Estariam com medo de alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296527
    m_Localized: 'Window: Você vê seu vizinho e a filha dele pela janela.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296528
    m_Localized: 'Window: Eles brincam felizes, tentando esquecer o horror que está acontecendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296529
    m_Localized: 'Window: Mesmo que só por um instante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296530
    m_Localized: 'Window: Um homem pálido como a morte está parado na trilha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296531
    m_Localized: 'Window: A pele dele tem umas dobras estranhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296532
    m_Localized: 'Window: É como se fosse pele de outra pessoa, mal ajustada ao corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296533
    m_Localized: 'Window: Você não consegue ver os olhos dele daqui, mas sente o olhar atravessando você.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296534
    m_Localized: 'Window: Você sente medo e reza pra que aquele Visitante assustador apenas passe direto pela sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296535
    m_Localized: 'Window: Um pequeno grupo de agentes da FEMA está parado ao lado da casa do seu vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296536
    m_Localized: 'Window: Você se pergunta sobre o que estarão conversando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296537
    m_Localized: 'Window: Será que estão recolhendo amostras do solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296538
    m_Localized: 'Window: Ou procurando um lugar pra montar base?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296539
    m_Localized: 'Window: Você vê um grupo de soldados armados pela janela.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296540
    m_Localized: 'Window: Parece ser uma equipe enviada da cidade pra proteger os agentes da FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296541
    m_Localized: 'Window: Você ouve pedaços de conversa sobre um homem pálido, de peito nu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296542
    m_Localized: 'Window: Talvez estejam tentando rastrear aquele Visitante esquisito?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296543
    m_Localized: 'Window: A casa do seu vizinho, que ele tinha acabado de pintar de branco, queimou por completo e agora está preta feito carvão.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296544
    m_Localized: 'Window: Parece que o fogo apagou há pouco tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296545
    m_Localized: 'Window: Será que alguém colocou fogo de propósito?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296546
    m_Localized: 'Window: O que aconteceu com a família do vizinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296547
    m_Localized: 'Window: Será que alguém sobreviveu?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296548
    m_Localized: 'Window: Pensamentos confusos tomam conta da sua cabeça, e você se sente perdido, impotente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296549
    m_Localized: 'Window: Toda a equipe de soldados que estava aqui ontem agora está morta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296550
    m_Localized: 'Window: Parece que houve um massacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296551
    m_Localized: 'Window: Os corpos estão espalhados pela rua. Um deles está sem cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296552
    m_Localized: 'Window: Será que foi aquele estranho pálido que matou todos?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296553
    m_Localized: 'Window: Você está olhando para as ruínas da casa do seu vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296554
    m_Localized: 'Window: Só resta uma carcaça fantasmagórica, embora até pouco tempo atrás morasse ali uma família feliz...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296555
    m_Localized: 'Window: Uma sensação estranha toma conta de você, como se soubesse que isso ia acontecer...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296556
    m_Localized: 'Window: É como se... você sentisse que a morte estava prestes a chegar a essa casa muito em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296557
    m_Localized: 'Window: Você vê uma estaca com um crânio usando um capacete.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296558
    m_Localized: 'Window: O crânio tem um pouco de pele preta e queimada, e parece que alguém arrancou os dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296559
    m_Localized: 'Window: A cabeça ficou ali o dia todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296560
    m_Localized: 'Window: Toda essa exibição macabra parece ser uma ameaça. Provavelmente foi deixada para trás por aquele Visitante pálido e assustador.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296561
    m_Localized: 'Window: Funcionários da FEMA estão inspecionando o local do massacre recente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296562
    m_Localized: 'Window: Eles levam todo o equipamento e as armas dos soldados mortos para mantê-los fora das mãos dos saqueadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296563
    m_Localized: 'Window: Provavelmente esperavam que o Visitante pálido não sobrevivesse ao encontro com a multidão de pessoas armadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296564
    m_Localized: 'Window: Agora há mais alguns sacos de cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296409
    m_Localized: 'TV: O silêncio é um sinal da morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296410
    m_Localized: 'TV: Um silêncio que suga a sua alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296411
    m_Localized: 'TV: Mas, pior do que o vazio... é o som.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296412
    m_Localized: 'TV: O som que os sinos funerários fazem.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296413
    m_Localized: 'TV: Alguma coisa cresce nas orelhas de quem escuta o sino badalar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296414
    m_Localized: 'TV: Tudo o que sobra é cera e pensamentos obscuros.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296415
    m_Localized: 'TV: É assim que os Convidados vivem.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296416
    m_Localized: 'TV: Os Convidados se emaranham nas teias do pensamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296417
    m_Localized: 'TV: Para eles, os sinos badalam ainda mais alto. E existe muito mais cera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102088
    m_Localized: 'TV: A seguir: Mais notícias sobre o tempo. Mas primeiro, uma mensagem dos nossos patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102105
    m_Localized: 'TV: Isso é tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102127
    m_Localized: 'TV: Estas são as informações mais recentes até o momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102132
    m_Localized: 'TV: Boa tarde. Estamos ao vivo com as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102133
    m_Localized: 'TV: A FEMA está adotando novas medidas, em decorrência de um aumento notório de indivíduos mostrando indícios de serem Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102134
    m_Localized: 'TV: As medidas entram em vigor imediatamente, uma quarentena total será instaurada por todas as grandes cidades.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102135
    m_Localized: 'TV: Sair da sua cidade ou de povoados próximos está estritamente proibido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102136
    m_Localized: 'TV: Por favor, fique em sua área designada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102137
    m_Localized: 'TV: Além disso, a FEMA divulgou um novo procedimento de identificação de Visitante:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102138
    m_Localized: 'TV: Fotografias de Aura.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102139
    m_Localized: 'TV: Pedaços escuros aparecendo na imagem da aura do indivíduo são fortes evidências de que o mesmo pode ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102140
    m_Localized: 'TV: Estas são as informações mais recentes até o momento. Mantenha a calma e fique dentro de casa durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102141
    m_Localized: 'TV: Agora, uma mensagem dos nossos patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102142
    m_Localized: 'TV: O que são os Visitantes? São fantasmas? Criaturas do subterrâneo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102143
    m_Localized: 'TV: Não, isso não é um romance de ficção científica ou uma manchete sensacionalista.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102144
    m_Localized: 'TV: Essa é a nossa nova realidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102145
    m_Localized: 'TV: Os rumores sobre a verdadeira origem dos Visitantes continuam circulando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102146
    m_Localized: 'TV: Eles são aliens? Mortos-vivos? Uma experiência que deu errado?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102147
    m_Localized: 'TV: De acordo com as autoridades, essas são só teorias sem nenhum fundamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102148
    m_Localized: 'TV: Os estudos mostram que um Visitante é um humano que entrou em contato com um agente biológico indeterminado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102149
    m_Localized: 'TV: Os métodos de transmissão ainda não foram identificados e a FEMA alerta para que todos fiquem em alerta por quaisquer sinais de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102150
    m_Localized: 'TV: Se você acredita que sofreu algum tipo de exposição ou não tem certeza se pode ou não ser um Visitante, ligue para a linha de apoio da FEMA:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102151
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102152
    m_Localized: 'TV: Estas são as informações mais recentes até o momento. Fiquem ligados após os comerciais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102153
    m_Localized: 'TV: Está ficando cada vez mais difícil de detectar um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102154
    m_Localized: 'TV: Os sinais podem ajudar, mas e se você quiser usar um método a prova de falhas?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102155
    m_Localized: 'TV: Apresentamos o nosso filme fotográfico revolucionário!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102156
    m_Localized: 'TV: Ele ressalta a energia da alma, fazendo com que você consiga distinguir um humano de um Visitante hostil.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102157
    m_Localized: 'TV: Tire uma fotografia e se você visualizar pedaços escuros, aí está a sua prova, você encontrou um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102158
    m_Localized: 'TV: Ligue agora para pedir o seu kit de iniciante: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102159
    m_Localized: 'TV: Atualização urgente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102160
    m_Localized: 'TV: O sol ataca novamente, queimadas estão dizimando as áreas florestais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102161
    m_Localized: 'TV: Os especialistas acreditam que é culpa do acréscimo anormal de atividade solar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102162
    m_Localized: 'TV: Enquanto a escala real do desastre continua desconhecida, equipes de bombeiros de cidades próximas foram enviadas para conter as chamas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296384
    m_Localized: 'TV: Estas são as informações mais recentes até o momento. Mantenha a calma e fique dentro de casa durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296385
    m_Localized: 'TV: Mantenha a calma e fique dentro de casa durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296386
    m_Localized: 'TV: A seguir: uma palavra dos nossos patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296392
    m_Localized: 'TV: Interrompemos a programação com as notícias de última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296393
    m_Localized: 'TV: Temos relatos de tumultos civis em uma cidade vizinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296394
    m_Localized: 'TV: Em virtude das ocorrências não resolvidas, as forças da FEMA isolaram a área.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296395
    m_Localized: 'TV: Por favor, permaneçam em suas casas. Mais instruções serão emitidas em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296396
    m_Localized: 'TV: Você ajuda a proteger o mundo ao cooperar com a Agência.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296397
    m_Localized: 'TV: Estas são as informações mais recentes até o momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296398
    m_Localized: 'TV: Fique onde você está e aguarde as próximas instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296399
    m_Localized: 'TV: Até mesmo os que trabalham sem cansar precisam de um descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296400
    m_Localized: 'TV: Com os Cigarros Margoro você pode respirar fundo e relaxar de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296401
    m_Localized: 'TV: Margoro. Cigarros para homens de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296402
    m_Localized: 'TV: (Aviso: a empresa não é responsável por qualquer risco de vida ou à saúde)'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296403
    m_Localized: 'TV: Boa tarde. Estamos aos vivos com as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296404
    m_Localized: 'TV: Uma informação importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296405
    m_Localized: 'TV: Surgiram novos detalhes sobre o recente ocorrido na cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296406
    m_Localized: 'TV: Uma das zonas de quarentena foi atacada por um indivíduo armado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296407
    m_Localized: 'TV: Até agora o motivo continua desconhecido e também não sabemos se o indivíduo estava acompanhado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296408
    m_Localized: 'TV: Várias pessoas de condições não verificadas escaparam.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296418
    m_Localized: 'TV: O incidente de hoje rendeu inúmeras teorias. Já perdemos a conta do número de testemunhas oculares.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296419
    m_Localized: 'TV: Alguns relatos descrevem um atirador solitário, enquanto outros mencionam um grupo armado encapuzado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296420
    m_Localized: 'TV: Mas o maior desafio ainda pode estar por vir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296421
    m_Localized: 'TV: Devido ao isolamento da cidade, o descarte de corpos nas áreas circundantes foi temporariamente suspenso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296422
    m_Localized: 'TV: No entanto, as inspeções residenciais continuarão de acordo com o programado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296423
    m_Localized: 'TV: Se você puder cremar os restos mortais, faça isso imediatamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296424
    m_Localized: 'TV: Caso contrário, aguarde até que a situação seja resolvida antes de entregar quaisquer corpos acumulados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296425
    m_Localized: 'TV: Estas são as informações mais recentes até o momento. Fiquem atentos às notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296426
    m_Localized: 'TV: Boa tarde. Estamos aos vivos com as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296427
    m_Localized: 'TV: Neste exato momento, a FEMA está ajudando as vítimas do ataque na zona de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296428
    m_Localized: 'TV: Por motivos de superlotação nas instalações, a Agência decretou o seguinte:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296429
    m_Localized: 'TV: Os residentes desalojados serão temporariamente acomodados em edifícios nos arredores da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296430
    m_Localized: 'TV: Felizmente, os proprietários locais cooperaram com a FEMA e oferecem abrigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296431
    m_Localized: 'TV: No entanto, apenas uma parte dos indivíduos que escaparam foram localizados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296432
    m_Localized: 'TV: Anúncio sobre um novo sinal de identificação:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296433
    m_Localized: 'TV: Gengivas sangrando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296434
    m_Localized: 'TV: Se algum indivíduo com essa condição aparecer na sua porta, não interaja.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296435
    m_Localized: 'TV: Espere pela patrulha rotineira e denuncie o indivíduo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296436
    m_Localized: 'TV: Estas são as informações mais recentes até o momento. Fiquem atentos às notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296437
    m_Localized: 'TV: Fique onde você está e aguarde as próximas instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296438
    m_Localized: 'TV: A seguir: uma reportagem especial sobre um novo culto perigoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296439
    m_Localized: 'TV: Os Visitantes não estão só se escondendo entre nós. Talvez eles estejam se infiltrando em nossos pensamentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296440
    m_Localized: 'TV: Diversas cidades já relataram atividades de um culto organizado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296441
    m_Localized: 'TV: As acusações contra eles incluem:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296442
    m_Localized: 'TV: Sacrifício ritualístico, adoração de uma divindade desconhecida e uma possível conexão com os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296443
    m_Localized: 'TV: De acordo com os últimos relatos, esse grupo já se posicionou abertamente contra a FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296444
    m_Localized: 'TV: O que começou como pregação e propaganda se transformou em ação.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296445
    m_Localized: 'TV: Esse culto pode ser o responsável pelo que ocorreu recentemente na cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296446
    m_Localized: 'TV: Encorajamos os telespectadores a evitarem qualquer contato com esses "novos crentes".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296447
    m_Localized: 'TV: Ajudar ou simpatizar com eles pode resultar em prisão.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296448
    m_Localized: 'TV: Estas são as informações mais recentes até o momento. Fiquem atentos às notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296449
    m_Localized: 'TV: Boa tarde. Estamos ao vivo com as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296450
    m_Localized: 'TV: A situação na cidade está se estabilizando aos poucos, mas os fugitivos continuam em liberdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296451
    m_Localized: 'TV: Enquanto isso, as operações de descarte de corpos retornou com suas atividades, embora novos desafios tenham surgido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296452
    m_Localized: 'TV: De acordo com os últimos relatos, um grupo de cachorros de rua está rondando pelas ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296453
    m_Localized: 'TV: A FEMA enviou uma equipe para neutralizar a ameaça.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296454
    m_Localized: 'TV: A Agência também divulgou um novo sinal em possíveis indivíduos de periculosidade:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296455
    m_Localized: 'TV: Irritação na pele.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296456
    m_Localized: 'TV: A investigação sobre o ataque na cidade ainda está em processo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296457
    m_Localized: 'TV: Ainda não está claro se quem realizou o ato agiu ou não só.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296458
    m_Localized: 'TV: No entanto, não há dúvidas de que a FEMA vai resolver o ocorrido e a ameaça dos Visitantes, também.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296459
    m_Localized: 'TV: Se você tiver qualquer dúvida sobre como reconhecer os sinais dos Visitantes, a linha de apoio da FEMA está sempre disponível:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296460
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296461
    m_Localized: 'TV: Estas são as informações mais recentes até o momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296462
    m_Localized: 'TV: Fique onde você está e aguarde as próximas instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296463
    m_Localized: 'TV: A seguir, uma reportagem sobre a situação nos países do cinturão equatorial.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296464
    m_Localized: 'TV: Notícias preocupantes sobre as regiões equatoriais, hoje à noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296465
    m_Localized: 'TV: Incêndios desenfreados, calor excessivo e a seca estão devastando diversas nações.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296466
    m_Localized: 'TV: Os últimos relatórios mostraram temperaturas tão altas que o mero contato com o solo pode causar queimaduras de terceiro grau.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296467
    m_Localized: 'TV: A contagem de mortos continua desconhecida e a realocação de residentes é impossível neste momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296468
    m_Localized: 'TV: O governo até agora não conseguiu estabelecer contato com as zonas afetadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296469
    m_Localized: 'TV: Contudo, assim que a situação permitir, os oficiais da FEMA serão enviados para ajudar a apaziguar o desastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296470
    m_Localized: 'TV: Estas são as informações mais recentes até o momento. Fiquem atentos às notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296471
    m_Localized: 'TV: Boa tarde. Estamos ao vivo com as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296472
    m_Localized: 'TV: A situação na cidade continua instável e o cordão de isolamento continua em vigor.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296473
    m_Localized: 'TV: No entanto, temos o surgimento de uma nova ameaça. Membros de um culto banido foram avistados nos arredores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296474
    m_Localized: 'TV: De acordo com os últimos relatos, eles podem estar preparando um ritual que envolve muito fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296475
    m_Localized: 'TV: A FEMA acredita que esse grupo pode ter ligação direta com os ataques nas zonas de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296476
    m_Localized: 'TV: Infelizmente, dada a situação atual na cidade, no momento nem a FEMA e nem os militares conseguem despachar uma força tarefa para o ocorrido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296477
    m_Localized: 'TV: Se membros do culto baterem na sua porta, ligue imediatamente para a linha de apoio da FEMA: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296478
    m_Localized: 'TV: A Agência também divulgou um novo sinal de identificação:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296479
    m_Localized: 'TV: Crescimento fúngico na região das axilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296480
    m_Localized: 'TV: Estas são as informações mais recentes até o momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296481
    m_Localized: 'TV: Fique onde você está e aguarde as próximas instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296482
    m_Localized: 'TV: A seguir, notícias sobre as condições das calotas polares.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296483
    m_Localized: 'TV: O sol ataca mais uma vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296484
    m_Localized: 'TV: Os cientistas divulgaram novas projeções desestimuladoras.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296485
    m_Localized: 'TV: Se a atual onda de calor não reduzir, as calotas polares vão derreter e causar uma inundação catastrófica.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296486
    m_Localized: 'TV: Os pesquisadores continuam investigando a anomalia climática recorrente. Até agora, não temos nenhuma resposta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296487
    m_Localized: 'TV: Estas são as informações mais recentes até o momento. Fiquem atentos às notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296488
    m_Localized: 'TV: Notícias de última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296489
    m_Localized: 'TV: As condições na cidade não aparentam nenhum sinal de estabilização. O desastre continua piorando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296490
    m_Localized: 'TV: Com as geleiras derretendo, os níveis dos oceanos aumentam assustadoramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296491
    m_Localized: 'TV: Ameaçando inundar áreas costeiras, incluindo grandes metrópoles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296492
    m_Localized: 'TV: Lagos contaminados de radiação começaram a evaporar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296493
    m_Localized: 'TV: Os cientistas alertam que isso pode resultar em chuva ácida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296494
    m_Localized: 'TV: Se você ouvir um trovão, procure abrigo imediatamente e se proteja da exposição.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296495
    m_Localized: 'TV: E, infelizmente, o cordão de isolamento da cidade continua em vigor.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296496
    m_Localized: 'TV: A FEMA ainda não capturou todos os fugitivos e acabou de divulgar um novo sinal para identificar os Visitantes:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296497
    m_Localized: 'TV: Movimentos rápidos da pupila.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296498
    m_Localized: 'TV: Estas são as informações mais recentes até o momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296499
    m_Localized: 'TV: Interromperemos essa notícia por conta do risco de um ataque em nosso estúdio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296500
    m_Localized: 'TV: Se você tiver qualquer dúvida sobre como identificar os Visitantes, ligue para a linha de apoio: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296501
    m_Localized: 'TV: Fim da transmissão.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296502
    m_Localized: 'TV: Atualização urgente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296503
    m_Localized: 'TV: A FEMA acabou de prender a maioria dos oficiais governamentais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296504
    m_Localized: 'TV: A Agência relata que algum deles foram identificados como Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296505
    m_Localized: 'TV: Com o parlamento inábil para operar, a FEMA vai assumir o cargo de governo temporário.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296506
    m_Localized: 'TV: E além disso...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296507
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296508
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296509
    m_Localized: 'TV: Só um instante...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296510
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296511
    m_Localized: 'TV: Acabamos de receber notícias da FEMA:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296512
    m_Localized: 'TV: Os agressores na zona de quarentena da cidade romperam o cordão de isolamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296513
    m_Localized: 'TV: Repetimos, os agressores estão à solta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296514
    m_Localized: 'TV: Reforcem suas janelas. Tranquem suas portas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296515
    m_Localized: 'TV: Aguarde as próximas instruções e fiquem dentro de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296516
    m_Localized: 'TV: Fim da transmissão.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296565
    m_Localized: 'Window: Você vê uma mulher chorando perto de seu esposo aparentemente lesionado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296566
    m_Localized: 'Window: Você não sabe dizer se ele está vivo ou morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296567
    m_Localized: 'Window: Com lágrimas nos olhos, ela arrasta o corpo dele para longe do tiroteio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296568
    m_Localized: 'Window: E você se encontra a sós com um único pensamento: As coisas só vão piorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296569
    m_Localized: 'Window: O caminho ao longo do campo está repleto de corpos das pessoas que tentaram fugir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296570
    m_Localized: 'Window: E perto deles está o responsável, um oficial da FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296571
    m_Localized: 'Window: Ele está segurando um rifle, a fumaça ainda percorre o cano da arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296572
    m_Localized: 'Window: Pessoas em pânico correm para suas casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296573
    m_Localized: 'Window: Elas batem nas portas, desesperadas por um abrigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296574
    m_Localized: 'Window: Mas parece que ninguém vai abrir, com medo de que isso possa resultar em algum problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296575
    m_Localized: 'Window: Um grupo de pessoas despejadas está ao lado da casa destruída do vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296576
    m_Localized: 'Window: Eles estão em choque, sussurrando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296577
    m_Localized: 'Window: Provavelmente querem se abrigar lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296578
    m_Localized: 'Window: Mas será se existe algum lugar que ainda dê pra se esconder e ficar seguro? Algum lugar no mundo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296579
    m_Localized: 'Window: Há um homem armado com um rifle no caminho. Ele parece estar totalmente enlouquecido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296580
    m_Localized: 'Window: A jaqueta dele está coberta de dentes arrancados, olhos e vai saber o que mais. É difícil distinguir daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296581
    m_Localized: 'Window: E se ele não mata só para se defender, e sim por pura diversão?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296582
    m_Localized: 'Window: Seja qual for o caso, espero que você não faça dele um inimigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296583
    m_Localized: 'Window: Pendurado em um poste há um homem com uma placa que diz: “Você tirou tudo de mim”.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296584
    m_Localized: 'Window: Ele foi roubado? Ou a FEMA levou a família dele?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296585
    m_Localized: 'Window: Sua mente acelera, mas não existem respostas, apenas palpites.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296586
    m_Localized: 'Window: Um grupo despejado pela FEMA se instalou nos destroços da casa do vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296587
    m_Localized: 'Window: Embora muito pouco tenha restado, o porão no subsolo parece ter aguentado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296588
    m_Localized: 'Window: Um pedacinho de terra em segurança.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296589
    m_Localized: 'Window: Mas, por quanto tempo eles vão conseguir se esconder?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296590
    m_Localized: 'Window: Cães selvagens rondam pelas ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296591
    m_Localized: 'Window: Seus corpos apresentam queimaduras superficiais, a fome os emagreceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296592
    m_Localized: 'Window: Dentro de casa você não sente medo deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296593
    m_Localized: 'Window: Mas, você não consegue se livrar da sensação de que é melhor não sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296594
    m_Localized: 'Window: Pequenos grupos com seus pertences se reúnem perto das casas. Eles sussurram com cuidado para não serem escutados pelos oficiais da FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296595
    m_Localized: 'Window: Parece que eles são da zona de quarentena e se mudaram para as casas dos antigos moradores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296596
    m_Localized: 'Window: Agora, o homem enforcado parece ser um sinal de "boas vindas".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296597
    m_Localized: 'Window: Um caçador de Visitantes está ameaçando um grupo de sobreviventes com uma arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296598
    m_Localized: 'Window: Deve ter esbarrado neles por acaso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296599
    m_Localized: 'Window: Você escuta barulhos de tiro e uma voz gritando, enlouquecida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296600
    m_Localized: 'Window: Quem é que consegue sobreviver nesse novo mundo? Parece que não serão esses caras.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296601
    m_Localized: 'Window: Os oficias da FEMA estão próximos dos cadáveres dos cachorros.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296602
    m_Localized: 'Window: Um deles está anotando alguma coisa em um tablet.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296603
    m_Localized: 'Window: Mas, será que um grupo pequeno de pessoas consegue impedir uma horda de animais famintos? Muito improvável.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296604
    m_Localized: 'Window: Dois oficiais da FEMA estão parados perto do poste, encarando o homem enforcado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296605
    m_Localized: 'Window: Parece que eles finalmente perceberam a atração principal da área.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296606
    m_Localized: 'Window: Parecem detetives de terceira, se questionando como o corpo foi parar ali, sem uma escada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296607
    m_Localized: 'Window: O grupo inteiro está morto. Os cachorros famintos destroçam seus resquícios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296608
    m_Localized: 'Window: Cartuchos usados estão espalhados perto dos corpos. Parece que aquele caçador matou todo mundo e levou só os espólios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296609
    m_Localized: 'Window: A loucura desse mundo já passou do limite.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296610
    m_Localized: 'Window: Os cultistas empilham vários fardos de lenha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296611
    m_Localized: 'Window: Eles planejam queimar alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296612
    m_Localized: 'Window: O plano de pura insanidade logo vai se revelar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296613
    m_Localized: 'Window: Mas, quantas vidas inocentes serão ceifadas em nome da causa que eles defendem?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296614
    m_Localized: 'Window: Na estrada... um atirador desvairado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296615
    m_Localized: 'Window: O homem está segurando uma lata de gás e um coquetel molotov.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296616
    m_Localized: 'Window: Ele planeja atear fogo no povoado inteiro?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296617
    m_Localized: 'Window: Alguém contou pra ele que eles são das zonas de quarentena?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296618
    m_Localized: 'Window: Os corpos dos que se abrigavam nos destroços da casa do vizinho tostaram, enquanto o sol do meio dia raiava.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296619
    m_Localized: 'Window: Os cães que se alimentavam deles fugiram, como se estivessem aterrorizados com alguma outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296620
    m_Localized: 'Window: E se eles não correram da FEMA, mas de algo pior?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296621
    m_Localized: 'Window: Os cultistas estão amarrados no local da fogueira.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296622
    m_Localized: 'Window: Decidiram se sacrificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296623
    m_Localized: 'Window: O pensamento se contorce na sua mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296624
    m_Localized: 'Window: O medo da morte turvou a razão e as pessoas estão dispostas a fazer o impensável.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296625
    m_Localized: 'Window: É aterrorizante pensar o que vai vir depois, quando esse tipo de loucura estiver normalizada, depois de apenas algumas semanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296626
    m_Localized: 'Window: A labareda das casas em chamas brilham com intensidade. Os gritos ecoam no vazio...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296627
    m_Localized: 'Window: Você sabe que o responsável por trás desse caos é o maluco que está tentando aniquilar os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490688
    m_Localized: 'Window: Será que a sua casa é a próxima? Amanhã, ou na semana que vem?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490689
    m_Localized: 'Window: É provável que você encare esse lunático pessoalmente, é só uma questão de tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490690
    m_Localized: 'Window: Nada restou dos corpos carbonizados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490691
    m_Localized: 'Window: Apenas uma massa estranha e disforme. Parece lodo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490692
    m_Localized: 'Window: Você imagina se alguma coisa derreteu a carne e o osso antes de engolir os restos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490693
    m_Localized: 'Window: Você reza para que essa criatura permaneça nas sombras. O medo de sua mente não sobreviver ao ver aquele monstro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490694
    m_Localized: 'Window: Os oficiais da FEMA cercam os corpos carbonizados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490695
    m_Localized: 'Window: Estão documentando a morte dos cultistas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490696
    m_Localized: 'Window: Rostos congelados em horror e agonia, como se tivessem visto alguma terrível antes de serem ceifados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490697
    m_Localized: 'Window: Todas as casas próximas estão em destroços.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490698
    m_Localized: 'Window: A sua casa é a única que restou.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490699
    m_Localized: 'Window: Não restou mais ninguém para servir como seu escudo humano contra a ira daquele louco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490700
    m_Localized: 'Window: Seja lá o que vai acontecer a seguir, o alvo vai ser você.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490701
    m_Localized: Aqui é a Central. Fazer verificação da condição da zona de quarentena. Código 51. Relatos de explosões às 3 da manhã.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490702
    m_Localized: 'Unidade 32-8 relatando. Código 60: Abate de civis em massa, oficiais caídos...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490703
    m_Localized: Aqui é o 28-8. Código 451. Solicitando o apoio da equipe de descarte de corpos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490704
    m_Localized: Afirmativo. Iniciando Código 984. A cidade está isolada até o fim da investigação. Aguarde os reforços.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490705
    m_Localized: Se você ouvir essa mensagem, mantenha distância dos arredores.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490706
    m_Localized: Os oficiais da FEMA estão fuzilando qualquer um que tente sair.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490707
    m_Localized: EU NÃO SEI O QUE TÁ ACONTECENDO. EU SÓ QUERO SAIR DAQUI.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490708
    m_Localized: ALGUÉM, POR FAV...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490709
    m_Localized: Esses não eram os responsáveis por atacar a zona de quarentena.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490710
    m_Localized: Eu vi. Eu vi o que estava lá.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490711
    m_Localized: Aquilo... não era humano.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490712
    m_Localized: Ahã... Aqui é um morador desalojado falando...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490713
    m_Localized: Se você foi despejado pela FEMA assim como nós, estamos nos protegendo em um porão no subsolo de uma casa queimada.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490714
    m_Localized: É perto da casa do ermitão.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490715
    m_Localized: Não temos muita comida restando. Nós morreremos se não conseguirmos mais.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490716
    m_Localized: Se alguém puder nos doar um pouco de comida, por favor, nos ajude. Nós estamos realmente necessitados.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490717
    m_Localized: Para quem estiver ouvindo...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490718
    m_Localized: A FEMA está tentando cortar todos os sinais na cidade para manter tudo debaixo dos panos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490719
    m_Localized: Eles querem esconder tudo o que está acontecendo dentro da cidade.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490720
    m_Localized: Estão tentando colocar toda a culpa naquele psicopata que matou todo mundo na zona de quarentena.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490721
    m_Localized: Se você ainda estiver na cidade, fu... ja... não... seguro.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490722
    m_Localized: E... vite as patrulhas da FEMA. Eles vão m... atar voc... ê.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490723
    m_Localized: FU... JA ENQUAN... TO VOCÊ... CONS...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490724
    m_Localized: Eles não deveriam ter quei... mado os cor... pos...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490725
    m_Localized: Se eles tivessem... se eles tivessem... os restos... não teriam conse...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490726
    m_Localized: Cen...tral para......... todas... unid... da F... MA...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490727
    m_Localized: 'Nova dire...: O Código 451 será substitui... pelo Código 955.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490728
    m_Localized: Não quei... os corpos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490729
    m_Localized: Rep...tindo, o Código 451 é... queim... ar... para con... ter a ame... ça apresentada pelo indivíd...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490730
    m_Localized: Aq... é 18-8. Nós nã... consegui... conter...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490731
    m_Localized: O indiv... escapou dos perímetros da cid.... refor... imediato... cessário.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490732
    m_Localized: 'Rep... tindo: precisamos de... forços agora. Nã... conseguimos conter o indi... sozinhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490733
    m_Localized: 'Phone: Ei, vizinho. Bom ter notícias de você.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490734
    m_Localized: 'Phone: Então... você já deixou algumas pessoas entrarem?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490735
    m_Localized: 'Phone: Se você ainda não estiver fazendo isso, deveria começar a pensar sobre o assunto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490736
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490737
    m_Localized: 'Phone: Você quer perguntar alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490738
    m_Localized: Você também está abrigando pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490739
    m_Localized: Quantos sinais são precisos para conseguir dizer se alguém é um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490740
    m_Localized: Como é que você resolve o problema de alimentar todo mundo?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490741
    m_Localized: Tchau (desligar)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490742
    m_Localized: 'Phone: É, eu preciso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490743
    m_Localized: 'Phone: Minha filha não gosta mesmo. Mas, o que eu posso fazer? Não tem outro jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490744
    m_Localized: 'Phone: Ela continua me implorando para levar ela lá fora, só pra se ver livre dos estranhos na casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490745
    m_Localized: 'Phone: Mas, fazer isso durante o dia não é uma opção, então a gente dá uma caminhada durante a noite. É bem perigoso, eu sei... mas, o que eu posso fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490746
    m_Localized: 'Phone: Se eu pelo menos soubesse...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490747
    m_Localized: 'Phone: Ninguém quer saber de verdade quantos sinais precisam para ter certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490748
    m_Localized: 'Phone: Eu diria que é melhor não pular para conclusões precipitadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490749
    m_Localized: 'Phone: Um? Talvez não seja nada. Talvez eles só tenham ido ao dentista antes de tudo ir pro inferno.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490750
    m_Localized: 'Phone: Eu dei sorte, armazenei tudo com antecedência. Se eu me lembro bem, você também.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490751
    m_Localized: 'Phone: Mas, se você quiser alguma coisa especial, existe aquele serviço de entrega, o For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490752
    m_Localized: 'Phone: Não sei qual é o número de lá, mas você encontra nos comerciais de rádio ou TV.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490753
    m_Localized: 'Phone: Se cuida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490754
    m_Localized: 'Phone: Oi, vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490755
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490756
    m_Localized: 'Phone: Você viu o que aconteceu lá fora? Aqueles adolescentes foram mortos...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490757
    m_Localized: 'Phone: Eu pensei que as ruas não eram tão perigosas assim... Achei errado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490758
    m_Localized: 'Phone: Minha filha falou comigo para sair e brincar. Não me pareceu tão ruim... até ver os corpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490759
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490760
    m_Localized: 'Phone: Foi a última vez que arrisquei a vida dela assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490761
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490762
    m_Localized: 'Phone: Jesus, eu nunca me perdoaria se alguma coisa acontecesse com ela. Ela é o meu mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490763
    m_Localized: A sua filha tá bem?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490764
    m_Localized: Quem matou?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490765
    m_Localized: Se cuida (desligar)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490766
    m_Localized: Eu não sei
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490767
    m_Localized: 'Phone: Com todo aquele matagal, eu torcia para que ela não notasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490768
    m_Localized: 'Phone: Mas, em casa ela disse que viu um rosto no mato...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490769
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490770
    m_Localized: 'Phone: Eu estou tentando convencê-la de que foi só a imaginação fértil dela. Mas... ela não tá acreditando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490771
    m_Localized: 'Phone: Era pálido pra caramba, alto, bizarro. Achei que ele só matava quem ficava dentro de casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490772
    m_Localized: 'Phone: Achei que estava tudo sob controle. Conclui que se eu visse aquela silhueta, nós correríamos na hora para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490773
    m_Localized: 'Phone: Mas eu não cogitei o que mais ela poderia ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490774
    m_Localized: 'Phone: Agradeço. Se cuida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490775
    m_Localized: 'Phone: Ei, vizinho. Valeu pela ligação.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490776
    m_Localized: 'Phone: Sinceramente, eu ainda estou processando isso tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490777
    m_Localized: 'Phone: Os assassinatos, os soldados, a FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490778
    m_Localized: 'Phone: Eles até apareceram aqui em casa ontem, pela noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490779
    m_Localized: 'Phone: Perguntaram sobre as pessoas que estavam aqui, escreveram algo num tablet e aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490780
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490781
    m_Localized: 'Phone: Um deles levou uma pessoa da minha casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490782
    m_Localized: Para onde é que eles levam esse pessoal?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490783
    m_Localized: Ainda bem que não levaram a sua filha
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490784
    m_Localized: Afinal, o que é a FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490785
    m_Localized: Se cuida (desligar)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490786
    m_Localized: 'Phone: Como se eu soubesse. Eles disseram que era para os "testes".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490787
    m_Localized: 'Phone: Eu pensava que todos esses soldados e o governo iriam consertar tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490788
    m_Localized: 'Phone: Deveríamos ter pensado melhor antes de achar que eles nos ajudariam ou nos levariam para um lugar seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490789
    m_Localized: 'Phone: Eu não vou deixar isso acontecer, nunca.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490790
    m_Localized: 'Phone: Só passando por cima do meu cadáver.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490791
    m_Localized: 'Phone: Se esses escrotos encostarem um dedo nela, eu vou partir eles no meio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490792
    m_Localized: 'Phone: Eu não sei. Ninguém sabe muita coisa sobre eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490793
    m_Localized: 'Phone: Eles vieram do nada e agem como se tudo tivesse em perfeita ordem.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490794
    m_Localized: 'Phone: Mas, me digam, como é que eles conseguem identificar os sinais quando os mesmos são apenas meras características de um ser humano?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490795
    m_Localized: 'Phone: Parece que eles estão escondendo mais sobre essa história...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490796
    m_Localized: 'Phone: Agradeço'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490797
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490798
    m_Localized: 'Phone: Nunca achei que acabaríamos vivenciando tempos tão interessantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490799
    m_Localized: 'Phone: O sol, os Visitantes, e agora a FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490800
    m_Localized: 'Phone: Tantas perguntas e nem uma maldita resposta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490801
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490802
    m_Localized: 'Phone: Vizinho, eu preciso te pedir uma coisa...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490803
    m_Localized: 'Phone: Se acontecer alguma coisa comigo, me prometa que vai cuidar da minha filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490804
    m_Localized: Eu prometo
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490805
    m_Localized: Eu não posso prometer nada
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490806
    m_Localized: 'Phone: Agradeço, vizinho. Eu sabia que poderia contar com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490807
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490808
    m_Localized: 'Phone: Tá, agora eu preciso ir. Fica firme.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490809
    m_Localized: 'Phone: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490810
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490811
    m_Localized: 'Phone: Você não vai mesmo ajudar ela? É só uma criança... Eu não quero deixar ela totalmente só.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490812
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490813
    m_Localized: 'Phone: Porra, preciso correr...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490814
    m_Localized: 'Phone: Tchau, vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490815
    m_Localized: 'Phone: Olá, você está no canal de entregas de comida For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490816
    m_Localized: 'Phone: Gostaria de fazer um pedido?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490817
    m_Localized: Duas latas de Enerjeka, por favor
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490818
    m_Localized: Um café, por favor
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490819
    m_Localized: Eu mudei de ideia, não quero pedir nada
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490820
    m_Localized: 'Phone: Pedimos perdão, não podemos aceitar o seu pedido agora. Nosso sistema aponta que você já tem um pedido em pendência.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490821
    m_Localized: 'Phone: Por conta da alta demanda dos nossos serviços, nós somos forçados a aceitar pedidos com algumas pausas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490822
    m_Localized: 'Phone: Se você quiser realizar um pedido, por favor, tente novamente outro dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490823
    m_Localized: 'Phone: Agradecemos o contato.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490824
    m_Localized: 'Phone: Seu pedido foi aceito. Seu pedido deve chegar amanhã pela noite. Obrigado por utilizar nossos serviços.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490825
    m_Localized: 'Phone: Seu pedido foi aceito. Seu pedido deve chegar amanhã pela noite. Obrigado por utilizar nossos serviços.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490826
    m_Localized: 'Phone: Olá, aqui é da divisão médica da FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490827
    m_Localized: 'Phone: Agora oferecemos serviços de consultoria sobre procedimentos oficiais da triagem de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490829
    m_Localized: 'Phone: Por favor, faça a sua pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490830
    m_Localized: O que devo saber sobre os sinais dentários?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490831
    m_Localized: O que devo saber sobre os sinais nas unhas?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490832
    m_Localized: O que devo saber sobre os sinais nos olhos?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490833
    m_Localized: Agradeço, isso é tudo
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490834
    m_Localized: 'Phone: Para uma verificação mais precisa, nós recomendamos evitar o uso de tabaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490835
    m_Localized: 'Phone: Fumar pode afetar as condições dentárias, levando a resultados não confiáveis.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490836
    m_Localized: 'Phone: Para se certificar da leitura correta do status de um Visitante, por favor evite lavar as suas mãos antes da examinação.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490837
    m_Localized: 'Phone: A água pode remover resíduos superficiais, que podem resultar em erros ou falso positivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490838
    m_Localized: 'Phone: Para uma triagem assertiva, por favor evite café ou bebidas que tenham cafeína em suas composições.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490839
    m_Localized: 'Phone: A cafeína é uma das principais causas de ansiedade e insônia, e pode deixar os olhos vermelhos ou irritados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490840
    m_Localized: 'Phone: Agradecemos a sua cooperação com a FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490841
    m_Localized: 'Phone: A sua contribuição é valiosa enquanto nós trabalhamos para resolver a situação.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490842
    m_Localized: 'Phone: Nos ajude a ajudar você. Você faz sua parte pelo futuro da humanidade ao realizar verificações mais precisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490843
    m_Localized: 'Phone: Olá. Por favor, aguarde enquanto conectamos você a um Especialista em Remoção de Visitante disponível.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490844
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490845
    m_Localized: 'Phone: Oi? Quem é você?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490846
    m_Localized: Como assim?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490847
    m_Localized: Por que você precisa saber quem eu sou?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490848
    m_Localized: 'Phone: Tá, entendi. Você não disse de cara que é humano... o Espírito do Visitante já está começou a criar raízes em você.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490849
    m_Localized: 'Phone: Agora, escute com atenção: Você não tem muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490850
    m_Localized: 'Phone: Me conte, você sempre deixa uma fatia de pão na cozinha?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490851
    m_Localized: Não? Por que eu faria isso?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490852
    m_Localized: Uma fatia de pão?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490853
    m_Localized: 'Phone: Para me ajudar a banir o Espírito do Visitante dentro de você.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490854
    m_Localized: 'Phone: Tá, deixa pra lá. Escute com atenção: Você não tem muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490855
    m_Localized: 'Phone: Me conte, você sempre deixa uma fatia de pão na cozinha?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490856
    m_Localized: Não? Por que eu faria isso?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490857
    m_Localized: Uma fatia de pão?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490858
    m_Localized: 'Phone: Ah... isso explica muita coisa. Você não está alinhado com o Espírito da Casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490859
    m_Localized: 'Phone: É por isso que o Espírito do Visitante veio. Mas não tem problema, nós conseguimos resolver isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490860
    m_Localized: 'Phone: Você tem algum computador pessoal em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490861
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490862
    m_Localized: Um o quê pessoal?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490863
    m_Localized: 'Phone: Você não deixa oferendas para o Espírito da Casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490864
    m_Localized: 'Phone: Não é surpresa o Espírito do Visitante ter se interessado em você.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490865
    m_Localized: 'Phone: Você tem algum computador pessoal em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490866
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490867
    m_Localized: Um o quê pessoal?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490868
    m_Localized: 'Phone: Entendi. Então o Alt+F4 está fora de cogitação.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490869
    m_Localized: 'Phone: Certo então, me diga: você consome cogumelos?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490870
    m_Localized: Só kombucha. Ocasionalmente.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490871
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490872
    m_Localized: 'Phone: Você não sabe de verdade o que é um computador?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490873
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490874
    m_Localized: 'Phone: Tá bom, deixa pra lá. Talvez você esteja sob o efeito de alguma medicação?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490875
    m_Localized: Só kombucha. Ocasionalmente.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490876
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490877
    m_Localized: 'Phone: Eita...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490878
    m_Localized: 'Phone: Você precisa parar de beber isso agora mesmo. A kombucha é um mal antigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490879
    m_Localized: 'Phone: Essa bebida faz com que o micélio se desenvolva dentro de você. É por isso que o espírito te controla como uma marionete.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490880
    m_Localized: 'Phone: Você não tem nem ideia do dano que ele pode causar se chegar até as suas memórias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490881
    m_Localized: 'Phone: Ele pode apagá-las uma por uma... ou reviver cada uma delas várias e várias vezes, alterando as suas escolhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490882
    m_Localized: 'Phone: O pior? Você não vai nem perceber que está sendo controlado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490883
    m_Localized: 'Phone: Certo, uma última pergunta: houve algum derramamento de sangue na sua casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490884
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490885
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490886
    m_Localized: 'Phone: Ótimo. Então nem beba. Caso contrário, será mais fácil para o Primeiro Convidado retornar para o seu corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490887
    m_Localized: 'Phone: Se você estivesse bebendo a kombucha, o micélio já poderia ter começado a crescer dentro do seu corpo... e ter tomado todo o controle, como se você fosse uma marionete.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490888
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490889
    m_Localized: 'Phone: Ufa... Não é fácil, nada fácil...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490890
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490891
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490892
    m_Localized: 'Phone: Ah, isso explica muita coisa...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490893
    m_Localized: 'Phone: Não é um Espírito do Visitante. É um Espírito Espectral. A alma de uma pessoa morta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490894
    m_Localized: 'Phone: Perdão, a remoção de espíritos não é mesmo a minha área.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490895
    m_Localized: 'Phone: Você vai precisar de um exorcista para isso. Eles vão ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490896
    m_Localized: 'Phone: Creio que não posso fazer mais nada por você. Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490897
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490898
    m_Localized: 'Phone: A sua sessão de Remoção de Visitantes terminou. Agradecemos o uso dos nossos serviços.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490899
    m_Localized: 'Phone: Uma taxa pela consulta será emitida em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490900
    m_Localized: Uma taxa?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490901
    m_Localized: Pensei que a ligação fosse gratuita
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490903
    m_Localized: 'Phone: Ah, é uma pena, eu não consigo identificar esse tipo de espírito. E não sabendo o tipo de espírito, não há nada que eu possa fazer para ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490904
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490905
    m_Localized: 'Phone: Sinto muito, mas preciso encerrar nossa sessão agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490906
    m_Localized: 'Phone: Seja forte... e adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490907
    m_Localized: 'Phone: A sua sessão de Remoção de Visitantes terminou. Agradecemos o uso dos nossos serviços.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: Uma taxa pela consulta será emitida em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: Uma taxa?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: Pensei que a ligação fosse gratuita
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: Correto. Afinal de contas, nossos Especialistas em Remoção de Visitantes precisam de um salário para sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: Como você avalia a sua experiência de hoje?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: Positiva
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: Não me ajudou
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: Vão se lascar, seus fraudulentos do caralho
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: Se você tivesse assistido o anúncio com atenção, teria visto que a ligação não é gratuita.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: Como você avalia a sua experiência de hoje?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: Positiva
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: Não me ajudou
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: Vão se lascar, seus fraudulentos do caralho
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: Agradecemos. A sua opinião é muito importante para nós. Até logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: Estas são as informações mais recentes até o momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: Já disponível pelo serviço de entrega For Rest. Ligue agora para {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: Boa tarde. Estamos ao vivo com as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: 'TV: Apesar das queimadas, os Visitantes continuam aterrorizando o país.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: A FEMA divulgou um novo sinal de identificação dos Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: A seguir: Uma reportagem especial sobre a natureza dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: Hã? Sim, oi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: Sua esposa me deu esse número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: Sua esposa precisa de ajuda
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: Aham, e?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: Ela perdeu todas as crianças
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: Elas estão com você?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: A mesma história de sempre. E só sobra eu pra limpar a bagunça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: Ela só fica sentada, tipo, "ai, eu tô cansada."'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: Nenhuma novidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: Ela perdeu todas as crianças
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: Elas estão com você?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: Ahã. Mais uma vez, para a surpresa de zero pessoas: ela deu a mínima para os próprios filhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: E sou eu quem precisa limpar a bagunça, vai entender...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: Você conferiu a casa da mãe dela?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: Alguma chance de você ir lá e buscar ela?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: Não. As crianças não estão com ela?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: Não tô nem um pouco surpreso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: Você conferiu a casa da mãe dela?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: Alguma chance de você ir lá e buscar ela?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: Aham.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: Bom, talvez elas estejam lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: Eu não vou.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: Deixa ela fazer isso. Pergunta pra ela: que tipo de mãe ignora os próprios filhos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: Vocês que resolvam isso
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: Enfim, eu conto para ela que você está vivo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: Deixa ela vir só. Ela não é nenhuma princesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: Ela tem duas pernas que andam, né? Então, qual é o problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: Vocês que resolvam isso
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: Enfim, eu conto para ela que você está vivo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: Então você ligou pra quê? Salvar uma pobre donzela em apuros?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: Faça o que você bem entender. Essa vagabunda não dá a mínima.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: Só me deixa em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: 'Phone: Enfim, eu conto para ela que você está vivo'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: Nem perca tempo. Pra quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: A gente não lembra mais nem da existência um do outro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: Eu não sei nem por que você está se envolvendo nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: Enfim... se cuidem, vocês dois. Espero que tenham uma vida maravilhosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: Você acredita na morte?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: Seu marido pediu para eu ligar para você
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: Vamos pular o sermão. Isso é sobre o seu marido
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: Quê? Meu marido?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: Depois de tudo o que ele fez, eu não quero ouvir uma palavra sobre ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: Ele me pediu pra te dizer que... ele sente muito pelo que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: Ele me pediu pra te mandar ir lá pra casa do caralho
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: Meu marido?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: Depois de tudo o que ele fez eu não quero ouvir um pio sobre ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: Ele me pediu pra te dizer que... ele sente muito pelo que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: Ele me pediu pra te mandar ir lá pra casa do caralho
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: Hã? Sente muito?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: Sério? De novo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: Ele já mandou outras pessoas pedirem desculpas por ele, sabia?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: Quer saber por que ele não consegue me ligar por conta própria?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: Por que ele não tem colhão o suficiente para encarar e aceitar o que fez.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: Ele ainda acredita que pode consertar tudo, fazer tudo voltar ao que era antes. Mas não é assim que a vida funciona. Ninguém pode rebobinar o tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: Estou melhor sozinha. Estou com pessoas que me entendem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: Você acha que um bando de fanáticos entendem você?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: Por que você entrou para um culto?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: Se você está dizendo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: Chame eles do que você quiser. Agora eles são a minha família.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: Nós compartilhamos a mesma crença. Nós sabemos que a Morte está chegando.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: E que ela trará paz, e não dor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: Cuide-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: Nós cremos na mesma coisa que está por vir. É a chegada da Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: Pode soar estranho para você, mas a Morte não traz sofrimento, e sim felicidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: Felicidade na paz e no fim do sofrimento. Tenho certeza que você também enfrentou dificuldades.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: Talvez um dia você entenda e veja as coisas da mesma maneira que nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: Cuide-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: Agradeço a sua compreensão.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: Cuide-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: Oi? Quem é?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: Oi. Seu irmão me deu o seu número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: Você vai ajudar o seu irmão?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: Que irmão? Eu nem...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: Ah, você tá falando do filho do meu pai, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: Mas, espera... Quem é você? E por que ele está com você?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: Os pais dele desapareceram
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: Ele veio até aqui, procurando por abrigo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: Desapareceu? Como isso aconteceu?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: Você não quer dizer que eles...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: Porra... isso não pode ser verdade. Eles estão mortos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: Eu não sei
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: É provável que sim
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: Procurando por abrigo? Mas ele vive com os pais dele, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: Será que eles...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: Porra... isso não pode ser verdade. Eles estão mortos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: Eu não sei
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: É provável que sim
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: Meu deus... como isso foi acontecer?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: Diga para ele que posso abrigá-lo. Ele sabe onde eu moro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: E... agradeço de verdade por você o ter ajudado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: Alô? Quem é?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: Sua esposa e a sua cunhada estão na minha casa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: Sua esposa me deu esse número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: Me parece que você está exigindo um resgate.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: Mas eu não tenho nada mais para dar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: E em breve não teremos mais ninguém restando.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: O que você quer dizer com isso? Qual é o seu problema?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: A sua esposa está bem
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: Por favor, me diga que ela está bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: Ela é forte e vai superar qualquer coisa. Ela vai até mesmo ajudar quem puder ao longo do caminho!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: Mas acho que eu não posso mais ser ajudado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: Eu não vou durar por muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: O que você quer dizer com isso? Qual é o seu problema?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: A sua esposa está bem
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: Eu... só não aguento mais. O sol, os Visitantes, a multidão enlouquecida. Tudo isso é assustador. Eu me sinto petrificado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: Eu só... queria que tudo isso acabasse. Eu só tenho uma saída... você tá me entendendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: Diga para ela que eu a amo muito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: Na verdade... não diga nada. Só se certifique que ela não vai vir procurar por mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: Eu não quero que ela descubra que eu parti sem ela...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: Obrigado pela ligação. E por me escutar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: Adeus...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: Ela deve estar se apoiando emocionalmente na irmã... ela nunca aprendeu a deixar as coisas partirem, ha...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: Quanta falta de sorte ela tem, cercada de pessoas fracas. Agora você entende o motivo de eu ter deixado ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: Olá, aqui é o setor de Adesões da FEMA. Como posso ajudar?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: A esposa de um oficial da FEMA está aqui
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: Uma altruísta que quer se unir a vocês
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: Certo, qual é a sua pergunta? Ainda não sei em como posso ajudar você.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: Supondo que isso não seja uma ameaça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: É uma ameaça...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: Ela está procurando por um trabalho com vocês. Ela trabalhava em uma fronteira
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: (Você escuta a outra pessoa suspirar alto)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: Você é um desses ativistas, né? Sempre reclamando de alguma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: Não desperdice o nosso tempo. Alguém que precisa mesmo de ajuda pode estar provavelmente tentando entrar em contato nesse exato momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: Os Visitantes podem estar tentando invadir alguma casa. Ou pior: pessoas podem morrer por sua culpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: Hum. Ela deve ter consciência de que o trabalho não é... nada fácil. Você tem certeza de que ela está pronta?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: Se sim, peça para ela preencher o Formulário 31-G e enviar três cópias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: Depois ela precisará ser avaliada pelos médicos e preencher...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: (Você desligou. Por que você se deu o trabalho de ligar e falar sobre essa mulher?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: Ela se candidatou par qual cargo? E, por favor, não me diga que foi o de "diretor".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: Só hoje, ela seria a terceira pessoa fazendo isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: Diretora
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: Rastreadora. Ou algum tipo de batedora
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: Essas pegadinhas de merda já passaram do limite.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: Olha, quando você faz uma merda de uma pegadinha numa linha de emergência eu não vou conseguir ajudar quem precisa, entendeu, porra? Pessoas podem estar sendo assassinadas por Visitantes, neste exato momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: Assuma essa sua piada imbecil e totalmente inapropriada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: (Eles desligaram. Sério?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: Não temos vagas assim. O que nós precisamos mesmo são de especialistas em epidemias e cientistas qualificados.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: A sua amiga não parece ser uma boa opção.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: Quer saber de uma coisa? As coisas estão mudando rápido demais. Tente ligar daqui a uma semana.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: Tenho certeza que teremos algum lugar para... qual foi a palavra que você usou? Uma altruísta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: Estrutura de uma maçã: a supermaçã, a terra dos cogumelos e papel.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: Tema o... mingau...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: Embora ele tanto.. me encante...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: Lá... encontro...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: Lágrimas, e despedidas inevitáveis.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: Confira a respiração dela'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: Por que você não responde? Eu quero morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: (Eles desligaram. Isso não foi.... o que você esperava)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: Lembre-se que, não há nenhuma maneira de voltarmos ao nosso país por trem ou avião.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: Como posso ajudar?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: Preciso enviar um turista de volta para casa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: Por que ele não vai de trem?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: É melhor esperar, até liberarem os vôos novamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: As balsas estão funcionando, mas não é seguro, o risco de fortres correntes de ar durante a noite não val o risco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: E, tem mais, a água reflete o sol no navio e a tripulação não aguenta ficar do lado de fora por muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: Então como é que eu vou despachar esse pobre coitado pra casa?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: Ele está morando comigo. Será que você consegue abrigá-lo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: Os trilhos se expandiram com o calor, é muito perigoso operar durante o dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: Os trens só funcionam pela noite, você não consegue ir tão longe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: Muitas transferências. É melhor aguardar a normalização da circulação de viagens aéreas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: Então como é que eu vou mandar esse pobre coitado para casa?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: Ele está vivendo comigo. Será que você pode levar ele até lá?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: Você só precisa esperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: Receio que não há nada mais que possamos fazer por agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: Ele não fala nem português
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: Tá de brincadeira comigo? Você é inútil
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: Não temos nenhuma pousada para ele se abrigar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: Não há nada que possamos fazer. Estamos tentando resolver o problema, mas ele não é o único que tá nessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: Ele não fala nem português
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: Tá de brincadeira comigo? Você é inútil
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: Escuta, nossa equipe está atolada em trabalho. Você deve estar sabendo que as verbas da embaixada foram cortadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: Estamos fazendo tudo o que podemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: Ah, uau, vocês são tão incríveis
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: Se é o que você diz, seu preguiçoso
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: Não precisa falar desse jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: Não podemos carregá-lo em nossas costas. Se você quer ajudar, faça por conta própria.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: Os cortes foram tantos que estamos basicamente trabalhando só pelo prazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: Ah, uau, vocês são tão incríveis
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: Eu odeio gente preguiçosa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: Não gosta da forma com que lidamos com as situações? Faça você mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: Boa sorte ao atravessar a fronteira com a verificação por Visitantes e o calor escaldante do meio-dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: Tá, obrigado
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: Vai se foder
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: Você está em casa e não no trabalho por quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: Quer vir até aqui mostrar como é que se faz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: Adoraríamos a ajuda de alguém que sabe mais do que todo mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: Tá, obrigado
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: Vai se foder
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: Me desculpe por perder a paciência.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: Você não é o primeiro a... ligar tão puto assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: Tenha um ótimo dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: E boas viagens.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: Espero mesmo que algum dia você sinta vontade de viajar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: Eu com certeza vou ajudá-lo nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: Janela para outro quarto. As pessoas faziam isso para economizar energia, para que a luz de um quarto iluminasse o outro.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: Então eles vedavam... mas só daquele lado.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: Não, eu não sou mais assim. Não, desde...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: Eu odeio dormir perto da mesa de cabeceira. Diversas lembranças ruins...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: Não entendi por que não está no canto do quarto. Achei que essa fosse a regra.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: Então... meu pai nunca deu muita atenção para as regras.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: Tótó. Basicamente o único brinquedo que eu tive quando criança.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: Bom, exceto os gravetos que eu usava para mexer na grama.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: Hehe. Os armários da vovó estavam sempre cheio de pratos.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: Ela só pegava o conjunto chique nos feriados. Mas, e agora? Quem precisa disso?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: Sinceramente, estou bem melhor sozinho.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: Posso conversar comigo, em voz alta.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: Uma dessas revistas onde você precisa encontrar um certo personagem no meio da multidão...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: Qual é o sentido? Queria que me deixassem em paz logo...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: 'Ele disse, naquela época: "Quando eu partir você vai decidir se vai querer ou não abrir aquela caixa."'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: Estou na indecisão por quinze anos. E ainda não sei o que fazer.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: Se sentindo só?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: Não tem ninguém para conversar? Se sentindo ansioso?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: A Roleta Telefônica é exatamente o que você precisa.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: Ligue agora em 891-533 e nós conectaremos você com a pessoa perfeita para conversar.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: A sua filha está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: Quem matou eles?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: Tome cuidado (Terminar ligação)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: A sua filha está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: Quem matou eles?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: Tenha cuidado (Terminar ligação)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: Para onde eles levaram o seu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: Ainda bem que não levaram a sua filha
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: O que é a FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: Tome cuidado (Terminar ligação)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: Para onde eles levaram o seu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: Ainda bem que não levaram a sua filha
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: O que é a FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: Tenha cuidado (Terminar ligação)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: Para onde eles levaram o seu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: Ainda bem que não levaram a sua filha
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: O que é a FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: Tenha cuidado (Terminar ligação)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: Olá, você ligou para a linha de apoio da FEMA. Como posso ajudar?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: O quê? FEMA? O que é isso?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: Do que você está falando?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: (Antes dela conseguir terminar, o grito alto de um homem atravessa a ligação)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: VOCÊ É IDIOTA?! DESLIGA O TELEFONE, AGORA!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: O que eu devo fazer com as axilas?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: O que eu devo fazer com as orelhas?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: Para certificar a acuidade das verificações nas axilas, você deve evitar qualquer tipo de contato com água.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: Evite tomar banho e lavar as mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: Orelhas? Espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: Vamos consultar a gerência e retornamos mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: Certo, por favor, especifique: Você consome fungos?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: Certo, uma última pergunta: houve algum derramamento de sangue na sua casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: Olá! Você ligou para a Roleta Telefônica. Conectaremos você com o seu par perfeito de conversa em breve. Por favor, aguarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: Oi, olá.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: Oi
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: Alô?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: Alô
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: Acho que não tem ninguém na linha...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: Eu... preciso conversar com alguém. Tem tanta coisa acontecendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: Tentei ligar para amigos e conhecidos, mas ninguém atende...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: Aí eu descobri a roleta telefônica.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: Talvez não seja o melhor lugar para se desabafar, mas é melhor do que nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: Eu sei que não é certo sobrecarregar um desconhecido com meus problemas, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: Você não imagina o quanto conversar com alguém me ajudaria. Eu me... sentiria tão melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: Te incomodaria me ouvir um pouco?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: Tudo bem
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: Eu não estou preparado para uma conversa demorada
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: Ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: Tá certo, desculpa se incomodei você.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: Tchau.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: Agradeço demais. Valeu mesmo!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: Acho que vai ser mais fácil se eu te contar um pouco sobre mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: O que você gostaria de saber?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: Onde você mora?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: Por que você decidiu telefonar para esse número em vez de chamar seus amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: Estou longe de casa, infelizmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: Ao tentar fugir do calor, busquei o local com a temperatura mais baixa que consegui encontrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: No meio do nada. É tão frio que trinca até o osso e nada cresce por aqui, nem grama'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: Um lugar relativamente seguro e bem distante de tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: Mas se existe algum lugar frio no inferno... talvez não seja tão ruim assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: Engraçado que eu geralmente não gostava do frio, mas, agora... parece uma bênção.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: Quero acreditar que a temperatura do sol vai diminuir e que tudo isso vai terminar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: Mas, estou perdendo a minha fé em um final feliz. O que acontece se o sol parar de queimar?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: Os Visitantes podem nunca mais desaparecer. Eles poderiam substituir as pessoas que nós amamos... e a gente nem desconfiaria...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: Por que você foi só?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: Você sente saudade da sua cidade?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: Eu adoraria ligar para eles, mas... Eu não sei como...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: O problema é que, eu fui embora da minha cidade quando as catástrofes começaram. Voei para bem longe do calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: Eu prometi para todo mundo que ligaria com frequência, para conversar com cada um e saber como eles estão...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: Mas, quando eu cheguei, eu não consegui contato com ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: Depois, eu descobri o motivo. A linha telefônica deles foi cortada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: A cidade inteira foi isolada do resto do mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: Agora eu estou em segurança aqui, mas todos os meus amigos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: O pensamento de nunca mais ver as pessoas que eu amo me aterroriza'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: Sinto saudade dos dias corriqueiros, quando a vida parecia ser mais simples e o futuro era algo que ansiávamos'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: Por que você foi só?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: Você sente saudade da sua cidade?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: Eu não queria, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: Na verdade, meu melhor amigo queria vir comigo, mas ele não conseguiu...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: Ele não tinha a documentação necessária para poder me acompanhar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: E quando a catástrofe aconteceu, ficou impossível de conseguir esses documentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: Ele estava arrasado... arrependido de não ter obtido os documentos antes. Eu queria ajudá-lo, mas não sabia como.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: Sinto saudades. Mas não muito da cidade, e nem das pessoas que ficaram...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: E o que mais sinto falta... o meu melhor amigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: Ele queria vir comigo, mas não conseguiu. E eu prometi que a gente manteria o contato e que eu ligaria para ele. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: Acho que ele estava apaixonado por mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: Ele se preocupava tanto comigo. Sempre apoiando, pronto para me escutar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: Aí, eu me dei conta que gostávamos um do outro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: Esperei ele se declarar. Eu queria que ele fizesse isso primeiro. Mas ele simplesmente não conseguiu... não conseguia encontrar o momento certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: Foi aí... a catástrofe começou, e não tinha mais tempo para isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: Me arrependo de não ter contado antes para ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: Bom, agora você sabe um pouco sobre mim. Agora é a sua vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: Não sou de falar tanto sobre mim...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: Eu nem sei por...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: Não fique acanhado. Estou aqui para escutar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: Bom... eu não tenho ninguém próximo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: Eu... sou uma pessoa solitária
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: Não se preocupe. Não tem nada de errado em falar sobre você'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: É... eu não tenho ninguém próximo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: Eu... sou uma pessoa solitária
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: Eu... tive uma relação complicada com o meu pai
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: Meu pai... Eu odiava ele
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: Eu não faço mais parte da família
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: E um certo dia, eu deixei de ser filho dele
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: 'Phone: E tudo o que me resta é essa maldita casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: Essa casa é tudo o que sobrou dele.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: Eu sinto muito por isso... Parece que você não está muito feliz por a casa ter ficado com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: 'Phone: Isso é verdade'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: 'Phone: Teria sido melhor se eu tivesse incendiado ela'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: Eu... eu nem consigo imaginar o que você passou.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: Não consigo imaginar o quanto você odeia seu pai para querer que a casa pegasse fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: Agradeço por ter conversado comigo.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: Adeus. E fique firme.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: Alô?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: Oi, posso falar com a sua filha?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: Oi, tudo bem a sua filha vir até aqui para brincar com a amiga dela?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: Como é? Por que você quer falar com ela?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: A amiga dela perguntou se ela pode vir pra cá
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: Tem uma menina aqui... o pai dela morreu
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: Ele... também era... um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: 'Phone: Como assim "também"?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: 'Phone: Não, uns lunáticos queimaram ele vivo, sem motivo algum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: Não se queima uma pessoa sem motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: Então ele era um Visitante... assim como a nossa garotinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: Eles queimaram ela, também.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: Lá mesmo, na creche.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: De primeira eu chorei. Queria me matar. Eu não conseguia viver sem ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: Mas, o meu marido me ajudou a superar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: E você vai superar isso... e aquela garotinha também.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: Você entende...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: Nada acontece sem uma razão.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: Se eles queimaram o pai dela... era para acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: E, chorar não vai adiantar nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: Por favor... diga isso para ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: Nossa garotinha... ela...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: Ela morreu...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: Nós tivemos que...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: Nós tivemos que matar ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: 'Phone: Quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: (Desligar)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: Nós matamos ela. Acredite em mim, precisava ser feito.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: Todos os sinais batiam... e, meu marido insistiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: 'Phone: Você... decidiu matar sua própria filha?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: Não venha me julgar!
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: Ela era um Visitante! Todos os sinais batiam, cem por cento!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: 'Phone: Porra...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: 'Phone: Eu entendo'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: Ela era um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: Todos os sinais apontavam para isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: Eu a conhecia até do avesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: Foi assim que percebi os sinais, imediatamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: Todos os sinais batiam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: Assim que eu contei para o meu marido, ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: Lidou com o Visitante, em um instante.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: Eu queria me matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: Mas aí, eu percebi... não era mais a nossa filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: Meu marido me ajudou a entender isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: Agora eu só me arrependo de não ter perguntado para a garota substituta o que ela fez com a nossa pequenina...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: Me desculpe.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: Não ligue pra cá novamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: Por favor... diga isso para ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: Por que eu estou me explicando para você?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972625
    m_Localized: 'Phone: Vai pro inferno!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972626
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972627
    m_Localized: 'TV: Mas... eu ainda sinto falta dela...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972628
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096192
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096193
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096194
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096195
    m_Localized: 'TV: A seguir, uma matéria exclusiva sobre a suspensão temporária do descarte de corpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 58690054376120320
    m_Localized: 'TV: Já disponível pelo serviço de entregas For Rest. Ligue agora em {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 58231803335401472
    m_Localized: Duas latas de ração de gato, por favor
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790080
    m_Localized: Um maço de cigarros, por favor
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790081
    m_Localized: Um vidro de kombucha, por favor
    m_Metadata:
      m_Items: []
