%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_zh
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh
  m_SharedData: {fileID: 11400000, guid: 1bdb57fba89c5124a83ad717d0443512, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: 这鬼天气热得人受不了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: 你感觉怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: 看来比我想的还糟*咳*该死……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: 我觉得我撑不过一个礼拜了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: 不过你让我进来，我确实感觉好受了那么一点点。谢谢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: 可我在这儿坐着……大伙都在外面送死。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: 我本来应该跟他们一起去的。反正我也没什么可失去的了，横竖就是个死……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: 这鬼天气热得人受不了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: 怎么不回家？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: 家里有孩子……可我……*咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: 不想吓着他们。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: 也不想*咳*让他们记得我这副模样。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: 就让他们以为我为了救火，早就死在……*咳咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: 死在林子里了吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: *咳*就让他们记得我认真负责，耐心配合集体工作的一面吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: 这鬼天气热得人受不了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: 制服呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: 上头收走了*咳*我们装备都不够。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: 好多救火的*咳*死在了前线……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: 收尸都来不及。大火*咳*把尸体都给烧了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: 可那些官老爷*咳*……只顾一件破制服……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: 他们发布命令像流水线上打马蹄铁似的。就是没一条为老百姓。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: 这鬼天气热得人受不了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: 山火怎么起的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: 最近森林干得厉害，*咳*一点就着。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: 这山火就跟*咳*地底冒出来的伪人一样，都是降临在我们身上的不幸。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: 可命运还给我们准备了更多的不幸……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: 现在痛快死了，说不定反而是好事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: 本来*咳*想当礼物带回家，还是给你吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: 这条项链……干巴巴的不好看。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: 是用把蜂蜜酿成阳光的死蜜蜂做的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: 这鬼天气热得人受不了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: 你脸色很差
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: 我……我就快要上路了……*咳咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: 我当初怎么不留下，非得跑？留下了起码还能多救几个人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: 留在那儿干到断气为止……官老爷就不用派那帮孩子去火场送死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: 狗娘养的官老爷！*咳咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: 太……太难受了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: 能最后给个火吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: 递上一支烟（给他一支烟）
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: 你该不会有烟吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: 没有，抱歉（不给他烟）
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: 俗话说得好，压死骆驼的最后一根稻草。*咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: （男人从口袋掏出打火机，点燃香烟，抽了起来。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: （他狠狠抽了一口，靠墙仰头。停顿片刻，继续说道。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: 能再跟大伙待一块儿就好了。抽着烟，聊着——'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *咳咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: 你不抽烟？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: 我知道，消防员抽烟不好。*咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: 不过现在抽不抽也没差了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: 我就想趁着还有口气*咳*放松一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: （男人倚着墙壁，仰头望着天花板说道。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: 我怎么就当了消防员呢……？我妈明明叫我去工厂上班的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: 当消防员根本不——'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *咳咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: 漫无目的地游荡，我要是能……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: 你在找谁？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: 我朋友。我们从小一起长大。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: 他出了意外。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: 有人雇他去山里挖矿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: 具体是怎么个事，我自己没搞懂，也不在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: 反正他挖着挖着闪了腰。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: 他在山里干活儿太拼命……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: 结果海鸥把他的……背……呃……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: 好吧，是屁股。海鸥把他屁股当成了窝。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: 哈哈哈哈。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: 抱歉……那是我脑子里的声音在说话。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: 刚才那个笑话它们讲得可精彩了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: 漫无目的地游荡，多希望我可以……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: 呃……你没事吧？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: 没事。我在等腿长回来。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: 你看，右腿已经开始长了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: 所以我要在这儿再待会儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: 我是说你脑子里声音的事
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: 好吧……
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: 没听懂吗？我那是在开玩笑。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: 还以为你一下就能反应过来。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: 看来不好笑。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: 你刚才是问我怎么样是吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: 谢谢，你人真好！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: 从来没人问我感觉怎么样，过得好不好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: 就因为我没了腿，还有对赛车手才有的车轮子？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: 没人会说实话。问题就在这儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: 他们总是找借口，说就随便看看我的腿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: 直勾勾盯着看也很讨厌。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: 但是当我的残疾不存在更蠢。嘁，这不一看就知道的事么。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: 说到底，这儿需要的是平衡。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: 可这座城市根本没有他妈的平衡。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: 你有没有想象过，用轮子走路是什么感觉？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: 靠，我不是这个意思……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: 是说你没了腿，只能靠轮子。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: 没错！你连家门都出不去！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: 怎么上下楼梯？怎么过马路？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: 外面那破路修的，都歪七扭八的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: 你家没台阶也没门槛，我活动起来倒方便。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: 我只有一个心愿……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: 希望你家建在斜坡上。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: 现在坐着轮椅冲下去肯定特带劲。当然也会撞墙，不过无所谓啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: 跟你说，我可喜欢赛车了。可惜在你这儿没法玩。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: 等会儿，你刚问我过得怎么样来着。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: 还不错。多谢关心'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: 漫无目的地游荡，多希望我可以……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: 你中暑了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: 跟中暑有什么关系？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: 我头发没烧焦也没掉过。好着呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: 没腿怎么坐轮椅赛车？这都不明白？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: 没有腿，怎么减速刹车？怎么过弯？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: 你连轮椅都没有，怎么可能明白？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: 你真信这个？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: 你为什么觉得腿会长回来？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: 信啊，怎么不信！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: 没听过老话吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: 右腿迈的步子更大，我们走起路来才一直绕圈。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: 瞧，我的腿就是证明。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: 反正都一样，根本逃不出这个循环，只能一直绕圈。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: 今天结束，还有明天。但真的有哪一天是没过过的新日子吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: 去他的。横竖都一样。我就活在这循环里。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: 说到底，你和我真的有区别吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: 你不也是在绕圈子吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: 我们活在充满奇迹的世界里。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: 虽然目前为止全是不好的奇迹。但是！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: 不好的奇迹迟早会结束。接着就会迎来美好的奇迹。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: 上帝宽恕了无数信徒，说不定也有好事在未来等着我们。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: 自由地游荡，希望我能成为那个世界的一部分……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: 你的腿是怎么没的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: 我跟你说我有个朋友进山里挖矿去了，记得吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: 后来嘛……他决定在院子里挖条沟。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: 他觉得自家屋子底下有条全是肉的隧道。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: 他买了台手摇钻之类的玩意儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: 然后就开凿了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: 妈的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: 那大概是我最后一次见他。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: 自由地游荡，希望我能成为那个世界的一部分……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: 那你的腿呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: 去他妈的腿！我只想知道他挖到想找的东西没。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: 算了，当我没问。
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: 对，想起来了。我当时想去喝点啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: 结果摔了一跤，让电车轧断了腿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: 等等……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: 不对，不是这么回事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: 你怎么不说话？不感兴趣？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: 算了，不讲了。没必要。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: 这儿闷得透不过气……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: 你不是带着孩子吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: 嗯？是带着啊。可能跑到别的什么地方玩去了吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: 我得弄明白其他几个孩子去哪儿了，有没有出事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: 有电话吗？我想打给孩子他爸聊，这样就不用再看他那张丑得要死的脸了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: 这儿闷得透不过气……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: 怎么样，给你丈夫打电话了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: 打什么？他只会支支吾吾，跟个局外人似的。孩子，房子，还有钱，这些事都是我一个人在操心，他管都不管。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: 我有时觉得我是在忍着他，他也是在忍着我，只不过他没先一步离开而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: 可能是觉得我好使唤吧，也可能是怕我哪天会追过去，跟他算账。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: 天啊，我好累……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: 这儿闷得透不过气……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: 你去见过你丈夫了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: 什么？我连床都下不了。浑身疼，没力气，有时觉着自己活到现在就是凭着股怨气。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: 孩子，丈夫，还有整个家，什么都压在我一个人身上。不过他偶尔也会做那么一两件事，让人觉得日子还能再熬一熬。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: 改天再说吧。我得歇会儿，实在没力气了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: 这儿闷得透不过气……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: 他做过哪些事？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: 有这么件事……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: 他以前经常开车带个女人出去。这事我知道，不过起初忍着没说什么，后来就天天拿这事数落他。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: 我说你肯定出轨了。他后来就换了份工作，跟那女人彻底说拜拜了。这么看来，他还是爱我的吧……？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: 嗐，说不定都是我瞎编的。总之得休息了，改天聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: 这儿闷得透不过气……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: 你就不担心孩子出事吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: 怎么不担心……不过我作为当妈的，可能还不够担心吧。我刚要第一个孩子那会儿……都不知道自己要做什么，搞得一塌糊涂。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: 以为等有了第二个孩子，就不会那样了。结果还不是一样。后来又有了第三个，第四个……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: 医生说我不能生育。可老二出生了……我管他叫世界第八大奇迹！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: 但是后来……就变得很可怕了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: 我……我得歇会儿……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: 这儿闷得透不过气……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: 什么可怕？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: 实在说不出口……我爱他们，可是……有时候会突然发火、吼叫，甚至对他们动手。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: 我知道这样做很不好，后悔得要命……但你知道吗，我现在头一回觉得轻松。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: 他们不在跟前，我总算能喘口气……这话不该说，但我确实觉得现在这样好多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: 操他妈的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: 怎么样？冷静下来了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: 是啊，我消气很快。但只要想起那些破事，火气立马又蹿上来。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: 我以前随和得很，没那么容易让人惹毛或者跟人急眼。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: 现在一点就着，直接炸翻天。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: 再说了，我凭什么要心平气和？说不定这股火气才能让我保持清醒。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: 我起码没像那帮蠢货一样整天崇拜太阳。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: 他们怎么会觉得太阳能救我们？那玩意儿明明在要我们的命。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: 照这样下去，大伙全得完蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: 这帮白痴明白这个道理吗？肯定不明白。好了，我现在没事了，真的冷静了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: 多谢你听我唠叨。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: 操他妈的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: 你这火气到底从哪儿来的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: 连我自己都搞不清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: 发生的每件破事都让我火大。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: 还有那群邪教徒，满嘴谎言的混账东西。就想着骗更多人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: 关键还真有人信！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: 连自家孩子嘴里最后一口吃的也肯抢了拿去当贡品。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: 就为讨好他们那个狗屁不通的地狱救世主。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: 一群疯子，还想用那套鬼话洗脑正常人……比如我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: 算了，我现在挺冷静。心里好受多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: 操他妈的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: 邪教抢走你什么人了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: 不是抢，问题就出在这儿。她是自己过去的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: 我老婆……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: 世界还没乱套那会儿，她就特别虔诚。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: 但我爱她，也就接受了她这一点，这事从来没影响过我们的感情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: 世界乱套以后，她就在那个什么新救世主身上找到了新信仰。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: 那帮混账邪教徒的花言巧语，她听着觉得句句真理。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: 后来是一天比一天疯，信那些我都搞不明白的鬼东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: 等我反应过来自己都干了什么，她早就吓得逃走了。太迟了，什么都改变不了了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: 操他妈的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: 你和你老婆到底怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: 我老婆那天说要入教。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: 我……我简直不敢相信。我爱过的女人……如今变得这么陌生。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: 我们的感情对她来说毫无意义了。我生气呀，气坏了，这辈子没那么气过。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: 我开始觉得她从来没爱过我，一直在想办法从我身边逃走。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: 想到这个我就恶心难受，拳头自己攥紧了，然后我就干了我这辈子都没法原谅自己的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: 我打了她……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: 说什么都晚了。如今，她人在邪教里，我呢……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: 这辈子都迈不过这个坎……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: 操！我恨透了自己！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: 我有火就冲自己撒，不会伤害身边的人。我活该，罪有应得。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: 上别处去吧，我得一个人待会儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: 要占卜一下吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: 你怎么会知道我的这些事？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: 哈！你真有意思……不是我知道，是群星知道。它们只是借我的嘴说出来罢了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: 月亮正位于你第六宫的金星位。命运从未开口，但这些都写在你脸上了，明白吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: 我以前认识个人，跟你一模一样。他说的少，听的多。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: 知道吗，木星落入第八宫时，最好一句话也别说。那意味着命运之门已然紧闭。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: 要占卜一下吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: 那个人后来怎么样了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: 我跟他说，关键不是你做了什么，而是你做这件事的时候，围绕在你身上的是什么能量。可他就是不信我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: 于是，宿命就这么跟他擦肩而过了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: 我有天闭上眼睛，观想一个愿望。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: 倾注所有能量，努力想象那个愿望的细节。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: 都不肯对能量敞开心扉，那为什么还要苟活在这具躯壳里？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: 你也可以试试。闭上眼睛……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: 想象你已经得偿所愿……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: 深深凝视那个画面……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: 你知道自己为什么痛苦吗？因为你还没有领悟到真谛，那就是痛苦是至高的欢愉。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: 那么……你准备好迈出那一步了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: 要占卜一下吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: “准备好”什么？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: 选择真实的自我。闻到了吗？那是你没得到满足的欲望的气味。该把它们都释放出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: 我当年陷入人生低谷，找不到一丝光明和意义，导师告诉我：“你没有聆听自己的海洋。”'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: 起初我还笑了一下，海洋，什么海洋？! 可我闭目凝神，竟然真的听见了。那海洋一直就在那儿，你也能听得见的！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: 但最关键的，是要问自己，有没有准备好与真我合而为一？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: 要占卜一下吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: 你的导师是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: 一位伟大的女性。她如同暴风雨中的灯塔，教会我洞见万物本质。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: 我永远记得她的话：“人们死去，只因未能学会呼吸内心的光。”'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: 她让我明白，我可以帮助别人找到属于自己的路。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: 可惜……她不敢再向前走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: 她看不见自己站在中央。但人必须居于中心，明白吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: 你如果不是自身宇宙的中心，那你是谁？你懂我什么意思吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: 要占卜一下吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: 你是怎么自救的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: 所有错误不过是你尚未破译的宇宙密码。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: 我走过了很长一段路。看看四周，再往回望望，看出来这房子现在是什么模样了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: 明亮、开阔，与我的能量和谐共鸣。不必与房屋对抗。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: 房子早就吸收了你的恐惧。接受它吧，不然墙壁会为你流泪。明白了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: 要占卜一下吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: 你到底要我怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: 亲爱的，你以为我有所图谋？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: 问题就在于，你能看见自己阴影的舞姿，就会明白道路藏在何处。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: 你只需诵念幸福的正向肯定的话。感受到万物的变化了吗？呼吸是不是变轻快了点儿？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: 那是我的能量正与你的空间交融。别追寻意义，那只是畏惧接受混沌之人的幻梦。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: 我要你成为这空间的一部分，说：“我并非客人，而是造物之主。”'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: 要占卜一下吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: 我要是不想成为造物主呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: 这些墙壁早想拥抱你，却被你用控制的锁链禁锢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: 你内心的寂静，正是被恐惧扼杀的世界之音。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: 你的能量如冬天的蜜糖般凝滞，需用呼吸融化。镜子从不说谎。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: 只能看见镜子里的自己，那就等于什么都没看见。你只需要把能量往右边转三度。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: 就能抵达幸福彼岸。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: 我在听，人类。说吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: 你是什么教派的信徒吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: 没错人类！但我的信仰和你知道的那些不一样——'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: 我侍奉的是神圣太阳本身！因为它保护着我们！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: 愚蠢的人看到太阳，只会觉得太阳是不好的，以为它会烧光一切……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: 放屁！它的怒火只会烧向邪恶之种和异教徒！因为那些人都是罪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: 愿那些不认同的人永远感受不到太阳正义的灼烧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: 这帮人分明是自己要惹事，回头真烧起来了又要惊讶。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: 邪恶之种？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: 异教徒？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: 你还在问？难道你不知道伪人是谁吗？！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: 很好人类。我就把真相告诉你吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: 那些伪人就是邪恶之种！！！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: 他们是外星人的后裔。天上的太阳还很年轻，地上的草也更绿的时候，那伙外星人就来到了地球上！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: 这群混账走狗在地球上安家，近亲繁殖了几百年！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: 他们现在爬出来，想抢走我们的土地，就好像这地方是他们的一样！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: 但太阳决定保护我们，因为这里本来就是我们的地盘。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: 太阳对伪人绝不留情！不然他们为什么成天躲在地底下？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: 靠……你那天晚上干嘛喝个烂醉……？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: 你真没必要把自己灌得不省人事。神圣太阳那正义的怒火，它……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: 神圣太阳啊，请让他的灵魂安息，宽恕他的罪孽，将他纳入你慈爱的怀抱中。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: 顺便也接纳下他种的榕树的灵魂。他死了，就没人给榕树浇水了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: 阿门。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: 听好了人类！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: 应急中心就是群杀千刀的异教徒！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: 我们人类无法控制的进程，他们也想插手！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: 就爱多管闲事！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: 愿太阳诅咒那些把我妈扔进水沟的杂种。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: 我在听，人类。说吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: 可太阳已经烧死了很多人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: 你说得对。可烧的都是邪恶之种，人类！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: 人类上千年来，犯下了数不清的罪，太阳终于决定要惩罚人类了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: 而伪人，那群混账东西，竟然想染指太阳！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: 不过太阳可不是给那群地底下的移民准备的，是给我们人类准备的！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: 太阳是我们的！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: 是赐予人类的福祉，靠！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: 还要烧死多少人才能平息太阳的怒火？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: 你是说世界末日就是太阳的正义审判？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: 多得数不清！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: 朋友，你信我一句，这一切远未结束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: 一切才刚刚开始！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: 就目前这个规模，还没法跟宇宙的力量达成平衡！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: 散发着正义的火焰的太阳，还得烧更多东西才行！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: 但是我告诉你，朋友，这些牺牲都不会白费的！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: 终有一日，我们会明白太阳真正的意图……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: 唉，夜里偶尔想起老婆离开的事，我就难受得要命……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: 她是个圣洁的女人……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: 可也是个贱人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: 末日？谁的世界末日？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: 你说我们？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: 哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: 别逗我笑了。太阳是站在我们这边！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: 太阳在帮我们，你看不出来？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: 它是在赶跑那群想从地下爬出来的伪人……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: 替人类清算犯下了累累罪行之人……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: 让那帮躲在面具后面，裹了一身尿水破布的异端原形毕露。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: 我们应该感谢太阳，而不是鼓吹什么人类世界的末日。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: 不是我们的末日，是太阳的敌人的末日！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: 地底爬虫去死！粪污异端去死！邪恶之种通通去死！！！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: 天啊，我好久没吃过炸土豆了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: 我在听，人类。说吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: 你觉得这一切有什么神圣的意义吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: 人类，我为什么要掰开了揉碎了全解释给你听？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: 难道就是为了听你原封不动再问一遍吗？！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: 人类，是我看错你了。你根本不明白眼下发生的这些事，背后真正的缘由是什么……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: 靠，真想喝杯冰啤酒……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: 人类，最后请我喝一杯如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: 好，拿去吧（给他啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: 没啤酒？你脑子进水了吗人类？！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: 我明明亲眼看见的！！！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: 人类，得了吧你，明明有这么多啤酒，居然舍不得分我！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: 我没有啤酒（不给啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: 啊……真不错……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: 唔，好喝。黑啤，我最喜欢了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: 让我想起和伙计泡酒吧的日子。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: 冰啤酒、面包棒，还有酱汁，聊得昏天黑地……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: 还有那个瘦皮猴，总阴沉着脸盯着我们，一脸不满意的样……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: 算了，也没什么可恼的。人类，你蠢是蠢了点，但心眼不算坏。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: 送你个小礼物表示感谢吧。拿着。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: 愿神圣太阳拯救你的灵魂！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: 你这杂种！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: 下地狱去吧狗杂种！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: 忘恩负义！我给他讲解神圣真谛，他居然……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: 你就是个邪恶，愚不可及的人类！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: 去你的。就在你这破屋里烂掉吧！老子另外找个好去处！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: 等着瞧，他们迟早会让我回酒吧的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: 祝你住得愉快，白痴。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: 嘿嘿，真希望这一切快点结束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: 你的房子是怎么没的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: 啊……那天我记得很清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: 刚被炒鱿鱼，只想回家躺床上大哭一场。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: 进门就看见玄关堆满靴子，还以为是室友来了亲戚朋友。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: 我往她房间走，想看看怎么回事，刚到门口，就听见里面传来奇怪的声响。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: 这动静弄得我有点紧张，我就打算静静地往里瞥一眼，看看到底出了什么事 。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: 刚瞥见室友一动不动地躺在床上，忽然……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: 背后冒出个邋里邋遢的男人，他抓着我说：“你不能进去，她……身体不舒服。”'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: “我们最好去厨房坐着说。”他就这么拉着我的胳膊，把我押到了厨房，让我跟他一起坐在了餐桌旁。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: 我想逃走，但吓得动弹不得……然后……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: 我……他……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: 我得歇会儿再说，太焦虑了，肚子里一阵翻江倒海的，哎哟……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: 嘿嘿，真希望这一切快点结束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: 后来你家又发生了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: 呃……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: 那个人押着我在厨房餐桌旁坐下，有个躲在角落的大块头就窜了出来，堵住了去路。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: 他们两个大声聊起天来，就……就跟我这人不存在一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: 然后……然后他们就开始碰我！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: 摸了摸胳膊又摸了摸肩膀……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: 就在这时，我听见我房间里传出来欢呼声，还有一阵响亮的笑声……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: 里面好像挤满了人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: 我觉得呼吸困难，心都快从嗓子眼里跳出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: 想大叫求救，可我吓坏了……硬是一点儿声音也发不出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: 只能跟个破泰迪熊布偶似的坐在那儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: 大块头去冰箱拿东西，我意识到机会来了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: 我起身冲向大门。恐惧这时候反倒给了我力量，我跑啊跑，头都没回。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: 一直跑到精疲力尽，累倒在地上……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: 太阳为什么没烧死你？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: 后来呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: 我记不清了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: 八成在地上躺了一晚上吧，然后……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: 奇怪……我应该记得的才对……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: 等等……你该不会觉得我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: 我说不定就是个伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: 不……不可能！我还记得我迄今为止的人生，记得我爸妈，我小时候的事……肯定搞错了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: 我不是伪人对不对？快说我不是！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: 我不知道
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: 你不是伪人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: 你很像伪人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: 我当时躺倒在地上，然后……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: 然后……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: 我肯定记得，怎么可能忘了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: 等等……你该不会觉得我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: 我说不定就是个伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: 不……不可能！我还记得我迄今为止的人生，记得我爸妈，我小时候的事……肯定搞错了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: 我不是伪人对不对？快说我不是！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: 我不知道
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: 你不是伪人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: 你很像伪人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: 你怎么能这么说？！天啊，我好害怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: 得歇会儿，又反胃起来了，哎哟……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: 谢谢，我感觉好点了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: 呃，得歇会儿，又反胃起来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: 你怎么能这么说？！我更害怕了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: 我不想死！真的不想！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: 我们都会死。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: 嘿嘿，真希望这一切快点结束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: 你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: 别过来！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: 对不起，我……我以为你要杀我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: 你怎么会这么想？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: 要杀你我早动手了
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: 根本分不清谁是伪人……万一……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: 万一你才是伪人呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: 你会杀了我吗？会不会剥我的皮？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: 求你别折磨我！要杀就痛快下手！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: 我不想在痛苦中死去！求你了！！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: 别紧张，我不是伪人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: 我不会杀你的
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: 抱歉，我太紧张了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: 已经不知道能相信谁了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: 要是……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: 万一你才是伪人呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: 你会杀了我吗？会不会剥我的皮？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: 求你别折磨我！要杀就痛快下手！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: 我不想在痛苦中死去！求你了！！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: 别紧张，我不是伪人
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: 我不会杀你的
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: 怎么证明？！我还没检查你的牙齿和眼睛……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: 我们都会死，不是死在伪人手里，就是让太阳活活烧死……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: 没希望了，眼前只有死路一条。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: 你走吧，别管我了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: 怎么证明？！我还没检查你的牙齿和眼睛……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: 我们都会死，不是死在伪人手里，就是让太阳活活烧死……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: 没希望了，眼前只有死路一条。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: 你走吧，别管我了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: 嘿嘿，真希望这一切快点结束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: 你怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: 伪人！伪人来了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: 没听见吗？死亡在召唤我们！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: 伪人也好人类也罢……有什么区别？！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: 死亡面前我们都一样！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: 反正该来的总会来，为什么还要边等边受罪？迎接伪人吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: 伪人做的事都是为我们好！迎接伪人吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: 你不太对劲
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: 你疯了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: 不！我是顿悟了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: 我就是伪人！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: 人类和伪人本是一体！我们如此相似！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: 就像镜中倒影！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: 和我们一起迎接死亡吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: 你根本不明白自己在说什么
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: 这是逼我动手
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: 我没疯——我是顿悟了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: 我就是伪人！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: 人类和伪人本是一体！我们如此相似！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: 就像镜中倒影！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: 和我们一起迎接即将到来的死亡吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: 你根本不明白自己在说什么
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: 这是逼我动手
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: 不，是你不明白！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: 死亡将至！太阳就是死亡临近的预兆！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: 我们很快就要面对死亡了，很快……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: 开枪啊！还等什么？！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: 杀人不会愧疚吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: 无所谓了，做你该做的吧，人类。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: 有事吗？你想问什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: 他们为什么把你赶出了酒吧？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: 大家都让这接二连三的灾难搞疯了呗。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: 太阳爆炸，伪人，还有经济危机，没完没了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: 反正大家都行为失常了。有的人是压力太大，有的人是喝多了酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: 至于我……我是给气的，气昏头了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: 我站在酒吧桌上大喊：“别他妈什么都怪环境，守住人性的底线！”'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: 眼泪混在啤酒沫里算什么，麦芽和啤酒花的味道配着点儿咸味才叫好喝。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: 呵，谁在乎呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: 有事吗？你想问什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: 你来我这儿，跟之前在酒吧里，有什么不一样？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: 我这回谁也不招惹了。不值当。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: 可我一看电影，一听到别人说话聊天的声音，心里那股劲儿就又起来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: 然后就问自己：有这个必要吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: 没有。我脑子里的弦早就绷得快断了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: 没有这堆破事，这日子也过得够没劲的了，可现在……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: 我总有一天会够到那盏吊灯，高悬在这个受洗的世界之上。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: 有事吗？你想问什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: 你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: 嗯？为什么这么问？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: 你身上有股味道
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: 发烧了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: 这个……我偷喝了点儿你的啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: 不舒服，就想喝两口，不犯法吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: 都乱了套了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: 大家都在说什么要解决问题，其实满嘴空话，什么都做不成。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: 我觉得我们说不定很快就要完蛋了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: 不是让太阳烧死，就是让伪人弄死。我们哪怕解决了伪人，也会自掘坟墓。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: 没问题要解决，就给自己制造一堆问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: 就好像不丢人现眼一回就活不下去似的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: 靠。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: 走开，我难受得很。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: 我没烧，烧的是这个破星球。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: 你好好瞧瞧，不是这边死人，就是那边冰山融化，再不然就是森林起火。整个世界都在发烧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: 地球想甩掉我们这些吸饱血的跳蚤。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: 它总有一天会彻底甩掉的。你就等着看吧，后边还有招呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: 呃啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: 求你了，滚远点儿，我不舒服。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: 有事吗？你想问什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: 感觉好些了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: 老兄啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: 我们都要死，谁也逃不掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: 你有没有想过，人死了以后会怎么样？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: 信仰决定答案
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: 什么也没有
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: 不知道，说不定会飘到太空去
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: 有一定道理。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: 但我一点儿也没觉得好受。知道为什么吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: 人快死了，大脑感应到了，就会自动播放美好的回忆。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: 可等到做梦的力气也消失了，又会怎样？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: 没有。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: 希望你能说点别的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: 你说的可能是对的，但是这也太可怕了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: 什么都没有……只剩……一片黑暗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: 现在不想聊这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: 仔细想想……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: 宇宙里只有人类这一个生命。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: 也就是说除了人类，只剩下冰冷和空洞。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: 要真有别的生命，估计早就发现了什么信号之类的了，我不知道，反正就那样。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: 死后去宇宙，那就是去到一片什么都没有，只剩无边黑暗的地方，那跟消失有什么区别……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: 我……想一个人静静。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: 有事吗？你想问什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: 你……还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: 酒吧起码天花板够高。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: 适合上吊。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: 这儿太窄了，整个星球都挺窄的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: 兄弟，我只想结束这一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: 全都乱套了，随便一件事都能吓得我屁滚尿流。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: 实在受不了了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: 我为什么要来这儿？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: 我想休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: 你需要什么吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: 为了让他活下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: 我需要的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: 需要的就这么多。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: 我能给你倒点水吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: 你想吃点东西吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: 就想坐在水龙头边。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: 渴了我会喝的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: 那我不打扰你了。
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: 我可以坐你旁边吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: 我不饿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: 就想坐着。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: 那我不打扰你了。
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: 我可以坐你旁边吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: 你为什么非要去死？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: 你还跟我保证了，说一切都会好起来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: 你说过一切都会好起来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: 然后你就死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: 只留下我一个人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: 你为什么要这样？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: 我想和他待在一起。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: 人死不能复生。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: 我想埋都……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: 埋不了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: 我想埋你都埋不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: 我该怎么办？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: 我想休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: 他是怎么死的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: 不行。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: 太沉重了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: 我已经哭不出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: 好像已经没什么好哭的了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: 但是真是这样吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: 别哭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: 必须找个地方给埋了
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: 他的灵魂已经没了，剩下的就是个躯壳。你必须接受这个现实
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: 不要……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: 不要，我不信！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: 我还没准备好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: 他们才刚把他还给我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: 现在就又要分开了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: 我做不到。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: 我不会把他交给那冷漠无情的土地。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: 不对。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: 不是这样的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: 他还听得见我说话。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: 我很想相信是真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: 我想休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: 你还记得他什么事吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: 我们有一天去朋友家玩，大家聚在一起聊天喝酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: 那会儿，我们都还很年轻。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: 他平时挺闷的，碰到这种场合，话都不怎么多。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: 那天我们喝了不少。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: 他本来跟往常一样，闷着不说话。可忽然就开口说了一句：'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: “给我把吉他，我要唱首歌。”'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: 他弹得特别好。我真的很喜欢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: 朋友开始点歌，他就坐在那儿，沉默了一下，然后……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: 然后他站起来，说他得走了。起身时没注意，打翻了杯子，想接没接住，连吉他也掉了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: 后来我才知道，他只学了一首歌，就是为了让我高兴。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: 我现在还留着那天晚上的照片。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: 就是有点儿破了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: 你给我唱完了最后一支歌，再也不能给我弹琴唱歌了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: 我想休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: 他到底是怎么回事？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: 他死了，死透了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: 我明白了，对不起打扰你了
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: 人又不是我杀的
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: 对不起，我就是……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: 我每天晚上都会哭，根本停不下来。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: 但最让我放不下的，还是那帮混账东西，全赖他们……都让太阳活活烧死才好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: 那……到底发生了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: 不好意思，我不问了
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: 是，我知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: 我刚刚那么说太没礼貌了，但要我跟人说他的事，真的很难开口。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: 希望那帮混账都遭报应。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: 有人杀了他们才好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: 那……到底发生了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: 不好意思，我不问了
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: 我丈夫身体不太舒服，就去了医院，但他们把他转到了那帮混账东西那儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: 我们去了应急中心开的那个什么中心。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: 他们直接把他关进了隔离区，拿走了手机，说三个礼拜后就放他走。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: 我提前去看了一眼。只是想确认一下情况。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: 他们就冷冰冰地……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: 我缓一缓，对不起。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: 他们说：“他死了。”'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: 就这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: 不让我见尸体。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: 不让我把他带回家。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: 但那帮蠢材做什么事都是乱七八糟的，我换了身白大褂，就进了停尸房。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: 然后他……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: 他真的在那儿……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: 他们杀了他，亲手夺走了他的灵魂。我只能放声尖叫和咒骂。我什么也不在乎了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: 我想一个人待会儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: 好，谢谢你。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: 我没有他真的快活不下去了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: 我想休息一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: 怎么了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: 我今晚就走。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: 我早就说过，不会久留。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: 只是找个地方喘口气。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: 接下来有什么打算？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: 回去找家里人吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: 我不想去想这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: 我要回家。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: 拿出吉他。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: 然后……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: 你可以留下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: 祝你好运
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: 已经没人了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: 我们要回家了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: 我什么都不想要。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: 你可以留下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: 祝你好运
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: 为什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: 你这么说，我也不会好受。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: 没有针对你的意思，我对你没什么感觉。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: 真的只想回家。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: 没回到家，我什么都不想做。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: 谢谢你。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: 你话不多……不过跟你聊天确实挺舒服的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: 希望你能找到你要找的东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: 嘿嘿，怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: 大灾难发生之前你是做什么的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: 噢～问得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: 你听说过……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: ……体育博彩吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: 你啥啊，骗子？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: 嗯
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: 哎，拜托！我是他妈的体育分析师。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: 你要知道我手里过过多少钱，怕是口水都要流下来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: 我是专业人士，傻逼。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: 别人拿着钱来找我，回头就能翻个五倍……不对，十倍！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: 那你到底赚了多少？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: 你这也叫工作？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: 我就靠这个吃饭。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: 鼓捣赌球说白了就是给自己找个活儿干，真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: 我有办法能坑庄家。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: 押个特定的球队，等着钱哗啦啦滚回手里就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: 没钱也没关系，找人借就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: 那你到底赚了多少？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: 你这也叫工作？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: 怎么说比较好……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: 我挣了三千万的……靠……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: ……三千万的债。对，不是挣的是欠的，不过我才不在乎欠没欠钱。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: 眼下都这样了，欠钱这事儿我就更不在乎了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: 我可是敢直视危险的男人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: 你开玩笑呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: 怎么就不是工作了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: 我甚至还有个专门的地儿，特奢华那种……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: 有张闪闪发亮的沙发，还有本笔记本，上面记着庄家名字、欠款数额和净收入。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: 嘿嘿，怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: 追债的还没找上你？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: 追债的？你啥意思，啥追债的？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: 呸。别提他们了。我现在可没啥债了。太阳已经替我清账了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: 银行也早就不干活了，以后说不定都不开了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: 啥意思呢？意思就是老子自由了，可以鼓捣新生意了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: 赌球那套早过时了。得想个新的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: 太阳真是你的福星啊
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: 这么说，你还想再鼓捣点什么生意？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: 哎呀，拜托。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: 反正以后还能把亏的钱赚回来，没什么大不了的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: 但现在，我可以重新开始了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: 对了，我现在有新点子。你想听不？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: 什么计划？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: 没兴趣
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: 我前一阵想出来个赚钱的方法。你想听，我可以告诉你。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: 什么计划？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: 没兴趣
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: 现在基本上是应急中心说了算。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: 我们得……就是……搞好关系，懂不？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: 我觉得啊，我们定期交人过去，他们说不定会让我们进地堡。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: 你懂吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: 你想把人交给应急中心？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: 你真觉得应急中心会救你？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: 对啊，为啥不呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: 我觉得这样我们就能活下来。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: 时代不一样了，生意自然也得变。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: 跟着大群人进隔离区通常都没啥好下场。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: 所以才得跟应急中心搞好关系。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: 别顶撞他们，该交人交人……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: 兴许还应该打打热线电话，说说什么检查特征之类的，让他们知道我不是那种……叫什么来着？哦对，伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: 他们是好人，大概知道该怎么做。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: 有点道理
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: 胡说八道
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: 你要那么想去找他们，那你赶紧滚蛋。
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: 靠，时代变了，你真一点儿也没感觉出来？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: 咱得看清谁掌控局势，跟着他们混。赢面才大。真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: 所以才得跟应急中心搞好关系。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: 别顶撞他们，该交人交人……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: 兴许还应该打打热线电话，说说什么检查特征之类的，让他们知道我肯定不是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: 他们是好人，大概知道该怎么做。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: 有点道理
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: 胡说八道
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: 你要那么想去找他们，那你赶紧滚蛋。
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: 我说的那还能有错？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: 我有种第六感，知道什么生意能挣钱。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: 相信我，跟着我你不会亏。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: 哎呀，得了吧。你真他妈胡说八道。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: 以前人家都得花钱来听我说投资建议，我现在一毛钱不要你的，当礼物白送你，你还……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: 靠，你下地狱去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: 怎么，你还想赶我出去？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: 我还以为你人挺好呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: 我都跟你分享我赚钱门路了。结果你……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: 你下地狱去吧，我要回家了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: 靠，我那赚钱的点子其实真不错。算了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: 改主意了记得告诉我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: 嘿嘿，怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: 你想干嘛？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: 听着，我想出个新门路，绝对行，真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: 好吧，你看啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: 太阳特别大，外头跟蒸桑拿似的，是吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: 我猜臭氧层可能出问题了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: 但我记得，氧气是阳光透过臭氧层产生的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: 你猜我想到啥了？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: 卖空气！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: 这才叫生意，相信我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: 一般人这辈子都想不出这么好的计划。
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: 我这辈子没听过这么荒唐的计划
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: 你真这么觉得？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: 嗯，你应该去当科学家
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: 没有
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: 靠，那……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: 谢了。好歹还有人认同我聪明。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: 我用不了多久就要拿达尔文奖了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: 你……你知道达尔文奖是啥吧？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: 噢，你肯定能拿奖
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: 呃……是那种给什么科学贡献的奖之类的吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: 你问这个干嘛？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: 随便问问
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: 达尔文奖是颁给蠢死的人的
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: 哈哈！我能感觉得到，科学界肯定会表彰我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: 一大笔钱，还有地位和一大堆女人……太妙了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: 好了，等一切结束，我就去申请卖空气的专利。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: 好吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: 啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: 等会儿，你是在耍我吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: 妈的，我这可是动真格在想计划，你还取笑我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: 妈的，我这可是动真格在想计划，你还取笑我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: 我会拿到达尔文奖，然后变成有钱有势的牛人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: 到时候你就会跪在我脚下求我原谅……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: 说对不起，不该说“你那点子真他妈烂”。
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: 靠，伙计……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: 听我说两句话就这么难吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: 随便吧，操。我没你照样能赚到更多钱。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: 靠，伙计……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: 妈的，我这可是动真格在想计划，你还取笑我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: 我会拿到达尔文奖，然后变成有钱有势的牛人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: 到时候你就会跪在我脚下求我原谅……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: 天杀的……这么说来，全是真的……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: 那我之前说的就都说得通了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: 白天别出门。不过你得让别人进屋里来。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: 为什么我要让陌生人进我家？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: 让人进来？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: 我知道你平时跟人保持距离，但你这回必须得放人进屋。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: 至于为什么不能一个人待着，我表姐也不确定……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: 但她提过，只要有人问你是不是一个人在家，就要说不是，还得说屋里有人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: 别人对我来说就是个麻烦
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: 多几个人又能怎样？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: 是啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: 我知道你不喜欢跟人待在一起，但你这回必须得放人进屋。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: 至于为什么不能一个人待着，我表姐也不确定……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: 但她提过，只要有人问你是不是一个人在家，就要说不是，还得说屋里有人。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: 别人对我来说就是个麻烦
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: 多几个人又能怎样？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: 我知道，放人进屋对你来说不是件容易事，可必须得放。不然我们都得玩儿完。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: 找上门的人可能会给你带点儿什么东西，也可能会告诉你什么有意思的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: 别忘了检查一下他们的身体，看看符不符合伪人的特征。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: 检查身体特征特别耗费精力，还得看得特别仔细。每次检查之前都得考虑清楚。天这么热，人都没多少精力做事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: 不过聊天这块儿就不用担心，耗费不了多少精力，想聊几句聊几句吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: 平时记得多看看窗户外面的情况。电视新闻是个获取信息的好渠道，不过周围到底发生了什么，新闻是不会告诉你的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: 然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: 还得做什么？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: 找上门的人可能会给你带点儿什么东西，也可能会告诉你什么有意思的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: 别忘了检查一下他们的身体，看看符不符合伪人的特征。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: 检查身体特征特别耗费精力，还得看得特别仔细。每次检查之前都得考虑清楚。天这么热，人都没多少精力做事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: 不过聊天这块儿就不用担心，耗费不了多少精力，想聊几句聊几句吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: 平时记得多看看窗户外面的情况。电视新闻是个获取信息的好渠道，不过周围到底发生了什么，新闻是不会告诉你的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: 然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: 还得做什么？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: 恐怕现在能做的只有努力活下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: 希望这场噩梦能早点结束。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: 我觉得政府也许会想办法帮我们。说不定会带大家去避难所之类的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: 到时候，你就跟我家人待在一起吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: 哦，对了，差点忘了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: 我明天晚上就要回家了，记一下我电话号码，有事可以给我打电话。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: 我们家刚装好电话线。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: 以后就靠电话联系了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: 好了，这下应该是真的说完了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: 对了，我给你带了一箱啤酒。我姐夫在啤酒厂上班，他弄来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: 喝几口就去睡吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: 那玩意儿喝了特别困。你要是不想跟人说话了，又还不困，就喝点儿啤酒，放松一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: 我……我想我妈妈……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: 告诉我发生什么事了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: 我不——知——道。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: 他们进来开始说话，爸爸说不是那样的，他们说……他们说……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: 爸爸！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: 爸——爸——！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: 你……先休息一下吧
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: 明天我再跟你聊，好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: （小女孩不停喊爸爸，陷入了歇斯底里，好像会一直喊下去。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: （她根本听不见你说的话，完全沉浸在自己的悲伤里。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: 我……我想我妈妈……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: 你好吗？你喜欢这里吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: 这儿还行吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: 可我想回家……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: 我什么时候能回家啊？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: 以后吧……房子在装修
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: 现在还不行，你家房子烧掉了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: 那……他们很快就会来接我了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: 他们会带我去新家吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: 还是我原来的家？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: 他们会给我建个新房间吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: 那……爸爸还会来接我的，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: 你知道到底发生了什么
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: 现在先待在这儿
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: 可是爸爸没事吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: 那我的房间呢？也烧掉了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: 妈妈不会来接我们了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: 还有其他人吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: 你知道到底发生了什么
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: 现在先待在这儿
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: 我不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: 我不确定。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: 他们打了爸爸，但他站起来了。我看见了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: 那就是说……那就是说他也能把火给灭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: 或者跑来找我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: 他很快就会来吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: 爸爸不来，我哪儿也不去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: 他会来接我，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: 我看见他站起来出去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: 我跑出去的时候看到他了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: 我……我想我妈妈……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: 你得接受现实
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: 你是什么意思？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: 我看见你房间里有电视，我能不能看看动画片？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: 我不知道你看见了什么。但我觉得你爸爸不在了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: 你爸爸可能不会来接你了，我也不知道他到底怎么了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: 你什么都没看见！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: 我在那儿！我跑出来的时候他还在动！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: 他很快就来了！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: 为什么他还没来接你？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: 你最后一次看到他是什么样子的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: 他不会来了吗？你为什么这么说？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: 为什么他还没来接你？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: 你最后一次看到他是什么样子的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: 他可能先去做什么别的事去了？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: 他去打那几个坏人了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: 他……他应该很快就来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: 你爸爸的事……节哀顺变吧。他是个好人，就是太善良了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: 好吧，你爸爸可能很快就会来了。
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: 他那会儿没事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: 他们打了我爸爸……也就是说……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: 我记不清了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: 你爸爸的事……节哀顺变吧。他是个好人，就是太善良了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: 好吧，你爸爸可能很快就会来了。
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: （小女孩似乎在审视着你。你动都不敢动，就这么僵在那儿，等着对方有所动作。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: （过了一会儿，她开始嚎啕大哭。你似乎什么也做不了。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: （让她相信假话对她来说更加不好。她得尽快接受现实。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: 我猜也是。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: （你发现小女孩在发呆，明显是在想什么事情。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: （不好归不好，可犯得着搭上她的童年吗？幼小的她能承受得住这个打击吗？）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: （你认为她眼下面对的问题够多了，没理由再给这个孩子添堵。）'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: 诶唷，我年纪大了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: 你是从哪儿来的？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: 嗯，是，怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: 大伙拿我的故事换了好处，又为这么几个故事恨上我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: 你想象得出来吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: 我有座房子，是个小木屋。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: 我喜欢待在那屋子里，可没人陪我，一个人待久了就会憔悴。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: 谁会来我小屋做客呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: 我只能四处游荡了。反正我也没什么好失去的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: 诶唷，我年纪大了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: 你没有亲人么？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: 最普通的故事。我在住的地方收集来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: 讲给我听听'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: 我是个老婆子啦，那么多故事，我都记不太清啦。我晚点儿用我的方式来讲一讲吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: 他们说不定就为这个记恨上我。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: 他们说的什么，你知道么？“悲伤本身并不难承受，难的是对悲伤将至的预想。”'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: 可天底下讲故事爱添油加醋的，又不是只有我一个，明白么？嘿嘿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: 每个人都会来找我。迟早的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: 每个人都需要故事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: 诶唷，我年纪大了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: 你丈夫出什么事了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: 你想让我讲什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: 人是种充满恐惧的生物。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: 我认识个男人，他住在栋高楼里。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: 那个人把自己反锁在公寓里，哪儿也不去，离所有人都远远的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: 他怕伪人，又害怕死亡本身。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: 没人去过他家，反正去了他也不会让人进去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: 然后啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: 我听到了一声巨响。轰隆！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: 刚开始还没明白过来。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: 后来我往窗户外面一望，发现他跳了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: 撑不住了，就跳了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: 你觉得这个故事怎么样？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: 我不喜欢
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: 就这个？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: 没人喜欢我，大概就是这个原因吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: 好吧，没关系。总有一天，我会按照我记得的方式讲你的故事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: 是啊。那个人摔得很惨。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: 他要么是害怕太阳爆炸，自个儿会炸死才跳的，要么是因为什么别的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: 我觉得是他的心撑不住了，受不了一个人待着。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: 不过，能怎么办呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: 诶唷，我年纪大了……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: 你在长椅上坐着……然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: 好吧，听好了啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: 我以前住在村里，那儿有个人喜欢去森林里散步。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: 我不知道为什么，反正他就是喜欢。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: 有一天，他又在森林里散步，走着走着发现自己迷路了，回不去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: 他停下来想了想，觉得只要往前走，总能走到个什么地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: 他走啊走，可还是找不到出去的路。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: 这会儿他才意识到，自己在原地打转。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: 然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: 这也太蠢了
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: 等大伙找到他，他已经死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: 跟着他的脚印走上一圈，才发现他一直在原地打转。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: 你知道有句老话怎么说的么？“一条腿迈的步子更大。”'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: 就是这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: 怎么了？你不喜欢这个故事吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: 嗯，我肯定是稍微夸张了点儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: 但这事真发生过，眼下还在发生。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: 走着走着迷路了，你说，该怎么走出去？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: 我得好好养精蓄锐，要是有人能帮我一把就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: 你妹妹怎么样了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: 她很多事做不了，只能我帮她弄。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: 我昨天给她洗了个澡。她在家里连浴缸都进不去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: 没什么变化。不过谢谢你关心。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: 抑郁了的人，真的是……挺不容易的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: 我怕万一走着走着就得逃跑，她又跑不动。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: 不然就是连吃东西的力气都没有，什么都吃不下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: 正好我也累了，想休息一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: 我得好好养精蓄锐，要是有人能分我点儿精力就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: 接下来有什么打算？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: 问得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: 我丈夫应该很快就过来接我们了。希望他找到了个安全的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: 伪人进不去，大太阳也晒不到。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: 他说真有这种好地方，还说太阳不会爆炸。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: 真爆炸了，全人类十分钟内就会灭绝。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: 我觉得他是对的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: 我得好好养精蓄锐，要是有人能分我点儿精力就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: 有你丈夫的消息吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: 不知道为什么，他一直没联系我。没打电话，也没上门来接。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: 他是不是出什么事了？不会是什么麻烦事吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: 反正肯定不是抛下我们不管了。他不可能这样做的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: 他烦透了我妹妹，可还是帮着我照顾她。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: 他……他应该在路上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: 我妹妹看着也好点儿了……所以说……他会来的，到时候一切都会好起来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: 我得好好养精蓄锐，要是有人能分我点儿精力就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: 你看起来很忧郁
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: 嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: 哦，可能吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: 我有很多事情要考虑。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: 太阳不会爆炸，那为什么温度还这么高？为什么大家还在想着什么世界末日？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: 我看了新闻。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: 他们话没有说得太明白，不过那意思就是白天还会更热。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: 气候在变化，说明有动物适应不了新气候，就会……死掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: 那我们会怎么样？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: 我得好好养精蓄锐，要是有人能分我点儿精力就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: 欸，你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: 我昨晚出去了一趟，想找我丈夫。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: 他可能去的地方我都找遍了，最后还是找到了他。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: 他吞药了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: 我们……我们是买了药的。怕情况变得更糟，以防万一就买了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: 他害怕，就吞了，打算自己走，不带我一起。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: 药吞了，也没提太阳的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: 大结局就在眼前。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: 欸，你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: 我感觉……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: 有条特别重的毯子……'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: 压在我身上。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: 我……不想这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: 大结局就在眼前。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: 你今天好像比昨天开心了点儿
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: 是啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: 你知道太阳是怎么回事吗？是不是要爆炸？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: 我今晚才知道这事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: 这么说来，人类就这么迎来大结局了？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: 我们的一点儿痕迹都不会留下吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: 想想真是有意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: 大结局就在眼前。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: 你姐姐怎么样了？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: 她害怕会失去一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: 我觉得我们没有什么好失去的。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: 宇宙不断扩张，我们只不过是尘埃。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: 除了我们，谁也不存在，自然也没有人需要我们。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: 这个星球消失了，没人会为我们哀悼。本来也不需要哀悼。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: 但我姐姐很害怕这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: 大结局就在眼前。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: 你姐姐生病了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: 是啊。她打算出去找她丈夫，不让自己去想不好的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: 我觉得这是个馊主意，可她就是坐不住。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: 她要还想出去找，那我就得跟着去。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: 大伙都还没死，我不想失去她。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: 大结局就在眼前。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: 你跟着去了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: 去了。找到了她丈夫的尸体。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: 他说一切都会好起来的，结果自己害怕真正的结局，怕到自杀了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: 我觉得她振作不起来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: 这下轮到我照顾她了，得照顾到大伙都咽气的那天为止。'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: 到那会儿就真没什么好担心，没什么好害怕，也没什么好害羞的了。'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: 放他走
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: 放他走
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: 靠……*咳咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: 欸，朋友……不麻烦的话……你能不能给他们打个电话？{0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: 我不是要他们来接我……也不是要告别……就告诉他们……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: 告诉他们……爸爸没有逃跑。他只是……留在了人们需要他的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: *咳嗽* 这就够了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: 请讲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: 文件里写了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: 说了你都不信。有的文件……还挺有意思的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: 就拿这个理论来说吧，观点挺新奇的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: 说是伪人压根不存在。政府有个解决人口过剩问题的计划，所谓的伪人只是计划的一部分。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: 说得挺像那么回事……怪是怪了点，但也有点道理。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: 不管我们喜不喜欢，人口过剩这问题还是得想办法解决。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: 伪人说不定就是他们想出来的解决办法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: 请讲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: 还在翻你那堆文件？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: 正是。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: 怎么，感兴趣？我手里文件多得很。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: 来，看这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: 说是应急中心的人*就是*伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: 他们身上那制服，把人从头到脚裹得严严实实的，想检查都没法检查。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: 有意思。我特别喜欢文件里对应急中心这四个字的解读。应是应该，急是紧急，中同终止的终，心是心跳，连起来就是“应该紧急终止人类心跳”的意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: 还是说，其实是别的意思……？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: 请讲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: 你又有什么新发现？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: 伪人就是剥皮行者。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: 听着像科幻小说里的设定，是吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: 不过这是有依据的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: 有篇报告说，有人看见个浑身苍白的人在街上走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: 我得说一句……写报告的人犯了个明显的错误。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: 他说这个苍白诡异的人影有两个。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: 一个在窗户外面，一个在家门口。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: 得了吧，那不明摆着就是一个实体么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: "Theorist: 我猜啊，是窗户扭曲了看到的东西。明明是一个人，隔窗户一望，看着也像两个人。\n  说白了就是个视觉错觉。"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: 不过这说法还是挺有意思的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: 请讲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: 文件里说的要是真的呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: 说到底，什么才是真相？真相嘛，就是个见仁见智的东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: 你觉得是真相的东西，别人觉得是妄想。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: 你觉得善良的东西，别人没准觉得邪恶。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: 人类从古到今，争这事争个没完。至于眼下这世道，道德判断早就乱七八糟咯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: 你的信念要跟我一样坚定，那你信的就是真相。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: 唔。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: 挺好，有意思……我们刚聊的什么来着？噢，对，真相。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: 记好了，真相只有一个，那就是伪人是大脑寄生虫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: 戴好耳塞，千万别摘。做到了这条，什么事都不会有！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: 那什么，我还有一堆东西要看，得集中精神，麻烦别打搅我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: 怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: 你说你以前在海关上班？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: 对，确实在那儿干过。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: 我说，你检没检查过他们是不是伪人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: 嗐，整个就是场闹剧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: “伪人”这词儿谁想出来的？这帮怪物叫这个合适么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: 就该换个贴切点儿的名字。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: 怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: 你怎么这么讨厌伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: 这还要问？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: 他们把世界搞成了活地狱！你没看新闻？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: 太阳快炸了，街上死了不少人，都是他们害的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: 我跟上帝发誓，有能力一定把他们全灭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: 给我点时间，我会跟当年在边境干活一样，把他们一个个揪出来。你就等着瞧吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: 应急中心能招我就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: 怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: 你怎么这么想去应急中心上班？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: 因为在乎呗，不然呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: 伪人不是对付不了的，也该有人对付他们。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: 我还举报了我邻居，做了我该做的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: 可他们呢？没招我，招了我老公！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: 别误会，我老公进了应急中心，我面上也有光。但是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: 有没有搞错啊？这跟给我一巴掌有什么区别。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: 怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: 你为什么举报你邻居？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: 说得还不够清楚么？我邻居是个伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: 他弄得我浑身起鸡皮疙瘩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: 说实话，举报的那一刻，心里舒服极了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: 我想起了以前在海关上班的日子，多好啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: 我也是在那时候一下明白了过来，应急中心我非进不可！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: 怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: 你不是来这儿找老公的，是奔着应急中心来的，对吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: 是又怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: 没错，我来这儿就是要闹个天翻地覆，闹到上头的人肯听我说话为止。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: 我想进他们不让进，我要申诉！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: 给的那是什么狗屁理由！伪人是我逮住的，我也做了好公民该做的事，到头来招的是他不是我？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: 天呐，真搞不懂为什么。太荒唐了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: 我恨死他了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: 那什么，我想请你帮个小忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: 能不能帮我给他们打个电话？打内线，专号是{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: 就说你碰见个女的，有真本事，有经验，胆子也够大，能给他们带个新同事来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: 往厉害了吹，多说几句好话，没准他们就能让我干点什么活儿了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: 怎么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: 还是在海关那会儿舒服些吧？手里好歹还有点权力。
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: 能不能别这么自以为是。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: 我又没问你怎么想，再说了你也没比我好到哪儿去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: 屋里你说了算，大家都得来找你。你想当老大，没说错吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: 你说谁是伪人，谁就是伪人，说谁不是，那就不是。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: 可这不是你干的活儿，是应急中心干的。你没那个资格，还硬要充法官。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: 你说你比应急中心强在哪儿？他们起码有实权，你呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: 我就知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: 我……我要是能学会杀人就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: 还想看我杀伪人么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: 其实……我不想了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: 对、对不起，我吓坏了，才发觉自己还没做好那个准备。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: 而且看见尸体还是犯恶心，得花点儿时间才能克服。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: 听说……伪人……死了以后还能动弹，比如……比如说巷子里那个人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: 唉！这会儿没法回忆那时候的事，还没做好心理准备……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: 我……我要是能学会杀人就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: 告诉我巷子里出什么事了。
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: 我……我不知道该怎么开口，不过我尽量吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: 我觉得巷子里安全点儿，就往那去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: 可我刚拐进去，就感觉自己进的不是巷子，是个坟场。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: 地上躺着好几具尸体。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: 有的还在动，跟没死透一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: 巷子尽头有个男的，手里拿了把枪，他……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: 不行了……不想再回忆了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: 我……我要是能学会杀人就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: 巷子尽头那个人是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: 是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: 是个穿披风的，身上挂了几串手指头和牙齿……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: 他身边有个小伙子，一脸的无助。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: 他拿枪指着人家，大吼大叫，让人家把牙齿露出来给他看。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: 那小伙子求他手下留情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: 我那会儿正躲在垃圾箱后面偷看……可下一秒……不知道为什么，我好像变成了那个小伙子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: 他痛哭流涕，苦苦哀求，求那男的饶他一命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: 接着……砰一声枪响，他倒在了地上，跟巷子里那几具尸体一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: 我忽然就悟了……如今世界上只剩下两种人，一种是猎人，一种是猎物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: 我……我要是能学会杀人就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: 不是非得当个嗜血的杀人犯才能活下去。
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: 怎么这么说？根本不是这么回事！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: 你能活到现在，还不是因为你露出了獠牙！大家都知道你是猎手，没人敢动你！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: 大家都怕你，你就不会出事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: 我不想任人宰割，不想跟个懦夫一样，哭哭啼啼死掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: 我要学会杀人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: 天父在上啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: 这屋子怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: 啊，不怎么样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: 墙歪的，屋子布局压根不合理。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: 还有，你是不是成心找了个最寒碜的小房间给我住？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: 家具又老又旧，快散架了，让虫蛀得不成样子，八成早就成了飞蛾窝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: 你连在个像样的房间里挂个十字架都做不到？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: 算了，当我没说。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: 天父在上啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: 这么不满意，怎么还不赶紧走？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: 你以为我是自己要来这个被上帝遗弃之地么？修道院还在，我这辈子都不会离开它那神圣的院墙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: 你以为我喜欢这堆破石头？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: 我有别的地方可去，也不会上这儿来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: 这地方弥漫着杀戮和死亡的臭味。我敢打包票，你待在这儿还挺享受的……主啊，救救我吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: 你觉得谁是恶魔就杀谁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: 可你自己说不定就是个恶魔！角都快冒出来了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: 但我不怕。天父自会庇佑祂的子民。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: 天父在上啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: 你怎么不待在修道院里？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: 首先，修道院不是属于我的，那是全能的主的居所。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: 其次，都是那群渎神之人害的！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: 他们亵渎了祂神圣的居所，愿天国的火焰落在他们身上！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: 这群渎神之人气势汹汹闯进修道院，驱逐院内信徒，把我也给赶了出去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: 赶完人就立马搬了进来，好像这地方是他们的似的！太野蛮了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: 我们循规蹈矩地生活，祈祷、禁食，做主的工。可这帮野兽呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: 拿圣水当便宜酒糟蹋，敞开了喝。愿他们让圣水呛死！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: 下地狱去吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: 天父在上啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: 这群“渎神之人”想干什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: 他们成群结队，脏兮兮，闹哄哄，大声尖叫如同恶魔，高声咒骂如同不信上帝的野蛮之人！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: 为什么闹？就因为我不让他们进来！我说得明明白白：没受过洗礼的，休想踏进这道门！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: 他们一听可发了狂。呵，能不发狂么……不停砸门，差点把门都砸烂了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: 门一砸开，人全冲进来，把我扔出去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: 他们明明需要帮助，你却置之不理？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: 换了我，说不定也会把你扔出去。
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: 修道院是个神圣的地方，不庇护不信上帝的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: 他们就算是跑来躲太阳，或者所谓的伪人，那又如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: 纵使火焰从天而降，上帝的居所也不容怪物踏足。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: 主的怜悯，只赐予祂的信徒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: 他们在街上活活烧成了灰烬，那也是该受的审判，顺其自然就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: 你这人挺可恶的，不过轮不到我来说
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: 趁我没开枪，赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: 傲慢无礼，无耻至极！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: 你是不是疯了？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: 我是上帝的仆人！那群不信神的虫豸，把我驱逐出了祂的居所……而你……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: 你竟敢嘲笑我，说我是自作自受？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: 你不是人，是条毒蛇！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: 你！你也是个渎神之人！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: 我还以为你能理解，没想到你也好不到哪儿去！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: 我们不过是上帝的仆人！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: 只能接受祂的意志！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: 祂的作为远比我们高明，我们终究不可能理解祂宏大的计划。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: 你这人挺可恶的，不过轮不到我来说
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: 趁我没开枪，赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: 呵，你倒成英雄了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: 你这鬼地方也算是个家？我一秒都不想多待。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: 永别了！上帝的震怒必将降临在你身上！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: 我压根没打算在这儿久待，别搞错了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: 我一进屋子，就打从心底里感觉到上帝不在这儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: 祂也许现在还在对我说话，要我赶紧走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: 永别了！上帝的震怒必将降临在你身上！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: 该死的伤口……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: 应急中心为什么抓你？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: 其实我也搞不太清楚具体咋回事，不过……大概能猜个八九不离十。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: 本来以为就是次常规检查而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: 但我敢打赌——绝对是隔壁那个贱人告的密！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: 我们一直互相看不顺眼。她逮着机会就陷害我，硬说我是"伪人"。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: 现在肯定得意坏了吧……这毒妇真该死。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: 这破伤口……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: 请问，伤口的状况如何？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: 已经好多了，真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: 之前不是跟你说过嘛，子弹直接穿过去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: 人跟人之间何必这样互相伤害？那家伙居然直接开枪！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: 再这样下去，人类迟早要完蛋——地上睡不安稳，那就只能长眠地下了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: 但偏偏有人反着来……自己活在地狱里，还要把别人也拖下水。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: 你真该亲眼看看那个拿枪的疯子，简直是个变态混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: 一个疯子？不是应急中心把你打伤的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: 疯子？什么疯子？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: 对，我是被应急中心的人打伤的，他……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: 跟我说实话
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: 别编了，你根本不会撒谎
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: 我是说……应急中心那个疯子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: 我和他对视的时候……就感觉这人特别危险。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: 就是他从背后……开枪打我的时候。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: 跟我说实话
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: 别编了，你根本不会撒谎
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: 好吧好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: 其实……我是从隔离区逃出来的，但……不是那时候中的枪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: 有个医生帮了我，造假文件把我送出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: 我不敢回家——那个举报我的贱人邻居还在呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: 我就到处找地方躲，想低调点。结果就碰上那家伙了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: 我问他能不能借住一晚。话刚说完……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: 就看见他背着霰弹枪，戴着串用牙齿和指甲做的项链，身后巷子里堆满了尸体。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: 那时候我才意识到，这完全是个疯子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: 糟了，伤口又开始疼了。我想躺会儿休息下，行吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: 真该死……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: 好吧，我都老实交代。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: 其实……我是从隔离区逃出来的，但枪伤不是那时候中的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: 有个医生帮我造假文件，把我弄出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: 我不敢回家——那个举报我的贱人邻居还在呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: 我就到处找地方躲，结果就碰上那家伙了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: 我问他能不能借住一晚。话刚出口……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: 就看见他背着步枪，戴着人牙指甲做的项链，巷子里全是尸体。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: 那时候我才明白——这完全是个变态疯子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: 糟了，伤口又疼起来了。让我躺会儿行吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: 这该死的伤口……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: 拿步枪的疯子后来怎么样了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: 好吧——再说说那个浑身挂满人牙手指的变态。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: 他一看我表情不对，立马就掏枪指着我。我赶紧抓住枪，我俩就扭打起来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: 都在抢那把枪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: 突然他就扣扳机了——我赶紧照他脑袋猛揍，把他打晕了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: 然后我就拼命跑……直到觉得肚子一阵剧痛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: 低头一看，全是血。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: 没跟你说实话是怕你知道后不让我进来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: 这世道，人不为己天诛地灭啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: 说实话……要是你知道有个持枪疯子在追我，还会收留我吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: 我就是想找个地方躲躲。不想像巷子里那些人一样死掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: 是……我承认撒谎了。希望你能原谅我，别赶我走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: 好吧。你可以留下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: 我现在无法信任你。走吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: 谢谢。你能理解真是太好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: 希望那变态别找来。幸好你也有枪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: 说不定有人已经解决他了。搞不好是那个苍白瘦弱的伪人干的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: 看来……我没猜错。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: 看吧？我撒谎是有苦衷的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: 再见了，混蛋！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: 噢不……他们去哪了？……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: 你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: 我不知道……我就是好想爸爸妈妈回来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: 他们照顾了我一辈子，可现在……我连他们发生了什么都不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: 希望他们平安。没有他们我根本活不下去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: 天呐……他们到底去哪儿了？……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: 你还有其他亲人吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: 几乎没有。不过……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: 最近发现我有个同父异母的姐姐，是爸爸跟前妻的孩子。但是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: 糟了！奶奶！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: 天啊，我可能知道爸妈去哪了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: 万一奶奶是伪人杀了他们？或者被应急中心带走了？？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: 为什么？为什么不留下？为什么不带我一起走？为什么……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: 我一个人活不下去的。为什么丢下我？？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: 天呐……他们到底去哪儿了？……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: 冷静点了吗？你姐姐的事呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: 其实我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: 就在他们离开前不久，我们收到了一封信。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: 爸爸亲自拿给我的……因为我从来不会检查信箱，他让我读一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: 是"姐姐"寄来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: 她说想跟我见一面。可是……我不知道该怎么面对这件事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: 说实话，我第一反应还以为是谁在恶作剧呢。但既然是爸爸给的，应该假不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: 他解释说，我不是他的第一个孩子——其实我一直有个姐姐……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: 一个同父异母的姐姐。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: 听到这个坦白的时候……我心里五味杂陈，完全不知道该怎么办。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: 我是说，没错，理论上她确实是我"姐姐"，但我们从来没见过面、完全不认识……这种感觉太奇怪了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: 我……我想我应该是想和她聊聊的。但我也特别害怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: 或许，你可以帮我打给她？号码是——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: 就说……她确实有个弟弟，而他现在不知道该怎么办。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: 天啊……他们到底去哪了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: 为何不去投靠自己的姐姐？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: 我根本不认识她啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: 父母坦白这件事的时候，我感觉就像被他们骗了一辈子似的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: 我当时气疯了，冲出房间，只想一个人静静。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: 然后第二天……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: 就发生了我跟你说的事。电视里的报道、地区陷入恐慌，然后……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: 他们就把我抛下了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: 天啊，我愿意付出任何代价，只要能再见爸爸妈妈一面。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: 老天，为什么……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: 去找你姐姐吧。她不会拒绝你
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: 你确定父母已经遇难了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: 真的吗？你这么觉得？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: 可我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: 从没离开父母出过远门。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: 她住得很远。我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: 我害怕。我做不到。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: 叫出租车吧。现在还有车运营
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: 你必须行动起来
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: 好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: 他们没回来找我，所以我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: 不知道……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: 试试找你奶奶
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: 去隔离区找找看
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: 这主意……其实不错。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: 虽然听说现在出租车很贵。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: 但我带了父母的积蓄。应该够去找姐姐。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: 谢谢你点醒我。再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: 也许你是对的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: ……可能我确实太依赖父母了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: 谢谢你点醒我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: 我会试着叫车。幸好带了父母的积蓄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: 希望我能做到。再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: 或许……或许你说得对。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: 会不会是车子抛锚了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: 爸爸之前就说车又该修了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: 而且奶奶坚持不用手机。所以他们没法联系我？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: 也许……真能在那儿找到他们。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: 谢谢你点醒我。我该走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: 好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: 他们可能真在那儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: 总得试试。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: 谢谢你点醒我。我该走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: 随便问吧，朋友。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: 最近怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: 好得很，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: 刚偷看了你的冰箱。早知道你有这么多啤酒……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: 从哪搞来的？酿酒厂有亲戚？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: 算了！每个人都有秘密！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: 要不是这破世道，咱们早该喝着冰啤看球赛了。我还能介绍你认识——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: 你没事吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: 发呆呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: 啊？什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: 算了。当我没说。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: 没什么……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: 就是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: ……随便想想。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: 随便问吧，老兄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: 今天情绪不怎么好啊
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: 不想提这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: 提什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: 你说什么呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: 说了你也不懂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: 我必须知道
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: 好吧，不逼你
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: 真的不想谈这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: 我必须知道
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: 好吧，不逼你
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: 别逼我了！我已经快崩溃了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: ……让我静静。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: 谢了。我确实不太好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: 随便问吧，老兄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: 你到底怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: 关你屁事，兄弟！少管！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: 告诉我发生了什么
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: 你迟早得说出来。憋着更难受
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: 我实在说不出口……你会用异样眼光看我的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: 不过……一直憋在心里也确实不是个事儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: 我养了只小狗，它……前几天走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: 这怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: 然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: 干嘛突然这么凶——总不是想干掉我吧，兄弟？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: 好吧。你想听实话是吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: 我养了只小狗，它……前几天走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: 这怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: 然后呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: 你听我说完。虽然它年纪大了，还一身病……但是——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: 其实，它不是自然死亡……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: 是我亲手结束了它的生命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: 你干了什么？！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: 你个变态！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: 是我亲手送走了它。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: 你干了什么？！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: 你个变态！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: 我知道这听起来很混蛋。但请你听我解释。它……被折磨得不成样子，我实在不忍心看它这么受苦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: 每天每夜，它眼里都写满痛苦。每天晚上，我都能听见它抱着受伤的腿低声啜泣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: 都怪那个该死的出租车司机！要是他开车不那么横冲直撞，我的狗现在还好好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: 妈的，要是能掐死那个混蛋，我付出什么代价都愿意。可他直接逃逸了，我连车牌都没看清……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: 你根本不懂失去宠物是什么感受。虽然它们生命短暂——但教会我们的，比任何人给的都多。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: 大家都说——它们只是我们生命的一部分，而我们却是它们的全世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: 好吧，你可以留下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: 赶紧离开这里
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: 我自己也知道……我是个畜生。到现在我都无法原谅自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: 它……被折磨得面目全非，我实在看不下去它这么受罪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: 每天情况都在恶化。晚上最难熬……它会哭，会抽泣……还会流眼泪……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: 你见过小狗流泪吗？它的眼神就是在求我帮它解脱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: 我根本不想这么做——我发誓，我根本不想！我怎么可能愿意亲手……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: 都怪那个天杀的出租车司机！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: 撞了我的狗还敢当没事发生一样直接开走！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: 就像碾过路边的一块石头似的，那可是一命活生生的生命啊！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: 妈的，要是能找到那个混蛋，我非拧断他脖子不可！可他溜得太快，我连车牌号都没记清……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: 你根本不懂失去家人是什么感觉。虽然它们寿命不长——但给我们的爱，比什么都珍贵。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: 都说——宠物只是我们生活的一部分，而我们却是它们的全部世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: 好吧，你可以留下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: 赶紧离开这里
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: 谢了，兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: 真的很感谢你能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: 你说得对，兄弟。或许这样最好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: 我每天都在想……帮它解脱到底对不对。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: 可能这辈子我都不会知道答案了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: 一片漆黑……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: 说说看，你到底看到了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: 你不会想知道的。相信我，不知道才是最好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: 我本以为失去视力，就能摆脱一直萦绕在我脑海里的……那个东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: 但一切早已深深刻在我记忆里。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: 我还是能清晰地梦见目睹过的一切，和以前一样，无处可逃。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: 一片漆黑……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: 对你来说，失去双眼真的更好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: 很难说。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: 我很确定再也不会看到那个东西了。就算被杀，我也不知道下手的是什么。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: 只是……感觉有点怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: 我不知道这里的布局，行动很不方便。不吃止痛药的话，眼眶就会疼得厉害……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: 但我会慢慢适应的。至少，再也不用看到那些毛骨悚然的景象了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: 即便如此……我所见过的一切……已经深深烙印在灵魂里——直到时间尽头，我都将与之共存。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: 一片漆黑……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: 你看起来不太舒服
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: 可能是因为没梳子吧？嗯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: 昨晚我做了个梦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: 我沿着电车轨道往家走。周围都是房子，树木林立。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: 我听见电车驶来的声音，赶紧躲到一边。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: 我转过头——看到某个东西抓住了一个人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: 它围着那人快速移动，速度快得根本看不清。但我心里很清楚——我知道那是什么东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: 我拼命追赶电车，却始终追不上——我永远无法触及终点线后的真相。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: 然后，我就醒了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: 一片漆黑……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: 你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: 我又做了个梦，它又出现了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: 我走在一条路上，夜黑风高，街灯闪烁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: 我转过头，看见它正不紧不慢地向我跑来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: 这次，我看清了它是怎么移动的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: 我试图逃跑，但无济于事——它还是在慢慢逼近。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: 终于到家后，却发现打不开门。没办法，只能翻栅栏。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: 但在慌忙摸口袋时，不小心把钥匙弄掉了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: 于是，我绕过房子，再次翻越栅栏。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: 突然之间，四周一片死寂。我停下动作。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: 抬头一看。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: 猛地发现它就在上方——正越过栅栏，向我扑来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: 不过，这一切也有可能是因为吃了止痛药产生的幻觉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: 一片漆黑……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: 昨晚也做梦了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: 嗯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: 只是……这次，我不想说。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: 我现在已经明白了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: 我们都会死。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: 它会把我们撕碎。醒着睡着都一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: 太阳会烧死我们。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: 什么都不重要了。结束了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: 我……让我静静。求你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: 哟，兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: 末世前你是干什么的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: 混日子啊。看电影，跟兄弟鬼混。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: 现在？没电影没聚会。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: 电视整天放恐慌新闻和广告。兄弟都不接电话。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: 听个大人物说"现在不是享乐的时候，我们在危机中……"'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: 去他妈的。什么时候享乐我说了算。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: 哟，兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: 你以前做什么工作？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: 工作？噗。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: 只有傻子才工作。我那叫生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: 看过个电影，男主角完全就是我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: 工厂流水线的看起来开心吗？才怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: 我办派对认识新朋友……这才是享受生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: 好吧好吧……我靠爸妈的关系，在物流仓库干过管理。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: 也就是说，你是个啃老族？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: 也就是说，你是个懒鬼？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: 奋斗啥啊？我活明白了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: 有资源不用？那才傻。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: 好比你有枪。挂墙上还是用起来？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: 这就对了。我不傻。会利用优势。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: 哟，冷静点儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: 嫉妒就直说。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: 不是谁都能中彩票的。认命吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: 哟，兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: 出什么事了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: 兄弟……你录像带呢？一盘都没有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: 你到底看不看电影？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: 我他妈无聊死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: 现在不是看电影的时候
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: 我根本没有
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: 以为你这儿能嗨起来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: 结果你这儿的伙计贼无聊。还没东西看。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: 没杂志没电影……只有书……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: 现在谁还看书啊？这都什么年代了！全是又臭又长的文章和描写，无聊得要命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: 这儿不是电影院
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: 你是来嗨还是求生的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: 啥？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: 认真的吗兄弟？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: 自己房间有电视却没片儿？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: 兄弟你这派对太烂了。还以为你挺酷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: 这儿不是电影院
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: 你是来嗨还是求生的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: 别这样……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: 你是我见过最扫兴的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: 想活命就冷静点
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: 不满意可以走
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: 欸哟……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: 家里电视坏了，兄弟。还指望你能解闷儿，结果……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: 你是我见过最扫兴的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: 想活命就冷静点
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: 不满意可以走
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: 行吧兄弟。这儿是烂，但比街上强。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: 就……让我看会儿电视。一会儿就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: 就知道！扫兴鬼！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: 走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: 可怜的孩子们……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: 你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: 也许吧……我也说不清……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: 我……我不明白为什么心智成熟的成年人会任由情绪驱使，做出这种伤天害理的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: 难道他们真的害怕到这种地步，甚至要去杀害无辜的孩子吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: 如今这个世道，人们会做出更糟糕的事
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: 混乱之中，理智往往最先被抛弃
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: 难道还有比杀害无辜孩子更糟糕的事吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: 而且，不是一个人……是一群人、一伙人，孜孜不倦地进行着他们的猎巫行动……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: 或许正是在这种艰难时期，我们内心最真实的面目才会显现。也许真正的怪物是我们，而不是地底下来的那些东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: 但是，难道人们就没意识到杀害无辜的孩子是非常……我甚至不知道该怎么形容……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: 或许正是在这种艰难时期，我们内心最真实的面目才会显现。也许真正的怪物是我们，而不是地底下来的那些东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: 可怜的孩子们……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: 你当教师多久了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: 大概是从灾变前三个月开始的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: 只是……我不是什么模范教师。以前，我并不热爱这份工作——只觉得孩子们太吵闹，让人精疲力尽。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: 但灾变改变了一切，让我看清了一些事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: 以前，任何一个孩子都可能在未来成为摇滚巨星、政治家，或是为人父母。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: 而现在……他们再也没机会抱起吉他、再去学校——再也没法正常长大了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: 永远都是……做梦的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: 我记得有一天，一个孩子突然跑来找我，哭着对我说——他的父母很怕他。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: 因为他们认定他是个伪人……所以就把他赶出了家门。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: 他不知道还能去哪，只好来找我……来到幼儿园。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: （女人的眼泪止不住地流下来）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: 不好意思……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: 可怜的孩子们……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: 昨天真的很抱歉，我不是有意让你难过
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: 没关系。我……我已经好多了，现在感觉好些了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: 关于之前提到的那个孩子……经过他的事，我意识到了孩子们的脆弱、他们的无助，尤其是在一切都崩坏的时候。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: 于是，我开始尽可能收留每个被"驱逐"、被抛弃的孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: 我听他们讲述经历……才知道有些父母竟然能毫不犹豫地抛弃自己的亲生骨肉，简直令人无法忍受。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: 就好像——对他们来说，这次灾变只是抛弃孩子的借口罢了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: 也许……他们从一开始就不想要孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: 可怜的孩子们……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: 你有自己的孩子吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: 我没有自己的孩子……我母亲倒是经常劝我早点成家生子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: 只是，我还没准备好——我希望在时机成熟时自己做出决定，而不是盲从别人、随波逐流。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: 听过被抛弃孩子们讲述的各种经历后……我不禁开始想。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: 如果我当初听了母亲的劝告，自己会不会也成为这样的父母。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: 正因为如此，我选择对每个遭遇这种命运的孩子伸出援手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: 最糟糕的是什么，你知道吗？其中一个纵火的人，就是我收留的某个孩子的父母……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: （女人的眼泪再次止不住地流下来）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: 不好意思……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: 我……我真的想给他们美好的生活。我关心他们、爱护他们。无论如何，都不该是这样的结局……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: 我很抱歉……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: 他们的死不是你的错
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: 对此我深感遗憾
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: 也许你是对的。只是……我的内心依然感到无比空虚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: 我脑海里一直有个挥之不去的想法——你知道是什么吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: 万一他们的父母从来就没爱过他们、没对他们付出过任何感情，该怎么办？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: 我……希望我有让他们感受到爱——哪怕只有一点点。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: 谢谢……但是我的心已经支离破碎，无法修补。恐怕这辈子都跨不过这个坎了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: 我脑海里一直有个挥之不去的想法——你知道是什么吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: 万一他们的父母从来就没爱过他们、没对他们付出过任何感情，该怎么办？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: 只希望……我曾给过他们一点点爱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: 屋里都有猫了，还有什么不满意的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: 你为什么在这？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: 问的这叫什么问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: 门是你开的，要问该问你自己，问我干什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: 对我而言哪儿都一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: 有人让来我就来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: 我对你没什么要求。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: 你只要把这儿弄舒服点儿，伺候好猫就行。其他关我屁事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: 屋里都有猫了，还有什么不满意的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: 你真是人类吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: 你呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: 你还剩多少人性？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: 我比你差哪儿了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: 屋里都有猫了，还有什么不满意的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: 谁派你来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: 该做的你都做了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: 问那么多干嘛？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: 一个……认识你也认识我的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: 但没说我来这儿以后下一步该干什么。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: 屋里都有猫了，还有什么不满意的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: 打算住多久？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: 直到对方来找我为止。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: 这段时间，我该做什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: 不知道——对方只说了这些。现在我在等其他指示。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: 给出指示的到底是谁？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: 你在等的到底是谁？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: 屋里都有猫了，还有什么不满意的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: 为什么不杀我？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: 你挺蠢的知道吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: 每天问一样的问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: 说了在等指示。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: 我在等指示。你又在等什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: 这儿真闷……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: 还好吗？孩子怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: 嗯……他……跟我一样累。怕生所以粘着我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: 孩子承受力差。就算不抱怨也写在脸上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: 有时觉得带他逃难是我的错。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: 但已经没法回头了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: 小宝贝~怎么不开心呀？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: 为什么在街上游荡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: 哎呀，我们正要去拜访我妻子的母亲、也就是我的岳母来着。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: 然后意识到大概没法及时赶到，于是——就找到了你这里。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: 再次感谢你允许我们待在这里！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: 宝贝，怎么板着一张脸？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: 走多远才能到地方？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: 我的爱人不怎么认得这里的路。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: 要是没人帮忙的话，估计得走上整整两天吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: 找到正确方向前，估计得迷好几次路。哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: 不过，要是有人能顺路捎我们一程——那就太好了，只需要几个小时就能到。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: 为何偏偏选在现在去拜访她母亲？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: 时间安排实在是一塌糊涂
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: 因为担心她可能出什么意外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: 手机一直关机——已经好几天联系不上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: 我们需要确认她是否平安，说不定她正需要我们帮忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: 虽然现在夜晚变短了，赶路还是有点吓人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: 不过没关系。我们很快就能见到你母亲了，对吧——亲爱的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: 我已经不太记得具体路线了，我妻子又总是选错方向。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: 但都是小事。只要能继续前进就好，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: 可能得花上一周时间就是了。哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: 宝贝，怎么板着一张脸？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: 你们不是今晚离开吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: 事情是这样的——我这傻乎乎的妻子光收拾行李就花了整整三个小时，完全错过了最佳出发时间。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: 所以，我们决定推迟一些再走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: 不好意思，我们下次动作会利索点。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: 我会确保这位慢吞吞的女士不再耽误行程。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: 我们应该没太打扰你吧？再次说声抱歉！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: 宝贝，怎么板着一张脸？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: 女士，你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: 一切正常——为什么要特地问她？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: 跟你说话的人明明是我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: 她只是有点心烦意乱而已。没什么好担心的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: 我问的是她
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: 你呢，感觉如何？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: 她已经很累了，请别强人所难。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: 说实话，我想她已经不关心自己母亲了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: 不过无所谓。她这只慢蜗牛终究会决定再次启程——到时我们就继续上路。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: 只是……不知道等到那时候，她母亲是否还活着。哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: 拜托，亲爱的——赶紧准备好。我还要等到什么时候？该死！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: 哎呀。总体来说，一切都好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: 只是感觉我的爱人好像已经不再关心自己母亲了而已，哈哈。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: 或许我该推你一把——嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: 抱歉让你听到这些。她实在太拖沓，快把我逼疯了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: 快点坐下准备好，我他妈不想再等了！该死！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: 宝贝，怎么板着一张脸？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: 你妻子并不想离开——出什么事了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: 她惹恼我了，知道吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: 一天到晚抱怨，无时无刻不在怪我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: 总是不懂闭嘴，永远不照我说的做——一如既往地把情况搞复杂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: 对于一直赖在这里，我真的很抱歉。今天就是最后一天，我们马上就走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: 听到了吗？赶紧他妈把行李收拾好。如果晚上还留在这里，我就把你扔出窗户——我说到做到。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: 女士，你确定自己还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: 出什么事了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: 我早就说过，请你别插手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: 与你无关。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: 我们自己会处理——别再刺激我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: 我不想再听废话，我要知道发生了什么（你举起了枪）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: 我不管——你们到底还走不走？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: 听着，房东——我之前就说过，一切都好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: 我妻子只是太无聊在闹脾气，惹恼我了而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: 你到底想怎样？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: 我不想再听废话，我要知道发生了什么（你举起了枪）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: 我不管——你们到底还走不走？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: 冷静点。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: 我手里有枪——敢轻举妄动，我就杀了这婊子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: 我反正已经没什么可失去的了。你呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: 不管怎样，你都得死
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: 现在收手还来得及，你还有机会
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: 会的会的，我们不打算继续待了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: 我们这就走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: 听到了吗？今天就是最后一天。妈的——赶紧准备好，别浪费时间。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: 我已经了无牵挂。你杀了我又能怎样？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: 起码不用再忍受这种痛苦，而且这婊子也会给我陪葬——这样我也满意了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: 我会开枪的
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: 冷静点——只要你放下枪，我也放下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: 我为什么要这样做？我一定要带她一起走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: 没她我也不走。所以——放下你的武器。我们今晚就会离开。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: 只要你不插手，没人会受伤。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: 我会开枪的
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: 冷静点——只要你放下枪，我也放下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: 你真的要向一个弱女子开枪吗？你真能心安理得吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: 要是向我开枪，一定会波及她。到时你手上就会沾满她的血。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: 我……一切都与我无关！下手的人——是你！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: 发出警告
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: 我要走了。不然连我也要交代在这里。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: 已经别无他法了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: 要是这婊子没被吓得浑身发抖、而是跟我一起走的话，事情根本不会变成这样……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: 全是她的错。听到了吗？你毁了一切！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: 发出警告
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: 你……你把枪放下了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: 等等，你还是打算向我开枪吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: 等等——不要！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: 好吧！好吧。我们会离开的。冷静点。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: 对吧？今晚必须离开这里——听到了吗？婊子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: （女人突然挣脱，男人因此扣下扳机）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: （你条件反射对准男人头部开了一枪）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: （看来他们都死了，起码这场闹剧结束了）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: （真是一对疯狂的夫妻）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: 好吧，我们这就离开。马上——先让我们拿东西遮着身体，然后立刻出发。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: 你再也不会见到我们了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: 等等……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: 你这是在做什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: （你对准男人扣下扳机，也击中了一旁的女人）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: （两人同时倒下，血流如注）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: （女人呻吟了片刻，但你无能为力）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: （两人均已死去）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: 你还不明白吗？这是唯一的方法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: 我们走了，就这样吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: 欸！拿上毯子！我们现在就要走了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: （你看着两人用毯子把自己裹得严严实实，走上大街。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: 但——只走了一小段，就突然倒下了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: 黑烟从毯子上缓缓升起。你转过头去，不再关注）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: 一切都会好起来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: 现在心情还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: 算不上开心……但也没崩溃。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: 我们依然是人类。依然在坚持。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: 我们没让风暴变得更糟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: 等这一切结束……我想我们能原谅彼此做过的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: 只要还有同情心，人性就还在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: 你明白我的意思吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: 一切都会好起来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: 你一直这样乐观吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: 不……不是一直这样。我以前对人、对世界、对自己，都很愤怒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: 我会为小事发火，恶语相向，摔门摔到门框开裂。但后来我意识到愤怒只会摧毁自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: 先摧毁自己的内心。然后是周围的一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: 有次……我对一个只是想帮我的人大发雷霆。而现在……他……不对——她已经不在了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: 就在那一刻，我感觉心里有什么东西碎了。我知道必须彻底改变，否则我所触及的一切都会被亲手摧毁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: 所以，我学会了放下。试着让自己平静下来，试着接受分歧。于是，就成了现在的我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: 一切都会好起来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: 你失去了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: 我的家人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: 就在我外出取水的时候，只不过短短几分钟，我们的房子就被烧毁了。回来时，眼前只有浓烟和灰烬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: 我花了很久才接受这个事实。不停质问自己：为什么那时要离开？为什么没能救他们？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: 但或许重点不在这里——不该为无法改变的过去懊恼，而是要背负这一切继续前行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: 在某种意义上，他们依然与我同在，活在我心里。与共度的回忆给了我前进的动力。正因如此，我会主动帮助他人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: 我太清楚失去的滋味。太清楚当一切崩塌后，重新找到意义所在的重要性。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: 一切都会好起来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: 你设法克服了失去他们的痛苦？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: 没错。我熬过来了，虽然并不轻松。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: 很长一段时间里我都在责怪自己，觉得——如果能早几分钟回去，或许结局就会不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: 但是，愧疚只会滋养悲伤。人生……需要学会宽恕。如果不懂放下，连自己也会随之消逝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: 正是这种信念拯救了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: 我原谅了无法改变过去的自己。甚至包容了如此残酷无情的命运。因为我知道，愤怒只会让自己陷入深渊，不断下沉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: 一切都会好起来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: 既然如此，现在是什么在激励着你向前迈进呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: 我相信人类可以变得更好。即便面对这种混乱的局面，也依然能找到重新崛起的机会。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: 我不相信什么奇迹天意。我相信人性——相信彼此之间的互相扶持。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: 有些人会对跌倒的同胞伸出援手。有些人会在艰难的日子里依然微笑。有些人会毫不犹豫分出最后一块面包。小事，成就大事；生活，正源于此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: 每个人作出的贡献，哪怕再微小也绝非毫无价值——世界会因此变得更加灿烂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: 一切都会好起来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: 要是可以的话，你会想要让一切都恢复原状吗——你的房子，你的家人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: 如果能再见到他们……再和他们说说话，再拥抱他们一次……我当然愿意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: 但是，让一切恢复原状？我说不好。失去是生命的一部分。虽然痛苦，虽然难受……但正是这些经历塑造了现在的我们。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: 确实。如果能再共度一天，我愿付出任何代价。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: 但如果这意味着我将失去因此学到的一切，比如如何宽恕，如何前进……那我不会选择重来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: 人生苦短。要珍惜现在拥有的一切，不能被已经失去的东西吞噬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: 保持警惕，谁都有可能是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: 你是个猎人吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: 说是护林员更合适。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: 我住在偏远的林区。没有电视，只有收音机，听电台广播才知道外面出了这么大事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: 我家就是我的堡垒，谁来都不让进。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: 来敲门的是伪人怎么办？花言巧语哄我开门放人，趁我睡熟了，割了我喉咙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: 那你怎么会在这儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: 一个人行动不安全
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: 总不能坐等那个苍白的高个怪物找上门。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: 我就是因为他，才从小木屋跑到这儿来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: 哎，看你眼神就知道，你也见过那怪物。我没说错吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: 你谁也不放进屋，是怎么活到现在的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: 你也见过那个苍白高个的伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: 哼，自己想办法挺过来了呗。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: 不然早让蛆虫吃了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: 我以前觉得放陌生人进屋太蠢了，一个人待着才安全……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: ……可没过多久，那恶棍就找上门了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: 我这辈子都没见过那么可怕的怪物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: 你谁也不放进屋，是怎么活到现在的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: 你也见过那个苍白高个的伪人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: 孩子，说来话长。今天不想多聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: 明天带啤酒来，我好好给你讲讲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: 看来不只我见过。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: 是啊……我也见过……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: 哎，孩子，你要是知道我经历过什么就好哩……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: 会告诉你的……不过不是今晚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: 明天带啤酒来，我好好给你讲讲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: 保持警惕，谁都有可能是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: 所以到底怎么回事？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: 啤酒带来了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: 带了（给他啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: 怎么，没带啤酒？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: 没带（不给啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: 嗯，这样就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: 我不是说了么，我一个人躲在小木屋里，谁也不放进来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: 有一天，突然来了个人，火急火燎的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: 那人砰砰砸门，苦苦哀求我放他进去，但我那会儿脑子可还清醒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: 他浑身苍白，抖得厉害，好像刚跟死亡打了个照面。我不知道他怎么会到深山老林里来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: 他看着不像登山客，我叫他赶紧走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: 他想破窗进来，我说我有枪，一听有枪他赶紧跑了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: 我还以为再也见不到他了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: 你说不定该帮他一把
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: 当时就该放他进屋
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: 什么叫“以为再也见不到”？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: 把追他的东西引到我屋里来？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: 免了，我麻烦够多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: 你不怎么爱说话啊？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: 你这才说了几句
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: 我懂了，有啤酒就肯说了是吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: 别跟我装好人，你肯定也见死不救过。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: 不然哪能活到现在？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: 明天再说吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: 你不怎么爱说话啊？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: 你这才说了几句
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: 我懂了，有啤酒就肯说了是吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: 本以为再也见不到他了。后来……他又找上门了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: 改天再跟你继续说。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: 你不怎么爱说话啊？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: 你这才说了几句
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: 我懂了，有啤酒就肯说了是吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: 明天带啤酒来……我把故事讲完。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: 老子不爱跟人闲扯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: 能跟你说这些算你走运。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: 明天带酒来，我把故事讲完，成不成？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: 耐心点儿。我见过些要命的东西……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: 清醒的时候可不想回忆。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: 带酒来，我就说。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: 你挺机灵，这我承认。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: 不是要紧事，我懒得开口。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: 明天带酒来，我告诉你后面怎么样了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: 抱歉，没酒我可不讲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: 有酒再聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: 保持警惕，谁都有可能是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: 后来怎么样了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: 我会告诉你，不过得先拿酒来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: 给（给他啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: 怎么，没带啤酒？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: 没有酒（不给啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: 这还差不多。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: 那家伙跑掉后，我继续待在小木屋里。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: 后来柴火烧完了，我不得不出去捡点回来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: 等我抱着一捆柴回到屋里……发现步枪不见了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: 我慌了神，把屋子翻了个底朝天也没找到枪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: 然后我看见窗户外面有个人，手里拿着我的枪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: 我一看，就是之前那个人……但是他样子跟上回不一样了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: 他变高了，皮肤松松垮垮的，上半身什么都没穿，就跟刚出生一样，只有下身穿了条裤子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: 他双手握着枪……像折树枝一样，啪一下折断了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: 然后就站在那儿，死死盯着我，像是在等我眨眼……好抓住机会，冲过来拧断我脖子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: 但他没动手，就那么看着我……像在玩什么变态的对视游戏。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: 我们就这么相互盯着……盯到天刚蒙蒙亮，那个高个怪物突然消失了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: 那一刻，我明白了——一个人待在这儿，还没枪，这不是找死么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: 我趁太阳还没完全升起来，赶紧跑到了这儿来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: 就是这样了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: 孩子，希望你有机会扣动扳机。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: 谁知道呢，说不定子弹对他有用。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: 他为什么没杀你？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: 你觉得他真能被杀死吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: 他可是干掉了一整支小队
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: 不知道。他掰断步枪就跟掰树枝一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: 他要杀我也是眨眨眼的事……可他没动手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: 他说不定很喜欢玩弄我们，跟猫耍耗子似的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: 我这辈子没怕过什么。但那个浑身苍白的高个子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: 吓得我不轻。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: 我倒愿意相信那句老话。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: 有句老话说得好……“如果它能流血，我们就能杀了它”。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: 靠……一整支武装小队都干不掉他……那我们更没戏。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: 他要是想，能把这地方撕个粉碎，就跟子弹射向母鹿似的——砰一下就完事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: 我这辈子没怕过什么。但那个浑身苍白的高个子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: 吓得我不轻。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: 没酒免谈。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: 我清醒的时候可不想聊这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: 想听后续……带罐啤酒来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: 就想要一点点温暖……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: 你一直穿着外套？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: 对。有件事让我很不安。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: 我不知道这、这样做会有什么后果。甚至在炎、炎热的天气里，我也感觉不到一点暖意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: 如果把这件夹克脱了，我会因为太、太冷而死吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: 又或者……虽然不会死，但会感觉更、更冷——这样反而更糟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: 你不会流汗吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: 也就是说，你甚至不洗澡咯？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: 不、不会。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: 流汗是因为身体需、需要降温。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: 而我这副身体……恐怕已经没法再、再降温了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: 我、我不想回答这个问题——不、不好意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: 只能感受到一丝微不足道的温、温暖……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: 对于治疗这个体温失调的症状，你有什么头绪吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: 我……觉得对此应、应该是无计可施了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: 我甚至试过用沸、沸水来提高体温。结果只是被烫伤了，完全没用。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: 你知道吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: 我想到了一个比、比喻。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: 想象一下，在浩瀚冰、冰冷的深远太空中……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: 星系显现。天体坍、坍塌。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: 而我，只能在一旁静静观察……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: 我从来感受不到哪怕一丝太、太阳带来的温暖。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: 更别说人与人之间拥、拥抱产生的温度了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: 大概——不管是太、太空，还是这个世界，都不需要我这样的异类。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: 只能感受到一丝微不足道的温、温暖……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: 我们第一次见面时，你说有话要说——到底是什么事呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: 我……不太确定该不该现在说、说出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: 有件事压在我心、心头很久了。我之所以感觉这么……寒、寒冷，说不定就是因为这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: 其实我根本不想提。但是，想倾诉的心情一直在蚕、蚕食着我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: 我、我明天会告诉你。我想——到时我应该就准备好、好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: 只能感受到一丝微不足道的温、温暖……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: 好了，你到底隐瞒了什么事呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: 我想和你分、分享一个秘密。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: 我已经准备好、好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: 通常来说，结局都不太、太好。但这次，或许会不一、一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: 衣服下面……就是寒冷和孤独的根源。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: 看。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: 唉……又、又是这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: 你干了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: 你完蛋了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: 我不是有意的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: 以为这里会不一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: 从来都不会。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: 我不想这样的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: 我发誓。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: 赶出去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: 以前也发生过。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: 怎么会觉得这次不同？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: 别冲动。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: 我没有恶意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: 这不是我的目的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: 赶出去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: 或许这样最好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: 不再寒冷。不再孤独。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: 只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: 没计划会这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: 现在吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: 子弹更仁慈。可惜我还能感觉到痛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: 让、让太阳下手的话……会死得更慢，更痛苦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: 能让我在这儿待到天黑吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: 赶紧走
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: 别耍花招
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: 明白了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: 对不起。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: 或许阳光最后能温暖我一次。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: 谢谢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: 我知道你恨我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: 但是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: 对不起。我也不想这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: 另外……那个……能叫我朋友来吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: 大人叫她来都会放行……换我就总挨骂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: 这应该是她电话：{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: 天啊……千万别放人进来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: 为什么应急中心没把你带走，而是赶跑了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: 鬼知道，亲爱的。那些穿防护服的……根本猜不透。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: 整天耀武扬威发号施令……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: 以为自己是老几？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: 狗屁不懂还摆架子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: 他们来过你这儿吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: 来过
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: 有个家伙总在这转悠
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: 天杀的混蛋！该扒了他们的防护服扔进隔离区。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: 让他们尝尝和真人相处的滋味。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: 现在连房子都要霸占？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: 没教养。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: 一次就算了。还接二连三来……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: 真不要脸。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: 天啊……千万别放人进来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: 他们带走你家人了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: 哎呀。好久没人问我家人了，亲爱的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: 我有一大家子呢。生了好多孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: 那个多呀……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: 现在屋里都快挤不下啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: 门锁后面还藏着个小可怜，躲着那些怪胎。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: 你没回答我的问题
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: 所以他们带走你家人了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: 哦……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: 说跑题了，亲爱的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: 是啊。穿防护服的杂种把我家搬空了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: 但他们别想逍遥法外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: 他们带走你家人了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: 我没有家人
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: 没带走
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: 哦……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: 说跑题了，亲爱的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: 是啊。穿防护服的杂种把我家搬空了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: 他们带走你家人了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: 我没有家人
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: 没有
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: 没有？那这大房子怎么回事？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: 就你一个人住？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: 大房子就该人丁兴旺啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: 算了不追问。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: 只想把我家人都救出那鬼地方……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: 他们没动你？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: 那你家人在哪？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: 这种大房子可不是给独居的人建的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: 好吧，不打听。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: 我只想让家人离开那该死的隔离区……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: 老天……千万别放人进来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: 你打算怎么救回家人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: 不用我帮忙，亲爱的。他们会自己回来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: 什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: 自己回来？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: 他们会从地底爬回来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: 穿过那些愚蠢的铁丝网。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: 要是地底行不通……就把整个隔离区撕碎。一个都不会落下……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: 他们来了……我听见动静了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: 你他妈在说什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: 疯了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: 什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: 时候一到……围墙自会崩塌。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: 会有很多死人……他会来饱餐一顿。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: 到时候那些穿防护服的混蛋就顾不上我家人的事了……他们有更大的麻烦要应付……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: 他们来了，我听见了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: 你在说什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: 你疯了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: 什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: 我们会彻底摧毁你们建造的那些巢穴……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: 墙壁会破裂……街道会流淌着鲜血……到处都是尸体……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: 我听见窸窸窣窣的爬行声……越来越近了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: 你这话什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: 你到底是什么人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: 是伪人伪装的吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: 啊……烤肉的味道真香啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: 那些穿防护服的家伙烤得刚刚好……就是稍微有点焦……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: 亲爱的……你这儿尸体可真不少……足够办场盛宴了……我的孩子们可以美餐一顿了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: 我听见窸窸窣窣的爬行声……越来越近了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: 你这话什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: 你到底是什么人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: 是伪人伪装的吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: 这房子是个好地方。很特别。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: 大房子却没几个人住。够我们全家搬进来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: 我听见窸窸窣窣的爬行声……越来越近了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: 你这话什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: 你到底是什么人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: 是伪人伪装的吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: 废物一个！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: 他们就要来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: 孩子，我们找到新家了，总算能歇一歇了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: 快爬过来，这房子他反正再也不需要了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: 妈妈想孩子了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: 快来吧，这房子正合适。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: 爬过来吧，孩子们。妈妈在这儿呢。找到新家了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: 多宽敞。多好啊。够咱们全家住。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: （杀死她）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: 房子交出来！反正你也不喜欢！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: 巴不得一把火烧了它！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: 交出来！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: 还有什么好抵抗的？我知道你想要什么……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: 你想要的是……死亡……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: 有话要说？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: 为什么把人当畜生看待？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: 问你个问题。人到底是什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: 杀戮，吞食猎物，毫无愧疚。这才是天性。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: 社会给我们套上了枷锁。幸好那套早过时了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: 什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: 你对现状很满意？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: 很简单。愚蠢的社会规则消失了。现在一切明朗。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: 狼群要有头狼。威胁群体存活的必须死。这才叫规矩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: 最可恶的是披着羊皮的狼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: 你觉得群体比社会优越？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: 披着狼皮的羊？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: 我庆幸人们终于摘下面具。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: 但这些败类毁了一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: 披着狼皮装模作样。模仿真正猎食者的本能。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: 说白了就是一群懦夫，只会挖洞躲在地底下。我宁愿直接跟人正面硬碰硬，也不想玩你追我赶的猫鼠游戏。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: 要想组建自己的族群，就得学会怎么识别这些滥竽充数的货色。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: 狼群比社会强？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: 披着狼皮的羊？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: 你在质疑？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: 过去的社会里，根本找不出这种懦弱的羊羔。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: 太多废话，太多规矩。整天陷在无休止的争论里，根本没空做正事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: 所以首领至关重要——没有疑问，无需投票，他的话就是法律。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: 必须展现出绝对强大、不容置疑的实力。只有这样，族群才能存活。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: 没错——我说的就是你们称为"伪人"的那些懦夫、败类。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: 过去像老鼠一样躲在地底，等着我们变得虚弱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: 现在却在玩弄人类的道德，利用我们的怜悯苟延残喘。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: 所以我们必须亮出獠牙——告诉它们人类也是动物。否则迟早会被取代。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: 怎么，想说什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: 为何一直盯着我的枪？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: 我看得出来——你有当首领的潜质。把这里管理得井井有条，很有统帅力。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: 这房子不错，宽敞明亮、人来人往。但里面的住客……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: 他们怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: 你认为有伪人混在里面？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: 你收留的都是些废物、软蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: 说说看——老弱妇孺有什么用？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: 族群必须由强者组成。否则根本活不下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: 你想让我干什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: 你想让我把他们都赶出去？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: 我担心的不是披着狼皮的羊，而是弱不禁风的狼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: 你的族群缺乏骨干，全是过客。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: 找出最强者，只留他们。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: 你想让我干什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: 你想让我把他们都赶出去？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: 你得淘汰弱者。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: 杀鸡儆猴——公开处刑。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: 这样才能巩固统治、树立权威。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: 目睹弱者消亡却不畏惧的……才是真狼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: 他们才配留下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: 我不是冷血杀手
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: 我只对伪人开枪
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: 放任不管，你的威信会崩塌——他们会觉得你懦弱无能。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: 心慈手软就是致命伤。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: 你得冷酷无情。伪人？直接崩了。老弱妇孺？同样下场。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: 这样他们才会怕你。这样他们才会服从你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: 我不是冷血杀手
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: 我只对伪人开枪
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: 骗谁呢？看你眼神就知道了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: 你杀过人，少跟我装什么好人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: 灾变前我称霸街头，为所欲为。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: 人人都怕我、敬我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: 你想过吗——一直这样活着，灵魂什么时候会彻底腐烂？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: 我根本不在乎，任由内心发臭变质。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: 有天有个不知死活的出租车司机拒载我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: 要是放过他，我的声誉就完了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: 于是我打断了他全身每一根骨头。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: 他的孩子也长了教训，人们照旧怕我、敬我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: 只要不再照顾弱者，就能更上一层楼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: 灾变前我称霸街头，为所欲为。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: 人人都怕我、敬我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: 你想过吗——一直这样活着，灵魂什么时候会彻底腐烂？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: 我根本不在乎，任由内心发臭变质。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: 有天有个不知死活的出租车司机拒载我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: 要是放过他，我的声誉就完了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: 于是我打断了他全身每一根骨头。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: 他的孩子也长了教训，人们照旧怕我、敬我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: 你有什么话想说？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: 你说这么多狼群理论，怎么自己没组建一个？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: 那你为什么收留这些人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: 为了不让那个苍白高个伪人杀我
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: 我想帮助别人
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: 只是想要人陪着
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: 因为他们需要领导者
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: 我先问的
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: 所以你是为了保命才收留他们？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: 你这可不像头狼，像条吓坏的小狗。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: 这个群体需要真正的强者。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: 看来得由我来接管了，你不配领导。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: 你目标很崇高，就是有点天真。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: 你救不了所有人，迟早要拒绝别人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: 不过你确实有头狼的样子，我不会挑战你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: 就这样？只是害怕孤独？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: 这才像懦夫的托词。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: 现在倒说了句人话。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: 行，我不质疑你的统治权了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: 我不会回答。你知道得越少越好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: 我已经说得太多了。现在该你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: 要是不配当领袖，我不介意取而代之。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: 滚蛋！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: 你比我强在哪儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: （拔枪）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: 趁我没开枪打死你，快滚
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: 闭嘴，菜鸟。你现在什么都不是。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: 连为什么当领袖都不知道，凭什么占着位置？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: 你最好自己滚蛋，不然我亲手放倒你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: 我懂狼群的规矩。这就是我的信条。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: 这么优柔寡断，也配当头狼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: 你最好自己滚蛋，不然我亲手放倒你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: 那就这么着吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: 知道我手里有枪吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: 把你的放下。咱们好聚好散。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: （开枪）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: （放下枪）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: 去死吧混账——'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: 你这杂种……真敢开枪……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: ……漂亮'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: 可惜你没补枪啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: （他趁机拔枪）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: （把你死死按住，你根本掏不出枪）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: （看来到此为止了）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: 你舌系带断了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: 正式异常呃嬷！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: 我倍他们伤好了嘴吧！就音喂塔们庭不冻沃将画！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: 我听不懂你在说什么。
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: 你能理解我说的话吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: 窝卜冥摆腻宰犟神么。艾……盖谮么班呐？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: 匹汝，鞭早眸种宫瞳域岩？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: 我们到底该怎么沟通？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: 窝克伊虫副腻烁得花，染猴腻队词坐处翻硬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: 叶序，折羊得花……器马，窝久能冥摆字机道滴宰烁蟄携神么。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: 怎么。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: 什么怎么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: 你是想要问我什么事情吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: 窝嗨室卜冥摆腻宰犟神么……不裹，腻毫嚮室剃了格纹梯？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: 勘赖，折硬改室格医吻刺。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: 窝嗨室卜冥摆腻宰犟神么……不裹，腻毫嚮室剃了格纹梯？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: 勘赖，折硬改室格医吻刺。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: 嘿，你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: （你拍了一下他的肩膀，并指着他嘴边的伤口）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: 你还好吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: 还会痛吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: 卜毫伊斯，腻能……宰烁衣鞭码？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: 还——好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: 还……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: 还好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: 毫腩罚因……不裹，硬改游爸医斯给船底倒爸。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: 不止，窝得族锅室否页宰罚升瞳痒得室清。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: 枕室衣长遏蒙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: 你打算怎么回家？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: （你将双手置于头顶，做出了屋顶的样子）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: 假？腻室——宰纹馆鱼假得神么室清码？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: 窝室籟折李襬方毫油得，节过……确罚升了蟄痒得室清。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: 嫌宰得撞框，久艮……久艮衣脱矢衣痒——窝室宰时照卜倒器獺得瓷克翼型溶了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: 我该怎么把你送回家？难道，要坐飞机？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: 你有查过船票吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: （你将手向下一挥，划出了一道弧线）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: 肥鸡？腻绝德……显宰害游夯板陨英？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: 我得区纳立达婷衣霞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: 烁卜钉害游扮罚克翼李凯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: （你摆动起一只手，模仿在海浪中行驶的船只）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: 腻得医室室……佐穿？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: 嫌宰害游读伦星石？窝惠区茶衣虾得，谢谢！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: 你为什么笑得这么开心？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: （你露出了笑容，并用手示意——指了指自己的嘴巴、又指了指他的嘴巴）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: 艾雅，腻烁蟄格雅。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: 腻衣钉卜辉翔心——窝达婷倒，活扯害宰陨星！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: （他举起一只手，开始沿着另一只手的手臂移动）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: 不知，是否有人能开车送你回家？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: 窝卜冥摆腻宰犟神么，碰油。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: 冥舔，窝久能惠嘉！器马，克医道扯战立区。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: 金万，窝久惠李凯。栽箭！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: 再——见！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: 你是在说火车吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: 你要走了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: 窝婷卜董，包千。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: 不裹——冥舔，窝惠区扯战衣叹酒井！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: 叶需，窝种鱼克医辉假了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: 祝、你——好、运！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: 如此安宁的沉默……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: 你的手怎么样了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: 已经失去知觉一段时间了。但还能感受到疼痛和寒意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edter: 也算意料之中吧。我只希望最美好的时刻能晚点到来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: 我曾深爱过一个女孩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: 非常珍惜与她共度的时光。即使相对无言，也能心意相通——直到我突然醒悟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: 我一直在自欺欺人，其实从未真正了解过她。所谓"尽在不言中"，或许只是我的一厢情愿。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: 我希望能真正理解她。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: 如此安宁的沉默……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: 跟我说说这个女孩吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: 我总能在她眼中看到银月般凛冽的光芒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: 她与灾变截然对立。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: 她身上总带着说不清的神秘感。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: 我渴望揭开她的秘密。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: 如今她已成为我的丰碑。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: 指引我前行的灯塔。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: 如此安宁的沉默……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: 你们是怎么相遇的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: 某天我得知自己命运——败血症很快会夺走我的生命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: 我惊慌失措。意识到自己即将消失……不是遥远的将来，而是短短数月之后。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: 后来伪人开始从地底涌出……我在一栋房子里发现了她。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: 裹着白色亚麻绷带的女孩，面容凄美动人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: 在这个残酷的世界里，人人都只顾自己，没人会在意这份美好——除了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: 你听过那句话吗？"太过珍贵，无法拒绝；太过恐怖，难以接受。"'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: 但我还是轻轻抱起她脆弱的身躯，带回了家。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: 当一切结束时，我会挺起胸膛说——我所做的一切，都出于爱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: 如此安宁的沉默……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: 这个女孩现在在哪里？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: 我花了很长时间领略她的美丽，感受她的沉默。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: 然后……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: 一群穿黄色制服的家伙闯了进来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: 抓住她，带走了她。理由不言而喻。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: 真遗憾……我根本完全不了解她。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: 于是我又变得孑然一身……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: 人人都在说要拯救世界，却对具体方法争论不休。答案其实很简单。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: 就在沉默中，在美丽中——要是大家能感受到这点就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: 她试图教会我，而我只学到了何为"安宁"。在恐怖中窥见一丝优雅。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: 至少现在……我已准备好去追寻她了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: 这是个什么世道啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: 现在怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: 看来我们还没完成租赁协议。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: 具体要我怎么做？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: 你现在就关心这个？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: 别告诉我你连文件都没带？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: 那我建议你去找公证处补办。说真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: 开什么玩笑？现在去哪儿找公证处？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: 你怎么不去？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: 请注意你的称呼。叫我先生就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: 真没礼貌……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: 随你怎么说
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: 赶紧滚蛋
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: 你总该会看地图吧？这又不难。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: 再说一次，请用"先生"尊称我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: 随你怎么说
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: 赶紧滚蛋
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: 凭什么要我去跑腿？还有，记得称呼我"先生"！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: 我可是体面人，不是跑腿的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: 随你怎么说
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: 赶紧滚蛋
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: 你是故意的吧？至少装装样子配合一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: 注意你的语气。宪法第21条保障我的人格尊严。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: 建议你放尊重点，否则会很难堪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: 这是个什么世道啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: 能别较真了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: 我还在等你完成租赁协议。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: 我手头没有文件
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: 你逗我呢
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: 啧。真遗憾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: 这恐怕涉嫌违反第131条法规。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: 你搞得我烦起来了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: 没完没了地搬法律条文不烦吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: 根据第131条规定，合同是强制性的。我是守法公民，依法办事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: 你搞得我烦起来了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: 没完没了地搬法律条文？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: 啊哈，开始人身攻击了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: 这恰好适用行政法5.61条。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: 继续骂，后果自负。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: 不，我引用法律和宪法从不嫌烦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: 我懂法！别因为你是法盲就觉得别人不该维权。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: 再说一次！注意称呼，叫我先生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: 看来你是真的学不乖啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: 这是个什么世道……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: 现在怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: 我注意到你有把枪。能看看持枪证吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: 关你屁事。
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: 你干嘛老针对我？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: 啊，明白了。拿不出证件就是没有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: 以为有枪就能无法无天？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: 随便审问别人却不接受质疑？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: 大错特错！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: 知道吗？天外有天。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: 够了。我够烦的了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: 能别放屁了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: 我只是想弄清你的真面目。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: 这么激动……看来戳中痛处了。没证件。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: 你觉得规则约束不了你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: 你觉得只有你能审查别人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: 你错了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: 知道吗？天外有天。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: 够了。我够烦的了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: 能别放屁了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: 哎呀……你日子过得挺艰难是吧？想想也是。真可怜啊。没人敢质疑你、没人敢检查你是不是伪人——对你来说一定很难熬吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: 谁给了你决定他人生死的权力？谁赋予了你这种权威？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: 其他人只能乖乖坐着，祈祷自己不会成为下一个被你消灭的目标。现在你却想要别人的同情？还偏偏找我要？开什么玩笑？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: 恕我直言，你自己不也在到处检查别人，给人灌输无稽之谈吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: 四处窥探，把每个人都当成潜在杀人凶手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: 不过——当然，我们最好别指出真正的凶手是谁。毕竟也许……根本没有什么伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: 那样的话，你成了什么？一个滥用地位、利用混乱满足嗜血欲望的……彻头彻尾的疯子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: 而那些听到广播后惊恐万分、慌不择路，像苍蝇扑向粪便般涌到你门前的民众……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: 告诉我，最早来你这儿的人……有几个活着出去的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: 果然不出我所料……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: 这是个什么世道……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: 先生？你还在这儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: 难得……终于学会用尊称了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: 可惜为时已晚。我很快就会举报这件事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: 举报什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: 向谁举报？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: 你骗不了我了。我很清楚你的真面目。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: 这根本不是你家。你杀了房主冒充他。我要联系应急中心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: 没错，他们会来收拾你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: 放屁
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: 是时候让你永远闭嘴了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: 联邦应急管理局，简称应急中心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: 起初我只是奇怪，为什么你连份简单合同都处理不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: 但聊得越久，真相就越清晰。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: 现在一切都说通了。这不是你家。你是个冒牌货。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: 你是伪人！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: 收拾行李吧。他们今晚就来抓你！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: 胡说八道
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: 是时候永远封住你的嘴了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: 我一定会举报。他们一定会来。等着瞧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: 随便。滚出去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: 你死定了（掏枪）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: 想灭口？尽管试试。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: 等等——什么？！你疯了？！这是刑事犯罪！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: 到头了！你休想逃！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: 我就站在这儿等到应急中心来人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: 我要把你干的勾当全告诉他们，让他们知道你多危险。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: 等等——什么？！你疯了？！这是刑事犯罪！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: 你敢！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: 趁我没开枪，赶紧滚
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: 再不走我就开枪
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: 这是你逼我的
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: （开枪）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: 我绝不会让你逃过应急中心的追查！除非我死了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: 他们迟早会抓住你！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: 你也没得选！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: 你是伪人！杀人犯！根本不是人类！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: 不，不要！！！这是犯法的！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: 啊啊啊！！！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: 老兄……能捞到点好东西就太棒了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: 拾荒拾得怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: 我以为这地方没人住了才摸进来……没想到还有人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: 我不偷活人的东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: 你想想——死人要外套有什么用？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: 人都死了，东西就摆在那儿。而我呢？我还得活命。说不定能救我在乎的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: 要是能救心爱之人，你会不从尸体上拿东西吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: 也许我们该改改把死人当圣象供着的毛病了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: 老兄……能捞到点好东西就太棒了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: 怎么干起拾荒这行的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: 不然能怎么办？我又不想伤人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: 所以选了这条清净路。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: 死人不会反抗懂吗？他们的东西就是……没人要的东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: 我不是来害人的。就想活下去，顺带帮帮别人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: 老兄……能捞到点好东西就太棒了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: 拾荒时见过什么特别的东西？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: 见过的太多了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: 让我想想……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: 有次找到个废弃图书馆。落灰的书还在架子上，像在等人来取。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: 闯进过新手画展。那些画还挂在墙上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: 还有次……我看见了日落。不是普通的日落——美得像画在天上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: 这年头没人敢站着看天了。但那时候……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: 真怀念以前的日子。我总是天不亮就起床，街上静悄悄的，薄雾贴着地面流动，草叶上还挂着露珠。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: 那时的太阳啊……伙计，它升起来时那么明亮，就像在向你承诺今天会是美好的一天。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: 现在看看我们。太阳成了敌人。怎么会变成这样？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: 真希望有人能解释这一切。也许知道了答案，呼吸就能轻松些。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: 老兄……能捞到点好东西就太棒了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: 你打算金盆洗手了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: 还在干这行。但是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: 有次经历……确实让我很难受。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: 发现一栋空房子。地上有具尸体，很平常。没有威胁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: 那人背上全是弹孔。好像压着什么东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: 我以为他在藏什么宝贝。凑近翻过来一看……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: 改天再说行吗？现在还不想回忆那个。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: 老兄……能捞到点好东西就太棒了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: 尸体下面藏着什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: 好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: 我翻开他，下面是个小女孩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: 已经死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: 看到成年人的尸体……多少有心理准备。但孩子跟成年人给人的冲击可不一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: 每次看见死去的孩子，我就喉咙发紧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: 她怀里紧紧抱着一只毛绒猫玩具。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: 沾满了血……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: 女孩的表情凝固着……像是预知到了死亡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: 有一瞬间，我发誓她看起来在害怕我抢走玩具。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: 仿佛就算死了，人性的残忍也不肯放过她。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: 这件事对我的冲击远超想象。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: 那天我真想就此收手，让死者安息。但现在说这些都晚了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: 我只能继续走，继续拾荒。这是我唯一的活路。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: 都说人逃不过命运。看来是真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: 真希望那些伪人滚回地底去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: 你怎么当起掘墓人的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: 哈？这个啊……鬼知道呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: 墓园就像……就像个图书馆懂吗？不过这些书不能读……就静静躺着。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: 以前我认得每座坟。谁埋哪儿，手怎么扭曲的，下葬穿的什么衣服，叫什么名字……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: 然后某天我正挖一个新墓穴。风平浪静，一切如常。正当我觉得挖得够深时，定睛一看——居然是空的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: 你敢信吗？居然是空的！但根据文件记录，里面不可能空着，应该有一具遗体。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: 某个早就死透的家伙，印象中留着八字胡。结果——嗖的一下，像晨露似的消失得无影无踪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: 如果……一个死者突然人间蒸发，是不是意味着……他们又死了一次？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: 真希望那些伪人滚回地底去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: 发现墓穴是空的之后，你做了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: 等等……我坐在坑边仔细往里看——没错，啥都没有。但当我抬起头……突然看见远处站着个人。那人一动不动盯着我，像在参加葬礼似的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: 虽然没有眼睛……但牙齿白得吓人——闪着光，咧着嘴笑。就静静站着。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: 妈的，我差点吓尿裤子。真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: 我头也不回溜了——逃跑我可是专业的。不过那家伙没追上来。就像烟似的……消失得无影无踪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: 真他妈邪门……就是从那时开始闹伪人的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: 真希望那些伪人滚回地底去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: 现在都没人下葬了，掘墓还有什么意义？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: 早不挖坟了。就……盯着点儿。不过那事后，我开始检查新坟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: 我不是玩玩而已，是特别小心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: 我想着会不会误埋了那些怪物，拿着铁锹当剑使，随时准备拍死会动的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: 结果……骨头都在原位。尸体老老实实。没东西爬出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: 我琢磨着……或许不是埋下去的爬出来。而是……该埋没埋的变成了伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: 真希望那些伪人滚回地底去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: 你没再挖开过新坟吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: 我？！当然没有！听着……我这辈子都在跟死人打交道。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: 以前觉得死亡很简单。人死，埋土里，完事。现在？谁给你收尸？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: 就算埋了，怎么确定能待得住？我亲眼见过填好的坟……空了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: 那是我亲手埋的人啊！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: 现在我想……说不定我的坟也会空。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: 也许……我早就是伪人了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: 算了……当我胡说八道。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: 真希望那些伪人滚回地底去……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: 你觉得这些伪人从哪来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: 你注意到了吗？这些家伙……看起来特别眼熟。不光是长相，还有……那种说不出的感觉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: 我确实有个猜想。不过你真想听？好吧，是这样的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: 也许伪人……根本不是死人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: 而是没被埋葬的念头。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: 恐惧、遗憾、遗忘的人、放不下的情绪。堆积多了……地底太安静时就爬出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: 他们找的不是血肉，是关注。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: 你越害怕……他们就越近。因为你记得他们。而被记住的……都想活过来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: 我在想……伪人会做梦吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: 你睡过觉了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: 嗯？没。其实我没打算睡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: 只是希望这里还有人会做梦，仅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: 不过……直到现在，还是没有人愿意与我分享自己的梦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: 或许，我看起来并不是很可信。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: 或许，他们之后就会敞开心扉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: 我在想……伪人会做梦吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: 为何如此痴迷于梦？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: 怎么能说是痴迷呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: 真是个奇怪的结论。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: 难道，你就从来都没有好奇过自己的潜意识究竟想要传达一些什么讯息吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: 你就从来都没有好奇过自己的脑袋到底藏了什么事情？没错，我们甚至会对自身有所隐瞒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: 就比如说你——你都遭遇了些什么，才会变得像现在一样极力地去避免与他人接触？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: 因此，我对其非常感兴趣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: 不如，这样好了——就来跟你说说我之前做的梦吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: 我被一辆巨大的黑色火车不断地追赶着。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: 突然之间，我的双腿与地面融为一体、扎根于其中。我不禁大声尖叫，接着便醒了过来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: 我正站在轨道上……与此同时，我也正驾驶着火车朝着自己直冲而去、无法停下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: 我在想……伪人会做梦吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: 你呢？你的梦中隐藏了什么事情？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: 我吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: 我已经连续好几天没睡过觉了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: 不过，好吧——就来告诉你一些事情好了，反正也没有人会去相信的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: 我能看见其他人的梦。这种感觉……妙不可言。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: 我也不是很清楚为什么自己能做到这点。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: 然而……自从一切发生后，梦就……沉寂下来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: 就好像每个人都屏住了自己的呼吸一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: 我也变得无法入睡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: 好了——试着搞清楚我说的究竟是实话、还是在耍你吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: 你是谁？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: 只不过是迷失的灵魂罢了——与其他在这片已然破碎的大地上行走之人别无二致。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: 我们渴望和平与安宁。而且，我们清楚该如何实现……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: 死亡……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: 大家为何会对其望而生畏？难道，是出于对未知的恐惧吗？还是，惧怕宗教灌输的种种惩罚呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: 数千年来，我们孜孜不倦地探寻着生命的意义。其实，答案非常、非常简单……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: 死亡，正是人们之所以会诞生于世的理由所在。我们，正是其无比忠实的信众。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: 为什么会崇拜死亡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: 死亡是仁慈的化身。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: 无人不忌惮死亡，然而——这一感情是否合理？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: 想想吧，这个世界只不过是一个巨大的炼狱罢了、将我们折磨得不成人型。然而，凭什么呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: 数不清、道不尽的恐惧与苦难……难道，我们不配享有安宁吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: 死亡是我们无法理解的乐园。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: 宗教试图简化天堂的形象，因为这样更易于人们接受。只是，生命何曾简单过？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: 死亡亦是如此——如不亲自接触，便将无法理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: 为什么选择待在我家里？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: 这栋房子与死亡的连结无可比拟、世间罕有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: 最初，我们也不明白为何导师会选择这个地方。现在，一切都变得清晰、明了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: 这里充斥着死亡的痕迹。虽无法目视，却能感知到。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: 裸露的混凝土散发着鲜血的气息。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: 不要误会，我们并非要求你刻意进行杀戮。毕竟，即使没有他人在一旁催促、你也已经夺取过好些性命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: 照我看来，你于死亡之间的联系远比我们还要更加紧密。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: 你们在外面搭建的那些篝火是怎么回事？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: 时机已至。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: 来自地下的天使会接受我们作为祭品献上的骨灰、准许我们踏进死亡的领域。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: 如此一来，便能赢得它的青睐。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: 你看起来惶恐不安。难道，是在害怕吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: 你很敏锐，房主先生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: 与其他充满信仰的兄弟不同……我仍被挥之不去的恐惧缠绕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: 疑惑正一点、一滴地蚕食着我的心神。生命的尽头究竟有着何物、又会是一种什么样的感觉？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: 导师曾经教导我们——该处并非天堂、也不会是地狱，而是某种无法言说之地。不过，我始终无法在脑海中想像出一幅与之对应的光景……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: 如果连他也无法完全领悟死亡的本质，我们又怎么可能理解得了它的真谛呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: 万一仅仅接触并不足以达成这一夙愿呢？万一它完全超越出了人类的理解范围呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: 然而，我并不敢对导师的旨意有所质疑。我能从他的眼神之中看到无比的笃定与浩瀚的知识。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: 他要求我们拥抱信仰、展示决心。做好准备。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: 唯有如此，方能渡过死者之河、翻越白骨之山。最终，抵达我们梦寐以求的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: 死亡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: 为什么会崇拜死亡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: 亲切的房主先生——提及死亡之时，还请包含敬意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: 如果带着不恭的态度肆意谈论它，便会被视作亵渎者、予以最为严厉的惩罚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: 虽然我非常害怕，不过导师曾说过——死亡是诸神之中最为仁慈的一位。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: 不会带来饥荒、瘟疫，抑或战争。只会……平等地赐予众人安息。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: 因此，我们需要抵达它的所在之处。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: 为何会如此迫切地追寻死亡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: 这趟旅程无关我们的意志，而是出自死亡降下的神谕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: 它持续不断地呼唤着、想要将我们引导至自己的领域。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: 导师认为正是因为如此，太阳现今才会燃烧得如此猛烈、试图将我们自地表驱离。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: 死亡将会赐予我们寂静、安宁，以及合一。众人将于它的臂弯之中重聚一堂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: 哀悼死者，只是徒劳——因为……总有一天，我们将再度相逢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: 你打算怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: 时机已至……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: 我很害怕……根本无法停止颤抖……不过，我必须拥抱信仰、展示决心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: 导师相信我——我绝不能令任何人失望。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: 然而，恐惧……恐惧却依旧侵蚀着我的思绪……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: 走吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: 走吧、走吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: 你会在这里待多久？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: 不必担心，房主先生。我们不会给你添任何麻烦的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: 我们非常感激你的热情款待，自然——也并不想激怒你。你为我们做的事情早已非常足够。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: 我们会待在这个房间、静静祈祷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: 我们需要好好休息——这趟旅程将会非常艰苦、非常漫长。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: 你们要前往何方？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: 外族之地。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: 人类的性命并非永恒，我们只是地球的过客。既然有来到这里的一天，也定有离开这里的一天。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: 外族将接过这片土地，于此生根、发芽。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: 它们的到来并非偶然。将其唤来此处的声音、引领我们离去的声音，实则同出一源……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: 死亡……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: 为何会觉得是死亡将伪人唤来？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: 死亡一视同仁——人类、野兽、外族……无一例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: 死亡面前，众生平等。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: 它一直在等待恰当的时机，现在——已经快了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: 我们必须筹备仪式……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: 你们要筹备什么仪式？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: 时机已至，该跨越现有界域、迁至新的家园了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: 我们将前往死亡的领域——永恒和平与安宁之王国。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: 该出发了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: 怎么了，亲爱的？想要跟我聊聊吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: 你觉得这儿怎么样？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: 非常舒适。考虑到现在的各种状况……远比我想象中的要更好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: 谢谢你允许我待在这里。还以为自己要在天亮之前流落街头了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: 你呢？感觉如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: 非常焦虑
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: 还可以吧。我们都得拼命活下去
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: 我懂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: 鉴于现在的状况……为将来的四个月制定计划根本就没有任何的意义。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: 因为永远也不知道什么东西会先找上门——太阳、四处游荡的疯子，还是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: 不过，不管是人类、抑或是地球，都曾经遭受过、战胜过不止一次的灾变。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: 我想，我们总会留下一点什么。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: 之后，他人将会找到这些我们曾经活在这个世上的踪迹。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: 如此看来，也没什么不好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: 心态不错，我很喜欢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: 不过，千万不要将情绪憋在自己心里——它们总会以最糟糕的方式爆发出来……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: 特别是在你最不想要失控的时候……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: 与他人倾诉一下吧，没必要觉得尴尬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: 不想跟我透露的话，就去找其他住客吧——谁都可以。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: 如何，这个要求不过分吧？一言为定，好吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: 怎么了，亲爱的？想要跟我聊聊吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: 我昨晚看到了一件奇怪的事情
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: 哎呀，你这是在说什么呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: 你的肚子鼓了起来
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: 我只是觉得自己好像目睹到了什么东西
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: 你的意思是……我看起来就像是怀孕了一样？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: 没关系。不如说，我很高兴你能直截了当地将自己的疑问给说出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: 我想……之所以会有这样的一种错觉，大概是因为你现在有点害怕需要对他人负责吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: 我懂。如今这个世道，谁都不知道自己还能否看到明天的日出……光是照顾好自己就已经费尽九牛二虎之力了，更不要说去担心他人了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: 根本就不知道闭上眼睛之后还能否再次睁开。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: 没错……我的确对此感到担忧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: 不对，我觉得不是错觉
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: 然而，你的确在因某些事情而感到困扰，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: 没关系。毕竟，恐惧令我们所有人都疲惫不堪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: 我留意到你晚上会起来四处巡视。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: 而这意义重大。就你这样戒备之心如此强的人来说，对于自己收留的住客却表现出了非比寻常的重视。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: 真是……非常有趣。你这个人充满了矛盾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: 不过，也有可能单纯只是失眠而已——恐惧的确是最为糟糕的床伴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: 没错……我的确对此感到担忧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: 不对，我觉得不是错觉
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: 承认这点需要很大的勇气。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: 不过……面对恐惧，我们也无能为力——对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: 万物都将终结，谁都难逃一死……谁又能心平气和地接受这种想法呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: 重要的是，你会在何处找到自己的救赎——又或者是，你究竟能否找到自己的救赎。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: 好吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: 无论如何……我都非常担心你的状况。听听自己都说了些什么吧，好吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: 我希望你能安心。毕竟，你我住在同一个屋檐之下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: 要是你疯了的话……我们便难逃天罚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: ……不小心押韵了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: 有意思吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: 怎么了，亲爱的？想要跟我聊聊吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: 我很确定，昨晚看到你肚子大起来了，给我解释清楚
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: 你有点吓到我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: 你真的确定自己昨晚有看到过什么东西吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: 你为什么不立即叫醒我呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: 又是被恐惧迷惑了心智吗？害怕自己会死掉……又或者是，被保护他人的责任压得喘不过气？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: 难道，是因为我吗？抑或，是被其他人占据了你的脑海？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: 妈的——不要再扰乱我的思绪了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: 我……我很确定自己看到了某些东西
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: 你不久前曾经提起过自己的父亲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: 之后就再也没有聊过关于他的事情了。说实话，我对他并不了解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: 不过，现在……我感觉你跟他一模一样——正所谓，有其父必有其子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: 你害怕自己这辈子都会困于他的阴影之下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: 对吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: 他早就已经过世了。为何要执着于一个并不存在的幽灵呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: 即便是在来世，你也绝对不会与他重逢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: 不必担心——我相信你们并不会进入同一个死后的世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: 不要试图一次抓住所有答案。道路都是一点一滴、一砖一瓦地砌起来的——懂吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: 还有就是……千万不要再像这样跟我说话了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: 目睹你现在所遭遇的一切，我感到非常痛心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: 不过，没有必要畏惧死亡、责任，以及亲密关系、或是其他什么东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: 因为，这些事物全都是生活的一部分。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: 不要试图一次抓住所有答案。道路都是一点一滴、一砖一瓦地砌起来的——懂吗，亲爱的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: 也许，这样想会对你有所帮助……一切都尘埃落定之后，我们或许不会就此消亡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: 昔日，我相信无论是天堂、抑或是地狱，都是存在的。如今？我已经不太确定了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: 或许，我们会去到某个完全不同于此二者的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: 不知，你觉得如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: 怎么了，亲爱的？想要跟我聊聊吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: 你怀孕了，我很确定——不久之后就会生下来，我一定会把他找出来
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: 我得对你进行检查
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: 哎呀。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: 看来，绝望占据了你的心智。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: 你所相信的一切都在分崩离析……却对此鞭长莫及、无能为力。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: 难道，是因为你不想看到事态如同现在一般发展？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: 抑或，是因为……你觉得自己并不属于这个世界——甚至，其他任何世界？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: 不要顾左右而言他，你怀孕了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: 难道，你自己就不害怕吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: 亲爱的……我根本不可能生得这么快。我的肚子甚至都没有隆起来。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: 我能问你一件事情吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: 如果我真的怀了一个孩子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: 要是——就跟你说的一样，快要诞生了的话……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: 你会怎么做呢？你会找到他吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: 他根本就不应该存在于世上
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: 我还没有做出决定
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: 嗯……问得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: 死亡的确非常可怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: 主要因为——我不知道等待着自己的将会是什么东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: 天堂？轮回？又或者是……某些完全不同的事情？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: 根本就没有人能回来与我们讲述。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: 不过，关于你认为自己目睹到的事情……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: 如果我真的怀了一个孩子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: 要是——就跟你说的一样，快要诞生了的话……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: 你会怎么做呢？你会找到他吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: 他根本就不应该存在于世上
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: 我还没有做出决定
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: 人类总会本能地想要保护自己熟悉的事物……即便已经不再有益也一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: 也许……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: 也许，该去睁开双眼、迎接新的事物了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: 抑或，对未知的恐惧真的把你吓得不轻？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: 我会把这个孩子给找出来
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: 我很确定，这个孩子不久以后就会出生
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: 不要害怕放手，特别是这些事物对你没好处了以后。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: 我们之所以会紧紧地抓着某样东西不肯放手，经常是因为它令我们感到熟悉——仅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: 没错，打破现有的习惯的确会使人感到非常痛苦……只是，塞翁失马，焉知非福。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: 我会把这个孩子给找出来
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: 我很确定，这个孩子不久以后就会出生
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: 随你怎么说吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: 到时候……告诉我你发现了什么。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: 宝贝儿，我呀，出生在城里，我那小屋就建在高高的楼房上。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: 乡下的小屋？没有。能唠上几句的老头子或者小孙儿？也不存在。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: 所以我大多时候就瘫在长椅上发呆。在那儿还能蹭到点儿活人气儿，懂吧……哎哟，听到的八卦可多了去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: 可自从这世道开始乱套，唉，我就再也不想待那儿了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: 呸！身边人一个接一个全死了，还享受什么生活！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: 一进楼梯间，总有个可怜虫躺在那儿，身上盖着白布单。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: 天呐，看得人恨不得自己先走了算了，真不忍心再看这种惨状。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: ……所以我就溜了呗！颤巍巍地找个还能听故事、蹭热气儿的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: 结果你猜怎么着？命运一脚把我踹到你家门口啦，宝贝儿！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: 我平时可不进教堂，但这种时候啊……唉，感觉简直像老天拽着我走到这儿似的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: 宝贝儿，大家早就忘了我咯。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: 就算还有人活着，也不会特地过来找我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: 现在的年轻人呐，几乎个个都有这样的毛病。被生活搞得晕头转向，就连自己的亲人也能忘记。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: 全都只顾自己，忙这忙那……就连打通电话寒暄两句都懒得！唉！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: 我有次跟邻居在长椅上聊天，她得意洋洋地谈论起了自己的孙子。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: “我孙儿特别孝顺，总是把我放在心上！”'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: 她没说错！那孩子是不错，总会跟我打招呼，问我过得怎么样。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: 我甚至因此而感到过一丝嫉妒……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: 之后，死亡降临到了她的身上……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: 接着，这个孩子变得特别尖酸、刻薄。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: 结果发现，之前和蔼可亲的样子全都是装出来的，他对邻居好，只是想把人家公寓的钥匙搞到手……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: 你说说看，为什么人能脸不红、心不跳地当着对方的面扯谎？而且，甚至还是自己的亲人。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: 结婚、生子，然后……你猜怎么样？他们根本就不爱你！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: 还好，我早就已经没有丈夫咯……一个又老、又笨，还满肚子坏水的家伙！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: 哎呀，他已经死了好一阵子咯，宝贝。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: 糟老头子……毁了我大半辈子！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: 我会跟他结婚，还不都是身边人逼的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: “嫁给他吧，女儿，他人挺好的。”他们都这么说，我……也这么这么做了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: 起初，他确实对我挺好，等结了婚，那股劲儿过去了，他骨子里的卑劣都暴露出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: 你猜怎么样？我在热得要命的炉子前忙活了半天，他就说了一句“忙活什么呐，没看我吃得正香吗？“'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: 他偶尔会跟朋友出去喝酒，一去就是好几个小时，搞得自己不省人事！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: 醉醺醺地回来之后，还会编一些就连鬼也不会信的事情，说是在车库里玩了多米诺骨牌之类的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: 如果我直接问他是不是去喝酒了，就会挨一顿劈头盖脸的骂，甚至能把整栋房子给震塌。哼，恶毒的老头子。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: 之后，死亡降临到了他的身上。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: 最初，我感到如释重负。只是……很快，空虚便悄然袭来。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: 刚一开始的时候，看看电视还能有所纾解。结果，现在……里面播的全是一些胡言乱语、无稽之谈。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: 于是，我走到路边、坐在长凳上，静看世事流转。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: 天啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: 看着自己周围的一切，我确实觉得好受了点儿。孩子们放声大笑，一对又一对年轻的情侣牵手走过，就连狗狗也迈着轻快的步子……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: 然后，灾变就发生了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: 于是，大家都把自己锁在了家里，街上也没了平日的热闹。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: 透过窗户往外看……也不是什么好事。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: 孩子们曾经嬉戏的地方如今堆满了运尸袋。野狗在街头游荡……邻居开始以对待陌生人的冰冷眼光打量彼此。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: 生活仿佛一下子便停滞不前。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: 现在想分辨谁说的是真话，谁说的是假话都难咯！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: 要是大家能不再尔诈我虞，就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: 啊……凉水。这才像话'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: 感觉好点没？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: 嗯嗯，好多了'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: 不过话说回来'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: 我有点饿了。有吃的没？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: 给你啤酒（递过一罐啤酒）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: 没啤酒？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: 骗鬼呢，我看见你冰箱塞满了。怎么可能这么快喝光？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: 不给
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: 噢！这才对嘛！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: 唔，爽。我最爱这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: 来，给你报酬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: （你收到一沓皱巴巴的纸币，如今已毫无价值）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: 呃……谢了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: 谁要你的钱
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: 够意思！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: 我要什么你给什么，报酬少不了你的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: 帮我的人从来不会吃亏。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: 对了，这个拿去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: （你收到一瓶康普茶）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: 天知道谁喝这玩意儿，但说不定有用。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: "谁要你的钱"？摆什么谱！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: 谁不需要钱？这世界就靠钱运转！"不需要钱"是吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: 拿着这个！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: （你收到一瓶康普茶）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: 天知道谁喝这玩意儿，但说不定有用。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: "不要"？觉得钱买不动你？什么都能买卖！爱情、物件、人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: 这个世界就是靠钱运转的，小子！而我？我可是大人物！我是个议员！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: 行，算了。不帮就滚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: 啊……凉水。这才像话。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: 这次又要什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: 问得好！我想抽烟。有多的烟吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: 给（递烟）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: 没烟？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: 算了'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: 不给
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: 这就对了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: 以前当然抽雪茄……但现在哪儿找去。当初我在议会的时候……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: 是啊……那时不一样。现在只有谋杀和混乱。彻底的地狱！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: 应急中心什么时候来收拾烂摊子？他们总不是白成立的吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: 我在议会时根本没这种破事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: 不过也许需要时间。总会解决的。等着就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: 你当过议员？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: 参与过成立应急中心？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: 当然，刚不是说了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: 哦对，这是报酬！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: （你收到一沓废纸般的钞票和印着应急中心徽章的诡异明信片）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: 胡想什么呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: 哦对，这是报酬！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: （你收到一沓废纸般的钞票和印着FEMA徽章的诡异明信片）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: "不要"？你知不知道我什么身份！？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: 我是议员！政府是精密机器，需要我这样的人运作！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: 我代表人民发声，改善民生！没我这种人，你们屁都不是。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: 要放在平时，你敢顶嘴？立马就把你抓走！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: 世界垮了……没人在乎部长头衔了。都觉得我们光在办公室摆架子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: 呵。等地狱真正降临，看你还嘴硬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: 啊……凉水。这才像话'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: 又想要什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: 挺有眼力见的，小子！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: 我想要……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: 想要能量饮料！好久没喝过带劲儿的了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: 给（递能量饮料）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: 连一罐劲能佳都没有？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: 算了，当我没说。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: 运气不好
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: 喔喔喔！太好了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: 告诉我应急中心的事。他们到底是什么组织？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: 应急中心有什么计划？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: 怎么是无糖的？垃圾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: 还不如给我可乐——等等你刚问什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: 疯了吗？这可是机密！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: 我签过保密协议的懂吗？你没权限知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: 拿去，喝点儿咖啡，别问这种问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: （你收到一罐咖啡）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: 居然是劲能佳。天知道里面加了什么……等等你刚问什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: 疯了吗？这可是机密！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: 我签过保密协议的懂吗？你没权限知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: 拿去，喝点儿咖啡，别问这种问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: （你收到一罐咖啡）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: 什么意思？饿着肚子怎么工作？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: 我在外奔波改善民生！为人民争取权益！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: 你们就知道指手画脚……都觉得自个儿聪明。真有本事，怎么不去政府上班？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: 不就是光会嘴炮，没真没本事么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: 啊……凉水。这才像话。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: 怎么？又要什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: 没错，小子。我要你的霰弹枪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: 什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: 你他妈疯了
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: 我要武器防身。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: 别担心，我打过猎，会用。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: 休想
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: 去死吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: 注意口气，小子。忘了在跟谁说话？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: 信不信我随时能把你扔进监狱！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: 休想
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: 去死吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: 你刚说什么？我没听错吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: 你完了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: 赶紧收拾东西，我要送你去坐牢，哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: 对我来说你和伪人没区别
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: 什么议员，你谁都不是
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: 疯了吗？敢这么对人民代表说话？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: 你摊上事了伙计'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: 惹怒我可是大错特错！议员的手段多的是！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: 放心……很快你就会乖乖听话了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: 对我来说你和伪人没区别
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: 什么部长，你谁都不是
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: 胡说八道什么！？你……说话注意点儿！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: 我不是开玩笑……真的会把你送进监狱，等着瞧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: 胡说八道什么！？你……说话注意点儿！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: 我不是开玩笑……真的会把你送进监狱，等着瞧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: 胡说八道什么！？你……说话注意点儿！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: 那我怎么还没进监狱？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: 嘲讽我是吧？我……我认真的！你真会进去的！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: 官职以前可能有用，但你现在什么都不是
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: 钱也没用了。不明白吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: 胡……胡说！我还是议员！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: 只是……暂时休假……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: 我自欺欺人什么呢……生活再也回不去了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: 想当初坐在办公室里的时候——全国上下都得为我们这些议员服务。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: 人人都怕我、敬我。车子要给我让道，人们争着讨好我、巴结我。可现在……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: 真好……压力大得我胃都抽筋了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: 你现在满意了吧？快滚开，我受够了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: 不对——不对！我还有很多钱！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: 虽然你不在乎，但是……别人都在乎……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: 我自欺欺人什么呢……生活再也回不去了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: 再也没有香槟、没有豪车、没有女人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: 以前有钱能使鬼推磨。家产越厚，地位越高！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: 要不是因为这堆破事……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: 太好了……压力大得我胃绞痛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: 你现在开心了吧？赶紧走开，我受够了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: 今天聊得够多了，我有点累了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: 明天再说'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: 妈的，真是受够了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: 你为什么独自在外游荡？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: 哼……家里太挤。吵得要命。毫无舒适可言。我想逃出去看看世界'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: 所以就背个包，带几罐汽水零食，还有中学编的这破手链……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: 直接走了。爸妈可能都没发现——谁在乎啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: 之后到处流浪，哪儿能睡就睡哪儿。说实话，到目前为止活得还挺好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: 至少没人唠叨，我自个儿当家作主。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: 老天，真是受够了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: 你怎么活下来的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: 凑合活呗。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: 躲楼梯间、棚屋，或者直接睡树下泥地，反正是个能躲太阳的地方就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: 搞到什么吃什么。不是野菜，就是从商店顺的糖果能量棒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: 那什么表情？对，我偷过。怎么了？不然怎么活？我这个年纪，谁雇我干活儿？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: 呃，又怎么了？觉得我会偷你东西？搞笑。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: 搞审讯啊？省省吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: 真受够这一切了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: 你打算这样过多久？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: 要你管？我能搞定'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: 所以是嫌我碍事了？偷你东西了？堵你马桶了？审犯人呐？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: 懂了……你也是变态。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: 之前有个男的收留我。说话好听，给我地方过夜。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: 我们一起看了几小时动漫电影什么的，我还以为遇上好人了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: ……结果他对我动手动脚的。个死变态。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: 敢碰我我就往死里反抗。谁也别想伤我。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: 我爸虽是个烂人，至少教过我怎么打架。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: 没错。滚远点。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: 真受够这一切了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: 那男人后来怎样了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: 问这干嘛？琢磨怎么制服我？好奇我为啥没跟他在一起？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: 别假好心了，我懂的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: 你就是怕惹麻烦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: 但我不是麻烦。没偷没砸窗——别摆那副嘴脸！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: 再说了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: 留我不就为防那个半裸的伪人抓你吗？我又不是不看新闻。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: 要查就查……随你的便！做你那变态检查，别跟我说话。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: 真受够这一切了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: 你爸为什么教你打架？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: 因为这样，我就能把那些对我不怀好意的变态全都揍趴下。或者，他就能拿我出气。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: 挥拳头、挨揍，诸如此类。日复一日，年复一年。知道吗？唯一的问题就是——他揍的不是沙袋，是我的脸。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: 虽说大部分时间都是正经训练——顺便一提，我对此烦透了。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: 有时他发疯就往死里揍。我妈？压根不管不看。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: 呃，真不想变成他们那样。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: 生我又这样对我？图什么？人生就这德行？'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: 现在还得对付太阳和伪人？太好了，糟心事总不嫌多。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: 会有好事发生吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: 我看悬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: 说吧，我在听'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: 医院后来发生了什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: 唉……简直是噩梦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: 刚开始暴乱时，人们冲进医院，疯了一样要确认自己不是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: 我们反复解释根本不知道检测方法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: 但没人听。推搡踩踏，真正需要救治的人反而得不到治疗。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: 最后应急中心来了。说人群对疫情管控造成威胁……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: 所以所有人都被送进隔离区，医院……就这么关闭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: 所以是应急中心让你失业的？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: 应急中心做错了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: 说实话……医院关闭后，我去应急中心隔离区工作了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: 为什么去那儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: 原来你也是应急中心的走狗
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: 你觉得把人都关起来对吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: 那些所谓特征不可笑吗？明明都是正常生理现象。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: 牙白就是伪人？胡说八道！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: 他们绝对隐瞒了真相……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: 说实话……医院关闭后，我去应急中心隔离区工作了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: 本想研究伪人的特征，但毫无进展。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: 为什么去那儿？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: 原来你也是应急中心的走狗
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: 我……我想继续救人。救人是我的天职。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: 或许……不。抱歉，我还不想说。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: 骂我走狗有失公允。你不了解具体情况。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: 或许……不。抱歉，我还不想说。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: 我在听'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: 你想告诉我什么？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: 请问你如何看待应急中心？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: 我觉得应急中心做得对
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: 我不信任应急中心
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: 真遗憾。我跟你看法相反。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: 我跟他们一起工作过一段时间，但没法相信他们，尤其是看到了某些事情以后。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: 据我所知，那个组织里的医生完全被蒙在鼓里。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: 连特征来源都解释不清的机构，值得信任吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: 经历了这些……你还相信应急中心？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: 恕我直言，高估你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: 很好，我也不信。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: 说实话我也不完全清楚应急中心的动机。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: 但无论出于什么目的，我选择用自己的方式违抗规则救人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: 问题在于完全没有透明度。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: 没人告诉我们特征来源和意义。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: 只下发判断指南，说怎么判断伪人和人类。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: 后来我觉得自己不像医生，倒像盖章的边境守卫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: 于是，我开始伪造报告帮人逃跑。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: 你肯定还有疑问。但剩下的……改天再谈吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: 抱歉，今天实在没法继续说了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: 最终我选择离开那个组织。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: 我在听。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: 那你怎么没在隔离区？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: 因为……发生了这样一件事……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: 当时太阳刚升起，我正在回家路上，突然被一名应急中心的工作人员叫住。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: 那一刻我心跳狂飙，膝盖发软，几乎站不稳。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: 他喝令我转身。我……甚至做好了死的准备。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: 他用步枪指着我的腿，警告我不准逃跑。然后死死盯着我。接着……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: 他命令我伸出舌头，说要检查我是不是伪人。我怕他开枪，只能乖乖照做。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: 突然……他大笑起来，说根本没有所谓"舌头特征"，连这都不知道，我这医生当得真失败。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: 我这辈子从没这么害怕过。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: 那一刻我心里想的不是救人，而是怎么活命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: 像个懦夫一样逃跑了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: 这种耻辱……无法忍受。对不起被留在那里的人，对不起自己，对不起所有人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: 不评价你的选择
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: 但你还能救人
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: 懦夫。滚出我家
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: 谢谢理解。我……我心里好受多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: 我总想着如果坚持到最后，或许能救更多人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: 恐怕我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: 所有器械都落在隔离区了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: 所以……现在的我毫无用处。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: 我知道你希望我能治病救人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: 但手里什么都没有的老头子，能做得了什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: 抱歉，让你失望了。我对抗不了伪人威胁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: 没关系，你可以留下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: 那就滚吧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: 你说得对。我该走了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: 再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: 谢谢理解。我……我心里好受多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: 我总想着如果坚持到最后，或许能救更多人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: 但总忍不住想，或许豁出性命能救更多人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: 这种负罪感会纠缠余生吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: 或许你是对的。我这种老家伙确实没用了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: 再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: 为什么问这个？想弄清我不信任应急中心的原因？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: 从这个问题开始吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: 你认为伪人是某种病毒吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: 我觉得根本不存在
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: 不认为，但不知道真相
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: 是的
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: 既然这么想，何必做这些检查。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: 你该跟我说实话。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: 所以……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: 明白了。可惜我也不清楚伪人本质。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: 但能肯定绝不是病毒。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: 要让你失望了，很可能不是。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: 见过好好的人突然变成伪人吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: 没错，从没有过这种案例。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: 要知道应急中心根本控制不住局面，只是在演戏。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: 他们把人关医院建隔离区……到底是为了什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: 救人了吗？有人治好了，放出来了么？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: 应急中心就是把人们圈起来囚禁，为所欲为。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: 那你为什么为应急中心工作？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: 别废话了，滚
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: 不能眼睁睁看着人们一个个死去。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: 我加入应急中心。就为了帮那些可怜人逃离隔离区。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: 我检查诊断，伪造文件放他们自由。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: 你可能放跑了伪人
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: 什么事件？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: 可惜你也要从这儿逃跑了
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: 连听都不愿听真遗憾……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: 不占你地方了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: 再见。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: 那我该怎么做？难道眼睁睁看他们死？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: 我发过希波克拉底誓言，必须竭尽全力守护生命。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: 但最后……因为那件事，我自己也逃离了隔离区。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: 就在我负责的区域，出了意外……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: 什么！？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: 觉得我不该救人？现在要为这个赶我走？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: 没想到你比应急中心更恶劣。他们至少还假装救人，而你……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: 这里容不下我了。真担心被你照看的人会怎么样。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: 告辞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: 别拘着，想问啥直接问。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: 还觉得应急中心在追捕你？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: 真希望不是啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: 是，我搞砸了。就不该往应急中心开，早该想到他们会连我一起抓。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: 本以为他们只抓乘客，会放我走人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: 结果扣了我的车还差点崩了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: 但你说能咋办？那家伙是伪人啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: 如果他是人类呢？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: 你没得选
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: 唉……别这么说。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: 我已经够难受了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: 嗯……确实没别的办法。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: 真怀念从前握着方向盘啥都不用操心的日子。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: 现在遇上伪人……妈的，说不定下个乘客就给你一枪。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: 唉……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: 别拘着，想问啥直接问。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: 开多久出租车了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: 有些年头了。现在没挂靠公司，自己单干。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: 应急中心压根不让平民随便跑。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: 但这堆破事总有一天会结束吧？而且钱……钱总是好东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: 危险路线收费高。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: 开夜车还能想起小时候。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: 我爸也是出租车司机，我从小就想子承父业。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: 不过，我不想像他那样死在路边没人管……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: TaxiDriver:希望我运气还没用完……
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: 别拘着伙计，想问啥直接问。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: 今天看你挺沮丧
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: 是啊，就是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: 实在迈不过丢车这个坎。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: 以前开的什么车？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: 那辆车有什么特别？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: 那可是最漂亮的经典款……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: 明黄车身，镀铬轮毂锃亮，线条流畅……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: 但现在没了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: 该死的应急中心……那辆车就是我的命！混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: 是我爸留下的。他以前也开出租。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: 小时候最爱夜里跟他出车。总在后座睡着，他就一直带着我。但后来……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: 只能说运气用光了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: 别拘着，想问啥直接问。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: 你父亲后来怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: 一般不跟人说这些……但我觉得你可以信任，就告诉你吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: 那天我妈出差，我爸只好带着我工作。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: 结果载了个永生难忘的乘客。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: 西装笔挺的秃头，笑得像野兽……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: 全镇都认识他。连我这种小孩都知道，对这种人说个不字会是什么下场。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: 但我爸特别耿直，他做的选择……害苦了我们。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: 穿西装的那位让我们付出了代价。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: 房子没了，往后去哪儿都不敢住太久。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: 因为穷，我爸一直开着那辆出租。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: 到老了债台高筑，他开始后悔留这辆车。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: 说是被诅咒了，霉运都是它带来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: 但他始终不明白。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: 让我们失去一切的不是那台车，而是他的骨气。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: 他的选择让我早早打工养家……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: 可我还是爱他。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: 想老爷子了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: 不求别的……要是不麻烦，能不能……给他打个电话？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: 号码是{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: 就说我一切安好。本来可以自己打，但现在……我不能暴露位置。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: TaxiDriver:……
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: 希望我没晒太多太阳……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: 你确定不是应急中心的人？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: 真不是。说过以前修冰箱的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: 这制服在车里捡的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: 之前你说从尸体扒的
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: 没骗我吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: 这个……嗯，对。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: 在车里死人身上发现的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: 想着穿制服能防伪人。应急中心穿这个总有点用吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: 没说谎，就是压力大记混了，这有什么奇怪的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: 信我，要是见过我见的那些……你就明白了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: 来这儿路上差点吓死，地上尸体一直抽搐。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: 希望我没晒太多太阳……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: 不觉得穿应急中心制服很危险吗？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: 啊？呃……不会吧'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: 确实有人不喜欢应急中心，但……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: 噢，你是怕我被应急中心找麻烦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: 听着，我……我觉得解释清楚他们会信的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: 别把他们当恶魔，应急中心又不是什么秘密结社。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: 希望我没晒太多太阳……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: 看看你口袋里有什么
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: 嘿，为什么搜我？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: 找你的应急中心ID卡
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: 藏了什么见不得人的东西？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: 什么ID卡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: 我发誓真没有这玩意儿……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: 口袋里的东西都掏出来……别逼我动粗
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: （拔枪）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: 你说谁？我？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: 不行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: 口袋里的东西都掏出来……别逼我动粗
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: （拔枪）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: 好吧，枪放下……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: 给。满意了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: 是，我认了。确实是应急中心的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: 但千万别告诉别人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: 妈的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: 拿去。别开枪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: 对……我确实是应急中心的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: 但最好别让人知道……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: 为什么隐瞒身份？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: 演这出戏图什么？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: 真不明白？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: 你居然这么问！？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: 要是让人知道我为应急中心工作过……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: 听着，我已经不干了。就当是……辞职了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: 听着，我已经不干了。就当是……辞职了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: 是，当时不得不做那些事……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: 抓人，送隔离区……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: 但那是工作，明白吗？上头怎么说，我就怎么做。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: 问抓了谁没用，那是上头定的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: 说我是杀人犯什么的……太荒谬了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: 要你这么说的话，那杀手除掉另一个杀手叫什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: 希望我没晒太多太阳……'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: 为什么隐瞒应急中心身份？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: 有次抓了个有伪人特征的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: 结果他在隔离区恶化死了。常有的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: 后来他老婆来找，问什么时候放人。我们说没什么可放的了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: 她当时就崩溃了。吼着骂我们凶手，非要领回尸体。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: 按规定不行，但她不听。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: 直接躺大门口不走'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: 最后我们只好交出尸体。所有违反规定的都被开除了，包括我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: 她非要那具尸体不可。都赖那个疯婆子，她害我丢了工作。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: 现在无处可去……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: 她没安葬丈夫，整天拖着尸首到处走。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: 就为了这个害我们全员被开除很值是吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: 你们应急中心真是群混蛋
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: 运气不好
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: 你说什么！？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: 我尽职工作，因为神经病被开除……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: 你还说我们是混蛋！？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: 去你的，你知道个屁！我走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: 老天啊，人是不是都疯了？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: 我看大家早就疯了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: 自从太阳出事，感染肆虐，所有人都疯了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: 就为了具尸体，害得我们工作都没了，你说说，这到底合不合理？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: 她和丈夫团聚是好事
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: 不该给她尸体
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: 你觉得我们被开除很好？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: 你们平民根本不懂。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: 当初就该像处理她丈夫一样毙了她。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: 你刚说什么？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: （拔枪）
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: 这什么表情？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: 规定说如果受污染的平民情况恶化……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: 那该就地处理，避免伪人进入隔离区。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: （拔枪）
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: 谢谢理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: 我不是凶手，只是上头怎么说，我就怎么做。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: 喂，你干什么！？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: 冷静，他是伪人！而且快不行了！不能放走。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: 别开枪，我只是按命令行事。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: 我也觉得。得该按规程来。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: 好了，不烦你了。谢谢你知道我身份还收留我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: 要是能复职，会记你一笔功劳的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: 行了，我就说到这儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: 对了，差点忘了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: 明晚我就回家了，电话线路刚通，有事可以给我打电话。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour: 你记一下我家号码：{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: 好，这回真说完了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: 喝罐啤酒就去睡吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: 喵！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: 摸摸猫
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: 抱起猫
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: 喂猫吃罐头
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: （你伸手摸了摸猫咪）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: （不知道它喜不喜欢你这么摸它）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: 喵！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: 摸摸猫
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: 抱起猫
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: 喂猫吃罐头
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: （你决定继续摸猫）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: （它好像很喜欢你这么摸它）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: （猫的脾气没你想的那么坏）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: （好像开始习惯跟你相处了）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: 喵！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: 摸摸猫
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: 抱起猫
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: 喂猫吃罐头
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: （你经常来摸它，它很享受）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: （你感觉它在主动蹭你的手）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: （谁能拒绝得了这样的小可爱呢）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: 喵！喵呜！喵——'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: （毛茸茸的脸很难读懂，但你觉得它肯定很开心）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: （你莫名觉得今晚能睡个安稳觉）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: （毛茸茸的朋友好像分了条命给你，作为感谢）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: （谁知道呢……死亡今晚说不定会绕过你家）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: 可怜的孩子……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: 怎么了？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: 嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: 我……我只是在想……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: 这次如果不是消灭全人类的大灾难，我们活了下来……那接下来又要面对什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: 到底有什么样的未来在等着我们？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: 怕新世界没你的位置？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: 如今这世道，温柔的人活不久。最好找个依靠
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: 温柔啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: 我做不到靠暴力生存'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: 不知道该怎么融入你说的……“新世界”'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: 好吧，看来你的计划就是……不做任何抵抗，平静迎接死亡？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: 既然如此，你打算怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: 人类以前也经历过黑暗的时期……这又不是第一次
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: “新世界”里，杀戮还在继续，暴力随处可见。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: 我不想那么活下去，就算有人给我当依靠，也不想……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: 好吧，看来你的计划就是……不做任何抵抗，平静迎接死亡？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: 既然如此，你打算怎么办？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: 人类以前也经历过黑暗的时期……这又不是第一次
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: 我很迷茫。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: 难道，我们要在一个满是残暴之徒的世界里继续生活下去？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: 难道，孩子们将来要向……杀人凶手学习？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: 现在可不是自怨自艾的时候
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: 振作一点！
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: 我不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: 我没有任何想法。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: 只是希望……这一切能赶紧结束。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: 我……已经无法再忍受下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: 没错，只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: 我们该怎么活下去呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: 大家都失去了理智，一心想要把与自己……有所不同的人给赶尽杀绝。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: 不管挡在自己面前的人是谁，都无所谓。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: 现在可不是自怨自艾的时候
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: 振作一点！
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: 为什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: 也许你可以令自己对一切都感到麻木不仁，然而……我做不到。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: 要是你能见到我所目睹的事情的话，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: 那幅光景……已经永远地烙印在了我的眼睛里。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: 熊熊燃烧的烈焰、惨绝人寰的尖叫……愤怒的脸庞、惊恐的神情……以及，被夷为平地的房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: 我实在无法做到跟你一样。我没有那么坚强。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: 对我来说……只能这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: （她抖了一下，惊恐万分地看着你）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: （内心的困惑令她一时之间忘了这场噩梦）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: （她捂住了自己的脸，低声地哭了起来）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: （你不知所措——根本就没人教过你面对这种情况到底该怎么办）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: （你小心翼翼地将手放在了她的肩上，就这样维持了一会）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: （看来，最好还是让她自己一个人静一静）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: 不如，这样好了——也许，你可以帮我打个电话给他？我记得号码是……{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: 好好教训他一顿。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: 毕竟，他们也是他的孩子。他也应该帮忙一起寻找。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: 要是线路还没被切断的话……就帮我打个电话过去，好吗？号码——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: 就说——我还记得自己的所作所为……直到今天，我也对此后悔不已。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: 又或者是，直接骂她一顿。就当是为了我。唉，我也不知道……也许，这样会稍微轻松一点吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: 至于有些人……这么说吧，则需要来自另一层面的帮助。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: 其实，世上存在一些懂得如何驱散黑暗的……能人、专家。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: 要是有这样的需求的话，我可以把联络方式给你。也许能派上一些用场呢……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: 我把号码写下来好了——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: 记得跟他们说，是我推荐的……千万别忘了！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: 要是不麻烦的话，能帮忙打给他吗？来，这是号码——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: （他递给了你一张纸条，上面写着一串电话号码——{0}）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: （也许，是大使馆的联系方式）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: 我真的好想喝上一杯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: 你经常挂在嘴上的……“不死之人”？到底是什么意思？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: 关于这个……你可以试着往自己的脑袋开一枪，看看有什么后果……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: 不过——换作我的话，不会这样做。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: 因为，这种不朽并非寻常意义上的不朽。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: 死后，我们会进入轮回、进行转世，获得新的生命、继续过着生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: 我也知道这一切听起来十分离奇，但是……如果你能看到我所目睹的事情，你一定可以理解我到底在说什么。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: 也许，伪人曾经也是人类——只是，死后转生成了现在的模样。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: 我也说不出个所以然来。我也不知道这一切究竟是什么原理……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: 不过，我相信——大自然一定向我们隐藏了数不清的秘密。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: 而且，我一定会找到自己的女儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: 虽说清楚会在哪次生命之中，然而……我一定可以。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: 因为，我们都无法丧命。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: 我真的好想喝上一杯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: 为何应急中心会追捕你？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: 因为，我当时正处于这一切事件、这一片混乱的中心。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: 就在它们爬出来的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: 不知，你是否记得那些关于城郊会有恶魔出没的荒诞故事？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: 当我没问——现在，应该已经不会有人晓得了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: 你猜怎么样？其实，传说都是真的。从一开始，应急中心就全都知道了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: 虽说，他们坚称并没有什么怪力乱神。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: 然而，事实却恰恰相反。现在——太阳正无情地炙烤着每一个人……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: 不仅如此，即便逃过一劫、也还是得面对一群虎视眈眈的吃人怪物！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: 应急中心知道自己搞砸了……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: 现在，他们正在忙着掩盖自己的无能。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: 我只不过是在错误的时间、出现在错误的地点罢了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: 我真的好想喝上一杯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: 你是怎么活下来的？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: 我是不死之人。怎么，这么快就忘了？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: 我不知道……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: 其实，我也有着同样的疑问。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: 也许，是运气使然。也有可能是某股……更为崇高的力量在保护着我。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: 上帝——或是你们信仰的其他什么神明。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: 又或者说，其实……我早就已经死了。现在这条，已经是新的生命了。我也不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: 只能说，问得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: 太可惜了，手上没枪……不然，我也会问你同样的问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: 而且，你这里竟然只有啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: 要是可以找来蒸馏器的话，我能酿出一批令你赞不绝口的美酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: 我真的好想喝上一杯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: 你还知道些什么？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: 我对整个应急中心的架构了如指掌：'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: 谁对谁负责、谁做了什么，以及谁和谁搞在了一起。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: 而且，他们对伪人知根、知底——非常清楚它们有多么的危险……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: 却还是任由它们渗透进了城里。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: 因为根本就没有人把安全问题当一回事。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: 这些家伙只不过是政府洗钱的工具罢了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: 不管是谁，只要目睹到了他们犯下的一切、都会遭到抹除。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: 这个组织根本就不想任何人知道关于他们的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: 而且，早在设立隔离区之前、他们就是这样做的了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: 我也是费了九牛二虎之力才逃出了生天。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: 想知道机密信息吗？好，听仔细了……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: 全都是应急中心的错。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: 至于他们在电视上说的事情？净是一些鬼扯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: 如果说有什么要比伪人更加恶劣……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: 就是应急中心。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: 我真的好想喝上一杯。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: 伪人是从哪里来的？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: 让我检查一下
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: 城郊。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: 没错，我很清楚，隔离区的确离那儿有一段距离……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: 不过，我很确定。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: 虽然，我并不是什么迷信的人。不过……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: 它们跟大家两年前谈论的恶魔，是同一群。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: 虽然，我也不知道它们究竟是怎么渗透进这座城市的……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: 不过，我很清楚它们是在谁的默许下行动的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: 正是应急中心……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: 出乎绝大多数人的意料，伪人并非什么异星来客。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: 而是与你、与我一样——'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: 出生在地球的生物！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: 我不能继续待在这里了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: 我得去找自己的女儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: 谢谢你……不死之人。'
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: （这个话题好像已经聊过了）'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071808
    m_Localized: 给出一张应急中心收治函
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071809
    m_Localized: 给出一张应急中心收治函
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071810
    m_Localized: 给出一张应急中心收治函
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071811
    m_Localized: 给出一张应急中心收治函
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071812
    m_Localized: 给出一张应急中心收治函
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071813
    m_Localized: 给出一张应急中心收治函
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071814
    m_Localized: 给出一张应急中心收治函
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071815
    m_Localized: 给出一张应急中心收治函
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071816
    m_Localized: 给出一张应急中心收治函
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071817
    m_Localized: 给出一张应急中心收治函
