    m_Localized: Abandonar
    m_Metadata:
      m_Items: []
  - m_Id: 3661098318024700
    m_Localized: Salir al menú sin guardar.
    m_Metadata:
      m_Items: []
  - m_Id: 3663275547676670
    m_Localized: Abrir
    m_Metadata:
