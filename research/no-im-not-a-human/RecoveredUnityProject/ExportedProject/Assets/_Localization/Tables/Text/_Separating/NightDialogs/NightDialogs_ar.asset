%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_ar
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ar
  m_SharedData: {fileID: 11400000, guid: 2e47acfd0901bcf4eba15f47b223778b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: يا هذا. *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: أيمكنك السماح لي بالدخول يا صاح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: من أنت؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: ماذا حدث لك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: أنا *يسعل* رجل إطفاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: لفحتني الشمس اليوم بينما كنا نطفئ حرائق الغابات.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: حمانا الدخان الكثيف من الاحتراق التام، ولكن *يسعل* الوضع لا يزال مروعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: الأشجار... *يسعل يسعل* احترقت كأنها أعواد كبريت.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: لم أرَ شيئًا كهذا من قبل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: غطت جثث الحيوانات المحترقة أرض الغابة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: ألا يجب أن تكون في المستشفى؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: ماذا ستفعل؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: لقد تعرضت لأشعة الشمس الحارقة *يسعل* أثناء إطفاء حرائق الغابات.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: أنا الوحيد المتبقي من فريقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: أما الباقون... *يسعل* المدير لم يسمح لهم بالمغادرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: والآن علقوا في نوبة عمل أبدية.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: ألا يجب أن تكون في المستشفى؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: ماذا ستفعل؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: مستشفى؟ لم يعد هناك مستشفيات يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: عندما جاء الزوار، تبدد الغرض من المستشفيات بالكامل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: يصعب تلقي العلاج دون ثقة بمن يعالجك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: لا أحد يستطيع *يسعل* مساعدتي الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: كان من الأفضل لي أن أخمد تلك الحرائق وأموت هناك مع رفاقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: لم يتبق لي الكثير من الوقت على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: أردت أن أستمر في إخماد تلك الحرائق. أتمنى لو كنت قد مت هناك بدلًا من رفاقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: لكنهم أوضحوا لي *يسعل* أنني فعلت ما بوسعي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: والآن لا أستطيع العودة إلى المنزل. وسائل النقل العام لم تعد تعمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: الشيء الوحيد الذي يمكنني فعله الآن هو الاعتماد على طيبة البشر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: شكرًا يا صديقي. *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: لا أعتقد أنني سأزعجك لفترة طويلة. *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: على الأقل لن أموت وحيدًا في العراء.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: سحقًا. *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: لا أريد أن أموت وحيدًا في العراء...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: آمل *يسعل* ألا تنتشر الحرائق في المدن.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: أهلًا، كيف حالك!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: لم نلتقِ منذ فترة طويلة. كيف أخبارك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: ...هل أعرفك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: مَن أنت؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: ألا تتذكرني يا رجل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: كنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: لحظة، صوتك يبدو مختلفًا عما أتذكر...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: منذ متى تعيش هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: لطالما كان هذا المنزل ملكًا لعائلتي
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: أعتقد أنك أخطأت العنوان...
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: أوه، أنت لست...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: أنت لست صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: منذ متى وأنت تعيش هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: لطالما كان هذا المنزل ملكًا لعائلتي
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: أعتقد أنك أخطأت العنوان...
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: لا، مستحيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: لم أرتكب أي خطأ في حياتي! ذاكرتي أقوى من الحديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: صديقي يعيش... أو، كان يعيش... هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: بحقك، لقد قطعت مسافة طويلة بالكرسي المتحرك لأصل إلى هنا. ألن تسمح لي بالدخول، من فضلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: مستحيل، لا يمكن أن...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: لا...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: اللعنة...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: أعتقد أنني أخطأت العنوان فعلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: بحقك، لقد قطعت مسافة طويلة بالكرسي المتحرك لأصل إلى هنا. ألن تسمح لي بالدخول، من فضلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: أوه! هذا ما أردت سماعه!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: يبدو منزلًا واسعًا جدًا يا صديقي. هل تريد أن نتسابق؟ 3... 2... 1... انطلق!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: أرحل؟ ماذا تعني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: هل تتوقع أن أرحل بهذه البساطة!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: أوه، سأرحل عن هذا المكان القذر. يا لك من مغفل معتوه!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: كفى! توقف عن التململ وقِف ثابتًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: مرحبًا. هل يمكنك مساعدتنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: ماذا حدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: ماذا تريدين مني؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: أنا متعبة جدًا. أريد النوم قليلًا وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: لديّ خمسة أطفال. وهذا هو الأخير المتبقي منهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: اختفى زوجي أيضًا. لا أعرف إن كان قد مات أم هجرنا، لكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: كل ما أريده الآن هو الاستلقاء والنوم لبضعة أيام.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: أين ذهب أطفالكِ الآخرون؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: هل مات أطفالكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: من فضلك دعني أدخل حتى أستطيع النوم. أنا متعبة جدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: كان لديّ خمسة أطفال. هذا هو الأخير المتبقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: لا أعرف من أين أبدأ في البحث عنهم. أريد الحصول على قسط من النوم وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: أين ذهب أطفالكِ الآخرون؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: هل مات أطفالكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: لا أعرف. ربما أخذهم والدهم. أريد الذهاب إلى منزله، لكنني لم أعد أملك القوة لذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: بالطبع كانت بيننا مشاحنات كثيرة، لكن ماذا تتوقع من حياة مشتركة مع إنسان أحمق؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: انسَ أمره. أهم شيء عندي الآن هو العثور على أطفالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: لا تقل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: من الصعب الاعتناء بهؤلاء الأشقياء، ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: لم يحدث لهم أي شيء. ربما ذهبوا إلى منزل أمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: كانوا يهربون دائمًا إلى هناك عندما يملّون مني.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: أو عندما يأتي والدهم لطلب المال... مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: هل ستسمح لي بالدخول؟ أريد فقط أن أرتاح وأذهب للبحث عن أطفالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: أخيرًا سأرتاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: هيا، أسرع. ادخل مكانك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: سنغادر هذا المكان غدًا، أعدك بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: حسنًا، سأحاول الذهاب إلى منزل أمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: قد لا أتمكن من ذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: ولكن لا، يجب أن أذهب. هذا طريقي الوحيد...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: مرحبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: أنا في مزاج سيئ للغاية، لذا أعتذر مقدمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: هناك الكثير من الحمقى هنا. آمل أنك لست واحدًا منهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: عمَن تتحدث بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: لستَ واحدًا من هذه ... الأشياء، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: أتحدث عن الجميع.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: كل هؤلاء الأوغاد الذين لم يمنعهم من قتل بعضهم بعضًا سوى الإيمان أو أشياء تافهة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: ماتت آداميتهم بعد انهيار معتقداتهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: أصبحوا الآن حيوانات عديمة العقل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: وكأن كل هذه المصائب مع الزوار لم تكن كافية... الآن علينا أن نتعامل معهم أيضًا. اللعنة!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: ما الذي أزعجك هكذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: كيف تختلف عنهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: سؤال وجيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: لا بد أنك لاحظت أن هناك الآن فئتين من الناس، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: هناك فئة تتكون من ساديين مغفلين. أسوأ من أي زائر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: يفعلون ما يحلو لهم. يمكنهم قتلك في أي لحظة وبلا سبب مقنع!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: والفئة الأخرى تضم الأغبياء. يمكنك أن تدوس عليهم وسيشكرونك على إظهارك الرحمة لهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: ...وكلاهما يغضبني للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: ما الذي أغضبك هكذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: كيف تختلف عنهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: لا تأخذ الأمر على محمل شخصي. الأمر هو...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: كل هذه المصائب التي حلت علينا من الشمس والآن الزوار اللعينون، يبدو أن البشرية كلها ستنتهي قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: وأنا غاضب... كل ما أردته هو أن أعيش حياة طبيعية، أتفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: كنت أؤلف الموسيقى. ولم يعد أحد يهتم بهذه التفاهات.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: أحاول الآن ألا أصبح جزءًا من أي من الفئتين.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: أريد أن أصدق أنني مختلف عنهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: ولعلمك، يخيفني للغاية التفكير في أن أتحول إلى أحد هؤلاء المجانين.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: أو أن أكون ضحية جبانة. لا أريد أي منهما.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: ولكن بصراحة...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: أعتقد أن الضحايا أسوأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: يجلسون يعدون الثواني حتى يتم قتلهم، أو يصيبهم شيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: لو رأيت كل ما رأيته، لفهمت غضبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: لا تقلق، لن أكون مصدر إزعاج.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: ولا، لن أضرب أحدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: أوجه غضبي نحو نفسي حتى لا يعاني أحد آخر من حولي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: اللعنة، حالك كحال بقية هؤلاء الجبناء البكائين.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: ستجلس هنا وتتقبل الأمر الواقع حتى يقتلونك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: سحقًا لك!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: أشعر أن الطاقة هنا راكدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: شيء سيئ للغاية يحدث في الداخل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: الشمس والأسد في البيت الخامس. أرى كل شيء بوضوح تام.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: أنت شخص حازم جدًا، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: هاه؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: لا أحتاج إلى أي شيء منكِ
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: أرى أنك تفضّل الأفعال على الكلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: أنت برج الأسد، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: لقد جمعت كمية كبيرة من الطاقة المظلمة هنا. أجل... هذا لا يبشر بالخير...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: لا أفهم بعد كيف أو لماذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: كل شيء يبدو مهملًا للغاية، أعتقد أنني يجب أن أبدأ بالعبارات التشجيعية.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: شكرًا على التفوه بكل هذا الهراء الذي لا يحتمله ذهني المضطرب بالفعل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: حسنًا، وماذا غير ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: لا أحاول تجاوز حدودي هنا يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: يمكنني فقط مساعدتك على فهم العلاقة السببية وراء المعاناة في هذا المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: ستة وستون كرمية، مثل مجموعتين من الأسماك تدوران في دوائر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: ساعدني وسأساعدك. فهمت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: شكرًا على التفوه بكل هذا الهراء الذي لا يحتمله ذهني المضطرب بالفعل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: حسنًا، وماذا غير ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: أفهم أن هذا أمر مزعج لك لأنك من برج الجدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: هناك مجموعة أبراج مختلفة داخلك. أنت شخص متناقض.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: يمكننا استخدام العبارات التشجيعية للوصول إلى أعماق كونك الداخلي. أنت تفهم ذلك، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: وعندها سنحل كل التناقضات بداخلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: هناك أشخاص مقيدون في حيواتك السابقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: امنحهم الحرية. فأنت تكرر تجارب حيواتك السابقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: عليك أن تسامحهم وتتقبل ماضيهم بداخلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: وعندها ستتمكن من كسر هذه الحلقة المفرغة التي تعيشها.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: هل تفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: آه، رائع. بصراحة، أنت تعيش في مكان ممتاز.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: هناك تيار قوي من الطاقة الإيجابية يتدفق عبر منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: إذن لا تريد رحلة تحسين نفسك، أهذا ما تقوله؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: ألا تريد أن تصبح شخصًا أفضل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: يا له من أمر مؤسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: سأحرص على أن أصيبك بنوبة إسهال شديدة للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: مساء الخير.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: أنا من الوكالة الفيدرالية. ونجري زيارات منزلية في حيّكم للتحقق من حالة سكانه.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: هل أنت بمفردك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: لماذا قد أثق بك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: لا، بالطبع لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: انقسمت فرقتي إلى مجموعات أصغر حتى نتمكن من تغطية مساحة أكبر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: لن يستغرق الأمر الكثير من وقتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: لماذا ترتدي ملابس واقية؟ هل يجب أن نرتديها نحن أيضًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: كيف ستساعدنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: يمكنني أن أريك أوراق اعتمادي، إذا كان ذلك سيطمئنك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: على أي حال، نادرًا ما يتحرك الزوار في مجموعات. وربما لا يحدث ذلك أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: لماذا ترتدي ملابس واقية؟ هل يجب أن نرتديها نحن أيضًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: كيف ستساعدنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: لا. ولكن يمكنك شراء بعضها إذا كان ذلك سيساعدك على الشعور بأمان أكبر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: ما زلنا ندرس تأثير الشمس على البيئة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: ومن المهم أن نكون حذرين لأننا نقضي الكثير من الوقت في الخارج.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: ماذا سيحدث بعد ذلك إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: هل تمتلك الوكالة الفيدرالية خطة لحل هذه الأزمة؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: أول ما سنقوم به هو جمع المزيد من البيانات لإرسالها إلى مقر الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: بمجرد أن نفعل ذلك، ستتمكن الوكالة من وضع إجراءات استجابة مناسبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: كل ما عليك فعله الآن هو التزام الهدوء.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: ماذا سيحدث بعد ذلك إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: هل تمتلك الوكالة الفيدرالية خطة لحل هذه الأزمة؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: سآخذ شخصًا واحدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: وسنجري اختبارات للتأكد من أنه بخير ولتحديد ما إذا كان من الآمن له الاستمرار في العيش في المنطقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: كما سنتحقق من أنه بشري بالطبع.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: هل أحتاج إلى حزم أمتعتي؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: هل عليّ الانتظار هنا حتى يحدث شيء ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: بالطبع. لكن لا يمكننا تنفيذ خططنا من دون دليل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: لذا، سنأخذ أحد الأشخاص المقيمين هنا إلى مختبرنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: سنجري عليه عددًا من الاختبارات للتأكد من أن كل شيء على ما يرام، ثم سنعيده.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: هل أحتاج إلى حزم أمتعتي؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: هل عليّ الانتظار هنا حتى يحدث شيء ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: أهذا منزلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: في هذه الحالة، لا. ابق مع المقيمين الآخرين. إذا قررنا إخلاءك، فسنعلمك بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: سنأخذ شخصًا واحدًا فقط ونواصل طريقنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: طابت ليلتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: نعم. بمجرد حصولنا على مزيد من المعلومات، سنقدم تعليمات لجميع المواطنين.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: ليس لديك ما يدعو للقلق في الوقت الحالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: سنأخذ شخصًا واحدًا فقط ونحاول إعادته إليك في أقرب وقت ممكن.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: اعتنِ بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: ها قد التقينا مجددًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: أتذكر أن الأمور كانت مختلفة بعض الشيء آخر مرة التقينا فيها. ومع ذلك، ما زلنا على قيد الحياة...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: همم... إنه أمر غريب — لا أعرف كيف أشرحه لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: أود أن أبدأ حديثنا... بتنبؤ ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: تنبأ بمستقبلي باختيار صفحة من هذا الكتاب. على أي صفحة أفتحه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: من صفحة ما في البداية
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: افتحه من الوسط
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: افتحه من نهايته
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: "سيتكلم الموتى قريبًا، لكن لن يصغي أحد إلى كلامهم."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: يا للهول...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: الأمر ينطبق على الوضع الحالي بشكل صادم.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: على الرغم من أنني أعتقد أنه ليس من المفاجئ سماع ذلك الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: ماذا يعني ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: هل تصدق ذلك حقًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: مَن أنت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: "أنا؟ أنا أنا. وأنت؟ أنت كنت في المنزل."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: هممم. نعم. هذه قصة مأساوية بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: هل هذا ما ينتظرنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: هذا ممكن.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: ماذا يعني ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: هل تصدق ذلك حقًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: "لقد كان ذلك منذ زمن بعيد. ربما كان حلمًا. ربما أنا وأنت والسمكة...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ...في ذاكرة شخص مات منذ زمن بعيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: ربما لا يوجد أحد أصلًا، وربما المطر يهطل في الخارج."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: هممم... يبدو أن الأمور قد تختفي حقًا في وقت قريب جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: ما رأيك؟ هل نعيش حلم شخص آخر؟ أم أننا نحلم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: كلام مثير للاهتمام.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: ماذا يعني ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: هل تصدق ذلك حقًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: أحتاج إلى التفكير في الأمر بعناية. هل لديك أي أفكار لتطرحها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: على أي حال، لقد جئت إلى هنا فقط لأخبرك بشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: ستبدأ الأحداث الكبرى قريبًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: وعليك أن تكون مستعدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: قد يبدو الأمر غريبًا... لكن القط يجب أن يدخل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: لا أستطيع أن أشرح كيف بعد، لكنني متأكد من أنه سيساعدك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: ويمكنك بالطبع اختيار ما تريد أن تفعله بهذه المعلومات.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: أما أنا، فسأذهب لأفكر في المعنى الأعمق لتنبؤاتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: ليس بشكل كامل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: أراها بمثابة نصيحة، كي لا تنسى مهمة لم تكملها، أو لعلها طريقة لشد الانتباه.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: بينما كنت أفكر في معناها الأعمق، خطر في ذهني رسالة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: عندما يحملق القط في عينيك، احرص على أن تدخله إلى المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: لا أستطيع أن أقول السبب بعد. لكن هذا من شأنه أن يجعل الأمور أسهل عليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: في هذه الأثناء، سأتدبر مليًا الخيار الذي انتقيته من الكتاب.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: مرحبًا أيها البشري.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: يا لها من نعمة أن نشهد بأعيننا الحساب الأخير للبشرية!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: الأرض تُطَهَّر من الخطيئة! الشمس، منقذتنا المقدسة، تغسلنا بنارها الإلهية.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: سنمضي نحو عالم جديد طاهر!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: انظر إلى أشعة الخلاص المباركة هذه!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: أنت تخيفني يا هذا
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: ألا تزال عاجزًا عن الفهم أيها المخلوق الأعمى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: حسنًا، دعني أنير عقلك التعيس.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: الشمس لا تحرقنا وتشويّنا أحياءً دون سبب! إنها تطهرنا من ذنوبنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: لقد دنست شهواتنا وجشعنا هذا العالم، وأغضبنا الشمس!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: وهذا هو عقابنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: وهذه نعمة وبركة. فكل الذنوب ستزول، وسنعيش كأرواح صالحة تحت نورها!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: والحل هو... أن نموت؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: ماذا سيحدث لك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: هل أنت خائف؟ هل جننت!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: حسنًا، دعني أنير عقلك التعيس.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: الشمس لا تحرقنا وتشويّنا أحياءً دون سبب! إنها تطهرنا من ذنوبنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: لقد دنست شهواتنا وجشعنا هذا العالم، وأغضبنا الشمس!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: وهذا هو عقابنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: وهذه نعمة وبركة. فكل الذنوب ستزول، وسنعيش كأرواح صالحة تحت نورها!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: والحل هو... أن نموت؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: ماذا سيحدث لك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: على العكس تمامًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: ستُطهر خطايانا. وقد تختفي الشمس نفسها. لكننا سنعيش.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: لن يكون هناك موت، ولا سرقة، ولا أوغاد جشعون يرفضون بيعي ما أريد بسعر عادل بعد التطهير.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: هل يمكنك أن تتخيل ذلك؟ هل فهمت الآن سبب حدوث كل هذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: ما علاقتي بهذا الأمر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: سنعيش جميعًا حياة رخاء بمجرد أن تكمل الشمس عملها المقدس!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: أشعتها المقدسة ستساعدنا على التخلص من هذا العذاب، ألا ترى ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: أنت ترى ذلك بالتأكيد — لهذا السبب ما زلت على قيد الحياة!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: جيد جدًا، أيها البشري! يمكننا مواصلة مناقشة هذا الأمر بتعمق أكثر!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: أوه، قبل أن أنسى... هل لديك أي جعة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: هل كنت تتظاهر بالجهل بشأن الشمس؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: يا لك من غبي! سأذهب لإنقاذ شخص آخر إذن!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: وداعًا أيها المختل!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: مر-مرحبًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: آسفة لإزعاجك في هذا الوقت المتأخر... كان الجو حارًا جدًا اليوم، والتلفاز قال إنه لا ينبغي لنا الخروج في الشمس، لذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: هل يمكنك... توفير مكان لي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: مَن أنتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: كيف وصلتِ إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: امممم، كنت أعيش بالقرب من المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: حرارة الأسفلت في المدينة لا تطاق، كما يمكنك أن تتخيل، هيه. هيه هيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: كنت أعمل محاسبة في متجر محلي. لكنني لم أعد أعمل هناك الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: لقد... طردوني. لطالما كان حظي سيئًا في العمل...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: ماذا ستفعلين الآن؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: ماذا سيحدث في رأيكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: لم أرد القدوم هنا أصلًا. الأسفلت يذوب تحتنا، صحيح، لكن كان يمكن أن نكون في وضع أسوأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: كل ما في الأمر هو... حسنًا، ستضحك على كلامي، هيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: جاء زوار إلى منزلي. هل تصدق ذلك؟ لقد طردوني من منزلي!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: لذا، الآن أحاول فقط العثور على مكان لأحتمي فيه من الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: ماذا ستفعلين الآن؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: ماذا سيحدث في رأيكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: امممم... سأحاول النجاة بطريقة ما؟ الوضع مخيف في الخارج، مع وجود الزوار في كل مكان والشمس تحرق كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: لكنني أرغب حقًا في العيش. هيه هيه. آآهه...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: ألست خائفًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: أخبرني أن كل شيء سينتهي قريبًا، أرجوك...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: لا... لا أعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: هل سأنجو؟ مَن سيساعدني؟ كم من الوقت لديّ لطلب المساعدة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: لا أعرف ماذا سيحدث. لا أستطيع حتى التخمين.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: ألا يخيفك كل هذا؟ إنه يرعبني.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: شكرًا. هاها! شكرًا جزيلًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: الآن سأعيش لفترة أطول قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: هاها، امممم... حسنًا، فهمت...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: شكرًا على استماعك واهتمامك على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: حسنًا... عليّ المغادرة إذن.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: وداعًا؟ نعم، وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: هل يمكنني الدخول؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: كنت قد اتخذت ملاذًا في الحانة التي تقع عند نهاية الطريق، ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: لقد طردوني. بهذه البساطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: لماذا؟ هممم. أعتقد أن شخصيتي لم تكن مقبولة لدى الجميع هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: لكنني لا أقصد إيذاء أحد، لا تقلق. أنا... الحياة لا تقف في صفك أحيانًا كما تعلم.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: ما قولك إذن يا صديقي؟ هل يمكنني الدخول؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: لستَ زائرًا، أليس كذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: هل أنت متأكد أنك لن تسبب أي مشاكل؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: هل أبدو كأحد هؤلاء الوحوش؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: لا، لستُ زائرًا. ولن تحصل أبدًا على إجابة مباشرة عندما تسأل هذا السؤال بشكل مباشر على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: أعتقد أن الأمور هنا لن تختلف عن الحانة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: لماذا طردوك من المأوى السابق؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: لماذا تعتقد أن الأمر سيكون مختلفًا هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: ما الذي تراه في نظرك "مشكلة"؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: القتل والعنف يثيران اشمئزازي. لكنني لن أتسامح مع تجاوزات الآخرين أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: أحب تناول الطعام والشراب في سلام. وأستمتع بالدردشة عندما أكون في مزاج جيد. هل يبدو ذلك "مشكلة" لك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: لماذا طردوك من المأوى السابق؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: لماذا تعتقد أن الأمر سيكون مختلفًا هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: فكرت في قول شيء غير مهذب للتو، لكنني عدلت عن ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: لقد أخبرتك من قبل: لم يكن شخص معين يحبني هناك. لا أحد يعلم من كان.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: الآن بعد أن فكرت في الأمر، ربما كان طردهم لي أمرًا إيجابيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: كان بإمكانهم أن يقتلونني بدم بارد هناك ولم يكن أحد ليلاحظ ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: ماذا يمكنني أن أفعل غير ذلك؟ أقف في الخارج وأنتظر أن تذيب الشمس جلدي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: لا، لا أحبذ ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: طالما أنا على قيد الحياة، سأبحث عن شخص أتحدث معه. إذا لم أجده هنا، فربما يحالفني الحظ في مكان آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: وإذا كان لديّ ذرة حظ في هذه الحياة، فقد يكون هذا الشخص لطيفًا وليس أحمق.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: شكرًا لك. الثقة في الناس لا تساوي شيئًا هذه الأيام.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: لكنني أقدّر ثقتك بي. ربما حتى... حسنًا، لا يجب أن أعدك بأي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: هممم. مفهوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: أفهم منطقك، لكن هذا لا يزال يغضبني. أنت جبان مثل كل من في هذه المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: طابت ليلتك، يا صديقي العزيز. وتبًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: هل يمكنني الدخول لأستريح قليلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: من أين أتيتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: إلى أين ستذهبين بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: لا أتذكر. فهذا لا يهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: أنا متعبة جدًا. إذا لم أحصل على قسط من الراحة، فقد أفقد الوعي تحت نافذتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: هل صديقكِ مريض؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: هل يحتاج صديقكِ إلى المساعدة؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: أنا... ربما سأسقط في مكان ما ولن أستطيع النهوض مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: لا يهمني أين سينتهي بيّ المطاف.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: هل صديقكِ مريض؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: هل يحتاج صديقكِ إلى المساعدة؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: إنه زوجي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: لقد مات.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: لا أستطيع أن أقيم له جنازة لائقة. لا يمكنني تركه وحده الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: لم يعد يحتاج إليها. عندما كان بحاجة إلى المساعدة، لم يفعل أحد شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: والآن... صار من الأموات.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: كان من الممكن أن يعيش لو...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: لو كان أحد يهتم.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: لن أبقى طويلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: أحتاج فقط إلى قليل من الراحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: أنت...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: أهلًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: هل رأيت ما يحدث؟ هذا جنون تام!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: كيف حالك يا أخي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: ماذا تريد؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: ما الذي يحدث بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: لا شيء في الحقيقة. أنا أتساءل فحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: لكن أود إخبارك بأن لديّ طريقة رائعة لكسب بعض المال بسهولة. هل تريد أن تعرفها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: بما أن الجميع مشغولون بالرعب من الشمس، يمكنك كسب أموال طائلة دون أن تحرك ساكنًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: كل هؤلاء الحمقى غارقون في خوفهم بينما ينبغي عليهم صقل مهاراتهم والسعي لربح المال!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: لماذا جئت إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: ما هي؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: أنا هنا لأقدم لك فرص نجاح جديدة يا أخي. وكلها ذات رؤية عظيمة!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: الجبناء حولنا يركضون مثل الدجاج بدلًا من فعل ما هو صحيح ومنطقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: كل ما أريد قوله هو إنهم جميعًا بحاجة إلى أن يكونوا سعداء!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: لماذا جئت إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: ما هي؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: سندخل في صلب الموضوع! يعجبني ذلك! يعجبني ذلك كثيرًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: الجميع يعتقد أنك تخطط لشيء ما هنا، بإحضارك كل هؤلاء الناس. وإثارة بعض المشاكل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: لذا أقول دعنا نمضي قدمًا في ذلك ونقيم حفلة تاريخية! حفلة نهاية العالم يا صاح!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: الموت ليس جزءًا من خططنا يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: عليك أن تعمل بجد بينما الفرصة سانحة. تبًا للشمس!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: حانت فرصتنا في النجاح! هل تتفق معي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: أنت ذكي يا صديقي! هذا ما أردت سماعه!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: أخيرًا قابلت شخصًا ذكيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: أوه، فهمت — أنت مغفل مثلهم. لم أتوقع ذلك منك، وهذا خطئي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: سأذهب لأرى ما إذا كان جارك أكثر تقبلًا لعبقريتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: وداعًا أيها المغفل الفاشل!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: مرحبًا يا جاري. لم نلتقِ منذ فترة طويلة. كيف أخبارك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: لا جديد
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: بخير
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: دعني أكون صريحًا معك: لقد جئت لسبب ما. لقد بدأت أشعر بالقلق عليك قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: يبدو أن شيئًا سيئًا للغاية في طريقه إلينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: لقد أنهيت للتو مكالمة هاتفية مع ابنة عمي. أخبرتني أن الأخبار تقول إن هناك شيئًا غريبًا يتعلق بالشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: وأن هناك أشخاصًا يخرجون من تحت الأرض. يطلقون عليهم اسم "الزوار" لأسباب غير معروفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: أمر مخيف، أليس كذلك؟ آمل ألا يكون هذا صحيحًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: ماذا يحدث للشمس؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: زوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: دعني أكون صريحًا معك: لقد جئت لسبب ما. لقد بدأت أشعر بالقلق عليك قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: يبدو أن شيئًا سيئًا للغاية في طريقه إلينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: لقد أنهيت للتو مكالمة هاتفية مع ابنة عمي. أخبرتني أن الأخبار تقول إن هناك شيئًا غريبًا يتعلق بالشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: ويقال إن هناك أشخاصًا يخرجون من تحت الأرض. يطلقون عليهم اسم "الزوار" لأسباب غير معروفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: أمر مخيف، أليس كذلك؟ آمل ألا يكون هذا صحيحًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: ماذا يحدث للشمس؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: زوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: إما أنها ستنفجر أو أن شيئًا ما سينفجر عليها... لست متأكدًا تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: كل ما أعرفه هو أن هناك خطبًا ما بها.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: أنا متأكد أنك لاحظت أن هذا الصيف كان الأكثر حرارة على الإطلاق، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: أعتقد أننا بحاجة إلى الاستعداد للأسوأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: قالت لي ابنة عمي إن البقاء في المنزل بمفردك أمر خطير.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: لذلك جئت لأتأكد من أنك لن تتأذى أو تتعرض لشيء أسوأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: تمام
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: يمكنني الاعتناء بنفسي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: كيف حال زوجتك وابنتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: نعم. هذا ما يطلقونه على الناس من تحت الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: لا أحد يعلم لماذا يسمونهم بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: أعتقد أن السبب هو أنهم زوار إلى الأرض؟ أو على الأقل إلى سطحها.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: أو ربما لأنهم يتجولون محاولين الدخول إلى منازل الناس.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: قالت لي ابنة عمي إن البقاء في المنزل بمفردك أمر خطير.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: لذلك جئت لأتأكد من أنك لن تتأذى أو تتعرض لشيء أسوأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: تمام
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: يمكنني الاعتناء بنفسي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: كيف حال زوجتك وابنتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: عظيم. لنكمل هذه المحادثة في الصباح.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: سأقابلك في المطبخ عندما تستيقظ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: أراك في الصباح.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: أنا متأكد من أنك تستطيع. لكنني لست متأكدًا من أنك تدرك مدى خطورة أن تكون وحيدًا في الوقت الحالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: ما رأيك أن أبقى معك ليلة واحدة، تحسبًا لأي أمر طارئ؟ سيساعدني هذا كثيرًا على الاطمئنان عليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: لا تقلق بشأن عائلتي. صديق عزيز لي يقيم معنا الآن. إنه يعتني بهم أثناء وجودي هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: عظيم. لنكمل هذه المحادثة في الصباح.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: سأقابلك في المطبخ عندما تستيقظ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: أراك في الصباح.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: لا تقلق بشأن عائلتي. صديق عزيز لي يقيم معنا الآن. إنه يعتني بهم أثناء وجودي هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: عظيم. لنكمل هذه المحادثة في الصباح.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: سأقابلك في المطبخ عندما تستيقظ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: أراك في الصباح.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: مرحبًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: هل أبي هنا؟ هل يمكنك أن تدعوه لي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: كنت بخير من قبل، لكنني أصبحت خائفة جدًا الآن. هناك الكثير من الأشخاص الغرباء في الخارج الليلة...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: ما اسم والدكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: أخبريني بشيء عن والدكِ
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: هل نسيت اسمه؟ أوه، انتظر... أنت تختبرني لترى ما إذا كنت زائرة أم لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: أنت ذكي! سأبدأ في طرح الأسئلة لاختبار الناس أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: كيف وصلتِ إلى هنا سالمة؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: هل تخافين من الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: هممم، أنا أعرف الكثير عنه. فهو والدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: أعرف أنه يحب شرب القليل من الجعة قبل الخروج، هههه!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: عندما يخرج، يترك لي دائمًا غداءً وعشاءً لذيذين. وعصيرًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: لكن اليوم جربت بعضًا من تلك الجعة. يع! كانت مقرفة جدًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: لماذا يشرب أحدهم ذلك بينما يمكنه شرب العصير؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: أوه، أرجوك لا تخبره أنني فعلت ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: كيف وصلتِ إلى هنا سالمة؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: هل تخافين من الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: لا أعرف، يبدو أن كل شيء أصبح معكوسًا الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: الناس يبقون في منازلهم وينامون خلال النهار، ثم يخرجون ويقومون بأنشطتهم في الليل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: ما زلت أخاف من الظلام، لكن ربما لا يوجد ما أخاف منه.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: ...أم هناك ما أخاف منه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: سأحضر لكِ والدكِ. حظًا سعيدًا!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: طاب يومكِ!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: لا أعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: الجميع يخاف منهم، لذا ربما يجب أن أخاف منهم أنا أيضًا. لم أرَ واحدًا منهم من قبل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: هل هم مخيفون؟ هل يضربون بقوة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: إذا كان الأمر كذلك، فربما يكون صديقي في المدرسة زائرًا. إنه يضربني طوال الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: نصحني أبي بأن أكون حذرة، لذا كنت حذرة للغاية!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: تسللت إلى هنا بهدوء شديد. لم يرني أحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: سأحضر لكِ والدكِ. حظًا سعيدًا!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: طاب يومكِ!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: شكرًا، ويومك أيضًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: أريد العودة إلى المنزل... المكان هنا مخيف...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: سنلعب لعبة جديدة ابتكرها أبي من أجلي. عليك أن ترمي النرد!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: ثم تقوم بتحريك الأشياء مثل الكرسي أو الأريكة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: يجب أن تبني كومة كبيرة بالقرب من الباب لتفوز. سأريك كيف تلعبها في وقت آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: وداعًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: مرحبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: د-دعني أدخل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: هل أنتِ خائفة؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: ماذا حدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: لا-لا أعرف ماذا أ-أ-أفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: الـ-الناس...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: اممم...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: قتلـ-قتلوا والـ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: والـ... والـ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: والـ-والدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: مَن فعل ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: لماذا فعلوا ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: اممم...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: والـ-والدييي...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: قتلـ-قتلوه...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: قتلـ-قتلوا والـ-والدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: مَن فعل ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: لماذا فعلوا ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: جاء زو-زوار إلى المنزل. كانوا يجلـ-يجلسون معنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: كان أبي يتحدث معهم عن شـ-شيء ما. ثم... قتلـ-قتلوه.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: لقد... *إهيئ* بيتـ-... *تبكي*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: بيتنا الآن يحـ-يحترررق...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: لا-لا أعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: كانوا جالـ-جالسين مع والدي في المطـ-المطبخ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: ثم فعلوا شيئًا... فعلوا شيئًا ما وأشعلوا البيت.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: وأنا أهرب، سمعتهم يضـ-يضحكون...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: هل ستتـ-ستساعدني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: أنا خائـ-خائفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: لكـ-لكن... أين سأذهـ-سأذهب!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: أنا خائـ-خائفة جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: وااااااااااااااء!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: وااااااااااااااااااااء!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: يا مرحب!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: ماذا تريد؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: لن أسمح لك بالدخول
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: منزلك واسع جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: يعجبني.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: لا أحتاج إلى أي شيء منك
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: لديّ سلاح ناري
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: هل بابك قوي ومتين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: لا أحد يعرف ما قد يحدث له.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: أنت تفهم قصدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: لا أحتاج إلى أي شيء منك
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: لديّ سلاح ناري
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: بالطبع لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: هل تعيش بمفردك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: لا، لست بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: نعم، أنا بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: جميل!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: اليأس يمنح الجبان شجاعة، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: هل تعيش بمفردك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: لا، لست بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: نعم، أنا بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: إنه يوم سعدك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: أسمع صوتًا يهمس من الداخل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: لكن مَن يدري أين سيكون بعد بضعة أيام؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: هاهاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: أعرف أنك بمفردك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: أردت فقط أن أرى ما إذا كنت ستكذب أم لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: سأدعو نفسي للدخول إذن.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: مرحبًا يا عزيزي! المشي طوال الطريق إلى هنا أرهقني بشدة!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: هل يمكنني الدخول ونيل قسط من الراحة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: ماذا؟ اخترتِ أن تمشي كل هذه المسافة إلى هنا خصيصًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: من أين أتيتِ مشيًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: لا، لا، لا... لم أكن أخطط للمجيء إلى هنا، لا تكن سخيفًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: لكن القدر دائمًا ما يجمعنا معًا. لا يوجد لقاء بالصدفة يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: بما أنني هنا، فهذا يعني أن قدميّ قادتني إلى هنا لسبب ما. وقعت عيناي على منزلك... لسبب ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: كما كان مقدرًا أن يكون... على ما أعتقد.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: لا أفهم. هل تحتاجين إلى شيء؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: كان بإمكانكِ أن تستمري في المشي. لماذا توقفتِ هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: ما الذي يعد "مسيرة طويلة" في رأيك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: خذ نفسك على سبيل المثال! أنت في المنزل، لكن كم عدد الخطوات التي قطعتها هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: هل كنت تمشي لفترة طويلة؟ لا بد أنك كنت كذلك بالتأكيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: لكنني مشيت لعقود وعقود تفوق عمرك.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: هذا هو الفرق بيني وبينك يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: لا أفهم. هل تحتاجين إلى شيء؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: كان بإمكانكِ أن تستمري في المشي. لماذا توقفتِ هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: أحتاج إلى ما يحتاج أي شخص يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: سقف فوق رأسي، وشخص لأشاركه قصصي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: أن أستلقي وأغمض عيني بسلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: والتنفس براحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: لا أحتاج إلى الكثير. الحياة مملة للغاية إذا عشتها بمفردك، هذا كل ما في الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: ألم تسمع كلامي يا عزيزي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: أنا متعبة من المشي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: هنا، سأتمكن من التقاط أنفاسي وربما التحدث إلى شخص ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: وهذا يكفي سيدة عجوز مثلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: أخبرني بشيء، وسأروي لك قصة في المقابل. لنتحدث معًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: ربما بعدها تستريح عظامي العجوز قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: شكرًا يا عزيزي!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: يبدو أنك ستكون مضيفًا ممتعًا للغاية. وربما سأكتشف أخيرًا ما الذي يجري حولنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: يرفضني الناس في كل مكان أذهب إليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: ربما لا أقوى على فعل شيء، ولكنني أملك قصصي الرائعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: لذا يلجأون إليّ في النهاية... حتى لو قالوا إنهم لن يفعلوا ذلك أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: لا أحمل ضغينة لأحد. أساعد كل من يأتي إليّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: حتى أنت ستجد نفسك في حاجة إلى شيء يومًا ما. إلى من ستلجأ حينها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: مرحبًا. تعالي، استندي عليّ قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: هل... ربما لديك مكان لنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: هل صديقتكِ مريضة؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: هل كلاكما مريضتان؟ أم إحداكما فقط؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: إنها أختي. وهي مكتئبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: لا تستطيع المشي أو الاستحمام بمفردها. وأحيانًا، حتى النهوض من السرير يمثل صعوبة لها.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: لكن لا بأس. ستتحسن يومًا ما. أليس كذلك يا أختي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: إنها ليست في مزاج جيد للتحدث الآن، لكنها قد تتحدث لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: ماذا ستفعلان بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: ألم تتعبي من حملها؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: نعاني جميعًا من الاكتئاب بدرجة ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: كنا نعرف إلى أين تتجه الأمور حتى قبل كل هذه المصائب من الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: هل تتابع الأخبار؟ كل شيء كان يؤدي إلى ما يحدث الآن. لكنني لا أعتقد أن الشمس ستنفجر بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: ماذا ستفعلان بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: ألم تتعبي من حملها؟
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: يجب أن أجد مكانًا تشعر فيه أختي براحة أكبر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: وبعدها سنبدأ حياة جديدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: يقولون إن حياتنا قد انتهت...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: لكنني لا أتفق معهم. فمن المفترض أن تصبح الأمور أسهل وأفضل من الآن فصاعدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: انتبه لما تقوله.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: نعم، يمكن أن يكون ذلك مرهقًا. لكنني لا أستطيع التخلي عنها أبدًا، إذا كان هذا ما تعنيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: تركنا دفء بيت والدينا، ولم يبقَ لنا في هذه الدنيا غير بعضنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: شكرًا لك! ساعدني في حملها للداخل.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: أعتقد أن وفاة والديّنا أدت إلى تفاقم حالتها، لكنها كانت على هذه الحال منذ فترة طويلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: ربما ستتمكن من التخلص من اكتئابها أثناء وجودنا هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: آآخ. حسنًا يا أختي، أعتقد أننا سنضطر إلى تجربة حظنا في مكان آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: هيا، لنذهب. ساعديني قليلًا يا أختي.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: متى ستنتهي هذه المعاناة...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: أعطونا هذه الورقة في العمل قبل أن نذهب لإطفاء الحرائق.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: إنها مذكرة تأمرنا بالذهاب إلى الحجر الصحي التابع للوكالة الفيدرالية. ولكن لماذا نذهب إذا كان كل من يذهب إليه يموت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: تفضل، أنا لا أحتاج إليها على أي حال. يمكنك رميها أو استخدامها لشيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: لديّ *يسعل* ورقة ما. إنها مهمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: سأعطيك إياها إذا سمحت لي بالدخول. دعني أعيش أيامي الأخيرة بسلام...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: لا، احتفظ بها
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: ماذا دهاك بالضبط؟ هاه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: اسمع، أرى أنك رجل صالح. ربما يمكن لمشروب إنيرجيكا أن يغير رأيك؟ هه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: أرهقني دفع نفسي إلى هنا للغاية! كان ذلك تمرينًا شاقًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: تستحق مشروب إنيرجيكا! شكرًا على استقبالي يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: تبًا... سحقًا لهذا الهراء...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: لا بأس. اسمع، سأ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: ما رأيك أن أعطيك مشروب إنيرجيكا. هل ستسمح لي بالدخول حينها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: أحصل على فرصة للحياة وتحصل على مشروب بارد ومنعش. ويعيش الجميع في سلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: اغرب عن وجهي
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: لا تقلق عليّ... أنا... اللعنة... على أي حال خذه...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: خذ مشروب إنيرجيكا.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: يجدر بي أن أهدأ، وأمتنع عن شرب هذا الهراء.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: أرى أن {0} هنا. الأمر واضح: الجميع يتحدثون بصوت خافت ويبذلون قصارى جهدهم لإخفاء مشاعرهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: لكنني لا أستطيع تحمل فكرة وجودي معهم. إما هم أو أنا. أحدنا يجب أن يرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: أكره العيش مع أشخاص يكتمون كل شيء بداخلهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: سأتولى الأمر. تفضل بالدخول.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: عليك الرحيل إذن
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: أنت صبور جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: سأعتمد عليك في التحدث إذا خرجت الأمور عن السيطرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: سأحاول... حسنًا. سأكون هادئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: رائع، أليس هذا رائعًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: أعتقد أنك تفضّل التقرب من الأوغاد الذين يعيشون معك، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: لا أكترث بك أيها المتملق المعتوه. سأرحل عن هذا المكان القذر!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: إليك مكافأة سخية من الشمس المقدسة نفسها: مشروب إنيرجيكا الذي تفضّله! أنت تستحقه، أيها البشري!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: هل أنت معتوه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: أنت تطرد رجلًا صالحًا وعادلًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: إذا سمحت لي بالدخول، فستحصل على مكافأة سخية من الشمس المقدسة نفسها. أعد النظر في قرارك، وستنال بركتها!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: اغرب عن وجهي
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: لا أحد يعرف ماذا حدث بعد وصول الزائر الأخير.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: ظل المنزل شاغرًا لفترة طويلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: بعد اختفائك المرعب، تُرك المنزل مهجورًا وتجنبه الناس كأنه موبوء.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: مرحبًا يا عزيزي... مَن الذي معك؟ هل {0}؟'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: في لحظة يسود الضجيج، وفي التالية تعلو الهمسات. مثل هذا المكان يُخيف عجوزًا مثلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: أتجول وحيدة لسبب جوهري. الغرف المليئة بالصراخ أو المكتظة بالوجوه ليست مكانًا مناسبًا لي.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: دعهم يبقون، إذا كانوا أعزاء عليك. وأنا سأبقى في مكاني حتى تهدأ رياح التغيير هذه. فأنا لست من محبي العواصف.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: فهذه العظام العتيقة لا يمكنها تحمل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: أستطيع التعامل معهم. تفضلي بالدخول.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: عليكِ الرحيل إذن
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: إذا كنت متأكدًا فسأبقى... لكن إذا شعرت بعاصفة تلوح أو خانني الظاهر مرة أخرى، فسأرحل فورًا. كبرت على احتمال هذا العبث.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: لا أشعر أنني أنتمي إلى هذا المكان على أي حال... سأحزم أمتعتي وأرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: لكن ابقَ منتبهًا ومنصتًا لما يحدث يا عزيزتي... فالحقائق الأكثر خطورة غالبًا ما تُهمس بأخفت الأصوات.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: أرجوك...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: أرجوك دعنا ندخل، ولو ليوم واحد فقط. لدينا شيء قد ترغب فيه...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: نعم، سيعجبك ما لدينا...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: حسنًا، ادخلا
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: اغربا عن وجهي
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: شكرًا جزيلًا لك!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: تفضّل مشروب إنيرجيكا. هذا كل ما لدينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: الآن، هل يمكنك مساعدتي في إحضار أختي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: قد لا تكون هذه فكرة سديدة، بالنظر إلى وجود {0} هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: يتعكر صفو الأجواء في وجودهم. وكأن أفكارهم أعلى صوتًا من أفكاري.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: أختي لا تستطيع تحمل ذلك. ستنغلق على نفسها. وسيكون الأمر كما لو أنها غير موجودة.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: وأنا أيضًا أجد صعوبة في التعامل مع هذا النوع من الأمور. حيث يصبح التنفس صعبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: آسفة، لكن أعتقد أننا سننتظر حتى تهدأ الأمور. ربما سيغادرون.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: أستطيع التعامل معهم. تفضلا بالدخول.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: عليكما الرحيل إذن
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: شكرًا. انتبه، تأكد من سندها بيدك على ظهرها... هكذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: أعتقد أن وفاة والديّنا... أثرت كثيرًا على نفسيتها. ولكنها تحاول التماسك قدر استطاعتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: لقد كنا نتجول هنا منذ فترة. كنت آمل أن تشعر بتحسن قليل هنا على الأقل.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: ...فهمتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: اصبري قليلًا يا أختي. سنجد لكِ مكانًا تستريحين فيه قريبًا، وعد. هيا، استندي عليّ. أنا بجانبك.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: أحيانًا نشعر أن الضغوط... أثقل من أن نحملها. حتى باب مغلق بسيط يصبح جبلًا. لكن علينا المضي قدمًا. هيا، أنا معكِ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: هذا مؤسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: شكرًا جزيلًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: بوجود {0} هنا، لست متأكدًا من أننا سنتفق.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: عفوًا يا سيدي، لكنني لا أستطيع الدخول الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: حسنًا، ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: هل اتفقنا الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: حسنًا. هل سيفي {0} بالغرض؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: أنا معتادة على أمثالك. وأعرف بالضبط ما تريده.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: من المؤسف أن الأوغاد حظهم وفير.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: لا يزال هناك متسع من الوقت. سأجد خيارًا آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: حسنًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: شكرًا. لم أكن أتوقع هذا، لكنه بالضبط ما كنت آمله.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: لكنك لن ترانا معًا في الغرفة ذاتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: إنها قصة طويلة، ولن أرويها لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: أوه، انظر، {0} هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: هل سيساعد ذلك في تسوية الأمور بيننا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: أوه، لديّ {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: حسنًا، دعني أعطيك... ماذا لديّ هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: حسنًا. لن أسمح لنفسي بالوقوع في هذا الفخ مجددًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: تذكّرني بتلك البنوك اللعينة. سحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: حسنًا، سأرحل إذن. لا يزال هناك وقت حتى شروق الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: فهمت.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: لنشرب احتفالًا بنهاية الديون. هاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: الأجواء أفضل الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: عانيت ما يكفي من سوء الحظ في حياتي. ألا يمكن على الأقل أن نبقي هذا المكان بعيدًا عن أمثال هؤلاء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: أترى ذلك الرجل هناك؟ {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: مستحيل. يوجد هنا شخص سيفسد علينا كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: حسنًا. أتفهم ذلك. اعتنِ بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: لكنني أقدر ثقتك!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: حقًا! شكرًا جزيلًا! ما كان يجب أن تتكلّف هذا العناء... كان يمكنني البحث عن مكان آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: لكنني أخشى أنني لن أشعر بالراحة في البقاء في مكان مع {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: أعلم أنني قد أخذت الكثير من وقتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: وبصراحة، لا أعتقد أنني كنت السبب.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: شكرًا جزيلًا! لكن... أرى هنا شخصًا حدثت بيننا مشكلة في المقهى.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: ماذا لو أعطيتك شيئًا؟ إليك مثلًا {0}. هل ستسمح لي بالدخول حينها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: في كلتا الحالتين، القرار لك. سأرحل عن هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: هل تعتقد حقًا أن الأشخاص الذين يسخرون من الآخرين بسبب مظهرهم يستحقون مكانًا في منزلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: شكرًا. لا أريد أن أتعرض لذلك مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: أرى {0} عندك. وقد نلت كفايتي من التنمر على مظهري.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: آسف، لكن لا أعتقد أنني أستطيع الدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: إذا كنت تحيط نفسك بأشخاص سيئين، فمن المحتمل أنك مثلهم. تيهي!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: ربما يجدر بي ألا أبقى عندك. نعم...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: هل أنت جاد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: لا يجب أن تتورط في أمور جنونية.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: يبدو الأمر محرجًا. لكن... لا بأس! تيهي!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: عظيم...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: أنا متأكد.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: إنه مجنون تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: أعرف جيدًا ما حدث قبل شهر.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: أوه... أنت تستضيف {0} هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: اعتنِ بنفسك، اتفقنا؟ آمل أن تتجاوز هذه المحنة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: لا بأس يا صديقي. أتفهم ذلك. لا ألومك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: اللعنة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: أعلم أن هذا محرج... أن تضطر إلى طرد شخص ما بهذه الطريقة. لكن هذه هي الحياة. أحيانًا عليك أن تكون صارمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: نعم، أعني {0}. ربما يجب أن... تتخلص من مثل هذه الشخصيات؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: عادة ما أتفاهم مع الجميع، لكن هذا صعب. شخصيات كهذه خطيرة على الجميع هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: أنا محبطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: لا تقل لي إنك لا تملك الشجاعة لذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: ماذا؟ كنت أعتقد أنك تحترم الشجعان.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: يبدو أنك لم تواجه أي مقاومة في عملية الطرد.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: هممم. لم أعتقد أنك ستقبل بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: لا يمكن أن نقيم كلينا في البيت نفسه، وإلا سأذهب إلى مكان آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: هل أرى {0} عندك في البيت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: حسنًا، يجدر بي أن أرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: سحقًا... ستجدني الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: ليتني لم آتِ إلى هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: اللعنة... إلى أين يفترض بي أن أذهب؟ لقد طرقت أبواب كل المنازل الأخرى بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: أنا ممتن لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: أرجوك، دعني أقيم عندك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: والآن ليس لديّ مكان آخر أذهب إليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: مكثت في فندق لفترة من الوقت، لكن مالي نفد.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: لا...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: لكنني هنا الآن، ولا أستطيع تحمل تكاليف الفندق. أرجوك، دعني أقيم معك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: نعم، فهمت ذلك. صدقني، لو كنت أعرف ما سيحدث بالشمس، لما جئت إطلاقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: ألا يوجد لديك مكان آخر تذهب إليه؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: اخترت أسوأ وقت ممكن للمجيء إلى هنا
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: أنا مجرد عابر سبيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: لكنهم أغلقوا الحدود... والآن أنا عالق هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: كنت متوجهًا إلى العاصمة، كنت أخطط لرحلة...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: ألا يوجد لديك مكان آخر تذهب إليه؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: اخترت أسوأ وقت ممكن للمجيء إلى هنا
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: المطار مغلق، والقطارات متوقفة أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: حدث خطأ ما. لا أستطيع الخروج من المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: كيف وصلت إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: ما مشكلتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: مرحبًا. هل يمكنك مساعدتي؟ لستُ من سكان هذه المنطقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: حسنًا. عليّ الذهاب.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: لا يزال هناك عدد قليل من المنازل في الجوار. ربما يتغاضى أحدهم عن مظهري ويتصرف كإنسان محترم.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: لقد كان أسبوعًا قاسيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: لنتحدث غدًا إذن. أنا مرهقة جدًا اليوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: عظيم.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: الأفظع هو أن تسمع خبرًا وتعرف أن الواقع أسوأ بخمسة أضعاف... أو حتى بعشرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: لا فائدة من التلفاز على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: لست متأكدة إن كانت الكهرباء تعمل عندك، لكن أتمنى أن تكون كذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: الهواء يبرد هنا ليلًا. ولا أحد يتابع الأخبار على مدار الساعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: سأتخطى الشكليات وأدخل مباشرة في صلب الموضوع.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: بالطبع.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: وأفضّل ألا أكون في قلب الحدث عندما يبدأ كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: أعتقد أننا نتجه نحو كارثة رهيبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: كلما طال أمد هذا الوضع، ساءت الأمور. لا يوجد هواء، وتحدث المزيد من الجرائم، والقلق يملأ البيوت.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: بالإضافة إلى ذلك، لديّ شعور بأن المدن لن تظل آمنة لفترة طويلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: لستُ من محبي الشكليات. فهذا يجعل الوصول إلى صلب الموضوع أسهل.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: ما الذي يجعلك تعتقد أنني أهرب من أي شيء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: هل تعتقدين أن الوضع سيكون أفضل هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: ما الذي تهربين منه؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: مظهري لا يعني شيئًا. لا أتمنى الأذى لأحد. وآمل ألا تكون من النوع الذي يحكم على الآخرين.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: لم أخطئ في شيء. وتوقف عن تفحصي بهذه النظرات!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: لماذا أنت فظ هكذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: هل تعتقدين أن الوضع سيكون أفضل هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: ما الذي تهربين منه؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: وكأن وجود المجانين والزوار لم يكن كافيًا، صارت الشمس الآن تحاول أن تفسد علينا حياتنا أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: وليس فقط في مدينتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: سمعت أن هناك أمورًا مروعة تحدث في الضواحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: لا، لم أقصد أن منزلك يبدو مهجورًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: أنتِ جريئة
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: هل يبدو مهجورًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: أوه، هناك شخص هنا. أتمانع إذا دخلت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: سأفكر في شيء ما. لا يزال هناك وقت حتى شروق الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: تبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: لا توجد فرصة على الإطلاق؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: لا يمكنك أن تتخيل كم يعني لي هذا اليوم!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: هذا ما وددت سماعه! لنحتفل بهذا القرار!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: هل ستسمح لي بالدخول أم ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: لو كان لديّ منزل كهذا، لكان ذلك حلمًا يتحقق.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: لا يهم. القرض ليس قرضك لتسدده، أليس كذلك؟ لديك منزل جميل هنا على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: ماذا يمكنني أن أقول؟ من الواضح أنك لست سعيدًا من أجلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: أنت متكتم إذن
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: ولأكون صادقًا، لا أحب ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: بدا ردك ساخرًا للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: أنت متكتم إذن
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: لا أقصد أي إساءة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: لأكون صادقًا، أفضّل عدم التحدث عن هذا الأمر علنًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: هذا سؤال وجيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: وماذا ستفعل بكل تلك الأموال التي ادخرتها؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: وماذا تفعل هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: وهذا رائع!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: فمع كل هذه الفوضى التي نعيشها، لم يعد أحد يهتم بالبنوك أو القروض!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: الآن لست مدينًا بأي شيء!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: ولكن الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: كان كل شيء يسير على نحو سيئ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: كنتُ غارقًا في الديون.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: وماذا ستفعل بكل تلك الأموال التي ادخرتها؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: وماذا تفعل هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: أشعر وكأنني أستطيع التنفس أخيرًا. لا يمكنك أن تتخيل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: يا صديقي... لا... يا أخي! الرهن العقاري لم يعد مشكلتي بعد الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: توقف عن التشاؤم! أنت ببساطة لم تستوعب الأمر حتى الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: لماذا تبتهج هكذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: هل أنت مجنون أم ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: يا لها من ليلة رائعة! هل تشعر بها؟ إنها ليلة ساحرة!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: يا هلا يا هلا، كيف الحال!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: حسنًا. أتفهم ذلك. اعتنِ بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: ما أجمل أن تكتشف أن الطيبين لم ينقرضوا... وأنهم ليسوا مجرد شخصيات في القصص.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: شكرًا جزيلًا! لن أنسى لك هذا!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: لم أتصور يومًا أن حياة الكبار ستكون صعبة لهذه الدرجة... وليس لي مكان آخر...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: سأرد لك الدين يومًا ما. ويمكنني مساعدتك الآن، بأي طريقة ممكنة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: أعلم أنني لا أملك الكثير لأقدمه... لكن أرجوك، أعد التفكير في قرارك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: فهمت...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: لا أريد متطفلين هنا. ارحل عن هنا
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: أشك في أنني أستطيع أن أكون منقذنا. لكن في كل قصة، دائمًا ما ينتصر الخير في النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: أتمنى أن يظهر بطل ما ليهزم أعداءنا الحقيقيين، ليعود كل شيء إلى ما كان عليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: يخاف الناس، ويختبئون، ويتوقفون عن الثقة ببعضهم بعضًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: كل هذا يذكرني بالقصص الخيالية التي نشأنا عليها. تلك القصص التي ينتشر فيها الشر في جميع أنحاء العالم.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: لكنني أعتقد أنني ما زلت الشخص الذي كنت عليه دائمًا. على الأقل لا أشعر بأي رغبة في إيذاء أي شخص آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: ربما تنطبق عليّ بعض العلامات. لا أعرف. أصبح كل شيء غريبًا جدًا مؤخرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: بكل صراحة، ما زلت غير متأكد من حقيقة هؤلاء الزوار، أو ما الذي يميزهم عنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: لا أريد متطفلين هنا. ارحل عن هنا
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: سأحاول أن أكون مفيدًا حتى يتحسن وضعي. وأعدك أنني سأرد لك الجميل يومًا ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: أكره أن أثقل على أحد. لكن في أوقات كهذه، تفعل أي شيء لتبقى على قيد الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: ثم نقل إخوته غير الأشقاء للعيش في الشقة بعد فترة وجيزة. أتفهم موقفه، لكن أتمنى أن تتفهم موقفي كذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: لذلك بعد أن حلت الكارثة، طردني... وقال إن السبب هو عدم حصولي على عمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: المالك لم يوافق أصلًا على تأجير الشقة لخريج جديد دون دخل ثابت.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: ...كما كنا في طفولتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: في وقت الشدائد، يرغب الناس في التخلص من كل مشاكلهم لفترة... ليكونوا بلا هموم لبعض الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: يبدو أن الذين اختاروا العمل في النوادي الليلية كانوا محظوظين أكثر. حالهم أفضل بكثير.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: لكن بعد كل ما حدث، توقف الناس عن زيارة المقهى، وجعلونا جميعًا عاطلين عن العمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: أنهيت دراستي الجامعية للتو، ولكن العثور على وظيفة في مجال تخصصي كان صعبًا، لذا عملت في مقهى صغير.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: كيف أعرف أنك لست زائرًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: ما الذي أتى بك إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: مساء الخير. هل يمكنني البقاء هنا؟ أي مكان صغير يكفيني.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: حسنًا إذن. كما تريد. سأرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: شكرًا... على السماح بدخولي. وعلى عدم إعطاء أهمية كبيرة لمظهري.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: ما الذي يجعلك متأكدًا إلى هذا الحد؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: سأعرف مدى صحة هذا الكلام
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: هل ستسمح لي بالدخول أم ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: لأنني أعرف من أنا. وأنا لستُ واحدًا منهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: ما الذي يجعلك متأكدًا إلى هذا الحد؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: سأعرف مدى صحة هذا الكلام
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: هل ستسمح لي بالدخول أم ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: كما تشاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: ما الذي يجعلك متأكدًا إلى هذا الحد؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: سأعرف مدى صحة هذا الكلام
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: أؤكد لك أنني لستُ زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: ماذا تعني بـ "ماذا كنت تتوقع"؟. هل تعتقد أنني اخترت أن أبدو هكذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: ما الذي يجعلك متأكدًا إلى هذا الحد؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: سأعرف مدى صحة هذا الكلام
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: أتفهم ذلك، لكنني لست زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: ماذا كنت تتوقع؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: الجميع قلق ومرتاب هذه الأيام
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: إنه عيب خلقي. لا يمكنني فعل أي شيء حيال ذلك. لكن لسبب ما، يعتقد الناس أنني زائر. هذا جنون.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: هذا بالضبط ما أعنيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: ماذا كنت تتوقع؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: الجميع قلق ومرتاب هذه الأيام
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: إنهم يستمرون في معاملتي كأنني مصاب بمرض معدٍ... أو أسوأ من ذلك، كأنني زائر.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: لقد ولدت بجينات بشرة سيئة. هذا كل ما في الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: لا! هذا هو صلب الموضوع. لا يوجد أي خطب بي.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: ماذا حدث لبشرتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: هل يجب أن أقلق؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: مرحبًا. آمل ألا أبدو غريبًا لدرجة أنك قد لا تسمح لي بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: تيهيي.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: سيقودك ذلك إلى مصير بشع... تذكر كلماتي...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: أنت لا تختلف عن أولئك القساة الذين يرتدون معاطف المختبر.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: غريب الأطوار؟ هممم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: إذن... هل تعتقد أنني مجنون أيضًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: مكان أستطيع الانتظار فيه حتى انتهاء هذه الفوضى...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: أخيرًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: بالإضافة إلى ذلك، سمعت دوي طلقات نارية قريبة. لكنك تهتم بالأمن والسلامة. أليس كذلك...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: الآن أحاول...التواصل مع أشخاص جدد!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: أحدهم نال ما يستحقه، لكنني أصبحت أكثر حذرًا الآن. تيهي!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: الجميع يكرهني. كل أحمق صادفته... منذ المدرسة وحتى الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: أي أصدقاء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: أفضّل العودة إلى الفندق على ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: حسنًا... لا أرغب في العودة إلى هذا الخيارة مجددًا! تيهي!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: لقد ساعدوني مرة واحدة، لكنهم لا يهتمون!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: كنت طفلًا غير مخطط له، وها أنا ذا!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: أليس لديك أي أصدقاء؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: لماذا لا تذهب إلى منزل أحد أقاربك؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: سأخبرك بكل شيء عن ذلك... لاحقًا. تيهي.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: غرف الفنادق صغيرة جدًا. تذكرني... بأوقات عصيبة مررت بها.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: منزلك كبير بما يكفي لجميع الأشكال والأحجام.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: الوضع هنا أفضل. تيهي.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: أليس لديك أي أصدقاء؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: لماذا لا تذهب إلى منزل أحد أقاربك؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: جاء ضباط الوكالة الفيدرالية، ثم رحلوا... واختفوا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: لا أستطيع إثبات ذلك، لا لا لا... لكنني أعتقد أنها زائرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: وتخيفني. تيهيي.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: هناك فتاة ترتدي معطفًا أصفر هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: لا يعجبني المكان. أفضّل البحث... عن مكان آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: هل تعتقد أن الوضع سيكون أفضل هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: لماذا؟ ألا يمكنك العودة؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: أنا خائف من العودة، هل يمكنني البقاء هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: أقيم في فندق الأمل، لكنني قررت أن أتمشى قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: آسف، أنا متوتر قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: مرحبًا. تييهييي.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: اعتنِ بنفسك، اتفقنا؟ آمل أن تتجاوز هذه المحنة.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: لا بأس يا صديقي. فهمت. لا ألومك.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: تعال لنتحدث لاحقًا، اتفقنا؟ لديّ بعض القصص المجنونة. ستذهلك، ها!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: شكرًا يا صديقي، لقد أنقذتني.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: لن أسبب لك أي مشاكل، أعدك بذلك. سأخبرك بكل شيء... لكن دعني أدخل، أرجوك.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: كانت تحاول حمايتي، ولم تخبرني بأي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: إنهم يلاحقون أمي.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: لا، إنهم لا يلاحقونني.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: وفي ظل حرارة الشمس اللعينة هذه، كل شيء أصبح جنونيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: لكن الآن... أنا... لا أستطيع الوصول إلى أي واحد منهم. كل شخص لديه مشاكله الخاصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: كانوا شبابًا طيبين، دائمًا مستعدين للمساعدة أو لمشاركة الجعة أو قضاء الوقت معًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: جميعهم من العاملين في المسرح. كنا نشرب معًا، ونمزح معًا، وندعم بعضنا بعضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: إذن، هناك مجموعة من الأشخاص الغاضبين يلاحقونك؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: أي نوع من الأصدقاء هؤلاء؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: كنت أعيش مع أمي وجدتي، لكننا طردنا من المنزل. محصلو الديون... كل شيء في حالة فوضى...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: كنت أعتقد أن لديّ الكثير من الأصدقاء. كنت أعتقد أننا سنبقى معًا خلال هذه المحنة... لكن ها أنا بمفردي.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: هل يمكنني البقاء هنا بعض الوقت؟ الجميع إما هربوا، أو أُجبروا على الرحيل، أو... اختفوا دون أثر.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: مرحبًا يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: ...مغفل.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: يا لك من...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: هممم، توقعت ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: لا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: أهذا اختبار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: لنتحدث لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: أتشرف بوجودي هنا، الآن، في الوقت الذي تتداعى فيه حياتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: عظيم!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: المحن جزء من طبيعتنا البشرية. النجاح يتطلب كفاحًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: القتال سبيلنا الوحيد للنجاة.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: أعتقد أن عدم مقاومتنا يعني فناء الجنس البشري.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: آسفة إن أعطيتك انطباعًا خاطئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: لقد نجت البشرية من أسوأ من ذلك من قبل. فلماذا نستسلم الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: لكنني لست يائسة بالتأكيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: أوه، تريد أن تعرف لماذا جئت إلى هنا؟ هاه. مَن يدري. ربما أنا مجنونة.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: يبدو أنكِ مجنونة
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: هل أنتِ يائسة مثلهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: سنبقى على قيد الحياة، مهما كلف الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: لم أستطع أن أمر بمكان كهذا دون أن أتوقف. أعتقد أننا متفقان في الرأي.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: يقال إنك لا تدع الزوار ينتزعون منك أثمن ما تملك... الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: يقولون إن البقاء على قيد الحياة هنا ليس بالأمر السهل.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: يبدو أنكِ مجنونة
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: هل أنتِ يائسة مثلهم؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: لكنك لست منهم. مثلك لا يستسلم دون قتال.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: أما الشجعان فيحملون السلاح. والباقون يتعفنون يومًا بعد يوم.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: معظم الناس استسلموا. لم يعد لديهم القوة لمواصلة الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: أعني ذلك صدقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: أممم... ماذا يقولون عن منزلي؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: شكرًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: لكنك تحظى باحترامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: لا يأتي إلى هنا إلا اليائسون... أو الحمقى.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: معظم الناس يبقون بعيدين عن منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: لقد سمعت عنك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: هاك، معي {0}. ليس كثيرًا، لكن آمل أن يساعدك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: شكرًا جزيلًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: أوه... آسف، لكن لديك {0} هنا. لا أثق حقًا بمثل هذه الشخصيات...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: إذا كنت تريد، لديّ {0}. هل سيساعدك ذلك في تغيير رأيك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: آخر شيء أريده هو مصادفة دورية... أو الأفظع، مقابلة الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: لا، أرجوك... دعني أدخل.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: هاك، لديّ {0}. ليس كثيرًا، لكن آمل أن يساعدك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: شكرًا جزيلًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: لا أريد أن ينتهي بي المطاف هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: ولكن عندما سمعت أن عملاءها ينقلون المصابين إلى مناطق الحجر الصحي...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: قررت ذات يوم أن عليها فحص الجميع.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: الوكالة الفيدرالية...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: لا أريد أن ينتهي بي المطاف في منطقة حجر صحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: بدأت تجمع الناس لإرسالهم إلى مناطق الحجر الصحي... وأنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: الوكالة الفيدرالية...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: ماذا حدث للسكن الطلابي؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: كنت أعيش في سكن الطلاب الجامعي، لكنني اضطررت إلى المغادرة...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: نعم. من فضلك... دعني أدخل، إذا كان ذلك ممكنًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: ماذا حدث للسكن الطلابي؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: السكن الطلابي لم يعد خيارًا متاحًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: نعم، مكان لأقيم فيه. ليس لديّ مكان آخر أذهب إليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: هل تبحث عن مأوى؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: هل تحتاج إلى شيء؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: مرحبًا. هل يمكنك السماح لي بالدخول، من فضلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: قرار صائب يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: أعني {0}. أعرف هذا النوع من الشخصيات جيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: اسمع يا صديقي. هذه الشخصية حقيرة للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: وداعًا أيها الأبله.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: حسنًا، أنت شخص غريب للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: قرار صائب يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: على أي حال، كفى كلامًا. هل ستسمح لي بالمبيت هنا أم ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: لا أملك مالًا، وزوجتي تزوجت من مهرج آخر، ولا أملك مكانًا ألتجئ إليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: عند ساعة الصفر، ستخرج من البوابة.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: كنت سأبقى، بالتأكيد. لكن هل تعتقد أن أحدًا طلب مني البقاء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: على أي حال، كفى كلامًا. هل ستسمح لي بالمبيت هنا يا صديقي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: أرغب في البقاء في مكان ناءٍ لا يتجسس فيه الأشرار. مكان آمن.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: ثم ألقيت نظرة على هذا المكان، ووجدته نظيفًا، هادئًا، وبعيدًا عن كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: لا أملك مالًا، وزوجتي تزوجت من مهرج آخر، ولا أملك مكانًا ألتجئ إليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: ليس لديّ مكان أذهب إليه يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: لماذا لم تبقَ في السجن؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: وماذا تفعل في منزلي؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: ها قد عدت إلى الشوارع.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: والآن؟ العالم كله أصبح مجنونًا. الشمس تحرق بقوة وكأنها تريد أن تقلي البشر.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: كنت سأبقى لفترة أطول، لكنهم طردوني.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: قضيت مدتين في الداخل يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: لماذا لم تبقَ في السجن؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: وماذا تفعل في منزلي؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: أما أنا، فقد اتخذت قراري منذ فترة. أول شيء فعلته بعد خروجي من السجن هو التخلص من كل تلك الملابس. والآن أتنفس بسهولة.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: يتجولون وكأن الثلج يتساقط أو شيء من هذا القبيل. حفنة من المهرجين.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: أليس هذا واضحًا؟ الحرارة هنا لا تُطاق، كأننا داخل فرن! لا أدري كيف لم ينتبه البقية لذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: من أين أتيت بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: لماذا تتجول بملابسك الداخلية فقط؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: هل تمانع السماح بدخولي يا صاح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: إذا لم تسمح لي، فسيسمح لي شخص آخر بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: لا بأس.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: لكن من دون الغيتار... لن أكون بكامل سعادتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: حسنًا، هيا بنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: نعم، أقصد {0}. لن أبقى في مكان يقيم فيه مثل تلك الشخصيات، اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: لا، لن أقترب من هذا النوع من الحثالة.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: سأحاول المبيت في منزل أحد أصدقائي. آمل أن يكون القليلون المتبقون لم يموتوا بعد...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: فهمتك يا أخي. لا مشكلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: ...أو لا! القرار لك يا صديقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: شكرًا يا صديقي! سأعزف بعض الأغاني من حين لآخر، آمل ألا يزعجك الأمر. وإن حالفني الحظ ووجدت غيتارًا، سأعزف لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: لو كنت أحد الزوار، لكسرت الباب أو تسللت عبر النافذة. لكنني... جئت بسلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: كسروا غيتاري، الأنذال. كل هذا الخراب يُفرغ البشر من إنسانيتهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: عزفت طوال الليل حتى الفجر، ثم داهم بعض المجانين بيتنا وسرقوا كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: لأنني لم أنم فعلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: سمعت أن زئرًا ظهر في الجوار. الآن يفحصون كل شخص. لا يهمني، لكن لا أريد رؤية أحد يفقد أعصابه.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: لا شيء يستحق الذكر. مكبر صوت وماء فقط. جرّبه إن كنت موسيقيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: لماذا تبدو وكأنك لم تنامي منذ أسبوع؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: ماذا تحملين؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: الوضع فوضوي للغاية كما لو أنك تستضيف شخصية مشهورة في مقهى رخيص دون أي سيطرة على الحشود!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: آه، متطفلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: دعني أمكث هنا ليلتين. لن أبقى هنا إلى الأبد. أنا لست... ما هي الكلمة المناسبة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: افتح الباب! الشمس تحرقني، سأفقد بصري!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: قد أحاول الانضمام. يبدو الأمر مثيرًا للاهتمام.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: ثم يرميهم في النار!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: سمعت قصصًا عن شخص غريب الأطوار يجمع الناس ويغسل أدمغتهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: حسنًا، سأذهب لأتفقد مكانًا آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: هذا أمر ممل. دائمًا أتعرض للموقف ذاته...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: حسنًا، إلى اللقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: أتساءل كم ربح من هذا الهراء.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: سمعت أن هناك رجلًا يبيع الهواء. يا لها من مسخرة!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: لا مشكلة، سأمر على بعض الأماكن الأخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: حسنًا، سأخبرك بكل ما لديّ من قصص!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: آسف، اعتقدت أن ذلك سيكون مضحكًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: هاهاها، أنا لا أعرف حتى من كان ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: ويتسبب ذلك في فوضى عارمة. لا، لن أحكي شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: لا أحب التحدث مع أشخاص من هذا النوع. فهم يحرّفون كل قصة إلى شيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: أوه، {0} في بيتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: هاك، خذ {0}. هل هذا مفيد لك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: أو... انتظر لحظة.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: هل تريد مشروب إنيرجيكا؟ ولديّ أكثر من ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: يا للأسف. انتظر، لديّ الكثير من الأشياء معي.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: ولديّ قصص أرويها لك. سنتسامر معًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: إذن، ستخبرني بما يجري هنا، اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: رائع!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: على أي حال، لقد سئمت الوقوف على عتبة بابك. إذا سمحت لي بالدخول، سأخبرك بما رأيته.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: بصراحة؟ استراتيجية كارثية.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: يستولي الذعر على الناس، فلا يفتحون أبوابهم لأحد، أو يطلقون الرصاص على كل ما يتحرك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: وجدت بعض المواقع الرائعة، لكن الباقي؟ مجرد نسخ مكررة.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: لقد أخبرتك بالفعل. أنا أراقب الطريقة التي يعيش بها الناس.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: أنت لا تحسن الاستماع.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: هل ستسمح لي بالدخول؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: لكن منزلك يبدو مثيرًا للاهتمام في رأيي.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: سأستمر في الركض حتى أجد ما أبحث عنه... مهما كان.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: سأركض.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: هل تهرب من شخص ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: وماذا بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: يجب أن نتبادل أسرار البقاء على قيد الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: لكنني لست ميتًا أيضًا! يبدو أن كل واحد منا توصل إلى شيء ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: نعم، أنت على قيد الحياة. وتتحدث معي... هذا صحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: وأنت عالق هنا. هل تعتقد أن هذا ما يحافظ على سلامتك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: هل تهرب من شيء ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: وماذا بعد ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: لا أحبذ ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: وحدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: كنت سأموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: لو بقيت في شقتي، لما اكتشفت ذلك قط.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: مَن يدري، ربما يكون لديك آخر أمل للبشرية في مكان ما في منزلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: كلما ابتعدت، زادت فرصتي في إيجاد حل. أنت لا تفهم، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: ماذا تقصد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: لا يمكنك الهروب من المتاعب
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: ألن تحاول الوصول إلى مكان آمن؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: أتحرك ليلًا. لذا نعم، سأكون في مكان ما قبل أن تحرقني الشمس.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: لديّ ما يكفي لفترة طويلة جدًا. لا تسألني أين أخفيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: لديّ مشروب إنيرجيكا.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: لا يمكنك الهروب من المتاعب
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: ألن تحاول الوصول إلى مكان آمن؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: سأستمر في التحرك حتى أحترق. أو حتى يلتهمني الزوار. أيهما يأتي أولًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: هناك عاصفة قادمة. وأشعر بالفضول لرؤية كيف سيواجهها الناس.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: إلى مكان بعيد. لا أستطيع البقاء في مكان واحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: ليس لديّ أي شواحن طاقة هنا
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: إلى أين ستذهب بكل هذه الطاقة؟
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: أنا متوتر للغاية الآن. لكن مشروب إنيرجيكا لم يعد يؤثر عليّ كما كان من قبل. أحتاج إلى إعادة شحن طاقتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: أوه، مهلًا! يوجد شخص ما هنا. رائع!'
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (قبول الطلبية)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (قبول الطلبية)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (قبول الطلبية)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (قبول الطلبية)
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: تخطي المقدمة
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: إذا لم تتمكن من نقل الزائر المشتبه به على الفور إلى منطقة الحجر الصحي، فعليك بإصدار إيصال حضور إلزامي له.'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: يبدو أن المهرجان سيقام في جميع الأحوال...'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: يا عزيزي... هذا ليس في صالحنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: لا، لست بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: نعم، أنا بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: هل تعيش بمفردك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: ماذا بقي في الحياة يهمك؟ أنت وحيد الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: لماذا أنت متوتر هكذا؟ وتتشبث بالحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: استمتع بما تبقى من حياتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: لن تراني مجددًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: انتهيت.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: الأذنان؟ ماذا تعني بالأذنين؟ هذه ليست علامة لتمييز الزوار!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: الأذنان؟ ماذا تعني بالأذنين؟ هذه ليست علامة لتمييز الزوار!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: أرني يديك.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: كما تشاء. إذا كان هذا هو اختيارك، فليكن. ...الموت سيأخذ حقه.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: لطالما رغبت في السلام... سأذهب معكم
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: إذا كنتم متشوقين للموت، فافعلوا ما شئتم وسأبقى أنا هنا
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: انضم إلى طقوسنا، وابحث عن السلام. تعال يا أخي، امسك بيدنا وسِر معنا نحو الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: كعربون امتنان، يمكنني أن أقدم لك الخلاص...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: حسنًا إذن. إلى اللقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: لا بد أن الأمر صعب عليك وعلينا. كيف يمكننا فحص منطقة لا يعيش فيها أحد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: أنت وحدك إذن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: يا لكم من جيل تافه...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: خسارة... أضيع وقتي الثمين معكم أيها الشباب...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: مرحبًا يا بني. هل نسيتني؟ ألم تلاحظ التلميحات المخبأة في كتاب الابتسامات؟'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: انظر لعظمة الهدية... {0}. دعني أدخل، وسأمنحك هذه المكافأة السخية مباشرة من الشمس المقدسة نفسها!'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: إليك مكافأة سخية من الشمس المقدسة نفسها! لقد استحققتها أيها البشري!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: سنلتقي مجددًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: لكنني لن أموت. أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: ترك الناس على شفا الموت ليس أمرًا صائبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: هناك شيء واحد عليك أن تتعلمه:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: لأننا... خالدان.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: أمثالك هم الذين سيتغلبون على هذا الكابوس.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: من النادر حاليًا أن تعثر على أناس يستمعون إلى الآخرين.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: ...شكرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: أعرف بالضبط من أين جاء الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: وسأخبرك بكل شيء أعرفه.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: وبمجرد رحيل الوكالة الفيدرالية عن المنطقة، سأمضي قدمًا وأواصل البحث عن ابنتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: بعض الأمور التي لا تريد الحكومة أن يعرفها أحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: عملاء الوكالة الفيدرالية يبحثون عني لأنني أعرف بعض الأمور...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: أحتاج إلى مأوى لبضعة أيام.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: مهلًا... لحظة!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: أعرف بالضبط من أين جاء الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: وسأخبرك بكل شيء أعرفه.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: ثم سأمضي قدمًا وأواصل البحث عن ابنتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: دعني أمكث هنا لبضعة أيام حتى يغادر عملاء الوكالة الفيدرالية المنطقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: إذا فعلوا ذلك، فلن يمسوها. إنهم يريدونني أنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: ربما أخذ هؤلاء الأوغاد ابنتي، وربما لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: عملاء الوكالة يبحثون عني نوعًا ما لأنني أعرف الكثير عنهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: بعيد عن هذه المنطقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: سنذهب إلى مكان بعيد عن أيادي الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: إنها ليست هنا. إلى اللقاء
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: إلى أين تريد أن تذهب؟
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: حالما أجدها، سنغادر هذا المكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: لا أعرف أين هي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: لقد كنت أبحث عنها منذ أن بدأت هذه الفوضى.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: لا تتحدث هكذا عن ابنتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: إنها ليست هنا. إلى اللقاء
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: إلى أين تريد أن تذهب؟
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: لم أجد ملاحظة متروكة، ولا أثر. اختفت ابنتي فجأة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: عندما استيقظت، لم يكن أحد في المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: ثم ضربت تلك الموجة الحارة غير العادية، وفقدتُ الوعي و...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: كان من المفترض أن نغادر هذا المكان...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: لم أتمكن من العثور عليها منذ أن بدأت كل هذه الفوضى.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: ...إنها ابنتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: إذا كنت تبحث عن ملهى ليلي، فهو في آخر الشارع
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: ليس لدينا أحد بهذه المواصفات هنا
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: هل مرت هنا فتاة ترتدي معطفًا وشعرها لونه أرجواني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: أهلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: هذا ليس المنزل المقصود.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: أنا آسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: رائحة غريبة. صوت لا أعرفه.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: هذا ليس المنزل المقصود.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: أنا آسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: رائحة غريبة. صوت لا أعرفه.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: هل تحتاج إلى مساعدة في العثور على بيتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: هل تبحث عن شيء ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: هل نحتاج إليهما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: ليس لي والدان، ولم يكن لي أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: والداي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: هل تحتاج إلى مساعدة في العثور على بيتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: هل تبحث عن شيء ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: سمعت صرير الأرضية من الخارج. هذا يعني أن هناك من ينتظر.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: كنت بحاجة إلى إضاءة المطبخ، ولكن... هناك صدى مختلف يتردد هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: تبدو جميع الأبواب متشابهة في الظلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: أين والداك؟
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: هل أنت تائه؟
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: يجب أن يكون...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: أليس نائمًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: اعتنِ بأتباعي. وتذكر، إذا مات أحدهم... فسيتحول منزلك إلى رماد.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: أراك لاحقًا. سآتي لأطمئن عليهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: هل تعتقد أن لديك خيار آخر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: أراك لاحقًا. سآتي لأطمئن عليهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: لن يحتاجوا إلى الكثير من الوقت. لكن مع ذلك، اعتنِ بهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: إنهم يعرقلون هدفنا وهذا أمر غير مقبول.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: كما ينبغي أن يكون. ومع ذلك، سأطلب منك التخلص من بعض... السكان... الذين تأويهم هنا:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: طابت ليلتك...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: تفضل: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (قبول الطلبية)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: حسنًا، خذ طلبك، وسأرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: لقد سئمت كل هذا الهراء. أريد أن ينتهي كل هذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: هذه الفوضى العارمة التي نعيشها...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: بالإضافة إلى تلك الفحوصات الصباحية التي لا تنتهي مع موظفي الوكالة الفيدرالية الذين يوجهون أسلحتهم نحونا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: فأنا أستمر في رؤية وجوه متعبة وكئيبة ومريرة...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: أتذكر عندما قلت لنفسي إن عملي كساعي توصيل يساعدني على إراحة ذهني؟ يبدو أن هذا لم يعد ينجح.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: هاه...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (قبول الطلبية)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: خذ طلبك ودعني أرحل عن هنا قبل أن تطلق النار عليّ أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: آه، فهمت... أنت تقول إن مقتل صديقي أمر جيد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: يؤسفني سماع ذلك
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: لا توجد طريقة أخرى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: تفضل: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (قبول الطلبية)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: خذ طلبيتك اللعينة. سأرحل من هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: شكرًا جزيلًا على الكلمات المشجعة. أنت حقًا ينبوع لا ينضب من النصائح الحياتية.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (قبول الطلبية)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: حسنًا، عليّ أن أذهب. خذ طلبك، وسأرحل.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: ربما الجديد الذي ستسمعه هو أنهم سيقولون إن شعر الصدر علامة على كونك زائرًا، وسيصبح العالم أكثر جنونًا مما هو عليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: اعتقدت أن الوضع لا يمكن أن يزداد سوءًا. لكن كل يوم، يزداد الأمر جنونًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: كل هؤلاء الزوار، والعلامات، والشمس الحارقة...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: بخير؟ ماذا تعني كلمة "بخير" في خضم الكارثة التي نعيشها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: تأقلم مع الواقع وستبقى على قيد الحياة. لا تتذمر كالفاشلين
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: لا تقلق. ستكون بخير
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: تفضل: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (قبول الطلبية)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: لديّ طلبية هنا لتسليمها لك. هل أنت مستعد لاستلامها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: وما الفائدة من الدراسة إذا لم أتوظف على أي حال؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: لا يهم. كونك ساعي توصيل ليس بالأمر السيئ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: نعم، بالطبع. أنت محاط بأشخاص آخرين في منزلك، لذا من السهل عليك أن تقول ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: هذا مؤسف جدًا
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: الوحدة ليست سيئة إلى هذا الحد
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: علاوة على ذلك، عائلتي تعيش بعيدة عني. ولستُ من هذه المنطقة، لقد جئت فقط للدراسة في الجامعة المحلية. أنا وحيد هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: تفضل: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (قبول الطلبية)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: على أي حال، آسف، لقد انحرفت عن الموضوع. هل أنت مستعد لتلقي هذه الطلبية؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: والآن يطلب الناس 20 لترًا من الماء في الطلبية الواحدة. أتمنى أن نحصل على إكراميات مقابل حمل هذه الأشياء الثقيلة...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: لكن هذه الشمس اللعينة... جعلونا نعمل في نوبات ليلية بسببها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: قد تكون عمليات التوصيل مربحة جدًا في الوقت الحالي. لكن المخاطر كبيرة، مهما حاولت التقليل منها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: سواء وقعت نهاية العالم أم لا، أعتقد أن الناس لا يزالون بحاجة إلى الطعام!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: أتعلم، لم أكن أتوقع أن يتجاهل الناس تخزين الأشياء قبل نهاية العالم.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: {0}؟ ما رأيك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: ما المطلوب للسماح لي بالدخول؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: يا للأسف! ربما يمكنني أن أعطيك شيئًا في المقابل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: أها! عثرت على شيء ذي قيمة! خُذ {0} يا صديقي. ودعني أبقى في بيتك حتى الصباح.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: حسنًا، لديّ سكين، سأحتاج إليها... ضمادات، بالطبع... قارورة قديمة، فارغة، لا فائدة منها...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: مهلًا، لا تطردني... دعني أرى ما يوجد في حقيبتي أولًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: القوة هي الأساس الآن يا عزيزي. يمكنك إما أن تتماشى مع هذا المبدأ، أو سيلتهمك الأقوى.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: قرار صائب.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: سأتولى الأمر. تفضل بالدخول.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: عليك طرد مثل هذه الشخصيات إذا كنت تريد الحفاظ على سلامة هذا المكان يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: أرى عندك {0}. أستطيع تمييز هذه الشخصيات من على بعد ميل. ذئاب ترتدي ثياب حملان.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: حسنًا، ادخلا
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: لدينا شيء قد يساعدك، خُذ {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: أختي الصغرى... إنها تمر بوقت عصيب للغاية. لكن... لدينا... ماذا كان اسمه مرة أخرى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: هممم... أتفهم ذلك، فأنت لا تعرفنا. وقد تعتقد أننا سنسبب المشاكل. لكنني أعدك بأننا لن نفعل ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: إنهما يذكراني كثيرًا بوالدينا... وهذه ليست أفضل بيئة لها، نظرًا لحالتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: هذا مقلق... أختي ستعاني في ظل وجودهما هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: أرى أنك تستضيف بالفعل {0} و{1} في منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: لا أعتقد أننا سننسجم في بيتك.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: أتعلم، قبل أن ألتقي بزوجي، كنت... دعنا نقول فقط إن هذه الشخصيات تذكرني كثيرًا بشخص كنت أعرفه.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: سيكون من الصعب عليّ العيش تحت سقف واحد مع هذا النوع من الأشخاص...
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: '{0} معك في البيت...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: وهذا آخر ما تحتاج إليه الآن. إنها بحاجة إلى الهدوء والراحة، لا إلى انتقادها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: أستطيع بالفعل تخيل كيف ستؤثر طريقة كلام هذا الشخص على أختي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: أخشى أن {0} في بيتك بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: بوركت! لولا ذلك القرار لوقعت الكثير من المشكلات.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: عليك طرد الحمقى وعديمي الفائدة يا عزيزي. وسأجلس في المكان الذي ستخليه لي!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: لا، اعتقدت أنك لا تريد أشخاص عديمي الفائدة في بيتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: يا للمفاجأة... انظر مَن في الداخل. {0} في بيتك؟ يا للروعة!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: شكرًا، لن أبقى طويلًا... أحتاج فقط إلى أن أستريح لبعض الوقت...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: لن أبقى في بيت واحد مع شخص مثله.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: ... هل {0} في بيتك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: شكرًا على مساعدتك. على عكس...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: ما رأيك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: معي {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: لا بأس! لكن، ربما هناك شيء يمكنني أن أقدمه لك. هل هناك شيء تريده؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: حسنًا، ادخلا
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: ما رأيك؟ هل ستساعدنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: ماذا عن {0}؟ أنا على استعداد لإعطائك كل ما لديّ إذا كان ذلك يعني أن حبيبتي ستحصل على قسط من الراحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: لدينا شيء ما، إنه ليس قميصي ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: بالمناسبة...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: إنها حب حياتي. سأعطيك ملابسي إذا أردت مقابل دخولها إلى بيتك الآمن.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: زوجتي ضعيفة جدًا هذه الأيام. وتتعب بسرعة. وأنا... سأفعل أي شيء من أجلها، أتفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: أرجوك يا صديقي... اعذرني على إلحاحي، لكن حاول أن تضع نفسك في مكاني.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: ساقيّ هما الدليل الذي تحتاج إليه! انظر! لا يوجد شيء هنا، أليس كذلك؟ هاه!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: إنه يعمل بالتأكيد!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: لن تسمح لي بالدخول؟ سأغير رأيك! خذ {0}، اضرب به الباب، و... ستصبح غير مرئي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: معايا {0}! إيه رأيك؟ ساعدني وأساعدك. خليك جدع.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: طب هقولك على حاجة. هديلك حاجة ممكن تحتاجها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: اسمع كلامي مش هتندم...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: لديّ {0}. أحتاج إلى يوم على الأقل لأستريح. لكن... لست متأكدًا من أن ذلك سيحدث أبدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: كان... كان معي شيء ما. انتظر، من فضلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: ما رأيك؟ ها! هل هذا مغرٍ لك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: إليك شيئًا صغيرًا... هدية مني. خذ {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: أجل... أعرف ما الذي سيفي بالغرض، أجل أعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: لديّ أيضًا بعض... العلكة؟ لم يتبق لديّ سوى بضع قطع، لكنني سأعطيها لك إذا كنت تريدها.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: ربما تريد شيئًا مني؟ ما رأيك في {0}؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: أنا... أنا لا أعرف ماذا أفعل...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: حسنًا، ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: أرجوك... سأموت هنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: هيا يا رجل... أنا مستعد لأعطيك كل ما لديّ. خذ، ما رأيك في {0}؟ ليس معي شيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: الآن، إما سأنزف حتى الموت على عتبة بابك... أو ستسمح لي بالدخول وتساعدني في تضميد جراحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: أتعلم شيئًا؟ تبًا لك. سأطلب من أحد جيرانك أن يدعني أدخل. وداعًا أيها الأحمق.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: ما مشكلتك يا هذا؟ أحاول العثور على حل، وأنت تفسد كل شيء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: هل تريد الموت؟ زوجي يعمل في الوكالة الفيدرالية!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: لا أقبل الرشاوى
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: حسنًا، ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: ومعهم بطاقات الحجر الصحي، والكلاب... وسوف يعودون كل يوم. الآن، هل غيرت رأيك بشأن السماح بدخولي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: هل ترفض؟ سأتحدث إلى زوجي، وسيأتي الرجال ذوو الزي الأصفر في الصباح لإجراء تفتيش غير مقرر.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: لنعقد صفقة: سأعطيك {0} مقدمًا، وتسمح لي بالدخول. اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: اسمع، أنفي حساس للغاية. أستطيع شم رائحة الأشخاص المشبوهين والزوار بشكل لا يضاهى.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: آمل أن أتمكن أخيرًا من النوم...
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: لقد رأيت أمثال هؤلاء مرة واحدة في أحلامي، وصدقني، كان ذلك كافيًا لإيقاظي.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: ' لا يوجد مكان لنا نحن الاثنين.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: أود ذلك، لكن... يبدو أن أحدهم قد أخذ مكاني بالفعل .انظر، {0} في مكاني.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: لا أعرف لماذا أرتديها حتى الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: أعتقد أن هذه البدلة مخيفة بعض الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: أفهم قصدك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: لم أعتقد أنك ستسمح لي بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: حقًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: إذا أمكنك إخلاء المكان لي، أقسم إنني سأجلس بهدوء ولن أزعج أحدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: اسمع. أرتدي هذا البدلة اللعينة طوال اليوم... أريد خلعها قليلًا والاستحمام لغسل كل الأوساخ و... الدماء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: أوه... أرى أن {0} في الحمام بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: مهلًا... لحظة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: ماذا؟ شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: شكرًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: كنت سأدخل... لكن، حسنًا، أنت تفهم قصدي...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: آه، تستضيف {0} بالفعل في بيتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: 'Marauder: كان الأمر يستحق المحاولة على الأقل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: 'Marauder: اللعنة، اعتقدت أنني سأستريح قليلًا هذه المرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: 'Marauder: هيه. هذا ما أردت سماعه.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: 'Marauder: هناك، أترى؟ {0} في مكاني.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: 'Marauder: أوه، انظر إلى ذلك. المكان المريح قد تم شغله بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: يمكننا مناقشة شروط الإيجار بالتفصيل لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: اختيار صائب.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: ألا تعني لك المواد 28 و48 و7.3 من الدستور شيئًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: هل تعلم أن هذا الفرد مجرم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: همم... حسنًا، في الواقع، لديك بالفعل أحد المستأجرين هنا. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: أفهم وجهة نظرك. لكن اللعنة، هذا صعب...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: وتعال لزيارتي من وقت لآخر، اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: شكرًا يا صاح. قدمت لي معروفًا كبيرًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: على أي حال، عليك أن تختار بيننا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: هه. هذا يذكرني بأحد الأشخاص الذين كانوا يطاردون عائلتي و...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: اسمع، لا تسيء فهمي، لكن {0} في منزلك، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: احتفظ بجثتي عندما يحين وقتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: لا أعرف إن كنت ترى الجمال كما أراه. لكن أخبرني... أنت لا ترمي الجثث، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: ومع ذلك جئت لأستمتع بضباب الغسق الصامت.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: أود ذلك... لكن {0} في بيتك بالفعل. وهذا لا يبشر بالخير.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (يومئ برأسه ويدخل)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: (يبدو أنه لا يحب {0}. يشير إليه، ثم إلى نفسه، ثم إلى الرجل)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: ممممف... بببببففف!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: سأكون في الجوار، فلا تتردد في طلب المساعدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: أفهم أن من الصعب الوثوق بأي شخص في هذه الأوقات.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: شكرًا. آمل أن أتمكن من مساعدة الناس هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: يُستحسن أن يجد شخصًا يمكنه مساعدته حقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: لا أستطيع توفير الرعاية الكافية له.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: همم، أرى أن {0} هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: سأريح عظامي العجوزة، ثم أواصل طريقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: هل يمكنك أن تكون لطيفًا وتجلب لجدتك كرسيًّا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: أوه، شكرًا لك يا عزيزي! من المؤسف أنك اضطررت إلى طرد شخص ما من أجلي...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: سأستريح قليلًا هنا، وألتقط أنفاسي، ثم أواصل السير إذا لم تمانع.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: مع وجود أشخاص سيئين مثل هؤلاء، ستصبح الأمور معقدة بسرعة يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: يا إلهي! يبدو أن {0} على كرسيي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: وااااااااااااااااااااء!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: أنا... خائفة جدًاااا...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: أنا... أنا لا أعرف أحد آخر...!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: أرحل أين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: باباااا! بابااااا!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: أريد رؤية باباااااا...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: لكنني... أريد الجلوس في ذلك المكان! أريد، الآن، الآن! هذا هو المكان... الذي كان يجلس فيه أبي...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: {0} في بيتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: أنا... لا... لا يوجد مكان لي!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: لا يهم. هناك الكثير من الحمقى في الجوار. وداعًا، أيها المغفل!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: تبًا، كنت أعرف أننا لن نكون على وفاق. لا أتعامل مع الجبناء أمثالك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: رائع! مرّ على شقتي عندما يسمح لك الوقت، اتفقنا؟ لديّ بعض الأخبار المثيرة التي أريد إخبارك بها.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: لن أدخل إلا بعد مغادرة الشخص المقزز.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: سأكون صريحًا معك، لديك {0} بالفعل. وهذا شيء مقزز.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: ربما ستُدفئني الشمس لمرة أخيرة...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: نعم... سأذهب إلى مكان آخر... بعيد عن الجميع...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: أتـ-أتفهم ذلك. سأغادر...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: شـ-شكرًا لك. هذا أكثر أمانًا. صدقني.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: أنا... أخشى أن أكون في نفس الغرفة مع هؤلاء الناس. يحدث شيء غير سار. في كل مرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: شـ-شكرًا لك. أوه. لن أدخل في وجود {0} في بيتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: تبًا لك. أراهن أنك من النوع الذي يطلب كوبًا من الماء في الحانة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: حسنًا، على الأقل شيء ما سار على ما يرام اليوم. تفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: أشخاص مثل هؤلاء طُردوا من الحانة قبل أن أطرد.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: لن أتحدث إلا في حال مغادرة {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: حسنًا، هاها... سأغادر. ممم، الشمس ستقتلنا على أي حال. سنموت جميعًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: شكرًا. سأجلس بهدوء. لكن لا تغلق الباب، اتفقنا؟ هاها. فقط تحسبًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: أيمكنك... إفساح مكان لي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: أرجوك، هل يمكنك إجراء فحص أو...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: لا... لا يمكنني البقاء في البيت نفسه. ماذا لو اكتشفنا أن هذا الشخص زائرًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: هناك في بيتك... {0}...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: قرار صائب يا فتى. أعرف ما أفعله. يمكنني مساعدتك إذا ظهر ذلك... الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: أستطيع شم رائحة الدماء. لا أعرف لماذا سمحت لهكذا أشخاص بالدخول. هل تحب العيش بين المخاطر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: يبدو أنك تستضيف {0} بالفعل يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: سأشارك معرفتي التنويرية مع شخص آخر! وداعًا أيها الوغد!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: سكان الجحيم الأشرار هم مَن يبقون أبوابهم مغلقة أمام النور... ويرفضون التنوير!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: سحقًا لك!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: الآن، أين الثلاجة...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: قرار صحيح، أيها البشري! ستشرق بركة الأشعة المقدسة في عينيك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: ظله يطفئ نور الصالحين! يجب طرد الروح المذنبة! الآن! الآن!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: أيها البشري! لا يمكنني الدخول بينما {0} في الداخل. الشمس قررت ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: هناك تيار قوي من الطاقة الإيجابية يتدفق عبر منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: رائع... بصراحة، تمتلك مساحة ميتافيزيقية نادرة في الزمن هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: علينا التخلص من هكذا أشخاص، وإلا ستتوافق النجوم لتحدث كارثة. هل تفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: أرى أمامي {0}. ألا يوحي لك ذلك بشيء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: أوه... أستطيع أن أشعر بها... هالة كثيفة وقمعية. ظل... قوي بما يكفي لتسميم المنزل بأكمله! نذير شؤم!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: اعتنِ بنفسك، اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: ومن بعدها، يمكن أن تصبح الأمور مأسوية للغاية، وبسرعة كبيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: إذا ركزت عليه أكثر من اللازم، فسيبدأ في التهامك حيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: لا تغرق في حزنك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: ربما عندها، لن يكون الموت هو الشيء الوحيد الذي يشغل بالك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: آمل أن تتذكر كيف كان شعورك بالسعادة.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: شكرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: سأكون ممتنًا جدًا إذا وفرت مكانًا صغيرًا لي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: لا أريد أن أطرد أي شخص، فمن يدري، ربما يحتاج إلى هذا المكان أكثر مني.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: كنت لأدخل عندك لكن يبدو أن {0} هنا بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: هيا، حركي ساقيكِ اللعينتين. أنا متعب أيضًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: سنواصل البحث، أليس كذلك يا زوجتي العزيزة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: فهمت. آسف على الإزعاج.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: يا لكِ من امرأة خجولة! لا بأس. سنجعلكِ تستريحين قريبًا يا زوجتي العزيزة!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: لماذا تقفين هكذا يا زوجتي العزيزة؟ هيا بنا، لقد تمت دعوتنا للدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: أوه، شكرًا جزيلًا لك!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: عليكما الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: سأطرد مَن تريدان. ادخلا
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: زوجتي لا تحب الأطفال كثيرًا. لم أتوقع أن أجد شخصًا بهذا السن هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: اسمع، لا أريد أن أكون صعب المراس، لكن... لا يمكننا البقاء هنا في وجود {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: ومَن هذا الذي أراه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: أوه، أنا ممتن لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: سحقًا لهذا الهراء!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: ستجلس في مكانك وتتحمل هراءهم حتى تختنق به.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: اللعنة، أنت مثير للشفقة مثل بقية هؤلاء الجبناء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: ..'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: لا أستخدم هذه القبضات إلا على نفسي. لن يتأذى أحد غيري.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: ولن أحطم المكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: لا تقلق، لن أغضب من أي شخص آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: لا. لن أبقى تحت سقف واحد مع غرباء الأطوار. سأفقد صوابي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: أتستضيف {0} عندك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: لا... لا... ما زالت هناك فرصة للوصول إليه...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: ربما فات الأوان بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: حسنًا. هيا يا حبيبي... سنرى إن كنا سنتمكن من الوصول إلى منزل أبيك الغبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: هيا، لا تقف عندك. ادخل، السيد لن ينتظر إلى الأبد.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: أخيرًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: ربما يمكنك... لا أعرف... اتخاذ قرار ما. حتى تتمكن طفلتي من النوم بأمان وسلامة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: هممم... أرى {0} عندك. طفلتي خائفة بالفعل...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: أترين يا قطتي؟ قرار خاطئ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: أترين يا قطتي؟ لست أنت أيها المغفل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: تعالي يا قطتي. هل أنتِ سعيدة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: هممم. لا يفترض أن تكون هذه الشخصية هنا. عليك اتخاذ قرار.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: معك {0}؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: آسفة...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: فهذا هو نوع الأشخاص نفسه الذي... الأطفال...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: لا يمكنني البقاء تحت سقف واحد مع هذا النوع من الأشخاص.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: المعذرة، ولكن هل تستضيف {0} عندك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: خلي بالك من نفسك يا صاحبي... ومن اللي معاك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: خلاص ولا يهمك. اللي تشوفه.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: ليه كدة يا جدع؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: عااااش! كنت عارف أنك صاحبي الجدع!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: يا خسارة... بس لمصلحتك تسمع كلامي وتطرد الناس اللي زي دي!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: لا يا عم مش هقدر اقعد هنا في وجود الناس اللي قلوبها مش صافية دي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: هل فعلًا {0} في البيت عندك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: إيه الاخبار يا... إيه ده...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: وإلا سيعثر عليك ويلاحقك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: من أجل مصلحتك، لا تقترب من الجثث المحترقة في الليل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: سأرحل، ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: عليّ البحث عن مكان آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: أنا آسف... لا أستطيع شرح الأمر. لكن هذا شعوري تجاه أشخاص كهؤلاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: أشعر أن {0} في البيت. ولا أحب وجود شخصيات كهذه في المكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: إلى أين سأذهب؟ لا مخرج لي. أنا في ورطة كبيرة!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: عفوًا؟ من الواضح أنني بحال سيئة، كما أنني وزير!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: سأبرم صفقة مثمرة معك... بمجرد انتهاء كل هذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: ممتاز، لقد اتخذت القرار الصحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: عليك التصرف حيال هذا الأمر وإلا فلن أبقى.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: لديك... {0} في البيت. لا لا! لا أود أن أشارك الحمام مع أحدهم!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: شكرًا يا صديقي! لقد أنقذت حياتي!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: لا أمانع في مشاركة السكن، لكن هذا البيت يبدو مزدحمًا بعض الشيء... هل تمانع أن تفسح لي بعض المساحة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: أوه، يا صديقي... يبدو أن هناك مَن يشغل هذا المكان بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: نعم... ربما تكون على حق. سأذهب إلى المنزل، تحسبًا لعودتهما...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: لكن... ربما يجب أن أبقى معك في الوقت الحالي. أشعر بأمان أكثر.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: ماذا لو عاد والداي إلى المنزل ولم أكن موجودًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: شكرًا لك! ما زلت... لا أستطيع التوقف عن القلق.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: ذات مرة، في الحديقة. هاجمني أمثال هذه الشخصيات. لم أخطُ خطوة في الحديقة منذ ذلك الحين!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: أرى أن {0} على الأريكة بالفعل. وبصراحة أخشى التعامل مع هكذا أشخاص.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: طابت ليلتك أيها المغفل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: كما تشاء. اختبئ خلف بابك الضعيف. دعنا نرى إلى أين سيقودك ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: هل تخشى أن تأتي الوكالة الفيدرالية للبحث عني؟ أيها الجبان.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: هل أنت جاد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: آمل ألا يكون جيرانك حثالة أيضًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: لقد أنقذت حياتي للتو يا رجل!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: أؤكد لك، أناس مثل هؤلاء سيبيعونك في لمح البصر.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: هذه الشخصيات تتظاهر بالهدوء، وكأنها تهتم بشؤونها الخاصة... ثم تطعنك في الظهر بلا سابق إنذار.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: لا أستطيع... اسمع يا رجل، لقد قابلت مثل هذه الشخصيات من قبل. ولديك أحدها هنا في بيتك. أقصد {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: عندما تقف أمام الرب للحساب، ستدرك كلامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: موتي سيقع على عاتقك، وستُعاقب عليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: يا للهول...! جاءتك فرصة ثمينة للخلاص وأنت ترفضها. عار عليك!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: شكرًا للرب...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: عليك طرد هذه الأرواح الشريرة يا بني!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: "عمر كامل لن يكفي للتكفير عن ذنوب أمثال هؤلاء! يجب إخراج الشياطين من البيت وطردهم!"'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: ومَن هناك، إذا جاز لي أن أسأل؟ {0}؟ لا أريد البقاء مع المذنبين.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: أنا... آمل أن أتعلم يومًا الدفاع عن نفسي... وكيفية قتل الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: لا بد أن ذلك الشخص يهمك. آسف لإضاعة وقتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: آه، يا إلهي... لم أقصد أن أضعك في موقف حرج كهذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: هل يمكنك أن تريني كيف تفعل ذلك؟ كيف تقتل زائرًا؟ أريد أن أواجه مخاوفي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: و... من فضلك... بعد أن تفحصني...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: شكرًا يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: الأمر هو... أنني لا أستطيع العيش مع أشخاص من هذا النوع. لقد حاولت. لكن... لم ينجح الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: يا إلهي... لا أقصد أن أكون وقحًا، لكن، {0} هنا بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: أتعلم؟ تبًا لك. سأذهب للتحدث إلى جيرانك. إلى اللقاء أيها الأحمق.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: ما مشكلتك بالضبط؟ أحاول حل المشكلات، وأنت تفسد كل شيء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: هل أنت جاد؟ زوجي يعمل في الوكالة الفيدرالية!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: هؤلاء المتطفلون الملاعين... ابتعدوا عن طريقي!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: سأطرد مَن تريدين. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: عليك اتخاذ قرار صارم قبل فوات الأوان!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: أعرف هذا النوع من البشر جيدًا. ما كان يفترض أن يكون هذا النوع هنا. فهذه النوعية من البشر تثير المشاكل يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: مَن هناك، {0}؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: وداعًا! لا أعتقد أنك ستعيش طويلًا بعقلك هذا!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: ذو العقل الضحل من يدير ظهره للحقيقة بهذه السهولة!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: أنت... أنت...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: ماذا تعني بـ "عليك الرحيل"؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: بمجرد أن نتحدث، لن ترى العالم بنفس الطريقة مرة أخرى!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: أنا سعيد لأنك اتخذت القرار الصحيح! ولن تندم على ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: سأطرد مَن تريد. ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: لكن إذا اتخذت قرارًا بالطرد، فسأقبل دعوتك بكل سرور!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: لا يمكنني أن أفصح عن أي شيء في وجودنا معًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: هل أرى... {0} هناك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: أوه لا. مستحيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: مهلًا. مَن هناك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: رائع!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: ما كان يجب أن أضيع وقتي معك...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: هاه... لا يهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: ممتاز!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: سأطرد مَن في هذا المكان. ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: هذا غير قابل للنقاش.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: إذا كنت سأبقى هنا، فسأفعل ذلك وفق شروطي.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: لا تهتم. لديك بالفعل {0} في وسط البيت.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: سحقًا لك يا هذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: أنت مثل أبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: حسنًا... إنه لا يعتقد ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: هل تعتقد أن مواجهة نهاية العالم بمفردك ستجعل الأمور أسهل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: لم أتوقع إطلاقًا أن تجيب بإجابة مختلفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: أثق أن بإمكاننا شغل أنفسنا بشيء... أفضل... من جَلد الذات الذي لا ينتهي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: لنهرب معًا من أهوال هذا العالم — أنا وأنت فقط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: ربما يمكننا التواصل معًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: يمكنني مساعدتك إذا أردت يا حبيبي. يمكنك التدرب معي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: التواصل مع الآخرين أمر صعب. لست وحدك من يعاني ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: فهمت. لا يستطيع الكثير من الناس الاستماع إلى مشاكل الآخرين دون أن يقاطعوا بقولهم: "لقد مررت بما هو أسوأ!"'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: نحتاج جميعًا إلى بعض الراحة في هذه الأيام. والقليل من الاهتمام... والمودة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: إذا سمحت لي بالدخول، فقد نتمكن من مداواة جراحنا — والتعافي معًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: و...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: ينتابني الشعور ذاته يا حبيبي. يمكننا التحدث عن ذلك... إذا أردت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: التخلي عن الغضب أمر صعب. أما التسامح فهو أصعب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: هل نشأت مع أب عنيف؟ هذا فظيع. أنا سعيدة لأنك تجاوزت هذه المرحلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: دعني أدخل، وسأمنحك هذا الاهتمام... سأجعلك أفضل حالًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: لكن حتى الأشخاص الأكثر وحدة يحتاجون إلى... نوع خاص من الاهتمام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: في هذه الأيام، الجميع مهووس بنهاية العالم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: يمكنني أن أقدم لك شيئًا لا يستطيع معظم الناس تقديمه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: هممم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: لكنني لن أجبرك على فتح قلبك لي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: ربما سيساعدك ذلك، بمجرد أن تفتح قلبك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: لم أكن أجيد التعامل مع الناس قط. وهذا لن يتغير الآن.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: كنت أتمنى أن يموت أبي. هل هذا كافٍ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: لا أريد ذلك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: أخبرني يا حبيبي. أنا مجرد شخص غريب على بابك. ربما لن نلتقي مجددًا أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: أم كانت طفولتك؟ كانت طفولة عصيبة، أنا متأكدة. هل استرجعت الذكريات؟ يا لك من مسكين...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: ربما قتل الزوار شخصًا قريبًا منك، مما أجبرك على تجاهل مشاعرك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: هل هناك ما يزعجك؟ هل تركتك زوجتك مؤخرًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: أوه، لقد جرحتني!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: لم أكن أجيد التعامل مع الناس قط. وهذا لن يتغير الآن.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: كنت أتمنى أن يموت أبي. هل هذا كافٍ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: لا أحبذ ذلك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: أنت لا تتحدث كثيرًا، أليس كذلك؟ أخبرني عن نفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: الناس يعلقون على مظهري كثيرًا مؤخرًا. أكثر مما كانوا يفعلون من قبل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: هل يعجبك ذلك يا حبيبي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: يسعدني أنك لاحظت ذلك. شكرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: تبدين... على غير طبيعتكِ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: يا له من سؤال غبي. فأنت تعيش هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: هل تمكنت من التكيف بعد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: كيف هي حياتك الجديدة يا حبيبي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: بصراحة؟ أنا لا أكترث إطلاقًا بصورتك اللعينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: تبدو سليمًا. لكن هذا حال نصف الخونة الذين دفنتهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: أتعبث معي مجددًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: اغرب عن وجهي. لن أشم إبطيك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: إذا كان هناك شيء ينمو هنا، فمن الأفضل ألا أعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: أتمزح معي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: هممم. يمكنك العيش بحرية... في الوقت الحالي. ليس لديّ وقت لهذه التفاهات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: حسنًا. هذا لا يعني أنك في أمان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: افتح عينيك اللعينتين أكثر. توقف عن العبث معي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: ليس لديّ وقت لهذا الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: همف... سواء كانت سليمة أم لا، فهذا لا يعني لي شيئًا. الزوار يندمجون جيدًا في كلتا الحالتين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: ماذا؟ حركها. أنا لا أعض إلا إذا اضطررت لذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: كفى كلامًا. أضيع وقتي هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: لا تغتر بنفسك، خطأ واحد وسينتهي أمرك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: تبدو سليمًا. لكن بصراحة؟ كنت أتمنى العكس. كان ذلك سيريحنا كلينا لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: افتح فمك يا فتى. لستُ طبيب أسنانك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (أظهر أذنيك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (أظهر صورة لك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (أظهر إبطيك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (أظهر عينيك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (أظهر يديك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (أظهر أسنانك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: على أي حال، هذا يكفي. سأفحصك. أرني أنك لست واحدًا منهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: ضحكوا. وقالوا إن عليّ أن أنضم إليهم. تبًا لذلك. كل ما يفعلونه هو خطف الناس في أماكن بعيدة، والزوار ما زالوا هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: ثم جاء موظفو الوكالة الفيدرالية وتحدثوا عن "التطهير". أخبرتهم ألا يقلقوا، فقد أنجزت ذلك بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: قتلتها أولًا. ثم قتلتُه. وتمكن الأطفال من الهرب مع الجيران بطريقة ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: عندما بدأ الزوار في تسلق السطح، فتح الأحمق الباب أخيرًا. وتركها تهرب. لذا فعلت ما لم يستطع هو فعله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: لكن الزوجة... كانت تظهر عليها علامات. ظل يتوسل إليّ قائلًا: "إنها زوجتي. لا تؤذِها!"'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: كانت هناك عائلة تعيش في أطراف المدينة. وكانت محاصرة في المنزل، وكان الأب يمسك الباب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: ولكن الآن؟ لم أعد أهتم. لقد اكتفيت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: لا فائدة من البحث. إنها مضيعة للوقت. لو كان أخي شجاعًا، لربما كانت هناك فرصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (أظهر أذنيك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (أظهر صورة لك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (أظهر إبطيك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (أظهر عينيك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (أظهر يديك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (أظهر أسنانك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: على أي حال، اكتفيت من القصص. سأفحصك. أرني أنك لست واحدًا منهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: تبدو خائفة، لكنها حية. هذا ما أحترمه. عكس أخي الجبان. لو كان مات مبكرًا، لربما نجت عائلته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: اعتقدوا أنه قُضي عليهم. لكن بعد أيام وجدوني. وتخيل مَن أول مَن ظهر من بين الأشجار؟ ابنته، وبيدها بندقية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: أخرج عائلته من الباب الخلفي، وهربوا إلى الغابة. قضيت على هؤلاء الزوار المجانين، لكنهم لم يعودوا قط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: رأيت عائلة منذ فترة قصيرة. أب قوي البنية. حافظ على رباطة جأشه، حتى مع صراخ الزوار عند النوافذ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: كيف أصبح العالم بهذه الفوضى في المقام الأول؟ بسبب الجبناء أمثاله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: انهار كالجبان. الآن عائلته إما مدفونة أو ممزقة إربًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: كما هو الحال دائمًا. حتى أنني قلت لأخي: "كن رجلًا، اعتنِ بأسرتك". وماذا فعل بعد ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: هل تريد العثور عليها؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: كيف حالك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: لو لم يكن أخي جبانًا، لربما كان بإمكانه حماية زوجته وطفلته. الآن، لا أحد يعلم بمكان تلك الشقية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: لقد عدت. لكنني لست متأكدًا من سبب اهتمامي بالأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: تبًا، لديّ أمور أهم لأتعامل معها. سأعود إليك لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: إذا حاولت أن تخدعني بأذنيك مرة أخرى، فسأقتلك على الفور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: لولا أخي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: الأذنين؟ هل تعتقدني غبيًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: بصراحة؟ لا أهتم بتلك الصورة على الإطلاق. لديّ أمور جدية لأتعامل معها. ستعيش في الوقت الحالي. وسأراك لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: همف... تبدو سليمًا، بالتأكيد. لكنني قتلت الكثير من المخادعين الذين تظاهروا بسلامتهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: صورة؟ أتعتقد أن صورة تكفي؟ حسنًا، لنرَ إذا كنت سليمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: لا توجد علامات. أنت محظوظ. الآن اغرب عن وجهي. لديّ مشاكل أكبر لأتعامل معها. سأعود لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: تبدو سليمًا. لكن هذا لا يعني شيئًا. هؤلاء المجانين يتظاهرون ببراعة تفوق قدرتي على اكتشافهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: هممم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: لكن ليس الآن. لديّ أمور أهم لأتعامل معها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: أنت سليم في الوقت الحالي. لكن إذا لاحظت أي شيء غريب بك، سأطلق النار عليك بلا تردد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: هل تدرك ما يمكن أن يفعله زائر "عادي" واحد في ليلة واحدة؟ خطأ واحد فقط وسيموت الجميع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: هيه... لا تظهر أي علامات. عظيم. عظيم جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: هيا، استخدم أصابعك. افتحها على مصراعيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: ليس لديّ وقت لهذا الهراء. سأفحصك بشكل صحيح في المرة القادمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: دعني أخبرك شيئًا. إليك نصيحة: أولئك الذين يبدون عاديين؟ هم دائمًا أول من يتحولون.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: سليمة... نعم، بالطبع هي سليمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: تبًا، ليس لديّ وقت لهذا. عليّ التحقق من أمر ما. إلى اللقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: حسنًا. ستعيش... في الوقت الحالي. لكن إذا لاحظت أي شيء غريب بك، سأطلق النار عليك بلا تردد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: هممم... لا توجد أي علامة. للأسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: افتح فمك أكثر. هيا، لا تخف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (أظهر أذنيك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (أظهر صورة لك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (أظهر إبطيك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (أظهر عينيك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (أظهر يديك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (أظهر أسنانك)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: لديك سلاح ناري؟ لا يهمني. سنموت معًا إذن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: أثبت أنك لست واحدًا منهم. أي جزء منك سيفي بالغرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: هممم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: نجت الفتاة فقط. لكن الرجل مات
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: منزله احترق. ولم أره منذ ذلك الحين
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: زوجته... حسنًا، تبًا للزوجة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: لديه طفلة. فتاة صغيرة. لا أعرف عمرها بالضبط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: بما أنني هنا... أخبرني، هل تعرف رجلًا قصير القامة يرتدي سترة جينز زرقاء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: الزوار يتغذون على ضعف أصحاب القلوب الرقيقة. هكذا يُقتل الناس في منازلهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: عليك تنفيذ القصاص بأسرع ما يمكن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: نجت الفتاة فقط. لكن الرجل مات
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: منزله احترق. ولم أره منذ ذلك الحين
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: زوجته... حسنًا، تبًا للزوجة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: لديه طفلة. فتاة صغيرة. لا أعرف عمرها بالضبط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: بما أنني هنا... أخبرني، هل تعرف رجلًا قصير القامة يرتدي سترة جينز زرقاء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: وجود علامة واحدة كافٍ لقتلهم. لا أتردد للحظة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: التلفاز والمذياع يوضحان العلامات لنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: بنفس الطريقة التي تتعرف عليهم بها، أراهن أنها هي نفسها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: ماذا لو ظهرت عليهم علامة أو علامتان فقط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: كيف يمكنك التعرف على الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: هل تخلت الوكالة الفيدرالية عن هذه البلدة؟ أم عن هذا الحي فقط؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: لكنني تفقدت بعض المنازل. هذا المكان يعج بالزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: حاولت العثور على الشخص الذي ذكرته. لكن لم يحالفني الحظ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: لقد عدت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: سأعود لاحقًا... لقد أثرت اهتمامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: لديّ شخص أحتاج إلى تفقد حاله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: لماذا تذكرهم... هذا مريب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: لديهم طرقهم الخاصة في اكتشاف علامات الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: إنهم بارعون فيما يفعلونه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: استرح. وسنتحدث لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: أحتاج إلى إنجاز هذا الأمر وفق شروطي الخاصة. وأنا عازم على ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: لكنني لا أثق بك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: إذن تحاول الحفاظ على النظام أيضًا. ممتاز.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: لقد أثرت انتباهي. سأعود مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: نعم، أعتقد أنك فعلت. لا تبدو كشخص معتاد على نشر الشائعات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: هذا مثير للاهتمام... هل رأيته فعلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: إذن لم يكن يرتدي أي درع واقٍ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: زائر واحد فقط؟ ونصف عارٍ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: الوكالة الفيدرالية تخطف الناس. لا توجد أي معلومات عما إذا كانوا سيعودون أم لا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: يواصل الزوار الظهور في المكان. لكنني أمتلك سلاحًا ناريًا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: زائر نصف عارٍ قضى على دورية بأكملها
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: هل هناك أي شيء غريب يحدث في هذا الحي؟ هل هناك أي تهديدات يجب أن أحترس منها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: لقد طرحت أسئلتك بالفعل. الآن سأطرح أسئلتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: كفى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: إلى متى تخطط لـ"تنظيف القذارة"؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: ما سبب وجودك هنا إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: وإذا ترك أحدهم انطباعًا قويًا لدي... فقد أختار شيئًا آخر أكثر قيمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: فأنا أخلع سنًا من كل زائر. فهي أسهل الغنائم التي يمكن الحصول عليها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: إنها بمثابة تذكير — حتى لا أنسى عدد المنازل والبلدات التي قمت بتطهيرها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: هه. هذا مصطلح مناسب. سأبدأ في استخدامه من الآن فصاعدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: "محصن ضد الزوار"؟ أتعني هذه القلادة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: إلى متى تخطط لـ"تنظيف القذارة"؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: ما سبب وجودك هنا إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: وأي شخص يتعاطف مع الزوار... قد يكون واحدًا منهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: لكن أتعرف الطريقة الأكثر فعالية؟ حبسهم في منزل وإشعال النار فيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: يمكنني إزالة القذارة بيدي العاريتين، لكنها تسهل الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: بالطبع إنها مقشة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: هه. استنتاجك مضحك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: ما هذا الزي والمعدات؟ هل من المفترض أن تجعلك محصنًا ضد الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: دعني أخمن، هل تمسك بمقشة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: أما أنا، فلا أختبئ. أنا ممثل العدالة. أنا أجلب النظام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: لا تقتص منهم العدالة أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: ثم يمر يومان، فيذبحون كل من في المنزل ويهربون ويكررون الأمر من جديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: بعض الناس يشعرون بالشفقة تجاه الزوار. يعتقدون أنهم يستطيعون، لا أعرف... أن يتحسنوا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: هذه ليست لعبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: ما هذا الزي والمعدات؟ هل من المفترض أن تجعلك محصنًا ضد الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: دعني أخمن، هل تمسك بمقشة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: لست بحاجة إلى معرفة أي شيء آخر عني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: لقد انتهيت من تنظيف الحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: شخص موجود هنا لتنظيف القذارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: لماذا لست بالداخل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: مَن أنت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: ...إلا إذا كنت زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: ممتاز. هذا يزيد من فرص نجاتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: تحافظ على مسافة بينك وبيني، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: هل ستنسحب بهذه البساطة؟ وتعود إلى حياتك وكأن شيئًا لم يحدث؟ هيا، انزل إلى هناك. لنحل هذه المشكلة معًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: ماذا لو كان هناك شيء ما في الأسفل يغير كل شيء؟ يجيب عن كل الأسئلة، ويجعلك بطلًا قوميًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: لن نكتشف؟ هل تمزح؟ إنها ليست مجرد حفرة. أعلم أنك تشعر بذلك أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: إذن؟ ماذا تنتظر؟ هذا سبب وجودنا هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: هل تريد حقًا أن تقضي بقية حياتك تتساءل "ماذا لو" لأنك خفت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: هيا. أظهر بعض الشجاعة. اذهب وسأحمي ظهرك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: تريد أن تعرف ماذا يوجد هناك، أليس كذلك؟ لستَ جبانًا، أستطيع أن أرى ذلك. لقد نزلت إلى هنا ثلاث مرات حتى الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: يمكنني سحبك إلى الأعلى بذراع واحدة. ولكن إذا ذهبت أنا، مَن سيسحبني إلى الأعلى؟ إنه منطق بسيط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: مَن سيساعدني إذا سقطت، هاه؟ لا أقصد الإهانة، لكنني رأيت فئرانًا أكثر قوة منك. انزل أنت وسأبقى هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: ماذا لو لم نكتشف ما يوجد في الأسفل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: لماذا لا تنزل بنفسك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: أنت تشعر بذلك أيضًا، أليس كذلك؟ تلك الجاذبية... كأن الحفرة تناديك. أنت تسمعها، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: أي صديق آخر؟ اسمع، على أحدهم أن يتحرك. لا يمكنني البقاء هنا إلى الأبد. إما الآن أو أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: ماذا لو لم نكتشف ما يوجد في الأسفل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: لماذا لا تنزل بنفسك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: لكن لدينا متسع من الوقت. ربما نستكشف هذا المكان بأكمله. ألا يثير ذلك فضولك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: أوه، بالطبع. بالطبع هو كذلك. الحبل لا يزال مشدودًا، أترى؟ هذا يعني أنه في الأسفل، يعمل. لو حدث شيء ما، لكنت عرفت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: هل صديقك الآخر لا يزال مفقودًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: هل تعتقد أن صديقك لا يزال على قيد الحياة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: 'Miner: لكن تلك الحفرة... بصراحة، كم مرة انجذبت إليها بالفعل؟ إنها تجذبك، أليس كذلك؟ اعترف بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: 'Miner: أو ربما لجلوسي هنا لفترة طويلة جدًا، بالغت في تخيلاتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: أوه، هذا أنت. اعتقدت أنك تراجعت. لكن هناك شيء غريب. الضوء غريب، والحبل يبدو ثقيلًا بشكل غريب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: لا تبدو قويًا بما يكفي لحمل الأثقال، لكنني أستطيع رفعك دون أي مشكلة. ما رأيك أن تذهب لتلقي نظرة، وأنا... سأراقب المكان؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: رحلة استكشافية واحدة للأسفل وربما نكتشف الأمر. كنت سأذهب بنفسي، لكن... يجب أن يبقى أحدهم ليثبت الحبل، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: ماذا لو كانت الإجابات موجودة هناك؟ ليس كلها، بالطبع. لكن لماذا جاءوا، وماذا يريدون... فكر في الأمر!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: زوار؟ هذا ما كنا نقوله! نعتقد أن هذه الأنفاق تخصهم. وقد تكون تلك الحفرة بوابة ما لهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: علينا أن نبقى معًا. على أحدنا أن يكون مستعدًا لمساعدة الآخر!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: ليس لأنني خائف، ولكن... إنها تجذبك. لو كان بإمكاني أن ألقي نظرة أخرى... نظرة أقرب قليلًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: لكن أحيانًا عندما تقف بالقرب منها... تشعر وكأن شيئًا ما يناديك. جربها... صدقني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: اقتربت من ذلك، عندما كان رفاقي لا يزالون هنا. لكن هناك... الأمر أشبه بالتحديق في الهاوية. التحديق في العدم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: أود ذلك، لكن انظر... شدة واحدة خاطئة لهذا الحبل، وسينهار كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: نظرت؟ ... نوعًا ما. ليس بالضبط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: ألا تقلق من أن يكون قد حدث شيء لأصدقائك هناك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: هل نظرت إلى الحفرة بنفسك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: أترى؟ الحبل مشدود. هذا يعني أنه لا يزال يعمل في الأسفل. كنا سنعرف لو كان هناك خطب ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: الآخر مربوط بحبل. سيشد الحبل عندما يكون جاهزًا، أو إذا حدثت مشكلة ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: ماذا؟ أصدقائي؟ لا، إنهم بخير. أحدهم دخل عمق الحفرة، لكنه سيعود. إنه يعرف كيف يكتشف المخرج.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: ألا تقلق من أن يكون قد حدث شيء لأصدقائك هناك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: هل نظرت إلى الحفرة بنفسك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: يجدر بك أن تأكل شيئًا، وإلا ستصبح مثلي: جائعًا، ولا يرافقك سوى فانوس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: فقدت الإحساس بالوقت هنا. لا يوجد ضوء ولا ساعات. لا أعرف كم ساعة قد مرت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: ماذا تقول؟ تحدث بصوت أعلى! أنا جالس هنا منذ يومين، ربما ثلاثة أيام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: ألم يعد أصدقاؤك بعد؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: منذ متى وأنتم هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: عدت مرة أخرى؟ هاه؟ هل تتحدث بهدوء الآن، أم أنني أصبحت أصم بسبب ذلك الضجيج؟ حسنًا؟ تحدث!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: سأخبرك بالمزيد عندما تنزل إلى هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: حاولنا الحفر بالقرب منها وكاد أن ينهدم المكان بأكمله فوق رؤوسنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: اسمع، إذا كنت تفكر في المجيء إلى هنا... فابتعد عن تلك الحفرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: أحد رفاقي سمع شيئًا عن ذلك في مكان ما، وقال إنه علينا التحقق من ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: مجرد حفرة. لكن هناك أشياء غريبة تحدث حولها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: لا، لا يوجد شيء مثير للاهتمام حقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: حاولنا الحفر بالقرب منها وكاد أن ينهدم المكان بأكمله فوق رؤوسنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: اسمع، إذا كنت تفكر في المجيء إلى هنا... فابتعد عن تلك الحفرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: أحد رجالنا دخلها. بينما بقيت هنا، تحسبًا إذا احتاج إلى المساعدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: الحيوانات تصمت بالقرب منها. البوصلات لا تعمل. المصابيح الكهربائية لا تستطيع اختراق الظلام بداخلها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: هناك شيء ما يحدث بالقرب منها أيضًا. صوت طنين خافت جدًا، ولا يتوقف أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: هناك حفرة ما!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: هل أمسكتم بأحد الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: ما هو؟ شيء مثير للاهتمام؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: لكن اسمع، هذه الأنفاق ليست أغرب ما في الأمر. هناك شيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: لم أرَ أي شيء بعد، لذا لا أستطيع الجزم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: نعتقد أن الزوار يستخدمونها للتنقل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: لا ندري من حفر هذه الأنفاق أو سبب وجودها. لكن لدينا فكرة، وهذا مؤكد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: بالكاد بدأنا الحفر، وماذا وجدنا؟ نظام أنفاق كامل!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: مأوى! من الحرارة الحارقة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: هل أمسكتم بأحد الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: ما هو؟ شيء مثير للاهتمام؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: لكن انسَ ذلك، لأننا وجدنا شيئًا آخر!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: هذه الأنفاق عميقة. عميقة جدًا. لا أعرف أين تنتهي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: كان هناك المزيد منها في السابق. انهار بعضها مؤخرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: لقد بدأنا للتو في الحفر، وانظر إلى حظنا، لقد عثرنا على شبكة أنفاق كاملة تحت الأرض!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: أنا ورفاقي قررنا حفر بعض الأنفاق للاختباء من الحرارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: هل تبحث عن شيء ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: لماذا أنت بالأسفل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: التراب كثير جدًا في أذنيّ، لدرجة أنني أشعر وكأنك تتحدث من خلال وسادة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: عالق؟ لا! لقد عثرنا على شيء ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: هاه؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: هل تبحث عن شيء ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: لماذا أنت بالأسفل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: حسنًا، لنأمل ألا يسقط على رؤوسنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: نحن تحت منزلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: أذناي مليئتان بالغبار والسخام، لا أستطيع سماع أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: ماذا تقول؟ ارفع صوتك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: هل أنت عالق؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: ماذا تفعل تحت منزلي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: ...أعتقد ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: ماذا؟ مَن هناك؟ خيل لي أنني سمعت شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: أراك لاحقًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: أتمنى لك يومًا سعيدًا، وصحة جيدة، وسعادة غامرة، والكثير من الابتسامات يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: ضاع أملنا الوحيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: حسنًا إذن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: نعم
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: لذا دعني أسألك مرة أخرى يا عزيزي. هل ستأتي معي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: لا أعرف ما الذي ينتظرنا في أرض الفطر... لكن من المؤكد أننا سنكون في... خطر!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: نمر بأوقات عصيبة يا بني. نرقص بينما تنهار أرض الفطر. ربما سنسقط نحن أيضًا... ربما...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: أخشى أنني لا أستطيع القيام بذلك بمفردي. أحتاج إلى مساعدتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: يا عزيزي... هذا ليس في صالحنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: قبل أن تغلق بوابة أرض الفطر!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: يا إلهي! لقد تأخرنا! هيا بنا الآن! بسرعة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: منتصف الليل!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: انتظر لحظة واحدة. دعني أرى ساعتك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: اجمع أغراضك و...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: أوه! هذا ما أردت سماعه يا فتى...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: نعم
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: هل أنت مستعد للذهاب معي إلى أرض الفطر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: لا ينبغي لأي إنسان أن يذهب إلى هناك. أبدًا أبدًا أبدًا. لكننا يجب أن نفعل ذلك إذا أردنا إيقاف المهرجان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: إذا لم نتحرك الآن، فقد نفقد كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: لن نرى المهرجان هناك... لكن النباتات الأخرى... الفطريات...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: إنها ليست أرض الشمس المشرقة وقوس قزح. لا، لا، لا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: قد يبدو الاسم مبهجًا في لغتنا... ولكن في لغة الفطر، فإنه يعني شيئًا مختلفًا تمامًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: لا تدع الاسم يخدعك، يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: لا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: نعم
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: هل أنت مستعد للذهاب معي إلى أرض الفطر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: يجب إيقاف المهرجان، مهما كان الثمن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: وفي الحقيقة... سيكون ذلك أفضل. لكن للأسف، ليس لدينا خيار آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: أوه، أنت مخطئ يا عزيزي! إنه مكان مخيف لم يسبق لأحد أن ذهب إليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: تبدو فكرة مقبولة...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: أرض الفطر؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: لم أكن أرغب في القيام بذلك، ولكن... أعتقد أننا سنضطر إلى الذهاب إلى أرض الفطر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: مما يعني أن عالم الفطريات سيكون في مأزق كبير!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: لماذا؟ المهرجان سيجعل الفطر ينمو بشكل عشوائي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: تبدو فكرة مقبولة...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: أرض الفطر؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: لم أكن أرغب في القيام بذلك، ولكن... أعتقد أننا سنضطر إلى الذهاب إلى أرض الفطر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: لكن في الآونة الأخيرة، كان هناك الكثير من الشر، حتى أن الفطر نما بشكل لا حدود له.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: الفطر يشبه الكبد، فهو يحاول تطهير الجسم من السموم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: عندما يتراكم الكثير من الشر في أعماقه، فإنه... يعرقل كل شيء يفعله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: شيء ما قد جن جنونه داخل عالم الفطريات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: لماذا سيقام المهرجان؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: لماذا لم ينجح الأمر؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: هناك الكثير من الفوضى داخل الفطريات لدرجة أن الطقوس... لم تنجح...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: يبدو أن المهرجان سيقام في جميع الأحوال...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: هذا ليس وداعًا يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: لكن تذكر أن الفطر ليس دائمًا كما يبدو.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: سنحرص على أن يظل الفطر صغيرًا، ونمنع المهرجان من أن يبدأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: سأعود عندما يحين الوقت المناسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: الفطريات هي العقل المدبر هنا. يؤسفني أنني لا أستطيع سوى الاستماع إليها... فهي لا تفهم لغتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: إنها مجرد جزء من شبكة الفطر! للأسف!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: فكرة رائعة... لكنني لا أستطيع التحدث إلى الفطر بهذه البساطة. لا، لا، لا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: هذا ليس وداعًا يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: لكن تذكر أن الفطر ليس دائمًا كما يبدو.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: سنحرص على أن يظل الفطر صغيرًا، ونمنع المهرجان من أن يبدأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: سأعود عندما يحين الوقت المناسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: وهذا بالضبط ما فعلناه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: لكن كتاب الابتسامات أظهر لنا طريقة لتهدئة جذورها ونموها المضطرب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: لا يمكننا التحدث إلى الفطر مباشرة، لا لا لا! لسنا جزءًا من الفطريات!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: لقد أجرينا طقسًا قديمًا، يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: ألا يمكنك أن تطلب من الفطر ألا يبدأ المهرجان؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: كيف توقف أفعالنا المهرجان بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: كل ما يمكننا فعله الآن هو الانتظار والأمل في أن يكون ما فعلناه كافيًا لمنع نمو الفطر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: يا عزيزي... أتمنى لو كان الأمر بهذه البساطة. ما زلنا لا نعرف ما إذا كان ما فعلناه قد أثر حقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: ألا يمكنك أن تطلب من الفطر ألا يبدأ المهرجان؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: كيف يمكن لأفعالنا أن توقف المهرجان؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: الفطر ينمو بسرعة كبيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: إنها تعرف الكثير من الأشياء. ولكنها الآن في خطر... مثلنا جميعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: لماذا! الفطريات أخبرتني بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: لا تبدو مقتنعًا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: كيف لك أن تعرف؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: آمل أن يكون ذلك كافيًا لإيقاف المهرجان...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: ها أنت ذا مرة أخرى، يا بني! أنا سعيد لأنك فعلت كل ما طلبه منك كتاب الابتسامات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: ربما أضيع وقتي الثمين معكم أيها الشباب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: لكن لماذا؟ إنها مجرد جزء صغير من الكتاب... وأنا أحفظها عن ظهر قلب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: أتمنى لك يومًا سعيدًا، وصحة جيدة، وسعادة غامرة، والكثير من الابتسامات يا عزيزي. إلى اللقاء!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: سأعود بمجرد أن تنتهي من ترتيب كل شيء! لذا أسرع!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: حسنًا... يجب أن أرحل الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: أنت فتى طيب. اقرأها عندما يسنح لك الوقت، حسنًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: احتفظ بها
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: حسنًا، سآخذ الصفحات المهمة من كتاب الابتسامات
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: لقد مزقت بعض الصفحات من كتاب الابتسامات. خذها أرجوك. ستخبرك بما عليك فعله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: يا إلهي! لا يمكننا السماح بحدوث ذلك. يجب أن نوقفه... معًا يا بني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: لكن هذا الفطر لن ينمو بمفرده. لأنه "مهرجان"، كما هو معروف!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: وسينشر ظلاله ويبتلع الشمس... ولن يُحرم أي مكان من المرح الذي يجلبه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: سينمو فطر كبير... وينثر جراثيمه في كل مكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: يجب أن نرجع إلى كتاب الابتسامات لمعرفة ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: يا عزيزي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: احتفظ بها
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: حسنًا، سآخذ الصفحات المهمة من كتاب الابتسامات
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: لذلك مزّقت الصفحات الأكثر أهمية. خذ يا بني. تفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: لكنني أخشى ألا يكون لدينا وقت لقراءته كاملًا. إنه ضخم... والوقت يداهمنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: إنه كتاب مميز — بل إنه الأكثر تميزًا في العالم. سيخبرك بما يجب فعله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: مهرجان الفطر؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: كتاب الابتسامات؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: الآن، انظر هنا... لديّ شيء سيساعدنا: كتاب الابتسامات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: آها! كل شيء سيتضح قريبًا. وتذكر، يجب أن نوقف المهرجان... مهما كان الثمن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: مهرجان الفطر؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: كتاب الابتسامات؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: تحدثت عن اقتراب مهرجان الفطر... وهذا، يا عزيزي، ليس جيدًا على الإطلاق. لا، لا، لا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: تعلمت سماعها من خلال دراسة كتاب الابتسامات. لكن ما أخبرتني به مؤخرًا... ليس مبشرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: تمتلك الفطريات لغة معينة للتواصل فيما بينها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: نعم، نعم، أعلم أنه من الصعب على الناس العاديين أن يفهموا كلامها. إنها تتحدث بطريقتها الغريبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: لا أفهم قصدك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: الفطريات؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: لذا استمع جيدًا يا عزيزي. لدينا الكثير من العمل لنقوم به، والوقت المتاح لنا قليل!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: طريقة كلامها صعبة، لكنني تعلمت كيف أفهم الإشارات التي ترسلها، نعم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: أوهو! بالطبع أعرف مَن أنت! الفطريات أخبرتني!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: لا أفهم قصدك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: الفطريات؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: لذا، أرجوك، استمع وانتبه جيدًا إلى كلامي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: مهرجان الفطر على الأبواب! والوقت، يا عزيزي، ينفد منا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: لكن هذا لا يهم الآن. لقد أخبرتني الفطريات بشيء مقلق للغاية، نعم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: أوهوهوهو! أنا مجرد عجوز يعرف بعض المعلومات عن الفطر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: هل تعرفني؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: مَن أنت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: مرحبًا يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: أُنجز المطلوب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: سأغادر ممتنًا لك، بغض النظر عن أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: أو لعلك لا تسعى للسلام في نهاية المطاف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: هل كانوا يزعجونك حقًا إلى هذا الحد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: سآخذهم معي. مع خالص الامتنان، بغض النظر عن أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: حسنًا... لقد فعلت ما يكفي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: هذه ليست حضانة
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: دعني وشأني
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: ليس لدينا خيار سوى الاستمرار في مناشدته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: لكن الموت نفسه... قد يخلصنا من أسوأ مصير على الإطلاق: الفراغ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: أما دورة البعث، فما هي سوى عذاب سرمدي تقطعه فترات راحة عابرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: لا نؤمن بحياة أخرى بعد التي نعيشها الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: ومع ذلك، فإن فكرة العيش في العدم الأبدي ترعبنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: ما يهم حقًا هو أننا جميعًا متعبون.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: لا يهم إذا لم نفهم تمامًا ما نستدعيه هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: اقترب يوم قدومه... أستطيع أن أشعر بذلك، نعم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: هذه ليست حضانة
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: دعني وشأني
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: إذن ما قصة "الموت" الذي تتحدث عنه؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: خذ مجانينك معك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: طابت ليلتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: أتعلم... إذا اختارك الموت، فسأساعده بكل سرور في الاقتراب منك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: هذا هو سبب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: هل غادروا هذا العالم الفاني...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: إذن ما قصة "الموت" الذي تتحدث عنه؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: خذ مجانينك معك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: لن أبقى طويلًا. سأغادر الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: نعم. كل شيء كما ينبغي أن يكون. نظراته لا تزال تراقبنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: ارحل عن هنا. أنا مشغول
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: جماعتك بخير
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: أوه، لكن كل شيء على ما يرام معك، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: هكذا ينتهي العالم إذن. ليس بانفجار... بل بهمسات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: لم يعد الموت يتحدث إليّ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: أنت... أنت حرمتنا من فرصتنا الوحيدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: هل مات جميعهم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: مهلًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: أنا نفسي لست متأكدًا بعد مما يعنيه ذلك... لكنه يبدو عرضًا مغريًا، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: قد يضمن لك مكانًا للاختباء. من كل شيء... حتى من نهاية العالم نفسها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: تحدث الموت إليّ منذ وقت قصير. ويأمل أن يلتقي بك عندما يحين الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: أنا متأكد من أنك متعب أيضًا... من كل هذا الضجيج، وهذه الأوقات الصعبة، والارتباك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: شكرًا على كل ما فعلته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: لا يهمني. أواجه مشكلات تخصني
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: ما زالوا على قيد الحياة
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: دعنا لا نضيع الوقت. كيف حال أتباعي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: أراك لاحقًا. سآتي لأطمئن عليهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: لن يحتاجوا إلى الكثير من الوقت. لكن مع ذلك، اعتنِ بهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: لا أعتقد أن الأمر سيستغرق وقتًا طويلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: لذا ربما عليك... أن تدعهم يبقون، نعم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: إلى أين ستهرب؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: حتى لو نجوت من الحريق، فلن تُكتب النجاة لمنزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: سيأتي آخرون من بعدنا وأنت نائم، وسيسكبون البنزين على الجدران ويشعلون منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: هل تعتقد أننا القلة الوحيدة التي تحمل شعلة اعتقادنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: لا أحب نبرة التهديد، لكن لا بأس، سأساعدكم
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: سأطلق النار عليكم جميعًا إذن
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: للأسف... لا توجد طريقة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: لسوء الحظ، فشل خطتنا هنا يعني أن بيتك سيدفع الثمن... وسيكون باهظًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: ولكن أكثر من ذلك... سيضيع هدفنا من أيدينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: اعتنِ بأتباعي. وتذكر، إذا مات أحدهم... فسيتحول منزلك إلى رماد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: ألا تتوق إلى السلام؟ عالم لا يكون فيه أحد عبئًا على الآخر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: إنها مهمة صعبة. الطريق إلى الهدف الأسمى ليس سهلًا أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: لا أحب نبرة التهديد، لكن لا بأس، سأساعدكم
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: سأطلق النار عليكم جميعًا إذن
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: سامحني، لكن ليس هناك طريقة أخرى لإنجاز مهمتنا المقدسة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: إذا حدث ذلك، فسنحرق بيتك حتى يصبح رمادًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: تجاوز هذا الحد، وسيكون كل شيء بلا جدوى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: اعتنِ بأتباعي. وتذكر، إذا مات أحدهم... فسيتحول منزلك إلى رماد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: ربما سينتهي بك المطاف محروقًا في النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: يبدو هذا أمرًا صعبًا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: لستُ متحمسًا لهذا الاحتمال
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: سيقومون بإجراء طقوس الجنازة. ما عليك سوى ضمان سلامتهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: لكن إخوتي بحاجة إلى مأوى. الموت يقترب من هذا المكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: لا داعي لدخولي. مهمتي نشر الحقيقة المقدسة التي تجلب السلام الأبدي وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: يبدو هذا أمرًا صعبًا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: لستُ متحمسًا لهذا الاحتمال
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: يجب أن يعيشوا طويلًا بما يكفي لإنجاز مهامهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: على أي حال، دع إخوتي يدخلون هذا المكان. احمِهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: ما الذي حدث هنا، على أي حال؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: تأثير الموت قوي هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: منزلك مثالي لذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: يجب أن نؤدي طقوس الدفن. بطرق جديدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: هل تريد أن تدخل أم ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: إذن ماذا تريد؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: إنه قريب بالفعل. ونحن نساعده على الاقتراب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: نحن لا نؤمن بالخلاص. إلا إذا جاء من الموت نفسه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: هذا هو كفن جثتي. سنحتاج إليه بعد وفاتي. بهذه الطريقة، لن نحتاج إلى البحث عن قماش لتكفين موتانا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: ربما أريد ذلك. هل هذا أمر سيئ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: هل تريد أن تدخل أم ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: إذن ماذا تريد؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: إنها الطريقة الوحيدة للخلاص... لا مجال للتراجع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: ونحن نساعده ببساطة على الاقتراب أكثر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: الموت قد حان. إنه يرغب فقط في إراحة البشرية — لتحريرنا من الفوضى والمرارة والاضطراب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: نحن أصحاب عقيدة جديدة — خطباء عقيدة مقدسة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: تبدو كأحد أتباع طائفة غريبة
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: مَن أنت؟ ولماذا ترتدي هذه الملابس؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: الموت قد أعجب بك، نعم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: بعضهم مات محروقًا. وبعضهم تم اعتقالهم وإعدامهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: الموت يحيط بنا من كل جانب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: هذا صحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: تبدو كأحد أتباع طائفة غريبة
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: مَن أنت؟ ولماذا ترتدي هذه الملابس؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: لا أعرف عدد الذين ماتوا هنا... لكن وجوده قوي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: الموت قد أعجب بمنزلك. إنه معجب به للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: ...الموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: نعم، وهو ملكي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: ما الذي تشعر برائحته بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: أشعر برائحته هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: عظيم. منزلك رائع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: تفضل. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: لماذا قد يعتقد هذا الأحمق أن مندوب توصيل عادي خطير؟ لماذا يقتله؟ لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: فقد الناس عقولهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: ذهب لتسليم طلبية، وصاحب المنزل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: لقد قتلوا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: ماذا حدث لك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: مندوب التوصيل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: طابت ليلتك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: وماذا لو احمرت عيناي من قلة النوم؟ هل سيقومون بسحبي إلى إحدى مناطق الحجر الصحي اللعينة تلك أيضًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: ثم اقتادوه بعيدًا. الآن لا أعرف حتى ماذا حدث له. أو ما إذا كانوا سيفرجون عنه يومًا ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: حدث هذا أثناء الفحص الصباحي، كالعادة. ولكن لاحظوا أن عينيه. حمراوان... اللعنة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: اعتقلت الوكالة الفيدرالية زميلي في العمل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: تبدو حزينًا بعض الشيء
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: مرحبًا... أنا مندوب التوصيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: طابت ليلتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: على الأقل هنا يمكنني أن أشغل نفسي وألا أفكر في كل هذه الفوضى...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: ماذا كان عليّ أن أفعل غير ذلك؟ أجلس في المنزل وأتعفن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: أوه، تقصد كيف انتهى بي الأمر بالعمل في خضم الكارثة الكبرى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: اجتزت الفحوصات. فحصوا جميع العلامات، وقرروا أنني بشري و...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: كيف أصبحت ساعي توصيل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: مرحبًا، هذه خدمة التوصيل إلى المنازل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: ما زلت غير معتاد على ذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: طاب يومك... أو بالأحرى، طابت ليلتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: لم أعتقد أن عمليات التوصيل لا تزال مستمرة
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: مرحبًا، هذه خدمة التوصيل إلى المنازل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: من الصعب العيش من دون أحلام. هذا أمر صعب على أي شخص.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: آمل ذلك بالتأكيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: هل تعتقد أن الناس سيحلمون مرة أخرى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: ولكن إذا حلم شخص آخر في هذا المنزل، فسيكون ذلك رائعًا أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: شكرًا. سأحاول النوم هنا، على الرغم من أنني لن أستطيع على الأرجح أن أرتاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: ادخل إذن.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: ربما لو نمت، سأحلم في يوم ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: لم أنم منذ ستة أيام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: تصعب معرفة ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: ادخل إذن.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: أعتقد أن السبب هو أنها فقدت ذلك الاعتقاد الراسخ لدى الناس. وفقدت ذلك الوقت المخصص للراحة والتأمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: لكن الآن؟ الأحلام تتلاشى. وتفقد ماهيتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: الأحلام هي المكان الذي نبحث فيه عن الإجابات، ونجد الراحة... أو نبحث ببساطة عن لحظة هدوء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: الأحلام... أوقات حساسة وغريبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: هل تحلم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: لماذا تهتم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: أتساءل... هل الشمس هي السبب؟ أم أن هناك سببًا آخر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: أنت مثل الآخرين. حتى عندما يصابون بالحمى... لا يهلوسون بأي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: ها أنت ذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: هل تحلم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: لماذا تهتم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: ما سبب ذلك في رأيك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: لا يحلم الناس كثيرًا الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: أتعرف ما الذي أدركته؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: تعرف ما هي الأحلام. عندما تنام... هل ترى أي شيء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: ليس بالضبط
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: هل تحلم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: ...وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: لا أعرف حتى لماذا أحتفظ بها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: أعتقد أن هذه البدلة مخيفة بعض الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: مهلًا... لم نتعرف على بعضنا بشكل صحيح. نعم، أفهم ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: ماذا؟ شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: لم أعتقد أنك ستسمح لي بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: هل يمكنني الجلوس في أي مكان؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: ماذا؟ شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: أعني البرمجة، وكتابة الأكواد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: انتهى بي الحال إلى عدم فعل أي شيء مما وعدوا به.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: ...ثم جاءت خيبة الأمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: كانت لديّ وظيفة. اعتقدت أن الأمور ستكون على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: هذا سؤال رائع. في الوقت الحالي أشعر... بالضياع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: لقد استنفدت طاقتي واستقلت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: تراكمت الأعمال عليّ. ولم يتبق عدد كافٍ من الموظفين. لذا لم نتمكن من مواكبة العمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: و... لم أعد أعمل هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: كنت أعمل في صناعة الثلاجات، وإصلاحها أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: مجرد عامل عادي في إحدى المصانع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: ما هي خطتك إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: مَن أنت إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: من يدري ما الذي يحدث بالفعل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: يأخذون الناس بعيدًا... ولا يعودون أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: لسبب... لا أعلمه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: مما رأيت، الجميع يكره الوكالة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: أوه! لا، أنا لا أعمل لصالح الوكالة الفيدرالية. هل هذا بسبب الزي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: لا أفهم قصدك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: هممم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: ما هي خطتك إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: مَن أنت إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: ربما تبعث الشمس إشعاعات في الليل أو شيء من هذا القبيل؟ لا أريد حتى أن أعرف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: اعتقدت أنني قد أكون أكثر أمانًا هنا بهذه الطريقة. لا بد أن هناك سببًا لارتداء هذه الأشياء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: لا، لقد أخذتها من جثة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: أوه... هل تعتقد أنني أعمل لصالح الوكالة الفيدرالية؟ بسبب البدلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: أخذتهم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: هل أتيت لأجلي هذه المرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: أعد من أخذتهم أولًا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: هل يمكنك السماح بدخولي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: سمعت صوت خطوات... هذا يعني أن هناك أحدًا خلف الباب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: مرحبًا؟ هل من أحد هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: سأحفر حفرة عميقة ولن أغادرها أبدًا مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: سمعت قصصًا... شخص ما يخرج، ثم يعود إلى المنزل، وفجأة... ينتهي كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: ثم يأتي الزوار ويطرقون بابك... أو الأسوأ من ذلك... يكونون بالفعل في الداخل، ينتظرونك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: تعود إلى المنزل، وتجده فارغًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: تكسر ظهرك بالحفر طوال اليوم، كل يوم، طوال حياتك اللعينة. وما المقابل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: لماذا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: لكن أسرع في إغلاق الباب، حسنًا؟ أنا خائف جدًا من أن يكون الزوار ورائي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: شكـ-شكرًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: على أي حال، قررت الاستقالة. تبًا لهذا العمل. لقد اكتفيت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: ليت المشاكل تغذينا، كما نغذيها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: الشمس ستحرق الجثث على أي حال، والليل... أقصر من أن نتعامل فيه مع الموتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: لم يعد أحد يأتيني بالجثث لدفنها على أي حال. لقد فقد الناس اهتمامهم بتوديع الموتى بكرامة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: وظيفتي لم تعد تساوي شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: ركضت بسرعة البرق ولم أنظر إلى الوراء. لم أجرؤ على العودة إلى المنزل. اعتقدت أنني سأكون أكثر أمانًا وسط حشود الناس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: لقد كان زائرًا، يزحف من تحت الأرض! وذلك الرجل؟ كان يضحك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: اعتقدت أنها صخرة، لكن لا، كانت يدًا تخرج من التربة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: كنت أحفر وأحفر ثم... فجأة! اصطدمت المجرفة بشيء ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: كان يقف يراقبني وأنا أعمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: بالتأكيد، الكثير من الأمور الفظيعة. كنت أحفر قبرًا طلبه أحدهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: هل تركت عملك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: هل رأيت شيئًا معينًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: إنهم يتركون الجثث حيث سقطت. فالشمس ستحرقها على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: الناس يموتون كالذباب مؤخرًا، لكن لا أحد موجود لدفنه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: لن تصدق ما رأيته وأنا أحفر الحفرة الأخيرة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: آسف على كل هذا الضجيج. الأمر هو...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: هل تركت عملك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: هل رأيت شيئًا معينًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: القبور لم تعد تعني شيئًا. الناس يسقطون أمواتًا ويتعفنون في المكان الذي يسقطون فيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: لعلمك، كنت أعمل حفار قبور، وللأسف لم يعد لتلك الوظيفة أي معنى الآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: أنا نفسي لم أنم قط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: لا داعي للغضب، لم أقصد إيقاظك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: لماذا لا تقرع على رأسك بدلًا من ذلك!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: لا تقرع بابي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: هل تمانع أن تدعني أدخل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: مرحبًا؟ هل من أحد على قيد الحياة هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: حسنًا إذن. أعتقد أنني سأرحل أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: هل... رحلت بالفعل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: أنا مجرد عابر سبيل. لن أبقى. أعدك بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: لا تعرف إذا كانت أي من هذه المنازل القريبة فارغة، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: لا بأس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: لن تجد واحدة منها مملة، أعدك بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: تعال وتحدث معي في أي وقت. لديّ قصص مثيرة لأرويها. في الواقع، لديّ مئات القصص.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: رائع! حان الوقت أخيرًا لأستلقي وأستريح كأي شخص عادي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: على أي حال... إذا كنت تعيش هنا، هل يمكنني المبيت عندك الليلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: كانت هناك مرة واحدة لم يكن لديّ خيار. لكنها قصة طويلة. يمكنني أن أخبرك بها لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: اسمع، لستُ قديسًا، لكن هناك حدودًا لا أتجاوزها. لا أؤذي على أي أحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: ماذا، هل تعتقد أنني مجرم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: لديّ قصص مثيرة. لقد رأيت الكثير من الأشياء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: لا أقصد الإساءة. ولكن بما أنك تعيش هنا... هل يمكن أن أبقى هنا لفترة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: لكن نعم... كنت على وشك سرقة منزلك. اعتقدت أنه فارغ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: كانت هناك لحظة كدت فيها أتوقف عن فعل ذلك نهائيًا... تقريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: آخذ ما أستطيع. أبيع بعضه وأحتفظ بالباقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: هممف. لا فائدة من الكذب. أسرق المنازل المهجورة. والشقق الفارغة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: هل تسرق الناس؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: كيف نجوت وحدك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: الوحدة بدأت تؤثر عليّ. أشعر أنني سأجن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: لكن بصراحة، سئمت ذلك. سئمت التحدث إلى نفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: في البداية اعتقدت أن ذلك أكثر أمانًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: منذ أن خرج الزوار من المكان الذي أتوا منه... وأنا وحيد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: بالطبع، ولمَ لا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: هل تسرق الناس؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: كيف نجوت وحدك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: لا... لم أنسجم إطلاقًا مع أي مجموعة بشر... لذا، أعيش الآن وحيدًا هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: المشكلة هي أنني رأيت ما يستطيع الناس فعله حقًا. وأنا لست حتى قريبًا من أن أكون الأسوأ بينهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: وكأنني أقل منهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: من سيود أن يرافقني؟ يضعني الناس في فئة حثالة المجتمع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: هل تعتقد أن هذه فكرة سديدة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: لماذا أنت وحدك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: اسمع، أتمانع إن بقيت هنا لفترة؟ مر وقت طويل منذ أن جلست مع أناس مثلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: لكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: آسف. اعتقدت أن المكان فارغ. سأرحل عن هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: اللعنة... هل يعيش أحد هنا بالفعل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: طاب يومك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: ...وهذا، بالمناسبة، يتعارض مع المادة 119 من الدستور. وصدقني، هذا لن يكون في صالحك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: قد ترغب في إعادة النظر في نبرة صوتك. يمكنني تفسير ذلك على أنه تهديد لحياتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: ماذا؟ هل قلت للتو إن عليّ أن أغادر؟ هل كان ذلك تهديدًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: يمكننا مناقشة شروط الإيجار بالتفصيل لاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: شكرًا لك يا صاحب المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: إما أن أدفع، أو لن أخطو خطوة واحدة إلى داخل منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: هذا غير لائق. والأسوأ من ذلك أنه غير قانوني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: أعتذر، لكن ضميري الحي يمنعني أن أقيم تحت سقفك دون دفع الإيجار المستحق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: حسنًا. سنسوي هذا الأمر بشكل صحيح لاحقًا — بعقد قانوني كامل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: هذا غير معقول... أن تعتقد أن أحد أعضاء مؤسسة تأجير محترمة سيرفض مبلغًا كبيرًا من المال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: أستمحيك عذرًا؟ هل أبدو وكأنني بحاجة إلى صدقة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: لا أحتاج إلى أموالك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: ادفع ما تريد، إذا كنت تشعر أنك مضطر لذلك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: أنا آسف، لكنني أرفض شغل أي مساحة قيّمة دون دفع إيجار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: عفوًا؟ هل قلت للتو "أسمح للناس بالدخول وحسب"؟ هل أنت متطوع؟ هل تدير مأوى للمشردين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: لا أحتاج إلى أموالك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: ادفع ما تريد، إذا كنت تشعر أنك مضطر لذلك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: بالمناسبة... بدلًا من توقيع عقد رسمي، ما سعر الليلة الواحدة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: حسنًا، لا بأس. أعتقد أنه يمكننا إبرام الاتفاق في وقت لاحق. مع تحديد تاريخ ملائم، بالطبع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: هممم... جواب غامض بعض الشيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: أسمح للناس بالدخول وحسب
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: شيء من هذا القبيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: طاب يومك يا صاحب المنزل. هل تؤجر غرفًا هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: لستَ أفضل من أولئك الأوغاد في الوكالة الفيدرالية. أتمنى أن تموت وتتعفن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: اللعنة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: نعم، لقد أصبت بالذعر، بالتأكيد، لكن هذا ليس سببًا لطردي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: بحقك يا صديقي... لا تفعل بي هكذا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: سيختطفونك في لمح البصر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: تذكر: لا تثق في هؤلاء الأوغاد الذين يرتدون الزي الأصفر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: شكرًا يا صاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: لذلك هربت. ولا أستطيع حتى العودة إلى المنزل الآن. أراهن أن هؤلاء الأوغاد الماكرين ينتظرونني بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: أرادوا أن يأخذوني معه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: ولم أتردد لحظة، فأخذته إلى الوكالة الفيدرالية. وكان خطأ فادحًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: لمحت في المرآة الخلفية تلك الأسنان البيضاء اللامعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: لقد كان زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: لستُ مجنونًا أو ما شابه، ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: ثم ضربت واحدًا منهم بزجاجة كنت قد خبأتها في معطفي، ثم هربت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: أخرجوني من السيارة، وتبين أنهم يريدونني أيضًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: في البداية، أشادوا بي قائلين: "أحسنت يا مواطن. ساعدنا لنساعدك!". إلخ إلخ... ولكن بعد ذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: لذلك قمت بتسليمه إلى عملاء الوكالة الفيدرالية. ولم يكونوا مستعدين للسماح له بالرحيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: كنت أقود سيارتي، لكنني لاحظت أن أسنان الراكب بيضاء للغاية. ناصعة البياض، أتفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: أولئك الأوغاد من الوكالة الفيدرالية سرقوا سيارتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: ماذا حدث لراكبك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: ماذا حدث لسيارتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: ليس لأنني غبي. لكن لأنني وثقت بالشخص الخطأ، أتفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: لقد فقدتها نوعًا ما بسبب غبائي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: حسنًا، لن أطيل عليك... لقد ضاعت مني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: ماذا حدث لراكبك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: ماذا حدث لسيارتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: رحل... ورحلت سيارتي معه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: تعرف كيف تسير الأمور. اتضح أنه لم يكن الشخص الذي ادعى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: كنت أقود سيارتي بهذا الراكب، ثم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: من أين أبدأ؟ أنا سائق سيارة أجرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: فيمَ تحتاج إلى مساعدة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: ماذا حدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: اسمع، أنا في مأزق كبير الآن. أتمانع إذا... بقيت هنا لفترة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: أهلًا يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: سأجد ملاذًا آمنًا في مكان ما. لكن أرجوك... لا تتخلص من جثتي عندما يحين أجلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: سأنتظر الموت ليضمني إلى حضنه الدافئ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: هل تمانع إذا بقيت بالقرب منك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: احتفظ بجثتي عندما يحين وقتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: لا أعرف بعد إن كنت ترى الجمال كما أراه. لكن أخبرني... هل ترمي الجثث في جنح الليل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: منزلك أكثر هدوءًا من أي مكان آخر زرته من قبل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: هنا سأمر إلى ذلك العالم النهائي المجهول وأندمج فيه. وسأرحل عن هذا العالم بهدوء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: لهذا جئت إليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: لا، لست بحاجة إلى مثل هذا العطف. بطريقة ما... أشعر أن المصير المحتوم مقبول هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: هل تعتقد أن ذلك سيساعد في تخفيف حدة الإنتان؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: الآن أقف هنا أمامك. وحيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: حتى جاء الآخرون. و... أعتقد أنك تستطيع تخمين الباقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: وتغيرت... يومًا بعد يوم، تغيرت شيئًا فشيئًا. وكان ذلك جميلًا للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: كنت أعيش مع فتاة أحببتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: سؤال وجيه. في الوقت الحالي... سأقول التالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: هل ينبغي أن نقطع ذراعك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: كيف أصبت بالغرغرينا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: لا أنتمي إلى حالة الذعر السائدة؛ أعيش حياتي بطريقة مختلفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: قصة كقصتي لا يقوى أحد على تحملها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: كل صباح، أستلقي وأتساءل عما إذا كنت سأعيش لليوم التالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: سأظل أرتجف في كلتا الحالتين، للأسف. إنه التعفن الموجود في ذراعي، كما ترى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: حرارة أبدية. لم تعد الشوارع تبرد مع حلول الليل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: أنا أرتجف، حتى في ذروة حرارة المدينة الصاخبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: الصمت... الفراغ... المكان هادئ للغاية هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: هل ينبغي أن نقطع ذراعك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: كيف أصبت بالغرغرينا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: أود أن أموت هنا. ببطء. بهدوء. لأستمتع بتلك اللحظات الأخيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: رجل يبحث يائسًا عن فرصة للنجاة. لكن هنا... أراك تتصالح مع ما سيحدث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: ضجيج المدينة يخنقني. كل هذا الصخب، والزعر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: قصة كقصتي لا يقوى أحد على تحملها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: كل صباح، أستلقي وأتساءل عما إذا كنت سأعيش لليوم التالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: أشعر بتوعك شديد. ولا أتحدث فقط عن الغرغرينا، للأسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: ما الجميل في هذا المكان؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: لماذا لم تبقَ في المنزل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: كنت آمل أن أتمكن من إقناعك بالسماح بدخولي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: المكان هنا أكثر هدوءًا. في المدينة، كل شيء صاخب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: مرحبًا. منزلك جميل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (تمر لحظة، ثم يستدير ويبتعد)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (صراخك يفاجئه)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: ارحل عن هنا!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (يظل واقفًا مكانه، يتمتم)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (يومئ برأسه ويدخل)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: ارحل الآن
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (لا يمكنك أن تكون متأكدًا، لكن خديه يبدوان مبللين بالدموع)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: (يظل واقفًا مكانه، يحدق من خلال ثقب الباب)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: ارحل الآن
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (لا يمكنك أن تكون متأكدًا، لكن خديه يبدوان مبللين بالدموع)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (يتمتم بشيء ما بينما يلوح بذراعيه)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: ماذا أفعل معك إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: هل خيّط أحدهم فمك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: (يتمتم مرة أخرى، لكن لا يمكنك فهم أي شيء مما يقوله)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (حاجباه يرتفعان من القلق)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: ماذا أفعل معك إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: هل خيّط أحدهم فمك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (يبدو أنه غير قادر على الإجابة)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (ينظر الرجل إليك وحاجبيه مرفوعين)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: ما خطبك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: هممممف!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: همممف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: سأكون في الجوار، فلا تتردد في طلب المساعدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: أفهم أن من الصعب الوثوق بأي شخص في هذه الأوقات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: شكرًا. آمل أن أتمكن من مساعدة الناس هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: إذا تكرّمت بالسماح لي بالدخول، فسأخبرك بكل شيء عن ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: إنها قصة طويلة نوعًا ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: كان هناك مستشفى في وسط المدينة. لكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: إذا سمحت لي بالدخول، يمكنني أن أخبرك بما حدث للمستشفيات.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: والآن... لم تعد المستشفيات موجودة. لذا، أتجول وأقدم المساعدة حيثما أستطيع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: كانت ميزانية قسمنا دائمًا محدودة، لذا كنت غالبًا ما أضطر إلى معالجة مرضى يعانون من أمراض خارج نطاق تخصصي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: أنا جراح. كنت أجري عمليات جراحية للمرضى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: من أين أتيت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: مَن أنت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: لكن الباب كان مغلقًا، فقررت أنه من الأدب أن أطرق الباب قبل أن أكسره.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: ونظرًا للهدوء الشديد، لم أعتقد أن أحدًا يعيش هنا. لذا قلت في نفسي، سألقي نظرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: الأمان... وربما إذا حالفني الحظ، بعض المحادثات لتخفيف الملل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: أبحث عن الشيء ذاته الذي يبحث عنه الجميع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: لماذا تسأل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: من أين أتيت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: مَن أنت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: ...أو صراخهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: ...أو بكائهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: عادة يمكنك سماع نوع من صراخ السكارى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: من النادر أن يظل منزل بأكمله صامتًا في الليل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: ماذا؟ لا، لا، لا هذا ليس صحيحًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: هل تبحث عن شيء ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: هل كنت تراقب المنزل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: مساء الخير! هل يمكنني الدخول؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: الليل هادئ جدًا هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: أوه، ظننت أنه لا يوجد أحد في المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: توقع أن تراني مرة أخرى يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: آه... هذا قرارك النهائي، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: القوة هي الأساس الآن يا عزيزي. يمكنك إما أن تتماشى مع هذا المبدأ، أو سيلتهمك الأقوى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: أحسنت،'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: المهم أنني لست هنا لإثارة المشاكل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: ما لا تعرفه لا يمكن أن يؤذيك. لم أسألك كيف نجوت حتى الآن، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: انظروا إلى الفتى الشجاع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: أما أنت؟ ما زلت تحافظ على النظام هنا. هذا أمر نادر يا عزيزي. وأود أنا أرى كيف تحافظ عليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: أرى الشيء ذاته في كل مكان أذهب إليه. الخوف يعمي الناس عن رؤية الصورة الأشمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: لم أبق في أي منها لفترة طويلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: كيف نجوت كل هذه المدة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: كم عدد المنازل التي مررت بها؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: أي شخص يقول عكس ذلك سيكون ميتًا بحلول الصباح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: هذا هو النظام العالمي الجديد: البقاء للأقوى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: إذا واصلت إنكار ذلك، فسيأكلونك حيًا. لن يتركوا حتى عظامك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: كلنا حيوانات يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: كيف نجوت كل هذه المدة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: كم عدد المنازل التي مررت بها؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: الأمر أصبح أبسط الآن. اقتل مَن تشاء وستكون الرابح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: كل قواعدكم وأخلاقكم قد تبخرت يا عزيزي. لم تعد تعني شيئًا بعد الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: هل زرت أيًا من هذه المنازل الأخرى؟ هل تجولت في الشوارع؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: هل أنت واحد من هؤلاء "الوحوش"؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: عمَ تتحدث بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: أخيرًا... لا مزيد من التردد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: لم يعد هذا مجتمعًا بعد أن خرجت الوحوش من جحورها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: العالم كله أصبح في حالة فوضى، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: مرحبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: فلماذا تقاوم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: سينتهي كل شيء قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: ما الذي تتمسك به؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: تهرب دائمًا من أمثالي، من الحقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: لهذا السبب أنا موجود.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: لا تزال غير قادر على تولي زمام الأمور بنفسك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: رائع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: هل تشعر بالخوف؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: أنت مستعد إذن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: تخلصت من بعض من لا ينتمي إلى هذا المكان
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: تخلصت من كل من لا ينتمي إلى هذا المكان
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: لا أسمح إلا للأشخاص المناسبين بالدخول
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: هناك الكثير من... غير البشر هنا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: لم أسمح لأحد بالدخول
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: هناك الكثير من الناس هنا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: هل تسمح لأي منا بدخول منزلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: لكنني أشعر بفضول أكبر تجاه شيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: هل ستشعر بأي شيء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: هل ترحل... إلى الأبد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: ستموت. ولكنك تريد معرفة ما سيحدث بعد ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: يبدو أنك أكثر اهتمامًا بما سيحدث بعد النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: هل تتساءل عن سبب بقائك على قيد الحياة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: هل يخيفك المجهول؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: تخلصت من بعض من لا ينتمي إلى هذا المكان
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: تخلصت من كل من لا ينتمي إلى هذا المكان
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: لا أسمح إلا للأشخاص المناسبين بالدخول
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: هناك الكثير من... غير البشر هنا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: لم أسمح لأحد بالدخول
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: يوجد الكثير من الناس هنا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: هل تعيش بمفردك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: هل تسمح لأي منا بدخول منزلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: ولكن حتى الآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: ...وستختفي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: إن لم يكن اليوم، فغدًا. إن لم يكن غدًا، فلاحقًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: ...ستموت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: لكن النتيجة واحدة دائمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: لتغيير شيء ما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: لقد أرسلوني لسبب ما...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: هل فكرت في... أنك قد تم اختيارك؟ هاهاها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: لم تفكر في هذا السؤال إلا الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: لمَ لا تكسر الباب؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: لماذا تواصل المجيء إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: لكن لا تقلق، يمكننا مساعدتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: من المضحك أنك لا تشعر بأي شيء على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: لا يمكنني الجزم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: لماذا لا تكسر الباب فحسب؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: لماذا تواصل المجيء إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: إنه يلاحقكم بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: هل شعرت به بعد؟ الموت يقترب أكثر فأكثر؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: هذا كل ما في الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: أقول لك ما قيل لي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: ما الذي يقترب من نهايته؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: ماذا تعني؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: سواء بأيدينا أو بأيديكم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: كل شيء يقترب من نهايته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: أخبروني أن هذه ستكون آخر محادثة صغيرة بيننا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: أراك لاحقًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: حسنًا إذن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: أنا أتبع الأوامر وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: هناك أشياء أعظم بكثير في هذا العالم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: لا تعتقد أنني أقود الجماعة بأكملها، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: التغيير ليس أسوأ ما ينتظرك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: حتى نحن أصبحنا نادرين الآن. ناهيك عن بني جنسك، المحبوسين داخل بيوتهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: حسنًا، حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: تعال معي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: جيد... كسبنا الرهان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: هممم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: لا، لستُ بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: نعم، أنا بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: هل تعيش بمفردك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: لكن قبل أن أغادر، دعنا نجرب تلك المراهنة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: يا للأسف... سأغادر... في الوقت الحالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: لا، لستُ بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: نعم، أنا بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: هل تعيش بمفردك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: ولكن أولًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: لنجرب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: الأمر بسيط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: هل يمكنك العودة لاحقًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: لا أفهمك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: ستفتح لي الباب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: إذا كان هناك اثنان على الأقل منا داخل منزلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: لنعالج هذا الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: لم تعد حتى تهتم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: نحن منفصلون، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: هل يمكنك العودة لاحقًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: لا أفهمك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: لأن الكلاب تسكن أجسادهما الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: ستفتح لي الباب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: إذا كان هناك اثنان على الأقل منا داخل منزلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: لماذا لا نجرب شيئًا جديدًا؟ المراهنة مثلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: يبدو أنك بحاجة إلى المساعدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: لا بد أن الأمر صعب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: لا يهمني
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: لا أشعر بأي شيء
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: هناك أشياء غريبة تحدث من حولك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: تعرف مَن أقصد، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: كل ذلك بسبب كلمة واحدة. كلمة واحدة فقط... لكن يا لها من كلمة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: والآن أصبح أحد أمثالك خالدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: ...وأنا أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: التغيير يطاردك في كل مكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: هل تشعر بذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: في المرة القادمة التي نلتقي فيها، ستكون الأمور... مثيرة للاهتمام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: ولا يمكنك مجاراة هذا التغيير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: لقد تغيرت الحياة إلى الأبد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: تفهم ما أعنيه، أليس كذلك؟ لن تعود الأمور أبدًا إلى ما كانت عليه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: الكلاب تحكم العالم الآن. والكلاب وحدها هي التي تنجو هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: لماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: ما زلت تكافح من أجل البقاء في هذا العالم الجديد، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: سأرحل بسرعة إذن. ولديّ هدية صغيرة لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: لم تتزوج؟ ...يا للأسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: انتهى بك الأمر وحيدًا إذن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: لا، لستُ بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: نعم، أنا بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: هل تعيش بمفردك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: الشيء الوحيد الذي يمكنك إيقافه هو نبضات قلب شخص ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: إيقاف الفيضانات والحرائق والكوارث؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: هل يمكنك درء الموت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: وماذا يمكنك أن تفعل بالضبط؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: لا، لستُ بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: نعم، أنا بمفردي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: هل تعيش بمفردك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: حسنًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: ...أو الموت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: ...كارثة كونية مثلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: ماذا يمكن لأي شخص أن يفعل في مواجهة الكوارث؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: نعم، أعرف ذلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: أفعل ما بوسعي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: لا أستطيع فعل أي شيء
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: أم تريد إصلاح الأمور بنفسك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: هذه نعمة، ألا تظن ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: كل شيء قد تقرر لنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: لماذا تشعر على الإطلاق؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: أفعل ما بوسعي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: لا أستطيع فعل أي شيء
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: أم يجب أن نأخذ زمام الأمور بأيدينا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: ربما سيعيد مرتدو البدلات النظام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: الأمور السيئة تتوالى واحدة تلو الأخرى، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: الأوقات عصيبة مؤخرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: لا أعرف كيف أشعر تجاهه
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: إنه يقوم بعمله فحسب
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: ما رأيك في ذلك الرجل؟ الذي يرتدي البدلة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: أرى أنك لا تزال مختبئًا هنا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: سأحضر أطفالي إلى هنا. ماما نونا ستحرص على ألا تموت وحدك... هاهاهاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: هاهاهاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: والأفضل... لا تفتحه على الإطلاق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: حسنًا. لكن... لا تفتح الباب لهؤلاء الأشخاص ذوي الزي الأصفر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: في اللحظة التي تفعل فيها ذلك، سيجروننا إلى مكان لا يعلمه أحد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: أوه، بوركت يا بني. لكن لا تفتح الباب لأي من هؤلاء المجانين ذوي الزي الأصفر الذين يطرقون الباب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: أحاول الآن البقاء على قيد الحياة يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: كما تم القبض على مجموعة من المستأجرين. ولكن لم يطاردوا بقيتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: حاول بعض الناس البقاء في أماكنهم، لكن ذوي الزي الأصفر قاموا بسحبهم بالقوة. كما لو كانوا يختارون الناس عشوائيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: كان المبنى بأكمله!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: وأخبروا الآخرين أن يرحلوا وكأن شيئًا لم يحدث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: هرع الرجال ذوو الزي الأصفر إلى الداخل، وألقوا بالناس على الأرض. وقبضوا على بعضهم أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: قالوا إن مبانينا تعرضت لضربة شمس قوية أو شيء غريب من هذا القبيل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: هل كان عددكم كبيرًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: لماذا طردوكم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: منذ ذلك الحين وأنا أهرب من مكان إلى آخر، أبحث عن مكان أستقر فيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: الحي بأكمله تم إخلاؤه، ولا أحد يعرف إلى أين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: لا أبحث عن أحد. لا أحتاج إلا إلى مكان أريح فيه رأسي يا عزيزي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: هل كان عددكم كبيرًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: لماذا طردوكم؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: بعد ذلك، هرب الناس في كل اتجاه. جئت إلى هنا أملًا في النجاة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: وأصبحنا بلا مأوى، وبلا مساعدة. إلى أين نذهب؟ ماذا نفعل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: أولئك الرجال ذوو الزي الأصفر طردونا جميعًا من المبنى، لكنهم لم يأخذونا إلى أي مكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: كنت أنا وأولادي نسكن على بعد بضعة شوارع من هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: هل تبحثين عن شخص ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: مَن أنتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: هل أنتم في المنزل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: يا مرحب!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: صحيح. أنا متأكد أنك لا تريد إهدار الرصاصات. إلى اللقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: هل يمكنك إطلاق النار عليّ؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: أرى أن يديك متمرستان على إطلاق النار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: أتفهم ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: السقف منخفض قليلًا. لكن لا بأس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: شـ-شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: سأرحل. لن أتوسل إليك. ولن أزعجك بعد الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: لست مضطرًا للسماح لي بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: ماذا لو ازداد الأمر سوءًا؟ ولم يكن هناك موت يخفف المعاناة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: أخشى خلع أي طبقة من ملابسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: يحتر-ررق آخرون تحت أشعة الشمس. بينما أرتدي عدة طبقات من الملابس وما زلت أشعر أنني على وشك التجمد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: أشعر بالبرد دائمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: اخلع سترتك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: ألا تؤثر فيك الحرارة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: منذ فترة طويلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: لم أجد السلام قط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: اخلع سترتك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: ألا تؤثر فيك الحرارة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: سأسألك لاحقًا. لست متأكدًا من أنني أستطيع الوثوق بك في هذا الأمر بعد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: لا، لستُ كذلك. أريد أن أطلب منك شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: لم يعد ذلك مهمًا. هل تتساءل إن كنت زائرًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: منذ متى وأنت تبحث عن مكان؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: مَن أنت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: هل يمكنني أن أحظى ببعض الهدوء في منزلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: الحرارة لا تزعـ-جني. كل ما في الأمر أنني أبحث عن مكان هادئ لأرتاح فيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: مر-مرحبًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: أقسم إنني لن أترك أي زائر حشرة على قيد الحياة. أعدك بذلك يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: ...وقد تذبحني قبل شروق شمس الغد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: ربما هذا أفضل. قد تكون واحدًا منهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: سنقضي عليهم. لن نسمح لأي متطفل منهم بالاقتراب من هذا المكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: كنت أعلم أنك لستَ ضعيفًا. لديك بعض الشجاعة يا بني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: وحوش في أجساد بشرية، يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: هرعت خارج المكان، ولكنهم أطلقوا النار عليّ من باب المرح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: انتظروا حتى فقدت الوعي. وسرقوها بينما كنت نائمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: كنت أمتلك بندقية. كادت أن تتسبب في مقتلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: لن تُمنح فرصة ثانية مع هؤلاء الأوغاد الأنذال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: إن تركت أحدهم حيًا، فسيعود ليقضي عليك بلا شفقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: لستَ غبيًا يا فتى. لكنني لن أطردهم وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: ألا تفعل الشيء ذاته؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: أين سلاحك إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: هل تريد صيد الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: أؤكد لك يا بني، إنهم يخططون لشيء ما. ويجب إيقافهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: منذ أن بدأت هذه الأزمة مع الشمس، أصبحوا يزحفون من جحورهم أكثر من أي وقت مضى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: هنا في المدينة؟ كنت بحاجة فقط إلى مكان أريح فيه جسدي يا فتى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: أين سلاحك إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: هل تريد صيد الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: يجب القضاء على هؤلاء المتطفلين. كلهم دون استثناء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: يتظاهرون بأنهم منا... ثم يتسللون إلى منازلنا ويحدث ما لا يمكن تصوره.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: منزل بعد منزل، لا يوجد إلا شخص ميت، أو شخص ممزق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: هل رأيت ما يفعله هؤلاء الزوار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: ما الذي تأمل أن تجده هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: لماذا تتنقل كثيرًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: لكنني لم أعد أستطيع التجول كما كنت أفعل من قبل. للعمر أحكامه يا بني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: لستُ من سكان المنطقة، ولا أحب البقاء في مكان واحد طويلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: مرحبًا يا فتى. كيف تسير الأمور في منطقتك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: ...أعتقد أنني سأرحل الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: ليس لديّ القوة الكافية لمواصلة القراءة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: "صراخ شبابنا كان كصراخ محرقة مدينة روان..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: وداعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: شكرًا. لكن ذلك لم يساعد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: هذا مؤسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: "واحد يهتف بين عالمين: يا نار، امشي معي."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: سأرحل الآن. إلى اللقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: يا إلهي... تذكرت شيئًا للتو. شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: ...فهمت الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: "لقد كنا على متن قطار نحو المجهول لفترة طويلة. لكن الطريق يهدر تحت عجلاته."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: الصفحة العاشرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: منتصف الصفحة مائتان
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: في صفحة ما قرب النهاية
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: أنا خائف. ربما سيساعدني ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: أتذكر عندما طلبت منك أن تقرأ لي مستقبلي من هذا الكتاب؟ هل يمكنك أن تفعل ذلك مرة أخرى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: هل هذه رسالة موجهة إليك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: أتذكر كلمة واحدة فقط... اقفز. ماذا تعني يا تُرى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: لكنني كنت كذلك... على ما أعتقد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: يا له من سؤال غريب. لم أعد أفهم أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: الصفحة العاشرة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: منتصف الصفحة مائتان
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: في صفحة ما قرب النهاية
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: ربما سيساعد ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: هل يمكنك أن تتنبأ بمستقبلي مرة أخرى؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: أشعر أننا ضعت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: لا أعرف إن كانت هذه رسالة موجهة لي... أم لك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: هناك كلمة واحدة تتكرر في ذهني: اقفز. اقفز. اقفز.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: أنا... لا أتذكر شيئًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: هل تحتضر؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: عمَن تتحدث بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: علام كل ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: والآن؟ تتراجع عن كل شيء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: لقد ساعدَتني على الاستمرار طوال هذا الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: هل تحتضر؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: عمَن تتحدث بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: يا إلهي، يجب أن... دعني وشأني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: أفهم ما الذي يحدث الآن... شيء طال انتظاره.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: لقد تلاشت رؤياي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: لقد فات الأوان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: تبدو في حالة... مزرية
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: لا تمت على الشرفة
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: هل تركتني ورحلَت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: رؤيتي تتلاشى. بالكاد أرى أي شيء الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: لقد نسيت وجهك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: أحتاج إلى أن أكون وحدي مع أفكاري.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: تذكر... القفز لن يساعدك. ليس بعد...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: وأنت...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: كان لا بد من القيام بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: أنا... أتذكر... كان ذلك هو التصرف الصحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: يجدر بي أن أرتاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: لا تقفز. ليس بعد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: لكن... في الأرض... أرى شيئًا آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: يا إلهي... لا أستطيع التفكير بتركيز.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: هل أنت متأكد أن هناك شيئًا ما بالفعل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: هل أحتاج إليه؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: من المفترض أن تجده.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: هناك شيء مدفون فيه. تحت الأرض...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: أرى... أرى ما سيحدث بعد ذلك. القبو.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: لكن الآن... بصيرتي باتت مشوشة. أراك تائهًا في غابة مظلمة، محاطًا بالوحوش.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: كان هناك سبب للقائنا. أتذكر ذلك بوضوح شديد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: ...أعلم أن كلامي قد يبدو غريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: هل أنت متأكد أن هناك شيئًا ما بالفعل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: هل أحتاج إليه؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: على الرغم من أنني لا أستطيع رؤيته بوضوح...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: هناك شيء ما تحت الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: لديك قبو، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: قبل أن آتي إليك، كان كل شيء واضحًا جدًا. الآن... أصبح كل شيء غامضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: يا إلهي... لا أريد أن أخيفك. أقول ما يجول في خاطري فقط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: بدأت أندم على ثقتي بك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: لا أفهم أبدًا ما تقوله
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: لكن الآن... هناك خطب ما. هل يمكن أن يكون...؟ رجل الفطر...؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: سيأتي لمساعدتك إذا طلبت منه ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: لكن لا داعي للخوف منه. لأننا ببساطة غير مدركين مدى قوته.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: أتعلم، هناك كيان أقوى منا جميعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: لا، بالطبع لا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: بدأت أندم على ثقتي بك
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: لا أفهم أبدًا ما تقوله
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: ستخترق الفروع الجديدة الرماد وتصل إلى السماء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: حدث هذا مرة واحدة في البداية. كل شيء سيكون على ما يرام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: ربما ليس أنت. أو هي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: أشعر بأنني أضعف. بصيرتي التنبؤية ليست في أفضل حالاتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: لقد حصلت بالفعل على كل المساعدة التي أحتاج إليها. ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: هل تتحدث إلى نفسك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: هل تحتاج إلى مساعدة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: هل هذا بسبب كل هذا الدمار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: الشعور أسوأ الآن. هذا غريب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: تعيش هنا، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: آمل أن أراك مرة أخرى قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: ولكن الآن تلاشى هذا الشعور إلى حد ما. أعتقد أننا نسير على الطريق الصحيح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: عندما جئت إلى هنا لأول مرة، شعرت بشيء... غريب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: لمدة يومين... الفحص ينذر بالهلاك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: انظر إلى ما قلت كنصيحة إذا أردت، ولكن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: لا أستطيع قول المزيد. لقد قلت الكثير بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: آمل أن أراك قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: ربما يجلب لك ذلك السلام النفسي. أو على الأقل يساعدك على المضي قدمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: إذا استطعت القيام بذلك، يمكنني مواصلة إرشادك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: أوقف تدقيقاتك حتى شروق شمس اليوم الثالث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: لكن... لمدة يومين... الفحص ينذر بالهلاك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: لا شيء. لقد قلت لك الكثير بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: ماذا سيحدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: ماذا أفعل بهذه المعلومات؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: 'Prophet: ربما سيذكرونه في المذياع. هل ستستمع؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: ولا يمكنك ردعه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: لكن هناك شيء واحد واضح حتى الآن. يلوح في الأفق شيء فظيع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: بفضلها أرى المستقبل أفضل من أي شخص آخر. لكن حتى أنا لا أرى كل شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: كيان قوي ينتظر اقتراب القطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: ماذا سيحدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: ماذا أفعل بهذه المعلومات؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: 'Prophet: ربما سيذكرونه في المذياع. هل ستستمع؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: لستَ السبب، لكنك ستشعر بآثاره.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: يلوح في الأفق شيء فظيع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: لا أرى كل شيء. لكن... أعرف ما ينتظرك في المستقبل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: أرى ما لا يراه معظم الناس. إنها موهبة أُعطيت لي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: لماذا طلبت مني أن أدع شخصًا لديه قطة يدخل منزلي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: كيف عرفت عن القطة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: أيًا كان ما ستفعله مع الشخص الذي جلبها... فهو قرارك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: رائع. القطة معك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: ثم سنواصل طريقنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: لذلك سنأخذ شخصين. وحالًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: ثم سنتركك لتموت وحيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: سنأخذ الجميع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: سنكسر بابك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: كأنني أتحدث إلى نفسي... سأخبرك بما سيحدث إذا لم تتعاون.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: هذا كل شيء. طابت ليلتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: الشعور متبادل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: لن أسلّم أي شخص آخر
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: ممتاز. لا أريد أن أراكم مرة أخرى أبدًا.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: وسنتعامل معك أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: لستَ أول من يحاول مقاومتنا. لقد تعاملنا مع أمثالك من قبل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: إما أن نكسر الباب ونخلي هذا البيت اللعين بالكامل، أو تسلمنا شخصين الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: لن أجادلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: لقد نفد صبري.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: لن أسلّم أي شخص آخر
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: ممتاز. لا أريد أن أراكم مرة أخرى أبدًا.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: وبعدها، إما أن نجد طريقة للقضاء على الزوار، أو أننا لن نلتقي مرة أخرى أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: لن نأخذ كل المقيمين لديك. نريد اثنين فقط.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: شخصان إضافيان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: ما الفائدة من وكالتك إذا لم تنجح في أي شيء تفعله؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: ما الذي يتطلبه إصلاح كل هذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: إذا لم نجد طريقة للنجاة، فسيقرر شخص آخر عنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: الأوامر التي يتوقعون منا الالتزام بها مستحيلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: السلطات غير قادرة على احتواء تفشي المرض. إنها على أتم الاستعداد لتفجير المدينة بأكملها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: كارثة كبرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: ما الفائدة من وكالتك إذا لم تنجح في أي شيء تفعله؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: ما الذي يتطلبه إصلاح كل هذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: استمر في المماطلة وسنأخذ كل من في هذا المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: العالم على وشك الفناء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: كف عن هذا الهراء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: أي كارثة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: أين الأشخاص الذين أخذتوهم من قبل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: إنها الطريقة الوحيدة لتجنب وقوع كارثة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: نحتاج إلى أناس آخرين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: ستستعيدهم قريبًا. شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: سلمنا الأشخاص بكل هدوء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: تهمنا مصلحة هذه المدينة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: قاوم، وسيتكرر الأمر مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: هذا ما يحدث عندما يعطلنا حمقى عنيدون مثلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: هل تستمتع بالمنظر خلفي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: كما تشاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: ...بحقك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: وسنتولى أمر الزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: سنعيد هذين الشخصين في أسرع وقت ممكن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: شكرًا لتفهمك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: تذكر، ساعدنا لنساعدك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: لا، لقد نلت كفايتي منكم
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: حسنًا. إذا كان ذلك يساعد...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: كل شيء سيعود إلى طبيعته قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: لا يهم مَن ستختار. لكن سلمنا اثنين من المقيمين عندك. الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: لكن هذه المرة سنحتاج إلى اثنين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: نعم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: لا، لقد نلت كفايتي منكم
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: حسنًا. إذا كان ذلك يساعد...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: هذا سيسرع الأمور. سيصب في مصلحة كل منا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: اثنان على وجه الخصوص.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: نحتاج إلى أناس آخرين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: هل عليّ أن أسلمك شخصًا مرة أخرى؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: ماذا سيحدث الآن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: الوضع تحت السيطرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: دعنا نقوم بعملنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: لو كان الأمر بهذه البساطة، لما كانت هناك حاجة إلى الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: هل عليّ أن أسلمك شخصًا مرة أخرى؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: ماذا سيحدث الآن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: تعاون معنا وسينتهي كل هذا بسرعة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: من الصعب تحديد متى ستعود الأمور إلى طبيعتها. نحتاج إلى إجراء المزيد من الفحوصات للسيطرة على الوضع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: ما زلنا ندرس سبب هذه الأحداث. لكن المهم هو عدم إعاقة عملنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: متى ستتخلصون من الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: إلى متى سيستمر كل هذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: كان... مسقط رأسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: وانظر إلى أين قادنا ذلك. لقد اضطررنا مؤخرًا إلى القضاء على مستعمرة للزوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: لم تفعل شيئًا سوى محاولة إعاقة عملنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: لستَ في وضع يسمح لك بطرح المطالب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: متى ستتخلصون من الزوار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: إلى متى سيستمر كل هذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: وهذا يؤدي إلى مزيد من العنف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: إخفاء الزوار يجعلهم يتكاثرون.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: إذا واصلت المقاومة، ستكون هناك المزيد من حالات التفشي التي يجب القضاء عليها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: تداعيات الكارثة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: أعد الذين أخذتهم!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: ماذا يحدث في المدينة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: كلما أسرعنا في الحصول عليهم، كان ذلك أفضل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: نحتاج إلى المزيد من الأشخاص الخاضعين للفحص من عندك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: مرحبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: بطريقة أو بأخرى، سنفعل ذلك. كلما أسرعت في التعاون، أسرعنا في إنهاء الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: هذا ليس خيارًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: أنت تسيء فهم الموقف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: بمجرد الانتهاء من الفحوصات، سنخبرك بما يجب عليك فعله بعد ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: لا تقلق. الإجراءات صعبة، نعم، لكننا نمنحهم وقتًا للراحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: لستُ مهتمًا بهذه الفحوصات
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: لا بأس. إذا لم يكن هناك طريقة أخرى
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: لدراسة تأثيرات الشمس بشكل أكثر شمولًا، سنحتاج إلى أخذ شخص آخر من منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: كانت النتائج غير حاسمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: لستُ مهتمًا بهذه الفحوصات
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: لا بأس. إذا لم يكن هناك طريقة أخرى
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: بعد ذلك، ستتم إعادته من منطقة الحجر الصحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: بعد الفحص، هناك فترة حجر صحي إلزامية. سيبقى الشخص معنا لفترة من الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: آه. كان فريقنا هنا بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: نعيد؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: ماذا عن التفتيش الأخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: متى ستعيدون الشخص الذي أخذتونه؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: لا تقلق. لن يستغرق الأمر وقتًا طويلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: أنا من الوكالة الفيدرالية. ونجري تفتيشًا روتينيًا في منطقتكم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: مساء الخير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: اعتنِ بنفسك، اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: ومن بعدها... يمكن أن تصبح الأمور مأسوية للغاية، وبسرعة كبيرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: إذا ركزت عليه أكثر من اللازم، فسيبدأ في التهامك حيًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: لا تغرق في حزنك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: ربما عندها... لن يكون الموت هو الشيء الوحيد الذي يشغل بالك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: آمل أن تتذكر كيف كان شعورك بالسعادة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: هل تفهم ما أعنيه؟ الحياة أصبحت مريرة للغاية مؤخرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: عندما لم يكن هدفهم مجرد البقاء على قيد الحياة، بل عيش لحظات... جميلة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: لكن في بعض الأحيان، إذا ذكرتهم بالطرق التي كانوا يسعدون بها في الماضي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: لماذا تسمي ذلك كذبًا؟ الناس غارقون في آلامهم وأنا أفهم السبب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: لا يمكننا أن نسمح لأنفسنا بالغرق في اليأس... الآن أكثر من أي وقت مضى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: حاول أن تتذكر ما الذي كان يجلب لك السعادة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: ماذا كنت تحب أن تفعل قبل أن يحدث كل هذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: هناك الكثير من الأسباب. لكنني لا أستطيع أن أخبرك بما يجب أن يجعلك سعيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: هل تريد أن تكذب على الناس؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: ما الذي يدعو للسعادة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: اليأس يعمينا عما تبقى من الخير القليل في العالم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: الخوف جعل الناس ينسون حتى معنى الفرح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: نعم... أنا أيضًا لم أرَ أحدًا يبتسم منذ فترة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: أوه، تقصد لماذا أبتسم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: ما المشكلة في ذلك؟ لا أرى أي ضرر في ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: هل تريد أن تكذب على الناس إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: ما الذي يدعو للسعادة؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: إذا واصلنا إقناع أنفسنا بأن كل شيء سيكون على ما يرام، فربما تصبح الأمور أسهل قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: الجيل القادم. الفن. و... متعة الحياة نفسها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: نعم، الأوقات عصيبة. ولكن لا يزال هناك الكثير مما يستحق النضال من أجله.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: هناك ما يكفي من الغضب في العالم بالفعل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: ماذا حدث لوجهك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: لماذا تبتهج هكذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: هل تمانع إن قضيت الليلة هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: أنت يا صاحب البيت! أسمع خطواتك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: سحقًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: أعتقد أنك شخص مقرف على أي حال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: لا يهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: ولكن... لا يهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: هل لديك سجادة؟ رائع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: مستحيل! وووه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: هل ستترك طفلة هنا حقًا؟ تحت أشعة الشمس الحارقة؟ في ظل وجود زوار حولها؟'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: لا يهم. أنا هنا، أليس كذلك؟ وأحتاج إلى مكان أحتمي به.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: أمي تحب الاستلقاء تحت أشعة الشمس. لذا، نعم... هناك مصير آخر يمكن تخمينه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: أو ربما أصبحا زائرين الآن. هذا يناسب طبيعتهما نوعًا ما. ها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: لا أعرف. ربما في المنزل. أين يمكن أن يكونا غير ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: لذا، إذا حاولت فعل أي شيء غريب، سأضربك ضربًا مبرحًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: لكن أحيانًا أصادف أشخاصًا في منتهى الوقاحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: لكنني مفلسة. لذا إما أن أبرم صفقات للحصول على غرفة أو أتسلل إلى الأقبية. هذه طبيعة الحياة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: أنا... أتجول. أريد أن أرى العالم. والأماكن المختلفة. ربما سأجد موطنًا جديدًا في مكان ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: أين والداكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: ماذا تفعلين في الأقبية؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: لم أجد قبوًا أو أي مكان آخر مناسب للاختباء، لذا أقف أمامك الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: حسنًا... هل يمكنني الدخول إذن؟ أم أنك ستتركني هنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: أين والداكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: ماذا تفعلين في الأقبية؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: لقد سئمت من الاختباء في الأقبية. إذا استمرت الأمور على هذا المنوال، سأنسى قريبًا كيف أتكلم. وأعلم أن هذا لا يعنيك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: لا، أنا فقط... أحتاج إلى الاستراحة قليلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: نعم، إنه منزلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: هل تبحثين عن شخص ما؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: هل هذا مكانك؟ أعني... منزلك يا سيدي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: مرحبًا. آآه... أو أهلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: هيا، حركي ساقيكِ اللعينتين. أنا متعب أيضًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: علينا أن نواصل البحث، أليس كذلك يا زوجتي العزيزة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: فهمت. آسف على الإزعاج.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: إنها تشعر بالخجل وحسب. لا بأس يا زوجتي العزيزة، سنجعلكِ تستريحين وتعودين إلى طبيعتكِ قريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: لماذا تقفين هناك؟ هيا يا عزيزتي، لقد دعانا هذا الرجل اللطيف للدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: أوه، شكرًا لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: عليكما الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: ادخلا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: آسف، ما كان يجب أن أسأل عن هذا. هذا ليس من شأني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: لكنني مدين لزوجتي بكل شيء. لولاها، لما كنت قد نجحت في تجاوز كل هذه المحن. ما الذي يدفعك للمضي قدمًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: تراكمت علينا المشكلات... وكان الأمر صعبًا علينا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: كل شيء كان مرهقًا مؤخرًا... الزوار، والحرارة، والطرد من العمل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: عليكما الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: ادخلا
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: أوه، اعذرني. لا ينبغي أن أضغط عليك هكذا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: أليس كذلك يا حبيبتي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: ولكن ربما يمكننا أن نتحدث جميعًا معًا في يوم آخر. إذا التقينا مرة أخرى، بالطبع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: إنها متعبة جدًا. أنا آسف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: بالطبع تستطيع! زوجتي العزيزة، هل تريدين قول شيء؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: لماذا أنتما مرهقان هكذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: هل تستطيع زوجتك التحدث بنفسها؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: إذا لم يزعجك ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: لكن زوجتي متعبة جدًا. إنها بحاجة إلى قليل من الراحة. هل يمكننا البقاء لفترة قصيرة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: حسنًا... أعتقد أنه يمكننا الذهاب والبحث عن مأوى في مكان آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: لماذا أنتما مرهقان هكذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: هل تستطيع زوجتك التحدث بنفسها؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: إنه منزل كبير، بعيد قليلًا عن الطريق، لا يوجد جيران فضوليون... احتمالية ظهور شخص غريب الأطوار أقل، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: لا أعرف حقًا كيف أشرح ذلك، هاها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: بصراحة، منزلك يبدو أكثر أمانًا من أي منزل آخر رأيناه، أليس كذلك يا حبيبتي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: ماذا لو كنتما تثيران المشكلات؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: هل يبدو منزلي مكانًا آمنًا لكما؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: هل تمانع إذا أقمنا هنا لفترة قصيرة؟ إذا لم يكن ذلك يسبب لك أي إزعاج، بالطبع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: مرحبًا! أنا وزوجتي الحبيبة نبحث عن مكان آمن لنحتمي فيه من العاصفة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: ...هنا، هذا أفضل كثيرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: هدية صغيرة مني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: اعثر على قطة تحت المنزل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: هيا يا قطتي. حان وقت الركض والمتعة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: سأرتاح هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: اغربي عن وجهي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: حسنًا، ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: فكّر مرة أخرى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: انظر لحال القطة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: لا تعذب القطة. القطة تكره البرد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: الراقصة المسكينة تتجمد من البرد... يا للأسف...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: ستفتح أم لا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: هل اجتزت الفحص؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: ألا يكفيك ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: ذراعان. ساقان. رأس.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: هل قررت؟ ماذا سنفعل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: أنا أفضل راقصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: قد أرقص لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: أتريد رؤيتي أرقص؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: ماذا إذن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: أثبتي أنكِ بشرية
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: لا أعتقد أنكِ بشرية
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: ما أغرب ما تقول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: ماذا الآن؟ هل تخبرني المزيد؟ أو ماذا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: حقًا؟ بالطبع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: أثبتي أنكِ بشرية
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: لا أعتقد أنكِ بشرية
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: هيه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: لا أعتقد ذلك. لماذا تهتم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: أنتِ تذكرينني بشخص ما
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: هل أرسلكِ أحد إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: الجو ليس حارًا هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: رأيت منزلك. وجئت إلى هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: هل رأيت المدينة؟ لقد عشت هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: أنتِ تذكرينني بشخص ما
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: هل أرسلكِ أحد إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: باليه. أليس واضحًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: أنا راقصة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: كيف وجدتِ منزلي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: مَن أنتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: قالوا لي تعالي إلى هنا، فجئت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: هل ستفتح؟ نعم أم لا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: صندوق جعة. درج. فخذ لحم. لا أعرف. أعطني أي شيء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: كيف وجدتِ منزلي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: مَن أنتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: كيف أساعدك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: تطرح أسئلة كثيرة. نعم، أعرفه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: ماذا تريدين؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: هل تعرفين... الرجل الأصلع؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: ستفتح أم لا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: أهلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: إذا صادفت طفلًا وحيدًا في حاجة إلى المساعدة... أرجوك اعتنِ به. إلى اللقاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: لا ألومك. لكن أرجوك... عدني بشيء قبل أن أذهب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: لكن شكرًا لك... على الاستماع. وعلى السماح لي بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: أعلم أنه لا يوجد شيء يمكنني فعله لإعادتهم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: لقد أحرقوا كل شيء. وأجبروني على المشاهدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: ماذا فعلوا ليستحقوا ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: ماذا أصبحنا؟ مجموعة من المجانين تحكم على أطفال عاجزين؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: اكتشفوا أنني كنت أؤوي أطفالًا لديهم علامات تدل على أنهم زوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: إنهم... سكان البلدة الآخرون.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: ما زلت أرى عيونهم المذعورة تراقبني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: وأجبروني على المشاهدة... أولًا أغلقوا الأبواب، وسدوا النوافذ بالمسامير... ثم أشعلوا النار في المبنى.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: السكان الآخرون فعلوا ذلك خوفًا من أن يكون الأطفال زوارًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: ماتوا كلهم... في الحريق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: لقد...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: لماذا اندلع الحريق؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: ماذا حدث للأطفال؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: ولكن الآن... لقد ماتوا جميعًا. لم ينجُ أحد منهم من الحريق...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: بعضهم تخلى عن أطفاله بمجرد ظهور أدنى علامة على أنهم زوار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: اختطفت الوكالة الفيدرالية بعضهم. وقُتِل بعضهم. وبعضهم...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: لقد فقد كل طفل منهم والديه لأسباب مختلفة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: بعد أن بدأ العالم ينهار، أحضرت الصغار الذين تم هجرهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: كنت معلمة... كنت أدرس في روضة أطفال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: لماذا اندلع الحريق؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: ماذا حدث للأطفال؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: لكن ذلك لم يكن كافيًا... لم أستطع إنقاذهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: كانوا بحاجة إلى شخص يعتني بهم ويحبهم. وبذلت قصارى جهدي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: كنا نعيش معًا في مبنى الروضة القديم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: أخذت معي أولئك الذين أطلقوا عليهم اسم "الملوثين" — أي طفل يخشون أن يكون زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: أنا... أردت فقط أن أمنح القليل من الأمل للأطفال الذين تم هجرهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: مَن أنتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: ماذا حدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: أشعر بالسوء الشديد. هل يمكنني التحدث معك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: آسفة لإزعاجك، ولكن... هل لديك دقيقة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: خلي بالك من نفسك ومن صحابك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: ولا يهمك يا صاحبي. مش هقدر ألومك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: يا خسارة...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: لازم يعملوا فيلم عن اللي حصلي في المصيبة دي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: دي أحسن حاجة حصلتلي في حياتي تقريبًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: ألف شكر يا صاحبي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: كان نفسي أعيش في فيلم من الأفلام...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: الأفلام أمتع بكتير من الكتب على فكرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: الأفلام بكل أنواعها، أكشن أو دراما إلخ إلخ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: الحل في الأفلام...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: وبعد كل الأخبار الكئيبة اللي في التلفزيون؟ الدنيا باظت أكتر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: الناس اتجننت. ماشيين يكلموا نفسهم. كلهم مرعوبين ومش فاهمين إيه اللي بيحصل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: الدنيا خربانة برا خالص.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: المهم... خليني أدخل عندك شوية لو سمحت!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: هتبقى حاجة رهيبة! في واحد صاحبي قرأ كدة في مجلة علمية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: تخيل لو سافرنا الفضاء ولقينا فضائيين نكلمهم... يا نهار أبيض....'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: بيسافروا الفضاء ويشوفوا حاجات غريبة هناك ويتوقعوا حدوثها هنا على الأرض.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: تعرف مخرجين أفلام الخيال العلمي بيتوقعوا المستقبل ازاي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: يا عم أنا عارف كل حاجة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: ألا تعرف حقًا ماذا يحدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: ما هذا العبث الذي تقوله؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: والأكل. لازم نخزن أكل كتير جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: وبالمناسبة، معاك بندقية خرطوش أو قنابل مثلًا؟ هنحتاج كل الأسلحة المتاحة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: أنا بسأل عشان إجابتك هتفرق جدًا في خطتنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: واتحولوا زومبي إزاي؟ فيروس وكدة ولا قاموا من الموت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: بس قولي، الزومبي اللي في الشارع عادي وبطيء ولا سريع وشرس؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: شفت أفلام كتير جدًا عن الزومبي واتعلمت كتير جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: بص بقى، أنا مفيش حد خبرة أكتر مني في الزومبي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: في زومبي طيب؟ كنت متأكد مع أني كنت شاكك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: ألا تعرف حقًا ماذا يحدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: ما هذا العبث الذي تقوله؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: ولازم كمان يكون في أربع أبطال مثلًا، عشان يحكوا لنا قصص المغامرة الجامدة دي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: وبووم! نضرب صاروخ على الشمس، وننقذ العالم ونخلص من الكابوس، صح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: يعني اللي المفروض نعمله أننا نبعت رواد فضاء للشمس ويخلصوا الموضوع ده، صح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: شفت فيلم زي كدة! كان فيه ممثل أقرع كدة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: ده جنان رسمي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: مخلوقات تشبه البشر تزحف من تحت الأرض.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: الشمس تشتعل وتحرق الناس أحياء خلال النهار
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: هو في حاجة أنا معرفهاش؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: شايف الدنيا عاملة إزاي برا؟ إيه الجنان ده؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: إيه الأخبار يا صاحبي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: وإلا سيعثر عليك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: أتوسل إليك، لا تقترب من أي جثث متفحمة بعد حلول الظلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: حسنًا، سأغادر. لكن يجب أن أحذرك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: اللعنة... هل سيكون النوم أصعب دون عيون؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: شكرًا... ربما يمكنني أخيرًا الحصول على قسط من الراحة الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: لم يكن من المفترض أن يوجد هذا الشيء... لا ينبغي أن يوجد أصلًا في عالمنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: أكبر... أقوى... لا يمكن تسميته. إنه يتبع رائحة اللحم المحترق ويحصد ما زرعناه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: لا، لا. هناك شيء أسوأ بكثير.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: هل رؤية رجل شاحب وحدها تكفي لأفعل ذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: يا إلهي... لا أتمنى أن يرى ألد أعدائي ما رأيت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: يلتهم ببطء تلك الأجساد المحترقة التي تشبه الفحم... أمام عينيّ مباشرة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: إنه... لم يلحظني في البداية. كان مشغولًا في التهام اللحم المحترق...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: خطئي الوحيد كان أنني تجولت في المكان الخطأ في الوقت الخطأ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: فهو يتغذى على حزننا! والآن أمامه مأدبة من الحزن! إنه يتغذى على الخوف والألم... وعقولنا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: صدقني، يُستحسن ألا تعرف...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: أتعني الرجل الشاحب؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: ماذا رأيت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: اعتقدت أنني أستطيع محو تلك الصورة الرهيبة إذا أصبحت أعمى. الآن لا أرى سوى فراغ لا نهاية له.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: اضطررت للتضحية بعينيّ حتى لا أفقد عقلي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: أنا... أنا من فعلت هذا بنفسي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: أتعني الرجل الشاحب؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: ماذا رأيت؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: صدقني... لو كنت قد رأيت ذلك، لكنت فعلت الشيء نفسه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: لا توجد كلمات تصف الرعب الذي مزق روحي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: إنه دائمًا أمامي. ثابت في الظلام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: رأيت شيئًا لا يوصف. لا أجرؤ على وصفه... رغم أن هذه الرؤية مصدرها خيالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: مَن فعل هذا بك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: ماذا حدث لعينيك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: أخيرًا... عثرت على ملجأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: إلى أين من المفترض أن أذهب الآن؟ أنا... أنا ميت لا محالة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: هذا غير معقول! ألا ترى حالتي المزرية!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: بمجرد انتهاء هذه الفوضى، سأحرص على أن يتم تعويضك بشكل ممتاز.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: رائع. لن تندم على قرارك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: دعني أدخل الآن، وعندما ينتهي كل هذا... سأحرص على أن تحصل على تعويض. وهذا التعويض سيكون جيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: بحقك... يمكنني أن أجعل الأمر يستحق عناءك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: فاشل وقح يرفض استقبال رجل مهم. كنت أدير هذا الحي! لقد كنت وزيرًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: لقد جئت إلى هنا بصعوبة، وما المقابل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: أنا جاد يا فتى! أنا... لا أشعر أنني بخير. أحتاج إلى ماء بارد، الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: أنا على وشك الإغماء والاحتراق حيًا على عتبة بابك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: اسمع يا فتى. افتح الباب. أحتاج إلى حمام بارد.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: ...بالمناسبة... ألا يوجد لديك أي مثلجات؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: رائع! لحظة أخرى وكنت سأذوب!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: لماذا تحتاج إلى الحمام؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: نعم
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: أحتاج إلى حمام بارد. أتمانع إن استعرت حمامك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: يا إلهي... الجو هنا أكثر حرارة من أي منتجع استوائي أقمت فيه من قبل. هاها!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: أشعر وكأن جلدي تذوب!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: لا، لا، لا! لستُ بخير. انظر إليّ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: لماذا تحتاج إلى الحمام؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: نعم
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: ...لا أستطيع التنفس. هل لديك حمام؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: قد يكون الجو أبرد قليلًا، نعم... لكن الهواء رطب مثل... مثل... مثل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: تبًا! ما زلت أشعر وكأنني داخل فرن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: هل أنت بخير؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: نحن في منتصف الليل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: تبًا... الجو حار جدًا هنا. حار جدًا جدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: حسنًا، لن أزعجك. سأرحل الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: خسارة يا صديقي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: سئمت الشعور بالوحدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: شكرًا جزيلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: لكن جديًا، هل ستسمح لي بالدخول يا صديقي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: ولمَ لا ننسى بؤسنا قليلًا؟ التعامل مع كل ما يحدث وأنا في حالة من اليقظة أمر صعب للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: هيه هيه، أنا أمزح معك مرة أخرى. لا تحمل ضغينة ضدي. في هذه الأيام، لا نملك سوى الضحك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: وجبات لذيذة وصحية، ويمكن أن تساعد في التخسيس إذا تم تناولها بالطريقة الصحيحة. أعني، متّع عينيك بجسدي الممشوق!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: تناولت فطورًا فاخرًا هذا الصباح. ألتزم بحمية صديقي الصحية: جعة على الفطور، ونبيذ على العشاء.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: إذن... هل ستسمح لي بالدخول يا صديقي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: أعتذر إن كانت نكاتي تزعجك. أحاول أن أبقى متماسكًا وحسب. هل تفهمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: سيبقيك الضحك عاقلًا في العالم المجنون يا صديقي. حتى لو كان كل شيء آخر يثير الجنون. لكنت تجدني بين الموتى منذ زمن طويل من دونه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: لستُ من النوع الذي "يقف على المسرح". ولكن، ما العيب في أن تضحك قليلًا بينما ينهار العالم؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: تبدو وكأنك ثمل. هل كنت تشرب مؤخرًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: هل أنت ممثل كوميدي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: لا يهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: لن أؤذي أحدًا أبدًا بسبب أسنانه أو عينيه أو أي شيء يقولونه في التلفاز. لا أستطيع حتى...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: إن وجود سمة غريبة أو اثنتين لا تجعلك زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: أمزح معك! لا تتصرف معي بصرامة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: قد أضرب أشخاصًا وسيمين بعيون جميلة وأسنان ناصعة البياض... فقط لأنني أحسدهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: صدقني، أنا أملك أطيب قلب بين جميع الرجال الذين ستقابلهم في حياتك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: تبدو وكأنك ثمل. هل كنت تشرب مؤخرًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: هل أنت ممثل كوميدي؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: هذا يعني أنني يمكنني الذهاب إلى الحانة إذا رغبت في تناول مشروب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: ليس لديّ حماة، فأنا لستُ متزوجًا أصلًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: هيهيههي، هل صدقت؟ أمزح معك يا صاح.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: طردتني حماتي لأنني طردت موظفًا من الوكالة الفيدرالية من المنزل. إنها خائفة الآن من أن يأتوا إلى بيتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: آه، لا شيء غريب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: كيف أعرف أنك حقًا "محترم"؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: ماذا حدث لك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: مرحبًا يا صديقي. هل هناك مكان لشخص محترم مثلي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: وداعًا أيها الغريب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: نعم... سيعودان قريبًا، أنا متأكد من ذلك. آمل ذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: سأعود إلى المنزل. تحسبًا لعودتهما...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: نعم، هذا على الأرجح الخيار الأكثر أمانًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: لكن... ربما تكون محقًا. ربما يجب أن أبقى معك في الوقت الحالي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: ماذا لو عادا إلى المنزل ولم أكن موجودًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: لا أعرف إن كانت هذه فكرة سديدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: ماذا يُفترض أن أفعل الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: أنا أعيش كابوسًا الآن...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: يا إلهي، ماذا لو... ماذا لو أحرقتهما الشمس؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: ماذا يُفترض أن أفعل الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: لم أعد أعرف كيف أتصرف. ربما أنت أيضًا لا تثق بي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: اللعنة، لماذا رحلا؟ لماذا لم يأخذاني معهما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: يا إلهي... ماذا لو أن "الزوار" قتلوهما؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: ستنفجر الشمس في أي وقت. إنها تحرق الناس أحياءً
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: ظهر الزوار من تحت الأرض. ولا يمكنك الوثوق بأحد
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: اعتقدت أن شخصًا آخر قد يخبرني بما يجري إذا تحدثت إليه. فهل يمكنك ذلك؟ من فضلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: غادرا على عجل من أمرهما بعد بضع ساعات من بث الأخبار... ولم يعودا بعد. والآن أنا خائف جدًا من تشغيل التلفاز.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: لذا لم أشاهد التلفاز. لم أرغب في إجهاد نفسي. لكنهم لم يعودا منذ حينها، وما زلت لا أعرف ما الذي يجري.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: ذات يوم، سمعا في الأخبار أن شيئًا سيئًا للغاية قد حدث.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: لكن أمي وأبي كانا يشاهدانها طوال الوقت.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: قرأت في مكان ما أن الأشخاص الذين لا يشاهدون الأخبار أو يقرؤونها يعيشون حياة أطول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: الأخبار غبر مبشرة. وإما تجعلني حزينًا أو خائفًا، لذلك توقفت عن مشاهدتها.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: ستنفجر الشمس في أي وقت. إنها تحرق الناس أحياءً
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: ظهر الزوار من تحت الأرض. ولا يمكنك الوثوق بأحد
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: أريد أن أعرف الحقيقة. أين ذهبا؟ لذا أرجوك... أخبرني بما يحدث!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: كان ذلك قبل أسبوع كامل... وما زالا لم يعودا. ما زلت أنتظرهما، لكنهما... اختفيا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: ذات صباح استيقظت ووجدتهما في حالة جنون تام. قالا إنهما يجب أن يغادرا على الفور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: لا، لا أشاهده. الأخبار تخيفني، لذا أحاول تجاهلها. لكن والديّ يشاهدانه...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: ألا تشاهد التلفاز؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: مهلًا، ألا تعرف حقًا ما الذي يحدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: يطلقون النار ويقاتلون بعضهم بعضًا... لا أفهم ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: الجو حار جدًا، وبالكاد أستطيع التنفس. والناس يتصرفون... بطريقة غريبة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: هل يمكنك أن تخبرني ما الذي يحدث؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: على كل حال، طابت ليلتك أيها الأحمق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: تختبئون في جحوركم وتمنعون الجميع من الدخول!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: بالطبع. كان يجب أن أتوقع ذلك. أنت مثل الآخرين تمامًا... مجرد مجموعة من الفئران الجبانة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: سحقًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: يسرني أنك لست مثل جيرانك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: شكرًا جزيلًا لك. أنا مدين لك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: أصبحت الآن شاهدًا... أعرف أكثر من اللازم. وبالتأكيد سيلاحقونني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: لهذا السبب هربت، على الرغم من أنني أصبت بعيار ناري أثناء قفزي فوق ذلك السياج اللعين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: عندما رأيت ذلك، عرفت أنه عليّ الخروج من هناك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: يفعل موظفوها أشياء مريبة بالناس. لذا، لا يخرج أحد من تلك المناطق أبدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: وسمعت صرخات مكتومة... وبعدها رأيتهم يسحبون حقيبة سوداء من الخيمة. لم يعد الرجل قط. هل فهمت الآن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: لقد رأيت ذلك بنفسي. لقد أخذوا أحدهم إلى خيمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: هذه ليست شائعة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: هل سمعت عن قيام الوكالة الفيدرالية بإجراء فحوصات لاكتشاف الزوار؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: هذه هي الحقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: سقطت مباشرة من السياج في بركة مياه، ثم هربت مسرعًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: لكن أعتقد أن اللحظة التي اخترتها لم تكن مناسبة. أحد هؤلاء الخنازير استدار ورآني. ثم بدأ في إطلاق النار.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: الموظفون مشغولون هناك. يمكنك أن ترى أنهم... يستعدون لشيء ما.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: لم أحتج حتى إلى وضع خطة. انتظرت اللحظة المناسبة وتسلقت السياج.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: والإجراءات الأمنية شبه منعدمة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: هذه هي منطقة الحجر الصحي التابعة للوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: والمساحة الفارغة تشغلها حاويات شحن ضخمة يدفعون الناس إليها كل صباح كالماشية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: تخيل موقف سيارات فارغًا، محاطًا بسياج، وبه بضع خيام متناثرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: هل تطاردك الوكالة الفيدرالية إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: أخبرني عن مناطق الحجر الصحي التابعة للوكالة الفيدرالية
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: رفضت وقاومتهم... فقاموا بتقييدي كالمجرمين. لكنني تمكنت من الهرب في النهاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: ثم رأيتهم يكتبون على أجهزة الكمبيوتر اللوحية الخاصة بهم ويخبرونني أن عليّ الذهاب معهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: لقد كانوا يفحصونني منذ اللحظة التي فتحت فيها الباب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: نعم، هربت من إحداها. جاء عملاء الوكالة يطرقون الباب أثناء عملية تفتيش وأخذوني من عتبة بابي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: هل تطاردك الوكالة الفيدرالية إذن؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: أخبرني عن مناطق الحجر الصحي التابعة للوكالة الفيدرالية
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: 'Fugitive: على الأقل أحشائي لم تسقط مني... ليس وكأنه بقي الكثير منها... هيه... آه، الضحك يؤلم بشدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: 'Fugitive: لكنها مرت عبر جسدي، لحسن حظي. لكنني أنزف بشدة كذبيحة الآن.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: اللعنة على هؤلاء الأوغاد. كل الرصاصات أخطأت الهدف... باستثناء واحدة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: لقد نال مني حيوانات الوكالة الفيدرالية... كنت أتسلق السياج، وأحاول الهرب...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: ماذا حدث؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: مَن فعل هذا بك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: لقد أصبت بطلق ناري. لن أعيش طويلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: ساعدني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: ستُحاسب أمام الرب. تذكر كلماتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: موتي سيقع على عاتقك يا ولدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: هل سترفض مساعدة امرأة مسنة مسكينة في حاجة إلى المساعدة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: أهذا قرارك إذن؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: ليكن الرب في معيتك يا ولدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: تأكد أنني سأبذل قصارى جهدي لإزالة مثل هذه الألفاظ البذيئة من هذا المكان.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: أسألك سؤالًا بسيطًا عن منزلك، فتشتمني؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: ألا تخاف الرب؟ ألا تخجل من نفسك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: لا تستخدم مثل هذه اللغة البذيئة معي أيها الزنديق!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: هل هذا عبء عليك يا ولدي؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: أحاول معرفة ما إذا كان بيتك يناسبني. لا أستطيع تحمل الفوضى والقذارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: أوه، أشكر الرب! ما كنت لأكتشف ذلك قط لو لم تخبرني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: هل جننتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: هذا ليس نزلًا!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: لا أطيق الحشرات. إنها أسوأ مخلوقات الخالق ولا تتحملها بشرتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: ثانيًا، هل تعاني من بق الفراش؟ هل توجد فئران بين جدران منزلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: إذا كان هناك أي أشخاص مثل هؤلاء في منزلك، فمن الأفضل أن تخبرني على الفور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: أولًا، لا أحتمل السكارى أو متعاطي المخدرات.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: أنت تستقبل المحتاجين، أليس كذلك؟ يجب أن أتأكد من بعض الأمور.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: أحتاج إلى غرفة في منزلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: هل جننتِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: هذا ليس نزلًا!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: لديك رموز مقدسة، أليس كذلك؟ أحتاج أيضًا إلى صمت تام للصلاة والتأمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: وبما أننا نتحدث عن هذا الموضوع... اسمح لي أن أسألك عن وسائل الراحة المتوفرة لديك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: للاختباء يا ولدي. أرغب في البقاء هنا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: يا إلهي... أنا أتكلم بوضوح، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: ما الذي تحتاجين إليه بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: يناسبكِ في ماذا بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: أعتقد أنه سيكون مناسبًا لي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: أرى أن مسكنك المتواضع أبعد مسكن هنا يا بني.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: 'Raskolnikov: آسف لإضاعة وقتك. أنا فقط... آمل أن أتعلم القتل يومًا ما. حتى... حتى أتمكن من الدفاع عن نفسي...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: 'Raskolnikov: لكنني أقسم إنني لست كذلك! أنا... كنت متوترًا مؤخرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: أعتقد أنني بدوت كشخص غريب الأطوار بعض الشيء. بل أسوأ من ذلك...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: يا إلهي... ألن تدعني أدخل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: هل يمكنك أن تريني كيف تفعل ذلك؟ كيف تقتل زائرًا. أريد أن أواجه الموت وجهًا لوجه.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: وإذا سمحت... بعد أن تفحصني...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: شكرًا يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: يمكنك أن تعلمني... كيف أقتل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: ولكن أيضًا، ربما... إذا كنت مستعدًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: لهذا السبب آمل أن أجد شخصًا... يمكنه حمايتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: وأنا؟ أنا جبان. لا أستطيع الدفاع عن نفسي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: في هذه الأيام، كل ما يتطلبه الأمر هو نظرة مقلقة واحدة ليسحب شخص ما الزناد ويقتلك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: أعني، الحماية من الزوار. ومن الأشخاص الذين يطاردونهم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: لا، لا، انتظر. لا أتحدث عن ذلك المختل الذي يحمل بندقية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: لهذا السبب أحتاج إلى أن أتعلم الأمر من شخص يعلمه جيدًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: وأنا خائف مما سيحدث إذا لم أتعلم كيف أقاتل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: قبل أن يضيع كل شيء، لم أكن أؤذي ذبابة حتى. لكن الآن... لا يعيش الأشخاص الضعفاء مثلي طويلًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: لا أقصد أن أبدو كشخص مجنون. الأمر فقط...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: يا إلهي... هل أبدو... غريبًا في نظرك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: مَن الذي تحاول حماية نفسك منه بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: لماذا أنت مهووس بالقتل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: وحينها لن أكون أنا من يعيش في خوف... بل هم.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: يومًا ما... يومًا ما سأتعلم القتل...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: من حسن حظي أنه لم يرني أيضًا. كان... كان من الممكن أن يكسر رقبتي في الحال.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: الأمر هو... أنني صادفت مجنونًا مسلحًا. شاهدته وهو يستجوب رجلًا. ظل يسأله عما إذا كان زائرًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: يا إلهي... لا تسيء فهمي، لا أحاول أن أثير عداوتك تجاه أي شخص...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: حسنًا! يمكنك القضاء على أي زوار يظهرون إذن!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: مَن الذي تحاول حماية نفسك منه بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: لماذا أنت مهووس بالقتل؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: أراهن أنك تستطيع حتى خنق شخص ما بيديك العاريتين، إذا لزم الأمر.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: لكنني أسمع الجدية في صوتك. أعتقد أنك قد تسحب الزناد إذا اضطررت إلى ذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: مَن سيلومك لقتلك أي شخص في نهاية العالم؟ سيكون ذلك مثل توزيع مخالفات السرعة في مضمار السباق.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: الأمر هو... أن هذه أوقات خطرة، ويجب أن تعرف كيف تستطيع الدفاع عن نفسك. وكيف تتعامل مع أي تهديدات محتملة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: أوه... أنا آسف. لم أقصد أن أكون فظًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: نعم، لديّ سلاح ناري
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: لماذا تريد أن تعرف؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: هل أنت مسلح؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: مرحبًا يا صديقي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: أتعلم شيئًا؟ تبًا لك. سأطلب من أحد جيرانك السماح لي بالدخول.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: ما مشكلتك يا هذا؟ أبوح لك بأسراري، وتطردني في المقابل؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: هل أنت جاد؟ زوجي يعمل لدى الوكالة الفيدرالية يا أحمق!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: يا إلهي! هل تظن أنني من الزوار!؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: انتظر... ماذا قلت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: بمجرد أن نقضي على كل هؤلاء المجانين، يمكننا العودة إلى العيش بشكل طبيعي، مثل الناس المحترمين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: الآن هذا أفضل!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: قاعدة "عدم وجود نساء في الوكالة الفيدرالية" هراء تام!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: لقد عملت على الحدود. أستطيع تمييز الأشخاص المشبوهين بدقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: هذا ليس عدلًا. ألا يمكن أن أكون بارعة مثل زوجي فقط لأنني امرأة؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: ما المهم في الأمر على أي حال؟ إنه يعمل لدى الوكالة الفيدرالية. ويمكنني أن أعمل هناك أيضًا، لو لم يكونوا رجعيين.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: كما لو أنني سأخبرك. لماذا تريد أن تعرف؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: عليكِ الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: ادخلي
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: قبضت على الكثير من الأوغاد الذين يحملون كل أنواع القذارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: كنت أعمل في الجمارك. أحمي أراضينا على الحدود.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: يا للأسف حقًا. لكنت أبرع في اكتشاف الزوار إلى جانب زوجي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: أتمنى ذلك. لكن لا، إنهم لا يقبلون النساء. هذا متوقع.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: ماذا كان يعمل زوجكِ قبل ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: هل تعملين لدى الوكالة الفيدرالية أيضًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: ثم سلبني سائق الأجرة كل ما أملك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: أردت أن أفاجئه، لذا دفعت ثمن سيارة أجرة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: عندما سمعت أنه تم نقله إلى الوكالة الفيدرالية، كدت أفقد صوابي!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: أوه، سأخبرك بصوت عالٍ وبفخر! إنه يعمل لدى الوكالة الفيدرالية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: ماذا كان يعمل زوجكِ قبل ذلك؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: هل تعملين لدى الوكالة الفيدرالية أيضًا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: بمجرد أن يراه زوجي الذي يعمل في الوكالة الفيدرالية... سيجعله يبلع تلك الأسنان البيضاء اللؤلؤية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: لكنني أقسم إن أسنان سائق التاكسي كانت بيضاء كالخزف.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: اضطررت إلى دفع أموال طائلة أيضًا. هذه الأمور تكلف الكثير من المال هذه الأيام.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: كيف؟ استقللت سيارة أجرة وحسب.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: ماذا يعمل زوجكِ؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: كيف وصلتِ إلى هنا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: اتضح أنه ليس هناك مكان يمكنني البقاء فيه حيث يعمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: فكرت في أن أفاجئه بزيارة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: جئت إلى المدينة لرؤية زوجي. حيث انتقل إلى هنا للعمل.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: مرحبًا. أتمانع إن بقيت عندك قليلًا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: حسنًا. لقد وثقت بك... وأنت خذلت ثقتي في الإنسانية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: يستحق الناس معرفة الحقيقة!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: ترتكب خطأ جسيمًا!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: صدقني، لقد رأيت الحقيقة! انسَ كل الأكاذيب التي قيلت لك!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: كنت أعلم أنني أستطيع الوثوق بك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: لذلك غادرت المعهد مرفوع الرأس... ومعي بعض الأرشيفات القيمة في يدي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: سدادات أذن. هذا كل ما كان يلزم لمنع الطفيليات من الزحف إلى رؤوسهم. كان من الممكن إنقاذ الآلاف!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: لكن هؤلاء الحمقى رفضوا الاعتراف بقيمة اكتشافاتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: قلت إن الزوار ليسوا التهديد الحقيقي. بل ما بداخلهم... الطفيليات الدماغية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: كنت أعمل في معهد أبحاث. وطردوني بسبب اكتشافاتي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: لكن عليك أن تقسم إنك لن تخبر أحدًا آخر، اتفقنا؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: حسنًا، سأخبرك. أعتقد أنني أستطيع الوثوق بك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: عليك الرحيل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: ادخل
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: ...الحقيقة وراء الرقائق بنكهة "البطاطس". وهذا يعني أنها طعام مصنوع في معمل!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: تحكم الحكومة في العقول — من خلال الوجبات السريعة. نعم، هذه حقيقة. وأخيرًا...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: تزوير الانتخابات. إثبات أن الهبوط على القمر كان مزيفًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: استعد يا صديقي. ستنفتح عيناك على الحقيقة.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: من أين حصلت على كل هذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: عمَ تتحدث بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: وهذا يعني... أنني أستطيع أن أشاركك شيئًا مهمًا.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: وإذا قلت إنك لست معهم، فلا بد أنك تقول الحقيقة، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: من البروتوكولات المتبعة في الوكالة الفيدرالية أن يكشف العملاء عن انتمائهم عندما يُطلب منهم ذلك. إنهم ملزمون بذلك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: أوه، رائع. يعني هذا أنني يمكنني الوثوق بك.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: من أين حصلت على كل هذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: أي نوع من الأسرار؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: نحن نتحدث عن آلاف الأسرار الحكومية — وأنا أخطط لنشرها جميعًا على الملأ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: لديّ بعض الوثائق التي تحتوي على معلومات حساسة للغاية.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: أحتاج إلى مكان آمن لأختبئ فيه وأواصل بحثي.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: في التحدث عن معلومات مهمة، بالطبع!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: لا، لا أعمل لصالح الوكالة الفيدرالية
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: فيمَ بالضبط؟
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: لا تعمل لصالح الوكالة الفيدرالية، أليس كذلك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: مرحبًا يا هذا. أخبرني... هل يمكنني الوثوق بك؟'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: تفضل، أنا لا أحتاج إليها على أي حال. يمكنك رميها أو استخدامها لشيء آخر.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: إنها مذكرة تأمرنا بالذهاب إلى الحجر الصحي التابع للوكالة الفيدرالية. ولكن لماذا نذهب إذا كان كل من يذهب إليه يموت؟'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: أعطونا هذه الورقة في العمل قبل أن نذهب لإطفاء الحرائق.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: على الأقل لن أموت وحيدًا في العراء.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: لا أعتقد أنني سأزعجك لفترة طويلة. *يسعل*'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: شكرًا يا صديقي. *يسعل*'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
