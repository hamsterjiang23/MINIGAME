      m_Items: []
  - m_Id: 41582931045507594
    m_Localized: 不再理會
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507595
    m_Localized: 拔出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507596
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507597
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507598
    m_Localized: 'Cultist2: 沒錯……我們的生活充滿艱辛、苦難。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507599
    m_Localized: 不再理會
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507600
    m_Localized: 拔出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507601
    m_Localized: 'Cultist2: 我們並不怎麼睡覺。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507602
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507603
    m_Localized: 'Cultist2: 據說，這樣能更為接近它。'
    m_Metadata:
