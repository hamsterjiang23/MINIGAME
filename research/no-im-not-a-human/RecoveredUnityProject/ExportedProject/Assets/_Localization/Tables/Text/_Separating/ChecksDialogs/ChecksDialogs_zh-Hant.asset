  - m_Id: 41582931045507559
    m_Localized: 向其開槍
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507560
    m_Localized: 把話聽完
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507561
    m_Localized: 'Cultist1: 你不該這樣做。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507562
    m_Localized: 向其開槍
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507563
    m_Localized: 把話聽完
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507564
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507565
    m_Localized: 向其開槍
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507566
    m_Localized: 把話聽完
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507567
    m_Localized: 'Cultist1: 勸你就此打住。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507568
    m_Localized: 向其開槍
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507569
    m_Localized: 把話聽完
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507570
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507571
    m_Localized: 向其開槍
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507572
    m_Localized: 把話聽完
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507573
    m_Localized: 'Cultist1: 為何要檢查來、檢查去，自尋煩惱？'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507574
    m_Localized: 'Cultist1: 只要做好離去的準備，靜候時機的到來即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507575
    m_Localized: 'Cultist1: 我不知道你究竟在等待著些什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507576
    m_Localized: 'Cultist1: 我無話可說。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507577
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507578
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507579
    m_Localized: 'Cultist1: 我已經很久沒給自己拍過照了。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507580
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507581
    m_Localized: 'Cultist1: 你會付出相應的代價。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507582
    m_Localized: 'Cultist1: 這是一個嚴重的錯誤。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507583
    m_Localized: 'Cultist2: 沒有必要感到害怕。我們將會啟程邁向更加美好的生活。我們都將獲得救贖。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507584
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507585
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507586
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507587
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507588
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507589
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507590
    m_Localized: 'Cultist2: 好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507591
    m_Localized: 'Cultist2: 稍微有點東倒西歪……而且，大概要比正常的尺寸稍大一些。'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507592
    m_Localized: 'Cultist2: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507593
    m_Localized: 'Cultist2: ……'
