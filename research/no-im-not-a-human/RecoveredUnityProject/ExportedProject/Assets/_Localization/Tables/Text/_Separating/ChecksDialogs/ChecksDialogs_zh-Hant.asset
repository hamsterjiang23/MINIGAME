%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_zh-Hant
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-Hant
  m_SharedData: {fileID: 11400000, guid: 1290f85681bd44940af0abf2b1b05504, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: *咳嗽*沒問題，我也沒有什麼東西可以隱藏的——畢竟早就全都被燒毀了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: 看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: 不過，*咳嗽*也別太挑剔了——畢竟，我吸了滿滿一肺的煙……而不是去看什麼牙醫。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: 來，看吧……*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: 就如同兩根烤成焦炭的木頭、上面長了幾根燻黑的枝椏一樣。不過，指甲倒是出奇地乾淨——挺諷刺的，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: 沒問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: 如何？*咳嗽*通紅得跟兩塊燒得正旺的煤球，對吧？都是被煙霧薰成這樣的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: 真假？事先聲明，肯定不會非常賞心悅目。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: 我的皮膚已經裂了開來，與老舊樹皮沒什麼區別。因此……能不抬起雙臂，就不抬起雙臂——畢竟，會非常痛。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: 沒問題，大概只能拍到一具燒焦的屍體吧——一如往常。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: 如何？*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: 好吧，小事一樁——我的耳朵就連軟骨都被燒焦了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: 遲早，我會變得聽不見任何聲響。不過……這樣或許也挺好。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: 想要開槍的話，就隨你高興吧。只是，不要瞄準牙齒——它們早就已經快掉光了，沒必要再受這個罪。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: 隨便你吧——我早就沒有什麼好害怕的了。要是這能讓你感到輕鬆一些的話，就扣下扳機吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: 說不定，這樣反而要比較仁慈……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: 不知，你是否知道這雙手都經歷過什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: 如果這張照片就是對我下達的死刑，那就*咳嗽*趕緊動手吧。我早就沒有什麼好留戀的了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: 萬物均會化為灰燼……看來，下一個就輪到我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: *咳嗽*我一直都沒辦法讓自己的孩子養成每天刷牙的習慣。現在……已經再也沒人會提醒他們了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: 我曾經*咳嗽*以這雙手拯救過無數人的性命，而現在甚至就連杯子也沒有辦法握緊。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: 看來，一切就到此為止了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: 該擁抱死亡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: 森林燃起大火的時候*咳嗽*……只能眼睜睜地看著一草一木盡數化為灰燼——我深知自己對此無能為力。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: 半夜，我總會因為皮膚傳來撕裂般的疼痛而驚醒。不管做什麼，都無法舒緩。大火吞噬了一切……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: 只有回憶能免受大火的焚燒，軀體終將會隨著時間而消散。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: 一旦被持續肆虐的烈焰給團團包圍，就能理解此刻的寧靜是如此的可貴。不是用耳朵去傾聽——而是用靈魂去感受。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: 好吧。無論什麼檢查，我都會盡數通過！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: 來，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: 你有看到過這樣的牙齒嗎？就彷彿——我的嘴巴是個寶庫一般！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: 裡頭的東西不僅是牙齒——而且還是黃金！雖然並非全部都是吧……不過肯定會陸續有來。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: 你知道嗎？其實，用門牙來開啤酒超級簡單。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: 開瓶器？去它的吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: 起碼，我的雙手依然完好。對此，我感到非常的感激。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: 不然，就這輩子都不要想著可以競速了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: 不對。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: 我的手指去哪裡了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: 昨天明明還只是缺了一根而已，其他的幾根到底跑到哪裡去了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: 好吧，罷了——反正會重新長出來的。只是需要一點時間而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: 我的手指沒了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: 雖說不是什麼大事，然而還是令人不快。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: 不過，我的指甲重新長出來了一點——看到了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: 也就是說，我的雙腿也是會重新長出來的！只是，需要一點時間而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: 我該望向哪裡呢——直視你的雙眼嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: 一跳、一跳的，看到了嗎？希望你不要介意吧，我已經養成習慣了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: 當年，還沒失去自己的雙腿、還能令引擎轟鳴時，我就已經沒有辦法將目光專注在……呃，任何東西上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: 看來，我還沒有準備好要就此減速。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: 哎呀。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: 來吧……等等——哈哈哈哈！還真是個不錯的段子！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: 不錯，你已經達到了搞笑的巔峰。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: 我們竟然在互相看對方的腋窩。真是瘋了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: 目前，地獄之火正在肆虐著大地。就好像是……整個宇宙都想將這顆行星給徹底摧毀一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: 再者，還有偽人在虎視眈眈、想把我們給開膛破肚。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: 而你，卻這樣說——「給我看看你的腋窩！」'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: 哈哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: 拍照？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: 雖然不太喜歡，不過無傷大雅。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: 該死，我眨眼了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: 哈哈哈哈——好吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: 我想，你應該也是在新聞報導裡聽到這則資訊的——沒錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: 如何，被我說中了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: 等等——不是？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: 真是……糟糕透頂。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: 好啦、好啦，我再也不會偷偷地拿你的啤酒來喝了。拜託，千萬不要往心裡去啦！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: 你知道像你這樣氣到抓狂、被怒火沖昏了頭腦的人，最後會落得什麼下場嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: 會無法承受，整個人垮掉——最終，像我這樣坐在輪椅上面。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: 要是生氣了的話，不如親自坐上來、出去兜兜風，體會一下這是種什麼樣的感受。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: 為什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: 這樣……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: 對你我都沒有什麼好處。因此，為何要把槍給拿出來？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: 雖然我大概無法以肉眼看清子彈，不過……還是能試著去躲開。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: 我一直都不理解為何大家會把自己給剃光——要知道，毛髮可是我們身體的自然防禦系統。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: 看到這個紅腫了嗎？這裡正在長出新的手指。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: 真正的好戲都還沒來得及上演呢！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: 我們這輩子，到底是在哪裡開始走偏了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: 誰又在乎什麼蠢到家了的照片呢？人生苦短，朋友——不該浪費在這種事情上面！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: 我想說的是……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: 能不能讓我直接離開？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: 好吧，看來我們這是咎由自取。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: 遲早，上帝也會降罪於你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: 我絕對不會就此罷休——絕對！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: 我們這副肉體凡胎，就是這種生理構造——清楚了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: 為何大家之前能對此一笑而過，現在卻要因其而大開殺戒不可？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: 我需要做好心理準備、面對死亡。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: 現在，我的雙手就是自己的引擎。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: 而且，沒有什麼離合器！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: 說實話——一想到自己有可能就連雙手也會失去，就讓我怕得要命。萬一真就如此，我又該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: 失去了一切移動手段、永遠都被困在同一處……我是千百個不願意。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: 即便是死亡，也無法令我如此畏懼。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: 無論如何，我們都跟不上時光流逝的速度。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: 不知，你是否有注意到隨著年齡的增長、時間過得越快？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: 年紀還小的時候，根本就不會急著去追趕生活。那時，一切都如此簡單——不必承擔任何責任，無需作出艱難抉擇。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: 然而現在，不管再怎麼拚命地去追，都已經再也無法趕上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: 不知怎地，我突然一點也笑不出來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: 這一系列荒唐至極的檢查已經把我的熱情給徹底地撲滅了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: 人人都想要拯救這破敗不堪的世界，然而卻無法就具體的方法達成一致。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: 歸根到底，這樣做真的有什麼意義嗎？也許，我們沒有必杞人憂天、只需要把心態放平即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: 看看……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: 我們的這趟旅程已經結束了——難道，你不這麼認為嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: 早就抵達了終點，不久後就會離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: 叮叮——甚至可以透過窗戶見到最後一站。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: 然而，問題是……我們做好準備了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: 我一直在想……呃，先向我保證——你不會生氣，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: 要是……要是就連你也無法判斷這些特徵是確有其事的話，我又憑什麼要去相信？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: 誰知道呢……也許，它們的確都是偽人的特徵——只是，也有可能就是一些鬼扯！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: 雖說，人人都會犯錯——'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: 然而……這種錯，卻有可能會造成非常、非常嚴重的後果。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: 要是……要是你無法確定這些特徵究竟正確與否的話，我又該如何相信之前的檢查沒有問題？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: 也許，都是失之毫釐、謬之千里了呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: 沒錯——我們只不過是普通人，出錯並沒有什麼出奇。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: 然而……這種錯，卻有可能會造成非常、非常嚴重的後果。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: 哪怕只是一點小小的疏忽，都有可能鑄成大錯、最終導致他人喪命。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: 要是你對自己所作出的選擇從未感到一絲後悔的話……我還真的挺羨慕這種自信。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: 沒問題，儘管檢查吧——我沒有什麼可隱瞞的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: 請吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: 我一直都沒怎麼關心過自己的牙齒，因為根本就騰不出這樣的時間。然而現在……我後悔了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: 來，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: 看起來就像鐵鏟，而非手掌——之所以會這樣，都是為了孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: 好的，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: 看到我這大得可怕的眼袋了嗎？全都是因為睡眠不足而造成的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: 好的，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: 我早就已經把除臭劑給通通用光了——千萬不要因此而嫌棄我。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: 我能坐著嗎——不行？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: 蓬頭垢面、脾氣暴躁，一如往常。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: 我已經很久沒有清理過自己的耳朵了。說不定，現在已經堵住了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: 孩子的鬼哭狼嚎早就快要把我給整聾了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: 最近一週以來，只要刷牙、我的牙齦就會開始流血。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: 即便如此，我還是滿嘴黃牙。然而……要是不抽菸的話，又該如何如何承受孩子們的摧殘呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: 只要接觸到清潔產品，我的雙手就會長滿疹子。雖然一直想去看看醫生，卻總是沒辦法騰出時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: 如果能活下來，我甚至願意親自為你熬一鍋湯來慶祝！然而，你卻掏出了槍……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: 哪怕你只是掏一顆手榴彈出來，我也照樣無法睡得安穩。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: 怎麼，難道你是因為我的腋窩太臭了而決定向我開槍？這也太離譜了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: 拜託……真的拍得這麼難看嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: 如果你是因為我的耳朵而想要向我開槍，那你絕對就是個心理變態！不喜歡哪裡，直說就好了——我會拿帽子把它們給蓋住！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: 終於，獲得了一絲安寧——再也不會有人來煩我了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: 真是悲哀……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: 我的一個孩子長了一口完美無瑕的牙齒，卻從來都沒有張嘴笑過。也許，這一切其實根本就與牙齒無關？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: ……一直以來，我以這雙手擁抱每一個孩子、處理各種的家務、抱緊自己的丈夫。你猜怎麼樣——從來沒人對此表示過感激。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: 一旦孩子生病，就會一連數天沒覺好睡。慢慢適應了之後，也就學會了如何活在半夢、半醒的狀態之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: 我曾經因為過度勞累而整整一週都沒有洗澡——我的孩子甚至一點都沒注意到。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: 我曾經找到過一張自己的孩子全部都展露出了笑容的照片。夜幕降臨之後，我常常會一邊看著這張照片、一邊慢慢入睡。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: 我偶爾會想——要是自己聾了的話，就太好了。不過，每當孩子們酣然入睡、美好的寧靜便會降臨……而這，就是生活的意義所在。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: 真假？媽的……好吧，趕緊完事！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: 我一點也不在乎，想怎樣都隨便你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: 黃的？哼——關我屁事。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: 白的？媽的，這也理所當然——我很注意個人衛生！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: 我以前經常會想——如果我的牙齒註定會變成現在這樣，起碼應該去鑲一顆金牙，就像電影裡面的那些硬漢一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: 好、好，隨你的便。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: 如何，一雙強而有力的手——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: 奶奶總說——如此粗壯的雙手、適合砍柴的工作，而不是我一直在做的……其他事業。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: 只是……這裡好像也沒有什麼木頭，我得想辦法把自己的怒氣給釋放出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: 隨你喜歡，看個夠吧——我不在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: 如何，喜歡這雙湛藍的瞳孔嗎？天生便是如此——根本不需要其他的什麼東西就能讓女士們對我著迷。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: 我他媽的一點也不在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: 沒錯，我把腋毛給剃光了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: 哪怕只有一根都會令我感到非常的不自在。媽的，就好像要在那裡長出整片灌木一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: 來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: 怎麼——為何要用這種眼神看著我？媽的，照片上到底顯示了些什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: 媽的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: 為什麼要用這種眼神看著我？難道……出什麼問題了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: 媽的，難道你瘋了不成！我只不過是給你看了牙齒罷了！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: 來啊，看看到底是你先扣下扳機、還是我的拳頭先把你揍翻。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: 媽的，這是什麼意思——難不成是嫉妒了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: 總是癢個不停……就好像是要引我發怒一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: 只要不斷抓撓、直至流血，就會感覺好一些。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: 媽的，我可不會信你的胡言亂語——你不過就是個瘋子！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: 就因為一張蠢到家得照片，你他媽的就要拿槍對著我？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: 媽的——小心點，別到處亂揮這把該死的霰彈槍！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: 不然……有可能會僅僅因為耳朵就不小心把我給射死。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: 真是一個徹頭徹尾的瘋子。好啊——既然如此，就開槍吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: 媽的，真是一個沒心沒肺的雜種。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: 去你媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: 奶奶有著一顆金牙——因此在很小的時候，我就想要給自己也鑲上一個。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: 於嘴裡散發著璀璨的光輝，就好像含著一輪驕陽一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: 據她所說，因為之前的牙齒已經腐爛了、大家才會給她鑲上現在這顆。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: 我感到非常高興，心想——「太棒了！等到我的牙齒腐爛之後，大家也會給我鑲上一顆。」'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: 然後……沒錯，雖然是腐爛了、卻沒人來給我任何東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: 現在，不光沒能把紅日含於嘴裡、這口牙齒也變得無比蠟黃，奇臭無比。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: 看到這些痕跡了嗎？不光沾滿泥土、甚至還有血汙，基本上可以說什麼都有。不過，並非來自他人，而是——我自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: 我的雙手偶爾會變得奇癢無比，恨不得要把上面的皮給扒下來、又或者是對著牆壁猛錘——甚至乎兩者同時進行。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: 我實在是難以抑制這種衝動。不過，不必擔心——我不會因此去傷害任何人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: 看到這些指甲了嗎？不光沾滿泥土、甚至還有血汙，基本上可以說什麼都有。不過，並非來自他人，而是——我自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: 我的雙手偶爾會變得奇癢無比，恨不得要把上面的皮給扒下來、又或者是對著牆壁猛錘——甚至乎兩者同時進行。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: 要是換做別人的話，早就已經開始因此而擔心我了。而我自己，則完全對此不屑一顧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: 因為這對瞳孔呈現的顏色，奶奶總是管我叫天使寶貝。「天使」——你敢信嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: 現在，我站在這個地方、凝視著這雙被稱為心靈之窗的眼睛——無比渾濁，毫無生機，心想——「我到底哪裡像天使了？」'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: 完全可以想像她會以一種什麼樣的眼神來看我——失望透頂。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: 剃刀非常鋒利，足以做到……很多事情。然而，說著容易、做起來難……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: 我曾經不小心劃傷過手臂——之後每次使用剃刀的時候，都會覺得刃口所刮除的不是毛髮、而是自己的血肉。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: 不過，我還是會繼續刮下去就是了……我是真的非常討厭那片灌木。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: 我就連一張奶奶的照片都沒有，她對非常、非常不喜歡這種事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: 據她所說，拍照會攝取精魄。靈魂被鎖進照片後，就再也無法逃脫了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: 我對此嗤之以鼻，告訴她說——「拜託，奶奶。這都是些胡說八道而已。」'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: 而她卻說——「當我死去，你就會一邊看著我的照片、一邊擔心：不知，奶奶的靈魂是否能順利抵達天國？」'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: 唉……去他媽的吧。不光沒拍到照片，奶奶也已經離去。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: 我偶爾會發現自己正無意識地在猛拽耳垂……因為感到了如同烈焰灼燒一般的鑽心疼痛。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: 本以為是出於緊張所導致的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: 然後突然意識到，我其實是想要把這東西給扯下來——就好像它非常礙事一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: 不過——我還沒有瘋到會自殘的程度，沒錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: 沒錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: 哎呀，親愛的……我早就知道你的能量會作出抵抗。不過，就來進行檢查吧——不管怎樣，我都能把你給看透。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: 好的，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: 能反映出自我宇宙的是眼睛，而非牙齒。難不成，你想要從中看清自己的命運？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: 能反映出自我宇宙的是眼睛，而非牙齒。不知，你究竟想要從中看到什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: 好的，儘管看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: 不過，還請小心——我還沒有把被捕夢網給扎到的刺給拔出來呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: 哎呀，我的眼睛？自然是深邃的褐色，一如既往。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: 至於那些紅斑，就得怪月亮了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: 哎呀……還真是造化弄人。好吧，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: 不過……你也知道——現在這個世道，實在是難以分出精力來打理自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: 還請小心——我的氣場很有可能會使你頭暈目眩！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: 不知，覺得如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: 來吧，看吧。不過，還請小心——我的耳朵非常靈敏，甚至就連你的心聲也能聽見。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: 如何，找到答案了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: 只是因為牙齒，就要向我開槍？之所以會這樣，都是因為火星與金星之間的情況變糟了、與我無關——這點，你也清楚吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: 真假——就因雙手扎刺，而要向我開槍？而且，還是來自我寶貴的捕夢網！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: 難道，你瘋了不成？這都是月亮搞的鬼——對此，你不也心知肚明嗎？想要追蹤它的運行軌跡，絕非易事！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: 難道，你瘋了不成？這都是月亮搞的鬼——對此，你不也心知肚明嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: 這根本就不是什麼占星術，而是徹頭徹尾的野蠻行徑！先把槍給放下、然後我再跟你說說自己的其他秘密，如何？當然，全都免費！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: 嘿——是你自己沒準備好，怎麼能怪到我身上！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: 先把這東西給放下，好嗎？觀察耳朵，又能看出個什麼所以然來呢？不要聽信讒言！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: 如果執意想要殺了我的話，就只好……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: 對你下蠱，讓你上吐下瀉、從此苦不堪言！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: 我曾經接待過這樣一位客人——他長了一口完美無缺的牙齒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: 我跟他說——「雖說你的外表光鮮亮麗，然而靈魂可謂腐敗不堪！」想想看，什麼才是最重要的。你應該可以理解吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: 我曾經試過在完成一場儀式之後，花了整整一個晚上把扎進手裡的刺給拔全部出來。雖然很痛，不過——每一根，都像是宇宙賜予我的考驗。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: 眼睛是通往其他世界的門扉。我曾經見過一個這樣的人——他的雙目猶如火炬一般炙熱、發亮。雖說他認為這是自己內心深處的熱愛，然而……只是火星作怪罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: 我曾經試過進行為期三週的苦行生活、一心專注於自己的逸想。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: 思緒會對現實造成衝擊。如此一來，就能事半功倍地達成內心所冀——只需許下合適的願望即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: 現在的狀態……大概跟當時不相上下。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: 我曾經給自己拍過一張照片，看著上面所顯示的神秘圖樣、心想——「這一定是來自群星的啟示！」結果，只不過是閃電剛好劃過了夜空而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: 我的耳朵曾經聽到過某種聲響，就好像是這個世界、甚至整個宇宙在試圖跟我對話一樣。不過，我認為應該是更甚於此的某種存在。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: 我曾經聽到過某種聲響，就好像是這個世界、甚至整個宇宙在試圖跟我對話一樣。結果，只不過是一陣過堂風而已。然而，我還挺喜歡的就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: 想要檢查什麼地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: 想要看看我的牙齒？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: 我以它們捍衛真理！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: 同時，卻也一敗塗地……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: 自己看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: 我會用啤酒來刷牙，裡面的成分能有效地保護琺瑯質。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: 不然，它們早就已經掉光了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: 完全可以理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: 雖說發生了一連串的事情，然而我們還是好好地活著。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: 我們得繼續堅持下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: 怎麼，難道你是在陰處待太久了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: 好好休息一下吧，我的好友。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: 沒有問題，我的好友！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: 盡情欣賞這些指甲吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: 我專門練過，能以其吸收陽光帶來的好處。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: 自然，也可以開啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: 難道，你只是想檢查一下？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: 注視我的雙眼吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: 看到洋溢於其中的陣陣怒火了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: 注視我黝黑、深邃的雙眼吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: 我透過它們來吸收正義之光帶來的好處、將其轉化為自己體內的能量。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: 我的精力，全都來自雙眼！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: 看到洋溢於其中的太陽之力了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: 要是沒看到的話，就是瞎了。試著去凝視太陽，堅持得久一點吧——像我一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: 你想要給我拍照？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: 嗯……嗯、嗯、嗯。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: 不知，是否有人告訴過你——我曾經跟太陽領袖本人打過面照？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: 沒錯，正是我教他如何凝視太陽的。不過，還是晚點再跟你娓娓道來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: 來，拍下我神聖的照片吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: （你給這個邋遢的人拍了一張照片。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: （上面的他蓬頭垢面，一如現實中的本人。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: （沒發現有什麼異常。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: 如此美妙！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: 晚點來一趟吧——我會把自己的生活盡數告知。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: 只要付出一點報酬即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: 我會將其用於保存太陽的能量！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: 好呀，儘管開槍吧——真理會保護我的！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: 把槍給收起來吧，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: 唉……手上沒有啤酒，實在太——難熬了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: 太——難熬了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: 人類——為什麼要這樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: 愚昧至極，無可救藥！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: 什麼以眼還眼……一槍過後，根本就什麼也不剩了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: 哇、哇、哇——你有點太著急下定論了吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: 小心一點，別拿這把東西亂指人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: 等等——你並不喜歡我的雙手？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: 為什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: 既吝嗇、又愚蠢……我想要來幾瓶啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: 大家總愛說——「眼睛不要亂瞟，別去多管閒事」。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: 既然如此，又該怎麼辦呢？難不成，要永遠別開視線？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: 不對，等等……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: 到底……是「眼睛不要亂瞟」、還是「鼻子不要亂聞」？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: 讓我想想……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: 罷了——我不在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: 沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: 不該向太陽開槍！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: 不過——不必擔心，我不會因為這種愚蠢的舉動而生氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: 只要你這裡還有大量的生命之水——啤酒，我們就相安無事！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: 哎呦。真是個喜歡惡作劇的人，嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: 好吧。既然如此，就給你聞個飽好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: 我一直都把自己打理得很好。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: 哎呦。真是個喜歡惡作劇的人，嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: 好吧。既然如此，就給你聞個飽好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: 此為太陽的傑作。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: 以水滋養，維持生命！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: 想要檢查什麼地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: 等等——難道，你要根據我的牙齒來進行判斷？好、好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: 我前不久剛剛矯正過牙齒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: 不過，說實話……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: 我已經不太記得自己什麼時候看的牙醫了。我……真的有去過嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: 天啊，我好害怕——我甚至都已經想不起昨天吃過些什麼東西了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: 如何……特徵對上了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: 我是個偽人？怎麼會這樣，完全沒道理！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: 天啊，我不光丟了工作、被踢出自己的家——現在，就連腦袋都要被轟飛了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: 想、想看看我的指甲？這也太奇怪了吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: 不過，好吧——看吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: 不對，這些都是什麼？泥巴？沒理由啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: 我……根本就不記得自己有挖過地。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: 這些東西是怎麼跑到我的指甲裡面去的？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: 我總不能一連幾天都髒著手到處跑吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: 真是……奇怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: 你能想像嗎？我根本就不記得這些東西是從哪裡來的。我明明一直都坐在這裡、沒離開過你的這棟房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: 難道……有人故意把泥巴塞進了我的指甲縫裡？到底是誰做的？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: 想檢查我的眼睛？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: 我已經猜到你想看什麼了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: 要是我具備某項特徵的話，你打算怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: 平平無奇，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: 我真的是個偽人嗎——照你看來，會是如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: 而且，我為什麼會完全沒有察覺到任何的端倪？難道，人類……就是這樣轉化成偽人的？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: 也許，僅僅是認為自己格格不入、遭到社會排斥……就已經滿足了條件。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: 我……害怕死去。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: 等等，能給我一些繃帶嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: 或者，其他什麼能讓我再稍微撐一會的東西也可以。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: 如果我真的是個偽人，會不會要開始殺人了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: 我會變得很危險嗎？還是說，我其實一直都很危險？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: 也許，我早就已經奪取過他人的性命？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: （你給她拍了一張照片。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: （圖像顯現出來之後，能看到她的身體非常模糊、而背景卻十分清晰。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: （就好像是按下快門時，對方突然畏縮了一樣。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: 哈哈哈——我竟然被嚇了一跳！真是沒想到……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: 現在，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: 到底是要放我一馬、還是把我給收拾掉？不知，你會如何抉擇呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: 為什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: 直接一槍將我給打死不是更簡單嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: 我也不想再待在這裡了，不過卻提不起勇氣離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: 也許……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: 我不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: 要是你扣下扳機的話，我會變成某種更為可怕的東西嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: 也許，我該逃跑。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: 然而，我甚至已經無法確定自己是否人類。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: 我該如何是好？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: 就跟那群霸佔了我房子的那些偽人一樣……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: 不好意思，那時實在是糟糕透頂……我會給你看的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: 我是個人類，沒錯吧？快點告訴我——我是個人類！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: 哈哈哈！要是不管怎樣都會掏出槍來的話，又何必要我給你看這個、看那個呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: 難不成，你以羞辱他人為樂？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: 真是一場夢魘……無論在哪，都不安全。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: 要嘛就是被偽人闖進住處，要嘛就是被一個瘋子拿槍指著、還差點賠上了性命——而且，還是因為腋窩的關係……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: 難道，就沒有人可以站出來安慰我們一下、高呼——「一切都會好起來的」？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: 只要這樣，就會被一口咬定是個偽人？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: 好極……我的這副扭曲的身體總是會把我給坑得夠嗆……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: 全身上下都東歪西扭的，難怪工作時會嚇到別人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: 我上週……好像到醫院去看了背。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: 難道……之後也去看了牙齒？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: 我到底花了多少錢……？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: 想要檢查什麼地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: 想要看看我的牙齒？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: 好吧，看吧——還殘留著香菸的味道和悲傷的氣息。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: 黃得不行，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: 檢查完了，就滾蛋吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: 我不是偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: 沒搞錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: 指甲上沾滿泥巴，竟然是一項特徵？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: 說得好像它們不懂得洗手一樣！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: 按照這種說法，園丁就全都是偽人囉？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: 狗屁不通。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: 喏——要檢查指甲的話，就隨你高興好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: 如何，我是偽人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: 答案——是否定的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: 真是一天比一天離譜。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: 要是我沒睡好、或者哭過，又該怎麼說？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: 我已經搞不懂到底是什麼原理了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: 而且——說說看，如果有一個或者數個特徵對上了，你打算怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: 我今晚就會把自己變成偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: 我會一邊緬懷往日的平靜生活、一邊狠狠地大哭一場。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: 不管是這一系列的特徵檢查，抑或是那些黃色衣服的傢伙……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: 全都……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: 糟糕透頂。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: 難道，你沒意識到一切都正在墮入可怕的深淵嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: 表面上看起來盡在掌控，實則完全處於混亂之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: 好吧，趕緊拍這該死的照吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: （你給他拍了一張照片。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: （對方安靜地坐著。雖然沒有完全把他給拍進去，不過也沒發現有什麼不對勁的地方。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: 我只是很害怕……接下來會發生什麼事。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: 真假？我說，你這傢伙腦子秀逗了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: 看來……FEMA把你給荼毒得不輕，嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: 又或者說，只是單純地醉得神志不清了？沒記錯的話，現在不是已經哪裡都找不到烈酒了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: 好吧——既然你想看，我就給你看！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: 如何，找到自己想要的東西了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: 聞得還痛快嗎？心滿意足了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: 還有——謝謝你沒有說想要檢查一下我的屁股！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: 趕緊完事吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: 蛤？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: 嗯……好吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: 好了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: 能讓我安靜一會了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: 雙手？好的……稍等。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: 一直背著自己的丈夫，雙手早已經又酸又累。這也無可奈何，沒人願意救他。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: 聽著——能不能不要再讓我做這些蠢事了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: 要是想要開槍的話，只管扣下扳機就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: 我早就已經沒有任何能拿來抵抗的力氣了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: 到底是想找些什麼東西——紅腫嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: 來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: 難道只要表現出了哪怕一點的情緒，就證明我是個偽人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: 現在，能打開天窗說亮話了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: 既不可以笑、又不可以哭。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: 甚至，就連偶爾說句話都不行。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: 還能怎麼辦呢——不就只能呆呆地坐在這裡、掩面痛哭了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: 一切，真的會如此簡單地結束嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: 已經，不需要再繼續受苦了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: 然而，我卻沒能拯救你——我的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: 看來，對你來說……這樣並不算是在羞辱他人，嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: 我丈夫活著的時候，沒人向他伸出援手、得不到應有的尊重……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: 然而，當他已經不在了的時候……你們——卻竟然想要紀念他的死亡？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: 我無言以對。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: 想做什麼都隨便你，好了之後就趕緊走。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: （你給她拍了一張照片。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: （沒發現有什麼不對勁的地方。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: （死去的丈夫也被一起拍了進去，這迫使你開始反思生命的意義。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: 給我走吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: 雖然，他很喜歡我的牙齒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: 不過，我還是想要戴牙套。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: 唉……不如就一槍把我給打死吧，怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: 現在這個世道，我們早就忘了該怎麼笑了——難道，就連哭也不允許了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: 你瘋了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: 快告訴我——你瘋了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: 如果那些人面獸心的傢伙要求你跳落懸崖，你也會搶著去做、生怕落於人後嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: 你，還真他媽的……我已經說不出話了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: 如何，不把槍給掏出來嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: 該死。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: 扣下扳機吧——FEMA早已扼殺了我的靈魂，你也不妨就此了結我的肉體。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: 我早就忘記牙套這事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: 直至被要求露出牙齒之後，我才想起這些無心、奇怪的念頭。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: 天啊……我累壞了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: 我把氣撒在了自己身邊的每個人之上，然而……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: 其實，大家都並沒有做錯些什麼——某群雜種除外。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: 我無法理解、也不想理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: 竟然羞辱一個剛剛失去了丈夫的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: 等等……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: 哎喲，你把槍給掏出來啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: 不過，卻沒有把我給殺掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: 怎麼——難道，是缺乏安全感？沒必要以這種方式表現出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: 想要檢查什麼地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: 牙齒？沒有問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: 我的好友是個牙醫。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: 結果，你猜怎麼樣——他被人打掉了所有的牙齒！哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: 哎呀，原來你只是想看一下、不是想聽笑話？好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: 一點問題也沒有，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: 哇哇哇，這是在搞什麼——我也沒說什麼得罪人的事情吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: 而且，只是因為牙齒、就要轟飛我的腦袋……實在是令人費解。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: 再想想吧，嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: 你瘋了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: 混蛋，去你媽的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: 搞什麼鬼？我只是個普通人罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: 我的指甲一點問題都沒有——看到了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: 不要誤會。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: 我有洗手的習慣，只不過是剛剛看到地上有一枚硬幣、撿起來的時候給弄髒了而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: 我的指甲乾淨得很——真的，我晚點就會去洗的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: 我有洗手的習慣，只不過今天恰巧沒時間而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: 我的指甲乾淨得很——真的，絕大多數時間都是。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: 單憑指甲不乾淨，就要把對方殺掉？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: 好吧，我從來沒想過自己會因為這麼愚蠢的理由而死去。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: 想要透過這種方式來辨別那些怪物，好像……有點奇怪。真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: 沒錯，的確能從雙手看出誰是蠢貨。不過，這到底又跟偽人有什麼關係？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: 不光早上9點就得爬下床來、而且起碼還要工作四個小時……媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: 我的眼睛最近出奇地癢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: 大概是太陽害的吧……好像有點不太對勁？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: 該死。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: 看來，是患上某種亂七八糟的爛病了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: 聽著，我想到了一個法子。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: 我們可以要求其他人進貢、從而換取自身的安全。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: 蛤？拜託，兄弟——根本就沒有那麼嚴重啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: 好吧……如果你不喜歡這一法子，我也可以理解。不過，我的眼睛的確是患病了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: 要是你有眼藥水的話，就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: 只是……出於私人理由，我依舊不會去購買就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: 想要拍照？來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: 不過，我對光線非常的敏感、說不定會因此縮一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: （你給他拍了一張照片。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: （看起來沒什麼問題，不過他的面容卻……）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: （非常模糊。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: 我就說吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: 要不要重拍一張？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: 不要坑我——去找其他人的麻煩吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: 看好這些傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: 不然，他們就會放鬆下來、忘記這裡是誰的房子，再也不會買帳。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: 等等！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: 媽的，去你個孬種還有這破爛房子——老子走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: 我會去站在太陽底下，讓你的良心感到不安。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: 活見鬼了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: 這可不是什麼好法子。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: 好吧，這裡你說了算。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: 如何，能下判決了嗎——一切都還好吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: 不再管他
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: 哇哇哇，先等一下！好吧，是這樣的……之前我試著剃了一下腋毛，結果覺得還不錯——因此就養成了這個習慣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: 千萬不要把這件事情告訴其他人。我想……你應該不是那種口無遮攔的人，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: 哇哇哇，先等一下！這……就好像要我給你看自己的內褲一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: 要知道，我並不是什麼野蠻之人——也因此，腋窩絕不可能會一團糟。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: 向他開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: 聽他說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: 我就知道你是個靠得住的人，肯定不會真的對普通人下手。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: 不如，我們也給其他人施加一點壓力吧——怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: 不要？好吧，晚點再說。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: 我知道……不光要去應付偽人、還得處理其他破事，你早就已經不堪重負了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: 而且，之所以會這樣、也是為了我們。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: 無論如何，都不要往心裡去——真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: 想要檢查什麼地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: 我的牙齒？想要看看……我的牙齒？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: 為什麼？爸爸說……我還有一些乳牙呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: 我再也不會哭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: 好吧，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: 為什麼要這樣做？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: 沒有什麼問題吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: 我已經可以自己剪指甲了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: 只不過還沒有很熟練罷了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: 好了，看吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: 挺漂亮的，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: 沒錯，我自己剪的——沒有依賴其他人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: 沒事的話，就先這樣——好嗎？我想自己一個人待著。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: 難道，你能看透我的眼睛？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: 然後，直接讀取我的想法？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: 要是這樣的話，我會非常認真地去思考的——不必擔心。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: 為什麼要露出這種表情？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: 難道，你看、看、看見了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: 你……嗚哇——'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: 我、我、我想喝、喝點東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: 我應該怎麼做？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: （看著她的樣子，你意識到這樣有點太超過了。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: 難道，只是想看看我是否還好？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: 我真的很累——能讓我一個人待著嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: 拍照？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: 我平時基本上都不怎麼拍照。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: 拍完之後給我看看，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: （你給她拍了一張照片。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: （有點模糊。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: （還沒有等你拍好，她就向你跑來了。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: 嗯……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: 謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: 我並不是特別喜歡，不要再讓我拍照了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: 好的——想要怎麼檢查都可以，寶貝。總之，也不會有什麼亂七八糟的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: 我的牙齒？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: 啊——'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: 我以前……特別討厭自己的牙齒，甚至想要給全部拔光。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: 看看我的手指——既不能好好數數、也不能交叉堆疊、更不能精確測量。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: 只不過恰如其分，不至於一無所有。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: 哎呀，寶貝……真的要這樣嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: 眼睛如同窗戶，承載燈火、映照人心。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: 而我的這雙，則早已蒙塵……玻璃破碎、窗簾還早已經被飛蛾蠶食殆盡……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: 還是作罷吧，寶貝——沒什麼好看的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: 呸！竟然讓一個老太太舉起雙手……難道，你就不覺得羞恥？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: 唉……也沒辦法。你是屋主，你說了算。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: 如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: 哎喲，沒有必要在我身上浪費底片吧？畢竟，現在已經很難取得了……哎呀，你堅持如此？好吧，我很樂意！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: 如何，寶貝？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: 哈——還真是個不錯的主意，寶貝！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: 我的耳朵實在是普通得不能再普通了，聽力也和以前一樣、沒什麼變化。不過……我偶爾會感覺自己彷彿已經不存在了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: 就好像只能透過天窗瞥見一樣，而且還飄忽不定。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: 嘿——為何要拿這東西指著我？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: 我早就已經跟風中殘燭沒什麼兩樣了，你竟然還想要把我的牙齒給全部轟掉——是嗎？呸！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: 難道，你以為我會心驚膽裂？難道，你以為我會緊抓雙手？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: 我已經無數次撲空——就連自己的手指都知道我根本就什麼都抓不住。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: 好吧，事已至此……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: 不相信我、想要檢查，對吧？來吧，看吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: 我以前也很喜歡注視他人的雙眼，我現在想起這是一種什麼滋味了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: 哎喲，寶貝——這就像是歲月的印記。每個活到這把年紀的人，都會得到這樣一份「禮物」。難道，你並不知曉？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: 真菌沒有痛覺、無需求食，活著就只是為了活著——跟我一樣，嘿嘿。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: 怎麼，難道就連這樣也會令你大發雷霆嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: 怎麼，寶貝——難道，你還能從耳朵看出個什麼所以然來？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: 好吧，寶貝。想怎麼做、都沒問題。現在這把年紀，也已經看淡了——我早就想去見一見上帝了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: 只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: 我曾經花錢讓醫生取出這口牙齒，結果……他沒有辦法一次性全部拔光。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: 我只好一次又一次地去造訪、他只能一顆又一顆地給拔出……沒有辦法。而現如今，已經沒有醫生能騰出時間來做這種事情了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: 因此，寶貝——我的嘴裡才會是現在的這種狀況。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: 雙手，是為願意將其緊握之人而存在的——而我，已經很久都沒有感受過這樣的喜悅了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: 想要讓我伸出雙手？難道，你自己就搆不著嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: 前往六指謊言者的小屋吧……快進來，沿著這狹窄的籠道往前走……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: 難道，你認為自己能逃離這樣的命運？恐怕，唯有英年早逝——也就是死亡一途吧。不過，你可千萬不要懂什麼歪主意！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: 拜託——你是如此的英俊！毀了這樣的生命，將會是一種罪過。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: 於我那個年代，這種裝置是專屬於有錢人的玩具。然而，現在……就連普通人都能隨便使用了！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: 我無話可說——真是的，竟然無緣無故地給好人找碴……呸！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: 只要別為難我的姊妹就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: 我們這一家人的牙齒都非常好。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: 我還是十幾歲的時候，試過拿牙齒來開啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: 雖然並沒有成功、甚至可以說很慘，不過——我還是學會了要好好呵護自己的牙齒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: 我的姊妹沒辦法自理——因此，事事都由我親力親為。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: 同時需要打理兩人的生活時，我們的雙手又會變成怎樣呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: 沒錯——雖然我的姊妹經常哭泣，不過我們的眼睛還是非常相像。只是，她的眼神要更為柔和一些。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: 對此，我有點擔心。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: 沒錯——雖然我的姊妹經常哭泣，不過我們的眼睛還是非常相像。也就是說，沒有任何的紅腫。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: 也許，她早就已經流乾了眼淚。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: 我會給你看的，不過——不要打擾我的姊妹，好嗎？她實在是太過疲憊了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: 我通常都會剃毛，盡量打理好自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: 即使是在這樣瘋狂的時期也不例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: 我通常都會盡量打理好自己，不過卻忘記把剃刀給帶上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: 而且，目前也不是在意這個的時候。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: 我們兩姊妹什麼大風大浪沒見過——把槍給我收起來。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: 正是因為你這種人，我最近開始抽菸了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: 難道，你以為就只有自己過得不好？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: 難道，你以為能隨便拿槍指著別人？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: 怎麼，你該不會是覺得我的目光有所遊移、又或者是眼神過於空虛？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: 怎麼，你該不會是覺得我的眼神過於空虛？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: 難道，你認為自己有有所不同？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: 冷靜下來、不要衝動行事——我經常跟自己的姊妹這樣說。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: 沒想到，我竟然還得跟你這樣說。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: 先等一下——新聞上真的說這樣的腋窩是偽人的特徵嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: 動動自己的腦子吧，不要像個笨蛋一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: 看來，我的人生將會就此譜下終曲。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: 如此苦澀。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: 生活始終在考驗我們，一切都是如此的艱難。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: 我的姊妹承受不住、早已放棄。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: 現在，我理解了——看來，你陷入了一個進退維谷的境地。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: 然而……要是屈服於恐慌之下的話，你與偽人又有什麼不同呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: 如果繼續像這樣將他人拒於千里之外，將會怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: 我已經受夠了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: 我本以為能在這裡喘口氣，沒有必要再繼續提心吊膽。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: 不過，情況根本沒有任何改變——而且，這一切也似乎沒有要就此結束的意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: 說實話，我自己也很害怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: 未來將如何展開？偽人會消失無蹤、又或者是我們會與它們……「分享」這座城市？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: 快點完事吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: 牙齒
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: 雙手
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: 腋窩
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: 看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: 難道，你是想要把我的牙齒給打掉嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: 我的姊妹會幫我打點好一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: 然而，毫無意義。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: 她就該……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: 她就該讓我自生自滅。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: 我們兩姊妹的眼睛非常相像。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: 不過，她的眼神並沒有這麼空虛。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: 我的姊妹會幫我打理好自己——自然，也包括給腋窩剃毛。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: 看來，並不是白費工夫。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: 不再管她
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: 拿出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: 就是這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: 取走我的性命吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: 沒有必要大費周章。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: 死亡早已近在咫尺。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: 只管交給我就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: 把槍給拿來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: 我會自行了斷。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: 即使閉上了雙眼，空虛也相伴左右。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: 之後，就會轉移給你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: 不知，是否合乎心意？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: 如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: 要扣下扳機嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: 向她開槍
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: 聽她說完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: 怎麼——提不起勇氣嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: 勿忘我們，終有一死。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: 真是遺憾。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: 看來，只能下次再說了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: 真是遺憾。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: 我並不具備相應的特徵。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: 看來，只能下次再說了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: 萬一我們所做的這一切……都只是為了讓黑洞將自身吞噬殆盡呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: 我們將會被吸入視界、無法逃離。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: 永遠都無法迎接滅亡。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: 只有著無盡的痛苦，以及對死亡的希冀。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: 沒有關係。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: 我會繼續耐心等待，渴盼著死期的到來。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: 我的終曲……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: 然而，這本屬於你！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: 這一切本該有個幸福的結局！'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733824
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733825
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733826
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733827
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733828
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733829
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733830
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733831
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733832
    m_Localized: 'Mother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733833
    m_Localized: 'Mother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733834
    m_Localized: 'Mother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733835
    m_Localized: 'Mother: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733836
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733837
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733838
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733839
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733840
    m_Localized: 'FortuneTeller: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752330928128
    m_Localized: 'FortuneTeller: ……'
    m_Metadata:
      m_Items: []
