    m_Localized: 把話聽完
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507631
    m_Localized: 'Cultist2: 哎呀……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507632
    m_Localized: 向其開槍
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507633
    m_Localized: 把話聽完
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507634
    m_Localized: 'Cultist2: 好吧……嘗試新鮮事物，往往伴隨風險。'
    m_Metadata:
      m_Items: []
