  - m_Id: 41582931045507532
    m_Localized: 不再理會
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507533
    m_Localized: 拔出槍來
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507534
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507535
    m_Localized: 'Cultist1: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507536
    m_Localized: 'Cultist1: 我……已經累了，不想再繼續準備下去了。'
    m_Metadata:
      m_Items: []
