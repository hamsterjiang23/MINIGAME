%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_pt-PT
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-PT
  m_SharedData: {fileID: 11400000, guid: 2e47acfd0901bcf4eba15f47b223778b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Ei. *cof cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: Podes deixar-me entrar, amigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: Quem és tu?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: O que te aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: Sou *cof* bombeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: O sol apanhou-me enquanto combatíamos incêndios florestais hoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: O fumo denso ajuda-nos a não sermos queimados vivos, mas *cof* não deixa de ser assustador.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: As árvores... *cof cof* Pegaram fogo como se fossem fósforos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: Nunca vi nada assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: Carcaças de animais a fumegar por toda a floresta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: Por que motivo não estás no hospital?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: O que vais fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Fui apanhado pelo sol da tarde *cof cof* enquanto apagava incêndios.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: Sou o único que restou da minha equipa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Os outros... *cof* O chefe não os deixou sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Agora estão de serviço para sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: Por que motivo não estás no hospital?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: O que vais fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: O hospital? Já não existem hospitais, pá.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: Quando os Visitantes chegaram, os hospitais deixaram de fazer sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: É difícil receberes tratamento quando não confias em quem te trata.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: Ninguém me vai ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Estaria melhor a apagar fogos e a morrer lado a lado com os meus companheiros.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: De qualquer forma, já não me resta muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: Gostava de continuar a apagar incêndios florestais. Preferia ter morrido lá em vez deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Mas deixaram bem claro *cof cof* que o meu tempo acabou.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Já não consigo voltar para casa. Os transportes públicos estão fora de serviço.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: Tenho de contar com a bondade das pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Obrigado, pá. *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: Não penso ficar aqui para te chatear por muito tempo. *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: Pelo menos, não morro deitado num chão encharcado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Merda, pá. *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: Não quero morrer num chão encharcado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: Espero que *cof cof* os incêndios não cheguem às cidades.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: Eeeei!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: Há quanto tempo! Como vai a vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: Eu conheço-te?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: Quem és tu?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Então? Não te lembras de mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: Éramos...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Espera, a tua voz está diferente...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: Há quanto tempo é que esta casa mudou de dono?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Esta casa sempre pertenceu à minha família
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Acho que te enganaste na morada
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Oh, tu não és...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Tu não és o meu amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: Há quanto tempo moras aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Esta casa sempre pertenceu à minha família
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Acho que te enganaste na morada
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: Nah, não digas asneiras.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: Nunca me engano! A minha memória é infalível.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: O meu amigo de certeza que mora... bem, morava aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Ouve, vim de muito longe. Podes deixar-me entrar, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: Nem pensar, não posso...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: Não...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: Raios...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Suponho que me tenha mesmo enganado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Ouve, vim de muito longe. Podes deixar-me entrar, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: É isso mesmo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Vamos fazer corridas em tua casa, não vamos?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: Ir embora? Mas que caralho?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: É simplesmente suposto ir-me embora, caralho?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Ohhh, vou-me pôr a andar. Lunático.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: Chega! Para um bocado e não te mexas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Olá. Por favor, ajuda-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: O que queres de mim?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: Estou exausta. Quero muito ir dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: Tinha cinco filhos. Este é o único que me resta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: O meu marido desapareceu. Não sei se está morto, se nos abandonou ou o que foi que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Agora, só queria deitar-me e dormir durante alguns dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: Para onde foram os teus outros filhos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: Os teus filhos morreram?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Deixa-me entrar. Estou mesmo muito cansada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: Tinha cinco filhos. Este é o último.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: Não sei onde os procurar. Só quero dormir um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: Para onde foram os teus outros filhos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: Os teus filhos morreram?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: Não sei. Se calhar o pai levou-os com ele. Quero ir à casa dele, mas já não consigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Sim, discutíamos muito, mas não é de admirar. Como se vive com alguém que é um cabrão?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Não, esquece-o. Ouve, o mais importante é encontrar os meus filhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: Não, não digas isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: É difícil cuidar de um monte de crianças agitadas, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: Não lhes aconteceu nada. Devem estar em casa da minha mãe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Costumam fugir para lá quando se fartam de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: Ou quando o pai deles me vem pedir dinheiro outra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: Podes deixar-me entrar para poder descansar e ir procurar os meus filhos?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Finalmente. Algum descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Anda, toca a mexer. Escolhe o teu canto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: Partimos amanhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: Está bem. Vou tentar chegar à casa da minha mãe, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Talvez não consiga...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: Não, tenho de conseguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Olá, residente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Estou de mau humor, por isso, peço desculpa desde já.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: Há demasiados idiotas por aí. Espero que não sejas um deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: De quem é que estás a falar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: Não és uma daquelas... coisas, pois não?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: Bem, de toda a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: Os idiotas que só se continham por causa da fé ou do que quer que fosse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: E quando Deus morreu por eles, já não restava nada de humano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Animais de merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Como se esta merda com os Visitantes já não bastasse, ainda temos de lidar com aquela gente também.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: Por que motivo estás tão agitado?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: Em que é que diferes deles?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Boa pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: Deves ter reparado que há dois... tipos de pessoas, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: Um deles é composto por sádicos de merda. Piores do que qualquer Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: Fazem o que lhes apetece: apontam-te uma arma aos cornos, disparam e és menos um!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: O outro é composto só por burros. Podes enxovalhá-los e ainda te agradecem por não os matares.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: E ambos enervam-me profundamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: Por que motivo estás tão agitado?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: Em que é que diferes deles?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: Não me leves a mal. É só que...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Depois da merda que aconteceu com o sol e com a chegada dos Visitantes, parece que a humanidade morreu com Deus.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: E estou chateado... Só queria fazer coisas normais.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Compunha música. Agora, não há ninguém que precise disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Só estou a tentar não fazer parte de nenhum dos dois tipos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: Quero acreditar que sou diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: Sabes, assusta-me como o caralho pensar que posso vir a tornar-me num maníaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: Ou numa vítima. Ambos os lados são uma merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: As vítimas são piores.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Ficam sentadas à espera de levar porrada, de perder os dentes ou pior.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Irias entender de onde vem toda esta minha raiva se tivesses visto o que vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: Não te preocupes, não vou incomodar ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: Nem agredir quem quer que seja.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: A minha raiva é direcionada contra mim mesmo, para que mais ninguém sofra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Caralho, és tão fodido dos cornos como os outros cobardes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Fica para aí parado enquanto te rebentam com a cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: Porra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Sinto que a energia aqui estagnou.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: Algo muito mau.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: O Sol, o Leão, a Quinta Casa. Estou a ver tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: És uma pessoa muito assertiva, não és?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: Hã?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: Não preciso de nada
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Vejo que preferes agir em vez de falar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Típico Leão, não é verdade?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: E acumulaste uma grande carga de energia obscura e desagradável por aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: Ainda não sei bem porquê.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Está tudo tão negligenciado que talvez devêssemos começar com afirmações.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Por que raio é que me estás a pôr isto em cima?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: Ok, e...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: Não estou a sugerir nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: Posso ajudar-te a compreender a relação causa-efeito, percebes?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Karma 6-9, como peixes a girar em torno uns dos outros.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Olho por olho, uma mão lava a outra, percebes?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Por que raio é que me estás a pôr isto em cima?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: Ok, e...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: Compreendo que isto te deixe stressado, tendo tu ascendência em Capricórnio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: Estás a lidar com várias constelações dentro de ti ao mesmo tempo. És uma pessoa complexa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: Podemos usar afirmações para alcançar as profundezas do teu cosmos. Tu percebes, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Depois, tudo se vai encaixar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: Havia guardas prisionais na tua linhagem e noutras vidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Dá-lhes espaço. Só estás a repetir os ciclos das tuas vidas passadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Precisas de os perdoar e de aceitar isso dentro de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Só assim podes quebrar as correntes do ciclo eterno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: Entendeste?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Ótimo. Para ser honesta, estás numa posição excelente aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: Há uma corrente energética a fluir na tua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: Então, não queres trabalhar em ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: Não gostarias de te tornar na tua melhor versão?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Que tragédia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Vou fazer umas afirmações para te dar diarreia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Boa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: Sou da AGEF. Estamos a percorrer o seu bairro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: Está sozinho?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: Por que motivo é que devia confiar em vós?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: Não, claro que não.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: A nossa brigada dividiu-se em pequenos grupos para cobrir mais terreno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: Esta conversa não deverá demorar muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: Por que motivo é que está a usar equipamento de proteção? Também precisamos disso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: De que forma nos vão ajudar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: Posso mostrar-lhe as minhas credenciais.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: E, seja como for, os Visitantes raramente se deslocam em grupos. Se calhar, até nunca o fazem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: Por que motivo é que está a usar equipamento de proteção? Também precisamos disso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: De que forma nos vão ajudar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: Não. Mas pode comprá-lo, se considerar necessário.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: Estamos a estudar o efeito do sol no ambiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: Como estamos muitas vezes ao sol, temos de ter cuidado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: Então e depois?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: Têm um plano de ação?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: A nossa primeira tarefa é recolher dados que deverão ser enviados aos nossos chefes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Em seguida, eles irão desenvolver um procedimento de resposta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: De momento, só têm de manter a calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: Então e depois?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: Têm um plano de ação?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Vou levar uma pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: Vamos fazer-lhe testes para garantir que está tudo bem e que é seguro viver nesta área.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: E, claro, vamos confirmar que a pessoa que levamos é humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: Preciso de fazer a mala?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: Tenho simplesmente de ficar à espera que algo aconteça?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Claro. Não podemos agir por impulso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: Vamos levar uma pessoa do vosso grupo para o nosso laboratório.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: Vamos realizar alguns testes para garantir que está tudo bem e, depois, voltaremos com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: Preciso de fazer a mala?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: Tenho simplesmente de ficar à espera que algo aconteça?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: Esta casa é sua?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: Então, não. Mantenha-se com os outros residentes. Se for necessário evacuar, avisá-lo-emos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Vamos apenas levar uma pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: Uma boa noite para si.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Sim. Quando tivermos todas as informações, daremos mais instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: Não há motivo para preocupações neste momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Vamos apenas levar uma pessoa e tentar trazê-la de volta o mais depressa possível.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: Então, voltamos a encontrar-nos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: Lembro-me de que tudo era diferente da última vez. Mas sobrevivemos...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Hm. É estranho, não sei bem como explicar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Gostava de começar esta conversa com um desafio... uma adivinhação.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: Tenta prever a minha sorte a partir de um livro. Em que página o devo abrir?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Vamos começar pelo início
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Abre no meio
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Abre no fim
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: "Os mortos levantar-se-ão e falarão, mas ninguém dará ouvidos às suas palavras."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Credo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: Não deixa de ser relevante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Embora agora já não seja surpresa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: O que quer isso dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: Acreditas mesmo nisso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: O que raio és tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: Eu? Eu sou eu. E tu? Tu estavas em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Hm. Sim. Uma história de tragédia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: É isto o que nos espera?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: É bem possível.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: O que quer isso dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: Acreditas mesmo nisso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: "Foi há muito tempo. Talvez tenha sido um sonho. Talvez tu, eu e os peixes...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ...apenas existamos na memória de uma pessoa que há muito deixou de existir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Talvez ninguém exista verdadeiramente e esteja apenas a chover lá fora."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Hm. Ou assim poderá ser em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: O que achas? Seremos já o sonho de alguém ou acabaremos simplesmente por nos tornar num?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: É uma frase interessante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: O que quer isso dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: Acreditas mesmo nisso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: Preciso de pensar um pouco. Tens alguma ideia sobre isto?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: Seja como for, vim cá para te dizer uma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Há certas coisas que vão acontecer em breve...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Tens de estar preparado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Eu sei que isto parece estranho, mas tens de deixar entrar a pessoa com um gato.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: Sei, com certeza, que isso te vai ajudar. Ainda não posso dizer como.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: Mas claro, podes fazer o que quiseres com esta informação.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: Por agora, vou pensar sobre o significado da tua escolha de adivinhação.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: Não totalmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: É melhor encarar isto como um aviso. Assim, não te esqueces de fazer algo ou prestas mais atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Enquanto pensava nisso, tive uma visão.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Em breve, vai chegar uma pessoa com um gato. É importante deixá-la entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: Ainda não posso dizer porquê. Mas vai tornar tudo mais fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: Agora, tenho de ir e pensar sobre a tua escolha no livro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Olá, humano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: Que sorte a nossa! Assistimos com os próprios olhos ao castigo da luxúria humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: A Terra está a ser purificada. O sol está a cumprir o seu papel.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: E estamos a caminho de um mundo novo e puro!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: CONTEMPLA A PUTA DESTA BÊNÇÃO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: O quê?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Estás a assustar-me
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: Do que estavas à espera, HUMANO?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Ouve, vou dar-te um pequeno resumo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: O sol não nos anda a queimar e a ESTURRICAR em vão! Está a purificar-nos dos nossos pecados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: Fizemos um caos de tudo e agora ENFURECEMOS O SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: ELE ESTÁ A FAZER-NOS PAGAR POR TUDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: Isto é uma bênção. Todo o pecado vai acabar e viveremos como devíamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: Então... Temos de morrer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: O que te vai acontecer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: Ficaste louco?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Ouve, vou dar-te um pequeno resumo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: O sol não nos anda a queimar e a ESTURRICAR em vão! Está a purificar-nos dos nossos pecados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: Fizemos um caos de tudo, e agora ENFURECEMOS O SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: ELE ESTÁ A FAZER-NOS PAGAR POR TUDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: Isto é uma bênção. Todo o pecado vai acabar e viveremos como devíamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: Então... Temos de morrer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: O que te vai acontecer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: Muito pelo contrário!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Os nossos pecados vão desaparecer. Talvez até o próprio sol. MAS NÓS VAMOS VIVER.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: Já não haverá morte, nem roubo, nem cabrões gananciosos que não me vendem o que quero por um preço justo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: Consegues imaginar? Percebes do que se trata?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: O que é que isso tem a ver comigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: Todos vamos VIVER BEM assim que o sol nos ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: O sol vai ajudar-nos a escapar disto tudo, não percebes?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: Tu percebes, é por isso que ainda estás vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: Vou contar-te muito mais sobre isto!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Ah, esqueci-me de perguntar: tens cerveja?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: Estavas a fingir que não sabias nada sobre o sol ou quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: Então, vai-te foder! VOU SALVAR O-O-OUTRA PESSOA!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: Até depois! ADEUUUS!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: Olá!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Desculpa ser tão tarde... Estava tanto calor hoje que na televisão disseram para não sair ao sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Será que me consegues arranjar aí um espacinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: Quem és tu?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: Como vieste aqui parar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Hum, eu morava perto da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: Claro que a temperatura do asfalto não para de subir por lá, heh. Heh heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: Na verdade, trabalhei como funcionária de caixa. A certa altura. Já não.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: Eles, hum, despediram-me. Tenho tido azar com o trabalho...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: O que vais fazer agora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: O que achas que vai acontecer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: Não é que quisesse vir para cá. Hum, o asfalto já está a derreter debaixo dos pés, mas ainda se aguenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: Vais-te rir, heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: Os Visitantes foram à minha casa. Heh... Imagina! Expulsaram-me da minha própria casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Por isso, agora quero encontrar um sítio onde me possa esconder do sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: O que vais fazer agora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: O que achas que vai acontecer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Hum... Tentar sobreviver. É assustador, claro, com estes Visitantes por todo o lado e o sol a queimar como o inferno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Gostava mesmo de continuar a viver. Heh heh. Uff.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: Não tens medo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Diz-me que isto vai acabar em breve, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: Não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: Será que vou sobreviver? Quem me vai ajudar? Por quanto tempo vou ter de procurar ajuda?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: Não faço ideia do que vai acontecer. Nem sequer consigo imaginar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: Isto não te assusta? A mim apavora-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Obrigada. Haha! Obrigada, a sério!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Vou viver mais um pouco, graças a Deus.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Haha, oooohh, pronto, está bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Obrigada por me ouvires, de qualquer forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: Hum, ok, devia mesmo ir-me embora, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: Adeus? Sim, hum, adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: Posso entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Estava a abrigar-me num bar, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Expulsaram-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: Porquê? Hmph. Nem toda a gente consegue lidar com o meu feitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Mas não magoo ninguém, não te preocupes. É só que... a vida às vezes é uma merda. Sabes como é.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: Então? Posso entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: Não és um Visitante, pois não?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: Tens a certeza de que não vais causar problemas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: Achas que sou um daqueles monstros?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: Não. Não sou um Visitante. Mas perguntar isso diretamente a toda a gente é um disparate do caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: Seja como for, acho que aqui não vai ser diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: Por que motivo é que te expulsaram do abrigo anterior?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: Por que motivo é que achas que aqui vai ser diferente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: O que é que consideras um problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: Assassinatos e porrada não fazem parte da minha maneira de ser. Mas também não deixo que me magoem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Gosto de comer e beber. Gosto de conversar quando estou bem-disposto. Isso é "problema"?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: Por que motivo é que te expulsaram do abrigo anterior?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: Por que motivo é que achas que aqui vai ser diferente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: Pensei em dizer algo mais rude, mas mudei de ideias.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: Já disse: as pessoas de lá não gostavam de mim. Só Deus sabe porquê.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Portanto, pensando bem, ter sido expulso talvez tenha sido pelo melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Podiam ter-me comido vivo e ninguém reparava.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: O que é suposto fazer agora? Fico só ali a queimar ao sol?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: Não, não me parece.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Enquanto for vivo, vou continuar à procura de alguém com quem falar. Se não me deixares entrar, tento noutro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: Se ainda houver sorte neste mundo... ou alguém que não seja um idiota.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Obrigado. Confiar nas pessoas hoje em dia é algo raro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Por isso, agradeço-te a confiança. Talvez... Bem, não posso prometer nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Hm. Percebo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Compreendo, mas não deixo de ficar irritado. És tão cobarde como todos os outros por aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Bons sonhos, oh samaritano. E vai-te foder.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: Posso entrar para descansar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: De onde vens?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: E para onde vais?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: Não me lembro. E também não interessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Estou exausta. Se não descansar, desmaio aqui mesmo debaixo das janelas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: O teu companheiro está doente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: O teu amigo precisa de ajuda?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Eu... Eu só quero cair algures e nunca mais me levantar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: Não interessa onde vou acabar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: O teu companheiro está doente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: O teu amigo precisa de ajuda?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: É o meu marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Está morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: Não lhe consigo dar um enterro digno. Agora, não vale a pena deixá-lo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Já não. Quando ele precisava, ninguém fez nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: Agora, está morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Talvez pudesse ter sobrevivido se...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: Se alguém se tivesse importado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: Acho que não vou ficar muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: Só preciso de descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: Ei!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: Tens visto o que se está a passar? Que loucura do caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: Como é que estás?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: O que queres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: O que é que se está a passar, exatamente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Nada, só curiosidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: Mas tenho uma maneira fácil de ganhares algum dinheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Com esta loucura do sol, dá para fazer dinheiro sem teres de mexer uma palha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: Está tudo cheio de medo de alguma coisa, quando só precisavam era de pôr mãos à obra!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: Por que estás aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: O que sugeres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Novas possibilidades. Não percebes?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Anda tudo por aí feito galinha tonta, quando podiam era fazer as coisas com o coração.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: A malta só precisa de ser feliz, é o que estou a tentar dizer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: Por que estás aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: O que sugeres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: Bem, foste direto ao assunto! Gosto disso!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Toda a gente acha que estás a tramar alguma coisa aqui. A armar merda com mais gente por aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: Podíamos fazer aqui a festa das nossas vidas!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: Queres sobreviver?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Tens de fazer planos enquanto ainda podes, que se foda o sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: Tens de agir, percebes? Vamos lá! O que achas?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Entra
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Devias ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: É isso mesmo, amigo! É disso que estava a falar!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Finalmente, alguém com juízo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: Claramente, és um idiota. Mas tudo bem. Vai para a puta que te pariu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: Vou até à casa do teu vizinho, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Adeusinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Ei, vizinho. Há quanto tempo. Como vai a vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: O mesmo de sempre
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Bem
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Ouve, vim até cá por um motivo. Estou um bocadinho preocupado contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Vem aí coisa má.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: A minha prima telefonou-me. As notícias lá para os lados dela dizem que está a acontecer algo estranho com o sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: E que há pessoas a aparecer do subsolo. Chamam-lhes Visitantes, não sei bem porquê.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: É assustador. Espero que não seja verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: O que está a acontecer com o sol?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Ouve, vim até cá por um motivo. Estou um bocadinho preocupado contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Vem aí coisa má.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: A minha prima telefonou-me. As notícias lá para os lados dela dizem que está a acontecer algo estranho com o sol.'
    m_Metadata:
      m_Items: []
