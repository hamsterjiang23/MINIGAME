%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_pt-BR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 1bdb57fba89c5124a83ad717d0443512, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: Tá quente pra caramba...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: Como você está se sentindo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: Quero verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: E pelo jeito... é ainda pior do que imaginei. *tosse* Que merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: Acho que não vou durar mais que uma semana.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: Embora eu só tenha me sentido um pouco melhor quando você decidiu me deixar entrar, agradeço por isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: Mas... aqui estou eu, sentado enquanto o resto do pessoal morre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: Eu poderia estar lá com eles já que não tenho mesmo nada a perder. Afinal, eu vou morrer...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: Tá quente pra caralho...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: Por que você não voltou para casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: Quero verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: Tenho filhos me esperando em casa. E eu... *tosse*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: Não quero que eles se assustem comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: E eu não quero que *tosse* eles lembrem de mim nesse estado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Prefiro que eles acreditem que morri na floresta, enquanto... *tosse tosse*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: eu apagava os indêndios.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: *tosse* Que minha marca seja a firmeza da paciência que construímos juntos e o valor do trabalho feito com consciência.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: Tá tão... quente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: Cadê o seu uniforme?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: Quero verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: Os chefes levaram. *tosse* Agora não temos mais equipamento o suficiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: Tem muita gente *tosse* morrendo no trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: Nós simplesmente não temos tempo de resgatar nossos colegas. Afinal, *tosse* o fogo consome tudo no fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: E os chefes... estão mais preocupados com a porra de *tosse* um uniforme...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: Eles forjam decretos em sequência, como ferraduras alinhadas. Nenhum deles serve ao povo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: E esse calor infernal...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: De onde vieram os incêndios florestais?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: Quero verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: A floresta anda especialmente seca nos últimos tempos. Assim, *tosse* qualquer faísca vira incêndio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: Os incêndios são apenas *tosse* uma das desgraças que ferra com a gente, assim como aqueles Visitantes que vieram do subsolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: Mas o destino ainda tem muita coisa guardada pra gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: Creio que uma morte tranquila talvez seja o melhor cenário para essa causa perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: Quer saber... *tosse* Eu cogitei levar um presente para casa. Mas, ao invés disso, vou dá-lo para você.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: Este colar aqui, seco e nem um pouco atraente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: Ele é feito de abelhas mortas que transformaram mel em sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: Tà quente demais...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: Você tá só o caco
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: Quero verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: Acho que... minha hora chegou... *tosse tosse*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: Por que não fiquei lá? Eu teria salvo a vida de alguns caras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: Eu podia ter ficado... e trabalhado até cair. Assim eles não precisariam mandar os mais novos para o abate.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: CHEFES DE MERDA! *TOSSE TOSSE*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: É tudo tão... triste.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: Você pode me dar uma última tragada?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: 'Segurar cigarro (dar cigarro) '
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: Você não teria um cigarrinho aí para me arrumar, não?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: Tô zerado, foi mal (não dar cigarro)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: É como dizem por aí: mais uma tragada antes de partir. *Tosse*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (O homem retira um isqueiro de seu bolso, acende o cigarro e começa a fumar.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (Ele dá uma longa tragada e se encosta na parede. Depois de uma pausa, continua.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: Quem dera eu estar com os meus parceiros mais uma vez. Fumando, conversando sobre...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *TOSSE TOSSE*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: Tu não fuma?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: Eu sei, um bombeiro fumante pega mal. *tosse*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: Mas isso agora já não fede e nem cheira.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: Eu só queria *tosse* relaxar um pouco antes de morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (O homem repousa as costas na parede, com seus olhos fixos no teto enquanto fala.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: Que ironia... o bombeiro virou o resgatado. Minha mãe sempre disse para eu ir trabalhar em uma fábrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: Isso não é certo para um bomb...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *TOSSE TOSSE*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: Vagando livre e desimpedido, quem dera eu ser...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: Quem você procura?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: Procuro pelo meu amigo. Nos conhecemos praticamente no berço.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: Ele foi vítima de um acidente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: Contrataram ele para minerar alguma coisa nas montanhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: Eu mesmo não entendo nada sobre isso. E eu não dou a mínima.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: MAS AÍ AS COSTAS DELE FORAM PRO SACO.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: Ele trabalhou tanto nas montanhas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: Que as gaivotas confundiram as... costas deles.. hã...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: Tá, era o rego dele. Elas confundiram o rego dele com um ninho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: Foi mal, são só as vozes na minha cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: Elas contaram essa piada muito bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: Vagando livre e desimpedido, quem dera eu ser...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Hã... tudo certo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: É. Tô esperando minhas pernas crescerem novamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: Olha, a perna direita já começou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: Então eu ficarei aqui por um tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: Eu estava falando sobre as vozes na sua cabeça
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: Certo... então tá
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: Você não entendeu? Era uma piada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: Achei que você ia sacar na hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: Acho que não colou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: Você acabou de perguntar como eu estou me sentindo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: Que gentil da sua parte!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: Ninguém nunca pergunta como eu estou me sentindo ou como foi o meu dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: E isso tudo é por que eu tenho rodas de um CARRO DE FÓRMULA 1 no lugar das pernas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: Ninguém responde isso com sinceridade. Ess é o problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: Eles inventavam desculpas dizendo que estavam só "dando uma conferida" nas minhas pernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: Mas também é uma merda quando eles só ficam encarando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: Mas ignorar minha deficiência é ignorância. Tipo, ela tá aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: Resumindo, precisa haver equilíbrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: Com toda certreza "equilíbrio" é o que não existe na porra da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: Você já parou para pensar em como seria caminhar se você estivesse em uma cadeira de rodas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: Caceta, não foi isso o que eu quis dizer...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: Se você não tivesse pernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: EXATAMENTE. Você não sairia nem de casa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: Como seria subir as escadas? Ou atravessar a rua?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: Esses meios-fios são todos desnivelados.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: Sua casa não tem escadas e soleiras, então posso me locomover facilmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: Cê sabe, eu só queria uma coisa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: Que a sua casa estivesse em um declive.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: Seria hilário cantar pneu em cada canto dela agora e colidir em uma parede, mas isso é só um detalhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: Rapaz, eu adoro correr. Mas você não tem condições de fazer isso, não.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: Ah, calma lá, foi você quem perguntou como eu estou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: E não foi nada mal. Obrigado por perguntar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: Vagando livre e desimpedido, quem dera eu ser...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: Você tá com insolação?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: O que isso tem a ver?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: Meu cabelo não queimou e nem caiu. Tá tudo certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: Eu não posso participar de uma corrida de cadeira de rodas sem pernas. Tá vendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: Como eu vou brecar em alta velocidade ou fazer uma curva fechada se as minhas pernas estão faltando?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: Você não tá com a bunda sentada em uma cadeira de rodas, então me diga, como você entenderia?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: Você realmente acredita nisso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: Por que você acha que suas pernas vão crescer de novo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: É claro que vão!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: Você sabe o que dizem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: A perna direita se apressa, a esquerda fica para trás... E assim seguimos, apenas circulando sem avançar'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: Veja, a minha perna é a prova viva disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: Tudo é igual, um espiral, e não existe um caminho para a saída.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: O dia de hoje termina hoje e um novo começa amanhã. Mas um dia verdadairamente novo algum dia existirá?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: Que se foda. É tudo a mesma coisa. Eu só vivo no ciclo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: Então, parando para pensar... você é realmente diferente de mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: Você também não anda em círculos?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: Olha, a gente vive em um mundo cheio de maravilhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: Até agora só as maravilhas mais tenebrosas... MAS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: As maravilhas tenebrosas terminarão em algum momento e as maravilhas do bem vão começar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: Deus já perdoou um tonel de crentes. Talvez algo melhor aconteça com a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: Vagando livre e desimpedido, quem dera eu ser...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: Como você perdeu as suas pernas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: Lembra do meu amigo na montanhas de quem falei?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: Bom... ele decidiu cavar uma trincheira no próprio jardim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: Deu na telha dele que havia um túnel cheio de carne embaixo de sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: Ele comprou uma broca manual ou algo parecido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: E então ele começou a cavar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: Caralho...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: Essa deve ter sido a última vez que o vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: Vagando livre e desimpedido, quem dera eu ser...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: E as suas pernas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: Fodam-se as pernas. Eu quero saber se ele conseguiu cavar até onde queria chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: Beleza, esquece
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: Sim, é isso. E depois eu fui tomar uma cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: Eu caí e um trólebus decepou minhas pernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: Ou, espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: Não, não foi isso o que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: E você tá calado porque? Não tá curioso, não?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: Então tá, não vou contar. Pra quê te incomodar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: Tá muito abafado aqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: Não tinha uma criança com você?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: Hã? Ela ainda tá comigo. Deve ter ido a algum lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: Eu preciso saber para onde os outros foram e se eles estão bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: Você tem um celular? Eu poderia ligar para o pai delas para nunca mais ter que ver a cara feia dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: Tá muito abafado aqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: E aí? Você ligou para o seu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: Pra quê? Ele só resmungaria, como se não fosse com ele. Nunca ajudou em nada. Tudo sobrou pra mim: as crianças, a casa, o dinheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: Às vezes acho que a gente só se tolerava. Mas ele não me largou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: Acho que por conveniência ou por ele ter medo de receber o que merece.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: Céus, eu tô exausta...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: Tá muito abafado aqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: Você foi ver seu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: Como é? Eu mal consigo levantar da cama. Tá tudo dolorido e eu tô acabada. Às vezes acho que só continuo viva por pura teimosia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Tudo caiu nas minhas costas: as crianças, meu marido, a casa inteira. Mas vez ou outra ele fazia umas coisas que amenizavam um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: Vamos conversar depois. Eu preciso descansar e tô esgotada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: Tá muito abafado aqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: Que tipo de coisas ele fazia?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: Tem esse boato...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: Que ele costumava andar com uma mulher por aí. Eu sabia o que era e tolerei no começo... mas depois comecei a o apurrinhar todo dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: Eu disse que ele estava me traindo e ele decidiu mudar de emprego para me acalmar. Parece que ele me amava, né...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: No entanto, eu posso ter inventado isso tudo. Enfim, preciso descansar. O resto dessa conversa fica para depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: Tá muito abafado aqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: Você não tá preocupada com suas crianças?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Eu tô... mas provavelmente não tanto quanto deveria. A primeira criança... eu não fazia ideia do que ela estava fazendo. Lascou tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: Achei que ia me redimir com a segunda criança. Mas aconteceu a mesma coisa. E o mesmo com a terceira, a quarta...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: Os médicos me disseram que eu não poderia ter filhos, mas quando o segundo veio... eu o batizei de "A oitava maravilha do mundo"!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: Mas então... se tornou... foi horrível...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: Eu... preciso descansar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: Tá muito abafado aqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: O que foi horrível?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: É difícil para mim falar sobre isso... eu amo as crianças, mas... as vezes eu perco o controle. Eu grito e até levanto a mão.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: Eu sei que é horrível e me arrependo pra caramba. Mas... quer saber, pela primeira vez as coisas parecem estar mais tranquilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: As crianças não estão aqui e eu... posso... respirar. Eu não me orgulho em falar isso, mas eu finalmente me sinto aliviada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Puta que pariu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: Então? Já se acalmou?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Sim, eu consigo me acalmar rápido. Mas, assim que eu lembro de alguma coisa que me dá raiva eu já sinto tudo voltando...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: Eu era mais tranquilão, sabe? Era difícil me ofender ou fazer eu perder a linha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Agora, qualquer faísca vira incêndio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: E por que eu deveria manter a calma? Talvez seja essa raiva que ainda me faz manter a sanidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: Pelo menos eu não tô por aí, adorando o sol como um completo imbecil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: Como alguém pode achar que o sol vai salvar a gente? Ele ta é lascando a gente cada vez mais a cada dia que passa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: Tá tudo indo pro saco e a gente indo pra baixa da égua.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: Esses otários não enxergam? Neeeem... Tá, tô de boa. Respirei. Já passou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Valeu por ouvir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Merda...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: De onde é que vem essa raiva toda?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Nem eu mesmo sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Tudo o que tá rolando me deixa puto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: E esses cultistas? Bando de mentirosos desgraçados. Só querem enganar mais gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: E as pessoas sempre acabam acreditando na merda da lorota deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: Tem gente tirando comida da boca dos filhos pra oferecer de sacrifício pro culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: Tudo isso pra agradar algum salvador de merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Lunáticos do caralho. Eles fazem essa lavagem cerebral até mesmo em gente normal, como eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: Enfim, eu tô mais tranquilo agora. Me sinto melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Que merda...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: Os cultistas tiraram alguém de você?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: Não, esse é o ponto. Ela foi até eles por conta própria.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: A minha esposa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Antes dessa bagunça toda, ela era muito religiosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: Mas, eu amava ela, e consegui lidar com toda essa coisa da religiosidade. Isso nunca foi um problema em nosso relacionamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: Mas quando a merda bateu no ventilador, ela encontrou uma nova fé, em um novo salvador.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: A ladainha dos cultistas fez sentido pra ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: Ela enlouquecia mais a cada dia, acreditando em coisas que eu sequer conseguia compreender.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: Quando percebi o que eu tinha feito, ela já tinha fugido de medo. E já era tarde demais para mudar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Cacete...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: O que aconteceu entre você e a sua esposa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: Um dia, minha esposa veio e me falou que estava fazendo parte de um culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: Eu... só não conseguia acreditar, que a mulher que eu amava... tinha se tornado uma pessoa totalmente diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: Foi como se tudo o que a gente construiu junto não significasse nada pra ela. Fiquei furioso, com toda a raiva que o meu corpo conseguia sentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: Fiquei pensando que ela nunca me amou, que ela só estava procurando por alguma maneira de dar no pé. Eu passo mal só de pensar nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: Minhas mãos comprimiram sozinhas... Elas se fecharam como duas pedras, e eu fiz uma coisa que jamais vou me perdoar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: Eu bati nela...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: Não tem como consertar isso. Ela tá no culto, e eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: Nunca vou conseguir digerir o que aconteceu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: PORRA, EU ME ODEIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: Estou melhor me machucando do que machucando os outros. É o preço que pago, é o que mereço.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Cai fora. Eu preciso ficar só.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: Quer que eu leia a sua mão?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: Como é que você sabe tudo isso sobre mim?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: Rá! Você é divertido... Eu não sei de nada. São as estrelas que me usam para se comunicar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: A lua está em Vênus na sua Sexta Casa. Tá vendo? Isso tá escancarado na sua cara. Por mais sutil que seja...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: Eu já conheci alguém como você. Ele sempre escutava mas não dizia uma bendita palavra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: Você sabe, é como eles dizem... se Júpiter estiver na sua Oitava Casa é melhor ficar quieto. É um presságio de portas fechadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: Quer que eu leia a sua mão?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: O que aconteceu com essa pessoa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: Eu disse para ele: "Não importa o que você faça. O que importa é o que a sua aura faz quando você estiver fazendo outras coisas." E ele continuou duvidando de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: E então... a vida o deixou para trás.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: Mas em um certo dia eu fechei meus olhos e imaginei um sonho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: Eu esparramei toda a minha energia nessa imagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: Se você não está de coração aberto para receber energia, então por que raios você habita esse corpo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: Você poderia fazer o mesmo. Fecha os olhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: Imagina que você já alcançou o seu objetivo, você já chegou lá...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Agora mantenha isso em mente e observe com profundidade e atenção...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: Quer saber qual é a raiz do seu sofrimento? É a sua ignorância em não enxergar que o sofrimento é a forma mais crua da felicidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: Então... você consegue está pronto para dar esse passo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: Quer que eu leia a sua mão?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: O que significa "estar pronto"?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: Significa priorizar e escolher você. Tá sentindo esse cheiro? É o odor dos seus sonhos não realizados. É hora de deixá-los sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: Certa vez, quando eu tava no fundo do poço e sem a centelha de qualquer significado, o meu mentor me disse uma coisa: "Você não está ouvindo o seu oceano."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: De primeira, eu dei uma risada. Oceano? Mas então eu fechei meus olhos e consegui escutar. Como se estivesse ali o tempo todo. Você também consegue!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: Mas a coisa mais importante de todas é perguntar a você mesmo: você está preparado para se tornar um com o seu próprio eu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: Quer que eu leia a sua mão?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: Quem foi o seu mentor?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: Uma mulher incrível. Era como um raio de luz no meio escuridão. Ela me ensinou a enxergar a essência das coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: As palavras delas ecoarão para sempre em minha mente: “As pessoas só morrem por não aprenderem a inspirar a luz interior.”'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: Ela me fez entender. Eu poderia ser útil ajudando as pessoas a encontrarem seus verdadeiros caminhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: Mas, né, ela teve medo de ir além.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: Ela não se enxergava no centro. E é importante estar no centro, sabe?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: Se você não é o o centro do universo então me diga, quem é você? Você entende, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: Quer que eu leia a sua mão?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: Como você saiu dessa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: Todos os seus erros são apenas códigos no seu próprio universo e que ainda não foram decifrados por você.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: Eu fui pelo caminho mais difícil. Dá uma olhada ao seu redor. Você vê como essa casa está agora, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Iluminada, ampla e em harmonia com a minha energia. Não é preciso lutar com essa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: Ela já absorveu o seu medo. Aceite-a ou as paredes vão chorar lágrimas que são suas. Entendeu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: Quer que eu leia a sua mão?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: O que você quer de mim?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Ah, nossa, você tá achando que eu quero alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: O lance é que se você ver a sua própria sombra dançar você entenderia onde o seu caminho se esconde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: Você só precisa recitar afirmativas para a felicidade acontecer. Você consegue sentir que tudo está mudando, né? É mais fácil de respirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: Isso é o resultado da combinação da minha energia com o seu espaço. Não tente entender. É uma ilusão para os que temem a chegada e a aceitação do caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: Estou pedindo para que você se torne parte desse espaço. Diga: "Eu não sou só um convidado aqui; Eu sou o criador desse lugar."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: Quer que eu leia a sua mão?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: E se eu não quiser ser um criador?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: Suas paredes há muito querem abraçá-lo, mas você as confina com as correntes do seu controle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: O silêncio dentro de você é a voz do universo que você está sufocando com o seu medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: A sua energia fica presa como o mel da abelha congela no inverno. Você precisa descongelar com a sua respiração. E os espelhos não mentem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: Se tudo o que você vê é você mesmo, você não vê nada. Tudo o que você precisa fazer é deslocar sua energia três graus para a direita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: E, finalmente, você será feliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: Estou ouvindo, humano. Diga!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: Você faz parte de algum tipo de "fé"?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: SIM, HUMANO! Mas a minha fé não é como as religiões que você conhece.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: Eu venero O PRÓPRIO SOL SAGRADO! POIS NOS AMA E NOS PROTEGE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: Mas, os ignorante só vêem o lado ruim da coisa. Eles acham que o sol vai "incinerar todo mundo"...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: PAPO FURADO! Sua raiva é dirigida às sementes do mal e aos hereges! Pois eles pecam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: Que aqueles que discordam nunca se encontrem sob seus raios escaldantes da salvação!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: Eles procuram as chamas e ficam surpresos ao sentir a dor da queimadura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: Sementes do mal?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: Hereges?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: Você ainda tá fazendo pergunta? Você não sabe QUEM SÃO OS ALIENÍGENAS?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Certo, humano. Eu vou te contar a MAIS PURA VERDADE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: OS VISITANTES SÃO SEMENTES DO MAL!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: ELES SÃO DESCENDENTES DE ALIENÍGENAS que pousaram na Terra quando o Sol adolescia e a relva enverdecia!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: MALDITOS VASSALOS! Que se abrigaram na Terra e consanguinaram por SÉCULOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: E agora, eles saíram e querem tomar NOSSAS TERRAS COMO SE FOSSEM OS DONOS DELAS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: Mas o SOL decidiu nos proteger, pois A TERRA É NOSSA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: Pois o Sol não há de ter PIEDADE com os Visitantes! De outra maneira, por que eles estariam se escondendo no subsolo durante todo esse tempo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Caramba... Por que você ficou tão bêbado naquela noite...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: Você não precisava beber até obliterar. A ira virtuosa do Sol Sagrado, ela...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: SOL SAGRADO, repouse a alma desta criatura e perdoe-a por nossos pecados.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Leve-o para o seu tenro abraço. E talvez a alma da árvore de figueira, a quem ele não poderá mais regar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Amém.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: Você ouviu certo, humano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: A FEMA é uma cambada de HÉREGES malditos!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: Eles interferem em processos que estão além do NOSSO controle, o controle de PESSOAS NORMAIS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: Eles se metem onde não devem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: Que o sol amaldiçoe aqueles otários que jogaram minha mãe naquela poça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: Estou ouvindo, humano. Diga!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: É, de alguma forma o sol queimou gente pra caramba
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: Você está certo. Todas as sementes do mal, humano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: O sol decidiu punir TODOS pelos pecados que as pessoas cometem ao longo de MIL ANOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: E OS VISITANTES, AQUELES VAGABUNDOS ESCROTOS, começaram a alcançar o SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: Mas o SOL não é para eles, os do subterrâneo, e sim para nós, os HUMANOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: ELE É NOSSO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: É UMA BÊNÇÃO PARA A HUMANIDADE, CACETE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: E quantas pessoas mais precisam ser queimadas para acalmar o sol?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: Você está dizendo que o fim do mundo é a justiça do sol?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Tô sim, pra caramba.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: E acredite em mim, meu amigo, isso está LONGE DE TERMINAR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: É APENAS O COMEÇO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: A BALANÇA ainda não está cheia o suficiente para servir de contrapeso contra as FORÇAS DO UNIVERSO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: QUANTO MAIS QUEIMAREM nas brasas virtuosas do SOL, MELHOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: Mas fique ciente, meu caro: essas vítimas não perderão a vida em vão!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Chegará o dia em que todos nós entenderemos os verdadeiros planos do sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Cara, vez ou outra durante a noite me bate uma tristeza, quando lembro que minha esposa me deixou...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: Ela era uma mulher santa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: Mas era também uma vadia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: O fim para quem?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: Para nós?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: Rá!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: Não me faça rir. O SOL ESTÁ DO NOSSO LADO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: Está nos ajudando, você não consegue enxergar isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: Está tentando enviar os Visitantes de volta para o interior da terra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: Punindo pessoas terríveis pelos pecados da humanidade...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: Desmascara hereges em farrapos sujos de mijo, se escondendo vergonhosamente atrás de máscaras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: Devemos agradecer ao sol, e não sair por aí dizendo que o mundo vai acabar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: É O FIM PARA TODOS OS INIMIGOS DO SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: MORTE AOS SUBTERRÂNEOS! MORTE AOS HEREGES MANCHADOS DE MERDA! MORTE ÀS SEMENTES DO MAL!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: Caramba, faz tempo que não como umas batatas fritas ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: Estou ouvindo, humano. Diga!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: Você acha que o que está acontecendo possui algum significado sagrado?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Por que eu expliquei isso tudo de mão beijada para você, humano?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: Só pra você me perguntar A MESMA COISA?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: Acho que me enganei a seu respeito, humano. Você realmente não entende os verdadeiros motivos do que está acontecendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Caralho, queria ter uma cerveja gelada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: Acha que consegue me tratar uma última vez, humano?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: 'Claro, pega aí (dar uma cerveja) '
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: Você não tem cerveja? Tá ficando maluco, humano?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: Eu vi COM MEUS DOIS OLHOS!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: Pô, humano. Beber tanta cerveja e não compartilhar UM golinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: Não vai rolar (não dar cerveja)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ah, beleza...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Humm, isso é bom. Está escuro, do jeito que gosto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Me lembra as saídas para o bar com meus amigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: Papo de qualidade, uma cerveja trincando, umas torradas e um molho de pimenta...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: E o semblante carrancudo daquele cara esquelético, sempre nos encarando com um ar de desaprovação...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Bom, não tem pra quê ficar triste. Você pode ser tapado, humano, mas pelo menos você é gentil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Vou te dar um presentinho de agradecimento. Pega isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: Que o Sol Sagrado salve sua alma!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: Seu DESGRAÇADO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: QUE VOCÊ QUEIME NO INFERNO, SEU FILHO DA PUTA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: A ingratidão! Eu expliquei os significados sagrados para ele, a importância, e ele ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: Você é um HUMANO MALVADO E IMBECIL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Vai se foder. Então fica aqui preso nesse barraco! Eu vou para um lugar melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: Você vai ver, eles vão me aceitar de volta no bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Tenha uma boa estadia, babaca.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: Heh h-heh. Espero que tudo isso acabe logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: Como você perdeu sua casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Ahh, eu lembro bem daquele dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: Foi quando me demitiram. Eu só queria ir pra casa, deitar na cama e chorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: Cheguei em casa e vi umas botas no corredor. Pensei que talvez minha colega de quarto estivesse hospedando algum amigo ou familiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: Eu fui até o quarto dela para saber o que ela estava afim de fazer. Assim que cheguei na porta do quarto, eu ouvi um som estranho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: Me deixou meio desconfortável. Fiquei quieta para ouvir o que estava rolando lá dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: Sò deu tempo de ver o relance da minha colega de quarto estirada na cama, sem se mexer, quando de repente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Um cara desgrenhado me segurou pelas costas e disse: "Você não pode entrar aí. Ela... não tá bem."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: "É melhor a gente ir conversar lá na cozinha". Aí, ele me segurou pelo braço e sentamos na mesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: Eu queria sair, mas o medo me paralisou... E então...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: Eu... ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: Preciso descansar um pouco. Meu estômago tá embrulhando por conta da ansiedade. Uuf...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: Heh h-heh. Espero que tudo isso termine logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: Então, o que aconteceu na sua casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Uhn...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: Depois que aquele homem me sentou na mesa da cozinha, um homem enorme que estava escondido no canto do corredor bloqueou a saída.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: Ele começou a falar alto com o cara que tava me segurando pelo braço.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: É... É como se eu nem estivesse ali. Depois disso... eles começaram a tocar em mim!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: Meus braços, meus ombros...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: E ouvi ao fundo um barulho de palmas e uma gargalhada, que pareciam vir do meu quarto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: Parecia que... havia uma torcida inteira de homens lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: Minha respiração ficou curta. O meu coração palpitava e estava quase saindo pela minha boca.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: Eu queria gritar e pedir ajuda, mas a minha voz... O medo me paralisou... ao ponto de não conseguir fazer qualquer som.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: Eu sentei lá, inútil como uma bonequinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: Mas, quando o grandão foi até a geladeira pegar alguma coisa eu vi que era a minha oportunidade...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: Eu corri pra sair dali. Era como se o medo me desse força para agir e eu corri... sem olhar pra trás.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: Até que a minha energia se esgotou e eu caí no chão...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: Por que o sol não queimou você?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: O que aconteceu depois?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: Não lembro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: Devo ter passado a noite inteira lá, e então...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: É estranho... Eu poderia jurar que eu lembrava de tudo o que aconteceu comigo naquele dia...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Pera, você não acha que eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: Eu posso ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: Isso não pode ser verdade. Eu tenho lembranças da minha vida. Minha infância, os meus pais. Não, não!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: Eu não sou um Visitante, tá bom? Me diz que eu não sou um Visitante!?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: Eu não sei
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: Você não é um Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: Você parece ser um Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: Eu estava deitada no chão, e então...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Então...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: Eu realmente achei que lembrava de tudo o que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Pera, você não tá achando que eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: Eu posso ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: Isso não pode ser verdade. Eu tenho lembranças da minha vida. Minha infância, os meus pais. Não, não!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: Eu não sou um Visitante, tá bom? Me diz que eu não sou um Visitante!?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: Eu não sei
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: Você não é um Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: Você parece ser um Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: POR QUE VOCÊ DIRIA ISSO?! Ai, meu deus, eu tô com medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: Eu preciso descansar. Meu estômago tá embrulhando de novo. Uuf...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Obrigado, isso faz eu me sentir melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Uh, eu preciso descansar. Meu estômago tá embrulhando de novo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: POR QUE VOCÊ DIRIA ISSO?! Agora eu tô com mais medo ainda!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: EU NÃO QUERO MORRER! EU NÃO QUERO MORRER!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: Todo mundo vai morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: Heh h-heh. Espero que tudo isso termine logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: Você tá bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: NÃO DÊ MAIS NEM UM PASSO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Desculpa, eu... Eu pensei que você fosse me matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: O que te faz pensar isso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: Você já teria morrido a muito tempo se eu quisesse te matar.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: Não consigo distinguir quem é e quem não é um Visitante... E se...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: E se você for um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: Você vai me matar? Arrancar o meu couro?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: NÃO, POR FAVOR! SÓ ME MATA RÁPIDO E SEM DOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: EU NÃO QUERO MORRER AGONIZANDO. POR FAVOR!!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Calma, eu não sou um Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: Eu não vou matar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: Foi mal, eu tô com os nervos à flor da pele.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: Eu não sei em quem eu posso confiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: E se...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: E se você for um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: Você vai me matar? Arrancar o meu couro?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: NÃO, POR FAVOR! ME DÊ UMA MORTE RÁPIDA E INDOLOR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: EU NÃO QUERO MORRER AGONIZANDO. POR FAVOR!!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Calma, eu não sou um Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: Eu não vou matar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: E COMO EU VOU SABER DISSO?! Eu não verifiquei os seus dentes ou os seus olhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: A morte vai vir para todo mundo, seja pelos Visitantes ou pelo sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: Já não existe mais esperança. A morte tá batendo na porta, não importa o que a gente tente fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: Me deixa em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: E COMO EU VOU SABER DISSO?! Eu não verifiquei os seus dentes ou os seus olhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: A morte vai vir para todo mundo, seja pelos Visitantes ou pelo sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: Já não existe mais esperança. A morte tá batendo na porta, não importa o que a gente tente fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: Me deixa em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: Heh h-heh. Espero que tudo isso acabe logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: O que tá rolando com você?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: OS VISITANTES! ELES ESTÃO VINDO PEGAR A GENTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: Tu não consegue escutar? A MORTE TÁ CHAMANDO O NOSSO NOME.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: VISITANTE, HUMANO... EXISTE ALGUMA DIFERENÇA?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: SOMOS TODOS IGUAIS ANTES DE MORRER.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: Me diz, por que nos torturar esperando? QUE ELES VENHAM! HAHAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: ELES SÓ QUEREM O MELHOR PRA GENTE! QUE VENHAM OS VISITANTES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: Você não parece bem
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: Você enlouqueceu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: NÃO, EU ACABEI DE PRESENCIAR A LUZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: EU SOU UM VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: NÓS SOMOS UM COM OS HUMANOS. NÓS SOMOS TÃO PARECIDOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: SOMOS O REFLEXO DA MESMA IMAGEM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: ACEITEM A MORTE COM A GENTE'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: Eu acho que você não tem ideia do que tá dizendo
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: Você tá me deixando sem escolhas
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: EU NÃO TÔ PIRANDO, EU VI A LUZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: EU SOU UM VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: NÓS SOMOS UM COM OS HUMANOS. NÓS SOMOS TÃO PARECIDOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: SOMOS O REFLEXO DA MESMA IMAGEM!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: ACEITEM A MORTE COM A GENTE! ELA LOGO CHEGARÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: Eu acho que você não tem ideia do que tá dizendo
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: Você tá me deixando sem escolhas
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: Não, você não entende nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: A morte tá chegando! OS ARAUTOS SOLARES ANUNCIAM A CHEGADA DA MORTE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: Presenciaremos isso em pouco tempo. Em muito pouco tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: Então vai, atira! Tá esperando o quê?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: VOCÊ VAI MATAR SEM O MENOR REMORSO?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: Eu não me importo. FAÇA O QUE PRECISA FAZER, HUMANO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: Sim? Você queria alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Então, por que eles te expulsaram do bar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: Hum. Eu culpo a série de catástrofes que dizimou o psicológico de todo mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: O sol explodindo, os Visitantes, a crise econômica... e por aí vai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: Isso fodeu todo mundo. Alguns ficaram estressados e outros se afundaram no álcool.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: Mas comigo? Bom, eu pirei por conta da raiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: Eu subi numa mesa do bar e gritei: "Parem de culpar tudo e todo mundo pela porra dos seus erros!"'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: As lágrimas não fazem diferença na espuma da cerveja, o malte e o lúpulo combinam bem com o sal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: Ninguém liga pra isso, então pra quê se preocupar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: Sim? Você quer perguntar alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: Aqui é pelo menos um pouco melhor?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: Eu não incomodo mais ninguém. Não vale a pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: Quando eu escuto as vozes na TV ou ouço sem querer a conversa dos outros uma lâmpada acende na minha mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: Aí, eu paro e penso... É trabalho demais pra quase nenhuma recompensa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: Não, bom homem, minha paciência já se foi faz tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: A vida já era triste o suficiente sem isso tudo acontecendo, e agora...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: Um dia, vou me enforcar no lustre sobre todo o mundo inteiro batizado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: Sim? Você queria alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: Tá tudo bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: Hein? Por que você tá perguntando isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: Tô sentindo um cheiro em você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: Você tá com febre?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: Bom, eu bebi um pouco da sua cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: Eu não tava me sentindo muito bem e decidi me medicar com uma gelada. Não tem nada de errado com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: É uma confusão muito escrota.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Todo mundo diz que eles estão resolvendo problemas, mas só tão de ladainha. Nada nunca acontece.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: Cê sabe, acho que todos nós vamos morrer logo, logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: Se o sol não torrar a gente, os Visitantes vão fazer o serviço. Se dermos um jeito nos Visitantes a gente vai acabar se enterrando vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: Um problema, quando resolvido, cria um buraco negro. Aí nós vamos e criamos o nosso próprio espaço oco... para preenchermos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Como fascinação mórbida e infinita, enquanto todo mundo caga junto nas calças.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Porra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Sai daqui. Tô me sentindo mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: Não é em mim que a febre se instalou. Foi na merda do planeta inteiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Para qualquer canto que você olhe, tem gente morrendo. Ou são as calotas polares derrentendo, ou as florestas queimando. O mundo tá com febre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: A Terra tá tentando se livrar da gente como se fôssemos gigantescas pulgas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: Um dia vai dar certo. E pode esperar problema vindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: Urfff...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Vai à merda. Por favor. Eu não tô bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: Sim? Você queria alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: Tá se sentindo um pouco melhor?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: Meu bom homem...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: Todo mundo vai morrer algum dia. Essa é uma verdade inescapável.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: O que você acha que acontece com a gente depois que morremos?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: Acredito que o que tiver que ser, será.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: Um nada, bem vazio.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: Sei lá, talvez a gente acabe no espaço
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: Isso faz um certo sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: Mas isso não faz eu me sentir nem um pouco melhor. Você sabe o por quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: Meu cérebro vai chegar a isso enquanto eu estiver morrendo. Ele vai me mostrar visões de algum paraíso, um lugar melhor que aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: Mas, o que vai acontecer quando a força que uso para me prender a esses frágeis sonhos se esvair?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: Não, eu não me sinto nem um pouco melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: Eu esperava que você fosse dizer outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: Talvez você tenha razão. Mas isso é péssimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: Que não existe nada mesmo... só... o escuro?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: Eu não tô muito a fim de conversar agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: Se você pensar sobre...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: Não existe nada no espaço, a não ser a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: Não tem outra vida. Só existe um espaço frio e vazio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: E se existisse outra vida nós provavelmente já teríamos encontrado algum indício ou coisa do tipo. Sei lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: O espaço vazio da escuridão infinita. Se a gente for parar lá depois de morrer é tipo... desaparecer por completo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: Eu... quero ficar só.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: Sim? Você queria alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: Você... você tá bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: Pelo menos o bar possui vigas altas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: Dá pra se enforcar lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: É tudo muito apertado. Esse planeta inteiro é pequeno demais para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: Meu bom homem, eu só desejo o fim disso tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: É um caos fodido. Eu tenho medo de praticamente tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: Eu só... não consigo aguentar mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: O que me deu na cabeça ao vir até aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: Um descanso cairia bem...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: Tá precisando de alguma coisa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: Que ele esteja vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: Isso é tudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: Isso é tudo o que preciso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: Posso pegar uma água para você?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: Você gostaria de comer um pouco?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: Eu só vou...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: Sentar aqui perto da torneira.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: Eu vou beber, se for preciso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: Vou deixar você em paz, então
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: Eu posso sentar com você?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: Não tô com fome.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: Eu só...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: Eu só quero sentar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: Eu vou deixar você em paz, então
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: Eu posso sentar com você?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: Por que você teve que ir e morrer?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: Você prometeu que tudo iria melhorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: Você disse que tudo ia melhorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: E aí você só... bateu as botas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: Agora eu sou a única que restou para sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: Por que você fez isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: Quero estar ao lado dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: Você não pode me devolver ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: E eu não posso nem...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: Enterrar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: Eu não posso enterrar você.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: O que é que eu faço agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: Eu poderia descansar um pouco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: Como foi que ele morreu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: Não posso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: É demais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: Minhas lágrimas se esgotaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: Não tenho mais lágrimas para chorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: Mas está errado... tudo errado...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: Eu não consigo parar de chorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: Ele precisa ser enterrado
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: Seu marido se foi. Você precisa aceitar isso
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: Não...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: Não, não, não!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: Eu não estou pronta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: Eles acabaram de me devolver ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: Para já termos que nos despedir outra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: Eu não consigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: Não o entregarei para o abraço gélido da terra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: Não.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: Não, isso não é verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: Ele ainda pode me ouvir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: Quero mesmo acreditar nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: Eu poderia descansar um pouco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: O que você lembra dele?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: Teve um dia que fomos para a casa do nosso amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: Nós éramos muito jovens na época.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: Estávamos bebendo, curtindo. Ele geralmente estava de bom humor e não costumava falar tanto assim nessas saídas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: Bom, nós bebemos pra caramba naquele dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: Ele estava quieto, como de costume, e então de repente ele disse:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: Me arruma um violão, eu vou cantar agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: E ele mandou bem. Eu adorei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Nossos amigos começaram a pedir diversas músicas e ele sentou por um momento e então...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: Aí ele levantou e disse que precisava ir, saindo meio nervoso, esbarrou em um copo e derrubou o violão...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: Foi aí que descobri que ele aprendeu uma única música só para me impressionar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: Ainda tenho uma foto daquela noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: Tá um pouco deteriorada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: "Widow: Agora você não pode mais tocar para mim. Você já cantou a sua última canção.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: Eu poderia descansar um pouco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: Então, o que aconteceu com ele?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: Ele morreu, caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: Entendo. Desculpa incomodar você.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: Eu não matei ele
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: Foi mal, eu só não posso...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: As lágrimas me visitam todas as noites. E eu não consigo pará-las.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: Mas o que eu desejo mais do que qualquer coisa são os responsáveis por... tudo o que aconteceu... Eu quero que eles torrem no sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: Então... O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: Eu posso parar de te perguntar sobre isso
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: Sim. Eu sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: Isso foi grosseiro. Mas é tão difícil para mim falar sobre ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: Espero que esses escrotos paguem o preço.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: E alguém arranque a vida deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: Então... O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: Eu posso parar de te perguntar sobre isso
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: Meu marido não estava se sentindo bem. Ele foi até o hospital, mas de lá enviaram ele para aqueles escrotos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: Nós fomos até a nova instalação da FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: Ele foi rapidamente colocado em quarentena, e foi isso. Pegaram o telefone dele. Disseram que o liberariam em três semanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: Eu fui até lá antes das três semanas, só para averiguar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: Eles foram frios quando disseram...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Me dá um minuto. Desculpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: Eles disseram: "Ele morreu".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: Foi isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: Eles não me deixaram ver o corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: Eles não me deixaram levá-lo para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: Mas as coisas são sempre caóticas com esses imbecis, então tudo o que eu tive que fazer foi colocar um jaleco e ir até o necrotério.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: E ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: Ele realmente estava lá...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: Ele foi morto e sua alma está nas mãos deles. Tudo o que posso fazer agora é gritar que eu não ligo mais para porra nenhuma.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: Eu quero ficar só.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Sim, é claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: Viver sem ele é tão difícil...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: Eu poderia descansar um pouco ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: Tá tudo bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: Tô me mandando essa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: Eu te falei que não planejava ficar por tanto tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: Só precisava descansar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: E agora?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: Vai voltar para a família?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: Eu não quero pensar nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: Vou voltar para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: Pegar o violão.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: E então...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: Você pode ficar
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Boa sorte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: Não sobrou ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: Estamos indo para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: Já não quero mais nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: Você pode ficar
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Boa sorte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Por que?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: Isso não vai facilitar as coisas para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: "Widow: Não quero ser rude, mas sou indiferente a você.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: Eu realmente quero ir para casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: Eu não quero fazer nada até voltar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: Obrigada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: Você não fala muito, mas... você acabou sendo uma boa companhia de conversa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: Espero que você encontre o que procura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: Hehe. E aí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: O que você fez antes do cataclismo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: Ahhh, que bom que você perguntou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: Você já ouviu falar sobre...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: apostas esportivas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: Quem é você? Um golpista?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: É isso aí
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: Ei, qualé, cara! Eu sou a porra de um analista esportivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: Se você soubesse o tanto de grana que já caiu na minha mão... você ficaria de queixo caído, meu chapa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: Eu sou profissa no meu negócio, porra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: As pessoas me traziam dinheiro e eu retornava tipo, cinco... não, DEZ vezes mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: E então, quanto você faturou?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: Você chama isso de trabalho?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: Era como eu ganhava o pão de cada dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Ralar com as apostas era só um trabalho que eu precisava fazer, mano. De verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: Existem maneiras de ludibriar os bicheiros.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: Você aposta em um certo time e espera a grana voltar rolando para você.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: E não tem problema se você não tiver dinheiro. É só você pegar emprestado de alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: Então, quanto você faturou?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: Você chama isso de trabalho?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: Como é que eu posso explicar isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: Eu faturei trinta. Fodendo. Milhões...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: Em dívidas, é, mas as dívidas não me incomodam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: E eu tô cagando pra elas agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: Eu jogo bola com o perigo, mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: Você tá de brincadeira comigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: Claro, é trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: Eu tinha até um lugar para fazer isso. Cara, era muito luxo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Um sofá brilhante e um bloco de notas com o nome dos bicheiros, valores de dívidas e o lucro líquido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: Hehe. E aí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: Os cobradores de dívidas ainda não vieram atrás de você?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: Cobradores de dívidas? Que porra você quis dizer com cobradores de dívidas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: Shhh. Deixa eles pra lá. Olha só, eu não tenho mais dívidas. O sol pagou minhas contas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: Os bancos já não são mais grande coisa. Talvez nunca mais sejam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: O que significa que eu tô livre e posso engatar em um novo esquema.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Apostar é coisa do passado. Preciso pensar em outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: O sol te fez um grande favor
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: E daí? Você quer voltar para a vida de fazer esquema, é?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: Caaaaaaaara, qual é.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: Eu só reaveria as perdas e pagaria minhas dívidas. Nada de mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: Mas desta vez eu posso começar do zero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: Aliás, eu tô com um novo esquema. Quer saber qual é?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: Qual é o plano?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: Não me interessa
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: Um tempo atrás eu descobri uma maneira de fazer uma grana. Eu posso compartilhar se você quiser.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: Qual é o plano?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: Não me interessa
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: Resumindo, a FEMA claramente está no controle por aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: Nós precisamos, tipo... ficar em uma boa posição, sabe?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: E eu acho que se nós entregarmos pessoas regularmente eles podem até levar a gente para um bunker.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: Tá me entendendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: Você quer entregar essas pessoas para a FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: Você acha que a FEMA vai te salvar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Claro. Por que não?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: Não seja um cagão.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: Outros tempos, outros esquemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: Estar com o rebanho na zona de quarentena é normalmente uma péssima ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: Por isso, precisamos estar de bem com a FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: Não olhar torto pra eles, entregar as pessoas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Talvez até falar para verificarem por sinais em uma chamada de emergência para que saibam que não sou um daqueles... como é que se chamam? Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: Eles são do bem e provavelmente sabem o que fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: Talvez você tenha razão
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: Soa como muita merda
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: Se você quer tanto ir até eles então pica a mula daqui
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Porra, cara. Você não consegue mesmo sentir o vento que carrega a mudança.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Precisamos saber quem está encarregado da situação e colar neles. É uma estratégia de vencer guerras. No sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: Por isso, precisamos estar de bem com a FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: Não olhar torto pra eles, entregar as pessoas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Talvez até falar para verificarem por sinais em uma chamada de emergência para que saibam que não sou um daqueles Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: Eles são do bem e provavelmente sabem o que fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: Talvez você tenha razão
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: Soa como muita merda
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: Se você quer tanto ir até eles então pica a mula daqui
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: É claro que eu tô certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: Tenho um sexto sentido para esquemas lucrativos, mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Confia em mim, você não vai perder comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: Caaaaaaaara, qual é. Você é uma piada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: As pessoas me pagavam por conselhos sobre investimentos. Eu tô passando o conhecimento de graça para você, te dando a palavra como uma bênção, e você...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Porra. Vai pro inferno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: Diz aí, você vai me despejar ou coisa parecida?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: Pô, eu pensei que você era massa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: Eu te ofereci até um esquema. Mas você...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: Pode ir queimar no inferno, e eu tô voltando pra casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: Porra, esse esquema era bom mesmo. É, faz parte...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Me dá um toque se você mudar de ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: Hehe. E aí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: O que foi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Se liga, arrumei um esquema novo. Vai funcionar. De verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: Beleza, então, basicamente é...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: O sol tá mandando ver hoje, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: Acho que a camada de ozônio deve estar ferrada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: Mas aí lembro que o oxigênio vem da luz solar atravessando o ozônio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: Então, você sabe qual foi a ideia genial que eu tive?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: VENDER OXIGÊNIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: ISSO SIM é um esquema do bom, pode confiar em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Plano do caralho, incrível
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: Nem nos meus piores dias ouvi algo de tão absurdo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: Sério? Você acha mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Acho sim. Você devia ser cientista
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Bom, é...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Valeu. Bom que pelo menos alguma pessoa reconhece que eu sou inteligente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: Eu vou ganhar um Prêmio Darwin em uma piscada de olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: Você... sabe o que é um Prêmio Darwin, certo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Ah, com certeza você vai conseguir um
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Bem... é para, tipo, pessoas que contribuíram para a ciência ou sei lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: Por que você quer saber?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: Por nada
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: Os Prêmios Darwin são para pessoas que morreram de alguma maneira muito estúpida
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: Haha! Eu já consigo sentir o reconhecimento científico.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Um bocado de grana, status social, garotas... Que sonho...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: Issaê, quando tudo isso acabar eu vou patentaer a tecnologia de venda de oxigênio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: Bom, tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Ô, tá de brincadeira comigo, é?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: Vai se lascar. Tô aqui fazendo planos de verdade e você tá aí tirando sarro de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: Vai se foder. Tô aqui pensando em esquemas de verdade e você tá aí tirando onda comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: Receberei o Prêmio Darwin e vou viver como barão.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: Aí você vai cair de boca nos meus pés e implorar por perdão...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: Vai pro caralho com essas ideias de merda.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: Droga, mano...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: Me ouvir é realmente tão difícil assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: Que se foda, não importa. Eu vou faturar mais sem você.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: Droga, mano...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: Vai se foder. Tô aqui pensando em esquemas de verdade e você tá aí tirando onda comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: Receberei o Prêmio Darwin e vou viver como barão.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: Aí você vai cair de boca nos meus pés e implorar por perdão...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: Caramba... Então é mesmo verdade...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: Então é isso, tudo o que eu falei faz sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: Não saia durante o dia. E você precisa deixar as outras pessoas entrarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: E por que eu deixaria estranhos entrarem na minha casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: Deixar as pessoas entrarem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: Eu sei que você mantém distância das pessoas, mas você precisa fazer isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: Minha prima não sabe ao certo por que não podemos estar sozinhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: Mas ela disse que toda vez que alguém perguntar se você está só você responde "não" e diz que tem gente em casa com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: As pessoas são um fardo para mim.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: Qual é a utilidade de pessoas a mais?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: Sim...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: Eu sei que você não curte companhia. Mas você precisa deixá-los entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: Minha prima não sabe ao certo por que não podemos estar sozinhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: Mas ela disse que toda vez que alguém perguntar se você está só você responde "não" e diz que tem gente em casa com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: As pessoas são um fardo para mim.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: Qual é a utilidade de pessoas a mais?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: Eu lembro disso. Eu sei que não vai ser fácil para você, mas é necessário. De outra forma, nós não sobreviveremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: Eles podem trazer alguma coisa ou contar algo de interessante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: E não se esqueça de verificar. Procure por sinais de que eles são Visitantes. Você não vai ter tanta energia durante o dia com esse calor escaldante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: Então, você precisa escolher quem verificar com cautela. Os testes são realmente estafantes. É preciso analisar com muita atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: Mas você não precisa se preocupar com a parte do diálogo. Isso NÃO drena energia. Então, converse o quanto você quiser conversar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: E não esqueça de olhar pelas janelas. A Televisão é um bom recurso, mas não vai noticiar o que está acontecendo perto de você.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: E depois?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: O que precisamos fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: Eles podem trazer alguma coisa ou contar algo de interessante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: E não se esqueça de verificar. Procure por sinais de que eles são Visitantes. Você não vai ter tanta energia durante o dia com esse calor escaldante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: Então, você precisa escolher quem verificar com cautela. Os testes são realmente estafantes. É preciso analisar com muita atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: Mas você não precisa se preocupar com a parte do diálogo. Isso NÃO drena energia. Então, converse o quanto você quiser conversar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: E não esqueça de olhar pelas janelas. A Televisão é um bom recurso, mas não vai noticiar o que está acontecendo perto de você.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: E depois?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: O que precisamos fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: Receio que tudo o que podemos fazer é sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: E torcer para que esse pesadelo termine logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: Acho que o governo vai nos ajudar de alguma forma. Talvez eles levem todo mundo para um abrigo ou algo do tipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: Se isso acontecer, fique com minha família...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: Ah, eu quase esqueci.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: Volto para casa amanhã pela noite. Toma meu número, para você me ligar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: As fiações da linha telefônica foram instaladas recentemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: A gente se fala pelo telefone.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: Certo, agora sim, isso é tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: Aliás, eu trouxe um fardo de cerveja. Meu cunhado trabalha numa fábrica de cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: Bebe aí e vai dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: Vai dar muito sono. Então, se você não quiser falar com mais ninguém, beba uma cerveja e relaxe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: E... eu quero minha m-mamãe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: Me conta o que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: Eu não seeeeeei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: Eles entraram e começaram a falar, e o papai disse que era errado, e eles disseram... eles disseram...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: PAPAI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: PAPAAAAAAAIIIIIIIII!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: Só... tenta descansar agora
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: Amanhã a gente se fala mais, tá?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (A garota chama sem parar pelo pai, e parece que sua crise não vai passar tão cedo.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (A garota não escuta você. Ela está sozinha com a própria dor.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: Eu... Eu quero minha m-mamãe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: Como você está? Você gosta daqui?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: Tá tudo bem aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: Queria tá em casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: Quando eu posso ir pra casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: Depois... estão reformando
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: Não tão cedo. Sua casa queimou até o chão
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: Tá. Então eles vão vir me buscar logo, logo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: E aí vão me levar pra uma casa nova?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: Ou pra mesma?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: Eu vou ganhar um quarto novo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: Então, o papai ainda vai vir me buscar, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: Você sabe o que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: É melhor você ficar aqui por enquanto
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: Mas o papai tá bem?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: E o meu quarto? Ele também pegou fogo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: A mamãe não vai vir nos buscar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: Sobrou mais alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: Você sabe o que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: É melhor você ficar aqui por enquanto
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: Eu não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: Não tenho certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: Eles bateram no papai, mas então ele se levantou. Eu vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: Isso significa... significa que ele poderia ter apagado o fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: Ou só ter vindo me procurar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: Ele vai chegar logo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: Eu não vou pra lugar nenhum sem o papai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: Ele tá vindo me buscar, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: Eu vi ele levantar e sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: Eu estava correndo, mas eu vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: Eu... Eu quero minha m-mamãe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: Você precisa aceitar o que aconteceu
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: Como assim verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: Eu vi uma televisão no seu quarto. Eu posso ver desenho lá?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: Eu não sei o que você viu. Mas eu acho que o seu pai está morto
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: Talvez o seu pai não esteja vindo. Eu não sei o que aconteceu com ele
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: Você não viu nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: Eu tava lá! Ele tava se mexendo quando eu corri.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: E isso quer dizer que ele deve tá chegando já, já!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: E por que ele ainda não veio até você?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: Como ele estava na última vez que você o viu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: Ele não vai vir? Por que você diria isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: E por que ele ainda não veio até você?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: Como ele estava na última vez que você o viu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: Talvez ele tenha alguma coisa para fazer antes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: Ele foi bater naquelas pessoas malvadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: Ele... deve chegar logo, logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: Sinto muito pelo seu pai. Ele era um bom homem, mas gentil demais
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: Certo, é isso mesmo, o seu pai deve chegar em breve
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: Ele era bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: Eles bateram nele... aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: Eu não lembro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: Sinto muito pelo seu pai. Ele era um bom homem, mas gentil demais
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: Certo, é isso mesmo, o seu pai deve chegar em breve
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (O olhar da garota parece atravessar o seu corpo. Você está apreensivo em se mexer, então você só espera que algo aconteça.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (Depois de um tempo, ela começa a chorar. Não há nada que você possa fazer.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (Seria pior fazer ela acreditar em uma mentira. Ela precisa aceitar a situação o mais rápido possível.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: Era o que eu pensava.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (Você percebe que a garota se afastou. Ela está claramente pensando sobre alguma coisa.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (Vale a pena destruir a infância dela? Ela conseguiria resistir a esse fato?)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (Você decide que ela tem problemas o suficiente no momento. Não tem por que preocupar a criança.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: Minha nossa, estou ficando velha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: De onde você é?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: Bem, sim, querido... O que tem de errado com isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: As pessoas se aproveitam das minhas historinhas e depois me odeiam por elas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: Consegue imaginar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: Eu tenho uma casa. Uma cabana.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: Lá é legal, mas vou acabar definhando sem companhia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: E quem virá para a minha cabana?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: Por isso eu ando por aí. Eu não tenho nada a perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: Minha nossa, estou ficando velha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: Por que você não tem parentes?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: As mais corriqueiras. Eu coleciono as histórias de onde vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: Então conta pra eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: Eu já sou uma senhora idosa. Eu não consigo lembrar bem dessas histórias. Eu conto mais tarde do jeito que eu for lembrando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: Eles devem me odiar por isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: Você sabe como dizem: a tristeza em si não é tão difícil de lidar quanto pensar na tristeza se formando na sua mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: Mas eu não sou a única que enfeita histórias, sabe? Hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: Todo mundo virá até mim. Cedo ou tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: Todo mundo precisa de histórias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: Minha nossa, estou ficando velha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: Por que está sem o seu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: O que você quer que eu te conte?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: O homem é uma criatura temerosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: Eu conheci um homem que se trancou longe de tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: Ele morava em um arranha-céu, vivia trancado em seu apartamento e não saía para lugar nenhum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: Ele temia tanto a morte quanto os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: Ninguém nunca foi lá de verdade. De qualquer jeito, ele não deixaria ninguém entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: Certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: Eu ouvi esse barulho. BUUUM.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: De primeira, eu não entendi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: "NotTrue: Olhei pela janela. Ele tinha pulado.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: Ele não aguentou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: O que você gostou dessa história?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: Eu não gostei
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: É só isso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: Deve ser por isso que ninguém gosta de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: Certo, tá tudo bem. Algum dia eu conto sua história, do jeito que eu lembrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: Sim. O homem esparramou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: Ou ele tinha medo de morrer agonizando pelo sol explodindo ou outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: Acho que o coração dele não aguentou a solidão.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: Mas o que se pode fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: Minha nossa, estou ficando velha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: Então como era sentar no banco?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: Tá bom, aí vai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: Quando eu vivia na aldeia, havia um homem lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: Ele adorava caminhar pela floresta. Eu não sei o motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: Mas ele ia. Ele estava andando na floresta mais uma vez quando se deu conta que estava perdido. Não conseguiu encontrar a trilha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: Ele parou para pensar e decidiu que se caminhasse em linha reta ele chegaria em algum lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: Ele andou e andou e andou, mas não encontrou nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: Foi quando ele se deu conta que estava caminhando em círculos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: E depois?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: Isso é muito estúpido
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: Eles o encontraram morto. Ele nunca conseguiu sair de lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: Nós seguimos os rastros dele e concluimos que ele estava só rodando e rodando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: Você sabe o que dizem: "Uma das pernas sempre dá um passo maior."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: E foi assim que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: Por que? Você não gosta da história?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: Bom, eu dei uma aumentada, é claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: Mas isso aconteceu mesmo. E tá acontecendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: As pessoas andam e se perdem, mas como é que eles saem de lá?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: Eu só preciso de força. Se pelo menos houvesse alguém para me emprestar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: Como está a sua irmã?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: Eu tenho que ajudar ela. Com muita coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: Eu consegui dar banho nela ontem. A coitada não conseguiu nem entrar na banheira.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: Nada mudou pra ela. Mas, agradeço por ter perguntado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: A depressão pode fazer com que tudo fique... realmente complicado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: Tenho medo que alguma coisa aconteça e a gente precise dar no pé, ela não vai ter força nem pra se por de pé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: Ou que ela não vai conseguir comer nada, já que ela não tem força nem pra mastigar ou engolir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: Também estou cansada. Acho que vou descansar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: Eu só preciso de força. Se pelo menos houvesse alguém para me emprestar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: O que você vai fazer depois?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: Ótima pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: Meu marido deve vir pegar a gente em breve. Espero que ele consiga encontrar um lugar seguro pra gente se abrigar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: Algum lugar pra gente esperar passar o ataque dos Visitantes e o calor escaldante do sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: Ele falou que lugares assim existem. Falou também que não tem essa de o "sol está explodindo".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: Falou que, se fosse isso mesmo, a gente ia ser varrido da terra em menos de 10 minutos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: Eu acho que ele está certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: Eu só preciso de força. Se pelo menos houvesse alguém para me emprestar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: Alguma notícia sobre o seu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: Eu tô sem notícias dele... Não ligou e nem veio até a gente por algum motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: Será que aconteceu alguma coisa com ele? Será que ele está em perigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: Eu posso garantir que ele não nos abandonou. Isso é impossível.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: Até mesmo quando ele estava de saco cheio da minha irmã, ele ainda me ajudou com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: Ele... deve tá vindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: E, a minha irmã parece um pouco melhor... Então... ele com certeza tá vindo e tudo vai ficar bem quando ele chegar aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: Eu só preciso de força. Se pelo menos houvesse alguém para me emprestar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: Você me parece melancólica
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: Hum?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: Ah, isso não é novidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: A minha mente só tá cheia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: Se o sol não explodir, por que o calor não diminuiu? Por que todo mundo tá pensando só no fim do mundo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: Eu vi o noticiário.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: Eles não disseram diretamente, mas parece que os dias estão ficando cada vez mais quentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: O clima está mudando. O que significa que animais estão morrendo por não conseguirem se adaptar ao novo... clima.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: E o que vai acontecer com a gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: Eu só preciso de força. Se pelo menos houvesse alguém para me emprestar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: Ei, tudo bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: Eu saí ontem a noite para procurar meu marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: Fui em alguns locais onde ele poderia estar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: Eu encontrei ele... Ele tinha tomado um comprimido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: Nós... compramos essas pílulas para tomarmos ao mesmo tempo, caso as coisas ficassem realmente feias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: Ele tomou uma e estava muito assustado. Não chegou nem a me esperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: Ele tomou. Ele engoliu a pílula sozinho antes do sol engolir ele primeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: Esse é o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: Ei, tudo bem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: Sinto que...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: Tem um edredom pesado. Bem pesado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: Pressionando o meu corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: Eu... não quero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: Esse é o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: Você parece mais animada hoje
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: É.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: Você sabia sobre o sol? Que ele está explodindo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: Só descobri essa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: Então, esse é o fim?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: Não vai restar nem mesmo um resquício da nossa existência?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: É interessante pensar nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: Esse é o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: Como está sua irmã?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: Ela tem medo de perder tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: Acho que não temos nada para perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: Nesse universo de constante expansão, somos só grãos de poeira.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: Ninguém precisa da gente por que não existe ninguém além de nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: Se o planeta desaparecer ninguém vai lamentar por nós. E eles não precisam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: Mas a minha irmã tem pavor disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: Esse é o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: Sua irmã está doente?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: Sim. Ela foi procurar o marido para se livrar dos pensamentos intrusivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: Sinto que é uma péssima ideia. Mas ela não consegue só ficar quieta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: Se ela ainda quiser procurar por ele, eu terei que ir também.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: Eu não quero perdê-la antes de todos nós morrermos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: Esse é o fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: Então, você saiu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: Sim. Ela encontrou o corpo do marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: Ele disse a ela que tudo melhoraria, e então ele acabou com a própria vida, com medo do fim verdadeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: Eu acho que já não restam forças nela.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: Agora eu terei que cuidar dela até o dia em que todos nós morreremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: E finalmente não haverá nada mais para se preocupar, temer e se envergonhar.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: Droga...*cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: Ei, amigo... se não for muito problema... poderia ligar para eles? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: .
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: Não estou pedindo para virem me buscar... não estou pedindo por adeus... Só diga para eles...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: Diga que o papai não fugiu. Ele só... ficou onde precisavam dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: *cof cof* Isso é tudo que importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: Por favor, vá em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: O que são esses papéis?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: Você não vai acreditar no que tem nesses arquivos. Algumas coisas são até que... fascinantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: Aqui, por exemplo. Uma teoria particularmente curiosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: Ela diz que os Visitantes não existem de verdade. É tudo parte de um plano do governo para lidar com o excesso de população.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: É uma leitura muito interessante... e estranhamente até meio que faz sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: O excesso de população ainda é um problema, quer nós gostemos ou não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: Talvez isso seja a forma que encontraram de "lidar" com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: Por favor, vá em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: Ainda mergulhado nos seus arquivos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: Precisamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: Tenho muito mais, se tiver interesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: Aqui, olha só esse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: Saca só. Os visitantes *são* a FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: As roupas que usam cobrem tudo. Não tem como testar eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: Fascinante. Eu particularmente gosto do que eles pensam que FEMA significa: Fundação de Eliminação Mundial Absoluta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: Ou era uma outra coisa...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: Por favor, vá em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: Então, o que você descobriu dessa vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: Visitantes: Skinwalkers.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: Parece algo de um livro de ficção científica, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: Mas tem algo aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: Um relato menciona um homem pálido visto andando pelas ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: Mas, devo dizer... o autor cometeu um erro bem óbvio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: Ele diz que haviam DUAS figuras pálidas e desconcertantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: Uma vista pelas janelas, e outra parada na porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: Poxa. Não é óbvio que são a mesma entidade?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: 'Theorist: Eu diria que a janela distorceu a visão. Fez o rosto parecer diferente. Um erro de percepção.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: Ainda assim, é divertido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: Por favor, vá em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: E se for verdade?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: E o que é a verdade, de qualquer forma? É um conceito fluido, moldado por perspectiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: A verdade de uma pessoa é o devaneio de outra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: O que um diz ser bom, outro pode ver como mau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: A humanidade discutiu sobre isso desde sempre. E hoje em dia? A bússola moral está pra todo lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: Se sua crença é forte, como a minha é, ela se torna sua verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: Humm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: Artigo interessante. Mas do que estávamos falando? Ah, sim. A verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: Lembre-se disso. Só há uma verdade: os Visitantes são parasitas cerebrais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: Fique com tampões de orelha. O tempo todo. E tudo vai ficar bem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: De qualquer forma, eu tenho mais leituras para fazer. Não me distraia. Eu preciso focar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: Você disse que trabalhava na alfândega?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: Sim, trabalhei mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: Hein, você já verificou as pessoas por sinais de Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: Que porcaria, isso é tudo uma bobagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: Quem diabos pensou em chamar esses esquisitos de Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: Deviam chamar de algo que combinasse mais com eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: Porque você odeia os Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: Que tipo de pergunta imbecil é essa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: Eles são o motivo pra tudo ter ido pro inferno! Você não assiste as notícias?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: O sol está explodindo, pessoas morrendo nas ruas. Tudo culpa deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: Juro por Deus, eu mataria todos se pudesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: Só me dê um tempo. Vou farejar todos como fazia na fronteira, só observe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: Se pelo menos o pessoal da FEMA me aceitasse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: Porque você quer tanto trabalhar para a FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: Porque eu me importo, essa é a razão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: Eu sei que esses Visitantes podem ser parados. Eles precisam ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: Eu até denunciei meu vizinho. Fiz a coisa certa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: Mas o que eles fizeram? Contrataram meu marido! Não eu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: Não me entenda mal, eu fico muito orgulhosa que meu marido foi escolhido, mas poxa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: Falando a real? Foi como um tapa na cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: Porque você denunciou seu vizinho?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: Eu te falei tudo: ele era um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: E ele me assustava.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: Pra falar a verdade, me senti muito bem denunciando ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: Me lembrou dos velhos tempos na alfândega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: Foi aí que me dei conta que eu preciso entrar para a FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: Não é pelo seu marido que você está aqui. É pela FEMA, né?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: Sim? E daí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: Sim, eu vim causar problemas até alguém no topo da cadeia me escutar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: Eu quero fazer um apelo sobre aquela rejeição de emprego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: Que absurdo! Eu pego o Visitante, faço meu maldito dever cívico, e eles dão o trabalho para ELE?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: Pelo Senhor, eu não entendo. Isso é imbecil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: Eu odeio aquele homem. Odeio ele do fundo do coração.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: Ei, eu tenho um pequeno favor para pedir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: Liga pra eles, que tal? Use a linha interna, eles tem um número especial: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: Diga que você encontrou alguém que é profissional. Uma mulher com experiência e determinação. Diga que eu até achei um novo empregado pra eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: Dá uma exagerada. Fale bem e talvez eles finalmente me deixem fazer algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: O que foi agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: A alfândega era melhor, é? Pelo menos você tinha algum poder lá.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: Ah, vai descendo do salto aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: Eu não perguntei o que você pensa. Você não é melhor que eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: Você quer ser o chefão, é? Essa é a tua casa, o povo vindo até você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: Você dá as ordens aqui, decide quem é Visitante e quem não é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: Mas isso não é a porra do teu trabalho. Isso é coisa da FEMA. Você está brincando de juiz sem credencial nenhuma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: Então me diz aí, como você é melhor que a FEMA? Pelo menos eles tem a autoridade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: Foi o que eu pensei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: Eu... Eu só queria aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: Ainda quer me ver matar Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: A verdade é... que eu mudei de ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: É, eu fiquei assustado. Eu sei. S-sinto muito. Mas percebi que ainda não estou pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: Eu ainda fico enjoado vendo cadáveres. Vai levar um tempo até eu me acostumar com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: É só que... Visitantes... Ouvi dizer que os corpos deles ainda se movem. Depois de morrerem. Como aquele cara... Aquele cara no beco...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: Droga, não posso pensar nisso agora. Ainda não estou pronto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: Eu... Eu só queria aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: Me diga o que aconteceu no beco.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: É... difícil de falar sobre. Mas vou tentar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: Eu achei que os becos seriam mais seguros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: Mas no momento que eu entrei em um, senti como se tivesse entrado em um cemitério.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: Dezenas de corpos atirados lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: Alguns deles ainda se mexendo. Como se não estivessem bem mortos ainda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: E no final do beco, tinha um homem com uma arma, e ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: Não... Chega. Eu não quero lembrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: Eu... Eu só queria aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: Quem era o homem no final do beco?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: Ele era...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: Um homem com um manto, coberto com fios que tinham dedos e dentes pendurados...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: Tinha um jovem ao lado dele. Indefeso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: O homem com o manto gritava com ele, apontando uma arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: Ele obrigava o garoto a mostrar os dentes. E o garoto implorava por piedade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: Eu estava escondido atrás de uma lixeira... E então... eu não sei porque, mas eu me vi no lugar do garoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: Ele estava soluçando, suplicando, implorando pela vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: Então... bang. E o corpo dele caiu, como o resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: Foi aí que me dei conta... Só há dois tipos de pessoas agora. Predadores e presas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: Eu... Eu só queria aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: Sobrevivência não significa se tornar um assassino sanguinário.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: Porque você diria isso? Isso não é verdade!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: Você está vivo porque mostrou suas presas. Você é um predador! É por isso que ninguém se atreve a tocar em você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: Se as pessoas o temem, então está seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: Eu não quero ser uma presa. Eu não quero morrer chorando como um covarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: É por isso que preciso aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: Pai nosso, que estás no céu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: Então, como está a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: Ugh. Deplorável.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: Paredes tortas. E a planta não faz sentido nenhum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: Diga-me, você me colocou de propósito no quarto menor e mais digno de pena que tinha disponível?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: Os móveis estão velhos e se desmanchando. Carcomidos, frouxos, e provavelmente cheios de cupins a esse ponto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: Não dava nem pra pendurar uma cruz em um quarto decente não, é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: Ah, esqueça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: Pai nosso, que estás no céu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: Se você odeia tanto ficar aqui, por que não vai embora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: Você acha que eu escolhi pisar nesse lugar maldito? Se o monastério tivesse ficado de pé, eu jamais teria saído de seu recinto sagrado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: Você acha que eu me importo com essa pocilga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: Se eu tivesse uma escolha, não teria vindo pra cá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: Esse lugar fede a assassinato e morte. E eu aposto que você adora se chafurdar nisso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: Você mata qualquer um que julga ser um demônio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: Talvez você seja um! Com chifre e tudo, só esperando para atacar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: Mas eu não temo. O Senhor todo poderoso cuida dos Seus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: Pai nosso, que estás no céu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: Por que você não ficou no seu monastério?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: Primeiro de tudo, o monastério não é meu. É a casa do Senhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: Em segundo lugar, foram aqueles hereges imundos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: Eles profanaram o local sagrado Dele. Que o fogo do céu os encontre!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: Eles invadiram, expulsaram meu rebanho e a mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: Eles entraram como se fossem donos do lugar. Bárbaros, todos eles!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: Nós vivíamos em paz. Rezávamos, fazíamos jejum, e o trabalho do Senhor. E aqueles animais?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: Bebendo água benta como se fosse vinho barato, sem dúvidas. Que eles se engasguem com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: Que apodreçam no inferno!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: Pai nosso, que estás no céu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: O que aqueles “hereges” queriam?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: Eles vieram com um bando, todos imundos e barulhentos — guinchando como demônios, blasfemando como os brutos ímpios que são!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: E por quê? Porque eu não os deixei entrar! Eu fui bem clara, nenhum pagão cruzará esta soleira!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: Eles ficaram furiosos, ah sim... Bateram nas portas, tentaram arrebentar elas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: Então eles invadiram e me expulsaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: Você expulsou aqueles que precisavam de ajuda?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: Eu teria te expulsado também.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: Um local sagrado não é abrigo para os impuros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: E daí, se buscavam abrigo do sol ou refúgio dos tais Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: Mesmo que caísse fogo dos céus, a casa de Deus não é lugar para aberrações.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: O Senhor mostra piedade apenas para os que tem fé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: E se eles queimassem nas ruas, então que seja. Esse era o seu julgamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: Você é desprezível, mas não é meu trabalho julgar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: É melhor ir embora agora, antes que eu atire em você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: Seu canalha insolente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: Você perdeu o juízo?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: Eu sou uma serva de Deus! Expulsada da casa Dele por vermes pagãos... E você...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: Você ousa me ridicularizar? Dizer que eu merecia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: Você não é um homem. É uma serpente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: HEREGE! VOCÊ É SÓ MAIS UM HEREGE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: Eu esperava que você fosse entender. Mas você não é diferente do resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: Somos nada além de servos! SERVOS DO SENHOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: Não podemos fazer nada a não ser aceitar a vontade Dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: O meios Dele são superiores aos nossos. Jamais iremos entender Seu plano divino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: Você é desprezível, mas não é meu trabalho julgar.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: É melhor ir embora agora, antes que eu atire em você.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: Ah, então agora você é o herói?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: Eu não quero sua casa nojenta. Não passarei mais um momento sequer aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: Adeus. Que a ira de Deus caia sobre você!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: Saiba que eu nunca planejei ficar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: Eu senti no meu âmago no momento que pisei aqui dentro: não há Deus nessa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: Talvez Ele ainda fale comigo agora, me dizendo para sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: Adeus. Que a ira de Deus caia sobre você!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: Maldito ferimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: Mas porque a FEMA foi atrás de você?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: Eu não tenho certeza, mas tenho um palpite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: Eu achei que era só uma verificação de rotina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: Mas aposto que foi aquela vizinha vadia que me dedurou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: Não suportávamos um ao outro. Ela viu uma chance de me enquadrar, e ela tomou essa chance. Disse que eu era um “Visitante”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: Ela provavelmente está toda orgulhosa de si, aquela vagabunda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: Maldito ferimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: Como está a ferida?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: Estou bem, sério. Está melhorando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: Eu disse, a bala atravessou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: As pessoas não deviam estar se matando. E esse cara? Ele atira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: Continue assim e estaremos todos enterrados logo. Eu não conseguia dormir sobre a terra, melhor tentar de baixo dela então.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: Mas não... viva de forma miserável e arraste os outros junto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: Você devia ter visto aquele lunático com a arma. Maluco esquisito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: Um lunático? Achei que a FEMA tinha atirado em você.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: Que lunático você está falando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: Sim, eu-sim, foi a FEMA, ele...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: Me diga a verdade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: Desista. Você não sabe mentir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: Digo... Estou falando de um cara da FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: Ele parecia super assustador quando vi ele... cara a cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: Digo... quando ele atirou em mim... pelas costas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: Me diga a verdade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: Desista. Você não sabe mentir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: Tá bom, tá bom...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: A verdade é... Eu saí da zona de quarentena, sim... mas não teve nenhum tiroteio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: Um doutor me ajudou. Falsificou os documentos e me tirou de lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: Eu não posso voltar pra casa. Ela ainda está lá. A vizinha que me denunciou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: Então eu tava procurando por um lugar pra ficar quieto. Foi aí que encontrei um cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: Só queria perguntar onde eu podia passar a noite. E então...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: Eu vi a espingarda nas costas dele, o colar de dentes e unhas. Um beco cheio de corpos atrás dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: Naquele momento eu sabia que era um maníaco maldito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: Olha, a dor tá voltando. Se importa se eu deitar um pouco?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: Droga...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: Escute bem, vou explicar tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: A verdade é... Eu saí da zona de quarentena, sim... mas não teve nenhum tiroteio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: Um doutor me ajudou. Falsificou os documentos e me tirou de lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: Eu não posso voltar pra casa. Ela ainda está lá. A vizinha que me denunciou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: Então eu tava procurando por um lugar pra ficar quieto. Foi aí que encontrei um cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: Só queria perguntar onde eu podia passar a noite. E então...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: Eu vi o rifle nas costas dele, o colar de dentes e unhas. Um beco cheio de corpos atrás dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: Naquele momento eu entendi: era um maníaco maldito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: Olha, a dor tá voltando. Se importa se eu deitar um pouco?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: Maldito ferimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: Então qual é a do maníaco do rifle?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: É, aquele maluco, coberto em dentes e dedos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: Ele viu a dúvida no meu rosto, apontou a arma para mim. Eu consegui agarrar ela e lutamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: Ambos disputando pela arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: Ele atirou. Quando me dei conta, bati a cabeça dele com tudo e ele desmaiou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: Eu fugi. Para o mais longe possível. Então senti dor no meu estômago.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: Olhei pra baixo, sangue por tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: Eu não disse que ele atirou em mim porque achei que você não me deixaria entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: Em horas como essa, todos estão pensando em si mesmos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: Seja honesto... Se você soubesse que um psicopata armado pudesse estar me perseguindo, deixaria mesmo eu entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: Eu precisava de abrigo. Eu não quero morrer como os pobres coitados daquele beco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: Então é... Eu menti. Espero que possa perdoar isso. Não guarde rancor contra mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: Certo. Você pode ficar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: Não posso confiar em você agora. Saia
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: Obrigado. Significa muito que você entende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: Vamos torcer para aquele maluco não aparecer. É bom que você está armado também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: Talvez alguém já tenha dado um jeito nele. É, talvez até aquele Visitante branquelo e magro tenha feito isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: Bom... acho que eu estava certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: Viu? Eu menti por um motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: Até mais, corno!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: Ah não... Pra onde eles foram?...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: Como você está?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: Eu não sei... Eu só quero meus pais de volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: Eles cuidaram de mim a vida inteira, e agora... Eu nem sei o que aconteceu com eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: Espero que estejam bem. Não consigo me imaginar sem eles...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: Ah não... Pra onde eles foram?...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: Você tem algum outro parente?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: Quase ninguém. Porém...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: Recentemente descobri que tenho uma irmã mais velha... do casamento anterior do meu pai. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: Droga, minha vó!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: Meu deus, acho que acabei de me dar conta pra onde meus pais podem ter ido...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: E se a vovó era um visitante e matou eles? E se a FEMA levou eles embora??'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: Por quê? Por que eles não ficaram? Por que eles não me levaram junto? POR QUÊ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: EU NÃO VOU SOBREVIVER SOZINHO. POR QUE ME DEIXARAM PARA TRÁS?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: Ah não... Pra onde eles foram?...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: Você se acalmou? E aquela sua irmã?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: Bom, eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: Não muito antes deles saírem, recebemos uma carta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: Meu pai me trouxe a carta porque eu nunca olho o correio. Ele me disse para ler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: Era “da irmã”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: Ela disse que queria me conhecer. Mas... Eu não sabia o que pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: Honestamente, eu pensei que fosse uma pegadinha primeiro. Mas meu pai me deu a carta, então não poderia ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: Ele me disse que eu não era o primeiro filho dele. Que eu sempre tive uma irmã...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: Não uma irmã completa. Só temos o mesmo pai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: Ouvindo aquilo... me senti estranho. Eu não sabia como lidar com aquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: Quer dizer, ela é supostamente minha “irmã”, mas ela é uma completa estranha... muito esquisito...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: Eu... eu acho que gostaria de falar com ela. Mas estou muito assustado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: Talvez você pudesse ligar pra ela por mim? Aqui está o número - XXX-XXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: Só... diga que eu existo. Que eu não sei o que fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: Ah não... Pra onde eles foram?...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: Por que você não quer ir para a casa da sua irmã?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: Eu mal conheço ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: Quando meus pais me falaram a verdade, senti como se tivessem mentido pra mim a vida toda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: Fiquei muito brabo e fui para o meu quarto. Eu só queria que me deixassem em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: E então, no dia seguinte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: Aquela coisa que eu falei aconteceu. A TV, o pânico, e então...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: Eles me deixaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: Deus, eu juro que daria tudo para ver meu pai e minha mãe mais uma vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: Meu deus, por quê...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: Vá até sua irmã; Ela não vai mandar você embora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: Tem certeza que seus pais morreram?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: Sério? Você acha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: Mas eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: Eu nunca fui tão longe sem meus pais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: Ela mora muito longe daqui. Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: Estou com medo. Eu não sei se consigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: Use um táxi. Eles ainda estão por aí.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: Você precisa fazer algo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: Bom...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: Eles não voltaram por mim, então eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: Eu não sei…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: Tente encontrar sua vó
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: Tente procurar nas zonas de quarentena
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: Ei, isso... até que não é uma má ideia. Mais ou menos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: Apesar de que eu ouvi que os táxis estão muito caros agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: Mas eu peguei a grana dos meus pais. Talvez seja o suficiente para pagar uma corrida até a minha irmã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: Obrigado por botar juízo na minha cabeça. Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: Talvez você esteja certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: Talvez eu realmente tenha me apoiado demais nos meus pais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: Obrigado por botar juízo na minha cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: Eu vou tentar pegar um táxi. Por sorte, eu trouxe a grana dos meus pais junto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: Espero que eu consiga fazer isso. Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: Talvez… talvez você esteja certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: Talvez o carro deles tenha estragado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: Sim, meu pai estava dizendo que precisava de conserto de novo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: Mas a minha vó se nega a comprar um celular. Talvez seja por isso que eles não podiam me ligar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: Talvez... talvez eu encontre eles por lá mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: Obrigado por botar juízo na minha cabeça. Eu deveria ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: Bom...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: Talvez eles estejam lá mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: Acho que eu deveria tentar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: Obrigado por botar juízo na minha cabeça. Eu deveria ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: Pode perguntar, parceiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: Como você está?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: Tô me sentindo muito bem, meu bom!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: Dei uma olhada na sua geladeira. Rapaz, se eu soubesse que você tinha TANTA cerveja...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: Enfim, como é que você desenrolou isso? Teu tio trabalha numa cervejaria ou coisa do tipo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: Ah, que seja, cara. Fica com os teus segredos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: Que bagunça, né, parceiro? Em outra situação a gente podia tá tomando umas geladas e assistindo um futebol. Eu até te apresentaria uma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: Ei, você tá bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: Você travou por que?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: Hum? Que foi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: Ah, esquece. Tá tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: Nada, eu só tava...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: Humm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: Só tava pensando, só isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: E aí, meu bom. O que cê manda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: Você parece pra baixo hoje
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: Eu não quero ir pra lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: Ir pra onde?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: Do que você está falando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: Não importa. Você não entenderia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: Eu acho que eu deveria saber
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: Tá bom, não vou insistir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: Olha, eu realmente não quero falar disso, belê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: Eu acho que eu deveria saber
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: Tá bom, não vou insistir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: Eu disse pra não me pressionar! Tô mal aguentando as coisas como elas estão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: Só... me deixa em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: E aí, meu bom. Só não tô me sentindo muito bem, nada além disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: Pode perguntar, parceiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: O que tá acontecendo com você?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: Isso não te interessa, parceiro! Sai fora!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: Só me diga o que está acontecendo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: Você precisa falar. Vai ser pior se você ficar quieto
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: Eu não posso... Você não vai mais me olhar do mesmo jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: Mas, não é como se reprimir esse tanto de coisa estivesse me fazendo algum bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: Eu... tinha uma cachorrinha. Ela... morreu faz alguns dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: E daí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: E?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: O que foi, meu bom? Tá pensando em me apagar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: Tá bom. Você quer a verdade?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: Eu... tinha uma cachorrinha. Ela... morreu faz alguns dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: E daí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: E?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: Não é só isso. Ela estava idosa, e doente... Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: Não é como se ela fosse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: Eu matei ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: Você fez o que?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: Você é doente!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: Eu matei ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: Você fez o que?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: Você é doente!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: Eu sei o que parece, mas deixa eu te explicar. Ela... tava sofrendo muito, eu não conseguia mais assistir aquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: Dia sim e dia não, eu via a dor nos olhos dela. Já ouvi ela chorando pela noite, chorando por conta de dores nas perninhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: E TUDO CULPA DAQUELA PORRA DE CARRO! Se aquele taxista não tivesse dirigindo com o cu no volante, talvez ela ainda estivesse viva, comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: Caralho, eu daria tudo pra torcer o pescoço dele, mas o cara deu no pé. Não deu tempo de anotar a placa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: Você não sabe como é a dor de perder um animalzinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: Você sabe o que dizem: Pra gente, eles são só um capítulo. Mas pra eles, nós somos o livro inteiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: Tá, você pode ficar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: Você deveria ir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: É, eu sei... eu sou grande de um filho da puta. Ainda não consegui me perdoar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: Ela tava sofrendo, parceiro... Era insuportável, ver a minha pequenina naquele estado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: E agravava a cada dia. De noite era pior...Ela gemia e choramingava, e as lágrimas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: Já viu um cachorro chorando? Os olhinhos dela estavam implorando para eu dar o descanso que ela merecia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: Eu não queria, eu não queria ter feito isso, eu juro! As minhas mãos nunca...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: AQUELE TAXISTA FILHO DA PUTA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: O filho da puta atropelou a minha pequena preciosidade. E fugiu como se nada tivesse acontecido!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: Como se ela fosse só um quebra-mola no asfalto, e não a porra de um ser vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: Caralho, eu daria tudo pra torcer o pescoço dele, mas o cara deu no pé. Não deu tempo de anotar a placa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: Você não sabe como é a dor de perder um animalzinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: Você sabe o que dizem: Pra gente, eles são só um capítulo. Mas pra eles, nós somos o livro inteiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: Tá, você pode ficar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: Você deveria ir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy:  Valeu, meu bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: Fico feliz por você entender.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: Você tá certo, parceiro. Talvez isso seja pro melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: Eu penso nisso todo santo dia... Eu fiz a coisa certa, ao dar fim na dor que dela?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: Acho que nunca vou saber de verdade...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: Tão escuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: Então, me diz, o que você viu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: Você não quer saber. Acredite. Você não saber é o melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: Eu pensei que se parasse de enxergar, eu iria parar de lembrar da aparência daquela... coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: Mas está marcado em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: Eu ainda sonho. Está sempre lá. Ele visita com frequência.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: Tão escuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: Então, é melhor não ter olhos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: Difícil dizer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: Eu sei que nunca vou enxergar novamente. Mesmo que algo me mate, eu não vou saber o que era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: Mas ainda assim... é estranho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: Eu não sei como sua casa é. É difícil de navegar. E o buraco dos meus olhos iriam doer se não fossem os remédios...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: O lado bom é que eu não vou precisar ver aquele horror, nunca mais. Eu vou me adaptar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: Ainda assim... sabendo o que eu vi... Está gravado em mim. Eu vou carregar isso até o fim dos tempos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: Tão escuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: Você parece mal
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: É a falta de uma escova? Hum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: Eu tive um sonho na noite passada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: Estava andando pelos trilhos bonde, voltando para casa. Casas em volta. Árvores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: Eu ouvi o bonde vindo e dei um passo pro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: Eu me virei; então vi algo pegar um homem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: Se moveu muito rápido em volta dele, não dava pra ver direito. Mas eu sabia. Eu sabia o que era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: Eu corri atrás do bonde, mas nunca chegava perto. Eu nunca vou alcançar; Nunca vou alcançar a verdade que se esconde no fim da linha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: Então eu acordei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: Tão escuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: Você está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: Outro sonho. Aquilo veio de novo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: Eu estava andando pela rua. De noite. Luzes piscando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: Eu me virei e vi aquilo correndo atrás de mim. Lentamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: Dessa vez eu vi como se movia. Claramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: Eu tentei correr, mas ele estava me alcançando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: Eu alcancei minha casa, mas não conseguia abrir o portão. Escalei a cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: Me atrapalhei com o meu bolso. As chaves escorregando pelos dedos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: Então corri em volta da casa. Outra cerca. Escalei de novo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: Parei. Nenhum som.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: Olho para cima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: E lá está. Me pegando pela cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: Talvez sejam só os remédios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: Tão escuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: Algum sonho noite passada?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: Sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: Eu não quero falar sobre isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: Eu entendo agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: Nós vamos morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: Ele vai nos despedaçar. Acordados ou dormindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: O sol irá nos queimar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: Nada mais importa. Acabou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: Eu... Me deixa quieto, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: E aí, meu irmão?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: O que você estava fazendo antes do cataclismo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: Ahh, parça, eu tava tranquilão, saca? Vendo uns seriados, curtindo com os manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: Mas agora? Sem filminho, sem resenha. Um pé no saco, meu brother.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: A TV só repete a mesma porcaria todo dia, é pânico, comercial inútil e pânico outra vez. Meus manos nem atendem mais o telefone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: Ouvi algum figurão aí dizendo: "Não é hora de se divertir. Isso é uma crise..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: Que se foda esse zé ruela. A alegria nunca acaba na terra da diversão! Uuuié!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: E aí, meu irmão?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: Você trabalhava com o que?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: Trabalho? Pfffft.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: Mano, só perdedores trabalham. Eu tava vivendo, cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: Vi esse filme uma vez. O personagem principal? Totalmente eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: Diz aí, os caras das fábricas parecem felizes? Nem pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: Eu dava festas, conhecia pessoas novas... isso é viver de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: Tá, tá... Eu já fui um gerente de depósito uma vez. Divisão de entregas. Graças aos meus velhos, sabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: Então você está vivendo às custas dos seus pais?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: Só um vagabundo, então?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: Pra que trampar, mano? Eu já tenho tudo arranjado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: Não usar o que tem? Isso é burrice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: Tipo, você tem uma arma. Cê vai pendurar na parede ou usar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: Exatamente. Eu não sou burro. Eu uso meus benefícios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: Ei, calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: Se cê tem inveja, é só falar mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: Eu entendo, nem todo mundo tem a sorte grande. É a vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: Eai, mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: Tem algo errado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: Mano... cadê teus filmes? Cê tem tipo, nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: Ao menos assiste algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: Tô morrendo de tédio aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: Não é hora pra filmes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: Eu não tenho nenhum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: Cara, eu achei que esse lugar ia ser massa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: Mas tua gente? Meio maluca. E tem nada pra ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: Sem revistas, sem filmes... só livros...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: Quem ao menos lê, cara? Isso é idade da pedra! Só palavras e descrições sem fim. Tédio total.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: Isso não é um cinema
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: Você está aqui pra fazer festa ou sobreviver?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: Pera, o que!?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: Mano, sem chance. Tá falando sério?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: Você tem uma TV no quarto, e nada de filmes!?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: Mano, essa festa é uma merda. Eu achei que cê seria legal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: Isso não é um cinema
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: Você está aqui pra fazer festa ou sobreviver?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: Poxa, cara...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: Cê é o maior estraga-prazeres que eu já vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: Se você quer sobreviver, se acalme.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: Se não gosta daqui, pode ir embora.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: Poxa, cara...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: Minha TV lá em casa queimou, cara. Eu tava com esperança de que você ia me salvar do tédio, mas nããão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: Cê é o maior estraga-prazeres que eu já vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: Se acalme se quiser sobreviver
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: Se não gosta daqui, pode ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: Tá bom, tanto faz, mano. Esse lugar é uma merda, mas é melhor que as ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: Só... me deixa assistir um pouco de TV, cara. Só um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: Sabia! Você é um baita estraga-prazeres!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: Tô fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: Pobres pequeninhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: Você está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: Sim, eu acho... Eu não sei...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: Eu... Eu não entendo como adultos crescidos e racionais podem deixar suas emoções os guiarem a fazer algo como aquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: Eles estão aterrorizados a um nível de matar até uma criança?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: As pessoas fazem coisas piores hoje em dia
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: No caos, o bom-senso é a primeira coisa a ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: O que poderia ser pior do que matar uma criança?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: Não foi só uma pessoa... foi um grupo, uma multidão, com sua caça às bruxas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: Talvez tempos difíceis de fato mostrem quem somos por trás das máscaras. Quem sabe somos nós os verdadeiros monstros, não aqueles que vieram do fundo da terra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: Mas as pessoas não se dão conta que matar crianças é... Eu não consigo nem encontrar palavras...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: Talvez tempos difíceis de fato mostrem quem somos por trás das máscaras. Quem sabe somos nós os verdadeiros monstros, não aqueles que vieram do fundo da terra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: Pobres pequeninhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: Por quanto tempo você foi uma professora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: Por volta de três meses antes do cataclismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: Mas... Eu não era uma professora modelo. Eu não amava o meu trabalho. Naquele tempo, as crianças pareciam barulhentas e cansativas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: O cataclismo mudou isso. Abriu meus olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: Sabe, qualquer uma daquelas crianças poderia ser uma estrela do rock, política, um pai ou mãe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: Mas agora, elas nunca irão segurar uma guitarra, nunca irão à escola, nunca irão crescer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: Elas serão para sempre... um grupo de sonhadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: Eu lembro do dia que uma das crianças veio correndo. Chorando, dizendo que seus pais tinham medo dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: Os pais pensavam que ele fosse um Visitante, e... expulsaram ele de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: Ele não tinha mais para onde ir, então veio até mim... na creche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (A mulher, mal conseguindo conter as lágrimas, chora)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: Desculpe-me...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: Pobres pequeninhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: Desculpe por ontem, eu não quis incomodar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: Tudo bem. Eu... Eu estou bem agora. Me sinto melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: Sobre o garoto... Depois dele, eu percebi o quão indefesas são as crianças. Especialmente quando as coisas entram em colapso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: Eu comecei a aceitar todo o “rejeitado” e abandonado que pudesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: Eu ouvi suas histórias... Era difícil de ouvir como alguns pais descartavam as crianças sem pensar duas vezes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: Como se o cataclismo fosse só uma desculpa para desistir de uma criança.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: Talvez... Eles nunca quisessem uma criança pra começo de conversa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: Pobres pequeninhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: Você tem filhos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: Não, eu... Minha mãe costumava me dizer para encontrar alguém, ter um filho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: Mas eu não estava pronta. Eu queria que fosse uma decisão consciente, quando a hora certa chegasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: Ouvir todas aquelas histórias de crianças abandonadas... eu não podia deixar de pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: Se eu tivesse escutado minha mãe, talvez eu pudesse ter acabado igual aqueles pais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: Por isso decidi ajudar todas as crianças deixadas para trás;'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: Você sabe qual a pior parte? Um dos incendiários era pai de uma das crianças que eu acolhi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (A mulher não consegue mais conter as lágrimas novamente)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: Desculpe-me...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: Eu... Eu tentei mesmo dar uma vida boa para elas. Eu cuidava delas. Não deveria ter acabado assim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: Sinto muito mesmo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: A morte delas não é culpa sua
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: Sinto muito por sua perda
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: Talvez você esteja certo. Mas... eu ainda me sinto vazia por dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: Você sabe qual o pensamento que não consigo me livrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: E se os pais delas nunca tivessem sentido nada por elas? Nunca tivessem amado elas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: Eu só... Eu espero que tenha sido capaz de fazer elas sentirem pelo menos um pouco de amor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: Obrigada... mas ainda me sinto quebrada. Eu acho que nunca vou superar isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: Você sabe qual o pensamento que não consigo me livrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: E se os pais delas nunca tivessem sentido nada por elas? Nunca tivessem amado elas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: Eu só... Eu espero que tenha sido capaz de fazer elas sentirem pelo menos um pouco de amor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: O gatinho está aqui. O que mais você precisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: Por que você está aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: Que pergunta idiota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: Você que responda isso, quem abriu a porta da casa não foi eu. Eu tô aqui pra quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: Pra mim é tudo igual. Um lugar é um lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: Me mandaram vir pra cá e foi exatamente o que eu fiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: Eu não quero nada. Não você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: O que importa é você manter esse lugar confortável pro gatinho. O resto? Quem se importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: O gatinho está aqui. O que mais você precisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: Você ao menos é humana?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: E você, é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: O que restou aí dentro de você?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: O que faz eu ser tão pior assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: O gatinho está aqui. O que mais você precisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: Quem te mandou pra cá?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: Você já fez o que tinha que fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: Pra quê saber do resto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: Tá, eu conto. Alguém... me mandou vir até aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: Mas, foi só isso, a pessoa não disse o que fazer depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: O gatinho está aqui. O que mais você precisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: Quanto tempo você planeja ficar aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: Até eles me encontrarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: O que mais eu deveria fazer? Hum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: Sei não. Eles me disseram coisas, agora eu espero até me contarem mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: E você? Quem é que te diz o que fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: Por quem você está esperando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: O gatinho está aqui. O que mais você precisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: Por que você não me matou?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: Você é meio burro, sabia disso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: Mesma coisa, todo dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: Eu já disse. Eles não disseram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: Eu aguardo. Por que você aguarda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: É sufocante aqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: Você está bem? Como está a criança?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: Sim, sim... Ela... ela está cansada, assim como eu. E ela é envergonhada em volta de pessoas novas, então está grudada em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: As crianças tem dificuldade em lidar com coisas assim. Mesmo quando não reclamam você consegue ver no rosto delas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: As vezes eu sinto como se fosse minha culpa arrastar todas elas pra isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: Mas é tarde demais para mudar algo agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: Ai, amor, tira essa carranca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: Por que vocês estavam andando na rua?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: Ah, nós só estávamos indo visitar a mãe da minha querida esposa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: Nos demos conta que não íamos chegar lá, só eu e ela. Aí, bem, a gente veio bater aqui na sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: Aliás, obrigado mais uma vez por nos deixar ficar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: Ai, amor, tira essa carranca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: O quão longe fica a casa dela?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: A minha querida esposa não é das melhores com orientações.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: Se a gente não encontrar ninguém pra ajudar então a viagem vai durar provavelemente uns dois dias?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: E isso DEPOIS que a gente se perdeu umas vezes tentando encontrar qual caminho devíamos estar seguindo. Hahah! Né, meu bem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: Se alguém puder nos dar uma carona, aí seria tranquilo. A viagem duraria poucas horas, no máximo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: Mas por que agora? Por que visitar a mãe dela de repente?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: Não é o melhor momento
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: Algo pode ter acontecido com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: O telefone da mãe dela está desligado. Não conseguimos entrar em contato faz dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: Precisamos garantir que ela esteja bem, talvez precise de ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: E as noites são mais curtas agora. É meio assustador andar por aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: Mas tudo bem, vamos ver sua mãe logo, né, querida?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: Eu não lembro do caminho, e minha esposa sempre pega a direção errada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: Mas tudo bem. Tudo que importa é seguir em frente, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: Quem sabe chegamos lá em uma semana! Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: Ai, amor, tira essa carranca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: Achei que vocês iam sair essa noite
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: Era esse o plano, mas a minha esposinha boba e ingênua levou apenas três horas cronometradas pra se arrumar. Agora já é tarde para sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: A gente vai ter que ir depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: Desculpa por isso. A gente vai ser mais rápido da próxima, não esquenta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: Vou me certificar que essa lesminha aqui não nos atrase novamente. Hahahah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: Não estamos pedindo muito, estamos? Desculpe de novo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: Ai, amor, tira essa carranca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: Senhora, você está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: Ela tá bem. Tá perguntando por que?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: Ela não tem nada a acrescentar que seja diferente do que eu já disse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: Além do mais, ela é meio nervosa, só isso. Não precisa se preocupar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: Eu perguntei pra ela
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: E como você está?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: É, e eu disse que ela tá cansada. Não força a barra, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: Vamos fazer essa lesminha andar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: Sinceramente, ela já deve ter parado de se importar com a mãe nesse ponto... Mas, ela vai chegar lá!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: Se a velha ainda tiver viva, isso sim! Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: Vamos, querida, anda logo. Quanto mais você vai me fazer esperar? Porra!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: Ah, tá tudo mais ou menos bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: Tá começando a parecer que minha mulher não dá mais a mínima pra própria mãe, hahaha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: Talvez eu devesse dar uma pressionada, hein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: Desculpe por te fazer ouvir isso. Ela só está me deixando maluco com a lentidão dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: Se senta e se arruma, eu já cansei de esperar! Porra!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: Ai, amor, tira essa carranca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: Sua esposa não quer sair. O que está acontecendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: Ela tá me irritando, entendeu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: Sempre choramingando, sempre me culpando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: Só cala a boca e me escuta. Mas não, nunca é fácil assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: Desculpe por ficar tempo demais, sério. Esse é o último dia. Estamos saindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: Me escutou? Junte a porcaria das suas coisas. Se ainda estivermos aqui de noite, juro que atiro você pela janela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: Senhora, tem certeza que está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: O que está acontecendo aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: Fique fora disso, por favor. Eu já te falei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: Pare de se meter, não é da sua conta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: Vamos dar um jeito nisso; não me enche o saco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: Tô de saco cheio da tua balela. EU QUERO A VERDADE, AGORA!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: Eu não me importo. Você vai sair ou não?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: Calma, camarada. Eu já disse que tá tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: Minha esposa só tá... entediada, aí ela fica fazendo showzinho e isso me deixa puto as vezes, é só isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: O que você quer de mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: Tô de saco cheio da tua balela. EU QUERO A VERDADE, AGORA!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: Eu não me importo. Você vai sair ou não?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: Calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: Eu tô com uma arma. Se tentar qualquer gracinha, eu atiro nessa vagabunda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: Eu não tenho nada a perder. Você tem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: Você vai morrer de qualquer jeito
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: Ainda dá pra você ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: Sim, sim, não vamos ficar mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: Estamos saindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: Me escutou? Essa é nossa última noite aqui. Se arruma logo e para de tomar a porra do meu tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: O que eu tenho a perder? Você me mata, e daí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: Pelo menos o sofrimento acaba. E essa vadia morre comigo. Eu vou ficar satisfeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: Vou atirar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: Calma. Baixa a arma e eu faço o mesmo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: Por quê? Eu preciso sair com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: Sem ela, eu não vou. Então baixe a arma. Estamos saindo hoje de noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: Ninguém precisa se machucar, é só você deixar isso pra lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: Vou atirar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: Calma. Baixa a arma e eu faço o mesmo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: Você vai mesmo atirar em uma mulher? Você não se importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: Você sabe que se atirar em mim, vai acertar ela também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: A culpa não seria minha! Será o sangue dela nas suas mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: Avisar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: Eu preciso sair ou nós dois morreremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: Não tem outro jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: Se aquela vagabunda parasse de tremer como uma vara verde e viesse comigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: Isso é tudo culpa dela. Me escutou? Você acabou com tudo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: Avisar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: Você... você está baixando a arma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: Espera, você ainda planeja atirar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: ESPERA! NÃO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: A... a gente tá indo, beleza?! Vamos tentar manter a calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: É? Você vai sair mesmo dessa vez, sua vadia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (De repente a mulher se solta. O homem atira nela)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (Você reage na mesma hora e atira na cabela dele)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: (Parece que os dois morreram... chegou ao fim, pelo menos)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: (Que casal maluco...)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: Tá bom, estamos indo. Agora. Vamos só pegar algo para nos cobrirmos, e iremos embora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: Você não nos verá novamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: Espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: O QUE VOCÊ ESTÁ FAZENDO?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (Você atira no homem, acertando a mulher junto)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (Ambos caem, sangrando)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (A mulher reage por um momento, mas você não consegue fazer nada por ela)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (Os dois estão mortos)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: Você não entende? Esse é o único jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: Vamos embora, e é isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: Ei, pega um cobertor, agora! Bora!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (Você observa enquanto o casal se arruma e sai da casa)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: Eles andam um pouco mas logo desmaiam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: Fumaça começa a sair do cobertor. Você se vira pro outro lado)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: Ainda se sentindo feliz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: Não super feliz... Mas não estou mal também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: Ainda somos humanos. Ainda resistindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: Não estamos fazendo caso como se fosse pior do que é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: E quando tudo tiver acabado... Acho que seremos capazes de perdoar uns aos outros pelas coisas que fizemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: Enquanto houver compaixão, há humanidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: Você tá me entendendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: Você sempre foi assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: Quer saber... não. Nem sempre. Eu costumava ter raiva. Das pessoas, do mundo, de mim mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: Perdia a paciência com nada, fazia indiretas, batia portas com força o suficiente para quebrar. Mas em um ponto, eu me dei conta que a raiva só nos despedaça por dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: Primeiro por dentro. E então tudo em volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: Uma vez... eu me irritei com uma pessoa que só queria me ajudar. E agora... ele... ela se foi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: Aquele momento quebrou algo dentro de mim. Eu sabia que precisava mudar'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: Então eu aprendi a deixar pra lá. A respirar. A perdoar. Foi assim que cheguei aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: O que você perdeu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: Minha família.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: Nossa casa queimou enquanto eu estava fora — só por um minuto, para pegar água. Eu voltei para dar de cara com fumaça e cinzas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: Eu levei tempo para aceitar isso. Eu fiquei me perguntando: por que eu saí naquela hora? Por que eu não podia salvar eles?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: Mas talvez não seja esse o ponto. Talvez não seja sobre salvar o passado. Talvez seja sobre seguir em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: Eles ainda estão comigo, de certa forma. A memória deles me dá forças. É por isso que eu tento ajudar as pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: Eu sei o que é perder algo. E eu sei o que significa encontrar propósito depois de tudo ruir em pedaços.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: E você conseguiu viver com isso? Com a perda deles?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: Sim, eu superei. Mas não foi fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: Eu me culpei por muito tempo. Pensei que se tivesse voltado uns minutos antes, as coisas teriam sido diferentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: Mas o luto se alimenta de culpa. E a vida... a vida precisa de perdão. Eu percebi que se não deixasse para trás, eu iria me perder também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: Perdão. Foi isso que me salvou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: Eu me perdoei por não ser capaz de mudar o passado. Até mesmo perdoei o destino, cruel como era. Porque a raiva estava só me puxando para baixo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: Então o que guia você agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: Eu acredito que as pessoas podem ser melhores. Mesmo na bagunça em que vivemos, ainda há uma chance de se reerguer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: Eu não acredito em milagres ou na providência divina. Eu acredito em pessoas. Em como levantamos uns aos outros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: Alguém levanta o caído. Alguem sorri em um dia ruim. Alguém compartilha seu último pedaço de pão. Isso aí é a vida. São as coisas pequenas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: Cada vez que alguém faz o mundo melhor, eu sei que isso não foi pra nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: Você gostaria de ter tudo de volta? Sua casa e família?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: Se eu pudesse ver eles de novo... conversar com eles, abraçar... Eu iria querer, com certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: Mas trazer tudo de volta? Não tenho tanta certeza. A perda faz parte da vida. É terrível, dói, mas nos molda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: Claro, eu daria quase tudo por mais um dia com eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: Mas se isso significasse desistir de tudo que aprendi? Como perdoar, como continuar em frente... Não. Eu não gostaria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: O tempo é limitado. É melhor segurarmos no que temos agora do que sermos engolidos pelo que perdemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: Fique alerta. Qualquer um de nós pode ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: Você é um caçador, certo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: Mais tipo um patrulheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: Eu morava no meio do nada. Sem TV, só rádio. Foi assim que descobri o que estava acontecendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: Decidi que não deixaria ninguém atravessar minha zona. Minha casa é minha fortaleza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: E se alguém fosse um Visitante? Me engana e então corta minha garganta enquanto eu durmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: Por que você está aqui, então?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: Não é seguro ficar sozinho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: Nem a pau que deixo aquele branquelo maldito me pegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: Ele é o motivo de eu ter saído da minha cabana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: Eu posso ver em seus olhos, você já encontrou ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: Como você sobreviveu sozinho lá fora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: Você viu o Visitante alto e branco também?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: Você acha que eu não tinha entendido isso ainda, gênio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: Se eu não tivesse, seria comida de vermes agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: Eu costumava pensar que era imbecil deixar estranhos entrarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: Imaginei que estaria mais seguro sozinho. Então aquele esquisito apareceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: Nunca vi uma fera como aquela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: Como você sobreviveu sozinho lá fora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: Você viu o Visitante alto e branco também?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: Ah, garoto... Essa é uma história longa. Não estou com humor pra conversa hoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: Me traga uma cerveja amanhã. Eu vou te contar tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: Então eu não sou o único.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: Sim... Eu consigo ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: Ah, garoto... se ao menos você soubesse o que eu já passei...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: Eu vou falar. Mas não essa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: Me traga uma cerveja amanhã e vai ouvir tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: Fique alerta. Qualquer um de nós pode ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: Então, qual a história?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: Trouxe a cerveja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: 'Sim (dar a cerveja) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: O que, nada de cerveja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: Hunter:...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: Não (não dar a cerveja)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: Aí sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: Como eu disse, eu estava escondido na cabana, me mantendo sozinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: Então um dia aparece esse cara. Ofegante, desesperado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: Começa a bater na porta, implorando para abrir. Mas algo estava errado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: Ele estava pálido, assustado, como se tivesse visto a morte. Nem ideia de como ele chegou tão longe na floresta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: Não parecia um trilheiro. Então mandei ele embora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: Ele tentou quebrar a janela, mas eu gritei que tinha um rifle. Isso fez ele sair correndo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: Pensei que nunca iria ver ele novamente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: Talvez você devesse ter ajudado
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: Você devia ter deixado ele entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: Como assim, “pensou”?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: E trazer seja lá o que for que estivesse perseguindo ele pra minha porta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: Não obrigado. Eu já tenho problemas o suficiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: Tá bom
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: Você não é muito conversador
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: Você não falou muito
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: Deixa eu adivinhar. Você vai se abrir se tiver cerveja no meio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: Não banque uma de herói, garoto. Aposto que você afastou outras pessoas também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: Caso contrário, você não teria chegado tão longe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: Mas essa é uma história para amanhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: Certo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: Você não é de conversar tanto
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: Na verdade, você não diz muita coisa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: Deixa eu adivinhar. Você vai desabafar se tiver cerveja?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: Eu tinha certeza de que nunca mais o veria. Mas, aí... ele me encontrou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: Mas vou guardar esse assunto para outro momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: Certo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: Você não é de conversar tanto
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: Na verdade, você não diz muita coisa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: Deixa eu adivinhar. Você vai desabafar se tiver cerveja?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: Me traz umas cervejas amanhã e eu termino a história.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: Não sou muito de conversar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: Se considere sortudo só por eu estar abrindo a boca para falar com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: Me traz aquelas cervejas amanhã e eu te conto o resto. Combinado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: Paciência, garoto. Eu já vi muita coisa horrenda por aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: E não é o tipo de coisa que eu quero lembrar sóbrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: Me traz a cerveja e a gente conversa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: Eu admito, você é esperto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: Não vou conversar até que seja algo realmente importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: Então, traz essa cerveja amahã e eu vou te contar como é que termina a história.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: Foi mal, eu não vou conversar sóbrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: Traz a cerveja e aí a gente conversa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: Fica antenado. Qualquer um pode ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: Então, como é que a história termina?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: Vou te contar, mas primeiro a cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: 'Sim (dar cerveja) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: Como é? Sem cerveja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: Não (não dar cerveja)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: Agora a gente pode conversar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: Aí, o cara fugiu e eu fiquei na cabana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: Então eu fiquei sem lenha. Tive que ir pegar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: Peguei um fardo, voltei e... o rifle tinha desaparecido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: Fiquei em alerta. Revirei o lugar de cabeça pra baixo mas a arma só sumiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: Foi nesse momento que eu vi o mesmo cara, no outro lado da janela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: Ele estava com meu rifle, mas ele havia mudado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: Estava mais alto e com a pele flácida. Não vestia nada mais do que uma calça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: Ele segurou a arma com as duas mãos e partiu o rilfe no meio, como se fosse um galho seco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: Depois disso ele ficou em pé, parado. Ele me encarava como se estivesse esperando uma oportunidade para quebrar meu pescoço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: Mas ele não fez nada. Só continuou me fitando, como se fosse uma competição de quem ia encarar por mais tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: E então... quando a manhã raiou aquele cara alto e bizarro só... sumiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: Foi quando me dei conta. Ficar só do lado de fora e sem uma arma? Isso é pedir para morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: Eu corri para a cidade. Saí antes do sol nascer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: E foi desse jeito que eu vim parar aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: Só espero que você tenha a oportunidade de apertar o gatilho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: Quem sabe? Talvez o chumbo funcione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: Ele não matou você por que?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: Você acha mesmo que ele pode ser morto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: Ele dizimou um pelotão inteiro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: Não sei. Ele partiu um rifle no meio como se fosse isopor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: Ele poderia ter feito o mesmo comigo em um segundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: Talvez ele goste de brincar com a gente. Como um gato faz com um rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: Você sabe, eu não me assusto com facilidade. Mas aquele maldito alto e pálido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: Ele me faz gelar a nuca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: Gostaria de acreditar nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: Você sabe o que dizem: "Se sangrar, dá pra matar."'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: Se um pelotão inteiro não derrubou o cara... a gente não vai nem arranhar ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: Se ele quiser ele rasga esse lugar inteiro como se fosse seda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: Você sabe, eu não me assusto com facilidade. Mas aquele maldito alto e pálido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: Ele me faz gelar a nuca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: Sem cerveja, sem história.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: Eu não vou conversar sóbrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: Então, me traz uma cerveja se quiser o resto da história.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: Ah, se tivesse um pouco de calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: Você vai ficar de jaqueta?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: Sim, tem um pensamento que tá me assustando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: O que acontece se eu tirar a jaqueta? Eu não consigo me aquecer, mesmo no calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: Se eu tirar a jaqueta, eu vou morrer congelado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: Ou pior! Ficar vivo e sentir ainda mais frio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: Você não tá suando usando isso aí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: Então, você não toma banho?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: Não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: O corpo produz suor para se resfriar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: Acho que não posso ficar mais frio que isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: Eu não vou responder essa pergunta. Desculpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: Ah, se tivesse um pouco de calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: Alguma ideia de como ajustar a sua temperatura?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: Acho que não consigo mudar isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: Uma ducha quente só vai me queimar. Eu não me sinto nem um pouco melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: Sabe...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: Pensei em uma metáfora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: Imagine um espaço vazio, vasto e congelado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: Ali, galáxias nascem e estrelas morrem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: E eu só... observo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: Eu não vou saber nunca o que é o calor do sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: Ou a ternura de um abraço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: Acho que a sociedade e o espaço não precisam de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: Ah, se tivesse um pouco de calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: Quando nos conhecemos você disse que tinha algo para revelar. O que era?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: Humm. Não sei se quero falar sobre isso agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: Tem algo que está em minha mente por muito tempo. Deve ser por isso que eu sinto tanto frio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: Eu nem ia falar disso, mas talvez só me consuma mais e mais se eu não disser...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: Eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: Te digo amanhã. Acho que vou estar preparado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: Ah, se tivesse um pouco de calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: Então, o que você tá escondendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: Sim. Eu queria te contar um segredo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: Acho que estou preparado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: Normalmente não acaba bem, mas dessa vez pode ser diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: Embaixo das minhas roupas está, creio eu, o motivo do meu frio e da minha solidão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: Veja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: Não... de novo não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: O que você fez?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: Você se deu mal
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: Não tive a intenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: Pensei que seria diferente aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: Mas nunca é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: Eu não pedi por isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: Eu juro, eu não pedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: Expulsar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: Já aconteceu antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: O que me deu na cabeça em achar que dessa vez seria diferente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: Não se precipite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: Eu não fiz isso por pura maldade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: Não era o que eu queria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: Expulsar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: Talvez tenha sido para o melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: Sem frio, sem solidão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: É que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: Não pense que eu planejei isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: Agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: Seria mais piedoso uma bala na minha cabeça. Infelizmente, eu ainda consigo sentir dor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: O sol vai demorar mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: Posso ficar até o anoitecer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: Saia agora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: Só não dê uma de esperto
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: Entendido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: Desculpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: Talvez o sol me aqueça uma última vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: Obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: Eu sei que você me odeia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: Mas, mesmo assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: Me desculpa. Eu não queria isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: Ah, e... Você pode convidar minha amiga para vir até aqui, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: Quando os adultos convidam ela, eles deixam... Mas se sou eu, a história é outra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: Acho que o número dela é: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: Por favor, querido, não deixe ninguém entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: Por que a FEMA despejou você ao invés de levá-la?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: Só deus sabe, docinho. Esses sujeitos e essas roupas... não consigo entender as intenções deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: Tão sempre rondando por aí, botando regra em tudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: Eles tão achando que são grande coisa, é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: Mas eles não sabem de merda nenhuma, só ficam nesse faz de conta de que são os todo-poderosos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: Me diz, eles tão te apurrinhando também?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: Um deles fica zanzando por aqui
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: Filhos da puta! Deviam arrancar essas roupas e jogar esses malditos em uma cela de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: Pra eles verem o que é estar no meio do povão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: Eles tão tomando os prédios também?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: Meu deus, um bando de selvagens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: Uma vez, tudo certo. Mas voltar um, dois, três dias depois...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: Eles não tem vergonha não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: Por favor, querido, não deixe ninguém entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: Eles levaram alguém da sua família?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: Ah, querido, já faz tempo que ninguém pergunta sobre a minha gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: Eu tinha uma família grande. Pari meio mundo de gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: Um bocado de gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: Agora mal cabemos na casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: Por causa desses esquisitões, nossa pobre alma se esconde atrás de portas fechadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: Você não respondeu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: Então, eles levaram a sua família?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: Ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: Fui levada pelas emoções, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: Sim. Os malditos fardados levaram até o último da minha gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: Mas eles não vão sair dessa impunes, não senhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: Eles te tiraram alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: Eu não tenho família
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: Ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: Fui levada pelas emoções, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: Sim. Os malditos fardados levaram até o último da minha gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: Eles te tiraram alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: Eu não tenho família
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: Não? Então me fala por que sua casa é tão grande assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: Era uma república ou coisa do tipo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: Uma casarona significa uma família grande, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: Tá, eu não vou forçar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: Quem dera eu conseguir resgatar a minha gente lá das zonas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: Eles nem triscaram em você, hein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: Então, onde estão os seus familiares?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: Um lugar grande assim não foi feito pra uma só pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: Tá certo, eu não vou me meter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: Só queria a minha gente fora daquela maldita zona...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: Por favor, querido, não deixe ninguém entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: Como é que você vai resgatar a sua família?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: Eu não vou ajudar ninguém, querido. Eles conseguem sair sozinhos de lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: Como assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: Por conta própria?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: Vão voltar rastejando pela terra e vão sair do lado de fora da zona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: Os arames e o cercado não vão os parar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: E caso eles não consigam vir por baixo, eles vão arrebentar com aquela zona. Abençoados sejam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: Eles tão chegando, consigo ouvir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: Do que você está falando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: Você perdeu a cabeça?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: Como assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (Matar ela)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: As paredes vão cair quando a hora chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: Vai ter muita morte, tanta morte e então ele virá, faminto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: Aí aqueles fardados não vão mais encher o saco da minha gente. Eles vão ter um bucho maior pra se preocupar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: Eles tão chegando, consigo ouvir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: Do que você está falando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: Você perdeu a cabeça?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: Como assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (Matar ela)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: Vamos derrubar essas tocas que cês construíram...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: As paredes vão rachar... e as ruas vão inundar de sangue com os mortos empilhados...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: Tô ouvindo eles rastejando, tão quase aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: O que isso quer dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: Você é um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (Matar ela)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: O cheiro de carne queimada é tão bom...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: Os fardados dão um bom assado. Acho que só são crocantes demais, mas só um pouquinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: Você tem corpos, querido. Vários corpos e o suficiente pra uma boa lambança. A minha gente vai encher a pança aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: Tô ouvindo eles rastejando, tão quase aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: O que isso quer dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: Você é um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (Matar ela)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: Essa casa é especial, é um bom lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: Não é um casebre que mal abriga duas pessoas. Tem lugar pra todo mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: Tô ouvindo eles rastejando, tão quase aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: O que isso quer dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: Você é um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (Matar ela)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: Seu filho da puta imprestável...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: Eles vão te pegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: Encontramos um novo ninho, crianças. É hora de finalmente descansar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: Podem vir, ele já não precisa mais dessa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: A mamãe quer ver seus filhotes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: Venham, essa casa é boa pra gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: Venham, crianças... eu encontrei um novo lar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: Espaçosa, conservada e com lugar de sobra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (MATAR ELA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: Não. Dê a casa pra gente. Você a odeia mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: Você quer que ela queime até o chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: DÊ A CASA PRA GENTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: Tá resistindo? Eu sei o que você quer...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: A morte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: Tem alguma coisa a dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: Por que você vê pessoas como animais?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: Vou te perguntar uma coisa. O que nós somos, de verdade?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: A gente mata, come o que mata e nem perde o sono. Isso é a ordem natural das coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: Mas a sociedade nos encoleira. Sorte da gente que esses dias já se foram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: Como assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: Você está satisfeito com o desenrolar das coisas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: É simples. Já se foram as regras imbecis que a sociedade forçava. Agora, tudo está claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: Há uma matilha e há um líder. Qualquer um que atrapalhe a sobreviência da matilha morre. É um código que eu respeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: Mas sabe o que é o pior? Um lobo na pele de um cordeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: Você acredita que uma matilha é melhor do que a sociedade?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: Cordeiro na pele de lobo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: Me alegra ver que as pessoas não se escondem mais atrás de máscaras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: Mas aqueles cordeiros avacalham tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: Eles vestem a pele de lobo e fingem. Fingem os instintos de um homem de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: Covardes, cavando buracos na terra. Eu escolheria brigar de mão nua todos os dias ao invés desse jogo de gato caça rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: Mas se você criou uma matilha então você aprendeu a diferenciar quem são os falsos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: Você acredita que uma matilha é melhor que a sociedade?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: Cordeiro na pele de lobo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: Você tá duvidando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: Quando ainda existia sociedade, você provavelmente nunca identificaria um falso cordeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: Muito falatório, muita regra. Você ficaria preso eternamete em um debate ao invés de fazer o que precisa ser feito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: É por isso que a figura de um líder é importante. Sem perguntas, sem votos. A  palavra dele é lei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: Um líder DEVE demonstrar força. É a única forma da matilha sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: É, eu estou falando daqueles covardes escrotos que vocês chamam de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: Eles se escondem no subsolo como ratos, esperando a gente enfraquecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: Agora eles usam o senso moral dos humanos. Eles focam na nossa piedade para não serem mortos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: É por isso que devemos mostrar nossos punhos e fazer eles lembrarem que nós somos animais. Ou é isso ou eles vão nos expulsar daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: Você quer dizer alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: Por que você está encarando a minha arma?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: Eu vejo um líder em você. Você faz com que todos andem na linha e já mostrou que está no comando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: Lugar bacana esse aqui, o pessoal aparece frequentemente. É uma casa grande. Mas seus colegas de casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: O que tem eles?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: Você acredita que alguns deles são Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: Você reuniu espécimes de natureza fraca. São frágeis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: Me conta de que serventia tem a velha, a criança e o doente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: Uma matilha deve ser composta de espécimes fortes. É assim que se sobrevive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: Você quer que eu faça o quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: Quer que eu expulse eles?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: Não é sobre o cordeiro na pele de lobo. São os lobos fracos que me preocupam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: A sua matilha não tem um alicerce. As pessoas vêm e vão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: Escolha os mais fortes e os mantenha perto de você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: Você quer que eu faça o quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: Quer que eu expulse eles?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: Você precisa se livrar dos fracos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: Mata eles. Em público. Faça com que seja um recado pra todo mundo ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: É assim que você mostra firmeza. É assim que você mostra quem é o alfa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: E os que não hesitarem quando os fracos morrerem.... esses sim, são os seus lobos de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: Esses ficam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: Eu não sou um assassino
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: Eu só mato os Visitantes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: Deixa eles sozinhos e a sua autoridade vai sucumbir. Vão chamar você de molenga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: A piedade é só a fraqueza em outras peles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: Você tem que ser implacável. Visitante? Chumbo. Fraco, doente, velho? A mesma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: É assim que eles vão temer você. É assim que um alfa lidera a sua matilha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: Eu não sou um assassino
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: Eu só mato os Visitantes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: Quem você tá tentando enganar? Dá pra ver nos seus olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: Você já matou. Então não finja que suas mãos estão limpas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: Eu mandava nas ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: O povo tinha medo de mim. Eu era respeitado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: Você já parou pra pensar quanto tempo leva até sua alma mofar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: Eu não tive pressa. Deixei o mofo se alastrar. Entendeu o que eu quero dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: Certo dia um taxista se recusou a fazer uma viagem comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: Se eu deixasse aquilo passar a minha reputação teria zero significado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: Então eu quebrei cada osso do corpo dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: Mas o filho do taxista entendeu o recado. E o pessoal continuou me respeitando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: Você se sairia bem melhor se parasse de paparicar os fracos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: Eu mandava nas ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: O povo tinha medo de mim. Eu era respeitado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: Você já parou pra pensar quanto tempo leva até sua alma mofar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: Eu não tive pressa. Deixei o mofo se alastrar. Entendeu o que eu quero dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: Certo dia um taxista se recusou a fazer uma viagem comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: Se eu deixasse aquilo passar a minha reputação teria zero significado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: Então eu quebrei cada osso do corpo dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: Mas o filho do taxista entendeu o recado. E o pessoal continuou me respeitando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: Você tem alguma coisa pra dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: Você só fala de matilha. Por que você não tem a sua?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: Por que você criou a sua?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: Para aquele Visitante alto e pálido não me matar.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: Estou tentando ajudar as pessoas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: Eu só gosto de ter alguém por perto
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: Porque essas pessoas precisam de um líder
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: Eu perguntei primeiro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: Então você reuniu essa gente para salvar a sua própria pele?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: Você não me parece nada como um alfa, me parece só um vira-latinha assustado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: Essa matilha precisa de alguém forte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: Acho que vou ter que tomar o seu posto. Você não nasceu para liderar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: Um objetivo nobre, embora um pouco ingênuo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: Você não vai salvar todo mundo. Cedo ou tarde você vai ter que dizer não para alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: Mas você me parece um alfa. Eu não vou questionar isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: É isso? Você só está com medo de ficar só?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: Essas não são as palavras de um alfa. Isso é papo de covarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: Isso sim é algo que um homem diria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: Então eu não questionarei a sua liderança.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: Não vou responder isso. Quanto menos você souber, melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: Eu já te contei mais do que deveria. Agora é a sua vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: Se você não estiver apto a liderar, eu mesmo fico no seu lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: Vai se foder!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: O que te faz ser melhor que eu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (Sacar sua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: Vai logo antes que eu te meta um tiro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: CALA A BOCA, VIRA-LATINHA. Agora você não significa nada para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: Então por que você pegou o trabalho, se não sabe liderar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: É melhor você ir embora ou eu vou fazer você beijar o chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: Eu sei o que é uma matilha. Eu vivo pelo código de conduta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: Se você é molenga assim, não é alfa de jeito nenhum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: É melhor você ir embora ou eu vou fazer você beijar o chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: Então é assim que vai ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: Você sabe que eu tenho uma arma, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: Melhor baixar a sua. Vamos acabar com isso de maneira limpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (Atirar)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (Baixar a arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: Morra, seu filho de uma pu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: Seu escroto... você atirou mesmo em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: Bom garoto'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: Mas você devia ter terminado o trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: (Ele aproveita a oportunidade e saca a arma)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: (Ele está mirando em você)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: (Por sorte você consegue pegar a espingarda dele e atirar)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: Então, você cortou as linhas da sua boca?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: Tnj rfrjq-nj rjivfh!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: VYT PFIBKB HJN! Ghjcnj gjnjve xnj vtyz yt gjyvf.n.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: Não consigo entender você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: Você entende o que eu falo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: Qf ntz yt gjybvfl. Xnj vjpyj cltkfnm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: Rfrjq-nj jlobq zpsr ghblevfnm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: Como é que a gente vai se comunicar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: Qf vjue gjdnjhznm ndjb ckjdf, ns vjptim htfubhjdfnm yf ybp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: Yfdthyj, nfr qf ijnz gs gjqve xnj qf ujdjhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: Como.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: E agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: Você tá tentando alguma coisa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: Yt gjybvfe dct hfdyj. Yj ns xnj-nj cghjcbk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: Vjptn, tnj djghjcbntkmyjt ckjdj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: Yj ns xnj-nj cghjcbk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: Vjptn, tnj djghjcbntkmyjt ckjdj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: Ei, como você está?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (Você dá uma batidinha no ombro dele e aponta para as feridas na boca)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: Você está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: Dói?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: Qf gjghjge gjdnjhbnm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: Ghhh-oot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: Uhhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: Ghoodt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: Ckjpyjdfnj, rjytxyj, yj vjptn tnj vyt gjvjptn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: Bynthtcyj, e vtyz ljvf ghjbcjlbn nj pt cfvjt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: Rfrjq epfc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: Como você vai chegar em casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (Você põe a palma da mão na sua cabeça, imitando o formato de um telhado)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: Ljv? Ns cghfibdftim ghj ljv?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: Qf ghbtpfk r lheue d ujcnb, f nen nfrjt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: Byfxt rfr gbpltw cbnefwb. yt jgbcfnm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: E como eu deveria mandar você para casa? De avião?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: Você já deu uma olhada nas passagens de navio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (Você mergulha a mão, fazendo um movimento amplo)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: Cfvjktn? Levftnt, jyb tot ktnfen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: Yflj ls epyfnm ult-ybgenm byae.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: Dlheu htfkmyj tot vjpyj ektntnm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (Você movimenta a mão, imitando um navio e as ondas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: Nbgj, yf rjhfgkt gjgksnm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: Hfpdt jyb tot gkfdfen? Yflj geltn gjbcrfnm byae, cgfcbgj!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: Por que você é tão orgulhoso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (Você sorri e aponta o dedo para a boca, e depois aponta para ele)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: F ns ghj tnj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: Vyt cvjukb jgmzcybnm, xnj gjtplf tot pjlzn! Ghtlcnfdkztnt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (Ele está percorrendo o outro braço com a mão)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: Alguém pode levar você para casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: Qf yt gjybvfe, lheu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: Pfdnhf qf jnghfdkecm ljvjq! Gj rhfqytq vtht cpjie yf djrpfk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: Ctujlyz yjxme qf ecjie. Gjrf!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: Tchâtchâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: Você quis dizer o trem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: Você está indo para algum lugar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: Ybxtuj yt gjyzk, bpdbyb.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: Yj pfdnhf z gele yf djrpfkt b dct epyfe cfv!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: Vjitn, qf jrfiecm ljvf, cgecnz cnjkmrj dhtvytb…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: Bôôatsortte!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: Um silêncio tão sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: Como está a sua mão?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: Outrora, por ela nutri sentimento, ainda que as dores lânidas e o frêmito gélido persistam sem cessar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: Mas isso era de se esperar. Quero adiar o instante mais sublime.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: Houve uma garota que em meu coração se ancorou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: Valorizei cada momento ao lado dela. Sentávamos em silêncio e mesmo sem palavras, eu a compreendia. Foi então que percebi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: Eu mesmo me engano e jamais a conheci de verdade. Talvez eu simplesmente só queria acreditar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: Ainda assim, espero que um dia eu possa compreendê-la de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: Que silêncio sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: Me conta sobre essa garota
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: Sempre vi o brilho álgido da lua nos olhos dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: Ela era a antítese do cataclismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: Ao lado dela eu era assombrado por um sentimento inabalável de mistério.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: E eu anseio em desvendar os segredos que ela confina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: Agora, ela é meu monumento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: Meu farol, para me guiar quando eu partir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: Que silêncio sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: Como você conheceu ela?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: Houve um momento em que eu sabia o que me esperava. A infecção em breve me levaria por inteiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: O pensamento me aterrorizava. Percebi que logo desapareceria. Não em algum futuro distante, mas em poucos meses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: E então, quando os Visitantes rasgavam a terra... eu a encontrei em uma das casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: "Edgar: Uma menina envolta em lençóis brancos, com um rosto de beleza perturbadora.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: Neste mundo cruel, onde os homens só pensam em si, ninguém se importou com tal delicadeza além de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: Já ouvistes as palavras que dizem: "Incomum demais para viver e raro demais para morrer"?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: "Edgar: E, mesmo assim, eu acolhi sua forma frágil e a levei para casa.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: Quando o fim chegar, falarei com orgulho que tudo o que fiz foi com amor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: "Edgar: Que silêncio sereno...\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: Onde ela está agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: "Edgar: Passei tanto tempo buscando entender sua beleza. O poder do seu silêncio.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: "Edgar: Mas então...\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: Homens sem rosto vestidos de amarelo invadiram a sala.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: Eles a agarraram e a arrastaram para longe. Suponho que você saiba por qual motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: É uma pena. Eu nunca consegui entendê-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: "Edgar: E assim, estou sozinho mais uma vez...\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: Os homens clamam salvar o mundo mas ironicamente não concordam em como fazer isso. A resposta é simples.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: "Edgar: Ela está no silêncio. Na beleza. Se ao menos alguém pudesse enxergar.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: "Edgar: Ela tentou me ensinar. Mas tudo o que aprendi foi a serenidade. Um vislumbre de leveza no meio de tanta coisa ruim.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: Agora, eu pelo menos estou pronto para seguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: Que mundo é esse que a gente vive...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: E agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: Parece que ainda não concluímos o contrato de locação.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: E como eu faço isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: É nisso que você pensa em um momento assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: Não me diga que nem sequer tem a documentação em mãos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: Sugiro que você vá até um tabelião e consiga os documentos. Haja paciência.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: Você tá de brincadeira comigo? Onde é que eu vou encontrar um tabelião?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: Por que você não vai?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: Com todo respeito, eu ficaria contente se você se dirigir a mim de maneira apropriada. "Senhor" já é o suficiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: Que ignorante...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: Como você quiser
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: Ah, vai se foder
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: Você sabe usar um mapa, certo? Não é um bicho de sete cabeças.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: E, novamente, eu insisto: se dirija a mim com o devido respeito. Me chame de "senhor".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: Como você quiser
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: Ah, vai se foder
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: E por que eu em específico tem que resolver essas coisas? Ah, aliás, use "senhor" quando estiver se dirigindo a mim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: Sou um cidadão de respeito, e não um vadio sem teto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: Como você quiser
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: Ah, vai se foder
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: Você tá fazendo isso de propósito, né? Você poderia pelo menos fingir que vai ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: Meça as suas palavras. O Artigo 21 da constituição garante a minha dignidade humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: E eu recomendo mesmo que você começe a demonstrar um pouco de respeito,  antes disso ficar... desagradável.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: Que mundo é esse que a gente vive...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: Você pode só deixar pra lá?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: Ainda estou aguardando você concluir o contrato de locação.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: Eu não tenho nada para concluir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: Você deve tá de brincadeira
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: Hum. Uma pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: Creio que isso se configure como uma violação do Artigo 131.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: Você tá me deixando puto, de verdade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: Você não cansa de ficar vomitando leis e regras sem parar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: Para a sua informação, o Artigo 131 deixa claro que o contrato é obrigatório. Eu sou um cidadão responsável e vou seguir as leis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: Você tá me deixando puto, de verdade
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: Você não cansa de ficar vomitando leis e regras sem parar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: Ah, e aí estão, os insultos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: "Provocateur: A propósito, isso se enquadra no Código Administrativo 5.61.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: Continue fazendo isso. Vai voltar tudo para você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: E, não. Eu não estou cansado de me referir e fazer uso da lei e da constituição.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: Eu conheço meus direitos! As outras pessoas também podem usar as leis e a constiuição mesmo você sendo um ignorante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: E, vou repetir mais uma outra vez! Eu falei para se dirigir a mim de maneira apropriada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: Você não aprende mesmo, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: Que mundo é esse que a gente vive...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: E agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: Eu não deixei de notar uma arma de fogo. Posso verificar o seu porte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: Isso não é da sua conta.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: Qual é o teu problema comigo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: Ah, entendi. Não exibir o porte de arma é a mesma coisa de não ter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: Você acha que portar uma arma faz de você a lei ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: Que você pode interrogar todo mundo e não ser questionado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: Você está totalmente enganado!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: Você sabe o que dizem, que tem sempre um peixe maior.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: Já chega. Eu já tenho muito com o que lidar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: Vai parar de falar besteira?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: Eu estou só tentando entender quem você é de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: Ficou na defensiva... quer dizer que eu acertei. Sem porte de arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: Você acha que as leis não englobam você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: Você acha que pode sair farejando perigos enquanto ninguém pode verificar você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: Você está enganado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: Você sabe o que dizem: tem sempre um peixe maior.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: Já chega. Eu já tenho muito com o que lidar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: Vai parar de falar beteira?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: Ah você gosta de uma agressão, hein? É claro. Coitadinho. Ninguém se atreve em questionar você, ninguém se atreve em verificar se você é um Visitante ou não. Isso deve ser tão difícil para você...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: E quem exatamente te deu o direito de decidir quem vive e quem morre? Quem te concedeu essa autoridade?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: O resto da gente só senta e reza para que você não decida nos matar. Agora você quer empatia? De mim? Não fode.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: Ah, perdão pelo linguajar. Como se você não fosse a pessoa que está enchendo o saco de todo mundo com suas verificações.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: Farejando tudo, tratando todo mundo como um assassino em potencial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: Mas sim, é claro, não vamos apontar o dedo para o verdadeiro assassino. Vai que, talvez... só talvez... os Visitantes não existam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: Então isso faz você o que? Um maníaco... abusando do poder, explorando o caos para satisfazer a sua sede de sangue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: E as pessoas? Elas escutam o pânico no rádio e correm para bater na sua porta, como moscas ao redor de um pedaço de merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: Me diz, quantas dessas pessoas que vieram até você sobreviveram?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: Exatamente como eu suspeitava.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: Que mundo é esse que a gente vive...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: Senhor? Você ainda está aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: Memorável... você falou comigo com o devido respeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: Uma pena você ter demorado tanto. Em breve estarei relatando o acontecido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: Reportando o que?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: Quem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: Você não me engana mais. Eu sei exatamente quem é você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: Essa casa não é sua. Você assassinou o dono. Você está personificando ele. E eu estarei entrando em contato com a FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: É isso mesmo, eles vão vir pegar você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: Quanta besteira
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: Hora de calar você de vez
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: A Agência Federal de Manejo de Emergências. FEMA, para abreviar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: De primeira eu não prestei muita atenção no fato que você não conseguiu concluir um simples contrato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: Mas quanto mais conversei com você, mais óbvio ficou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: Agora tudo bate. Essa não é a sua casa. Você é um impostor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: Você é um VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: Então arruma as suas coisas. Eles vão vir atrás de você hoje a noite!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: Quanta besteira
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: Hora de calar você de vez
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: Ah eu vou relatar isso. Eles vão vir. Só espera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: Tanto faz. Sai daqui
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: Você está morto (pegar a arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: Então tente e me cale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: Espera, o que?! Você está enlouquecendo?! Isso é uma infração penal!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: Não, não, não. Você não vai sair impune disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: Eu vou ficar aqui até a FEMA chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: Vou dizer tudo o que você fez e o quão perigoso você é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: Espera, o que?! Você está enlouquecendo?! Isso é uma infração penal!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: Não ouse!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: Melhor você sair antes que eu atire em você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: Eu vou atirar se você não sair
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: Você me deixa sem opções
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (Atirar)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: Não vou permitir que você escape da FEMA. Você vai ter que passar por cima do meu cadáver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: Eles vão pegar você de qualquer jeito!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: Você também não vai escapar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: VOCÊ É UM VISITANTE! UM ASSASSINO! VOCÊ NÃO É HUMANO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: NÃO, NÃO!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: AAAAAAAAARGH!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: Cara... saquear alguma coisa de valor seria massa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: Como vai a carreira de catador?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: Ah, é. Pensei que esse lugar tava morto, então tentei entrar... mas tem gente vivendo aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: Eu não roubo de quem tá vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: Quer dizer, pensa mais: O que um cara morto vai fazer com um casaco?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: Ele já era. Seus pertences só estão ali, jogados. E eu ainda tô vivo, respirando. Pode salvar a minha vida ou a de alguém importante pra mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: Me diz aí se você não iria pegar algo de um cadáver para salvar alguém que você ama?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: Já deu da gente idolatrar todo corpo morto. Só dizendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: Cara... saquear alguma coisa de valor seria massa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: Por que você decidiu virar um catador?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: O que eu devia fazer? Eu não queria começar a machucar pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: Então eu decidi trilhar o caminho do silêncio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: Os mortos não revidam, tá ligado? O bagulho deles tá ali, de sobra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: Eu não tô aqui pra machucar ninguém. Só tô tentando sobreviver e talvez ajudar alguns no meu caminho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: Cara... saquear alguma coisa de valor seria massa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: Com o que você já lidou enquanto catava?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: Eu já vi tanta coisa que não dá nem pra por em uma lista...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: Deixa eu ver...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: Tinha uma biblioteca abandonada. Bocado de livro empoeirado nas prateleiras como se alguém ainda fosse voltar para os pegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: Passei por uma apresentação de um artista novato. As pinturas ainda continuam lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: Daí... teve uma vez que eu vi um por do sol. Não só qualquer por do sol, o negócio parecia uma pintura no céu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: Hoje em dia ninguém mais se arrisca a olhar para o céu. Mas naqueles tempos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: Sinto saudades de como as coisas eram. Eu costumava acordar cedão. As ruas eram silenciosas. A névoa na altura do tornozelo e a grama ainda úmida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: E o sol... cara, ele nascia com tanto brilho, como se estivesse te prometendo um dia decente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: Agora olha pra gente. O sol é o inimigo. Como é que isso foi acontecer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: Quem dera alguém trivesse respostas pra essa merda toda. Talvez ficasse mais fácil de respirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: Cara... saquear alguma coisa de valor seria massa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: Você parou de catar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: Ainda tô nessa. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: Teve uma vez... é, teve uma vez que mexeu comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: Encontrei essa casa. Vazia. Sangue no chão, coisa de sempre. Sem perigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: As costas do cara tava parecendo uma peneira. Ele tava deitado em alguma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: Pensei na hora que ele talvez estivesse tentando esconder alguma coisa. Cheguei perto, virei o corpo e...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: Olha, eu te conto mais tarde, beleza? Ainda não tô pronto pra dizer isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: Cara... saquear alguma coisa de valor seria massa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: O que o cadáver estava tentando esconder?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: Beleza...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: Eu virei o corpo e ela tava lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: Uma garotinha. Morta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: Você meio que espera isso com adultos. Mas uma criança? Aí é outra história.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: Me dá um nó na garganta toda vez que vejo uma criança morta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: Ela tava abraçando um gatinho de pelúcia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: Coberto de sangue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: O rosto da garotinha estava com esse olhar de... quem sabia que a morte logo ia chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: Por um segundo eu jurei que ela iria se assustar se eu pegasse o brinquedo dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: É como se mesmo ela morta a crueldade das pessoas não deixa ela descansar em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: Isso me pegou mais forte do que eu gostaria de admitir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: Naquele dia, eu pensei em parar, quis deixar os mortos em paz. Mas já é tarde demais para isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: Tudo o que posso fazer é continuar seguindo. Continuar catando. É a única maneira que tenho de sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: As pessoas dizem que você não pode fugir do destino. Acho que isso é mesmo verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: Queria que os Visitantes só voltassem pro subsolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: Por que você se tornou um coveiro?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: Hã? Ah, isso? Sei lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: O cemitério é tipo... tipo uma biblioteca, sabe? Mas esses livros não são pra você ler, eles só ficam deitados, quietos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: Eu conhecia todo túmulo. Quem estava lá, como seus braços estavam repousados, a roupa que vestiam e seus nomes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: Então teve um dia que eu tava cavando, certo? Dia normal, nada de bizarro. O buraco já tava fundo o suficiente até que, bã. Vazio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: Tô te dizendo, vazio! Mas os papeis diziam que havia alguém lá. Um corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: Algum cara, morto com certeza. Tinha um bigode. Eu lembro. Mas, puf, se foi. Como o suor da terra no amanhecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: Então... se um homem morto desaparece... Isso é como morrer mais uma vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: Queria que os Visitantes só voltassem pro subsolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: O que você fez quando encontrou o túmulo vazio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: Então, eu sentei bem na borda. Olhei pra dentro e nada. Mas aí olhei pra cima e bem longe... eu vi alguém em pé observando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: Sem olhos. Mas com os dentes brancos pra caramba. Brilhando. Sorrindo. Parado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: Eu quase me caguei, não vou mentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: Eu corri rápido, que é no que eu sou bom. Mas ele não me perseguiu. Só desapareceu, como fumaça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: Uma parada bizarra. Foi aí que essa bagunça dos Visitantes começou...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: Queria que os Visitantes só voltassem pro subsolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: Pra que cavar se ninguém enterra seus mortos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: Eu não cavo mais. Só... fico de olho. Mas depois daquela bagunça? Eu comecei a fuçar nos túmulos mais recentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: Com muito cuidado. Sem segundas intenções.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: Pensei que alguma daquelas aberrações tinha sido enterrada por engano. Segurava minha pá como uma espada. Pronto para descer o ferro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: Mas, nada... os ossos no lugar. O cadáver muito bem morto e nada tentando sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: Me fez pensar... talvez não sejam os mortos voltando. Talvez os Visitantes sejam pessoas que deviam ter sido enterradas... mas não foram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: Queria que os Visitantes só voltassem pro subsolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: Você esteve cavando algum túmulo recentemente?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: Eu?! Não mesmo! Não sou trouxa. Olha, eu tô perto da morte desde que me entendo por gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: Antes, a morte não me assustava. Você morria, enterravam você. Pronto. Mas e agora, quem é que vai enterrar a gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: E mesmo que alguém enterre, como você vai saber que não vai voltar depois? Eu vi um túmulo onde EU ENTERREI UMA PESSOA... e estava vazio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: Mas eu mesmo enterrei ele!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: Agora eu tô pensando... talvez o meu túmulo fique vazio também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: Talvez... talvez eu já seja um Visitante...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: Ah, esquece isso, cara. Só tô falando besteira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: Queria que os Visitantes só voltassem pro subsolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: De onde você acha que os Visitantes são?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: Você já percebeu que... eles são parecidos pra porra com a gente? Não só o rosto... mas uma memória.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: Eu tenho uma teoria. Você tem certeza que quer ouvir? Tá bom, é o seguinte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: Talvez os Visitantes não sejam os mortos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: Talvez eles sejam pensamentos. Os pensamentos que você não enterrou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: Medos, arrependimentos, pessoas que você esqueceu, sentimentos que você nunca deixou partir. Eles acumulam e... e quando a terra está silenciosa eles dão um jeito de sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: Eles não procuram pela carne, eles estão buscando atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: E quanto mais você sente medo, mais eles se aproximam. Por que você lembra deles e qualquer coisa que é lembrada... quer continuar existindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: Fico me perguntando... Os Visitantes também sonham?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: Você conseguiu dormir?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: Hã? Nada. Não tava tentando dormir valendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: Eu só espero que alguém ainda sonhe, e isso é tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: Mas... ninguém compartilhou nenhum sonho comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: Talvez eu não pareça ser confiável.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: Ou talvez eles queiram conversar depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: Fico me perguntando... Os Visitantes também sonham?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: Qual o motivo de você ser tão obsessivo com os sonhos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: Quem disse que eu sou obsessivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: Isso é uma conclusão meio estranha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: Você não tem nem um pouco de curiosidade em saber o que o seu subconsciente está tentando te dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: O que você está escondendo nessa cabeça?  A gente sempre esconde algo de si mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: Você, por exemplo. Evitando pessoas por que alguma coisa estilhaçou você por dentro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: É isso o que eu acho interessante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: Quer saber? Eu vou te contar o meu último sonho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: Um trem enorme e de cor preta está me perseguindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: Minhas pernas estão fincadas no chão. Eu grito e acordo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: Estou em pé nos trilhos e o maquinista do trem também sou eu. Indo de encontro a mim, e eu não podia fazer nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: Fico me perguntando... Os Visitantes também sonham?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: E você? O que você esconde nos seus sonhos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: O que tem eu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: Não durmo faz dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: Mas beleza, eu vou te dizer uma coisa. Ninguém vai acreditar mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: Eu consigo ASSISTIR o sonho das outras pessoas. É fascinante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: Não faço ideia de como isso funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: Mas desde que tudo isso começou, os sonhos ficaram mais quietos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: Como se todo mundo tivesse prendendo a respiração.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: E eu também não consigo mais dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: Pode continuar, tenta descobrir se eu tô contando a verdade ou brincando com sua cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: Almas perdidas. Assim como todas as outras pessoas nesta terra amaldiçoada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: Nós clamamos por paz e serenidade. E nós sabemos como conseguir...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: A morte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: Por que as pessoas temem tanto? É o desconhecido? Ou é o punimento que as religiões nos impuseram?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: Por milênios nós procuramos o significado da vida, da existência. E a resposta sempre foi tão, tão simples...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: A morte é o nosso propósito e nós somos seus acólitos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: Por que você venera a morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: A morte é a encarnação da piedade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: Todos temos medo, mas esses medos possuem alguma justificativa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: Pense sobre isso. O nosso mundo é só um purgatório que nos atormenta dia após dia. Mas, por qual motivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: Tanto medo, tanta dor, tanto sofrimento... Nós não merecemos paz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: A morte é um paraíso que nós não conseguimos compreender.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: As religiões tentam simplificar a imagem do céu por ser mais fácil para as pessoas aceitarem. Mas viver é simples assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: O mesmo vale para a morte. Você não pode entender até sentir o seu toque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: Por que você escolheu a minha casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: A sua casa está de mãos dadas com a morte como nenhuma outra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: De primeira eu não entendi o nosso mentor ter escolhido esse lugar. Mas agora faz sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: Essas paredes carregam vestígios de morte. Eles são invisíveis, mas palpáveis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: O concreto está tomado pelo odor de sangue derramado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: Não estamos pedindo para você matar sem motivo, como você deve pensar. Você já ceifa as vidas sem o nosso chamado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: Acho que o seu laço com a morte é mais íntimo do que o de qualquer um de nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: O que são essas fogueiras que você está construindo lá fora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: Chegou a hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: Os anjos do submundo vão levar nossas cinzas como oferenda e vão garantir a nossa passagem para o reino da morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: É assim que merecemos sua graça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: Você parece estar assustado. Você tá com medo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: Você é astuto, proprietário.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: Diferente dos meus irmãos... eu ainda sofro com o medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: A dúvida me atormenta. O que tem depois da vida? Como é a sensação?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: Nosso sacerdote nos ensinou que não é nem o céu e nem o inferno. É algo além dos dois. Mas eu não consigo assimilar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: Se até ele não consegue compreender a Morte por inteiro, será que algum dia nós alcançaremos o conhecimento?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: E se tocar não for o suficiente? E se for além da total compreensão?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: Mas eu não ouso questionar o desejo do nosso sacerdote. Eu vejo certeza e conhecimento nos olhos dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: Eles nos pede para abraçar a nossa fé e a nossa determinação. Para estarmos prontos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: E só assim nós conseguiremos atravessar o rio dos mortos e as colinas de ossos. E alcançar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: A morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: Por que você venera a morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: Por favor, gentil proprietário, fale da Morte com respeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: Ela despreza os que blasfemam e os que a consideram injusta, e os pune com mais severidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: Sua natureza me amedronta, mas o nosso sacerdote disse que a Morte deve ser o Deus mais bondoso de todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: Ela não acarreta a fome, a praga ou a guerra. Ela garante apenas o descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: E nós precisamos encontrá-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: Então por que você quer tanto encontrar a morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: Essa jornada não é escolha nossa. É a própria vontade da morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: Ela nos chamou e nos quer em seu reino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: Nosso sacerdote disse que é por isso que o sol está queimando com tanto afinco agora, tentando nos fazer correr da superfície.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: A morte oferece silêncio, paz e união. São nas terras dela onde nós nos reuniremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: Nós lamentamos a partida dos nossos em vão, e esquecemos que um dia os encontraremos novamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: O que você está planejando fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: Chegou a hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: Tenho medo... meu corpo não para de tremer, mas eu devo abraçar a fé e a determinação.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: Nosso sacerdote crê em mim. Eu não posso falhar com ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: Mas o medo... o medo ainda permeia a minha mente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: Deixa a gente sair daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: Deixa a gente ir. Deixa a gente ir!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: Você vai ficar por quanto tempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: Não se preocupe, proprietário. Nós não traremos problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: Agradecemos a sua hospitalidade e não queremos aborrecer você. Você já fez muito por nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: Nós ficaremos nesse quarto e rezaremos, quietos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: Precisamos de um descanso. Nossa jornada será árdua e duradoura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: Para onde você está indo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: Para a terra dos forasteiros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: A vida humana não é eterna. Somos só passageiros nessa terra. Nós vimos, e nós iremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: Os Forasteiros devem dominar esta terra, e se estabelecer aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: A chegada deles não é fruto do acaso. Atenderam ao mesmo motivo que nos faz partir...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: A Morte os chamou aqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: O que faz você pensar que a morte chamou os Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: Por que a morte não faz distinções entre humano, fera, forasteiros...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: A morte é uma para todos, e todos são iguais embaixo de seu véu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: Ela esperou o momento certo, e agora ela está quase aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: E precisamos nos preparar para o ritual...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: Que tipo de ritual você está planejando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: A hora de fazer a travessia chegou, de ir para o nosso lar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: Devemos ir até a Morte, para o reino da paz eterna e da serenidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: É hora de ir...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: Sim, querido? Tá pensando em alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: O que você acha daqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: Aconchegante. Considerando como as coisas estão... é mais do que eu esperava.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: Agradeço por ter me deixado entrar. Achei que ia ficar nas ruas até o amanhecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: E você? Como se sente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: Ansioso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: Está tudo bem. Precisamos sobreviver
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: Eu entendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: Nesses dias de hoje não faz muito sentido fazer planos para além de um mês.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: Você não tem como saber o que vai acontecer. O sol, os pirados ou os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: Mas a humanidade e a terra já sobreviveram a catástrofes antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: Acho que vamos deixar algum resquício.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: Alguém vai encontrar os nossos restos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: Eu gostei da sua atitude. Combina com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: Mas não guarde tudo para você. As emoções tem um jeito horrível de explodir...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: Quando você não quer que elas extravasem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: Não fique com vergonha de conversar sobre isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: Se não for comigo, vai ser qualquer outra pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: Me prometa pelo menos isso, tá?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: Sim, querido? Tá pensando em alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: Eu vi uma coisa estranha na noite passada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: Hã? Do que você está falando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: Sua barriga. Ela cresceu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: E eu pensei ter visto alguma coisa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: Você quer dizer que eu tô tipo grávida?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: Tá tudo bem. Fico contente por você ter expressado seus sentimentos em voz alta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: Acho que você se sente assim por estar com medo de ser responsável por outras pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: Eu entendo. Em tempos como esse, quando cada por do sol pode ser o seu último... já é difícil cuidar de você, imagine se preocupar com os outros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: Você não sabe nem se vai acordar amanhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: É... isso me assusta
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: Não, eu não acho que seja isso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: Mas alguma coisa incomoda você, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: Tá tudo bem. O medo bota todo mundo no chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: Eu vi você, acordando no meio da noite, fazendo vigília.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: Isso não é nada. Para alguém que se protege tão bem, você certamente se preocupa com aqueles que deixa entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: É interessante. Você é uma contradição ambulante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: Ou talvez seja só a insônia. O medo é um acompanhante barulhento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: É... isso me assusta
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: Não, eu não acho que seja isso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: É preciso ser forte para dizer isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: Hmm, mas o que podemos fazer com o medo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: Você consegue raciocinar com a ideia de que tudo isso acaba? Todo mundo morre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: O que importa é onde você encontra a sua salvação? Isso ainda existe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: Tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: De qualquer forma, eu me preocupo com você. Escute o seu coração, tá certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: Eu quero que você se sinta siguro. Afinal, nós vivemos no mesmo lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: Mas se você enferrujar nós vamos nos lascar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: Eu não quis fazer um trocadilho *risada*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: Gostou dessa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: Sim, querido? Tá pensando em alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: Eu sei o que vi, você estava grávida ontem a noite. Explique isso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: Você está começando a me aterrorizar um pouquinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: Você tem CERTEZA que viu algo assim ontem a noite?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: Por que você não me acordou?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: É o medo falando novamente? A morte ou o peso de se preocupar com alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: É por conta de mim? Ou tem mais alguém aterrorizando os seus pensamentos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: Não mexe com a minha cabeça
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: Eu... tenho certeza que vi alguma coisa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: Você falou sobre o seu pai no outro dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: Desde então nós não falamos mais sobre isso. Eu não sei de muita coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: Mas, agora... Eu sinto que você é igual a ele. Você é a cópia de carbono dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: Isso te dá medo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: Que você está preso na sombra dele?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: Ele está morto para você. Então por que continuar cavando fantasmas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: Você não vai encontrá-lo no outro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: Acho que vocês não vão para o mesmo lugar. Não se preocupe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: Pare de correr atrás de todas as perguntas de uma só vez. As estradas são construídas com uma pedra de cada vez, querido. Está me entendendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: E, por favor... não fale assim comigo outra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: Machuca. Assistir o que está acontecendo com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: Mas você não deve ter medo da morte, ou da responsabilidade, ou de se aproximar de alguém ou de qualquer outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: Faz parte de estar vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: Pare de correr atrás de todas as perguntas de uma só vez. As estradas são construídas com uma pedra de cada vez, querido. Está me entendendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: E talvez isso ajude você a pensar, nós não desaparecemos por completo quando as cortinas caem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: Eu costumava acreditar em céu e inferno. Mas agora? Eu não tenho tanta certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: Talvez seja uma coisa totalmente distinta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: O que você acha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: Sim, querido? Tá pensando em alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: Você está grávida e tá chegando o dia, não tá?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: Ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: O desespero pegou você, não é mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: Tudo o que você acredita está desmoronando e você não consegue aceitar isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: É por você não querer ir para seja lá onde todos nós vamos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: Ou é por você não acreditar que pertence mais a esse mundo? Ou a qualquer mundo, seja lá o que for?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: Eu não estou falando disso. Você está grávida
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: Você não está com medo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: Querido... eu não conseguiria parir tão rápido assim, mesmo querendo. Eu não estou nem com a barriguinha de grávida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: Posso te perguntar uma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: Se essa criança é real...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: E se, como você diz, ela estiver chegando em breve...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: O que você vai fazer? Você tentaria encontrá-la?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: Ela não deveria existir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: Eu ainda não decidi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: Hum. Boa pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: Morrer é aterrorizante, é claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: Mas é mais por não sabermos o que vem depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: O céu, o renascimento, ou algo totalmente diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: Ninguém voltou para contar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: Mas sobre essas suas visões...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: Se a criança é real...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: E se, como você diz, ela estiver chegando em breve...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: O que você vai fazer? Você tentaria encontrá-la?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: Ela não deveria existir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: Eu ainda não decidi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: Vez ou outra o instinto quer preservar o que é familiar, mesmo não te ajudando mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: Talvez...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: Talvez seja hora de abrir os olhos para algo novo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: Ou o desconhecido te assusta tanto assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: Eu vou encontrar a criança
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: Ela está vindo. Eu sei que está
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: Você não devia ter medo de deixar as coisas irem. Especialmente quando elas pararam de ajudar você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: As vezes nos seguramos em alguma coisa só por ser familiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: E sim, é doloroso quebrar hábitos. Mas quem sabe o que isso pode nos levar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: Eu vou encontrar a criança
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: Ela está vindo. Eu sei que está
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: Se é o que você diz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: Me conta o que você encontrar... quando a hora chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: Nascida na cidade eu sou, docinho. Eu tinha um muquifinho lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: Sem chalé no campo, sem família, sem netinhos... Ai, querido...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: Então eu sentava no banco perto da porta quase todos os dias. Sentia um pouco de vida ali, e escutava todo o tipo de conversa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: Mas quando os problemas chegaram, até mesmo isso não me traziam alegria.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: Como você vai sentir a vida quando a morte tá por perto? O pessoal caindo morto que nem moscas, estão.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: Bote o pé na escada e sempre terá alguém deitado lá, coberto com um pano branco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: Pelos céus, isso já é o suficiente para fazer você desejar sumir de uma vez ao invés de testemunhar tanta tristeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: Então eu saio por aí, procurando por um lugar onde ainda há gente e histórias para ouvir e vidas para se sentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: E veja só, o destino me guiou até a sua porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: Não sou praticante, mas em momentos como este... bem, sinto que foi o próprio senhor que guiou os meus passos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: Mas todo mundo esqueceu de mim, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: Se ainda houverem pessoas vivas elas não virão me visitar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: E verdade seja dita, eu não sou a única. Várias pessoas esquecem dos seus familiares...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: Enxergando apenas seus próprios narizes. Nem uma alma viva para perguntar como eu estou.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: Uma vez, enquanto nós sentávamos no banco, a minha vizinha veio se gabando sobre seu neto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: Ela disse "Meu menino é um dos bons! Lembra dos mais velhos e me visita. Não é como os outros."'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: E ele era mesmo um garoto do bem. Sempre me cumprimentava, perguntava como as coisas estavam indo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: Eu até senti um tiquinho de inveja...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: E aí a morte chegou até ela...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: E o garoto... é, ele se tornou seco e amargo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: Acontece que a bondade toda era só pelo apartamento. Ele queria muito a herança...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: Por que você acha que as pessoas mentem descaradamente umas para as outras, especialmente em uma família?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: Case, tenha filhos e aí... você acredita? Eles não te amam coisa nenhuma.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: Ai, ai, que sorte a minha não ter um marido. Um velho malvado, ele era. Uhh.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: Ah, mas ele também já morreu, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: Arruinou a minha vida, aquele traste de homem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: Só casei com ele por que meu pai e minha mãe me obrigaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: Eles disseram, "case com ele, filhota". Então, nós casamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: No início ele realmente se importava. Mas assim que o êxtase do casamento passou a podridão em sua alma começou a se mostrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: Primeiro, minha comida estava sempre ruim. Depois, "Para de encher o saco, você não tá me vendo comer?"'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: E em seus últimos anos ele saia para beber com os amigos e desaparecia por horas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: Voltava embriagado, contando histórias fantásticas sobre jogar dominó na garagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: E se eu perguntasse se ele tinha bebido, ele me xingaria de todos os jeitos, o filho da puta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: Aí a morte veio para ele, também.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: De primeira eu me senti mais leve. Mas não tardou para a solidão se instalar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: A TV ajudou por um tempo, mas agora só se vê maluquice... uma cadeia de mentiras.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: Então eu fui para a beira da estrada e me sentei no banco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: Ah, meu bem...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: Eu comecei sim a me sentir um pouquinho melhor ao assistir o mundo acontecer. As crianças rindo, os jovens casais passeando de mãos dadas, os cãezinhos correndo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: Mas aí veio esse problema...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: E um por um o pessoal foi se isolando em casa. Sem mais sentar no banco pela noite, assistindo a agitação da vida passar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: Ficar olhando pela janela também não era uma coisa boa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: Existem sacos com cadáveres onde as crianças costumavam brincar. Os cães selvagens vagavam pelas ruas e os vizinhos começaram a se encarar como estranhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: A vida, queridinho, pareceu ter perdido toda a sua pulsação.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: E agora você não consegue nem mesmo distinguir verdades de mentiras...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: Eu queria que as pessoas só parassem de mentir...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: Ahh... água gelada. Agora sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: Está se sentindo melhor?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: Sim, sim, eu me sinto melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: Sabe, tá me dando uma fome. Tem algo pra beliscar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: Eu posso dar um pouco de cerveja (Dá uma lata de cerveja pra ele)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: O que, nada de cerveja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: Não tira comigo, eu vi sua geladeira cheia. Como diabos bebeu tudo aquilo rápido assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: Ahh, é disso que eu tava falando!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: Humm, isso é bom. Minha favorita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: Aqui, uns trocados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (Você recebe um amontoado de notas amassadas, inúteis hoje em dia)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: Tá... obrigado
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: Eu não dou a mínima pro seu dinheiro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: Agora sim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: Você me dá o que eu peço, e será pago como um chefe de fábrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: Eu não seguro dinheiro pra quem me ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: Ah, por sinal, aqui, pegue isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (Você recebe um pote de kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: Não sei quem bebe essa merda, mas pega aí. Pode ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: O que você quer dizer com “não dou a mínima”? Você se acha especial ou qualquer coisa assim!?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: Todo mundo precisa de dinheiro! A porra do mundo gira em torno disso. Não precisa de dinheiro, é...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: Aqui, pega isso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (Você recebe um pote de kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: Não sei quem bebe essa merda, mas pega aí. Pode ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: Como assim, não? Você acha que não pode ser comprado? Tudo está à venda! Amor, coisas, pessoas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: O mundo comanda o mundo, garoto! E eu? Eu sou o grandão! Um ministro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: Tá, esquece. Não quer ajudar, então foda-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: Ahh... água gelada. Agora sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: O que você precisa agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: Ah, que bom que perguntou! Eu adoraria fumar algo. Tem um cigarro sobrando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: 'Sim, pode pegar (Dar cigarros) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: O que, sem cigarros?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: Tá, esquece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: Agora sim, é disso que eu tava falando!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: Eu costumava fumar charutos, é claro... mas boa sorte achando um desses agora. Na época que eu era da câmara...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: É... as coisas eram diferentes. Agora é assassinato e caos. Um completo pesadelo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: Quando que a FEMA vai fazer algo e dar um jeito nisso? Eles não foram formados pra nada, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: Nenhuma dessa merda teria acontecido quando eu era do Parlamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: Mas pode ser que só precisem de mais tempo. Tudo vai ser colocado no lugar eventualmente. Só precisamos esperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: Você era do Parlamento?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: Você teve parte na fundação da FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: Bom, sim, acabei de dizer isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: Ah, sim, aqui está sua recompensa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (Você recebe um punhado de notas amassadas sem valor e um cartão postal esquisito carimbado com um selo da FEMA)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: De onde tirou essa ideia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: Ah, sim, aqui está sua recompensa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (Você recebe um punhado de notas amassadas sem valor e um cartão postal esquisito carimbado com um selo da FEMA)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: Como assim, não!? Você ao menos sabe quem eu sou!?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: Eu era um ministro! O governo é uma máquina complicada, e precisa de pessoas como eu para conduzi-la!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: Eu sou a voz do povo! Sem gente como eu, pessoas como você não seriam ouvidas. Eu torno a vida melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: Se os tempos fossem normais, você não ousaria me desacatar! Você seria levado embora em um segundo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: O mundo tá em pedaços... Ninguém mais dá bola pra um ministro sem poder nenhum... As pessoas pensam que a gente fica de braços cruzados no escritório...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: Heh. Vamos ver se vai continuar falando quando tudo for pro inferno de vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: Ahh... água gelada. Agora sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: Você precisa de algo de novo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: Você é um jovem esperto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: Eu quero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: Eu quero um energético! Não tomo nada refrescante e forte faz eras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: 'Tá bom, toma (Dar energético) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: Você não tem Enerjeka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: Tá, esquece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: Que azar né
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: Aaah, sim sim sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: Me conte sobre a FEMA. Quem são eles?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: O que a FEMA está planejando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: O que, é sem açúcar? Isso é porcaria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: Você deveria ter me trazido um refrigerante ao invés dessa porc—... Peraí, o que você acabou de me perguntar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: Você tá maluco? Eu não vou falar coisa nenhuma. Isso é confidencial!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: Eu assinei documentos, entendeu? É segredo. Você não tem credencial pra isso, sem ofensas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: Aqui, toma um café então, e pare de fazer essas perguntas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (Você recebe uma lata de café)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: E é Enerjeka também. Só deus sabe que tipo de porcaria botam nisso... Pera, o que você acabou de perguntar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: Você tá maluco? Eu não vou falar coisa nenhuma. Isso é confidencial!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: Eu assinei documentos, entendeu? É segredo. Você não tem credencial pra isso, sem ofensas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: Aqui, toma um café então, e pare de fazer essas perguntas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (Você recebe uma lata de café)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: Que porra você quer dizer? Como que eu posso trabalhar de estômago vazio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: Eu tô aqui tentando tornar a vida melhor! Eu defendo o povo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: Mas tudo que vocês fazem é criticar... Todo mundo se acha tão inteligente. Então por que não estão no governo, hein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: Exatamente. Muita atitude, pouca ação.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: Ahh... água gelada. Agora sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: O que? Precisa de algo de novo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: Isso mesmo, jovem. Eu quero a sua espingarda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: O que?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: Você perdeu o juízo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: É, eu preciso dela pra me proteger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: Não se preocupe, estou acostumado a caçar. Eu sei como usar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: Você não vai ficar com ela
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: Vai pro inferno
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: Olha o palavreado, jovem. Esqueceu com quem está falando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: Se eu quiser, posso te botar atrás das grades em um segundo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: Você não vai ficar com ela
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: Vai pro inferno
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: O que você acabou de dizer? Eu ouvi isso direito?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: É isso. Você tá ferrado agora!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: Comece a fazer as malas, por que já vai direto pra cadeia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: Pra mim, você não é nada além de outro visitante
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: Eu não me importo se você é um ministro. Pra mim, você é um ninguém.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: Você perdeu o juízo, falando com a voz do povo assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: Você se ferrou, amigo. Prepare-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: Grande erro, me enfurecer! Os vereadores tem poder, se já não sabia disso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: Não se preocupe... Você vai ser botado na linha logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: Pra mim, você não é nada além de outro visitante
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: Eu não me importo se você é um ministro. Pra mim, você é um ninguém.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: Que merda você tá falando!? Você... cuidado com a sua língua!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: Eu não tô de brincadeira aqui... é muito sério. Você vai mesmo acabar atrás das grades, vai ver só...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: Que merda você tá falando!? Você... cuidado com a sua língua!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: Eu não tô de brincadeira aqui... é muito sério. Você vai mesmo acabar atrás das grades, vai ver só...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: Ahh... água gelada. Agora sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: Então por que não estou atrás das grades ainda?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: Tirando sarro de mim, é? Eu... eu não tô brincando! Você vai mesmo pra cadeia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: Talvez um título valesse algo. Mas agora você é nada.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: O dinheiro não significa nada agora. Você não entende?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: Isso... isso não é verdade! Eu ainda estou no Parlamento!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: Eles só... me deixaram afastado...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: Quem eu tô tentando enganar... A vida não vai voltar a ser como era...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: Quando eu tinha meu mandato, o país inteiro estava nas mãos se nós, ministros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: As pessoas me temiam, me respeitavam. Os carros davam espaço, as multidões se juntavam para me agradar... todos tentando me conquistar. E agora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: Ótimo. Agora meu estômago tá dando nó de estresse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: Feliz agora? Só vai embora. Já aguentei o suficiente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: I-isso não é verdade! Eu ainda tenho muito dinheiro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: Você pode não dar bola, mas... mas todos os outros dão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: Quem eu tô tentando enganar... A vida não vai voltar a ser como era...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: Acabou a luxúria, as limusines, as mulheres...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: Com dinheiro, tudo era muito mais fácil. Você tinha dinheiro, logo você era relevante!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: Se não fosse pelo colapso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: Ótimo. Agora meu estômago tá dando nó de estresse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: Feliz agora? Só vai embora. Já aguentei o suficiente...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: Já conversamos. Estou cansado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: Vamos continuar isso amanhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: Meu deus, eu não aguento mais isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: Por que você está por aí sozinha?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: Bom... em casa era apertado. Barulhento pra caramba. Zero conforto. Eu queria sair. Queria ver o mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: Então é, peguei uma mochila, uns refris, umas barrinhas e essa velha pulseira da amizade que eu fiz na escola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: E aí fui embora. Meus pais provavelmente nem notaram. Não que eu me importe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: Desde então tenho só andado por aí, passo a noite onde dá. E, no sério? Até agora tá tudo indo muito bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: Pelo menos não tem ninguém me enchendo o saco, e eu mando em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: Meu deus, eu não aguento mais isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: E como você sobreviveu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: De alguma forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: Eu me escondia em escadarias, em cabanas, ou só dormia no chão mesmo de baixo de uma árvore. Me escondia do calor em qualquer teto que pudesse encontrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: Comida o que for que eu conseguisse. Aglumas verduras e um doce que roubei de uma loja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: Qual é a desse olhar? Sim, eu roubei. Grande coisa. O que mais eu deveria fazer pra sobreviver? Ninguém vai me contratar com a minha idade. Então eu dou um jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: Uh, o que foi agora? Tá achando que vou te roubar, é? Me faça o favor!'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: Sério? O que é isso, um interrogatório? No sério, corta essa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: Meu deus, eu não aguento mais isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: Por quanto tempo pretende viver assim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: Por que você ao menos se importa? Eu vou dar um jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: Ou o que, é difícil pra você me deixar ficar aqui? Eu roubei de você? Entupi o seu banheiro? Por que você tá me interrogando, hein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: Entendi... talvez você seja um daqueles esquisitos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: Teve um cara uma vez, me aceitou em casa. Falava muito bem, me deu um lugar pra passar a noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: Passamos horas vendo animes, filmes, coisas assim. Pensei que finalmente tivesse encontrado uma pessoa decente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: Então ele tentou tocar em mim. Esquisito de merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: Tente fazer qualquer coisa e eu vou arranhar, morder, fazer o que for. Eu não vou tolerar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: Meu pai é um babaca mas pelo menos me ensinou a brigar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: Isso mesmo. Não toca em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: Meu deus, eu não aguento mais isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: E o que aconteceu com aquele cara?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: Por que quer saber? Procurando por um jeito de lidar comigo se eu revidar? Percebeu que eu não tô mais com ele?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: E não pensa que eu não entendo. Você não pergunta por bondade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: Você só não quer problemas na sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: Mas eu não sou problema. Eu não tô roubando, não quebrei suas janelas, então pare de agir como se eu fosse um problema!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: E de qualquer forma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: Eu só tô aqui por que você precisa de mim por perto, né? Pra que aquele Visitante pelado não te leve embora? É, eu também ouço as notícias.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: Se é assim que vai ser, que seja! Então, hã, enfim. Faça os seus testes bizarros aí, só não fala comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: Meu deus, eu não aguento mais isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: Por que o seu pai te ensinou a lutar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: Pra que eu pudesse arrebentar os esquisitos. Ou pra que ele pudesse descontar a raiva em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: Ele me fez treinar desde que eu tinha, tipo, três anos. Sparring, tomar soco, blá blá. O único problema? Ao invés de um saco de pancadas, era a minha cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: Mas, tipo, treinar com ele era uma coisa. Que, aliás, eu odiava.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: Era outra coisa quando ele perdia a cabeça e me enchia de porrada. E a minha mãe? Ela não tava nem aí. Nem sequer olhava.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: Uh, eu não quero acabar como eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: Por que cacetas me tiveram? Só pra me tratar desse jeito? Eu ainda não consigo entender. A vida é assim de verdade?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: E, tipo, irado, agora temos o Sol e os Visitantes! Mais dois motivos pra tudo ser um bocado de merda. Ótimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: Será que alguma coisa boa vai acontecer em algum momento?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: Duvido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: Estou ouvindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: O que aconteceu com os hospitais?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: Ahhh... foi um pesadelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: Assim que tudo começou, as pessoas começaram a invadir os hospitais. Estavam desesperados para saber se eram ou não um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: Nós tentamos explicar que não sabíamos como testar isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: Mas, as pessoas não ouviam. Eles continuavam empurrando e insistindo, e tornavam impossível tratar aqueles que estavam realmente doentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: No final, a FEMA apareceu. Eles decidiram que as multidões eram uma ameaça à situação de epidemia...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: Então todos foram mandados para as zonas de quarentena, e os hospitais... só fecharam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: Então a FEMA tirou o seu trabalho?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: A FEMA fez a coisa errada?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: Pra falar a verdade... depois que os hospitais fecharam, eu fui trabalhar pra FEMA nas zonas de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: Por que você foi pra lá?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: Então você é só mais um maldito da FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: E você acha que foi certo só rebanhar todos daquele jeito?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: Não acha esses ditos “sinais’ um absurdo, nada além de características humanas comuns?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: É bobagem! Dentes brancos dizem que uma pessoa é Visitante? Por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: Eu estou dizendo, eles estão escondendo algo de nós...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: Pra falar a verdade... depois que os hospitais fecharam, eu fui trabalhar pra FEMA nas zonas de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: Eu esperava aprender algo sobre os Visitantes e seus sinais. Mas... nada se concretizou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: Por que você foi pra lá?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: Então você é só mais um maldito da FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: Eu... eu queria continuar ajudando as pessoas. É a minha vocação. Eu não podia só fugir disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: Talvez... Não. Me desculpe, não estou pronto para falar sobre isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: Você está errado em me chamar de maldito. Você não sabe da história toda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: Talvez... Não. Me desculpe, não estou pronto para falar sobre isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: Estou ouvindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: Então, o que você queria me dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: Se me permite perguntar, o que você acha da FEMA?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: Eu acho que a FEMA faz um bom trabalho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: Eu não acredito na FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: Uma pena. Eu me sinto o completo oposto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: Eu trabalhei para eles um tempo, mas não tenho razão nenhuma para ter confiança neles. Especialmente depois do que eu vi lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: Da minha experiência própria, os doutores naquela organização são mantidos totalmente no escudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: Você realmente acredita em uma organização que não sabe nem explicar de onde vem aqueles sinais, ou o que significam?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: Depois de tudo aquilo... como você pode ainda acreditar na FEMA?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: Devo admitir, pensava melhor de você antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: Ótimo. Nem eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: Honestamente, eu mesmo não entendo os motivos da FEMA. Mesmo depois de trabalhar com eles por um tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: Mas seja o que for que guia eles, eu escolhi ajudar as pessoas da minha forma, contra as regras deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: O problema era a transparência. Não tinha nenhuma. Nenhuma mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: Nunca nos foi dito de onde esses “sinais” vêm, ou o que eles significam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: Eles só nos deram uma lista de diretrizes, quem devemos chamar de Visitante, quem devemos deixar passar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: Depois disso, nunca mais me senti um médico novamente. Era mais como um agente de fronteira carimbando documentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: Então comecei a falsificar relatórios. Ajudei pessoas escaparem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: Tenho certeza que você ainda tem perguntas. Mas se você não se importar, vamos deixar o resto para amanhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: Perdão, mas hoje não consigo mais conversar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: Então, decidi sair da organização.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: Estou ouvindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: Por que você não tá na zona de quarentena?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: Foi... aquele incidente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: O sol estava nascendo. Eu estava indo para quando quando um dos agentes da FEMA me chamou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: Naquele momento, meu coração começou a palpitar, minhas pernas quase cederam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: Ele ordenou que eu me virasse. Estava preparado pra morrer ali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: Ele mirou em mim e disse para não me mover. Ele continuou me encarando, e então...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: Mandou eu mostrar a língua, disse que precisava verificar se eu não era um Visitante. E eu fiz, morrendo de medo que ele fosse atirar em mim caso contrário.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: Então... ele riu. Disse que eu devia ser um médico incompetente se eu nem ao menos sabia que a língua não é um sinal de Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: Eu nunca tive tanto medo na minha vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: Naquele momento eu não estava pensando em salvar a vida de ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: Eu só corri. Como um covarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: A vergonha... é insuportável. Vergonha por aqueles que foram deixados lá. Vergonha de mim mesmo. Antes de qualquer outro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: Eu não estou te julgando
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: Mas você ainda pode ajudar pessoas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: Você é um covarde patético. Saia da minha casa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: Obrigado por entender. Isso... isso me faz sentir um pouco melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: Eu não consigo parar de pensar sobre quantas vidas a mais eu poderia salvar, se eu pelo menos ficasse lá até o fim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: Temo que não consigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: Todos os meus instrumentos foram deixados para trás na zona de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: Então... sou completamente inútil agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: Eu sei que você estava esperando por tratamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: Mas o que pode fazer um velho como eu sem nada além de suas mãos vazias? Quase nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: Desculpe por decepcioná-lo. Temo que não tenho poder contra a ameaça dos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: Não se preocupe, você pode ficar mesmo assim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: Então cuidado pra não bater a porta na saída
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: Acho que você está certo. Eu devo seguir meu caminho...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: Obrigado por entender. Isso... isso me faz sentir um pouco melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: Eu imagino que a FEMA teria descoberto os relatórios falsos mais cedo ou mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: Ainda assim, não consigo tirar da cabeça o pensamento de que poderia ter dado minha vida para salvar mais pessoas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: Temo que isso vai pesar em mim pro resto da minha vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: Acho que você está certo. Não tem lugar para um velho como eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: Qual é a razão da pergunta? Você quer descobrir porquê eu não confio na FEMA?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: Vamos começar assim...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: Você acredita que os Visitantes são algum tipo de vírus?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: Acho que eles não existem
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: Não. Mas eu não sei o que eles são de verdade
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: Sim, eu acho
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: Se é nisso que você acredita então eu não sei por que você se importa com todas essas verificações.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: Não tente me enganar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: Então...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: Eu entendo. Infelizmente, eu também não sei o que os Visitantes são de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: Mas uma coisa eu posso dizer, eles não são nenhum tipo de vírus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: Certo, creio que terei que desapontar você. Não é esse o caso, provavelmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: Você já viu uma pessoa que parece estar perfeitamente bem e muda repentinamente? Se torna um Visitante bem atrás de você?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: Exatamente. Não existe um único caso assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: Você precisa compreender. A FEMA não está no controle da situação. Eles só fingem que estão.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: Eles fecham hospitais, mandam todo mundo para as zonas de quarentena... qual o motivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: Eles estão ajudando a população? Alguém já saiu de lá curado?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: a FEMA só tocou o povo como um rebanho de bois, os trancafiou e agora fazem o que bem entendem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: Então por que você trabalha para a FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: Chega dessa loucura. Sai daqui
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: Eu só não consegui ficar sentado, assistindo pessoas serem mortas, uma por uma.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: Foi por isso que me juntei à FEMA, para ajudar essas pobres almas a escaparem das zonas de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: Eu os examinei e fiz meus diagnósticos, eu forjei documentos para que eles pudessem viver livres.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: Os Visitantes podem ter escapados por culpa sua
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: Que incidente?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: É uma pena que você também tenha que fugir daqui
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: É uma lástima o fato de você nem mesmo tentar me ouvir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: Então eu não ocuparei mais espaço em sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: E o que você escolheria? Deixar eles lá para morrerem?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: Eu fiz o juramento de hipócratres. Eu farei tudo ao meu alcance, para proteger a vida e a saúde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: Mas, no fim das contas, eu tive que fugir da zona de quarentena sozinho depois de um ocorrido. Um infortúnio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: Aconteceu na zona em que eu estava alocado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: Quê?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: Você acha que eu não devia ter ajudado eles? E agora você está me expulsando por isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: Eu nunca achei que diria isso, mas você é pior do que a FEMA. Pelo menos eles fingem ser pessoas. Já você...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: Aqui já não tem mais lugar para mim. Eu me pergunto o que acontecerá com aqueles que estão sob os seus cuidados.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: Não se acanhe, cara. Vai lá, pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: Ainda acha que a FEMA está atrás de você?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: Realmente espero que não, sabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: É, eu estraguei tudo, indo até a FEMA daquele jeito. Devia ter imaginado que iam tentar me capturar também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: Imaginei que fossem só pegar o passageiro de me deixar em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: Ao invés disso, eles pegaram meu carro e quase atiraram em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: Mas pensa nisso, cara, o que mais eu poderia ter feito? O cara era um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: E se ele era um humano?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: Você não tinha escolha
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: Ah... ei, não diz isso não, cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: Eu ainda tô me sentindo meio esquisito sobre o que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: Bem... cê tá certo. Não tinha mesmo outro jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: Rapaz, eu sinto falta dos dias onde você só dirigia sem pensar em nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: Agora, com esses Visitantes... caralho, talvez o próximo passageiro decida enfiar uma bala na tua cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: É...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: Não se acanhe, cara. Vai lá, pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: Há quanto tempo você dirige um táxi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: É, tô nessa faz um tempo, sabe. Ultimamente não trabalho pra ninguém, sou meu próprio chefe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: A FEMA não deixa civis andarem livres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: Mas essa desgraça vai acabar um dia, não vai? E dinheiro... dinheiro é sempre bom de se ter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: As pessoas pagam muito bem por corridas arriscadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: E dirigir de noite meio que trás lembranças de quando eu era criança.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: Sabe, eu virei taxista por causa do meu pai. Queria seguir os passos dele, sabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: ....'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: Não quero terminar de escanteio, apagado, sem ser notado... como o meu coroa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: Torço pra que a minha sorte ainda não tenha acabado...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: Não se acanhe, cara. Vai lá, pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: Você parece bem pra baixo hoje
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: É, é só que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: É só que não consigo superar o fato de que meu carro já era, sabe...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: Que tipo de carro você tinha?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: O que fazia o seu carro ser tão especial?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: Ah cara, era o carro clássico mais lindo do mundo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: Pintura amarela reluzente, rodas cromadas no brilho, belas curvas...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: Mas ela já era agora...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: Maldita FEMA... Aquele carro era tudo pra mim! Malditos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: Era o carro do meu pai. Ele era taxista também.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: Quando eu era criança, adorava andar com ele de noite. Sempre dormia no banco de trás, então ele me levava junto. Mas aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: Você poderia dizer que a sorte dele acabou...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: Não se acanhe, cara. Vai lá, pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: O que aconteceu com seu pai?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: Eu não falo muito disso, mas... Acho que posso confiar em você.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: Um dia, minha mãe precisou sair pra uma viagem de trabalho, então meu pai me levou com ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: Foi aí que pegamos um passageiro que nunca vou esquecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: Terno fino, careca, sorriso de uma fera.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: Todos na cidade sabiam que ele era. Até eu, uma criancinha. Dizer não pra um cara desses? Nem pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: Mas meu pai era um cara de honra. E aquela escolha... pegou todos nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: O cara de terno garantiu que pagássemos por isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: Perdemos nossa casa. Não conseguíamos ficar em um lugar por muito tempo depois disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: E já que mal tínhamos dinheiro, meu pai ficou com o taxi que dirigia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: Quando velho, afogado em dívidas, ele começou a desejar que nunca tivesse ficado com ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: Disse que era amaldiçoado. Disse que trouxe toda nossa má sorte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: Mas ele nunca entendeu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: Não era o carro. Era o orgulho dele. Foi isso que nos custou tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: Ainda assim... mesmo que as escolhas dele significaram que eu precisei começar a trabalhar cedo pra botar comida na mesa...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: Eu ainda amo ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: Tenho saudades do meu velho...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: Não é pedir muito, mas... se não for um problema, poderia, hum, lugar pra ele?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: Aqui o número dele: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: Só diga que estou bem. Eu daria conta disso, mas... agora não dá pra dizer onde eu tô.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: Espero que não tenha me exposto demais ao sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: Você não tá mesmo com a FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: É, eu não tô com eles de verdade. Eu te disse, eu consertava geladeiras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: Eu encontrei o uniforme no carro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: Você disse mais cedo que a farda era de um cadáver
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: Você não tá mentindo pra mim, né?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: Hã... é, é, tenho certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: Encontrei em um carro, em um cara morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: Pensei que o uniforme me protegeria dos Visitantes. Tipo, o pessoal da FEMA usa isso por algum motivo, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: Não tô mentindo. O estresse altera muito meu humor. O que tem de tão estranho nisso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: Acredite, você entenderia se tivesse visto as coisas que eu vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: Quase me borrei de medo vindo pra cá, tinham tantos cadáveres ainda se contorcendo no chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: Espero que não tenha me exposto demais ao sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: Você acha que usar um uniforme da FEMA é uma ideia ruim?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: O que? Bom... não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: Digo, sim, algumas pessoas não gostam da FEMA, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: Ahh, você quer dizer que posso ter problemas com a FEMA, é isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: Bom, escuta, eu... eu acho que se eu só explicar tudo, eles vão acreditar em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: Não precisamos transformar eles em demônios. Não é como se fossem uma sociedade secreta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: Espero que não tenha me exposto demais ao sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: Vamos ver o que tem nos seus bolsos
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: Ei, você quer me revistar por que?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: Estou procurando o seu crachá da FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: Que foi, tá escondendo algo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: Como é? Que crachá?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: Eu juro, não tenho nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: Esvazie seus bolsos. Vamos fazer isso da maneira fácil
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (Sacar sua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: Quem? E eu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: Não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: Esvazie seus bolsos. Vamos fazer isso da maneira fácil
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (Sacar sua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: Tá bom, tá bom. Não precisa de violência...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: Aqui. Feliz agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: Tá bom, você me pegou. Eu tô mesmo com a FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: Mas por favor, não diga para os outros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: Ah, merda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: Aqui. Só não atira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: Sim... eu tô mesmo com a FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: Mas, é melhor não deixar os outros descobrirem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: Por que você escondeu que estava com a FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: E por que ficar de mistério assim?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: Você não entende mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: Tá falando sério?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: Se as pessoas descobrirem que eu trabalhava pra FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: Olha, eu não estou mais com a FEMA. Pense que eu... me demiti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: Olha, eu não estou mais com a FEMA. Pense que eu... me demiti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: Sim, eu precisei fazer algumas coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: Levar pessoas, mandar elas pra zonas de quarentena...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: Mas olha, era meu trabalho, sabe? Eu tava só seguindo ordens.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: Não tem por que me perguntar sobre aqueles que levamos. Isso é com os superiores, não comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: E me chamar de assassino, ou o que for... isso é ridículo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: O que você chama quando um assassino mata outro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: Espero que não tenha me exposto demais ao sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: Por que você escondeu que estava com a FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: Uma vez eu peguei um cara mostrando sinais de Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: Em resumo, ele ficou pior na zona de quarentena e morreu. Acontece.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: Então veio a esposa dele. Queria saber quando iríamos soltar ele. Falamos que não tinha mais nada pra soltar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: Vimos que ela estava em choque. Começou a gritar, nos chamar de assassinos, exigindo o corpo de volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: Dissemos que o protocolo não permitia. Isso não parou ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: Acampou no chão, logo depois da entrada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: Entregamos o corpo pra ela. E então eles demitiram todos que quebraram o protocolo. Eu incluso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: Ela tinha que pegar o maldito corpo. Aquela maluca me custou o meu trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: E agora eu não tenho pra onde ir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: E ao invés de enterrar ele, ela carrega o corpo por aí junto com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: Com certeza valeu a pena nos demitir, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: Vocês da FEMA são uns malditos mesmo
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: Que azar né.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: É o que!?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: Então eu tô fazendo meu trabalho, meu dever, e sou demitido por causa de uma doida...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: E você nos chama de malditos!?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: Quer saber, pro caralho com o seu abrigo. Tô fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: Minha nossa, mas todo mundo perdeu a cabeça?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: Não, não, isso foi exatamente o que aconteceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: Desde que o sol foi pro caralho e as infecções começaram, todos ficaram doidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: Aquele maldito cadáver valia mesmo os nossos empregos? O que você acha?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: Bom que ela se reuniu com o marido
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: Não deveria ter dado o corpo pra ela
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: Você tá dizendo que foi bom termos sido demitidos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: Vocês civis não entendem nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: Devia ter atirado nela, igual com o marido dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: O que você acabou de dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (Sacar sua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: Qual é a desse olhar?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: O protocolo diz que se um civil contaminado está mal...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: Então lidamos com o problema na hora, pra que um Visitante não acabe na quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: Deixar ele ir
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (Sacar sua arma)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: Obrigado por entender.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: Eu não sou um assassino, só estava seguindo ordens.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: Ei, peraí o que você tá fazendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: Calma, ele era um Visitante! E tava muito mal! Não podíamos só deixar ele ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: Não atire, eu só segui ordens.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: Eu também acho. Devia ter seguido o protocolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: Tá, não vou mais incomodar você. Obrigado por me deixar entrar mesmo assim, mesmo sabendo que eu era FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: Se eu conseguir meu trabalho de volta, vou lembrar da sua cooperação.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: Certo, era só isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: Ah, é, quase esqueci.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: Tô voltando pra casa amanhã pela noite. Anota o meu número, acabaram de instalar uma linha nova.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour: A gente se fala pelo telefone.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: Beleza, agora eu tô indo mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: Tomar uma gelada e pregar os olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: Fazer carinho no gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: Pegar o gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: Dar um pouco de comida enlatada pro gato (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (Você estende a mão e faz carinho no gato)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (Difícil dizer se ele gostou ou não)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: Fazer carinho no gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: Pegar o gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: Dar um pouco de comida enlatada pro gato (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (Você decide fazer carinho no gato)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (Ele parece ter gostado)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (Não é tão mal-humorado quando você pensava)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (Parece que está se acostumando com você)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: Fazer carinho no gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: Pegar o gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: Dar um pouco de comida enlatada pro gato (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (O gato gosta bastante de receber carinho com frequencia)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (Você sente que ele agora vai em direção ao seu toque)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (Mas como você diria não pra uma coisa fofinha dessas?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: Miau! MIAU! Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (A carinha dele é difícil de entender, mas você tem quase certeza que ele está feliz)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (Você tem a sensação estranha de que pode dormir em paz essa noite)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (Como se o eu amigo peludo tivesse compartilhado uma de suas vidas com você como agradecimento)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (Quem sabe... talvez a morte vai passar reto pela sua casa esta noite)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: Pobres pequeninhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: Tem algo errado?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: Preciso verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: Hum?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: Eu... eu estava pensando...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: Se isso não é uma extinção em massa, se sobrevivermos... o que nos aguarda?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: Que tipo de futuro nos resta?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: Você tem medo que não terá um lugar para você no mundo?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: Um coração gentil não durará muito nos dias atuais. É melhor você encontrar alguém pra se apoiar
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: Um coração gentil...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: Eu não consigo viver com violência.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: Eu não sei onde me encaixo... no... como você chamou... no “novo mundo”.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: Então o plano é se deitar e morrer?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: E o que você sugere?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: Tempos sombrios vieram para todos antes... isso não é novidade.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: Eu não quero isso. Mesmo que alguém me proteja...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: As mortes não irão parar. A violência não vai desaparecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: Então o plano é se deitar e morrer?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: E o que você sugere?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: Tempos sombrios vieram para todos antes... isso não é novidade.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: Eu me sinto tão perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: Nós vamos mesmo viver em meio a assassinos?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: As crianças vão aprender com assassinos agora?..'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: Não tem tempo pra ficar se martirizando agora
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: CAIA NA REAL!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: Eu não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: Eu não tenho nada a oferecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: Eu só... quero que isso acabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: Eu... eu não consigo mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: Sim, é verdade. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: E agora, como é que viveremos?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: As pessoas ficaram loucas, matando todos que parecem... diferentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: Não importa quem ficar no caminho.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: Não tem tempo pra ficar se martirizando agora
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: CAIA NA REAL!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: Por que não?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: Talvez a indiferença ajude. Mas eu não consigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: Se você pudesse ver o que eu vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: Aquilo queimou nos meus olhos, para sempre...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: Fogo. Gritos. Rostos furiosos e aterrorizados. Lares destruídos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: Eu não consigo ser como você. Não sou forte assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: Para mim... só há um jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (A mulher se encolhe, olhando para você com medo)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (A confusão a ajudou a esquecer os pesadelos, mas só por um momento)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (Ela cobre o rosto com as mãos e chora)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (Você não sabe o que fazer. Ninguém te ensinou isso)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (Você coloca a mão no ombro dela com cuidado e fica assim por um tempo)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (Talvez seja melhor deixar ela só por um tempo)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: Ei, quer saber, será que você pode ligar para ele? {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: E dizer o que você pensa sobre isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: Enfim, as crianças também são dele. Ele deveria ajudar na busca.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: Se tiver sinal, você vai ligar, né? O número é {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: Só diga pra ela que eu lembro de tudo... e que eu ainda quero me degolar e acabar com a minha existência.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: Ou você pode só gritar com ela. Por mim, eu não sei. Talvez isso até deixe mais fácil...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: E algumas pessoas... bom, algumas delas precisam de ajuda do além.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: Existem indivíduos... especialistas... que sabem purificar a escuridão.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: Se você se interessar, posso te passar um contato. Pode te ajudar...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: Eu vou escrever o número pra você: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: Diga que fui eu que indiquei você... Não se esqueça disso!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: Se não for um problema, você pode ligar pra ele? {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (Ele pega um pedaço de papel com um número escrito: {0})'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (Talvez seja o número da embaixada estrangeira)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: Cara, tô doido por uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: O que você quis dizer sobre ser imortal?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: Eu quero verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: Bom... você podia enfiar uma bala na sua testa e verificar...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: Mas eu não faria isso, se fosse você.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: Não, é claro que não somos imortais desse jeito que você está pensando.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: Depois da morte, nós reencarnamos e continuamos vivendo nossas vidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: Eu sei como isso parece, mas se você tivesse visto o que eu vi... você entenderia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: Talvez os Visitantes já tenham sido humanos, e aí renasceram.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: Eu não tenho como confirmar. Eu não sei como essa merda funciona...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: Mas, tenho certeza que a natureza esconde vários segredos da gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: E eu vou encontrar minha filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: Eu não sei em qual vida... mas, eu vou.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: Por que nunca iremos morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: Cara, tô doido por uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: Por que a FEMA está atrás de você?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: Eu quero verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: Eu tava no epicentro dessa merda toda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: Nas terras de onde essas coisas rastejaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: Lembra daquelas lendas urbanas imbecis sobre demônios nas redondezas da cidade?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: Esquece, ninguém lembra mais delas agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: Parece que no final das contas não eram lendas. A FEMA sabia o tempo todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: Eles diziam que não tinha nada místico lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: E agora o sol está queimando todos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: Enquanto monstros do subterrâneo acabam com os sobreviventes!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: Basicamente, a FEMA percebeu que eles fizeram merda...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: E agora estão encobrindo a incompetência deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: Só aconteceu de eu estar no lugar errado e na hora errada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: Cara, tô doido por uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: Como você sobreviveu?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: Eu quero verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: Eu sou imortal. Esqueceu?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: Eu não sei…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: Eu também me pergunto isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: Talvez seja sorte. Ou talvez algum poder maior me protegendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: Deus, ou seja lá no que você acredita.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: Ou talvez eu já esteja morto, e isso é minha nova vida. Eu não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: Boa pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: Uma pena que não tenho uma arma, eu perguntaria o mesmo pra você.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: E é uma pena que tudo que você tem é cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: Se eu tivesse um destilador eu produziria uma boa leva.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: Cara, tô doido por uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: O que mais você sabe?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: Eu quero verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: Eu sei da estrutura inteira da FEMA:'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: Quem responde a quem, quem faz o que e quem tá ferrando com quem.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: E aqueles malditos sabiam tudo sobre os Visitantes, sabiam o quão perigosos eles eram...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: E ainda assim, permitiram que eles entrassem na cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: Por que ninguém se importava com a segurança.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: Eles só estavam lavando o dinheiro do governo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: Qualquer um que testemunhasse o erro deles virava uma vítima também.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: A organização não queria que ninguém mais soubesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: E isso acontecia antes mesmo das zonas de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: Eu escapei por pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: Quer saber informações confidenciais? Aqui estão...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: É tudo culpa da FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: Isso tudo que dizem e mostram na TV? Pura balela.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: Se existe alguma coisa pior que os Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: Essa coisa é a FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: Cara, tô doido por uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: De onde vieram os Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: Eu quero verificar você
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: Dos arredores da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: É, eu sei que as zonas de quarentena são longe de lá...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: Mas eu tenho certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: Eu não sou supersticioso, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: Eles são os mesmos demônios que as pessoas falavam há dois anos atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: Eu não sei como eles chegaram na cidade...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: Mas, eu sei quem deixou eles entrarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: Os Visitantes não são aliens, assim como a maioria das pessoas pensam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: Eles são criaturas, como eu e você.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: Eles nasceram aqui!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: Eu não posso mais ficar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: Preciso encontrar minha filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: Obrigado... imortal.'
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: (Parece que a conversa acabou)'
    m_Metadata:
      m_Items: []
