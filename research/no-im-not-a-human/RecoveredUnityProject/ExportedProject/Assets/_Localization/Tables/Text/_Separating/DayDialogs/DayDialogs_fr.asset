  - m_Id: 55784900568014861
    m_Localized: 'Wolfhound: Mais, oui… Bien sûr…'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792075
    m_Localized: 'Player: Qu''est-ce que c''est ?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792076
    m_Localized: 'Player: …'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792077
    m_Localized: 'Player: D''accord, je vais la prendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792078
    m_Localized: 'Player: Hein ? Vous voulez me redonner ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792079
    m_Localized: 'Player: …'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792080
    m_Localized: 'Player: Maintenant, ils vont m''emmener…'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539790462976
    m_Localized: Excellente question.
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434496
    m_Localized: J'attends pas…
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434497
    m_Localized: 'Ballerina: Tu trouves ma question excellente ? Pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434498
    m_Localized: 'Ballerina: Tu ferais mieux de répondre. Sinon, il y en a un qui adore ne pas répondre aux questions.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434499
    m_Localized: 'Ballerina: Tu es comme lui maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434500
    m_Localized: Je. N'attends. Rien.
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434501
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434502
    m_Localized: 'Ballerina: Ouais.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434503
    m_Localized: 'Ballerina: Qu''est-ce que tu fais alors ? Assis là, enfermé entre quatre murs.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434504
    m_Localized: 'Ballerina: Tu attends. Tu veux savoir ce qui est arrivé aux tiens, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434505
    m_Localized: Je. N'attends. Rien.
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434506
    m_Localized: Dégainer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434507
    m_Localized: 'Ballerina: Comme tu veux. Moi non plus, d''ailleurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434508
    m_Localized: 'Ballerina: Oh, attends ! Je t''ai déjà dit que j''attendais.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434509
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434510
    m_Localized: 'Ballerina: Bah ! Ele va venir de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434511
    m_Localized: 'Ballerina: AHAHAHAHAHA !'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434512
    m_Localized: 'Ballerina: J''ADORE DANSER. Tu veux que je te montre ? Il suffit que tu appuies sur la gâchette !'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434513
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434514
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434515
    m_Localized: 'Ballerina: Oups !'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434516
    m_Localized: 'Ballerina: Tu veux réessayer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434517
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434518
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434519
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434520
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434521
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434522
    m_Localized: 'Ballerina: T''as raté ! Pourtant, je suis juste à côté.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434523
    m_Localized: 'Ballerina: Tu fermes les yeux quand tu tires ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434524
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434525
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434526
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434527
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434528
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434529
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434530
    m_Localized: 'Ballerina: ALLEZ HOP !'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434531
    m_Localized: 'Ballerina: Bon, ça y est, j''en ai marre.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434532
    m_Localized: 'Ballerina: Ce serait plus simple si je me laissais pourrir toute seule.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683264
    m_Localized: 'Foreigner: Qi''ast-ca qi''yl u o ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683265
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683266
    m_Localized: 'Foreigner: Ja voys la prandra dons ca cos…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683267
    m_Localized: 'Unstable: Bon, ça suffit… Je suis à bout de souffle…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683268
    m_Localized: Alors, euh… c'était quoi les histoires que tu racontais ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683269
    m_Localized: 'Unstable: Ah. Ouais, mes histoires… On pourrait échanger, non ? Tu veux en raconter une, pour commencer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683270
    m_Localized: Pas avec toi.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683271
    m_Localized: Viens-en au fait.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683272
    m_Localized: 'Unstable: OK, OK… Je vais pas te tirer les vers du nez non plus !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683273
    m_Localized: 'Unstable: Donc… J''étais dans ce bar, tu sais. Ou peut-être que c''était pas un bar. Ça aurait pu être autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683274
    m_Localized: 'Unstable: Mince, comment ça s''appelait déjà…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683275
    m_Localized: … Et ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683276
    m_Localized: 'Unstable: Ouais, ouais.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683277
    m_Localized: 'Unstable: Bref. J''étais là, pépère, en train de siroter mon traditionnel Énerjéka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683278
    m_Localized: 'Unstable: Ah, mon pote ! Si tu savais comme j''adore ce truc. T''as pas idée !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683279
    m_Localized: 'Unstable: C''est juste… ça te retourne le cerveau !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683280
    m_Localized: 'Unstable: L''arrière-goût reste dans ta bouche toute la journée ! Dommage qu''on n''en trouve pas partout…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683281
    m_Localized: … Et après ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683282
    m_Localized: 'Unstable: Oh, ouais… Qu''est-ce que je disais déjà ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683283
    m_Localized: 'Unstable: Donc je suis assis là et y a presque pas un chat. La musique résonne dans mes oreilles.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683284
    m_Localized: 'Unstable: Et là, j''entends quelqu''un crier ! Plus fort que mes écouteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683285
    m_Localized: 'Unstable: En plein milieu d''un morceau génial, en plus. Moi j''ai horreur qu''on coupe un morceau, tu sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683286
    m_Localized: 'Unstable: C''est comme si… quand t''es à fond dans le son, le monde autour de toi s''efface…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683287
    m_Localized: T'es sérieux, là ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683288
    m_Localized: 'Unstable: Excuse ! Bon…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683289
    m_Localized: 'Unstable: J''ai retiré mes écouteurs et j''ai vu un grand gaillard qui hurlait après un pauvre type.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683290
    m_Localized: 'Unstable: Je sais pas pourquoi ils se prenaient la tête, mais il arrivait à peine à aligner deux mots, bourré comme il était.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683291
    m_Localized: 'Unstable: Et tout à coup, le grand maigre se met à gifler l''autre type, qui lui, s''écroule comme un sac de patates.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683292
    m_Localized: 'Unstable: Mais le grand n''en a pas fini. Il grimpe sur le bar, il titube comme un bébé, sa tête frôle le plafond.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683293
    m_Localized: 'Unstable: Puis il crie un truc comme « Vous êtes tous des ordures ! ».'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683294
    m_Localized: 'Unstable: Là, j''ai senti que ça allait dégénérer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683295
    m_Localized: 'Unstable: Et moi, j''avais pas envie d''être là quand ça arriverait. Alors je me suis tiré.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683296
    m_Localized: Et après ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683297
    m_Localized: 'Unstable: Rien. Mais depuis, j''ai comme l''impression qu''il y a un truc qui cloche.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683298
    m_Localized: 'Unstable: Partout où je vais, y a toujours quelqu''un pour mettre les pieds dans le plat.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683299
    m_Localized: 'Unstable: J''ai l''impression que si je reste plus de deux jours au même endroit, c''est fichu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683300
    m_Localized: 'Unstable: Bagarre. Mort. Cercueil. Tombe. Toujours dans le même ordre…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683301
    m_Localized: 'Unstable: J''espère que les choses seront différentes ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683302
    m_Localized: 'Unstable: Bon, ça suffit… Je suis à bout de souffle…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683303
    m_Localized: Alors… Quel est le verdict ? Tu te sens en sécurité ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683304
    m_Localized: 'Unstable: Difficile à dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683305
    m_Localized: 'Unstable: Tu dégages une vibe… calme ? Comme une ambiance familiale ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683306
    m_Localized: 'Unstable: Peut-être parce que c''est vraiment ta maison. Ha ha !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683307
    m_Localized: 'Unstable: On dirait que tu essaies de créer un petit havre de paix, ou quelque chose du genre.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683308
    m_Localized: 'Unstable: Et tu laisses pas entrer n''importe qui, tout ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683309
    m_Localized: 'Unstable: Mais… Toi aussi, tu le sens, non ? Y a quelque chose qui tourne pas rond.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683310
    m_Localized: 'Unstable: Ha ! Faut dire que le monde tourne pas rond. Mais ici… C''est…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683311
    m_Localized: 'Unstable: Je sais pas… Je sais même pas ce que j''essaie de dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683312
    m_Localized: 'Unstable: Enfin, peu importe… Prends donc un Énerjéka et oublie ce que je viens de dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683313
    m_Localized: 'Unstable: Va pas te faire de bile non plus !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683314
    m_Localized: Dis-moi… Quand est-ce que tu pars ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683315
    m_Localized: Est-ce que tu fuis toujours quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683316
    m_Localized: 'Unstable: Bientôt, je pense.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683317
    m_Localized: 'Unstable: J''aime pas rester trop longtemps au même endroit. Tu dois bien t''en douter, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683318
    m_Localized: 'Unstable: Et si tu t''en doutes pas… Je sais pas quoi te dire ! C''est pas la première fois que je t''en parle, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683319
    m_Localized: 'Unstable: Je me disais que chez toi, ça aurait pu être sympa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683320
    m_Localized: 'Unstable: Mais ici, tout respire la mort, tu vois ? Je sais pas pourquoi, mais c''est comme ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683321
    m_Localized: 'Unstable: Tu sais, j''en ai assez vu. Ça me va.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683322
    m_Localized: 'Unstable: Je ne m''enfuis pas… C''est juste que je passe à autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683323
    m_Localized: 'Unstable: Je veux pas d''autres problèmes. J''en ai déjà assez comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683324
    m_Localized: 'Unstable: Si tu restes trop longtemps au même endroit, quelqu''un finira toujours par te frapper, te tirer dessus ou t''enfermer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683325
    m_Localized: 'Unstable: Et qui sait comment ça risque de se terminer…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683326
    m_Localized: 'Unstable: Bien sûr, plus je vagabonde, plus j''ai de chances de tomber sur un sale type effrayant.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683327
    m_Localized: 'Unstable: Mais bon, mieux vaut ça que de se faire poignarder dans le dos par quelqu''un en qui tu as confiance.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683328
    m_Localized: 'Unstable: Bon, ça suffit… Je suis à bout de souffle…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683329
    m_Localized: Alors ? Tout est prêt ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683330
    m_Localized: 'Unstable: Hein ? Oh. Oh, ouais. Je pars ce soir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683331
    m_Localized: 'Unstable: Bon… À plus !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683332
    m_Localized: Tu ne pourras pas échapper à toutes les horreurs de ce monde.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683333
    m_Localized: Bonne chance. J'espère que tu ne finiras pas entre les mains d'un psychopathe.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683334
    m_Localized: 'Unstable: Ouais, ouais, je sais. Mais qui sait ? Peut-être que je pourrais y arriver…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683335
    m_Localized: 'Unstable: Tu penses vraiment que rester au même endroit fait une telle différence ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683336
    m_Localized: Eh bien… Bonne chance.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683337
    m_Localized: Je ne te laisserai pas revenir, tu sais.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683338
    m_Localized: 'Unstable: C''est pas du sarcasme, je me trompe ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683339
    m_Localized: 'Unstable: Merci quand même. J''ai pu me reposer un peu ici. J''ai encore quelques jours devant moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683340
    m_Localized: 'Unstable: Tu sais, l''Énerjéka ça fait vraiment des merveilles…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683341
    m_Localized: 'Unstable: Et si c''était une blague… Faire quelque chose, n''importe quoi… Mieux vaut ça que d''attendre que ton cerveau crame.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683342
    m_Localized: 'Unstable: J''ai rien à perdre de toute façon. J''ai tout laissé derrière moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683343
    m_Localized: 'Unstable: Pourquoi ne pas continuer à chercher quelque chose de plus ? C''est mieux que de jeter l''éponge en attendant la fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683344
    m_Localized: 'Unstable: Moi… Je veux pas de ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683345
    m_Localized: Hé bien… Bonne chance
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683346
    m_Localized: Et je te rouvrirai pas la porte, hein. Tu le sais.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683347
    m_Localized: 'Unstable: Merci. Toi aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683348
    m_Localized: 'Unstable: On se reverra peut-être. J''aurai peut-être deux ou trois nouvelles anecdotes.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683349
    m_Localized: 'Unstable: Et j''aurai peut-être envie de les raconter. Mais là, non. Pas avec ta tronche de déterré, très peu pour moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683350
    m_Localized: 'Unstable: Enfin, c''est pas grave. Je reviendrai pas de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683351
    m_Localized: 'Unstable: Ça sert à rien. Y a jamais rien qui vaut la peine de revenir. Y a juste des terres brûlées et des os calcinés.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683352
    m_Localized: 'Unstable: Le prends pas personnellement, hein… Je te dis juste ce que j''ai vu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683353
    m_Localized: 'Unstable: C''est plus facile de tout laisser derrière soi. Donc… C''est mieux si on ne se revoit plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683354
    m_Localized: 'Unstable: Bon, ça suffit… Je suis à bout de souffle…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683355
    m_Localized: T'étais pas censé partir ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683356
    m_Localized: 'Unstable: Si, si… mais je voulais te prévenir avant !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683357
    m_Localized: 'Unstable: J''ai senti un truc bizarre par la fenêtre hier soir. J''allais te réveiller, mais finalement je t''ai laissé dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683358
    m_Localized: 'Unstable: Juste… Fais gaffe, OK ? Une chose est sûre : la mort te guette.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683359
    m_Localized: 'Unstable: Je le sais, même si je n''arrive pas à me l''expliquer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683360
    m_Localized: 'Unstable: J''ai des fourmillements bizarres partout… C''est sûrement à cause de toute cette caféine.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683361
    m_Localized: 'Unstable: Mais là n''est pas le problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683362
    m_Localized: 'Unstable: J''ai juste eu le sentiment que je devais te prévenir, c''est tout… avant qu''il n''arrive quelque chose de grave…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683363
    m_Localized: 'Unstable: Peut-être que… tu devrais peut-être envisager de partir toi aussi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683364
    m_Localized: 'Unstable: … Me regarde pas comme ça. Je vois bien que tu penses que je dis n''importe quoi. Tsss… Peu importe.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683365
    m_Localized: 'Unstable: En tout cas, je t''aurais prévenu. Bon, ça suffit… pour de vrai, cette fois. J''espère que tu crameras pas, toi aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683366
    m_Localized: 'Rocker: Mec… ma gratte me manque.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683367
    m_Localized: Tu rêves éveillé ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460480
    m_Localized: Hm ? Ouais… J'étais juste en train de compter qui reste debout parmi mon ancien groupe.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460481
    m_Localized: 'Rocker: Après chaque enterrement, on branchait nos amplis et on jouait à fond. Valait mieux ça que moisir dans son lit ou picoler.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460482
    m_Localized: 'Rocker: Une fois, j''ai répété le même riff trois nuits d''affilée. Jusqu''à ce que mes doigts pissent le sang.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460483
    m_Localized: 'Rocker: Juste moi et ma gratte. Pas de place dans ma tête pour revoir la tronche de l''enfoiré qui venait de clamser.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460484
    m_Localized: 'Rocker: Maintenant, c''est la même merde tous les jours. Les Visiteurs, le soleil qui crame… Et un avant-goût de l''enfer, cul sec !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460485
    m_Localized: 'Rocker: Mec… ma gratte me manque.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460486
    m_Localized: C'est dur ? Sans guitare ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460487
    m_Localized: 'Rocker: Carrément, ouais…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460488
    m_Localized: 'Rocker: Ha, j''me souviens de nos bœufs… L''ampli sur un tabouret, pas trop fort pour que les voisins appellent pas les flics.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460489
    m_Localized: 'Rocker: Après chaque morceau, y avait toujours un connard pour dire « En mémoire de untel ». C''est tout. Pas de guimauve.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460490
    m_Localized: 'Rocker: Mieux vaut casser une vieille gratte que sa pipe. Au moins, on peut remplacer la première…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460491
    m_Localized: 'Rocker: À l''époque, j''aurais mis ma main à couper qu''à force de répéts sur le canap, on aurait fini par percer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460492
    m_Localized: 'Rocker: Mais cette satanée ville nous a broyés avant qu''on ait pu se reformer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460493
    m_Localized: 'Rocker: Y avait toujours un connard qui crevait d''une overdose ou d''un accident de voiture.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460494
    m_Localized: 'Rocker: La vie était vraiment pourrie…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460495
    m_Localized: 'Rocker: J''me tire demain soir. J''ai un endroit où crécher.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460496
    m_Localized: 'Rocker: Mec… ma gratte me manque.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460497
    m_Localized: Alors ? T'es allé faire un tour hier soir ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460498
    m_Localized: 'Rocker: Ouais. Je suis passé au vieux local de répét. Les murs étaient moisis, les câbles détachés, c''était le bazar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460499
    m_Localized: 'Rocker: J''ai allumé le métronome. J''ai écouté un bon moment… Et rien. Juste le vide.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460500
    m_Localized: 'Rocker: À quoi bon continuer à rêver…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460501
    m_Localized: 'Rocker: Le rock''n''roll ne meurt jamais ? Ha !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460502
    m_Localized: 'Rocker: Tu veux que je te dise ? Même si le soleil s''était pas mis à nous griller, un autre truc nous serait tombé dessus.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460503
    m_Localized: 'Rocker: Quand j''étais gosse, je croyais que toutes les galères étaient derrière nous. Que ça pouvait que s''améliorer. Ha !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460504
    m_Localized: 'Rocker: La récession, la guerre… On aurait presque pu croire qu''on pouvait enfin vivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460505
    m_Localized: 'Rocker: Putain, qu''est-ce que je pouvais me tromper…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460506
    m_Localized: 'Rocker: Mec… ma gratte me manque.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460507
    m_Localized: À quoi tu penses ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460508
    m_Localized: 'Rocker: J''ai réalisé que toutes mes histoires, c''était du remplissage. Jamais été sur scène, sous les projos. Et ça, ça changera jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460509
    m_Localized: 'Rocker: J''sais même pas pourquoi je t''ai menti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460510
    m_Localized: 'Rocker: Peut-être que j''avais envie de croire que j''avais percé le temps d''un instant.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460511
    m_Localized: 'Rocker: J''ai dit que j''avais traversé l''enfer et que j''en étais sorti plus fort, mais c''est du vent. J''me suis planqué comme un môme sous une couverture.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460512
    m_Localized: 'Rocker: Quand t''as braqué ton arme, tout s''est cassé. J''ai tué l''ancien moi… Et ce que je suis devenu, c''est pathétique.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460513
    m_Localized: 'Rocker: Si je continue comme ça, je finirai comme tous les autres. Avec le bide plein de cachetons ou un rasoir dans un bain chaud.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460514
    m_Localized: 'Rocker: J''suis pas un Visiteur. Juste un enfoiré à bout, sur le point de craquer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460515
    m_Localized: 'Rocker: Si tu veux tirer…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460516
    m_Localized: 'Rocker: Ah, laisse tomber, mec.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460517
    m_Localized: 'Rocker: J''en ai marre, je m''en fous.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460518
    m_Localized: 'Experienced: Tout va bien, frérot ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460519
    m_Localized: Si t'as fait de la taule, où sont tes tatouages ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460520
    m_Localized: 'Experienced: Mec, c''est pas parce que j''ai pas de tatouages que j''ai pas fait de zonzon.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460521
    m_Localized: 'Experienced: L''habit ne fait pas le moine. C''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460522
    m_Localized: 'Experienced: C''est vrai que j''ai enchaîné les emmerdes… Mais j''ai jamais tué personne, moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460523
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460524
    m_Localized: 'Experienced: Le prends pas mal, frérot… Mais faut que je te pose la question. Est-ce que c''est toi qui commandes ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460525
    m_Localized: Qu'est-ce que ça peut te faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460526
    m_Localized: Mêle-toi de tes oignons.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460527
    m_Localized: 'Experienced: J''ai l''impression que tu laisses entrer les gens comme dans un moulin, ici. Des clochards, des types louches…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460528
    m_Localized: 'Experienced: C''est pas bon pour les affaires. Moi, j''ai de la bouteille… Je sais comment ça marche.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460529
    m_Localized: 'Experienced: Ça va t''attirer des ennuis, frérot.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460530
    m_Localized: 'Experienced: Imaginons que tu laisses entrer un vieux gâteux et qu''il s''écroule sur ton canapé.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460531
    m_Localized: 'Experienced: Qu''est-ce qui se passe après ? On te fera porter le chapeau, tu seras responsable de sa mort. Tu piges ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460532
    m_Localized: 'Experienced: Ou disons que c''est une femme. Un type la fout en cloque. Et après ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460533
    m_Localized: 'Experienced: C''est toi qui vas torcher le mioche ? Tu veux vraiment t''embarquer là-dedans ? Hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460534
    m_Localized: 'Experienced: En gros, frérot… Y a que les vrais, les durs… Les gars comme toi et moi, quoi… qui tenons la route.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460535
    m_Localized: T'es en train de me dire que je devrais pas laisser entrer les vieux, les femmes et les enfants ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460536
    m_Localized: Et ça sort de la bouche d'un ex-taulard ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460537
    m_Localized: 'Experienced: Compris, frérot. Je me mêlerai plus de tes affaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460538
    m_Localized: 'Experienced: Excuse-moi, je voulais pas t''énerver. C''est ta baraque, c''est toi qui décides.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460539
    m_Localized: 'Experienced: La seule chose qui me chiffonne…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460540
    m_Localized: 'Experienced: C''est… Pourquoi tout le monde continue à porter des fringues ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460541
    m_Localized: 'Experienced: T''es malin, frérot. Pas besoin de ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460542
    m_Localized: Tu manques pas d'air, tu sais ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460543
    m_Localized: Depuis quand t'es un expert ? Depuis que t'es sorti de taule ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460544
    m_Localized: 'Experienced: Écoute. Tout ce que je dis, c''est qu''il faut pas laisser entrer n''importe qui. Sinon, ça va te faire du tort.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460545
    m_Localized: Tu manques pas d'air, tu sais ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460546
    m_Localized: Depuis quand t'es un expert ? Depuis que t'es sorti de taule ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460547
    m_Localized: 'Experienced: Tu te crois drôle, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460548
    m_Localized: 'Experienced: J''ai compris, frérot. Je reste en dehors de ça. Pas besoin de me le dire deux fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460549
    m_Localized: 'Experienced: La seule chose qui me chiffonne…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460550
    m_Localized: 'Experienced: C''est… Pourquoi tout le monde continue à porter des fringues ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460551
    m_Localized: 'Experienced: Tout va bien, frérot ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460552
    m_Localized: T'as pas froid comme ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460553
    m_Localized: 'Experienced: Comme quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460554
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460555
    m_Localized: 'Experienced: Tu te fiches de moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460556
    m_Localized: 'Experienced: Le soleil chauffe les oreilles comme du bacon. Les rues sont plus cramées qu''un barbecue.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460557
    m_Localized: 'Experienced: Et toi ? T''es en pull. Qui est le plus idiot des deux, frérot ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460558
    m_Localized: Ces vêtements font un peu partie de moi.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460559
    m_Localized: Tout va bien.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460560
    m_Localized: 'Experienced: Partie de toi, hein…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460561
    m_Localized: 'Experienced: Comme tu veux, frérot.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460562
    m_Localized: 'Experienced: Il fait une chaleur infernale dehors, et vous paradez tous, avec des plumes sur vos casquettes.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460563
    m_Localized: 'Experienced: C''est complètement débile. La sueur coule à flots, mais pas question que quelqu''un voie mon corps en sueur !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460564
    m_Localized: 'Experienced: Ou peut-être que… Les gens qui ne transpirent pas sous toutes leurs fringues sont pas vraiment normaux…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460565
    m_Localized: Tu insinues que je suis un Visiteur ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460566
    m_Localized: Où est-ce que tu veux en venir ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460567
    m_Localized: 'Experienced: Tu me fais marcher ? Je suis là à cuire en plein soleil, et toi, c''est limite si t''as pas froid avec ton pull ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460568
    m_Localized: 'Experienced: Je pige pas. On transpire comme dans un sauna, mais pas question que quelqu''un voie mon corps en sueur !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460569
    m_Localized: 'Experienced: Bon sang ! Et quand tu vas à la plage, alors ? Maillots de bain, bikinis… C''est pas grave, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460570
    m_Localized: 'Experienced: Même chaleur, moins de plaisir !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460571
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460572
    m_Localized: 'Experienced: Ou peut-être que… Les gens qui ne transpirent pas sous toutes leurs fringues sont pas vraiment normaux…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460573
    m_Localized: Tu insinues que je suis un Visiteur ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460574
    m_Localized: Où est-ce que tu veux en venir ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460575
    m_Localized: 'Experienced: Relax, frérot. Je te cherche pas des noises.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460576
    m_Localized: 'Experienced: T''as l''air d''être un gars sûr. Si tu veux transpirer, c''est ton problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460577
    m_Localized: 'Experienced: Je parle des autres bouffons. C''est comme ceux qui portent un imper à la plage…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460578
    m_Localized: Et alors, je suis censé me déshabiller ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460579
    m_Localized: Géniale, ta théorie. Géniale… Tu la sors d'où ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460580
    m_Localized: 'Experienced: Écoute… À mon avis, y a que deux types de gens qui portent des fringues ces jours-ci. Les idiots et les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460581
    m_Localized: 'Experienced: Ces monstres, ils sont bons qu''à nourrir les asticots ! C''est pour ça qu''ils ressentent pas la chaleur. Tu piges ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460582
    m_Localized: Et alors, je suis censé me déshabiller ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460583
    m_Localized: Géniale, ta théorie géniale… Tu la sors d'où ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460584
    m_Localized: 'Experienced: Écoute, frérot. C''est pas ce que j''ai voulu dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460585
    m_Localized: 'Experienced: Si tu veux transpirer, c''est ton problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460586
    m_Localized: 'Experienced: Moi, je dis juste que c''est bizarre. Faut être soit complètement idiot, soit…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460587
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460588
    m_Localized: 'Experienced: Je suis sérieux, frérot ! Se balader avec plusieurs couches de fringues d''une chaleur pareille, c''est fou.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460589
    m_Localized: 'Experienced: Quel genre de guignol fait ça d''un temps pareil ? Ce que je dis, c''est qu''il faut être soit complètement idiot, soit…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460590
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460591
    m_Localized: 'Experienced: Ah, ça me soule. J''en ai marre de parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460592
    m_Localized: 'Experienced: Tout va bien, frérot ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460593
    m_Localized: Alors, qu'est-ce que tu voulais dire la dernière fois, au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460594
    m_Localized: 'Experienced: Écoute, frérot… Je peux t''expliquer… Mais promets-moi que tu vas vraiment m''écouter, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460595
    m_Localized: Oui
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460596
    m_Localized: Non
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460597
    m_Localized: 'Experienced: OK. Alors, voilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460598
    m_Localized: 'Experienced: Pour la faire courte, tout le monde ici est une mauvaise graine.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460599
    m_Localized: Qu'est-ce qui te fait dire ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460600
    m_Localized: T'as toujours catalogué les gens comme des fruits ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460601
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460602
    m_Localized: 'Experienced: C''est quoi ton délire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460603
    m_Localized: 'Experienced: Dans ce cas, pourquoi tu poses la question ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460604
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460605
    m_Localized: 'Experienced: On dirait que tout le monde a perdu la boule, sauf ceux qui sont derrière les barreaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460606
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460607
    m_Localized: 'Experienced: Tu sais quoi, frérot ? Je vais la fermer plutôt que de péter les plombs moi aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460608
    m_Localized: 'Experienced: Si j''étais pas en train de cuire, tu crois que je me baladerais à moitié à poil en maillot de bain ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460609
    m_Localized: 'Experienced: Ça m''énerve de tous les voir se balader habillés comme s''ils sentaient pas la chaleur.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460610
    m_Localized: 'Experienced: T''es ici depuis plus longtemps que moi, mais on dirait que tu vis dans un bunker.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460611
    m_Localized: 'Experienced: Est-ce que tu sais reconnaître ces monstres, au moins ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460612
    m_Localized: Ouais, je connais les signes. Je les ai vus à la télé.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460613
    m_Localized: Personne ne sait vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460614
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460615
    m_Localized: 'Experienced: Tu me fais marcher, avoue…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460616
    m_Localized: 'Experienced: C''est comme je te le dis ! Les Visiteurs, c''est ceux qui portent des fringues !'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460617
    m_Localized: 'Experienced: Est-ce que tu sais reconnaître ces monstres, au moins ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460618
    m_Localized: Ouais, je connais les signes. Je les ai vus à la télé.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460619
    m_Localized: Personne ne sait vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460620
    m_Localized: 'Experienced: J''espère vraiment que c''est le cas, frérot.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460621
    m_Localized: 'Experienced: Ça craindrait grave si ces signes c''était que des conneries. Ils te jetteraient en taule.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460622
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460623
    m_Localized: 'Experienced: Alors quoi, on choisit au hasard maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460624
    m_Localized: 'Experienced: Bon sang, si y a pas d''autre moyen, qu''est-ce qu''on peut faire ? C''est comme ça et pis c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460625
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460626
    m_Localized: 'Experienced: Franchement, vu comment ça se passe en ce moment… les gens sont plus humains.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460627
    m_Localized: 'Experienced: Je me sentais plus en sécurité derrière les barreaux…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460628
    m_Localized: 'Experienced: Tout va bien, frérot ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460629
    m_Localized: Si tu te sentais plus en sécurité en prison, pourquoi tu y es pas resté ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460630
    m_Localized: 'Experienced: Je te l''ai déjà dit, frérot. Moi, j''ai purgé ma peine. Ma troisième, d''ailleurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460631
    m_Localized: 'Experienced: La première fois, j''étais gamin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460632
    m_Localized: 'Experienced: Je croyais qu''à ma sortie, je me tiendrais à carreau.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460633
    m_Localized: 'Experienced: Et c''est ce que j''ai fait, frérot. Je me suis trouvé une petite nana, j''ai eu un môme. Mon ancienne vie, c''était du passé.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460634
    m_Localized: 'Experienced: Et la récession a frappé. Il a fallu que je vole pour les nourrir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460635
    m_Localized: 'Experienced: Et avant même que je m''en rende compte, j''étais retombé dans mes vieux travers.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460636
    m_Localized: 'Experienced: Après ça, impossible de pas retourner à l''ombre. Et la troisième peine, je l''ai choisie. Y avait rien pour moi dehors.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460637
    m_Localized: 'Experienced: Ma femme m''avait quitté, mon gosse avait peur de moi, et… personne n''embauche un ex-taulard.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460638
    m_Localized: 'Experienced: Donc ouais… La moitié de ma vie est fichue.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460639
    m_Localized: Qu'est-ce qui t'empêche de retomber dans tes vieux travers encore une fois ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460640
    m_Localized: Je suis désolé d'entendre ça.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460641
    m_Localized: 'Experienced: Rien, frérot. J''ai juste pas encore trouvé de bonne raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460642
    m_Localized: 'Experienced: Mais chaque chose en son temps… Chaque chose en son temps…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460643
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460644
    m_Localized: 'Experienced: Je veux pas de ta pitié, frérot. Je suis seul responsable de ce qui m''est arrivé.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460645
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460646
    m_Localized: 'Experienced: Le monde a changé pendant que j''étais en prison.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460647
    m_Localized: 'Experienced: Je suis vieux jeu maintenant. Les dernières trouvailles, ça me dépasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460648
    m_Localized: 'Experienced: Je suis comme le vieux lit de ma cellule. Il était en bois massif avant, il est toujours en bois massif maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460649
    m_Localized: 'Experienced: Je crois que je me suis figé dans mes habitudes, frérot.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460650
    m_Localized: 'Experienced: C''est dur de s''intégrer de nos jours. Personne fait confiance à personne. Les gens hésitent pas à te trahir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460651
    m_Localized: 'Experienced: Moi, j''ai l''habitude de parler franchement.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460652
    m_Localized: 'Experienced: Crois-le ou non… En taule, les gens sont honnêtes. Tu vois qui ils sont vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460653
    m_Localized: 'Experienced: Ici, dehors ? Tu ne peux pas dire qui est authentique, qui est tordu. Tout est biaisé.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460654
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460655
    m_Localized: 'Experienced: Je suis pas philosophe, mais… C''est si difficile de garder son humanité ? Les gens y arrivent bien en taule…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460656
    m_Localized: 'Experienced: Je crois qu''il y a plus de graines pourries ici que ce que je croyais.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460657
    m_Localized: 'Jacket: Purée… Tout ça, c''est vraiment n''importe quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460658
    m_Localized: Tu habitais dans un dortoir, c'est ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460659
    m_Localized: 'Jacket: Ouais. Je t''en ai pas parlé avant, mais je suis pas du coin. Je suis venu pour étudier, et puis tout a dérapé…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460660
    m_Localized: 'Jacket: Au début, ils nous ont enfermés dans les dortoirs, pour pas que le virus se propage. Et les gars en combi jaune sont venus.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460661
    m_Localized: 'Jacket: J''étais déjà pas serein. Mais quand j''ai entendu qu''ils emmenaient les infectés dans des zones de quarantaine…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460662
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460663
    m_Localized: 'Jacket: J''allais pas rester là à attendre qu''on vienne me chercher… J''ai grimpé par la fenêtre et je me suis échappé.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460664
    m_Localized: 'Jacket: J''ai attrapé ma veste et je me suis sauvé. Mais j''avais nulle part où aller… Et je me suis retrouvé devant ta porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460665
    m_Localized: Juste ta veste ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460666
    m_Localized: Qu'est-ce que t'as pris d'autre ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460667
    m_Localized: 'Jacket: Ouais. C''est ma veste préférée.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460668
    m_Localized: 'Jacket: Bon, j''ai pris ma carte d''identité et deux-trois autres trucs. Mais franchement, y a que la veste qui compte vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460669
    m_Localized: 'Jacket: Et détrompe-toi, c''est pas une question de prix ou de marque.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460670
    m_Localized: 'Jacket: C''est juste que… C''est un des rares trucs qui me restent de mon frère.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460671
    m_Localized: 'Jacket: Purée… Tout ça, c''est vraiment n''importe quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460672
    m_Localized: Qu'est-ce qui lui est arrivé, à ton frère ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460673
    m_Localized: 'Jacket: Pour faire court, la FEMA l''a emmené, et je l''ai pas revu depuis.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460674
    m_Localized: 'Jacket: Avant, il était marin, en fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460675
    m_Localized: 'Jacket: Et cette veste… Il me l''a rapportée comme cadeau, d''un de ses voyages à l''étranger.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460676
    m_Localized: 'Jacket: Je pensais qu''il me rapporterait un petit truc, comme un de ces stylos rigolos ou un aimant pour le frigo…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460677
    m_Localized: 'Jacket: Mais au lieu de ça, il a dépensé un paquet de fric pour m''acheter une belle veste ! J''étais super content.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460678
    m_Localized: 'Jacket: Pour être franc, je le voyais vraiment pas souvent. Alors, j''étais super content qu''il ait pensé à moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460679
    m_Localized: 'Jacket: Je l''avoue, cette veste m''a causé pas mal d''ennuis. On en trouve pas des comme ça par ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460680
    m_Localized: 'Jacket: Quand les gens la voient, ils essaient de me la piquer, et ensuite…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460681
    m_Localized: 'Jacket: Mais je compte pas l''abandonner. C''est pas juste une veste, c''est un souvenir de mon frère.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460682
    m_Localized: 'Jacket: J''espère juste qu''il va bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460683
    m_Localized: 'Jacket: Purée… Tout ça, c''est vraiment n''importe quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460684
    m_Localized: Est-ce que tu t'es dit que tu pourrais peut-être retrouver ton frère dans la zone de quarantaine ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460685
    m_Localized: 'Jacket: C''est pas si simple.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460686
    m_Localized: 'Jacket: Ils ont pas emmené mon frère dans une zone de quarantaine. Ils l''ont carrément embrigadé à la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460687
    m_Localized: Tu veux dire…
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460688
    m_Localized: Merde…
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460689
    m_Localized: 'Jacket: Ouais… C''est un des leurs maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460690
    m_Localized: 'Jacket: Ils lui ont même pas laissé le choix. Ils se sont juste pointés chez lui et ils lui ont dit qu''il ferait l''affaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460691
    m_Localized: 'Jacket: Il se serait jamais engagé de son plein gré. Jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460692
    m_Localized: 'Jacket: C''est pour ça que je peux pas les laisser m''attraper.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460693
    m_Localized: 'Jacket: C''est pas juste que j''ai peur des Visiteurs… Enfin, tout le monde a peur, bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460694
    m_Localized: 'Jacket: Alors que la plupart sont terrifiés, se demandant si la personne en face d''eux est humaine… Moi, j''ai peur d''autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460695
    m_Localized: 'Jacket: Et si celui qui m''emmène, c''est mon frère ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460696
    m_Localized: 'Jacket: Qu''est-ce qu''il fera ? Il enfreindra les règles pour me laisser partir ? Et qu''est-ce qui lui arrivera s''il le fait ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460697
    m_Localized: 'Jacket: Ou est-ce qu''il obéira aux ordres et m''emmènera en quarantaine avec les autres ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460698
    m_Localized: 'Jacket: Et s''ils lui demandaient de me tirer dessus…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460699
    m_Localized: 'Jacket: Est-ce que ça me réconforterait de savoir que c''est mon frère qui a appuyé sur la gâchette ? Ou est-ce que ce serait pire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460700
    m_Localized: 'Jacket: Rien de tout ça me semble normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460701
    m_Localized: 'Jacket: Y a plein de pensées angoissantes qui me stressent. Mais y en a qu''une qui me fait vraiment flipper…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460702
    m_Localized: 'Jacket: Si un jour ils m''emmenaient… je risquerais de jamais savoir si c''était mon propre frère derrière le masque.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725184
    m_Localized: 'Tough: Rien tombe du ciel. Absolument rien. Un point c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725185
    m_Localized: La vie dure n'a pas été facile pour toi, pas vrai ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725186
    m_Localized: 'Tough: À mon avis, tous ceux qui ont eu la vie facile sont morts à l''heure qu''il est.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725187
    m_Localized: 'Tough: Le jour où le fric a arrêté de faire la loi, tous les fragiles se sont effondrés.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725188
    m_Localized: 'Tough: Quand on n''a pas de cran, on devient vite une proie facile pour les violeurs, les opportunistes ou juste les tarés.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725189
    m_Localized: 'Tough: Tu as bien vu ça toi aussi, non ? Les gens deviennent des animaux. Mais pas nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725190
    m_Localized: 'Tough: Nous, on s''abaisse pas à leur niveau. On peut se défendre et laisser les autres survivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725191
    m_Localized: 'Tough: Nous, nous sommes ceux qui veulent vivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725192
    m_Localized: 'Tough: Les ordures, les lâches, ceux qui ont abandonné… Eux, ils seront éliminés par ce monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725193
    m_Localized: 'Tough: Oui, ça peut paraître radical. Mais c''est comme ça. On n''y peut rien faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725194
    m_Localized: 'Tough: Tout ce qu''on peut faire, c''est protéger notre humanité. J''espère que cet endroit pourra y contribuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725195
    m_Localized: 'Tough: Rien tombe du ciel. Absolument rien. Un point c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725196
    m_Localized: J'en suis pas si sûr que ça.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725197
    m_Localized: 'Tough: On ne peut pas juste dire que tout va bien se passer… Enfin si, on peut, mais ça ne changera rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725198
    m_Localized: 'Tough: Les lapalissades, ça sert à rien. Soit t''es prêt à affronter l''enfer… soit tu l''es pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725199
    m_Localized: Je vois pas pourquoi ce serait à moi de réconforter les gens.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725200
    m_Localized: T'aimerais pas qu'on te dise ça, juste une fois ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725201
    m_Localized: 'Tough: C''est exactement ce que je dis.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725202
    m_Localized: 'Tough: Y a des gens à qui tu dois tenir la main, torcher les fesses… Tu dois tout faire à leur place.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725203
    m_Localized: 'Tough: Et le jour où il faut passer à l''action, y a plus personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725204
    m_Localized: 'Tough: Ils s''effondrent comme un château de cartes, et ils entraînent tout le monde avec eux au passage.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725205
    m_Localized: 'Tough: Dire que tout va bien se passer, ça résout pas le problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725206
    m_Localized: 'Tough: Moi, j''ai pas envie de revivre ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725207
    m_Localized: 'Tough: La faiblesse a plus sa place dans ce monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725208
    m_Localized: 'Tough: Faut croire que je suis un peu trop dure. C''est encore tout frais dans ma tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725209
    m_Localized: 'Tough: On en reparlera plus tard, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725210
    m_Localized: 'Tough: Quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725211
    m_Localized: 'Tough: À quoi ça servirait ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725212
    m_Localized: 'Tough: Les mots, ça change rien du tout. C''est pas ça qui va faire revenir les morts ou pousser un violeur à se les couper.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725213
    m_Localized: 'Tough: Je l''ai le couteau, mais j''ai pas le sucre pour faire passer la dose.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725214
    m_Localized: 'Tough: Faut s''adapter à ce nouveau monde ou mourir. Le reste, ça sert à rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725215
    m_Localized: 'Tough: J''ai pas envie de m''en prendre à toi. Mais t''avise pas de poser d''autres questions débiles comme ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725216
    m_Localized: 'Tough: Rien tombe du ciel. Absolument rien. Un point c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725217
    m_Localized: Dis-moi… Qu'est-ce que t'as, là ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725218
    m_Localized: 'Tough: Je vais être franche avec toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725219
    m_Localized: 'Tough: J''ai vu comment tu regardais cette boîte dans la réserve. Comment t''étais figé devant la fenêtre de la chambre.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725220
    m_Localized: 'Tough: Je suis allée jeter un œil hier soir. T''es coincé dans cette maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725221
    m_Localized: 'Tough: Tu te bats pas pour rester en vie. En fait, t''as juste peur de mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725222
    m_Localized: 'Tough: Je me trompe ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725223
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725224
    m_Localized: Va te faire voir.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725225
    m_Localized: 'Tough: Pffft… N''importe quoi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725226
    m_Localized: 'Tough: J''ai bien vu que t''étais tendu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725227
    m_Localized: 'Tough: La seule chose qui t''empêche de te faire sauter la cervelle, c''est la peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725228
    m_Localized: 'Tough: Au début, je pensais que t''avais vécu l''enfer, que t''étais endurci par toutes les galères que la vie t''avait infligées.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725229
    m_Localized: 'Tough: Mais en fait, t''es juste une autre âme apeurée qui a réussi à éviter le pire.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725230
    m_Localized: 'Tough: Je suis… déçue.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725231
    m_Localized: 'Tough: J''ai plus envie de te parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725232
    m_Localized: 'Tough: Tu me fais penser à un écolier aux yeux grands ouverts, malmené par ses tyrans.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725233
    m_Localized: 'Tough: C''est bien ce que je pensais. T''es juste un autre faiblard qui a réussi à mettre la main sur un flingue.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725234
    m_Localized: 'Tough: Rien de plus…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725235
    m_Localized: 'Tough: Au début, je pensais que t''avais vécu l''enfer, que t''étais endurci par toutes les galères que la vie t''avait infligées.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725236
    m_Localized: 'Tough: Mais en fait, t''es juste une autre âme apeurée qui a réussi à éviter le pire.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725237
    m_Localized: 'Tough: Je suis… déçue.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725238
    m_Localized: 'Tough: J''ai plus rien à te dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725239
    m_Localized: 'Tough: Rien tombe du ciel. Absolument rien. Un point c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725240
    m_Localized: Dans quoi d'autre t'as mis ton nez, hein ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725241
    m_Localized: 'Tough: Si j''ai fait ça, c''est parce que je suis prête à tout pour survivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725242
    m_Localized: 'Tough: J''avais besoin de savoir à qui j''avais affaire. Et de quoi je devais me méfier.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725243
    m_Localized: 'Tough: Cet endroit est plein de souvenirs… Des membres de ta famille… morts.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725244
    m_Localized: 'Tough: Ça m''a fait réfléchir… On peut jamais oublier le passé.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725245
    m_Localized: 'Tough: Mais c''est pas mes oignons.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725246
    m_Localized: 'Tough: C''est juste que…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725247
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725248
    m_Localized: 'Tough: Avant, j''étais plus douce. Plus jeune. Un jour, j''ai cru que j''avais rencontré le prince charmant…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725249
    m_Localized: 'Tough: Il m''avait dit qu''on devait passer chez lui pour apporter quelque chose à sa mère. Moi, je voulais pas entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725250
    m_Localized: 'Tough: J''avais décidé d''attendre dehors… Mais un peu plus tard, il m''a crié de monter, depuis la fenêtre.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725251
    m_Localized: 'Tough: C''est ce que j''ai fait. Mais sa mère était pas là… Y avait juste ce salaud et son horrible pote.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725252
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725253
    m_Localized: 'Tough: Je vais te dire… Quand tout le monde a basculé… Je les ai retrouvés.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725254
    m_Localized: 'Tough: Je me suis pas mieux sentie pour autant. Pas vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725255
    m_Localized: 'Tough: Je me suis longtemps sentie sale. Pendant longtemps… Comme si je pouvais jamais m''en débarrasser…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725256
    m_Localized: 'Tough: Mais après, le monde a basculé…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725257
    m_Localized: 'Tough: Les salauds comme ça méritent pas notre pitié. Et les faibles non plus. C''est de leur faute si ce genre de choses arrive.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725258
    m_Localized: 'Tough: Je fouillerai plus dans tes affaires, promis. Mais peut-être que tu me comprends maintenant…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725259
    m_Localized: 'Bald: 1, 2, 3, 4… Peut-être que je vais tout brûler… Ah ah ! Mais non, c''est une boutade !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725260
    m_Localized: C'est quoi le problème avec vos amis ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725261
    m_Localized: 'Bald: Ah oui ! Nous nous sommes tous rencontrés à l''école de théâtre.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725262
    m_Localized: 'Bald: À vrai dire, j''ai fait des études pour devenir producteur de théâtre. Mais je ne le recommande pas, vous savez.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725263
    m_Localized: 'Bald: Le théâtre non plus, d''ailleurs. Oui, ça fait classe à première vue, mais plus personne ne va au théâtre aujourd''hui.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725264
    m_Localized: 'Bald: Enfin, si vous le faites uniquement pour l''art et que ça ne vous dérange de vivre sans le sou, allez-y.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725265
    m_Localized: 'Bald: Bien sûr, il y a quelques compagnies qui se produisent sur de grandes scènes, mais c''est rare.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725266
    m_Localized: 'Bald: Le reste ? Que des petits budgets. Les gens préfèrent le cinéma. C''est moins cher, plus spectaculaire, plus facile.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725267
    m_Localized: 'Bald: Donc oui… c''est juste une grande déception, l''ami.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725268
    m_Localized: 'Bald: 1, 2, 3, 4… Peut-être que je vais tout brûler… Ah ah ! Mais non, c''est une boutade !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725269
    m_Localized: D'accord, le théâtre n'est pas toujours reluisant… Mais c'est quoi le problème avec vos amis ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725270
    m_Localized: 'Bald: Ah, je n''avais pas fini… J''ai tendance à sauter du coq à l''âne. J''ai du mal à me concentrer sur un seul sujet. Bref.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725271
    m_Localized: 'Bald: Mes amis étaient tous acteurs, ingénieurs du son, techniciens lumière… Des saltimbanques, en somme !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725272
    m_Localized: 'Bald: On a toujours bu comme des trous. Je louais même des petites scènes pour mes anniversaires… Ce monde qu''il y avait !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725273
    m_Localized: 'Bald: Et c''était fa-bu-leux ! Imaginez une centaine de personnes qui viennent juste pour vous ! C''était le bon temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725274
    m_Localized: 'Bald: Mais le monde du théâtre est extrêmement toxique, pavé de mauvaises intentions. Pas d''argent, trop de stress.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725275
    m_Localized: 'Bald: Avec le temps, les fêtes sont devenues de plus en plus rares.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725276
    m_Localized: 'Bald: Et j''ai réalisé que les gens qui venaient à mes anniversaires n''étaient pas des amis… ils étaient juste… là.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725277
    m_Localized: 'Bald: Ils se servaient de moi quand ça les arrangeait… Et ils me critiquaient dès que j''avais le dos tourné.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725278
    m_Localized: 'Bald: Alors, je me suis assis. J''ai pris un papier et un crayon. J''ai trié, j''ai listé. J''ai viré les parasites.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725279
    m_Localized: 'Bald: 1, 2, 3, 4… Peut-être que je vais tout brûler… Ah ah ! Mais non, c''est une boutade !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725280
    m_Localized: Et où les amis qu'il y avait sur votre liste ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725281
    m_Localized: 'Bald: Lorsque les problèmes avec les huissiers ont commencé, j''ai cherché de l''aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725282
    m_Localized: 'Bald: Mais le soleil a commencé à tout brûler et les Visiteurs sont apparus. Les choses sont allées de mal en pis.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725283
    m_Localized: 'Bald: Je me suis donc décidé à contacter tous mes amis.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725284
    m_Localized: 'Bald: Un d''eux avait brûlé vif : il s''était assoupi dans un parc après avoir trop bu et il ne s''est jamais réveillé.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725285
    m_Localized: 'Bald: Un autre a été tué… Vous vous rendez compte ? Ils ont cru que c''était un Visiteur !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725286
    m_Localized: 'Bald: C''est insensé ! Ces soi-disant « signes » ne sont que foutaises ! Ils ont tué mes amis pour rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725287
    m_Localized: 'Bald: Ça me rend tellement furieux… Je ne sais même pas quoi faire de ce sentiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725288
    m_Localized: 'Bald: La colère mêlée à l''impuissance, ça vous paralyse. On commence à tout haïr autour de soi… à commencer par soi-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725289
    m_Localized: 'Bald: Bon sang… Quelle belle bande de salauds…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725290
    m_Localized: 'Bald: 1, 2, 3, 4… Peut-être que je vais tout brûler… Ah ah ! Mais non, c''est une boutade !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725291
    m_Localized: C'est quoi l'histoire avec les huissiers ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725292
    m_Localized: 'Bald: Je vivais avec ma mère et ma grand-mère.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725293
    m_Localized: 'Bald: Mon père, un acteur infidèle et alcoolique, nous a abandonnés. La vie de théâtre, hé ! Et ma mère était costumière.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725294
    m_Localized: 'Bald: Elle m''a protégé toute ma vie. J''ai découvert bien tard que nous avions toujours été submergés par les problèmes.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725295
    m_Localized: 'Bald: Ma mère avait du mal à trouver du travail. Les grands théâtres ? Impossible. Les petits ? Ils payaient mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725296
    m_Localized: 'Bald: Alors, elle a emprunté de l''argent. Pas à un ami, mais à une banque. Juste pour qu''on puisse manger.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725297
    m_Localized: 'Bald: Évidemment, elle ne pouvait pas rembourser. Et les huissiers ont commencé à venir.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725298
    m_Localized: 'Bald: On avait une règle stricte : ne pas ouvrir la porte si on n''attendait personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725299
    m_Localized: 'Bald: Et si on arrivait à la maison et qu''il y avait des inconnus dans le coin ? On partait se promener quelques heures.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725300
    m_Localized: 'Bald: C''était compliqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725301
    m_Localized: 'Bald: Et avec tout ce qui se passait… les gens devenaient violents. Les huissiers encore plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725302
    m_Localized: 'Bald: Une fois, je suis rentré et la porte était grande ouverte. Tout était saccagé. Leurs doigts, leurs jambes… brisés.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725303
    m_Localized: 'Bald: C''était un cauchemar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725304
    m_Localized: 'Bald: Puis deux gorilles ont débarqué…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725305
    m_Localized: 'Bald: Je me suis enfui. Évidemment que je me suis enfui…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725306
    m_Localized: 'Bald: J''étais terrorisé…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725307
    m_Localized: 'Bald: Et je me hais pour ça. Pour ne pas les avoir défendues. Pour avoir fui comme un trouillard. Pour ne jamais y être retourné.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725308
    m_Localized: 'Bald: J''ai trop la frousse.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725309
    m_Localized: 'Bald: Une peur sale, égoïste.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725310
    m_Localized: 'Bald: Et c''est juste… trop grave… Y a pas d''autres mots…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725311
    m_Localized: 'Nervous: Je veux pas y retourner, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725312
    m_Localized: T'es… un peu bizarre, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725313
    m_Localized: 'Nervous: Ah bon ? Et qu''est-ce que ça peut te faire ? Hein ? Hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725314
    m_Localized: 'Nervous: Toi aussi, tu me cherches ? Hein ? Hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725315
    m_Localized: 'Nervous: Tu devrais pourtant t''en douter que j''aime pas ça. J''aime pas ça depuis l''asile de fous.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725316
    m_Localized: 'Nervous: Mes parents m''ont enfermé dans un asile, imagine un peu, hi hi !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725317
    m_Localized: 'Nervous: Ouais… Tout le monde disait que je suivais quelqu''un. Et alors ? Qu''est-ce que ça peut leur faire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725318
    m_Localized: 'Nervous: J''ai rien fait de mal, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725319
    m_Localized: 'Nervous: Mais mes parents, eux, ils pensaient que j''étais fou. Peut-être qu''ils le pensent encore.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725320
    m_Localized: 'Nervous: Après tout, ils m''ont enfermé plus de dix ans dans cet asile. Comme si j''étais une sorte de maniaque, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725321
    m_Localized: 'Nervous: Et tout ça, juste parce qu''une seule fois…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725322
    m_Localized: 'Nervous: Ah, laisse tomber. Faut que j''appelle l''hôtel. Dring dring dring !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725323
    m_Localized: 'Nervous: Je veux pas y retourner, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725324
    m_Localized: Qu'est-ce que tu disais avant ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725325
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725326
    m_Localized: 'Nervous: Ils m''embêtaient à l''école. Ils me lâchaient pas. Tous les jours. Ils m''embêtaient tout le temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725327
    m_Localized: 'Nervous: Alors, oui, j''ai craqué. Je suis pas un punching-ball qu''on peut frapper jusqu''à ce qu''il éclate…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725328
    m_Localized: 'Nervous: Je me suis battu. Ils sont tombés… et ils se sont pas relevés. J''ai entendu dire qu''il était à l''hôpital. Mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725329
    m_Localized: 'Nervous: Je voulais pas le tuer. Mais bon… Mes parents ont réussi à arranger un peu les choses, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725330
    m_Localized: 'Nervous: Mais ils continuent à chuchoter sur moi. Tu les entends ? Chut…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725331
    m_Localized: 'Nervous: Ensuite, ils m''ont envoyé à l''asile. Et voilà ! On est revenus au début !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725332
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725333
    m_Localized: 'Nervous: Cette bagarre… C''était chouette… Le pouvoir… La vengeance…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725334
    m_Localized: 'Nervous: Mes poings m''ont fait tellement mal. Le goût du sang sur mes lèvres, ma langue… Mmmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725335
    m_Localized: 'Nervous: Ils m''ont viré. Mais moi… Moi j''ai fait que me défendre, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725336
    m_Localized: 'Nervous: Je veux pas y retourner, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725337
    m_Localized: L'asile, ça t'a pas vraiment réussi, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725338
    m_Localized: 'Nervous: Pas vraiment, hi hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725339
    m_Localized: 'Nervous: Quand tu gobes des pilules qui te transforment en légume… tu passes ton temps à ruminer !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725340
    m_Localized: 'Nervous: Je me suis pas arrangé. C''était de moins en moins facile. Mais dix ans plus tard… Me voilà, ta-da !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725341
    m_Localized: 'Nervous: Tout ça à cause de cette seule et unique fois où…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725342
    m_Localized: 'Nervous: Hi hi hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725343
    m_Localized: 'Nervous: Oh, comme si personne faisait jamais d''erreurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725344
    m_Localized: 'Nervous: Arrête ! Je vois bien que tu es en train de me juger.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725345
    m_Localized: 'Nervous: Tu veux me frapper ? Vas-y ! Frappe-moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725346
    m_Localized: 'Nervous: Frappe-moi au visage, casse-moi les doigts ! Oui ! Je veux l''adrénaline, nourris-moi ! Ouiii !'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725347
    m_Localized: 'Nervous: Quoi ? Tu veux pas me frapper ? T''en as pas envie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725348
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725349
    m_Localized: 'Nervous: Hi hi… Dans ce cas, je vais juste attendre ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725350
    m_Localized: 'Nervous: C''est… En fait, c''est plus calme qu''à l''hôtel, ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725351
    m_Localized: 'Nervous: Merci de m''avoir laissé entrer hi hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725352
    m_Localized: 'Nervous: Au moins, tout le monde est fou ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725353
    m_Localized: 'Leper: Ouais ? Qu''est-ce qu''il y a ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725354
    m_Localized: C'est dur d'avoir cette apparence ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725355
    m_Localized: 'Leper: Pas vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725356
    m_Localized: 'Leper: Sauf à l''école… Ils me traitaient de lépreux et personne voulait jouer avec moi. Ils avaient peur de tomber malades.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725357
    m_Localized: 'Leper: Je pensais que ça s''arrêterait en grandissant. Et ça s''est calmé. Il y avait encore des regards, mais rien de grave.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725358
    m_Localized: 'Leper: Ensuite, le cataclysme a frappé, et tout à coup, tous les vieux préjugés sont revenus.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725359
    m_Localized: 'Leper: Mais maintenant, c''est pire, parce qu''il s''agit de survie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725360
    m_Localized: 'Leper: Et bien sûr, avec ma peau… j''ai l''air d''un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725361
    m_Localized: 'Leper: Qu''est-ce que je peux y faire ? L''adversité fait ressortir ce qu''il y a de pire chez les gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725362
    m_Localized: 'Leper: Ouais ? Qu''est-ce qu''il y a ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725363
    m_Localized: Ils te traitent de Visiteur juste à cause de ta peau ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725364
    m_Localized: 'Leper: Évidemment. Qu''est-ce que tu crois ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725365
    m_Localized: 'Leper: C''est carrément une chasse aux sorcières.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725366
    m_Localized: 'Leper: Tous ceux qui n''ont pas l''air normaux sont pris pour cible. Et la FEMA fait office de juge et de bourreau.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725367
    m_Localized: 'Leper: Je me demande même s''ils sont pas derrière tout ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725368
    m_Localized: 'Leper: Et s''ils avaient inventé les Visiteurs de toutes pièces ? Tu imagines ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725369
    m_Localized: Tu as peut-être raison.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725370
    m_Localized: Non, les Visiteurs existent vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725371
    m_Localized: 'Leper: Content que tu sois d''accord. Visiteurs, mon cul…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725372
    m_Localized: 'Leper: On croirait un mauvais scénario de film.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725373
    m_Localized: 'Leper: C''est peut-être pour renverser le gouvernement. La peur, c''est le vecteur du pouvoir après tout, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725374
    m_Localized: 'Leper: C''est sûrement pour ça qu''ils jettent tous ceux qui ne sont pas d''accord dans leurs zones de quarantaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725375
    m_Localized: 'Leper: Et puis… Ça donne aussi l''impression qu''ils luttent contre les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725376
    m_Localized: 'Leper: Enfin, Visiteurs ou pas… Je voudrais pas être dans le collimateur de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725377
    m_Localized: 'Leper: Je parie qu''ils me feraient des choses horribles.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725378
    m_Localized: 'Leper: Tu penses que c''est vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725379
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725380
    m_Localized: 'Leper: Même si c''était vrai, tu trouves pas que la FEMA agit bizarrement ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725381
    m_Localized: 'Leper: Ils disent que les Visiteurs ont un virus, mais ils expliquent pas comment ça se propage…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725382
    m_Localized: 'Leper: C''est pas la première chose à faire quand on veut vraiment arrêter une pandémie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919488
    m_Localized: 'Leper: Je sais pas… Peut-être qu''ils cherchent un remède ou un vaccin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919489
    m_Localized: 'Leper: Mais je peux pas m''empêcher de penser que si je me retrouve en quarantaine, il va m''arriver quelque chose de grave.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919490
    m_Localized: 'Leper: Ouais ? Qu''est-ce qu''il y a ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919491
    m_Localized: Pourquoi tu t'imagines que la FEMA va te faire du mal ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919492
    m_Localized: 'Leper: Parce que pour eux, je suis rien de plus qu''une putain de maladie…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919493
    m_Localized: 'Leper: C''est comme si j''avais une cible dans le dos. J''ai plus de chances d''être tiré au sort pour leurs… expériences.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919494
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919495
    m_Localized: 'Leper: Tout ça à cause de ma putain de peau.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919496
    m_Localized: T'es là maintenant, inutile de t'inquiéter.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919497
    m_Localized: Tu réfléchis trop.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919498
    m_Localized: 'Leper: Ah oui ? J''en conclus qu''ils n''ont pas encore frappé à ta porte, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919499
    m_Localized: 'Leper: Tu penses vraiment qu''ils me laisseraient tranquille, vu mon apparence ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919500
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919501
    m_Localized: 'Leper: Tu crois vraiment ?! T''as pas entendu parler de l''incendie de la maternelle ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919502
    m_Localized: 'Leper: Celui où des parents ont brûlé vif leurs propres enfants ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919503
    m_Localized: 'Leper: On a régressé de plusieurs siècles. La folie se propage comme une gangrène et la FEMA, elle… elle s''en nourrit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919504
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919505
    m_Localized: 'Leper: J''aimerais juste que les gens arrêtent de juger les autres sur leur apparence.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919506
    m_Localized: 'Leper: Mais peu importe combien de temps l''humanité survit, elle continuera toujours à coller des étiquettes aux autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919507
    m_Localized: 'Leper: Comme ça, on peut choisir plus facilement qui a sa place… et qui n''en a pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919508
    m_Localized: 'Leper: Et c''est les types comme moi qui paient le prix fort pour cette cruauté aveugle.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919509
    m_Localized: 'Leper: Tout ça, c''est juste… triste… Vraiment triste.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891008
    m_Localized: 'Fairytaller: T''as besoin de quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891009
    m_Localized: Tu as l'air perdu dans tes pensées.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891010
    m_Localized: Je dois te tester.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891011
    m_Localized: Donner un bulletin FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891012
    m_Localized: 'Fairytaller: Je repensais à une histoire qu''on me racontait, petit… sur des bouvreuils dans une forêt magique…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891013
    m_Localized: 'Fairytaller: Un jour, un dragon est arrivé… et il a tout brûlé : les nids, les oiseaux… tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891014
    m_Localized: 'Fairytaller: Ils se ressemblaient, un peu. Ils avaient des ailes et se partageaient le ciel, le monde en paix, la forêt fertile.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891015
    m_Localized: 'Fairytaller: Mais la puissance du dragon lui a fait perdre la tête. Il a tout brûlé, même ce qu''il aurait pu aimer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891016
    m_Localized: 'Fairytaller: Mon père disait toujours qu''un dragon sommeillait en chacun de nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891017
    m_Localized: 'Fairytaller: Ma sœur et moi on y croyait pas, ça nous faisait rire : « Les dragons sont énormes et les humains minuscules. »'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891018
    m_Localized: 'Fairytaller: En grandissant, j''ai enfin compris. Dommage, mon père ne le saura jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891019
    m_Localized: 'Fairytaller: Mais parfois, je me demande si je serai capable de tuer mon propre dragon ou si je céderai à la tentation.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891020
    m_Localized: 'Fairytaller: T''as besoin de quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891021
    m_Localized: Tu penses souvent aux contes de fées ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891022
    m_Localized: Je dois te tester.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891023
    m_Localized: Donner un bulletin FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891024
    m_Localized: 'Fairytaller: Oui. Aujourd''hui, j''ai repensé à un autre conte, celui de la Cité gelée, entourée de remparts et des tours glacées.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891025
    m_Localized: 'Fairytaller: Depuis des siècles, et peut-être même depuis toujours, les habitants ne se faisaient pas confiance.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891026
    m_Localized: 'Fairytaller: Mais un jour, un souffleur de verre itinérant est arrivé et, petit à petit, les choses ont commencé à changer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891027
    m_Localized: 'Fairytaller: Il a illuminé les rues avec ses lanternes et ne manquait jamais une occasion de saluer ses voisins.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891028
    m_Localized: 'Fairytaller: Au début, ils se moquaient de lui. Mais peu à peu, la glace de leurs cœurs a commencé à fondre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891029
    m_Localized: 'Fairytaller: Tout changer du jour au lendemain, c''est presque impossible. Le vrai changement, c''est en toi qu''il commence.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891030
    m_Localized: 'Fairytaller: Allume ta propre lanterne, même quand le monde qui t''entoure est sombre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891031
    m_Localized: 'Fairytaller: Ma mère, paix à son âme, disait toujours en plaisantant que si tu attends le changement, tu mourras en attendant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891032
    m_Localized: 'Fairytaller: En fin de compte, c''est nous qui gardons ce monde en vie. Renoncer avant d''essayer… Alors, on a déjà perdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891033
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891034
    m_Localized: 'Fairytaller: Je veux me raccrocher à la charité. À l''humanité. Même si ça fait mal. Peut-être que ça montrera la voie aux autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891035
    m_Localized: 'Fairytaller: T''as besoin de quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891036
    m_Localized: Quelle histoire tu vas me raconter aujourd'hui ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891037
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891038
    m_Localized: Donner un bulletin FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891039
    m_Localized: 'Fairytaller: Il y a encore beaucoup d''histoires… des histoires de morts qui reviennent, et où les survivants doivent continuer…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891040
    m_Localized: 'Fairytaller: Celle d''un démon qui prend forme humaine, qui frappe aux portes et pose des questions jusqu''à l''aube…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891041
    m_Localized: 'Fairytaller: Où la colère du soleil cramoisi s''est abattue sur l''humanité, maudissant les récoltes et asséchant les rivières.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891042
    m_Localized: 'Fairytaller: Mais une âme courageuse, ou une troupe de cœurs vaillants, ou peut-être même un pays entier, allaient sauver le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891043
    m_Localized: 'Fairytaller: Le bien finit toujours par triompher.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891044
    m_Localized: 'Fairytaller: Moi aussi, je veux croire que le Cataclysme va passer. Qu''un jour ou l''autre, où tout ça s''arrêtera.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891045
    m_Localized: 'Fairytaller: Et nos familles seront encore là. Et tout le monde pourra faire ce qu''il aime. Et…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891046
    m_Localized: 'Fairytaller: Excuse-moi, je me suis un peu emballé. J''ai besoin d''un peu de temps seul. Pardon…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891047
    m_Localized: 'FunnyGuy: On pourrait enfin vivre sans se soucier de quoi que ce soit maintenant !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891048
    m_Localized: Pourquoi es-tu si sûr qu'ils vont oublier ton emprunt ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891049
    m_Localized: Je dois te faire passer un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891050
    m_Localized: Donner un bulletin FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891051
    m_Localized: 'FunnyGuy: Tu rigoles ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891052
    m_Localized: 'FunnyGuy: Mon gars, c''est la fin du monde ! Y a plus de banques, y a plus d''économie !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891053
    m_Localized: 'FunnyGuy: Plus personne n''en a plus rien à faire. Je l''ai vu, de mes yeux vu !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891054
    m_Localized: 'FunnyGuy: D''habitude, quand je rate un paiement, je reçois des avertissements, des lettres, des menaces, tout le tralala.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891055
    m_Localized: 'FunnyGuy: Mais pas cette fois-ci… Silence radio. Quel pied !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891056
    m_Localized: 'FunnyGuy: Qu''est-ce qu''ils vont faire avec une liste d''endettés qu''on ne peut trouver qu''une fois la nuit tombée ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891057
    m_Localized: 'FunnyGuy: Bien sûr, plus personne n''accorde de nouveaux prêts non plus. J''ai déjà essayé, crois-moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891058
    m_Localized: 'FunnyGuy: Mais bon ! Rien que le fait d''être libéré des chaînes de l''esclavage financier, c''est déjà énorme !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891059
    m_Localized: Je serais pas si détendu, si j'étais toi.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891060
    m_Localized: Alors, on fait la fête ou bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891061
    m_Localized: 'FunnyGuy: Oh, arrête !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891062
    m_Localized: 'FunnyGuy: À quoi bon se stresser ? Ils s''en fichent de moi. Ils sont sûrement en train de creuser des bunkers ou autre…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891063
    m_Localized: 'FunnyGuy: Pourquoi est-ce qu''ils s''embêteraient à harceler un plouc ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891064
    m_Localized: Dans ce cas, pourquoi t'es pas chez toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891065
    m_Localized: Donc, t'es venu ici juste pour te vanter ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891066
    m_Localized: 'FunnyGuy: Et comment !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891067
    m_Localized: 'FunnyGuy: Comme je suis de super bonne humeur, j''avais envie de parler, c''est tout !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891068
    m_Localized: Dans ce cas, pourquoi t'es pas chez toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891069
    m_Localized: Donc, t'es venu ici juste pour te vanter ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891070
    m_Localized: 'FunnyGuy: Eh bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891071
    m_Localized: 'FunnyGuy: Je louais mon appart. Techniquement, c''est toujours le cas. Mais aujourd''hui, l''argent ne vaut plus grand-chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891072
    m_Localized: 'FunnyGuy: Tu te balades, tu casses une fenêtre, tu prends ce dont tu as besoin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862528
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862529
    m_Localized: 'FunnyGuy: Quoi ? Tu me juges ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862530
    m_Localized: Pourquoi tu évites la question ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862531
    m_Localized: Oh, attends ! Je viens juste de réaliser que je m'en fiche…
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862532
    m_Localized: 'FunnyGuy: Arrête, mon gars. Pas besoin d''être désagréable. Je n''ai rien fait de mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862533
    m_Localized: 'FunnyGuy: Même si tu rigolais, c''était pas la peine d''être aussi méchant, bon sang.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862534
    m_Localized: 'FunnyGuy: Tu m''as mis de mauvaise humeur. Juste comme ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862535
    m_Localized: Pourquoi tu évites la question ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862536
    m_Localized: Oh, attends ! Je viens juste de réaliser que je m'en fiche…
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862537
    m_Localized: 'FunnyGuy: Ouais, ouais…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862538
    m_Localized: 'FunnyGuy: Écoute…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862539
    m_Localized: 'FunnyGuy: Je cherche pas à éviter le sujet. C''est juste que… j''ai peur, OK ? J''ai peur de retourner là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862540
    m_Localized: 'FunnyGuy: J''ai loué mon appart à une famille de deux personnes. Ça m''a aidé à payer mon crédit immobilier.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862541
    m_Localized: 'FunnyGuy: Et, eh bien… Je sais pas s''ils sont encore… humains.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862542
    m_Localized: 'FunnyGuy: Les voisines ont appelé plusieurs fois pour se plaindre de coups, de cris, de gens qui allaient et venaient.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862543
    m_Localized: 'FunnyGuy: Mais d''un autre côté, les voisines en question sont des vieilles folles paniquées. Elles me rendent dingue.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862544
    m_Localized: 'FunnyGuy: Mais bon… Et si… Elles avaient raison ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862545
    m_Localized: 'FunnyGuy: Attends, j''ai pas fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862546
    m_Localized: 'FunnyGuy: J''ai besoin de vider mon sac. Tu comprends pas que c''est super gênant pour moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862547
    m_Localized: 'FunnyGuy: Je me suis acheté un appart, et maintenant j''ai trop peur de vivre dedans.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862548
    m_Localized: 'FunnyGuy: Je l''ai loué à une famille, et j''utilise le loyer pour payer le crédit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862549
    m_Localized: 'FunnyGuy: Et maintenant… Merde… J''ai trop peur d''aller sonner à la porte…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862550
    m_Localized: 'FunnyGuy: Les voisines disent qu''il se passe des trucs bizarres. Elles osent à peine mettre le nez dehors.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862551
    m_Localized: 'FunnyGuy: Alors ouais, j''ai peut-être plus de crédit à payer. Mais bon sang, je vais pas me risquer à les expulser non plus !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862552
    m_Localized: 'FunnyGuy: On pourrait enfin vivre sans se soucier de quoi que ce soit maintenant !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862553
    m_Localized: Tu as des nouvelles de tes locataires ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862554
    m_Localized: Je dois te faire passer un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862555
    m_Localized: Donner un bulletin FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862556
    m_Localized: 'FunnyGuy: Hein ? Oh, eux ? J''ai d''autres chats à fouetter.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862557
    m_Localized: 'FunnyGuy: J''ai appelé les voisines plus tôt, j''espère que ça te dérange pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862558
    m_Localized: 'FunnyGuy: Elles m''ont dit que des types de la banque étaient passés. Ils ont posé des questions sur mes paiements.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862559
    m_Localized: 'FunnyGuy: Heureusement que je vis pas là-bas. Mais quand même…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862560
    m_Localized: 'FunnyGuy: Quoi, ces salauds sont prêts à venir me chercher alors même que le soleil est sur le point d''exploser ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862561
    m_Localized: 'FunnyGuy: T''imagines ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862562
    m_Localized: 'FunnyGuy: Je te jure… Bientôt ils vont ressusciter leurs débiteurs…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862563
    m_Localized: 'FunnyGuy: Tu crois pas qu''ils feraient mieux de sauver leur peau ? Pourquoi s''embêter à nous harceler ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862564
    m_Localized: 'FunnyGuy: Bande d''enfoirés…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862565
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862566
    m_Localized: 'FunnyGuy: Bref, je vais squatter ici un petit moment. Après, je retournerai peut-être chez ma famille.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862567
    m_Localized: 'FunnyGuy: Plus on est de fous, plus on rit, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862568
    m_Localized: 'FunnyGuy: Non mais, sérieusement, ces enfoirés… C''est la fin du monde, et ils lâchent pas l''affaire ! Putain !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862569
    m_Localized: 'FunnyGuy: … Dieu les jugera.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862570
    m_Localized: 'FunnyGuy: On pourrait enfin vivre sans se soucier de quoi que ce soit maintenant !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862571
    m_Localized: Tu rentres chez toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862572
    m_Localized: Je dois te faire passer un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862573
    m_Localized: Donner un bulletin FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862574
    m_Localized: 'FunnyGuy: C''est le bordel… Un joli bordel…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862575
    m_Localized: 'FunnyGuy: J''ai encore utilisé ton téléphone, j''espère que ça te dérange pas. C''était pour la banque cette fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862576
    m_Localized: 'FunnyGuy: Apparemment, mes comptes sont bloqués. Et dire que j''avais économisé !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862577
    m_Localized: 'FunnyGuy: Maintenant, je peux plus retirer un centime.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862578
    m_Localized: 'FunnyGuy: Ils disent que c''est à cause de la dette, mais c''est des conneries. Ils pouvaient déduire les mensualités eux-mêmes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862579
    m_Localized: 'FunnyGuy: Mais tout bloquer ? C''est complètement absurde.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862580
    m_Localized: 'FunnyGuy: Je parie qu''ils l''ont fait pour financer les petits projets de la FEMA… Le personnel, les expériences, tout ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862581
    m_Localized: 'FunnyGuy: Eh bien… Ils peuvent aller se faire voir. Moi, j''en ai marre de payer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862582
    m_Localized: 'FunnyGuy: Je vais rester ici un petit moment, si ça te va. J''ose pas aller voir ma famille pour l''instant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862583
    m_Localized: 'FunnyGuy: Et mon appart est sûrement devenu un repaire de Visiteurs ou un labo de la FEMA à l''heure où on parle.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862584
    m_Localized: 'Alt: … Ça devient un peu plus pénible de jour en jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862585
    m_Localized: Tu as beaucoup parlé sur le pas de ma porte.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862586
    m_Localized: Je veux te tester.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862587
    m_Localized: Donner un bulletin FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862588
    m_Localized: 'Alt: Ah, t''as remarqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862589
    m_Localized: 'Alt: C''est une déformation professionnelle, j''imagine. J''évite de trop parler. Surtout quand je suis sur les nerfs.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862590
    m_Localized: 'Alt: Je veux toujours arrondir les angles, tout arranger… Faire en sorte que tout se passe pour le mieux…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862591
    m_Localized: 'Alt: … Avant, j''animais une émission de radio.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862592
    m_Localized: Vraiment ? Mince alors…
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862593
    m_Localized: Je m'en serais jamais douté.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862594
    m_Localized: 'Alt: Quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862595
    m_Localized: 'Alt: Que tu me croies ou pas, j''en n''ai rien à faire. En tout cas, je pouvais plus rester là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862596
    m_Localized: 'Alt: Maintenant, c''est la foire. Tous les charlatans passent à l''antenne pour refourguer leur camelote. Une paix à prix d''or…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862597
    m_Localized: 'Alt: « Et un d''eau à côté de votre radio, ça va aspirer les ondes ! »'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862598
    m_Localized: 'Alt: Et c''est allé de pire en pire.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862599
    m_Localized: 'Alt: Je supportais plus de faire partie de ça. J''en pouvais plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862600
    m_Localized: 'Alt: Et me parle pas des infos. Je restais assise, là, à me demander comment on pouvait encore être en vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862601
    m_Localized: 'Alt: Et donc… À quoi c''est censé ressembler, un animateur radio ? Un intello bigleux en costard-cravate ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862602
    m_Localized: 'Alt: T''es prisonnier de tes clichés. Je peux comprendre. Mais c''est ton problème, pas le mien.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862603
    m_Localized: 'Alt: Moi aussi, j''étais convaincue que je discuterais avec des gens intéressants avant… Je parle des invités du studio.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862604
    m_Localized: 'Alt: Mais non, je devais enchaîner les bulletins d''info sinistres. C''était vraiment difficile de pas avoir envie d''en finir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862605
    m_Localized: 'Alt: Le comble, c''était ces idiots qui cherchaient à vendre du vent et qui s''incrustaient dans toutes les émissions.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862606
    m_Localized: 'Alt: La radio était devenue un cirque. Et moi, j''étais devenue Madame Loyale.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862607
    m_Localized: 'Alt: … Ça devient un peu plus pénible de jour en jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862608
    m_Localized: Alors, t'en as juste eu marre de tout ça et tu es partie ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862609
    m_Localized: Je veux te tester.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862610
    m_Localized: Donner un bulletin FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862611
    m_Localized: 'Alt: Bref… Pour conclure notre petite discussion.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862612
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862613
    m_Localized: 'Alt: Tu sais ce qui m''a fait craquer ? Une émission de plus avec un autre cinglé.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862614
    m_Localized: 'Alt: On nous avait prévenus qu''un « expert » interviendrait en direct pour parler des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862615
    m_Localized: 'Alt: Il disait qu''il avait un moyen de s''en débarrasser… Je sais même plus comment. Un pot hors de prix, peut-être ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862616
    m_Localized: 'Alt: Il avait même payé à l''avance pour passer à l''antenne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862617
    m_Localized: 'Alt: J''ai passé une semaine à fouiller dans toutes les affaires louches où il avait trempé. Je voulais le détruire en direct.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862618
    m_Localized: 'Alt: Ça aurait été une émission géniale…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862619
    m_Localized: 'Alt: Mais ça s''est jamais fait. Tu sais pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862620
    m_Localized: 'Alt: Il s''est défilé parce que quelqu''un lui avait piqué ses foutus documents.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862621
    m_Localized: 'Alt: Des tonnes et des tonnes de données !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862622
    m_Localized: 'Alt: Quel genre de crétin fait un truc pareil ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862623
    m_Localized: 'Alt: Mon plan est complètement tombé à l''eau. Toutes ces recherches pour rien. Après ça, il nous a ignorés, tout simplement.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862624
    m_Localized: 'Alt: Quelle enflure…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862625
    m_Localized: 'Alt: … Ça devient un peu plus pénible de jour en jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862626
    m_Localized: Tu veux plus entendre parler de journalisme depuis ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862627
    m_Localized: Je veux te tester.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862628
    m_Localized: Donner un bulletin FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862629
    m_Localized: 'Alt: Survivre, c''est la seule chose qui m''intéresse.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862630
    m_Localized: 'Alt: J''ai essayé de me faire une place dans d''autres services, surtout quand les éruptions solaires ont éclaté.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862631
    m_Localized: 'Alt: Mais une chose est sûre : tout va de plus en plus mal et ça ne va pas s''arranger.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862632
    m_Localized: 'Alt: Avant, la police municipale nous envoyait tous les jours des rapports. C''est de là qu''on tirait nos infos.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862633
    m_Localized: 'Alt: Et puis, les rapports ont commencé à arriver en retard.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862634
    m_Localized: 'Alt: Et j''ai remarqué qu''ils étaient écrits différemment… Quand on lit la même chose tous les jours, on voit le changement.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862635
    m_Localized: 'Alt: Jusqu''au jour où ils avaient carrément l''air… bizarres.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862636
    m_Localized: 'Alt: C''est là que j''ai décidé de m''éloigner autant que possible des villes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862637
    m_Localized: 'Alt: Mieux vaut rester à la périphérie. J''ai même pensé à aller dans les bois, mais ces temps-ci, c''est pas une bonne idée.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862638
    m_Localized: 'Alt: La vie est juste… pénible.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862639
    m_Localized: 'Tourist: Si seulement je pouvais partir d''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862640
    m_Localized: Où comptiez-vous aller ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862641
    m_Localized: Je dois vous contrôler.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862642
    m_Localized: Donner un bulletin FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862643
    m_Localized: 'Tourist: À quoi bon maintenant ? Je ne rentrerai jamais chez moi de toute façon…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862644
    m_Localized: 'Tourist: Saleté de soleil, c''est exaspérant. Et cette épidémie de Visiteurs est tout aussi insupportable.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862645
    m_Localized: 'Tourist: Est-ce que ça se passe uniquement ici ? Ou partout ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862646
    m_Localized: 'Tourist: Je préparais ce voyage depuis tellement longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862647
    m_Localized: 'Tourist: J''ai économisé, j''ai supplié pour obtenir des congés…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862648
    m_Localized: 'Tourist: Et tout ça pour quoi ? Un voyage qui s''est terminé avant même d''avoir commencé.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862649
    m_Localized: 'Tourist: Si seulement je pouvais partir d''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862650
    m_Localized: Pourquoi n'êtes-vous pas parti plus tôt ?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862651
    m_Localized: Je dois vous contrôler.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862652
    m_Localized: Donner un bulletin FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862653
    m_Localized: 'Tourist: Je vous l''ai déjà dit… Il y avait toujours quelque chose qui m''en empêchait. Encore et encore…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862654
    m_Localized: 'Tourist: En plus, j''étais convaincu que c''était le moment idéal pour voyager.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862655
    m_Localized: 'Tourist: Je pensais pouvoir enfin profiter du soleil…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862656
    m_Localized: 'Tourist: Si j''avais su, je serais parti plus tôt. J''aurais pu voir le monde tant que j''en avais encore la possibilité.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862657
    m_Localized: 'Tourist: Maintenant, je vais devoir me contenter de photos. Tous les autres pays sont en plein chaos.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862658
    m_Localized: 'Tourist: Si seulement je pouvais partir d''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862659
    m_Localized: Au fond, vous avez peut-être eu de la chance ? Au moins, vous n'avez pas encore brûlé vif.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862660
    m_Localized: Je dois vous contrôler.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862661
    m_Localized: Donner un bulletin FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862662
    m_Localized: 'Tourist: De la chance ? Vous vous moquez de moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862663
    m_Localized: 'Tourist: Toute ma vie, j''ai rêvé de découvrir le monde, et maintenant, je ne sais même pas si je verrai quoi que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862664
    m_Localized: 'Tourist: Vous appelez ça de la chance ? En quoi est-ce de la chance ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862665
    m_Localized: Vous êtes en vie, bon sang !
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862666
    m_Localized: C'est juste un voyage, mon vieux.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862667
    m_Localized: 'Tourist: Ouais, ouais… Je suis en vie. Pour l''instant. Mais après ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862668
    m_Localized: 'Tourist: Quand le soleil aura explosé, ce sera fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862669
    m_Localized: 'Tourist: J''imagine que je vais mourir sans avoir vu le reste de la planète…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862670
    m_Localized: C'est ça, votre excuse pour vous apitoyer sur vous-même ? Arrêtez un peu de vous lamenter.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862671
    m_Localized: Vos jérémiades commencent sérieusement à me taper sur les nerfs.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862672
    m_Localized: 'Tourist: Ce n''était pas un simple voyage. C''était le rêve de ma vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862673
    m_Localized: 'Tourist: J''ai toujours voulu découvrir le monde… toute ma vie ! Et pour quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862674
    m_Localized: 'Tourist: Tout est fini. Rien de tout ça n''arrivera jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862675
    m_Localized: 'Tourist: J''aurais dû faire mes valises avant bien avant tout ça. Et maintenant, tout le monde attend la mort…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862676
    m_Localized: C'est ça, votre excuse pour vous apitoyer sur vous-même ? Arrêtez un peu de vous lamenter.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862677
    m_Localized: Vos jérémiades commencent sérieusement à me taper sur les nerfs.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862678
    m_Localized: 'Tourist: Mais… Mais, je…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862679
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862680
    m_Localized: 'Tourist: Je peux pas m''empêcher d''avoir des regrets, je n''y peux rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862681
    m_Localized: 'Tourist: C''est juste que j''ai réalisé… que rien ne m''a jamais vraiment empêché de partir avant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862682
    m_Localized: 'Tourist: Mais j''ai toujours remis ça au lendemain, en me disant que j''aurais le temps plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862683
    m_Localized: 'Tourist: Et voilà… Maintenant… c''est trop tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862684
    m_Localized: 'Tourist: Le monde est sur le point de s''effondrer… Et il y a encore tant de choses que j''aurais voulu voir… et faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862685
    m_Localized: 'Tourist: J''imagine que je vais devoir apprendre à vivre avec mes regrets d''une manière ou d''une autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862686
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862687
    m_Localized: 'Tourist: Allez vous faire voir !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862688
    m_Localized: 'Tourist: Quoi ? J''ai pas le droit de pleurer ce que j''ai perdu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862689
    m_Localized: 'Tourist: Rien ne redeviendra jamais comme avant. Vous devez bien vous en rendre compte, non ? C''est la fin !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862690
    m_Localized: 'Tourist: Vous l''avez déjà accepté, je peux le lire dans vos yeux… Mais moi, moi j''ai pas envie de mourir !'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862691
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862692
    m_Localized: 'Tourist: Qu''est-ce que je raconte ? Vous n''avez sans doute pas mis le nez dehors depuis un bail. Pour vous, rien n''a changé.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862693
    m_Localized: Vous commencez à sérieusement m'agacer.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862694
    m_Localized: Je vais peut-être vous mettre à la porte pour regarder le soleil vous brûler les yeux.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862695
    m_Localized: 'Tourist: Mais qu''est-ce que vous…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862696
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862697
    m_Localized: 'Tourist: Vous savez quoi ? Je pense que je vais partir. Vous commencez à me faire peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862698
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862699
    m_Localized: 'Tourist: Ce que je veux dire, c''est que vous avez peut-être accepté ce qui va se passer, mais c''est pas le cas de tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862700
    m_Localized: 'Tourist: Moi, je peux pas m''empêcher de penser à ce qui va se passer ensuite. Et c''est vraiment difficile.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862701
    m_Localized: 'Tourist: J''arrête pas de repenser à toutes ces occasions manquées… J''avais trop peur pour vivre l''instant présent.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862702
    m_Localized: Essayez de vous souvenir des bons moments. Ça vous aidera peut-être à aller mieux.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862703
    m_Localized: Vous devez arrêter de vous morfondre dans vos regrets.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862704
    m_Localized: 'Tourist: Vous avez peut-être raison…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862705
    m_Localized: 'Tourist: C''est juste que… c''est dur de pas se laisser envahir par les « j''aurais dû », « j''aurais pu », « j''aurais voulu »…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862706
    m_Localized: 'Tourist: Mais vous avez raison… Ça ne sert à rien de vouloir remonter le temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862707
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862708
    m_Localized: 'Tourist: Merci de m''avoir écouté.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862709
    m_Localized: 'Tourist: Je ne sais pas si ça peut vous être utile… Mais tenez, prenez ça {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602560
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602561
    m_Localized: 'Dude: Maaaan… Je viens de me rappeler qu''il me reste encore un cône très spécial…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602562
    m_Localized: 'Dude: Ohhh man… On va planer tellement haut !'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602563
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602564
    m_Localized: 'Dude: Oh, man… Désolé…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602565
    m_Localized: 'Dude: J''ai complètement zappé de faire tourner…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602566
    m_Localized: 'Dude: Paix et amour, mann… Prends un pétard normal…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602567
    m_Localized: 'Dude: J''ai juste besoin de me détendre un peu… Oh, trop bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602568
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602569
    m_Localized: 'Wheelchair: Bon sang, j''ai besoin de m''étirer un peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602570
    m_Localized: 'Wheelchair: Attends, attends… Deux secondes.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602571
    m_Localized: 'Wheelchair: Ouahhhh ! C''est beaucoup mieux comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602572
    m_Localized: C'est quoi ce délire ?!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602573
    m_Localized: 'Wheelchair: Détends-toi, j''ai des fourmis dans les jambes, c''est tout. Pas de quoi en faire un fromage.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602574
    m_Localized: C'était quoi cette comédie ?!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602575
    m_Localized: Qu'est-ce que tu fous dans un fauteuil roulant, bon sang ?!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602576
    m_Localized: 'Wheelchair: J''ai jamais dit que je pouvais pas m''en passer… C''est juste que j''ai les jambes bien au chaud, comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602577
    m_Localized: 'Wheelchair: Quoi ? … J''aime bien me balader dedans.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602578
    m_Localized: T'es tordu…
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602579
    m_Localized: Fous le camp d'ici. TOUT DE SUITE.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602580
    m_Localized: 'Wheelchair: Rohh, ça va… Tu sais, on peut faire des super dérapages avec ce truc.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602581
    m_Localized: 'Wheelchair: Me dis pas que t''as jamais essayé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602582
    m_Localized: T'es tordu…
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602583
    m_Localized: Fous le camp d'ici. TOUT DE SUITE.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602584
    m_Localized: 'Wheelchair: Comme tu veux…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602585
    m_Localized: 'Wheelchair: Mais moi, au moins… Je m''amuse comme un p''tit fou !'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602586
    m_Localized: 'Wheelchair: Oh ! C''est quoi ce bordel ?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602587
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602588
    m_Localized: 'Wheelchair: C''est bon, c''est bon… Je me casse. Mais je prends le fauteuil avec moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602589
    m_Localized: '>>'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602590
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602591
    m_Localized: 'Esenin: J''ai trouvé des recueils de poésie qui traînaient dans le coin.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602592
    m_Localized: 'Esenin: Ça te dérange pas si j''en lis un, dis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602593
    m_Localized: Non, vas-y.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602594
    m_Localized: Ne fais pas ça.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602595
    m_Localized: 'Esenin: Et voilà. C''est fini. Qu''est-ce que t''en dis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602596
    m_Localized: C'est magnifique !
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602597
    m_Localized: Ce ne sont que des mots.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602598
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602599
    m_Localized: 'Esenin: Tu sais, je me sens un peu mieux maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602600
    m_Localized: 'Esenin: Merci de m''avoir écouté, vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602601
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602602
    m_Localized: 'Esenin: D''accord, comme tu veux.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602603
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602604
    m_Localized: 'FortuneTeller: Je crois que je connais le moyen idéal pour vous aider à transformer votre énergie.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602605
    m_Localized: 'FortuneTeller: Il vous suffit de…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602606
    m_Localized: 'FortuneTeller: EXÉCUTER LES ONDULATIONS DU CAPRICORNE !'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602607
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602608
    m_Localized: 'FortuneTeller: Alors ? Est-ce que ça a marché ? Est-ce que vous sentez la joie circuler dans vos chakras ?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602609
    m_Localized: Est-ce que je dois vraiment faire ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602610
    m_Localized: Mais c'est quoi cette histoire ?!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602611
    m_Localized: 'FortuneTeller: Comment ? Ça n''a pas marché ?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602612
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602613
    m_Localized: 'FortuneTeller: C''est étrange. Ça aurait dû…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602614
    m_Localized: 'FortuneTeller: Ce n''est pas une raison pour désespérer. Les mantras devraient vous aider au jour le jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602615
    m_Localized: 'FortuneTeller: D''ailleurs… Mettons ça en pratique tout de suite.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602616
    m_Localized: 'FortuneTeller: Répétez après moi : je suis quelqu''un de joyeux !'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602617
    m_Localized: Je suis quelqu'un de joyeux !
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602618
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602619
    m_Localized: C'est ridicule.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602620
    m_Localized: 'FortuneTeller: Très bien ! Continuez !'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602621
    m_Localized: Je suis quelqu'un de joyeux !
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602622
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602623
    m_Localized: C'est ridicule.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602624
    m_Localized: 'FortuneTeller: Mais, enfin… Mettez-y un peu du vôtre !'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602625
    m_Localized: 'FortuneTeller: Une petite minute… Comment est-ce que j''ai pu passer à côté de ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602626
    m_Localized: 'FortuneTeller: Je le vois dans votre aura… Vous rejetez la joie ! Il n''y a rien en vous, seulement le néant.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602627
    m_Localized: 'FortuneTeller: Et sans désir, on n''arrivera jamais à rien. L''univers ne pourra tout simplement pas le manifester.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602628
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602629
    m_Localized: 'FortuneTeller: Je suis désolée, mais j''ai bien peur de ne pas pouvoir vous aider. Même les mantras vous ont laissé de marbre.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602630
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602631
    m_Localized: Qu'est-ce que tu fais ?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602632
    m_Localized: 'Intruder: Je cherche tes rêves.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602633
    m_Localized: 'Intruder: Tout ce que je veux, c''est trouver un peu de paix. Juste un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602634
    m_Localized: 'Intruder: Où tu les caches ? Dis-moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602635
    m_Localized: Recule ou je te tue !
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602636
    m_Localized: Je ne rêve jamais.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602637
    m_Localized: Fiche-moi la paix.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602638
    m_Localized: 'Intruder: Comprends-moi… J''ai BESOIN de rêves.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602639
    m_Localized: 'Intruder: Mais je le vois dans tes yeux : tu n''en as pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602640
    m_Localized: 'Intruder: C''est bon, tu peux te détendre maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602641
    m_Localized: 'Intruder: La question maintenant, c''est… Est-ce que je te dis la vérité ? Ou je cherche juste à te faire baisser la garde… ?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602642
    m_Localized: 'Intruder: J''ai trouvé un cauchemar qui ne me lâche pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796864
    m_Localized: 'Intruder: Tu rampes dans un couloir… comme une limace immonde.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796865
    m_Localized: 'Intruder: Tu ignores complètement à qui appartiennent les yeux à travers lesquels tu regardes.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796866
    m_Localized: 'Intruder: Tout ce que je peux te dire, c''est que c''est un regard qui cherche des corps. Il est attiré par les lieux de mort…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796867
    m_Localized: 'Intruder: Peut-être qu''un jour tu le verras…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796868
    m_Localized: 'Intruder: Je suis tombé sur un cauchemar bizarre, pourtant…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796869
    m_Localized: 'Intruder: Tu rampes dans un tunnel où des champignons poussent en permanence.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796870
    m_Localized: 'Intruder: Il y en a beaucoup trop, et ils poussent à une vitesse effrayante.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796871
    m_Localized: 'Intruder: C''est bizarre. Comment se fait-il que tu aies eu une telle vision…'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821952
    m_Localized: 'Esenin: Quand la nuit s''étend dans le ciel…'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821953
    m_Localized: 'Esenin: Telle une patiente endormie sur la table d''opération…'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821954
    m_Localized: 'Esenin: Nous sortons, pour parcourir les rues à moitié désertes…'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821955
    m_Localized: 'Esenin: Pour parcourir les retraites où courent les murmures.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823488
    m_Localized: Je vais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823489
    m_Localized: Donner un bulletin FEMA
    m_Metadata:
